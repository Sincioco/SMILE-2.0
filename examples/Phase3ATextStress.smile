Option Explicit

Dim Value As Text
Dim Copy As Text
Dim Values[4] As Text
Dim Index As Number

Value = "初期"

For Index = 0 To 999
    Copy = Value
    Call ChangeByValue(Copy)
    Call Replace(Value, BuildValue("SMILE", "✓"))

    Values[Index Mod 4] = Value

End For

Value = Value
Print Value
Print Values[3]
Print "" = Values[0]

End Program

Sub ChangeByValue(ValueToChange As Text)

    ValueToChange = "Local"

End Sub

Sub Replace(ByRef ValueToChange As Text, NewValue As Text)

    ValueToChange = NewValue

End Sub

Function BuildValue(LeftValue As Text, RightValue As Text) As Text

    Dim Combined As Text

    Combined = LeftValue + RightValue
    Return Combined

End Function
