Option Explicit

Import Smile.Simple3D.Core As Core
Import Smile.Simple3D.Graphics3D As Graphics3D

Dim Checks As Number
Dim Failures As Number

Game Window "Renderer3D M7E-A Soft-Depth Fallback Tests" Size 320 By 240

Do

    Call RunTests()

Loop Until True

If Failures = 0 Then
    Print "Renderer3D M7E-A soft-depth fallback tests passed"
Else
    Print "Renderer3D M7E-A soft-depth fallback tests failed: "; Failures
End If

Sub RunTests()

    Dim Camera As Core.Camera3D
    Dim EmptyTexture As Core.Texture3D
    Dim Material As Core.Material3D
    Dim Particle As Core.ParticleBatch3D

    Call Graphics3D.ResetRenderer3D()

    Camera = Graphics3D.DefaultCamera()
    Material = Graphics3D.CreateEffectMaterial3D(
        EmptyTexture,
        Graphics3D.MATERIAL_ALPHA_BLEND,
        150
    )
    Particle = Graphics3D.CreateParticleBatch3D(1, Material)

    Call Check(Material.Handle <> 0)
    Call Check(Particle.Handle <> 0)
    Call Check(Graphics3D.ConfigureSoftDepth3D(Graphics3D.SOFT_DEPTH_REQUEST_AUTOMATIC))
    Call Check(Graphics3D.SetEffectMaterialSoftDepth3D(
        Material,
        Graphics3D.SOFT_DEPTH_MATERIAL_AUTOMATIC
    ))
    Call Check(Graphics3D.SetParticle3D(Particle, 0, 0, 0, 50, 90, 0))
    Call Check(Graphics3D.SetParticleColor3D(Particle, 0, 255, 128, 32, 85))
    Call Check(Graphics3D.CommitParticleBatch3D(Particle, 1))
    Call Check(Graphics3D.Begin3D(Camera, 4, 8, 12))
    Call Check(Graphics3D.DrawParticleBatch3D(Particle))
    Call Check(Graphics3D.End3DChecked())
    Call Check(Graphics3D.SoftDepthValue3D(Graphics3D.SOFT_DEPTH_QUERY_REQUESTED) = 1)
    Call Check(Graphics3D.SoftDepthValue3D(Graphics3D.SOFT_DEPTH_QUERY_EFFECTIVE) = 0)
    Call Check(Graphics3D.SoftDepthValue3D(Graphics3D.SOFT_DEPTH_QUERY_BYTES) = 0)
    Call Check(Graphics3D.SoftDepthValue3D(Graphics3D.SOFT_DEPTH_QUERY_COPY_DRAWS) = 0)
    Call Check(Graphics3D.SoftDepthValue3D(Graphics3D.SOFT_DEPTH_QUERY_COPY_FAILURES) = 1)
    Call Check(Graphics3D.SoftDepthValue3D(Graphics3D.SOFT_DEPTH_QUERY_VFX_DRAWS) = 0)
    Call Check(Graphics3D.SoftDepthValue3D(
        Graphics3D.SOFT_DEPTH_QUERY_FALLBACK_REASON
    ) = Graphics3D.SOFT_DEPTH_FALLBACK_TARGET)

    Call Check(Graphics3D.TryDestroyParticleBatch3D(Particle))
    Call Graphics3D.DestroyEffectMaterial3D(Material)

    Call Graphics3D.ResetRenderer3D()

End Sub

Sub Check(Condition As Boolean)

    Checks = Checks + 1

    If Not Condition Then
        Failures = Failures + 1
    End If

End Sub
