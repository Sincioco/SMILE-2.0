OPTION EXPLICIT

IMPORT Smile.UI.Core AS UI
IMPORT Smile.UI.BitmapFont AS BitmapFont
IMPORT Smile.UI.Menu AS Menu
IMPORT Smile.UI.MenuNavigator AS MenuNavigator

GAME WINDOW "Phase 5.2.1 Submenu Viewport" SIZE 640 BY 360

DIM CursorImage AS IMAGE
DIM FontAtlas AS IMAGE
DIM FontDefinition AS UI.BitmapFontStyle
DIM FontHandle AS NUMBER
DIM SystemText AS UI.TextStyle
DIM SystemSelected AS UI.TextStyle
DIM SystemDisabled AS UI.TextStyle
DIM BitmapText AS UI.TextStyle
DIM BitmapSelected AS UI.TextStyle
DIM BitmapDisabled AS UI.TextStyle
DIM SmallText AS UI.TextStyle
DIM MenuStyle AS UI.MenuStyle
DIM WrapStyle AS UI.MenuStyle
DIM GeometryStyle AS UI.MenuStyle
DIM NoScrollbarStyle AS UI.MenuStyle
DIM NavigatorStyle AS UI.MenuNavigatorStyle
DIM Root AS NUMBER
DIM Child AS NUMBER
DIM Grandchild AS NUMBER
DIM Navigator AS NUMBER
DIM FiveMenu AS NUMBER
DIM TwentyMenu AS NUMBER
DIM SixtyFourMenu AS NUMBER
DIM AllVisibleMenu AS NUMBER
DIM HiddenScrollbarMenu AS NUMBER
DIM TinyMenu AS NUMBER
DIM RootLongShared AS NUMBER
DIM RootDisabled AS NUMBER
DIM RootSubmenu AS NUMBER
DIM ChildSubmenu AS NUMBER
DIM ItemIndex AS NUMBER
DIM Result AS BOOLEAN
DIM Event AS NUMBER
DIM Key AS NUMBER
DIM Running AS BOOLEAN
DIM I AS NUMBER

LOAD IMAGE CursorImage FROM "Assets\Cursor.png"
LOAD IMAGE FontAtlas FROM "Assets\BitmapFont.png"

FontDefinition.Atlas = FontAtlas
FontDefinition.FirstCodePoint = 32
FontDefinition.GlyphCount = 96
FontDefinition.Columns = 16
FontDefinition.SourceCellWidth = 64
FontDefinition.SourceCellHeight = 64
FontDefinition.DrawWidth = 18
FontDefinition.DrawHeight = 18
FontDefinition.AdvanceX = 15
FontDefinition.LineHeight = 20
FontDefinition.FallbackCodePoint = 63
FontDefinition.FilterMode = UI.UI_FILTER_SMOOTH
FontHandle = BitmapFont.Create(FontDefinition)

SystemText.Mode = UI.UI_TEXT_SYSTEM
SystemText.SystemSize = 18
SystemText.SystemColor = WHITE
SystemText.LineSpacing = 2
SystemSelected = SystemText
SystemSelected.SystemColor = YELLOW
SystemDisabled = SystemText
SystemDisabled.SystemColor = DARK_GRAY
SmallText = SystemText
SmallText.SystemSize = 8
SmallText.LineSpacing = 0

BitmapText.Mode = UI.UI_TEXT_BITMAP
BitmapText.SystemSize = 18
BitmapText.SystemColor = WHITE
BitmapText.BitmapFontHandle = FontHandle
BitmapText.LineSpacing = 2
BitmapSelected = BitmapText
BitmapDisabled = BitmapText

MenuStyle.Window.FillColor = RGB(12, 22, 48)
MenuStyle.Window.BorderColor = CYAN
MenuStyle.Window.BorderThickness = 2
MenuStyle.Window.Padding.Left = 10
MenuStyle.Window.Padding.Top = 10
MenuStyle.Window.Padding.Right = 10
MenuStyle.Window.Padding.Bottom = 10
MenuStyle.NormalText = SystemText
MenuStyle.SelectedText = SystemSelected
MenuStyle.DisabledText = SystemDisabled
MenuStyle.SelectionFillColor = RGB(35, 70, 118)
MenuStyle.UseCursor = TRUE
MenuStyle.Cursor = CursorImage
MenuStyle.CursorWidth = 20
MenuStyle.CursorHeight = 20
MenuStyle.CursorFilterMode = UI.UI_FILTER_SMOOTH
MenuStyle.RowHeight = 32
MenuStyle.WrapSelection = TRUE
MenuStyle.ShowScrollbar = FALSE
MenuStyle.ShowSubmenuIndicator = TRUE
MenuStyle.SubmenuIndicatorPosition = UI.UI_SUBMENU_INDICATOR_RIGHT_ALIGNED
MenuStyle.ItemTextOverflowMode = UI.UI_MENU_TEXT_ELLIPSIS
MenuStyle.ItemTextMaxLines = 1

WrapStyle = MenuStyle
WrapStyle.RowHeight = 70
WrapStyle.SubmenuIndicatorPosition = UI.UI_SUBMENU_INDICATOR_AFTER_TEXT
WrapStyle.ItemTextOverflowMode = UI.UI_MENU_TEXT_WRAP
WrapStyle.ItemTextMaxLines = 2

GeometryStyle = MenuStyle
GeometryStyle.Window.Padding.Left = 2
GeometryStyle.Window.Padding.Top = 2
GeometryStyle.Window.Padding.Right = 2
GeometryStyle.Window.Padding.Bottom = 2
GeometryStyle.NormalText = SmallText
GeometryStyle.SelectedText = SmallText
GeometryStyle.DisabledText = SmallText
GeometryStyle.UseCursor = FALSE
GeometryStyle.RowHeight = 12
GeometryStyle.ShowScrollbar = TRUE
GeometryStyle.ShowSubmenuIndicator = FALSE
GeometryStyle.ItemTextOverflowMode = UI.UI_MENU_TEXT_CLIP
NoScrollbarStyle = GeometryStyle
NoScrollbarStyle.ShowScrollbar = FALSE

FiveMenu = Menu.Create(GeometryStyle, 8, 60, 90, 52, 4)
TwentyMenu = Menu.Create(GeometryStyle, 106, 60, 90, 52, 4)
SixtyFourMenu = Menu.Create(GeometryStyle, 204, 60, 90, 52, 4)
AllVisibleMenu = Menu.Create(GeometryStyle, 302, 60, 90, 52, 4)
HiddenScrollbarMenu = Menu.Create(NoScrollbarStyle, 400, 60, 90, 52, 4)
TinyMenu = Menu.Create(GeometryStyle, 498, 60, 60, 7, 1)
FOR I = 0 TO 4
    ItemIndex = Menu.AddItem(FiveMenu, "FIVE", I, TRUE)
    ItemIndex = Menu.AddItem(HiddenScrollbarMenu, "HIDDEN", I, TRUE)
    ItemIndex = Menu.AddItem(TinyMenu, "TINY", I, TRUE)
END FOR
FOR I = 0 TO 19
    ItemIndex = Menu.AddItem(TwentyMenu, "TWENTY", I, TRUE)
END FOR
FOR I = 0 TO 63
    ItemIndex = Menu.AddItem(SixtyFourMenu, "SIXTY FOUR", I, TRUE)
END FOR
FOR I = 0 TO 3
    ItemIndex = Menu.AddItem(AllVisibleMenu, "VISIBLE", I, TRUE)
END FOR

Root = Menu.Create(MenuStyle, 430, 185, 190, 160, 4)
Child = Menu.Create(WrapStyle, 0, 0, 230, 165, 2)
Grandchild = Menu.Create(MenuStyle, 0, 0, 245, 150, 4)

ItemIndex = Menu.AddItem(Root, "SHORT LEAF", 10, TRUE)
RootLongShared = Menu.AddItem(Root, "A VERY LONG SHARED CATEGORY NAME", 11, TRUE)
RootDisabled = Menu.AddItem(Root, "DISABLED CATEGORY", 12, FALSE)
RootSubmenu = Menu.AddItem(Root, "DISPLAY AND ACCESSIBILITY SETTINGS", 13, TRUE)

ChildSubmenu = Menu.AddItem(Child, "A WRAPPED CHILD OPTION WITH EXPLICIT
MULTILINE CONTENT AND FINAL OVERFLOW", 20, TRUE)
ItemIndex = Menu.AddItem(Child, "CHILD LEAF", 21, TRUE)

ItemIndex = Menu.AddItem(Grandchild, "DEEPEST ACCEPTED LEAF", 30, TRUE)
ItemIndex = Menu.AddItem(Grandchild, "ANOTHER VERY LONG LEAF THAT ELLIPSIZES", 31, TRUE)

NavigatorStyle.Viewport.X = 0
NavigatorStyle.Viewport.Y = 0
NavigatorStyle.Viewport.Width = 640
NavigatorStyle.Viewport.Height = 360
NavigatorStyle.ViewportPadding.Left = 8
NavigatorStyle.ViewportPadding.Top = 8
NavigatorStyle.ViewportPadding.Right = 8
NavigatorStyle.ViewportPadding.Bottom = 8
NavigatorStyle.HorizontalGap = 8
NavigatorStyle.PreferredDirection = UI.UI_SUBMENU_DIRECTION_AUTO

Navigator = MenuNavigator.Create(Root, NavigatorStyle)
Result = Navigator > 0
Result = Result AND MenuNavigator.BindSubmenu(Navigator, Root, RootLongShared, Child, FALSE)
Result = Result AND MenuNavigator.BindSubmenu(Navigator, Root, RootDisabled, Grandchild, FALSE)
Result = Result AND MenuNavigator.BindSubmenu(Navigator, Root, RootSubmenu, Child, TRUE)
Result = Result AND MenuNavigator.BindSubmenu(Navigator, Child, ChildSubmenu, Grandchild, TRUE)
Result = Result AND Menu.SetSelectedIndex(Root, RootSubmenu)
Running = Result AND FiveMenu > 0 AND TwentyMenu > 0 AND SixtyFourMenu > 0 AND AllVisibleMenu > 0 AND HiddenScrollbarMenu > 0 AND TinyMenu > 0

DO
    GET KEY Key
    Event = UI.UI_EVENT_NONE

    IF Key = KEY_1 THEN
        MenuStyle.NormalText = SystemText
        MenuStyle.SelectedText = SystemSelected
        MenuStyle.DisabledText = SystemDisabled
        WrapStyle.NormalText = SystemText
        WrapStyle.SelectedText = SystemSelected
        WrapStyle.DisabledText = SystemDisabled
        Result = Menu.SetStyle(Root, MenuStyle)
        Result = Result AND Menu.SetStyle(Child, WrapStyle)
        Result = Result AND Menu.SetStyle(Grandchild, MenuStyle)
        Running = Running AND Result
    ELSE IF Key = KEY_2 THEN
        MenuStyle.NormalText = BitmapText
        MenuStyle.SelectedText = BitmapSelected
        MenuStyle.DisabledText = BitmapDisabled
        WrapStyle.NormalText = BitmapText
        WrapStyle.SelectedText = BitmapSelected
        WrapStyle.DisabledText = BitmapDisabled
        Result = Menu.SetStyle(Root, MenuStyle)
        Result = Result AND Menu.SetStyle(Child, WrapStyle)
        Result = Result AND Menu.SetStyle(Grandchild, MenuStyle)
        Running = Running AND Result
    ELSE
        Event = MenuNavigator.HandleKey(Navigator, Key)
    END IF

    CLEAR RGB(4, 8, 20)
    CALL Menu.Draw(FiveMenu)
    CALL Menu.Draw(TwentyMenu)
    CALL Menu.Draw(SixtyFourMenu)
    CALL Menu.Draw(AllVisibleMenu)
    CALL Menu.Draw(HiddenScrollbarMenu)
    CALL Menu.Draw(TinyMenu)
    CALL MenuNavigator.DrawStack(Navigator)
    DRAW TEXT "RIGHT/ENTER OPEN   LEFT/ESC BACK   1 SYSTEM   2 BITMAP" AT 320, 12 SIZE 15 COLOR WHITE CENTERED
    SHOW SCREEN
    WAIT 8 MILLISECONDS
LOOP UNTIL GAME_CLOSED() = TRUE OR Running = FALSE

CALL MenuNavigator.Destroy(Navigator)
CALL Menu.Destroy(TinyMenu)
CALL Menu.Destroy(HiddenScrollbarMenu)
CALL Menu.Destroy(AllVisibleMenu)
CALL Menu.Destroy(SixtyFourMenu)
CALL Menu.Destroy(TwentyMenu)
CALL Menu.Destroy(FiveMenu)
CALL Menu.Destroy(Grandchild)
CALL Menu.Destroy(Child)
CALL Menu.Destroy(Root)
CALL BitmapFont.Destroy(FontHandle)
UNLOAD IMAGE FontAtlas
UNLOAD IMAGE CursorImage

END PROGRAM
