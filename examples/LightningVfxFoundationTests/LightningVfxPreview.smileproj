<SmileProject Version="1.0">
  <PropertyGroup>
    <ProjectKind>Game</ProjectKind>
    <StartupFile>Preview.smile</StartupFile>
    <OutputName>LightningVfxPreview</OutputName>
    <ApplicationId>smile.examples.lightning-vfx-preview</ApplicationId>
    <Graphics>DirectX</Graphics>
    <VSync>true</VSync>
    <ResponsiveWindow>true</ResponsiveWindow>
    <RememberWindowPlacement>true</RememberWindowPlacement>
  </PropertyGroup>
  <ItemGroup>
    <SmileSource Include="Preview.smile" StartupOnly="true" />
    <Asset Include="Assets\Lightning\*.png" />
    <SmileProjectReference Include="..\..\libraries\Smile.Simple3D\Smile.Simple3D.smilelibproj" />
  </ItemGroup>
</SmileProject>
