Option Explicit

Import Smile.Simple3D.Core As Core
Import Smile.Simple3D.Effects3D As Effects3D
Import Smile.Simple3D.Graphics3D As Graphics3D
Import Smile.Simple3D.Scene3D As Scene3D

Dim Failures As Number
Dim Checks As Number

Game Window "Renderer3D M6 VFX Tests" Size 320 By 240

Do

    Call RunTests()

Loop Until True

If Failures = 0 Then
    Print "Renderer3D M6 VFX tests passed"
Else
    Print "Renderer3D M6 VFX tests failed: "; Failures
End If

Sub RunTests()

    Dim AdditiveMaterial As Core.Material3D
    Dim AlphaMaterial As Core.Material3D
    Dim Atlas As Core.Texture3D
    Dim Camera As Core.Camera3D
    Dim Index As Number
    Dim Particle As Core.ParticleBatch3D
    Dim Ribbon As Core.RibbonBatch3D
    Dim StaleParticle As Core.ParticleBatch3D
    Dim SubmissionToken As Number

    Call Graphics3D.ResetRenderer3D()

    Camera = Graphics3D.DefaultCamera()
    Atlas = Graphics3D.LoadTexture3D("Assets\VfxAtlas.png")
    AlphaMaterial = Graphics3D.CreateEffectMaterial3D(
        Atlas,
        Graphics3D.MATERIAL_ALPHA_BLEND,
        80
    )
    AdditiveMaterial = Graphics3D.CreateEffectMaterial3D(
        Atlas,
        Graphics3D.MATERIAL_ALPHA_ADDITIVE,
        160
    )

    Call Check(Atlas.Handle <> 0)
    Call Check(AlphaMaterial.Handle <> 0)
    Call Check(AdditiveMaterial.Handle <> 0)
    Call Check(Graphics3D.LiveObjectCount3D() = 0)
    Call Check(Graphics3D.VfxValue3D(Graphics3D.VFX_QUERY_MAX_PARTICLE_BATCHES) = 16)
    Call Check(Graphics3D.VfxValue3D(Graphics3D.VFX_QUERY_MAX_RIBBON_BATCHES) = 16)
    Call Check(Graphics3D.VfxValue3D(Graphics3D.VFX_QUERY_MAX_STAGED_PARTICLES) = 8192)
    Call Check(Graphics3D.VfxValue3D(Graphics3D.VFX_QUERY_MAX_STAGED_RIBBON_POINTS) = 2048)

    Particle = Graphics3D.CreateParticleBatch3D(
        1024,
        AdditiveMaterial,
        Graphics3D.VFX_BILLBOARD_CAMERA,
        4,
        4
    )
    Ribbon = Graphics3D.CreateRibbonBatch3D(4, AlphaMaterial)

    Call Check(Particle.Handle <> 0)
    Call Check(Ribbon.Handle <> 0)
    Call Check(Graphics3D.LiveParticleBatchCount3D() = 1)
    Call Check(Graphics3D.LiveRibbonBatchCount3D() = 1)
    Call Check(Graphics3D.VfxValue3D(Graphics3D.VFX_QUERY_RESOURCE_CAPACITY, Particle.Handle) = 1024)

    For Index = 0 To 1023

        Call Check(Graphics3D.SetParticle3D(
            Particle,
            Index,
            Index Mod 32 - 16,
            Index / 32,
            50,
            4,
            Index Mod 360,
            Index Mod 16
        ))
        Call Check(Graphics3D.SetParticleColor3D(
            Particle,
            Index,
            255,
            190,
            64,
            80
        ))
    End For

    Call Check(Graphics3D.CommitParticleBatch3D(Particle, 1024))
    Call Check(Graphics3D.VfxValue3D(Graphics3D.VFX_QUERY_RESOURCE_REVISION, Particle.Handle) = 1)
    Call Check(Not Graphics3D.CommitParticleBatch3D(Particle, 1025))
    Call Check(Graphics3D.VfxValue3D(Graphics3D.VFX_QUERY_RESOURCE_REVISION, Particle.Handle) = 1)

    For Index = 0 To 3

        Call Check(Graphics3D.SetRibbonPoint3D(
            Ribbon,
            Index,
            Index * 10,
            0,
            50,
            Index * 10,
            8,
            50,
            Index * 1000 / 3
        ))
        Call Check(Graphics3D.SetRibbonPointColor3D(Ribbon, Index, 80, 190, 255, 75))
    End For

    Call Check(Graphics3D.CommitRibbonBatch3D(Ribbon, 4))
    Call Check(Graphics3D.ConfigureShadows3D(
        True,
        Graphics3D.SHADOW_CASTER_DIRECTIONAL,
        0,
        1024,
        500,
        600
    ))
    Call Check(Graphics3D.ConfigurePostProcessing3D(True, True, True, 125, 1100, 90, 2, 2, 4))
    Call Check(Graphics3D.Begin3D(Camera, 0, 0, 0))

    SubmissionToken = Graphics3D.BeginSubmissionGroup3D(2)

    Call Check(SubmissionToken <> 0)
    Call Check(Graphics3D.DrawParticleBatch3D(Particle))
    Call Check(Graphics3D.DrawRibbonBatch3D(Ribbon))
    Call Check(Not Graphics3D.SetParticle3D(Particle, 0, 0, 0, 0, 4, 0, 0))
    Call Check(Graphics3D.LastError() = 56)
    Call Check(Not Graphics3D.TryDestroyParticleBatch3D(Particle))
    Call Check(Graphics3D.CommitSubmissionGroup3D(SubmissionToken))
    Call Check(Graphics3D.End3DChecked())
    Call Check(Graphics3D.ParticleDrawCount3D() = 1)
    Call Check(Graphics3D.RibbonDrawCount3D() = 1)
    Call Check(Graphics3D.ParticleTriangleCount3D() = 2048)
    Call Check(Graphics3D.RibbonTriangleCount3D() = 6)
    Call Check(Graphics3D.VfxValue3D(Graphics3D.VFX_QUERY_IN_FLIGHT_BATCHES) = 0)
    Call Check(Graphics3D.M5Value3D(Graphics3D.M5_QUERY_SHADOW_DRAWS, 0) = 0)
    Call Check(Graphics3D.SetParticle3D(Particle, 0, 0, 0, 0, 4, 0, 0))

    Call RunEffectsTests(AlphaMaterial, AdditiveMaterial)

    StaleParticle = Particle

    Call Check(Graphics3D.TryDestroyParticleBatch3D(Particle))
    Call Check(Not Graphics3D.ParticleBatchHandleValid3D(StaleParticle))
    Call Check(Graphics3D.TryDestroyRibbonBatch3D(Ribbon))
    Call Check(Graphics3D.LiveParticleBatchCount3D() = 0)
    Call Check(Graphics3D.LiveRibbonBatchCount3D() = 0)

    Call Graphics3D.DestroyEffectMaterial3D(AlphaMaterial)
    Call Graphics3D.DestroyEffectMaterial3D(AdditiveMaterial)
    Call Graphics3D.DestroyTexture3D(Atlas)
    Call Graphics3D.ResetRenderer3D()

    Call Check(Graphics3D.LiveParticleBatchCount3D() = 0)
    Call Check(Graphics3D.LiveRibbonBatchCount3D() = 0)
    Call Check(Graphics3D.LiveObjectCount3D() = 0)

End Sub

Sub RunEffectsTests(AlphaMaterial As Core.Material3D, AdditiveMaterial As Core.Material3D)

    Dim AudioRequest As Effects3D.AudioCueRequest3D
    Dim Effect As Effects3D.Effect
    Dim FirstRotation As Number
    Dim FirstVelocityX As Number
    Dim Index As Number
    Dim Rejected As Effects3D.Effect
    Dim RibbonMaterial As Core.Material3D
    Dim LightRequest As Effects3D.TransientLightRequest3D
    Dim SecondRotation As Number
    Dim SecondVelocityX As Number
    Dim TimedPreset As Effects3D.EffectPreset

    RibbonMaterial = AlphaMaterial

    Call Check(Effects3D.Initialize(
        AlphaMaterial,
        AdditiveMaterial,
        RibbonMaterial,
        Scene3D.QUALITY_HIGH
    ))
    Call Check(Effects3D.DefineStandardPresets())
    Call Check(Effects3D.EmitterCount(Effects3D.PRESET_FIRE_BURST) = 2)

    TimedPreset.Id = 50
    TimedPreset.Name = "Timed Emitter Test"
    TimedPreset.ParticleCount = 4
    TimedPreset.DelayMilliseconds = 20
    TimedPreset.SpawnIntervalMilliseconds = 10
    TimedPreset.LifetimeMilliseconds = 500
    TimedPreset.Speed = 20
    TimedPreset.Spread = 5
    TimedPreset.Gravity = -5
    TimedPreset.DragPercent = 2
    TimedPreset.StartRed = 255
    TimedPreset.StartGreen = 255
    TimedPreset.StartBlue = 255
    TimedPreset.EndRed = 0
    TimedPreset.EndGreen = 0
    TimedPreset.EndBlue = 0
    TimedPreset.StartOpacity = 80
    TimedPreset.EndOpacity = 10
    TimedPreset.StartSize = 8
    TimedPreset.EndSize = 2
    TimedPreset.BlendMode = Graphics3D.MATERIAL_ALPHA_BLEND
    TimedPreset.BillboardMode = Graphics3D.VFX_BILLBOARD_VERTICAL
    TimedPreset.AtlasFirstFrame = 0
    TimedPreset.AtlasFrameCount = 4
    TimedPreset.QualityLowPercent = 100
    TimedPreset.QualityMediumPercent = 100
    TimedPreset.QualityHighPercent = 100

    Call Check(Effects3D.DefinePreset(TimedPreset))

    Effect = Effects3D.Spawn(TimedPreset.Id, 0, 20, 50, 77)

    Call Check(Effects3D.ReservedParticleCount() = 4)
    Call Check(Effects3D.ActiveParticleCount() = 0)
    Call Check(Effects3D.Update(20))
    Call Check(Effects3D.ActiveParticleCount() = 1)
    Call Check(Effects3D.Update(30))
    Call Check(Effects3D.ActiveParticleCount() = 4)
    Call Check(Effects3D.StopEffect(Effect))

    Effect = Effects3D.Spawn(Effects3D.PRESET_FIRE_BURST, 0, 20, 50, 12345)
    LightRequest = Effects3D.TakeTransientLight()
    AudioRequest = Effects3D.TakeAudioCue()

    Call Check(Effects3D.IsActive(Effect))
    Call Check(LightRequest.Available)
    Call Check(LightRequest.RedValue = 255)
    Call Check(AudioRequest.Available)
    Call Check(AudioRequest.CueId = Effects3D.PRESET_FIRE_BURST)
    Call Check(Effects3D.Update(100))

    FirstVelocityX = Effects3D.ParticleValue(0, Effects3D.PARTICLE_VALUE_VELOCITY_X)
    FirstRotation = Effects3D.ParticleValue(0, Effects3D.PARTICLE_VALUE_ROTATION)

    Call Check(Effects3D.StopEffect(Effect))
    Call Check(Effects3D.ActiveParticleCount() = 0)
    Call Effects3D.Shutdown()
    Call Check(Effects3D.Initialize(
        AlphaMaterial,
        AdditiveMaterial,
        RibbonMaterial,
        Scene3D.QUALITY_HIGH
    ))
    Call Check(Effects3D.DefineStandardPresets())

    Effect = Effects3D.Spawn(Effects3D.PRESET_FIRE_BURST, 0, 20, 50, 12345)

    For Index = 1 To 10
        Call Check(Effects3D.Update(10))
    End For

    SecondVelocityX = Effects3D.ParticleValue(0, Effects3D.PARTICLE_VALUE_VELOCITY_X)
    SecondRotation = Effects3D.ParticleValue(0, Effects3D.PARTICLE_VALUE_ROTATION)

    Call Check(FirstVelocityX = SecondVelocityX)
    Call Check(FirstRotation = SecondRotation)
    Call Check(Effects3D.ParticleValue(0, Effects3D.PARTICLE_VALUE_AGE) = 100)
    Call Check(Effects3D.StopEffect(Effect))

    Effect = Effects3D.Spawn(Effects3D.PRESET_FIRE_BURST, 0, 20, 50, 12346)

    Call Check(Effects3D.ParticleValue(0, Effects3D.PARTICLE_VALUE_VELOCITY_X) <> FirstVelocityX Or
        Effects3D.ParticleValue(0, Effects3D.PARTICLE_VALUE_ROTATION) <> FirstRotation)
    Call Check(Effects3D.StopEffect(Effect))
    Call Check(Effects3D.Update(300))
    Call Check(Effects3D.ClampedUpdates() = 1)
    Call Check(Effects3D.DroppedSimulationMilliseconds() = 50)

    For Index = 1 To 8

        Effect = Effects3D.Spawn(
            Effects3D.PRESET_DRAGON_FIRE_BREATH,
            Index * 4,
            20,
            50,
            Index
        )

        Call Check(Effects3D.IsActive(Effect))
    End For

    Rejected = Effects3D.Spawn(Effects3D.PRESET_DRAGON_FIRE_BREATH, 0, 20, 50, 100)

    Call Check(Not Effects3D.IsActive(Rejected))
    Call Check(Effects3D.DroppedEffects() = 1)
    Call Check(Effects3D.ActiveParticleCount() = 2048)
    Call Check(Effects3D.ReservedParticleCount() = 2048)
    Call Check(Effects3D.Commit())
    Call Effects3D.Shutdown()
    Call Check(Graphics3D.LiveParticleBatchCount3D() = 1)
    Call Check(Graphics3D.LiveRibbonBatchCount3D() = 1)

    Call Check(Effects3D.Initialize(
        AlphaMaterial,
        AdditiveMaterial,
        RibbonMaterial,
        Scene3D.QUALITY_LOW
    ))
    Call Check(Effects3D.ParticleCapacity() = 256)
    Call Effects3D.Shutdown()
    Call Effects3D.Shutdown()

End Sub

Sub Check(Condition As Boolean)

    Checks = Checks + 1

    If Not Condition Then
        Failures = Failures + 1
    End If

End Sub
