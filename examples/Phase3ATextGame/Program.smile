Option Explicit

Game Window "SMILE 2.0 Phase 3A" Size 800 By 450

Dim Caption As Text
Caption = GetCaption()

Do
    Clear Rgb(8, 16, 32)
    Draw Text Caption At 400, 220 Size 28 Color CYAN Centered
    Show Screen
    Wait 16 Milliseconds
Loop Until Game_Closed() = True

End Program

Function GetCaption() As Text
    Return "First-Class Text — Café"
End Function
