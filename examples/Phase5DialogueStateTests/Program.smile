Option Explicit

Import Smile.UI.Core As UI
Import Smile.UI.Dialogue As Dialogues

Game Window "Phase 5 Dialogue State Tests" Size 320 By 200

Dim Style As UI.DialogueStyle
Dim NarrowStyle As UI.DialogueStyle
Dim GalleryStyle As UI.DialogueStyle
Dim ActiveStyle As UI.DialogueStyle
Dim FailedStyle As UI.DialogueStyle
Dim Message As Dialogues.Dialogue
Dim NarrowMessage As Dialogues.Dialogue
Dim GalleryMessage As Dialogues.Dialogue
Dim Index As Number
Dim OperationSucceeded As Boolean
Dim Failures As Number
Dim CheckNumber As Number
Dim OldVisible As Number
Dim OldPage As Number
Dim LongValue As Text

Style.Window.Padding.Left = 10
Style.Window.Padding.Top = 10
Style.Window.Padding.Right = 10
Style.Window.Padding.Bottom = 10
Style.Text.Mode = UI.UI_TEXT_SYSTEM
Style.Text.SystemSize = 20
Style.Text.SystemColor = WHITE
Style.CharactersPerSecond = 0
Style.LineSpacing = 0

Message = New Dialogues.Dialogue(Style, 0, 0, 300, 150)
OperationSucceeded = Message.AddPage("One")
OperationSucceeded = Message.AddPage("Two")

Call Check(Message.Start(0))
Call Check(Message.PageCount = 2)
Call Check(Message.VisibleCharacters = 3)
Call Check(Message.HandleKey(KEY_ENTER, 0) = UI.UI_EVENT_ADVANCED)
Call Check(Message.CurrentPage = 1)
Call Check(Message.HandleKey(KEY_ENTER, 0) = UI.UI_EVENT_COMPLETED)
Call Check(Message.Complete)

GalleryStyle = Style
GalleryStyle.Window.Padding.Left = 28
GalleryStyle.Window.Padding.Top = 24
GalleryStyle.Window.Padding.Right = 24
GalleryStyle.Window.Padding.Bottom = 22
GalleryStyle.Text.SystemSize = 25
GalleryStyle.Text.LineSpacing = 5
GalleryStyle.LineSpacing = 5
GalleryMessage = New Dialogues.Dialogue(GalleryStyle, 438, 290, 470, 205)
OperationSucceeded = GalleryMessage.AddPage("Save-game encoding belongs to a later RPG component. The generic persistent Data primitive is already available underneath it.")

Call Check(GalleryMessage.Start(0))
Call Check(GalleryMessage.PageCount >= 1 And GalleryMessage.PageCount <= 2)
Call GalleryMessage.Destroy()

Call Message.ClearPages()

Style.CharactersPerSecond = 10
OperationSucceeded = Message.SetStyle(Style)
OperationSucceeded = Message.AddPage("A😀B")

Call Check(Message.Start(100))
Call Check(Message.Update(200) = UI.UI_EVENT_CHANGED)
Call Check(Message.VisibleCharacters = 1)
Call Check(Message.HandleKey(KEY_ENTER, 200) = UI.UI_EVENT_CHANGED)
Call Check(Message.VisibleCharacters = 3)
Call Check(Message.HandleKey(KEY_ENTER, 200) = UI.UI_EVENT_COMPLETED)
Call Check(Message.Complete)

Call Message.ClearPages()

OperationSucceeded = Message.AddPage("Active Style Change Keeps This Page Visible")

Call Check(Message.Start(100))

OperationSucceeded = Message.Update(400) = UI.UI_EVENT_CHANGED
OldVisible = Message.VisibleCharacters
OldPage = Message.CurrentPage
ActiveStyle = Style
ActiveStyle.Text.SystemSize = 22

Call Check(Message.SetStyle(ActiveStyle))
Call Check(Message.Active)
Call Check(Message.VisibleCharacters = OldVisible)
Call Check(Message.CurrentPage = OldPage)

FailedStyle = ActiveStyle
FailedStyle.Window.Padding.Left = 150
FailedStyle.Window.Padding.Right = 150

Call Check(Not Message.SetStyle(FailedStyle))
Call Check(Message.Active)
Call Check(Message.VisibleCharacters = OldVisible)
Call Check(Message.CurrentPage = OldPage)
Call Check(Message.HandleKey(KEY_ENTER, 400) = UI.UI_EVENT_CHANGED)
Call Check(Message.HandleKey(KEY_ENTER, 400) = UI.UI_EVENT_COMPLETED)

Call Message.ClearPages()

OperationSucceeded = Message.AddPage("Cancel")

Call Check(Message.Start(0))
Call Check(Message.HandleKey(KEY_ESCAPE, 0) = UI.UI_EVENT_CANCELLED)
Call Check(Not Message.Active)

Call Message.ClearPages()

Style.CharactersPerSecond = 0
OperationSucceeded = Message.SetStyle(Style)
OperationSucceeded = Message.AddPage("")

Call Check(Message.Start(0))
Call Check(Message.VisibleCharacters = 0)
Call Check(Message.HandleKey(KEY_ENTER, 0) = UI.UI_EVENT_COMPLETED)

Call Message.ClearPages()

Style = ActiveStyle
Style.CharactersPerSecond = 0
OperationSucceeded = Message.SetStyle(Style)
OperationSucceeded = Message.AddPage("One

Three
")

Call Check(OperationSucceeded)
Call Check(Message.Start(0))
Call Check(Message.PageCount = 1)
Call Check(Message.HandleKey(KEY_ENTER, 0) = UI.UI_EVENT_COMPLETED)

Call Message.ClearPages()

For Index = 1 To UI.UI_MAX_DIALOGUE_PAGE_SCALARS - 1
    LongValue = LongValue + "A"
End For

Call Check(Message.AddPage(LongValue))
Call Message.ClearPages()

LongValue = LongValue + "A"

Call Check(Message.AddPage(LongValue))
Call Check(Message.PageCount = 1)

LongValue = LongValue + "A"

Call Check(Not Message.AddPage(LongValue))
Call Check(Message.PageCount = 1)
Call Check(Message.Start(0))

NarrowStyle = Style
NarrowStyle.Window.Padding.Left = 45
NarrowStyle.Window.Padding.Right = 45
NarrowStyle.Window.Padding.Top = 35
NarrowStyle.Window.Padding.Bottom = 35
NarrowMessage = New Dialogues.Dialogue(NarrowStyle, 0, 0, 100, 100)

Call Check(NarrowMessage.AddPage("Abcdefghijklmnopqrstuvwxyz0123456789"))
Call Check(Not NarrowMessage.Start(0))

Call NarrowMessage.ClearPages()
Call Check(NarrowMessage.AddPage("A"))
Call Check(NarrowMessage.Start(0))

OldVisible = NarrowMessage.VisibleCharacters
OldPage = NarrowMessage.CurrentPage
LongValue = ""

For Index = 1 To UI.UI_MAX_DIALOGUE_PAGE_SCALARS
    LongValue = LongValue + "A"
End For

For Index = 1 To UI.UI_MAX_DIALOGUE_PAGES - 1
    Call Check(NarrowMessage.AddPage(LongValue))
End For

Call Check(Not NarrowMessage.Start(0))
Call Check(NarrowMessage.Active)
Call Check(NarrowMessage.VisibleCharacters = OldVisible)
Call Check(NarrowMessage.CurrentPage = OldPage)

Call NarrowMessage.ClearPages()

For Index = 0 To 31
    OperationSucceeded = NarrowMessage.AddPage("A")
End For

Call Check(Not NarrowMessage.AddPage("Overflow"))
Call Check(NarrowMessage.Start(0))
Call Check(NarrowMessage.PageCount = 32)

Call NarrowMessage.Destroy()
Call Message.Destroy()

Save Failures To "Result"
Print Failures

Sub Check(Condition As Boolean)

    CheckNumber = CheckNumber + 1

    If Not Condition Then
        Failures = Failures + 1
        Print CheckNumber
    End If

End Sub

End Program
