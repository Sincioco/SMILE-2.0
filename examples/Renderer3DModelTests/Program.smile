Option Explicit

Import Smile.Simple3D.Core As Core
Import Smile.Simple3D.Graphics3D As Graphics3D

Const RELOAD_CYCLES = 100

Dim Camera As Core.Camera3D
Dim Humanoid As Core.Model3D
Dim Dragon As Core.Model3D
Dim BadMagic As Core.Model3D
Dim BadVersion As Core.Model3D
Dim Missing As Core.Model3D
Dim Reloaded As Core.Model3D
Dim EmptyTexture As Core.Texture3D
Dim Armor As Core.Material3D
Dim Scales As Core.Material3D
Dim HumanoidPart As Core.Object3D
Dim DragonBody As Core.Object3D
Dim DragonWings As Core.Object3D
Dim Failures As Number
Dim FrameReady As Boolean
Dim MaterialBindingsReady As Boolean
Dim Index As Number
Dim StaleHandle As Number

Game Window "Renderer3D Model Tests" Size 480 By 270

Call Graphics3D.ResetRenderer3D()

BadMagic = Graphics3D.LoadModel3D("Assets\BadMagic.sm3d")
BadVersion = Graphics3D.LoadModel3D("Assets\BadVersion.sm3d")
Missing = Graphics3D.LoadModel3D("Assets\Missing.sm3d")

If (BadMagic.Handle <> 0 Or
    BadVersion.Handle <> 0 Or
    Missing.Handle <> 0 Or
    Graphics3D.LiveModelCount3D() <> 0 Or
    Graphics3D.LiveMeshCount3D() <> 0) Then
    Failures = Failures + 1
End If

Humanoid = Graphics3D.LoadModel3D("Assets\Humanoid.sm3d")
Dragon = Graphics3D.LoadModel3D("Assets\Dragon.sm3d")

If (Humanoid.Handle = 0 Or
    Humanoid.PartCount <> 1 Or
    Humanoid.MaterialCount <> 1 Or
    Dragon.Handle = 0 Or
    Dragon.PartCount <> 2 Or
    Dragon.MaterialCount <> 2 Or
    Graphics3D.ModelPartMaterial3D(Humanoid, 0) <> 0 Or
    Graphics3D.ModelPartMaterial3D(Dragon, 0) <> 0 Or
    Graphics3D.ModelPartMaterial3D(Dragon, 1) <> 1 Or
    Graphics3D.LiveModelCount3D() <> 2 Or
    Graphics3D.LiveMeshCount3D() <> 3) Then
    Failures = Failures + 1
End If

Armor = Graphics3D.CreateMaterial3D(
    EmptyTexture,
    Graphics3D.MATERIAL_ALPHA_OPAQUE,
    64,
    192,
    255,
    100,
    False,
    20,
    50
)
Scales = Graphics3D.CreateMaterial3D(
    EmptyTexture,
    Graphics3D.MATERIAL_ALPHA_OPAQUE,
    255,
    96,
    64,
    100,
    False,
    40,
    50
)

HumanoidPart = Graphics3D.CreateModelPart3D(Humanoid, 0)
DragonBody = Graphics3D.CreateModelPart3D(Dragon, 0)
DragonWings = Graphics3D.CreateModelPart3D(Dragon, 1)

MaterialBindingsReady = Graphics3D.SetObjectMaterial3D(HumanoidPart, Armor)
MaterialBindingsReady = MaterialBindingsReady And Graphics3D.SetObjectMaterial3D(DragonBody, Scales)
MaterialBindingsReady = MaterialBindingsReady And Graphics3D.SetObjectMaterial3D(DragonWings, Scales)

Call Graphics3D.SetObjectPosition(HumanoidPart, -55, 0, 0)
Call Graphics3D.SetObjectPosition(DragonBody, 55, 0, 0)
Call Graphics3D.SetObjectPosition(DragonWings, 55, 0, 2)
Call Graphics3D.SetObjectScale(HumanoidPart, 3500, 7000, 3500)
Call Graphics3D.SetObjectScale(DragonBody, 6000, 4000, 6000)
Call Graphics3D.SetObjectScale(DragonWings, 9000, 3000, 6000)

If (HumanoidPart.Handle = 0 Or
    DragonBody.Handle = 0 Or
    DragonWings.Handle = 0 Or
    Not MaterialBindingsReady Or
    Graphics3D.LiveObjectCount3D() <> 3 Or
    Graphics3D.MaterialReferenceCount3D(Scales.Handle) <> 2) Then
    Failures = Failures + 1
End If

StaleHandle = Dragon.Handle

Call Graphics3D.DestroyModel3D(Dragon)

If Dragon.Handle = 0 Or Not Graphics3D.ModelHandleValid3D(StaleHandle) Then
    Failures = Failures + 1
End If

If Graphics3D.RendererAvailable() Then

    Camera = Graphics3D.DefaultCamera()
    FrameReady = Graphics3D.Begin3D(Camera, 2, 5, 14)
    FrameReady = FrameReady And Graphics3D.DrawObject3D(HumanoidPart)
    FrameReady = FrameReady And Graphics3D.DrawObject3D(DragonBody)
    FrameReady = FrameReady And Graphics3D.DrawObject3D(DragonWings)

    If Not FrameReady Then
        Failures = Failures + 1
    End If

    Call Graphics3D.End3D()

End If

Fill Rectangle 0, 0, 480, 270, Rgb(2, 5, 14)
Draw Text "DETERMINISTIC MODEL PIPELINE" At 75, 118 Size 19 Color WHITE
Show Screen

Call Graphics3D.DestroyObjectInstance3D(HumanoidPart)
Call Graphics3D.DestroyObjectInstance3D(DragonBody)
Call Graphics3D.DestroyObjectInstance3D(DragonWings)
Call Graphics3D.DestroyModel3D(Humanoid)
Call Graphics3D.DestroyModel3D(Dragon)
Call Graphics3D.DestroyMaterial3D(Armor)
Call Graphics3D.DestroyMaterial3D(Scales)

If (Graphics3D.ModelHandleValid3D(StaleHandle) Or
    Graphics3D.LiveModelCount3D() <> 0 Or
    Graphics3D.LiveMeshCount3D() <> 0 Or
    Graphics3D.LiveObjectCount3D() <> 0 Or
    Graphics3D.LiveMaterialCount3D() <> 0) Then
    Failures = Failures + 1
End If

For Index = 0 To RELOAD_CYCLES - 1

    Reloaded = Graphics3D.LoadModel3D("Assets\Humanoid.sm3d")

    If (Reloaded.Handle = 0 Or
        Graphics3D.LiveModelCount3D() <> 1 Or
        Graphics3D.LiveMeshCount3D() <> 1) Then
        Failures = Failures + 1
    End If

    Call Graphics3D.DestroyModel3D(Reloaded)

    If Graphics3D.LiveModelCount3D() <> 0 Or Graphics3D.LiveMeshCount3D() <> 0 Then
        Failures = Failures + 1
    End If

End For

Call Graphics3D.ResetRenderer3D()

If Failures = 0 Then
    Print "Renderer3D model tests passed"
Else
    Print "Renderer3D model tests failed: "; Failures
End If
