<SmileProject Version="1.0">
  <PropertyGroup>
    <ProjectKind>Game</ProjectKind>
    <StartupFile>Program.smile</StartupFile>
    <OutputName>MenuGalleryPackage</OutputName>
    <GraphicsBackend>Auto</GraphicsBackend>
    <VSync>true</VSync>
  </PropertyGroup>
  <ItemGroup>
    <SmileSource Include="Program.smile" StartupOnly="true" />
    <SmileLibraryReference Include="..\..\artifacts\libraries\Smile.UI.smilelib" />
    <Asset Include="Assets\**\*" />
  </ItemGroup>
</SmileProject>
