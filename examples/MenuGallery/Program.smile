Option Explicit

Import Smile.UI.Core As UI
Import Smile.UI.BitmapFont As BitmapFont
Import Smile.UI.Menu As Menus
Import Smile.UI.Dialogue As Dialogues

Game Window "SMILE 2.0 Menu Gallery" Size 960 By 540

Dim Background As Image
Dim WindowSkin As Image
Dim CursorImage As Image
Dim ContinueImage As Image
Dim FontAtlas As Image
Dim FontDefinition As UI.BitmapFontStyle
Dim FontHandle As Number

Dim SkinWindow As UI.WindowStyle
Dim VectorWindow As UI.WindowStyle
Dim SystemText As UI.TextStyle
Dim SystemSelectedText As UI.TextStyle
Dim SystemDisabledText As UI.TextStyle
Dim BitmapText As UI.TextStyle
Dim BitmapSelectedText As UI.TextStyle
Dim BitmapDisabledText As UI.TextStyle
Dim MenuStyle As UI.MenuStyle
Dim WrapMenuStyle As UI.MenuStyle
Dim DialogueStyle As UI.DialogueStyle
Dim NavigatorStyle As UI.MenuNavigatorStyle

Dim RootMenu As Menus.Menu
Dim CategoryMenu As Menus.Menu
Dim OptionMenu As Menus.Menu
Dim DetailMenu As Menus.Menu
Dim Navigator As Menus.MenuNavigator
Dim Message As Dialogues.Dialogue
Dim RootSharedIndex As Number
Dim RootDisabledIndex As Number
Dim RootHierarchyIndex As Number
Dim CategoryOptionIndex As Number
Dim CategorySharedIndex As Number
Dim OptionDetailIndex As Number
Dim ItemIndex As Number
Dim Key As Number
Dim Event As Number
Dim UpdateEvent As Number
Dim AcceptedValue As Number
Dim OperationSucceeded As Boolean
Dim StyleChanged As Boolean
Dim Running As Boolean
Dim TestStage As Number

Load Image Background From "Assets\Background.png"
Load Image WindowSkin From "Assets\WindowSkin.png"
Load Image CursorImage From "Assets\Cursor.png"
Load Image ContinueImage From "Assets\Continue.png"
Load Image FontAtlas From "Assets\BitmapFont.png"

With FontDefinition
    .Atlas = FontAtlas
    .FirstCodePoint = 32
    .GlyphCount = 96
    .Columns = 16
    .SourceCellWidth = 64
    .SourceCellHeight = 64
    .DrawWidth = 25
    .DrawHeight = 25
    .AdvanceX = 21
    .LineHeight = 30
    .FallbackCodePoint = 63
    .FilterMode = UI.UI_FILTER_SMOOTH
End With
FontHandle = BitmapFont.Create(FontDefinition)

With SkinWindow
    .UseSkin = True
    .Skin = WindowSkin
    .SourceWidth = 768
    .SourceHeight = 768
    .SourceLeft = 192
    .SourceTop = 192
    .SourceRight = 192
    .SourceBottom = 192
    .DestinationLeft = 34
    .DestinationTop = 34
    .DestinationRight = 34
    .DestinationBottom = 34
    .FillColor = Rgb(15, 23, 48)
    .BorderColor = Rgb(120, 210, 255)
    .BorderThickness = 2
    .Opacity = 96
    .FilterMode = UI.UI_FILTER_SMOOTH

    With .Padding
        .Left = 34
        .Top = 28
        .Right = 28
        .Bottom = 26
    End With
End With

VectorWindow = SkinWindow
VectorWindow.UseSkin = False
VectorWindow.FillColor = Rgb(13, 19, 42)
VectorWindow.BorderColor = Rgb(98, 213, 255)
VectorWindow.BorderThickness = 3
VectorWindow.Padding.Left = 28
VectorWindow.Padding.Top = 24
VectorWindow.Padding.Right = 24
VectorWindow.Padding.Bottom = 22

SystemText.Mode = UI.UI_TEXT_SYSTEM
SystemText.SystemSize = 25
SystemText.SystemColor = WHITE
SystemText.LineSpacing = 5
SystemSelectedText = SystemText
SystemSelectedText.SystemColor = YELLOW
SystemDisabledText = SystemText
SystemDisabledText.SystemColor = DARK_GRAY

BitmapText.Mode = UI.UI_TEXT_BITMAP
BitmapText.SystemSize = 25
BitmapText.SystemColor = WHITE
BitmapText.BitmapFontHandle = FontHandle
BitmapText.LineSpacing = 5
BitmapSelectedText = BitmapText
BitmapDisabledText = BitmapText

MenuStyle.Window = SkinWindow
MenuStyle.NormalText = SystemText
MenuStyle.SelectedText = SystemSelectedText
MenuStyle.DisabledText = SystemDisabledText
MenuStyle.SelectionFillColor = Rgb(45, 77, 130)
MenuStyle.UseCursor = True
MenuStyle.Cursor = CursorImage
MenuStyle.CursorWidth = 30
MenuStyle.CursorHeight = 30
MenuStyle.CursorOffsetY = -2
MenuStyle.CursorFilterMode = UI.UI_FILTER_SMOOTH
MenuStyle.RowHeight = 43
MenuStyle.WrapSelection = True
MenuStyle.ShowScrollbar = True
MenuStyle.ShowSubmenuIndicator = True
MenuStyle.SubmenuIndicatorPosition = UI.UI_SUBMENU_INDICATOR_RIGHT_ALIGNED
MenuStyle.ItemTextOverflowMode = UI.UI_MENU_TEXT_ELLIPSIS
MenuStyle.ItemTextMaxLines = 1

WrapMenuStyle = MenuStyle
WrapMenuStyle.RowHeight = 78
WrapMenuStyle.ShowScrollbar = False
WrapMenuStyle.SubmenuIndicatorPosition = UI.UI_SUBMENU_INDICATOR_RIGHT_ALIGNED
WrapMenuStyle.ItemTextOverflowMode = UI.UI_MENU_TEXT_WRAP
WrapMenuStyle.ItemTextMaxLines = 2

DialogueStyle.Window = SkinWindow
DialogueStyle.Text = SystemText
DialogueStyle.CharactersPerSecond = 32
DialogueStyle.LineSpacing = 5
DialogueStyle.UseContinueIndicator = True
DialogueStyle.ContinueIndicator = ContinueImage
DialogueStyle.IndicatorWidth = 24
DialogueStyle.IndicatorHeight = 24
DialogueStyle.IndicatorOffsetX = -14
DialogueStyle.IndicatorOffsetY = -12
DialogueStyle.IndicatorBlinkMilliseconds = 420

' The root starts near the bottom. Deeper fixed-size menus force right placement,
' left fallback, upward adjustment, and overlap while remaining fully on-screen.
RootMenu = New Menus.Menu(
    MenuStyle,
    X:=200,
    Y:=250,
    Width:=600,
    Height:=200,
    VisibleRows:=5
)
CategoryMenu = New Menus.Menu(WrapMenuStyle, 0, 0, 280, 270, 3)
OptionMenu = New Menus.Menu(MenuStyle, 0, 0, 320, 240, 4)
DetailMenu = New Menus.Menu(MenuStyle, 0, 0, 400, 230, 4)

ItemIndex = RootMenu.AddItem("Quick Leaf", 10)
RootSharedIndex = RootMenu.AddItem("A Very Long Shared Library Category", 11)
RootDisabledIndex = RootMenu.AddItem("Disabled Library Section", 12, Enabled:=False)
RootHierarchyIndex = RootMenu.AddItem("Open Hierarchy", 13)
ItemIndex = RootMenu.AddItem("Exit Sample", 99)
ItemIndex = RootMenu.AddItem("Additional Root Action", 14)
ItemIndex = RootMenu.AddItem("More Root Content", 15)
ItemIndex = RootMenu.AddItem("Final Root Content", 16)

CategoryOptionIndex = CategoryMenu.AddItem("A Very Long Shared Library Command That Wraps Because It Is Long", 20, True)
CategorySharedIndex = CategoryMenu.AddItem("Shared Detail View", 21, True)
ItemIndex = CategoryMenu.AddItem("Category Leaf", 22, True)

OptionDetailIndex = OptionMenu.AddItem("Display Mode Details", 30, True)
ItemIndex = OptionMenu.AddItem("A Very Long Option Leaf That Ellipsizes Safely", 31, True)
ItemIndex = OptionMenu.AddItem("Option Leaf", 32, True)

ItemIndex = DetailMenu.AddItem("Deepest Accepted Leaf", 40, True)
ItemIndex = DetailMenu.AddItem("Another Long Detail Leaf That Must Ellipsize", 41, True)
ItemIndex = DetailMenu.AddItem("Final Action", 42, True)
ItemIndex = DetailMenu.AddItem("Detail Action Four", 43, True)
ItemIndex = DetailMenu.AddItem("Detail Action Five", 44, True)
ItemIndex = DetailMenu.AddItem("Detail Action Six", 45, True)
ItemIndex = DetailMenu.AddItem("Detail Action Seven", 46, True)
ItemIndex = DetailMenu.AddItem("Detail Action Eight", 47, True)

NavigatorStyle.Viewport.X = 0
NavigatorStyle.Viewport.Y = 0
NavigatorStyle.Viewport.Width = 960
NavigatorStyle.Viewport.Height = 540
NavigatorStyle.ViewportPadding.Left = 12
NavigatorStyle.ViewportPadding.Top = 12
NavigatorStyle.ViewportPadding.Right = 12
NavigatorStyle.ViewportPadding.Bottom = 12
NavigatorStyle.HorizontalGap = 8
NavigatorStyle.PreferredDirection = UI.UI_SUBMENU_DIRECTION_AUTO

Navigator = New Menus.MenuNavigator(RootMenu, NavigatorStyle)
Running = FontHandle > 0 And RootMenu.Valid And CategoryMenu.Valid And OptionMenu.Valid And DetailMenu.Valid And Navigator.Valid
OperationSucceeded = Navigator.BindSubmenu(
    RootMenu,
    RootSharedIndex,
    CategoryMenu,
    ResetChildSelection:=False
)
OperationSucceeded = OperationSucceeded And Navigator.BindSubmenu(
    RootMenu,
    RootDisabledIndex,
    DetailMenu,
    ResetChildSelection:=False
)
OperationSucceeded = OperationSucceeded And Navigator.BindSubmenu(RootMenu, RootHierarchyIndex, CategoryMenu)
OperationSucceeded = OperationSucceeded And Navigator.BindSubmenu(CategoryMenu, CategoryOptionIndex, OptionMenu)
OperationSucceeded = OperationSucceeded And Navigator.BindSubmenu(
    CategoryMenu,
    CategorySharedIndex,
    DetailMenu,
    ResetChildSelection:=False
)
OperationSucceeded = OperationSucceeded And Navigator.BindSubmenu(OptionMenu, OptionDetailIndex, DetailMenu)
RootMenu.SelectedIndex = RootHierarchyIndex
OperationSucceeded = OperationSucceeded And RootMenu.SelectedIndex = RootHierarchyIndex
Running = Running And OperationSucceeded

Message = New Dialogues.Dialogue(DialogueStyle, 38, 38, 450, 180)
Running = Running And Message.Valid

Do
    Get Key Key
    Event = UI.UI_EVENT_NONE
    StyleChanged = False

    If Key = KEY_1 Then

        MenuStyle.Window = SkinWindow
        MenuStyle.NormalText = SystemText
        MenuStyle.SelectedText = SystemSelectedText
        MenuStyle.DisabledText = SystemDisabledText
        WrapMenuStyle.Window = SkinWindow
        WrapMenuStyle.NormalText = SystemText
        WrapMenuStyle.SelectedText = SystemSelectedText
        WrapMenuStyle.DisabledText = SystemDisabledText
        DialogueStyle.Window = SkinWindow
        DialogueStyle.Text = SystemText
        StyleChanged = True

    Else If Key = KEY_2 Then

        MenuStyle.Window = SkinWindow
        MenuStyle.NormalText = BitmapText
        MenuStyle.SelectedText = BitmapSelectedText
        MenuStyle.DisabledText = BitmapDisabledText
        WrapMenuStyle.Window = SkinWindow
        WrapMenuStyle.NormalText = BitmapText
        WrapMenuStyle.SelectedText = BitmapSelectedText
        WrapMenuStyle.DisabledText = BitmapDisabledText
        DialogueStyle.Window = SkinWindow
        DialogueStyle.Text = BitmapText
        StyleChanged = True

    Else If Key = KEY_3 Then

        MenuStyle.Window = VectorWindow
        MenuStyle.NormalText = SystemText
        MenuStyle.SelectedText = SystemSelectedText
        MenuStyle.DisabledText = SystemDisabledText
        WrapMenuStyle.Window = VectorWindow
        WrapMenuStyle.NormalText = SystemText
        WrapMenuStyle.SelectedText = SystemSelectedText
        WrapMenuStyle.DisabledText = SystemDisabledText
        DialogueStyle.Window = VectorWindow
        DialogueStyle.Text = SystemText
        StyleChanged = True

    Else If Key = KEY_W Then

        MenuStyle.ShowSubmenuIndicator = False
        WrapMenuStyle.ShowSubmenuIndicator = False
        StyleChanged = True

    Else If Key = KEY_A Then

        MenuStyle.ShowSubmenuIndicator = True
        MenuStyle.SubmenuIndicatorPosition = UI.UI_SUBMENU_INDICATOR_AFTER_TEXT
        WrapMenuStyle.ShowSubmenuIndicator = True
        WrapMenuStyle.SubmenuIndicatorPosition = UI.UI_SUBMENU_INDICATOR_AFTER_TEXT
        WrapMenuStyle.UseCursor = True
        StyleChanged = True

    Else If Key = KEY_S Then

        MenuStyle.ShowSubmenuIndicator = True
        MenuStyle.SubmenuIndicatorPosition = UI.UI_SUBMENU_INDICATOR_RIGHT_ALIGNED
        WrapMenuStyle.ShowSubmenuIndicator = True
        WrapMenuStyle.SubmenuIndicatorPosition = UI.UI_SUBMENU_INDICATOR_RIGHT_ALIGNED
        StyleChanged = True

    Else If Key = KEY_D Then

        MenuStyle.ShowScrollbar = Not MenuStyle.ShowScrollbar
        WrapMenuStyle.ShowScrollbar = MenuStyle.ShowScrollbar
        StyleChanged = True

    Else If (Key = KEY_OTHER Or
        Key = KEY_X Or
        Key = KEY_Y Or
        Key = KEY_E Or
        Key = KEY_P) Then

        If TestStage = 0 Then

            RootMenu.SelectedIndex = RootSharedIndex
            OperationSucceeded = RootMenu.SelectedIndex = RootSharedIndex
            OperationSucceeded = OperationSucceeded And Navigator.Depth = 1
            WrapMenuStyle.UseCursor = False

        Else If TestStage = 1 Then

            MenuStyle.CursorOffsetY = 0
            WrapMenuStyle.CursorOffsetY = 0

        Else If TestStage = 2 Then

            MenuStyle.CursorOffsetY = 8
            WrapMenuStyle.CursorOffsetY = 8

        Else If TestStage = 3 Then

            MenuStyle.CursorOffsetY = -20
            WrapMenuStyle.CursorOffsetY = -20

        Else If TestStage = 4 Then

            MenuStyle.CursorHeight = 96
            WrapMenuStyle.CursorHeight = 96

        Else If TestStage = 5 Then

            MenuStyle.CursorHeight = 30
            MenuStyle.CursorOffsetY = -2
            WrapMenuStyle.CursorHeight = 30
            WrapMenuStyle.CursorOffsetY = -2

        Else If TestStage = 6 Then

            MenuStyle.ItemTextOverflowMode = UI.UI_MENU_TEXT_CLIP
            WrapMenuStyle.ItemTextOverflowMode = UI.UI_MENU_TEXT_CLIP

        Else If TestStage = 7 Then

            MenuStyle.ItemTextOverflowMode = UI.UI_MENU_TEXT_ELLIPSIS
            WrapMenuStyle.ItemTextOverflowMode = UI.UI_MENU_TEXT_WRAP

        End If

        TestStage = TestStage + 1
        StyleChanged = True
        Running = Running And OperationSucceeded

    Else If Message.Active Then

        Event = Message.HandleKey(Key, Timer())

    Else

        Event = Navigator.Update(Key)

        If Event = UI.UI_EVENT_ACCEPTED Then

            AcceptedValue = Navigator.LastAcceptedValue

            Call Message.ClearPages()

            If AcceptedValue = 99 Then
                OperationSucceeded = Message.AddPage("The reusable hierarchical menu demonstration is complete. Press Enter again to close the sample.")
            Else
                OperationSucceeded = Message.AddPage("A leaf item was accepted through MenuNavigator. The game owns this reaction while the reusable library owns stack routing, cursors, indicators, and placement.")
            End If

            If OperationSucceeded Then
                OperationSucceeded = Message.AddPage("Right, Enter, or Space opens a submenu. Left or Escape closes one level. Escape at the root returns the normal cancel event.")
            End If

            If OperationSucceeded Then
                OperationSucceeded = Message.Start(Timer())
            End If

            Running = Running And OperationSucceeded

        End If

    End If

    If StyleChanged Then

        OperationSucceeded = RootMenu.SetStyle(MenuStyle)
        OperationSucceeded = OperationSucceeded And CategoryMenu.SetStyle(WrapMenuStyle)
        OperationSucceeded = OperationSucceeded And OptionMenu.SetStyle(MenuStyle)
        OperationSucceeded = OperationSucceeded And DetailMenu.SetStyle(MenuStyle)
        OperationSucceeded = OperationSucceeded And Message.SetStyle(DialogueStyle)
        OperationSucceeded = OperationSucceeded And Navigator.Relayout()
        Running = Running And OperationSucceeded

    End If

    If Event = UI.UI_EVENT_CHANGED Then

        Play Sound "Assets\Move.wav" On Channel 1

    Else If (Event = UI.UI_EVENT_SUBMENU_OPENED Or
        Event = UI.UI_EVENT_ACCEPTED Or
        Event = UI.UI_EVENT_ADVANCED) Then

        Play Sound "Assets\Confirm.wav" On Channel 2

    Else If Event = UI.UI_EVENT_SUBMENU_CLOSED Or Event = UI.UI_EVENT_CANCELLED Then

        Play Sound "Assets\Cancel.wav" On Channel 3

    Else If Event = UI.UI_EVENT_COMPLETED Then

        Play Sound "Assets\Confirm.wav" On Channel 2

        If AcceptedValue = 99 Then
            Running = False
        End If

    End If

    UpdateEvent = Message.Update(Timer())

    Clear Rgb(5, 9, 25)
    Draw Image Background At 0, 0 Size 960 By 540 Filter Smooth

    Call Navigator.Draw()

    If Message.Active Then
        Call Message.Draw(Timer())
    End If

    Draw Text "Right/Enter/Space Open   Left/Esc Back   1 System   2 Bitmap   3 Vector" At 480, 12 Size 15 Color CYAN Centered
    Draw Text "W Indicators Off   A After Text   S Right Aligned   D Scrollbar" At 480, 32 Size 15 Color CYAN Centered
    Show Screen
    Wait 8 Milliseconds

Loop Until Game_Closed() = True Or Running = False

Call Message.Destroy()
Call Navigator.Destroy()
Call DetailMenu.Destroy()
Call OptionMenu.Destroy()
Call CategoryMenu.Destroy()
Call RootMenu.Destroy()

Message = Nothing
Navigator = Nothing
DetailMenu = Nothing
OptionMenu = Nothing
CategoryMenu = Nothing
RootMenu = Nothing

Call BitmapFont.Destroy(FontHandle)

Unload Image FontAtlas
Unload Image ContinueImage
Unload Image CursorImage
Unload Image WindowSkin
Unload Image Background

Stop Sound
End Program
