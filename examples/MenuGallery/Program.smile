OPTION EXPLICIT

IMPORT Smile.UI.Core AS UI
IMPORT Smile.UI.BitmapFont AS BitmapFont
IMPORT Smile.UI.Menu AS Menu
IMPORT Smile.UI.MenuNavigator AS MenuNavigator
IMPORT Smile.UI.Dialogue AS Dialogue

GAME WINDOW "SMILE 2.0 Menu Gallery" SIZE 960 BY 540

DIM Background AS IMAGE
DIM WindowSkin AS IMAGE
DIM CursorImage AS IMAGE
DIM ContinueImage AS IMAGE
DIM FontAtlas AS IMAGE
DIM FontDefinition AS UI.BitmapFontStyle
DIM FontHandle AS NUMBER

DIM SkinWindow AS UI.WindowStyle
DIM VectorWindow AS UI.WindowStyle
DIM SystemText AS UI.TextStyle
DIM SystemSelectedText AS UI.TextStyle
DIM SystemDisabledText AS UI.TextStyle
DIM BitmapText AS UI.TextStyle
DIM BitmapSelectedText AS UI.TextStyle
DIM BitmapDisabledText AS UI.TextStyle
DIM MenuStyle AS UI.MenuStyle
DIM WrapMenuStyle AS UI.MenuStyle
DIM DialogueStyle AS UI.DialogueStyle
DIM NavigatorStyle AS UI.MenuNavigatorStyle

DIM RootMenu AS NUMBER
DIM CategoryMenu AS NUMBER
DIM OptionMenu AS NUMBER
DIM DetailMenu AS NUMBER
DIM NavigatorHandle AS NUMBER
DIM DialogueHandle AS NUMBER
DIM RootSharedIndex AS NUMBER
DIM RootDisabledIndex AS NUMBER
DIM RootHierarchyIndex AS NUMBER
DIM CategoryOptionIndex AS NUMBER
DIM CategorySharedIndex AS NUMBER
DIM OptionDetailIndex AS NUMBER
DIM ItemIndex AS NUMBER
DIM Key AS NUMBER
DIM Event AS NUMBER
DIM UpdateEvent AS NUMBER
DIM AcceptedValue AS NUMBER
DIM OperationSucceeded AS BOOLEAN
DIM Running AS BOOLEAN

LOAD IMAGE Background FROM "Assets\Background.png"
LOAD IMAGE WindowSkin FROM "Assets\WindowSkin.png"
LOAD IMAGE CursorImage FROM "Assets\Cursor.png"
LOAD IMAGE ContinueImage FROM "Assets\Continue.png"
LOAD IMAGE FontAtlas FROM "Assets\BitmapFont.png"

FontDefinition.Atlas = FontAtlas
FontDefinition.FirstCodePoint = 32
FontDefinition.GlyphCount = 96
FontDefinition.Columns = 16
FontDefinition.SourceCellWidth = 64
FontDefinition.SourceCellHeight = 64
FontDefinition.DrawWidth = 25
FontDefinition.DrawHeight = 25
FontDefinition.AdvanceX = 21
FontDefinition.LineHeight = 30
FontDefinition.FallbackCodePoint = 63
FontDefinition.FilterMode = UI.UI_FILTER_SMOOTH
FontHandle = BitmapFont.Create(FontDefinition)

SkinWindow.UseSkin = TRUE
SkinWindow.Skin = WindowSkin
SkinWindow.SourceWidth = 768
SkinWindow.SourceHeight = 768
SkinWindow.SourceLeft = 192
SkinWindow.SourceTop = 192
SkinWindow.SourceRight = 192
SkinWindow.SourceBottom = 192
SkinWindow.DestinationLeft = 34
SkinWindow.DestinationTop = 34
SkinWindow.DestinationRight = 34
SkinWindow.DestinationBottom = 34
SkinWindow.FillColor = RGB(15, 23, 48)
SkinWindow.BorderColor = RGB(120, 210, 255)
SkinWindow.BorderThickness = 2
SkinWindow.Opacity = 96
SkinWindow.FilterMode = UI.UI_FILTER_SMOOTH
SkinWindow.Padding.Left = 34
SkinWindow.Padding.Top = 28
SkinWindow.Padding.Right = 28
SkinWindow.Padding.Bottom = 26

VectorWindow = SkinWindow
VectorWindow.UseSkin = FALSE
VectorWindow.FillColor = RGB(13, 19, 42)
VectorWindow.BorderColor = RGB(98, 213, 255)
VectorWindow.BorderThickness = 3
VectorWindow.Padding.Left = 28
VectorWindow.Padding.Top = 24
VectorWindow.Padding.Right = 24
VectorWindow.Padding.Bottom = 22

SystemText.Mode = UI.UI_TEXT_SYSTEM
SystemText.SystemSize = 25
SystemText.SystemColor = WHITE
SystemText.LineSpacing = 5
SystemSelectedText = SystemText
SystemSelectedText.SystemColor = YELLOW
SystemDisabledText = SystemText
SystemDisabledText.SystemColor = DARK_GRAY

BitmapText.Mode = UI.UI_TEXT_BITMAP
BitmapText.SystemSize = 25
BitmapText.SystemColor = WHITE
BitmapText.BitmapFontHandle = FontHandle
BitmapText.LineSpacing = 5
BitmapSelectedText = BitmapText
BitmapDisabledText = BitmapText

MenuStyle.Window = SkinWindow
MenuStyle.NormalText = SystemText
MenuStyle.SelectedText = SystemSelectedText
MenuStyle.DisabledText = SystemDisabledText
MenuStyle.SelectionFillColor = RGB(45, 77, 130)
MenuStyle.UseCursor = TRUE
MenuStyle.Cursor = CursorImage
MenuStyle.CursorWidth = 30
MenuStyle.CursorHeight = 30
MenuStyle.CursorOffsetY = -2
MenuStyle.CursorFilterMode = UI.UI_FILTER_SMOOTH
MenuStyle.RowHeight = 43
MenuStyle.WrapSelection = TRUE
MenuStyle.ShowScrollbar = TRUE
MenuStyle.ItemTextOverflowMode = UI.UI_MENU_TEXT_ELLIPSIS
MenuStyle.ItemTextMaxLines = 1

WrapMenuStyle = MenuStyle
WrapMenuStyle.RowHeight = 78
WrapMenuStyle.ShowScrollbar = FALSE
WrapMenuStyle.ItemTextOverflowMode = UI.UI_MENU_TEXT_WRAP
WrapMenuStyle.ItemTextMaxLines = 2

DialogueStyle.Window = SkinWindow
DialogueStyle.Text = SystemText
DialogueStyle.CharactersPerSecond = 32
DialogueStyle.LineSpacing = 5
DialogueStyle.UseContinueIndicator = TRUE
DialogueStyle.ContinueIndicator = ContinueImage
DialogueStyle.IndicatorWidth = 24
DialogueStyle.IndicatorHeight = 24
DialogueStyle.IndicatorOffsetX = -14
DialogueStyle.IndicatorOffsetY = -12
DialogueStyle.IndicatorBlinkMilliseconds = 420

' The root starts near the bottom. Deeper fixed-size menus force right placement,
' left fallback, upward adjustment, and overlap while remaining fully on-screen.
RootMenu = Menu.Create(MenuStyle, 320, 250, 250, 250, 5)
CategoryMenu = Menu.Create(WrapMenuStyle, 0, 0, 280, 270, 3)
OptionMenu = Menu.Create(MenuStyle, 0, 0, 320, 240, 4)
DetailMenu = Menu.Create(MenuStyle, 0, 0, 400, 230, 4)

ItemIndex = Menu.AddItem(RootMenu, "QUICK LEAF", 10, TRUE)
RootSharedIndex = Menu.AddItem(RootMenu, "A VERY LONG SHARED LIBRARY CATEGORY", 11, TRUE)
RootDisabledIndex = Menu.AddItem(RootMenu, "DISABLED LIBRARY SECTION", 12, FALSE)
RootHierarchyIndex = Menu.AddItem(RootMenu, "OPEN HIERARCHY", 13, TRUE)
ItemIndex = Menu.AddItem(RootMenu, "EXIT SAMPLE", 99, TRUE)

CategoryOptionIndex = Menu.AddItem(CategoryMenu, "LOCALIZATION AND ACCESSIBILITY OPTIONS THAT WRAP ACROSS MULTIPLE WORDS", 20, TRUE)
CategorySharedIndex = Menu.AddItem(CategoryMenu, "SHARED DETAIL VIEW", 21, TRUE)
ItemIndex = Menu.AddItem(CategoryMenu, "CATEGORY LEAF", 22, TRUE)

OptionDetailIndex = Menu.AddItem(OptionMenu, "DISPLAY MODE DETAILS", 30, TRUE)
ItemIndex = Menu.AddItem(OptionMenu, "A VERY LONG OPTION LEAF THAT ELLIPSIZES SAFELY", 31, TRUE)
ItemIndex = Menu.AddItem(OptionMenu, "OPTION LEAF", 32, TRUE)

ItemIndex = Menu.AddItem(DetailMenu, "DEEPEST ACCEPTED LEAF", 40, TRUE)
ItemIndex = Menu.AddItem(DetailMenu, "ANOTHER LONG DETAIL LEAF THAT MUST ELLIPSIZE", 41, TRUE)
ItemIndex = Menu.AddItem(DetailMenu, "FINAL ACTION", 42, TRUE)

NavigatorStyle.Viewport.X = 0
NavigatorStyle.Viewport.Y = 0
NavigatorStyle.Viewport.Width = 960
NavigatorStyle.Viewport.Height = 540
NavigatorStyle.ViewportPadding.Left = 12
NavigatorStyle.ViewportPadding.Top = 12
NavigatorStyle.ViewportPadding.Right = 12
NavigatorStyle.ViewportPadding.Bottom = 12
NavigatorStyle.HorizontalGap = 8
NavigatorStyle.PreferredDirection = UI.UI_SUBMENU_DIRECTION_AUTO

NavigatorHandle = MenuNavigator.Create(RootMenu, NavigatorStyle)
Running = FontHandle > 0 AND RootMenu > 0 AND CategoryMenu > 0 AND OptionMenu > 0 AND DetailMenu > 0 AND NavigatorHandle > 0
OperationSucceeded = MenuNavigator.BindSubmenu(NavigatorHandle, RootMenu, RootSharedIndex, CategoryMenu, FALSE)
OperationSucceeded = OperationSucceeded AND MenuNavigator.BindSubmenu(NavigatorHandle, RootMenu, RootDisabledIndex, DetailMenu, FALSE)
OperationSucceeded = OperationSucceeded AND MenuNavigator.BindSubmenu(NavigatorHandle, RootMenu, RootHierarchyIndex, CategoryMenu, TRUE)
OperationSucceeded = OperationSucceeded AND MenuNavigator.BindSubmenu(NavigatorHandle, CategoryMenu, CategoryOptionIndex, OptionMenu, TRUE)
OperationSucceeded = OperationSucceeded AND MenuNavigator.BindSubmenu(NavigatorHandle, CategoryMenu, CategorySharedIndex, DetailMenu, FALSE)
OperationSucceeded = OperationSucceeded AND MenuNavigator.BindSubmenu(NavigatorHandle, OptionMenu, OptionDetailIndex, DetailMenu, TRUE)
OperationSucceeded = OperationSucceeded AND Menu.SetSelectedIndex(RootMenu, RootHierarchyIndex)
Running = Running AND OperationSucceeded

DialogueHandle = Dialogue.Create(DialogueStyle, 38, 38, 450, 180)
Running = Running AND DialogueHandle > 0

DO
    GET KEY Key
    Event = UI.UI_EVENT_NONE

    IF Key = KEY_1 THEN
        MenuStyle.Window = SkinWindow
        MenuStyle.NormalText = SystemText
        MenuStyle.SelectedText = SystemSelectedText
        MenuStyle.DisabledText = SystemDisabledText
        WrapMenuStyle.Window = SkinWindow
        WrapMenuStyle.NormalText = SystemText
        WrapMenuStyle.SelectedText = SystemSelectedText
        WrapMenuStyle.DisabledText = SystemDisabledText
        DialogueStyle.Window = SkinWindow
        DialogueStyle.Text = SystemText
        OperationSucceeded = Menu.SetStyle(RootMenu, MenuStyle)
        OperationSucceeded = OperationSucceeded AND Menu.SetStyle(CategoryMenu, WrapMenuStyle)
        OperationSucceeded = OperationSucceeded AND Menu.SetStyle(OptionMenu, MenuStyle)
        OperationSucceeded = OperationSucceeded AND Menu.SetStyle(DetailMenu, MenuStyle)
        OperationSucceeded = OperationSucceeded AND Dialogue.SetStyle(DialogueHandle, DialogueStyle)
        OperationSucceeded = OperationSucceeded AND MenuNavigator.Relayout(NavigatorHandle)
        Running = Running AND OperationSucceeded
    ELSE IF Key = KEY_2 THEN
        MenuStyle.Window = SkinWindow
        MenuStyle.NormalText = BitmapText
        MenuStyle.SelectedText = BitmapSelectedText
        MenuStyle.DisabledText = BitmapDisabledText
        WrapMenuStyle.Window = SkinWindow
        WrapMenuStyle.NormalText = BitmapText
        WrapMenuStyle.SelectedText = BitmapSelectedText
        WrapMenuStyle.DisabledText = BitmapDisabledText
        DialogueStyle.Window = SkinWindow
        DialogueStyle.Text = BitmapText
        OperationSucceeded = Menu.SetStyle(RootMenu, MenuStyle)
        OperationSucceeded = OperationSucceeded AND Menu.SetStyle(CategoryMenu, WrapMenuStyle)
        OperationSucceeded = OperationSucceeded AND Menu.SetStyle(OptionMenu, MenuStyle)
        OperationSucceeded = OperationSucceeded AND Menu.SetStyle(DetailMenu, MenuStyle)
        OperationSucceeded = OperationSucceeded AND Dialogue.SetStyle(DialogueHandle, DialogueStyle)
        OperationSucceeded = OperationSucceeded AND MenuNavigator.Relayout(NavigatorHandle)
        Running = Running AND OperationSucceeded
    ELSE IF Key = KEY_3 THEN
        MenuStyle.Window = VectorWindow
        MenuStyle.NormalText = SystemText
        MenuStyle.SelectedText = SystemSelectedText
        MenuStyle.DisabledText = SystemDisabledText
        WrapMenuStyle.Window = VectorWindow
        WrapMenuStyle.NormalText = SystemText
        WrapMenuStyle.SelectedText = SystemSelectedText
        WrapMenuStyle.DisabledText = SystemDisabledText
        DialogueStyle.Window = VectorWindow
        DialogueStyle.Text = SystemText
        OperationSucceeded = Menu.SetStyle(RootMenu, MenuStyle)
        OperationSucceeded = OperationSucceeded AND Menu.SetStyle(CategoryMenu, WrapMenuStyle)
        OperationSucceeded = OperationSucceeded AND Menu.SetStyle(OptionMenu, MenuStyle)
        OperationSucceeded = OperationSucceeded AND Menu.SetStyle(DetailMenu, MenuStyle)
        OperationSucceeded = OperationSucceeded AND Dialogue.SetStyle(DialogueHandle, DialogueStyle)
        OperationSucceeded = OperationSucceeded AND MenuNavigator.Relayout(NavigatorHandle)
        Running = Running AND OperationSucceeded
    ELSE IF Dialogue.IsActive(DialogueHandle) THEN
        Event = Dialogue.HandleKey(DialogueHandle, Key, TIMER())
    ELSE
        Event = MenuNavigator.HandleKey(NavigatorHandle, Key)
        IF Event = UI.UI_EVENT_ACCEPTED THEN
            AcceptedValue = MenuNavigator.LastAcceptedValue(NavigatorHandle)
            CALL Dialogue.ClearPages(DialogueHandle)
            IF AcceptedValue = 99 THEN
                OperationSucceeded = Dialogue.AddPage(DialogueHandle, "The reusable hierarchical menu demonstration is complete. Press Enter again to close the sample.")
            ELSE
                OperationSucceeded = Dialogue.AddPage(DialogueHandle, "A leaf item was accepted through MenuNavigator. The game owns this reaction while the reusable library owns stack routing, focus, markers, and placement.")
            END IF
            IF OperationSucceeded THEN
                OperationSucceeded = Dialogue.AddPage(DialogueHandle, "Right, Enter, or Space opens a submenu. Left or Escape closes one level. Escape at the root returns the normal cancel event.")
            END IF
            IF OperationSucceeded THEN
                OperationSucceeded = Dialogue.Start(DialogueHandle, TIMER())
            END IF
            Running = Running AND OperationSucceeded
        END IF
    END IF

    IF Event = UI.UI_EVENT_CHANGED THEN
        PLAY SOUND "Assets\Move.wav" ON CHANNEL 1
    ELSE IF Event = UI.UI_EVENT_SUBMENU_OPENED OR Event = UI.UI_EVENT_ACCEPTED OR Event = UI.UI_EVENT_ADVANCED THEN
        PLAY SOUND "Assets\Confirm.wav" ON CHANNEL 2
    ELSE IF Event = UI.UI_EVENT_SUBMENU_CLOSED OR Event = UI.UI_EVENT_CANCELLED THEN
        PLAY SOUND "Assets\Cancel.wav" ON CHANNEL 3
    ELSE IF Event = UI.UI_EVENT_COMPLETED THEN
        PLAY SOUND "Assets\Confirm.wav" ON CHANNEL 2
        IF AcceptedValue = 99 THEN
            Running = FALSE
        END IF
    END IF

    UpdateEvent = Dialogue.Update(DialogueHandle, TIMER())

    CLEAR RGB(5, 9, 25)
    DRAW IMAGE Background AT 0, 0 SIZE 960 BY 540 FILTER SMOOTH
    CALL MenuNavigator.DrawStack(NavigatorHandle)
    IF Dialogue.IsActive(DialogueHandle) THEN
        CALL Dialogue.Draw(DialogueHandle, TIMER())
    END IF
    DRAW TEXT "RIGHT/ENTER/SPACE OPEN   LEFT/ESC BACK   1 SYSTEM   2 BITMAP   3 VECTOR" AT 480, 16 SIZE 16 COLOR CYAN CENTERED
    SHOW SCREEN
    WAIT 8 MILLISECONDS
LOOP UNTIL GAME_CLOSED() = TRUE OR Running = FALSE

CALL Dialogue.Destroy(DialogueHandle)
CALL MenuNavigator.Destroy(NavigatorHandle)
CALL Menu.Destroy(DetailMenu)
CALL Menu.Destroy(OptionMenu)
CALL Menu.Destroy(CategoryMenu)
CALL Menu.Destroy(RootMenu)
CALL BitmapFont.Destroy(FontHandle)

UNLOAD IMAGE FontAtlas
UNLOAD IMAGE ContinueImage
UNLOAD IMAGE CursorImage
UNLOAD IMAGE WindowSkin
UNLOAD IMAGE Background

STOP SOUND
END PROGRAM
