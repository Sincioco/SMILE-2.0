Option Explicit

Import Smile.Simple3D.Core As Core
Import Smile.Simple3D.Graphics3D As Graphics3D

Dim Failures As Number
Dim ForcedFailureObserved As Boolean

Game Window "Renderer3D Reflection Tests" Size 320 By 240

Do

    Call RunReflectionTests()

    ' The forced allocation-failure run is covered by RunReflectionTests.
    ' Resetting for the VFX fixture deliberately re-arms that injection.

    If Not ForcedFailureObserved Then
        Call RunVfxReflectionTests()
    End If

Loop Until True

If Failures = 0 Then

    If ForcedFailureObserved Then
        Print "Renderer3D reflection retry tests passed"
    Else
        Print "Renderer3D reflection tests passed"
    End If

Else
    Print "Renderer3D reflection tests failed: "; Failures

End If

Sub RunReflectionTests()

    Dim Camera As Core.Camera3D
    Dim ConfigurationRevision As Number
    Dim Excluded As Core.Object3D
    Dim FallbackReason As Number
    Dim FirstGeneration As Number
    Dim FirstTargetBytes As Number
    Dim Floor As Core.Object3D
    Dim SecondFloor As Core.Object3D
    Dim Source As Core.Object3D

    Call Graphics3D.ResetRenderer3D()

    Camera = Graphics3D.DefaultCamera()
    Floor = Graphics3D.CreatePlane3D(180, 140)
    Source = Graphics3D.CreateCube3D(24)
    Excluded = Graphics3D.CreateCube3D(12)

    Call Graphics3D.SetObjectPosition(Floor, 0, -1, 0)
    Call Graphics3D.SetObjectPosition(Source, 0, 20, 0)
    Call Graphics3D.SetObjectPosition(Excluded, 40, 8, 0)
    Call Graphics3D.SetObjectReflectionMode3D(
        Floor, Graphics3D.OBJECT_REFLECTION_RECEIVER)
    Call Graphics3D.SetObjectReflectionMode3D(
        Excluded, Graphics3D.OBJECT_REFLECTION_EXCLUDED)

    Call Check(Floor.ReflectionMode = Graphics3D.OBJECT_REFLECTION_RECEIVER)
    Call Check(Source.ReflectionMode = Graphics3D.OBJECT_REFLECTION_ELIGIBLE)
    Call Check(Excluded.ReflectionMode = Graphics3D.OBJECT_REFLECTION_EXCLUDED)
    Call Check(Graphics3D.ConfigureShadows3D(
        False, Graphics3D.SHADOW_CASTER_DIRECTIONAL, 0, 1024, 500, 600))
    Call Check(Graphics3D.ConfigurePostProcessing3D(
        False, False, False, 100, 1200, 80, 4, 0, 1))
    Call Check(Graphics3D.ConfigureReflections3D(True, 45, 35, 50, -1, True))
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_REQUESTED) = 1)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_STRENGTH) = 45)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_SOFTNESS) = 35)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_SCALE) = 50)

    ConfigurationRevision = Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_CONFIGURATION_REVISION)

    Call Check(Not Graphics3D.ConfigureReflections3D(True, 45, 35, 10, -1, True))
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_CONFIGURATION_REVISION) = ConfigurationRevision)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_SCALE) = 50)

    Call DrawReflectionFrame(Camera, Floor, Source, Excluded)

    FallbackReason = Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_FALLBACK_REASON)
    ForcedFailureObserved = FallbackReason = Graphics3D.REFLECTION_FALLBACK_ALLOCATION_FAILED

    If ForcedFailureObserved Then

        Call Check(Graphics3D.ReflectionValue3D(
            Graphics3D.REFLECTION_QUERY_EFFECTIVE) = 0)
        Call Check(Graphics3D.ReflectionValue3D(
            Graphics3D.REFLECTION_QUERY_CAPTURES) = 0)
        Call Check(Graphics3D.ReflectionValue3D(
            Graphics3D.REFLECTION_QUERY_DRAWS) = 0)
        Call Check(Graphics3D.ReflectionValue3D(
            Graphics3D.REFLECTION_QUERY_COMPOSITIONS) = 0)

        FirstGeneration = Graphics3D.ReflectionValue3D(
            Graphics3D.REFLECTION_QUERY_RESOURCE_GENERATION)

        Call DrawReflectionFrame(Camera, Floor, Source, Excluded)
        Call Check(Graphics3D.ReflectionValue3D(
            Graphics3D.REFLECTION_QUERY_FALLBACK_REASON) =
            Graphics3D.REFLECTION_FALLBACK_ALLOCATION_FAILED)
        Call Check(Graphics3D.ReflectionValue3D(
            Graphics3D.REFLECTION_QUERY_RESOURCE_GENERATION) = FirstGeneration)
        Call Check(Graphics3D.ConfigureReflections3D(False, 45, 35, 50, -1, True))
        Call Check(Graphics3D.ConfigureReflections3D(True, 45, 35, 50, -1, True))

        Call DrawReflectionFrame(Camera, Floor, Source, Excluded)

    End If

    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_EFFECTIVE) = 1)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_FALLBACK_REASON) =
        Graphics3D.REFLECTION_FALLBACK_NONE)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_CAPTURES) = 1)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_DRAWS) = 1)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_TRIANGLES) = 12)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_COMPOSITIONS) = 1)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_RECEIVER_SAMPLE_ERROR) <= 2)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_WIDTH) > 0)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_HEIGHT) > 0)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_TARGET_BYTES) > 0)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_TARGET_FORMAT) =
        Graphics3D.REFLECTION_TARGET_FORMAT_LDR)
    Call Check(Graphics3D.M5Value3D(
        Graphics3D.M5_QUERY_LOGICAL_SUBMISSIONS, 0) = 3)
    Call Check(Graphics3D.M5Value3D(
        Graphics3D.M5_QUERY_PHYSICAL_SUBMISSIONS, 0) = 3)
    Call Check(Graphics3D.DrawCallCount3D() = 3)
    Call Check(Graphics3D.M5Value3D(
        Graphics3D.M5_QUERY_MULTIPASS_ACTIVE, 0) = 1)

    FirstGeneration = Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_RESOURCE_GENERATION)

    Call DrawReflectionFrame(Camera, Floor, Source, Excluded)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_RESOURCE_GENERATION) = FirstGeneration)

    Call Graphics3D.SetObjectPosition(Floor, 0, 0, 0)

    Camera.Position.X = -27
    Camera.Position.Y = 51
    Camera.Position.Z = -82
    Camera.Target.X = 14
    Camera.Target.Y = 0
    Camera.Target.Z = 9

    Call DrawReflectionFrame(Camera, Floor, Source, Excluded)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_EFFECTIVE_FLOOR_HEIGHT) = 0)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_RECEIVER_SAMPLE_ERROR) <= 2)

    ConfigurationRevision = Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_CONFIGURATION_REVISION)

    Call Graphics3D.SetObjectPosition(Floor, 0, 7, 0)

    Camera.Position.X = 31
    Camera.Position.Y = 42
    Camera.Position.Z = -64
    Camera.Target.X = -9
    Camera.Target.Y = 7
    Camera.Target.Z = 5

    Call DrawReflectionFrameWithFloorMutation(Camera, Floor, Source, Excluded)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_FLOOR_HEIGHT) = -1)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_EFFECTIVE_FLOOR_HEIGHT) = 7)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_CONFIGURATION_REVISION) = ConfigurationRevision)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_RECEIVER_SAMPLE_ERROR) <= 2)

    Camera.Position.Y = 0

    Call DrawReflectionFrame(Camera, Floor, Source, Excluded)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_EFFECTIVE_FLOOR_HEIGHT) = 7)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_FALLBACK_REASON) =
        Graphics3D.REFLECTION_FALLBACK_CAMERA_BELOW_FLOOR)

    Camera.Position.Y = 42

    Call Check(Graphics3D.ConfigureReflections3D(True, 45, 35, 50, 7, True))
    Call DrawReflectionFrame(Camera, Floor, Source, Excluded)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_FLOOR_HEIGHT) = 7)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_EFFECTIVE_FLOOR_HEIGHT) = 7)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_RECEIVER_SAMPLE_ERROR) <= 2)

    Call Graphics3D.SetObjectPosition(Floor, 0, -4, 0)
    Call Check(Graphics3D.ConfigureReflections3D(True, 45, 35, 50, -1, True))

    Camera.Position.Y = 35
    Camera.Target.Y = -4

    Call DrawReflectionFrame(Camera, Floor, Source, Excluded)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_EFFECTIVE_FLOOR_HEIGHT) = -4)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_RECEIVER_SAMPLE_ERROR) <= 2)

    Call Graphics3D.SetObjectRotation(Floor, 10, 0, 0)
    Call DrawReflectionFrame(Camera, Floor, Source, Excluded)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_FALLBACK_REASON) =
        Graphics3D.REFLECTION_FALLBACK_UNSUPPORTED_RECEIVER)

    Call Graphics3D.SetObjectRotation(Floor, 0, 0, 0)
    Call Graphics3D.SetObjectPosition(Floor, 0, 7, 0)

    SecondFloor = Graphics3D.CreatePlane3D(60, 60)

    Call Graphics3D.SetObjectPosition(SecondFloor, 0, 8, 0)
    Call Graphics3D.SetObjectReflectionMode3D(
        SecondFloor, Graphics3D.OBJECT_REFLECTION_RECEIVER)
    Call DrawWithTwoReceivers(Camera, Floor, SecondFloor, Source)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_FALLBACK_REASON) =
        Graphics3D.REFLECTION_FALLBACK_UNSUPPORTED_RECEIVER)

    Call Graphics3D.DestroyObject3D(SecondFloor)
    Call Graphics3D.SetObjectPosition(Floor, 0, -1, 0)

    Camera = Graphics3D.DefaultCamera()

    Call DrawReflectionFrame(Camera, Floor, Source, Excluded)

    FirstGeneration = Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_RESOURCE_GENERATION)
    FirstTargetBytes = Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_TARGET_BYTES)

    Call Check(FirstTargetBytes =
        Graphics3D.ReflectionValue3D(Graphics3D.REFLECTION_QUERY_WIDTH) *
        Graphics3D.ReflectionValue3D(Graphics3D.REFLECTION_QUERY_HEIGHT) * 8)
    Call Check(Graphics3D.ConfigurePostProcessing3D(
        True, True, False, 100, 1200, 80, 4, 0, 1))
    Call DrawReflectionFrame(Camera, Floor, Source, Excluded)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_TARGET_FORMAT) =
        Graphics3D.REFLECTION_TARGET_FORMAT_HDR)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_RESOURCE_GENERATION) = FirstGeneration + 1)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_TARGET_BYTES) =
        Graphics3D.ReflectionValue3D(Graphics3D.REFLECTION_QUERY_WIDTH) *
        Graphics3D.ReflectionValue3D(Graphics3D.REFLECTION_QUERY_HEIGHT) * 12)

    FirstGeneration = Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_RESOURCE_GENERATION)

    Call Check(Graphics3D.ConfigurePostProcessing3D(
        False, False, False, 100, 1200, 80, 4, 0, 1))
    Call DrawReflectionFrame(Camera, Floor, Source, Excluded)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_TARGET_FORMAT) =
        Graphics3D.REFLECTION_TARGET_FORMAT_LDR)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_RESOURCE_GENERATION) = FirstGeneration + 1)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_TARGET_BYTES) = FirstTargetBytes)

    Call Check(Graphics3D.ConfigureReflections3D(False, 45, 35, 50, -1, True))
    Call DrawReflectionFrame(Camera, Floor, Source, Excluded)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_REQUESTED) = 0)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_EFFECTIVE) = 0)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_FALLBACK_REASON) =
        Graphics3D.REFLECTION_FALLBACK_DISABLED)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_CAPTURES) = 0)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_DRAWS) = 0)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_COMPOSITIONS) = 0)
    Call Check(Graphics3D.M5Value3D(
        Graphics3D.M5_QUERY_MULTIPASS_ACTIVE, 0) = 0)

    Call Check(Graphics3D.ConfigureReflections3D(True, 45, 35, 50, -1, True))
    Call DrawWithoutReceiver(Camera, Source, Excluded)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_FALLBACK_REASON) =
        Graphics3D.REFLECTION_FALLBACK_NO_RECEIVER)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_CAPTURES) = 0)

    Camera.Position.Y = -2
    Camera.Target.Y = -3

    Call DrawReflectionFrame(Camera, Floor, Source, Excluded)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_FALLBACK_REASON) =
        Graphics3D.REFLECTION_FALLBACK_CAMERA_BELOW_FLOOR)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_CAPTURES) = 0)

    Call Graphics3D.DestroyObject3D(Excluded)
    Call Graphics3D.DestroyObject3D(Source)
    Call Graphics3D.DestroyObject3D(Floor)
    Call Graphics3D.ResetRenderer3D()

    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_REQUESTED) = 0)
    Call Check(Graphics3D.ReflectionValue3D(
        Graphics3D.REFLECTION_QUERY_TARGET_BYTES) = 0)

End Sub

Sub DrawReflectionFrameWithFloorMutation(
    Camera As Core.Camera3D,
    Floor As Core.Object3D,
    Source As Core.Object3D,
    Excluded As Core.Object3D
)

    Call Check(Graphics3D.Begin3D(Camera, 2, 4, 8))
    Call Check(Graphics3D.DrawObject3D(Floor))
    Call Check(Graphics3D.SetObjectPositionChecked3D(Floor, 0, 9, 0))
    Call Check(Graphics3D.DrawObject3D(Source))
    Call Check(Graphics3D.DrawObject3D(Excluded))
    Call Check(Graphics3D.End3DChecked())
    Call Graphics3D.SetObjectPosition(Floor, 0, 7, 0)

End Sub

Sub DrawWithTwoReceivers(
    Camera As Core.Camera3D,
    Floor As Core.Object3D,
    SecondFloor As Core.Object3D,
    Source As Core.Object3D
)

    Call Check(Graphics3D.Begin3D(Camera, 2, 4, 8))
    Call Check(Graphics3D.DrawObject3D(Floor))
    Call Check(Graphics3D.DrawObject3D(SecondFloor))
    Call Check(Graphics3D.DrawObject3D(Source))
    Call Check(Graphics3D.End3DChecked())

End Sub

Sub DrawReflectionFrame(Camera As Core.Camera3D, Floor As Core.Object3D,
    Source As Core.Object3D, Excluded As Core.Object3D)

    Call Check(Graphics3D.Begin3D(Camera, 2, 4, 8))
    Call Check(Graphics3D.DrawObject3D(Floor))
    Call Check(Graphics3D.DrawObject3D(Source))
    Call Check(Graphics3D.SetObjectPositionChecked3D(Source, 8, 20, 0))
    Call Check(Not Graphics3D.SetObjectReflectionModeChecked3D(
        Source, Graphics3D.OBJECT_REFLECTION_EXCLUDED))
    Call Check(Graphics3D.DrawObject3D(Excluded))
    Call Check(Graphics3D.End3DChecked())

    Call Graphics3D.SetObjectPosition(Source, 0, 20, 0)

End Sub

Sub DrawWithoutReceiver(Camera As Core.Camera3D, Source As Core.Object3D,
    Excluded As Core.Object3D)

    Call Check(Graphics3D.Begin3D(Camera, 2, 4, 8))
    Call Check(Graphics3D.DrawObject3D(Source))
    Call Check(Graphics3D.DrawObject3D(Excluded))
    Call Check(Graphics3D.End3DChecked())

End Sub

Sub RunVfxReflectionTests()

    Dim Camera As Core.Camera3D
    Dim Floor As Core.Object3D
    Dim Glow As Core.Object3D
    Dim EmptyTexture As Core.Texture3D
    Dim Material As Core.Material3D
    Dim Particle As Core.ParticleBatch3D
    Dim Ribbon As Core.RibbonBatch3D
    Dim System As Core.GpuParticleSystem3D
    Dim Pass As Number
    Dim Dispatches As Number
    Dim Generation As Number

    Call Graphics3D.ResetRenderer3D()

    Camera = Graphics3D.DefaultCamera()
    Camera.Position.Y = 60
    Camera.Position.Z = -100
    Camera.Target.Y = 0
    Floor = Graphics3D.CreatePlane3D(180, 140)
    Glow = Graphics3D.CreateCube3D(12)
    Material = Graphics3D.CreateEffectMaterial3D(
        EmptyTexture, Graphics3D.MATERIAL_ALPHA_ADDITIVE, 150)
    Particle = Graphics3D.CreateParticleBatch3D(
        2, Material, Graphics3D.VFX_BILLBOARD_CAMERA, 1, 1)
    Ribbon = Graphics3D.CreateRibbonBatch3D(2, Material)
    System = Graphics3D.CreateGpuParticleSystem3D(
        4, Material, Graphics3D.GPU_PARTICLE_SIMULATION_AUTO, 10)

    Call Check(Floor.Handle <> 0 And Glow.Handle <> 0 And Material.Handle <> 0)
    Call Check(Particle.Handle <> 0 And Ribbon.Handle <> 0 And System.Handle <> 0)
    Call Graphics3D.SetObjectReflectionMode3D(Floor, Graphics3D.OBJECT_REFLECTION_RECEIVER)
    Call Graphics3D.SetObjectPosition(Glow, -30, 20, 0)
    Call Check(Graphics3D.SetObjectMaterial3D(Glow, Material))
    Call Check(Graphics3D.SetParticle3D(Particle, 0, -10, 20, 0, 10, 0, 0))
    Call Check(Graphics3D.CommitParticleBatch3D(Particle, 1))
    Call Check(Graphics3D.SetRibbonPoint3D(Ribbon, 0, 5, 10, 0, 10, 10, 0, 0))
    Call Check(Graphics3D.SetRibbonPoint3D(Ribbon, 1, 5, 30, 0, 10, 30, 0, 1000))
    Call Check(Graphics3D.CommitRibbonBatch3D(Ribbon, 2))
    Call Check(Graphics3D.SetGpuParticleSpawnKinematics3D(System, 0, 30, 20, 0, 0, 0, 0))
    Call Check(Graphics3D.SetGpuParticleSpawnVisual3D(System, 0, 1000, 10, 10, 0, 0, 900, 800))
    Call Check(Graphics3D.CommitGpuParticleSpawn3D(System, 0, 1, 123))
    Call Check(Graphics3D.AdvanceGpuParticleSystem3D(System, 10))

    Dispatches = Graphics3D.GpuParticleValue3D(Graphics3D.GPU_PARTICLE_QUERY_DISPATCHES)

    ' Off, On, Off: capture reuses the same committed effects and GPU state.

    For Pass = 0 To 2

        Call Check(Graphics3D.ConfigureReflections3D(True, 85, 5, 100, -1, False, Pass = 1))
        Call Check(Graphics3D.ReflectionValue3D(Graphics3D.REFLECTION_QUERY_INCLUDE_VFX) =
            Pass Mod 2)
        Call Check(Graphics3D.Begin3D(Camera, 2, 4, 8))
        Call Check(Graphics3D.DrawObject3D(Floor))
        Call Check(Graphics3D.DrawObject3D(Glow))
        Call Check(Graphics3D.DrawParticleBatch3D(Particle))
        Call Check(Graphics3D.DrawRibbonBatch3D(Ribbon))
        Call Check(Graphics3D.DrawGpuParticleSystem3D(System))
        Call Check(Graphics3D.End3DChecked())
        Call Check(Graphics3D.ReflectionValue3D(Graphics3D.REFLECTION_QUERY_EFFECTIVE) = 1)
        Call Check(Graphics3D.ReflectionValue3D(Graphics3D.REFLECTION_QUERY_DRAWS) =
            (Pass Mod 2) * 4)
        Call Check(Graphics3D.DrawCallCount3D() = 5)
        Call Check(Graphics3D.VfxValue3D(Graphics3D.VFX_QUERY_DRAW_CALLS) = 3)
        Call Check(Graphics3D.M5Value3D(Graphics3D.M5_QUERY_LOGICAL_SUBMISSIONS, 0) = 5)
        Call Check(Graphics3D.GpuParticleValue3D(Graphics3D.GPU_PARTICLE_QUERY_DISPATCHES) =
            Dispatches)

        If Pass = 0 Then
            Generation = Graphics3D.ReflectionValue3D(Graphics3D.REFLECTION_QUERY_RESOURCE_GENERATION)
        Else

            Call Check(Graphics3D.ReflectionValue3D(
                Graphics3D.REFLECTION_QUERY_RESOURCE_GENERATION) = Generation)
        End If

    End For

    Call Graphics3D.DestroyGpuParticleSystem3D(System)
    Call Graphics3D.DestroyParticleBatch3D(Particle)
    Call Graphics3D.DestroyRibbonBatch3D(Ribbon)
    Call Graphics3D.DestroyObject3D(Glow)
    Call Graphics3D.DestroyObject3D(Floor)
    Call Graphics3D.DestroyMaterial3D(Material)
    Call Graphics3D.ResetRenderer3D()
    Call Check(Graphics3D.ReflectionValue3D(Graphics3D.REFLECTION_QUERY_INCLUDE_VFX) = 0)

End Sub

Sub Check(Condition As Boolean)

    If Not Condition Then
        Failures = Failures + 1
    End If

End Sub
