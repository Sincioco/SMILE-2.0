' SMILE 2.0 Snake
' Use W, A, S, and D to move.

Width = 30
Height = 15

Dim SnakeX[400]
Dim SnakeY[400]

Length = 3
Direction = RIGHT

FoodX = 20
FoodY = 7

GameOver = False
FoodOnSnake = False
SnakeHere = False

Key = NONE
TailX = 0
TailY = 0

SnakeX[0] = 15
SnakeY[0] = 7

SnakeX[1] = 14
SnakeY[1] = 7

SnakeX[2] = 13
SnakeY[2] = 7

Clear Screen

Do
    Get Key Key

    If Key = W And Direction <> Down Then
        Direction = UP
    Else If Key = S And Direction <> UP Then
        Direction = Down
    Else If Key = A And Direction <> RIGHT Then
        Direction = LEFT
    Else If Key = D And Direction <> LEFT Then
        Direction = RIGHT
    End If

    TailX = SnakeX[Length - 1]
    TailY = SnakeY[Length - 1]

    For I = Length - 1 Down To 1
        SnakeX[I] = SnakeX[I - 1]
        SnakeY[I] = SnakeY[I - 1]
    End For

    If Direction = UP Then
        SnakeY[0] = SnakeY[0] - 1
    Else If Direction = Down Then
        SnakeY[0] = SnakeY[0] + 1
    Else If Direction = LEFT Then
        SnakeX[0] = SnakeX[0] - 1
    Else If Direction = RIGHT Then
        SnakeX[0] = SnakeX[0] + 1
    End If

    If (SnakeX[0] = 0 Or
        SnakeX[0] = Width - 1 Or
        SnakeY[0] = 0 Or
        SnakeY[0] = Height - 1) Then
        GameOver = True
    End If

    For I = 1 To Length - 1

        If SnakeX[0] = SnakeX[I] And SnakeY[0] = SnakeY[I] Then
            GameOver = True
        End If

    End For

    If SnakeX[0] = FoodX And SnakeY[0] = FoodY Then

        SnakeX[Length] = TailX
        SnakeY[Length] = TailY
        Length = Length + 1

        FoodOnSnake = True

        Do
            Random FoodX From 1 To Width - 2
            Random FoodY From 1 To Height - 2

            FoodOnSnake = False

            For I = 0 To Length - 1

                If FoodX = SnakeX[I] And FoodY = SnakeY[I] Then
                    FoodOnSnake = True
                End If

            End For

        Loop Until FoodOnSnake = False

    End If

    Clear Screen

    For Y = 0 To Height - 1

        For X = 0 To Width - 1

            SnakeHere = False

            For I = 0 To Length - 1

                If X = SnakeX[I] And Y = SnakeY[I] Then
                    SnakeHere = True
                End If

            End For

            If (X = 0 Or
                X = Width - 1 Or
                Y = 0 Or
                Y = Height - 1) Then
                Print "#";
            Else If X = FoodX And Y = FoodY Then
                Print "@";
            Else If SnakeHere = True Then
                Print "O";
            Else
                Print " ";
            End If

        End For

        Print
    End For

    Print "Score: "; Length - 3
    Print "W A S D to move"

    Wait 120 Milliseconds

Loop Until GameOver = True

Print
Print "Game Over"
Print "Score: "; Length - 3
