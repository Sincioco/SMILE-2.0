Option Explicit

Import Smile.UI.Core As UI
Import Smile.UI.Menu As Menu
Import Smile.UI.MenuNavigator As MenuNavigator

Dim Style As UI.MenuStyle
Dim CandidateMenuStyle As UI.MenuStyle
Dim NavigatorStyle As UI.MenuNavigatorStyle
Dim CandidateStyle As UI.MenuNavigatorStyle
Dim Root As Number
Dim Child As Number
Dim Grandchild As Number
Dim DeepChild As Number
Dim Oversized As Number
Dim Navigator As Number
Dim StaleNavigator As Number
Dim RootChild As Number
Dim RootShared As Number
Dim RootLeaf As Number
Dim RootDisabled As Number
Dim ChildGrandchild As Number
Dim ChildOther As Number
Dim GrandchildDeep As Number
Dim GrandchildOther As Number
Dim ItemIndex As Number
Dim Event As Number
Dim Result As Boolean
Dim OldRevision As Number
Dim RootBounds As UI.Rect
Dim ChildBounds As UI.Rect
Dim OldBounds As UI.Rect
Dim ChainMenus[9] As Number
Dim ExtraNavigators[8] As Number
Dim OtherNavigator As Number
Dim DeepLeafIndex As Number
Dim ParentOne As Number
Dim ParentTwo As Number
Dim ParentThree As Number
Dim SharedChild As Number
Dim LongMenu As Number
Dim LongValue As Text
Dim I As Number

Sub Check(Condition As Boolean)

    Print Condition

End Sub

Style.RowHeight = 32
Style.WrapSelection = True
Style.ShowSubmenuIndicator = True
Style.SubmenuIndicatorPosition = UI.UI_SUBMENU_INDICATOR_RIGHT_ALIGNED
Style.ItemTextOverflowMode = UI.UI_MENU_TEXT_ELLIPSIS
Style.ItemTextMaxLines = 1

NavigatorStyle.Viewport.X = 0
NavigatorStyle.Viewport.Y = 0
NavigatorStyle.Viewport.Width = 640
NavigatorStyle.Viewport.Height = 360
NavigatorStyle.ViewportPadding.LEFT = 10
NavigatorStyle.ViewportPadding.Top = 10
NavigatorStyle.ViewportPadding.RIGHT = 10
NavigatorStyle.ViewportPadding.Bottom = 10
NavigatorStyle.HorizontalGap = 8
NavigatorStyle.PreferredDirection = UI.UI_SUBMENU_DIRECTION_AUTO

Call Check(UI.UI_EVENT_SUBMENU_OPENED = 6 And UI.UI_EVENT_SUBMENU_CLOSED = 7)
Call Check(UI.UI_SUBMENU_INDICATOR_AFTER_TEXT = 0 And UI.UI_SUBMENU_INDICATOR_RIGHT_ALIGNED = 1)
Call Check(UI.UI_MAX_MENU_NAVIGATORS = 8 And UI.UI_MAX_MENU_DEPTH = 8 And UI.UI_MAX_SUBMENU_BINDINGS = 128)
Call Check(MenuNavigator.IsStyleValid(NavigatorStyle))

CandidateMenuStyle = Style
CandidateMenuStyle.SubmenuIndicatorPosition = 2

Call Check(Not Menu.IsStyleValid(CandidateMenuStyle))

Root = Menu.Create(Style, 10, 10, 220, 180, 5)
Child = Menu.Create(Style, 0, 0, 200, 160, 4)
Grandchild = Menu.Create(Style, 0, 0, 180, 140, 4)
RootChild = Menu.AddItem(Root, "Primary", 100, True)
RootShared = Menu.AddItem(Root, "Shared", 101, True)
RootLeaf = Menu.AddItem(Root, "Leaf", 102, True)
RootDisabled = Menu.AddItem(Root, "Disabled", 103, False)
ChildGrandchild = Menu.AddItem(Child, "Deep", 200, True)
ItemIndex = Menu.AddItem(Child, "Second", 201, True)
ItemIndex = Menu.AddItem(Child, "Third", 202, True)
ItemIndex = Menu.AddItem(Grandchild, "Unavailable", 300, False)
ItemIndex = Menu.AddItem(Grandchild, "Available", 301, True)

Navigator = MenuNavigator.Create(Root, NavigatorStyle)

Call Check(Navigator > 0 And MenuNavigator.Depth(Navigator) = 1)
Call Check(MenuNavigator.RootMenu(Navigator) = Root And MenuNavigator.CurrentMenu(Navigator) = Root And MenuNavigator.MenuAtDepth(Navigator, 0) = Root)
Call Check(MenuNavigator.BindSubmenu(Navigator, Root, RootChild, Child, False))
Call Check(MenuNavigator.BindSubmenu(Navigator, Root, RootShared, Child, True))
Call Check(MenuNavigator.BindSubmenu(Navigator, Root, RootDisabled, Grandchild, False))
Call Check(MenuNavigator.BindSubmenu(Navigator, Child, ChildGrandchild, Grandchild, True))
Call Check(Menu.ItemHasSubmenu(Root, RootChild) And Menu.ItemHasSubmenu(Root, RootShared) And MenuNavigator.HasSubmenu(Navigator, Root, RootChild))
Call Check(Not MenuNavigator.BindSubmenu(Navigator, Root, RootChild, Root, False))
Call Check(Not MenuNavigator.BindSubmenu(Navigator, Grandchild, 0, Root, False))

Event = MenuNavigator.HandleKey(Navigator, KEY_RIGHT)

Call Check(Event = UI.UI_EVENT_SUBMENU_OPENED And MenuNavigator.Depth(Navigator) = 2 And MenuNavigator.ParentMenu(Navigator) = Root)

Result = Menu.SetSelectedIndex(Child, 2)
Event = MenuNavigator.HandleKey(Navigator, KEY_LEFT)

Call Check(Result And Event = UI.UI_EVENT_SUBMENU_CLOSED And MenuNavigator.Depth(Navigator) = 1)

Event = MenuNavigator.HandleKey(Navigator, KEY_ENTER)

Call Check(Event = UI.UI_EVENT_SUBMENU_OPENED And Menu.SelectedIndex(Child) = 2)

Event = MenuNavigator.HandleKey(Navigator, KEY_ESCAPE)

Call Check(Event = UI.UI_EVENT_SUBMENU_CLOSED And MenuNavigator.Depth(Navigator) = 1)

Result = Menu.SetSelectedIndex(Root, RootShared)
Result = Result And Menu.SetSelectedIndex(Child, 2)
Event = MenuNavigator.HandleKey(Navigator, KEY_SPACE)

Call Check(Result And Event = UI.UI_EVENT_SUBMENU_OPENED And Menu.SelectedIndex(Child) = 0)

Event = MenuNavigator.HandleKey(Navigator, KEY_RIGHT)

Call Check(Event = UI.UI_EVENT_SUBMENU_OPENED And MenuNavigator.Depth(Navigator) = 3 And Menu.SelectedIndex(Grandchild) = 1)

Event = MenuNavigator.HandleKey(Navigator, KEY_LEFT)

Call Check(Event = UI.UI_EVENT_SUBMENU_CLOSED And MenuNavigator.Depth(Navigator) = 2)

Event = MenuNavigator.HandleKey(Navigator, KEY_ESCAPE)

Call Check(Event = UI.UI_EVENT_SUBMENU_CLOSED And MenuNavigator.Depth(Navigator) = 1)

Event = MenuNavigator.HandleKey(Navigator, KEY_ESCAPE)

Call Check(Event = UI.UI_EVENT_CANCELLED)

Event = MenuNavigator.HandleKey(Navigator, KEY_LEFT)

Call Check(Event = UI.UI_EVENT_NONE)

Result = Menu.SetSelectedIndex(Root, RootLeaf)
Event = MenuNavigator.HandleKey(Navigator, KEY_RIGHT)

Call Check(Result And Event = UI.UI_EVENT_NONE)

Event = MenuNavigator.HandleKey(Navigator, KEY_ENTER)

Call Check(Event = UI.UI_EVENT_ACCEPTED And MenuNavigator.LastAcceptedMenu(Navigator) = Root)
Call Check(MenuNavigator.LastAcceptedIndex(Navigator) = RootLeaf And MenuNavigator.LastAcceptedValue(Navigator) = 102)
Call Check(Not Menu.SetSelectedIndex(Root, RootDisabled))
Call Check(MenuNavigator.Reset(Navigator) And MenuNavigator.Depth(Navigator) = 1 And MenuNavigator.LastAcceptedIndex(Navigator) = -1)

Call Check(MenuNavigator.UnbindSubmenu(Navigator, Root, RootShared) And Not Menu.ItemHasSubmenu(Root, RootShared))
Call MenuNavigator.ClearBindings(Navigator)
Call Check(Not MenuNavigator.HasSubmenu(Navigator, Root, RootChild) And Not Menu.ItemHasSubmenu(Root, RootChild) And MenuNavigator.Depth(Navigator) = 1)

Result = MenuNavigator.BindSubmenu(Navigator, Root, RootChild, Child, False)
OldRevision = Menu.ItemRevision(Root)

Call Menu.ClearItems(Root)

ItemIndex = Menu.AddItem(Root, "Reused Index", 500, True)

Call Check(Result And Menu.ItemRevision(Root) <> OldRevision And Not MenuNavigator.HasSubmenu(Navigator, Root, ItemIndex) And Not Menu.ItemHasSubmenu(Root, ItemIndex))

Result = MenuNavigator.BindSubmenu(Navigator, Root, ItemIndex, Child, False)
Event = MenuNavigator.HandleKey(Navigator, KEY_RIGHT)

Call Menu.Destroy(Child)
Call Check(Result And Event = UI.UI_EVENT_SUBMENU_OPENED And MenuNavigator.Depth(Navigator) = 1 And Not MenuNavigator.HasSubmenu(Navigator, Root, ItemIndex))

StaleNavigator = Navigator

Call MenuNavigator.Destroy(Navigator)

Navigator = MenuNavigator.Create(Root, NavigatorStyle)

Call Check(Navigator > 0 And Navigator <> StaleNavigator And Not MenuNavigator.IsValid(StaleNavigator))
Call MenuNavigator.Destroy(Navigator)
Call Menu.Destroy(Grandchild)
Call Menu.Destroy(Root)

' Active edges follow the exact selected parent item and prune from the first changed ancestor.
Root = Menu.Create(Style, 20, 20, 220, 180, 4)
Child = Menu.Create(Style, 0, 0, 200, 160, 4)
Grandchild = Menu.Create(Style, 0, 0, 190, 150, 4)
DeepChild = Menu.Create(Style, 0, 0, 180, 140, 4)
RootChild = Menu.AddItem(Root, "Open Child", 10, True)
RootShared = Menu.AddItem(Root, "Other Root", 11, True)
ChildGrandchild = Menu.AddItem(Child, "Open Grandchild", 20, True)
ChildOther = Menu.AddItem(Child, "Other Child", 21, True)
GrandchildDeep = Menu.AddItem(Grandchild, "Open Deep", 30, True)
GrandchildOther = Menu.AddItem(Grandchild, "Other Grandchild", 31, True)
ItemIndex = Menu.AddItem(DeepChild, "Deepest Leaf", 40, True)
Navigator = MenuNavigator.Create(Root, NavigatorStyle)
Result = MenuNavigator.BindSubmenu(Navigator, Root, RootChild, Child, False)
Result = Result And MenuNavigator.BindSubmenu(Navigator, Child, ChildGrandchild, Grandchild, False)
Result = Result And MenuNavigator.BindSubmenu(Navigator, Grandchild, GrandchildDeep, DeepChild, False)
Event = MenuNavigator.HandleKey(Navigator, KEY_RIGHT)
Result = Result And Event = UI.UI_EVENT_SUBMENU_OPENED
Event = MenuNavigator.HandleKey(Navigator, KEY_ENTER)
Result = Result And Event = UI.UI_EVENT_SUBMENU_OPENED
Event = MenuNavigator.HandleKey(Navigator, KEY_SPACE)

Call Check(Result And Event = UI.UI_EVENT_SUBMENU_OPENED And MenuNavigator.Depth(Navigator) = 4)

Event = MenuNavigator.HandleKey(Navigator, KEY_ENTER)

Call Check(Event = UI.UI_EVENT_ACCEPTED And MenuNavigator.LastAcceptedValue(Navigator) = 40)

Result = Menu.SetSelectedIndex(Root, RootShared)

Call Check(Result And MenuNavigator.Depth(Navigator) = 1 And MenuNavigator.CurrentMenu(Navigator) = Root And MenuNavigator.LastAcceptedIndex(Navigator) = -1)

Result = Menu.SetSelectedIndex(Root, RootChild)
Event = MenuNavigator.HandleKey(Navigator, KEY_RIGHT)
Result = Result And Event = UI.UI_EVENT_SUBMENU_OPENED
Event = MenuNavigator.HandleKey(Navigator, KEY_RIGHT)
Result = Result And Event = UI.UI_EVENT_SUBMENU_OPENED
Event = MenuNavigator.HandleKey(Navigator, KEY_RIGHT)

Call Check(Result And Event = UI.UI_EVENT_SUBMENU_OPENED And MenuNavigator.Depth(Navigator) = 4)

Result = Menu.SetSelectedIndex(Child, ChildOther)

Call Check(Result And MenuNavigator.Depth(Navigator) = 2 And MenuNavigator.CurrentMenu(Navigator) = Child)

Result = Menu.SetSelectedIndex(Child, ChildGrandchild)
Event = MenuNavigator.HandleKey(Navigator, KEY_RIGHT)
Result = Result And Event = UI.UI_EVENT_SUBMENU_OPENED
Event = MenuNavigator.HandleKey(Navigator, KEY_RIGHT)

Call Check(Result And Event = UI.UI_EVENT_SUBMENU_OPENED And MenuNavigator.Depth(Navigator) = 4)

Result = Menu.SetItemLabel(Root, RootChild, "Renamed Active Edge")

Call Check(Result And MenuNavigator.Depth(Navigator) = 4)

Result = Menu.SetItemValue(Root, RootChild, 12)

Call Check(Result And MenuNavigator.Depth(Navigator) = 4)

CandidateMenuStyle = Style
CandidateMenuStyle.SelectionFillColor = 123
Result = Menu.SetStyle(Root, CandidateMenuStyle)

Call Check(Result And MenuNavigator.Depth(Navigator) = 4)

Result = Menu.SetPosition(Root, 30, 30)
Result = Result And MenuNavigator.Relayout(Navigator)

Call Check(Result And MenuNavigator.Depth(Navigator) = 4)

Result = Menu.SetItemEnabled(Root, RootChild, False)

Call Check(Result And MenuNavigator.Depth(Navigator) = 1 And MenuNavigator.CurrentMenu(Navigator) = Root)

Call MenuNavigator.Destroy(Navigator)
Call Menu.Destroy(DeepChild)
Call Menu.Destroy(Grandchild)
Call Menu.Destroy(Child)
Call Menu.Destroy(Root)

' Exact root clamp, left fallback, bottom adjustment, style transaction, overlap, and oversize rejection.
Root = Menu.Create(Style, 600, 330, 200, 150, 5)
Child = Menu.Create(Style, 0, 0, 180, 140, 4)

For I = 0 To 4
    ItemIndex = Menu.AddItem(Root, "Row", I, True)
End For
ItemIndex = Menu.AddItem(Child, "Leaf", 1, True)
Result = Menu.SetSelectedIndex(Root, 4)
Navigator = MenuNavigator.Create(Root, NavigatorStyle)
RootBounds = Menu.Bounds(Root)

Call Check(Result And RootBounds.X = 430 And RootBounds.Y = 200)

Result = MenuNavigator.BindSubmenu(Navigator, Root, 4, Child, False)
Event = MenuNavigator.HandleKey(Navigator, KEY_RIGHT)
ChildBounds = Menu.Bounds(Child)

Call Check(Result And Event = UI.UI_EVENT_SUBMENU_OPENED And ChildBounds.X = 242 And ChildBounds.Y = 210)
Call Check(ChildBounds.X >= 10 And ChildBounds.Y >= 10 And ChildBounds.X + ChildBounds.Width <= 630 And ChildBounds.Y + ChildBounds.Height <= 350)

CandidateStyle = NavigatorStyle
CandidateStyle.PreferredDirection = UI.UI_SUBMENU_DIRECTION_LEFT
Result = Menu.SetPosition(Root, 300, 50)
Result = Result And MenuNavigator.SetStyle(Navigator, CandidateStyle)
ChildBounds = Menu.Bounds(Child)

Call Check(Result And ChildBounds.X = 112)

OldBounds = Menu.Bounds(Child)
CandidateStyle.Viewport.Width = 150

Call Check(Not MenuNavigator.SetStyle(Navigator, CandidateStyle))

ChildBounds = Menu.Bounds(Child)

Call Check(ChildBounds.X = OldBounds.X And ChildBounds.Y = OldBounds.Y)

CandidateStyle = NavigatorStyle
CandidateStyle.Viewport.Width = 250
Result = MenuNavigator.SetStyle(Navigator, CandidateStyle)
RootBounds = Menu.Bounds(Root)
ChildBounds = Menu.Bounds(Child)

Call Check(Result And RootBounds.X >= 10 And RootBounds.X + RootBounds.Width <= 240)
Call Check(ChildBounds.X >= 10 And ChildBounds.X + ChildBounds.Width <= 240 And ChildBounds.X < RootBounds.X + RootBounds.Width)

Oversized = Menu.Create(Style, 0, 0, 300, 100, 3)
ItemIndex = Menu.AddItem(Oversized, "Too Wide", 0, True)

Call Check(Not MenuNavigator.BindSubmenu(Navigator, Root, 0, Oversized, False))
Call MenuNavigator.Destroy(Navigator)
Call Menu.Destroy(Oversized)
Call Menu.Destroy(Child)
Call Menu.Destroy(Root)

Oversized = Menu.Create(Style, 0, 0, 700, 100, 3)

Call Check(MenuNavigator.Create(Oversized, NavigatorStyle) = 0)
Call Menu.Destroy(Oversized)

' Navigator registry capacity and stale generations.
Root = Menu.Create(Style, 0, 0, 100, 100, 3)
ItemIndex = Menu.AddItem(Root, "Root", 0, True)

For I = 0 To 7
    ExtraNavigators[I] = MenuNavigator.Create(Root, NavigatorStyle)
End For

Call Check(ExtraNavigators[0] > 0 And ExtraNavigators[7] > 0 And MenuNavigator.Create(Root, NavigatorStyle) = 0)

For I = 0 To 7
    Call MenuNavigator.Destroy(ExtraNavigators[I])
End For

Call Menu.Destroy(Root)

' Depth capacity and cycle rejection across a full eight-level active stack.

For I = 0 To 8
    ChainMenus[I] = Menu.Create(Style, 0, 0, 100, 100, 3)
    ItemIndex = Menu.AddItem(ChainMenus[I], "Next", I, True)
End For
DeepLeafIndex = Menu.AddItem(ChainMenus[7], "Level Eight Leaf", 700, True)
Navigator = MenuNavigator.Create(ChainMenus[0], NavigatorStyle)
Result = True

For I = 0 To 7
    Result = Result And MenuNavigator.BindSubmenu(Navigator, ChainMenus[I], 0, ChainMenus[I + 1], False)
End For

For I = 0 To 6
    Event = MenuNavigator.HandleKey(Navigator, KEY_RIGHT)
    Result = Result And Event = UI.UI_EVENT_SUBMENU_OPENED
End For

Call Check(Result And MenuNavigator.Depth(Navigator) = 8 And MenuNavigator.CurrentMenu(Navigator) = ChainMenus[7])
Call Check(MenuNavigator.LastAcceptedMenu(Navigator) = 0 And MenuNavigator.LastAcceptedIndex(Navigator) = -1 And MenuNavigator.LastAcceptedValue(Navigator) = 0)

Event = MenuNavigator.HandleKey(Navigator, KEY_RIGHT)

Call Check(Event = UI.UI_EVENT_NONE And MenuNavigator.Depth(Navigator) = 8 And MenuNavigator.CurrentMenu(Navigator) = ChainMenus[7] And MenuNavigator.LastAcceptedIndex(Navigator) = -1)

Event = MenuNavigator.HandleKey(Navigator, KEY_ENTER)

Call Check(Event = UI.UI_EVENT_NONE And MenuNavigator.Depth(Navigator) = 8 And MenuNavigator.CurrentMenu(Navigator) = ChainMenus[7] And MenuNavigator.LastAcceptedMenu(Navigator) = 0 And MenuNavigator.LastAcceptedIndex(Navigator) = -1 And MenuNavigator.LastAcceptedValue(Navigator) = 0)

Event = MenuNavigator.HandleKey(Navigator, KEY_SPACE)

Call Check(Event = UI.UI_EVENT_NONE And MenuNavigator.Depth(Navigator) = 8 And MenuNavigator.CurrentMenu(Navigator) = ChainMenus[7] And MenuNavigator.LastAcceptedMenu(Navigator) = 0 And MenuNavigator.LastAcceptedIndex(Navigator) = -1 And MenuNavigator.LastAcceptedValue(Navigator) = 0)

CandidateMenuStyle = Style
CandidateMenuStyle.ShowSubmenuIndicator = False
Result = Menu.SetStyle(ChainMenus[7], CandidateMenuStyle)
Event = MenuNavigator.HandleKey(Navigator, KEY_ENTER)

Call Check(Result And Event = UI.UI_EVENT_NONE And MenuNavigator.Depth(Navigator) = 8 And MenuNavigator.LastAcceptedIndex(Navigator) = -1)

Result = Menu.SetSelectedIndex(ChainMenus[7], DeepLeafIndex)
Event = MenuNavigator.HandleKey(Navigator, KEY_ENTER)

Call Check(Result And Event = UI.UI_EVENT_ACCEPTED And MenuNavigator.LastAcceptedMenu(Navigator) = ChainMenus[7] And MenuNavigator.LastAcceptedIndex(Navigator) = DeepLeafIndex And MenuNavigator.LastAcceptedValue(Navigator) = 700)

Result = Menu.SetSelectedIndex(ChainMenus[7], 0)
Event = MenuNavigator.HandleKey(Navigator, KEY_ENTER)

Call Check(Result And Event = UI.UI_EVENT_NONE And MenuNavigator.Depth(Navigator) = 8 And MenuNavigator.LastAcceptedMenu(Navigator) = ChainMenus[7] And MenuNavigator.LastAcceptedIndex(Navigator) = DeepLeafIndex And MenuNavigator.LastAcceptedValue(Navigator) = 700)

Event = MenuNavigator.HandleKey(Navigator, KEY_SPACE)

Call Check(Event = UI.UI_EVENT_NONE And MenuNavigator.Depth(Navigator) = 8 And MenuNavigator.LastAcceptedMenu(Navigator) = ChainMenus[7] And MenuNavigator.LastAcceptedIndex(Navigator) = DeepLeafIndex And MenuNavigator.LastAcceptedValue(Navigator) = 700)
Call Check(Not MenuNavigator.BindSubmenu(Navigator, ChainMenus[8], 0, ChainMenus[0], False))
Call MenuNavigator.Destroy(Navigator)

For I = 0 To 8
    Call Menu.Destroy(ChainMenus[I])
End For

' Disabled bound parents and reset failures remain inert for every opening key.
ParentOne = Menu.Create(Style, 0, 0, 100, 100, 2)
SharedChild = Menu.Create(Style, 0, 0, 100, 100, 2)
ItemIndex = Menu.AddItem(ParentOne, "Disabled Parent", 1, False)
ItemIndex = Menu.AddItem(SharedChild, "Child Leaf", 2, True)
Navigator = MenuNavigator.Create(ParentOne, NavigatorStyle)
Result = MenuNavigator.BindSubmenu(Navigator, ParentOne, 0, SharedChild, False)

Call Check(Result And Menu.SelectedIndex(ParentOne) = -1)

Event = MenuNavigator.HandleKey(Navigator, KEY_RIGHT)

Call Check(Event = UI.UI_EVENT_NONE And MenuNavigator.Depth(Navigator) = 1)

Event = MenuNavigator.HandleKey(Navigator, KEY_ENTER)
Result = Event = UI.UI_EVENT_NONE
Event = MenuNavigator.HandleKey(Navigator, KEY_SPACE)

Call Check(Result And Event = UI.UI_EVENT_NONE And MenuNavigator.LastAcceptedIndex(Navigator) = -1)
Call MenuNavigator.Destroy(Navigator)
Call Menu.Destroy(SharedChild)
Call Menu.Destroy(ParentOne)

ParentOne = Menu.Create(Style, 0, 0, 100, 100, 2)
SharedChild = Menu.Create(Style, 0, 0, 100, 100, 2)
ItemIndex = Menu.AddItem(ParentOne, "Reset Child", 3, True)
ItemIndex = Menu.AddItem(SharedChild, "Disabled Child", 4, False)
Navigator = MenuNavigator.Create(ParentOne, NavigatorStyle)
Result = MenuNavigator.BindSubmenu(Navigator, ParentOne, 0, SharedChild, True)
Event = MenuNavigator.HandleKey(Navigator, KEY_RIGHT)

Call Check(Result And Event = UI.UI_EVENT_NONE And MenuNavigator.Depth(Navigator) = 1)

Event = MenuNavigator.HandleKey(Navigator, KEY_ENTER)
Result = Event = UI.UI_EVENT_NONE
Event = MenuNavigator.HandleKey(Navigator, KEY_SPACE)

Call Check(Result And Event = UI.UI_EVENT_NONE And MenuNavigator.Depth(Navigator) = 1 And MenuNavigator.LastAcceptedIndex(Navigator) = -1)
Call MenuNavigator.Destroy(Navigator)
Call Menu.Destroy(SharedChild)
Call Menu.Destroy(ParentOne)

' The current navigator binding table, rather than a shared visual marker, is acceptance authority.
ParentOne = Menu.Create(Style, 0, 0, 100, 100, 2)
SharedChild = Menu.Create(Style, 0, 0, 100, 100, 2)
ItemIndex = Menu.AddItem(ParentOne, "Shared Marker Leaf", 5, True)
ItemIndex = Menu.AddItem(SharedChild, "Child Leaf", 6, True)
Navigator = MenuNavigator.Create(ParentOne, NavigatorStyle)
OtherNavigator = MenuNavigator.Create(ParentOne, NavigatorStyle)
Result = MenuNavigator.BindSubmenu(Navigator, ParentOne, 0, SharedChild, False)

Call Check(Result And Menu.ItemHasSubmenu(ParentOne, 0) And Not MenuNavigator.HasSubmenu(OtherNavigator, ParentOne, 0))

Event = MenuNavigator.HandleKey(OtherNavigator, KEY_ENTER)

Call Check(Event = UI.UI_EVENT_ACCEPTED And MenuNavigator.LastAcceptedMenu(OtherNavigator) = ParentOne And MenuNavigator.LastAcceptedValue(OtherNavigator) = 5)

Event = MenuNavigator.HandleKey(Navigator, KEY_RIGHT)

Call Check(Event = UI.UI_EVENT_SUBMENU_OPENED And MenuNavigator.Depth(Navigator) = 2)
Call MenuNavigator.Destroy(OtherNavigator)
Call MenuNavigator.Destroy(Navigator)
Call Menu.Destroy(SharedChild)
Call Menu.Destroy(ParentOne)

' Exact binding capacity with shared leaf menus.
ParentOne = Menu.Create(Style, 0, 0, 100, 100, 3)
ParentTwo = Menu.Create(Style, 0, 0, 100, 100, 3)
ParentThree = Menu.Create(Style, 0, 0, 100, 100, 3)
SharedChild = Menu.Create(Style, 0, 0, 100, 100, 3)

For I = 0 To 63
    ItemIndex = Menu.AddItem(ParentOne, "A", I, True)
    ItemIndex = Menu.AddItem(ParentTwo, "B", I, True)
End For
ItemIndex = Menu.AddItem(ParentThree, "C", 0, True)
ItemIndex = Menu.AddItem(SharedChild, "Leaf", 0, True)
Navigator = MenuNavigator.Create(ParentOne, NavigatorStyle)
Result = True

For I = 0 To 63
    Result = Result And MenuNavigator.BindSubmenu(Navigator, ParentOne, I, SharedChild, False)
    Result = Result And MenuNavigator.BindSubmenu(Navigator, ParentTwo, I, SharedChild, False)
End For

Call Check(Result And Not MenuNavigator.BindSubmenu(Navigator, ParentThree, 0, SharedChild, False))
Call MenuNavigator.ClearBindings(Navigator)
Call Check(Not Menu.ItemHasSubmenu(ParentOne, 0) And Not Menu.ItemHasSubmenu(ParentTwo, 63))
Call MenuNavigator.Destroy(Navigator)
Call Menu.Destroy(SharedChild)
Call Menu.Destroy(ParentThree)
Call Menu.Destroy(ParentTwo)
Call Menu.Destroy(ParentOne)

' Bounded Unicode labels.
LongMenu = Menu.Create(Style, 0, 0, 200, 120, 3)

For I = 1 To 256
    LongValue = LongValue + "😀"
End For
ItemIndex = Menu.AddItem(LongMenu, LongValue, 1, True)

Call Check(ItemIndex = 0 And Text_Length(LongValue) = UI.UI_MAX_MENU_ITEM_SCALARS)

LongValue = LongValue + "😀"

Call Check(Menu.AddItem(LongMenu, LongValue, 2, True) = -1 And Menu.ItemCount(LongMenu) = 1)
Call Check(Not Menu.SetItemLabel(LongMenu, 0, LongValue) And Menu.ItemCount(LongMenu) = 1)
Call Check(Menu.AddItem(LongMenu, "", 3, True) = 1 And Menu.AddItem(LongMenu, "Line One
Line Two", 4, True) = 2)
Call Menu.Destroy(LongMenu)

End Program
