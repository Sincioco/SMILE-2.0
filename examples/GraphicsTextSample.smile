' Required DirectWrite and GDI final-resolution text comparison sample.
Game Window "SMILE 2.0 Graphics Text Sample"

Do
    Get Key Key

    If Key = KEY_ESCAPE Then
        End Program
    End If

    Clear Rgb(10, 14, 24)
    Draw Text "Final-Resolution Text" At 480, 42 Size 34 Color CYAN Centered
    Draw Text "Abcdefghijklmnopqrstuvwxyz" At 480, 112 Size 26 Color WHITE Centered
    Draw Text "abcdefghijklmnopqrstuvwxyz" At 480, 158 Size 26 Color LIGHT_GRAY Centered
    Draw Text "0123456789" At 480, 204 Size 26 Color YELLOW Centered
    Draw Text "!@#$%^&*()" At 480, 250 Size 26 Color ORANGE Centered
    Draw Text "Score" At 480, 318 Size 30 Color LIGHT_GREEN Centered
    Draw Text "Computer" At 480, 362 Size 30 Color MAGENTA Centered
    Draw Text "Player 1" At 480, 406 Size 30 Color LIGHT_BLUE Centered
    Draw Text "Best One-Player Rally" At 480, 450 Size 30 Color WHITE Centered
    Draw Text "Alt+Enter Full Screen - Escape Exits" At 480, 506 Size 18 Color LIGHT_GRAY Centered
    Show Screen

Loop Until Game_Closed() = True

End Program
