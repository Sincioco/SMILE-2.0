' Structured language and native backend smoke coverage.
Const BoardWidth = 10
Const BoardHeight = 4 * 5
Const MaximumCells = BoardWidth * BoardHeight

Dim Board[BoardWidth, BoardHeight]

Sub StoreCell(Column, Row, Value)
    Adjusted = Max(0, Value)
    Board[Column, Row] = Adjusted
End Sub

Function IsEven(Value)
    If Value Mod 2 = 0 Then
        Return True
    Else
        Return False
    End If
End Function

Call StoreCell(2, 3, 12)

Selected = 0
Select Case Board[2, 3] / 3
    Case 4
        Selected = 40
    Case Else
        Selected = -1
End Select

Counter = 0
Do
    Counter = Counter + 1
    Exit Do
Loop

For Index = 0 To 9
    If Index = 2 Then
        Exit For
    End If
End For

If IsEven(Board[2, 3]) = True Then
    Print "Even"
End If

Print Board[2, 3]
Print Selected
Print Counter
Print Index
Print MaximumCells
Print Abs(-5)
Print Min(7, 3)
Print Rgb(40, 220, 30)
Print KEY_LEFT
Print LIGHT_BLUE
End Program
