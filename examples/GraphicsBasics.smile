' Demonstrates the complete generic SMILE 2.0 game runtime surface.
Const CanvasWidth = 960
Const CanvasHeight = 540

Game Window "SMILE 2.0 Graphics Basics"

Load LaunchCount From "LaunchCount" Default 0
LaunchCount = LaunchCount + 1
Save LaunchCount To "LaunchCount"

MarkerX = 480
MarkerY = 420
Play Sound "Assets\Missing.wav"
Play Sound "Assets\Graphics.wav"

Do
    Get Key Key
    If Key = KEY_ESCAPE Then
        End Program
    End If

    If Key_Held(KEY_LEFT) = True Then
        MarkerX = Max(20, MarkerX - 4)
    End If
    If Key_Held(KEY_RIGHT) = True Then
        MarkerX = Min(CanvasWidth - 20, MarkerX + 4)
    End If
    If Key_Held(KEY_UP) = True Then
        MarkerY = Max(20, MarkerY - 4)
    End If
    If Key_Held(KEY_DOWN) = True Then
        MarkerY = Min(CanvasHeight - 20, MarkerY + 4)
    End If

    Clear Rgb(18, 22, 38)
    Fill Rectangle 40, 60, 180, 90, DARK_BLUE
    Draw Rectangle 40, 60, 180, 90, LIGHT_BLUE
    Fill Rounded Rectangle 260, 60, 180, 90, 18, DARK_GREEN
    Draw Rounded Rectangle 260, 60, 180, 90, 18, LIGHT_GREEN
    Fill Circle 560, 105, 45, MAGENTA
    Draw Circle 680, 105, 45, YELLOW
    Fill Quadrilateral 760, 60, 900, 75, 870, 145, 785, 130, DARK_RED
    Draw Quadrilateral 760, 60, 900, 75, 870, 145, 785, 130, LIGHT_RED
    Draw Line 760, 165, 900, 165, ORANGE
    Draw Text "Hello, SMILE!" At 480, 190 Size 42 Color WHITE Centered
    Draw Text "Arrows Move The Marker - Escape Exits" At 480, 255 Size 22 Color LIGHT_GRAY Centered
    Draw Text "Launch Count" At 380, 315 Size 24 Color CYAN
    Draw Number LaunchCount At 570, 315 Size 24 Color CYAN
    Draw Text "Timer" At 380, 350 Size 24 Color YELLOW
    Draw Number Timer() At 500, 350 Size 24 Color YELLOW
    Draw Text "Unnamed Keys Report KEY_OTHER" At 480, 385 Size 18 Color LIGHT_BLUE Centered
    Fill Circle MarkerX, MarkerY, 14, RED
    Draw Circle MarkerX, MarkerY, 18, WHITE
    Show Screen
    Wait 16 Milliseconds
Loop Until Game_Closed() = True

Stop Sound
End Program
