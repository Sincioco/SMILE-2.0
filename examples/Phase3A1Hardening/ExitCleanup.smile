OPTION EXPLICIT

CALL Exercise("STOP")
PRINT "DONE"

END PROGRAM

SUB Exercise(Command AS TEXT)
    DIM Index AS NUMBER
    DIM Run AS NUMBER

    FOR Run = 1 TO 1000
        FOR Index = 1 TO 3
            SELECT CASE Command + ""
                CASE "STOP"
                    EXIT FOR
            END SELECT
        END FOR

        DO
            SELECT CASE Command + ""
                CASE "STOP"
                    EXIT DO
            END SELECT
        LOOP
    END FOR
END SUB
