Option Explicit

Const Prefix = "C"

Dim First As Text
Dim Copy As Text
Dim TextValues[2] As Text
Dim NumberValues[2] As Number
Dim BooleanValues[2] As Boolean
Dim Counter As Number
Dim Ready As Boolean

First = "A"
Copy = First
First = First + "b"
Print Copy
Print First
Print First <> Copy

TextValues[1] = "Array"
NumberValues[1] = 10
BooleanValues[1] = False

Call ChangeByValue(TextValues[1])

Print TextValues[1]

Call SetText(TextValues[1], "Changed")
Call Increment(NumberValues[1])
Call Toggle(BooleanValues[1])

Print TextValues[1]
Print NumberValues[1]
Print BooleanValues[1]

Counter = 3
Ready = False

Call Increment(Counter)
Call Toggle(Ready)

Print Counter
Print Ready
Print ReturnText()
Print Join("N", "est")
Print AddFive(1, 2, 3, 4, 5)

Select Case Prefix + "ase"
    Case "Case"
        Print "Select"
End Select

End Program

Sub ChangeByValue(Value As Text)

    Value = "Local"

End Sub

Sub SetText(ByRef Value As Text, NewValue As Text)

    Value = NewValue

End Sub

Sub Increment(ByRef Value As Number)

    Value = Value + 1

End Sub

Sub Toggle(ByRef Value As Boolean)

    Value = Not Value

End Sub

Function ReturnText() As Text

    Dim ReturnValue As Text

    ReturnValue = "Return"
    Return ReturnValue

End Function

Function Join(LeftValue As Text, RightValue As Text) As Text

    Dim ReturnValue As Text

    ReturnValue = LeftValue + RightValue
    Return ReturnValue

End Function

Function AddFive(Value1 As Number, Value2 As Number, Value3 As Number, Value4 As Number, Value5 As Number) As Number

    Dim ReturnValue As Number

    ReturnValue = Value1 + Value2 + Value3 + Value4 + Value5
    Return ReturnValue

End Function
