Option Explicit

Print Choose("Return")

End Program

Function Choose(Command As Text) As Text
    Select Case Command + ""
        Case "Return"
            Do
                Select Case "Inner" + ""
                    Case "Inner"
                        Return BuildResult("Return", "ed")
                End Select
            Loop
    End Select
    Return "Failed"
End Function

Function BuildResult(LeftValue As Text, RightValue As Text) As Text
    Dim Result As Text
    Result = LeftValue + RightValue
    Return Result
End Function
