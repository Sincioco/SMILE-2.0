Option Explicit

Import Smile.RPG.Core As RPG
Import Smile.Battle3D.Articulation As Articulation
Import Smile.Battle3D.Camera As BattleCamera
Import Smile.Battle3D.Effects As Effects

Const SHOT_DEFAULT = 1
Const SHOT_IMPACT = 2
Const SHOT_FRAMED = 3
Const EFFECT_FIRE = 1
Const EFFECT_MIST = 2
Const EFFECT_STORM = 3

Dim Checks As Number
Dim Failures As Number
Dim StateA As Number
Dim StateB As Number
Dim Index As Number
Dim FirstParticle As Number
Dim Shot As BattleCamera.ShotDefinition
Dim Bounds As BattleCamera.FramingBounds3D
Dim Preset As Effects.EffectPreset
Dim Projected As BattleCamera.ProjectedPoint3D
Dim ManualPanBeforeReturn As Number
Dim FramingDistanceBefore As Number
Dim OrbitPositionBefore As Number
Dim Segment As Articulation.SegmentPose3D

StateA = RPG.Create()
StateB = RPG.Create()

Call Check(StateA > 0)
Call Check(StateB > 0)
Call DefineContent(StateA)
Call DefineContent(StateB)

' Rigid articulation solves exact joint chains and deterministic motion envelopes.

Segment = Articulation.SolveHangingSegment(10, 200, 30, 100, 0, 0)

Call Check(Segment.CenterX = 10)
Call Check(Segment.CenterY = 150)
Call Check(Segment.CenterZ = 30)
Call Check(Segment.EndX = 10)
Call Check(Segment.EndY = 100)
Call Check(Segment.EndZ = 30)
Call Check(Segment.RotationZ = 0)

Segment = Articulation.SolveHangingSegment(10, 200, 30, 100, 90, 0)

Call Check(Segment.CenterX = 60)
Call Check(Segment.CenterY = 200)
Call Check(Segment.EndX = 110)
Call Check(Segment.EndY = 200)
Call Check(Segment.RotationZ = 90)

Segment = Articulation.SolveHangingSegment(10, 200, 30, 100, 0, 90)

Call Check(Segment.CenterZ = 80)
Call Check(Segment.EndZ = 130)
Call Check(Segment.RotationX = -90)
Call Check(Articulation.CycleAngle(1, 4, 30, 0) = 30)
Call Check(Articulation.CycleAngle(3, 4, 30, 0) = -30)
Call Check(Articulation.PositiveCycle(3, 4, 30, 0) = 0)
Call Check(Articulation.ActionEnvelope(5, 0, 10, 20, 90) = 45)
Call Check(Articulation.ActionEnvelope(10, 0, 10, 20, 90) = 90)
Call Check(Articulation.ActionEnvelope(15, 0, 10, 20, 90) = 45)
Call Check(Articulation.ActionEnvelope(20, 0, 10, 20, 90) = 0)

' Camera interpolation and shake produce identical state for equivalent fixed-step chunks.

Call Check(BattleCamera.PlayShot(StateA, SHOT_DEFAULT, 0))
Call Check(BattleCamera.PlayShot(StateB, SHOT_DEFAULT, 0))
Call Check(BattleCamera.PositionY(StateA) = 220)
Call Check(BattleCamera.FovDegrees(StateA) = 55)
Call Check(BattleCamera.PlayShot(StateA, SHOT_IMPACT, 10))
Call Check(BattleCamera.PlayShot(StateB, SHOT_IMPACT, 10))
Call Check(BattleCamera.Update(StateA, 10))

For Index = 1 To 10
    Call Check(BattleCamera.Update(StateB, 1))
End For

Call Check(BattleCamera.PositionX(StateA) = BattleCamera.PositionX(StateB))
Call Check(BattleCamera.PositionY(StateA) = BattleCamera.PositionY(StateB))
Call Check(BattleCamera.PositionZ(StateA) = BattleCamera.PositionZ(StateB))

Call Check(BattleCamera.CurrentShotName(StateA) = "TargetImpact")
Call Check(BattleCamera.IsComplete(StateA))

' Bounds-driven framing centers arbitrary groups and backs up as their footprint grows.

Bounds.MinX = -200
Bounds.MinY = 0
Bounds.MinZ = -100
Bounds.MaxX = 400
Bounds.MaxY = 300
Bounds.MaxZ = 100

Call Check(BattleCamera.DefineFramedShot(StateA, SHOT_FRAMED, "GroupFrame", Bounds, -25, 30, -100, 960, 540, 55, 20, 0))
Call Check(BattleCamera.PlayShot(StateA, SHOT_FRAMED, 0))
Call Check(BattleCamera.TargetX(StateA) = 100)
Call Check(BattleCamera.TargetY(StateA) = 150)
Call Check(BattleCamera.TargetZ(StateA) = 0)

FramingDistanceBefore = Abs(BattleCamera.PositionZ(StateA) - BattleCamera.TargetZ(StateA))
Bounds.MaxX = 1000

Call Check(BattleCamera.DefineFramedShot(StateA, SHOT_FRAMED, "GroupFrame", Bounds, -25, 30, -100, 960, 540, 55, 20, 0))
Call Check(BattleCamera.PlayShot(StateA, SHOT_FRAMED, 0))
Call Check(Abs(BattleCamera.PositionZ(StateA) - BattleCamera.TargetZ(StateA)) > FramingDistanceBefore)
Call Check(Not BattleCamera.DefineFramedShot(StateA, SHOT_FRAMED, "Invalid", Bounds, 0, 0, 0, 960, 540, 55, 20, 0))
Call Check(BattleCamera.FollowPoint(StateA, 450, 320, -75, -380, 190, -720, 62))
Call Check(BattleCamera.TargetX(StateA) = 450)
Call Check(BattleCamera.TargetY(StateA) = 320)
Call Check(BattleCamera.PositionZ(StateA) = -795)
Call Check(BattleCamera.FovDegrees(StateA) = 62)
Call Check(Not BattleCamera.FollowPoint(StateA, 0, 0, 0, 0, 0, -100, 5))
Call Check(BattleCamera.FollowPoint(StateB, 450, 320, -75, -380, 190, -720, 62))
Call Check(BattleCamera.StartShake(StateA, 18, 6, 77))
Call Check(BattleCamera.StartShake(StateB, 18, 6, 77))
Call Check(BattleCamera.Update(StateA, 3))

For Index = 1 To 3
    Call Check(BattleCamera.Update(StateB, 1))
End For

Call Check(BattleCamera.PositionX(StateA) = BattleCamera.PositionX(StateB))
Call Check(BattleCamera.PositionY(StateA) = BattleCamera.PositionY(StateB))
Call Check(BattleCamera.PositionZ(StateA) = BattleCamera.PositionZ(StateB))
Call Check(BattleCamera.StartShake(StateA, 0, 0, 0))

' Bounded shot variation changes composition without mutating the stored shot.

Call Check(BattleCamera.PlayShotVariation(StateA, SHOT_DEFAULT, 0, 25, 10, -15, 5, -3, 7, 2))
Call Check(BattleCamera.PositionX(StateA) = 25)
Call Check(BattleCamera.PositionY(StateA) = 230)
Call Check(BattleCamera.PositionZ(StateA) = -865)
Call Check(BattleCamera.TargetX(StateA) = 5)
Call Check(BattleCamera.TargetY(StateA) = 97)
Call Check(BattleCamera.TargetZ(StateA) = 7)
Call Check(BattleCamera.FovDegrees(StateA) = 57)
Call Check(Not BattleCamera.PlayShotVariation(StateA, SHOT_DEFAULT, 0, 0, 0, 0, 0, 0, 0, 200))

' Manual pan and wheel zoom compose over cinematic shots, then ease back after release.

Call Check(BattleCamera.UpdateManualInput(StateA, True, True, False, 18, -9, 2))
Call Check(BattleCamera.IsManualDragging(StateA))
Call Check(BattleCamera.ManualPanX(StateA) = -36)
Call Check(BattleCamera.ManualPanY(StateA) = -18)
Call Check(BattleCamera.ManualZoom(StateA) = -8)
Call Check(BattleCamera.IsManualActive(StateA))

Projected = BattleCamera.ProjectWorldPoint(StateA,
    BattleCamera.TargetX(StateA),
    BattleCamera.TargetY(StateA),
    BattleCamera.TargetZ(StateA),
    960,
    540)

Call Check(Projected.Visible)
Call Check(Abs(Projected.X - 480) <= 1)
Call Check(Abs(Projected.Y - 270) <= 1)
Call Check(BattleCamera.UpdateManualInput(StateA, False, False, True, 0, 0, 0))
Call Check(Not BattleCamera.IsManualDragging(StateA))

ManualPanBeforeReturn = Abs(BattleCamera.ManualPanX(StateA))

Call Check(BattleCamera.Update(StateA, 14))
Call Check(Abs(BattleCamera.ManualPanX(StateA)) < ManualPanBeforeReturn)
Call Check(BattleCamera.Update(StateA, 100))
Call Check(Not BattleCamera.IsManualActive(StateA))
Call Check(BattleCamera.UpdateManualInput(StateA, True, True, False, 2, 2, 0))
Call Check(BattleCamera.UpdateManualInput(StateA, False, False, False, 0, 0, 0))
Call Check(Not BattleCamera.IsManualDragging(StateA))
Call Check(Not BattleCamera.UpdateManualInput(StateA, True, True, False, 10001, 0, 0))

' Middle-drag orbit composes with pan/zoom and has the same missed-release fail-safe.

OrbitPositionBefore = BattleCamera.PositionX(StateA)

Call Check(BattleCamera.UpdateManualOrbitInput(StateA, True, True, False, 20, -10))
Call Check(BattleCamera.IsManualOrbiting(StateA))
Call Check(BattleCamera.ManualOrbitYaw(StateA) = 60)
Call Check(BattleCamera.ManualOrbitPitch(StateA) = -20)
Call Check(BattleCamera.PositionX(StateA) <> OrbitPositionBefore)
Call Check(BattleCamera.UpdateManualOrbitInput(StateA, False, False, True, 0, 0))
Call Check(Not BattleCamera.IsManualOrbiting(StateA))
Call Check(BattleCamera.Update(StateA, 120))
Call Check(Not BattleCamera.IsManualActive(StateA))
Call Check(BattleCamera.UpdateManualOrbitInput(StateA, True, True, False, 3, 2))
Call Check(BattleCamera.UpdateManualOrbitInput(StateA, False, False, False, 0, 0))
Call Check(Not BattleCamera.IsManualOrbiting(StateA))
Call Check(Not BattleCamera.UpdateManualOrbitInput(StateA, True, True, False, 10001, 0))

' Seeded additive billboard particles, flash, color/size fades, and expiry are deterministic.

Call Check(Effects.Spawn(StateA, EFFECT_FIRE, 10, 20, 30, 99))
Call Check(Effects.Spawn(StateB, EFFECT_FIRE, 10, 20, 30, 99))
Call Check(Effects.ActiveCount(StateA) = 8)
Call Check(Effects.FlashOpacity(StateA) = 100)
Call Check(Effects.ShakeAmplitude(StateA, EFFECT_FIRE) = 14)

FirstParticle = FirstActiveParticle(StateA)

Call Check(FirstParticle >= 0)
Call Check(Effects.BlendMode(StateA, FirstParticle) = Effects.BATTLE3D_BLEND_ADDITIVE)
Call Check(Effects.IsBillboard(StateA, FirstParticle))
Call Check(Effects.BillboardYaw(StateA, FirstParticle, 15) = 195)
Call Check(Effects.Update(StateA, 5))

For Index = 1 To 5
    Call Check(Effects.Update(StateB, 1))
End For

Call Check(Effects.ActiveCount(StateA) = Effects.ActiveCount(StateB))
Call Check(Effects.X(StateA, FirstParticle) = Effects.X(StateB, FirstParticle))
Call Check(Effects.Y(StateA, FirstParticle) = Effects.Y(StateB, FirstParticle))
Call Check(Effects.Z(StateA, FirstParticle) = Effects.Z(StateB, FirstParticle))
Call Check(Effects.ParticleRedValue(StateA, FirstParticle) = Effects.ParticleRedValue(StateB, FirstParticle))
Call Check(Effects.Size(StateA, FirstParticle) = Effects.Size(StateB, FirstParticle))
Call Check(Effects.Opacity(StateA, FirstParticle) < 100)
Call Check(Effects.FlashOpacity(StateA) = 0)
Call Check(Effects.Update(StateA, 20))
Call Check(Effects.ActiveCount(StateA) = 0)

' Alpha presets and the bounded pool reject overflow atomically and cleanly restart.

Call Check(Effects.Spawn(StateA, EFFECT_MIST, 0, 0, 0, 12))

FirstParticle = FirstActiveParticle(StateA)

Call Check(Effects.BlendMode(StateA, FirstParticle) = Effects.BATTLE3D_BLEND_ALPHA)
Call Check(Effects.ClearParticles(StateA))
Call Check(Effects.Spawn(StateA, EFFECT_STORM, 0, 0, 0, 4))
Call Check(Effects.ActiveCount(StateA) = Effects.MaximumParticleCount())
Call Check(Not Effects.Spawn(StateA, EFFECT_FIRE, 0, 0, 0, 5))
Call Check(Effects.ActiveCount(StateA) = Effects.MaximumParticleCount())
Call Check(Effects.ClearParticles(StateA))
Call Check(Effects.ActiveCount(StateA) = 0)

Call RPG.Destroy(StateA)
Call RPG.Destroy(StateB)

StateA = RPG.Create()

Call Check(StateA > 0)
Call Check(Effects.ActiveCount(StateA) = 0)
Call Check(BattleCamera.CurrentShotId(StateA) = 0)
Call RPG.Destroy(StateA)

If Failures = 0 Then
    Print "Battle camera and VFX tests: PASS"
Else
    Print "Battle camera and VFX tests: FAIL"
    Print Failures
End If

End Program

Sub DefineContent(State As Number)

    Shot.Id = SHOT_DEFAULT
    Shot.Name = "BattleDefault"
    Shot.PositionX = 0
    Shot.PositionY = 220
    Shot.PositionZ = -850
    Shot.TargetX = 0
    Shot.TargetY = 100
    Shot.TargetZ = 0
    Shot.FovDegrees = 55
    Shot.Duration = 0

    Call Check(BattleCamera.DefineShot(State, Shot))

    Shot.Id = SHOT_IMPACT
    Shot.Name = "TargetImpact"
    Shot.PositionX = 180
    Shot.PositionY = 280
    Shot.PositionZ = -520
    Shot.TargetX = 120
    Shot.TargetY = 140
    Shot.TargetZ = 0
    Shot.FovDegrees = 42
    Shot.Duration = 10

    Call Check(BattleCamera.DefineShot(State, Shot))

    Preset.Id = EFFECT_FIRE
    Preset.Name = "Fire Burst"
    Preset.ParticleCount = 8
    Preset.Lifetime = 12
    Preset.Speed = 4
    Preset.Spread = 3
    Preset.Gravity = -1
    Preset.StartRed = 255
    Preset.StartGreen = 240
    Preset.StartBlue = 96
    Preset.EndRed = 255
    Preset.EndGreen = 32
    Preset.EndBlue = 8
    Preset.StartSize = 20
    Preset.EndSize = 2
    Preset.BlendMode = Effects.BATTLE3D_BLEND_ADDITIVE
    Preset.Billboard = True
    Preset.FlashPercent = 100
    Preset.FlashDuration = 4
    Preset.ShakeAmplitude = 14

    Call Check(Effects.DefinePreset(State, Preset))

    Preset.Id = EFFECT_MIST
    Preset.Name = "Healing Mist"
    Preset.ParticleCount = 3
    Preset.BlendMode = Effects.BATTLE3D_BLEND_ALPHA
    Preset.Billboard = True
    Preset.FlashPercent = 0
    Preset.FlashDuration = 0
    Preset.ShakeAmplitude = 0

    Call Check(Effects.DefinePreset(State, Preset))

    Preset.Id = EFFECT_STORM
    Preset.Name = "Bounded Storm"
    Preset.ParticleCount = Effects.BATTLE3D_MAX_PARTICLES
    Preset.BlendMode = Effects.BATTLE3D_BLEND_ADDITIVE

    Call Check(Effects.DefinePreset(State, Preset))

End Sub

Function FirstActiveParticle(State As Number) As Number

    Dim ReturnValue As Number

    Dim ParticleIndex As Number

    For ParticleIndex = 0 To Effects.MaximumParticleCount() - 1

        If Effects.IsActive(State, ParticleIndex) Then
            Return ParticleIndex
        End If

    End For

    ReturnValue = -1

    Return ReturnValue

End Function

Sub Check(Condition As Boolean)

    Checks = Checks + 1

    If Not Condition Then

        Failures = Failures + 1
        Print "Failed check"
        Print Checks

    End If

End Sub
