  </PropertyGroup>
  <ItemGroup>
    <SmileSource Include="PackageConsumer.smile" StartupOnly="true" />
    <SmileProjectReference Include="DoubleProof.smilelibproj" />
  </ItemGroup>
</SmileProject>
