<SmileProject Version="1.0">
  <PropertyGroup>
    <ProjectKind>Library</ProjectKind>
    <LibraryName>Example.AssetLibrary</LibraryName>
    <Version>1.0.0</Version>
    <OutputName>Example.AssetLibrary</OutputName>
  </PropertyGroup>
  <ItemGroup>
    <SmileSource Include="Library.smile" />
    <Asset Include="Assets\**\*" />
  </ItemGroup>
</SmileProject>
