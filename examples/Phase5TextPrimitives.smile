Option Explicit

Print Text_Length("")
Print Text_Length("Abc")
Print Text_Length("Café")
Print Text_Length("Καλημέρα")
Print Text_Length("こんにちは")
Print Text_Length("你好")
Print Text_Length("😀")
Print Text_Length("A😀B")
Print Text_Length("é")
Print Text_Code_At("", 0)
Print Text_Code_At("A😀B", -1)
Print Text_Code_At("A😀B", 1)
Print Text_Code_At("A😀B", 3)
Print Text_Slice("A😀B", 1, 1)
Print Text_Slice("Café", 2, 99)
Print Text_Slice("Abc", -1, 1)
Print Text_Length(BuildText())
Print Text_Code_At(Text_Slice(BuildText(), 1, 1), 0)

Function BuildText() As Text

    Dim ReturnValue As Text

    ReturnValue = "A😀B"
    Return ReturnValue

End Function

End Program
