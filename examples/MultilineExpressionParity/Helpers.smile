Module Parity.Helpers

Public Function Add(
    LeftValue As Number,
    RightValue As Number
) As Number

    Dim ReturnValue As Number

    ReturnValue = LeftValue + RightValue
    Return ReturnValue

End Function

Public Sub PrintPair(
    FirstValue As Number,
    SecondValue As Number
)

    Print FirstValue
    Print SecondValue

End Sub

End Module
