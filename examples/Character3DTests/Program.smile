Option Explicit

Import Smile.Simple3D.Core As Core
Import Smile.Simple3D.Graphics3D As Graphics3D
Import Smile.Simple3D.Scene3D As Scene3D
Import Smile.Simple3D.Character3D As Character3D
Import Smile.Simple3D.Math3D As Math3D

Dim Camera As Core.Camera3D
Dim First As Character3D.Actor
Dim Second As Character3D.Actor
Dim Third As Character3D.Actor
Dim Broken As Character3D.Actor
Dim Stale As Character3D.Actor
Dim PolicyActor As Character3D.Actor
Dim PolicyActor2 As Character3D.Actor
Dim TamperedActor As Character3D.Actor
Dim SurvivorActor As Character3D.Actor
Dim PendingActor As Character3D.Actor
Dim CapacityActors[32] As Character3D.Actor
Dim Blockers[1023] As Core.Object3D
Dim FillAnimators[128] As Core.Animator3D
Dim Skeleton As Core.Skeleton3D
Dim Socket As Core.Vector3
Dim Delta As Core.RootMotionDelta3D
Dim Bounds As Character3D.Bounds3D
Dim Bounds2 As Character3D.Bounds3D
Dim Center As Core.Vector3
Dim BorrowedObject As Core.Object3D
Dim BorrowedModel As Core.Model3D
Dim BorrowedAnimator As Core.Animator3D
Dim PbrAvailable As Boolean
Dim FrameReady As Boolean
Dim Ready As Boolean
Dim PositionBefore As Number
Dim UploadsBefore As Number
Dim ProfileKey As Number
Dim EpochBefore As Number
Dim EpochAfter As Number
Dim TamperedPartCount As Number
Dim SurvivorPartCount As Number
Dim TamperedAnimatorHandle As Number
Dim SurvivorAnimatorHandle As Number
Dim TamperedPartHandles[16] As Number
Dim SurvivorPartHandles[16] As Number
Dim Index As Number
Dim Failures As Number
Dim CheckIndex As Number

Game Window "Character3D Tests" Size 640 By 360

Call Graphics3D.ResetRenderer3D()
Call Character3D.Shutdown()

EpochBefore = Graphics3D.ResourceEpoch3D()

Call Check(EpochBefore > 0)
Call Check(Not Graphics3D.FrameActive3D())
Call Graphics3D.ResetRenderer3D()

EpochAfter = Graphics3D.ResourceEpoch3D()

Call Check(EpochAfter > 0)
Call Check(EpochAfter <> EpochBefore)
Call Character3D.Shutdown()

Call Check(Scene3D.SetQuality(Scene3D.QUALITY_LOW))
Call Check(Scene3D.RequestedQuality() = Scene3D.QUALITY_LOW)
Call Check(Scene3D.EffectiveQuality() = Scene3D.QUALITY_LOW)
Call Check(Scene3D.TextureFilter() = Graphics3D.TEXTURE_FILTER_LINEAR)
Call Check(Scene3D.RequestedAnisotropy() = 1)

ProfileKey = Scene3D.AssetProfileKey()

Call Check(ProfileKey = 1101)
Call Check(Scene3D.UseLighting("CharacterStudio"))
Call Check(Scene3D.ApplyLighting())
Call Check(Scene3D.CurrentLightingMatches("CharacterStudio"))
Call Check(Graphics3D.ActiveLightCount3D() = 3)
Call Check(Graphics3D.LightValue3D(Graphics3D.LIGHT_QUERY_AMBIENT, 0, 1) = 54)
Call Check(Graphics3D.LightValue3D(Graphics3D.LIGHT_QUERY_AMBIENT, 0, 4) = 340)
Call Check(Graphics3D.LightValue3D(Graphics3D.LIGHT_QUERY_LOCAL, 0, 1) = Graphics3D.LIGHT_POINT)
Call Check(Graphics3D.LightValue3D(Graphics3D.LIGHT_QUERY_LOCAL, 0, 11) = 1500)
Call Check(Not Scene3D.UseLighting("Unknown"))
Call Check(Scene3D.CurrentLightingMatches("CharacterStudio"))
Call Check(Scene3D.UseLighting("Daylight"))
Call Check(Scene3D.ApplyLighting())
Call Check(Graphics3D.LightValue3D(Graphics3D.LIGHT_QUERY_AMBIENT, 0, 1) = 166)
Call Check(Scene3D.UseLighting("Dungeon"))
Call Check(Scene3D.ApplyLighting())
Call Check(Graphics3D.LightValue3D(Graphics3D.LIGHT_QUERY_LOCAL, 0, 8) = 255)
Call Check(Scene3D.UseLighting("Moonlight"))
Call Check(Scene3D.ApplyLighting())
Call Check(Graphics3D.LightValue3D(Graphics3D.LIGHT_QUERY_DIRECTIONAL, 0, 5) = 158)
Call Check(Scene3D.UseLighting("EmberObservatory"))
Call Check(Scene3D.ApplyLighting())
Call Check(Graphics3D.LightValue3D(Graphics3D.LIGHT_QUERY_LOCAL, 0, 9) = 72)

Camera = Graphics3D.DefaultCamera()
FrameReady = Scene3D.Begin(Camera, 5, 7, 14)

Call Check(FrameReady)
Call Check(Scene3D.IsOpen())
Call Check(Not Scene3D.Begin(Camera, 5, 7, 14))
Call Check(Scene3D.EndScene())
Call Check(Not Scene3D.IsOpen())
Call Check(Not Scene3D.EndScene())

Call Scene3D.ClearError()

FrameReady = Graphics3D.Begin3D(Camera, 5, 7, 14)

Call Check(FrameReady)
Call Check(Graphics3D.FrameActive3D())
Call Check(Not Scene3D.Begin(Camera, 5, 7, 14))
Call Check(Scene3D.LastError() = Scene3D.SCENE_ERROR_FRAME_MISMATCH)
Call Graphics3D.End3D()

Call Scene3D.ResetState()

FrameReady = Scene3D.Begin(Camera, 5, 7, 14)

Call Check(FrameReady)
Call Graphics3D.End3D()
Call Check(Not Scene3D.EndScene())
Call Check(Scene3D.LastError() = Scene3D.SCENE_ERROR_FRAME_MISMATCH)

Call Scene3D.ResetState()

Fill Rectangle 0, 0, 640, 360, Rgb(5, 7, 14)
Draw Text "SCENE3D + RENDERER2D" At 180, 164 Size 18 Color WHITE
Show Screen

PbrAvailable = Graphics3D.PbrShaderAvailable3D()
First = Character3D.LoadActor("Assets\AnimationArticulated.sm3d")
Second = Character3D.LoadActor("Assets\AnimationArticulated.sm3d")

Call Check(Character3D.IsValid(First))
Call Check(Character3D.IsValid(Second))
Call Check(Character3D.LiveActorCount() = 2)
Call Check(Character3D.MaximumActorCount() = 32)
Call Check(Character3D.CachedAssetCount() = 1)
Call Check(Character3D.AssetReferenceCount(First) = 2)
Call Check(Character3D.PartCount(First) = 2)
Call Check(Character3D.PrimaryObjectHandle(First) <> Character3D.PrimaryObjectHandle(Second))
Call Check(Character3D.AnimatorHandle(First) <> Character3D.AnimatorHandle(Second))
Call Check(Character3D.ModelHandle(First) = Character3D.ModelHandle(Second))
Call Check(Graphics3D.LiveModelCount3D() = 1)
Call Check(Graphics3D.LiveAnimatorCount3D() = 2)
Call Check(Graphics3D.LiveObjectCount3D() = 4)
Call Check(Character3D.AnimationResidentBytes(First) > 0)
Call Check(Character3D.Height(First) = 2)
Call Check(Character3D.ActorUsesPbr(First) = PbrAvailable)
Call Check(Character3D.ActorUsesFallback(First) <> PbrAvailable)

PolicyActor = Character3D.LoadWithPolicy(
    "Assets\AnimationArticulated.sm3d",
    Character3D.CHARACTER_LOAD_REQUIRE_PBR
)
PolicyActor2 = Character3D.LoadWithPolicy(
    "Assets\AnimationArticulated.sm3d",
    Character3D.CHARACTER_LOAD_ALLOW_SIMPLE_FALLBACK
)

If PbrAvailable Then

    Call Check(Character3D.IsValid(PolicyActor))
    Call Check(Character3D.IsValid(PolicyActor2))
    Call Check(Character3D.ModelHandle(PolicyActor) = Character3D.ModelHandle(First))
    Call Check(Character3D.ModelHandle(PolicyActor2) = Character3D.ModelHandle(First))
    Call Check(Character3D.AssetReferenceCount(First) = 4)

Else

    Call Check(PolicyActor.Handle = 0)
    Call Check(Character3D.IsValid(PolicyActor2))
    Call Check(Character3D.ModelHandle(PolicyActor2) = Character3D.ModelHandle(First))
    Call Check(Character3D.AssetReferenceCount(First) = 3)

End If

Call Check(Character3D.CachedAssetCount() = 1)
Call Character3D.Destroy(PolicyActor)
Call Character3D.Destroy(PolicyActor2)
Call Check(Character3D.AssetReferenceCount(First) = 2)
Call Check(Scene3D.UseLighting("Daylight"))

PolicyActor2 = Character3D.LoadActor("Assets\AnimationArticulated.sm3d")

Call Check(Character3D.IsValid(PolicyActor2))
Call Check(Character3D.CachedAssetCount() = 1)
Call Check(Character3D.ModelHandle(PolicyActor2) = Character3D.ModelHandle(First))
Call Character3D.Destroy(PolicyActor2)
Call Check(Scene3D.UseLighting("CharacterStudio"))

Call Check(Character3D.Place(First, -1, 0, 0))
Call Check(Character3D.Rotate(First, 0, 20, 0))
Call Check(Character3D.SetScale(First, 120))
Call Check(Character3D.SetVisible(First, True))
Call Check(Character3D.LookAt(First, 100, 0, 0))
Call Check(Character3D.RotationY(First) >= 89 And Character3D.RotationY(First) <= 91)
Call Check(Not Character3D.Place(First, 1000001, 0, 0))
Call Check(Character3D.PositionX(First) = -1)
Call Check(Not Character3D.Rotate(First, 1000001, 0, 0))
Call Check(Character3D.SetScale(First, 25000))
Call Check(Not Character3D.SetScale(First, 25001))
Call Check(Character3D.SetScale(First, 200))
Call Check(Character3D.Place(First, 10, 20, 30))
Call Check(Character3D.Rotate(First, 0, 0, 0))

Bounds = Character3D.LocalBounds(First)
Bounds2 = Character3D.WorldBounds(First)
Center = Character3D.WorldCenter(First)

Call Check(Bounds.Valid)
Call Check(Bounds2.Valid)
Call Check(Character3D.WorldHeight(First) = Character3D.Height(First) * 2)
Call Check(Center.X >= 9 And Center.X <= 13)
Call Check(Center.Y >= 20 And Center.Y <= 24)
Call Check(Center.Z >= 29 And Center.Z <= 31)
Call Check(Character3D.WorldRadius(First) > 0)

Bounds = Character3D.WorldBounds(First, 3)

Call Check(Bounds.Valid)
Call Check(Bounds.AnimationMargin = 3000)
Call Check(Character3D.WorldHeight(First, 3) = Character3D.WorldHeight(First) + 6)

Bounds = Character3D.WorldBounds(First)

Call Check(Character3D.Rotate(First, 0, 90, 0))

Bounds2 = Character3D.WorldBounds(First)

Call Check(Bounds.Size.X = Bounds2.Size.Z)
Call Check(Bounds.Size.Z = Bounds2.Size.X)
Call Check(Character3D.SetScale(First, 120))
Call Check(Character3D.Place(First, -1, 0, 0))
Call Check(Character3D.Rotate(First, 0, 0, 0))
Call Check(Character3D.CurrentClipNameMatches(First, "Idle"))
Call Check(Not Character3D.PlayMode(First, "Missing", Graphics3D.ANIMATION_LOOP, 100))
Call Check(Character3D.LastError() = Character3D.CHARACTER_ERROR_CLIP_NOT_FOUND)
Call Check(Character3D.CurrentClipNameMatches(First, "Idle"))
Call Check(Character3D.PlayAnimation(First, "Bend", False))
Call Check(Character3D.Update(First, 1010))
Call Check(Character3D.AnimationComplete(First))
Call Check(Character3D.PlayMode(First, "Idle", Graphics3D.ANIMATION_LOOP, 100))
Call Check(Character3D.CrossFade(First, "AttackLike", 120, Graphics3D.ANIMATION_ONCE))
Call Check(Character3D.Update(First, 120))
Call Check(Character3D.CurrentClipNameMatches(First, "AttackLike"))
Call Check(Character3D.Update(First, 500))
Call Check(Character3D.TakeEvent(First, "Impact"))

Socket = Character3D.SocketPosition(First, "HandTip")

Call Check(Character3D.HasSocket(First, "HandTip"))
Call Check(Socket.X <> 0 Or Socket.Y <> 0 Or Socket.Z <> 0)
Call Check(Not Character3D.HasSocket(First, "Missing"))
Call Check(Character3D.SocketValueThousandths(
    First,
    "HandTip",
    Graphics3D.ANIMATOR_SOCKET_POSITION_Y
) <> 0)

Call CheckRotationParity(First)

Call Check(Character3D.Place(First, 0, 0, 0))
Call Check(Character3D.PlayMode(First, "RootMove", Graphics3D.ANIMATION_LOOP, 100))
Call Check(Character3D.SetRootMotion(First, Character3D.ROOT_MOTION_APPLY))

For Index = 1 To 5
    Call Check(Character3D.Update(First, 300))
End For

Delta = Character3D.LastRootDelta(First)

Call Check(Delta.Z <> 0)
Call Check(Character3D.PositionZ(First) = 1)

PositionBefore = Character3D.PositionZ(First)

Call Check(Character3D.SetRootMotion(First, Character3D.ROOT_MOTION_IGNORE))
Call Check(Character3D.Update(First, 600))
Call Check(Character3D.PositionZ(First) = PositionBefore)

Call Check(Character3D.Place(First, 0, 0, 0))
Call Check(Character3D.Rotate(First, 0, 90, 0))
Call Check(Character3D.PlayMode(First, "RootMove", Graphics3D.ANIMATION_LOOP, 100))
Call Check(Character3D.SetRootMotion(First, Character3D.ROOT_MOTION_APPLY))
Call Check(Character3D.Update(First, 1200))
Call Check(Character3D.PositionX(First) = 1)
Call Check(Character3D.PositionZ(First) = 0)
Call Check(Character3D.Place(First, 0, 0, 0))
Call Check(Character3D.Rotate(First, 0, 180, 0))
Call Check(Character3D.PlayMode(First, "RootMove", Graphics3D.ANIMATION_LOOP, 100))
Call Check(Character3D.Update(First, 1200))
Call Check(Character3D.PositionX(First) = 0)
Call Check(Character3D.PositionZ(First) = -1)
Call Check(Character3D.Place(First, 0, 0, 0))
Call Check(Character3D.Rotate(First, 0, 270, 0))
Call Check(Character3D.PlayMode(First, "RootMove", Graphics3D.ANIMATION_LOOP, 100))
Call Check(Character3D.Update(First, 1200))
Call Check(Character3D.PositionX(First) = -1)
Call Check(Character3D.PositionZ(First) = 0)
Call Check(Character3D.Place(First, 0, 0, 0))
Call Check(Character3D.Rotate(First, 0, 0, 0))
Call Check(Character3D.PlayMode(First, "WalkLike", Graphics3D.ANIMATION_LOOP, 100))
Call Check(Character3D.Update(First, 1017))
Call Check(Character3D.PositionX(First) = 1)
Call Check(Character3D.SetRootMotion(First, Character3D.ROOT_MOTION_IGNORE))
Call Check(Character3D.PlayMode(First, "RootMove", Graphics3D.ANIMATION_LOOP, 100))
Call Check(Character3D.Update(First, 600000))
Call Check(Character3D.PendingEventCount(First) = 32)
Call Check(Character3D.EventOverflowed(First))
Call Check(Character3D.DroppedEventCount(First) > 0)

Call Character3D.ClearEvents(First)

Call Check(Character3D.PendingEventCount(First) = 0)
Call Check(Not Character3D.EventOverflowed(First))
Call Check(Character3D.PlayAnimation(Second, "Bend", True))
Call Check(Character3D.Update(Second, 505))

UploadsBefore = Graphics3D.ModelPaletteUploadCount3D()
FrameReady = Scene3D.Begin(Camera, 5, 7, 14)

If FrameReady Then
    FrameReady = Character3D.Draw(First)
    FrameReady = Character3D.Draw(Second) And FrameReady
End If

Ready = Scene3D.EndScene()

Call Check(FrameReady And Ready)
Call Check(Graphics3D.DrawCallCount3D() = 4)
Call Check(Graphics3D.SubmittedTriangleCount3D() = 72)
Call Check(Graphics3D.ModelPaletteUploadCount3D() - UploadsBefore = 2)

' Part visibility is actor-owned intent, not a temporary object transform flag.

Call Check(Character3D.SetPartVisible(First, 0, False))
Call Check(VisibleActorDrawCount() = 3)
Call Check(Character3D.Place(First, Character3D.PositionX(First),
    Character3D.PositionY(First), Character3D.PositionZ(First)))
Call Check(Character3D.Rotate(First, 0, 0, 0))
Call Check(Character3D.SetScale(First, 200))
Call Check(VisibleActorDrawCount() = 3)
Call Check(Character3D.SetVisible(First, False))
Call Check(Character3D.SetPartVisible(First, 0, True))
Call Check(VisibleActorDrawCount() = 2)
Call Check(Character3D.SetPartVisible(First, 0, False))
Call Check(Character3D.SetVisible(First, True))
Call Check(VisibleActorDrawCount() = 3)
Call Check(Character3D.SetPartVisible(First, 0, True))
Call Check(VisibleActorDrawCount() = 4)

Call Check(Scene3D.SetQuality(Scene3D.QUALITY_MEDIUM))

Third = Character3D.LoadActor("Assets\AnimationArticulated.sm3d")

Call Check(Character3D.IsValid(Third))
Call Check(Character3D.CachedAssetCount() = 2)
Call Check(Graphics3D.LiveModelCount3D() = 2)
Call Check(Character3D.ModelHandle(Third) <> Character3D.ModelHandle(First))

Call Character3D.Destroy(Third)

Call Check(Character3D.CachedAssetCount() = 1)
Call Check(Graphics3D.LiveModelCount3D() = 1)

If PbrAvailable Then

    Broken = Character3D.LoadActor("Assets\AnimationArticulatedMissingTexture.sm3d")

    Call Check(Broken.Handle = 0)
    Call Check(Character3D.LastError() = Character3D.CHARACTER_ERROR_PBR_PREPARATION)
    Call Check(Character3D.CachedAssetCount() = 1)
    Call Check(Graphics3D.LiveModelCount3D() = 1)

Else

    Broken = Character3D.LoadWithPolicy(
        "Assets\AnimationArticulated.sm3d",
        Character3D.CHARACTER_LOAD_REQUIRE_PBR
    )

    Call Check(Broken.Handle = 0)
    Call Check(Character3D.LastError() = Character3D.CHARACTER_ERROR_PBR_PREPARATION)

End If

Stale = First

Call Character3D.Destroy(First)

Call Check(Not Character3D.IsValid(Stale))
Call Check(Character3D.AssetReferenceCount(Second) = 1)
Call Check(Graphics3D.LiveModelCount3D() = 1)

Call Character3D.Destroy(Second)

Call Check(Character3D.LiveActorCount() = 0)
Call Check(Character3D.CachedAssetCount() = 0)
Call Check(Graphics3D.LiveModelCount3D() = 0)
Call Check(Graphics3D.LiveMeshCount3D() = 0)
Call Check(Graphics3D.LiveObjectCount3D() = 0)
Call Check(Graphics3D.LiveAnimatorCount3D() = 0)
Call Check(Graphics3D.LiveMaterialCount3D() = 0)

For Index = 0 To 31
    CapacityActors[Index] = Character3D.LoadActor("Assets\AnimationArticulated.sm3d")

    Call Check(CapacityActors[Index].Handle <> 0)
End For

Broken = Character3D.LoadActor("Assets\AnimationArticulated.sm3d")

Call Check(Broken.Handle = 0)
Call Check(Character3D.LastError() = Character3D.CHARACTER_ERROR_CAPACITY)
Call Check(Character3D.LiveActorCount() = 32)

Call Character3D.Shutdown()
Call Character3D.Shutdown()

Call Check(Character3D.LiveActorCount() = 0)
Call Check(Character3D.CachedAssetCount() = 0)
Call Check(Graphics3D.LiveModelCount3D() = 0)
Call Check(Graphics3D.LiveObjectCount3D() = 0)
Call Check(Graphics3D.LiveAnimatorCount3D() = 0)

Blockers[0] = Graphics3D.CreateCube3D(1)

For Index = 1 To 1022
    Blockers[Index] = Graphics3D.CreateObjectFromMesh3D(Blockers[0].MeshHandle)
End For

Call Check(Graphics3D.LiveObjectCount3D() = 1023)

Broken = Character3D.LoadActor("Assets\AnimationArticulated.sm3d")

Call Check(Broken.Handle = 0)
Call Check(Character3D.LastError() = Character3D.CHARACTER_ERROR_CAPACITY)
Call Check(Character3D.LiveActorCount() = 0)
Call Check(Character3D.CachedAssetCount() = 0)
Call Check(Graphics3D.LiveModelCount3D() = 0)
Call Check(Graphics3D.LiveObjectCount3D() = 1023)

For Index = 1 To 1022
    Call Graphics3D.DestroyObjectInstance3D(Blockers[Index])
End For

Call Graphics3D.DestroyObject3D(Blockers[0])

Skeleton = Graphics3D.CreateSkeleton3D(1)
Ready = Graphics3D.SetSkeletonBone3D(Skeleton, 0, -1, 0, 0, 0)
Ready = Graphics3D.CommitSkeleton3D(Skeleton) And Ready

Call Check(Ready)

For Index = 0 To 127
    FillAnimators[Index] = Graphics3D.CreateAnimator3D(Skeleton)
End For

Call Check(Graphics3D.LiveAnimatorCount3D() = 128)

Broken = Character3D.LoadActor("Assets\AnimationArticulated.sm3d")

Call Check(Broken.Handle = 0)
Call Check(Character3D.LastError() = Character3D.CHARACTER_ERROR_CAPACITY)
Call Check(Character3D.CachedAssetCount() = 0)

For Index = 0 To 127
    Call Graphics3D.DestroyAnimator3D(FillAnimators[Index])
End For

Call Graphics3D.DestroySkeleton3D(Skeleton)

TamperedActor = Character3D.LoadActor("Assets\AnimationArticulated.sm3d")
SurvivorActor = Character3D.LoadActor("Assets\AnimationArticulated.sm3d")
Stale = TamperedActor
BorrowedObject.Handle = Character3D.PartObjectHandle(TamperedActor, 1)

Call Graphics3D.DestroyObjectInstance3D(BorrowedObject)
Call Check(Not Character3D.Place(TamperedActor, 10, 0, 0))
Call Check(Character3D.ActorLastError(Stale) = Character3D.CHARACTER_ERROR_INVALID_PART)
Call Check(Character3D.IsValid(SurvivorActor))
Call Check(Character3D.ActorLastError(SurvivorActor) = Character3D.CHARACTER_ERROR_NONE)
Call Check(Character3D.AssetReferenceCount(SurvivorActor) = 1)
Call Character3D.Destroy(SurvivorActor)
Call Check(Character3D.CachedAssetCount() = 0)

PendingActor = Character3D.LoadActor("Assets\AnimationArticulated.sm3d")
BorrowedModel.Handle = Character3D.ModelHandle(PendingActor)
BorrowedObject = Graphics3D.CreateModelPart3D(BorrowedModel, 0)

Call Check(BorrowedObject.Handle <> 0)
Call Character3D.Destroy(PendingActor)
Call Check(Character3D.PendingReleaseAssetCount() = 1)
Call Check(Character3D.CachedAssetCount() = 1)
Call Check(Character3D.LastError() = Character3D.CHARACTER_ERROR_PENDING_RELEASE)

Broken = Character3D.LoadActor("Assets\AnimationArticulated.sm3d")

Call Check(Broken.Handle = 0)
Call Check(Character3D.LastError() = Character3D.CHARACTER_ERROR_PENDING_RELEASE)
Call Check(Character3D.CachedAssetCount() = 1)
Call Graphics3D.DestroyObjectInstance3D(BorrowedObject)
Call Check(Character3D.RetryPendingReleases())
Call Check(Character3D.PendingReleaseAssetCount() = 0)
Call Check(Character3D.CachedAssetCount() = 0)

TamperedActor = Character3D.LoadActor("Assets\AnimationArticulated.sm3d")
SurvivorActor = Character3D.LoadActor("Assets\AnimationArticulated.sm3d")
Stale = TamperedActor
BorrowedModel.Handle = Character3D.ModelHandle(TamperedActor)
TamperedPartCount = Character3D.PartCount(TamperedActor)
SurvivorPartCount = Character3D.PartCount(SurvivorActor)
TamperedAnimatorHandle = Character3D.AnimatorHandle(TamperedActor)
SurvivorAnimatorHandle = Character3D.AnimatorHandle(SurvivorActor)

For Index = 0 To TamperedPartCount - 1
    TamperedPartHandles[Index] = Character3D.PartObjectHandle(TamperedActor, Index)
End For

For Index = 0 To SurvivorPartCount - 1
    SurvivorPartHandles[Index] = Character3D.PartObjectHandle(SurvivorActor, Index)
End For

For Index = 0 To TamperedPartCount - 1
    BorrowedObject.Handle = TamperedPartHandles[Index]

    Call Graphics3D.DestroyObjectInstance3D(BorrowedObject)
End For

For Index = 0 To SurvivorPartCount - 1
    BorrowedObject.Handle = SurvivorPartHandles[Index]

    Call Graphics3D.DestroyObjectInstance3D(BorrowedObject)
End For

BorrowedAnimator.Handle = TamperedAnimatorHandle

Call Graphics3D.DestroyAnimator3D(BorrowedAnimator)

BorrowedAnimator.Handle = SurvivorAnimatorHandle

Call Graphics3D.DestroyAnimator3D(BorrowedAnimator)
Call Graphics3D.DestroyModel3D(BorrowedModel)
Call Check(Not Character3D.IsValid(TamperedActor))
Call Check(Character3D.ActorLastError(Stale) = Character3D.CHARACTER_ERROR_TAMPERED_RESOURCE)
Call Check(Not Character3D.IsValid(SurvivorActor))
Call Check(Character3D.LiveActorCount() = 0)
Call Check(Character3D.CachedAssetCount() = 0)

First = Character3D.LoadActor("Assets\AnimationArticulated.sm3d")
Stale = First

Call Check(Character3D.IsValid(First))
Call Graphics3D.ResetRenderer3D()
Call Check(Not Character3D.IsValid(First))
Call Check(Character3D.LastError() = Character3D.CHARACTER_ERROR_RENDERER_RESET)
Call Check(Character3D.LiveActorCount() = 0)
Call Check(Character3D.CachedAssetCount() = 0)
Call Check(Not Character3D.IsValid(Stale))

Call Character3D.Shutdown()
Call Graphics3D.ResetRenderer3D()

Call CheckUnusedAssetCache()

If Failures = 0 Then
    Print "Character3D and Scene3D tests passed"
Else
    Print "Character3D and Scene3D tests failed: "; Failures
End If

Sub CheckRotationParity(ByRef Value As Character3D.Actor)

    Dim BasePoint As Core.Vector3
    Dim ExpectedPoint As Core.Vector3
    Dim Angles As Core.Vector3
    Dim Rotation As Core.Matrix4
    Dim TestIndex As Number

    Call Check(Character3D.Place(Value, 0, 0, 0))
    Call Check(Character3D.Rotate(Value, 0, 0, 0))
    Call Check(Character3D.SetScale(Value, 100))

    BasePoint.X = Character3D.SocketValueThousandths(Value, "HandTip", Graphics3D.ANIMATOR_SOCKET_POSITION_X)
    BasePoint.Y = Character3D.SocketValueThousandths(Value, "HandTip", Graphics3D.ANIMATOR_SOCKET_POSITION_Y)
    BasePoint.Z = Character3D.SocketValueThousandths(Value, "HandTip", Graphics3D.ANIMATOR_SOCKET_POSITION_Z)

    ' Compare actual renderer sockets with the shared, native-convention math.
    ' Include mixed axes so merely reversing one yaw sign cannot pass.

    For TestIndex = 0 To 3

        Angles = Math3D.Vector(0, 0, 0)

        If TestIndex = 0 Then
            Angles.X = 90
        Else If TestIndex = 1 Then
            Angles.Y = 90
        Else If TestIndex = 2 Then
            Angles.Z = 90
        Else
            Angles = Math3D.Vector(30, 45, 60)
        End If

        Rotation = Math3D.Multiply(Math3D.RotationX(Angles.X), Math3D.RotationY(Angles.Y))
        Rotation = Math3D.Multiply(Rotation, Math3D.RotationZ(Angles.Z))
        ExpectedPoint = Math3D.TransformPoint(BasePoint, Rotation)

        Call Check(Character3D.Rotate(Value, Angles.X, Angles.Y, Angles.Z))
        Call CheckSocketNear(Value, ExpectedPoint)
        Call Check(Character3D.Rotate(Value, 0, 0, 0))
        Call Check(Character3D.SetNodeRotationOffset(Value, 0, Angles.X, Angles.Y, Angles.Z))
        Call CheckSocketNear(Value, ExpectedPoint)
        Call Check(Character3D.SetNodeRotationOffset(Value, 0, 0, 0, 0))

        ' A fixed-thousandths world pivot must rotate around itself, not origin.
        ExpectedPoint = BasePoint
        ExpectedPoint.X = ExpectedPoint.X - 250
        ExpectedPoint.Y = ExpectedPoint.Y + 125
        ExpectedPoint.Z = ExpectedPoint.Z - 500
        ExpectedPoint = Math3D.TransformPoint(ExpectedPoint, Rotation)
        ExpectedPoint.X = ExpectedPoint.X + 250
        ExpectedPoint.Y = ExpectedPoint.Y - 125
        ExpectedPoint.Z = ExpectedPoint.Z + 500

        Call Check(Character3D.SetPartPivotRotationThousandths(
            Value, 0, 250, -125, 500, Angles.X, Angles.Y, Angles.Z))
        Call CheckSocketNear(Value, ExpectedPoint)
        Call Check(Character3D.SetPartPivotRotationThousandths(Value, 0, 0, 0, 0, 0, 0, 0))

        ' Exercise combined scale, rotation, translation and the world pivot.
        ExpectedPoint = Math3D.MultiplyScalar(BasePoint, 2)
        ExpectedPoint = Math3D.TransformPoint(ExpectedPoint, Rotation)
        ExpectedPoint.X = ExpectedPoint.X + 10000
        ExpectedPoint.Y = ExpectedPoint.Y + 20000
        ExpectedPoint.Z = ExpectedPoint.Z + 30000

        Call Check(Character3D.SetScale(Value, 200))
        Call Check(Character3D.Place(Value, 10, 20, 30))
        Call Check(Character3D.Rotate(Value, Angles.X, Angles.Y, Angles.Z))
        Call CheckSocketNear(Value, ExpectedPoint)
        Call Check(Character3D.SetScale(Value, 100))
        Call Check(Character3D.Place(Value, 0, 0, 0))
        Call Check(Character3D.Rotate(Value, 0, 0, 0))
    End For

    Call Check(Character3D.SetScale(Value, 120))
    Call Check(Character3D.Place(Value, -1, 0, 0))

End Sub

Sub CheckUnusedAssetCache()

    Dim Actor As Character3D.Actor
    Dim NextActor As Character3D.Actor
    Dim Model As Number
    Dim OldAnimator As Number
    Dim OldSocket As Core.Vector3
    Dim NewSocket As Core.Vector3

    Call Character3D.Shutdown()
    Call Check(Scene3D.SetQuality(Scene3D.QUALITY_LOW))
    Call Check(Not Character3D.SetUnusedAssetCacheLimit(-1))
    Call Check(Not Character3D.SetUnusedAssetCacheLimit(17))
    Call Check(Character3D.SetUnusedAssetCacheLimit(1))

    Actor = Character3D.LoadActor("Assets\AnimationArticulated.sm3d")
    Model = Character3D.ModelHandle(Actor)
    OldAnimator = Character3D.AnimatorHandle(Actor)

    Call Check(Model > 0)
    Call Check(Character3D.PlayMode(Actor, "Idle", Graphics3D.ANIMATION_LOOP, 100))

    OldSocket = Character3D.SocketPosition(Actor, "HandTip")

    Call Check(Character3D.SetNodeRotationOffset(Actor, 0, 0, 30, 0))
    Call Check(Character3D.SetAnimationTime(Actor, 300))
    Call Character3D.Destroy(Actor)
    Call Check(Character3D.LiveActorCount() = 0)
    Call Check(Character3D.CachedAssetCount() = 1)
    Call Check(Graphics3D.LiveAnimatorCount3D() = 0)

    NextActor = Character3D.LoadActor("Assets\AnimationArticulated.sm3d")

    Call Check(Character3D.ModelHandle(NextActor) = Model)
    Call Check(Character3D.AnimatorHandle(NextActor) <> OldAnimator)
    Call Check(Character3D.AssetReferenceCount(NextActor) = 1)
    Call Check(Character3D.PlayMode(NextActor, "Idle", Graphics3D.ANIMATION_LOOP, 100))
    Call Check(Character3D.AnimationTime(NextActor) = 0)

    NewSocket = Character3D.SocketPosition(NextActor, "HandTip")

    Call Check(NewSocket.X = OldSocket.X And NewSocket.Y = OldSocket.Y And NewSocket.Z = OldSocket.Z)
    Call Character3D.Destroy(NextActor)
    Call Check(Scene3D.SetQuality(Scene3D.QUALITY_MEDIUM))

    NextActor = Character3D.LoadActor("Assets\AnimationArticulated.sm3d")

    Call Check(Character3D.ModelHandle(NextActor) <> Model)
    Call Character3D.Destroy(NextActor)
    Call Check(Character3D.CachedAssetCount() = 1)
    Call Check(Not Graphics3D.ModelHandleValid3D(Model))
    Call Check(Character3D.SetUnusedAssetCacheLimit(0))
    Call Check(Character3D.CachedAssetCount() = 0)
    Call Check(Character3D.SetUnusedAssetCacheLimit(1))

    Actor = Character3D.LoadActor("Assets\AnimationArticulated.sm3d")

    Call Character3D.Destroy(Actor)
    Call Character3D.Shutdown()
    Call Check(Character3D.CachedAssetCount() = 0)
    Call Check(Graphics3D.LiveModelCount3D() = 0)

End Sub

Sub CheckSocketNear(Value As Character3D.Actor, ExpectedPoint As Core.Vector3)

    ' Shared fixed-point trig rounds; allow less than one hundredth of a unit.

    Call Check(Abs(Character3D.SocketValueThousandths(Value, "HandTip",
        Graphics3D.ANIMATOR_SOCKET_POSITION_X) - ExpectedPoint.X) <= 8)
    Call Check(Abs(Character3D.SocketValueThousandths(Value, "HandTip",
        Graphics3D.ANIMATOR_SOCKET_POSITION_Y) - ExpectedPoint.Y) <= 8)
    Call Check(Abs(Character3D.SocketValueThousandths(Value, "HandTip",
        Graphics3D.ANIMATOR_SOCKET_POSITION_Z) - ExpectedPoint.Z) <= 8)

End Sub

Function VisibleActorDrawCount() As Number

    Dim Result As Number
    Dim Rendered As Boolean

    Rendered = Scene3D.Begin(Camera, 5, 7, 14)

    If Rendered Then
        Rendered = Character3D.Draw(First)
        Rendered = Character3D.Draw(Second) And Rendered
    End If

    Rendered = Scene3D.EndScene() And Rendered

    Call Check(Rendered)

    Result = Graphics3D.DrawCallCount3D()

    Return Result

End Function

Sub Check(Condition As Boolean)

    CheckIndex = CheckIndex + 1

    If Not Condition Then
        Failures = Failures + 1
        Print "Character3D failed check "; CheckIndex
    End If

End Sub
