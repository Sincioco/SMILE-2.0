' MultiFileBasics support source.
' This file owns drawing and calls functions declared in GameState.smile.
' It also reads FrameCount, a global created by the startup source.

SUB DrawSharedScene()
    FILL ROUNDED RECTANGLE 40, 40, 880, 460, 18, RGB(14, 28, 58)
    DRAW ROUNDED RECTANGLE 40, 40, 880, 460, 18, LIGHT_BLUE

    DRAW TEXT "ONE PROGRAM - THREE SMILE SOURCE FILES" AT 480, 75 SIZE 26 COLOR WHITE CENTERED
    DRAW TEXT "LEFT / RIGHT ARROW KEYS MOVE THE MARKER" AT 480, 115 SIZE 18 COLOR LIGHT_GRAY CENTERED

    DRAW LINE 90, 300, 870, 300, DARK_GRAY
    FILL CIRCLE MarkerX(), MarkerY(), 18 + MarkerPulse() / 5, LIGHT_BLUE
    DRAW CIRCLE MarkerX(), MarkerY(), 22 + MarkerPulse() / 5, WHITE

    DRAW TEXT "FRAME" AT 70, 450 SIZE 18 COLOR CYAN
    DRAW NUMBER FrameCount AT 145, 445 SIZE 26 COLOR YELLOW

    DRAW TEXT "X" AT 700, 450 SIZE 18 COLOR CYAN
    DRAW NUMBER MarkerX() AT 730, 445 SIZE 26 COLOR YELLOW
END SUB
