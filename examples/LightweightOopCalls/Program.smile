Option Explicit

Import Smile.Lightweight.Oop.Proof As Proof

Dim Trace As Text
Dim Primary As Proof.Counter
Dim Copy As Proof.Counter
Dim Holder As Proof.CounterBox
Dim Items[2] As Proof.Counter

Call Proof.Report("defaults")

Trace = ""

Call Proof.Report(
    Enabled:=MarkBoolean("B", False),
    Label:=MarkText("L", "named"),
    Mode:=MarkMode("M", Proof.DisplayMode.Standard),
    Suffix:=MarkText("S", "?"),
    Copies:=MarkNumber("N", 7)
)

Print Trace

Call Proof.Report(
    "mixed",
    Suffix:=".",
    Copies:=4
)

Trace = ""

Call Primary.Configure(
    Mode:=MarkMode("M", Proof.DisplayMode.Compact),
    Label:=MarkText("L", "primary"),
    Start:=MarkNumber("S", 10)
)

Print Trace
Print Primary.Total
Print Primary.Caption

Call Primary.Advance(Delta:=2)

Print Primary.Total

Copy = Primary

Call Copy.Advance()

Print Primary.Total
Print Copy.Total
Print Copy.Difference(Other:=Primary)

Copy = Primary.Shifted(Delta:=5)

Print Primary.Total
Print Copy.Total

Holder.Item = Primary

Call Holder.Item.Advance(3)

Print Holder.Item.Total

Items[1] = Primary

Call Items[1].Advance(4)

Print Items[1].Total
Print Primary.Total

Call MutateCopy(Primary)

Print Primary.Total

Call MutateOriginal(Primary)

Print Primary.Total

Primary.GameProbe = 21
Print Primary.Total

Holder.Item.Total = 2

Call Holder.Item.Advance(ReplaceHolder(Holder))

Print Holder.Item.Total

Holder.Item.Total = ReplaceHolderValue(Holder)
Print Holder.Item.Total

Dim EmptyReference As New Proof.EmptyReference()
Dim Object As New Proof.ReferenceCounter(

    Mode:=Proof.DisplayMode.Compact,
    Label:="object",
    Start:=5
)
Dim ObjectAlias As Proof.ReferenceCounter
Dim CapturedObject As Proof.ReferenceCounter
Dim ClassSnapshot As Proof.Counter

Print Object.Caption
Print Object.Total

ObjectAlias = Object

Print ObjectAlias Is Object

Call ObjectAlias.Advance(Delta:=2)

Print Object.Total
Print Object.Same(Other:=ObjectAlias)

Object.Samples[1] = 9

Print Object.Samples[1]

ClassSnapshot = Object.Snapshot()

Print ClassSnapshot.Total
Print ClassSnapshot.Caption

Call MutateClassByVal(Object)

Print Object.Total

ObjectAlias = Object.Alias()

Print ObjectAlias Is Object

ObjectAlias = Nothing

Print ObjectAlias Is Nothing

CapturedObject = Object

With Object

    Call .Advance(ReplaceClass(Object))

    Print .Total
End With

Print Object.Total
Print CapturedObject.Total

Object.Total = ReplaceClassValue(Object)

Print Object.Total
Print Object.Caption

Object.Samples[1] = 13

Print Object.Samples[1]

CapturedObject = Object

Call RebindClass(Object)

Print CapturedObject Is Object
Print Object.Total

End Program

Function MarkNumber(Tag As Text, Value As Number) As Number

    Trace = Trace + Tag
    Return Value

End Function

Function MarkBoolean(Tag As Text, Value As Boolean) As Boolean

    Trace = Trace + Tag
    Return Value

End Function

Function MarkText(Tag As Text, Value As Text) As Text

    Trace = Trace + Tag
    Return Value

End Function

Function MarkMode(Tag As Text, Value As Proof.DisplayMode) As Proof.DisplayMode

    Trace = Trace + Tag
    Return Value

End Function

Sub MutateCopy(Value As Proof.Counter)

    Call Value.Advance(100)

    Print Value.Total

End Sub

Sub MutateOriginal(ByRef Value As Proof.Counter)

    Call Value.Advance(2)

End Sub

Function ReplaceHolder(ByRef Value As Proof.CounterBox) As Number

    Dim Replacement As Proof.CounterBox

    Replacement.Item.Label = "method-root"
    Replacement.Item.Total = 40
    Value = Replacement

    Return 2

End Function

Function ReplaceHolderValue(ByRef Value As Proof.CounterBox) As Number

    Dim Replacement As Proof.CounterBox

    Replacement.Item.Label = "property-root"
    Replacement.Item.Total = 40
    Value = Replacement

    Return 7

End Function

Sub MutateClassByVal(Value As Proof.ReferenceCounter)

    Call Value.Advance(3)

End Sub

Function ReplaceClass(ByRef Value As Proof.ReferenceCounter) As Number

    Value = New Proof.ReferenceCounter("method-root", 40)

    Return 2

End Function

Function ReplaceClassValue(ByRef Value As Proof.ReferenceCounter) As Number

    Value = New Proof.ReferenceCounter("property-root", 50)

    Return 7

End Function

Sub RebindClass(ByRef Value As Proof.ReferenceCounter)

    Value = New Proof.ReferenceCounter("rebound", 60)

End Sub
