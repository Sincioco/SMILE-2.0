Option Explicit

Import Smile.Game.Core As GameCore
Import Smile.Game.Animation As Animation
Import Smile.Game.TileMap As TileMap
Import Smile.Game.Camera2D As Camera2D
Import Smile.RPG.Core As RPG
Import Smile.RPG.Characters As Characters
Import Smile.RPG.Party As Party
Import Smile.RPG.Inventory As Inventory
Import Smile.RPG.World As World
Import Smile.RPG.Story As Story
Import Smile.RPG.Encounters As Encounters
Import Smile.RPG.SaveGames As SaveGames
Import Smile.UI.Core As UI
Import Smile.UI.Menu As Menu
Import Smile.UI.MenuNavigator As MenuNavigator
Import Smile.UI.Dialogue As Dialogue

Const MODE_TITLE = 1
Const MODE_DUNGEON = 2
Const MODE_MENU = 3
Const MODE_DIALOGUE = 4
Const MODE_INFO = 5
Const MODE_ENCOUNTER = 6

Const SCENE_FP_1 = 1
Const SCENE_FP_2 = 2
Const SCENE_FP_3 = 3
Const SCENE_TOP_1 = 11
Const SCENE_TOP_2 = 12
Const SCENE_TOP_3 = 13
Const SCENE_TOP_4 = 14

Const ACTOR_HERO = 1000
Const ACTOR_FP_DOOR = 1100
Const ACTOR_FP_LOCKED_DOOR = 1101
Const ACTOR_FP_CHEST_GOLD = 1200
Const ACTOR_FP_CHEST_KEY = 1201
Const ACTOR_FP_HIDDEN = 1300
Const ACTOR_FP_NPC = 1400
Const ACTOR_TOP_DOOR = 2100
Const ACTOR_TOP_LOCKED_DOOR = 2101
Const ACTOR_TOP_CHEST_ITEM = 2200
Const ACTOR_TOP_CHEST_GOLD = 2201
Const ACTOR_TOP_HIDDEN = 2300
Const ACTOR_TOP_NPC = 2400

Const CHARACTER_HERO = 100
Const CHARACTER_COMPANION = 200
Const ITEM_VAULT_KEY = 10
Const ITEM_SUN_TONIC = 20

Const FLAG_FP_DOOR = 1
Const FLAG_FP_LOCKED_DOOR = 2
Const FLAG_FP_CHEST_GOLD = 3
Const FLAG_FP_CHEST_KEY = 4
Const FLAG_FP_HIDDEN = 5
Const FLAG_FP_TRAP = 6
Const FLAG_FP_NPC = 7
Const FLAG_TOP_DOOR = 8
Const FLAG_TOP_LOCKED_DOOR = 9
Const FLAG_TOP_CHEST_ITEM = 10
Const FLAG_TOP_CHEST_GOLD = 11
Const FLAG_TOP_HIDDEN = 12
Const FLAG_TOP_TRAP = 13
Const FLAG_TOP_NPC = 14
Const VALUE_REPEAT_TRAPS = 30

Const INTERACTION_DOOR = 1
Const INTERACTION_LOCKED_DOOR = 2
Const INTERACTION_CHEST_GOLD = 3
Const INTERACTION_CHEST_KEY = 4
Const INTERACTION_HIDDEN = 5
Const INTERACTION_NPC = 6
Const INTERACTION_CHEST_ITEM = 7

Const FP_WIDTH = 9
Const FP_HEIGHT = 9
Const FP_FLOORS = 3
Const FP_CELLS_PER_FLOOR = FP_WIDTH * FP_HEIGHT
Const FP_TOTAL_CELLS = FP_CELLS_PER_FLOOR * FP_FLOORS
Const FP_WALL = 0
Const FP_FLOOR = 1
Const VIEW_DEPTH = 5

Const REGION_TOP_1_DOWN = 101
Const REGION_TOP_1_EXIT = 109
Const REGION_TOP_1_TRAP = 111
Const REGION_TOP_1_ENCOUNTER = 121
Const REGION_TOP_2_UP = 102
Const REGION_TOP_2_DOWN = 103
Const REGION_TOP_2_REPEAT_TRAP = 112
Const REGION_TOP_2_CHUTE = 114
Const REGION_TOP_3_UP = 104
Const REGION_TOP_3_DOWN = 105
Const REGION_TOP_3_WARP = 115
Const REGION_TOP_4_UP = 106
Const REGION_TOP_4_ENCOUNTER = 124
Const REGION_TOP_1_ALT_DOWN = 107
Const REGION_TOP_2_ALT_UP = 108
Const REGION_FP_3_ENCOUNTER = 131

Dim Tileset As Image
Dim HeroImage As Image
Dim CompanionImage As Image
Dim NpcImage As Image
Dim EnemyImage As Image
Dim FloorMaps[4] As Number
Dim WalkAnimations[4] As Number
Dim FpCells[FP_TOTAL_CELLS] As Number
Dim ViewHalfWidth[VIEW_DEPTH + 1] As Number
Dim ViewTop[VIEW_DEPTH + 1] As Number
Dim ViewBottom[VIEW_DEPTH + 1] As Number
Dim State As Number
Dim PlayerMover As GameCore.CardinalMover
Dim Camera As Camera2D.CameraState
Dim WindowStyle As UI.WindowStyle
Dim TextStyle As UI.TextStyle
Dim SelectedTextStyle As UI.TextStyle
Dim DisabledTextStyle As UI.TextStyle
Dim MenuStyle As UI.MenuStyle
Dim NavigatorStyle As UI.MenuNavigatorStyle
Dim DialogueStyle As UI.DialogueStyle
Dim CommandMenu As Number
Dim CommandNavigator As Number
Dim DialogueHandle As Number
Dim Mode As Number
Dim PreviousMode As Number
Dim InfoPage As Number
Dim TitleSelection As Number
Dim AnimationClock As Number
Dim Key As Number
Dim Event As Number
Dim Action As Number
Dim Result As Number
Dim CurrentMap As Number
Dim Direction As Number
Dim RegionId As Number
Dim TransitionId As Number
Dim TargetActor As Number
Dim ItemIndex As Number
Dim Running As Boolean
Dim OperationSucceeded As Boolean
Dim Status As Text
Dim SceneDefinition As World.SceneDefinition
Dim SpawnDefinition As World.SpawnDefinition
Dim TransitionDefinition As World.TransitionDefinition
Dim ActorDefinition As World.ActorDefinition
Dim HeroDefinition As Characters.CharacterDefinition
Dim CompanionDefinition As Characters.CharacterDefinition
Dim ItemDefinition As Inventory.ItemDefinition
Dim ZoneDefinition As Encounters.ZoneDefinition

Game Window "SMILE 2.0 RPG Dungeon Gallery" Size 960 By 540

Load Image Tileset From "Assets\WorldTiles.png"
Load Image HeroImage From "Assets\Hero.png"
Load Image CompanionImage From "Assets\Companion.png"
Load Image NpcImage From "Assets\Npc.png"
Load Image EnemyImage From "Assets\MireWarden.png"

State = RPG.Create()

Call InitializeProjection()
Call InitializeAnimations()
Call InitializeFirstPersonMaps()
Call InitializeStyles()
Call InitializeMenus()
Call InitializeDefinitions()
Call LoadTopDownMaps()
Call StartNewGame(SCENE_FP_1)

Mode = MODE_TITLE
TitleSelection = 1
Status = "Choose an original dungeon presentation."
Running = State > 0 And FloorMaps[0] > 0 And FloorMaps[1] > 0 And FloorMaps[2] > 0 And FloorMaps[3] > 0 And Animation.IsValid(WalkAnimations[0]) And Animation.IsValid(WalkAnimations[1]) And Animation.IsValid(WalkAnimations[2]) And Animation.IsValid(WalkAnimations[3])

Do
    Get Key Key

    Select Case Mode
        Case MODE_TITLE

            Call HandleTitle(Key)

        Case MODE_DUNGEON

            Call HandleDungeon(Key)

        Case MODE_MENU

            Call HandleMenu(Key)

        Case MODE_DIALOGUE

            Call HandleDialogue(Key)

        Case MODE_INFO

            Call HandleInfo(Key)

        Case MODE_ENCOUNTER

            Call HandleEncounter(Key)

    End Select

    If Mode = MODE_DUNGEON And Not IsFirstPersonScene(World.CurrentScene(State)) Then
        Call UpdateTopDownMovement()
    End If

    If PlayerMover.Moving Then
        AnimationClock = AnimationClock + 1
    Else
        AnimationClock = 0
    End If

    Select Case Mode
        Case MODE_TITLE

            Call DrawTitle()

        Case MODE_ENCOUNTER

            Call DrawEncounter()

        Case Else

            Call DrawDungeon()

            If Mode = MODE_MENU Then
                Call MenuNavigator.DrawStack(CommandNavigator)
            Else If Mode = MODE_DIALOGUE Then
                Event = Dialogue.Update(DialogueHandle, Timer())

                Call Dialogue.Draw(DialogueHandle, Timer())
            Else If Mode = MODE_INFO Then
                Call DrawInformation()
            End If

    End Select

    Show Screen
    Wait 8 Milliseconds

Loop Until Game_Closed() = True Or Not Running

Call Dialogue.Destroy(DialogueHandle)
Call MenuNavigator.Destroy(CommandNavigator)
Call Menu.Destroy(CommandMenu)

For ItemIndex = 0 To 3
    Call TileMap.Unload(FloorMaps[ItemIndex])
    Call Animation.Destroy(WalkAnimations[ItemIndex])
End For

Unload Image EnemyImage
Unload Image NpcImage
Unload Image CompanionImage
Unload Image HeroImage
Unload Image Tileset

Call RPG.Destroy(State)

End Program

Sub InitializeProjection()

    ViewHalfWidth[0] = 650
    ViewHalfWidth[1] = 350
    ViewHalfWidth[2] = 210
    ViewHalfWidth[3] = 122
    ViewHalfWidth[4] = 68
    ViewHalfWidth[5] = 34
    ViewTop[0] = -80
    ViewTop[1] = 62
    ViewTop[2] = 145
    ViewTop[3] = 196
    ViewTop[4] = 225
    ViewTop[5] = 244
    ViewBottom[0] = 620
    ViewBottom[1] = 478
    ViewBottom[2] = 395
    ViewBottom[3] = 344
    ViewBottom[4] = 315
    ViewBottom[5] = 296

End Sub

Sub InitializeAnimations()

    Dim DirectionIndex As Number

    For DirectionIndex = 0 To 3

        WalkAnimations[DirectionIndex] = Animation.Create(2, True, 32, 86)
        OperationSucceeded = Animation.AddFrame(WalkAnimations[DirectionIndex], 0, DirectionIndex * 128, 96, 128)
        OperationSucceeded = OperationSucceeded And Animation.AddFrame(WalkAnimations[DirectionIndex], 96, DirectionIndex * 128, 96, 128)
        OperationSucceeded = OperationSucceeded And Animation.AddFrame(WalkAnimations[DirectionIndex], 192, DirectionIndex * 128, 96, 128)
        OperationSucceeded = OperationSucceeded And Animation.AddFrame(WalkAnimations[DirectionIndex], 96, DirectionIndex * 128, 96, 128)
    End For

End Sub

Sub InitializeFirstPersonMaps()

    Dim Index As Number
    Dim FloorIndex As Number
    Dim X As Number
    Dim Y As Number

    For Index = 0 To FP_TOTAL_CELLS - 1
        FpCells[Index] = FP_WALL
    End For

    For FloorIndex = 0 To FP_FLOORS - 1

        For Y = 1 To FP_HEIGHT - 2

            For X = 1 To FP_WIDTH - 2
                Call SetFpCell(FloorIndex, X, Y, FP_FLOOR)
            End For
        End For
    End For

    For Y = 2 To 6
        Call SetFpCell(0, 4, Y, FP_WALL)
    End For

    Call SetFpCell(0, 4, 4, FP_FLOOR)

    For X = 2 To 6
        Call SetFpCell(1, X, 4, FP_WALL)
    End For

    Call SetFpCell(1, 2, 4, FP_FLOOR)
    Call SetFpCell(1, 6, 4, FP_FLOOR)

    Call SetFpCell(2, 2, 2, FP_WALL)
    Call SetFpCell(2, 3, 2, FP_WALL)
    Call SetFpCell(2, 5, 2, FP_WALL)
    Call SetFpCell(2, 6, 2, FP_WALL)
    Call SetFpCell(2, 2, 6, FP_WALL)
    Call SetFpCell(2, 3, 6, FP_WALL)
    Call SetFpCell(2, 5, 6, FP_WALL)
    Call SetFpCell(2, 6, 6, FP_WALL)

End Sub

Function FpIndex(FloorIndex As Number, X As Number, Y As Number) As Number

    Dim ReturnValue As Number

    ReturnValue = FloorIndex * FP_CELLS_PER_FLOOR + Y * FP_WIDTH + X

    Return ReturnValue

End Function

Sub SetFpCell(FloorIndex As Number, X As Number, Y As Number, Value As Number)

    FpCells[FpIndex(FloorIndex, X, Y)] = Value

End Sub

Function FpCellAt(SceneId As Number, X As Number, Y As Number) As Number

    Dim ReturnValue As Number

    Dim FloorIndex As Number

    If (X < 0 Or
        X >= FP_WIDTH Or
        Y < 0 Or
        Y >= FP_HEIGHT) Then
        Return FP_WALL
    End If

    FloorIndex = SceneId - SCENE_FP_1

    If FloorIndex < 0 Or FloorIndex >= FP_FLOORS Then
        Return FP_WALL
    End If

    ReturnValue = FpCells[FpIndex(FloorIndex, X, Y)]

    Return ReturnValue

End Function

