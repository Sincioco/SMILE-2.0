Option Explicit

Import SinStarI.TitleScreen As TitleScreen
Import SinStarI.TownScreen As TownScreen
Import SinStarI.Town2Screen As Town2Screen
Import SinStarI.CharacterScreen As CharacterScreen

Const MODE_TITLE = 0

Dim Mode As Number
Dim TitleAction As Number
Dim PressedKey As Number
Dim SceneLabel As Text

Game Window "Sin Star I" Size 1280 By 720

Mode = MODE_TITLE
TitleAction = TitleScreen.TITLE_ACTION_NONE
SceneLabel = ""

Call TitleScreen.Initialize()
Call TownScreen.Initialize()
Call Town2Screen.Initialize()
Call CharacterScreen.Initialize()

Do
    Get Key PressedKey

    If Mode = MODE_TITLE Then

        TitleAction = TitleScreen.HandleInput(PressedKey)

        If TitleAction <> TitleScreen.TITLE_ACTION_NONE Then
            Call OpenScene(TitleAction)
        End If

    Else

        Call HandleScene(PressedKey)

    End If

    If Mode = MODE_TITLE Then
        Call TitleScreen.Draw()
    Else If Mode = TitleScreen.TITLE_ACTION_TOWN Then
        Call TownScreen.Draw()
    Else If Mode = TitleScreen.TITLE_ACTION_TOWN_2 Then
        Call Town2Screen.Draw()
    Else If Mode = TitleScreen.TITLE_ACTION_CHARACTER Then
        Call CharacterScreen.Draw()
    Else

        Call DrawScene()
    End If

    Show Screen
    Wait 8 Milliseconds

Loop Until Game_Closed() = True

Call CharacterScreen.Shutdown()
Call Town2Screen.Shutdown()
Call TownScreen.Shutdown()
Call TitleScreen.Shutdown()

End Program

Sub OpenScene(SceneId As Number)

    Mode = SceneId

    If SceneId = TitleScreen.TITLE_ACTION_TOWN Then
        SceneLabel = "Town"
    Else If SceneId = TitleScreen.TITLE_ACTION_TOWN_2 Then
        SceneLabel = "Town 2"
    Else If SceneId = TitleScreen.TITLE_ACTION_SHOP Then
        SceneLabel = "Shop"
    Else If SceneId = TitleScreen.TITLE_ACTION_DUNGEON Then
        SceneLabel = "Dungeon"
    Else If SceneId = TitleScreen.TITLE_ACTION_CHARACTER Then
        SceneLabel = "Character"
    Else
        SceneLabel = "Battle"
    End If

    Call TitleScreen.Leave()

    If SceneId = TitleScreen.TITLE_ACTION_TOWN Then
        Call TownScreen.Enter()
    Else If SceneId = TitleScreen.TITLE_ACTION_TOWN_2 Then
        Call Town2Screen.Enter()
    Else If SceneId = TitleScreen.TITLE_ACTION_CHARACTER Then
        Call CharacterScreen.Enter()
    End If

End Sub

Sub HandleScene(Key As Number)

    If Key = KEY_ESCAPE Then

        If Mode = TitleScreen.TITLE_ACTION_TOWN Then
            Call TownScreen.Shutdown()
        Else If Mode = TitleScreen.TITLE_ACTION_TOWN_2 Then
            Call Town2Screen.Shutdown()
        Else If Mode = TitleScreen.TITLE_ACTION_CHARACTER Then
            Call CharacterScreen.Shutdown()
        End If

        Mode = MODE_TITLE

        Call TitleScreen.Enter()

        Return

    End If

    If Mode = TitleScreen.TITLE_ACTION_TOWN Then
        Call TownScreen.Update(Key)
    Else If Mode = TitleScreen.TITLE_ACTION_TOWN_2 Then
        Call Town2Screen.Update(Key)
    Else If Mode = TitleScreen.TITLE_ACTION_CHARACTER Then
        Call CharacterScreen.Update(Key)
    End If

End Sub

Sub DrawScene()

    Clear Rgb(5, 9, 18)
    Fill Rectangle 0, 0, 1280, 72, Rgb(17, 29, 50)
    Draw Text SceneLabel At 32, 20 Size 32 Color YELLOW
    Draw Text "Press ESC to return to the main menu" At 32, 674 Size 18 Color WHITE

End Sub
