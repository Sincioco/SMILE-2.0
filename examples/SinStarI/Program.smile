Option Explicit

Import SinStarI.TitleScreen As TitleScreen

Const MODE_TITLE = 0

Dim Mode As Number
Dim TitleAction As Number
Dim PressedKey As Number
Dim SceneLabel As Text

Game Window "Sin Star I" Size 1280 By 720

Mode = MODE_TITLE
TitleAction = TitleScreen.TITLE_ACTION_NONE
SceneLabel = ""

Call TitleScreen.Initialize()

Do
    Get Key PressedKey

    If Mode = MODE_TITLE Then

        TitleAction = TitleScreen.HandleInput(PressedKey)

        If TitleAction <> TitleScreen.TITLE_ACTION_NONE Then
            Call OpenScene(TitleAction)
        End If

    Else

        Call HandleScene(PressedKey)

    End If

    If Mode = MODE_TITLE Then
        Call TitleScreen.Draw()
    Else

        Call DrawScene()
    End If

    Show Screen
    Wait 8 Milliseconds

Loop Until Game_Closed() = True

Call TitleScreen.Shutdown()

End Program

Sub OpenScene(SceneId As Number)

    Mode = SceneId

    If SceneId = TitleScreen.TITLE_ACTION_NEW_GAME Then
        SceneLabel = "Start a New Game"
    Else If SceneId = TitleScreen.TITLE_ACTION_TOWN Then
        SceneLabel = "Town"
    Else If SceneId = TitleScreen.TITLE_ACTION_SHOP Then
        SceneLabel = "Shop"
    Else If SceneId = TitleScreen.TITLE_ACTION_DUNGEON Then
        SceneLabel = "Dungeon"
    Else
        SceneLabel = "Battle"
    End If

    Call TitleScreen.Leave()

End Sub

Sub HandleScene(Key As Number)

    If Key = KEY_ESCAPE Then
        Mode = MODE_TITLE

        Call TitleScreen.Enter()
    End If

End Sub

Sub DrawScene()

    Clear Rgb(5, 9, 18)
    Fill Rectangle 0, 0, 1280, 72, Rgb(17, 29, 50)
    Draw Text SceneLabel At 32, 20 Size 32 Color YELLOW
    Draw Text "Press ESC to return to the main menu" At 32, 674 Size 18 Color WHITE

End Sub
