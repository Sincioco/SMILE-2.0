''' Returns the global cell X for one generated service landmark.
Public Function LandmarkCellX(Index As Number) As Number

    Dim ReturnValue As Number

    If Index = 0 Then
        Return 5
    Else If Index = 1 Then
        Return 50
    Else If Index = 2 Then
        Return 5
    Else If Index = 3 Then
        Return 42
    End If

    ReturnValue = -1

    Return ReturnValue

End Function

''' Returns the global cell Y for one generated service landmark.
Public Function LandmarkCellY(Index As Number) As Number

    Dim ReturnValue As Number

    If Index = 0 Then
        Return 9
    Else If Index = 1 Then
        Return 9
    Else If Index = 2 Then
        Return 23
    Else If Index = 3 Then
        Return 23
    End If

    ReturnValue = -1

    Return ReturnValue

End Function

''' Returns the icon-sheet index for one generated service landmark.
Public Function LandmarkIcon(Index As Number) As Number

    Dim ReturnValue As Number

    If Index >= 0 And Index < LANDMARK_COUNT Then
        Return Index
    End If

    ReturnValue = -1

    Return ReturnValue

End Function

''' Returns the short service label for one generated landmark.
Public Function LandmarkLabel(Index As Number) As Text

    If Index = 0 Then
        Return "ARMOR"
    Else If Index = 1 Then
        Return "SWORDS"
    Else If Index = 2 Then
        Return "SUPPLIES"
    Else If Index = 3 Then
        Return "CLINIC"
    End If

    Return ""

End Function

''' Registers the shared atlas rectangles on one loaded Town 2 chunk.
Public Function Register(MapHandle As Number) As Boolean

    Dim Succeeded As Boolean

    Succeeded = True
    Succeeded = Succeeded And TileMap.DefineTile(MapHandle, 1, 4, 4, 256, 256, 100)
