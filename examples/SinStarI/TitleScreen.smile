''' Sin Star I title-screen assets, state, input, music, and drawing.
Module SinStarI.TitleScreen

Option Explicit

''' Identifies a title selection and the application scene it opens.
Public Enum TitleAction
    None = 0
    Character = 1
    Town = 2
    Town2 = 3
    Shop = 4
    Dungeon = 5
    Battle = 6
End Enum

Private Dim TitleBackground As Image
Private Dim TitleLogo As Image
Private Dim MenuBackground As Image
Private Dim TitleSelection As TitleAction

''' Loads the title-screen assets, selects the first menu item, and starts the title music.
Public Sub Initialize()

    Load Image TitleBackground From "Assets\Sin Star - Title Screen - Background.png"
    Load Image TitleLogo From "Assets\Sin Star - Logo.png"
    Load Image MenuBackground From "Assets\MenuBackground.png"

    TitleSelection = TitleAction.Character

    Call Enter()

End Sub

''' Restarts the looping title-screen music.
Public Sub Enter()

    Stop Music
    Play Music "Assets\TitleMusic.mp3" Loop

End Sub

''' Stops title-screen music before the application opens another scene.
Public Sub Leave()

    Stop Music

End Sub

''' Stops the title music and releases every title-screen image.
Public Sub Shutdown()

    Stop Music
    Unload Image MenuBackground
    Unload Image TitleLogo
    Unload Image TitleBackground

End Sub

''' Updates menu navigation and returns the chosen title action, or TitleAction.None.
Public Function HandleInput(Key As Number) As TitleAction

    Dim Action As TitleAction

    Action = TitleAction.None

    If Key = KEY_UP Or Key = KEY_W Then

        Select Case TitleSelection
            Case TitleAction.Character
                TitleSelection = TitleAction.Battle
            Case TitleAction.Town
                TitleSelection = TitleAction.Character
            Case TitleAction.Town2
                TitleSelection = TitleAction.Town
            Case TitleAction.Shop
                TitleSelection = TitleAction.Town2
            Case TitleAction.Dungeon
                TitleSelection = TitleAction.Shop
            Case TitleAction.Battle
                TitleSelection = TitleAction.Dungeon
            Case Else
                TitleSelection = TitleAction.Character
        End Select

    Else If Key = KEY_DOWN Or Key = KEY_S Then

        Select Case TitleSelection
            Case TitleAction.Character
                TitleSelection = TitleAction.Town
            Case TitleAction.Town
                TitleSelection = TitleAction.Town2
            Case TitleAction.Town2
                TitleSelection = TitleAction.Shop
            Case TitleAction.Shop
                TitleSelection = TitleAction.Dungeon
            Case TitleAction.Dungeon
                TitleSelection = TitleAction.Battle
            Case TitleAction.Battle
                TitleSelection = TitleAction.Character
            Case Else
                TitleSelection = TitleAction.Character
        End Select

    Else If Key = KEY_ENTER Or Key = KEY_SPACE Then

        Action = TitleSelection

    End If

    Return Action

End Function

''' Draws the complete Sin Star I title screen.
Public Sub Draw()

    Clear Rgb(4, 8, 20)
    Draw Image TitleBackground At 0, 0 Size 1280 By 720 Filter Smooth
    Draw Image TitleLogo At 30, 30 Size 480 By 600 Filter Smooth
    'Draw Image MenuBackground At 505, 297 Size 380 By 300 Opacity 80 Filter Smooth

    Call DrawChoice(TitleAction.Character, "Character", 358)
    Call DrawChoice(TitleAction.Town, "Town", 408)
    Call DrawChoice(TitleAction.Town2, "Town 2", 458)
    Call DrawChoice(TitleAction.Shop, "Shop", 508)
    Call DrawChoice(TitleAction.Dungeon, "Dungeon", 558)
    Call DrawChoice(TitleAction.Battle, "Battle", 608)

    'Draw Text "Programmed by:  Louiery R. Sincioco  August 16, 2026. Copyright (c) 2026.  All rights reserved." At 641, 695 Size 12 Color BLACK Centered
    Draw Text "Programmed by:  Louiery R. Sincioco  August 16, 2026. Copyright (c) 2026.  All rights reserved." At 640, 694 Size 12 Color WHITE Centered

End Sub

Private Sub DrawChoice(Action As TitleAction, Label As Text, Y As Number)

    If TitleSelection = Action Then

        Draw Image MenuBackground At 525, Y - 5 Size 300 By 42 Opacity 80 Filter Smooth
        Draw Text ">" At 543, Y Size 24 Color WHITE
        Draw Text Label At 581, Y Size 24 Color WHITE

    Else
        Draw Text Label At 581, Y Size 24 Color WHITE

    End If

End Sub

End Module
