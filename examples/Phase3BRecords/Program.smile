Option Explicit

Import Smile.Data.Models As Models

Dim Hero As Models.Actor
Dim Copy As Models.Actor
Dim Party[2] As Models.Actor
Dim OriginalName As Text

Hero = Models.CreateActor("Alyssa", 10, 20, 35, 35)
Copy = Hero
OriginalName = Copy.Name
Hero.Name = "Changed"

Print OriginalName
Print Copy.Name
Print Hero.Name

Party[0] = Copy
Party[1] = Models.CreateActor("Rolf", 1, 2, 20, 25)

Call Models.Move(Party[0], 5, -2)
Call Models.Damage(Party[0], 7)

Print Party[0].Position.X
Print Party[0].Position.Y
Print Party[0].Health.Current
Print Party[1].Name

Call TryChange(Party[0])
Print Party[0].Name

Call Change(Party[0])
Print Party[0].Name

Call RenameField(Party[1].Name, "Nei")
Print Party[1].Name

Copy = Models.CopyActor(Party[0])
Print Copy.Name

End Program

Sub TryChange(Value As Models.Actor)
    Value.Name = "ByVal"
End Sub

Sub Change(ByRef Value As Models.Actor)
    Value.Name = "ByRef"
End Sub

Sub RenameField(ByRef Value As Text, NewValue As Text)
    Value = NewValue
End Sub
