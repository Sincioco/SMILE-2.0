Option Explicit

Type Dangerous
    __proto__ As Text
    constructor As Number
    prototype As Boolean
    toString As Text
    valueOf As Number
End Type

Type Wrapper
    Value As Dangerous
End Type

Dim First As Dangerous
Dim Copy As Dangerous
Dim Values[2] As Dangerous
Dim Wrapped As Wrapper

First.__proto__ = "Safe"
First.constructor = 42
First.prototype = True
First.toString = "Text"
First.valueOf = 7

Copy = First
First.__proto__ = "Changed"

Values[0] = Copy
Values[1] = MakeDangerous("Returned")

Call Rename(Values[0].__proto__, "ByRef")

Wrapped.Value = Values[0]

Print Copy.__proto__
Print Copy.constructor
Print Copy.prototype
Print Copy.toString
Print Copy.valueOf
Print Values[0].__proto__
Print Values[1].__proto__
Print Wrapped.Value.__proto__

End Program

Sub Rename(ByRef Value As Text, NewValue As Text)

    Value = NewValue

End Sub

Function MakeDangerous(Name As Text) As Dangerous

    Dim Result As Dangerous

    Result.__proto__ = Name
    Result.constructor = 99
    Result.prototype = True
    Result.toString = "Result"
    Result.valueOf = 11

    Return Result

End Function
