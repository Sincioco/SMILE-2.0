OPTION EXPLICIT

IMPORT Smile.UI.Core AS UI
IMPORT Smile.UI.Window AS Window
IMPORT Smile.UI.BitmapFont AS BitmapFont
IMPORT Smile.UI.Text AS Text
IMPORT Smile.UI.Menu AS Menu
IMPORT Smile.UI.Dialogue AS Dialogue

GAME WINDOW "Phase 5.1 UI Hardening" SIZE 640 BY 360

DIM Skin AS IMAGE
DIM Atlas AS IMAGE
DIM Cursor AS IMAGE
DIM SkinWindow AS UI.WindowStyle
DIM VectorWindow AS UI.WindowStyle
DIM FontStyle AS UI.BitmapFontStyle
DIM BadWindow AS UI.WindowStyle
DIM BadFont AS UI.BitmapFontStyle
DIM SystemText AS UI.TextStyle
DIM BitmapText AS UI.TextStyle
DIM StaleText AS UI.TextStyle
DIM MenuStyle AS UI.MenuStyle
DIM LargeMenuStyle AS UI.MenuStyle
DIM TinyMenuStyle AS UI.MenuStyle
DIM BadMenuStyle AS UI.MenuStyle
DIM DialogueStyle AS UI.DialogueStyle
DIM BitmapDialogueStyle AS UI.DialogueStyle
DIM VectorDialogueStyle AS UI.DialogueStyle
DIM BadDialogueStyle AS UI.DialogueStyle
DIM FontHandle AS NUMBER
DIM StaleHandle AS NUMBER
DIM MenuHandle AS NUMBER
DIM TinyMenuHandle AS NUMBER
DIM DialogueHandle AS NUMBER
DIM LimitHandle AS NUMBER
DIM ItemIndex AS NUMBER
DIM Index AS NUMBER
DIM Failures AS NUMBER
DIM CheckNumber AS NUMBER
DIM OldTop AS NUMBER
DIM OldPage AS NUMBER
DIM OldVisible AS NUMBER
DIM LineHeight AS NUMBER
DIM LongValue AS TEXT
DIM Started AS NUMBER
DIM PreparationMilliseconds AS NUMBER
DIM UnbrokenMilliseconds AS NUMBER
DIM SpacedMilliseconds AS NUMBER
DIM UnicodeMilliseconds AS NUMBER
DIM OperationSucceeded AS BOOLEAN

LOAD IMAGE Skin FROM "Assets\WindowSkin.png"
LOAD IMAGE Atlas FROM "Assets\BitmapFont.png"
LOAD IMAGE Cursor FROM "Assets\Cursor.png"

SkinWindow.UseSkin = TRUE
SkinWindow.Skin = Skin
SkinWindow.SourceX = 0
SkinWindow.SourceY = 0
SkinWindow.SourceWidth = 768
SkinWindow.SourceHeight = 768
SkinWindow.SourceLeft = 192
SkinWindow.SourceTop = 192
SkinWindow.SourceRight = 192
SkinWindow.SourceBottom = 192
SkinWindow.DestinationLeft = 24
SkinWindow.DestinationTop = 24
SkinWindow.DestinationRight = 24
SkinWindow.DestinationBottom = 24
SkinWindow.BorderThickness = 2
SkinWindow.Opacity = 100
SkinWindow.FilterMode = UI.UI_FILTER_SMOOTH
SkinWindow.Padding.Left = 20
SkinWindow.Padding.Top = 20
SkinWindow.Padding.Right = 20
SkinWindow.Padding.Bottom = 20

VectorWindow = SkinWindow
VectorWindow.UseSkin = FALSE

FontStyle.Atlas = Atlas
FontStyle.SourceX = 0
FontStyle.SourceY = 0
FontStyle.FirstCodePoint = 32
FontStyle.GlyphCount = 96
FontStyle.Columns = 16
FontStyle.SourceCellWidth = 64
FontStyle.SourceCellHeight = 64
FontStyle.DrawWidth = 25
FontStyle.DrawHeight = 25
FontStyle.AdvanceX = 21
FontStyle.LineHeight = 30
FontStyle.FallbackCodePoint = 63
FontStyle.FilterMode = UI.UI_FILTER_SMOOTH

SystemText.Mode = UI.UI_TEXT_SYSTEM
SystemText.SystemSize = 24
SystemText.SystemColor = WHITE
SystemText.LineSpacing = 7

StaleHandle = BitmapFont.Create(FontStyle)
StaleText = SystemText
StaleText.Mode = UI.UI_TEXT_BITMAP
StaleText.BitmapFontHandle = StaleHandle
CALL BitmapFont.Destroy(StaleHandle)
CALL Check(NOT Text.IsStyleValid(StaleText))
CALL Check(Text.MeasureHeight(StaleText, "") > 0)

FontHandle = BitmapFont.Create(FontStyle)
CALL Check(FontHandle > 0)
BitmapText = SystemText
BitmapText.Mode = UI.UI_TEXT_BITMAP
BitmapText.BitmapFontHandle = FontHandle

CALL Check(Window.IsStyleValid(SkinWindow))
BadWindow = SkinWindow
BadWindow.SourceX = -1
CALL Check(NOT Window.IsStyleValid(BadWindow))
BadWindow = SkinWindow
BadWindow.SourceWidth = 769
CALL Check(NOT Window.IsStyleValid(BadWindow))
BadWindow = SkinWindow
BadWindow.SourceLeft = 384
BadWindow.SourceRight = 384
CALL Check(NOT Window.IsStyleValid(BadWindow))
BadWindow = SkinWindow
BadWindow.SourceX = 1
CALL Check(NOT Window.IsStyleValid(BadWindow))
BadWindow = SkinWindow
BadWindow.FilterMode = 9
CALL Check(NOT Window.IsStyleValid(BadWindow))
BadWindow = SkinWindow
BadWindow.Opacity = 101
CALL Check(NOT Window.IsStyleValid(BadWindow))
BadWindow = VectorWindow
BadWindow.Padding.Left = UI.UI_MAX_LAYOUT_VALUE + 1
CALL Check(NOT Window.IsStyleValid(BadWindow))

CALL Check(BitmapFont.IsStyleValid(FontStyle))
BadFont = FontStyle
BadFont.SourceX = -1
CALL Check(NOT BitmapFont.IsStyleValid(BadFont))
BadFont = FontStyle
BadFont.Columns = 17
CALL Check(NOT BitmapFont.IsStyleValid(BadFont))
BadFont = FontStyle
BadFont.SourceY = 1
CALL Check(NOT BitmapFont.IsStyleValid(BadFont))
BadFont = FontStyle
BadFont.FilterMode = 4
CALL Check(NOT BitmapFont.IsStyleValid(BadFont))
BadFont = FontStyle
BadFont.FirstCodePoint = 1114110
BadFont.GlyphCount = 3
CALL Check(NOT BitmapFont.IsStyleValid(BadFont))
BadFont = FontStyle
BadFont.FirstCodePoint = 55296
BadFont.GlyphCount = 1
CALL Check(NOT BitmapFont.IsStyleValid(BadFont))

MenuStyle.Window = SkinWindow
MenuStyle.NormalText = SystemText
MenuStyle.SelectedText = SystemText
MenuStyle.DisabledText = SystemText
MenuStyle.UseCursor = TRUE
MenuStyle.Cursor = Cursor
MenuStyle.CursorWidth = 24
MenuStyle.CursorHeight = 24
MenuStyle.CursorFilterMode = UI.UI_FILTER_PIXEL
MenuStyle.RowHeight = 40
MenuStyle.WrapSelection = TRUE
MenuStyle.ShowScrollbar = TRUE
CALL Check(Menu.IsStyleValid(MenuStyle))

BadMenuStyle = MenuStyle
BadMenuStyle.NormalText.Mode = 9
CALL Check(NOT Menu.IsStyleValid(BadMenuStyle))
BadMenuStyle = MenuStyle
BadMenuStyle.CursorWidth = 0
CALL Check(NOT Menu.IsStyleValid(BadMenuStyle))
BadMenuStyle = MenuStyle
BadMenuStyle.CursorFilterMode = 7
CALL Check(NOT Menu.IsStyleValid(BadMenuStyle))

MenuHandle = Menu.Create(MenuStyle, 10, 10, 280, 280, 6)
FOR Index = 0 TO 11
    ItemIndex = Menu.AddItem(MenuHandle, "ITEM", Index, TRUE)
END FOR
CALL Check(Menu.VisibleRows(MenuHandle) = 6)
CALL Check(Menu.SetSelectedIndex(MenuHandle, 10))
LargeMenuStyle = MenuStyle
LargeMenuStyle.RowHeight = 100
CALL Check(Menu.SetStyle(MenuHandle, LargeMenuStyle))
CALL Check(Menu.VisibleRows(MenuHandle) = 2)
CALL Check(Menu.TopIndex(MenuHandle) = 9)
CALL Check(Menu.SelectedIndex(MenuHandle) >= Menu.TopIndex(MenuHandle))
CALL Check(Menu.SelectedIndex(MenuHandle) < Menu.TopIndex(MenuHandle) + Menu.VisibleRows(MenuHandle))
CALL Check(Menu.SetStyle(MenuHandle, MenuStyle))
CALL Check(Menu.VisibleRows(MenuHandle) = 6)
CALL Check(Menu.TopIndex(MenuHandle) = 6)
CALL Check(Menu.SetSelectedIndex(MenuHandle, 5))
CALL Check(Menu.SetSelectedIndex(MenuHandle, 10))
CALL Check(Menu.TopIndex(MenuHandle) = 5)
OldTop = Menu.TopIndex(MenuHandle)
CALL Check(NOT Menu.SetStyle(MenuHandle, BadMenuStyle))
CALL Check(Menu.TopIndex(MenuHandle) = OldTop)

TinyMenuStyle = MenuStyle
TinyMenuStyle.Window = VectorWindow
TinyMenuStyle.Window.Padding.Left = 0
TinyMenuStyle.Window.Padding.Top = 0
TinyMenuStyle.Window.Padding.Right = 0
TinyMenuStyle.Window.Padding.Bottom = 0
TinyMenuStyle.RowHeight = 100
TinyMenuHandle = Menu.Create(TinyMenuStyle, 600, 350, 30, 3, 6)
FOR Index = 0 TO 11
    ItemIndex = Menu.AddItem(TinyMenuHandle, "TINY", Index, TRUE)
END FOR
CALL Check(Menu.VisibleRows(TinyMenuHandle) = 1)
CALL Check(Menu.SetSelectedIndex(TinyMenuHandle, 11))
CALL Check(Menu.TopIndex(TinyMenuHandle) = 11)

LineHeight = Text.MeasureHeight(SystemText, "")
CALL Check(Text.MeasureHeight(SystemText, "ONE") = LineHeight)
CALL Check(Text.MeasureHeight(SystemText, "ONE
TWO") = LineHeight * 2 + SystemText.LineSpacing)
CALL Check(Text.MeasureHeight(SystemText, "ONE

THREE") = LineHeight * 3 + SystemText.LineSpacing * 2)
CALL Check(Text.MeasureHeight(SystemText, "TRAILING
") = LineHeight * 2 + SystemText.LineSpacing)
CALL Check(Text.MeasureWidth(SystemText, "ONE
LONGER") = Text.MeasureWidth(SystemText, "LONGER"))
LineHeight = Text.MeasureHeight(BitmapText, "")
CALL Check(Text.MeasureHeight(BitmapText, "ONE
TWO") = LineHeight * 2 + BitmapText.LineSpacing)
CALL Check(Text.MeasureHeight(BitmapText, "ONE

THREE") = LineHeight * 3 + BitmapText.LineSpacing * 2)
CALL Check(Text.MeasureHeight(BitmapText, "TRAILING
") = LineHeight * 2 + BitmapText.LineSpacing)

DialogueStyle.Window = SkinWindow
DialogueStyle.Text = SystemText
DialogueStyle.CharactersPerSecond = 10
DialogueStyle.LineSpacing = 3
CALL Check(Dialogue.IsStyleValid(DialogueStyle))
BadDialogueStyle = DialogueStyle
BadDialogueStyle.CharactersPerSecond = -1
CALL Check(NOT Dialogue.IsStyleValid(BadDialogueStyle))
BadDialogueStyle = DialogueStyle
BadDialogueStyle.UseContinueIndicator = TRUE
BadDialogueStyle.ContinueIndicator = Cursor
BadDialogueStyle.IndicatorWidth = 0
BadDialogueStyle.IndicatorHeight = 20
CALL Check(NOT Dialogue.IsStyleValid(BadDialogueStyle))

DialogueHandle = Dialogue.Create(DialogueStyle, 310, 10, 320, 200)
CALL Check(Dialogue.AddPage(DialogueHandle, "ONE TWO THREE FOUR FIVE SIX SEVEN EIGHT NINE TEN"))
CALL Check(Dialogue.AddPage(DialogueHandle, "SECOND PAGE"))
CALL Check(Dialogue.Start(DialogueHandle, 0))
OperationSucceeded = Dialogue.Update(DialogueHandle, 500) = UI.UI_EVENT_CHANGED
OldVisible = Dialogue.VisibleCharacters(DialogueHandle)
OldPage = Dialogue.CurrentPage(DialogueHandle)
BitmapDialogueStyle = DialogueStyle
BitmapDialogueStyle.Text = BitmapText
CALL Check(Dialogue.SetStyle(DialogueHandle, BitmapDialogueStyle))
CALL Check(Dialogue.IsActive(DialogueHandle))
CALL Check(Dialogue.VisibleCharacters(DialogueHandle) = OldVisible)
CALL Check(Dialogue.CurrentPage(DialogueHandle) = OldPage)
VectorDialogueStyle = BitmapDialogueStyle
VectorDialogueStyle.Window = VectorWindow
CALL Check(Dialogue.SetStyle(DialogueHandle, VectorDialogueStyle))
CALL Check(Dialogue.IsActive(DialogueHandle))
OldVisible = Dialogue.VisibleCharacters(DialogueHandle)
OldPage = Dialogue.CurrentPage(DialogueHandle)
BadDialogueStyle = VectorDialogueStyle
BadDialogueStyle.Window.Padding.Left = 160
BadDialogueStyle.Window.Padding.Right = 160
CALL Check(NOT Dialogue.SetStyle(DialogueHandle, BadDialogueStyle))
CALL Check(Dialogue.IsActive(DialogueHandle))
CALL Check(Dialogue.VisibleCharacters(DialogueHandle) = OldVisible)
CALL Check(Dialogue.CurrentPage(DialogueHandle) = OldPage)

LimitHandle = Dialogue.Create(DialogueStyle, 0, 0, 1000, 300)
FOR Index = 1 TO UI.UI_MAX_DIALOGUE_PAGE_SCALARS - 1
    LongValue = LongValue + "A"
END FOR
CALL Check(Dialogue.AddPage(LimitHandle, LongValue))
CALL Dialogue.ClearPages(LimitHandle)
LongValue = LongValue + "A"
CALL Check(Dialogue.AddPage(LimitHandle, LongValue))
CALL Check(Dialogue.PageCount(LimitHandle) = 1)
LongValue = LongValue + "A"
CALL Check(NOT Dialogue.AddPage(LimitHandle, LongValue))
CALL Check(Dialogue.PageCount(LimitHandle) = 1)
Started = TIMER()
CALL Check(Dialogue.Start(LimitHandle, Started))
UnbrokenMilliseconds = TIMER() - Started
CALL Check(UnbrokenMilliseconds < 5000)

CALL Dialogue.ClearPages(LimitHandle)
LongValue = ""
FOR Index = 1 TO UI.UI_MAX_DIALOGUE_PAGE_SCALARS / 2
    LongValue = LongValue + "A "
END FOR
CALL Check(TEXT_LENGTH(LongValue) = UI.UI_MAX_DIALOGUE_PAGE_SCALARS)
CALL Check(Dialogue.AddPage(LimitHandle, LongValue))
Started = TIMER()
CALL Check(Dialogue.Start(LimitHandle, Started))
SpacedMilliseconds = TIMER() - Started
CALL Check(SpacedMilliseconds < 5000)

CALL Dialogue.ClearPages(LimitHandle)
LongValue = ""
FOR Index = 1 TO UI.UI_MAX_DIALOGUE_PAGE_SCALARS
    LongValue = LongValue + "😀"
END FOR
CALL Check(TEXT_LENGTH(LongValue) = UI.UI_MAX_DIALOGUE_PAGE_SCALARS)
CALL Check(Dialogue.AddPage(LimitHandle, LongValue))
Started = TIMER()
CALL Check(Dialogue.Start(LimitHandle, Started))
UnicodeMilliseconds = TIMER() - Started
CALL Check(UnicodeMilliseconds < 5000)

CALL Dialogue.ClearPages(LimitHandle)
LongValue = ""
FOR Index = 1 TO UI.UI_MAX_DIALOGUE_PAGE_SCALARS
    LongValue = LongValue + " "
END FOR
CALL Check(Dialogue.AddPage(LimitHandle, LongValue))
CALL Check(Dialogue.Start(LimitHandle, TIMER()))

CALL Dialogue.ClearPages(LimitHandle)
LongValue = ""
FOR Index = 1 TO UI.UI_MAX_DIALOGUE_PAGE_SCALARS
    LongValue = LongValue + "
"
END FOR
CALL Check(Dialogue.AddPage(LimitHandle, LongValue))
CALL Check(NOT Dialogue.Start(LimitHandle, TIMER()))

PreparationMilliseconds = MAX(UnbrokenMilliseconds, MAX(SpacedMilliseconds, UnicodeMilliseconds))

CLEAR RGB(5, 9, 25)
CALL Menu.Draw(MenuHandle)
CALL Menu.Draw(TinyMenuHandle)
CALL Dialogue.Draw(DialogueHandle, TIMER())
CALL Text.Draw(SystemText, "SYSTEM
MULTILINE", 320, 235, UI.UI_ALIGN_LEFT, 100)
CALL Text.Draw(BitmapText, "BITMAP
MULTILINE", 480, 235, UI.UI_ALIGN_CENTER, 100)
CALL Text.Draw(SystemText, "HIDDEN", 620, 340, UI.UI_ALIGN_RIGHT, 0)
SHOW SCREEN

CALL Dialogue.Destroy(LimitHandle)
CALL Dialogue.Destroy(DialogueHandle)
CALL Menu.Destroy(TinyMenuHandle)
CALL Menu.Destroy(MenuHandle)
CALL BitmapFont.Destroy(FontHandle)
UNLOAD IMAGE Cursor
UNLOAD IMAGE Atlas
UNLOAD IMAGE Skin

SAVE Failures TO "Result"
SAVE PreparationMilliseconds TO "PreparationMilliseconds"
SAVE UnbrokenMilliseconds TO "UnbrokenMilliseconds"
SAVE SpacedMilliseconds TO "SpacedMilliseconds"
SAVE UnicodeMilliseconds TO "UnicodeMilliseconds"
PRINT Failures

SUB Check(Condition AS BOOLEAN)
    CheckNumber = CheckNumber + 1
    IF NOT Condition THEN
        Failures = Failures + 1
        PRINT CheckNumber
    END IF
END SUB

END PROGRAM
