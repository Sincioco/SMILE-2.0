Option Explicit

Import Smile.Simple3D.Core As Core
Import Smile.Simple3D.FixedMath As Math3D
Import Smile.Simple3D.Math3D As TrueMath3D
Import Smile.Simple3D.Mesh As Mesh
Import Smile.Simple3D.Primitives As Primitives
Import Smile.Simple3D.Renderer As Renderer
Import Smile.Simple3D.Interaction As Interaction

Dim Failures As Number
Dim Handle As Number
Dim Handles[32] As Number
Dim Index As Number
Dim Point As Core.Vector3
Dim Camera As Core.Camera3D
Dim Projected As Core.ProjectedPoint3D
Dim Orbit As Core.OrbitState3D
Dim CameraControls As Core.CameraControl3D
Dim ControlledCamera As Core.Camera3D
Dim ControlAccepted As Boolean
Dim OtherPoint As Core.Vector3
Dim VectorResult As Core.Vector3
Dim Matrix As Core.Matrix4

If Math3D.SinFixed(0) <> 0 Then
    Failures = Failures + 1
End If

If Math3D.SinFixed(90) <> Core.FIXED_ONE Then
    Failures = Failures + 1
End If

If Math3D.SinFixed(180) <> 0 Then
    Failures = Failures + 1
End If

If Math3D.SinFixed(270) <> -Core.FIXED_ONE Then
    Failures = Failures + 1
End If

If Math3D.WrapDegrees(-90) <> 270 Then
    Failures = Failures + 1
End If

If Math3D.DivideFixed(100, 0) <> 0 Then
    Failures = Failures + 1
End If

Point.X = 3
Point.Y = 4
OtherPoint.X = 1
OtherPoint.Y = 2
OtherPoint.Z = 3
VectorResult = TrueMath3D.Add(Point, OtherPoint)

If (VectorResult.X <> 4 Or
    VectorResult.Y <> 6 Or
    VectorResult.Z <> 3) Then
    Failures = Failures + 1
End If

VectorResult = TrueMath3D.Subtract(Point, OtherPoint)

If (VectorResult.X <> 2 Or
    VectorResult.Y <> 2 Or
    VectorResult.Z <> -3) Then
    Failures = Failures + 1
End If

VectorResult = TrueMath3D.MultiplyScalar(OtherPoint, 3)

If (VectorResult.X <> 3 Or
    VectorResult.Y <> 6 Or
    VectorResult.Z <> 9) Then
    Failures = Failures + 1
End If

If TrueMath3D.Dot(Point, OtherPoint) <> 11 Or TrueMath3D.Length(Point) <> 5 Then
    Failures = Failures + 1
End If

VectorResult = TrueMath3D.Cross(Point, OtherPoint)

If (VectorResult.X <> 12 Or
    VectorResult.Y <> -9 Or
    VectorResult.Z <> 2) Then
    Failures = Failures + 1
End If

VectorResult = TrueMath3D.Normalize(Point)

If Abs(VectorResult.X - 9830) > 1 Or Abs(VectorResult.Y - 13107) > 1 Then
    Failures = Failures + 1
End If

Point.X = 0
Point.Y = 0
Point.Z = 0
VectorResult = TrueMath3D.Normalize(Point)

If (VectorResult.X <> 0 Or
    VectorResult.Y <> 0 Or
    VectorResult.Z <> 0) Then
    Failures = Failures + 1
End If

If TrueMath3D.Distance(Point, OtherPoint) <> 3 Then
    Failures = Failures + 1
End If

Matrix = TrueMath3D.Identity()

If (Matrix.M11 <> Core.FIXED_ONE Or
    Matrix.M22 <> Core.FIXED_ONE Or
    Matrix.M33 <> Core.FIXED_ONE Or
    Matrix.M44 <> Core.FIXED_ONE) Then
    Failures = Failures + 1
End If

Matrix = TrueMath3D.Translation(20, 30, 40)
VectorResult = TrueMath3D.TransformPoint(Point, Matrix)

If (VectorResult.X <> 20 Or
    VectorResult.Y <> 30 Or
    VectorResult.Z <> 40) Then
    Failures = Failures + 1
End If

Point.X = 10
Point.Y = 20
Point.Z = 30
Matrix = TrueMath3D.Scale(200, 50, 100)
VectorResult = TrueMath3D.TransformPoint(Point, Matrix)

If (VectorResult.X <> 20 Or
    VectorResult.Y <> 10 Or
    VectorResult.Z <> 30) Then
    Failures = Failures + 1
End If

Matrix = TrueMath3D.RotationY(90)
VectorResult = TrueMath3D.TransformPoint(Point, Matrix)

If Abs(VectorResult.X - 30) > 1 Or Abs(VectorResult.Z + 10) > 1 Then
    Failures = Failures + 1
End If

Point.X = 0
Point.Y = 10
Point.Z = 20
Matrix = TrueMath3D.RotationX(90)
VectorResult = TrueMath3D.TransformPoint(Point, Matrix)

If Abs(VectorResult.Y + 20) > 1 Or Abs(VectorResult.Z - 10) > 1 Then
    Failures = Failures + 1
End If

Point.X = 10
Point.Y = 20
Point.Z = 0
Matrix = TrueMath3D.RotationZ(90)
VectorResult = TrueMath3D.TransformPoint(Point, Matrix)

If Abs(VectorResult.X + 20) > 1 Or Abs(VectorResult.Y - 10) > 1 Then
    Failures = Failures + 1
End If

Point.X = 1
Point.Y = 2
Point.Z = 3
Matrix = TrueMath3D.Multiply(TrueMath3D.Scale(200, 200, 200), TrueMath3D.Translation(10, 20, 30))
VectorResult = TrueMath3D.TransformPoint(Point, Matrix)

If (VectorResult.X <> 12 Or
    VectorResult.Y <> 24 Or
    VectorResult.Z <> 36) Then
    Failures = Failures + 1
End If

Matrix = TrueMath3D.Perspective(60, 177, 1, 1000)

If (Matrix.M11 = 0 Or
    Matrix.M22 = 0 Or
    Matrix.M34 <> Core.FIXED_ONE) Then
    Failures = Failures + 1
End If

Point.X = 0
Point.Y = 0
Point.Z = -10
OtherPoint.X = 0
OtherPoint.Y = 0
OtherPoint.Z = 0
Matrix = TrueMath3D.LookAt(Point, OtherPoint)

If Matrix.M43 <> 10 Or Matrix.M44 <> Core.FIXED_ONE Then
    Failures = Failures + 1
End If

Handle = Primitives.CreateCube(200)

If Mesh.VertexCount(Handle) <> 8 Or Mesh.EdgeCount(Handle) <> 12 Then
    Failures = Failures + 1
End If

Call Mesh.DestroyMesh(Handle)

Handle = Primitives.CreatePyramid(200, 240)

If Mesh.VertexCount(Handle) <> 5 Or Mesh.EdgeCount(Handle) <> 8 Then
    Failures = Failures + 1
End If

Call Mesh.DestroyMesh(Handle)

Handle = Primitives.CreateSphere(100, 8, 4)

If Mesh.VertexCount(Handle) <> 40 Or Mesh.EdgeCount(Handle) <> 72 Then
    Failures = Failures + 1
End If

Call Mesh.DestroyMesh(Handle)

Handle = Primitives.CreateDonut(100, 30, 8, 6)

If Mesh.VertexCount(Handle) <> 48 Or Mesh.EdgeCount(Handle) <> 96 Then
    Failures = Failures + 1
End If

Call Mesh.DestroyMesh(Handle)

For Index = 0 To Core.MAX_MESHES - 1

    Handles[Index] = Mesh.CreateMesh()

    If Handles[Index] = 0 Then
        Failures = Failures + 1
    End If

End For

If Mesh.CreateMesh() <> 0 Then
    Failures = Failures + 1
End If

Call Mesh.DestroyMesh(Handles[10])

Handle = Mesh.CreateMesh()

If Handle = 0 Then
    Failures = Failures + 1
End If

Call Mesh.DestroyMesh(Handle)

For Index = 0 To Core.MAX_MESHES - 1
    Call Mesh.DestroyMesh(Handles[Index])
End For

Point.X = 0
Point.Y = 0
Point.Z = 0
Camera = Renderer.DefaultCamera(960, 540)
Projected = Renderer.ProjectPoint(Point, Camera)

If (Not Projected.Visible Or
    Projected.X <> 480 Or
    Projected.Y <> 270) Then
    Failures = Failures + 1
End If

Point.Z = -900
Projected = Renderer.ProjectPoint(Point, Camera)

If Projected.Visible Then
    Failures = Failures + 1
End If

Call Interaction.ResetOrbit(Orbit)
Call Interaction.UpdateOrbit(Orbit, True, True, False, 12, -8, 1, 16)

If (Orbit.Yaw <> 37 Or
    Orbit.Pitch <> 10 Or
    Orbit.Distance <> 780) Then
    Failures = Failures + 1
End If

Call Interaction.UpdateOrbit(Orbit, False, False, True, 0, 0, 0, 16)

If Orbit.Dragging Then
    Failures = Failures + 1
End If

Call Interaction.ResetCameraControls(CameraControls)

Camera.FovDegrees = 55
Camera.UpDirection.Y = 1

If (Not Interaction.UpdatePanZoomControls(CameraControls, True, True, False, 10, -5, 2) Or
    Not Interaction.UpdateOrbitControls(CameraControls, True, True, False, 12, -6) Or
    CameraControls.PanX <> -20 Or
    CameraControls.PanY <> -10 Or
    CameraControls.Zoom <> -8 Or
    CameraControls.OrbitYaw <> 36 Or
    CameraControls.OrbitPitch <> -12 Or
    Not Interaction.CameraControlsDragging(CameraControls)) Then
    Failures = Failures + 1
End If

ControlledCamera = Interaction.ApplyCameraControls(Camera, CameraControls)

If (ControlledCamera.Position.X = Camera.Position.X Or
    ControlledCamera.Position.Y = Camera.Position.Y Or
    ControlledCamera.Target.X <> Camera.Target.X - 20 Or
    ControlledCamera.Target.Y <> Camera.Target.Y - 10 Or
    ControlledCamera.FovDegrees <> Camera.FovDegrees - 8) Then
    Failures = Failures + 1
End If

ControlAccepted = Interaction.UpdatePanZoomControls(CameraControls, False, False, True, 0, 0, 0)
ControlAccepted = Interaction.UpdateOrbitControls(CameraControls, False, False, True, 0, 0)
ControlAccepted = Interaction.AdvanceCameraControls(CameraControls, 120)

If Interaction.CameraControlsActive(CameraControls) Then
    Failures = Failures + 1
End If

ControlAccepted = Interaction.UpdateOrbitControls(CameraControls, True, True, False, 2, 2)
ControlAccepted = Interaction.UpdateOrbitControls(CameraControls, False, False, False, 0, 0)

If CameraControls.Orbiting Then
    Failures = Failures + 1
End If

Call Interaction.ResetCameraControls(CameraControls)

ControlAccepted = Interaction.UpdateOrbitControls(CameraControls, True, True, False, 0, 200)

If CameraControls.OrbitPitch <> 400 Then
    Failures = Failures + 1
End If

ControlAccepted = Interaction.UpdateOrbitControls(CameraControls, False, False, True, 0, 0)

If CameraControls.OrbitPitch <> 40 Then
    Failures = Failures + 1
End If

Call Interaction.ResetCameraControls(CameraControls)

CameraControls.OrbitPitch = 180
ControlledCamera = Interaction.ApplyCameraControls(Camera, CameraControls)

If ControlledCamera.UpDirection.Y <> -1 Then
    Failures = Failures + 1
End If

CameraControls.OrbitPitch = 360
ControlledCamera = Interaction.ApplyCameraControls(Camera, CameraControls)

If ControlledCamera.UpDirection.Y <> 1 Then
    Failures = Failures + 1
End If

If Failures = 0 Then
    Print "Simple3D tests passed"
Else
    Print "Simple3D tests failed: "; Failures
End If
