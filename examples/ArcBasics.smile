' Demonstrates DRAW ARC angle direction, long sweeps, and complete circles.
CONST CornerRadius = 32

GAME WINDOW "SMILE 2.0 Arc Basics"

DO
    GET KEY Key
    IF Key = KEY_ESCAPE THEN
        END PROGRAM
    END IF

    CLEAR RGB(8, 12, 28)
    DRAW TEXT "DRAW ARC" AT 480, 25 SIZE 34 COLOR CYAN CENTERED

    ' A rounded outline assembled from four lines and four 90-degree arcs.
    DRAW LINE 92, 105, 388, 105, LIGHT_BLUE
    DRAW ARC 92, 137, CornerRadius, 180, 90, LIGHT_BLUE
    DRAW ARC 388, 137, CornerRadius, 270, 90, LIGHT_BLUE
    DRAW LINE 60, 137, 60, 263, LIGHT_BLUE
    DRAW LINE 420, 137, 420, 263, LIGHT_BLUE
    DRAW ARC 92, 263, CornerRadius, 90, 90, LIGHT_BLUE
    DRAW ARC 388, 263, CornerRadius, 0, 90, LIGHT_BLUE
    DRAW LINE 92, 295, 388, 295, LIGHT_BLUE
    DRAW TEXT "FOUR JOINED CORNERS" AT 240, 185 SIZE 18 COLOR WHITE CENTERED

    DRAW ARC 570, 145, 52, 0, 90, LIGHT_GREEN
    DRAW TEXT "0, 90" AT 570, 215 SIZE 17 COLOR LIGHT_GREEN CENTERED
    DRAW TEXT "CLOCKWISE" AT 570, 238 SIZE 13 COLOR LIGHT_GRAY CENTERED

    DRAW ARC 760, 145, 52, 0, -90, YELLOW
    DRAW TEXT "0, -90" AT 760, 215 SIZE 17 COLOR YELLOW CENTERED
    DRAW TEXT "COUNTERCLOCKWISE" AT 760, 238 SIZE 13 COLOR LIGHT_GRAY CENTERED

    DRAW ARC 570, 385, 58, 0, 270, ORANGE
    DRAW TEXT "270 DEGREE LONG ARC" AT 570, 470 SIZE 14 COLOR ORANGE CENTERED

    DRAW ARC 760, 385, 58, 450, 360, MAGENTA
    DRAW TEXT "NORMALIZED FULL CIRCLE" AT 760, 470 SIZE 14 COLOR MAGENTA CENTERED

    DRAW TEXT "ESCAPE EXITS" AT 480, 510 SIZE 14 COLOR LIGHT_GRAY CENTERED
    SHOW SCREEN
    WAIT 16 MILLISECONDS
LOOP UNTIL GAME_CLOSED() = TRUE

END PROGRAM
