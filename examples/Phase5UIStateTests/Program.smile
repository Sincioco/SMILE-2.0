Option Explicit

Import Smile.UI.Core As UI
Import Smile.UI.Menu As Menus

Dim Style As UI.MenuStyle
Dim CurrentMenu As Menus.Menu
Dim OldMenu As Menus.Menu
Dim Event As Number
Dim Value As Text
Dim ItemIndex As Number
Dim Index As Number
Dim OperationSucceeded As Boolean
Dim ReflowStyle As UI.MenuStyle

Style.RowHeight = 32
Style.WrapSelection = True

CurrentMenu = New Menus.Menu(Style, 0, 0, 320, 240, 2)

ItemIndex = CurrentMenu.AddItem("First", 10)
ItemIndex = CurrentMenu.AddItem("Disabled", 20, Enabled:=False)
ItemIndex = CurrentMenu.AddItem("Third", 30)
ItemIndex = CurrentMenu.AddItem("Fourth", 40)

Print CurrentMenu.SelectedIndex

Event = CurrentMenu.Update(KEY_DOWN)
Print Event
Print CurrentMenu.SelectedIndex
Print CurrentMenu.TopIndex

Event = CurrentMenu.Update(KEY_ENTER)
Print Event
Print CurrentMenu.SelectedValue

Event = CurrentMenu.Update(KEY_DOWN)
Print CurrentMenu.SelectedIndex
Print CurrentMenu.TopIndex

Event = CurrentMenu.Update(KEY_DOWN)
Print CurrentMenu.SelectedIndex

Event = CurrentMenu.Update(KEY_ESCAPE)
Print Event

Value = "A😀B"
Print Text_Length(Value)
Print Text_Code_At(Value, 1)
Print Text_Slice(Value, 1, 1)

OldMenu = CurrentMenu

Call CurrentMenu.Destroy()

Print OldMenu.SelectedIndex

CurrentMenu = New Menus.Menu(Style, 0, 0, 320, 240, 2)
Print CurrentMenu.Valid

Call CurrentMenu.Destroy()

CurrentMenu = New Menus.Menu(Style, 0, 0, 320, 240, 2)

For Index = 0 To 63
    ItemIndex = CurrentMenu.AddItem("Item", Index)
End For
Print CurrentMenu.AddItem("Overflow", 64)
Print CurrentMenu.ItemCount

Call CurrentMenu.Destroy()

CurrentMenu = New Menus.Menu(Style, 0, 0, 320, 240, 2)
ItemIndex = CurrentMenu.AddItem("Off", 1, Enabled:=False)
ItemIndex = CurrentMenu.AddItem("Also Off", 2, Enabled:=False)
Print CurrentMenu.SelectedIndex
Print CurrentMenu.Update(KEY_DOWN)

Call CurrentMenu.Destroy()

Style.WrapSelection = False
CurrentMenu = New Menus.Menu(Style, 0, 0, 320, 240, 2)
ItemIndex = CurrentMenu.AddItem("One", 1)
ItemIndex = CurrentMenu.AddItem("Two", 2)
CurrentMenu.SelectedIndex = 1
Print CurrentMenu.Update(KEY_DOWN)
Print CurrentMenu.SelectedIndex

Call CurrentMenu.Destroy()

Style.RowHeight = 24
CurrentMenu = New Menus.Menu(Style, 0, 0, 300, 180, 6)

For Index = 0 To 11
    ItemIndex = CurrentMenu.AddItem("Item", Index)
End For
Print CurrentMenu.VisibleRows
CurrentMenu.SelectedIndex = 10
Print CurrentMenu.TopIndex
ReflowStyle = Style
ReflowStyle.RowHeight = 80
OperationSucceeded = CurrentMenu.SetStyle(ReflowStyle)
Print CurrentMenu.VisibleRows
Print CurrentMenu.TopIndex
OperationSucceeded = CurrentMenu.SetStyle(Style)
Print CurrentMenu.VisibleRows
Print CurrentMenu.TopIndex
CurrentMenu.SelectedIndex = 5
CurrentMenu.SelectedIndex = 10
Print CurrentMenu.TopIndex

Call CurrentMenu.Destroy()

Call CheckCapacity(Style)

End Program

Sub CheckCapacity(ByRef Style As UI.MenuStyle)

    Dim Slot0 As Menus.Menu
    Dim Slot1 As Menus.Menu
    Dim Slot2 As Menus.Menu
    Dim Slot3 As Menus.Menu
    Dim Slot4 As Menus.Menu
    Dim Slot5 As Menus.Menu
    Dim Slot6 As Menus.Menu
    Dim Slot7 As Menus.Menu
    Dim Slot8 As Menus.Menu
    Dim Slot9 As Menus.Menu
    Dim Slot10 As Menus.Menu
    Dim Slot11 As Menus.Menu
    Dim Slot12 As Menus.Menu
    Dim Slot13 As Menus.Menu
    Dim Slot14 As Menus.Menu
    Dim Slot15 As Menus.Menu
    Dim Overflow As Menus.Menu

    Slot0 = New Menus.Menu(Style, 0, 0, 320, 240, 2)
    Slot1 = New Menus.Menu(Style, 0, 0, 320, 240, 2)
    Slot2 = New Menus.Menu(Style, 0, 0, 320, 240, 2)
    Slot3 = New Menus.Menu(Style, 0, 0, 320, 240, 2)
    Slot4 = New Menus.Menu(Style, 0, 0, 320, 240, 2)
    Slot5 = New Menus.Menu(Style, 0, 0, 320, 240, 2)
    Slot6 = New Menus.Menu(Style, 0, 0, 320, 240, 2)
    Slot7 = New Menus.Menu(Style, 0, 0, 320, 240, 2)
    Slot8 = New Menus.Menu(Style, 0, 0, 320, 240, 2)
    Slot9 = New Menus.Menu(Style, 0, 0, 320, 240, 2)
    Slot10 = New Menus.Menu(Style, 0, 0, 320, 240, 2)
    Slot11 = New Menus.Menu(Style, 0, 0, 320, 240, 2)
    Slot12 = New Menus.Menu(Style, 0, 0, 320, 240, 2)
    Slot13 = New Menus.Menu(Style, 0, 0, 320, 240, 2)
    Slot14 = New Menus.Menu(Style, 0, 0, 320, 240, 2)
    Slot15 = New Menus.Menu(Style, 0, 0, 320, 240, 2)
    Overflow = New Menus.Menu(Style, 0, 0, 320, 240, 2)

    Print Overflow.Valid

    Call Slot15.Destroy()
    Call Slot14.Destroy()
    Call Slot13.Destroy()
    Call Slot12.Destroy()
    Call Slot11.Destroy()
    Call Slot10.Destroy()
    Call Slot9.Destroy()
    Call Slot8.Destroy()
    Call Slot7.Destroy()
    Call Slot6.Destroy()
    Call Slot5.Destroy()
    Call Slot4.Destroy()
    Call Slot3.Destroy()
    Call Slot2.Destroy()
    Call Slot1.Destroy()
    Call Slot0.Destroy()

End Sub
