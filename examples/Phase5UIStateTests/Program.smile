Option Explicit

Import Smile.UI.Core As UI
Import Smile.UI.Menu As Menu

Dim Style As UI.MenuStyle
Dim Handle As Number
Dim OldHandle As Number
Dim Event As Number
Dim Value As Text
Dim ItemIndex As Number
Dim Index As Number
Dim Handles[16] As Number
Dim OperationSucceeded As Boolean
Dim ReflowStyle As UI.MenuStyle

Style.RowHeight = 32
Style.WrapSelection = True

Handle = Menu.Create(Style, 0, 0, 320, 240, 2)

ItemIndex = Menu.AddItem(Handle, "First", 10, True)
ItemIndex = Menu.AddItem(Handle, "Disabled", 20, False)
ItemIndex = Menu.AddItem(Handle, "Third", 30, True)
ItemIndex = Menu.AddItem(Handle, "Fourth", 40, True)

Print Menu.SelectedIndex(Handle)

Event = Menu.HandleKey(Handle, KEY_DOWN)
Print Event
Print Menu.SelectedIndex(Handle)
Print Menu.TopIndex(Handle)

Event = Menu.HandleKey(Handle, KEY_ENTER)
Print Event
Print Menu.SelectedValue(Handle)

Event = Menu.HandleKey(Handle, KEY_DOWN)
Print Menu.SelectedIndex(Handle)
Print Menu.TopIndex(Handle)

Event = Menu.HandleKey(Handle, KEY_DOWN)
Print Menu.SelectedIndex(Handle)

Event = Menu.HandleKey(Handle, KEY_ESCAPE)
Print Event

Value = "A😀B"
Print Text_Length(Value)
Print Text_Code_At(Value, 1)
Print Text_Slice(Value, 1, 1)

OldHandle = Handle
Call Menu.Destroy(Handle)
Print Menu.SelectedIndex(OldHandle)

Handle = Menu.Create(Style, 0, 0, 320, 240, 2)
Print Handle
Call Menu.Destroy(Handle)

Handle = Menu.Create(Style, 0, 0, 320, 240, 2)
For Index = 0 To 63
    ItemIndex = Menu.AddItem(Handle, "Item", Index, True)
End For
Print Menu.AddItem(Handle, "Overflow", 64, True)
Print Menu.ItemCount(Handle)
Call Menu.Destroy(Handle)

Handle = Menu.Create(Style, 0, 0, 320, 240, 2)
ItemIndex = Menu.AddItem(Handle, "Off", 1, False)
ItemIndex = Menu.AddItem(Handle, "Also Off", 2, False)
Print Menu.SelectedIndex(Handle)
Print Menu.HandleKey(Handle, KEY_DOWN)
Call Menu.Destroy(Handle)

Style.WrapSelection = False
Handle = Menu.Create(Style, 0, 0, 320, 240, 2)
ItemIndex = Menu.AddItem(Handle, "One", 1, True)
ItemIndex = Menu.AddItem(Handle, "Two", 2, True)
OperationSucceeded = Menu.SetSelectedIndex(Handle, 1)
Print Menu.HandleKey(Handle, KEY_DOWN)
Print Menu.SelectedIndex(Handle)
Call Menu.Destroy(Handle)

Style.RowHeight = 24
Handle = Menu.Create(Style, 0, 0, 300, 180, 6)
For Index = 0 To 11
    ItemIndex = Menu.AddItem(Handle, "Item", Index, True)
End For
Print Menu.VisibleRows(Handle)
OperationSucceeded = Menu.SetSelectedIndex(Handle, 10)
Print Menu.TopIndex(Handle)
ReflowStyle = Style
ReflowStyle.RowHeight = 80
OperationSucceeded = Menu.SetStyle(Handle, ReflowStyle)
Print Menu.VisibleRows(Handle)
Print Menu.TopIndex(Handle)
OperationSucceeded = Menu.SetStyle(Handle, Style)
Print Menu.VisibleRows(Handle)
Print Menu.TopIndex(Handle)
OperationSucceeded = Menu.SetSelectedIndex(Handle, 5)
OperationSucceeded = Menu.SetSelectedIndex(Handle, 10)
Print Menu.TopIndex(Handle)
Call Menu.Destroy(Handle)

For Index = 0 To 15
    Handles[Index] = Menu.Create(Style, 0, 0, 320, 240, 2)
End For
Print Menu.Create(Style, 0, 0, 320, 240, 2)
For Index = 0 To 15
    Call Menu.Destroy(Handles[Index])
End For

End Program
