Option Explicit

Import Smile.RPG.Core As RPG
Import Smile.RPG.Characters As Characters
Import Smile.RPG.Party As Party
Import Smile.RPG.Inventory As Inventory
Import Smile.RPG.World As World
Import Smile.RPG.Story As Story
Import Smile.RPG.Encounters As Encounters
Import Smile.RPG.SaveGames As SaveGames
Import RPGSystems.DungeonWorkflow As DungeonWorkflow

Const CHARACTER_HERO = 100
Const CHARACTER_COMPANION = 200
Const ITEM_VAULT_KEY = 10
Const ITEM_SUN_TONIC = 20

Const ACTOR_HERO = 1000
Const ACTOR_FP_DOOR = 1100
Const ACTOR_FP_LOCKED_DOOR = 1101
Const ACTOR_FP_CHEST_GOLD = 1200
Const ACTOR_FP_CHEST_KEY = 1201
Const ACTOR_FP_HIDDEN = 1300
Const ACTOR_TOP_DOOR = 2100
Const ACTOR_TOP_LOCKED_DOOR = 2101
Const ACTOR_TOP_CHEST_ITEM = 2200
Const ACTOR_TOP_CHEST_GOLD = 2201
Const ACTOR_TOP_HIDDEN = 2300

Const FLAG_FP_DOOR = 1
Const FLAG_FP_LOCKED_DOOR = 2
Const FLAG_FP_CHEST_GOLD = 3
Const FLAG_FP_CHEST_KEY = 4
Const FLAG_FP_HIDDEN = 5
Const FLAG_FP_TRAP = 6
Const FLAG_FP_NPC = 7
Const FLAG_TOP_DOOR = 8
Const FLAG_TOP_LOCKED_DOOR = 9
Const FLAG_TOP_CHEST_ITEM = 10
Const FLAG_TOP_CHEST_GOLD = 11
Const FLAG_TOP_HIDDEN = 12
Const FLAG_TOP_TRAP = 13
Const FLAG_TOP_NPC = 14
Const VALUE_REPEAT_TRAPS = 30

Dim Checks As Number
Dim Failures As Number
Dim State As Number
Dim Result As Number
Dim PreviousScene As Number
Dim PreviousX As Number
Dim PreviousY As Number
Dim Scene As World.SceneDefinition
Dim Spawn As World.SpawnDefinition
Dim Transition As World.TransitionDefinition
Dim Actor As World.ActorDefinition
Dim Character As Characters.CharacterDefinition
Dim Item As Inventory.ItemDefinition
Dim Zone As Encounters.ZoneDefinition

State = RPG.Create()

Call Check(State > 0)
Call DefineCharacters()
Call DefineItems()
Call DefineStory()
Call DefineWorld()
Call DefineEncounters()

Result = DungeonWorkflow.StartNewGame(State, 1, 8)

Call Check(Result = DungeonWorkflow.DUNGEON_RESULT_OK)
Call Check(World.CurrentScene(State) = 1)
Call Check(World.ControlledActor(State) = ACTOR_HERO)
Call Check(Party.PartyCount(State) = 2 And Party.Gold(State) = 60)
Call Check(DungeonWorkflow.FieldCommandsAllowed(False))
Call Check(Not DungeonWorkflow.FieldCommandsAllowed(True))

' Ordinary and locked barriers are atomic, requirement-aware, and idempotent.

Result = DungeonWorkflow.CompleteBarrier(State, ACTOR_FP_DOOR, FLAG_FP_DOOR)

Call Check(Result = DungeonWorkflow.DUNGEON_RESULT_OK)
Call Check(Story.Flag(State, FLAG_FP_DOOR) And Not World.ActorIsVisible(State, ACTOR_FP_DOOR))

Result = DungeonWorkflow.CompleteBarrier(State, ACTOR_FP_DOOR, FLAG_FP_DOOR)

Call Check(Result = DungeonWorkflow.DUNGEON_RESULT_ALREADY_COMPLETED)

Result = DungeonWorkflow.CompleteLockedBarrier(State, ACTOR_FP_LOCKED_DOOR, FLAG_FP_LOCKED_DOOR, ITEM_VAULT_KEY)

Call Check(Result = DungeonWorkflow.DUNGEON_RESULT_MISSING_REQUIREMENT)
Call Check(Not Story.Flag(State, FLAG_FP_LOCKED_DOOR) And World.ActorIsVisible(State, ACTOR_FP_LOCKED_DOOR))
Call Check(Inventory.AddItem(State, ITEM_VAULT_KEY, 1))

Result = DungeonWorkflow.CompleteLockedBarrier(State, ACTOR_FP_LOCKED_DOOR, FLAG_FP_LOCKED_DOOR, ITEM_VAULT_KEY)

Call Check(Result = DungeonWorkflow.DUNGEON_RESULT_OK)
Call Check(Inventory.Quantity(State, ITEM_VAULT_KEY) = 1)
Call Check(Story.Flag(State, FLAG_FP_LOCKED_DOOR) And Not World.ActorIsVisible(State, ACTOR_FP_LOCKED_DOOR))

' Reward chests grant once and preserve every preflight or repeated-activation invariant.

Result = DungeonWorkflow.CompleteGoldChest(State, ACTOR_FP_CHEST_GOLD, FLAG_FP_CHEST_GOLD, 50)

Call Check(Result = DungeonWorkflow.DUNGEON_RESULT_OK And Party.Gold(State) = 110)

Result = DungeonWorkflow.CompleteGoldChest(State, ACTOR_FP_CHEST_GOLD, FLAG_FP_CHEST_GOLD, 50)

Call Check(Result = DungeonWorkflow.DUNGEON_RESULT_ALREADY_COMPLETED And Party.Gold(State) = 110)

Result = DungeonWorkflow.CompleteItemChest(State, ACTOR_FP_CHEST_KEY, FLAG_FP_CHEST_KEY, ITEM_VAULT_KEY)

Call Check(Result = DungeonWorkflow.DUNGEON_RESULT_CAPACITY)
Call Check(Not Story.Flag(State, FLAG_FP_CHEST_KEY) And World.ActorIsVisible(State, ACTOR_FP_CHEST_KEY))

Result = DungeonWorkflow.CompleteMultiItemChest(State, ACTOR_TOP_CHEST_ITEM, FLAG_TOP_CHEST_ITEM, ITEM_VAULT_KEY, ITEM_SUN_TONIC)

Call Check(Result = DungeonWorkflow.DUNGEON_RESULT_OK)
Call Check(Inventory.Quantity(State, ITEM_VAULT_KEY) = 1 And Inventory.Quantity(State, ITEM_SUN_TONIC) = 1)
Call Check(Story.Flag(State, FLAG_TOP_CHEST_ITEM) And Not World.ActorIsVisible(State, ACTOR_TOP_CHEST_ITEM))

Result = DungeonWorkflow.CompleteMultiItemChest(State, ACTOR_TOP_CHEST_ITEM, FLAG_TOP_CHEST_ITEM, ITEM_VAULT_KEY, ITEM_SUN_TONIC)

Call Check(Result = DungeonWorkflow.DUNGEON_RESULT_ALREADY_COMPLETED)
Call Check(Inventory.Quantity(State, ITEM_SUN_TONIC) = 1)

Result = DungeonWorkflow.CompleteBarrier(State, ACTOR_FP_HIDDEN, FLAG_FP_HIDDEN)

Call Check(Result = DungeonWorkflow.DUNGEON_RESULT_OK)

' One-shot traps never double-apply; repeat traps update damage and count together.

Result = DungeonWorkflow.ApplyOneShotTrap(State, CHARACTER_HERO, FLAG_FP_TRAP, 9)

Call Check(Result = DungeonWorkflow.DUNGEON_RESULT_OK)
Call Check(Characters.Health(State, CHARACTER_HERO) = 131 And Story.Flag(State, FLAG_FP_TRAP))

Result = DungeonWorkflow.ApplyOneShotTrap(State, CHARACTER_HERO, FLAG_FP_TRAP, 9)

Call Check(Result = DungeonWorkflow.DUNGEON_RESULT_ALREADY_COMPLETED)
Call Check(Characters.Health(State, CHARACTER_HERO) = 131)

Result = DungeonWorkflow.ApplyRepeatTrap(State, CHARACTER_HERO, VALUE_REPEAT_TRAPS, 3)

Call Check(Result = DungeonWorkflow.DUNGEON_RESULT_OK)
Call Check(Characters.Health(State, CHARACTER_HERO) = 128 And Story.Value(State, VALUE_REPEAT_TRAPS) = 1)

' NPC completion follows actual dialogue start and remains idempotent.

Result = DungeonWorkflow.CompleteNpcDialogue(State, FLAG_FP_NPC, False)

Call Check(Result = DungeonWorkflow.DUNGEON_RESULT_APPLY_FAILED)
Call Check(Not Story.Flag(State, FLAG_FP_NPC))

Result = DungeonWorkflow.CompleteNpcDialogue(State, FLAG_FP_NPC, True)

Call Check(Result = DungeonWorkflow.DUNGEON_RESULT_OK And Story.Flag(State, FLAG_FP_NPC))

Result = DungeonWorkflow.CompleteNpcDialogue(State, FLAG_FP_NPC, True)

Call Check(Result = DungeonWorkflow.DUNGEON_RESULT_ALREADY_COMPLETED)

' Encounter preview writes and restores one exact return transaction.

PreviousScene = World.CurrentScene(State)
PreviousX = World.ActorX(State, ACTOR_HERO)
PreviousY = World.ActorY(State, ACTOR_HERO)
Result = DungeonWorkflow.BeginEncounter(State, ACTOR_HERO, 500)

Call Check(Result = DungeonWorkflow.DUNGEON_RESULT_OK)
Call Check(Encounters.PendingEncounter(State) = 500)
Call Check(World.ReturnScene(State) = PreviousScene And World.ReturnX(State) = PreviousX And World.ReturnY(State) = PreviousY)

Result = DungeonWorkflow.CompleteEncounter(State, ACTOR_HERO)

Call Check(Result = DungeonWorkflow.DUNGEON_RESULT_OK)
Call Check(Encounters.PendingEncounter(State) = 0)
Call Check(World.CurrentScene(State) = PreviousScene And World.ActorX(State, ACTOR_HERO) = PreviousX And World.ActorY(State, ACTOR_HERO) = PreviousY)

Result = DungeonWorkflow.AdvanceEncounter(State, ACTOR_HERO, 1, Encounters.Seed(State, 1))

Call Check(Result = DungeonWorkflow.DUNGEON_RESULT_NOT_FOUND)
Call Check(Encounters.StepCount(State, 1) = 1 And Encounters.PendingEncounter(State) = 0)

Result = DungeonWorkflow.AdvanceEncounter(State, ACTOR_HERO, 1, Encounters.Seed(State, 1))

Call Check(Result = DungeonWorkflow.DUNGEON_RESULT_OK)
Call Check(Encounters.PendingEncounter(State) = 500)

Result = DungeonWorkflow.CompleteEncounter(State, ACTOR_HERO)

Call Check(Result = DungeonWorkflow.DUNGEON_RESULT_OK And Encounters.PendingEncounter(State) = 0)

' Spawns and transitions expose honest result codes and never claim a failed move.

Result = DungeonWorkflow.ApplySpawn(State, ACTOR_HERO, 201)

Call Check(Result = DungeonWorkflow.DUNGEON_RESULT_OK And World.CurrentScene(State) = 11)

Result = DungeonWorkflow.ActivateTransition(State, 1)

Call Check(Result = DungeonWorkflow.DUNGEON_RESULT_OK And World.CurrentScene(State) = 12)

PreviousScene = World.CurrentScene(State)
PreviousX = World.ActorX(State, ACTOR_HERO)
PreviousY = World.ActorY(State, ACTOR_HERO)
Result = DungeonWorkflow.ActivateTransition(State, 999)

Call Check(Result = DungeonWorkflow.DUNGEON_RESULT_BLOCKED)
Call Check(World.CurrentScene(State) = PreviousScene And World.ActorX(State, ACTOR_HERO) = PreviousX And World.ActorY(State, ACTOR_HERO) = PreviousY)

' Load projects canonical story flags and rejects invalid app semantics with rollback.

Call Check(World.SetActorVisible(State, ACTOR_FP_DOOR, True))

Result = SaveGames.SaveGame(State, 8, 8)

Call Check(Result = RPG.RPG_RESULT_OK)
Call Check(World.SetActorVisible(State, ACTOR_FP_DOOR, False))

Result = DungeonWorkflow.LoadGame(State, 8, 8)

Call Check(Result = DungeonWorkflow.DUNGEON_RESULT_OK)
Call Check(Story.Flag(State, FLAG_FP_DOOR) And Not World.ActorIsVisible(State, ACTOR_FP_DOOR))

Call Check(World.SetControlledActor(State, 0))

Result = SaveGames.SaveGame(State, 7, 8)

Call Check(Result = RPG.RPG_RESULT_OK)
Call Check(World.SetControlledActor(State, ACTOR_HERO))

PreviousScene = World.CurrentScene(State)
PreviousX = World.ActorX(State, ACTOR_HERO)
PreviousY = World.ActorY(State, ACTOR_HERO)
Result = DungeonWorkflow.LoadGame(State, 7, 8)

Call Check(Result = DungeonWorkflow.DUNGEON_RESULT_INVALID_STATE)
Call Check(World.ControlledActor(State) = ACTOR_HERO)
Call Check(World.CurrentScene(State) = PreviousScene And World.ActorX(State, ACTOR_HERO) = PreviousX And World.ActorY(State, ACTOR_HERO) = PreviousY)

Result = DungeonWorkflow.SaveGame(State, 8, 8)

Call Check(Result = DungeonWorkflow.DUNGEON_RESULT_OK)

' Capacity and success paths are independently proven for each single-reward chest.

Result = DungeonWorkflow.StartNewGame(State, 1, 8)

Call Check(Result = DungeonWorkflow.DUNGEON_RESULT_OK)

Result = DungeonWorkflow.CompleteItemChest(State, ACTOR_FP_CHEST_KEY, FLAG_FP_CHEST_KEY, ITEM_VAULT_KEY)

Call Check(Result = DungeonWorkflow.DUNGEON_RESULT_OK)
Call Check(Inventory.Quantity(State, ITEM_VAULT_KEY) = 1)
Call Check(Story.Flag(State, FLAG_FP_CHEST_KEY) And Not World.ActorIsVisible(State, ACTOR_FP_CHEST_KEY))

Result = DungeonWorkflow.CompleteItemChest(State, ACTOR_FP_CHEST_KEY, FLAG_FP_CHEST_KEY, ITEM_VAULT_KEY)

Call Check(Result = DungeonWorkflow.DUNGEON_RESULT_ALREADY_COMPLETED)
Call Check(Inventory.Quantity(State, ITEM_VAULT_KEY) = 1)

Result = DungeonWorkflow.StartNewGame(State, 1, 8)

Call Check(Result = DungeonWorkflow.DUNGEON_RESULT_OK)
Call Check(Party.SetGold(State, RPG.RPG_MAX_VALUE))

Result = DungeonWorkflow.CompleteGoldChest(State, ACTOR_FP_CHEST_GOLD, FLAG_FP_CHEST_GOLD, 50)

Call Check(Result = DungeonWorkflow.DUNGEON_RESULT_CAPACITY)
Call Check(Party.Gold(State) = RPG.RPG_MAX_VALUE)
Call Check(Not Story.Flag(State, FLAG_FP_CHEST_GOLD) And World.ActorIsVisible(State, ACTOR_FP_CHEST_GOLD))

Call RPG.Destroy(State)

If Failures = 0 Then
    Print "Phase 8 dungeon state tests: PASS"
    Print Checks
Else
    Print "Phase 8 dungeon state tests: FAIL"
    Print Failures
End If

End Program

Sub Check(Condition As Boolean)

    Checks = Checks + 1

    If Not Condition Then

        Failures = Failures + 1
        Print "Failed check"
        Print Checks

    End If

End Sub

Sub DefineCharacters()

    Character.Id = CHARACTER_HERO
    Character.Name = "Aster"
    Character.StartingLevel = 4
    Character.StartingMaximumHealth = 140
    Character.StartingMaximumMagicPoints = 36
    Character.Strength = 16
    Character.Defense = 14
    Character.Magic = 12
    Character.Resistance = 11
    Character.Agility = 15
    Character.Luck = 9

    Call Check(Characters.DefineCharacter(State, Character))

    Character.Id = CHARACTER_COMPANION
    Character.Name = "Nia"
    Character.StartingLevel = 3
    Character.StartingMaximumHealth = 105

    Call Check(Characters.DefineCharacter(State, Character))

End Sub

Sub DefineItems()

    Item.Id = ITEM_VAULT_KEY
    Item.Name = "Prism Key"
    Item.Kind = RPG.RPG_ITEM_KEY_ITEM
    Item.MaximumStack = 1
    Item.BasePrice = 0
    Item.CanSell = False
    Item.EffectId = 0
    Item.EquipmentSlotId = 0

    Call Check(Inventory.DefineItem(State, Item))

    Item.Id = ITEM_SUN_TONIC
    Item.Name = "Sun Tonic"
    Item.Kind = RPG.RPG_ITEM_CONSUMABLE
    Item.MaximumStack = 9
    Item.BasePrice = 40
    Item.CanSell = True
    Item.EffectId = 1

    Call Check(Inventory.DefineItem(State, Item))

End Sub

Sub DefineStory()

    Dim FlagId As Number

    For FlagId = FLAG_FP_DOOR To FLAG_TOP_NPC
        Call Check(Story.DefineFlag(State, FlagId))
    End For

    Call Check(Story.DefineValue(State, VALUE_REPEAT_TRAPS))

End Sub

Sub DefineWorld()

    Call DefineScene(1, 101)
    Call DefineScene(2, 102)
    Call DefineScene(3, 103)
    Call DefineScene(11, 201)
    Call DefineScene(12, 202)
    Call DefineScene(13, 203)
    Call DefineScene(14, 204)
    Call DefineSpawn(101, 1, 1, 7, World.WORLD_FACING_RIGHT)
    Call DefineSpawn(102, 2, 1, 7, World.WORLD_FACING_RIGHT)
    Call DefineSpawn(103, 3, 1, 7, World.WORLD_FACING_RIGHT)
    Call DefineSpawn(201, 11, 2, 8, World.WORLD_FACING_RIGHT)
    Call DefineSpawn(202, 12, 10, 8, World.WORLD_FACING_LEFT)
    Call DefineSpawn(203, 13, 2, 2, World.WORLD_FACING_RIGHT)
    Call DefineSpawn(204, 14, 10, 8, World.WORLD_FACING_LEFT)
    Call DefineTransition(1, 11, 101, 12, 202)
    Call DefineActor(ACTOR_FP_DOOR, 1, 2, 4, True, True, True, 1)
    Call DefineActor(ACTOR_FP_LOCKED_DOOR, 2, 6, 4, True, True, True, 2)
    Call DefineActor(ACTOR_FP_CHEST_GOLD, 1, 6, 2, True, True, True, 3)
    Call DefineActor(ACTOR_FP_CHEST_KEY, 2, 2, 2, True, True, True, 4)
    Call DefineActor(ACTOR_FP_HIDDEN, 3, 4, 2, True, True, True, 5)
    Call DefineActor(ACTOR_TOP_DOOR, 11, 6, 8, True, True, True, 1)
    Call DefineActor(ACTOR_TOP_LOCKED_DOOR, 12, 6, 3, True, True, True, 2)
    Call DefineActor(ACTOR_TOP_CHEST_ITEM, 13, 10, 2, True, True, True, 7)
    Call DefineActor(ACTOR_TOP_CHEST_GOLD, 14, 3, 3, True, True, True, 3)
    Call DefineActor(ACTOR_TOP_HIDDEN, 13, 6, 4, True, True, True, 5)
    Call DefineActor(ACTOR_HERO, 1, 1, 7, True, True, True, 0)

End Sub

Sub DefineEncounters()

    Zone.Id = 1
    Zone.SceneId = 11
    Zone.RegionId = 121
    Zone.StepsRequired = 2
    Zone.InitialSeed = 31

    Call Check(Encounters.DefineZone(State, Zone))
    Call Check(Encounters.AddEntry(State, 1, 500, 1))

End Sub

Sub DefineScene(Id As Number, DefaultSpawnId As Number)

    Scene.Id = Id
    Scene.MapId = Id
    Scene.DefaultSpawnId = DefaultSpawnId
    Scene.CameraMode = World.WORLD_CAMERA_FOLLOW

    Call Check(World.DefineScene(State, Scene))

End Sub

Sub DefineSpawn(Id As Number, SceneId As Number, X As Number, Y As Number, Facing As Number)

    Spawn.Id = Id
    Spawn.SceneId = SceneId
    Spawn.CellX = X
    Spawn.CellY = Y
    Spawn.Facing = Facing

    Call Check(World.DefineSpawn(State, Spawn))

End Sub

Sub DefineTransition(Id As Number, SourceScene As Number, Region As Number, DestinationScene As Number, DestinationSpawn As Number)

    Transition.Id = Id
    Transition.SourceSceneId = SourceScene
    Transition.SourceRegionId = Region
    Transition.DestinationSceneId = DestinationScene
    Transition.DestinationSpawnId = DestinationSpawn

    Call Check(World.DefineTransition(State, Transition))

End Sub

Sub DefineActor(Id As Number, SceneId As Number, X As Number, Y As Number, Visible As Boolean, Solid As Boolean, Persistent As Boolean, InteractionId As Number)

    Actor.Id = Id
    Actor.SceneId = SceneId
    Actor.CellX = X
    Actor.CellY = Y
    Actor.Facing = World.WORLD_FACING_DOWN
    Actor.Visible = Visible
    Actor.Solid = Solid
    Actor.Persistent = Persistent
    Actor.AnimationSetId = 0
    Actor.InteractionId = InteractionId

    Call Check(World.DefineActor(State, Actor))

End Sub
