Option Explicit

Dim First[3]
Dim Second[3]
Dim Loaded[3]
Dim LoadedCount As Number

First[0] = 1
First[1] = 2
First[2] = 3

Second[0] = 7
Second[1] = 8
Second[2] = 9

Save Data First Count 3 To "Slot/A"
Save Data Second Count 3 To "Slot?A"

Load Data "Slot/A" Into Loaded Count LoadedCount
Print LoadedCount
Print Loaded[0]
Print Loaded[1]
Print Loaded[2]

Load Data "Slot?A" Into Loaded Count LoadedCount
Print LoadedCount
Print Loaded[0]
Print Loaded[1]
Print Loaded[2]

End Program
