OPTION EXPLICIT

DIM First[3]
DIM Second[3]
DIM Loaded[3]
DIM LoadedCount AS NUMBER

First[0] = 1
First[1] = 2
First[2] = 3

Second[0] = 7
Second[1] = 8
Second[2] = 9

SAVE DATA First COUNT 3 TO "Slot/A"
SAVE DATA Second COUNT 3 TO "Slot?A"

LOAD DATA "Slot/A" INTO Loaded COUNT LoadedCount
PRINT LoadedCount
PRINT Loaded[0]
PRINT Loaded[1]
PRINT Loaded[2]

LOAD DATA "Slot?A" INTO Loaded COUNT LoadedCount
PRINT LoadedCount
PRINT Loaded[0]
PRINT Loaded[1]
PRINT Loaded[2]

END PROGRAM
