Option Explicit

Game Window "Phase 4.1 Image Ownership" Size 320 By 180

Type MediaBox
    Picture As Image
End Type

Type NestedBox
    Media As MediaBox
End Type

Dim Shared As Image
Dim Copy As Image
Dim Box As MediaBox
Dim Nested As NestedBox

Load Image Shared From "Assets\PixelProof.png"

Copy = GetImage()
Print Image_Width(GetImage())
Print Image_Height(GetImage())
Print Image_Loaded(GetImage())

Call UseImage(GetImage())

Box = GetBox()
Nested = GetNested()

Draw Image GetImage() At 0, 0 Size 74 By 106 Filter Pixel
Show Screen

End Program

Function GetImage() As Image

    Return Shared

End Function

Sub UseImage(Value As Image)

    Print Image_Width(Value)

End Sub

Function GetBox() As MediaBox

    Dim Result As MediaBox

    Result.Picture = Shared
    Return Result

End Function

Function GetNested() As NestedBox

    Dim Result As NestedBox

    Result.Media.Picture = Shared
    Return Result

End Function
