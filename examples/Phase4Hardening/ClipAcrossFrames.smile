Option Explicit

Game Window "Phase 4.1 Clip Frames" Size 320 By 180

Dim Frame As Number

Clip Rectangle 20, 20, 200, 120
    For Frame = 0 To 2
        Clear Rgb(8, 12, 24)
        Fill Rectangle 0, 0, 320, 180, BLUE
        Draw Text "Clipped Frame" At 30, 30 Size 20 Color WHITE
        Show Screen
    End For
End Clip

End Program
