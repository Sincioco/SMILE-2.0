MODULE Smile.UI.Dialogue

OPTION EXPLICIT

IMPORT Smile.UI.Core AS Core
IMPORT Smile.UI.Window AS Window
IMPORT Smile.UI.Text AS Text

PRIVATE DIM DialogueUsed[8] AS BOOLEAN
PRIVATE DIM DialogueGeneration[8] AS NUMBER
PRIVATE DIM DialogueStyles[8] AS Core.DialogueStyle
PRIVATE DIM DialogueX[8] AS NUMBER
PRIVATE DIM DialogueY[8] AS NUMBER
PRIVATE DIM DialogueWidth[8] AS NUMBER
PRIVATE DIM DialogueHeight[8] AS NUMBER
PRIVATE DIM RawPageCount[8] AS NUMBER
PRIVATE DIM RawPages[8, 32] AS TEXT
PRIVATE DIM PreparedPageCount[8] AS NUMBER
PRIVATE DIM PreparedRawPage[8, 32] AS NUMBER
PRIVATE DIM PreparedStart[8, 32] AS NUMBER
PRIVATE DIM CurrentLines[8, 16] AS TEXT
PRIVATE DIM CurrentLineCount[8] AS NUMBER
PRIVATE DIM CurrentScalarCount[8] AS NUMBER
PRIVATE DIM DialogueCurrentPage[8] AS NUMBER
PRIVATE DIM DialogueVisible[8] AS NUMBER
PRIVATE DIM DialogueStartedAt[8] AS NUMBER
PRIVATE DIM DialogueActive[8] AS BOOLEAN
PRIVATE DIM DialogueComplete[8] AS BOOLEAN
PRIVATE DIM ScratchPreparedRawPage[32] AS NUMBER
PRIVATE DIM ScratchPreparedStart[32] AS NUMBER
PRIVATE DIM ScratchPreparedPageCount AS NUMBER

PRIVATE FUNCTION SlotFromHandle(Handle AS NUMBER) AS NUMBER
    DIM Slot AS NUMBER
    DIM Generation AS NUMBER
    IF Handle <= 0 THEN
        RETURN -1
    END IF
    Slot = (Handle MOD 100) - 1
    Generation = Handle / 100
    IF Slot < 0 OR Slot >= Core.UI_MAX_DIALOGUES THEN
        RETURN -1
    END IF
    IF NOT DialogueUsed[Slot] OR DialogueGeneration[Slot] <> Generation THEN
        RETURN -1
    END IF
    RETURN Slot
END FUNCTION

PUBLIC FUNCTION IsStyleValid(BYREF Style AS Core.DialogueStyle) AS BOOLEAN
    IF NOT Window.IsStyleValid(Style.Window) OR NOT Text.IsStyleValid(Style.Text) THEN
        RETURN FALSE
    END IF
    IF Style.CharactersPerSecond < 0 OR Style.CharactersPerSecond > Core.UI_MAX_LAYOUT_VALUE OR Style.LineSpacing < 0 OR Style.LineSpacing > Core.UI_MAX_LAYOUT_VALUE THEN
        RETURN FALSE
    END IF
    IF Style.IndicatorWidth < 0 OR Style.IndicatorWidth > Core.UI_MAX_LAYOUT_VALUE OR Style.IndicatorHeight < 0 OR Style.IndicatorHeight > Core.UI_MAX_LAYOUT_VALUE OR Style.IndicatorBlinkMilliseconds < 0 OR Style.IndicatorBlinkMilliseconds > Core.UI_MAX_LAYOUT_VALUE THEN
        RETURN FALSE
    END IF
    IF Style.IndicatorOffsetX < -Core.UI_MAX_LAYOUT_VALUE OR Style.IndicatorOffsetX > Core.UI_MAX_LAYOUT_VALUE OR Style.IndicatorOffsetY < -Core.UI_MAX_LAYOUT_VALUE OR Style.IndicatorOffsetY > Core.UI_MAX_LAYOUT_VALUE THEN
        RETURN FALSE
    END IF
    IF Style.UseContinueIndicator AND IMAGE_LOADED(Style.ContinueIndicator) AND (Style.IndicatorWidth <= 0 OR Style.IndicatorHeight <= 0) THEN
        RETURN FALSE
    END IF
    RETURN TRUE
END FUNCTION

PRIVATE FUNCTION LineStep(BYREF Style AS Core.DialogueStyle) AS NUMBER
    DIM Height AS NUMBER
    Height = Text.MeasureHeight(Style.Text, "")
    IF Height <= 0 THEN
        Height = MAX(1, Style.Text.SystemSize)
    END IF
    RETURN Height + MAX(0, Style.Text.LineSpacing) + MAX(0, Style.LineSpacing)
END FUNCTION

PRIVATE FUNCTION MaximumLines(Slot AS NUMBER, BYREF Style AS Core.DialogueStyle) AS NUMBER
    DIM Content AS Core.Rect
    DIM StepHeight AS NUMBER
    DIM Spacing AS NUMBER
    Content = Window.ContentRect(Style.Window, DialogueX[Slot], DialogueY[Slot], DialogueWidth[Slot], DialogueHeight[Slot])
    StepHeight = LineStep(Style)
    Spacing = MAX(0, Style.Text.LineSpacing) + MAX(0, Style.LineSpacing)
    IF Content.Width <= 0 OR Content.Height <= 0 OR StepHeight <= 0 THEN
        RETURN 0
    END IF
    RETURN MIN(Core.UI_MAX_DIALOGUE_LINES, MAX(1, (Content.Height + Spacing) / StepHeight))
END FUNCTION

PRIVATE SUB ClearCurrentLines(Slot AS NUMBER)
    DIM Line AS NUMBER
    FOR Line = 0 TO Core.UI_MAX_DIALOGUE_LINES - 1
        CurrentLines[Slot, Line] = ""
    END FOR
    CurrentLineCount[Slot] = 0
    CurrentScalarCount[Slot] = 0
END SUB

PRIVATE FUNCTION PrepareRawPage(Slot AS NUMBER, BYREF Style AS Core.DialogueStyle, RawIndex AS NUMBER, StartIndex AS NUMBER, StoreLines AS BOOLEAN) AS NUMBER
    DIM Value AS TEXT
    DIM Length AS NUMBER
    DIM Content AS Core.Rect
    DIM Maximum AS NUMBER
    DIM Cursor AS NUMBER
    DIM LineStart AS NUMBER
    DIM LineNumber AS NUMBER
    DIM Scan AS NUMBER
    DIM SkipIndex AS NUMBER
    DIM LastSpace AS NUMBER
    DIM FitEnd AS NUMBER
    DIM LineEnd AS NUMBER
    DIM Candidate AS TEXT
    DIM LineValue AS TEXT
    DIM SegmentEnd AS NUMBER
    DIM Low AS NUMBER
    DIM High AS NUMBER
    DIM Middle AS NUMBER
    DIM BestCount AS NUMBER
    DIM HasNewline AS BOOLEAN

    Value = RawPages[Slot, RawIndex]
    Length = TEXT_LENGTH(Value)
    Content = Window.ContentRect(Style.Window, DialogueX[Slot], DialogueY[Slot], DialogueWidth[Slot], DialogueHeight[Slot])
    Maximum = MaximumLines(Slot, Style)
    IF StoreLines THEN
        CALL ClearCurrentLines(Slot)
    END IF
    IF Maximum <= 0 OR Content.Width <= 0 THEN
        RETURN StartIndex
    END IF

    IF Length = 0 OR StartIndex = Length THEN
        IF StoreLines THEN
            CurrentLines[Slot, 0] = ""
            CurrentLineCount[Slot] = 1
            CurrentScalarCount[Slot] = 0
        END IF
        RETURN Length + 1
    END IF

    Cursor = StartIndex
    FOR LineNumber = 0 TO Maximum - 1
        IF Cursor > Length THEN
            RETURN Length + 1
        END IF
        IF Cursor = Length THEN
            IF StoreLines THEN
                CurrentLines[Slot, LineNumber] = ""
                CurrentLineCount[Slot] = LineNumber + 1
            END IF
            RETURN Length + 1
        END IF

        LineStart = Cursor
        SegmentEnd = Length
        HasNewline = FALSE
        FOR Scan = LineStart TO Length - 1
            IF TEXT_CODE_AT(Value, Scan) = 10 THEN
                SegmentEnd = Scan
                HasNewline = TRUE
                EXIT FOR
            END IF
        END FOR

        IF SegmentEnd = LineStart THEN
            LineEnd = LineStart
            Cursor = SegmentEnd + 1
        ELSE
            Low = 1
            High = SegmentEnd - LineStart
            BestCount = 1
            FOR Scan = 0 TO 31
                IF Low > High THEN
                    EXIT FOR
                END IF
                Middle = Low + (High - Low) / 2
                Candidate = TEXT_SLICE(Value, LineStart, Middle)
                IF Text.MeasureWidth(Style.Text, Candidate) <= Content.Width OR Middle = 1 THEN
                    BestCount = Middle
                    Low = Middle + 1
                ELSE
                    High = Middle - 1
                END IF
            END FOR
            FitEnd = LineStart + BestCount
            LineEnd = FitEnd
            IF FitEnd < SegmentEnd THEN
                LastSpace = -1
                FOR Scan = LineStart TO FitEnd - 1
                    IF TEXT_CODE_AT(Value, Scan) = 32 THEN
                        LastSpace = Scan
                    END IF
                END FOR
                IF LastSpace > LineStart THEN
                    LineEnd = LastSpace
                    Cursor = LastSpace + 1
                    FOR SkipIndex = Cursor TO SegmentEnd - 1
                        IF TEXT_CODE_AT(Value, SkipIndex) <> 32 THEN
                            EXIT FOR
                        END IF
                        Cursor = Cursor + 1
                    END FOR
                ELSE
                    Cursor = FitEnd
                END IF
            ELSE IF HasNewline THEN
                Cursor = SegmentEnd + 1
            ELSE
                Cursor = Length + 1
            END IF
        END IF

        LineValue = TEXT_SLICE(Value, LineStart, MAX(0, LineEnd - LineStart))
        IF StoreLines THEN
            CurrentLines[Slot, LineNumber] = LineValue
            CurrentLineCount[Slot] = LineNumber + 1
            CurrentScalarCount[Slot] = CurrentScalarCount[Slot] + TEXT_LENGTH(LineValue)
        END IF

        IF Cursor > Length THEN
            RETURN Length + 1
        END IF
    END FOR
    RETURN Cursor
END FUNCTION

PRIVATE SUB ClearPrepared(Slot AS NUMBER)
    DIM Page AS NUMBER
    FOR Page = 0 TO Core.UI_MAX_DIALOGUE_PAGES - 1
        PreparedRawPage[Slot, Page] = 0
        PreparedStart[Slot, Page] = 0
    END FOR
    PreparedPageCount[Slot] = 0
    DialogueCurrentPage[Slot] = 0
    DialogueVisible[Slot] = 0
    DialogueStartedAt[Slot] = 0
    DialogueActive[Slot] = FALSE
    DialogueComplete[Slot] = FALSE
    CALL ClearCurrentLines(Slot)
END SUB

PRIVATE SUB ClearScratch()
    DIM Page AS NUMBER
    FOR Page = 0 TO Core.UI_MAX_DIALOGUE_PAGES - 1
        ScratchPreparedRawPage[Page] = 0
        ScratchPreparedStart[Page] = 0
    END FOR
    ScratchPreparedPageCount = 0
END SUB

PRIVATE FUNCTION BuildScratch(Slot AS NUMBER, BYREF Style AS Core.DialogueStyle) AS BOOLEAN
    DIM RawIndex AS NUMBER
    DIM Spill AS NUMBER
    DIM Cursor AS NUMBER
    DIM NextIndex AS NUMBER
    DIM Length AS NUMBER
    DIM Finished AS BOOLEAN
    CALL ClearScratch()
    IF MaximumLines(Slot, Style) <= 0 THEN
        RETURN FALSE
    END IF
    FOR RawIndex = 0 TO RawPageCount[Slot] - 1
        Cursor = 0
        Length = TEXT_LENGTH(RawPages[Slot, RawIndex])
        Finished = FALSE
        FOR Spill = 0 TO Core.UI_MAX_DIALOGUE_PAGES
            IF Cursor > Length THEN
                Finished = TRUE
                EXIT FOR
            END IF
            IF ScratchPreparedPageCount >= Core.UI_MAX_DIALOGUE_PAGES THEN
                CALL ClearScratch()
                RETURN FALSE
            END IF
            ScratchPreparedRawPage[ScratchPreparedPageCount] = RawIndex
            ScratchPreparedStart[ScratchPreparedPageCount] = Cursor
            ScratchPreparedPageCount = ScratchPreparedPageCount + 1
            NextIndex = PrepareRawPage(Slot, Style, RawIndex, Cursor, FALSE)
            IF NextIndex <= Cursor THEN
                CALL ClearScratch()
                RETURN FALSE
            END IF
            Cursor = NextIndex
        END FOR
        IF NOT Finished THEN
            CALL ClearScratch()
            RETURN FALSE
        END IF
    END FOR
    RETURN ScratchPreparedPageCount > 0
END FUNCTION

PRIVATE SUB CommitScratch(Slot AS NUMBER)
    DIM Page AS NUMBER
    FOR Page = 0 TO Core.UI_MAX_DIALOGUE_PAGES - 1
        PreparedRawPage[Slot, Page] = 0
        PreparedStart[Slot, Page] = 0
    END FOR
    FOR Page = 0 TO ScratchPreparedPageCount - 1
        PreparedRawPage[Slot, Page] = ScratchPreparedRawPage[Page]
        PreparedStart[Slot, Page] = ScratchPreparedStart[Page]
    END FOR
    PreparedPageCount[Slot] = ScratchPreparedPageCount
    CALL ClearScratch()
END SUB

PRIVATE SUB PrepareCurrentPage(Slot AS NUMBER)
    DIM NextIndex AS NUMBER
    IF DialogueCurrentPage[Slot] < 0 OR DialogueCurrentPage[Slot] >= PreparedPageCount[Slot] THEN
        CALL ClearCurrentLines(Slot)
        RETURN
    END IF
    NextIndex = PrepareRawPage(Slot, DialogueStyles[Slot], PreparedRawPage[Slot, DialogueCurrentPage[Slot]], PreparedStart[Slot, DialogueCurrentPage[Slot]], TRUE)
END SUB

PUBLIC FUNCTION Create(BYREF Style AS Core.DialogueStyle, X AS NUMBER, Y AS NUMBER, Width AS NUMBER, Height AS NUMBER) AS NUMBER
    DIM Slot AS NUMBER
    DIM Index AS NUMBER
    IF NOT IsStyleValid(Style) THEN
        RETURN 0
    END IF
    Slot = -1
    FOR Index = 0 TO Core.UI_MAX_DIALOGUES - 1
        IF NOT DialogueUsed[Index] THEN
            Slot = Index
            EXIT FOR
        END IF
    END FOR
    IF Slot < 0 THEN
        RETURN 0
    END IF
    DialogueGeneration[Slot] = DialogueGeneration[Slot] + 1
    IF DialogueGeneration[Slot] <= 0 THEN
        DialogueGeneration[Slot] = 1
    END IF
    DialogueUsed[Slot] = TRUE
    DialogueStyles[Slot] = Style
    DialogueX[Slot] = X
    DialogueY[Slot] = Y
    DialogueWidth[Slot] = MAX(0, MIN(Core.UI_MAX_LAYOUT_VALUE, Width))
    DialogueHeight[Slot] = MAX(0, MIN(Core.UI_MAX_LAYOUT_VALUE, Height))
    RawPageCount[Slot] = 0
    CALL ClearPrepared(Slot)
    RETURN DialogueGeneration[Slot] * 100 + Slot + 1
END FUNCTION

PUBLIC FUNCTION IsValid(Handle AS NUMBER) AS BOOLEAN
    RETURN SlotFromHandle(Handle) >= 0
END FUNCTION

PUBLIC SUB ClearPages(Handle AS NUMBER)
    DIM Slot AS NUMBER
    DIM Page AS NUMBER
    Slot = SlotFromHandle(Handle)
    IF Slot < 0 THEN
        RETURN
    END IF
    FOR Page = 0 TO Core.UI_MAX_DIALOGUE_PAGES - 1
        RawPages[Slot, Page] = ""
    END FOR
    RawPageCount[Slot] = 0
    CALL ClearPrepared(Slot)
END SUB

PUBLIC SUB Destroy(Handle AS NUMBER)
    DIM Slot AS NUMBER
    DIM Empty AS Core.DialogueStyle
    Slot = SlotFromHandle(Handle)
    IF Slot < 0 THEN
        RETURN
    END IF
    CALL ClearPages(Handle)
    DialogueStyles[Slot] = Empty
    DialogueUsed[Slot] = FALSE
END SUB

PUBLIC FUNCTION SetStyle(Handle AS NUMBER, BYREF Style AS Core.DialogueStyle) AS BOOLEAN
    DIM Slot AS NUMBER
    DIM OldRawPage AS NUMBER
    DIM OldStart AS NUMBER
    DIM OldVisible AS NUMBER
    DIM Page AS NUMBER
    DIM NewPage AS NUMBER
    Slot = SlotFromHandle(Handle)
    IF Slot < 0 OR NOT IsStyleValid(Style) THEN
        RETURN FALSE
    END IF
    IF NOT DialogueActive[Slot] OR PreparedPageCount[Slot] <= 0 THEN
        DialogueStyles[Slot] = Style
        CALL ClearPrepared(Slot)
        RETURN TRUE
    END IF
    OldRawPage = PreparedRawPage[Slot, DialogueCurrentPage[Slot]]
    OldStart = PreparedStart[Slot, DialogueCurrentPage[Slot]]
    OldVisible = DialogueVisible[Slot]
    IF NOT BuildScratch(Slot, Style) THEN
        RETURN FALSE
    END IF
    NewPage = -1
    FOR Page = 0 TO ScratchPreparedPageCount - 1
        IF ScratchPreparedRawPage[Page] = OldRawPage AND ScratchPreparedStart[Page] <= OldStart THEN
            NewPage = Page
        END IF
    END FOR
    IF NewPage < 0 THEN
        CALL ClearScratch()
        RETURN FALSE
    END IF
    DialogueStyles[Slot] = Style
    CALL CommitScratch(Slot)
    DialogueCurrentPage[Slot] = NewPage
    DialogueActive[Slot] = TRUE
    DialogueComplete[Slot] = FALSE
    CALL PrepareCurrentPage(Slot)
    DialogueVisible[Slot] = MIN(OldVisible, CurrentScalarCount[Slot])
    DialogueStartedAt[Slot] = TIMER()
    IF DialogueStyles[Slot].CharactersPerSecond > 0 THEN
        DialogueStartedAt[Slot] = DialogueStartedAt[Slot] - DialogueVisible[Slot] * 1000 / DialogueStyles[Slot].CharactersPerSecond
    END IF
    RETURN TRUE
END FUNCTION

PUBLIC FUNCTION AddPage(Handle AS NUMBER, Value AS TEXT) AS BOOLEAN
    DIM Slot AS NUMBER
    DIM Index AS NUMBER
    Slot = SlotFromHandle(Handle)
    IF Slot < 0 OR RawPageCount[Slot] >= Core.UI_MAX_DIALOGUE_PAGES OR TEXT_LENGTH(Value) > Core.UI_MAX_DIALOGUE_PAGE_SCALARS THEN
        RETURN FALSE
    END IF
    Index = RawPageCount[Slot]
    RawPages[Slot, Index] = Value
    RawPageCount[Slot] = Index + 1
    RETURN TRUE
END FUNCTION

PUBLIC FUNCTION Start(Handle AS NUMBER, NowMilliseconds AS NUMBER) AS BOOLEAN
    DIM Slot AS NUMBER
    Slot = SlotFromHandle(Handle)
    IF Slot < 0 OR RawPageCount[Slot] <= 0 THEN
        RETURN FALSE
    END IF
    IF NOT BuildScratch(Slot, DialogueStyles[Slot]) THEN
        RETURN FALSE
    END IF
    CALL CommitScratch(Slot)
    DialogueCurrentPage[Slot] = 0
    DialogueStartedAt[Slot] = NowMilliseconds
    DialogueVisible[Slot] = 0
    DialogueActive[Slot] = TRUE
    DialogueComplete[Slot] = FALSE
    CALL PrepareCurrentPage(Slot)
    IF DialogueStyles[Slot].CharactersPerSecond <= 0 THEN
        DialogueVisible[Slot] = CurrentScalarCount[Slot]
    END IF
    RETURN TRUE
END FUNCTION

PUBLIC FUNCTION Update(Handle AS NUMBER, NowMilliseconds AS NUMBER) AS NUMBER
    DIM Slot AS NUMBER
    DIM Previous AS NUMBER
    DIM Elapsed AS NUMBER
    DIM Target AS NUMBER
    Slot = SlotFromHandle(Handle)
    IF Slot < 0 OR NOT DialogueActive[Slot] THEN
        RETURN Core.UI_EVENT_NONE
    END IF
    Previous = DialogueVisible[Slot]
    IF DialogueStyles[Slot].CharactersPerSecond <= 0 THEN
        DialogueVisible[Slot] = CurrentScalarCount[Slot]
    ELSE
        Elapsed = MAX(0, NowMilliseconds - DialogueStartedAt[Slot])
        Target = Elapsed * DialogueStyles[Slot].CharactersPerSecond / 1000
        DialogueVisible[Slot] = MIN(CurrentScalarCount[Slot], MAX(DialogueVisible[Slot], Target))
    END IF
    IF DialogueVisible[Slot] <> Previous THEN
        RETURN Core.UI_EVENT_CHANGED
    END IF
    RETURN Core.UI_EVENT_NONE
END FUNCTION

PUBLIC FUNCTION HandleKey(Handle AS NUMBER, Key AS NUMBER, NowMilliseconds AS NUMBER) AS NUMBER
    DIM Slot AS NUMBER
    DIM UpdateEvent AS NUMBER
    Slot = SlotFromHandle(Handle)
    IF Slot < 0 OR NOT DialogueActive[Slot] THEN
        RETURN Core.UI_EVENT_NONE
    END IF
    IF Key = KEY_ESCAPE THEN
        DialogueActive[Slot] = FALSE
        DialogueComplete[Slot] = FALSE
        RETURN Core.UI_EVENT_CANCELLED
    END IF
    IF Key <> KEY_ENTER AND Key <> KEY_SPACE THEN
        RETURN Core.UI_EVENT_NONE
    END IF

    UpdateEvent = Update(Handle, NowMilliseconds)
    IF DialogueVisible[Slot] < CurrentScalarCount[Slot] THEN
        DialogueVisible[Slot] = CurrentScalarCount[Slot]
        RETURN Core.UI_EVENT_CHANGED
    END IF
    IF DialogueCurrentPage[Slot] + 1 < PreparedPageCount[Slot] THEN
        DialogueCurrentPage[Slot] = DialogueCurrentPage[Slot] + 1
        DialogueStartedAt[Slot] = NowMilliseconds
        DialogueVisible[Slot] = 0
        CALL PrepareCurrentPage(Slot)
        IF DialogueStyles[Slot].CharactersPerSecond <= 0 THEN
            DialogueVisible[Slot] = CurrentScalarCount[Slot]
        END IF
        RETURN Core.UI_EVENT_ADVANCED
    END IF
    DialogueActive[Slot] = FALSE
    DialogueComplete[Slot] = TRUE
    RETURN Core.UI_EVENT_COMPLETED
END FUNCTION

PUBLIC SUB Draw(Handle AS NUMBER, NowMilliseconds AS NUMBER)
    DIM Slot AS NUMBER
    DIM Content AS Core.Rect
    DIM Line AS NUMBER
    DIM Remaining AS NUMBER
    DIM Length AS NUMBER
    DIM VisibleOnLine AS NUMBER
    DIM LineY AS NUMBER
    DIM StepHeight AS NUMBER
    DIM IndicatorX AS NUMBER
    DIM IndicatorY AS NUMBER
    DIM BlinkOn AS BOOLEAN
    DIM UpdateEvent AS NUMBER
    Slot = SlotFromHandle(Handle)
    IF Slot < 0 OR NOT DialogueActive[Slot] OR DialogueWidth[Slot] <= 0 OR DialogueHeight[Slot] <= 0 THEN
        RETURN
    END IF
    UpdateEvent = Update(Handle, NowMilliseconds)
    CALL Window.Draw(DialogueStyles[Slot].Window, DialogueX[Slot], DialogueY[Slot], DialogueWidth[Slot], DialogueHeight[Slot])
    Content = Window.ContentRect(DialogueStyles[Slot].Window, DialogueX[Slot], DialogueY[Slot], DialogueWidth[Slot], DialogueHeight[Slot])
    IF Content.Width <= 0 OR Content.Height <= 0 THEN
        RETURN
    END IF
    Remaining = DialogueVisible[Slot]
    StepHeight = LineStep(DialogueStyles[Slot])
    CLIP RECTANGLE Content.X, Content.Y, Content.Width, Content.Height
        FOR Line = 0 TO CurrentLineCount[Slot] - 1
            Length = TEXT_LENGTH(CurrentLines[Slot, Line])
            VisibleOnLine = MIN(Length, MAX(0, Remaining))
            LineY = Content.Y + Line * StepHeight
            IF VisibleOnLine > 0 THEN
                CALL Text.Draw(DialogueStyles[Slot].Text, TEXT_SLICE(CurrentLines[Slot, Line], 0, VisibleOnLine), Content.X, LineY, Core.UI_ALIGN_LEFT, 100)
            END IF
            Remaining = MAX(0, Remaining - Length)
        END FOR

        IF DialogueVisible[Slot] >= CurrentScalarCount[Slot] AND DialogueStyles[Slot].UseContinueIndicator AND IMAGE_LOADED(DialogueStyles[Slot].ContinueIndicator) AND DialogueStyles[Slot].IndicatorWidth > 0 AND DialogueStyles[Slot].IndicatorHeight > 0 THEN
            BlinkOn = TRUE
            IF DialogueStyles[Slot].IndicatorBlinkMilliseconds > 0 THEN
                BlinkOn = ((NowMilliseconds / DialogueStyles[Slot].IndicatorBlinkMilliseconds) MOD 2) = 0
            END IF
            IF BlinkOn THEN
                IndicatorX = Content.X + Content.Width - DialogueStyles[Slot].IndicatorWidth + DialogueStyles[Slot].IndicatorOffsetX
                IndicatorY = Content.Y + Content.Height - DialogueStyles[Slot].IndicatorHeight + DialogueStyles[Slot].IndicatorOffsetY
                DRAW IMAGE DialogueStyles[Slot].ContinueIndicator AT IndicatorX, IndicatorY SIZE DialogueStyles[Slot].IndicatorWidth BY DialogueStyles[Slot].IndicatorHeight FILTER SMOOTH
            END IF
        END IF
    END CLIP
END SUB

PUBLIC FUNCTION IsActive(Handle AS NUMBER) AS BOOLEAN
    DIM Slot AS NUMBER
    Slot = SlotFromHandle(Handle)
    IF Slot < 0 THEN
        RETURN FALSE
    END IF
    RETURN DialogueActive[Slot]
END FUNCTION

PUBLIC FUNCTION IsComplete(Handle AS NUMBER) AS BOOLEAN
    DIM Slot AS NUMBER
    Slot = SlotFromHandle(Handle)
    IF Slot < 0 THEN
        RETURN FALSE
    END IF
    RETURN DialogueComplete[Slot]
END FUNCTION

PUBLIC FUNCTION PageCount(Handle AS NUMBER) AS NUMBER
    DIM Slot AS NUMBER
    Slot = SlotFromHandle(Handle)
    IF Slot < 0 THEN
        RETURN 0
    END IF
    IF PreparedPageCount[Slot] > 0 THEN
        RETURN PreparedPageCount[Slot]
    END IF
    RETURN RawPageCount[Slot]
END FUNCTION

PUBLIC FUNCTION CurrentPage(Handle AS NUMBER) AS NUMBER
    DIM Slot AS NUMBER
    Slot = SlotFromHandle(Handle)
    IF Slot < 0 THEN
        RETURN -1
    END IF
    RETURN DialogueCurrentPage[Slot]
END FUNCTION

PUBLIC FUNCTION VisibleCharacters(Handle AS NUMBER) AS NUMBER
    DIM Slot AS NUMBER
    Slot = SlotFromHandle(Handle)
    IF Slot < 0 THEN
        RETURN 0
    END IF
    RETURN DialogueVisible[Slot]
END FUNCTION

END MODULE
