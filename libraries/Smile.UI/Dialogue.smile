Module Smile.UI.Dialogue

Option Explicit

Import Smile.UI.Core As Core
Import Smile.UI.Window As Window
Import Smile.UI.Text As Text

Private Dim DialogueUsed[8] As Boolean
Private Dim DialogueGeneration[8] As Number
Private Dim DialogueStyles[8] As Core.DialogueStyle
Private Dim DialogueX[8] As Number
Private Dim DialogueY[8] As Number
Private Dim DialogueWidth[8] As Number
Private Dim DialogueHeight[8] As Number
Private Dim RawPageCount[8] As Number
Private Dim RawPages[8, 32] As Text
Private Dim PreparedPageCount[8] As Number
Private Dim PreparedRawPage[8, 32] As Number
Private Dim PreparedStart[8, 32] As Number
Private Dim CurrentLines[8, 16] As Text
Private Dim CurrentLineCount[8] As Number
Private Dim CurrentScalarCount[8] As Number
Private Dim DialogueCurrentPage[8] As Number
Private Dim DialogueVisible[8] As Number
Private Dim DialogueStartedAt[8] As Number
Private Dim DialogueActive[8] As Boolean
Private Dim DialogueComplete[8] As Boolean
Private Dim ScratchPreparedRawPage[32] As Number
Private Dim ScratchPreparedStart[32] As Number
Private Dim ScratchPreparedPageCount As Number

Private Function DialogueSlotFromHandle(Handle As Number) As Number

    Dim ReturnValue As Number
    Dim Slot As Number
    Dim Generation As Number

    If Handle <= 0 Then
        ReturnValue = -1
        Return ReturnValue
    End If

    Slot = (Handle Mod 100) - 1
    Generation = Handle / 100

    If Slot < 0 Or Slot >= Core.UI_MAX_DIALOGUES Then
        ReturnValue = -1
        Return ReturnValue
    End If

    If Not DialogueUsed[Slot] Or DialogueGeneration[Slot] <> Generation Then
        ReturnValue = -1
        Return ReturnValue
    End If

    Return Slot

End Function

Private Function DialogueHandleIsStyleValid(ByRef Style As Core.DialogueStyle) As Boolean

    If Not Window.IsStyleValid(Style.Window) Or Not Text.IsStyleValid(Style.Text) Then
        Return False
    End If

    If (Style.CharactersPerSecond < 0 Or
        Style.CharactersPerSecond > Core.UI_MAX_LAYOUT_VALUE Or
        Style.LineSpacing < 0 Or
        Style.LineSpacing > Core.UI_MAX_LAYOUT_VALUE) Then
        Return False
    End If

    If (Style.IndicatorWidth < 0 Or
        Style.IndicatorWidth > Core.UI_MAX_LAYOUT_VALUE Or
        Style.IndicatorHeight < 0 Or
        Style.IndicatorHeight > Core.UI_MAX_LAYOUT_VALUE Or
        Style.IndicatorBlinkMilliseconds < 0 Or
        Style.IndicatorBlinkMilliseconds > Core.UI_MAX_LAYOUT_VALUE) Then
        Return False
    End If

    If (Style.IndicatorOffsetX < -Core.UI_MAX_LAYOUT_VALUE Or
        Style.IndicatorOffsetX > Core.UI_MAX_LAYOUT_VALUE Or
        Style.IndicatorOffsetY < -Core.UI_MAX_LAYOUT_VALUE Or
        Style.IndicatorOffsetY > Core.UI_MAX_LAYOUT_VALUE) Then
        Return False
    End If

    If (Style.UseContinueIndicator And
        Image_Loaded(Style.ContinueIndicator) And
        (Style.IndicatorWidth <= 0 Or Style.IndicatorHeight <= 0)) Then
        Return False
    End If

    Return True

End Function

Private Function LineStep(ByRef Style As Core.DialogueStyle) As Number

    Dim ReturnValue As Number
    Dim Height As Number

    Height = Text.MeasureHeight(Style.Text, "")

    If Height <= 0 Then
        Height = Max(1, Style.Text.SystemSize)
    End If

    ReturnValue = Height + Max(0, Style.Text.LineSpacing) + Max(0, Style.LineSpacing)
    Return ReturnValue

End Function

Private Function MaximumLines(Slot As Number, ByRef Style As Core.DialogueStyle) As Number

    Dim ReturnValue As Number
    Dim Content As Core.Rect
    Dim StepHeight As Number
    Dim Spacing As Number

    Content = Window.ContentRect(Style.Window, DialogueX[Slot], DialogueY[Slot], DialogueWidth[Slot], DialogueHeight[Slot])
    StepHeight = LineStep(Style)
    Spacing = Max(0, Style.Text.LineSpacing) + Max(0, Style.LineSpacing)

    If (Content.Width <= 0 Or
        Content.Height <= 0 Or
        StepHeight <= 0) Then
        ReturnValue = 0
        Return ReturnValue
    End If

    ReturnValue = Min(Core.UI_MAX_DIALOGUE_LINES, Max(1, (Content.Height + Spacing) / StepHeight))
    Return ReturnValue

End Function

Private Sub ClearCurrentLines(Slot As Number)

    Dim Line As Number

    For Line = 0 To Core.UI_MAX_DIALOGUE_LINES - 1
        CurrentLines[Slot, Line] = ""
    End For
    CurrentLineCount[Slot] = 0
    CurrentScalarCount[Slot] = 0

End Sub

Private Function PrepareRawPage(Slot As Number, ByRef Style As Core.DialogueStyle, RawIndex As Number, StartIndex As Number, StoreLines As Boolean) As Number

    Dim ReturnValue As Number
    Dim Value As Text
    Dim Length As Number
    Dim Content As Core.Rect
    Dim Maximum As Number
    Dim Cursor As Number
    Dim LineStart As Number
    Dim LineNumber As Number
    Dim Scan As Number
    Dim SkipIndex As Number
    Dim LastSpace As Number
    Dim FitEnd As Number
    Dim LineEnd As Number
    Dim Candidate As Text
    Dim LineValue As Text
    Dim SegmentEnd As Number
    Dim Low As Number
    Dim High As Number
    Dim Middle As Number
    Dim BestCount As Number
    Dim HasNewline As Boolean

    Value = RawPages[Slot, RawIndex]
    Length = Text_Length(Value)
    Content = Window.ContentRect(Style.Window, DialogueX[Slot], DialogueY[Slot], DialogueWidth[Slot], DialogueHeight[Slot])
    Maximum = MaximumLines(Slot, Style)

    If StoreLines Then
        Call ClearCurrentLines(Slot)
    End If

    If Maximum <= 0 Or Content.Width <= 0 Then
        Return StartIndex
    End If

    If Length = 0 Or StartIndex = Length Then

        If StoreLines Then

            CurrentLines[Slot, 0] = ""
            CurrentLineCount[Slot] = 1
            CurrentScalarCount[Slot] = 0

        End If

        ReturnValue = Length + 1
        Return ReturnValue

    End If

    Cursor = StartIndex

    For LineNumber = 0 To Maximum - 1

        If Cursor > Length Then
            ReturnValue = Length + 1
            Return ReturnValue
        End If

        If Cursor = Length Then

            If StoreLines Then
                CurrentLines[Slot, LineNumber] = ""
                CurrentLineCount[Slot] = LineNumber + 1
            End If

            ReturnValue = Length + 1
            Return ReturnValue

        End If

        LineStart = Cursor
        SegmentEnd = Length
        HasNewline = False

        For Scan = LineStart To Length - 1

            If Text_Code_At(Value, Scan) = 10 Then

                SegmentEnd = Scan
                HasNewline = True
                Exit For

            End If

        End For

        If SegmentEnd = LineStart Then

            LineEnd = LineStart
            Cursor = SegmentEnd + 1

        Else

            Low = 1
            High = SegmentEnd - LineStart
            BestCount = 1

            For Scan = 0 To 31

                If Low > High Then
                    Exit For
                End If

                Middle = Low + (High - Low) / 2
                Candidate = Text_Slice(Value, LineStart, Middle)

                If Text.MeasureWidth(Style.Text, Candidate) <= Content.Width Or Middle = 1 Then
                    BestCount = Middle
                    Low = Middle + 1
                Else
                    High = Middle - 1
                End If

            End For
            FitEnd = LineStart + BestCount
            LineEnd = FitEnd

            If FitEnd < SegmentEnd Then

                LastSpace = -1

                For Scan = LineStart To FitEnd - 1

                    If Text_Code_At(Value, Scan) = 32 Then
                        LastSpace = Scan
                    End If

                End For

                If LastSpace > LineStart Then

                    LineEnd = LastSpace
                    Cursor = LastSpace + 1

                    For SkipIndex = Cursor To SegmentEnd - 1

                        If Text_Code_At(Value, SkipIndex) <> 32 Then
                            Exit For
                        End If

                        Cursor = Cursor + 1
                    End For

                Else

                    Cursor = FitEnd

                End If

            Else If HasNewline Then

                Cursor = SegmentEnd + 1

            Else

                Cursor = Length + 1

            End If

        End If

        LineValue = Text_Slice(Value, LineStart, Max(0, LineEnd - LineStart))

        If StoreLines Then

            CurrentLines[Slot, LineNumber] = LineValue
            CurrentLineCount[Slot] = LineNumber + 1
            CurrentScalarCount[Slot] = CurrentScalarCount[Slot] + Text_Length(LineValue)

        End If

        If Cursor > Length Then
            ReturnValue = Length + 1
            Return ReturnValue
        End If

    End For
    Return Cursor

End Function

Private Sub ClearPrepared(Slot As Number)

    Dim Page As Number

    For Page = 0 To Core.UI_MAX_DIALOGUE_PAGES - 1
        PreparedRawPage[Slot, Page] = 0
        PreparedStart[Slot, Page] = 0
    End For
    PreparedPageCount[Slot] = 0
    DialogueCurrentPage[Slot] = 0
    DialogueVisible[Slot] = 0
    DialogueStartedAt[Slot] = 0
    DialogueActive[Slot] = False
    DialogueComplete[Slot] = False

    Call ClearCurrentLines(Slot)

End Sub

Private Sub ClearScratch()

    Dim Page As Number

    For Page = 0 To Core.UI_MAX_DIALOGUE_PAGES - 1
        ScratchPreparedRawPage[Page] = 0
        ScratchPreparedStart[Page] = 0
    End For
    ScratchPreparedPageCount = 0

End Sub

Private Function BuildScratch(Slot As Number, ByRef Style As Core.DialogueStyle) As Boolean

    Dim ReturnValue As Boolean
    Dim RawIndex As Number
    Dim Spill As Number
    Dim Cursor As Number
    Dim NextIndex As Number
    Dim Length As Number
    Dim Finished As Boolean

    Call ClearScratch()

    If MaximumLines(Slot, Style) <= 0 Then
        Return False
    End If

    For RawIndex = 0 To RawPageCount[Slot] - 1

        Cursor = 0
        Length = Text_Length(RawPages[Slot, RawIndex])
        Finished = False

        For Spill = 0 To Core.UI_MAX_DIALOGUE_PAGES

            If Cursor > Length Then
                Finished = True
                Exit For
            End If

            If ScratchPreparedPageCount >= Core.UI_MAX_DIALOGUE_PAGES Then
                Call ClearScratch()

                Return False
            End If

            ScratchPreparedRawPage[ScratchPreparedPageCount] = RawIndex
            ScratchPreparedStart[ScratchPreparedPageCount] = Cursor
            ScratchPreparedPageCount = ScratchPreparedPageCount + 1
            NextIndex = PrepareRawPage(Slot, Style, RawIndex, Cursor, False)

            If NextIndex <= Cursor Then
                Call ClearScratch()

                Return False
            End If

            Cursor = NextIndex
        End For

        If Not Finished Then
            Call ClearScratch()

            Return False
        End If

    End For
    ReturnValue = ScratchPreparedPageCount > 0
    Return ReturnValue

End Function

Private Sub CommitScratch(Slot As Number)

    Dim Page As Number

    For Page = 0 To Core.UI_MAX_DIALOGUE_PAGES - 1
        PreparedRawPage[Slot, Page] = 0
        PreparedStart[Slot, Page] = 0
    End For

    For Page = 0 To ScratchPreparedPageCount - 1
        PreparedRawPage[Slot, Page] = ScratchPreparedRawPage[Page]
        PreparedStart[Slot, Page] = ScratchPreparedStart[Page]
    End For
    PreparedPageCount[Slot] = ScratchPreparedPageCount

    Call ClearScratch()

End Sub

Private Sub PrepareCurrentPage(Slot As Number)

    Dim NextIndex As Number

    If DialogueCurrentPage[Slot] < 0 Or DialogueCurrentPage[Slot] >= PreparedPageCount[Slot] Then
        Call ClearCurrentLines(Slot)

        Return
    End If

    NextIndex = PrepareRawPage(Slot, DialogueStyles[Slot], PreparedRawPage[Slot, DialogueCurrentPage[Slot]], PreparedStart[Slot, DialogueCurrentPage[Slot]], True)

End Sub

Private Function DialogueHandleCreate(ByRef Style As Core.DialogueStyle, X As Number, Y As Number, Width As Number, Height As Number) As Number

    Dim ReturnValue As Number
    Dim Slot As Number
    Dim Index As Number

    If Not DialogueHandleIsStyleValid(Style) Then
        ReturnValue = 0
        Return ReturnValue
    End If

    Slot = -1

    For Index = 0 To Core.UI_MAX_DIALOGUES - 1

        If Not DialogueUsed[Index] Then
            Slot = Index
            Exit For
        End If

    End For

    If Slot < 0 Then
        ReturnValue = 0
        Return ReturnValue
    End If

    DialogueGeneration[Slot] = DialogueGeneration[Slot] + 1

    If DialogueGeneration[Slot] <= 0 Then
        DialogueGeneration[Slot] = 1
    End If

    DialogueUsed[Slot] = True
    DialogueStyles[Slot] = Style
    DialogueX[Slot] = X
    DialogueY[Slot] = Y
    DialogueWidth[Slot] = Max(0, Min(Core.UI_MAX_LAYOUT_VALUE, Width))
    DialogueHeight[Slot] = Max(0, Min(Core.UI_MAX_LAYOUT_VALUE, Height))
    RawPageCount[Slot] = 0

    Call ClearPrepared(Slot)

    ReturnValue = DialogueGeneration[Slot] * 100 + Slot + 1
    Return ReturnValue

End Function

Private Function DialogueHandleIsValid(Handle As Number) As Boolean

    Dim ReturnValue As Boolean

    ReturnValue = DialogueSlotFromHandle(Handle) >= 0
    Return ReturnValue

End Function

Private Sub DialogueHandleClearPages(Handle As Number)

    Dim Slot As Number
    Dim Page As Number

    Slot = DialogueSlotFromHandle(Handle)

    If Slot < 0 Then
        Return
    End If

    For Page = 0 To Core.UI_MAX_DIALOGUE_PAGES - 1
        RawPages[Slot, Page] = ""
    End For
    RawPageCount[Slot] = 0

    Call ClearPrepared(Slot)

End Sub

Private Sub DialogueHandleDestroy(Handle As Number)

    Dim Slot As Number
    Dim Empty As Core.DialogueStyle

    Slot = DialogueSlotFromHandle(Handle)

    If Slot < 0 Then
        Return
    End If

    Call DialogueHandleClearPages(Handle)

    DialogueStyles[Slot] = Empty
    DialogueUsed[Slot] = False

End Sub

Private Function DialogueHandleSetStyle(Handle As Number, ByRef Style As Core.DialogueStyle) As Boolean

    Dim Slot As Number
    Dim OldRawPage As Number
    Dim OldStart As Number
    Dim OldVisible As Number
    Dim Page As Number
    Dim NewPage As Number

    Slot = DialogueSlotFromHandle(Handle)

    If Slot < 0 Or Not DialogueHandleIsStyleValid(Style) Then
        Return False
    End If

    If Not DialogueActive[Slot] Or PreparedPageCount[Slot] <= 0 Then

        DialogueStyles[Slot] = Style

        Call ClearPrepared(Slot)

        Return True

    End If

    OldRawPage = PreparedRawPage[Slot, DialogueCurrentPage[Slot]]
    OldStart = PreparedStart[Slot, DialogueCurrentPage[Slot]]
    OldVisible = DialogueVisible[Slot]

    If Not BuildScratch(Slot, Style) Then
        Return False
    End If

    NewPage = -1

    For Page = 0 To ScratchPreparedPageCount - 1

        If ScratchPreparedRawPage[Page] = OldRawPage And ScratchPreparedStart[Page] <= OldStart Then
            NewPage = Page
        End If

    End For

    If NewPage < 0 Then
        Call ClearScratch()

        Return False
    End If

    DialogueStyles[Slot] = Style

    Call CommitScratch(Slot)

    DialogueCurrentPage[Slot] = NewPage
    DialogueActive[Slot] = True
    DialogueComplete[Slot] = False

    Call PrepareCurrentPage(Slot)

    DialogueVisible[Slot] = Min(OldVisible, CurrentScalarCount[Slot])
    DialogueStartedAt[Slot] = Timer()

    If DialogueStyles[Slot].CharactersPerSecond > 0 Then
        DialogueStartedAt[Slot] = DialogueStartedAt[Slot] - DialogueVisible[Slot] * 1000 / DialogueStyles[Slot].CharactersPerSecond
    End If

    Return True

End Function

Private Function DialogueHandleAddPage(Handle As Number, Value As Text) As Boolean

    Dim Slot As Number
    Dim Index As Number

    Slot = DialogueSlotFromHandle(Handle)

    If (Slot < 0 Or
        RawPageCount[Slot] >= Core.UI_MAX_DIALOGUE_PAGES Or
        Text_Length(Value) > Core.UI_MAX_DIALOGUE_PAGE_SCALARS) Then
        Return False
    End If

    Index = RawPageCount[Slot]
    RawPages[Slot, Index] = Value
    RawPageCount[Slot] = Index + 1
    Return True

End Function

Private Function DialogueHandleStart(Handle As Number, NowMilliseconds As Number) As Boolean

    Dim Slot As Number

    Slot = DialogueSlotFromHandle(Handle)

    If Slot < 0 Or RawPageCount[Slot] <= 0 Then
        Return False
    End If

    If Not BuildScratch(Slot, DialogueStyles[Slot]) Then
        Return False
    End If

    Call CommitScratch(Slot)

    DialogueCurrentPage[Slot] = 0
    DialogueStartedAt[Slot] = NowMilliseconds
    DialogueVisible[Slot] = 0
    DialogueActive[Slot] = True
    DialogueComplete[Slot] = False

    Call PrepareCurrentPage(Slot)

    If DialogueStyles[Slot].CharactersPerSecond <= 0 Then
        DialogueVisible[Slot] = CurrentScalarCount[Slot]
    End If

    Return True

End Function

Private Function DialogueHandleUpdate(Handle As Number, NowMilliseconds As Number) As Number

    Dim ReturnValue As Number
    Dim Slot As Number
    Dim Previous As Number
    Dim Elapsed As Number
    Dim Target As Number

    Slot = DialogueSlotFromHandle(Handle)

    If Slot < 0 Or Not DialogueActive[Slot] Then
        ReturnValue = Core.UI_EVENT_NONE
        Return ReturnValue
    End If

    Previous = DialogueVisible[Slot]

    If DialogueStyles[Slot].CharactersPerSecond <= 0 Then

        DialogueVisible[Slot] = CurrentScalarCount[Slot]

    Else

        Elapsed = Max(0, NowMilliseconds - DialogueStartedAt[Slot])
        Target = Elapsed * DialogueStyles[Slot].CharactersPerSecond / 1000
        DialogueVisible[Slot] = Min(CurrentScalarCount[Slot], Max(DialogueVisible[Slot], Target))

    End If

    If DialogueVisible[Slot] <> Previous Then
        ReturnValue = Core.UI_EVENT_CHANGED
        Return ReturnValue
    End If

    ReturnValue = Core.UI_EVENT_NONE
    Return ReturnValue

End Function

Private Function DialogueHandleHandleKey(Handle As Number, Key As Number, NowMilliseconds As Number) As Number

    Dim ReturnValue As Number
    Dim Slot As Number
    Dim UpdateEvent As Number

    Slot = DialogueSlotFromHandle(Handle)

    If Slot < 0 Or Not DialogueActive[Slot] Then
        ReturnValue = Core.UI_EVENT_NONE
        Return ReturnValue
    End If

    If Key = KEY_ESCAPE Then

        DialogueActive[Slot] = False
        DialogueComplete[Slot] = False
        ReturnValue = Core.UI_EVENT_CANCELLED
        Return ReturnValue

    End If

    If Key <> KEY_ENTER And Key <> KEY_SPACE Then
        ReturnValue = Core.UI_EVENT_NONE
        Return ReturnValue
    End If

    UpdateEvent = DialogueHandleUpdate(Handle, NowMilliseconds)

    If DialogueVisible[Slot] < CurrentScalarCount[Slot] Then

        DialogueVisible[Slot] = CurrentScalarCount[Slot]
        ReturnValue = Core.UI_EVENT_CHANGED
        Return ReturnValue

    End If

    If DialogueCurrentPage[Slot] + 1 < PreparedPageCount[Slot] Then

        DialogueCurrentPage[Slot] = DialogueCurrentPage[Slot] + 1
        DialogueStartedAt[Slot] = NowMilliseconds
        DialogueVisible[Slot] = 0

        Call PrepareCurrentPage(Slot)

        If DialogueStyles[Slot].CharactersPerSecond <= 0 Then
            DialogueVisible[Slot] = CurrentScalarCount[Slot]
        End If

        ReturnValue = Core.UI_EVENT_ADVANCED
        Return ReturnValue

    End If

    DialogueActive[Slot] = False
    DialogueComplete[Slot] = True
    ReturnValue = Core.UI_EVENT_COMPLETED
    Return ReturnValue

End Function

Private Sub DialogueHandleDraw(Handle As Number, NowMilliseconds As Number)

    Dim Slot As Number
    Dim Content As Core.Rect
    Dim Line As Number
    Dim Remaining As Number
    Dim Length As Number
    Dim VisibleOnLine As Number
    Dim LineY As Number
    Dim StepHeight As Number
    Dim IndicatorX As Number
    Dim IndicatorY As Number
    Dim BlinkOn As Boolean
    Dim UpdateEvent As Number

    Slot = DialogueSlotFromHandle(Handle)

    If (Slot < 0 Or
        Not DialogueActive[Slot] Or
        DialogueWidth[Slot] <= 0 Or
        DialogueHeight[Slot] <= 0) Then
        Return
    End If

    UpdateEvent = DialogueHandleUpdate(Handle, NowMilliseconds)

    Call Window.Draw(DialogueStyles[Slot].Window, DialogueX[Slot], DialogueY[Slot], DialogueWidth[Slot], DialogueHeight[Slot])

    Content = Window.ContentRect(DialogueStyles[Slot].Window, DialogueX[Slot], DialogueY[Slot], DialogueWidth[Slot], DialogueHeight[Slot])

    If Content.Width <= 0 Or Content.Height <= 0 Then
        Return
    End If

    Remaining = DialogueVisible[Slot]
    StepHeight = LineStep(DialogueStyles[Slot])
    Clip Rectangle Content.X, Content.Y, Content.Width, Content.Height

        For Line = 0 To CurrentLineCount[Slot] - 1

            Length = Text_Length(CurrentLines[Slot, Line])
            VisibleOnLine = Min(Length, Max(0, Remaining))
            LineY = Content.Y + Line * StepHeight

            If VisibleOnLine > 0 Then
                Call Text.Draw(DialogueStyles[Slot].Text, Text_Slice(CurrentLines[Slot, Line], 0, VisibleOnLine), Content.X, LineY, Core.UI_ALIGN_LEFT, 100)
            End If

            Remaining = Max(0, Remaining - Length)
        End For

        If (DialogueVisible[Slot] >= CurrentScalarCount[Slot] And
            DialogueStyles[Slot].UseContinueIndicator And
            Image_Loaded(DialogueStyles[Slot].ContinueIndicator) And
            DialogueStyles[Slot].IndicatorWidth > 0 And
            DialogueStyles[Slot].IndicatorHeight > 0) Then

            BlinkOn = True

            If DialogueStyles[Slot].IndicatorBlinkMilliseconds > 0 Then
                BlinkOn = ((NowMilliseconds / DialogueStyles[Slot].IndicatorBlinkMilliseconds) Mod 2) = 0
            End If

            If BlinkOn Then

                IndicatorX = Content.X + Content.Width - DialogueStyles[Slot].IndicatorWidth + DialogueStyles[Slot].IndicatorOffsetX
                IndicatorY = Content.Y + Content.Height - DialogueStyles[Slot].IndicatorHeight + DialogueStyles[Slot].IndicatorOffsetY
                Draw Image DialogueStyles[Slot].ContinueIndicator At IndicatorX, IndicatorY Size DialogueStyles[Slot].IndicatorWidth By DialogueStyles[Slot].IndicatorHeight Filter Smooth

            End If

        End If

    End Clip

End Sub

Private Function DialogueHandleIsActive(Handle As Number) As Boolean

    Dim ReturnValue As Boolean
    Dim Slot As Number

    Slot = DialogueSlotFromHandle(Handle)

    If Slot < 0 Then
        Return False
    End If

    ReturnValue = DialogueActive[Slot]
    Return ReturnValue

End Function

Private Function DialogueHandleIsComplete(Handle As Number) As Boolean

    Dim ReturnValue As Boolean
    Dim Slot As Number

    Slot = DialogueSlotFromHandle(Handle)

    If Slot < 0 Then
        Return False
    End If

    ReturnValue = DialogueComplete[Slot]
    Return ReturnValue

End Function

Private Function DialogueHandlePageCount(Handle As Number) As Number

    Dim ReturnValue As Number
    Dim Slot As Number

    Slot = DialogueSlotFromHandle(Handle)

    If Slot < 0 Then
        ReturnValue = 0
        Return ReturnValue
    End If

    If PreparedPageCount[Slot] > 0 Then
        ReturnValue = PreparedPageCount[Slot]
        Return ReturnValue
    End If

    ReturnValue = RawPageCount[Slot]
    Return ReturnValue

End Function

Private Function DialogueHandleCurrentPage(Handle As Number) As Number

    Dim ReturnValue As Number
    Dim Slot As Number

    Slot = DialogueSlotFromHandle(Handle)

    If Slot < 0 Then
        ReturnValue = -1
        Return ReturnValue
    End If

    ReturnValue = DialogueCurrentPage[Slot]
    Return ReturnValue

End Function

Private Function DialogueHandleVisibleCharacters(Handle As Number) As Number

    Dim ReturnValue As Number
    Dim Slot As Number

    Slot = DialogueSlotFromHandle(Handle)

    If Slot < 0 Then
        ReturnValue = 0
        Return ReturnValue
    End If

    ReturnValue = DialogueVisible[Slot]
    Return ReturnValue

End Function

''' Stateful dialogue facade backed by the bounded generation-safe dialogue runtime.
Public Class Dialogue

    Private Handle As Number

    ''' Creates a bounded dialogue facade. Valid is False when validation or capacity allocation fails.
    ''' @param Style: Dialogue appearance, wrapping, and typewriter configuration.
    ''' @param X: Left edge in logical window coordinates.
    ''' @param Y: Top edge in logical window coordinates.
    ''' @param Width: Dialogue width in logical units.
    ''' @param Height: Dialogue height in logical units.
    Public Sub New(
        ByRef Style As Core.DialogueStyle,
        X As Number,
        Y As Number,
        Width As Number,
        Height As Number
    )

        Me.Handle = DialogueHandleCreate(Style, X, Y, Width, Height)

    End Sub

    ''' Reports whether this facade still owns a valid generation-safe dialogue slot.
    Public Property Valid As Boolean

        Get

            Dim ReturnValue As Boolean

            ReturnValue = DialogueHandleIsValid(Me.Handle)

            Return ReturnValue

        End Get

    End Property

    ''' Releases the underlying bounded dialogue slot. Repeated calls are safe.
    Public Sub Destroy()

        Call DialogueHandleDestroy(Me.Handle)

        Me.Handle = 0

    End Sub

    ''' Removes all raw and prepared pages while retaining the facade and style.
    Public Sub ClearPages()

        Call DialogueHandleClearPages(Me.Handle)

    End Sub

    ''' Replaces the style transactionally and reflows active content when possible.
    ''' @param Style: Candidate dialogue configuration.
    ''' @returns: True when validation and any required reflow succeeded.
    Public Function SetStyle(ByRef Style As Core.DialogueStyle) As Boolean

        Dim ReturnValue As Boolean

        ReturnValue = DialogueHandleSetStyle(Me.Handle, Style)

        Return ReturnValue

    End Function

    ''' Appends one bounded raw page.
    ''' @param Value: Unicode page content.
    ''' @returns: True when the page was accepted without changing earlier pages.
    Public Function AddPage(Value As Text) As Boolean

        Dim ReturnValue As Boolean

        ReturnValue = DialogueHandleAddPage(Me.Handle, Value)

        Return ReturnValue

    End Function

    ''' Prepares pages and starts typewriter reveal from the beginning.
    ''' @param NowMilliseconds: Caller-owned monotonic clock value.
    ''' @returns: True when preparation completed transactionally.
    Public Function Start(NowMilliseconds As Number) As Boolean

        Dim ReturnValue As Boolean

        ReturnValue = DialogueHandleStart(Me.Handle, NowMilliseconds)

        Return ReturnValue

    End Function

    ''' Advances typewriter state using the caller's clock.
    ''' @param NowMilliseconds: Caller-owned monotonic clock value.
    ''' @returns: A UI_EVENT value describing the state transition.
    Public Function Update(NowMilliseconds As Number) As Number

        Dim ReturnValue As Number

        ReturnValue = DialogueHandleUpdate(Me.Handle, NowMilliseconds)

        Return ReturnValue

    End Function

    ''' Applies one keyboard input to the active dialogue.
    ''' @param Key: SMILE key code to process.
    ''' @param NowMilliseconds: Caller-owned monotonic clock value.
    ''' @returns: A UI_EVENT value describing reveal, paging, cancellation, or completion.
    ''' @remarks: Requires Game Window because accepted input may measure newly prepared text.
    Public Function HandleKey(Key As Number, NowMilliseconds As Number) As Number

        Dim ReturnValue As Number

        ReturnValue = DialogueHandleHandleKey(Me.Handle, Key, NowMilliseconds)

        Return ReturnValue

    End Function

    ''' Draws the visible prepared page and continuation indicator.
    ''' @param NowMilliseconds: Caller-owned monotonic clock value used for indicator blinking.
    ''' @remarks: Requires Game Window.
    Public Sub Draw(NowMilliseconds As Number)

        Call DialogueHandleDraw(Me.Handle, NowMilliseconds)

    End Sub

    ''' Reports whether dialogue input and typewriter state are active.
    Public Property Active As Boolean

        Get

            Dim ReturnValue As Boolean

            ReturnValue = DialogueHandleIsActive(Me.Handle)

            Return ReturnValue

        End Get

    End Property

    ''' Reports whether the final prepared page has been fully revealed and accepted.
    Public Property Complete As Boolean

        Get

            Dim ReturnValue As Boolean

            ReturnValue = DialogueHandleIsComplete(Me.Handle)

            Return ReturnValue

        End Get

    End Property

    ''' Returns the number of currently prepared spill pages.
    Public Property PageCount As Number

        Get

            Dim ReturnValue As Number

            ReturnValue = DialogueHandlePageCount(Me.Handle)

            Return ReturnValue

        End Get

    End Property

    ''' Returns the zero-based current prepared-page index.
    Public Property CurrentPage As Number

        Get

            Dim ReturnValue As Number

            ReturnValue = DialogueHandleCurrentPage(Me.Handle)

            Return ReturnValue

        End Get

    End Property

    ''' Returns the number of Unicode scalars currently visible on the active page.
    Public Property VisibleCharacters As Number

        Get

            Dim ReturnValue As Number

            ReturnValue = DialogueHandleVisibleCharacters(Me.Handle)

            Return ReturnValue

        End Get

    End Property

End Class

End Module
