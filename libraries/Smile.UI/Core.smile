Module Smile.UI.Core

Option Explicit

Public Const UI_EVENT_NONE = 0
Public Const UI_EVENT_CHANGED = 1
Public Const UI_EVENT_ACCEPTED = 2
Public Const UI_EVENT_CANCELLED = 3
Public Const UI_EVENT_ADVANCED = 4
Public Const UI_EVENT_COMPLETED = 5
Public Const UI_EVENT_SUBMENU_OPENED = 6
Public Const UI_EVENT_SUBMENU_CLOSED = 7

Public Const UI_ALIGN_LEFT = 0
Public Const UI_ALIGN_CENTER = 1
Public Const UI_ALIGN_RIGHT = 2

Public Const UI_TEXT_SYSTEM = 0
Public Const UI_TEXT_BITMAP = 1

Public Const UI_FILTER_SMOOTH = 0
Public Const UI_FILTER_PIXEL = 1

Public Const UI_MENU_TEXT_ELLIPSIS = 0
Public Const UI_MENU_TEXT_CLIP = 1
Public Const UI_MENU_TEXT_WRAP = 2

Public Const UI_SUBMENU_DIRECTION_AUTO = 0
Public Const UI_SUBMENU_DIRECTION_RIGHT = 1
Public Const UI_SUBMENU_DIRECTION_LEFT = 2

Public Const UI_SUBMENU_INDICATOR_AFTER_TEXT = 0
Public Const UI_SUBMENU_INDICATOR_RIGHT_ALIGNED = 1

Public Const UI_MAX_BITMAP_FONTS = 8
Public Const UI_MAX_MENUS = 16
Public Const UI_MAX_MENU_ITEMS = 64
Public Const UI_MAX_MENU_ITEM_SCALARS = 256
Public Const UI_MAX_MENU_ITEM_LINES = 4
Public Const UI_MAX_MENU_NAVIGATORS = 8
Public Const UI_MAX_MENU_DEPTH = 8
Public Const UI_MAX_SUBMENU_BINDINGS = 128
Public Const UI_MAX_DIALOGUES = 8
Public Const UI_MAX_DIALOGUE_PAGES = 32
Public Const UI_MAX_DIALOGUE_LINES = 16
Public Const UI_MAX_DIALOGUE_PAGE_SCALARS = 2048
Public Const UI_MAX_LAYOUT_VALUE = 1000000

Public Type Rect
    X As Number
    Y As Number
    Width As Number
    Height As Number
End Type

Public Type Insets
    LEFT As Number
    Top As Number
    RIGHT As Number
    Bottom As Number
End Type

Public Type BitmapFontStyle
    Atlas As Image
    SourceX As Number
    SourceY As Number
    FirstCodePoint As Number
    GlyphCount As Number
    Columns As Number
    SourceCellWidth As Number
    SourceCellHeight As Number
    DrawWidth As Number
    DrawHeight As Number
    AdvanceX As Number
    LineHeight As Number
    FallbackCodePoint As Number
    FilterMode As Number
End Type

Public Type TextStyle
    Mode As Number
    SystemSize As Number
    SystemColor As Number
    BitmapFontHandle As Number
    LineSpacing As Number
End Type

Public Type WindowStyle
    UseSkin As Boolean
    Skin As Image
    SourceX As Number
    SourceY As Number
    SourceWidth As Number
    SourceHeight As Number
    SourceLeft As Number
    SourceTop As Number
    SourceRight As Number
    SourceBottom As Number
    DestinationLeft As Number
    DestinationTop As Number
    DestinationRight As Number
    DestinationBottom As Number
    FillColor As Number
    BorderColor As Number
    BorderThickness As Number
    Opacity As Number
    FilterMode As Number
    Padding As Insets
End Type

Public Type MenuStyle
    Window As WindowStyle
    NormalText As TextStyle
    SelectedText As TextStyle
    DisabledText As TextStyle
    SelectionFillColor As Number
    UseCursor As Boolean
    Cursor As Image
    CursorWidth As Number
    CursorHeight As Number
    CursorOffsetX As Number
    CursorOffsetY As Number
    CursorFilterMode As Number
    RowHeight As Number
    WrapSelection As Boolean
    ShowScrollbar As Boolean
    ShowSubmenuIndicator As Boolean
    SubmenuIndicatorPosition As Number
    ItemTextOverflowMode As Number
    ItemTextMaxLines As Number
End Type

Public Type MenuNavigatorStyle
    Viewport As Rect
    ViewportPadding As Insets
    HorizontalGap As Number
    PreferredDirection As Number
End Type

Public Type DialogueStyle
    Window As WindowStyle
    Text As TextStyle
    CharactersPerSecond As Number
    LineSpacing As Number
    UseContinueIndicator As Boolean
    ContinueIndicator As Image
    IndicatorWidth As Number
    IndicatorHeight As Number
    IndicatorOffsetX As Number
    IndicatorOffsetY As Number
    IndicatorBlinkMilliseconds As Number
End Type

Public Function IsRectValid(ByRef Value As Rect) As Boolean
    Return Value.Width > 0 And Value.Height > 0
End Function

End Module
