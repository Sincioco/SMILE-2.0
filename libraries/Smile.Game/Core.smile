''' Shared fixed-step, cardinal-movement primitives for reusable two-dimensional games.
Module Smile.Game.Core

Option Explicit

''' One exclusive direction in a four-way cardinal grid.
Public Enum CardinalDirection
    None = 0
    Up = 1
    Right = 2
    Down = 3
    Left = 4
End Enum

Public Const GAME_LAYER_GROUND = 1
Public Const GAME_LAYER_DETAIL = 2
Public Const GAME_LAYER_FOREGROUND = 3

Public Const GAME_FILTER_SMOOTH = 1
Public Const GAME_FILTER_PIXEL = 2

Public Const GAME_MAX_VALUE = 999999999

''' Tile-authoritative motion state. Position is interpolated from Source to Destination.
Public Type CardinalMover

    CellX As Number
    CellY As Number
    SourceX As Number
    SourceY As Number
    DestinationX As Number
    DestinationY As Number
    Progress As Number
    Duration As Number
    Facing As CardinalDirection
    Moving As Boolean

    ''' Initializes this mover at one legal cell.
    Public Sub Place(
        CellX As Number,
        CellY As Number,
        Facing As CardinalDirection
    )

        Me.CellX = CellX
        Me.CellY = CellY
        Me.SourceX = CellX
        Me.SourceY = CellY
        Me.DestinationX = CellX
        Me.DestinationY = CellY
        Me.Progress = 0
        Me.Duration = 1
        Me.Facing = Facing
        Me.Moving = False

    End Sub

    ''' Begins interpolation after the caller has preflighted map and actor collision.
    Public Function BeginMove(
        Direction As CardinalDirection,
        Duration As Number
    ) As Boolean

        If ((Direction <> CardinalDirection.Up And
            Direction <> CardinalDirection.Right And
            Direction <> CardinalDirection.Down And
            Direction <> CardinalDirection.Left) Or
            Me.Moving Or
            Duration <= 0 Or
            Duration > GAME_MAX_VALUE) Then
            Return False
        End If

        Me.Facing = Direction
        Me.SourceX = Me.CellX
        Me.SourceY = Me.CellY
        Me.DestinationX = Me.CellX + DirectionX(Direction)
        Me.DestinationY = Me.CellY + DirectionY(Direction)
        Me.Progress = 0
        Me.Duration = Duration
        Me.Moving = True
        Return True

    End Function

    ''' Advances fixed-step interpolation and commits the destination only at completion.
    Public Function UpdateMove(Steps As Number) As Boolean

        If Not Me.Moving Or Steps <= 0 Then
            Return False
        End If

        Me.Progress = Me.Progress + Steps

        If Me.Progress >= Me.Duration Then

            Me.CellX = Me.DestinationX
            Me.CellY = Me.DestinationY
            Me.SourceX = Me.CellX
            Me.SourceY = Me.CellY
            Me.Progress = Me.Duration
            Me.Moving = False
            Return True

        End If

        Return False

    End Function

    ''' Cancels an incomplete move without changing the authoritative source cell.
    Public Sub CancelMove()

        Me.DestinationX = Me.CellX
        Me.DestinationY = Me.CellY
        Me.SourceX = Me.CellX
        Me.SourceY = Me.CellY
        Me.Progress = 0
        Me.Moving = False

    End Sub

    ''' Returns interpolated pixel X using integer fixed-point math.
    Public Function VisualX(CellWidth As Number) As Number

        Dim ReturnValue As Number

        If Not Me.Moving Then
            ReturnValue = Me.CellX * CellWidth

            Return ReturnValue
        End If

        ReturnValue = (Me.SourceX * CellWidth * Me.Duration +
            (Me.DestinationX - Me.SourceX) * CellWidth * Me.Progress) / Me.Duration

        Return ReturnValue

    End Function

    ''' Returns interpolated pixel Y using integer fixed-point math.
    Public Function VisualY(CellHeight As Number) As Number

        Dim ReturnValue As Number

        If Not Me.Moving Then
            ReturnValue = Me.CellY * CellHeight

            Return ReturnValue
        End If

        ReturnValue = (Me.SourceY * CellHeight * Me.Duration +
            (Me.DestinationY - Me.SourceY) * CellHeight * Me.Progress) / Me.Duration

        Return ReturnValue

    End Function

End Type

''' Returns the horizontal cell delta for a cardinal direction.
Public Function DirectionX(Direction As CardinalDirection) As Number

    Dim ReturnValue As Number

    Select Case Direction
        Case CardinalDirection.Right
            Return 1

        Case CardinalDirection.Left
            ReturnValue = -1

            Return ReturnValue

    End Select

    Return 0

End Function

''' Returns the vertical cell delta for a cardinal direction.
Public Function DirectionY(Direction As CardinalDirection) As Number

    Dim ReturnValue As Number

    Select Case Direction
        Case CardinalDirection.Down
            Return 1

        Case CardinalDirection.Up
            ReturnValue = -1

            Return ReturnValue

    End Select

    Return 0

End Function

End Module
