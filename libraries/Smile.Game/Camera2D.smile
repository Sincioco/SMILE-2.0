''' Deterministic two-dimensional camera follow and map-edge clamping.
Module Smile.Game.Camera2D

Option Explicit

Private Function MaximumOffset(WorldSize As Number, ViewSize As Number) As Number

    Dim ReturnValue As Number

    If WorldSize <= ViewSize Then
        Return 0
    End If

    ReturnValue = WorldSize - ViewSize

    Return ReturnValue

End Function

Private Function ClampOffset(Value As Number, Maximum As Number) As Number

    If Value < 0 Then
        Return 0
    End If

    If Value > Maximum Then
        Return Maximum
    End If

    Return Value

End Function

''' Camera offset plus viewport and world dimensions in caller-selected world units.
Public Type CameraState

    X As Number
    Y As Number
    ViewWidth As Number
    ViewHeight As Number
    WorldWidth As Number
    WorldHeight As Number

    ''' Configures the viewport/world sizes and clamps the current offset.
    Public Function Configure(
        ViewWidth As Number,
        ViewHeight As Number,
        WorldWidth As Number,
        WorldHeight As Number
    ) As Boolean

        If (ViewWidth <= 0 Or
            ViewHeight <= 0 Or
            WorldWidth <= 0 Or
            WorldHeight <= 0) Then
            Return False
        End If

        Me.ViewWidth = ViewWidth
        Me.ViewHeight = ViewHeight
        Me.WorldWidth = WorldWidth
        Me.WorldHeight = WorldHeight
        Me.X = ClampOffset(Me.X, MaximumOffset(WorldWidth, ViewWidth))
        Me.Y = ClampOffset(Me.Y, MaximumOffset(WorldHeight, ViewHeight))
        Return True

    End Function

    ''' Snaps the camera to center a target point while honoring every map edge.
    Public Sub Follow(TargetX As Number, TargetY As Number)

        Me.X = ClampOffset(TargetX - Me.ViewWidth / 2,
            MaximumOffset(Me.WorldWidth, Me.ViewWidth))
        Me.Y = ClampOffset(TargetY - Me.ViewHeight / 2,
            MaximumOffset(Me.WorldHeight, Me.ViewHeight))

    End Sub

    ''' Moves toward the clamped follow target by a bounded integer step.
    Public Sub SmoothFollow(
        TargetX As Number,
        TargetY As Number,
        MaximumStep As Number
    )

        Dim DesiredX As Number
        Dim DesiredY As Number

        DesiredX = ClampOffset(TargetX - Me.ViewWidth / 2,
            MaximumOffset(Me.WorldWidth, Me.ViewWidth))
        DesiredY = ClampOffset(TargetY - Me.ViewHeight / 2,
            MaximumOffset(Me.WorldHeight, Me.ViewHeight))

        If MaximumStep <= 0 Then

            Me.X = DesiredX
            Me.Y = DesiredY
            Return

        End If

        If Me.X < DesiredX Then
            Me.X = Min(Me.X + MaximumStep, DesiredX)
        Else If Me.X > DesiredX Then
            Me.X = Max(Me.X - MaximumStep, DesiredX)
        End If

        If Me.Y < DesiredY Then
            Me.Y = Min(Me.Y + MaximumStep, DesiredY)
        Else If Me.Y > DesiredY Then
            Me.Y = Max(Me.Y - MaximumStep, DesiredY)
        End If

    End Sub

    ''' Returns the first visible cell with a caller-selected overscan amount.
    Public Function FirstVisibleCellX(
        CellWidth As Number,
        Overscan As Number
    ) As Number

        Dim ReturnValue As Number

        ReturnValue = Max(0, Me.X / CellWidth - Max(0, Overscan))

        Return ReturnValue

    End Function

    ''' Returns the first visible row with a caller-selected nonnegative overscan.
    Public Function FirstVisibleCellY(
        CellHeight As Number,
        Overscan As Number
    ) As Number

        Dim ReturnValue As Number

        ReturnValue = Max(0, Me.Y / CellHeight - Max(0, Overscan))

        Return ReturnValue

    End Function

    ''' Returns the last visible column, clamped to the supplied map width.
    Public Function LastVisibleCellX(
        CellWidth As Number,
        MapWidth As Number,
        Overscan As Number
    ) As Number

        Dim ReturnValue As Number

        ReturnValue = Min(MapWidth - 1, (Me.X + Me.ViewWidth - 1) / CellWidth + Max(0, Overscan))

        Return ReturnValue

    End Function

    ''' Returns the last visible row, clamped to the supplied map height.
    Public Function LastVisibleCellY(
        CellHeight As Number,
        MapHeight As Number,
        Overscan As Number
    ) As Number

        Dim ReturnValue As Number

        ReturnValue = Min(MapHeight - 1, (Me.Y + Me.ViewHeight - 1) / CellHeight + Max(0, Overscan))

        Return ReturnValue

    End Function

End Type

End Module
