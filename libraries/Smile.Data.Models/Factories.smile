Module Smile.Data.Models

Option Explicit

Public Function CreateActor(Name As Text, X As Number, Y As Number, CurrentHP As Number, MaximumHP As Number) As Actor

    Dim Result As Actor

    With Result
        .Name = Name

        With .Position
            .X = X
            .Y = Y
        End With

        With .Health
            .Current = CurrentHP
            .Maximum = MaximumHP
        End With

        .Active = True
    End With

    Return Result

End Function

Public Function CopyActor(Value As Actor) As Actor

    Return Value

End Function

Public Sub Move(ByRef Value As Actor, DeltaX As Number, DeltaY As Number)

    With Value
        With .Position
            .X = .X + DeltaX
            .Y = .Y + DeltaY
        End With
    End With

End Sub

Public Sub Damage(ByRef Value As Actor, Amount As Number)

    With Value
        With .Health
            .Current = Max(0, .Current - Amount)
        End With
    End With

End Sub

Private Function InternalIdentity(Value As Number) As Number

    Return Value

End Function

End Module
