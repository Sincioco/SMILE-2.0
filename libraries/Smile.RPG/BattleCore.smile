Public Const BATTLE_OUTCOME_VICTORY = 1
Public Const BATTLE_OUTCOME_DEFEAT = 2
Public Const BATTLE_OUTCOME_ESCAPED = 3

Public Const BATTLE_EVENT_BATTLE_STARTED = 1
Public Const BATTLE_EVENT_ROUND_STARTED = 2
Public Const BATTLE_EVENT_ACTION_STARTED = 3
Public Const BATTLE_EVENT_ACTION_DENIED = 4
Public Const BATTLE_EVENT_ATTACK = 5
