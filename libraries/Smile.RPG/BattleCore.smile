    Id As Number
    Name As Text
    EscapeChance As Number
End Type

Public Type FormationMemberDefinition
    FormationId As Number
    EnemyId As Number
    GroupId As Number
    SlotId As Number
End Type

Private Dim StateGeneration[4] As Number
Private Dim EnemyDefinitionCounts[4] As Number
Private Dim EnemyIds[4, 64] As Number
Private Dim EnemyNames[4, 64] As Text
Private Dim EnemyMaximumHealth[4, 64] As Number
Private Dim EnemyMaximumMagicPoints[4, 64] As Number
Private Dim EnemyStrength[4, 64] As Number
Private Dim EnemyDefense[4, 64] As Number
Private Dim EnemyMagic[4, 64] As Number
Private Dim EnemyResistance[4, 64] As Number
Private Dim EnemyAgility[4, 64] As Number
Private Dim EnemyLuck[4, 64] As Number
Private Dim EnemyExperienceRewards[4, 64] As Number
Private Dim EnemyGoldRewards[4, 64] As Number
Private Dim EnemyAiProfileIds[4, 64] As Number

Private Dim FormationCounts[4] As Number
Private Dim FormationIds[4, 32] As Number
Private Dim FormationNames[4, 32] As Text
Private Dim FormationEscapeChances[4, 32] As Number
Private Dim FormationMemberCounts[4, 32] As Number
Private Dim FormationEnemyIds[4, 256] As Number
Private Dim FormationGroupIds[4, 256] As Number
Private Dim FormationSlotIds[4, 256] As Number

Private Dim BattleActive[4] As Boolean
Private Dim BattleSerials[4] As Number
Private Dim BattleHandles[4] As Number
Private Dim BattlePhases[4] As Number
Private Dim BattleOutcomes[4] As Number
Private Dim BattleRounds[4] As Number
Private Dim BattleSeeds[4] As Number
Private Dim ActiveFormationIds[4] As Number
Private Dim ActiveEscapeChances[4] As Number
Private Dim ActiveParticipantCounts[4] As Number
Private Dim RewardExperience[4] As Number
Private Dim RewardGold[4] As Number
Private Dim RewardsCommitted[4] As Boolean
Private Dim PartyAttackBaseHitChances[4] As Number
Private Dim EnemyAttackBaseHitChances[4] As Number

Private Dim ParticipantSides[4, 12] As Number
Private Dim ParticipantReferenceIds[4, 12] As Number
Private Dim ParticipantDefinitionIds[4, 12] As Number
Private Dim ParticipantGroupIds[4, 12] As Number
Private Dim ParticipantSlotIds[4, 12] As Number
Private Dim ParticipantNames[4, 12] As Text
Private Dim ParticipantHealth[4, 12] As Number
Private Dim ParticipantMaximumHealth[4, 12] As Number
Private Dim ParticipantMagicPoints[4, 12] As Number
Private Dim ParticipantMaximumMagicPoints[4, 12] As Number
Private Dim ParticipantStrength[4, 12] As Number
Private Dim ParticipantDefense[4, 12] As Number
Private Dim ParticipantMagic[4, 12] As Number
Private Dim ParticipantResistance[4, 12] As Number
Private Dim ParticipantAgility[4, 12] As Number
Private Dim ParticipantLuck[4, 12] As Number
Private Dim ParticipantAttackProficiencyBonuses[4, 12] As Number
Private Dim ParticipantDefending[4, 12] As Boolean
Private Dim ParticipantAiProfileIds[4, 12] As Number

Private Dim ParticipantStatusCounts[4, 12] As Number
Private Dim ParticipantStatusIds[4, 96] As Number
Private Dim ParticipantStatusDurations[4, 96] As Number

Private Dim SubmittedActions[4, 12] As Boolean
Private Dim SubmittedActionKinds[4, 12] As Number
Private Dim SubmittedSourceIds[4, 12] As Number
Private Dim SubmittedTargetIds[4, 12] As Number
Private Dim ScheduleCounts[4] As Number
Private Dim SchedulePositions[4] As Number
Private Dim ScheduleParticipantIndexes[4, 12] As Number

Private Dim EventCounts[4] As Number
Private Dim EventKinds[4, 1024] As Number
Private Dim EventActorIds[4, 1024] As Number
Private Dim EventTargetIds[4, 1024] As Number
Private Dim EventValueOne[4, 1024] As Number
Private Dim EventValueTwo[4, 1024] As Number
Private Dim EventTexts[4, 1024] As Text

Private Dim BackupHealth[4, 12] As Number
Private Dim BackupMagicPoints[4, 12] As Number
Private Dim BackupDefending[4, 12] As Boolean
Private Dim BackupStatusCounts[4, 12] As Number
Private Dim BackupStatusIds[4, 96] As Number
Private Dim BackupStatusDurations[4, 96] As Number
Private Dim BackupEventCounts[4] As Number
Private Dim BackupSeeds[4] As Number
Private Dim BackupItemIds[4] As Number
Private Dim BackupItemQuantities[4] As Number

Private Function StateSlot(StateHandle As Number) As Number

    Dim ReturnValue As Number

    Dim Slot As Number
    Dim Index As Number
    Dim Generation As Number

    Slot = Core.StateSlot(StateHandle)

    If Slot < 0 Then
        ReturnValue = -1

        Return ReturnValue
    End If

    Generation = Core.StateGeneration(StateHandle)

    If StateGeneration[Slot] <> Generation Then

        For Index = 0 To BATTLE_MAX_ENEMY_DEFINITIONS - 1
            EnemyIds[Slot, Index] = 0
            EnemyNames[Slot, Index] = ""
        End For

        For Index = 0 To BATTLE_MAX_FORMATIONS - 1
            FormationIds[Slot, Index] = 0
            FormationNames[Slot, Index] = ""
            FormationMemberCounts[Slot, Index] = 0
        End For

        EnemyDefinitionCounts[Slot] = 0
        FormationCounts[Slot] = 0
        BattleActive[Slot] = False
        BattleSerials[Slot] = 0
        BattleHandles[Slot] = 0
        BattlePhases[Slot] = BATTLE_PHASE_NONE
        BattleOutcomes[Slot] = BATTLE_OUTCOME_NONE
        EventCounts[Slot] = 0
        StateGeneration[Slot] = Generation

    End If

    Return Slot

End Function

Private Function EnemyIndex(StateHandle As Number, EnemyId As Number) As Number

    Dim ReturnValue As Number

    Dim Slot As Number
    Dim Index As Number

    Slot = StateSlot(StateHandle)

    If Slot < 0 Then
        ReturnValue = -1

        Return ReturnValue
    End If

    For Index = 0 To EnemyDefinitionCounts[Slot] - 1

        If EnemyIds[Slot, Index] = EnemyId Then
            Return Index
        End If

    End For

    ReturnValue = -1

    Return ReturnValue

End Function

Private Function FormationIndex(StateHandle As Number, FormationId As Number) As Number

    Dim ReturnValue As Number

    Dim Slot As Number
    Dim Index As Number

    Slot = StateSlot(StateHandle)

    If Slot < 0 Then
        ReturnValue = -1

        Return ReturnValue
    End If

    For Index = 0 To FormationCounts[Slot] - 1

        If FormationIds[Slot, Index] = FormationId Then
            Return Index
        End If

    End For

    ReturnValue = -1

    Return ReturnValue

End Function

Private Function ParticipantIndex(StateHandle As Number, ParticipantId As Number) As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    Slot = StateSlot(StateHandle)

    If (Slot < 0 Or
        Not BattleActive[Slot] Or
        ParticipantId <= 0 Or
        ParticipantId > ActiveParticipantCounts[Slot]) Then
        ReturnValue = -1

        Return ReturnValue
    End If

    ReturnValue = ParticipantId - 1

    Return ReturnValue

End Function

Private Function StatusStorageIndex(ParticipantIndexValue As Number, StatusOffset As Number) As Number

    Dim ReturnValue As Number

    ReturnValue = ParticipantIndexValue * BATTLE_MAX_STATUSES_PER_PARTICIPANT + StatusOffset

    Return ReturnValue

End Function

Private Function CurrentHealth(StateHandle As Number, ParticipantIndexValue As Number) As Number

    Dim ReturnValue As Number

    Dim Slot As Number
    Dim CharacterId As Number

    Slot = StateSlot(StateHandle)

    If (Slot < 0 Or
        ParticipantIndexValue < 0 Or
        ParticipantIndexValue >= ActiveParticipantCounts[Slot]) Then
        Return 0
    End If

    If ParticipantSides[Slot, ParticipantIndexValue] = BATTLE_SIDE_PARTY Then

        CharacterId = ParticipantReferenceIds[Slot, ParticipantIndexValue]

        ReturnValue = Characters.Health(StateHandle, CharacterId)

        Return ReturnValue

    End If

    ReturnValue = ParticipantHealth[Slot, ParticipantIndexValue]

    Return ReturnValue

End Function

Private Function CurrentMagicPoints(StateHandle As Number, ParticipantIndexValue As Number) As Number

    Dim ReturnValue As Number

    Dim Slot As Number
    Dim CharacterId As Number

    Slot = StateSlot(StateHandle)

    If (Slot < 0 Or
        ParticipantIndexValue < 0 Or
        ParticipantIndexValue >= ActiveParticipantCounts[Slot]) Then
        Return 0
    End If

    If ParticipantSides[Slot, ParticipantIndexValue] = BATTLE_SIDE_PARTY Then

        CharacterId = ParticipantReferenceIds[Slot, ParticipantIndexValue]

        ReturnValue = Characters.MagicPoints(StateHandle, CharacterId)

        Return ReturnValue

    End If

    ReturnValue = ParticipantMagicPoints[Slot, ParticipantIndexValue]

    Return ReturnValue

End Function

Private Function CurrentMaximumHealth(StateHandle As Number, ParticipantIndexValue As Number) As Number

    Dim ReturnValue As Number

    Dim Slot As Number
    Dim CharacterId As Number

    Slot = StateSlot(StateHandle)

    If (Slot < 0 Or
        ParticipantIndexValue < 0 Or
        ParticipantIndexValue >= ActiveParticipantCounts[Slot]) Then
        Return 0
    End If

    If ParticipantSides[Slot, ParticipantIndexValue] = BATTLE_SIDE_PARTY Then

        CharacterId = ParticipantReferenceIds[Slot, ParticipantIndexValue]

        ReturnValue = Characters.MaximumHealth(StateHandle, CharacterId)

        Return ReturnValue

    End If

    ReturnValue = ParticipantMaximumHealth[Slot, ParticipantIndexValue]

    Return ReturnValue

End Function

Private Function CurrentMaximumMagicPoints(StateHandle As Number, ParticipantIndexValue As Number) As Number

    Dim ReturnValue As Number

    Dim Slot As Number
    Dim CharacterId As Number

    Slot = StateSlot(StateHandle)

    If (Slot < 0 Or
        ParticipantIndexValue < 0 Or
        ParticipantIndexValue >= ActiveParticipantCounts[Slot]) Then
        Return 0
    End If

    If ParticipantSides[Slot, ParticipantIndexValue] = BATTLE_SIDE_PARTY Then

        CharacterId = ParticipantReferenceIds[Slot, ParticipantIndexValue]

        ReturnValue = Characters.MaximumMagicPoints(StateHandle, CharacterId)

        Return ReturnValue

    End If

    ReturnValue = ParticipantMaximumMagicPoints[Slot, ParticipantIndexValue]

    Return ReturnValue

End Function

Private Function SetCurrentHealth(StateHandle As Number, ParticipantIndexValue As Number, Value As Number) As Boolean

    Dim ReturnValue As Boolean

    Dim Slot As Number
    Dim CharacterId As Number

    Slot = StateSlot(StateHandle)

    If (Slot < 0 Or
        ParticipantIndexValue < 0 Or
        ParticipantIndexValue >= ActiveParticipantCounts[Slot]) Then
        Return False
    End If

    If ParticipantSides[Slot, ParticipantIndexValue] = BATTLE_SIDE_PARTY Then

        CharacterId = ParticipantReferenceIds[Slot, ParticipantIndexValue]

        ReturnValue = Characters.SetHealth(StateHandle, CharacterId, Value)

        Return ReturnValue

    End If

    If Value < 0 Or Value > ParticipantMaximumHealth[Slot, ParticipantIndexValue] Then
        Return False
    End If

    ParticipantHealth[Slot, ParticipantIndexValue] = Value
    Return True

End Function

Private Function SetCurrentMagicPoints(StateHandle As Number, ParticipantIndexValue As Number, Value As Number) As Boolean

    Dim ReturnValue As Boolean

    Dim Slot As Number
    Dim CharacterId As Number

    Slot = StateSlot(StateHandle)

    If (Slot < 0 Or
        ParticipantIndexValue < 0 Or
        ParticipantIndexValue >= ActiveParticipantCounts[Slot]) Then
        Return False
    End If

    If ParticipantSides[Slot, ParticipantIndexValue] = BATTLE_SIDE_PARTY Then

        CharacterId = ParticipantReferenceIds[Slot, ParticipantIndexValue]

        ReturnValue = Characters.SetMagicPoints(StateHandle, CharacterId, Value)

        Return ReturnValue

    End If

    If Value < 0 Or Value > ParticipantMaximumMagicPoints[Slot, ParticipantIndexValue] Then
        Return False
    End If

    ParticipantMagicPoints[Slot, ParticipantIndexValue] = Value
    Return True

End Function

Private Function NextRandom(StateHandle As Number) As Number

    Dim Slot As Number
    Dim ReturnValue As Number

    Slot = StateSlot(StateHandle)

    If Slot < 0 Then
        Return 0
    End If

    BattleSeeds[Slot] = (BattleSeeds[Slot] * 25173 + 13849) Mod 65536
    ReturnValue = BattleSeeds[Slot]

    Return ReturnValue

End Function

Private Function AddEvent(StateHandle As Number, Kind As Number, ActorId As Number, TargetId As Number, ValueOne As Number, ValueTwo As Number, Message As Text) As Boolean

    Dim Slot As Number
    Dim Index As Number

    Slot = StateSlot(StateHandle)

    If Slot < 0 Or EventCounts[Slot] >= BATTLE_MAX_EVENTS Then
        Return False
    End If

    Index = EventCounts[Slot]
    EventKinds[Slot, Index] = Kind
    EventActorIds[Slot, Index] = ActorId
    EventTargetIds[Slot, Index] = TargetId
    EventValueOne[Slot, Index] = ValueOne
    EventValueTwo[Slot, Index] = ValueTwo
    EventTexts[Slot, Index] = Message
    EventCounts[Slot] = Index + 1
    Return True

End Function

Private Sub ClearParticipant(Slot As Number, Index As Number)

    Dim StatusOffset As Number
    Dim StoredIndex As Number

    ParticipantSides[Slot, Index] = 0
    ParticipantReferenceIds[Slot, Index] = 0
    ParticipantDefinitionIds[Slot, Index] = 0
    ParticipantGroupIds[Slot, Index] = 0
    ParticipantSlotIds[Slot, Index] = 0
    ParticipantNames[Slot, Index] = ""
    ParticipantHealth[Slot, Index] = 0
    ParticipantMaximumHealth[Slot, Index] = 0
    ParticipantMagicPoints[Slot, Index] = 0
    ParticipantMaximumMagicPoints[Slot, Index] = 0
    ParticipantStrength[Slot, Index] = 0
    ParticipantDefense[Slot, Index] = 0
    ParticipantMagic[Slot, Index] = 0
    ParticipantResistance[Slot, Index] = 0
    ParticipantAgility[Slot, Index] = 0
    ParticipantLuck[Slot, Index] = 0
    ParticipantAttackProficiencyBonuses[Slot, Index] = 0
    ParticipantDefending[Slot, Index] = False
    ParticipantAiProfileIds[Slot, Index] = 0
    ParticipantStatusCounts[Slot, Index] = 0
    SubmittedActions[Slot, Index] = False

    For StatusOffset = 0 To BATTLE_MAX_STATUSES_PER_PARTICIPANT - 1
        StoredIndex = StatusStorageIndex(Index, StatusOffset)
        ParticipantStatusIds[Slot, StoredIndex] = 0
        ParticipantStatusDurations[Slot, StoredIndex] = 0
    End For

End Sub

Private Sub ResetSession(Slot As Number)

    Dim Index As Number

    For Index = 0 To BATTLE_MAX_PARTICIPANTS - 1
        Call ClearParticipant(Slot, Index)

        ScheduleParticipantIndexes[Slot, Index] = 0
    End For

    BattlePhases[Slot] = BATTLE_PHASE_NONE
    BattleOutcomes[Slot] = BATTLE_OUTCOME_NONE
    BattleRounds[Slot] = 0
    BattleSeeds[Slot] = 0
    ActiveFormationIds[Slot] = 0
    ActiveEscapeChances[Slot] = 0
    ActiveParticipantCounts[Slot] = 0
    RewardExperience[Slot] = 0
    RewardGold[Slot] = 0
    RewardsCommitted[Slot] = False
    PartyAttackBaseHitChances[Slot] = 100
    EnemyAttackBaseHitChances[Slot] = 100
    ScheduleCounts[Slot] = 0
    SchedulePositions[Slot] = 0
    EventCounts[Slot] = 0

End Sub

Private Function AddPartyParticipant(StateHandle As Number, CharacterId As Number, PartyIndex As Number) As Boolean

    Dim Slot As Number
    Dim Index As Number

    Slot = StateSlot(StateHandle)

    If (Slot < 0 Or
        Not Characters.IsCharacterDefined(StateHandle, CharacterId) Or
        ActiveParticipantCounts[Slot] >= BATTLE_MAX_PARTICIPANTS) Then
        Return False
    End If

    Index = ActiveParticipantCounts[Slot]
    ParticipantSides[Slot, Index] = BATTLE_SIDE_PARTY
    ParticipantReferenceIds[Slot, Index] = CharacterId
    ParticipantDefinitionIds[Slot, Index] = CharacterId
    ParticipantGroupIds[Slot, Index] = 0
    ParticipantSlotIds[Slot, Index] = PartyIndex + 1
    ParticipantNames[Slot, Index] = Characters.Name(StateHandle, CharacterId)
    ParticipantMaximumHealth[Slot, Index] = Characters.MaximumHealth(StateHandle, CharacterId)
    ParticipantMaximumMagicPoints[Slot, Index] = Characters.MaximumMagicPoints(StateHandle, CharacterId)
    ParticipantStrength[Slot, Index] = Characters.Strength(StateHandle, CharacterId) + Equipment.StrengthBonus(StateHandle, CharacterId)
    ParticipantDefense[Slot, Index] = Characters.Defense(StateHandle, CharacterId) + Equipment.DefenseBonus(StateHandle, CharacterId)
    ParticipantMagic[Slot, Index] = Characters.Magic(StateHandle, CharacterId) + Equipment.MagicBonus(StateHandle, CharacterId)
    ParticipantResistance[Slot, Index] = Characters.Resistance(StateHandle, CharacterId) + Equipment.ResistanceBonus(StateHandle, CharacterId)
    ParticipantAgility[Slot, Index] = Characters.Agility(StateHandle, CharacterId) + Equipment.AgilityBonus(StateHandle, CharacterId)
    ParticipantLuck[Slot, Index] = Characters.Luck(StateHandle, CharacterId) + Equipment.LuckBonus(StateHandle, CharacterId)
    ActiveParticipantCounts[Slot] = Index + 1
    Return True

End Function

''' Sets the basic-Attack baseline for one side of the active battle. The final
''' chance also incorporates character growth, combat stats, and equipped bonuses.
Public Function ConfigureAttackBaseHitChance(
    StateHandle As Number,
    Side As Number,
    HitChancePercent As Number
) As Boolean

    Dim Slot As Number

    Slot = StateSlot(StateHandle)

    If (Slot < 0 Or
        Not BattleActive[Slot] Or
        (Side <> BATTLE_SIDE_PARTY And Side <> BATTLE_SIDE_ENEMY) Or
        HitChancePercent < 0 Or
        HitChancePercent > 100) Then
        Return False
    End If

    If Side = BATTLE_SIDE_PARTY Then
        PartyAttackBaseHitChances[Slot] = HitChancePercent
    Else

        EnemyAttackBaseHitChances[Slot] = HitChancePercent
    End If

    Return True

End Function

''' Returns the configured basic-Attack baseline for one side.
Public Function AttackBaseHitChance(StateHandle As Number, Side As Number) As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    Slot = StateSlot(StateHandle)

    If (Slot < 0 Or
        Not BattleActive[Slot] Or
        (Side <> BATTLE_SIDE_PARTY And Side <> BATTLE_SIDE_ENEMY)) Then
        Return 0
    End If

    If Side = BATTLE_SIDE_PARTY Then
        ReturnValue = PartyAttackBaseHitChances[Slot]

        Return ReturnValue
    End If

    ReturnValue = EnemyAttackBaseHitChances[Slot]

    Return ReturnValue

End Function

''' Supplies an application-owned weapon-skill or class-proficiency adjustment
''' for one active participant. Equipment statistic bonuses are already automatic.
Public Function ConfigureAttackProficiencyBonus(
    StateHandle As Number,
    ParticipantId As Number,
    BonusPercent As Number
) As Boolean

    Dim Slot As Number
    Dim Index As Number

    Slot = StateSlot(StateHandle)
    Index = ParticipantIndex(StateHandle, ParticipantId)

    If (Slot < 0 Or
        Not BattleActive[Slot] Or
        Index < 0 Or
        BonusPercent < -100 Or
        BonusPercent > 100) Then
        Return False
    End If

    ParticipantAttackProficiencyBonuses[Slot, Index] = BonusPercent

    Return True

End Function

''' Returns one participant's application-owned weapon/class proficiency bonus.
Public Function AttackProficiencyBonus(StateHandle As Number, ParticipantId As Number) As Number

    Dim Slot As Number
    Dim Index As Number
    Dim ReturnValue As Number

    Slot = StateSlot(StateHandle)
    Index = ParticipantIndex(StateHandle, ParticipantId)

    If Slot < 0 Or Not BattleActive[Slot] Or Index < 0 Then
        Return 0
    End If

    ReturnValue = ParticipantAttackProficiencyBonuses[Slot, Index]

    Return ReturnValue

End Function

''' Calculates the effective chance for one basic Attack. Party growth comes from
''' Level; Agility, Luck, Strength, Defense, and all equipped bonuses are already
''' frozen into the active participants. The PRNG only resolves this derived chance.
Public Function CalculatedAttackHitChance(
    StateHandle As Number,
    ActorId As Number,
    TargetId As Number
) As Number

    Dim Slot As Number
    Dim ActorIndex As Number
    Dim TargetIndex As Number
    Dim BaseChance As Number
    Dim LevelBonus As Number
    Dim StatisticAdjustment As Number
    Dim ReturnValue As Number

    Slot = StateSlot(StateHandle)
    ActorIndex = ParticipantIndex(StateHandle, ActorId)
    TargetIndex = ParticipantIndex(StateHandle, TargetId)

    If (Slot < 0 Or
        Not BattleActive[Slot] Or
        ActorIndex < 0 Or
        TargetIndex < 0 Or
        ParticipantSides[Slot, ActorIndex] = ParticipantSides[Slot, TargetIndex]) Then
        Return 0
    End If

    If ParticipantSides[Slot, ActorIndex] = BATTLE_SIDE_PARTY Then
        BaseChance = PartyAttackBaseHitChances[Slot]
        LevelBonus = Characters.Level(StateHandle, ParticipantReferenceIds[Slot, ActorIndex]) / 3
    Else

        BaseChance = EnemyAttackBaseHitChances[Slot]
    End If

    ''' A default 100 baseline preserves legacy guaranteed-hit behavior and does
    ''' not consume a PRNG value. Lower baselines opt into progression-aware accuracy.

    If BaseChance >= 100 Then
        Return 100
    End If

    StatisticAdjustment = (
        (ParticipantAgility[Slot, ActorIndex] - ParticipantAgility[Slot, TargetIndex]) / 6 +
        (ParticipantLuck[Slot, ActorIndex] - ParticipantLuck[Slot, TargetIndex]) / 8 +
        (ParticipantStrength[Slot, ActorIndex] - ParticipantDefense[Slot, TargetIndex]) / 20
    )
    ReturnValue = (
        BaseChance +
        LevelBonus +
        ParticipantAttackProficiencyBonuses[Slot, ActorIndex] +
        StatisticAdjustment
    )
    ReturnValue = Max(5, Min(100, ReturnValue))
    Return ReturnValue

End Function

Private Function AddEnemyParticipant(StateHandle As Number, EnemyId As Number, GroupId As Number, SlotId As Number) As Boolean

    Dim Slot As Number
    Dim DefinitionIndex As Number
    Dim Index As Number

    Slot = StateSlot(StateHandle)
    DefinitionIndex = EnemyIndex(StateHandle, EnemyId)

    If (Slot < 0 Or
        DefinitionIndex < 0 Or
        ActiveParticipantCounts[Slot] >= BATTLE_MAX_PARTICIPANTS) Then
        Return False
    End If

    Index = ActiveParticipantCounts[Slot]
    ParticipantSides[Slot, Index] = BATTLE_SIDE_ENEMY
    ParticipantReferenceIds[Slot, Index] = Index + 1
    ParticipantDefinitionIds[Slot, Index] = EnemyId
    ParticipantGroupIds[Slot, Index] = GroupId
    ParticipantSlotIds[Slot, Index] = SlotId
    ParticipantNames[Slot, Index] = EnemyNames[Slot, DefinitionIndex]
    ParticipantHealth[Slot, Index] = EnemyMaximumHealth[Slot, DefinitionIndex]
    ParticipantMaximumHealth[Slot, Index] = EnemyMaximumHealth[Slot, DefinitionIndex]
    ParticipantMagicPoints[Slot, Index] = EnemyMaximumMagicPoints[Slot, DefinitionIndex]
    ParticipantMaximumMagicPoints[Slot, Index] = EnemyMaximumMagicPoints[Slot, DefinitionIndex]
    ParticipantStrength[Slot, Index] = EnemyStrength[Slot, DefinitionIndex]
    ParticipantDefense[Slot, Index] = EnemyDefense[Slot, DefinitionIndex]
    ParticipantMagic[Slot, Index] = EnemyMagic[Slot, DefinitionIndex]
    ParticipantResistance[Slot, Index] = EnemyResistance[Slot, DefinitionIndex]
    ParticipantAgility[Slot, Index] = EnemyAgility[Slot, DefinitionIndex]
    ParticipantLuck[Slot, Index] = EnemyLuck[Slot, DefinitionIndex]
    ParticipantAiProfileIds[Slot, Index] = EnemyAiProfileIds[Slot, DefinitionIndex]
    RewardExperience[Slot] = RewardExperience[Slot] + EnemyExperienceRewards[Slot, DefinitionIndex]
    RewardGold[Slot] = RewardGold[Slot] + EnemyGoldRewards[Slot, DefinitionIndex]
    ActiveParticipantCounts[Slot] = Index + 1
    Return True

End Function

''' Registers one immutable enemy definition for the RPG state.
Public Function DefineEnemy(StateHandle As Number, ByRef Definition As EnemyDefinition) As Boolean

    Dim Slot As Number
    Dim Index As Number

    Slot = StateSlot(StateHandle)

    If (Slot < 0 Or
        Not Core.IsValidId(Definition.Id) Or
        Not Core.IsValidName(Definition.Name) Or
        Definition.MaximumHealth <= 0 Or
        Not Core.IsValidValue(Definition.MaximumHealth) Or
        Not Core.IsValidValue(Definition.MaximumMagicPoints) Or
        Not Core.IsValidValue(Definition.Strength) Or
        Not Core.IsValidValue(Definition.Defense) Or
        Not Core.IsValidValue(Definition.Magic) Or
        Not Core.IsValidValue(Definition.Resistance) Or
        Not Core.IsValidValue(Definition.Agility) Or
        Not Core.IsValidValue(Definition.Luck) Or
        Not Core.IsValidValue(Definition.ExperienceReward) Or
        Not Core.IsValidValue(Definition.GoldReward) Or
        Not Core.IsValidValue(Definition.AiProfileId) Or
        EnemyIndex(StateHandle, Definition.Id) >= 0 Or
        EnemyDefinitionCounts[Slot] >= BATTLE_MAX_ENEMY_DEFINITIONS) Then
        Return False
    End If

    Index = EnemyDefinitionCounts[Slot]
    EnemyIds[Slot, Index] = Definition.Id
    EnemyNames[Slot, Index] = Definition.Name
    EnemyMaximumHealth[Slot, Index] = Definition.MaximumHealth
    EnemyMaximumMagicPoints[Slot, Index] = Definition.MaximumMagicPoints
    EnemyStrength[Slot, Index] = Definition.Strength
    EnemyDefense[Slot, Index] = Definition.Defense
    EnemyMagic[Slot, Index] = Definition.Magic
    EnemyResistance[Slot, Index] = Definition.Resistance
    EnemyAgility[Slot, Index] = Definition.Agility
    EnemyLuck[Slot, Index] = Definition.Luck
    EnemyExperienceRewards[Slot, Index] = Definition.ExperienceReward
    EnemyGoldRewards[Slot, Index] = Definition.GoldReward
    EnemyAiProfileIds[Slot, Index] = Definition.AiProfileId
    EnemyDefinitionCounts[Slot] = Index + 1
    Return True

End Function

''' Registers one bounded enemy formation.
Public Function DefineFormation(StateHandle As Number, ByRef Definition As FormationDefinition) As Boolean

    Dim Slot As Number
    Dim Index As Number

    Slot = StateSlot(StateHandle)

    If (Slot < 0 Or
        Not Core.IsValidId(Definition.Id) Or
        Not Core.IsValidName(Definition.Name) Or
        Definition.EscapeChance < 0 Or
        Definition.EscapeChance > 100 Or
        FormationIndex(StateHandle, Definition.Id) >= 0 Or
        FormationCounts[Slot] >= BATTLE_MAX_FORMATIONS) Then
        Return False
    End If

    Index = FormationCounts[Slot]
    FormationIds[Slot, Index] = Definition.Id
    FormationNames[Slot, Index] = Definition.Name
    FormationEscapeChances[Slot, Index] = Definition.EscapeChance
    FormationMemberCounts[Slot, Index] = 0
    FormationCounts[Slot] = Index + 1
    Return True

End Function

''' Appends one enemy to an existing formation.
Public Function AddFormationMember(StateHandle As Number, ByRef Definition As FormationMemberDefinition) As Boolean

    Dim Slot As Number
    Dim Index As Number
    Dim MemberIndex As Number
    Dim ExistingIndex As Number
    Dim StoredIndex As Number

    Slot = StateSlot(StateHandle)
    Index = FormationIndex(StateHandle, Definition.FormationId)

    If (Slot < 0 Or
        Index < 0 Or
        EnemyIndex(StateHandle, Definition.EnemyId) < 0 Or
        Definition.GroupId <= 0 Or
        Definition.GroupId > BATTLE_MAX_ENEMY_GROUPS Or
        Definition.SlotId <= 0 Or
        Definition.SlotId > BATTLE_MAX_ENEMIES Or
        FormationMemberCounts[Slot, Index] >= BATTLE_MAX_FORMATION_MEMBERS) Then
        Return False
    End If

    For ExistingIndex = 0 To FormationMemberCounts[Slot, Index] - 1

        StoredIndex = Index * BATTLE_MAX_FORMATION_MEMBERS + ExistingIndex

        If FormationSlotIds[Slot, StoredIndex] = Definition.SlotId Then
            Return False
        End If

    End For

    MemberIndex = Index * BATTLE_MAX_FORMATION_MEMBERS + FormationMemberCounts[Slot, Index]
    FormationEnemyIds[Slot, MemberIndex] = Definition.EnemyId
    FormationGroupIds[Slot, MemberIndex] = Definition.GroupId
    FormationSlotIds[Slot, MemberIndex] = Definition.SlotId
    FormationMemberCounts[Slot, Index] = FormationMemberCounts[Slot, Index] + 1
    Return True

End Function

Public Function EnemyDefinitionCount(StateHandle As Number) As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    Slot = StateSlot(StateHandle)

    If Slot < 0 Then
        Return 0
    End If

    ReturnValue = EnemyDefinitionCounts[Slot]

    Return ReturnValue

End Function

Public Function FormationCount(StateHandle As Number) As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    Slot = StateSlot(StateHandle)

    If Slot < 0 Then
        Return 0
    End If

    ReturnValue = FormationCounts[Slot]

    Return ReturnValue

End Function

''' Begins a battle from the existing party and one registered formation.
Public Function BeginBattle(StateHandle As Number, FormationId As Number, Seed As Number) As Number

    Dim ReturnValue As Number

    Dim Slot As Number
    Dim Index As Number
    Dim PartyMemberCount As Number
    Dim FormationDefinitionIndex As Number
    Dim MemberIndex As Number
    Dim StoredIndex As Number
    Dim CharacterId As Number

    Slot = StateSlot(StateHandle)
    FormationDefinitionIndex = FormationIndex(StateHandle, FormationId)
    PartyMemberCount = Party.PartyCount(StateHandle)

    If (Slot < 0 Or
        BattleActive[Slot] Or
        FormationDefinitionIndex < 0 Or
        FormationMemberCounts[Slot, FormationDefinitionIndex] <= 0 Or
        PartyMemberCount <= 0 Or
        Seed < 0) Then
        Return 0
    End If

    Call ResetSession(Slot)

    If PartyMemberCount > BATTLE_MAX_PARTY_MEMBERS Then
        PartyMemberCount = BATTLE_MAX_PARTY_MEMBERS
    End If

    For Index = 0 To PartyMemberCount - 1

        CharacterId = Party.CharacterIdAt(StateHandle, Index)

        If Not AddPartyParticipant(StateHandle, CharacterId, Index) Then
            Call ResetSession(Slot)

            Return 0
        End If

    End For

    For MemberIndex = 0 To FormationMemberCounts[Slot, FormationDefinitionIndex] - 1

        StoredIndex = FormationDefinitionIndex * BATTLE_MAX_FORMATION_MEMBERS + MemberIndex

        If Not AddEnemyParticipant(StateHandle, FormationEnemyIds[Slot, StoredIndex], FormationGroupIds[Slot, StoredIndex], FormationSlotIds[Slot, StoredIndex]) Then
            Call ResetSession(Slot)

            Return 0
        End If

    End For

    BattleSerials[Slot] = BattleSerials[Slot] + 1

    If BattleSerials[Slot] > 9999 Then
        BattleSerials[Slot] = 1
    End If

    BattleHandles[Slot] = Core.StateGeneration(StateHandle) * 100000 + (Slot + 1) * 10000 + BattleSerials[Slot]
    BattleActive[Slot] = True
    BattlePhases[Slot] = BATTLE_PHASE_COMMAND
    BattleOutcomes[Slot] = BATTLE_OUTCOME_NONE
    BattleRounds[Slot] = 0
    BattleSeeds[Slot] = Seed Mod 65536
    ActiveFormationIds[Slot] = FormationId
    ActiveEscapeChances[Slot] = FormationEscapeChances[Slot, FormationDefinitionIndex]

    If Not AddEvent(StateHandle, BATTLE_EVENT_BATTLE_STARTED, 0, 0, FormationId, Seed, FormationNames[Slot, FormationDefinitionIndex]) Then

        Call ResetSession(Slot)

        BattleActive[Slot] = False

        Return 0

    End If

    ReturnValue = BattleHandles[Slot]

    Return ReturnValue

End Function

Public Function IsActive(StateHandle As Number) As Boolean

    Dim ReturnValue As Boolean

    Dim Slot As Number

    Slot = StateSlot(StateHandle)

    If Slot < 0 Then
        Return False
    End If

    ReturnValue = BattleActive[Slot]

    Return ReturnValue

End Function

