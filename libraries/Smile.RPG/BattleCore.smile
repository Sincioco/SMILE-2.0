Public Const BATTLE_EVENT_DEFEAT = 20
Public Const BATTLE_EVENT_ESCAPE = 21
Public Const BATTLE_EVENT_REWARD = 22
Public Const BATTLE_EVENT_MESSAGE = 23
Public Const BATTLE_EVENT_MISS = 24

Private Const CHECKPOINT_MAGIC_POINT_PAYMENT = 1
Private Const CHECKPOINT_ITEM_REMOVAL = 2
Private Const CHECKPOINT_FIRST_MULTI_TARGET = 3
Private Const CHECKPOINT_STATUS_COMPOSITE = 4
Private Const CHECKPOINT_FIRST_CHARACTER_REWARD = 5
