    Name As Text
    MaximumHealth As Number
    MaximumMagicPoints As Number
    Strength As Number
    Defense As Number
    Magic As Number
    Resistance As Number
    Agility As Number
    Luck As Number
    ExperienceReward As Number
    GoldReward As Number
    AiProfileId As Number
End Type

