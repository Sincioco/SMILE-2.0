Public Const BATTLE_MAX_ENEMIES = 8
Public Const BATTLE_MAX_ENEMY_GROUPS = 4
Public Const BATTLE_MAX_PARTICIPANTS = 12
Public Const BATTLE_MAX_ENEMY_DEFINITIONS = 64
Public Const BATTLE_MAX_FORMATIONS = 32
Public Const BATTLE_MAX_FORMATION_MEMBERS = 8
Public Const BATTLE_MAX_STATUSES_PER_PARTICIPANT = 8
Public Const BATTLE_MAX_EVENTS = 1024

Public Const BATTLE_SIDE_PARTY = 1
Public Const BATTLE_SIDE_ENEMY = 2

Public Const BATTLE_ACTION_ATTACK = 1
Public Const BATTLE_ACTION_ABILITY = 2
Public Const BATTLE_ACTION_ITEM = 3
Public Const BATTLE_ACTION_DEFEND = 4
Public Const BATTLE_ACTION_RUN = 5

Public Const BATTLE_PHASE_NONE = 0
Public Const BATTLE_PHASE_COMMAND = 1
Public Const BATTLE_PHASE_RESOLVING = 2
