    Dim Index As Number
    Dim ReturnValue As Boolean

    Index = ParticipantIndex(StateHandle, ParticipantId)

    If Index < 0 Then
        Return False
    End If

    ReturnValue = CurrentHealth(StateHandle, Index) > 0

    Return ReturnValue

End Function

Public Function Agility(StateHandle As Number, ParticipantId As Number) As Number

    Dim Slot As Number
    Dim Index As Number
    Dim Value As Number
    Dim StatusOffset As Number
    Dim StoredIndex As Number
    Dim StatusId As Number

    Slot = StateSlot(StateHandle)
    Index = ParticipantIndex(StateHandle, ParticipantId)

    If Slot < 0 Or Index < 0 Then
        Return 0
    End If

    Value = ParticipantAgility[Slot, Index]

    For StatusOffset = 0 To ParticipantStatusCounts[Slot, Index] - 1

        StoredIndex = StatusStorageIndex(Index, StatusOffset)
        StatusId = ParticipantStatusIds[Slot, StoredIndex]

        If (Effects.StatusKind(StateHandle, StatusId) = Effects.BATTLE_STATUS_STAT_MODIFIER And
            Effects.StatusStatistic(StateHandle, StatusId) = Effects.BATTLE_STAT_AGILITY) Then
            Value = Value + Effects.StatusValue(StateHandle, StatusId)
        End If

    End For

    If Value < 0 Then
        Value = 0
    End If

    Return Value

End Function

Public Function AiProfileId(StateHandle As Number, ParticipantId As Number) As Number

    Dim ReturnValue As Number

    Dim Slot As Number
    Dim Index As Number

    Slot = StateSlot(StateHandle)
    Index = ParticipantIndex(StateHandle, ParticipantId)

    If Slot < 0 Or Index < 0 Then
        Return 0
    End If

    ReturnValue = ParticipantAiProfileIds[Slot, Index]

    Return ReturnValue

End Function

Private Function StatusIndexOnParticipant(StateHandle As Number, ParticipantIndexValue As Number, StatusId As Number) As Number

    Dim ReturnValue As Number

    Dim Slot As Number
    Dim Index As Number
    Dim StoredIndex As Number

    Slot = StateSlot(StateHandle)

    If (Slot < 0 Or
        ParticipantIndexValue < 0 Or
        ParticipantIndexValue >= ActiveParticipantCounts[Slot]) Then
        ReturnValue = -1

        Return ReturnValue
    End If

    For Index = 0 To ParticipantStatusCounts[Slot, ParticipantIndexValue] - 1

        StoredIndex = StatusStorageIndex(ParticipantIndexValue, Index)

        If ParticipantStatusIds[Slot, StoredIndex] = StatusId Then
            Return Index
        End If

    End For

    ReturnValue = -1

    Return ReturnValue

End Function

Public Function StatusCount(StateHandle As Number, ParticipantId As Number) As Number

    Dim ReturnValue As Number

    Dim Slot As Number
    Dim Index As Number

    Slot = StateSlot(StateHandle)
    Index = ParticipantIndex(StateHandle, ParticipantId)

    If Slot < 0 Or Index < 0 Then
        Return 0
    End If

    ReturnValue = ParticipantStatusCounts[Slot, Index]

    Return ReturnValue

End Function

Public Function StatusIdAt(StateHandle As Number, ParticipantId As Number, Index As Number) As Number

    Dim ReturnValue As Number

    Dim Slot As Number
    Dim ParticipantIndexValue As Number
    Dim StoredIndex As Number

    Slot = StateSlot(StateHandle)
    ParticipantIndexValue = ParticipantIndex(StateHandle, ParticipantId)

    If (Slot < 0 Or
        ParticipantIndexValue < 0 Or
        Index < 0 Or
        Index >= ParticipantStatusCounts[Slot, ParticipantIndexValue]) Then
        Return 0
    End If

    StoredIndex = StatusStorageIndex(ParticipantIndexValue, Index)
    ReturnValue = ParticipantStatusIds[Slot, StoredIndex]

    Return ReturnValue

End Function

Public Function StatusDurationAt(StateHandle As Number, ParticipantId As Number, Index As Number) As Number

    Dim ReturnValue As Number

    Dim Slot As Number
    Dim ParticipantIndexValue As Number
    Dim StoredIndex As Number

    Slot = StateSlot(StateHandle)
    ParticipantIndexValue = ParticipantIndex(StateHandle, ParticipantId)

    If (Slot < 0 Or
        ParticipantIndexValue < 0 Or
        Index < 0 Or
        Index >= ParticipantStatusCounts[Slot, ParticipantIndexValue]) Then
        Return 0
    End If

    StoredIndex = StatusStorageIndex(ParticipantIndexValue, Index)
    ReturnValue = ParticipantStatusDurations[Slot, StoredIndex]

    Return ReturnValue

End Function

Private Function AddStatus(StateHandle As Number, ParticipantIndexValue As Number, StatusId As Number, Duration As Number) As Boolean

    Dim Slot As Number
    Dim Index As Number
    Dim StoredIndex As Number

    Slot = StateSlot(StateHandle)
    Index = StatusIndexOnParticipant(StateHandle, ParticipantIndexValue, StatusId)

    If (Slot < 0 Or
        Not Effects.IsStatusDefined(StateHandle, StatusId) Or
        Duration <= 0) Then
        Return False
    End If

    If Index >= 0 Then

        StoredIndex = StatusStorageIndex(ParticipantIndexValue, Index)

        If ParticipantStatusDurations[Slot, StoredIndex] < Duration Then
            ParticipantStatusDurations[Slot, StoredIndex] = Duration
        End If

        Return True

    End If

    If ParticipantStatusCounts[Slot, ParticipantIndexValue] >= BATTLE_MAX_STATUSES_PER_PARTICIPANT Then
        Return False
    End If

    Index = ParticipantStatusCounts[Slot, ParticipantIndexValue]
    StoredIndex = StatusStorageIndex(ParticipantIndexValue, Index)
    ParticipantStatusIds[Slot, StoredIndex] = StatusId
    ParticipantStatusDurations[Slot, StoredIndex] = Duration
    ParticipantStatusCounts[Slot, ParticipantIndexValue] = Index + 1
    Return True

End Function

Private Function RemoveStatus(StateHandle As Number, ParticipantIndexValue As Number, StatusId As Number) As Boolean

    Dim Slot As Number
    Dim Index As Number
    Dim MoveIndex As Number
    Dim StoredIndex As Number
    Dim NextStoredIndex As Number

    Slot = StateSlot(StateHandle)
    Index = StatusIndexOnParticipant(StateHandle, ParticipantIndexValue, StatusId)

    If Slot < 0 Or Index < 0 Then
        Return False
    End If

    For MoveIndex = Index To ParticipantStatusCounts[Slot, ParticipantIndexValue] - 2
        StoredIndex = StatusStorageIndex(ParticipantIndexValue, MoveIndex)
        NextStoredIndex = StatusStorageIndex(ParticipantIndexValue, MoveIndex + 1)
        ParticipantStatusIds[Slot, StoredIndex] = ParticipantStatusIds[Slot, NextStoredIndex]
        ParticipantStatusDurations[Slot, StoredIndex] = ParticipantStatusDurations[Slot, NextStoredIndex]
    End For

    ParticipantStatusCounts[Slot, ParticipantIndexValue] = ParticipantStatusCounts[Slot, ParticipantIndexValue] - 1
    StoredIndex = StatusStorageIndex(ParticipantIndexValue, ParticipantStatusCounts[Slot, ParticipantIndexValue])
    ParticipantStatusIds[Slot, StoredIndex] = 0
    ParticipantStatusDurations[Slot, StoredIndex] = 0
    Return True

End Function

Private Function IsTargetAliveRequirement(StateHandle As Number, EffectId As Number) As Number

    Dim ReturnValue As Number

    Dim ComponentIndexValue As Number

    For ComponentIndexValue = 0 To Effects.ComponentCount(StateHandle, EffectId) - 1

        If Effects.ComponentKindAt(StateHandle, EffectId, ComponentIndexValue) = Effects.BATTLE_EFFECT_REVIVE Then
            ReturnValue = -1

            Return ReturnValue
        End If

    End For

    Return 1

End Function

Private Function IsLegalTarget(StateHandle As Number, ActorIndex As Number, TargetIndex As Number, TargetMode As Number, EffectId As Number) As Boolean

    Dim ReturnValue As Boolean

    Dim Slot As Number
    Dim SameSide As Boolean
    Dim MustBeAlive As Number
    Dim TargetIsAlive As Boolean

    Slot = StateSlot(StateHandle)

    If (Slot < 0 Or
        ActorIndex < 0 Or
        TargetIndex < 0 Or
        ActorIndex >= ActiveParticipantCounts[Slot] Or
        TargetIndex >= ActiveParticipantCounts[Slot]) Then
        Return False
    End If

    SameSide = ParticipantSides[Slot, ActorIndex] = ParticipantSides[Slot, TargetIndex]

    If TargetMode = Core.RPG_TARGET_SELF And ActorIndex <> TargetIndex Then
        Return False
    Else If ((TargetMode = Core.RPG_TARGET_ONE_ALLY Or TargetMode = Core.RPG_TARGET_ALL_ALLIES) And
        Not SameSide) Then
        Return False
    Else If ((TargetMode = Core.RPG_TARGET_ONE_ENEMY Or TargetMode = Core.RPG_TARGET_ALL_ENEMIES) And
        SameSide) Then
        Return False
    End If

    MustBeAlive = IsTargetAliveRequirement(StateHandle, EffectId)
    TargetIsAlive = CurrentHealth(StateHandle, TargetIndex) > 0

    If MustBeAlive < 0 Then
        ReturnValue = Not TargetIsAlive

        Return ReturnValue
    End If

    Return TargetIsAlive

End Function

Private Function Retarget(StateHandle As Number, ActorIndex As Number, TargetIndex As Number, TargetMode As Number, EffectId As Number) As Number

    Dim ReturnValue As Number

    Dim Slot As Number
    Dim Index As Number

    Slot = StateSlot(StateHandle)

    If Slot < 0 Then
        ReturnValue = -1

        Return ReturnValue
    End If

    If IsLegalTarget(StateHandle, ActorIndex, TargetIndex, TargetMode, EffectId) Then
        Return TargetIndex
    End If

    For Index = 0 To ActiveParticipantCounts[Slot] - 1

        If IsLegalTarget(StateHandle, ActorIndex, Index, TargetMode, EffectId) Then
            Return Index
        End If

    End For

    ReturnValue = -1

    Return ReturnValue

End Function

''' Submits one participant action for the next deterministic round.
Public Function QueueAction(StateHandle As Number, ParticipantId As Number, ActionKind As Number, SourceId As Number, TargetParticipantId As Number) As Boolean

    Dim Slot As Number
    Dim Index As Number
    Dim TargetIndex As Number
    Dim CharacterId As Number
    Dim EffectId As Number
    Dim TargetMode As Number

    Slot = StateSlot(StateHandle)
    Index = ParticipantIndex(StateHandle, ParticipantId)
    TargetIndex = ParticipantIndex(StateHandle, TargetParticipantId)

    If (Slot < 0 Or
        Index < 0 Or
        BattlePhases[Slot] <> BATTLE_PHASE_COMMAND Or
        CurrentHealth(StateHandle, Index) <= 0 Or
        SubmittedActions[Slot, Index] Or
        ActionKind < BATTLE_ACTION_ATTACK Or
        ActionKind > BATTLE_ACTION_RUN) Then
        Return False
    End If

    If ActionKind = BATTLE_ACTION_ATTACK Then

        EffectId = 0
        TargetMode = Core.RPG_TARGET_ONE_ENEMY

        If SourceId <> 0 Or Retarget(StateHandle, Index, TargetIndex, TargetMode, EffectId) < 0 Then
            Return False
        End If

    Else If ActionKind = BATTLE_ACTION_ABILITY Then

        If ParticipantSides[Slot, Index] = BATTLE_SIDE_PARTY Then

            CharacterId = ParticipantReferenceIds[Slot, Index]

            If (Not Abilities.KnowsAbility(StateHandle, CharacterId, SourceId) Or
                Not Abilities.CanPayMagicPointCost(StateHandle, CharacterId, SourceId)) Then
                Return False
            End If

        Else If Not Abilities.IsAbilityDefined(StateHandle, SourceId) Then

            Return False

        End If

        EffectId = Abilities.EffectId(StateHandle, SourceId)
        TargetMode = Abilities.TargetMode(StateHandle, SourceId)

        If Not Effects.IsEffectDefined(StateHandle, EffectId) Then
            Return False
        End If

        If (TargetMode = Core.RPG_TARGET_SELF Or
            TargetMode = Core.RPG_TARGET_ONE_ALLY Or
            TargetMode = Core.RPG_TARGET_ONE_ENEMY) Then

            If Retarget(StateHandle, Index, TargetIndex, TargetMode, EffectId) < 0 Then
                Return False
            End If

        End If

    Else If ActionKind = BATTLE_ACTION_ITEM Then

        If ParticipantSides[Slot, Index] <> BATTLE_SIDE_PARTY Then
            Return False
        End If

        EffectId = Inventory.EffectId(StateHandle, SourceId)

        If (Inventory.Kind(StateHandle, SourceId) <> Core.RPG_ITEM_CONSUMABLE Or
            Inventory.Quantity(StateHandle, SourceId) <= 0 Or
            Not Effects.IsEffectDefined(StateHandle, EffectId) Or
            Retarget(StateHandle, Index, TargetIndex, Core.RPG_TARGET_ONE_ALLY, EffectId) < 0) Then
            Return False
        End If

    Else If ActionKind = BATTLE_ACTION_DEFEND Then

        If SourceId <> 0 Or TargetParticipantId <> 0 Then
            Return False
        End If

    Else If ActionKind = BATTLE_ACTION_RUN Then

        If (ParticipantSides[Slot, Index] <> BATTLE_SIDE_PARTY Or
            SourceId <> 0 Or
            TargetParticipantId <> 0) Then
            Return False
        End If

    End If

    SubmittedActions[Slot, Index] = True
    SubmittedActionKinds[Slot, Index] = ActionKind
    SubmittedSourceIds[Slot, Index] = SourceId
    SubmittedTargetIds[Slot, Index] = TargetParticipantId
    Return True

End Function

Private Function HasActionDenyStatus(StateHandle As Number, ParticipantIndexValue As Number) As Boolean

    Dim Slot As Number
    Dim Index As Number
    Dim StoredIndex As Number
    Dim StatusId As Number

    Slot = StateSlot(StateHandle)

    If Slot < 0 Then
        Return False
    End If

    For Index = 0 To ParticipantStatusCounts[Slot, ParticipantIndexValue] - 1

        StoredIndex = StatusStorageIndex(ParticipantIndexValue, Index)
        StatusId = ParticipantStatusIds[Slot, StoredIndex]

        If Effects.StatusKind(StateHandle, StatusId) = Effects.BATTLE_STATUS_ACTION_DENY Then
            Return True
        End If

    End For

    Return False

End Function

Private Sub SortSchedule(StateHandle As Number)

    Dim Slot As Number
    Dim Index As Number
    Dim CompareIndex As Number
    Dim LeftParticipant As Number
    Dim RightParticipant As Number
    Dim SwapValue As Number
    Dim LeftAgility As Number
    Dim RightAgility As Number

    Slot = StateSlot(StateHandle)

    For Index = 0 To ScheduleCounts[Slot] - 2

        For CompareIndex = Index + 1 To ScheduleCounts[Slot] - 1

            LeftParticipant = ScheduleParticipantIndexes[Slot, Index]
            RightParticipant = ScheduleParticipantIndexes[Slot, CompareIndex]
            LeftAgility = Agility(StateHandle, LeftParticipant + 1)
            RightAgility = Agility(StateHandle, RightParticipant + 1)

            If (RightAgility > LeftAgility Or
                (RightAgility = LeftAgility And RightParticipant < LeftParticipant)) Then

                SwapValue = ScheduleParticipantIndexes[Slot, Index]
                ScheduleParticipantIndexes[Slot, Index] = ScheduleParticipantIndexes[Slot, CompareIndex]
                ScheduleParticipantIndexes[Slot, CompareIndex] = SwapValue

            End If

        End For
    End For

End Sub

''' Freezes submitted actions and starts their deterministic agility schedule.
Public Function StartRound(StateHandle As Number) As Boolean

    Dim ReturnValue As Boolean

    Dim Slot As Number
    Dim Index As Number

    Slot = StateSlot(StateHandle)

    If (Slot < 0 Or
        Not BattleActive[Slot] Or
        BattlePhases[Slot] <> BATTLE_PHASE_COMMAND) Then
        Return False
    End If

    ScheduleCounts[Slot] = 0
    SchedulePositions[Slot] = 0

    For Index = 0 To ActiveParticipantCounts[Slot] - 1

        If SubmittedActions[Slot, Index] And CurrentHealth(StateHandle, Index) > 0 Then
            ScheduleParticipantIndexes[Slot, ScheduleCounts[Slot]] = Index
            ScheduleCounts[Slot] = ScheduleCounts[Slot] + 1
        End If

    End For

    If ScheduleCounts[Slot] <= 0 Or EventCounts[Slot] > BATTLE_MAX_EVENTS - 32 Then
        Return False
    End If

    Call SortSchedule(StateHandle)

    BattleRounds[Slot] = BattleRounds[Slot] + 1
    BattlePhases[Slot] = BATTLE_PHASE_RESOLVING

    ReturnValue = AddEvent(StateHandle, BATTLE_EVENT_ROUND_STARTED, 0, 0, BattleRounds[Slot], ScheduleCounts[Slot], "Round started")

    Return ReturnValue

End Function

Private Sub BackupTransaction(StateHandle As Number)

    Dim Slot As Number
    Dim Index As Number
    Dim StatusOffset As Number
    Dim StoredIndex As Number

    Slot = StateSlot(StateHandle)
    BackupEventCounts[Slot] = EventCounts[Slot]
    BackupSeeds[Slot] = BattleSeeds[Slot]
    BackupItemIds[Slot] = 0
    BackupItemQuantities[Slot] = 0

    For Index = 0 To ActiveParticipantCounts[Slot] - 1

        BackupHealth[Slot, Index] = CurrentHealth(StateHandle, Index)
        BackupMagicPoints[Slot, Index] = CurrentMagicPoints(StateHandle, Index)
        BackupDefending[Slot, Index] = ParticipantDefending[Slot, Index]
        BackupStatusCounts[Slot, Index] = ParticipantStatusCounts[Slot, Index]

        For StatusOffset = 0 To BATTLE_MAX_STATUSES_PER_PARTICIPANT - 1
            StoredIndex = StatusStorageIndex(Index, StatusOffset)
            BackupStatusIds[Slot, StoredIndex] = ParticipantStatusIds[Slot, StoredIndex]
            BackupStatusDurations[Slot, StoredIndex] = ParticipantStatusDurations[Slot, StoredIndex]
        End For
    End For

End Sub

Private Sub RestoreTransaction(StateHandle As Number)

    Dim Slot As Number
    Dim Index As Number
    Dim StatusOffset As Number
    Dim StoredIndex As Number
    Dim Ignored As Boolean
    Dim CurrentItemQuantity As Number

    Slot = StateSlot(StateHandle)
    EventCounts[Slot] = BackupEventCounts[Slot]
    BattleSeeds[Slot] = BackupSeeds[Slot]

    If BackupItemIds[Slot] > 0 Then

        CurrentItemQuantity = Inventory.Quantity(StateHandle, BackupItemIds[Slot])

        If CurrentItemQuantity < BackupItemQuantities[Slot] Then
            Ignored = Inventory.AddItem(StateHandle, BackupItemIds[Slot], BackupItemQuantities[Slot] - CurrentItemQuantity)
        Else If CurrentItemQuantity > BackupItemQuantities[Slot] Then
            Ignored = Inventory.RemoveItem(StateHandle, BackupItemIds[Slot], CurrentItemQuantity - BackupItemQuantities[Slot])
        End If

    End If

    For Index = 0 To ActiveParticipantCounts[Slot] - 1

        Ignored = SetCurrentHealth(StateHandle, Index, BackupHealth[Slot, Index])
        Ignored = SetCurrentMagicPoints(StateHandle, Index, BackupMagicPoints[Slot, Index])

        ParticipantDefending[Slot, Index] = BackupDefending[Slot, Index]
        ParticipantStatusCounts[Slot, Index] = BackupStatusCounts[Slot, Index]

        For StatusOffset = 0 To BATTLE_MAX_STATUSES_PER_PARTICIPANT - 1
            StoredIndex = StatusStorageIndex(Index, StatusOffset)
            ParticipantStatusIds[Slot, StoredIndex] = BackupStatusIds[Slot, StoredIndex]
            ParticipantStatusDurations[Slot, StoredIndex] = BackupStatusDurations[Slot, StoredIndex]
        End For
    End For

End Sub

Private Function CommitCheckpoint(Checkpoint As Number) As Boolean

    Dim ReturnValue As Boolean

    ReturnValue = Checkpoint >= CHECKPOINT_MAGIC_POINT_PAYMENT And Checkpoint <= CHECKPOINT_GOLD_REWARD

    Return ReturnValue

End Function

Private Function StatisticValue(StateHandle As Number, ParticipantIndexValue As Number, Statistic As Number) As Number

    Dim Slot As Number
    Dim Value As Number
    Dim StatusOffset As Number
    Dim StoredIndex As Number
    Dim StatusId As Number

    Slot = StateSlot(StateHandle)

    If Statistic = Effects.BATTLE_STAT_STRENGTH Then
        Value = ParticipantStrength[Slot, ParticipantIndexValue]
    Else If Statistic = Effects.BATTLE_STAT_DEFENSE Then
        Value = ParticipantDefense[Slot, ParticipantIndexValue]
    Else If Statistic = Effects.BATTLE_STAT_MAGIC Then
        Value = ParticipantMagic[Slot, ParticipantIndexValue]
    Else If Statistic = Effects.BATTLE_STAT_RESISTANCE Then
        Value = ParticipantResistance[Slot, ParticipantIndexValue]
    Else If Statistic = Effects.BATTLE_STAT_AGILITY Then
        Value = ParticipantAgility[Slot, ParticipantIndexValue]
    Else If Statistic = Effects.BATTLE_STAT_LUCK Then
        Value = ParticipantLuck[Slot, ParticipantIndexValue]
    End If

    For StatusOffset = 0 To ParticipantStatusCounts[Slot, ParticipantIndexValue] - 1

        StoredIndex = StatusStorageIndex(ParticipantIndexValue, StatusOffset)
        StatusId = ParticipantStatusIds[Slot, StoredIndex]

        If (Effects.StatusKind(StateHandle, StatusId) = Effects.BATTLE_STATUS_STAT_MODIFIER And
            Effects.StatusStatistic(StateHandle, StatusId) = Statistic) Then
            Value = Value + Effects.StatusValue(StateHandle, StatusId)
        End If

    End For

    If Value < 0 Then
        Value = 0
    End If

    Return Value

End Function

Private Function ApplyDamage(StateHandle As Number, ActorIndex As Number, TargetIndex As Number, Power As Number, MagicDamage As Boolean) As Boolean

    Dim ReturnValue As Boolean

    Dim Slot As Number
    Dim AttackValue As Number
    Dim DefenseValue As Number
    Dim DamageValue As Number
    Dim OldHealth As Number
    Dim NewHealth As Number

    Slot = StateSlot(StateHandle)

    If MagicDamage Then
        AttackValue = StatisticValue(StateHandle, ActorIndex, Effects.BATTLE_STAT_MAGIC)
        DefenseValue = StatisticValue(StateHandle, TargetIndex, Effects.BATTLE_STAT_RESISTANCE)
    Else
        AttackValue = StatisticValue(StateHandle, ActorIndex, Effects.BATTLE_STAT_STRENGTH)
        DefenseValue = StatisticValue(StateHandle, TargetIndex, Effects.BATTLE_STAT_DEFENSE)
    End If

    DamageValue = AttackValue + Power + (NextRandom(StateHandle) Mod 5) - DefenseValue / 2

    If DamageValue < 1 Then
        DamageValue = 1
    End If

    If ParticipantDefending[Slot, TargetIndex] Then
        DamageValue = (DamageValue + 1) / 2
    End If

    OldHealth = CurrentHealth(StateHandle, TargetIndex)
    NewHealth = OldHealth - DamageValue

    If NewHealth < 0 Then
        NewHealth = 0
    End If

    If Not SetCurrentHealth(StateHandle, TargetIndex, NewHealth) Then
        Return False
    End If

    If Not AddEvent(StateHandle, BATTLE_EVENT_DAMAGE, ActorIndex + 1, TargetIndex + 1, OldHealth - NewHealth, NewHealth, "Damage") Then
        Return False
    End If

    If NewHealth = 0 Then
        ReturnValue = AddEvent(StateHandle, BATTLE_EVENT_DEFEATED, ActorIndex + 1, TargetIndex + 1, 0, 0, ParticipantNames[Slot, TargetIndex] + " was defeated")

        Return ReturnValue
    End If

    Return True

End Function

Private Function ApplyComponent(StateHandle As Number, ActorIndex As Number, TargetIndex As Number, EffectId As Number, ComponentIndexValue As Number) As Boolean

    Dim ReturnValue As Boolean

    Dim Slot As Number
    Dim Kind As Number
    Dim Power As Number
    Dim StatusId As Number
    Dim Duration As Number
    Dim OldValue As Number
    Dim NewValue As Number

    Slot = StateSlot(StateHandle)
    Kind = Effects.ComponentKindAt(StateHandle, EffectId, ComponentIndexValue)
    Power = Effects.ComponentPowerAt(StateHandle, EffectId, ComponentIndexValue)
    StatusId = Effects.ComponentStatusIdAt(StateHandle, EffectId, ComponentIndexValue)
    Duration = Effects.ComponentDurationAt(StateHandle, EffectId, ComponentIndexValue)

    If Kind = Effects.BATTLE_EFFECT_PHYSICAL_DAMAGE Then

        ReturnValue = ApplyDamage(StateHandle, ActorIndex, TargetIndex, Power, False)

        Return ReturnValue

    Else If Kind = Effects.BATTLE_EFFECT_MAGIC_DAMAGE Then

        ReturnValue = ApplyDamage(StateHandle, ActorIndex, TargetIndex, Power, True)

        Return ReturnValue

    Else If Kind = Effects.BATTLE_EFFECT_HEAL_HEALTH Then

        OldValue = CurrentHealth(StateHandle, TargetIndex)
        NewValue = OldValue + Power

        If NewValue > CurrentMaximumHealth(StateHandle, TargetIndex) Then
            NewValue = CurrentMaximumHealth(StateHandle, TargetIndex)
        End If

        If Not SetCurrentHealth(StateHandle, TargetIndex, NewValue) Then
            Return False
        End If

        ReturnValue = AddEvent(StateHandle, BATTLE_EVENT_HEAL, ActorIndex + 1, TargetIndex + 1, NewValue - OldValue, NewValue, "Health restored")

        Return ReturnValue

    Else If Kind = Effects.BATTLE_EFFECT_RESTORE_MAGIC_POINTS Then

        OldValue = CurrentMagicPoints(StateHandle, TargetIndex)
        NewValue = OldValue + Power

        If NewValue > CurrentMaximumMagicPoints(StateHandle, TargetIndex) Then
            NewValue = CurrentMaximumMagicPoints(StateHandle, TargetIndex)
        End If

        If Not SetCurrentMagicPoints(StateHandle, TargetIndex, NewValue) Then
            Return False
        End If

        ReturnValue = AddEvent(StateHandle, BATTLE_EVENT_MAGIC_POINTS, ActorIndex + 1, TargetIndex + 1, NewValue - OldValue, NewValue, "Magic Points restored")

        Return ReturnValue

    Else If Kind = Effects.BATTLE_EFFECT_APPLY_STATUS Then

        If Not AddStatus(StateHandle, TargetIndex, StatusId, Duration) Then
            Return False
        End If

        ReturnValue = AddEvent(StateHandle, BATTLE_EVENT_STATUS_APPLIED, ActorIndex + 1, TargetIndex + 1, StatusId, Duration, Effects.StatusName(StateHandle, StatusId))

        Return ReturnValue

    Else If Kind = Effects.BATTLE_EFFECT_REMOVE_STATUS Then

        If StatusIndexOnParticipant(StateHandle, TargetIndex, StatusId) < 0 Then
            Return True
        End If

        If Not RemoveStatus(StateHandle, TargetIndex, StatusId) Then
            Return False
        End If

        ReturnValue = AddEvent(StateHandle, BATTLE_EVENT_STATUS_REMOVED, ActorIndex + 1, TargetIndex + 1, StatusId, 0, Effects.StatusName(StateHandle, StatusId))

        Return ReturnValue

    Else If Kind = Effects.BATTLE_EFFECT_REVIVE Then

        If CurrentHealth(StateHandle, TargetIndex) > 0 Then
            Return False
        End If

        NewValue = Power

        If NewValue < 1 Then
            NewValue = 1
        End If

        If NewValue > CurrentMaximumHealth(StateHandle, TargetIndex) Then
            NewValue = CurrentMaximumHealth(StateHandle, TargetIndex)
        End If

        If Not SetCurrentHealth(StateHandle, TargetIndex, NewValue) Then
            Return False
        End If

        ReturnValue = AddEvent(StateHandle, BATTLE_EVENT_REVIVED, ActorIndex + 1, TargetIndex + 1, NewValue, 0, "Revived")

        Return ReturnValue

    End If

    Return False

End Function

Private Function ApplyEffectToTarget(StateHandle As Number, ActorIndex As Number, TargetIndex As Number, EffectId As Number) As Boolean

    Dim ComponentIndexValue As Number

    For ComponentIndexValue = 0 To Effects.ComponentCount(StateHandle, EffectId) - 1

        If Not ApplyComponent(StateHandle, ActorIndex, TargetIndex, EffectId, ComponentIndexValue) Then
            Return False
        End If

        If Effects.ComponentKindAt(StateHandle, EffectId, ComponentIndexValue) = Effects.BATTLE_EFFECT_APPLY_STATUS Then

            If Not CommitCheckpoint(CHECKPOINT_STATUS_COMPOSITE) Then
                Return False
            End If

        End If

    End For

    Return True

End Function

Private Function ApplyEffect(StateHandle As Number, ActorIndex As Number, TargetIndex As Number, EffectId As Number, TargetMode As Number) As Boolean

    Dim ReturnValue As Boolean

    Dim Slot As Number
    Dim Index As Number
    Dim AppliedCount As Number
    Dim ActualTarget As Number

    Slot = StateSlot(StateHandle)

    If (TargetMode = Core.RPG_TARGET_SELF Or
        TargetMode = Core.RPG_TARGET_ONE_ALLY Or
        TargetMode = Core.RPG_TARGET_ONE_ENEMY) Then

        ActualTarget = Retarget(StateHandle, ActorIndex, TargetIndex, TargetMode, EffectId)

        If ActualTarget < 0 Then
            Return False
        End If

        ReturnValue = ApplyEffectToTarget(StateHandle, ActorIndex, ActualTarget, EffectId)

        Return ReturnValue

    End If

    For Index = 0 To ActiveParticipantCounts[Slot] - 1

        If IsLegalTarget(StateHandle, ActorIndex, Index, TargetMode, EffectId) Then

            If Not ApplyEffectToTarget(StateHandle, ActorIndex, Index, EffectId) Then
                Return False
            End If

            AppliedCount = AppliedCount + 1

            If AppliedCount = 1 Then

                If Not CommitCheckpoint(CHECKPOINT_FIRST_MULTI_TARGET) Then
                    Return False
                End If

            End If

        End If

    End For

    ReturnValue = AppliedCount > 0

    Return ReturnValue

End Function

Private Function ExecuteAttack(StateHandle As Number, ActorIndex As Number, TargetIndex As Number) As Boolean

    Dim ReturnValue As Boolean

    Dim ActualTarget As Number
    Dim HitChance As Number
    Dim Roll As Number

    ActualTarget = Retarget(StateHandle, ActorIndex, TargetIndex, Core.RPG_TARGET_ONE_ENEMY, 0)

    If ActualTarget < 0 Then
        Return True
    End If

    If Not AddEvent(StateHandle, BATTLE_EVENT_ATTACK, ActorIndex + 1, ActualTarget + 1, 0, 0, "Attack") Then
        Return False
    End If

    HitChance = CalculatedAttackHitChance(StateHandle, ActorIndex + 1, ActualTarget + 1)

    If HitChance < 100 Then

        Roll = NextRandom(StateHandle) Mod 100

        If Roll >= HitChance Then
            ReturnValue = AddEvent(StateHandle, BATTLE_EVENT_MISS, ActorIndex + 1, ActualTarget + 1, Roll, HitChance, "Miss")

            Return ReturnValue
        End If

    End If

    ReturnValue = ApplyDamage(StateHandle, ActorIndex, ActualTarget, 0, False)

    Return ReturnValue

End Function

Private Function ExecuteAbility(StateHandle As Number, ActorIndex As Number, SourceId As Number, TargetIndex As Number) As Boolean

    Dim ReturnValue As Boolean

    Dim Slot As Number
    Dim CharacterId As Number
    Dim Cost As Number
    Dim OldMagicPoints As Number
    Dim EffectId As Number
    Dim TargetMode As Number

    Slot = StateSlot(StateHandle)
    Cost = Abilities.MagicPointCost(StateHandle, SourceId)
    EffectId = Abilities.EffectId(StateHandle, SourceId)
    TargetMode = Abilities.TargetMode(StateHandle, SourceId)
    OldMagicPoints = CurrentMagicPoints(StateHandle, ActorIndex)

    If OldMagicPoints < Cost Then
        Return False
    End If

    If ParticipantSides[Slot, ActorIndex] = BATTLE_SIDE_PARTY Then

        CharacterId = ParticipantReferenceIds[Slot, ActorIndex]

        If Not Abilities.PayMagicPointCost(StateHandle, CharacterId, SourceId) Then
            Return False
        End If

    Else If Not SetCurrentMagicPoints(StateHandle, ActorIndex, OldMagicPoints - Cost) Then

        Return False

    End If

    If Not CommitCheckpoint(CHECKPOINT_MAGIC_POINT_PAYMENT) Then
        Return False
    End If

    If Not AddEvent(StateHandle, BATTLE_EVENT_ABILITY, ActorIndex + 1, TargetIndex + 1, SourceId, Cost, Abilities.Name(StateHandle, SourceId)) Then
        Return False
    End If

    ReturnValue = ApplyEffect(StateHandle, ActorIndex, TargetIndex, EffectId, TargetMode)

    Return ReturnValue

End Function

Private Function ExecuteItem(StateHandle As Number, ActorIndex As Number, SourceId As Number, TargetIndex As Number) As Boolean

    Dim ReturnValue As Boolean

    Dim EffectId As Number

    EffectId = Inventory.EffectId(StateHandle, SourceId)

    If Not Inventory.RemoveItem(StateHandle, SourceId, 1) Then
        Return False
    End If

    If Not CommitCheckpoint(CHECKPOINT_ITEM_REMOVAL) Then
        Return False
    End If

    If Not AddEvent(StateHandle, BATTLE_EVENT_ITEM, ActorIndex + 1, TargetIndex + 1, SourceId, 1, Inventory.Name(StateHandle, SourceId)) Then
        Return False
    End If

    ReturnValue = ApplyEffect(StateHandle, ActorIndex, TargetIndex, EffectId, Core.RPG_TARGET_ONE_ALLY)

    Return ReturnValue

End Function

Private Function ExecuteRun(StateHandle As Number, ActorIndex As Number) As Boolean

    Dim ReturnValue As Boolean

    Dim Slot As Number
    Dim Roll As Number

    Slot = StateSlot(StateHandle)
    Roll = NextRandom(StateHandle) Mod 100

    If Roll < ActiveEscapeChances[Slot] Then

        BattleOutcomes[Slot] = BATTLE_OUTCOME_ESCAPED
        BattlePhases[Slot] = BATTLE_PHASE_ESCAPED

        If Not AddEvent(StateHandle, BATTLE_EVENT_RUN_SUCCEEDED, ActorIndex + 1, 0, Roll, ActiveEscapeChances[Slot], "Run succeeded") Then
            Return False
        End If

        ReturnValue = AddEvent(StateHandle, BATTLE_EVENT_ESCAPE, 0, 0, 0, 0, "The party escaped")

        Return ReturnValue

    End If

    ReturnValue = AddEvent(StateHandle, BATTLE_EVENT_RUN_FAILED, ActorIndex + 1, 0, Roll, ActiveEscapeChances[Slot], "Run failed")

    Return ReturnValue

End Function

Private Function ExecuteAction(StateHandle As Number, ParticipantIndexValue As Number) As Boolean

    Dim Slot As Number
    Dim ActionKind As Number
    Dim SourceId As Number
    Dim TargetId As Number
    Dim TargetIndex As Number
    Dim OldItemQuantity As Number
    Dim ActionSucceeded As Boolean
    Dim Ignored As Boolean

    Slot = StateSlot(StateHandle)
    ActionKind = SubmittedActionKinds[Slot, ParticipantIndexValue]
    SourceId = SubmittedSourceIds[Slot, ParticipantIndexValue]
    TargetId = SubmittedTargetIds[Slot, ParticipantIndexValue]
    TargetIndex = ParticipantIndex(StateHandle, TargetId)

    If CurrentHealth(StateHandle, ParticipantIndexValue) <= 0 Then
        Return True
    End If

    Call BackupTransaction(StateHandle)

    If ActionKind = BATTLE_ACTION_ITEM Then

        OldItemQuantity = Inventory.Quantity(StateHandle, SourceId)
        BackupItemIds[Slot] = SourceId
        BackupItemQuantities[Slot] = OldItemQuantity

    End If

    ParticipantDefending[Slot, ParticipantIndexValue] = False

    If Not AddEvent(StateHandle, BATTLE_EVENT_ACTION_STARTED, ParticipantIndexValue + 1, TargetId, ActionKind, SourceId, ParticipantNames[Slot, ParticipantIndexValue]) Then
        Call RestoreTransaction(StateHandle)

        Return False
    End If

    If HasActionDenyStatus(StateHandle, ParticipantIndexValue) Then
        ActionSucceeded = AddEvent(StateHandle, BATTLE_EVENT_ACTION_DENIED, ParticipantIndexValue + 1, 0, 0, 0, "Action denied")
    Else If ActionKind = BATTLE_ACTION_ATTACK Then
        ActionSucceeded = ExecuteAttack(StateHandle, ParticipantIndexValue, TargetIndex)
    Else If ActionKind = BATTLE_ACTION_ABILITY Then
        ActionSucceeded = ExecuteAbility(StateHandle, ParticipantIndexValue, SourceId, TargetIndex)
    Else If ActionKind = BATTLE_ACTION_ITEM Then
        ActionSucceeded = ExecuteItem(StateHandle, ParticipantIndexValue, SourceId, TargetIndex)
    Else If ActionKind = BATTLE_ACTION_DEFEND Then
        ParticipantDefending[Slot, ParticipantIndexValue] = True
        ActionSucceeded = AddEvent(StateHandle, BATTLE_EVENT_DEFEND, ParticipantIndexValue + 1, ParticipantIndexValue + 1, 0, 0, "Defend")
    Else If ActionKind = BATTLE_ACTION_RUN Then
        ActionSucceeded = ExecuteRun(StateHandle, ParticipantIndexValue)
    End If

    If Not ActionSucceeded Then

        Call RestoreTransaction(StateHandle)

        If (ActionKind = BATTLE_ACTION_ITEM And
            Inventory.Quantity(StateHandle, SourceId) < OldItemQuantity) Then
            Ignored = Inventory.AddItem(StateHandle, SourceId, OldItemQuantity - Inventory.Quantity(StateHandle, SourceId))
        End If

        Return False

    End If

    Return True

End Function

Private Function SideHasLivingParticipant(StateHandle As Number, Side As Number) As Boolean

    Dim Slot As Number
    Dim Index As Number

    Slot = StateSlot(StateHandle)

    For Index = 0 To ActiveParticipantCounts[Slot] - 1

        If ParticipantSides[Slot, Index] = Side And CurrentHealth(StateHandle, Index) > 0 Then
            Return True
        End If

    End For

    Return False

End Function

Private Function CommitRewards(StateHandle As Number) As Boolean

    Dim ReturnValue As Boolean

    Dim Slot As Number
    Dim Index As Number
    Dim CharacterId As Number
    Dim CharacterCount As Number
    Dim OldGold As Number
    Dim OldExperience[4] As Number

    Slot = StateSlot(StateHandle)

    If RewardsCommitted[Slot] Then
        Return True
    End If

    OldGold = Party.Gold(StateHandle)

    For Index = 0 To ActiveParticipantCounts[Slot] - 1

        If ParticipantSides[Slot, Index] = BATTLE_SIDE_PARTY Then

            CharacterId = ParticipantReferenceIds[Slot, Index]

            If Characters.Experience(StateHandle, CharacterId) > Core.RPG_MAX_VALUE - RewardExperience[Slot] Then
                Return False
            End If

            OldExperience[CharacterCount] = Characters.Experience(StateHandle, CharacterId)
            CharacterCount = CharacterCount + 1

        End If

    End For

    If OldGold > Core.RPG_MAX_VALUE - RewardGold[Slot] Then
        Return False
    End If

    CharacterCount = 0

    For Index = 0 To ActiveParticipantCounts[Slot] - 1

        If ParticipantSides[Slot, Index] = BATTLE_SIDE_PARTY Then

            CharacterId = ParticipantReferenceIds[Slot, Index]

            If Not Characters.AddExperience(StateHandle, CharacterId, RewardExperience[Slot]) Then
                Call RollbackRewards(StateHandle, CharacterCount, OldGold)

                Return False
            End If

            CharacterCount = CharacterCount + 1

            If CharacterCount = 1 Then

                If Not CommitCheckpoint(CHECKPOINT_FIRST_CHARACTER_REWARD) Then
                    Call RollbackRewardsWithValues(StateHandle, CharacterCount, OldGold, OldExperience[0], OldExperience[1], OldExperience[2], OldExperience[3])

                    Return False
                End If

            End If

        End If

    End For

    If Not Party.AddGold(StateHandle, RewardGold[Slot]) Then
        Call RollbackRewardsWithValues(StateHandle, CharacterCount, OldGold, OldExperience[0], OldExperience[1], OldExperience[2], OldExperience[3])

        Return False
    End If

    If Not CommitCheckpoint(CHECKPOINT_GOLD_REWARD) Then
        Call RollbackRewardsWithValues(StateHandle, CharacterCount, OldGold, OldExperience[0], OldExperience[1], OldExperience[2], OldExperience[3])

        Return False
    End If

    ReturnValue = AddEvent(StateHandle, BATTLE_EVENT_REWARD, 0, 0, RewardExperience[Slot], RewardGold[Slot], "Battle rewards")

    If Not ReturnValue Then
        Call RollbackRewardsWithValues(StateHandle, CharacterCount, OldGold, OldExperience[0], OldExperience[1], OldExperience[2], OldExperience[3])

        Return False
    End If

    RewardsCommitted[Slot] = True

    Return ReturnValue

End Function

Private Sub RollbackRewards(StateHandle As Number, CharacterCount As Number, OldGold As Number)

    Dim Index As Number
    Dim CharacterId As Number
    Dim Ignored As Boolean

    For Index = 0 To CharacterCount - 1
        CharacterId = ParticipantReferenceIds[StateSlot(StateHandle), Index]
        Ignored = Characters.SetExperience(StateHandle, CharacterId, Characters.Experience(StateHandle, CharacterId) - RewardExperience[StateSlot(StateHandle)])
    End For

    Ignored = Party.SetGold(StateHandle, OldGold)

End Sub

Private Sub RollbackRewardsWithValues(StateHandle As Number, CharacterCount As Number, OldGold As Number, ExperienceZero As Number, ExperienceOne As Number, ExperienceTwo As Number, ExperienceThree As Number)

    Dim Slot As Number
    Dim Index As Number
    Dim CharacterId As Number
    Dim OldExperience As Number
    Dim Ignored As Boolean

    Slot = StateSlot(StateHandle)

    For Index = 0 To CharacterCount - 1

        CharacterId = ParticipantReferenceIds[Slot, Index]

        If Index = 0 Then
            OldExperience = ExperienceZero
        Else If Index = 1 Then
            OldExperience = ExperienceOne
        Else If Index = 2 Then
            OldExperience = ExperienceTwo
        Else
            OldExperience = ExperienceThree
        End If

        Ignored = Characters.SetExperience(StateHandle, CharacterId, OldExperience)
    End For

    Ignored = Party.SetGold(StateHandle, OldGold)

End Sub

Private Function CheckOutcome(StateHandle As Number) As Boolean

    Dim ReturnValue As Boolean

    Dim Slot As Number

    Slot = StateSlot(StateHandle)

    If BattleOutcomes[Slot] <> BATTLE_OUTCOME_NONE Then
        Return True
    End If

    If Not SideHasLivingParticipant(StateHandle, BATTLE_SIDE_ENEMY) Then

        If EventCounts[Slot] > BATTLE_MAX_EVENTS - 2 Then
            Return False
        End If

        If Not CommitRewards(StateHandle) Then
            Return False
        End If

        BattleOutcomes[Slot] = BATTLE_OUTCOME_VICTORY
        BattlePhases[Slot] = BATTLE_PHASE_VICTORY
        ReturnValue = AddEvent(StateHandle, BATTLE_EVENT_VICTORY, 0, 0, RewardExperience[Slot], RewardGold[Slot], "Victory")

        Return ReturnValue

    End If

    If Not SideHasLivingParticipant(StateHandle, BATTLE_SIDE_PARTY) Then

        BattleOutcomes[Slot] = BATTLE_OUTCOME_DEFEAT
        BattlePhases[Slot] = BATTLE_PHASE_DEFEAT
        ReturnValue = AddEvent(StateHandle, BATTLE_EVENT_DEFEAT, 0, 0, 0, 0, "Defeat")

        Return ReturnValue

    End If

    Return True

End Function

Private Function TickStatuses(StateHandle As Number) As Boolean

    Dim Slot As Number
    Dim ParticipantIndexValue As Number
    Dim StatusOffset As Number
    Dim StoredIndex As Number
    Dim StatusId As Number
    Dim StatusKind As Number
    Dim DamageValue As Number
    Dim OldHealth As Number
    Dim NewHealth As Number
    Dim Ignored As Boolean

    Slot = StateSlot(StateHandle)

    For ParticipantIndexValue = 0 To ActiveParticipantCounts[Slot] - 1

        StatusOffset = 0

        If ParticipantStatusCounts[Slot, ParticipantIndexValue] > 0 Then

            Do
            StoredIndex = StatusStorageIndex(ParticipantIndexValue, StatusOffset)
            StatusId = ParticipantStatusIds[Slot, StoredIndex]
            StatusKind = Effects.StatusKind(StateHandle, StatusId)

            If (Effects.StatusTickTiming(StateHandle, StatusId) = Effects.BATTLE_STATUS_TICK_ROUND_END And
                StatusKind = Effects.BATTLE_STATUS_POISON And
                CurrentHealth(StateHandle, ParticipantIndexValue) > 0) Then

                DamageValue = Effects.StatusValue(StateHandle, StatusId)
                OldHealth = CurrentHealth(StateHandle, ParticipantIndexValue)
                NewHealth = OldHealth - DamageValue

                If NewHealth < 0 Then
                    NewHealth = 0
                End If

                If Not SetCurrentHealth(StateHandle, ParticipantIndexValue, NewHealth) Then
                    Return False
                End If

                If Not AddEvent(StateHandle, BATTLE_EVENT_DAMAGE, 0, ParticipantIndexValue + 1, OldHealth - NewHealth, NewHealth, Effects.StatusName(StateHandle, StatusId)) Then
                    Return False
                End If

            End If

            If Effects.StatusTickTiming(StateHandle, StatusId) = Effects.BATTLE_STATUS_TICK_ROUND_END Then
                ParticipantStatusDurations[Slot, StoredIndex] = ParticipantStatusDurations[Slot, StoredIndex] - 1
            End If

            If ParticipantStatusDurations[Slot, StoredIndex] <= 0 Then
                Ignored = RemoveStatus(StateHandle, ParticipantIndexValue, StatusId)
            Else
                StatusOffset = StatusOffset + 1
            End If

            Loop Until StatusOffset >= ParticipantStatusCounts[Slot, ParticipantIndexValue]

        End If

    End For

    Return True

End Function

Private Sub TickActionDenyDuration(StateHandle As Number, ParticipantIndexValue As Number)

    Dim Slot As Number
    Dim StatusOffset As Number
    Dim StoredIndex As Number
    Dim StatusId As Number
    Dim Ignored As Boolean

    Slot = StateSlot(StateHandle)
    StatusOffset = 0

    Do
        StoredIndex = StatusStorageIndex(ParticipantIndexValue, StatusOffset)
        StatusId = ParticipantStatusIds[Slot, StoredIndex]

        If Effects.StatusTickTiming(StateHandle, StatusId) = Effects.BATTLE_STATUS_TICK_ACTION_START Then
            ParticipantStatusDurations[Slot, StoredIndex] = ParticipantStatusDurations[Slot, StoredIndex] - 1
        End If

        If ParticipantStatusDurations[Slot, StoredIndex] <= 0 Then
            Ignored = RemoveStatus(StateHandle, ParticipantIndexValue, StatusId)
        Else
            StatusOffset = StatusOffset + 1
        End If

    Loop Until StatusOffset >= ParticipantStatusCounts[Slot, ParticipantIndexValue]

End Sub

''' Advances exactly one action, or closes the current round after its last action.
Public Function Advance(StateHandle As Number) As Boolean

    Dim ReturnValue As Boolean

    Dim Slot As Number
    Dim ParticipantIndexValue As Number
    Dim WasDenied As Boolean

    Slot = StateSlot(StateHandle)

    If (Slot < 0 Or
        Not BattleActive[Slot] Or
        BattlePhases[Slot] <> BATTLE_PHASE_RESOLVING) Then
        Return False
    End If

    If SchedulePositions[Slot] < ScheduleCounts[Slot] Then

        ParticipantIndexValue = ScheduleParticipantIndexes[Slot, SchedulePositions[Slot]]
        WasDenied = HasActionDenyStatus(StateHandle, ParticipantIndexValue)

        If Not ExecuteAction(StateHandle, ParticipantIndexValue) Then
            Return False
        End If

        If WasDenied Then
            Call TickActionDenyDuration(StateHandle, ParticipantIndexValue)
        End If

        ReturnValue = CheckOutcome(StateHandle)

        If Not ReturnValue Then
            Call RestoreTransaction(StateHandle)

            Return False
        End If

        SchedulePositions[Slot] = SchedulePositions[Slot] + 1

        Return ReturnValue

    End If

    Call BackupTransaction(StateHandle)

    If Not TickStatuses(StateHandle) Or Not CheckOutcome(StateHandle) Then
        Call RestoreTransaction(StateHandle)

        Return False
    End If

    If BattleOutcomes[Slot] = BATTLE_OUTCOME_NONE Then

        If Not AddEvent(StateHandle, BATTLE_EVENT_ROUND_ENDED, 0, 0, BattleRounds[Slot], 0, "Round ended") Then
            Call RestoreTransaction(StateHandle)

            Return False
        End If

        For ParticipantIndexValue = 0 To ActiveParticipantCounts[Slot] - 1
            SubmittedActions[Slot, ParticipantIndexValue] = False
        End For

        BattlePhases[Slot] = BATTLE_PHASE_COMMAND

    End If

    Return True

End Function

''' Clears submitted actions while the command phase still owns them.
Public Function ClearQueuedActions(StateHandle As Number) As Boolean

    Dim Slot As Number
    Dim Index As Number

    Slot = StateSlot(StateHandle)

    If (Slot < 0 Or
        Not BattleActive[Slot] Or
        BattlePhases[Slot] <> BATTLE_PHASE_COMMAND) Then
        Return False
    End If

    For Index = 0 To ActiveParticipantCounts[Slot] - 1
        SubmittedActions[Slot, Index] = False
        SubmittedActionKinds[Slot, Index] = 0
        SubmittedSourceIds[Slot, Index] = 0
        SubmittedTargetIds[Slot, Index] = 0
    End For

    Return True

End Function

''' Ends a completed battle and clears every transient action, status, event, and participant.
Public Function EndBattle(StateHandle As Number) As Boolean

    Dim Slot As Number

    Slot = StateSlot(StateHandle)

    If (Slot < 0 Or
        Not BattleActive[Slot] Or
        BattleOutcomes[Slot] = BATTLE_OUTCOME_NONE) Then
        Return False
    End If

    BattleActive[Slot] = False
    BattleHandles[Slot] = 0

    Call ResetSession(Slot)

    Return True

End Function

''' Abandons an unfinished transient battle without granting rewards.
Public Function CancelBattle(StateHandle As Number) As Boolean

    Dim Slot As Number

    Slot = StateSlot(StateHandle)

    If Slot < 0 Or Not BattleActive[Slot] Then
        Return False
    End If

    BattleActive[Slot] = False
    BattleHandles[Slot] = 0

    Call ResetSession(Slot)

    Return True

End Function

Public Function EventCount(StateHandle As Number) As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    Slot = StateSlot(StateHandle)

    If Slot < 0 Then
        Return 0
    End If

    ReturnValue = EventCounts[Slot]

    Return ReturnValue

End Function

Public Function EventKindAt(StateHandle As Number, Index As Number) As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    Slot = StateSlot(StateHandle)

    If (Slot < 0 Or
        Index < 0 Or
        Index >= EventCounts[Slot]) Then
        Return 0
    End If

    ReturnValue = EventKinds[Slot, Index]

    Return ReturnValue

End Function

Public Function EventActorIdAt(StateHandle As Number, Index As Number) As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    Slot = StateSlot(StateHandle)

    If (Slot < 0 Or
        Index < 0 Or
        Index >= EventCounts[Slot]) Then
        Return 0
    End If

    ReturnValue = EventActorIds[Slot, Index]

    Return ReturnValue

End Function

Public Function EventTargetIdAt(StateHandle As Number, Index As Number) As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    Slot = StateSlot(StateHandle)

    If (Slot < 0 Or
        Index < 0 Or
        Index >= EventCounts[Slot]) Then
        Return 0
    End If

    ReturnValue = EventTargetIds[Slot, Index]

    Return ReturnValue

End Function

Public Function EventValueOneAt(StateHandle As Number, Index As Number) As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    Slot = StateSlot(StateHandle)

    If (Slot < 0 Or
        Index < 0 Or
        Index >= EventCounts[Slot]) Then
        Return 0
    End If

    ReturnValue = EventValueOne[Slot, Index]

    Return ReturnValue

End Function

Public Function EventValueTwoAt(StateHandle As Number, Index As Number) As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    Slot = StateSlot(StateHandle)

    If (Slot < 0 Or
        Index < 0 Or
        Index >= EventCounts[Slot]) Then
        Return 0
    End If

    ReturnValue = EventValueTwo[Slot, Index]

    Return ReturnValue

End Function

Public Function EventTextAt(StateHandle As Number, Index As Number) As Text

    Dim ReturnValue As Text

    Dim Slot As Number

    Slot = StateSlot(StateHandle)

    If (Slot < 0 Or
        Index < 0 Or
        Index >= EventCounts[Slot]) Then
        Return ""
    End If

    ReturnValue = EventTexts[Slot, Index]

    Return ReturnValue

End Function

''' Removes a bounded prefix of already-consumed events.
Public Function ConsumeEvents(StateHandle As Number, EventCountToConsume As Number) As Boolean

    Dim Slot As Number
    Dim Index As Number
    Dim SourceIndex As Number

    Slot = StateSlot(StateHandle)

    If (Slot < 0 Or
        EventCountToConsume < 0 Or
        EventCountToConsume > EventCounts[Slot]) Then
        Return False
    End If

    For Index = 0 To EventCounts[Slot] - EventCountToConsume - 1

        SourceIndex = Index + EventCountToConsume
        EventKinds[Slot, Index] = EventKinds[Slot, SourceIndex]
        EventActorIds[Slot, Index] = EventActorIds[Slot, SourceIndex]
        EventTargetIds[Slot, Index] = EventTargetIds[Slot, SourceIndex]
        EventValueOne[Slot, Index] = EventValueOne[Slot, SourceIndex]
        EventValueTwo[Slot, Index] = EventValueTwo[Slot, SourceIndex]
        EventTexts[Slot, Index] = EventTexts[Slot, SourceIndex]
    End For

    For Index = EventCounts[Slot] - EventCountToConsume To EventCounts[Slot] - 1

        EventKinds[Slot, Index] = 0
        EventActorIds[Slot, Index] = 0
        EventTargetIds[Slot, Index] = 0
        EventValueOne[Slot, Index] = 0
        EventValueTwo[Slot, Index] = 0
        EventTexts[Slot, Index] = ""
    End For

    EventCounts[Slot] = EventCounts[Slot] - EventCountToConsume
    Return True

End Function

End Module
