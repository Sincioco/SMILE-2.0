Public Const BATTLE_EVENT_ITEM = 7
Public Const BATTLE_EVENT_DEFEND = 8
Public Const BATTLE_EVENT_RUN_SUCCEEDED = 9
Public Const BATTLE_EVENT_RUN_FAILED = 10
Public Const BATTLE_EVENT_DAMAGE = 11
Public Const BATTLE_EVENT_HEAL = 12
Public Const BATTLE_EVENT_MAGIC_POINTS = 13
Public Const BATTLE_EVENT_STATUS_APPLIED = 14
Public Const BATTLE_EVENT_STATUS_REMOVED = 15
Public Const BATTLE_EVENT_REVIVED = 16
Public Const BATTLE_EVENT_DEFEATED = 17
