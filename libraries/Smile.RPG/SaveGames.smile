''' Deterministic SRPG format-2 encoding, format-1 compatibility, and transactional save games.
Module Smile.RPG.SaveGames

Option Explicit

Import Smile.RPG.Core As Core
Import Smile.RPG.Characters As Characters
Import Smile.RPG.Party As Party
Import Smile.RPG.Inventory As Inventory
Import Smile.RPG.Equipment As Equipment
Import Smile.RPG.Abilities As Abilities
Import Smile.RPG.Shops As Shops
Import Smile.RPG.World As World
Import Smile.RPG.Story As Story
Import Smile.RPG.Encounters As Encounters
Import Smile.RPG.BattleCore As Battle

Private Const SAVE_FORMAT_VERSION = 2
Private Const EARLIEST_READ_FORMAT_VERSION = 1

Private Dim EncodedBytes[36864] As Number
Private Dim IncomingBytes[36864] As Number
Private Dim RollbackBytes[36864] As Number
Private Dim BufferCount As Number
Private Dim WritePosition As Number
Private Dim WriteFailed As Boolean
Private Dim ReadPosition As Number
Private Dim ReadFailed As Boolean

Private Dim ScratchCharacterCount As Number
Private Dim ScratchCharacterIds[32] As Number
Private Dim ScratchLevels[32] As Number
Private Dim ScratchExperience[32] As Number
Private Dim ScratchHealth[32] As Number
Private Dim ScratchMaximumHealth[32] As Number
Private Dim ScratchMagicPoints[32] As Number
Private Dim ScratchMaximumMagicPoints[32] As Number
Private Dim ScratchStrength[32] As Number
Private Dim ScratchDefense[32] As Number
Private Dim ScratchMagic[32] As Number
Private Dim ScratchResistance[32] As Number
Private Dim ScratchAgility[32] As Number
Private Dim ScratchLuck[32] As Number

Private Dim ScratchPartyCount As Number
Private Dim ScratchPartyIds[8] As Number
Private Dim ScratchGold As Number

Private Dim ScratchInventoryCount As Number
Private Dim ScratchInventoryItemIds[64] As Number
Private Dim ScratchInventoryQuantities[64] As Number

Private Dim ScratchEquipmentCount As Number
Private Dim ScratchEquipmentCharacterIds[512] As Number
Private Dim ScratchEquipmentSlotIds[512] As Number
Private Dim ScratchEquipmentItemIds[512] As Number

Private Dim ScratchLearnedCount As Number
Private Dim ScratchLearnedCharacterIds[1024] As Number
Private Dim ScratchLearnedAbilityIds[1024] As Number

Private Dim ScratchShopCount As Number
Private Dim ScratchShopIds[1024] As Number
Private Dim ScratchShopItemIds[1024] As Number
Private Dim ScratchShopStock[1024] As Number

Private Dim ScratchFormatVersion As Number
Private Dim ScratchCurrentSceneId As Number
Private Dim ScratchControlledActorId As Number
Private Dim ScratchReturnSceneId As Number
Private Dim ScratchReturnCellX As Number
Private Dim ScratchReturnCellY As Number
Private Dim ScratchReturnFacing As Number
Private Dim ScratchActorCount As Number
Private Dim ScratchActorIds[64] As Number
Private Dim ScratchActorSceneIds[64] As Number
Private Dim ScratchActorCellX[64] As Number
Private Dim ScratchActorCellY[64] As Number
Private Dim ScratchActorFacing[64] As Number
Private Dim ScratchActorVisible[64] As Number
Private Dim ScratchActorRouteSteps[64] As Number
Private Dim ScratchFlagCount As Number
Private Dim ScratchFlagIds[128] As Number
Private Dim ScratchFlagValues[128] As Number
Private Dim ScratchValueCount As Number
Private Dim ScratchValueIds[64] As Number
Private Dim ScratchValueValues[64] As Number
Private Dim ScratchPendingEncounterId As Number
Private Dim ScratchZoneCount As Number
Private Dim ScratchZoneIds[16] As Number
Private Dim ScratchZoneStepCounts[16] As Number
Private Dim ScratchZoneSeeds[16] As Number

Private Dim RollbackActorCount As Number
Private Dim RollbackActorIds[64] As Number
Private Dim RollbackActorReserved[64] As Boolean
Private Dim RollbackActorReservedX[64] As Number
Private Dim RollbackActorReservedY[64] As Number

Private Sub PutByte(Value As Number)

    If (WritePosition >= Core.RPG_MAX_SAVE_BYTES Or
        Value < 0 Or
        Value > 255) Then
        WriteFailed = True
        Return
    End If

    EncodedBytes[WritePosition] = Value
    WritePosition = WritePosition + 1

End Sub

Private Sub PutInt(Value As Number)

    Dim UnsignedValue As Number

    If Value < -1 Or Value > Core.RPG_MAX_VALUE Then
        WriteFailed = True
        Return
    End If

    UnsignedValue = Value

    If UnsignedValue < 0 Then
        UnsignedValue = UnsignedValue + 4294967296
    End If

    Call PutByte(UnsignedValue Mod 256)

    UnsignedValue = UnsignedValue / 256

    Call PutByte(UnsignedValue Mod 256)

    UnsignedValue = UnsignedValue / 256

    Call PutByte(UnsignedValue Mod 256)

    UnsignedValue = UnsignedValue / 256

    Call PutByte(UnsignedValue Mod 256)

End Sub

Private Function GetInt() As Number

    Dim Value As Number

    If ReadPosition > BufferCount - 4 Then
        ReadFailed = True
        Return 0
    End If

    Value = EncodedBytes[ReadPosition]
    Value = Value + EncodedBytes[ReadPosition + 1] * 256
    Value = Value + EncodedBytes[ReadPosition + 2] * 65536
    Value = Value + EncodedBytes[ReadPosition + 3] * 16777216
    ReadPosition = ReadPosition + 4

    If Value >= 2147483648 Then
        Value = Value - 4294967296
    End If

    Return Value

End Function

''' Encodes dynamic state into the module buffer and returns an RPG result code.
Public Function Encode(StateHandle As Number, SchemaVersion As Number) As Number

    Dim Index As Number
    Dim CharacterIndex As Number
    Dim SlotIndex As Number
    Dim ShopIndex As Number
    Dim EntryIndex As Number
    Dim CharacterId As Number
    Dim EquipmentSlotId As Number
    Dim ItemId As Number
    Dim RecordCount As Number

    If Not Core.IsValid(StateHandle) Then
        Return Core.RPG_RESULT_INVALID_STATE
    End If

    If Battle.IsActive(StateHandle) Then
        Return Core.RPG_RESULT_BATTLE_ACTIVE
    End If

    If SchemaVersion <= 0 Or Not Core.IsValidValue(SchemaVersion) Then
        Return Core.RPG_RESULT_INVALID_ARGUMENT
    End If

    WritePosition = 0
    WriteFailed = False

    Call PutByte(83)
    Call PutByte(82)
    Call PutByte(80)
    Call PutByte(71)
    Call PutInt(SAVE_FORMAT_VERSION)
    Call PutInt(SchemaVersion)

    Call PutInt(Characters.CharacterDefinitionCount(StateHandle))

    For Index = 0 To Characters.CharacterDefinitionCount(StateHandle) - 1

        CharacterId = Characters.CharacterIdAt(StateHandle, Index)

        Call PutInt(CharacterId)
        Call PutInt(Characters.Level(StateHandle, CharacterId))
        Call PutInt(Characters.Experience(StateHandle, CharacterId))
        Call PutInt(Characters.Health(StateHandle, CharacterId))
        Call PutInt(Characters.MaximumHealth(StateHandle, CharacterId))
        Call PutInt(Characters.MagicPoints(StateHandle, CharacterId))
        Call PutInt(Characters.MaximumMagicPoints(StateHandle, CharacterId))
        Call PutInt(Characters.Strength(StateHandle, CharacterId))
        Call PutInt(Characters.Defense(StateHandle, CharacterId))
        Call PutInt(Characters.Magic(StateHandle, CharacterId))
        Call PutInt(Characters.Resistance(StateHandle, CharacterId))
        Call PutInt(Characters.Agility(StateHandle, CharacterId))
        Call PutInt(Characters.Luck(StateHandle, CharacterId))
    End For

    Call PutInt(Party.PartyCount(StateHandle))

    For Index = 0 To Party.PartyCount(StateHandle) - 1
        Call PutInt(Party.CharacterIdAt(StateHandle, Index))
    End For

    Call PutInt(Party.Gold(StateHandle))

    Call PutInt(Inventory.EntryCount(StateHandle))

    For Index = 0 To Inventory.EntryCount(StateHandle) - 1
        ItemId = Inventory.ItemIdAtEntryIndex(StateHandle, Index)

        Call PutInt(ItemId)
        Call PutInt(Inventory.Quantity(StateHandle, ItemId))
    End For

    RecordCount = 0

    For CharacterIndex = 0 To Characters.CharacterDefinitionCount(StateHandle) - 1

        CharacterId = Characters.CharacterIdAt(StateHandle, CharacterIndex)

        For SlotIndex = 0 To Equipment.SlotCount(StateHandle) - 1

            EquipmentSlotId = Equipment.SlotIdAt(StateHandle, SlotIndex)

            If Equipment.EquippedItem(StateHandle, CharacterId, EquipmentSlotId) <> 0 Then
                RecordCount = RecordCount + 1
            End If

        End For
    End For

    Call PutInt(RecordCount)

    For CharacterIndex = 0 To Characters.CharacterDefinitionCount(StateHandle) - 1

        CharacterId = Characters.CharacterIdAt(StateHandle, CharacterIndex)

        For SlotIndex = 0 To Equipment.SlotCount(StateHandle) - 1

            EquipmentSlotId = Equipment.SlotIdAt(StateHandle, SlotIndex)
            ItemId = Equipment.EquippedItem(StateHandle, CharacterId, EquipmentSlotId)

            If ItemId <> 0 Then

                Call PutInt(CharacterId)
                Call PutInt(EquipmentSlotId)
                Call PutInt(ItemId)

            End If

        End For
    End For

    RecordCount = 0

    For CharacterIndex = 0 To Characters.CharacterDefinitionCount(StateHandle) - 1
        CharacterId = Characters.CharacterIdAt(StateHandle, CharacterIndex)
        RecordCount = RecordCount + Abilities.LearnedAbilityCount(StateHandle, CharacterId)
    End For

    Call PutInt(RecordCount)

    For CharacterIndex = 0 To Characters.CharacterDefinitionCount(StateHandle) - 1

        CharacterId = Characters.CharacterIdAt(StateHandle, CharacterIndex)

        For Index = 0 To Abilities.LearnedAbilityCount(StateHandle, CharacterId) - 1
            Call PutInt(CharacterId)
            Call PutInt(Abilities.LearnedAbilityIdAt(StateHandle, CharacterId, Index))
        End For
    End For

    RecordCount = 0

    For ShopIndex = 0 To Shops.ShopCount(StateHandle) - 1
        RecordCount = RecordCount + Shops.ShopItemCount(StateHandle, Shops.ShopIdAt(StateHandle, ShopIndex))
    End For

    Call PutInt(RecordCount)

    For ShopIndex = 0 To Shops.ShopCount(StateHandle) - 1

        For EntryIndex = 0 To Shops.ShopItemCount(StateHandle, Shops.ShopIdAt(StateHandle, ShopIndex)) - 1
            ItemId = Shops.ShopItemIdAt(StateHandle, Shops.ShopIdAt(StateHandle, ShopIndex), EntryIndex)

            Call PutInt(Shops.ShopIdAt(StateHandle, ShopIndex))
            Call PutInt(ItemId)
            Call PutInt(Shops.Stock(StateHandle, Shops.ShopIdAt(StateHandle, ShopIndex), ItemId))
        End For
    End For

    Call PutInt(World.CurrentScene(StateHandle))
    Call PutInt(World.ControlledActor(StateHandle))
    Call PutInt(World.ReturnScene(StateHandle))
    Call PutInt(World.ReturnX(StateHandle))
    Call PutInt(World.ReturnY(StateHandle))
    Call PutInt(World.ReturnFacingDirection(StateHandle))

    Call PutInt(World.PersistentActorCount(StateHandle))

    For Index = 0 To World.PersistentActorCount(StateHandle) - 1

        CharacterId = World.PersistentActorIdAt(StateHandle, Index)

        Call PutInt(CharacterId)
        Call PutInt(World.ActorScene(StateHandle, CharacterId))
        Call PutInt(World.ActorX(StateHandle, CharacterId))
        Call PutInt(World.ActorY(StateHandle, CharacterId))
        Call PutInt(World.ActorFacingDirection(StateHandle, CharacterId))

        If World.ActorIsVisible(StateHandle, CharacterId) Then
            Call PutInt(1)
        Else

            Call PutInt(0)
        End If

        Call PutInt(World.ActorRouteStep(StateHandle, CharacterId))
    End For

    Call PutInt(Story.FlagCount(StateHandle))

    For Index = 0 To Story.FlagCount(StateHandle) - 1

        ItemId = Story.FlagIdAt(StateHandle, Index)

        Call PutInt(ItemId)

        If Story.Flag(StateHandle, ItemId) Then
            Call PutInt(1)
        Else

            Call PutInt(0)
        End If

    End For

    Call PutInt(Story.ValueCount(StateHandle))

    For Index = 0 To Story.ValueCount(StateHandle) - 1
        ItemId = Story.ValueIdAt(StateHandle, Index)

        Call PutInt(ItemId)
        Call PutInt(Story.Value(StateHandle, ItemId))
    End For

    Call PutInt(Encounters.PendingEncounter(StateHandle))
    Call PutInt(Encounters.ZoneCount(StateHandle))

    For Index = 0 To Encounters.ZoneCount(StateHandle) - 1
        ItemId = Encounters.ZoneIdAt(StateHandle, Index)

        Call PutInt(ItemId)
        Call PutInt(Encounters.StepCount(StateHandle, ItemId))
        Call PutInt(Encounters.Seed(StateHandle, ItemId))
    End For

    If WriteFailed Then
        BufferCount = 0
        Return Core.RPG_RESULT_CAPACITY
    End If

    BufferCount = WritePosition
    Return Core.RPG_RESULT_OK

End Function

Private Function IsDuplicateCharacter(Index As Number) As Boolean

    Dim Earlier As Number

    For Earlier = 0 To Index - 1

        If ScratchCharacterIds[Earlier] = ScratchCharacterIds[Index] Then
            Return True
        End If

    End For
    Return False

End Function

Private Function IsDuplicatePartyMember(Index As Number) As Boolean

    Dim Earlier As Number

    For Earlier = 0 To Index - 1

        If ScratchPartyIds[Earlier] = ScratchPartyIds[Index] Then
            Return True
        End If

    End For
    Return False

End Function

Private Function IsDuplicateInventoryItem(Index As Number) As Boolean

    Dim Earlier As Number

    For Earlier = 0 To Index - 1

        If ScratchInventoryItemIds[Earlier] = ScratchInventoryItemIds[Index] Then
            Return True
        End If

    End For
    Return False

End Function

Private Function IsDuplicateEquipment(Index As Number) As Boolean

    Dim Earlier As Number

    For Earlier = 0 To Index - 1

        If (ScratchEquipmentCharacterIds[Earlier] = ScratchEquipmentCharacterIds[Index] And
            ScratchEquipmentSlotIds[Earlier] = ScratchEquipmentSlotIds[Index]) Then
            Return True
        End If

    End For
    Return False

End Function

Private Function IsDuplicateLearnedAbility(Index As Number) As Boolean

    Dim Earlier As Number

    For Earlier = 0 To Index - 1

        If (ScratchLearnedCharacterIds[Earlier] = ScratchLearnedCharacterIds[Index] And
            ScratchLearnedAbilityIds[Earlier] = ScratchLearnedAbilityIds[Index]) Then
            Return True
        End If

    End For
    Return False

End Function

Private Function IsDuplicateShopStock(Index As Number) As Boolean

    Dim Earlier As Number

    For Earlier = 0 To Index - 1

        If (ScratchShopIds[Earlier] = ScratchShopIds[Index] And
            ScratchShopItemIds[Earlier] = ScratchShopItemIds[Index]) Then
            Return True
        End If

    End For
    Return False

End Function

Private Function IsDuplicateActor(Index As Number) As Boolean

    Dim Earlier As Number

    For Earlier = 0 To Index - 1

        If ScratchActorIds[Earlier] = ScratchActorIds[Index] Then
            Return True
        End If

    End For

    Return False

End Function

Private Function IsDuplicateFlag(Index As Number) As Boolean

    Dim Earlier As Number

    For Earlier = 0 To Index - 1

        If ScratchFlagIds[Earlier] = ScratchFlagIds[Index] Then
            Return True
        End If

    End For

    Return False

End Function

Private Function IsDuplicateValue(Index As Number) As Boolean

    Dim Earlier As Number

    For Earlier = 0 To Index - 1

        If ScratchValueIds[Earlier] = ScratchValueIds[Index] Then
            Return True
        End If

    End For

    Return False

End Function

Private Function IsDuplicateZone(Index As Number) As Boolean

    Dim Earlier As Number

    For Earlier = 0 To Index - 1

        If ScratchZoneIds[Earlier] = ScratchZoneIds[Index] Then
            Return True
        End If

    End For

    Return False

End Function

Private Function ScratchActorIndex(ActorId As Number) As Number

    Dim ReturnValue As Number

    Dim Index As Number

    For Index = 0 To ScratchActorCount - 1

        If ScratchActorIds[Index] = ActorId Then
            Return Index
        End If

    End For

    ReturnValue = -1

    Return ReturnValue

End Function

Private Function ScratchWorldLayoutIsValid(StateHandle As Number) As Boolean

    Dim Index As Number
    Dim Other As Number
    Dim ActorId As Number
    Dim ControlledIndex As Number
    Dim ControlledSceneId As Number

    For Index = 0 To ScratchActorCount - 1

        ActorId = ScratchActorIds[Index]

        If ScratchActorVisible[Index] = 1 And World.ActorIsSolid(StateHandle, ActorId) Then

            For Other = Index + 1 To ScratchActorCount - 1

                If (ScratchActorVisible[Other] = 1 And
                    World.ActorIsSolid(StateHandle, ScratchActorIds[Other]) And
                    ScratchActorSceneIds[Other] = ScratchActorSceneIds[Index] And
                    ScratchActorCellX[Other] = ScratchActorCellX[Index] And
                    ScratchActorCellY[Other] = ScratchActorCellY[Index]) Then
                    Return False
                End If

            End For

            For Other = 0 To World.ActorCount(StateHandle) - 1

                ActorId = World.ActorIdAt(StateHandle, Other)

                If (Not World.ActorIsPersistent(StateHandle, ActorId) And
                    World.ActorIsVisible(StateHandle, ActorId) And
                    World.ActorIsSolid(StateHandle, ActorId) And
                    World.ActorScene(StateHandle, ActorId) = ScratchActorSceneIds[Index]) Then

                    If (World.ActorX(StateHandle, ActorId) = ScratchActorCellX[Index] And
                        World.ActorY(StateHandle, ActorId) = ScratchActorCellY[Index]) Then
                        Return False
                    End If

                    If (World.ActorHasReservation(StateHandle, ActorId) And
                        World.ActorReservedDestinationX(StateHandle, ActorId) = ScratchActorCellX[Index] And
                        World.ActorReservedDestinationY(StateHandle, ActorId) = ScratchActorCellY[Index]) Then
                        Return False
                    End If

                End If

            End For

        End If

    End For

    If ScratchCurrentSceneId <> 0 And ScratchControlledActorId <> 0 Then

        If World.ActorIsPersistent(StateHandle, ScratchControlledActorId) Then

            ControlledIndex = ScratchActorIndex(ScratchControlledActorId)

            If ControlledIndex < 0 Then
                Return False
            End If

            ControlledSceneId = ScratchActorSceneIds[ControlledIndex]

        Else
            ControlledSceneId = World.ActorScene(StateHandle, ScratchControlledActorId)

        End If

        If ControlledSceneId <> ScratchCurrentSceneId Then
            Return False
        End If

    End If

    Return True

End Function

Private Function ParseEncoded(StateHandle As Number, ExpectedSchemaVersion As Number) As Number

    Dim FormatVersion As Number
    Dim SchemaVersion As Number
    Dim Index As Number
    Dim CharacterLearnedCounts[32] As Number

    If BufferCount < 12 Or BufferCount > Core.RPG_MAX_SAVE_BYTES Then
        Return Core.RPG_RESULT_NOT_FOUND_OR_INVALID_SAVE
    End If

    If (EncodedBytes[0] <> 83 Or
        EncodedBytes[1] <> 82 Or
        EncodedBytes[2] <> 80 Or
        EncodedBytes[3] <> 71) Then
        Return Core.RPG_RESULT_NOT_FOUND_OR_INVALID_SAVE
    End If

    ReadPosition = 4
    ReadFailed = False
    FormatVersion = GetInt()
    SchemaVersion = GetInt()

    If (ReadFailed Or
        FormatVersion < EARLIEST_READ_FORMAT_VERSION Or
        FormatVersion > SAVE_FORMAT_VERSION) Then
        Return Core.RPG_RESULT_NOT_FOUND_OR_INVALID_SAVE
    End If

    ScratchFormatVersion = FormatVersion

    If SchemaVersion <> ExpectedSchemaVersion Then
        Return Core.RPG_RESULT_WRONG_SCHEMA
    End If

    ScratchCharacterCount = GetInt()

    If (ReadFailed Or
        ScratchCharacterCount < 0 Or
        ScratchCharacterCount > Core.RPG_MAX_CHARACTERS) Then
        Return Core.RPG_RESULT_CAPACITY
    End If

    For Index = 0 To ScratchCharacterCount - 1

        ScratchCharacterIds[Index] = GetInt()
        ScratchLevels[Index] = GetInt()
        ScratchExperience[Index] = GetInt()
        ScratchHealth[Index] = GetInt()
        ScratchMaximumHealth[Index] = GetInt()
        ScratchMagicPoints[Index] = GetInt()
        ScratchMaximumMagicPoints[Index] = GetInt()
        ScratchStrength[Index] = GetInt()
        ScratchDefense[Index] = GetInt()
        ScratchMagic[Index] = GetInt()
        ScratchResistance[Index] = GetInt()
        ScratchAgility[Index] = GetInt()
        ScratchLuck[Index] = GetInt()

        If ReadFailed Then
            Return Core.RPG_RESULT_NOT_FOUND_OR_INVALID_SAVE
        End If

        If Not Characters.IsCharacterDefined(StateHandle, ScratchCharacterIds[Index]) Then
            Return Core.RPG_RESULT_MISSING_DEFINITION
        End If

        If (IsDuplicateCharacter(Index) Or
            ScratchLevels[Index] <= 0 Or
            Not Core.IsValidValue(ScratchLevels[Index]) Or
            Not Core.IsValidValue(ScratchExperience[Index]) Or
            ScratchMaximumHealth[Index] <= 0 Or
            Not Core.IsValidValue(ScratchMaximumHealth[Index]) Or
            ScratchHealth[Index] < 0 Or
            ScratchHealth[Index] > ScratchMaximumHealth[Index] Or
            Not Core.IsValidValue(ScratchMaximumMagicPoints[Index]) Or
            ScratchMagicPoints[Index] < 0 Or
            ScratchMagicPoints[Index] > ScratchMaximumMagicPoints[Index] Or
            Not Core.IsValidValue(ScratchStrength[Index]) Or
            Not Core.IsValidValue(ScratchDefense[Index]) Or
            Not Core.IsValidValue(ScratchMagic[Index]) Or
            Not Core.IsValidValue(ScratchResistance[Index]) Or
            Not Core.IsValidValue(ScratchAgility[Index]) Or
            Not Core.IsValidValue(ScratchLuck[Index])) Then
            Return Core.RPG_RESULT_INVALID_ARGUMENT
        End If

    End For

    ScratchPartyCount = GetInt()

    If (ReadFailed Or
        ScratchPartyCount < 0 Or
        ScratchPartyCount > Core.RPG_MAX_PARTY_MEMBERS) Then
        Return Core.RPG_RESULT_CAPACITY
    End If

    For Index = 0 To ScratchPartyCount - 1

        ScratchPartyIds[Index] = GetInt()

        If Not Characters.IsCharacterDefined(StateHandle, ScratchPartyIds[Index]) Then
            Return Core.RPG_RESULT_MISSING_DEFINITION
        End If

        If ReadFailed Or IsDuplicatePartyMember(Index) Then
            Return Core.RPG_RESULT_INVALID_ARGUMENT
        End If

    End For

    ScratchGold = GetInt()

    If ReadFailed Or Not Core.IsValidValue(ScratchGold) Then
        Return Core.RPG_RESULT_INVALID_ARGUMENT
    End If

    ScratchInventoryCount = GetInt()

    If (ReadFailed Or
        ScratchInventoryCount < 0 Or
        ScratchInventoryCount > Core.RPG_MAX_INVENTORY_ENTRIES) Then
        Return Core.RPG_RESULT_CAPACITY
    End If

    For Index = 0 To ScratchInventoryCount - 1

        ScratchInventoryItemIds[Index] = GetInt()
        ScratchInventoryQuantities[Index] = GetInt()

        If Not Inventory.IsItemDefined(StateHandle, ScratchInventoryItemIds[Index]) Then
            Return Core.RPG_RESULT_MISSING_DEFINITION
        End If

        If (ReadFailed Or
            IsDuplicateInventoryItem(Index) Or
            Not Core.IsValidQuantity(ScratchInventoryQuantities[Index]) Or
            ScratchInventoryQuantities[Index] > Inventory.MaximumStack(StateHandle, ScratchInventoryItemIds[Index])) Then
            Return Core.RPG_RESULT_INVALID_ARGUMENT
        End If

    End For

    ScratchEquipmentCount = GetInt()

    If (ReadFailed Or
        ScratchEquipmentCount < 0 Or
        ScratchEquipmentCount > Core.RPG_MAX_CHARACTERS * Core.RPG_MAX_EQUIPMENT_SLOTS) Then
        Return Core.RPG_RESULT_CAPACITY
    End If

    For Index = 0 To ScratchEquipmentCount - 1

        ScratchEquipmentCharacterIds[Index] = GetInt()
        ScratchEquipmentSlotIds[Index] = GetInt()
        ScratchEquipmentItemIds[Index] = GetInt()

        If (Not Characters.IsCharacterDefined(StateHandle, ScratchEquipmentCharacterIds[Index]) Or
            Not Equipment.IsSlotDefined(StateHandle, ScratchEquipmentSlotIds[Index]) Or
            Not Inventory.IsItemDefined(StateHandle, ScratchEquipmentItemIds[Index])) Then
            Return Core.RPG_RESULT_MISSING_DEFINITION
        End If

        If (ReadFailed Or
            IsDuplicateEquipment(Index) Or
            Inventory.Kind(StateHandle, ScratchEquipmentItemIds[Index]) <> Core.RPG_ITEM_EQUIPMENT Or
            Inventory.EquipmentSlotId(StateHandle, ScratchEquipmentItemIds[Index]) <> ScratchEquipmentSlotIds[Index]) Then
            Return Core.RPG_RESULT_INVALID_ARGUMENT
        End If

    End For

    ScratchLearnedCount = GetInt()

    If (ReadFailed Or
        ScratchLearnedCount < 0 Or
        ScratchLearnedCount > Core.RPG_MAX_CHARACTERS * Core.RPG_MAX_LEARNED_ABILITIES) Then
        Return Core.RPG_RESULT_CAPACITY
    End If

    For Index = 0 To Core.RPG_MAX_CHARACTERS - 1
        CharacterLearnedCounts[Index] = 0
    End For

    For Index = 0 To ScratchLearnedCount - 1

        ScratchLearnedCharacterIds[Index] = GetInt()
        ScratchLearnedAbilityIds[Index] = GetInt()

        If (Not Characters.IsCharacterDefined(StateHandle, ScratchLearnedCharacterIds[Index]) Or
            Not Abilities.IsAbilityDefined(StateHandle, ScratchLearnedAbilityIds[Index])) Then
            Return Core.RPG_RESULT_MISSING_DEFINITION
        End If

        If ReadFailed Or IsDuplicateLearnedAbility(Index) Then
            Return Core.RPG_RESULT_INVALID_ARGUMENT
        End If

    End For

    For Index = 0 To ScratchLearnedCount - 1

        Dim CharacterDefinitionIndex As Number

        CharacterDefinitionIndex = 0

        Do

            If CharacterDefinitionIndex >= Characters.CharacterDefinitionCount(StateHandle) Then
                Exit Do
            End If

            If Characters.CharacterIdAt(StateHandle, CharacterDefinitionIndex) = ScratchLearnedCharacterIds[Index] Then
                CharacterLearnedCounts[CharacterDefinitionIndex] = CharacterLearnedCounts[CharacterDefinitionIndex] + 1
                Exit Do
            End If

            CharacterDefinitionIndex = CharacterDefinitionIndex + 1

        Loop

        If CharacterLearnedCounts[CharacterDefinitionIndex] > Core.RPG_MAX_LEARNED_ABILITIES Then
            Return Core.RPG_RESULT_CAPACITY
        End If

    End For

    ScratchShopCount = GetInt()

    If (ReadFailed Or
        ScratchShopCount < 0 Or
        ScratchShopCount > Core.RPG_MAX_SHOPS * Core.RPG_MAX_SHOP_ITEMS) Then
        Return Core.RPG_RESULT_CAPACITY
    End If

    For Index = 0 To ScratchShopCount - 1

        ScratchShopIds[Index] = GetInt()
        ScratchShopItemIds[Index] = GetInt()
        ScratchShopStock[Index] = GetInt()

        If (Not Shops.IsShopDefined(StateHandle, ScratchShopIds[Index]) Or
            Not Shops.HasShopItem(StateHandle, ScratchShopIds[Index], ScratchShopItemIds[Index])) Then
            Return Core.RPG_RESULT_MISSING_DEFINITION
        End If

        If (ReadFailed Or
            IsDuplicateShopStock(Index) Or
            (ScratchShopStock[Index] <> Core.RPG_STOCK_UNLIMITED And Not Core.IsValidValue(ScratchShopStock[Index]))) Then
            Return Core.RPG_RESULT_INVALID_ARGUMENT
        End If

    End For

    ScratchCurrentSceneId = 0
    ScratchControlledActorId = 0
    ScratchReturnSceneId = 0
    ScratchReturnCellX = 0
    ScratchReturnCellY = 0
    ScratchReturnFacing = World.WORLD_FACING_DOWN
    ScratchActorCount = 0
    ScratchFlagCount = 0
    ScratchValueCount = 0
    ScratchPendingEncounterId = 0
    ScratchZoneCount = 0

    If ScratchFormatVersion >= 2 Then

        ScratchCurrentSceneId = GetInt()
        ScratchControlledActorId = GetInt()
        ScratchReturnSceneId = GetInt()
        ScratchReturnCellX = GetInt()
        ScratchReturnCellY = GetInt()
        ScratchReturnFacing = GetInt()

        If (ReadFailed Or
            (ScratchCurrentSceneId <> 0 And Not World.IsSceneDefined(StateHandle, ScratchCurrentSceneId)) Or
            (ScratchControlledActorId <> 0 And Not World.IsActorDefined(StateHandle, ScratchControlledActorId)) Or
            (ScratchReturnSceneId <> 0 And Not World.IsSceneDefined(StateHandle, ScratchReturnSceneId)) Or
            ScratchReturnCellX < 0 Or
            ScratchReturnCellY < 0 Or
            ScratchReturnFacing < World.WORLD_FACING_UP Or
            ScratchReturnFacing > World.WORLD_FACING_LEFT) Then
            Return Core.RPG_RESULT_MISSING_DEFINITION
        End If

        ScratchActorCount = GetInt()

        If (ReadFailed Or
            ScratchActorCount <> World.PersistentActorCount(StateHandle) Or
            ScratchActorCount < 0 Or
            ScratchActorCount > World.WORLD_MAX_ACTORS) Then
            Return Core.RPG_RESULT_CAPACITY
        End If

        For Index = 0 To ScratchActorCount - 1

            ScratchActorIds[Index] = GetInt()
            ScratchActorSceneIds[Index] = GetInt()
            ScratchActorCellX[Index] = GetInt()
            ScratchActorCellY[Index] = GetInt()
            ScratchActorFacing[Index] = GetInt()
            ScratchActorVisible[Index] = GetInt()
            ScratchActorRouteSteps[Index] = GetInt()

            If (ReadFailed Or
                Not World.IsActorDefined(StateHandle, ScratchActorIds[Index]) Or
                Not World.ActorIsPersistent(StateHandle, ScratchActorIds[Index]) Or
                Not World.IsSceneDefined(StateHandle, ScratchActorSceneIds[Index]) Or
                IsDuplicateActor(Index) Or
                ScratchActorCellX[Index] < 0 Or
                ScratchActorCellY[Index] < 0 Or
                ScratchActorFacing[Index] < World.WORLD_FACING_UP Or
                ScratchActorFacing[Index] > World.WORLD_FACING_LEFT Or
                (ScratchActorVisible[Index] <> 0 And ScratchActorVisible[Index] <> 1) Or
                Not Core.IsValidValue(ScratchActorRouteSteps[Index])) Then
                Return Core.RPG_RESULT_INVALID_ARGUMENT
            End If

        End For

        ScratchFlagCount = GetInt()

        If (ReadFailed Or
            ScratchFlagCount <> Story.FlagCount(StateHandle) Or
            ScratchFlagCount < 0 Or
            ScratchFlagCount > Story.STORY_MAX_FLAGS) Then
            Return Core.RPG_RESULT_CAPACITY
        End If

        For Index = 0 To ScratchFlagCount - 1

            ScratchFlagIds[Index] = GetInt()
            ScratchFlagValues[Index] = GetInt()

            If (ReadFailed Or
                Not Story.IsFlagDefined(StateHandle, ScratchFlagIds[Index]) Or
                IsDuplicateFlag(Index) Or
                (ScratchFlagValues[Index] <> 0 And ScratchFlagValues[Index] <> 1)) Then
                Return Core.RPG_RESULT_INVALID_ARGUMENT
            End If

        End For

        ScratchValueCount = GetInt()

        If (ReadFailed Or
            ScratchValueCount <> Story.ValueCount(StateHandle) Or
            ScratchValueCount < 0 Or
            ScratchValueCount > Story.STORY_MAX_VALUES) Then
            Return Core.RPG_RESULT_CAPACITY
        End If

        For Index = 0 To ScratchValueCount - 1

            ScratchValueIds[Index] = GetInt()
            ScratchValueValues[Index] = GetInt()

            If (ReadFailed Or
                Not Story.IsValueDefined(StateHandle, ScratchValueIds[Index]) Or
                IsDuplicateValue(Index) Or
                ScratchValueValues[Index] < -1 Or
                ScratchValueValues[Index] > Core.RPG_MAX_VALUE) Then
                Return Core.RPG_RESULT_INVALID_ARGUMENT
            End If

        End For

        ScratchPendingEncounterId = GetInt()
        ScratchZoneCount = GetInt()

        If (ReadFailed Or
            ScratchPendingEncounterId < 0 Or
            ScratchPendingEncounterId > Core.RPG_MAX_VALUE Or
            ScratchZoneCount <> Encounters.ZoneCount(StateHandle) Or
            ScratchZoneCount < 0 Or
            ScratchZoneCount > Encounters.ENCOUNTER_MAX_ZONES) Then
            Return Core.RPG_RESULT_CAPACITY
        End If

        For Index = 0 To ScratchZoneCount - 1

            ScratchZoneIds[Index] = GetInt()
            ScratchZoneStepCounts[Index] = GetInt()
            ScratchZoneSeeds[Index] = GetInt()

            If (ReadFailed Or
                IsDuplicateZone(Index) Or
                ScratchZoneIds[Index] <> Encounters.ZoneIdAt(StateHandle, Index) Or
                ScratchZoneStepCounts[Index] < 0 Or
                ScratchZoneSeeds[Index] < 0 Or
                ScratchZoneSeeds[Index] > 65535) Then
                Return Core.RPG_RESULT_INVALID_ARGUMENT
            End If

        End For

    End If

    If ReadFailed Or ReadPosition <> BufferCount Then
        Return Core.RPG_RESULT_NOT_FOUND_OR_INVALID_SAVE
    End If

    If ScratchFormatVersion >= 2 And Not ScratchWorldLayoutIsValid(StateHandle) Then
        Return Core.RPG_RESULT_INVALID_ARGUMENT
    End If

    Return Core.RPG_RESULT_OK

End Function

Private Function ApplyScratchWorld(StateHandle As Number) As Boolean

    Dim ReturnValue As Boolean

    Dim Index As Number
    Dim ActorId As Number

    If ScratchFormatVersion < 2 Then
        ReturnValue = World.ResetPersistentProgress(StateHandle)

        Return ReturnValue
    End If

    If (Not World.SetCurrentScene(StateHandle, 0) Or
        Not World.SetControlledActor(StateHandle, 0) Or
        Not World.SetReturnLocation(StateHandle, 0, 0, 0, World.WORLD_FACING_DOWN)) Then
        Return False
    End If

    For Index = 0 To World.PersistentActorCount(StateHandle) - 1

        ActorId = World.PersistentActorIdAt(StateHandle, Index)

        If Not World.SetActorVisible(StateHandle, ActorId, False) Then
            Return False
        End If

    End For

    For Index = 0 To ScratchActorCount - 1

        If Not World.SetActorProgress(StateHandle, ScratchActorIds[Index], ScratchActorSceneIds[Index], ScratchActorCellX[Index], ScratchActorCellY[Index], ScratchActorFacing[Index], False, ScratchActorRouteSteps[Index]) Then
            Return False
        End If

    End For

    For Index = 0 To ScratchActorCount - 1

        If ScratchActorVisible[Index] = 1 Then

            If Not World.SetActorVisible(StateHandle, ScratchActorIds[Index], True) Then
                Return False
            End If

        End If

    End For

    If (Not World.SetCurrentScene(StateHandle, ScratchCurrentSceneId) Or
        Not World.SetControlledActor(StateHandle, ScratchControlledActorId) Or
        Not World.SetReturnLocation(StateHandle, ScratchReturnSceneId, ScratchReturnCellX, ScratchReturnCellY, ScratchReturnFacing)) Then
        Return False
    End If

    Return True

End Function

Private Sub SnapshotRollbackReservations(StateHandle As Number)

    Dim Index As Number
    Dim ActorId As Number

    RollbackActorCount = World.ActorCount(StateHandle)

    For Index = 0 To RollbackActorCount - 1

        ActorId = World.ActorIdAt(StateHandle, Index)
        RollbackActorIds[Index] = ActorId
        RollbackActorReserved[Index] = World.ActorHasReservation(StateHandle, ActorId)
        RollbackActorReservedX[Index] = World.ActorReservedDestinationX(StateHandle, ActorId)
        RollbackActorReservedY[Index] = World.ActorReservedDestinationY(StateHandle, ActorId)
    End For

End Sub

Private Function RestoreRollbackReservations(StateHandle As Number) As Boolean

    Dim Index As Number
    Dim ActorId As Number

    For Index = 0 To RollbackActorCount - 1

        ActorId = RollbackActorIds[Index]

        If World.ActorHasReservation(StateHandle, ActorId) Then

            If (Not RollbackActorReserved[Index] Or
                World.ActorReservedDestinationX(StateHandle, ActorId) <> RollbackActorReservedX[Index] Or
                World.ActorReservedDestinationY(StateHandle, ActorId) <> RollbackActorReservedY[Index]) Then
                Call World.CancelReservedMove(StateHandle, ActorId)
            End If

        End If

        If (RollbackActorReserved[Index] And
            Not World.ActorHasReservation(StateHandle, ActorId) And
            Not World.TryReserveDestination(StateHandle, ActorId, RollbackActorReservedX[Index], RollbackActorReservedY[Index])) Then
            Return False
        End If

    End For

    Return True

End Function

Private Function ApplyScratch(StateHandle As Number) As Boolean

    Dim Index As Number
    Dim ShopIndex As Number
    Dim CharacterId As Number

    If (Not Characters.ResetProgress(StateHandle) Or
        Not Party.ClearParty(StateHandle) Or
        Not Party.SetGold(StateHandle, 0) Or
        Not Inventory.ClearInventory(StateHandle) Or
        Not Equipment.ClearAllEquipment(StateHandle) Or
        Not Abilities.ClearAllLearnedAbilities(StateHandle) Or
        Not ApplyScratchWorld(StateHandle) Or
        Not Story.Reset(StateHandle) Or
        Not Encounters.ResetProgress(StateHandle)) Then
        Return False
    End If

    For ShopIndex = 0 To Shops.ShopCount(StateHandle) - 1

        If Not Shops.ResetShopStock(StateHandle, Shops.ShopIdAt(StateHandle, ShopIndex)) Then
            Return False
        End If

    End For

    For Index = 0 To ScratchCharacterCount - 1

        CharacterId = ScratchCharacterIds[Index]

        If (Not Characters.SetLevel(StateHandle, CharacterId, ScratchLevels[Index]) Or
            Not Characters.SetExperience(StateHandle, CharacterId, ScratchExperience[Index]) Or
            Not Characters.SetMaximumHealth(StateHandle, CharacterId, ScratchMaximumHealth[Index]) Or
            Not Characters.SetHealth(StateHandle, CharacterId, ScratchHealth[Index]) Or
            Not Characters.SetMaximumMagicPoints(StateHandle, CharacterId, ScratchMaximumMagicPoints[Index]) Or
            Not Characters.SetMagicPoints(StateHandle, CharacterId, ScratchMagicPoints[Index]) Or
            Not Characters.SetStrength(StateHandle, CharacterId, ScratchStrength[Index]) Or
            Not Characters.SetDefense(StateHandle, CharacterId, ScratchDefense[Index]) Or
            Not Characters.SetMagic(StateHandle, CharacterId, ScratchMagic[Index]) Or
            Not Characters.SetResistance(StateHandle, CharacterId, ScratchResistance[Index]) Or
            Not Characters.SetAgility(StateHandle, CharacterId, ScratchAgility[Index]) Or
            Not Characters.SetLuck(StateHandle, CharacterId, ScratchLuck[Index])) Then
            Return False
        End If

    End For

    For Index = 0 To ScratchPartyCount - 1

        If Not Party.AddCharacter(StateHandle, ScratchPartyIds[Index]) Then
            Return False
        End If

    End For

    If Not Party.SetGold(StateHandle, ScratchGold) Then
        Return False
    End If

    For Index = 0 To ScratchEquipmentCount - 1

        If (Not Inventory.AddItem(StateHandle, ScratchEquipmentItemIds[Index], 1) Or
            Not Equipment.Equip(StateHandle, ScratchEquipmentCharacterIds[Index], ScratchEquipmentSlotIds[Index], ScratchEquipmentItemIds[Index])) Then
            Return False
        End If

    End For

    For Index = 0 To ScratchInventoryCount - 1

        If Not Inventory.AddItem(StateHandle, ScratchInventoryItemIds[Index], ScratchInventoryQuantities[Index]) Then
            Return False
        End If

    End For

    For Index = 0 To ScratchLearnedCount - 1

        If Not Abilities.LearnAbility(StateHandle, ScratchLearnedCharacterIds[Index], ScratchLearnedAbilityIds[Index]) Then
            Return False
        End If

    End For

    For Index = 0 To ScratchShopCount - 1

        If Not Shops.SetStock(StateHandle, ScratchShopIds[Index], ScratchShopItemIds[Index], ScratchShopStock[Index]) Then
            Return False
        End If

    End For

    For Index = 0 To ScratchFlagCount - 1

        If Not Story.SetFlag(StateHandle, ScratchFlagIds[Index], ScratchFlagValues[Index] = 1) Then
            Return False
        End If

    End For

    For Index = 0 To ScratchValueCount - 1

        If Not Story.SetValue(StateHandle, ScratchValueIds[Index], ScratchValueValues[Index]) Then
            Return False
        End If

    End For

    If Not Encounters.SetPendingEncounter(StateHandle, ScratchPendingEncounterId) Then
        Return False
    End If

    For Index = 0 To ScratchZoneCount - 1

        If Not Encounters.SetProgress(StateHandle, ScratchZoneIds[Index], ScratchZoneStepCounts[Index], ScratchZoneSeeds[Index]) Then
            Return False
        End If

    End For

    Return True

End Function

''' Validates the module buffer completely, then replaces dynamic state transactionally.
Public Function Decode(StateHandle As Number, ExpectedSchemaVersion As Number) As Number

    Dim Result As Number
    Dim IncomingCount As Number
    Dim RollbackCount As Number
    Dim Index As Number
    Dim Restored As Boolean

    If Not Core.IsValid(StateHandle) Then
        Return Core.RPG_RESULT_INVALID_STATE
    End If

    If Battle.IsActive(StateHandle) Then
        Return Core.RPG_RESULT_BATTLE_ACTIVE
    End If

    If ExpectedSchemaVersion <= 0 Or Not Core.IsValidValue(ExpectedSchemaVersion) Then
        Return Core.RPG_RESULT_INVALID_ARGUMENT
    End If

    Result = ParseEncoded(StateHandle, ExpectedSchemaVersion)

    If Result <> Core.RPG_RESULT_OK Then
        Return Result
    End If

    IncomingCount = BufferCount

    For Index = 0 To IncomingCount - 1
        IncomingBytes[Index] = EncodedBytes[Index]
    End For

    Result = Encode(StateHandle, ExpectedSchemaVersion)

    If Result <> Core.RPG_RESULT_OK Then

        For Index = 0 To IncomingCount - 1
            EncodedBytes[Index] = IncomingBytes[Index]
        End For
        BufferCount = IncomingCount
        Return Core.RPG_RESULT_APPLY_FAILED

    End If

    RollbackCount = BufferCount

    For Index = 0 To RollbackCount - 1
        RollbackBytes[Index] = EncodedBytes[Index]
    End For

    Call SnapshotRollbackReservations(StateHandle)

    For Index = 0 To IncomingCount - 1
        EncodedBytes[Index] = IncomingBytes[Index]
    End For

    BufferCount = IncomingCount

    If ApplyScratch(StateHandle) Then
        Return Core.RPG_RESULT_OK
    End If

    For Index = 0 To RollbackCount - 1
        EncodedBytes[Index] = RollbackBytes[Index]
    End For

    BufferCount = RollbackCount
    Result = ParseEncoded(StateHandle, ExpectedSchemaVersion)

    If Result = Core.RPG_RESULT_OK Then

        Restored = ApplyScratch(StateHandle)

        If Restored Then
            Restored = RestoreRollbackReservations(StateHandle)
        End If

    End If

    For Index = 0 To IncomingCount - 1
        EncodedBytes[Index] = IncomingBytes[Index]
    End For

    BufferCount = IncomingCount
    Return Core.RPG_RESULT_APPLY_FAILED

End Function

''' Returns the number of bytes currently available to Decode.
Public Function EncodedByteCount() As Number

    Return BufferCount

End Function

''' Returns one encoded byte, or -1 when the index is outside the current payload.
Public Function EncodedByteAt(Index As Number) As Number

    Dim ReturnValue As Number

    If Index < 0 Or Index >= BufferCount Then
        ReturnValue = -1

        Return ReturnValue
    End If

    ReturnValue = EncodedBytes[Index]

    Return ReturnValue

End Function

''' Clears the public in-memory codec buffer.
Public Sub ClearEncodedBytes()

    BufferCount = 0

End Sub

''' Appends or replaces one byte for deterministic decoder tests and export workflows.
Public Function SetEncodedByte(Index As Number, Value As Number) As Boolean

    If (Index < 0 Or
        Index >= Core.RPG_MAX_SAVE_BYTES Or
        Value < 0 Or
        Value > 255) Then
        Return False
    End If

    EncodedBytes[Index] = Value

    If Index >= BufferCount Then
        BufferCount = Index + 1
    End If

    Return True

End Function

''' Saves the current dynamic state to one of eight literal Phase 4 Data keys.
Public Function SaveGame(StateHandle As Number, SaveSlot As Number, SchemaVersion As Number) As Number

    Dim Result As Number

    If Not Core.IsValid(StateHandle) Then
        Return Core.RPG_RESULT_INVALID_STATE
    End If

    If Battle.IsActive(StateHandle) Then
        Return Core.RPG_RESULT_BATTLE_ACTIVE
    End If

    If SaveSlot < 1 Or SaveSlot > Core.RPG_MAX_SAVE_SLOTS Then
        Return Core.RPG_RESULT_INVALID_ARGUMENT
    End If

    Result = Encode(StateHandle, SchemaVersion)

    If Result <> Core.RPG_RESULT_OK Then
        Return Result
    End If

    Select Case SaveSlot
        Case 1
            Save Data EncodedBytes Count BufferCount To "Smile.RPG.Save.1"
        Case 2
            Save Data EncodedBytes Count BufferCount To "Smile.RPG.Save.2"
        Case 3
            Save Data EncodedBytes Count BufferCount To "Smile.RPG.Save.3"
        Case 4
            Save Data EncodedBytes Count BufferCount To "Smile.RPG.Save.4"
        Case 5
            Save Data EncodedBytes Count BufferCount To "Smile.RPG.Save.5"
        Case 6
            Save Data EncodedBytes Count BufferCount To "Smile.RPG.Save.6"
        Case 7
            Save Data EncodedBytes Count BufferCount To "Smile.RPG.Save.7"
        Case 8
            Save Data EncodedBytes Count BufferCount To "Smile.RPG.Save.8"
    End Select

    Return Core.RPG_RESULT_OK

End Function

''' Loads, validates, and transactionally applies one persistent save slot.
Public Function LoadGame(StateHandle As Number, SaveSlot As Number, ExpectedSchemaVersion As Number) As Number

    Dim ReturnValue As Number

    If Not Core.IsValid(StateHandle) Then
        Return Core.RPG_RESULT_INVALID_STATE
    End If

    If Battle.IsActive(StateHandle) Then
        Return Core.RPG_RESULT_BATTLE_ACTIVE
    End If

    If SaveSlot < 1 Or SaveSlot > Core.RPG_MAX_SAVE_SLOTS Then
        Return Core.RPG_RESULT_INVALID_ARGUMENT
    End If

    BufferCount = 0

    Select Case SaveSlot
        Case 1
            Load Data "Smile.RPG.Save.1" Into EncodedBytes Count BufferCount
        Case 2
            Load Data "Smile.RPG.Save.2" Into EncodedBytes Count BufferCount
        Case 3
            Load Data "Smile.RPG.Save.3" Into EncodedBytes Count BufferCount
        Case 4
            Load Data "Smile.RPG.Save.4" Into EncodedBytes Count BufferCount
        Case 5
            Load Data "Smile.RPG.Save.5" Into EncodedBytes Count BufferCount
        Case 6
            Load Data "Smile.RPG.Save.6" Into EncodedBytes Count BufferCount
        Case 7
            Load Data "Smile.RPG.Save.7" Into EncodedBytes Count BufferCount
        Case 8
            Load Data "Smile.RPG.Save.8" Into EncodedBytes Count BufferCount
    End Select

    If BufferCount <= 0 Then
        Return Core.RPG_RESULT_NOT_FOUND_OR_INVALID_SAVE
    End If

    ReturnValue = Decode(StateHandle, ExpectedSchemaVersion)

    Return ReturnValue

End Function

''' Checks for a Phase 4 Data block without changing the public codec buffer or RPG state.
Public Function Exists(StateHandle As Number, SaveSlot As Number) As Boolean

    Dim ProbeCount As Number
    Dim ReturnValue As Boolean

    If (Not Core.IsValid(StateHandle) Or
        SaveSlot < 1 Or
        SaveSlot > Core.RPG_MAX_SAVE_SLOTS) Then
        Return False
    End If

    ProbeCount = 0

    Select Case SaveSlot
        Case 1
            Load Data "Smile.RPG.Save.1" Into IncomingBytes Count ProbeCount
        Case 2
            Load Data "Smile.RPG.Save.2" Into IncomingBytes Count ProbeCount
        Case 3
            Load Data "Smile.RPG.Save.3" Into IncomingBytes Count ProbeCount
        Case 4
            Load Data "Smile.RPG.Save.4" Into IncomingBytes Count ProbeCount
        Case 5
            Load Data "Smile.RPG.Save.5" Into IncomingBytes Count ProbeCount
        Case 6
            Load Data "Smile.RPG.Save.6" Into IncomingBytes Count ProbeCount
        Case 7
            Load Data "Smile.RPG.Save.7" Into IncomingBytes Count ProbeCount
        Case 8
            Load Data "Smile.RPG.Save.8" Into IncomingBytes Count ProbeCount
    End Select

    ReturnValue = ProbeCount > 0

    Return ReturnValue

End Function

End Module
