''' Data-driven deterministic camera shots and shake timelines.
Module Smile.Battle3D.Camera

Option Explicit

Import Smile.RPG.Core As RPG
Import Smile.Simple3D.Core As SimpleCore
Import Smile.Simple3D.Interaction As Interaction
Import Smile.Simple3D.FixedMath As Math3D

Public Const BATTLE3D_MAX_CAMERA_SHOTS = 32
Public Const BATTLE3D_MAX_CAMERA_STEPS = 10000

Public Type ShotDefinition
    Id As Number
    Name As Text
    PositionX As Number
    PositionY As Number
    PositionZ As Number
    TargetX As Number
    TargetY As Number
    TargetZ As Number
    FovDegrees As Number
    Duration As Number
End Type

''' World-space extents used to frame any combat group without actor-specific camera coordinates.
Public Type FramingBounds3D
    MinX As Number
    MinY As Number
    MinZ As Number
    MaxX As Number
    MaxY As Number
    MaxZ As Number
End Type

''' Logical-canvas projection used for screen-space interaction and actor exclusion.
Public Type ProjectedPoint3D
    X As Number
    Y As Number
    Depth As Number
    Visible As Boolean
End Type

Private Dim StateGeneration[4] As Number
Private Dim ShotCounts[4] As Number
Private Dim ShotIds[4, 32] As Number
Private Dim ShotNames[4, 32] As Text
Private Dim ShotPositionX[4, 32] As Number
Private Dim ShotPositionY[4, 32] As Number
Private Dim ShotPositionZ[4, 32] As Number
Private Dim ShotTargetX[4, 32] As Number
Private Dim ShotTargetY[4, 32] As Number
Private Dim ShotTargetZ[4, 32] As Number
Private Dim ShotFov[4, 32] As Number
Private Dim ShotDurations[4, 32] As Number
Private Dim CurrentShotIds[4] As Number
Private Dim StartPositionX[4] As Number
Private Dim StartPositionY[4] As Number
Private Dim StartPositionZ[4] As Number
Private Dim StartTargetX[4] As Number
Private Dim StartTargetY[4] As Number
Private Dim StartTargetZ[4] As Number
Private Dim StartFov[4] As Number
Private Dim CurrentPositionX[4] As Number
Private Dim CurrentPositionY[4] As Number
Private Dim CurrentPositionZ[4] As Number
Private Dim CurrentTargetX[4] As Number
Private Dim CurrentTargetY[4] As Number
Private Dim CurrentTargetZ[4] As Number
Private Dim CurrentFov[4] As Number
Private Dim TargetPositionX[4] As Number
Private Dim TargetPositionY[4] As Number
Private Dim TargetPositionZ[4] As Number
Private Dim TargetTargetX[4] As Number
Private Dim TargetTargetY[4] As Number
Private Dim TargetTargetZ[4] As Number
Private Dim TargetFov[4] As Number
Private Dim TimelineSteps[4] As Number
Private Dim TimelineDurations[4] As Number
Private Dim ShakeAmplitudes[4] As Number
Private Dim ShakeSteps[4] As Number
Private Dim ShakeDurations[4] As Number
Private Dim ShakeSeeds[4] As Number
Private Dim ShakeOffsetX[4] As Number
Private Dim ShakeOffsetY[4] As Number
Private Dim ShakeOffsetZ[4] As Number
Private Dim ManualControls[4] As SimpleCore.CameraControl3D

Private Sub ResetSlot(Slot As Number)

    Dim Index As Number

    For Index = 0 To BATTLE3D_MAX_CAMERA_SHOTS - 1
        ShotIds[Slot, Index] = 0
        ShotNames[Slot, Index] = ""
    End For

    ShotCounts[Slot] = 0
    CurrentShotIds[Slot] = 0
    TimelineSteps[Slot] = 0
    TimelineDurations[Slot] = 0
    ShakeAmplitudes[Slot] = 0
    ShakeSteps[Slot] = 0
    ShakeDurations[Slot] = 0
    ShakeOffsetX[Slot] = 0
    ShakeOffsetY[Slot] = 0
    ShakeOffsetZ[Slot] = 0

    Call Interaction.ResetCameraControls(ManualControls[Slot])

End Sub

Private Function StateSlot(StateHandle As Number) As Number

    Dim ReturnValue As Number

    Dim Slot As Number
    Dim Generation As Number

    Slot = RPG.StateSlot(StateHandle)

    If Slot < 0 Then
        ReturnValue = -1

        Return ReturnValue
    End If

    Generation = RPG.StateGeneration(StateHandle)

    If StateGeneration[Slot] <> Generation Then
        Call ResetSlot(Slot)

        StateGeneration[Slot] = Generation
    End If

    Return Slot

End Function

Private Sub UpdateManualReturn(Slot As Number)

    Dim Accepted As Boolean

    Accepted = Interaction.AdvanceCameraControls(ManualControls[Slot], 1)

End Sub

''' Applies simultaneous drag-pan and wheel-zoom input without interrupting the active shot.
Public Function UpdateManualInput(
    StateHandle As Number,
    Pressed As Boolean,
    Held As Boolean,
    Released As Boolean,
    DeltaX As Number,
    DeltaY As Number,
    WheelDelta As Number
) As Boolean

    Dim ReturnValue As Boolean

    Dim Slot As Number

    Slot = StateSlot(StateHandle)

    If Slot < 0 Then
        Return False
    End If

    ReturnValue = Interaction.UpdatePanZoomControls(
        ManualControls[Slot],
        Pressed,
        Held,
        Released,
        DeltaX,
        DeltaY,
        WheelDelta
    )

    Return ReturnValue

End Function

''' Applies middle-drag orbit input alongside independent pan and wheel zoom input.
Public Function UpdateManualOrbitInput(
    StateHandle As Number,
    Pressed As Boolean,
    Held As Boolean,
    Released As Boolean,
    DeltaX As Number,
    DeltaY As Number
) As Boolean

    Dim ReturnValue As Boolean

    Dim Slot As Number

    Slot = StateSlot(StateHandle)

    If Slot < 0 Then
        Return False
    End If

    ReturnValue = Interaction.UpdateOrbitControls(
        ManualControls[Slot],
        Pressed,
        Held,
        Released,
        DeltaX,
        DeltaY
    )

    Return ReturnValue

End Function

Private Function ShotIndex(StateHandle As Number, ShotId As Number) As Number

    Dim ReturnValue As Number

    Dim Slot As Number
    Dim Index As Number

    Slot = StateSlot(StateHandle)

    If Slot < 0 Then
        ReturnValue = -1

        Return ReturnValue
    End If

    For Index = 0 To ShotCounts[Slot] - 1

        If ShotIds[Slot, Index] = ShotId Then
            Return Index
        End If

    End For

    ReturnValue = -1

    Return ReturnValue

End Function

Public Function DefineShot(StateHandle As Number, ByRef Definition As ShotDefinition) As Boolean

    Dim Slot As Number
    Dim Index As Number

    Slot = StateSlot(StateHandle)
    Index = ShotIndex(StateHandle, Definition.Id)

    If (Slot < 0 Or
        Definition.Id <= 0 Or
        Definition.Name = "" Or
        Definition.FovDegrees < 10 Or
        Definition.FovDegrees > 150 Or
        Definition.Duration < 0 Or
        Definition.Duration > BATTLE3D_MAX_CAMERA_STEPS) Then
        Return False
    End If

    If Index < 0 Then

        If ShotCounts[Slot] >= BATTLE3D_MAX_CAMERA_SHOTS Then
            Return False
        End If

        Index = ShotCounts[Slot]
        ShotCounts[Slot] = Index + 1

    End If

    ShotIds[Slot, Index] = Definition.Id
    ShotNames[Slot, Index] = Definition.Name
    ShotPositionX[Slot, Index] = Definition.PositionX
    ShotPositionY[Slot, Index] = Definition.PositionY
    ShotPositionZ[Slot, Index] = Definition.PositionZ
    ShotTargetX[Slot, Index] = Definition.TargetX
    ShotTargetY[Slot, Index] = Definition.TargetY
    ShotTargetZ[Slot, Index] = Definition.TargetZ
    ShotFov[Slot, Index] = Definition.FovDegrees
    ShotDurations[Slot, Index] = Definition.Duration
    Return True

End Function

''' Defines a shot whose distance adapts to world bounds and the logical viewport aspect ratio.
Public Function DefineFramedShot(
    StateHandle As Number,
    ShotId As Number,
    Name As Text,
    ByRef Bounds As FramingBounds3D,
    ViewXPercent As Number,
    ViewYPercent As Number,
    ViewZPercent As Number,
    ViewportWidth As Number,
    ViewportHeight As Number,
    FovDegrees As Number,
    PaddingPercent As Number,
    Duration As Number
) As Boolean

    Dim Definition As ShotDefinition
    Dim CenterX As Number
    Dim CenterY As Number
    Dim CenterZ As Number
    Dim SpanX As Number
    Dim SpanY As Number
    Dim SpanZ As Number
    Dim HorizontalSpan As Number
    Dim FramingSpan As Number
    Dim Distance As Number
    Dim Accepted As Boolean

    If (Bounds.MaxX <= Bounds.MinX Or
        Bounds.MaxY <= Bounds.MinY Or
        Bounds.MaxZ <= Bounds.MinZ Or
        ViewportWidth <= 0 Or
        ViewportHeight <= 0 Or
        FovDegrees < 10 Or
        FovDegrees > 150 Or
        PaddingPercent < 0 Or
        PaddingPercent > 300 Or
        (ViewXPercent = 0 And ViewYPercent = 0 And ViewZPercent = 0)) Then
        Return False
    End If

    CenterX = (Bounds.MinX + Bounds.MaxX) / 2
    CenterY = (Bounds.MinY + Bounds.MaxY) / 2
    CenterZ = (Bounds.MinZ + Bounds.MaxZ) / 2
    SpanX = Bounds.MaxX - Bounds.MinX
    SpanY = Bounds.MaxY - Bounds.MinY
    SpanZ = Bounds.MaxZ - Bounds.MinZ
    HorizontalSpan = SpanX * ViewportHeight / ViewportWidth
    FramingSpan = Max(SpanY, HorizontalSpan) + SpanZ / 2
    Distance = Max(100, FramingSpan * (100 + PaddingPercent) * 70 / (100 * FovDegrees))

    Definition.Id = ShotId
    Definition.Name = Name
    Definition.PositionX = CenterX + ViewXPercent * Distance / 100
    Definition.PositionY = CenterY + ViewYPercent * Distance / 100
    Definition.PositionZ = CenterZ + ViewZPercent * Distance / 100
    Definition.TargetX = CenterX
    Definition.TargetY = CenterY
    Definition.TargetZ = CenterZ
    Definition.FovDegrees = FovDegrees
    Definition.Duration = Duration
    Accepted = DefineShot(StateHandle, Definition)

    Return Accepted

End Function

''' Immediately tracks a moving world point while retaining the active shot identity and manual offsets.
Public Function FollowPoint(
    StateHandle As Number,
    PointX As Number,
    PointY As Number,
    PointZ As Number,
    OffsetX As Number,
    OffsetY As Number,
    OffsetZ As Number,
    FovDegrees As Number
) As Boolean

    Dim Slot As Number

    Slot = StateSlot(StateHandle)

    If (Slot < 0 Or
        FovDegrees < 10 Or
        FovDegrees > 150) Then
        Return False
    End If

    CurrentPositionX[Slot] = PointX + OffsetX
    CurrentPositionY[Slot] = PointY + OffsetY
    CurrentPositionZ[Slot] = PointZ + OffsetZ
    CurrentTargetX[Slot] = PointX
    CurrentTargetY[Slot] = PointY
    CurrentTargetZ[Slot] = PointZ
    CurrentFov[Slot] = FovDegrees
    TargetPositionX[Slot] = CurrentPositionX[Slot]
    TargetPositionY[Slot] = CurrentPositionY[Slot]
    TargetPositionZ[Slot] = CurrentPositionZ[Slot]
    TargetTargetX[Slot] = PointX
    TargetTargetY[Slot] = PointY
    TargetTargetZ[Slot] = PointZ
    TargetFov[Slot] = FovDegrees
    TimelineSteps[Slot] = 0
    TimelineDurations[Slot] = 0
    Return True

End Function

Private Sub CaptureStart(Slot As Number)

    StartPositionX[Slot] = CurrentPositionX[Slot]
    StartPositionY[Slot] = CurrentPositionY[Slot]
    StartPositionZ[Slot] = CurrentPositionZ[Slot]
    StartTargetX[Slot] = CurrentTargetX[Slot]
    StartTargetY[Slot] = CurrentTargetY[Slot]
    StartTargetZ[Slot] = CurrentTargetZ[Slot]
    StartFov[Slot] = CurrentFov[Slot]

End Sub

Private Sub ApplyTarget(Slot As Number)

    CurrentPositionX[Slot] = TargetPositionX[Slot]
    CurrentPositionY[Slot] = TargetPositionY[Slot]
    CurrentPositionZ[Slot] = TargetPositionZ[Slot]
    CurrentTargetX[Slot] = TargetTargetX[Slot]
    CurrentTargetY[Slot] = TargetTargetY[Slot]
    CurrentTargetZ[Slot] = TargetTargetZ[Slot]
    CurrentFov[Slot] = TargetFov[Slot]

End Sub

''' Starts a shot, using its data duration when DurationOverride is zero.
Public Function PlayShot(StateHandle As Number, ShotId As Number, DurationOverride As Number) As Boolean

    Dim Slot As Number
    Dim Index As Number

    Slot = StateSlot(StateHandle)
    Index = ShotIndex(StateHandle, ShotId)

    If (Slot < 0 Or
        Index < 0 Or
        DurationOverride < 0 Or
        DurationOverride > BATTLE3D_MAX_CAMERA_STEPS) Then
        Return False
    End If

    Call CaptureStart(Slot)

    TargetPositionX[Slot] = ShotPositionX[Slot, Index]
    TargetPositionY[Slot] = ShotPositionY[Slot, Index]
    TargetPositionZ[Slot] = ShotPositionZ[Slot, Index]
    TargetTargetX[Slot] = ShotTargetX[Slot, Index]
    TargetTargetY[Slot] = ShotTargetY[Slot, Index]
    TargetTargetZ[Slot] = ShotTargetZ[Slot, Index]
    TargetFov[Slot] = ShotFov[Slot, Index]
    TimelineSteps[Slot] = 0
    TimelineDurations[Slot] = DurationOverride

    If DurationOverride = 0 Then
        TimelineDurations[Slot] = ShotDurations[Slot, Index]
    End If

    CurrentShotIds[Slot] = ShotId

    If TimelineDurations[Slot] = 0 Then
        Call ApplyTarget(Slot)
    End If

    Return True

End Function

''' Starts a shot with bounded positional, target, and lens variation.
Public Function PlayShotVariation(
    StateHandle As Number,
    ShotId As Number,
    DurationOverride As Number,
    PositionOffsetX As Number,
    PositionOffsetY As Number,
    PositionOffsetZ As Number,
    TargetOffsetX As Number,
    TargetOffsetY As Number,
    TargetOffsetZ As Number,
    FovOffset As Number
) As Boolean

    Dim Slot As Number
    Dim Index As Number

    Slot = StateSlot(StateHandle)
    Index = ShotIndex(StateHandle, ShotId)

    If (Slot < 0 Or
        Index < 0 Or
        DurationOverride < 0 Or
        DurationOverride > BATTLE3D_MAX_CAMERA_STEPS Or
        Abs(PositionOffsetX) > 1000 Or
        Abs(PositionOffsetY) > 1000 Or
        Abs(PositionOffsetZ) > 1000 Or
        Abs(TargetOffsetX) > 1000 Or
        Abs(TargetOffsetY) > 1000 Or
        Abs(TargetOffsetZ) > 1000 Or
        ShotFov[Slot, Index] + FovOffset < 10 Or
        ShotFov[Slot, Index] + FovOffset > 150) Then
        Return False
    End If

    Call CaptureStart(Slot)

    TargetPositionX[Slot] = ShotPositionX[Slot, Index] + PositionOffsetX
    TargetPositionY[Slot] = ShotPositionY[Slot, Index] + PositionOffsetY
    TargetPositionZ[Slot] = ShotPositionZ[Slot, Index] + PositionOffsetZ
    TargetTargetX[Slot] = ShotTargetX[Slot, Index] + TargetOffsetX
    TargetTargetY[Slot] = ShotTargetY[Slot, Index] + TargetOffsetY
    TargetTargetZ[Slot] = ShotTargetZ[Slot, Index] + TargetOffsetZ
    TargetFov[Slot] = ShotFov[Slot, Index] + FovOffset
    TimelineSteps[Slot] = 0
    TimelineDurations[Slot] = DurationOverride

    If DurationOverride = 0 Then
        TimelineDurations[Slot] = ShotDurations[Slot, Index]
    End If

    CurrentShotIds[Slot] = ShotId

    If TimelineDurations[Slot] = 0 Then
        Call ApplyTarget(Slot)
    End If

    Return True

End Function

Public Function StartShake(StateHandle As Number, Amplitude As Number, Duration As Number, Seed As Number) As Boolean

    Dim Slot As Number

    Slot = StateSlot(StateHandle)

    If (Slot < 0 Or
        Amplitude < 0 Or
        Duration < 0 Or
        Duration > BATTLE3D_MAX_CAMERA_STEPS) Then
        Return False
    End If

    ShakeAmplitudes[Slot] = Amplitude
    ShakeSteps[Slot] = 0
    ShakeDurations[Slot] = Duration
    ShakeSeeds[Slot] = Seed Mod 65536
    ShakeOffsetX[Slot] = 0
    ShakeOffsetY[Slot] = 0
    ShakeOffsetZ[Slot] = 0
    Return True

End Function

Private Function Interpolate(StartValue As Number, EndValue As Number, Elapsed As Number, Duration As Number) As Number

    Dim ReturnValue As Number

    If Duration <= 0 Or Elapsed >= Duration Then
        Return EndValue
    End If

    ReturnValue = StartValue + (EndValue - StartValue) * Elapsed / Duration

    Return ReturnValue

End Function

Private Function NextShakeValue(Slot As Number) As Number

    Dim ReturnValue As Number

    ShakeSeeds[Slot] = (ShakeSeeds[Slot] * 25173 + 13849) Mod 65536

    ReturnValue = ShakeSeeds[Slot]

    Return ReturnValue

End Function

Public Function Update(StateHandle As Number, Steps As Number) As Boolean

    Dim Slot As Number
    Dim StepIndex As Number
    Dim CurrentAmplitude As Number

    Slot = StateSlot(StateHandle)

    If (Slot < 0 Or
        Steps < 0 Or
        Steps > BATTLE3D_MAX_CAMERA_STEPS) Then
        Return False
    End If

    For StepIndex = 1 To Steps

        If TimelineSteps[Slot] < TimelineDurations[Slot] Then

            TimelineSteps[Slot] = TimelineSteps[Slot] + 1
            CurrentPositionX[Slot] = Interpolate(StartPositionX[Slot], TargetPositionX[Slot], TimelineSteps[Slot], TimelineDurations[Slot])
            CurrentPositionY[Slot] = Interpolate(StartPositionY[Slot], TargetPositionY[Slot], TimelineSteps[Slot], TimelineDurations[Slot])
            CurrentPositionZ[Slot] = Interpolate(StartPositionZ[Slot], TargetPositionZ[Slot], TimelineSteps[Slot], TimelineDurations[Slot])
            CurrentTargetX[Slot] = Interpolate(StartTargetX[Slot], TargetTargetX[Slot], TimelineSteps[Slot], TimelineDurations[Slot])
            CurrentTargetY[Slot] = Interpolate(StartTargetY[Slot], TargetTargetY[Slot], TimelineSteps[Slot], TimelineDurations[Slot])
            CurrentTargetZ[Slot] = Interpolate(StartTargetZ[Slot], TargetTargetZ[Slot], TimelineSteps[Slot], TimelineDurations[Slot])
            CurrentFov[Slot] = Interpolate(StartFov[Slot], TargetFov[Slot], TimelineSteps[Slot], TimelineDurations[Slot])

        End If

        If ShakeSteps[Slot] < ShakeDurations[Slot] Then

            ShakeSteps[Slot] = ShakeSteps[Slot] + 1
            CurrentAmplitude = ShakeAmplitudes[Slot] * (ShakeDurations[Slot] - ShakeSteps[Slot]) / ShakeDurations[Slot]
            ShakeOffsetX[Slot] = (NextShakeValue(Slot) Mod (CurrentAmplitude * 2 + 1)) - CurrentAmplitude
            ShakeOffsetY[Slot] = (NextShakeValue(Slot) Mod (CurrentAmplitude * 2 + 1)) - CurrentAmplitude
            ShakeOffsetZ[Slot] = (NextShakeValue(Slot) Mod (CurrentAmplitude * 2 + 1)) - CurrentAmplitude

        Else
            ShakeOffsetX[Slot] = 0
            ShakeOffsetY[Slot] = 0
            ShakeOffsetZ[Slot] = 0

        End If

        Call UpdateManualReturn(Slot)
    End For

    Return True

End Function

''' Advances only the manual return spring, allowing camera control while simulation is paused.
Public Function UpdateManualReturnOnly(StateHandle As Number, Steps As Number) As Boolean

    Dim Slot As Number
    Dim StepIndex As Number

    Slot = StateSlot(StateHandle)

    If (Slot < 0 Or
        Steps < 0 Or
        Steps > BATTLE3D_MAX_CAMERA_STEPS) Then
        Return False
    End If

    For StepIndex = 1 To Steps
        Call UpdateManualReturn(Slot)
    End For

    Return True

End Function

Private Function OrbitPositionX(Slot As Number) As Number

    Dim ReturnValue As Number
    Dim DeltaX As Number
    Dim DeltaZ As Number
    Dim CosYaw As Number
    Dim SinYaw As Number

    DeltaX = CurrentPositionX[Slot] - CurrentTargetX[Slot]
    DeltaZ = CurrentPositionZ[Slot] - CurrentTargetZ[Slot]
    CosYaw = Math3D.CosFixed(ManualControls[Slot].OrbitYaw)
    SinYaw = Math3D.SinFixed(ManualControls[Slot].OrbitYaw)
    ReturnValue = CurrentTargetX[Slot] + (DeltaX * CosYaw - DeltaZ * SinYaw) / SimpleCore.FIXED_ONE

    Return ReturnValue

End Function

Private Function OrbitPositionZ(Slot As Number) As Number

    Dim ReturnValue As Number
    Dim DeltaX As Number
    Dim DeltaZ As Number
    Dim CosYaw As Number
    Dim SinYaw As Number

    DeltaX = CurrentPositionX[Slot] - CurrentTargetX[Slot]
    DeltaZ = CurrentPositionZ[Slot] - CurrentTargetZ[Slot]
    CosYaw = Math3D.CosFixed(ManualControls[Slot].OrbitYaw)
    SinYaw = Math3D.SinFixed(ManualControls[Slot].OrbitYaw)
    ReturnValue = CurrentTargetZ[Slot] + (DeltaX * SinYaw + DeltaZ * CosYaw) / SimpleCore.FIXED_ONE

    Return ReturnValue

End Function

Public Function PositionX(StateHandle As Number) As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    Slot = StateSlot(StateHandle)

    If Slot < 0 Then
        Return 0
    End If

    ReturnValue = OrbitPositionX(Slot) + ShakeOffsetX[Slot] + ManualControls[Slot].PanX

    Return ReturnValue

End Function

Public Function PositionY(StateHandle As Number) As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    Slot = StateSlot(StateHandle)

    If Slot < 0 Then
        Return 0
    End If

    ReturnValue = CurrentPositionY[Slot] + ShakeOffsetY[Slot] + ManualControls[Slot].PanY + ManualControls[Slot].OrbitPitch

    Return ReturnValue

End Function

Public Function PositionZ(StateHandle As Number) As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    Slot = StateSlot(StateHandle)

    If Slot < 0 Then
        Return 0
    End If

    ReturnValue = OrbitPositionZ(Slot) + ShakeOffsetZ[Slot]

    Return ReturnValue

End Function

Public Function TargetX(StateHandle As Number) As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    Slot = StateSlot(StateHandle)

    If Slot < 0 Then
        Return 0
    End If

    ReturnValue = CurrentTargetX[Slot] + ManualControls[Slot].PanX

    Return ReturnValue

End Function

Public Function TargetY(StateHandle As Number) As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    Slot = StateSlot(StateHandle)

    If Slot < 0 Then
        Return 0
    End If

    ReturnValue = CurrentTargetY[Slot] + ManualControls[Slot].PanY

    Return ReturnValue

End Function

Public Function TargetZ(StateHandle As Number) As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    Slot = StateSlot(StateHandle)

    If Slot < 0 Then
        Return 0
    End If

    ReturnValue = CurrentTargetZ[Slot]

    Return ReturnValue

End Function

Public Function FovDegrees(StateHandle As Number) As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    Slot = StateSlot(StateHandle)

    If Slot < 0 Then
        Return 0
    End If

    ReturnValue = Min(120, Max(18, CurrentFov[Slot] + ManualControls[Slot].Zoom))

    Return ReturnValue

End Function

Public Function ManualPanX(StateHandle As Number) As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    Slot = StateSlot(StateHandle)

    If Slot < 0 Then
        Return 0
    End If

    ReturnValue = ManualControls[Slot].PanX

    Return ReturnValue

End Function

Public Function ManualPanY(StateHandle As Number) As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    Slot = StateSlot(StateHandle)

    If Slot < 0 Then
        Return 0
    End If

    ReturnValue = ManualControls[Slot].PanY

    Return ReturnValue

End Function

Public Function ManualZoom(StateHandle As Number) As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    Slot = StateSlot(StateHandle)

    If Slot < 0 Then
        Return 0
    End If

    ReturnValue = ManualControls[Slot].Zoom

    Return ReturnValue

End Function

Public Function ManualOrbitYaw(StateHandle As Number) As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    Slot = StateSlot(StateHandle)

    If Slot < 0 Then
        Return 0
    End If

    ReturnValue = ManualControls[Slot].OrbitYaw

    Return ReturnValue

End Function

Public Function ManualOrbitPitch(StateHandle As Number) As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    Slot = StateSlot(StateHandle)

    If Slot < 0 Then
        Return 0
    End If

    ReturnValue = ManualControls[Slot].OrbitPitch

    Return ReturnValue

End Function

Public Function IsManualOrbiting(StateHandle As Number) As Boolean

    Dim ReturnValue As Boolean

    Dim Slot As Number

    Slot = StateSlot(StateHandle)

    If Slot < 0 Then
        Return False
    End If

    ReturnValue = ManualControls[Slot].Orbiting

    Return ReturnValue

End Function

Public Function IsManualDragging(StateHandle As Number) As Boolean

    Dim ReturnValue As Boolean

    Dim Slot As Number

    Slot = StateSlot(StateHandle)

    If Slot < 0 Then
        Return False
    End If

    ReturnValue = Interaction.CameraControlsDragging(ManualControls[Slot])

    Return ReturnValue

End Function

Public Function IsManualActive(StateHandle As Number) As Boolean

    Dim ReturnValue As Boolean

    Dim Slot As Number

    Slot = StateSlot(StateHandle)

    If Slot < 0 Then
        Return False
    End If

    ReturnValue = Interaction.CameraControlsActive(ManualControls[Slot])

    Return ReturnValue

End Function

Private Function IntegerSquareRoot(Value As Number) As Number

    Dim Guess As Number
    Dim NextGuess As Number
    Dim Index As Number

    If Value <= 0 Then
        Return 0
    End If

    Guess = Value

    For Index = 1 To 32

        NextGuess = (Guess + Value / Guess) / 2

        If NextGuess >= Guess Then
            Return Guess
        End If

        Guess = NextGuess
    End For

    Return Guess

End Function

''' Projects a world-space anchor to logical-canvas pixels using the active shot and manual offsets.
Public Function ProjectWorldPoint(
    StateHandle As Number,
    WorldX As Number,
    WorldY As Number,
    WorldZ As Number,
    ViewWidth As Number,
    ViewHeight As Number
) As ProjectedPoint3D

    Dim Result As ProjectedPoint3D
    Dim CameraX As Number
    Dim CameraY As Number
    Dim CameraZ As Number
    Dim ForwardX As Number
    Dim ForwardY As Number
    Dim ForwardZ As Number
    Dim ForwardLength As Number
    Dim HorizontalLength As Number
    Dim RightX As Number
    Dim RightZ As Number
    Dim UpX As Number
    Dim UpY As Number
    Dim UpZ As Number
    Dim DeltaX As Number
    Dim DeltaY As Number
    Dim DeltaZ As Number
    Dim ViewX As Number
    Dim ViewY As Number
    Dim FocalLength As Number

    If (StateSlot(StateHandle) < 0 Or
        ViewWidth <= 0 Or
        ViewHeight <= 0) Then
        Return Result
    End If

    CameraX = PositionX(StateHandle)
    CameraY = PositionY(StateHandle)
    CameraZ = PositionZ(StateHandle)
    ForwardX = TargetX(StateHandle) - CameraX
    ForwardY = TargetY(StateHandle) - CameraY
    ForwardZ = TargetZ(StateHandle) - CameraZ
    ForwardLength = IntegerSquareRoot(ForwardX * ForwardX + ForwardY * ForwardY + ForwardZ * ForwardZ)
    HorizontalLength = IntegerSquareRoot(ForwardX * ForwardX + ForwardZ * ForwardZ)

    If ForwardLength <= 0 Or HorizontalLength <= 0 Then
        Return Result
    End If

    RightX = ForwardZ * 1000 / HorizontalLength
    RightZ = (0 - ForwardX) * 1000 / HorizontalLength
    UpX = (0 - ForwardY) * ForwardX * 1000 / (ForwardLength * HorizontalLength)
    UpY = HorizontalLength * 1000 / ForwardLength
    UpZ = (0 - ForwardY) * ForwardZ * 1000 / (ForwardLength * HorizontalLength)
    ForwardX = ForwardX * 1000 / ForwardLength
    ForwardY = ForwardY * 1000 / ForwardLength
    ForwardZ = ForwardZ * 1000 / ForwardLength
    DeltaX = WorldX - CameraX
    DeltaY = WorldY - CameraY
    DeltaZ = WorldZ - CameraZ
    ViewX = (DeltaX * RightX + DeltaZ * RightZ) / 1000
    ViewY = (DeltaX * UpX + DeltaY * UpY + DeltaZ * UpZ) / 1000
    Result.Depth = (DeltaX * ForwardX + DeltaY * ForwardY + DeltaZ * ForwardZ) / 1000

    If Result.Depth <= 1 Then
        Return Result
    End If

    FocalLength = ViewHeight * 50 / Max(10, FovDegrees(StateHandle))
    Result.X = ViewWidth / 2 + ViewX * FocalLength / Result.Depth
    Result.Y = ViewHeight / 2 - ViewY * FocalLength / Result.Depth
    Result.Visible = (Result.X >= 0 And
        Result.X < ViewWidth And
        Result.Y >= 0 And
        Result.Y < ViewHeight)

    Return Result

End Function

Public Function CurrentShotId(StateHandle As Number) As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    Slot = StateSlot(StateHandle)

    If Slot < 0 Then
        Return 0
    End If

    ReturnValue = CurrentShotIds[Slot]

    Return ReturnValue

End Function

Public Function CurrentShotName(StateHandle As Number) As Text

    Dim ReturnValue As Text

    Dim Index As Number

    Index = ShotIndex(StateHandle, CurrentShotId(StateHandle))

    If Index < 0 Then
        Return ""
    End If

    ReturnValue = ShotNames[StateSlot(StateHandle), Index]

    Return ReturnValue

End Function

Public Function IsComplete(StateHandle As Number) As Boolean

    Dim ReturnValue As Boolean

    Dim Slot As Number

    Slot = StateSlot(StateHandle)

    If Slot < 0 Then
        Return False
    End If

    ReturnValue = TimelineSteps[Slot] >= TimelineDurations[Slot] And ShakeSteps[Slot] >= ShakeDurations[Slot]

    Return ReturnValue

End Function

End Module
