<SmileProject Version="1.0">
  <PropertyGroup>
    <ProjectKind>Library</ProjectKind>
    <LibraryName>Smile.Battle3D</LibraryName>
    <Version>1.1.0</Version>
    <OutputName>Smile.Battle3D</OutputName>
  </PropertyGroup>
  <ItemGroup>
    <SmileSource Include="Core.smile" />
    <SmileSource Include="Actor.smile" />
    <SmileSource Include="Presentation.smile" />
    <SmileSource Include="Camera.smile" />
    <SmileSource Include="Effects.smile" />
    <SmileProjectReference Include="..\Smile.RPG\Smile.RPG.smilelibproj" />
    <SmileProjectReference Include="..\Smile.Simple3D\Smile.Simple3D.smilelibproj" />
  </ItemGroup>
</SmileProject>
