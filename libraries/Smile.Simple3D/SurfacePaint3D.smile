''' Ordered analytic surface brushes. Coordinates remain independent of navigation cells.
Module Smile.Simple3D.SurfacePaint3D

Option Explicit

Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.SurfacePath3D As Paths

Public Const MAX_BRUSHES = 256
Public Const FORM_RECTANGLE = 1
Public Const FORM_CIRCLE = 2
Public Const FORM_RING = 3
Public Const FORM_LINE = 4
Public Const FORM_FILLET = 5
Public Const FORM_JUNCTION = 6
Public Const FORM_TRIANGLE = 7
Public Const FORM_CURVE = 8

Public Type Brush
    Form As Number
    Surface As Number
    X0 As Double
    Z0 As Double
    X1 As Double
    Z1 As Double
    Width As Double
    X2 As Double
    Z2 As Double
    WaterMode As Number
    FlowSign As Number
    FlowSpeed As Number
End Type

Public Type State
    Brushes[256] As Brush
    BrushCount As Number
End Type

Public Function Valid(Value As Brush) As Boolean

    Dim Result As Boolean

    Result = (Value.Form >= FORM_RECTANGLE And Value.Form <= FORM_CURVE And
        Value.Surface >= 0 And Value.Surface <= 4 And
        Abs(Value.X0) <= 1000000000.0 And Abs(Value.Z0) <= 1000000000.0 And
        Abs(Value.X1) <= 1000000000.0 And Abs(Value.Z1) <= 1000000000.0 And
        Abs(Value.X2) <= 1000000000.0 And Abs(Value.Z2) <= 1000000000.0 And
        Value.Width >= 0.0 And Value.Width <= 1000000000.0)

    If Value.WaterMode = 1 Then
        Result = (Result And Value.Surface = 2 And Value.Form = FORM_LINE And
            Value.Width > 0.0 And (Value.FlowSign = -1 Or Value.FlowSign = 1) And
            Value.FlowSpeed >= 0 And Value.FlowSpeed <= 400 And
            Abs(Value.X1 - Value.X0) + Abs(Value.Z1 - Value.Z0) > 0.000001)
    Else
        Result = Result And Value.WaterMode = 0 And Value.FlowSign = 0 And Value.FlowSpeed = 0
    End If

    If Value.Form = FORM_CIRCLE Or Value.Form = FORM_RING Then
        Result = Result And Value.X1 > 0.0
    End If

    If Value.Form = FORM_FILLET Then
        Result = (Result And Value.Width > 0.0 And
            (Value.X1 - Value.X0) * (Value.X1 - Value.X0) +
            (Value.Z1 - Value.Z0) * (Value.Z1 - Value.Z0) > Value.Width * Value.Width)
    End If

    If Value.Form = FORM_JUNCTION Then
        Result = Result And Value.X1 > 0.0 And Value.Z1 > 0.0 And Value.Width > 0.0
    End If

    If Value.Form = FORM_TRIANGLE Then
        Result = Result And Abs((Value.X1 - Value.X0) * (Value.Z2 - Value.Z0) -
            (Value.Z1 - Value.Z0) * (Value.X2 - Value.X0)) > 0.000001
    Else If Value.Form = FORM_CURVE Then
        Result = Result And Value.Width > 0.0
    End If

    Return Result

End Function

Public Function Contains(Value As Brush, X As Double, Z As Double) As Boolean

    Dim Distance As Double
    Dim Amount As Double
    Dim DeltaX As Double
    Dim DeltaZ As Double
    Dim AxisX As Double
    Dim AxisZ As Double
    Dim Along As Double
    Dim Across As Double
    Dim RadiusSquared As Double
    Dim Result As Boolean

    If Value.Form = FORM_TRIANGLE Then
        Result = Paths.TriangleContains(P.Vector(Value.X0, 0.0, Value.Z0),
            P.Vector(Value.X1, 0.0, Value.Z1), P.Vector(Value.X2, 0.0, Value.Z2), X, Z)
        Return Result
    Else If Value.Form = FORM_CURVE Then
        Result = Paths.StrokeContains(P.Vector(Value.X0, 0.0, Value.Z0),
            P.Vector(Value.X1, 0.0, Value.Z1), P.Vector(Value.X2, 0.0, Value.Z2), Value.Width, X, Z)
        Return Result
    End If

    If Value.Form = FORM_RECTANGLE Then
        Result = X >= Value.X0 And X <= Value.X1 And Z >= Value.Z0 And Z <= Value.Z1
        Return Result
    End If

    DeltaX = X - Value.X0
    DeltaZ = Z - Value.Z0

    ' Four-way axis-aligned crossing: X1/Z1 are road half-widths, Width is radius.

    If Value.Form = FORM_JUNCTION Then

        DeltaX = Abs(DeltaX)
        DeltaZ = Abs(DeltaZ)
        Result = (DeltaX <= Value.X1 + Value.Width And DeltaZ <= Value.Z1 + Value.Width And
            (DeltaX <= Value.X1 Or DeltaZ <= Value.Z1 Or
            (DeltaX - Value.X1 - Value.Width) * (DeltaX - Value.X1 - Value.Width) +
            (DeltaZ - Value.Z1 - Value.Width) * (DeltaZ - Value.Z1 - Value.Width) >= Value.Width * Value.Width))
        Return Result

    End If

    ' A fillet fills the tangent triangle from corner X1/Z1 to circle X0/Z0,
    ' excluding that circle. Width is its radius. Squared projections avoid roots.

    If Value.Form = FORM_FILLET Then

        AxisX = Value.X1 - Value.X0
        AxisZ = Value.Z1 - Value.Z0
        Distance = AxisX * AxisX + AxisZ * AxisZ
        RadiusSquared = Value.Width * Value.Width
        Along = DeltaX * AxisX + DeltaZ * AxisZ
        Across = DeltaX * AxisZ - DeltaZ * AxisX
        Result = (Along >= RadiusSquared And Along <= Distance And
            DeltaX * DeltaX + DeltaZ * DeltaZ >= RadiusSquared And
            Across * Across * (Distance - RadiusSquared) <=
            RadiusSquared * (Distance - Along) * (Distance - Along))
        Return Result

    End If

    If Value.Form = FORM_LINE Then

        Amount = Clamp((DeltaX * (Value.X1 - Value.X0) + DeltaZ * (Value.Z1 - Value.Z0)) /
            Max(0.000001, (Value.X1 - Value.X0) * (Value.X1 - Value.X0) +
            (Value.Z1 - Value.Z0) * (Value.Z1 - Value.Z0)), 0.0, 1.0)
        DeltaX = DeltaX - Amount * (Value.X1 - Value.X0)
        DeltaZ = DeltaZ - Amount * (Value.Z1 - Value.Z0)
        Result = DeltaX * DeltaX + DeltaZ * DeltaZ <= Value.Width * Value.Width * 0.25
        Return Result

    End If

    Distance = DeltaX * DeltaX + DeltaZ * DeltaZ
    Result = Distance <= Value.X1 * Value.X1

    If Value.Form = FORM_RING Then
        Result = (Distance <= (Value.X1 + Value.Width * 0.5) * (Value.X1 + Value.Width * 0.5) And
            Distance >= Max(0.0, Value.X1 - Value.Width * 0.5) * Max(0.0, Value.X1 - Value.Width * 0.5))
    End If

    Return Result

End Function

Public Function Resolve(ByRef Value As State, X As Double, Z As Double, Base As Number) As Number

    Dim Index As Number
    Dim Surface As Number
    Dim Road As Boolean
    Dim Offset As Number

    ' The last covering brush wins. A road also needs the underlying water flag.

    For Offset = 0 To Value.BrushCount - 1

        Index = Value.BrushCount - Offset - 1

        If Contains(Value.Brushes[Index], X, Z) Then

            Surface = Value.Brushes[Index].Surface

            If Surface = 3 Then

                Road = True

            Else

                If Road Then

                    If Surface = 2 Or Surface = 4 Then
                        Surface = 4
                    Else
                        Surface = 3
                    End If

                End If

                Return Surface

            End If

        End If

    End For

    If Road Then

        If Base = 2 Or Base = 4 Then
            Base = 4
        Else
            Base = 3
        End If

    End If

    Return Base

End Function

''' Retain ordered brushes that can affect this sampling rectangle.
Public Sub SelectRegion(ByRef Source As State, ByRef Selected As State,
    X0 As Double, Z0 As Double, X1 As Double, Z1 As Double)

    Dim Index As Number
    Dim Value As Brush
    Dim Radius As Double
    Dim MinX As Double
    Dim MaxX As Double
    Dim Top As Double
    Dim Bottom As Double

    Selected.BrushCount = 0

    For Index = 0 To Source.BrushCount - 1

        Value = Source.Brushes[Index]
        Radius = Value.Width * 0.5
        MinX = Min(Value.X0, Value.X1) - Radius
        MaxX = Max(Value.X0, Value.X1) + Radius
        Top = Min(Value.Z0, Value.Z1) - Radius
        Bottom = Max(Value.Z0, Value.Z1) + Radius

        If Value.Form = FORM_RECTANGLE Then

            MinX = Value.X0
            MaxX = Value.X1
            Top = Value.Z0
            Bottom = Value.Z1

        Else If Value.Form = FORM_CIRCLE Or Value.Form = FORM_RING Then

            If Value.Form = FORM_CIRCLE Then
                Radius = 0.0
            End If

            Radius = Radius + Value.X1
            MinX = Value.X0 - Radius
            MaxX = Value.X0 + Radius
            Top = Value.Z0 - Radius
            Bottom = Value.Z0 + Radius

        Else If Value.Form = FORM_FILLET Then

            MinX = Min(Value.X0 - Value.Width, Value.X1)
            MaxX = Max(Value.X0 + Value.Width, Value.X1)
            Top = Min(Value.Z0 - Value.Width, Value.Z1)
            Bottom = Max(Value.Z0 + Value.Width, Value.Z1)

        Else If Value.Form = FORM_TRIANGLE Or Value.Form = FORM_CURVE Then

            Radius = 0.0

            If Value.Form = FORM_CURVE Then
                Radius = Value.Width * 0.5
            End If

            MinX = Min(Value.X0, Min(Value.X1, Value.X2)) - Radius
            MaxX = Max(Value.X0, Max(Value.X1, Value.X2)) + Radius
            Top = Min(Value.Z0, Min(Value.Z1, Value.Z2)) - Radius
            Bottom = Max(Value.Z0, Max(Value.Z1, Value.Z2)) + Radius

        Else If Value.Form = FORM_JUNCTION Then

            MinX = Value.X0 - Value.X1 - Value.Width
            MaxX = Value.X0 + Value.X1 + Value.Width
            Top = Value.Z0 - Value.Z1 - Value.Width
            Bottom = Value.Z0 + Value.Z1 + Value.Width

        End If

        If (MaxX >= X0 And
            MinX <= X1 And
            Bottom >= Z0 And
            Top <= Z1) Then
            Selected.Brushes[Selected.BrushCount] = Value
            Selected.BrushCount = Selected.BrushCount + 1
        End If

    End For

End Sub

End Module
