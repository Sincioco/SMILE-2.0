''' A caller-owned arena for new games/tools and simple existing preview programs.
Module Smile.Simple3D.ArenaViewport3D

Option Explicit

Import Smile.Simple3D.Arena3D As Arena
Import Smile.Simple3D.ArenaCamera3D As Motion
Import Smile.Simple3D.ArenaBackdrop3D As Backdrop
Import Smile.Simple3D.PrecisionCamera3D As Camera
Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.PrecisionMath3D As M
Import Smile.Simple3D.DistanceZoom3D As DistanceZoom

Public Type State
    Floor As Arena.ArenaFloor
    Backgrounds As Backdrop.State
    Controls As Camera.Controls
    Zoom As Camera.ZoomState
    Distance As DistanceZoom.State
    LiveCamera As P.Camera3D
    TransitionFrom As P.Camera3D
    TransitionElapsed As Number
    TransitionDuration As Number
    FloorVisible As Boolean
    GridVisible As Boolean
    BackgroundIndex As Number
    WorldScale As Double
    PanXLimit As Double
    PanYLimit As Double
    MinimumDistance As Double
    MaximumDistance As Double
    MaximumPitch As Double
    PreviousTime As Number
    Ready As Boolean
End Type

Public Function Create(Width As Number, Depth As Number,
    Optional WorldScale As Double = 1.0,
    Optional GridRed As Number = 24, Optional GridGreen As Number = 150,
    Optional GridBlue As Number = 255, Optional TileSize As Number = 40,
    Optional LineThickness As Number = 2) As State

    Dim Result As State

    Result.Floor = Arena.Create(Width, Depth, GridRed, GridGreen, GridBlue, TileSize, LineThickness)
    Result.Backgrounds = Backdrop.Create()
    Result.FloorVisible = True
    Result.GridVisible = True
    Result.BackgroundIndex = Backdrop.DEFAULT_BACKGROUND
    Result.WorldScale = WorldScale
    Result.PanXLimit = 360.0 * WorldScale
    Result.PanYLimit = 220.0 * WorldScale
    Result.PreviousTime = Timer()
    Result.Ready = Result.Floor.Ready And Result.Backgrounds.Ready And WorldScale > 0.0

    Call ResetControls(Result)

    Return Result

End Function

''' Host UI blocks only new gestures; an existing drag always receives its release.
Public Sub Update(ByRef Value As State, Key As Number, Optional Blocked As Boolean = False,
    Optional WheelStep As Number = Motion.ZOOM_STEP)

    Dim CurrentTime As Number
    Dim Pointer As Motion.PointerInput

    Call Arena.HandleKey(Key, Value.FloorVisible, Value.GridVisible)

    If Key = KEY_B Then
        Call Backdrop.Cycle(Value.BackgroundIndex)
    End If

    If Not Blocked And Pointer_Pressed(POINTER_SECONDARY) Then
        Call ResetControls(Value)
    End If

    CurrentTime = Timer()
    Pointer = Motion.ReadPointer(Blocked)

    Call ApplyPointer(Value, Pointer, CurrentTime - Value.PreviousTime, WheelStep)
    Call AdvanceTransition(Value, CurrentTime - Value.PreviousTime)

    Value.PreviousTime = CurrentTime

End Sub

Public Sub ResetControls(ByRef Value As State)

    Dim Empty As DistanceZoom.State

    Call Motion.Reset(Value.Controls, Value.Zoom)

    Value.Distance = Empty

End Sub

Public Sub ConfigureDistance(ByRef Value As State, Base As P.Camera3D)

    Call DistanceZoom.Configure(Value.Distance, M.Distance(Base.Position, Base.Target),
        Max(Value.MinimumDistance, Value.Distance.Minimum), Value.MaximumDistance)

End Sub

''' Input routing is shared by the live viewport and native camera regressions.
Public Sub ApplyPointer(ByRef Value As State, Input As Motion.PointerInput,
    Elapsed As Number, Optional WheelStep As Number = Motion.ZOOM_STEP)

    Dim Changed As Boolean

    If Value.MinimumDistance > 0.0 Then

        Call ConfigureDistance(Value, Value.LiveCamera)

        If Not Input.Blocked Then
            Call DistanceZoom.Step(Value.Distance, ToDouble(Input.Wheel))
        End If

        Input.Wheel = 0
        Changed = Motion.UpdatePointer(Value.Controls, Value.Zoom, Input,
            Value.PanXLimit, Value.PanYLimit, Value.WorldScale, WheelStep)

        Call DistanceZoom.Advance(Value.Distance, Elapsed)

    Else

        Changed = Motion.UpdatePointer(Value.Controls, Value.Zoom, Input,
            Value.PanXLimit, Value.PanYLimit, Value.WorldScale, WheelStep)

        Call Motion.Advance(Value.Controls, Value.Zoom, Elapsed)

    End If

End Sub

''' Capture the displayed view before changing framing; zero duration cancels a transition.
Public Sub BeginTransition(ByRef Value As State, Optional Duration As Number = 700)

    Value.TransitionFrom = Value.LiveCamera
    Value.TransitionElapsed = 0
    Value.TransitionDuration = Max(0, Duration)

End Sub

Public Sub AdvanceTransition(ByRef Value As State, Elapsed As Number)

    Value.TransitionElapsed = Min(Value.TransitionDuration,
        Value.TransitionElapsed + Max(0, Elapsed))

    If Value.TransitionElapsed >= Value.TransitionDuration Then
        Value.TransitionDuration = 0
    End If

End Sub

''' BaseCamera describes the intended reset framing, independent of the zoom slider offset.
Public Sub ComposeCamera(ByRef Value As State, BaseCamera As P.Camera3D)

    If Value.MinimumDistance > 0.0 And Value.MaximumDistance > Value.MinimumDistance Then
        Call ConfigureDistance(Value, BaseCamera)

        Value.LiveCamera = Motion.ComposeDistance(BaseCamera, Value.Controls,
            Value.Distance.Current, Max(1.48, Value.MaximumPitch))
    Else

        BaseCamera.FovDegrees = BaseCamera.FovDegrees - ToDouble(Motion.DEFAULT_ZOOM)
        Value.LiveCamera = Motion.Compose(BaseCamera, Value.Controls)
    End If

    If Value.TransitionDuration > 0 Then
        Value.LiveCamera = Motion.BlendFraming(Value.TransitionFrom, Value.LiveCamera,
            ToDouble(Value.TransitionElapsed) / ToDouble(Value.TransitionDuration))
    End If

    If Value.FloorVisible Then
        Call Camera.KeepCameraAboveGround(Value.LiveCamera, ToDouble(Value.Floor.FloorHeight + 1))
    End If

End Sub

Public Function BeginFrame(ByRef Value As State, BaseCamera As P.Camera3D,
    Optional UseScene As Boolean = True, Optional ComposeView As Boolean = True,
    Optional ConfigureArenaReflections As Boolean = True) As Boolean

    Dim Result As Boolean

    If ComposeView Then
        Call ComposeCamera(Value, BaseCamera)
    End If

    Result = True

    If ConfigureArenaReflections Then
        Result = Arena.ConfigureForFrame(Value.Floor, Value.FloorVisible, True)
    End If

    If Not Result Then
        Return False
    End If

    If Not P.SetCamera(Value.LiveCamera) Then
        Return False
    End If

    Result = Backdrop.BeginFrame(Value.Backgrounds, Value.BackgroundIndex, UseScene)

    Return Result

End Function

Public Function Draw(ByRef Value As State) As Boolean

    Dim Result As Boolean

    Result = Arena.Draw(Value.Floor, Value.FloorVisible, Value.GridVisible)

    Return Result

End Function

Public Sub Destroy(ByRef Value As State)

    Call Arena.Destroy(Value.Floor)
    Call Backdrop.Destroy(Value.Backgrounds)

    Value.Ready = False

End Sub

End Module
