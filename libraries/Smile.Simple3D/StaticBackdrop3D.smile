''' Screen-fixed image background. Camera motion never changes its position or UVs.
Module Smile.Simple3D.StaticBackdrop3D

Option Explicit

Import Smile.Simple3D.Core As Core
Import Smile.Simple3D.Graphics3D As Graphics3D

Public Type Backdrop
    Texture As Core.Texture3D
    Epoch As Number
    Ready As Boolean
End Type

''' Borrowed selection only. Keep its texture owner alive during a synchronous scope.
Public Type Selection
    TextureHandle As Number
    Epoch As Number
End Type

Private Dim ActiveHandle As Number
Private Dim ActiveEpoch As Number

Public Function Create(Path As Text) As Backdrop

    Dim Result As Backdrop

    If Graphics3D.FrameActive3D() Then
        Return Result
    End If

    Result.Epoch = Graphics3D.ResourceEpoch3D()
    Result.Texture = Graphics3D.LoadTexture3D(Path)
    Result.Ready = Result.Texture.Handle <> 0

    Return Result

End Function

Public Function SetActive(Value As Backdrop) As Boolean

    Dim Result As Boolean

    If Graphics3D.FrameActive3D() Then
        Return False
    End If

    If Not Value.Ready Or Value.Epoch <> Graphics3D.ResourceEpoch3D() Then
        Return False
    End If

    Result = Graphics3D.SetBackdropTexture3D(Value.Texture)

    If Result Then
        ActiveHandle = Value.Texture.Handle
        ActiveEpoch = Value.Epoch
    End If

    Return Result

End Function

Public Function ClearActive() As Boolean

    Dim Result As Boolean

    If Graphics3D.FrameActive3D() Then
        Return False
    End If

    Result = Graphics3D.ClearBackdropTexture3D()

    If Result Then
        ActiveHandle = 0
        ActiveEpoch = 0
    End If

    Return Result

End Function

''' Empty selection clears the bitmap and receives the prior selection; exchange again to restore.
Public Function ExchangeActive(ByRef Value As Selection) As Boolean

    Dim Previous As Selection
    Dim Texture As Core.Texture3D
    Dim Epoch As Number
    Dim Result As Boolean

    If Graphics3D.FrameActive3D() Then
        Return False
    End If

    Epoch = Graphics3D.ResourceEpoch3D()

    If Value.TextureHandle <> 0 Then

        If Value.Epoch <> Epoch Then
            Return False
        End If

        If Not Graphics3D.TextureHandleValid3D(Value.TextureHandle) Then
            Return False
        End If

    End If

    Previous.TextureHandle = ActiveHandle
    Previous.Epoch = ActiveEpoch

    If Previous.Epoch <> Epoch Or Previous.TextureHandle = 0 Then
        Previous.TextureHandle = 0
        Previous.Epoch = 0
    Else If Not Graphics3D.TextureHandleValid3D(Previous.TextureHandle) Then
        Previous.TextureHandle = 0
        Previous.Epoch = 0
    End If

    If Value.TextureHandle = 0 Then
        Result = Graphics3D.ClearBackdropTexture3D()
    Else

        Texture.Handle = Value.TextureHandle
        Result = Graphics3D.SetBackdropTexture3D(Texture)
    End If

    If Not Result Then
        Return False
    End If

    ActiveHandle = Value.TextureHandle
    ActiveEpoch = Epoch

    If ActiveHandle = 0 Then
        ActiveEpoch = 0
    End If

    Value = Previous

    Return True

End Function

Public Sub Destroy(ByRef Value As Backdrop)

    Dim Empty As Backdrop
    Dim Cleared As Boolean

    If Graphics3D.FrameActive3D() Then
        Return
    End If

    If Value.Epoch = Graphics3D.ResourceEpoch3D() And Value.Ready Then

        If ActiveEpoch = Value.Epoch And ActiveHandle = Value.Texture.Handle Then

            Cleared = ClearActive()

            If Not Cleared Then
                Return
            End If

        End If

        Call Graphics3D.DestroyTexture3D(Value.Texture)

        If Value.Texture.Handle <> 0 Then
            Return
        End If

    End If

    Value = Empty

End Sub

End Module
