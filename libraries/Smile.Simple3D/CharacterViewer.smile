''' Reusable character-viewer profile, automatic framing, and smooth zoom helpers.
Module Smile.Simple3D.CharacterViewer

Option Explicit

Import Smile.Simple3D.Character3D As Character3D
Import Smile.Simple3D.Core As Core
Import Smile.Simple3D.FixedMath As Math3D
Import Smile.Simple3D.Math3D As VectorMath

Private Const MIN_SCALE_PERCENT = 1
Private Const MAX_SCALE_PERCENT = 10000
Private Const MIN_VIEW_HEIGHT = 20
Private Const MAX_VIEW_HEIGHT = 1000
Private Const MIN_MARGIN_PERCENT = 0
Private Const MAX_MARGIN_PERCENT = 100
Private Const MIN_GROUND_OFFSET = -100
Private Const MAX_GROUND_OFFSET = 100
Private Const MIN_ZOOM_RATE = 1000
Private Const MAX_ZOOM_RATE = 360000
Private Const GIZMO_MINIMUM_VIEW_SIZE = 40
Private Const GIZMO_MINIMUM_WORLD_SIZE = 1
Private Const GIZMO_MAXIMUM_WORLD_SIZE = 1000

''' Bounded, data-driven inputs for one inspectable character asset.
Public Type Profile
    Version As Number
    AssetId As Text
    CandidateVersion As Text
    DisplayName As Text
    PartyRole As Text
    PrototypeAlias As Text
    ProductionStatus As Text
    AssetPath As Text
    ExpectedClipCount As Number
    ExpectedSocketCount As Number
    DesiredWorldHeight As Number
    GroundOffset As Number
    MarginPercent As Number
    AnimationMargin As Number
    DefaultPlaybackSpeed As Number
    MinimumPlaybackSpeed As Number
    MaximumPlaybackSpeed As Number
End Type

''' Deterministic placement and camera values derived from local model bounds.
Public Type Framing
    ScalePercent As Number
    PositionX As Number
    PositionY As Number
    PositionZ As Number
    TargetY As Number
    CameraY As Number
    CameraZ As Number
    FloorWidth As Number
    FloorDepth As Number
    PanXLimit As Number
    PanYLimit As Number
    ShadowWidth As Number
    ShadowDepth As Number
    ShadowNear As Number
    ShadowFar As Number
    FittedWidth As Number
    FittedHeight As Number
    Valid As Boolean
End Type

''' Fixed-thousandths zoom state whose advance is elapsed-time based.
Public Type ZoomState
    Current1000 As Number
    Target1000 As Number
    RatePerSecond1000 As Number
    AdvanceRemainder As Number
    Minimum1000 As Number
    Maximum1000 As Number
End Type

''' Separated wall, animation, camera, and presentation time for inspection tools.
Public Type ClockState
    RawFrameMilliseconds As Number
    AnimationElapsed As Number
    CameraElapsed As Number
    PresentationElapsed As Number
    DroppedAnimationMilliseconds As Number
    DroppedCameraMilliseconds As Number
    LongPauseCount As Number
End Type

''' Screen projection of a Blender-style world-axis transform gizmo.
Public Type TransformGizmo
    Origin As Core.ProjectedPoint3D
    XAxis As Core.ProjectedPoint3D
    YAxis As Core.ProjectedPoint3D
    ZAxis As Core.ProjectedPoint3D
    Visible As Boolean
End Type

Public Function AdvanceClock(
    ByRef Value As ClockState,
    RawElapsed As Number,
    Optional AnimationCap As Number = 250,
    Optional CameraCap As Number = 250,
    Optional RawCap As Number = 60000
) As Boolean

    Dim AnimationDrop As Number
    Dim CameraDrop As Number

    If (RawElapsed < 0 Or
        AnimationCap <= 0 Or
        CameraCap <= 0 Or
        RawCap <= 0 Or
        AnimationCap > RawCap Or
        CameraCap > RawCap) Then
        Return False
    End If

    If RawElapsed > RawCap Then
        RawElapsed = RawCap
        Value.LongPauseCount = Value.LongPauseCount + 1
    End If

    Value.RawFrameMilliseconds = RawElapsed
    Value.AnimationElapsed = Min(AnimationCap, RawElapsed)
    Value.CameraElapsed = Min(CameraCap, RawElapsed)
    Value.PresentationElapsed = RawElapsed
    AnimationDrop = RawElapsed - Value.AnimationElapsed
    CameraDrop = RawElapsed - Value.CameraElapsed
    Value.DroppedAnimationMilliseconds = Value.DroppedAnimationMilliseconds + AnimationDrop
    Value.DroppedCameraMilliseconds = Value.DroppedCameraMilliseconds + CameraDrop

    Return True

End Function

''' Advances a bounded periodic index while retaining exact overshoot.
Public Function AdvanceCycle(
    ByRef Elapsed As Number,
    Delta As Number,
    Period As Number,
    ItemCount As Number
) As Number

    Dim Result As Number

    If (Delta < 0 Or
        Delta > 60000 Or
        Period <= 0 Or
        ItemCount <= 0 Or
        ItemCount > 64) Then
        Return 0
    End If

    Elapsed = Elapsed + Delta
    Result = Elapsed / Period
    Elapsed = Elapsed Mod Period
    Result = Result Mod ItemCount

    Return Result

End Function

Public Function AdvanceOrbitYaw1000(
    ByRef Yaw1000 As Number,
    ElapsedMilliseconds As Number,
    DegreesPerSecond As Number
) As Boolean

    If (ElapsedMilliseconds < 0 Or
        ElapsedMilliseconds > 60000 Or
        Abs(DegreesPerSecond) > 3600) Then
        Return False
    End If

    Yaw1000 = (Yaw1000 + ElapsedMilliseconds * DegreesPerSecond) Mod 360000

    Return True

End Function

''' Validates the bounded fields required by every character-viewer profile.
Public Function ValidateProfile(Value As Profile) As Boolean

    Dim Result As Boolean

    Result = (Value.Version = 1 And
        Value.AssetId <> "" And
        Value.CandidateVersion <> "" And
        Value.DisplayName <> "" And
        Value.ProductionStatus <> "" And
        Value.AssetPath <> "" And
        Value.ExpectedClipCount >= 0 And
        Value.ExpectedClipCount <= 64 And
        Value.ExpectedSocketCount >= 0 And
        Value.ExpectedSocketCount <= 64 And
        Value.DesiredWorldHeight >= MIN_VIEW_HEIGHT And
        Value.DesiredWorldHeight <= MAX_VIEW_HEIGHT And
        Value.GroundOffset >= MIN_GROUND_OFFSET And
        Value.GroundOffset <= MAX_GROUND_OFFSET And
        Value.MarginPercent >= MIN_MARGIN_PERCENT And
        Value.MarginPercent <= MAX_MARGIN_PERCENT And
        Value.AnimationMargin >= 0 And
        Value.AnimationMargin <= MAX_VIEW_HEIGHT And
        Value.MinimumPlaybackSpeed >= 25 And
        Value.MaximumPlaybackSpeed <= 200 And
        Value.MinimumPlaybackSpeed <= Value.DefaultPlaybackSpeed And
        Value.DefaultPlaybackSpeed <= Value.MaximumPlaybackSpeed)

    Return Result

End Function

''' Derives a grounded, centered character and bounded studio camera from local bounds.
Public Function AutoFit(
    Value As Profile,
    Bounds As Character3D.Bounds3D,
    Optional ViewportWidth As Number = 0,
    Optional ViewportHeight As Number = 0,
    Optional FovDegrees As Number = 55
) As Framing

    Dim Result As Framing
    Dim ScaledMinimumY1000 As Number
    Dim ScaledCenterX1000 As Number
    Dim ScaledCenterZ1000 As Number
    Dim FittedHeight As Number
    Dim FittedWidth As Number
    Dim PaddedHeight As Number
    Dim PaddedWidth As Number
    Dim HalfFov As Number
    Dim Sine As Number
    Dim Cosine As Number
    Dim Aspect1000 As Number
    Dim VerticalDistance As Number
    Dim HorizontalDistance As Number
    Dim CameraDistance As Number

    If (Not ValidateProfile(Value) Or
        Not Bounds.Valid Or
        Bounds.Size.Y <= 0) Then
        Return Result
    End If

    Result.ScalePercent = Value.DesiredWorldHeight * 100000 / Bounds.Size.Y
    Result.ScalePercent = Min(MAX_SCALE_PERCENT, Max(MIN_SCALE_PERCENT, Result.ScalePercent))
    ScaledMinimumY1000 = Bounds.Minimum.Y * Result.ScalePercent / 100
    ScaledCenterX1000 = Bounds.Center.X * Result.ScalePercent / 100
    ScaledCenterZ1000 = Bounds.Center.Z * Result.ScalePercent / 100
    FittedHeight = Bounds.Size.Y * Result.ScalePercent / 100000
    FittedWidth = Max(Bounds.Size.X, Bounds.Size.Z) * Result.ScalePercent / 100000
    PaddedHeight = FittedHeight * (100 + Value.MarginPercent) / 100
    PaddedWidth = FittedWidth * (100 + Value.MarginPercent) / 100
    Result.PositionX = 0 - ScaledCenterX1000 / 1000
    Result.PositionY = 0 - ScaledMinimumY1000 / 1000 + Value.GroundOffset
    Result.PositionZ = 0 - ScaledCenterZ1000 / 1000
    Result.TargetY = FittedHeight / 2
    Result.CameraY = Result.TargetY
    CameraDistance = PaddedHeight * 3 / 2

    If ViewportWidth > 0 And ViewportHeight > 0 Then

        HalfFov = Min(80, Max(5, FovDegrees / 2))
        Sine = Max(1, Abs(Math3D.SinFixed(HalfFov)))
        Cosine = Max(1, Abs(Math3D.CosFixed(HalfFov)))
        Aspect1000 = Max(1, ViewportWidth * 1000 / ViewportHeight)
        VerticalDistance = PaddedHeight * Cosine / (2 * Sine)
        HorizontalDistance = PaddedWidth * Cosine * 1000 / (2 * Sine * Aspect1000)
        CameraDistance = Max(CameraDistance, Max(VerticalDistance, HorizontalDistance))

    End If

    Result.CameraZ = 0 - CameraDistance
    Result.FloorWidth = Max(400, PaddedHeight * 4)
    Result.FloorDepth = Max(320, PaddedHeight * 3)
    Result.PanXLimit = Max(40, PaddedHeight / 2)
    Result.PanYLimit = Max(30, PaddedHeight / 3)
    Result.ShadowWidth = Max(200, PaddedHeight * 2)
    Result.ShadowDepth = Max(160, PaddedHeight * 3 / 2)
    Result.ShadowNear = 1
    Result.ShadowFar = Max(400, PaddedHeight * 3)
    Result.FittedWidth = FittedWidth
    Result.FittedHeight = FittedHeight
    Result.Valid = True

    Return Result

End Function

Public Sub InitializeZoom(
    ByRef Value As ZoomState,
    CurrentDegrees As Number,
    MinimumDegrees As Number,
    MaximumDegrees As Number,
    RatePerSecond1000 As Number
)

    Value.Minimum1000 = MinimumDegrees * 1000
    Value.Maximum1000 = MaximumDegrees * 1000
    Value.Current1000 = Min(Value.Maximum1000, Max(Value.Minimum1000, CurrentDegrees * 1000))
    Value.Target1000 = Value.Current1000
    Value.RatePerSecond1000 = Min(MAX_ZOOM_RATE, Max(MIN_ZOOM_RATE, RatePerSecond1000))
    Value.AdvanceRemainder = 0

End Sub

Public Sub AdjustZoomTarget(ByRef Value As ZoomState, WheelDelta As Number, DegreesPerStep As Number)

    Dim NextTarget1000 As Number

    NextTarget1000 = Value.Target1000 - WheelDelta * DegreesPerStep * 1000
    Value.Target1000 = Min(Value.Maximum1000, Max(Value.Minimum1000, NextTarget1000))

End Sub

''' Advances smooth zoom by elapsed milliseconds while preserving fractional work.
Public Function AdvanceZoom(ByRef Value As ZoomState, ElapsedMilliseconds As Number) As Boolean

    Dim Advance1000 As Number
    Dim Distance1000 As Number
    Dim Total As Number

    If ElapsedMilliseconds < 0 Or ElapsedMilliseconds > 1000 Then
        Return False
    End If

    Total = Value.RatePerSecond1000 * ElapsedMilliseconds + Value.AdvanceRemainder
    Advance1000 = Total / 1000
    Value.AdvanceRemainder = Total - Advance1000 * 1000

    If Value.Current1000 < Value.Target1000 Then
        Distance1000 = Value.Target1000 - Value.Current1000
        Value.Current1000 = Value.Current1000 + Min(Distance1000, Advance1000)
    Else If Value.Current1000 > Value.Target1000 Then
        Distance1000 = Value.Current1000 - Value.Target1000
        Value.Current1000 = Value.Current1000 - Min(Distance1000, Advance1000)
    End If

    Return True

End Function

Public Function ZoomDegrees(Value As ZoomState) As Number

    Dim Result As Number

    Result = Value.Current1000 / 1000

    Return Result

End Function

Public Function ZoomTargetDegrees(Value As ZoomState) As Number

    Dim Result As Number

    Result = Value.Target1000 / 1000

    Return Result

End Function

''' Scales pointer motion without dropping sub-unit movement between frames.
Public Function RetainedPointerDelta(
    ByRef Remainder As Number,
    Delta As Number,
    Divisor As Number
) As Number

    Dim Result As Number
    Dim Total As Number

    If Divisor <= 0 Then
        Return 0
    End If

    Total = Remainder + Delta
    Result = Total / Divisor
    Remainder = Total - Result * Divisor

    Return Result

End Function

''' Projects a Graphics3D look-at camera point into the current logical viewport.
Public Function ProjectViewerPoint(
    Point As Core.Vector3,
    Camera As Core.Camera3D,
    ViewWidth As Number,
    ViewHeight As Number
) As Core.ProjectedPoint3D

    Dim Result As Core.ProjectedPoint3D
    Dim Forward As Core.Vector3
    Dim RightValue As Core.Vector3
    Dim UpValue As Core.Vector3
    Dim Relative As Core.Vector3
    Dim CameraX As Number
    Dim CameraY As Number
    Dim Depth As Number
    Dim FocalLength As Number
    Dim HalfFov As Number
    Dim Sine As Number
    Dim Cosine As Number

    If (ViewWidth < GIZMO_MINIMUM_VIEW_SIZE Or
        ViewHeight < GIZMO_MINIMUM_VIEW_SIZE Or
        Camera.FovDegrees <= 0 Or
        Camera.FovDegrees >= 180) Then
        Return Result
    End If

    Forward = VectorMath.Normalize(VectorMath.Subtract(Camera.Target, Camera.Position))
    RightValue = VectorMath.Normalize(VectorMath.Cross(Camera.UpDirection, Forward))
    UpValue = VectorMath.Normalize(VectorMath.Cross(Forward, RightValue))
    Relative = VectorMath.Subtract(Point, Camera.Position)
    CameraX = VectorMath.Dot(Relative, RightValue) / Core.FIXED_ONE
    CameraY = VectorMath.Dot(Relative, UpValue) / Core.FIXED_ONE
    Depth = VectorMath.Dot(Relative, Forward) / Core.FIXED_ONE

    If Depth < Max(1, Camera.NearPlane) Then
        Return Result
    End If

    HalfFov = Camera.FovDegrees / 2
    Sine = Max(1, Abs(Math3D.SinFixed(HalfFov)))
    Cosine = Max(1, Abs(Math3D.CosFixed(HalfFov)))
    FocalLength = ViewHeight * Cosine / (2 * Sine)
    Result.X = ViewWidth / 2 + CameraX * FocalLength / Depth
    Result.Y = ViewHeight / 2 - CameraY * FocalLength / Depth
    Result.Depth = Depth
    Result.Visible = True

    Return Result

End Function

''' Resolves a logical cursor on the camera-facing plane at a chosen world depth.
''' This is a depth-plane anchor, not mesh collision or surface picking.
Public Function CursorPointAtDepth(
    Camera As Core.Camera3D,
    CursorX As Number,
    CursorY As Number,
    Depth As Number,
    ViewWidth As Number,
    ViewHeight As Number
) As Core.Vector3

    Dim Result As Core.Vector3
    Dim Forward As Core.Vector3
    Dim RightValue As Core.Vector3
    Dim UpValue As Core.Vector3
    Dim FocalLength As Number
    Dim Horizontal1000 As Number
    Dim Vertical1000 As Number
    Dim HalfFov As Number

    Result = Camera.Target

    If (ViewWidth < GIZMO_MINIMUM_VIEW_SIZE Or
        ViewHeight < GIZMO_MINIMUM_VIEW_SIZE Or
        Camera.FovDegrees <= 0 Or
        Camera.FovDegrees >= 180 Or
        Depth < Max(1, Camera.NearPlane)) Then
        Return Result
    End If

    Forward = VectorMath.Normalize(VectorMath.Subtract(Camera.Target, Camera.Position))
    RightValue = VectorMath.Normalize(VectorMath.Cross(Camera.UpDirection, Forward))
    UpValue = VectorMath.Normalize(VectorMath.Cross(Forward, RightValue))
    HalfFov = Camera.FovDegrees / 2
    FocalLength = (ViewHeight * Max(1, Abs(Math3D.CosFixed(HalfFov))) /
        (2 * Max(1, Abs(Math3D.SinFixed(HalfFov)))))
    Horizontal1000 = (CursorX - ViewWidth / 2) * Depth * 1000 / Max(1, FocalLength)
    Vertical1000 = (ViewHeight / 2 - CursorY) * Depth * 1000 / Max(1, FocalLength)
    Result.X = Camera.Position.X + (Forward.X * Depth * 1000 +
        RightValue.X * Horizontal1000 + UpValue.X * Vertical1000) / (Core.FIXED_ONE * 1000)
    Result.Y = Camera.Position.Y + (Forward.Y * Depth * 1000 +
        RightValue.Y * Horizontal1000 + UpValue.Y * Vertical1000) / (Core.FIXED_ONE * 1000)
    Result.Z = Camera.Position.Z + (Forward.Z * Depth * 1000 +
        RightValue.Z * Horizontal1000 + UpValue.Z * Vertical1000) / (Core.FIXED_ONE * 1000)

    Return Result

End Function

''' Translates a composed camera so one world anchor retains its logical pixel.
Public Function KeepCursorAnchor(
    Camera As Core.Camera3D,
    Anchor As Core.Vector3,
    CursorX As Number,
    CursorY As Number,
    Depth As Number,
    ViewWidth As Number,
    ViewHeight As Number
) As Core.Camera3D

    Dim Result As Core.Camera3D
    Dim CursorPoint As Core.Vector3
    Dim Translation As Core.Vector3

    Result = Camera
    CursorPoint = CursorPointAtDepth(Camera, CursorX, CursorY, Depth, ViewWidth, ViewHeight)
    Translation = VectorMath.Subtract(Anchor, CursorPoint)
    Result.Position = VectorMath.Add(Result.Position, Translation)
    Result.Target = VectorMath.Add(Result.Target, Translation)

    Return Result

End Function

''' Builds the projected origin and positive X, Y, and Z handles.
Public Function ProjectTransformGizmo(
    Origin As Core.Vector3,
    WorldSize As Number,
    Camera As Core.Camera3D,
    ViewWidth As Number,
    ViewHeight As Number
) As TransformGizmo

    Dim Result As TransformGizmo
    Dim AxisPoint As Core.Vector3

    WorldSize = Min(GIZMO_MAXIMUM_WORLD_SIZE, Max(GIZMO_MINIMUM_WORLD_SIZE, WorldSize))
    Result.Origin = ProjectViewerPoint(Origin, Camera, ViewWidth, ViewHeight)
    AxisPoint = Origin
    AxisPoint.X = AxisPoint.X + WorldSize
    Result.XAxis = ProjectViewerPoint(AxisPoint, Camera, ViewWidth, ViewHeight)
    AxisPoint = Origin
    AxisPoint.Y = AxisPoint.Y + WorldSize
    Result.YAxis = ProjectViewerPoint(AxisPoint, Camera, ViewWidth, ViewHeight)
    AxisPoint = Origin
    AxisPoint.Z = AxisPoint.Z + WorldSize
    Result.ZAxis = ProjectViewerPoint(AxisPoint, Camera, ViewWidth, ViewHeight)
    Result.Visible = (Result.Origin.Visible And
        Result.XAxis.Visible And
        Result.YAxis.Visible And
        Result.ZAxis.Visible)

    Return Result

End Function

''' Projects one point on a world-axis rotation ring.
Public Function ProjectTransformRingPoint(
    Origin As Core.Vector3,
    Axis As Number,
    Segment As Number,
    SegmentCount As Number,
    WorldRadius As Number,
    Camera As Core.Camera3D,
    ViewWidth As Number,
    ViewHeight As Number
) As Core.ProjectedPoint3D

    Dim Point As Core.Vector3
    Dim Angle As Number
    Dim FirstOffset As Number
    Dim SecondOffset As Number
    Dim Result As Core.ProjectedPoint3D

    If SegmentCount < 8 Or SegmentCount > 128 Then
        Return Result
    End If

    Segment = Segment Mod SegmentCount
    WorldRadius = Min(GIZMO_MAXIMUM_WORLD_SIZE, Max(GIZMO_MINIMUM_WORLD_SIZE, WorldRadius))
    Angle = Segment * 360 / SegmentCount
    FirstOffset = WorldRadius * Math3D.CosFixed(Angle) / Core.FIXED_ONE
    SecondOffset = WorldRadius * Math3D.SinFixed(Angle) / Core.FIXED_ONE
    Point = Origin

    If Axis = 0 Then
        Point.Y = Point.Y + FirstOffset
        Point.Z = Point.Z + SecondOffset
    Else If Axis = 1 Then
        Point.X = Point.X + FirstOffset
        Point.Z = Point.Z + SecondOffset
    Else
        Point.X = Point.X + FirstOffset
        Point.Y = Point.Y + SecondOffset
    End If

    Result = ProjectViewerPoint(Point, Camera, ViewWidth, ViewHeight)

    Return Result

End Function

Private Function PointerNearSegment(
    PointerX As Number,
    PointerY As Number,
    StartX As Number,
    StartY As Number,
    EndX As Number,
    EndY As Number,
    HitRadius As Number
) As Boolean

    Dim DeltaX As Number
    Dim DeltaY As Number
    Dim LengthSquared As Number
    Dim Along1000 As Number
    Dim ClosestX As Number
    Dim ClosestY As Number
    Dim DistanceX As Number
    Dim DistanceY As Number
    Dim Result As Boolean

    DeltaX = EndX - StartX
    DeltaY = EndY - StartY
    LengthSquared = DeltaX * DeltaX + DeltaY * DeltaY

    If LengthSquared <= 0 Then
        Return False
    End If

    Along1000 = ((PointerX - StartX) * DeltaX + (PointerY - StartY) * DeltaY) * 1000 / LengthSquared
    Along1000 = Min(1000, Max(0, Along1000))
    ClosestX = StartX + DeltaX * Along1000 / 1000
    ClosestY = StartY + DeltaY * Along1000 / 1000
    DistanceX = PointerX - ClosestX
    DistanceY = PointerY - ClosestY
    Result = DistanceX * DistanceX + DistanceY * DistanceY <= HitRadius * HitRadius

    Return Result

End Function

Private Function MoveAxisHit(
    Value As TransformGizmo,
    Axis As Number,
    PointerX As Number,
    PointerY As Number,
    HitRadius As Number
) As Boolean

    Dim EndPoint As Core.ProjectedPoint3D
    Dim StartX As Number
    Dim StartY As Number
    Dim Result As Boolean

    EndPoint = Value.XAxis

    If Axis = 1 Then
        EndPoint = Value.YAxis
    Else If Axis = 2 Then
        EndPoint = Value.ZAxis
    End If

    StartX = Value.Origin.X + (EndPoint.X - Value.Origin.X) / 5
    StartY = Value.Origin.Y + (EndPoint.Y - Value.Origin.Y) / 5
    Result = PointerNearSegment(PointerX, PointerY, StartX, StartY,
        EndPoint.X, EndPoint.Y, HitRadius)

    Return Result

End Function

''' Returns the clicked move axis, preferring the currently selected axis at overlaps.
Public Function TransformGizmoMoveAxisAtPointer(
    Value As TransformGizmo,
    PointerX As Number,
    PointerY As Number,
    PreferredAxis As Number,
    Optional HitRadius As Number = 8
) As Number

    Dim ReturnValue As Number

    Dim Axis As Number

    If Not Value.Visible Then
        ReturnValue = -1

        Return ReturnValue
    End If

    If (PreferredAxis >= 0 And
        PreferredAxis <= 2 And
        MoveAxisHit(Value, PreferredAxis, PointerX, PointerY, HitRadius)) Then
        Return PreferredAxis
    End If

    For Axis = 0 To 2

        If Axis <> PreferredAxis And MoveAxisHit(Value, Axis, PointerX, PointerY, HitRadius) Then
            Return Axis
        End If

    End For

    ReturnValue = -1

    Return ReturnValue

End Function

''' Converts pointer motion to signed pixels along a projected move axis.
Public Function TransformGizmoAxisPointerDelta(
    Value As TransformGizmo,
    Axis As Number,
    DeltaX As Number,
    DeltaY As Number
) As Number

    Dim EndPoint As Core.ProjectedPoint3D
    Dim AxisX As Number
    Dim AxisY As Number
    Dim AxisLength As Number
    Dim Result As Number

    EndPoint = Value.XAxis

    If Axis = 1 Then
        EndPoint = Value.YAxis
    Else If Axis = 2 Then
        EndPoint = Value.ZAxis
    End If

    AxisX = EndPoint.X - Value.Origin.X
    AxisY = EndPoint.Y - Value.Origin.Y
    AxisLength = VectorMath.SquareRoot(AxisX * AxisX + AxisY * AxisY)

    If AxisLength <= 0 Then
        Return 0
    End If

    Result = (DeltaX * AxisX + DeltaY * AxisY) / AxisLength

    Return Result

End Function

Private Function RotationAxisHit(
    Origin As Core.Vector3,
    Axis As Number,
    PointerX As Number,
    PointerY As Number,
    WorldRadius As Number,
    Camera As Core.Camera3D,
    ViewWidth As Number,
    ViewHeight As Number,
    SegmentCount As Number,
    HitRadius As Number
) As Boolean

    Dim Segment As Number
    Dim StartPoint As Core.ProjectedPoint3D
    Dim EndPoint As Core.ProjectedPoint3D

    For Segment = 0 To SegmentCount - 1

        StartPoint = ProjectTransformRingPoint(Origin, Axis, Segment,
            SegmentCount, WorldRadius, Camera, ViewWidth, ViewHeight)
        EndPoint = ProjectTransformRingPoint(Origin, Axis, Segment + 1,
            SegmentCount, WorldRadius, Camera, ViewWidth, ViewHeight)

        If (StartPoint.Visible And
            EndPoint.Visible And
            PointerNearSegment(PointerX, PointerY, StartPoint.X, StartPoint.Y,
                EndPoint.X, EndPoint.Y, HitRadius)) Then
            Return True
        End If

    End For

    Return False

End Function

''' Returns the clicked rotation ring, preferring the currently selected axis.
Public Function TransformGizmoRotationAxisAtPointer(
    Origin As Core.Vector3,
    PointerX As Number,
    PointerY As Number,
    PreferredAxis As Number,
    WorldRadius As Number,
    Camera As Core.Camera3D,
    ViewWidth As Number,
    ViewHeight As Number,
    Optional SegmentCount As Number = 32,
    Optional HitRadius As Number = 7
) As Number

    Dim ReturnValue As Number

    Dim Axis As Number

    If (PreferredAxis >= 0 And
        PreferredAxis <= 2 And
        RotationAxisHit(Origin, PreferredAxis, PointerX, PointerY,
            WorldRadius, Camera, ViewWidth, ViewHeight, SegmentCount, HitRadius)) Then
        Return PreferredAxis
    End If

    For Axis = 0 To 2

        If (Axis <> PreferredAxis And
            RotationAxisHit(Origin, Axis, PointerX, PointerY,
                WorldRadius, Camera, ViewWidth, ViewHeight, SegmentCount, HitRadius)) Then
            Return Axis
        End If

    End For

    ReturnValue = -1

    Return ReturnValue

End Function

End Module
