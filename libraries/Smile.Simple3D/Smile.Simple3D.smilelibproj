<SmileProject Version="1.0">
  <PropertyGroup>
    <ProjectKind>Library</ProjectKind>
    <LibraryName>Smile.Simple3D</LibraryName>
    <Version>2.0.0</Version>
    <OutputName>Smile.Simple3D</OutputName>
  </PropertyGroup>
  <ItemGroup>
    <SmileSource Include="Core.smile" />
    <SmileSource Include="FixedMath.smile" />
    <SmileSource Include="Math3D.smile" />
    <SmileSource Include="Mesh.smile" />
    <SmileSource Include="Primitives.smile" />
    <SmileSource Include="Renderer.smile" />
    <SmileSource Include="Interaction.smile" />
    <SmileSource Include="Graphics3D.smile" />
  </ItemGroup>
</SmileProject>
