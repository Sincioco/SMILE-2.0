<SmileProject Version="1.0">
  <PropertyGroup>
    <ProjectKind>Library</ProjectKind>
    <LibraryName>Smile.Simple3D</LibraryName>
    <Version>2.0.0</Version>
    <OutputName>Smile.Simple3D</OutputName>
  </PropertyGroup>
  <ItemGroup>
    <SmileSource Include="Core.smile" />
    <SmileSource Include="FixedMath.smile" />
    <SmileSource Include="Math3D.smile" />
    <SmileSource Include="Mesh.smile" />
    <SmileSource Include="Primitives.smile" />
    <SmileSource Include="Renderer.smile" />
    <SmileSource Include="Interaction.smile" />
    <SmileSource Include="CharacterViewer.smile" />
    <SmileSource Include="Graphics3D.smile" />
    <SmileSource Include="Scene3D.smile" />
    <SmileSource Include="Character3D.smile" />
    <SmileSource Include="NodeAim3D.smile" />
    <SmileSource Include="Effects3D.smile" />
    <SmileSource Include="AetherBlade3D.smile" />
    <SmileSource Include="FireEmitter3D.smile" />
    <SmileSource Include="LightningVfx3D.smile" />
    <SmileSource Include="Arena3D.smile" />
    <SmileSource Include="StaticBackdrop3D.smile" />
  </ItemGroup>
</SmileProject>
