Public Const PARTICLE_VALUE_POSITION_X = 2
Public Const PARTICLE_VALUE_POSITION_Y = 3
Public Const PARTICLE_VALUE_POSITION_Z = 4
Public Const PARTICLE_VALUE_VELOCITY_X = 5
Public Const PARTICLE_VALUE_VELOCITY_Y = 6
Public Const PARTICLE_VALUE_VELOCITY_Z = 7
Public Const PARTICLE_VALUE_AGE = 8
Public Const PARTICLE_VALUE_LIFETIME = 9
Public Const PARTICLE_VALUE_ROTATION = 10
Public Const PARTICLE_VALUE_ATLAS_FIRST = 11
Public Const PARTICLE_VALUE_ATLAS_COUNT = 12

