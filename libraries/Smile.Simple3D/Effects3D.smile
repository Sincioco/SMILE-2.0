    Return RequestedQualityValue

End Function

Public Function IsInitialized() As Boolean

    Return Initialized

End Function

Public Function EmitterCount(PresetId As Number) As Number

    Dim ReturnValue As Number

    Dim Index As Number

    Index = PresetIndex(PresetId)

    If Index < 0 Then
        Return 0
    End If

    ReturnValue = PresetEmitterCounts[Index]

    Return ReturnValue

End Function

