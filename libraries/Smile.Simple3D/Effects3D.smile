Public Const EFFECTS_ERROR_INVALID_QUALITY = 2
Public Const EFFECTS_ERROR_RENDERER_RESOURCE = 3
Public Const EFFECTS_ERROR_INVALID_PRESET = 4
Public Const EFFECTS_ERROR_CAPACITY = 5
Public Const EFFECTS_ERROR_INVALID_EFFECT = 6
Public Const EFFECTS_ERROR_DRAW = 7
Public Const EFFECTS_ERROR_RENDERER_RESET = 8
