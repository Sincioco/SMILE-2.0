Public Function ActiveImpulseCount() As Number

    Dim CountValue As Number
    Dim Slot As Number

    For Slot = 0 To MAX_IMPULSES - 1

        If ImpulseActive[Slot] Then
            CountValue = CountValue + 1
        End If

    End For

    Return CountValue

End Function

