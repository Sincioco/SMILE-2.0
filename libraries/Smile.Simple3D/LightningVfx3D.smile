''' Bounded deterministic lightning built from shared Renderer3D ribbons and particles.
Module Smile.Simple3D.LightningVfx3D

Option Explicit

Import Smile.Simple3D.Core As Core
Import Smile.Simple3D.Precision3D As Precision3D
Import Smile.Simple3D.PrecisionMath3D As PreciseMath
Import Smile.Simple3D.Graphics3D As Graphics3D
Import Smile.Simple3D.Math3D As Math3D
Import Smile.Simple3D.FixedMath As Fixed

Public Const QUALITY_LOW = 1
Public Const QUALITY_MEDIUM = 2
Public Const QUALITY_HIGH = 3
Public Const QUALITY_ULTRA = 4
Public Const QUALITY_AUTO = 5

Public Const FLASH_STANDARD = 1
Public Const FLASH_REDUCED = 2
Public Const FLASH_OFF = 3

Public Const MAX_EFFECTS = 8
Public Const MAX_CHAIN_TARGETS = 8
Public Const MAX_POINTS_PER_EFFECT = 1022
Public Const RIBBON_CAPACITY = 512
Public Const SPARK_CAPACITY = 64
Public Const FIXED_STEP_MILLISECONDS = 10
Public Const MAXIMUM_UPDATE_MILLISECONDS = 100

Public Const ERROR_NONE = 0
Public Const ERROR_NOT_INITIALIZED = 1
Public Const ERROR_INVALID_PRESET = 2
Public Const ERROR_INVALID_POSITION = 3
Public Const ERROR_CAPACITY = 4
Public Const ERROR_INVALID_EFFECT = 5
Public Const ERROR_IN_FLIGHT = 6
Public Const ERROR_RENDERER = 7
Public Const ERROR_CHAIN_CAPACITY = 8
Public Const ERROR_INVALID_FLASH_MODE = 9

Public Const QUERY_LIVE_EFFECTS = 1
Public Const QUERY_ACTIVE_POINTS = 2
Public Const QUERY_DROPPED_POINTS = 3
Public Const QUERY_LAST_ERROR = 4
Public Const QUERY_PARTICLE_BACKEND = 5
Public Const QUERY_PARTICLE_CAPACITY = 6
Public Const QUERY_PARTICLES = 7
Public Const QUERY_CPU_BYTES = 8
Public Const QUERY_GPU_BYTES = 9
Public Const QUERY_REBUILDS = 10
Public Const QUERY_PRESET = 30
Public Const QUERY_AGE = 31
Public Const QUERY_DURATION = 32
Public Const QUERY_QUALITY = 33
Public Const QUERY_TOPOLOGY_CHECKSUM = 34
Public Const QUERY_CHAIN_TARGETS = 35
Public Const QUERY_FINISHED = 36
Public Const QUERY_CHARGE = 37
Public Const QUERY_POINT_COUNT = 38
Public Const QUERY_FIRST_X = 40
Public Const QUERY_FIRST_Y = 41
Public Const QUERY_FIRST_Z = 42
Public Const QUERY_MAIN_TARGET_X = 43
Public Const QUERY_MAIN_TARGET_Y = 44
Public Const QUERY_MAIN_TARGET_Z = 45

Public Type LightningEffect
    Slot As Number
    Generation As Number
End Type

''' Caller-owned corona and world-space trail, independent of character/socket names.
Public Type WeaponTrail
    Particles As Core.GpuParticleSystem3D
    PreviousStart As Precision3D.Vector3
    PreviousEnd As Precision3D.Vector3
    HasPrevious As Boolean
    Cursor As Number
    Serial As Number
    EmissionRemainder As Number
End Type

Private Type LightningState
    Active As Boolean
    Enabled As Boolean
    Finished As Boolean
    Generation As Number
    Preset As Number
    Quality As Number
    BranchLimit As Number
    PathJitter1000 As Number
    ContourPresentation As Number
    SparkPercent As Number
    Seed As Number
    Age As Number
    Duration As Number
    Width As Number
    Intensity As Number
    Charge As Number
    TopologyBucket As Number
    TopologyChecksum As Number
    PointCount As Number
    ChainCount As Number
    PresentationPhase As Number
    LightRequest As Number
    FlashRequest As Number
    ShakeRequest As Number
    AudioRequest As Number
    Source As Precision3D.Vector3
    Target As Precision3D.Vector3
    MainTargetPoint As Number
End Type

Private Dim RibbonPoints As Number
Private Dim Ready As Boolean
Private Dim RendererEpoch As Number
Private Dim ErrorValue As Number
Private Dim FlashMode As Number
Private Dim UpdateRemainder As Number
Private Dim ActivePointCount As Number
Private Dim DroppedPointCount As Number
Private Dim RebuildCount As Number
Private Dim BranchesEnabled As Boolean
Private Dim DebugLayer As Number
Private Dim SpawnSerial As Number
Private Dim SpawnCursor As Number
Private Dim BuildDelay As Number
Private Dim Items[8] As LightningState
Private Dim PathX[8, 1022] As Double
Private Dim PathY[8, 1022] As Double
Private Dim PathZ[8, 1022] As Double
Private Dim PathWidth1000[8, 1022] As Number
Private Dim PathDelay[8, 1022] As Number
Private Dim ChainX[8, 8] As Double
Private Dim ChainY[8, 8] As Double
Private Dim ChainZ[8, 8] As Double
Private Dim RibbonTexture As Core.Texture3D
Private Dim SparkTexture As Core.Texture3D
Private Dim HaloMaterial As Core.Material3D
Private Dim GlowMaterial As Core.Material3D
Private Dim CoreMaterial As Core.Material3D
Private Dim SparkMaterial As Core.Material3D
Private Dim HaloRibbon As Core.RibbonBatch3D
Private Dim GlowRibbon As Core.RibbonBatch3D
Private Dim CoreRibbon As Core.RibbonBatch3D
Private Dim SparkBatch As Core.ParticleBatch3D
Private Dim GpuSparks As Core.GpuParticleSystem3D

Private Function UnitVector(Value As Precision3D.Vector3) As Precision3D.Vector3

    Dim Result As Precision3D.Vector3
    Dim Valid As Boolean

    Valid = PreciseMath.TryNormalize(Value, Result)

    Return Result

End Function

Private Function UnitCross(First As Precision3D.Vector3, Second As Precision3D.Vector3) As Precision3D.Vector3

    Dim Result As Precision3D.Vector3

    Result = UnitVector(PreciseMath.Cross(UnitVector(First), UnitVector(Second)))

    Return Result

End Function

Private Function PositionValid(Position As Precision3D.Vector3) As Boolean

    Dim Result As Boolean

    Result = (Position.X >= -1000000.0 And
        Position.X <= 1000000.0 And
        Position.Y >= -1000000.0 And
        Position.Y <= 1000000.0 And
        Position.Z >= -1000000.0 And
        Position.Z <= 1000000.0)

    Return Result

End Function

Private Function Current(Value As LightningEffect) As Boolean

    Dim Index As Number
    Dim Result As Boolean

    If Not Ready Or RendererEpoch <> Graphics3D.ResourceEpoch3D() Then
        Return False
    End If

    If Value.Slot < 1 Or Value.Slot > MAX_EFFECTS Then
        Return False
    End If

    Index = Value.Slot - 1
    Result = Items[Index].Active And Items[Index].Generation = Value.Generation

    Return Result

End Function

Private Function PresetId(Name As Text) As Number

    If Name = "StormGather" Then
        Return 1
    Else If Name = "SkyStrike" Then
        Return 2
    Else If Name = "SkyToWeaponCharge" Then
        Return 3
    Else If Name = "WeaponCorona" Or Name = "StoredStorm" Then
        Return 4
    Else If Name = "ThunderLance" Or Name = "ChargedBlast" Then
        Return 5
    Else If Name = "ChainTempest" Then
        Return 6
    Else If Name = "ThunderGroundSlam" Then
        Return 7
    Else If Name = "StormCrown" Then
        Return 8
    End If

    Return 0

End Function

Private Function EffectiveQuality(Requested As Number) As Number

    Dim Result As Number

    Result = Requested

    If Requested = QUALITY_AUTO Then
        Result = QUALITY_HIGH
    End If

    If Result < QUALITY_LOW Or Result > QUALITY_ULTRA Then
        Result = QUALITY_HIGH
    End If

    Return Result

End Function

Private Function SegmentCount(Quality As Number) As Number

    Dim Result As Number

    Result = 8

    If Quality = QUALITY_MEDIUM Then
        Result = 12
    Else If Quality = QUALITY_HIGH Then
        Result = 18
    Else If Quality = QUALITY_ULTRA Then
        Result = 24
    End If

    If RibbonPoints >= 2048 And Quality >= QUALITY_HIGH Then
        Result = 64
    End If

    If RibbonPoints >= 8192 And Quality = QUALITY_ULTRA Then
        Result = 128
    End If

    Return Result

End Function

Private Function BranchCount(Quality As Number) As Number

    Dim Result As Number

    Result = 1

    If Quality = QUALITY_MEDIUM Then
        Result = 2
    Else If Quality = QUALITY_HIGH Then
        Result = 3
    Else If Quality = QUALITY_ULTRA Then
        Result = 4
    End If

    If RibbonPoints >= 2048 And Quality >= QUALITY_HIGH Then
        Result = 16
    End If

    If RibbonPoints >= 8192 And Quality = QUALITY_ULTRA Then
        Result = 24
    End If

    Return Result

End Function

Private Function HashValue(Seed As Number, Salt As Number) As Number

    Dim Result As Number

    Result = ((Abs(Seed) Mod 1000000) * 48271 + (Salt + 1) * 7919) Mod 2147483647
    Result = Result Mod 32749
    Result = (Result * Result * 16807 + 97) Mod 2147483647

    Return Result

End Function

Private Function AppendPoint(
    Index As Number,
    Position As Precision3D.Vector3,
    Width1000 As Number
) As Boolean

    Dim Point As Number

    Point = Items[Index].PointCount

    If Point >= Min(MAX_POINTS_PER_EFFECT, RibbonPoints / MAX_EFFECTS - 2) Then
        DroppedPointCount = DroppedPointCount + 1

        Return False
    End If

    PathX[Index, Point] = Position.X
    PathY[Index, Point] = Position.Y
    PathZ[Index, Point] = Position.Z
    PathWidth1000[Index, Point] = Width1000
    PathDelay[Index, Point] = BuildDelay
    Items[Index].PointCount = Point + 1

    Return True

End Function

Private Function AppendBreak(Index As Number, Position As Precision3D.Vector3) As Boolean

    Dim Previous As Precision3D.Vector3
    Dim Result As Boolean

    If Items[Index].PointCount <= 0 Then
        Return True
    End If

    Previous.X = PathX[Index, Items[Index].PointCount - 1]
    Previous.Y = PathY[Index, Items[Index].PointCount - 1]
    Previous.Z = PathZ[Index, Items[Index].PointCount - 1]
    Result = AppendPoint(Index, Previous, 0)
    Result = AppendPoint(Index, Position, 0) And Result

    Return Result

End Function

Private Function AppendBoltPath(
    Index As Number,
    StartPosition As Precision3D.Vector3,
    EndPosition As Precision3D.Vector3,
    Segments As Number,
    Amplitude As Double,
    Salt As Number,
    AddBreak As Boolean
) As Boolean

    Dim Direction As Precision3D.Vector3
    Dim Reference As Precision3D.Vector3
    Dim Side As Precision3D.Vector3
    Dim UpVector As Precision3D.Vector3
    Dim Position As Precision3D.Vector3
    Dim StepIndex As Number
    Dim NoiseSide As Number
    Dim NoiseUp As Number
    Dim OffsetSide As Double
    Dim OffsetUp As Double
    Dim Samples[257] As Precision3D.Vector3
    Dim StackLow[32] As Number
    Dim StackHigh[32] As Number
    Dim StackAmplitude[32] As Double
    Dim StackSize As Number
    Dim LowIndex As Number
    Dim HighIndex As Number
    Dim MiddleIndex As Number
    Dim LocalAmplitude As Double
    Dim FirstSample As Number
    Dim Result As Boolean

    If Segments < 1 Then
        Return False
    End If

    Direction = UnitVector(PreciseMath.Subtract(EndPosition, StartPosition))
    Reference.Y = 1.0

    If Abs(Direction.Y) > 0.9 Then
        Reference.X = 1.0
        Reference.Y = 0.0
    End If

    Side = UnitCross(Direction, Reference)
    UpVector = UnitCross(Side, Direction)
    Result = True

    If AddBreak Then
        Result = AppendBreak(Index, StartPosition)
    End If

    Samples[0] = StartPosition
    Samples[Segments] = EndPosition
    StackHigh[0] = Segments
    StackAmplitude[0] = Amplitude
    StackSize = 1

    Do

        StackSize = StackSize - 1
        LowIndex = StackLow[StackSize]
        HighIndex = StackHigh[StackSize]
        MiddleIndex = (LowIndex + HighIndex) / 2
        LocalAmplitude = StackAmplitude[StackSize]

        If MiddleIndex > LowIndex Then

            Position.X = (Samples[LowIndex].X + Samples[HighIndex].X) / 2.0
            Position.Y = (Samples[LowIndex].Y + Samples[HighIndex].Y) / 2.0
            Position.Z = (Samples[LowIndex].Z + Samples[HighIndex].Z) / 2.0
            NoiseSide = HashValue(Items[Index].Seed, Salt + MiddleIndex * 2) Mod 2001 - 1000
            NoiseUp = HashValue(Items[Index].Seed, Salt + MiddleIndex * 2 + 1) Mod 2001 - 1000
            OffsetSide = ToDouble(NoiseSide) * LocalAmplitude / 1000.0
            OffsetUp = ToDouble(NoiseUp) * LocalAmplitude / 1000.0
            Position.X = Position.X + Side.X * OffsetSide
            Position.Y = Position.Y + Side.Y * OffsetSide
            Position.Z = Position.Z + Side.Z * OffsetSide
            Position.X = Position.X + UpVector.X * OffsetUp
            Position.Y = Position.Y + UpVector.Y * OffsetUp
            Position.Z = Position.Z + UpVector.Z * OffsetUp
            Samples[MiddleIndex] = Position
            StackLow[StackSize] = LowIndex
            StackHigh[StackSize] = MiddleIndex
            StackAmplitude[StackSize] = LocalAmplitude * 0.55
            StackSize = StackSize + 1
            StackLow[StackSize] = MiddleIndex
            StackHigh[StackSize] = HighIndex
            StackAmplitude[StackSize] = LocalAmplitude * 0.55
            StackSize = StackSize + 1

        End If

    Loop Until StackSize = 0

    ' Continuous contour edges share one corner, avoiding overlapping ribbon joins.

    If Not AddBreak And Items[Index].PointCount > 0 Then
        FirstSample = 1
    End If

    For StepIndex = FirstSample To Segments
        Result = AppendPoint(Index, Samples[StepIndex], 1000) And Result
    End For

    Return Result

End Function

Private Sub BuildEffect(Index As Number)

    Dim StartPosition As Precision3D.Vector3
    Dim EndPosition As Precision3D.Vector3
    Dim BranchStart As Precision3D.Vector3
    Dim BranchEnd As Precision3D.Vector3
    Dim Direction As Precision3D.Vector3
    Dim Reference As Precision3D.Vector3
    Dim Side As Precision3D.Vector3
    Dim UpVector As Precision3D.Vector3
    Dim Distance As Double
    Dim Amplitude As Double
    Dim Segments As Number
    Dim Branches As Number
    Dim Hop As Number
    Dim Branch As Number
    Dim MainStart As Number
    Dim MainPoint As Number
    Dim BranchFirst As Number
    Dim BranchPoint As Number
    Dim Result As Boolean

    Items[Index].PointCount = 0
    RebuildCount = RebuildCount + 1
    BuildDelay = 0
    StartPosition = Items[Index].Source
    EndPosition = Items[Index].Target
    Distance = PreciseMath.Distance(StartPosition, EndPosition)
    Segments = SegmentCount(Items[Index].Quality)
    Amplitude = Max(ToDouble(Items[Index].Width * 3), Distance / 5.0) * ToDouble(Items[Index].PathJitter1000) / 1000.0

    ' Short surface arcs need a few distinct bends, not a dense full-bolt cloud.

    If Items[Index].ContourPresentation = 2 Then
        Segments = 4
        Amplitude = Distance * 0.18
    End If

    If Items[Index].ChainCount > 0 Then
        Segments = Max(2, Segments / (Items[Index].ChainCount + 1))
    End If

    MainStart = Items[Index].PointCount
    Items[Index].MainTargetPoint = Segments
    Result = AppendBoltPath(Index, StartPosition, EndPosition, Segments, Amplitude,
        Items[Index].TopologyBucket * 101, False)

    For Hop = 0 To Items[Index].ChainCount - 1

        BuildDelay = (Hop + 1) * 110

        If Items[Index].Preset = 4 Then
            BuildDelay = 0
        End If

        StartPosition = EndPosition
        EndPosition.X = ChainX[Index, Hop]
        EndPosition.Y = ChainY[Index, Hop]
        EndPosition.Z = ChainZ[Index, Hop]
        Result = AppendBoltPath(Index, StartPosition, EndPosition, Segments,
            Amplitude, 2000 + Hop * 313 + Items[Index].TopologyBucket * 101,
            Items[Index].PathJitter1000 <> 0) And Result
    End For

    Direction = UnitVector(PreciseMath.Subtract(Items[Index].Target, Items[Index].Source))
    BuildDelay = 0
    Reference.Y = 1.0

    If Abs(Direction.Y) > 0.9 Then
        Reference.X = 1.0
        Reference.Y = 0.0
    End If

    Side = UnitCross(Direction, Reference)
    UpVector = UnitCross(Side, Direction)
    Branches = Min(Items[Index].BranchLimit, BranchCount(Items[Index].Quality))

    If Not BranchesEnabled Then
        Branches = 0
    End If

    Branches = Min(Branches, Max(0, (RibbonPoints / MAX_EFFECTS - 2 - Items[Index].PointCount) / 11))

    For Branch = 0 To Branches - 1

        MainPoint = MainStart + (Branch + 1) * Segments / (Branches + 1)
        BranchStart.X = PathX[Index, MainPoint]
        BranchStart.Y = PathY[Index, MainPoint]
        BranchStart.Z = PathZ[Index, MainPoint]
        BranchEnd = BranchStart
        BranchEnd.X = BranchEnd.X + Direction.X * Distance / 5.0
        BranchEnd.Y = BranchEnd.Y + Direction.Y * Distance / 5.0
        BranchEnd.Z = BranchEnd.Z + Direction.Z * Distance / 5.0
        BranchEnd.X = BranchEnd.X + Side.X * Distance * ToDouble(HashValue(Items[Index].Seed, Branch * 97) Mod 2001 - 1000) / 2400.0
        BranchEnd.Y = BranchEnd.Y + Side.Y * Distance * ToDouble(HashValue(Items[Index].Seed, Branch * 97) Mod 2001 - 1000) / 2400.0
        BranchEnd.Z = BranchEnd.Z + Side.Z * Distance * ToDouble(HashValue(Items[Index].Seed, Branch * 97) Mod 2001 - 1000) / 2400.0
        BranchEnd.X = BranchEnd.X + UpVector.X * Distance / 10.0
        BranchEnd.Y = BranchEnd.Y + UpVector.Y * Distance / 10.0
        BranchEnd.Z = BranchEnd.Z + UpVector.Z * Distance / 10.0

        If Items[Index].Preset = 7 Then
            BranchEnd.Y = Items[Index].Target.Y
        End If

        BranchFirst = Items[Index].PointCount + 2
        Result = AppendBoltPath(Index, BranchStart, BranchEnd, 8, Amplitude / 4.0,
            4000 + Branch * 127 + Items[Index].TopologyBucket * 101, True) And Result

        For BranchPoint = BranchFirst To Items[Index].PointCount - 1
            PathWidth1000[Index, BranchPoint] = Max(0, 650 * (8 - BranchPoint + BranchFirst) / 8)
        End For

        If Items[Index].PointCount > 0 Then
            PathWidth1000[Index, Items[Index].PointCount - 1] = 0
        End If

    End For

    Items[Index].TopologyChecksum = 17

    For MainPoint = 0 To Items[Index].PointCount - 1
        Items[Index].TopologyChecksum = (Items[Index].TopologyChecksum * 31 +
            ToNumber(PathX[Index, MainPoint]) * 3 + ToNumber(PathY[Index, MainPoint]) * 5 +
            ToNumber(PathZ[Index, MainPoint]) * 7 + PathWidth1000[Index, MainPoint]) Mod 2147483647
    End For

End Sub

Private Function StagePoint(
    ByRef Ribbon As Core.RibbonBatch3D,
    OutputIndex As Number,
    EffectIndex As Number,
    PointIndex As Number,
    Camera As Precision3D.Camera3D,
    Width As Double,
    RedValue As Number,
    GreenValue As Number,
    BlueValue As Number,
    Opacity As Number
) As Boolean

    Dim Center As Precision3D.Vector3
    Dim Previous As Precision3D.Vector3
    Dim Following As Precision3D.Vector3
    Dim Tangent As Precision3D.Vector3
    Dim ToCamera As Precision3D.Vector3
    Dim Side As Precision3D.Vector3
    Dim WorldCenter As Precision3D.Vector3
    Dim WidthOffset As Precision3D.Vector3
    Dim Normalized As Boolean
    Dim HalfWidth As Double
    Dim PreviousIndex As Number
    Dim FollowingIndex As Number
    Dim LastPoint As Number
    Dim ClosedPath As Boolean
    Dim LeaderEnd As Number
    Dim StreamerStart As Number
    Dim Result As Boolean

    Center.X = PathX[EffectIndex, PointIndex]
    Center.Y = PathY[EffectIndex, PointIndex]
    Center.Z = PathZ[EffectIndex, PointIndex]
    Previous = Center
    Following = Center
    LastPoint = Items[EffectIndex].PointCount - 1
    PreviousIndex = Max(0, PointIndex - 1)
    FollowingIndex = Min(LastPoint, PointIndex + 1)
    ClosedPath = (Items[EffectIndex].PathJitter1000 = 0 And
        Items[EffectIndex].ChainCount > 0 And
        PathX[EffectIndex, 0] = PathX[EffectIndex, LastPoint] And
        PathY[EffectIndex, 0] = PathY[EffectIndex, LastPoint] And
        PathZ[EffectIndex, 0] = PathZ[EffectIndex, LastPoint])

    If ClosedPath And PointIndex = 0 Then
        PreviousIndex = LastPoint - 1
    End If

    If ClosedPath And PointIndex = LastPoint Then
        FollowingIndex = 1
    End If

    Previous.X = PathX[EffectIndex, PreviousIndex]
    Previous.Y = PathY[EffectIndex, PreviousIndex]
    Previous.Z = PathZ[EffectIndex, PreviousIndex]
    Following.X = PathX[EffectIndex, FollowingIndex]
    Following.Y = PathY[EffectIndex, FollowingIndex]
    Following.Z = PathZ[EffectIndex, FollowingIndex]

    Tangent = PreciseMath.Subtract(Following, Previous)
    WorldCenter = Center
    ToCamera = PreciseMath.Subtract(Camera.Position, WorldCenter)
    Normalized = PreciseMath.TryNormalize(
        PreciseMath.Cross(Tangent, ToCamera), Side)

    If Not Normalized Then
        Side = Precision3D.Vector(1.0, 0.0, 0.0)
    End If

    HalfWidth = Width * ToDouble(PathWidth1000[EffectIndex, PointIndex]) / 1000.0

    If Items[EffectIndex].Age < PathDelay[EffectIndex, PointIndex] Then
        HalfWidth = 0.0
        Opacity = 0
    End If

    If (Items[EffectIndex].Preset <= 3 And
        Items[EffectIndex].Duration > 0 And
        Items[EffectIndex].Age * 100 < Items[EffectIndex].Duration * 40) Then

        LeaderEnd = (Items[EffectIndex].MainTargetPoint * Items[EffectIndex].Age * 80 /
            Max(1, Items[EffectIndex].Duration * 40))
        StreamerStart = Items[EffectIndex].MainTargetPoint * 9 / 10

        If (PointIndex > LeaderEnd And
            (PointIndex < StreamerStart Or
                PointIndex > Items[EffectIndex].MainTargetPoint Or
                Items[EffectIndex].Age * 100 < Items[EffectIndex].Duration * 20)) Then
            HalfWidth = 0.0
            Opacity = 0
        Else
            Opacity = Opacity * 35 / 100
        End If

    End If

    WidthOffset = PreciseMath.Scale(Side, HalfWidth)
    Result = Precision3D.SetRibbonPoint(Ribbon, OutputIndex,
        PreciseMath.Subtract(WorldCenter, WidthOffset),
        PreciseMath.Add(WorldCenter, WidthOffset), 0.5)
    Result = Graphics3D.SetRibbonPointColor3D(
        Ribbon,
        OutputIndex,
        RedValue,
        GreenValue,
        BlueValue,
        Opacity / 10
    ) And Result

    Return Result

End Function

Private Function EffectOpacity(Index As Number) As Number

    Dim Remaining As Number
    Dim PulsePeriod As Number
    Dim PulseAge As Number
    Dim Result As Number

    Result = Items[Index].Intensity

    If Items[Index].Duration > 0 Then

        Remaining = Items[Index].Duration - Items[Index].Age

        If Remaining < 180 Then
            Result = Result * Max(0, Remaining) / 180
        End If

    End If

    If FlashMode = FLASH_REDUCED Then
        Result = Min(Result, 650)
    End If

    If Items[Index].Duration > 0 And Items[Index].Age > Items[Index].Duration * 4 / 10 Then

        PulsePeriod = Max(60, Items[Index].Duration * 6 / 10 / 4)
        PulseAge = (Items[Index].Age - Items[Index].Duration * 4 / 10) Mod PulsePeriod
        Result = Result * (35 + Max(0, 60 - PulseAge) * 65 / 60) / 100

    End If

    Return Result

End Function

Private Function StageLayer(
    ByRef Ribbon As Core.RibbonBatch3D,
    Camera As Precision3D.Camera3D,
    WidthMultiplier As Number,
    RedValue As Number,
    GreenValue As Number,
    BlueValue As Number,
    LayerOpacity As Number
) As Boolean

    Dim EffectIndex As Number
    Dim PreviousEffectIndex As Number
    Dim PointIndex As Number
    Dim OutputIndex As Number
    Dim Opacity As Number
    Dim LayerWidth As Double
    Dim Result As Boolean

    Result = True
    PreviousEffectIndex = -1

    For EffectIndex = 0 To MAX_EFFECTS - 1

        If (Items[EffectIndex].Active And
            Items[EffectIndex].Enabled And
            Not Items[EffectIndex].Finished) Then

            If OutputIndex > 0 And Items[EffectIndex].PointCount > 0 Then

                If OutputIndex + 2 <= RibbonPoints Then

                    Result = StagePoint(
                        Ribbon,
                        OutputIndex,
                        PreviousEffectIndex,
                        Items[PreviousEffectIndex].PointCount - 1,
                        Camera,
                        0.0,
                        RedValue, GreenValue, BlueValue, 0) And Result
                    OutputIndex = OutputIndex + 1
                    Result = StagePoint(Ribbon, OutputIndex, EffectIndex, 0, Camera, 0.0,
                        RedValue, GreenValue, BlueValue, 0) And Result
                    OutputIndex = OutputIndex + 1

                End If

            End If

            Opacity = EffectOpacity(EffectIndex) * LayerOpacity / 1000
            LayerWidth = ToDouble(Items[EffectIndex].Width * WidthMultiplier) / 1000.0

            If Items[EffectIndex].ContourPresentation = 1 Then
                LayerWidth = LayerWidth * 0.45
            Else If Items[EffectIndex].ContourPresentation = 2 Then
                LayerWidth = LayerWidth * 0.18
            Else
                LayerWidth = ToDouble(Max(1, ToNumber(LayerWidth)))
            End If

            For PointIndex = 0 To Items[EffectIndex].PointCount - 1

                If OutputIndex < RibbonPoints Then
                    Result = StagePoint(
                        Ribbon,
                        OutputIndex,
                        EffectIndex,
                        PointIndex,
                        Camera,
                        LayerWidth,
                        RedValue,
                        GreenValue,
                        BlueValue,
                        Opacity
                    ) And Result
                    OutputIndex = OutputIndex + 1
                Else
                    DroppedPointCount = DroppedPointCount + 1
                End If

            End For

            PreviousEffectIndex = EffectIndex

        End If

    End For

    Result = Graphics3D.CommitRibbonBatch3D(Ribbon, OutputIndex) And Result

    Return Result

End Function

Private Function StageSparks() As Boolean

    Dim EffectIndex As Number
    Dim OutputIndex As Number
    Dim Position As Precision3D.Vector3
    Dim Opacity As Number
    Dim Result As Boolean

    Result = True

    For EffectIndex = 0 To MAX_EFFECTS - 1

        If (Items[EffectIndex].Active And
            Items[EffectIndex].Enabled And
            Not Items[EffectIndex].Finished And
            OutputIndex < SPARK_CAPACITY) Then

            Position = Items[EffectIndex].Target
            Opacity = EffectOpacity(EffectIndex) / 10
            Result = Precision3D.SetParticle(SparkBatch, OutputIndex, Position,
                ToDouble(Max(2, Items[EffectIndex].Width * 5)),
                ToDouble(Items[EffectIndex].Age * 3 Mod 360), 0) And Result
            Result = Graphics3D.SetParticleColor3D(
                SparkBatch,
                OutputIndex,
                235,
                249,
                255,
                Opacity
            ) And Result
            OutputIndex = OutputIndex + 1

        End If

    End For

    Result = Graphics3D.CommitParticleBatch3D(SparkBatch, OutputIndex) And Result

    Return Result

End Function

Private Function StageAll(Camera As Precision3D.Camera3D) As Boolean

    Dim Result As Boolean

    Result = StageLayer(HaloRibbon, Camera, 4200, 36, 116, 255, 180)
    Result = StageLayer(GlowRibbon, Camera, 2100, 102, 216, 255, 520) And Result
    Result = StageLayer(CoreRibbon, Camera, 700, 248, 254, 255, 1000) And Result
    Result = StageSparks() And Result
    ActivePointCount = HaloRibbon.PointCount

    If Not Result Then
        ErrorValue = ERROR_RENDERER
    End If

    Return Result

End Function

Private Function EmitSparks(Index As Number) As Boolean

    Dim SpawnCount As Number
    Dim Particle As Number
    Dim Slot As Number
    Dim Noise As Number
    Dim Position As Precision3D.Vector3
    Dim VelocityRange As Number
    Dim Lifetime As Number
    Dim Result As Boolean

    Result = True

    If GpuSparks.Handle = 0 Then
        Return True
    End If

    SpawnCount = Min(64, Items[Index].Quality * Items[Index].Quality * 4)
    VelocityRange = 220
    Lifetime = 600

    If Items[Index].Preset = 4 Then

        SpawnCount = Items[Index].Quality * 2
        VelocityRange = 35
        Lifetime = 250

    End If

    SpawnCount = SpawnCount * Items[Index].SparkPercent / 100

    For Particle = 0 To SpawnCount - 1

        SpawnSerial = SpawnSerial + 1
        Slot = SpawnCursor
        SpawnCursor = (SpawnCursor + 1) Mod GpuSparks.Capacity
        Result = Graphics3D.KillGpuParticleSlot3D(GpuSparks, Slot) And Result
        Noise = HashValue(Items[Index].Seed, SpawnSerial)
        Position = Items[Index].Target

        If Items[Index].Preset = 4 Then

            Position.X = (Items[Index].Source.X +
                (Items[Index].Target.X - Items[Index].Source.X) * ToDouble(Particle) / ToDouble(Max(1, SpawnCount - 1)))
            Position.Y = (Items[Index].Source.Y +
                (Items[Index].Target.Y - Items[Index].Source.Y) * ToDouble(Particle) / ToDouble(Max(1, SpawnCount - 1)))
            Position.Z = (Items[Index].Source.Z +
                (Items[Index].Target.Z - Items[Index].Source.Z) * ToDouble(Particle) / ToDouble(Max(1, SpawnCount - 1)))

        End If

        Result = Precision3D.SetGpuParticleSpawnKinematics(GpuSparks, Slot, Position,
            Precision3D.Vector(ToDouble(Noise Mod (VelocityRange * 2 + 1) - VelocityRange),
                ToDouble(Noise / 441 Mod (VelocityRange * 2)),
                ToDouble(Noise / 19321 Mod (VelocityRange * 2 + 1) - VelocityRange))) And Result
        Result = Graphics3D.SetGpuParticleSpawnVisual3D(GpuSparks, Slot,
            Lifetime + Noise Mod Lifetime, 1 + Noise Mod 3, 1, Noise Mod 360, 90, 1000, 800) And Result
        Result = Graphics3D.CommitGpuParticleSpawn3D(GpuSparks, Slot,
            SpawnSerial, Max(1, Noise)) And Result
    End For

    Return Result

End Function

Private Sub QueuePresentation(Index As Number, Phase As Number)

    If Phase <= Items[Index].PresentationPhase Then
        Return
    End If

    Items[Index].PresentationPhase = Phase

    If Phase = 1 Then

        Items[Index].LightRequest = 420
        Items[Index].AudioRequest = 1

    Else If Phase = 2 Then

        Items[Index].LightRequest = 850
        Items[Index].FlashRequest = 720
        Items[Index].ShakeRequest = 180
        Items[Index].AudioRequest = 2

        If FlashMode = FLASH_REDUCED Then
            Items[Index].FlashRequest = 240
            Items[Index].ShakeRequest = 90
        End If

    Else If Phase >= 3 Then

        Items[Index].LightRequest = 300
        Items[Index].AudioRequest = 3

    End If

End Sub

Private Sub AdvanceEffect(Index As Number)

    Dim Phase As Number
    Dim PreviousBucket As Number
    Dim Result As Boolean

    If (Not Items[Index].Active Or
        Not Items[Index].Enabled Or
        Items[Index].Finished) Then
        Return
    End If

    PreviousBucket = Items[Index].TopologyBucket
    Items[Index].Age = Items[Index].Age + FIXED_STEP_MILLISECONDS
    Items[Index].TopologyBucket = Items[Index].Age / 60

    If Items[Index].TopologyBucket <> PreviousBucket Then

        Call BuildEffect(Index)

        Result = EmitSparks(Index)

        If Not Result Then
            ErrorValue = ERROR_RENDERER
        End If

    End If

    If Items[Index].Duration > 0 Then

        Phase = Min(3, Items[Index].Age * 4 / Items[Index].Duration)

        Call QueuePresentation(Index, Phase)

        If Items[Index].Age >= Items[Index].Duration Then
            Items[Index].Finished = True
        End If

    End If

End Sub

''' Allocates the shared three-layer ribbon and spark batches once.
Public Function Initialize(
    Directory As Text,
    Optional ParticleCapacity As Number = 2048,
    Optional Simulation As Number = Graphics3D.GPU_PARTICLE_SIMULATION_AUTO,
    Optional PathCapacity As Number = 512
) As Boolean

    Dim Result As Boolean

    If Ready And RendererEpoch = Graphics3D.ResourceEpoch3D() Then
        Return True
    End If

    If Ready Then
        Call Shutdown()
    End If

    If Graphics3D.FrameActive3D() Then
        ErrorValue = ERROR_IN_FLIGHT

        Return False
    End If

    RendererEpoch = Graphics3D.ResourceEpoch3D()
    SpawnCursor = 0
    SpawnSerial = 0
    RibbonPoints = Min(8192, Max(512, PathCapacity))
    BranchesEnabled = True
    DebugLayer = 0
    DroppedPointCount = 0
    RebuildCount = 0
    RibbonTexture = Graphics3D.LoadTexture3D(Directory + "/lightning-ribbon.png")
    SparkTexture = Graphics3D.LoadTexture3D(Directory + "/lightning-spark.png")

    If RibbonTexture.Handle <> 0 Then

        HaloMaterial = Graphics3D.CreateEffectMaterial3D(
            RibbonTexture, Graphics3D.MATERIAL_ALPHA_ADDITIVE, 360)
        GlowMaterial = Graphics3D.CreateEffectMaterial3D(
            RibbonTexture, Graphics3D.MATERIAL_ALPHA_ADDITIVE, 360)
        CoreMaterial = Graphics3D.CreateEffectMaterial3D(
            RibbonTexture, Graphics3D.MATERIAL_ALPHA_ADDITIVE, 400)

    End If

    If SparkTexture.Handle <> 0 Then
        SparkMaterial = Graphics3D.CreateEffectMaterial3D(
            SparkTexture, Graphics3D.MATERIAL_ALPHA_ADDITIVE, 400)
    End If

    If (HaloMaterial.Handle <> 0 And
        GlowMaterial.Handle <> 0 And
        CoreMaterial.Handle <> 0 And
        SparkMaterial.Handle <> 0) Then

        HaloRibbon = Graphics3D.CreateRibbonBatch3D(RibbonPoints, HaloMaterial)
        GlowRibbon = Graphics3D.CreateRibbonBatch3D(RibbonPoints, GlowMaterial)
        CoreRibbon = Graphics3D.CreateRibbonBatch3D(RibbonPoints, CoreMaterial)
        SparkBatch = Graphics3D.CreateParticleBatch3D(
            SPARK_CAPACITY,
            SparkMaterial,
            Graphics3D.VFX_BILLBOARD_CAMERA,
            1,
            1
        )

    End If

    Result = (RibbonTexture.Handle <> 0 And
        SparkTexture.Handle <> 0 And
        HaloMaterial.Handle <> 0 And
        GlowMaterial.Handle <> 0 And
        CoreMaterial.Handle <> 0 And
        SparkMaterial.Handle <> 0 And
        HaloRibbon.Handle <> 0 And
        GlowRibbon.Handle <> 0 And
        CoreRibbon.Handle <> 0 And
        SparkBatch.Handle <> 0)

    If Not Result Then

        Call Shutdown()

        ErrorValue = ERROR_RENDERER

        Return False

    End If

    Ready = True
    RendererEpoch = Graphics3D.ResourceEpoch3D()
    FlashMode = FLASH_STANDARD
    ErrorValue = ERROR_NONE

    If Simulation <> Graphics3D.GPU_PARTICLE_SIMULATION_CPU_DETERMINISTIC Then

        GpuSparks = Graphics3D.CreateGpuParticleSystem3D(
            Min(16384, Max(64, ParticleCapacity)), SparkMaterial, Simulation, 10)

        If GpuSparks.EffectiveSimulation <> Graphics3D.GPU_PARTICLE_SIMULATION_GPU_FAST Then
            Call Graphics3D.DestroyGpuParticleSystem3D(GpuSparks)
        End If

    End If

    If GpuSparks.Handle <> 0 Then

        Result = Graphics3D.SetGpuParticleRender3D(GpuSparks, Graphics3D.GPU_PARTICLE_SHADER_THERMAL, 2)
        Result = Graphics3D.SetGpuParticleForces3D(GpuSparks, 0, -160, 0, 0, 0, 0, 0, 120) And Result
        Result = Graphics3D.SetGpuParticleThermalEvolution3D(GpuSparks, 0, 250, 0, 800) And Result

    End If

    Result = Graphics3D.SetEffectMaterialSoftDepth3D(SparkMaterial, 1)

    Return True

End Function

''' Borrows the shared spark material; destroy the trail before Lightning.Shutdown.
Public Function CreateWeaponTrail() As WeaponTrail

    Dim Result As WeaponTrail
    Dim Ok As Boolean

    If Not Ready Or RendererEpoch <> Graphics3D.ResourceEpoch3D() Then
        Return Result
    End If

    Result.Particles = Graphics3D.CreateGpuParticleSystem3D(1024,
        SparkMaterial, Graphics3D.GPU_PARTICLE_SIMULATION_AUTO, 10)
    Ok = Result.Particles.Handle <> 0

    If Ok Then

        Ok = Graphics3D.SetGpuParticleRender3D(Result.Particles,
            Graphics3D.GPU_PARTICLE_SHADER_THERMAL, 2)
        Ok = Graphics3D.SetGpuParticleForces3D(Result.Particles,
            0, 8, 0, 0, 0, 0, 0, 500) And Ok
        Ok = Graphics3D.SetGpuParticleThermalEvolution3D(Result.Particles,
            0, 500, 0, 1400) And Ok

    End If

    If Not Ok Then
        Call DestroyWeaponTrail(Result)
    End If

    Return Result

End Function

Public Sub DestroyWeaponTrail(ByRef Value As WeaponTrail)

    Call Graphics3D.DestroyGpuParticleSystem3D(Value.Particles)

    Value.HasPrevious = False
    Value.Cursor = 0
    Value.EmissionRemainder = 0

End Sub

''' Emit along the full supplied weapon span; retained particles fade in world space.
Public Function UpdateWeaponTrail(ByRef Value As WeaponTrail,
    StartPoint As Precision3D.Vector3, EndPoint As Precision3D.Vector3,
    Elapsed As Number, MotionPaused As Boolean, Paused As Boolean,
    Optional Intensity As Number = 100) As Boolean

    Dim Step As Number
    Dim SparkCount As Number
    Dim Index As Number
    Dim Noise As Number
    Dim SlotSerial As Number
    Dim Size As Number
    Dim Travel As Double
    Dim Fraction As Double
    Dim Along As Double
    Dim SweptStart As Precision3D.Vector3
    Dim SweptEnd As Precision3D.Vector3
    Dim Point As Precision3D.Vector3
    Dim Result As Boolean

    If (Value.Particles.Handle = 0 Or
        Not PositionValid(StartPoint) Or
        Not PositionValid(EndPoint)) Then
        Return False
    End If

    If Paused Then
        Value.HasPrevious = False
        Return True
    End If

    Step = Min(MAXIMUM_UPDATE_MILLISECONDS, Max(0, Elapsed))
    Travel = Max(PreciseMath.Distance(Value.PreviousStart, StartPoint),
        PreciseMath.Distance(Value.PreviousEnd, EndPoint))

    If (Not Value.HasPrevious Or
        MotionPaused Or
        Travel > 100.0) Then

        Value.PreviousStart = StartPoint
        Value.PreviousEnd = EndPoint
        Travel = 0.0

    End If

    ''' Time-based density avoids frame-rate-dependent emission; travel fills fast swings.
    Value.EmissionRemainder = Value.EmissionRemainder + Step
    SparkCount = Min(64, Value.EmissionRemainder / 3 + ToNumber(Travel / 2.0))
    SparkCount = Min(64, SparkCount * Max(0, Min(200, Intensity)) / 100)
    Value.EmissionRemainder = Value.EmissionRemainder Mod 3
    Size = Max(4, Min(10, ToNumber(PreciseMath.Distance(StartPoint, EndPoint) / 12.0)))
    Result = True

    If Step > 0 Then

        For Index = 0 To SparkCount - 1

            Value.Serial = Value.Serial Mod 100000 + 1
            Noise = (Value.Serial * 7919) Mod 104729
            Fraction = ToDouble(Index + 1) / ToDouble(SparkCount)

            SweptStart = PreciseMath.Add(Value.PreviousStart,
                PreciseMath.Scale(PreciseMath.Subtract(StartPoint, Value.PreviousStart), Fraction))
            SweptEnd = PreciseMath.Add(Value.PreviousEnd,
                PreciseMath.Scale(PreciseMath.Subtract(EndPoint, Value.PreviousEnd), Fraction))
            Along = ToDouble(Noise Mod 1001) / 1000.0
            Point = PreciseMath.Add(SweptStart,
                PreciseMath.Scale(PreciseMath.Subtract(SweptEnd, SweptStart), Along))
            Point.X = Point.X + ToDouble(Noise Mod 7 - 3) * 0.35
            Point.Y = Point.Y + ToDouble(Noise / 7 Mod 7 - 3) * 0.35
            Point.Z = Point.Z + ToDouble(Noise / 49 Mod 7 - 3) * 0.35
            Result = Graphics3D.KillGpuParticleSlot3D(Value.Particles, Value.Cursor) And Result
            Result = Precision3D.SetGpuParticleSpawnKinematics(Value.Particles,
                Value.Cursor, Point, Precision3D.Vector(
                    ToDouble(Noise Mod 13 - 6), ToDouble(Noise / 13 Mod 10),
                    ToDouble(Noise / 130 Mod 13 - 6))) And Result
            Result = Graphics3D.SetGpuParticleSpawnVisual3D(Value.Particles,
                Value.Cursor, 500 + Noise Mod 220, Size, 1,
                Noise Mod 360, 40, 950, 650) And Result
            SlotSerial = Graphics3D.GpuParticleValue3D(
                Graphics3D.GPU_PARTICLE_QUERY_SLOT_SERIAL, Value.Particles.Handle, Value.Cursor) + 1
            Result = Graphics3D.CommitGpuParticleSpawn3D(Value.Particles,
                Value.Cursor, SlotSerial, Max(1, Noise)) And Result
            Value.Cursor = (Value.Cursor + 1) Mod 1024
        End For

        Result = Graphics3D.AdvanceGpuParticleSystem3D(Value.Particles, Step) And Result

    End If

    Value.PreviousStart = StartPoint
    Value.PreviousEnd = EndPoint
    Value.HasPrevious = True

    Return Result

End Function

''' Starts a caller-owned point-to-point visual. It never selects targets or applies damage.
Public Function StartAt(Preset As Text, Source As Core.Vector3, Target As Core.Vector3, Seed As Number,
    Optional Quality As Number = QUALITY_AUTO) As LightningEffect

    Dim Result As LightningEffect

    Result = StartAtPrecise(Preset, Precision3D.FromVector(Source), Precision3D.FromVector(Target), Seed, Quality)

    Return Result

End Function

Public Function StartAtPrecise(
    Preset As Text,
    Source As Precision3D.Vector3,
    Target As Precision3D.Vector3,
    Seed As Number,
    Optional Quality As Number = QUALITY_AUTO
) As LightningEffect

    Dim Index As Number
    Dim PresetValue As Number
    Dim Result As LightningEffect

    If Not Ready Or RendererEpoch <> Graphics3D.ResourceEpoch3D() Then
        ErrorValue = ERROR_NOT_INITIALIZED

        Return Result
    End If

    If Graphics3D.FrameActive3D() Then
        ErrorValue = ERROR_IN_FLIGHT

        Return Result
    End If

    PresetValue = PresetId(Preset)

    If PresetValue = 0 Then
        ErrorValue = ERROR_INVALID_PRESET

        Return Result
    End If

    If (Not PositionValid(Source) Or
        Not PositionValid(Target) Or
        PreciseMath.Distance(Source, Target) <= 0.0) Then
        ErrorValue = ERROR_INVALID_POSITION

        Return Result
    End If

    Index = -1

    For Index = 0 To MAX_EFFECTS - 1

        If Not Items[Index].Active Then
            Exit For
        End If

    End For

    If Index < 0 Or Index >= MAX_EFFECTS Then
        ErrorValue = ERROR_CAPACITY

        Return Result
    End If

    If Items[Index].Active Then
        ErrorValue = ERROR_CAPACITY

        Return Result
    End If

    Items[Index].Generation = Items[Index].Generation + 1

    If Items[Index].Generation <= 0 Then
        Items[Index].Generation = 1
    End If

    Items[Index].Active = True
    Items[Index].Enabled = True
    Items[Index].Finished = False
    Items[Index].Preset = PresetValue
    Items[Index].BranchLimit = 64
    Items[Index].PathJitter1000 = 1000
    Items[Index].SparkPercent = 100
    Items[Index].Quality = EffectiveQuality(Quality)
    Items[Index].Seed = Max(1, Abs(Seed))
    Items[Index].Age = 0
    Items[Index].Duration = 900
    Items[Index].Width = 3
    Items[Index].Intensity = 1000
    Items[Index].Charge = 0
    Items[Index].TopologyBucket = 0
    Items[Index].TopologyChecksum = 0
    Items[Index].ChainCount = 0
    Items[Index].ContourPresentation = 0
    Items[Index].PresentationPhase = 0
    Items[Index].LightRequest = 180
    Items[Index].FlashRequest = 0
    Items[Index].ShakeRequest = 0
    Items[Index].AudioRequest = 0
    Items[Index].Source = Source
    Items[Index].Target = Target

    If PresetValue = 1 Then

        Items[Index].Duration = 1200
        Items[Index].Width = 2

    Else If PresetValue = 2 Then

        Items[Index].Duration = 650
        Items[Index].Width = 4

    Else If PresetValue = 3 Then

        Items[Index].Duration = 1200
        Items[Index].Width = 3

    Else If PresetValue = 4 Then

        Items[Index].Duration = 0
        Items[Index].Width = 2
        Items[Index].Intensity = 820

    Else If PresetValue = 5 Then

        Items[Index].Duration = 700
        Items[Index].Width = 5

    Else If PresetValue = 6 Then

        Items[Index].Duration = 950
        Items[Index].Width = 4

    Else If PresetValue = 7 Then

        Items[Index].Duration = 1000
        Items[Index].Width = 5

    Else If PresetValue = 8 Then

        Items[Index].Duration = 1800
        Items[Index].Width = 5

    End If

    Call BuildEffect(Index)

    Result.Slot = Index + 1
    Result.Generation = Items[Index].Generation
    ErrorValue = ERROR_NONE

    Return Result

End Function

Public Function SetEndpoints(Value As LightningEffect, Source As Core.Vector3, Target As Core.Vector3) As Boolean

    Dim Result As Boolean

    Result = SetEndpointsPrecise(Value, Precision3D.FromVector(Source), Precision3D.FromVector(Target))

    Return Result

End Function

Public Function SetEndpointsPrecise(
    Value As LightningEffect,
    Source As Precision3D.Vector3,
    Target As Precision3D.Vector3
) As Boolean

    Dim Index As Number

    If Not Current(Value) Then
        ErrorValue = ERROR_INVALID_EFFECT

        Return False
    End If

    If Graphics3D.FrameActive3D() Then
        ErrorValue = ERROR_IN_FLIGHT

        Return False
    End If

    If (Not PositionValid(Source) Or
        Not PositionValid(Target) Or
        PreciseMath.Distance(Source, Target) <= 0.0) Then
        ErrorValue = ERROR_INVALID_POSITION

        Return False
    End If

    Index = Value.Slot - 1
    Items[Index].Source = Source
    Items[Index].Target = Target

    Call BuildEffect(Index)

    ErrorValue = ERROR_NONE

    Return True

End Function

Public Function AddChainTarget(Value As LightningEffect, Target As Core.Vector3) As Boolean

    Dim Result As Boolean

    Result = AddChainTargetPrecise(Value, Precision3D.FromVector(Target))

    Return Result

End Function

Public Function AddChainTargetPrecise(Value As LightningEffect, Target As Precision3D.Vector3) As Boolean

    Dim ChainIndex As Number
    Dim Index As Number

    If Not Current(Value) Then
        ErrorValue = ERROR_INVALID_EFFECT

        Return False
    End If

    If Graphics3D.FrameActive3D() Then
        ErrorValue = ERROR_IN_FLIGHT

        Return False
    End If

    If Not PositionValid(Target) Then
        ErrorValue = ERROR_INVALID_POSITION

        Return False
    End If

    Index = Value.Slot - 1
    ChainIndex = Items[Index].ChainCount

    If ChainIndex >= MAX_CHAIN_TARGETS Then
        ErrorValue = ERROR_CHAIN_CAPACITY

        Return False
    End If

    ChainX[Index, ChainIndex] = Target.X
    ChainY[Index, ChainIndex] = Target.Y
    ChainZ[Index, ChainIndex] = Target.Z
    Items[Index].ChainCount = ChainIndex + 1

    Call BuildEffect(Index)

    ErrorValue = ERROR_NONE

    Return True

End Function

''' Reposition an existing chain point after resolving an animated attachment.
Public Function SetChainTarget(Value As LightningEffect, ChainIndex As Number, Target As Core.Vector3) As Boolean

    Dim Result As Boolean

    Result = SetChainTargetPrecise(Value, ChainIndex, Precision3D.FromVector(Target))

    Return Result

End Function

Public Function SetChainTargetPrecise(Value As LightningEffect, ChainIndex As Number, Target As Precision3D.Vector3) As Boolean

    Dim Index As Number

    If Not Current(Value) Then
        ErrorValue = ERROR_INVALID_EFFECT
        Return False
    End If

    If Graphics3D.FrameActive3D() Then
        ErrorValue = ERROR_IN_FLIGHT
        Return False
    End If

    Index = Value.Slot - 1

    If (ChainIndex < 0 Or
        ChainIndex >= Items[Index].ChainCount Or
        Not PositionValid(Target)) Then
        ErrorValue = ERROR_INVALID_POSITION
        Return False
    End If

    ChainX[Index, ChainIndex] = Target.X
    ChainY[Index, ChainIndex] = Target.Y
    ChainZ[Index, ChainIndex] = Target.Z

    Call BuildEffect(Index)

    ErrorValue = ERROR_NONE

    Return True

End Function

''' Restrict displacement for contours; zero produces an exact glowing path.
Public Function SetPathJitter(Value As LightningEffect, Jitter1000 As Number) As Boolean

    If Not Current(Value) Then
        ErrorValue = ERROR_INVALID_EFFECT
        Return False
    End If

    If Graphics3D.FrameActive3D() Then
        ErrorValue = ERROR_IN_FLIGHT
        Return False
    End If

    Items[Value.Slot - 1].PathJitter1000 = Min(1000, Max(0, Jitter1000))

    Call BuildEffect(Value.Slot - 1)

    ErrorValue = ERROR_NONE

    Return True

End Function

Public Function SetCharge(Value As LightningEffect, Charge1000 As Number) As Boolean

    Dim Index As Number
    Dim Previous As Number

    If Not Current(Value) Then
        ErrorValue = ERROR_INVALID_EFFECT

        Return False
    End If

    If Graphics3D.FrameActive3D() Then
        ErrorValue = ERROR_IN_FLIGHT

        Return False
    End If

    Index = Value.Slot - 1
    Previous = Items[Index].Charge
    Items[Index].Charge = Min(1000, Max(0, Charge1000))
    Items[Index].Intensity = 520 + Items[Index].Charge * 480 / 1000

    If Previous < 1000 And Items[Index].Charge = 1000 Then

        Items[Index].LightRequest = 900
        Items[Index].FlashRequest = 650
        Items[Index].AudioRequest = 4

        If FlashMode = FLASH_REDUCED Then
            Items[Index].FlashRequest = 220
        End If

    End If

    ErrorValue = ERROR_NONE

    Return True

End Function

Public Function SetEnabled(Value As LightningEffect, Enabled As Boolean) As Boolean

    Dim Index As Number

    If Not Current(Value) Then
        ErrorValue = ERROR_INVALID_EFFECT

        Return False
    End If

    If Graphics3D.FrameActive3D() Then
        ErrorValue = ERROR_IN_FLIGHT

        Return False
    End If

    Index = Value.Slot - 1
    Items[Index].Enabled = Enabled

    Return True

End Function

Public Function SetFlashMode(Mode As Number) As Boolean

    If Graphics3D.FrameActive3D() Then
        ErrorValue = ERROR_IN_FLIGHT

        Return False
    End If

    If Mode < FLASH_STANDARD Or Mode > FLASH_OFF Then
        ErrorValue = ERROR_INVALID_FLASH_MODE

        Return False
    End If

    FlashMode = Mode
    ErrorValue = ERROR_NONE

    Return True

End Function

''' Configures shared presentation layers outside frame submission.
Public Function Configure(Branches As Boolean, Layer As Number,
    SoftDepth As Boolean, Distortion As Boolean) As Boolean

    Dim Index As Number
    Dim SoftMode As Number
    Dim DistortionStrength As Number
    Dim Result As Boolean

    If (Not Ready Or
        Graphics3D.FrameActive3D() Or
        Layer < 0 Or
        Layer > 3) Then
        Return False
    End If

    BranchesEnabled = Branches
    DebugLayer = Layer

    If SoftDepth Then
        SoftMode = 1
    End If

    If Distortion Then
        DistortionStrength = 8
    End If

    Result = Graphics3D.SetEffectMaterialSoftDepth3D(SparkMaterial, SoftMode)
    Result = Graphics3D.SetEffectMaterialDistortion3D(SparkMaterial,
        DistortionStrength, 180, 40, 30, 10) And Result

    For Index = 0 To MAX_EFFECTS - 1

        If Items[Index].Active Then
            Call BuildEffect(Index)
        End If

    End For

    Return Result

End Function

''' World-space width and per-mille intensity, independent of the caller's charge value.
Public Function SetStyle(Effect As LightningEffect, Width As Number,
    Intensity1000 As Number) As Boolean

    If Not Current(Effect) Or Graphics3D.FrameActive3D() Then
        Return False
    End If

    Items[Effect.Slot - 1].Width = Min(40, Max(1, Width))
    Items[Effect.Slot - 1].Intensity = Min(1000, Max(0, Intensity1000))

    Return True

End Function

Public Function SetBranchBudget(Effect As LightningEffect, BranchLimit As Number) As Boolean

    If Not Current(Effect) Or Graphics3D.FrameActive3D() Then
        Return False
    End If

    Items[Effect.Slot - 1].BranchLimit = Min(64, Max(0, BranchLimit))

    Call BuildEffect(Effect.Slot - 1)

    Return True

End Function

Public Function SetSparkIntensity(Effect As LightningEffect, Percent As Number) As Boolean

    If Not Current(Effect) Or Graphics3D.FrameActive3D() Then
        Return False
    End If

    Items[Effect.Slot - 1].SparkPercent = Min(100, Max(0, Percent))

    Return True

End Function

Public Function PhaseName(Effect As LightningEffect) As Text

    Dim Index As Number
    Dim Phase1000 As Number

    If Not Current(Effect) Then
        Return "Inactive"
    End If

    Index = Effect.Slot - 1

    If Items[Index].Duration = 0 Then
        Return "Stored Storm"
    End If

    Phase1000 = Items[Index].Age * 1000 / Items[Index].Duration

    If Phase1000 < 200 Then
        Return "Descending Leader"
    Else If Phase1000 < 400 Then
        Return "Upward Streamer"
    Else If Phase1000 < 700 Then
        Return "Return Stroke"
    Else If Phase1000 < 1000 Then
        Return "Afterstroke"
    End If

    Return "Complete"

End Function

''' Advances all active effects in bounded fixed 10 ms steps and restages camera-facing edges.
Public Function Update(ElapsedMilliseconds As Number, Camera As Core.Camera3D) As Boolean

    Dim Result As Boolean

    Result = UpdatePrecise(ElapsedMilliseconds, Precision3D.FromCamera(Camera))

    Return Result

End Function

Public Function UpdatePrecise(ElapsedMilliseconds As Number, Camera As Precision3D.Camera3D) As Boolean

    Dim Index As Number
    Dim StepIndex As Number
    Dim Steps As Number
    Dim Result As Boolean

    If Not Ready Or RendererEpoch <> Graphics3D.ResourceEpoch3D() Then
        ErrorValue = ERROR_NOT_INITIALIZED

        Return False
    End If

    If Graphics3D.FrameActive3D() Then
        ErrorValue = ERROR_IN_FLIGHT

        Return False
    End If

    ElapsedMilliseconds = Min(MAXIMUM_UPDATE_MILLISECONDS, Max(0, ElapsedMilliseconds))
    UpdateRemainder = UpdateRemainder + ElapsedMilliseconds
    Steps = Min(10, UpdateRemainder / FIXED_STEP_MILLISECONDS)
    UpdateRemainder = UpdateRemainder - Steps * FIXED_STEP_MILLISECONDS

    Result = True

    For StepIndex = 1 To Steps

        For Index = 0 To MAX_EFFECTS - 1
            Call AdvanceEffect(Index)
        End For

        If GpuSparks.Handle <> 0 Then
            Result = Graphics3D.AdvanceGpuParticleSystem3D(GpuSparks, FIXED_STEP_MILLISECONDS) And Result
        End If

    End For

    Result = StageAll(Camera) And Result

    Return Result

End Function

Public Function DrawAll() As Boolean

    Dim Result As Boolean

    If Not Ready Or RendererEpoch <> Graphics3D.ResourceEpoch3D() Then
        ErrorValue = ERROR_NOT_INITIALIZED

        Return False
    End If

    Result = True

    If DebugLayer = 0 Or DebugLayer = 2 Then
        Result = Graphics3D.DrawRibbonBatch3D(HaloRibbon)
        Result = Graphics3D.DrawRibbonBatch3D(GlowRibbon) And Result
    End If

    If DebugLayer = 0 Or DebugLayer = 1 Then
        Result = Graphics3D.DrawRibbonBatch3D(CoreRibbon) And Result
    End If

    If DebugLayer = 0 Or DebugLayer = 3 Then

        Result = Graphics3D.DrawParticleBatch3D(SparkBatch) And Result

        If GpuSparks.Handle <> 0 Then
            Result = Graphics3D.DrawGpuParticleSystem3D(GpuSparks) And Result
        End If

    End If

    If Not Result Then
        ErrorValue = ERROR_RENDERER
    End If

    Return Result

End Function

Public Function Destroy(ByRef Value As LightningEffect) As Boolean

    Dim Index As Number

    If Not Current(Value) Then

        Value.Slot = 0
        Value.Generation = 0
        ErrorValue = ERROR_INVALID_EFFECT

        Return False

    End If

    If Graphics3D.FrameActive3D() Then
        ErrorValue = ERROR_IN_FLIGHT

        Return False
    End If

    Index = Value.Slot - 1
    Items[Index].Active = False
    Items[Index].Enabled = False
    Items[Index].Finished = False
    Items[Index].PointCount = 0
    Items[Index].ChainCount = 0
    Value.Slot = 0
    Value.Generation = 0
    ErrorValue = ERROR_NONE

    Return True

End Function

Public Function ConsumeLightRequest(Value As LightningEffect) As Number

    Dim Index As Number
    Dim Result As Number

    If Not Current(Value) Then
        Return 0
    End If

    Index = Value.Slot - 1
    Result = Items[Index].LightRequest
    Items[Index].LightRequest = 0

    Return Result

End Function

Public Function ConsumeFlashRequest(Value As LightningEffect) As Number

    Dim Index As Number
    Dim Result As Number

    If Not Current(Value) Then
        Return 0
    End If

    Index = Value.Slot - 1
    Result = Items[Index].FlashRequest
    Items[Index].FlashRequest = 0

    If FlashMode = FLASH_OFF Then
        Result = 0
    End If

    Return Result

End Function

Public Function ConsumeShakeRequest(Value As LightningEffect) As Number

    Dim Index As Number
    Dim Result As Number

    If Not Current(Value) Then
        Return 0
    End If

    Index = Value.Slot - 1
    Result = Items[Index].ShakeRequest
    Items[Index].ShakeRequest = 0

    Return Result

End Function

Public Function ConsumeAudioRequest(Value As LightningEffect) As Number

    Dim Index As Number
    Dim Result As Number

    If Not Current(Value) Then
        Return 0
    End If

    Index = Value.Slot - 1
    Result = Items[Index].AudioRequest
    Items[Index].AudioRequest = 0

    Return Result

End Function

Public Function Value(Query As Number, Effect As LightningEffect) As Number

    Dim ReturnValue As Number

    Dim Index As Number
    Dim ItemIndex As Number
    Dim TargetPoint As Number
    Dim Result As Number

    If Query = QUERY_LAST_ERROR Then

        Return ErrorValue

    Else If Query = QUERY_LIVE_EFFECTS Then

        For ItemIndex = 0 To MAX_EFFECTS - 1

            If Items[ItemIndex].Active Then
                Result = Result + 1
            End If

        End For

        Return Result

    Else If Query = QUERY_ACTIVE_POINTS Then

        Return ActivePointCount

    Else If Query = QUERY_DROPPED_POINTS Then

        Return DroppedPointCount

    Else If Query = QUERY_PARTICLE_BACKEND Then

        ReturnValue = GpuSparks.EffectiveSimulation

        Return ReturnValue

    Else If Query = QUERY_PARTICLE_CAPACITY Then

        ReturnValue = GpuSparks.Capacity

        Return ReturnValue

    Else If Query = QUERY_PARTICLES Then

        If GpuSparks.Handle = 0 Then
            Return 0
        End If

        Result = Graphics3D.GpuParticleValue3D(Graphics3D.GPU_PARTICLE_QUERY_RESOURCE_ACTIVE,
            GpuSparks.Handle)
        Return Result

    Else If Query = QUERY_CPU_BYTES Then

        If GpuSparks.Handle = 0 Then
            Return 0
        End If

        Result = Graphics3D.GpuParticleValue3D(Graphics3D.GPU_PARTICLE_QUERY_RESOURCE_CPU_BYTES,
            GpuSparks.Handle)
        Return Result

    Else If Query = QUERY_GPU_BYTES Then

        If GpuSparks.Handle = 0 Then
            Return 0
        End If

        Result = Graphics3D.GpuParticleValue3D(Graphics3D.GPU_PARTICLE_QUERY_RESOURCE_GPU_BYTES,
            GpuSparks.Handle)
        Return Result

    Else If Query = QUERY_REBUILDS Then

        Return RebuildCount

    End If

    If Not Current(Effect) Then
        Return 0
    End If

    Index = Effect.Slot - 1

    If Query = QUERY_PRESET Then

        Result = Items[Index].Preset

    Else If Query = QUERY_AGE Then

        Result = Items[Index].Age

    Else If Query = QUERY_DURATION Then

        Result = Items[Index].Duration

    Else If Query = QUERY_QUALITY Then

        Result = Items[Index].Quality

    Else If Query = QUERY_TOPOLOGY_CHECKSUM Then

        Result = Items[Index].TopologyChecksum

    Else If Query = QUERY_CHAIN_TARGETS Then

        Result = Items[Index].ChainCount

    Else If Query = QUERY_FINISHED Then

        If Items[Index].Finished Then
            Result = 1
        End If

    Else If Query = QUERY_CHARGE Then

        Result = Items[Index].Charge

    Else If Query = QUERY_POINT_COUNT Then

        Result = Items[Index].PointCount

    Else If Query = QUERY_FIRST_X Then

        Result = ToNumber(Round(PathX[Index, 0]))

    Else If Query = QUERY_FIRST_Y Then

        Result = ToNumber(Round(PathY[Index, 0]))

    Else If Query = QUERY_FIRST_Z Then

        Result = ToNumber(Round(PathZ[Index, 0]))

    Else If (Query = QUERY_MAIN_TARGET_X Or
        Query = QUERY_MAIN_TARGET_Y Or
        Query = QUERY_MAIN_TARGET_Z) Then

        TargetPoint = Items[Index].MainTargetPoint

        If Query = QUERY_MAIN_TARGET_X Then
            Result = ToNumber(Round(PathX[Index, TargetPoint]))
        Else If Query = QUERY_MAIN_TARGET_Y Then
            Result = ToNumber(Round(PathY[Index, TargetPoint]))
        Else
            Result = ToNumber(Round(PathZ[Index, TargetPoint]))
        End If

    End If

    Return Result

End Function

Public Function IsActive(Value As LightningEffect) As Boolean

    Dim Result As Boolean

    Result = Current(Value)

    Return Result

End Function

Public Sub Shutdown()

    Dim Index As Number
    Dim SameEpoch As Boolean

    SameEpoch = RendererEpoch = Graphics3D.ResourceEpoch3D()

    If Graphics3D.FrameActive3D() And SameEpoch Then
        ErrorValue = ERROR_IN_FLIGHT

        Return
    End If

    If SameEpoch Then

        Call Graphics3D.DestroyParticleBatch3D(SparkBatch)
        Call Graphics3D.DestroyGpuParticleSystem3D(GpuSparks)
        Call Graphics3D.DestroyRibbonBatch3D(HaloRibbon)
        Call Graphics3D.DestroyRibbonBatch3D(GlowRibbon)
        Call Graphics3D.DestroyRibbonBatch3D(CoreRibbon)
        Call Graphics3D.DestroyEffectMaterial3D(HaloMaterial)
        Call Graphics3D.DestroyEffectMaterial3D(GlowMaterial)
        Call Graphics3D.DestroyEffectMaterial3D(CoreMaterial)
        Call Graphics3D.DestroyEffectMaterial3D(SparkMaterial)
        Call Graphics3D.DestroyTexture3D(RibbonTexture)
        Call Graphics3D.DestroyTexture3D(SparkTexture)

    End If

    For Index = 0 To MAX_EFFECTS - 1
        Items[Index].Active = False
        Items[Index].Enabled = False
        Items[Index].PointCount = 0
        Items[Index].ChainCount = 0
    End For

    SparkBatch.Handle = 0
    GpuSparks.Handle = 0
    GpuSparks.Capacity = 0
    GpuSparks.EffectiveSimulation = 0
    HaloRibbon.Handle = 0
    GlowRibbon.Handle = 0
    CoreRibbon.Handle = 0
    HaloMaterial.Handle = 0
    GlowMaterial.Handle = 0
    CoreMaterial.Handle = 0
    SparkMaterial.Handle = 0
    RibbonTexture.Handle = 0
    SparkTexture.Handle = 0
    Ready = False
    RendererEpoch = 0
    UpdateRemainder = 0
    ActivePointCount = 0

End Sub

''' A closed edge path, with no branches or particle sparks across the enclosed face.
Public Function SetContourPrecise(Value As LightningEffect,
    Contour As Precision3D.Contour3D, Width As Number, Intensity1000 As Number) As Boolean

    Dim Index As Number
    Dim Existing As Number
    Dim Ok As Boolean

    If Not Current(Value) Then
        ErrorValue = ERROR_INVALID_EFFECT
        Return False
    End If

    If Graphics3D.FrameActive3D() Then
        ErrorValue = ERROR_IN_FLIGHT
        Return False
    End If

    If Contour.PointCount > 8 Or Precision3D.ContourLength(Contour) <= 0.0 Then
        ErrorValue = ERROR_INVALID_POSITION
        Return False
    End If

    Existing = Items[Value.Slot - 1].ChainCount
    Items[Value.Slot - 1].ContourPresentation = 1

    If Existing <> Contour.PointCount - 1 Then
        Items[Value.Slot - 1].ChainCount = 0
        Existing = 0
    End If

    Ok = SetEndpointsPrecise(Value, Contour.Points[0], Contour.Points[1])

    For Index = 2 To Contour.PointCount

        If Existing = 0 Then
            Ok = AddChainTargetPrecise(Value, Contour.Points[Index Mod Contour.PointCount]) And Ok
        Else
            Ok = SetChainTargetPrecise(Value, Index - 2, Contour.Points[Index Mod Contour.PointCount]) And Ok
        End If

    End For

    Ok = SetBranchBudget(Value, 0) And Ok
    Ok = SetSparkIntensity(Value, 0) And Ok
    Ok = SetPathJitter(Value, 0) And Ok
    Ok = SetStyle(Value, Width, Intensity1000) And Ok

    Return Ok

End Function

''' A short arc travels just outside one edge, never shortcuts through the face.
Public Function SetTravellingEdgePrecise(Value As LightningEffect,
    Contour As Precision3D.Contour3D, Elapsed As Number, Intensity1000 As Number) As Boolean

    Dim Edge As Number
    Dim NextEdge As Number
    Dim Start As Precision3D.Vector3
    Dim Finish As Precision3D.Vector3
    Dim Delta As Precision3D.Vector3
    Dim Along As Double
    Dim PointIndex As Number
    Dim Normal As Precision3D.Vector3
    Dim Outward As Precision3D.Vector3
    Dim Offset As Double
    Dim Ok As Boolean

    If Not Current(Value) Then
        ErrorValue = ERROR_INVALID_EFFECT
        Return False
    End If

    If Graphics3D.FrameActive3D() Then
        ErrorValue = ERROR_IN_FLIGHT
        Return False
    End If

    If Elapsed < 0 Or Precision3D.ContourLength(Contour) <= 0.0 Then
        ErrorValue = ERROR_INVALID_POSITION
        Return False
    End If

    Edge = (Elapsed / 260) Mod Contour.PointCount
    NextEdge = (Edge + 1) Mod Contour.PointCount
    Along = ToDouble(Elapsed Mod 260) / 260.0 * 0.75
    Delta.X = Contour.Points[NextEdge].X - Contour.Points[Edge].X
    Delta.Y = Contour.Points[NextEdge].Y - Contour.Points[Edge].Y
    Delta.Z = Contour.Points[NextEdge].Z - Contour.Points[Edge].Z
    Start.X = Contour.Points[Edge].X + Delta.X * Along
    Start.Y = Contour.Points[Edge].Y + Delta.Y * Along
    Start.Z = Contour.Points[Edge].Z + Delta.Z * Along
    Finish.X = Start.X + Delta.X * 0.25
    Finish.Y = Start.Y + Delta.Y * 0.25
    Finish.Z = Start.Z + Delta.Z * 0.25

    ' The contour winding supplies the outward direction, independent of weapon shape.

    For PointIndex = 0 To Contour.PointCount - 1
        Normal = PreciseMath.Add(Normal, PreciseMath.Cross(
            PreciseMath.Subtract(Contour.Points[PointIndex], Contour.Points[0]),
            PreciseMath.Subtract(Contour.Points[(PointIndex + 1) Mod Contour.PointCount], Contour.Points[0])))
    End For

    Ok = PreciseMath.TryNormalize(PreciseMath.Cross(Delta, Normal), Outward)

    If Ok Then

        Offset = Min(3.0, PreciseMath.Distance(Contour.Points[Edge], Contour.Points[NextEdge]) * 0.1)
        Start = PreciseMath.Add(Start, PreciseMath.Scale(Outward, Offset))
        Finish = PreciseMath.Add(Finish, PreciseMath.Scale(Outward, Offset))

    End If

    Items[Value.Slot - 1].ChainCount = 0
    Items[Value.Slot - 1].ContourPresentation = 2
    Ok = SetEndpointsPrecise(Value, Start, Finish)
    Ok = SetBranchBudget(Value, 0) And Ok
    Ok = SetSparkIntensity(Value, 0) And Ok
    Ok = SetPathJitter(Value, 600) And Ok
    Ok = SetStyle(Value, 1, Intensity1000) And Ok

    Return Ok

End Function

End Module
