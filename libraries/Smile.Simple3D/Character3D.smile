''' Positions one character part relative to the actor's current world position.
Public Function SetPartPositionOffset(
    ByRef Value As Actor,
    PartIndex As Number,
    X As Number,
    Y As Number,
    Z As Number
) As Boolean

    Dim Result As Boolean
    Dim Slot As Number

    Slot = ActorSlot(Value)

    If Slot < 0 Then
        Return False
    End If

    If PartIndex < 0 Or PartIndex >= ActorPartCounts[Slot] Then
        Call SetActorFailure(Slot, CHARACTER_ERROR_INVALID_PART, 0)

        Return False
    End If

    If (X < -CHARACTER_MAX_WORLD_POSITION Or
        X > CHARACTER_MAX_WORLD_POSITION Or
        Y < -CHARACTER_MAX_WORLD_POSITION Or
        Y > CHARACTER_MAX_WORLD_POSITION Or
        Z < -CHARACTER_MAX_WORLD_POSITION Or
        Z > CHARACTER_MAX_WORLD_POSITION) Then
        Call SetActorFailure(Slot, CHARACTER_ERROR_INVALID_ARGUMENT, 0)

        Return False
    End If

    Result = Graphics3D.SetObjectPositionChecked3D(
        ActorParts[Slot, PartIndex],
        RoundedThousandths(ActorPositionX1000[Slot]) + X,
        RoundedThousandths(ActorPositionY1000[Slot]) + Y,
        RoundedThousandths(ActorPositionZ1000[Slot]) + Z
    )

    If Result Then
        Call ClearActorError(Slot)
    Else

        Call SetActorFailure(Slot, CHARACTER_ERROR_INVALID_ARGUMENT, Graphics3D.LastError())
    End If

    Return Result

End Function

