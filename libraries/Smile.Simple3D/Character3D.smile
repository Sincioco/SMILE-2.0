Public Function LiveActorCount() As Number

    Dim Slot As Number
    Dim Result As Number

    For Slot = 0 To CHARACTER3D_MAX_ACTORS - 1

        If ActorUsed[Slot] Then
            Result = Result + 1
        End If

    End For

    Return Result

End Function

Public Function MaximumActorCount() As Number

