Private Function BoundsRadiusThousandths(Bounds As Bounds3D) As Number

    Dim HalfX As Number
    Dim HalfY As Number
    Dim HalfZ As Number
    Dim Largest As Number
    Dim NormalX As Number
    Dim NormalY As Number
    Dim NormalZ As Number
    Dim Sum As Number
    Dim Low As Number
    Dim High As Number
    Dim Middle As Number
    Dim Root As Number
    Dim Result As Number

    HalfX = Bounds.Size.X / 2
    HalfY = Bounds.Size.Y / 2
    HalfZ = Bounds.Size.Z / 2
    Largest = Max(HalfX, Max(HalfY, HalfZ))

    If Largest <= 0 Then
        Return 0
    End If

    NormalX = HalfX * 1000 / Largest
    NormalY = HalfY * 1000 / Largest
    NormalZ = HalfZ * 1000 / Largest
    Sum = NormalX * NormalX + NormalY * NormalY + NormalZ * NormalZ
    Low = 0
    High = 2000

    Do

        Middle = (Low + High) / 2

        If Middle * Middle <= Sum Then
            Root = Middle
            Low = Middle + 1
        Else
            High = Middle - 1
        End If

    Loop Until Low > High

    Result = Root * Largest / 1000

    Return Result

End Function

''' Returns the immutable model-space static AABB in thousandths.
Public Function LocalBounds(Value As Actor) As Bounds3D

    Dim Result As Bounds3D
    Dim Slot As Number

    Slot = ActorSlot(Value)

    If Slot < 0 Then
        Return Result
    End If

    Result.Minimum.X = BoundsValueThousandths(Value, Graphics3D.MODEL_BOUNDS_MINIMUM_X)
    Result.Minimum.Y = BoundsValueThousandths(Value, Graphics3D.MODEL_BOUNDS_MINIMUM_Y)
    Result.Minimum.Z = BoundsValueThousandths(Value, Graphics3D.MODEL_BOUNDS_MINIMUM_Z)
    Result.Maximum.X = BoundsValueThousandths(Value, Graphics3D.MODEL_BOUNDS_MAXIMUM_X)
    Result.Maximum.Y = BoundsValueThousandths(Value, Graphics3D.MODEL_BOUNDS_MAXIMUM_Y)
    Result.Maximum.Z = BoundsValueThousandths(Value, Graphics3D.MODEL_BOUNDS_MAXIMUM_Z)
    Result.Center.X = (Result.Minimum.X + Result.Maximum.X) / 2
    Result.Center.Y = (Result.Minimum.Y + Result.Maximum.Y) / 2
    Result.Center.Z = (Result.Minimum.Z + Result.Maximum.Z) / 2
    Result.Size.X = Result.Maximum.X - Result.Minimum.X
    Result.Size.Y = Result.Maximum.Y - Result.Minimum.Y
    Result.Size.Z = Result.Maximum.Z - Result.Minimum.Z
    Result.Radius = BoundsRadiusThousandths(Result)
    Result.Valid = True

    Return Result

End Function

''' Transforms all eight local AABB corners and applies an optional positive world-unit margin.
Public Function WorldBounds(
    Value As Actor,
    Optional AnimationMargin As Number = 0
) As Bounds3D

    Dim Result As Bounds3D
    Dim LocalValue As Bounds3D
    Dim Point As Core.Vector3
    Dim Rotation As Core.Rotation3D
    Dim Slot As Number
    Dim Corner As Number
    Dim Margin1000 As Number

    Slot = ActorSlot(Value)

    If Slot < 0 Then
        Return Result
    End If

    If AnimationMargin < 0 Or AnimationMargin > CHARACTER_MAX_WORLD_POSITION Then
        Call SetActorFailure(Slot, CHARACTER_ERROR_BOUNDS, 0)

        Return Result
    End If

    LocalValue = LocalBounds(Value)

    If Not LocalValue.Valid Then
        Call SetActorFailure(Slot, CHARACTER_ERROR_BOUNDS, Graphics3D.LastError())

        Return Result
    End If

    Rotation.X = RoundedThousandths(ActorRotationX1000[Slot])
    Rotation.Y = RoundedThousandths(ActorRotationY1000[Slot])
    Rotation.Z = RoundedThousandths(ActorRotationZ1000[Slot])

    For Corner = 0 To 7

        If Corner Mod 2 = 0 Then
            Point.X = LocalValue.Minimum.X
        Else
            Point.X = LocalValue.Maximum.X
        End If

        If (Corner / 2) Mod 2 = 0 Then
            Point.Y = LocalValue.Minimum.Y
        Else
            Point.Y = LocalValue.Maximum.Y
        End If

        If (Corner / 4) Mod 2 = 0 Then
            Point.Z = LocalValue.Minimum.Z
        Else
            Point.Z = LocalValue.Maximum.Z
        End If

        Point.X = Point.X * ActorScalePercent[Slot] / 100
        Point.Y = Point.Y * ActorScalePercent[Slot] / 100
        Point.Z = Point.Z * ActorScalePercent[Slot] / 100
        Point = Fixed.Rotate(Point, Rotation)
        Point.X = Point.X + ActorPositionX1000[Slot]
        Point.Y = Point.Y + ActorPositionY1000[Slot]
        Point.Z = Point.Z + ActorPositionZ1000[Slot]

        If Corner = 0 Then

            Result.Minimum = Point
            Result.Maximum = Point

        Else

            Result.Minimum.X = Min(Result.Minimum.X, Point.X)
            Result.Minimum.Y = Min(Result.Minimum.Y, Point.Y)
            Result.Minimum.Z = Min(Result.Minimum.Z, Point.Z)
            Result.Maximum.X = Max(Result.Maximum.X, Point.X)
            Result.Maximum.Y = Max(Result.Maximum.Y, Point.Y)
            Result.Maximum.Z = Max(Result.Maximum.Z, Point.Z)

        End If

    End For

    Margin1000 = AnimationMargin * 1000
    Result.Minimum.X = Result.Minimum.X - Margin1000
    Result.Minimum.Y = Result.Minimum.Y - Margin1000
    Result.Minimum.Z = Result.Minimum.Z - Margin1000
    Result.Maximum.X = Result.Maximum.X + Margin1000
    Result.Maximum.Y = Result.Maximum.Y + Margin1000
    Result.Maximum.Z = Result.Maximum.Z + Margin1000
    Result.Center.X = (Result.Minimum.X + Result.Maximum.X) / 2
    Result.Center.Y = (Result.Minimum.Y + Result.Maximum.Y) / 2
    Result.Center.Z = (Result.Minimum.Z + Result.Maximum.Z) / 2
    Result.Size.X = Result.Maximum.X - Result.Minimum.X
    Result.Size.Y = Result.Maximum.Y - Result.Minimum.Y
    Result.Size.Z = Result.Maximum.Z - Result.Minimum.Z
    Result.Radius = BoundsRadiusThousandths(Result)
    Result.AnimationMargin = Margin1000
    Result.Valid = True

    Call ClearActorError(Slot)

    Return Result

End Function

Public Function WorldBoundsValueThousandths(
    Value As Actor,
    Component As Number,
    Optional AnimationMargin As Number = 0
) As Number

    Dim ReturnValue As Number

    Dim Bounds As Bounds3D

    Bounds = WorldBounds(Value, AnimationMargin)

    If Not Bounds.Valid Then
        Return 0
    End If

    If Component = Graphics3D.MODEL_BOUNDS_MINIMUM_X Then
        ReturnValue = Bounds.Minimum.X

        Return ReturnValue
    Else If Component = Graphics3D.MODEL_BOUNDS_MINIMUM_Y Then
        ReturnValue = Bounds.Minimum.Y

        Return ReturnValue
    Else If Component = Graphics3D.MODEL_BOUNDS_MINIMUM_Z Then
        ReturnValue = Bounds.Minimum.Z

        Return ReturnValue
    Else If Component = Graphics3D.MODEL_BOUNDS_MAXIMUM_X Then
        ReturnValue = Bounds.Maximum.X

        Return ReturnValue
    Else If Component = Graphics3D.MODEL_BOUNDS_MAXIMUM_Y Then
        ReturnValue = Bounds.Maximum.Y

        Return ReturnValue
    Else If Component = Graphics3D.MODEL_BOUNDS_MAXIMUM_Z Then
        ReturnValue = Bounds.Maximum.Z

        Return ReturnValue
    End If

    Return 0

End Function

Public Function WorldHeight(Value As Actor, Optional AnimationMargin As Number = 0) As Number

    Dim Bounds As Bounds3D
    Dim Result As Number

    Bounds = WorldBounds(Value, AnimationMargin)

    If Bounds.Valid Then
        Result = RoundedThousandths(Bounds.Size.Y)
    End If

    Return Result

End Function

Public Function WorldCenter(Value As Actor, Optional AnimationMargin As Number = 0) As Core.Vector3

    Dim Bounds As Bounds3D
    Dim Result As Core.Vector3

    Bounds = WorldBounds(Value, AnimationMargin)

    If Bounds.Valid Then

        Result.X = RoundedThousandths(Bounds.Center.X)
        Result.Y = RoundedThousandths(Bounds.Center.Y)
        Result.Z = RoundedThousandths(Bounds.Center.Z)

    End If

    Return Result

End Function

Public Function WorldRadius(Value As Actor, Optional AnimationMargin As Number = 0) As Number

    Dim Bounds As Bounds3D
    Dim Result As Number

    Bounds = WorldBounds(Value, AnimationMargin)

    If Bounds.Valid Then
        Result = RoundedThousandths(Bounds.Radius)
    End If

    Return Result

End Function

Public Function Height(Value As Actor) As Number

    Dim Minimum As Number
    Dim Maximum As Number
    Dim Result As Number

    Minimum = BoundsValueThousandths(Value, Graphics3D.MODEL_BOUNDS_MINIMUM_Y)
    Maximum = BoundsValueThousandths(Value, Graphics3D.MODEL_BOUNDS_MAXIMUM_Y)
    Result = RoundedThousandths(Maximum - Minimum)

    Return Result

End Function

Public Function LastError() As Number

    Return ErrorValue

End Function

Public Function ActorLastError(Value As Actor) As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    Slot = RawDiagnosticSlot(Value)

    If Slot < 0 Then
        Return CHARACTER_ERROR_INVALID_ACTOR
    End If

    ReturnValue = ActorErrorValues[Slot]

    Return ReturnValue

End Function

Public Function LastRendererError() As Number

    Return RendererErrorValue

End Function

Public Function ActorLastRendererError(Value As Actor) As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    Slot = RawDiagnosticSlot(Value)

    If Slot < 0 Then
        Return 0
    End If

    ReturnValue = ActorRendererErrorValues[Slot]

    Return ReturnValue

End Function

Public Function LastCleanupRendererError() As Number

    Return CleanupRendererErrorValue

End Function

Public Function LastFallback() As Number

    Return FallbackValue

End Function

Public Function ActorFallback(Value As Actor) As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    Slot = RawDiagnosticSlot(Value)

    If Slot < 0 Then
        Return CHARACTER_FALLBACK_NONE
    End If

    ReturnValue = ActorFallbackValues[Slot]

    Return ReturnValue

End Function

Public Function ActorFallbackFlags(Value As Actor) As Number

    Dim Result As Number

    Result = Scene3D.FallbackFlags()

    If ActorFallback(Value) = CHARACTER_FALLBACK_SIMPLE Then
        Result = Result + Scene3D.SCENE_FALLBACK_FLAG_SIMPLE_CHARACTER
    End If

    Return Result

End Function

Public Sub ClearError()

    ErrorValue = CHARACTER_ERROR_NONE
    RendererErrorValue = 0
    FallbackValue = CHARACTER_FALLBACK_NONE
    CleanupRendererErrorValue = 0

End Sub

End Module
