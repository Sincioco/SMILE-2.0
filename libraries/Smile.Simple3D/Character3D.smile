    Dim Result As Number
    Dim Slot As Number

    Slot = ActorSlot(Value)

    If Slot >= 0 Then
        Result = Graphics3D.AnimatorTime3D(ActorAnimators[Slot])
    End If

    Return Result

End Function

''' Seeks the active clip without firing events crossed by the seek.
Public Function SetAnimationTime(ByRef Value As Actor, TimeMilliseconds As Number) As Boolean

    Dim Result As Boolean
    Dim Slot As Number

    Slot = ActorSlot(Value)

    If Slot < 0 Then
        Return False
    End If

    Result = Graphics3D.SetModelAnimatorTime3D(ActorAnimators[Slot], TimeMilliseconds)

    If Result Then
        Call ClearActorError(Slot)
    Else

        Call SetActorFailure(Slot, CHARACTER_ERROR_INVALID_ARGUMENT, Graphics3D.LastError())
    End If

    Return Result

End Function

''' Applies one additive local rotation to a model node after animation sampling.
Public Function SetNodeRotationOffset(
    ByRef Value As Actor,
    NodeIndex As Number,
    XDegrees As Number,
    YDegrees As Number,
    ZDegrees As Number
) As Boolean

    Dim Result As Boolean
    Dim Slot As Number

    Slot = ActorSlot(Value)

    If Slot < 0 Then
        Return False
    End If

    Result = Graphics3D.SetModelNodeRotationOffset3D(
        ActorAnimators[Slot],
        NodeIndex,
        XDegrees,
        YDegrees,
        ZDegrees
    )

    If Result Then
        Call ClearActorError(Slot)
    Else

        Call SetActorFailure(Slot, CHARACTER_ERROR_INVALID_ARGUMENT, Graphics3D.LastError())
    End If

    Return Result

End Function

Public Function CurrentClipNameMatches(Value As Actor, Name As Text) As Boolean

    Dim Slot As Number
    Dim AssetSlot As Number
    Dim ClipIndex As Number
    Dim Result As Boolean

    Slot = ActorSlot(Value)

    If Slot < 0 Then
        Return False
    End If

    AssetSlot = ActorAssetSlot[Slot]
    ClipIndex = Graphics3D.ModelClipIndex3D(AssetModels[AssetSlot], Name)
    Result = ClipIndex >= 0 And Graphics3D.AnimatorClipIndex3D(ActorAnimators[Slot]) = ClipIndex

    Return Result

End Function

Public Function SetRootMotion(ByRef Value As Actor, Mode As Number) As Boolean

    Dim Slot As Number
    Dim LowLevelMode As Number
    Dim Result As Boolean
    Dim Discarded As Core.RootMotionDelta3D
    Dim EmptyDelta As Core.RootMotionDelta3D

    Slot = ActorSlot(Value)

    If Slot < 0 Then
        Return False
    End If

    If Mode <> ROOT_MOTION_IGNORE And Mode <> ROOT_MOTION_APPLY Then
        Call SetActorFailure(Slot, CHARACTER_ERROR_INVALID_ARGUMENT, 0)

        Return False
    End If

    If Mode = ROOT_MOTION_APPLY Then
        LowLevelMode = Graphics3D.ROOT_MOTION_EXTRACT
    Else
        LowLevelMode = Graphics3D.ROOT_MOTION_NONE
    End If

    Result = Graphics3D.SetAnimatorRootMotion3D(ActorAnimators[Slot], LowLevelMode)

    If Result Then

        Discarded = Graphics3D.TakeAnimatorRootDelta3D(ActorAnimators[Slot])
        ActorRootMode[Slot] = Mode
        ActorLastRootDelta[Slot] = EmptyDelta

    Else

        Call SetActorFailure(Slot, CHARACTER_ERROR_TAMPERED_RESOURCE, Graphics3D.LastError())

    End If

    If Result Then
        Call ClearActorError(Slot)
    End If

    Return Result

End Function

Public Function LastRootDelta(Value As Actor) As Core.RootMotionDelta3D

    Dim Result As Core.RootMotionDelta3D
    Dim Slot As Number

    Slot = ActorSlot(Value)

    If Slot >= 0 Then
        Result = ActorLastRootDelta[Slot]
    End If

    Return Result

End Function

