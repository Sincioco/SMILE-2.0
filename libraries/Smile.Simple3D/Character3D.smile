Public Function ActorAssetState(Value As Actor) As Number

    Dim Slot As Number
    Dim AssetSlot As Number

    Slot = ActorSlot(Value)

    If Slot < 0 Then
        Return CHARACTER_ASSET_EMPTY
    End If

    AssetSlot = ActorAssetSlot[Slot]

    If AssetPendingRelease[AssetSlot] Then
        Return CHARACTER_ASSET_PENDING_RELEASE
    End If

    If AssetReferences[AssetSlot] = 0 Then
        Return CHARACTER_ASSET_UNUSED_RELEASABLE
    End If

    Return CHARACTER_ASSET_ACTIVE

End Function

