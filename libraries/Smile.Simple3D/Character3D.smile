''' Rotates yaw toward one world-space point without introducing IK.
Public Function LookAt(ByRef Value As Actor, X As Number, Y As Number, Z As Number) As Boolean

    Dim ReturnValue As Boolean

    Dim Slot As Number
    Dim DeltaX As Number
    Dim DeltaZ As Number
    Dim Angle As Number
    Dim BestAngle As Number
    Dim Score As Number
    Dim BestScore As Number

    Slot = ActorSlot(Value)

    If Slot < 0 Then
        Return False
    End If

    If (X < -CHARACTER_MAX_WORLD_POSITION Or
        X > CHARACTER_MAX_WORLD_POSITION Or
        Y < -CHARACTER_MAX_WORLD_POSITION Or
        Y > CHARACTER_MAX_WORLD_POSITION Or
        Z < -CHARACTER_MAX_WORLD_POSITION Or
        Z > CHARACTER_MAX_WORLD_POSITION) Then
        Call SetActorFailure(Slot, CHARACTER_ERROR_INVALID_ARGUMENT, 0)

        Return False
    End If

    DeltaX = X - RoundedThousandths(ActorPositionX1000[Slot])
    DeltaZ = Z - RoundedThousandths(ActorPositionZ1000[Slot])

    If DeltaX = 0 And DeltaZ = 0 Then
        Call SetActorFailure(Slot, CHARACTER_ERROR_INVALID_ARGUMENT, 0)

        Return False
    End If

    BestScore = -2147483647

    For Angle = 0 To 359

        Score = DeltaX * Fixed.SinFixed(Angle) + DeltaZ * Fixed.CosFixed(Angle)

        If Score > BestScore Then
            BestScore = Score
            BestAngle = Angle
        End If

    End For

    ReturnValue = ApplyTransformTransaction(
        Slot,
        ActorPositionX1000[Slot],
        ActorPositionY1000[Slot],
        ActorPositionZ1000[Slot],
        ActorRotationX1000[Slot],
        Fixed.WrapDegrees(BestAngle) * 1000,
        ActorRotationZ1000[Slot],
        ActorScalePercent[Slot],
        ActorVisible[Slot]
    )

    Return ReturnValue

End Function

Public Function PlayAnimation(ByRef Value As Actor, ClipName As Text, Looping As Boolean) As Boolean

    Dim Mode As Number
    Dim Result As Boolean

    If Looping Then
        Mode = Graphics3D.ANIMATION_LOOP
    Else
        Mode = Graphics3D.ANIMATION_ONCE
    End If

    Result = PlayMode(Value, ClipName, Mode, 100)

    Return Result

End Function

Public Function PlayMode(
    ByRef Value As Actor,
    ClipName As Text,
    Mode As Number,
    Optional SpeedPercent As Number = 100
) As Boolean

    Dim Slot As Number
    Dim AssetSlot As Number
    Dim Result As Boolean

    Slot = ActorSlot(Value)

    If Slot < 0 Then
        Return False
    End If

    AssetSlot = ActorAssetSlot[Slot]

    If Graphics3D.ModelClipIndex3D(AssetModels[AssetSlot], ClipName) < 0 Then
        Call SetActorFailure(Slot, CHARACTER_ERROR_CLIP_NOT_FOUND, Graphics3D.LastError())

        Return False
    End If

    Result = Graphics3D.PlayModelAnimatorNamed3D(ActorAnimators[Slot], ClipName, Mode, SpeedPercent)

    If Not Result Then
        Call SetActorFailure(Slot, CHARACTER_ERROR_CLIP_NOT_FOUND, Graphics3D.LastError())
    Else

        Call ClearActorError(Slot)
    End If

    Return Result

End Function

