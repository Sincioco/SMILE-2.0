    Dim Slot As Number
    Dim AssetSlot As Number
    Dim Result As Boolean

    Slot = ActorSlot(Value)

    If Slot >= 0 Then
        AssetSlot = ActorAssetSlot[Slot]
        Result = Graphics3D.ModelClipIndex3D(AssetModels[AssetSlot], Name) >= 0
    End If

    Return Result

End Function

Public Function SocketPosition(
    Value As Actor,
    Name As Text,
    Optional ReferencePartIndex As Number = 0
) As Core.Vector3

    Dim Result As Core.Vector3
    Dim Slot As Number
    Dim AssetSlot As Number
    Dim SocketIndex As Number

    Slot = ActorSlot(Value)

    If Slot < 0 Then
        Return Result
    End If

    If ReferencePartIndex < 0 Or ReferencePartIndex >= ActorPartCounts[Slot] Then
        Call SetActorFailure(Slot, CHARACTER_ERROR_INVALID_PART, 0)

        Return Result
    End If

    AssetSlot = ActorAssetSlot[Slot]
    SocketIndex = Graphics3D.ModelSocketIndex3D(AssetModels[AssetSlot], Name)

    If SocketIndex < 0 Then
        Call SetActorFailure(Slot, CHARACTER_ERROR_SOCKET_NOT_FOUND, Graphics3D.LastError())

        Return Result
    End If

    Result.X = RoundedThousandths(Graphics3D.AnimatorSocketWorldValue3D(
        ActorAnimators[Slot],
        ActorParts[Slot, ReferencePartIndex],
        SocketIndex,
        Graphics3D.ANIMATOR_SOCKET_POSITION_X
    ))
    Result.Y = RoundedThousandths(Graphics3D.AnimatorSocketWorldValue3D(
        ActorAnimators[Slot],
        ActorParts[Slot, ReferencePartIndex],
        SocketIndex,
        Graphics3D.ANIMATOR_SOCKET_POSITION_Y
    ))
    Result.Z = RoundedThousandths(Graphics3D.AnimatorSocketWorldValue3D(
        ActorAnimators[Slot],
        ActorParts[Slot, ReferencePartIndex],
        SocketIndex,
        Graphics3D.ANIMATOR_SOCKET_POSITION_Z
    ))

    Return Result

End Function

Public Function SocketValueThousandths(
    Value As Actor,
    Name As Text,
    Property As Number,
    Optional ReferencePartIndex As Number = 0
) As Number

    Dim Slot As Number
    Dim AssetSlot As Number
    Dim SocketIndex As Number
    Dim Result As Number

    Slot = ActorSlot(Value)

    If Slot < 0 Then
        Return 0
    End If

    If ReferencePartIndex < 0 Or ReferencePartIndex >= ActorPartCounts[Slot] Then
        Call SetActorFailure(Slot, CHARACTER_ERROR_INVALID_PART, 0)

        Return 0
    End If

    AssetSlot = ActorAssetSlot[Slot]
    SocketIndex = Graphics3D.ModelSocketIndex3D(AssetModels[AssetSlot], Name)

    If SocketIndex < 0 Then
        Call SetActorFailure(Slot, CHARACTER_ERROR_SOCKET_NOT_FOUND, Graphics3D.LastError())

        Return 0
    End If

    Result = Graphics3D.AnimatorSocketWorldValue3D(
        ActorAnimators[Slot],
        ActorParts[Slot, ReferencePartIndex],
        SocketIndex,
        Property
    )

    Return Result

End Function

''' Draws every actor part in deterministic model-part order.
Public Function Draw(Value As Actor) As Boolean

    Dim Slot As Number
    Dim PartIndex As Number
    Dim DrawRendererError As Number
    Dim SubmissionToken As Number
    Dim Result As Boolean

    Slot = ActorSlot(Value)

    If Slot < 0 Then
        Return False
    End If

    SubmissionToken = Graphics3D.BeginSubmissionGroup3D(ActorPartCounts[Slot])

    If SubmissionToken = 0 Then
        Call SetActorFailure(Slot, CHARACTER_ERROR_DRAW_SUBMISSION, Graphics3D.LastError())

        Return False
    End If

    For PartIndex = 0 To ActorPartCounts[Slot] - 1

        If Not Graphics3D.DrawObject3D(ActorParts[Slot, PartIndex]) Then

            DrawRendererError = Graphics3D.LastError()
            Result = Graphics3D.RollbackSubmissionGroup3D(SubmissionToken)

            Call SetActorFailure(Slot, CHARACTER_ERROR_DRAW_SUBMISSION, DrawRendererError)

            Return False

        End If

    End For

    Result = Graphics3D.CommitSubmissionGroup3D(SubmissionToken)

    If Result Then
        Call ClearActorError(Slot)
    Else

        Call SetActorFailure(Slot, CHARACTER_ERROR_DRAW_SUBMISSION, Graphics3D.LastError())
    End If

    Return Result

End Function

