    ByRef Value As Actor,
    ClipName As Text,
    FadeMilliseconds As Number,
    Optional Mode As Number = Graphics3D.ANIMATION_ONCE
) As Boolean

    Dim Slot As Number
    Dim AssetSlot As Number
    Dim Result As Boolean

    Slot = ActorSlot(Value)

    If Slot < 0 Then
        Return False
    End If

    AssetSlot = ActorAssetSlot[Slot]

    If Graphics3D.ModelClipIndex3D(AssetModels[AssetSlot], ClipName) < 0 Then
        Call SetActorFailure(Slot, CHARACTER_ERROR_CLIP_NOT_FOUND, Graphics3D.LastError())

        Return False
    End If

    Result = Graphics3D.CrossFadeModelAnimatorNamed3D(
        ActorAnimators[Slot],
        ClipName,
        FadeMilliseconds,
        Mode
    )

    If Not Result Then
        Call SetActorFailure(Slot, CHARACTER_ERROR_CLIP_NOT_FOUND, Graphics3D.LastError())
    Else

        Call ClearActorError(Slot)
    End If

    Return Result

End Function

Public Function StopAnimation(ByRef Value As Actor) As Boolean

    Dim Slot As Number
    Dim Result As Boolean

    Slot = ActorSlot(Value)

    If Slot < 0 Then
        Return False
    End If

    Result = Graphics3D.StopAnimator3D(ActorAnimators[Slot])

    If Not Result Then
        Call SetActorFailure(Slot, CHARACTER_ERROR_TAMPERED_RESOURCE, Graphics3D.LastError())
    Else

        Call ClearActorError(Slot)
    End If

    Return Result

End Function

''' Advances one actor and atomically consumes at most one combined root-motion delta.
Public Function Update(ByRef Value As Actor, ElapsedMilliseconds As Number) As Boolean

    Dim Slot As Number
    Dim Result As Boolean
    Dim Delta As Core.RootMotionDelta3D
    Dim Sine As Number
    Dim Cosine As Number
    Dim WorldX As Number
    Dim WorldZ As Number
    Dim CandidateX As Number
    Dim CandidateY As Number
    Dim CandidateZ As Number
    Dim CandidateYaw As Number
    Dim YawDegrees As Number

    Slot = ActorSlot(Value)

    If Slot < 0 Then
        Return False
    End If

    If ElapsedMilliseconds < 0 Or ElapsedMilliseconds > 2147483647 Then
        Call SetActorFailure(Slot, CHARACTER_ERROR_INVALID_ARGUMENT, 0)

        Return False
    End If

    Result = Graphics3D.UpdateAnimator3D(ActorAnimators[Slot], ElapsedMilliseconds)

    If Not Result Then
        Call SetActorFailure(
            Slot,
            CHARACTER_ERROR_TAMPERED_RESOURCE,
            Graphics3D.LastError()
        )

        Return False
    End If

    If ActorRootMode[Slot] = ROOT_MOTION_APPLY Then

        Delta = Graphics3D.TakeAnimatorRootDelta3D(ActorAnimators[Slot])
        ActorLastRootDelta[Slot] = Delta
        YawDegrees = RoundedThousandths(ActorRotationY1000[Slot])
        Sine = Fixed.SinFixed(YawDegrees)
        Cosine = Fixed.CosFixed(YawDegrees)
        WorldX = (Delta.X * Cosine + Delta.Z * Sine) / Core.FIXED_ONE
        WorldZ = (-Delta.X * Sine + Delta.Z * Cosine) / Core.FIXED_ONE
        CandidateX = ActorPositionX1000[Slot] + WorldX
        CandidateY = ActorPositionY1000[Slot] + Delta.Y
        CandidateZ = ActorPositionZ1000[Slot] + WorldZ
        CandidateYaw = (ActorRotationY1000[Slot] + Delta.Yaw) Mod 360000

        If CandidateYaw < 0 Then
            CandidateYaw = CandidateYaw + 360000
        End If

        If (CandidateX < -CHARACTER_MAX_WORLD_POSITION * 1000 Or
            CandidateX > CHARACTER_MAX_WORLD_POSITION * 1000 Or
            CandidateY < -CHARACTER_MAX_WORLD_POSITION * 1000 Or
            CandidateY > CHARACTER_MAX_WORLD_POSITION * 1000 Or
            CandidateZ < -CHARACTER_MAX_WORLD_POSITION * 1000 Or
            CandidateZ > CHARACTER_MAX_WORLD_POSITION * 1000) Then
            Call SetActorFailure(Slot, CHARACTER_ERROR_INVALID_ARGUMENT, 0)

            Return False
        End If

        Result = ApplyTransformTransaction(
            Slot,
            CandidateX,
            CandidateY,
            CandidateZ,
            ActorRotationX1000[Slot],
            CandidateYaw,
            ActorRotationZ1000[Slot],
            ActorScalePercent[Slot],
            ActorVisible[Slot]
        )

    Else

        Call ClearActorError(Slot)

    End If

    Return Result

End Function

Public Function IsPlaying(Value As Actor, ClipName As Text) As Boolean

    Dim Slot As Number
    Dim Result As Boolean

    Slot = ActorSlot(Value)

    If Slot < 0 Then
        Return False
    End If

    Result = CurrentClipNameMatches(Value, ClipName) And Not Graphics3D.AnimatorComplete3D(ActorAnimators[Slot])

    Return Result

End Function

