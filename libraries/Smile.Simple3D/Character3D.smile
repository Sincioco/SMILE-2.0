    Dim Slot As Number

    Slot = ActorSlot(Value)

    If Slot < 0 Then
        Return 0
    End If

    ReturnValue = Graphics3D.ModelBoundsValue3D(AssetModels[ActorAssetSlot[Slot]], -1, Component)

    Return ReturnValue

End Function

Public Function Height(Value As Actor) As Number

    Dim Minimum As Number
    Dim Maximum As Number
    Dim Result As Number

    Minimum = BoundsValueThousandths(Value, Graphics3D.MODEL_BOUNDS_MINIMUM_Y)
    Maximum = BoundsValueThousandths(Value, Graphics3D.MODEL_BOUNDS_MAXIMUM_Y)
    Result = RoundedThousandths(Maximum - Minimum)

    Return Result

End Function

Public Function LastError() As Number

    Return ErrorValue

End Function

Public Function LastRendererError() As Number

    Return RendererErrorValue

End Function

Public Function LastFallback() As Number

    Return FallbackValue

End Function

Public Sub ClearError()

    ErrorValue = CHARACTER_ERROR_NONE
    RendererErrorValue = 0
    FallbackValue = CHARACTER_FALLBACK_NONE

End Sub

