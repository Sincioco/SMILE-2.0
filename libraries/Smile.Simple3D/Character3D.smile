''' Bounded beginner-facing animated-character ownership over Graphics3D.
Module Smile.Simple3D.Character3D

Option Explicit

Import Smile.Simple3D.Core As Core
Import Smile.Simple3D.FixedMath As Fixed
Import Smile.Simple3D.Graphics3D As Graphics3D
Import Smile.Simple3D.Scene3D As Scene3D

Public Const CHARACTER3D_MAX_ASSETS = 16
Public Const CHARACTER3D_MAX_ACTORS = 32
Public Const CHARACTER3D_MAX_PARTS = 16

Public Const CHARACTER_LOAD_AUTO = 0
Public Const CHARACTER_LOAD_REQUIRE_PBR = 1
Public Const CHARACTER_LOAD_ALLOW_SIMPLE_FALLBACK = 2

Public Const ROOT_MOTION_IGNORE = 0
Public Const ROOT_MOTION_APPLY = 1

Public Const CHARACTER_FALLBACK_NONE = 0
Public Const CHARACTER_FALLBACK_SIMPLE = 1

Public Const CHARACTER_VARIANT_NONE = 0
Public Const CHARACTER_VARIANT_PBR = 1
Public Const CHARACTER_VARIANT_SIMPLE = 2

Public Const CHARACTER_ASSET_EMPTY = 0
Public Const CHARACTER_ASSET_ACTIVE = 1
Public Const CHARACTER_ASSET_UNUSED_RELEASABLE = 2
Public Const CHARACTER_ASSET_PENDING_RELEASE = 3

Public Const CHARACTER_MAX_WORLD_POSITION = 1000000
Public Const CHARACTER_MAX_ROTATION_INPUT = 1000000
Public Const CHARACTER_MAX_SCALE_PERCENT = 25000

Public Const CHARACTER_ERROR_NONE = 0
Public Const CHARACTER_ERROR_INVALID_ACTOR = 1
Public Const CHARACTER_ERROR_CAPACITY = 2
Public Const CHARACTER_ERROR_MODEL_LOAD = 3
Public Const CHARACTER_ERROR_PBR_PREPARATION = 4
Public Const CHARACTER_ERROR_ANIMATION_UNAVAILABLE = 5
Public Const CHARACTER_ERROR_ANIMATOR_CREATE = 6
Public Const CHARACTER_ERROR_PART_CREATE = 7
Public Const CHARACTER_ERROR_CLIP_NOT_FOUND = 8
Public Const CHARACTER_ERROR_SOCKET_NOT_FOUND = 9
Public Const CHARACTER_ERROR_RENDERER_RESET = 10
Public Const CHARACTER_ERROR_INVALID_ARGUMENT = 11
Public Const CHARACTER_ERROR_TAMPERED_RESOURCE = 12
Public Const CHARACTER_ERROR_PARTIAL_TRANSFORM = 13
Public Const CHARACTER_ERROR_PENDING_RELEASE = 14
Public Const CHARACTER_ERROR_INVALID_PART = 15
Public Const CHARACTER_ERROR_BOUNDS = 16
Public Const CHARACTER_ERROR_PARTIAL_SHADOW = 17
Public Const CHARACTER_ERROR_DRAW_SUBMISSION = 18

Private Const HANDLE_FACTOR = 100
Private Const MAX_GENERATION = 90000000

''' A generation-safe character identity. All ownership remains inside Character3D.
Public Type Actor
    Handle As Number
End Type

''' Static local/world AABB values use thousandths for deterministic subunit precision.
Public Type Bounds3D
    Minimum As Core.Vector3
    Maximum As Core.Vector3
    Center As Core.Vector3
    Size As Core.Vector3
    Radius As Number
    AnimationMargin As Number
    Valid As Boolean
End Type

Private Dim ActorUsed[32] As Boolean
Private Dim ActorGeneration[32] As Number
Private Dim ActorAssetSlot[32] As Number
Private Dim ActorPartCounts[32] As Number
Private Dim ActorParts[32, 16] As Core.Object3D
Private Dim ActorAnimators[32] As Core.Animator3D
Private Dim ActorPositionX1000[32] As Number
Private Dim ActorPositionY1000[32] As Number
Private Dim ActorPositionZ1000[32] As Number
Private Dim ActorRotationX1000[32] As Number
Private Dim ActorRotationY1000[32] As Number
Private Dim ActorRotationZ1000[32] As Number
Private Dim ActorScalePercent[32] As Number
Private Dim ActorVisible[32] As Boolean
Private Dim ActorCastsShadow[32] As Boolean
Private Dim ActorReceivesShadow[32] As Boolean
Private Dim ActorRootMode[32] As Number
Private Dim ActorLastRootDelta[32] As Core.RootMotionDelta3D
Private Dim ActorErrorValues[32] As Number
Private Dim ActorRendererErrorValues[32] As Number
Private Dim ActorFallbackValues[32] As Number

Private Dim AssetUsed[16] As Boolean
Private Dim AssetPaths[16] As Text
Private Dim AssetProfileKeys[16] As Number
Private Dim AssetVariants[16] As Number
Private Dim AssetReferences[16] As Number
Private Dim AssetModels[16] As Core.Model3D
Private Dim AssetFallbackMaterials[16] As Core.Material3D
Private Dim AssetUsesPbr[16] As Boolean
Private Dim AssetUsesFallback[16] As Boolean
Private Dim AssetPendingRelease[16] As Boolean

Private Dim ErrorValue As Number
Private Dim RendererErrorValue As Number
Private Dim FallbackValue As Number
Private Dim CleanupRendererErrorValue As Number
Private Dim RendererEpoch As Number

Private Function RoundedThousandths(Value As Number) As Number

    Dim Result As Number

    If Value >= 0 Then
        Result = (Value + 500) / 1000
    Else
        Result = (Value - 500) / 1000
    End If

    Return Result

End Function

Private Function RawActorSlot(Value As Actor) As Number

    Dim ReturnValue As Number

    Dim Result As Number
    Dim Slot As Number
    Dim Generation As Number

    If Value.Handle <= 0 Then
        ReturnValue = -1

        Return ReturnValue
    End If

    Slot = (Value.Handle Mod HANDLE_FACTOR) - 1
    Generation = Value.Handle / HANDLE_FACTOR

    If (Slot < 0 Or
        Slot >= CHARACTER3D_MAX_ACTORS Or
        Not ActorUsed[Slot] Or
        ActorGeneration[Slot] <> Generation) Then
        Result = -1
    Else
        Result = Slot
    End If

    Return Result

End Function

Private Function RawDiagnosticSlot(Value As Actor) As Number

    Dim ReturnValue As Number

    Dim Result As Number
    Dim Slot As Number
    Dim Generation As Number

    If Value.Handle <= 0 Then
        ReturnValue = -1

        Return ReturnValue
    End If

    Slot = (Value.Handle Mod HANDLE_FACTOR) - 1
    Generation = Value.Handle / HANDLE_FACTOR

    If (Slot < 0 Or
        Slot >= CHARACTER3D_MAX_ACTORS Or
        ActorGeneration[Slot] <> Generation) Then
        Result = -1
    Else
        Result = Slot
    End If

    Return Result

End Function

Private Sub SetActorFailure(Slot As Number, ErrorCode As Number, RendererError As Number)

    ErrorValue = ErrorCode
    RendererErrorValue = RendererError

    If Slot >= 0 And Slot < CHARACTER3D_MAX_ACTORS Then
        ActorErrorValues[Slot] = ErrorCode
        ActorRendererErrorValues[Slot] = RendererError
    End If

End Sub

Private Sub ClearActorError(Slot As Number)

    ErrorValue = CHARACTER_ERROR_NONE
    RendererErrorValue = 0

    If Slot >= 0 And Slot < CHARACTER3D_MAX_ACTORS Then
        ActorErrorValues[Slot] = CHARACTER_ERROR_NONE
        ActorRendererErrorValues[Slot] = 0
    End If

End Sub

Private Sub RecordCleanupFailure(RendererError As Number)

    If CleanupRendererErrorValue = 0 Then
        CleanupRendererErrorValue = RendererError
    End If

End Sub

Private Function RendererResourcesValid(Slot As Number) As Boolean

    Dim AssetSlot As Number
    Dim PartIndex As Number

    AssetSlot = ActorAssetSlot[Slot]

    If (AssetSlot < 0 Or
        AssetSlot >= CHARACTER3D_MAX_ASSETS Or
        Not AssetUsed[AssetSlot] Or
        Not Graphics3D.ModelHandleValid3D(AssetModels[AssetSlot].Handle) Or
        Not Graphics3D.AnimatorHandleValid3D(ActorAnimators[Slot].Handle)) Then
        Return False
    End If

    For PartIndex = 0 To ActorPartCounts[Slot] - 1

        If Not Graphics3D.ObjectHandleValid3D(ActorParts[Slot, PartIndex].Handle) Then
            Return False
        End If

    End For

    Return True

End Function

Private Sub ClearActorStorage(Slot As Number)

    Dim EmptyObject As Core.Object3D
    Dim EmptyAnimator As Core.Animator3D
    Dim EmptyDelta As Core.RootMotionDelta3D
    Dim PartIndex As Number

    For PartIndex = 0 To CHARACTER3D_MAX_PARTS - 1
        ActorParts[Slot, PartIndex] = EmptyObject
    End For

    ActorUsed[Slot] = False
    ActorAssetSlot[Slot] = -1
    ActorPartCounts[Slot] = 0
    ActorAnimators[Slot] = EmptyAnimator
    ActorPositionX1000[Slot] = 0
    ActorPositionY1000[Slot] = 0
    ActorPositionZ1000[Slot] = 0
    ActorRotationX1000[Slot] = 0
    ActorRotationY1000[Slot] = 0
    ActorRotationZ1000[Slot] = 0
    ActorScalePercent[Slot] = 0
    ActorVisible[Slot] = False
    ActorCastsShadow[Slot] = False
    ActorReceivesShadow[Slot] = False
    ActorRootMode[Slot] = ROOT_MOTION_IGNORE
    ActorLastRootDelta[Slot] = EmptyDelta

End Sub

Private Sub ClearAssetStorage(Slot As Number)

    Dim EmptyModel As Core.Model3D
    Dim EmptyMaterial As Core.Material3D

    AssetUsed[Slot] = False
    AssetPaths[Slot] = ""
    AssetProfileKeys[Slot] = 0
    AssetVariants[Slot] = CHARACTER_VARIANT_NONE
    AssetReferences[Slot] = 0
    AssetModels[Slot] = EmptyModel
    AssetFallbackMaterials[Slot] = EmptyMaterial
    AssetUsesPbr[Slot] = False
    AssetUsesFallback[Slot] = False
    AssetPendingRelease[Slot] = False

End Sub

Private Sub InvalidateAfterRendererReset()

    Dim Slot As Number

    For Slot = 0 To CHARACTER3D_MAX_ACTORS - 1
        Call ClearActorStorage(Slot)
    End For

    For Slot = 0 To CHARACTER3D_MAX_ASSETS - 1
        Call ClearAssetStorage(Slot)
    End For

    ErrorValue = CHARACTER_ERROR_RENDERER_RESET
    RendererErrorValue = Graphics3D.LastError()
    FallbackValue = CHARACTER_FALLBACK_NONE
    RendererEpoch = Graphics3D.ResourceEpoch3D()

End Sub

Private Function SynchronizeRendererEpoch() As Boolean

    Dim CurrentEpoch As Number

    CurrentEpoch = Graphics3D.ResourceEpoch3D()

    If RendererEpoch = 0 Then
        RendererEpoch = CurrentEpoch

        Return True
    End If

    If CurrentEpoch <> RendererEpoch Then
        Call InvalidateAfterRendererReset()

        Return False
    End If

    Return True

End Function

Private Function ActorSlot(Value As Actor) As Number

    Dim ReturnValue As Number

    Dim Slot As Number
    Dim AssetSlot As Number
    Dim PartIndex As Number
    Dim PrimaryRendererError As Number

    Slot = RawActorSlot(Value)

    If Slot < 0 Then

        ErrorValue = CHARACTER_ERROR_INVALID_ACTOR
        ReturnValue = -1

        Return ReturnValue

    End If

    If Not SynchronizeRendererEpoch() Then
        ReturnValue = -1

        Return ReturnValue
    End If

    AssetSlot = ActorAssetSlot[Slot]

    If (AssetSlot < 0 Or
        AssetSlot >= CHARACTER3D_MAX_ASSETS Or
        Not AssetUsed[AssetSlot]) Then

        Call SetActorFailure(Slot, CHARACTER_ERROR_TAMPERED_RESOURCE, Graphics3D.LastError())

        ReturnValue = -1

        Return ReturnValue

    End If

    If Not Graphics3D.ModelHandleValid3D(AssetModels[AssetSlot].Handle) Then

        PrimaryRendererError = Graphics3D.LastError()

        Call QuarantineAsset(AssetSlot, PrimaryRendererError)

        ReturnValue = -1

        Return ReturnValue

    End If

    If Not Graphics3D.AnimatorHandleValid3D(ActorAnimators[Slot].Handle) Then

        PrimaryRendererError = Graphics3D.LastError()

        Call QuarantineActor(Slot, CHARACTER_ERROR_TAMPERED_RESOURCE, PrimaryRendererError, True)

        ReturnValue = -1

        Return ReturnValue

    End If

    For PartIndex = 0 To ActorPartCounts[Slot] - 1

        If Not Graphics3D.ObjectHandleValid3D(ActorParts[Slot, PartIndex].Handle) Then

            PrimaryRendererError = Graphics3D.LastError()

            Call QuarantineActor(Slot, CHARACTER_ERROR_INVALID_PART, PrimaryRendererError, True)

            ReturnValue = -1

            Return ReturnValue

        End If

    End For

    If Not RendererResourcesValid(Slot) Then

        PrimaryRendererError = Graphics3D.LastError()

        Call QuarantineActor(Slot, CHARACTER_ERROR_TAMPERED_RESOURCE, PrimaryRendererError, True)

        ReturnValue = -1

        Return ReturnValue

    End If

    Return Slot

End Function

Private Function FindFreeActorSlot() As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    For Slot = 0 To CHARACTER3D_MAX_ACTORS - 1

        If Not ActorUsed[Slot] Then
            Return Slot
        End If

    End For

    ReturnValue = -1

    Return ReturnValue

End Function

Private Function FindFreeAssetSlot() As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    For Slot = 0 To CHARACTER3D_MAX_ASSETS - 1

        If Not AssetUsed[Slot] Then
            Return Slot
        End If

    End For

    ReturnValue = -1

    Return ReturnValue

End Function

Private Sub QuarantineActor(
    Slot As Number,
    ErrorCode As Number,
    PrimaryRendererError As Number,
    ReleaseUnusedAsset As Boolean
)

    Dim AssetSlot As Number
    Dim PartIndex As Number
    Dim Destroyed As Boolean

    AssetSlot = ActorAssetSlot[Slot]

    For PartIndex = 0 To ActorPartCounts[Slot] - 1

        If Graphics3D.ObjectHandleValid3D(ActorParts[Slot, PartIndex].Handle) Then

            Destroyed = Graphics3D.TryDestroyObjectInstance3D(ActorParts[Slot, PartIndex])

            If Not Destroyed Then
                Call RecordCleanupFailure(Graphics3D.LastError())
            End If

        End If

    End For

    If Graphics3D.AnimatorHandleValid3D(ActorAnimators[Slot].Handle) Then

        Destroyed = Graphics3D.TryDestroyAnimator3D(ActorAnimators[Slot])

        If Not Destroyed Then
            Call RecordCleanupFailure(Graphics3D.LastError())
        End If

    End If

    Call ClearActorStorage(Slot)

    If (AssetSlot >= 0 And
        AssetSlot < CHARACTER3D_MAX_ASSETS And
        AssetUsed[AssetSlot]) Then

        AssetReferences[AssetSlot] = Max(0, AssetReferences[AssetSlot] - 1)

        If ReleaseUnusedAsset Then
            Call ReleaseAssetIfUnused(AssetSlot)
        End If

    End If

    Call SetActorFailure(Slot, ErrorCode, PrimaryRendererError)

End Sub

Private Sub QuarantineAsset(Slot As Number, PrimaryRendererError As Number)

    Dim ActorIndex As Number
    Dim Destroyed As Boolean

    For ActorIndex = 0 To CHARACTER3D_MAX_ACTORS - 1

        If ActorUsed[ActorIndex] And ActorAssetSlot[ActorIndex] = Slot Then
            Call QuarantineActor(
                ActorIndex,
                CHARACTER_ERROR_TAMPERED_RESOURCE,
                PrimaryRendererError,
                False
            )
        End If

    End For

    If (AssetFallbackMaterials[Slot].Handle <> 0 And
        Graphics3D.MaterialHandleValid3D(AssetFallbackMaterials[Slot].Handle)) Then

        Destroyed = Graphics3D.TryDestroyMaterial3D(AssetFallbackMaterials[Slot])

        If Not Destroyed Then
            Call RecordCleanupFailure(Graphics3D.LastError())
        End If

    End If

    Call ClearAssetStorage(Slot)

    ErrorValue = CHARACTER_ERROR_TAMPERED_RESOURCE
    RendererErrorValue = PrimaryRendererError
    FallbackValue = CHARACTER_FALLBACK_NONE

End Sub

Private Function FindAsset(Path As Text, ProfileKey As Number, Variant As Number) As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    For Slot = 0 To CHARACTER3D_MAX_ASSETS - 1

        If (AssetUsed[Slot] And
            AssetPaths[Slot] = Path And
            AssetProfileKeys[Slot] = ProfileKey And
            AssetVariants[Slot] = Variant) Then

            If AssetPendingRelease[Slot] Then

                ErrorValue = CHARACTER_ERROR_PENDING_RELEASE
                ReturnValue = -2

                Return ReturnValue

            End If

            If Not Graphics3D.ModelHandleValid3D(AssetModels[Slot].Handle) Then

                Call QuarantineAsset(Slot, Graphics3D.LastError())

                ReturnValue = -1

                Return ReturnValue

            End If

            Return Slot

        End If

    End For

    ReturnValue = -1

    Return ReturnValue

End Function

Private Sub ReleaseAssetIfUnused(Slot As Number)

    Dim Released As Boolean

    If (Slot < 0 Or
        Slot >= CHARACTER3D_MAX_ASSETS Or
        Not AssetUsed[Slot] Or
        AssetReferences[Slot] > 0) Then
        Return
    End If

    AssetPendingRelease[Slot] = False

    If AssetFallbackMaterials[Slot].Handle <> 0 Then

        If Graphics3D.MaterialHandleValid3D(AssetFallbackMaterials[Slot].Handle) Then

            Released = Graphics3D.TryDestroyMaterial3D(AssetFallbackMaterials[Slot])

            If Not Released Then
                AssetPendingRelease[Slot] = True

                Call RecordCleanupFailure(Graphics3D.LastError())
            End If

        Else
            AssetFallbackMaterials[Slot].Handle = 0

        End If

    End If

    If AssetModels[Slot].Handle <> 0 Then

        If Graphics3D.ModelHandleValid3D(AssetModels[Slot].Handle) Then

            Released = Graphics3D.TryDestroyModel3D(AssetModels[Slot])

            If Not Released Then
                AssetPendingRelease[Slot] = True

                Call RecordCleanupFailure(Graphics3D.LastError())
            End If

        Else
            AssetModels[Slot].Handle = 0

        End If

    End If

    If (AssetFallbackMaterials[Slot].Handle = 0 And
        AssetModels[Slot].Handle = 0) Then

        Call ClearAssetStorage(Slot)

    Else

        AssetPendingRelease[Slot] = True
        ErrorValue = CHARACTER_ERROR_PENDING_RELEASE
        RendererErrorValue = CleanupRendererErrorValue

    End If

End Sub

Private Function CreateAsset(
    Path As Text,
    ProfileKey As Number,
    Variant As Number,
    CapabilityError As Number
) As Number

    Dim ReturnValue As Number

    Dim Result As Number
    Dim Slot As Number
    Dim Model As Core.Model3D
    Dim EmptyTexture As Core.Texture3D
    Dim FallbackMaterial As Core.Material3D
    Dim PbrReady As Boolean
    Dim Destroyed As Boolean
    Dim PrimaryRendererError As Number

    Slot = FindFreeAssetSlot()

    If Slot < 0 Then

        ErrorValue = CHARACTER_ERROR_CAPACITY
        ReturnValue = -1

        Return ReturnValue

    End If

    If Graphics3D.LiveModelCount3D() >= Graphics3D.MaximumModelCount3D() Then

        ErrorValue = CHARACTER_ERROR_CAPACITY
        ReturnValue = -1

        Return ReturnValue

    End If

    Model = Graphics3D.LoadModelGeometry3D(Path)

    If Model.Handle = 0 Then

        ErrorValue = CHARACTER_ERROR_MODEL_LOAD
        RendererErrorValue = Graphics3D.LastError()
        ReturnValue = -1

        Return ReturnValue

    End If

    If (Not Model.HasAnimation Or
        Model.BoneCount <= 0 Or
        Model.ClipCount <= 0) Then

        PrimaryRendererError = Graphics3D.LastError()
        Destroyed = Graphics3D.TryDestroyModel3D(Model)

        If Not Destroyed Then
            Call RecordCleanupFailure(Graphics3D.LastError())
        End If

        ErrorValue = CHARACTER_ERROR_ANIMATION_UNAVAILABLE
        RendererErrorValue = PrimaryRendererError

        ReturnValue = -1

        Return ReturnValue

    End If

    If Variant = CHARACTER_VARIANT_PBR Then

        PbrReady = Graphics3D.PrepareModelPbr3D(
            Model,
            Scene3D.TextureFilter(),
            Scene3D.TextureWrap(),
            Scene3D.RequestedAnisotropy()
        )

        If Not PbrReady Then

            PrimaryRendererError = Graphics3D.LastError()
            Destroyed = Graphics3D.TryDestroyModel3D(Model)

            If Not Destroyed Then
                Call RecordCleanupFailure(Graphics3D.LastError())
            End If

            ErrorValue = CHARACTER_ERROR_PBR_PREPARATION
            RendererErrorValue = PrimaryRendererError

            ReturnValue = -1

            Return ReturnValue

        End If

    Else
        FallbackMaterial = Graphics3D.DefaultMaterial3D(EmptyTexture)

        If FallbackMaterial.Handle = 0 Then

            PrimaryRendererError = Graphics3D.LastError()
            Destroyed = Graphics3D.TryDestroyModel3D(Model)

            If Not Destroyed Then
                Call RecordCleanupFailure(Graphics3D.LastError())
            End If

            ErrorValue = CHARACTER_ERROR_PBR_PREPARATION
            RendererErrorValue = PrimaryRendererError

            ReturnValue = -1

            Return ReturnValue

        End If

    End If

    AssetUsed[Slot] = True
    AssetPaths[Slot] = Path
    AssetProfileKeys[Slot] = ProfileKey
    AssetVariants[Slot] = Variant
    AssetReferences[Slot] = 0
    AssetModels[Slot] = Model
    AssetFallbackMaterials[Slot] = FallbackMaterial
    AssetUsesPbr[Slot] = PbrReady
    AssetUsesFallback[Slot] = Not PbrReady
    AssetPendingRelease[Slot] = False

    If AssetUsesFallback[Slot] Then
        FallbackValue = CHARACTER_FALLBACK_SIMPLE
        RendererErrorValue = CapabilityError
    Else
        FallbackValue = CHARACTER_FALLBACK_NONE
        RendererErrorValue = 0
    End If

    Result = Slot

    Return Result

End Function

Private Sub DestroyActorSlot(Slot As Number)

    Dim AssetSlot As Number
    Dim PartIndex As Number
    Dim Destroyed As Boolean

    AssetSlot = ActorAssetSlot[Slot]

    For PartIndex = 0 To ActorPartCounts[Slot] - 1

        If Graphics3D.ObjectHandleValid3D(ActorParts[Slot, PartIndex].Handle) Then

            Destroyed = Graphics3D.TryDestroyObjectInstance3D(ActorParts[Slot, PartIndex])

            If Not Destroyed Then
                Call RecordCleanupFailure(Graphics3D.LastError())
            End If

        End If

    End For

    If Graphics3D.AnimatorHandleValid3D(ActorAnimators[Slot].Handle) Then

        Destroyed = Graphics3D.TryDestroyAnimator3D(ActorAnimators[Slot])

        If Not Destroyed Then
            Call RecordCleanupFailure(Graphics3D.LastError())
        End If

    End If

    Call ClearActorStorage(Slot)

    If (AssetSlot >= 0 And
        AssetSlot < CHARACTER3D_MAX_ASSETS And
        AssetUsed[AssetSlot]) Then
        AssetReferences[AssetSlot] = Max(0, AssetReferences[AssetSlot] - 1)

        Call ReleaseAssetIfUnused(AssetSlot)
    End If

End Sub

Private Function ApplyTransformSnapshot(
    Slot As Number,
    PositionX1000 As Number,
    PositionY1000 As Number,
    PositionZ1000 As Number,
    RotationX1000 As Number,
    RotationY1000 As Number,
    RotationZ1000 As Number,
    ScalePercent As Number,
    Visible As Boolean
) As Boolean

    Dim PartIndex As Number
    Dim X As Number
    Dim Y As Number
    Dim Z As Number
    Dim RotationX As Number
    Dim RotationY As Number
    Dim RotationZ As Number

    X = RoundedThousandths(PositionX1000)
    Y = RoundedThousandths(PositionY1000)
    Z = RoundedThousandths(PositionZ1000)
    RotationX = RoundedThousandths(RotationX1000)
    RotationY = RoundedThousandths(RotationY1000)
    RotationZ = RoundedThousandths(RotationZ1000)

    For PartIndex = 0 To ActorPartCounts[Slot] - 1

        If Not Graphics3D.SetObjectPositionChecked3D(ActorParts[Slot, PartIndex], X, Y, Z) Then
            Return False
        End If

        If Not Graphics3D.SetObjectRotationChecked3D(
            ActorParts[Slot, PartIndex],
            RotationX,
            RotationY,
            RotationZ
        ) Then
            Return False
        End If

        If Not Graphics3D.SetObjectScaleChecked3D(
            ActorParts[Slot, PartIndex],
            ScalePercent,
            ScalePercent,
            ScalePercent
        ) Then
            Return False
        End If

        If Not Graphics3D.SetObjectVisibleChecked3D(ActorParts[Slot, PartIndex], Visible) Then
            Return False
        End If

    End For

    Return True

End Function

Private Function ApplyTransformTransaction(
    Slot As Number,
    PositionX1000 As Number,
    PositionY1000 As Number,
    PositionZ1000 As Number,
    RotationX1000 As Number,
    RotationY1000 As Number,
    RotationZ1000 As Number,
    ScalePercent As Number,
    Visible As Boolean
) As Boolean

    Dim Applied As Boolean
    Dim Restored As Boolean
    Dim PrimaryRendererError As Number

    Applied = ApplyTransformSnapshot(
        Slot,
        PositionX1000,
        PositionY1000,
        PositionZ1000,
        RotationX1000,
        RotationY1000,
        RotationZ1000,
        ScalePercent,
        Visible
    )

    If Not Applied Then

        PrimaryRendererError = Graphics3D.LastError()
        Restored = ApplyTransformSnapshot(
            Slot,
            ActorPositionX1000[Slot],
            ActorPositionY1000[Slot],
            ActorPositionZ1000[Slot],
            ActorRotationX1000[Slot],
            ActorRotationY1000[Slot],
            ActorRotationZ1000[Slot],
            ActorScalePercent[Slot],
            ActorVisible[Slot]
        )

        If Not Restored Then
            Call RecordCleanupFailure(Graphics3D.LastError())
            Call QuarantineActor(
                Slot,
                CHARACTER_ERROR_PARTIAL_TRANSFORM,
                PrimaryRendererError,
                True
            )
        Else

            Call SetActorFailure(Slot, CHARACTER_ERROR_PARTIAL_TRANSFORM, PrimaryRendererError)
        End If

        Return False

    End If

    ActorPositionX1000[Slot] = PositionX1000
    ActorPositionY1000[Slot] = PositionY1000
    ActorPositionZ1000[Slot] = PositionZ1000
    ActorRotationX1000[Slot] = RotationX1000
    ActorRotationY1000[Slot] = RotationY1000
    ActorRotationZ1000[Slot] = RotationZ1000
    ActorScalePercent[Slot] = ScalePercent
    ActorVisible[Slot] = Visible

    Call ClearActorError(Slot)

    Return True

End Function

Private Function ApplyShadowSnapshot(
    Slot As Number,
    CastsShadow As Boolean,
    ReceivesShadow As Boolean
) As Boolean

    Dim PartIndex As Number

    For PartIndex = 0 To ActorPartCounts[Slot] - 1

        If Not Graphics3D.SetObjectShadowsChecked3D(
            ActorParts[Slot, PartIndex],
            CastsShadow,
            ReceivesShadow
        ) Then
            Return False
        End If

    End For

    Return True

End Function

Private Function ApplyShadowTransaction(
    Slot As Number,
    CastsShadow As Boolean,
    ReceivesShadow As Boolean
) As Boolean

    Dim Applied As Boolean
    Dim PrimaryRendererError As Number
    Dim Restored As Boolean

    Applied = ApplyShadowSnapshot(Slot, CastsShadow, ReceivesShadow)

    If Not Applied Then

        PrimaryRendererError = Graphics3D.LastError()
        Restored = ApplyShadowSnapshot(
            Slot,
            ActorCastsShadow[Slot],
            ActorReceivesShadow[Slot]
        )

        If Not Restored Then
            Call RecordCleanupFailure(Graphics3D.LastError())
            Call QuarantineActor(
                Slot,
                CHARACTER_ERROR_PARTIAL_SHADOW,
                PrimaryRendererError,
                True
            )
        Else

            Call SetActorFailure(Slot, CHARACTER_ERROR_PARTIAL_SHADOW, PrimaryRendererError)
        End If

        Return False

    End If

    ActorCastsShadow[Slot] = CastsShadow
    ActorReceivesShadow[Slot] = ReceivesShadow

    Call ClearActorError(Slot)

    Return True

End Function

''' Loads or shares one animated model using the current Scene3D asset profile.
Public Function LoadActor(Path As Text) As Actor

    Dim Result As Actor

    Result = LoadWithPolicy(Path, CHARACTER_LOAD_AUTO)

    Return Result

End Function

''' Loads an animated character with an explicit PBR/fallback policy.
Public Function LoadWithPolicy(Path As Text, Policy As Number) As Actor

    Dim Result As Actor
    Dim Slot As Number
    Dim AssetSlot As Number
    Dim ProfileKey As Number
    Dim PartIndex As Number
    Dim CreatedPartCount As Number
    Dim Model As Core.Model3D
    Dim Animator As Core.Animator3D
    Dim Parts[16] As Core.Object3D
    Dim Prepared As Boolean
    Dim PbrAvailable As Boolean
    Dim FallbackAllowed As Boolean
    Dim Variant As Number
    Dim CapabilityError As Number
    Dim PrimaryRendererError As Number
    Dim Destroyed As Boolean

    Call ClearError()

    If Not SynchronizeRendererEpoch() Then
        Return Result
    End If

    If (Path = "" Or
        Policy < CHARACTER_LOAD_AUTO Or
        Policy > CHARACTER_LOAD_ALLOW_SIMPLE_FALLBACK) Then
        ErrorValue = CHARACTER_ERROR_INVALID_ARGUMENT
        Return Result
    End If

    Slot = FindFreeActorSlot()

    If Slot < 0 Then
        ErrorValue = CHARACTER_ERROR_CAPACITY
        Return Result
    End If

    If Graphics3D.LiveAnimatorCount3D() >= Graphics3D.MaximumAnimatorCount3D() Then
        ErrorValue = CHARACTER_ERROR_CAPACITY
        Return Result
    End If

    Prepared = Scene3D.RefreshCapabilities()
    PbrAvailable = Scene3D.PbrAvailable()
    CapabilityError = Graphics3D.LastError()

    If PbrAvailable Then

        Variant = CHARACTER_VARIANT_PBR

    Else

        FallbackAllowed = Policy = CHARACTER_LOAD_ALLOW_SIMPLE_FALLBACK

        If Policy = CHARACTER_LOAD_AUTO Then
            FallbackAllowed = Scene3D.SimpleFallbackAllowed()
        End If

        If Not FallbackAllowed Then

            ErrorValue = CHARACTER_ERROR_PBR_PREPARATION
            RendererErrorValue = CapabilityError

            Return Result

        End If

        Variant = CHARACTER_VARIANT_SIMPLE

    End If

    ProfileKey = Scene3D.AssetProfileKey()
    AssetSlot = FindAsset(Path, ProfileKey, Variant)

    If AssetSlot = -2 Or ErrorValue = CHARACTER_ERROR_RENDERER_RESET Then
        Return Result
    End If

    If AssetSlot < 0 Then
        AssetSlot = CreateAsset(Path, ProfileKey, Variant, CapabilityError)
    Else If AssetUsesFallback[AssetSlot] Then
        FallbackValue = CHARACTER_FALLBACK_SIMPLE
    End If

    If AssetSlot < 0 Then
        Return Result
    End If

    Model = AssetModels[AssetSlot]

    If (Model.PartCount <= 0 Or
        Model.PartCount > CHARACTER3D_MAX_PARTS Or
        Graphics3D.LiveObjectCount3D() + Model.PartCount > Graphics3D.MaximumObjectCount3D()) Then

        ErrorValue = CHARACTER_ERROR_CAPACITY

        Call ReleaseAssetIfUnused(AssetSlot)

        Return Result

    End If

    Animator = Graphics3D.CreateModelAnimator3D(Model)

    If Animator.Handle = 0 Then

        ErrorValue = CHARACTER_ERROR_ANIMATOR_CREATE
        RendererErrorValue = Graphics3D.LastError()

        Call ReleaseAssetIfUnused(AssetSlot)

        Return Result

    End If

    Prepared = True

    For PartIndex = 0 To Model.PartCount - 1

        Parts[PartIndex] = Graphics3D.CreateModelPart3D(Model, PartIndex)

        If Parts[PartIndex].Handle = 0 Then
            Prepared = False
            Exit For
        End If

        CreatedPartCount = CreatedPartCount + 1

        If AssetUsesFallback[AssetSlot] Then
            Prepared = Graphics3D.SetObjectMaterial3D(Parts[PartIndex], AssetFallbackMaterials[AssetSlot])
        End If

        If Prepared Then
            Prepared = Graphics3D.SetObjectAnimator3D(Parts[PartIndex], Animator)
        End If

        If Not Prepared Then
            Exit For
        End If

    End For

    If Not Prepared Then

        PrimaryRendererError = Graphics3D.LastError()

        For PartIndex = 0 To CreatedPartCount - 1

            Destroyed = Graphics3D.TryDestroyObjectInstance3D(Parts[PartIndex])

            If Not Destroyed Then
                Call RecordCleanupFailure(Graphics3D.LastError())
            End If

        End For

        Destroyed = Graphics3D.TryDestroyAnimator3D(Animator)

        If Not Destroyed Then
            Call RecordCleanupFailure(Graphics3D.LastError())
        End If

        ErrorValue = CHARACTER_ERROR_PART_CREATE
        RendererErrorValue = PrimaryRendererError

        Call ReleaseAssetIfUnused(AssetSlot)

        Return Result

    End If

    ActorGeneration[Slot] = ActorGeneration[Slot] + 1

    If ActorGeneration[Slot] <= 0 Or ActorGeneration[Slot] > MAX_GENERATION Then
        ActorGeneration[Slot] = 1
    End If

    ActorUsed[Slot] = True
    ActorAssetSlot[Slot] = AssetSlot
    ActorPartCounts[Slot] = Model.PartCount
    ActorAnimators[Slot] = Animator
    ActorScalePercent[Slot] = 100
    ActorVisible[Slot] = True
    ActorCastsShadow[Slot] = True
    ActorReceivesShadow[Slot] = True
    ActorRootMode[Slot] = ROOT_MOTION_IGNORE
    ActorErrorValues[Slot] = CHARACTER_ERROR_NONE
    ActorRendererErrorValues[Slot] = 0
    ActorFallbackValues[Slot] = FallbackValue

    For PartIndex = 0 To Model.PartCount - 1
        ActorParts[Slot, PartIndex] = Parts[PartIndex]
    End For

    AssetReferences[AssetSlot] = AssetReferences[AssetSlot] + 1
    Result.Handle = ActorGeneration[Slot] * HANDLE_FACTOR + Slot + 1

    If Graphics3D.ModelClipIndex3D(Model, "Idle") >= 0 Then

        Prepared = Graphics3D.PlayModelAnimatorNamed3D(
            ActorAnimators[Slot],
            "Idle",
            Graphics3D.ANIMATION_LOOP,
            100
        )

        If Not Prepared Then

            PrimaryRendererError = Graphics3D.LastError()

            Call DestroyActorSlot(Slot)

            Result.Handle = 0
            ErrorValue = CHARACTER_ERROR_CLIP_NOT_FOUND
            RendererErrorValue = PrimaryRendererError

            Return Result

        End If

    End If

    ErrorValue = CHARACTER_ERROR_NONE

    Return Result

End Function

''' Releases part objects, animator state, and the last actor-owned cache reference.
Public Sub Destroy(ByRef Value As Actor)

    Dim Slot As Number

    Slot = ActorSlot(Value)

    If Slot < 0 Then
        Value.Handle = 0
        Return
    End If

    Call DestroyActorSlot(Slot)

    Value.Handle = 0

    If ErrorValue <> CHARACTER_ERROR_PENDING_RELEASE Then
        ErrorValue = CHARACTER_ERROR_NONE
        RendererErrorValue = 0
    End If

    FallbackValue = CHARACTER_FALLBACK_NONE

End Sub

''' Deterministically releases every live actor and cache entry. Repeated calls are safe.
Public Sub Shutdown()

    Dim Slot As Number

    If Not SynchronizeRendererEpoch() Then
        Return
    End If

    For Slot = 0 To CHARACTER3D_MAX_ACTORS - 1

        If ActorUsed[Slot] Then
            Call DestroyActorSlot(Slot)
        End If

    End For

    For Slot = 0 To CHARACTER3D_MAX_ASSETS - 1
        Call ReleaseAssetIfUnused(Slot)
    End For

    If PendingReleaseAssetCount() > 0 Then
        ErrorValue = CHARACTER_ERROR_PENDING_RELEASE
        RendererErrorValue = CleanupRendererErrorValue
    Else

        ErrorValue = CHARACTER_ERROR_NONE
        RendererErrorValue = 0
    End If

    FallbackValue = CHARACTER_FALLBACK_NONE

End Sub

Public Function Place(ByRef Value As Actor, X As Number, Y As Number, Z As Number) As Boolean

    Dim ReturnValue As Boolean

    Dim Slot As Number

    Slot = ActorSlot(Value)

    If Slot < 0 Then
        Return False
    End If

    If (X < -CHARACTER_MAX_WORLD_POSITION Or
        X > CHARACTER_MAX_WORLD_POSITION Or
        Y < -CHARACTER_MAX_WORLD_POSITION Or
        Y > CHARACTER_MAX_WORLD_POSITION Or
        Z < -CHARACTER_MAX_WORLD_POSITION Or
        Z > CHARACTER_MAX_WORLD_POSITION) Then
        Call SetActorFailure(Slot, CHARACTER_ERROR_INVALID_ARGUMENT, 0)

        Return False
    End If

    ReturnValue = ApplyTransformTransaction(
        Slot,
        X * 1000,
        Y * 1000,
        Z * 1000,
        ActorRotationX1000[Slot],
        ActorRotationY1000[Slot],
        ActorRotationZ1000[Slot],
        ActorScalePercent[Slot],
        ActorVisible[Slot]
    )

    Return ReturnValue

End Function

Public Function Rotate(ByRef Value As Actor, X As Number, Y As Number, Z As Number) As Boolean

    Dim ReturnValue As Boolean

    Dim Slot As Number

    Slot = ActorSlot(Value)

    If Slot < 0 Then
        Return False
    End If

    If (X < -CHARACTER_MAX_ROTATION_INPUT Or
        X > CHARACTER_MAX_ROTATION_INPUT Or
        Y < -CHARACTER_MAX_ROTATION_INPUT Or
        Y > CHARACTER_MAX_ROTATION_INPUT Or
        Z < -CHARACTER_MAX_ROTATION_INPUT Or
        Z > CHARACTER_MAX_ROTATION_INPUT) Then
        Call SetActorFailure(Slot, CHARACTER_ERROR_INVALID_ARGUMENT, 0)

        Return False
    End If

    ReturnValue = ApplyTransformTransaction(
        Slot,
        ActorPositionX1000[Slot],
        ActorPositionY1000[Slot],
        ActorPositionZ1000[Slot],
        Fixed.WrapDegrees(X) * 1000,
        Fixed.WrapDegrees(Y) * 1000,
        Fixed.WrapDegrees(Z) * 1000,
        ActorScalePercent[Slot],
        ActorVisible[Slot]
    )

    Return ReturnValue

End Function

Public Function SetScale(ByRef Value As Actor, Percent As Number) As Boolean

    Dim ReturnValue As Boolean

    Dim Slot As Number

    Slot = ActorSlot(Value)

    If Slot < 0 Then
        Return False
    End If

    If Percent < 1 Or Percent > CHARACTER_MAX_SCALE_PERCENT Then
        Call SetActorFailure(Slot, CHARACTER_ERROR_INVALID_ARGUMENT, 0)

        Return False
    End If

    ReturnValue = ApplyTransformTransaction(
        Slot,
        ActorPositionX1000[Slot],
        ActorPositionY1000[Slot],
        ActorPositionZ1000[Slot],
        ActorRotationX1000[Slot],
        ActorRotationY1000[Slot],
        ActorRotationZ1000[Slot],
        Percent,
        ActorVisible[Slot]
    )

    Return ReturnValue

End Function

Public Function SetVisible(ByRef Value As Actor, Visible As Boolean) As Boolean

    Dim ReturnValue As Boolean

    Dim Slot As Number

    Slot = ActorSlot(Value)

    If Slot < 0 Then
        Return False
    End If

    ReturnValue = ApplyTransformTransaction(
        Slot,
        ActorPositionX1000[Slot],
        ActorPositionY1000[Slot],
        ActorPositionZ1000[Slot],
        ActorRotationX1000[Slot],
        ActorRotationY1000[Slot],
        ActorRotationZ1000[Slot],
        ActorScalePercent[Slot],
        Visible
    )

