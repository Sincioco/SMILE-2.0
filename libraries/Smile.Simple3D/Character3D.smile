    Slot = ActorSlot(Value)

    If Slot < 0 Then
        Return False
    End If

    AssetSlot = ActorAssetSlot[Slot]

    ReturnValue = Graphics3D.ModelSocketIndex3D(AssetModels[AssetSlot], Name) >= 0

    Return ReturnValue

End Function

