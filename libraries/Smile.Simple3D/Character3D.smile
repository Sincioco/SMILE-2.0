Public Sub ClearEvents(Value As Actor)

    Dim Slot As Number
    Dim Cleared As Boolean

    Slot = ActorSlot(Value)

    If Slot >= 0 Then
        Cleared = Graphics3D.ClearAnimatorEvents3D(ActorAnimators[Slot])
    End If

End Sub

Public Function HasSocket(Value As Actor, Name As Text) As Boolean

    Dim ReturnValue As Boolean

    Dim Slot As Number
    Dim AssetSlot As Number

    Slot = ActorSlot(Value)

    If Slot < 0 Then
        Return False
    End If

    AssetSlot = ActorAssetSlot[Slot]

    ReturnValue = Graphics3D.ModelSocketIndex3D(AssetModels[AssetSlot], Name) >= 0

    Return ReturnValue

End Function

Public Function SocketPosition(Value As Actor, Name As Text) As Core.Vector3

    Dim Result As Core.Vector3
    Dim Slot As Number
    Dim AssetSlot As Number
    Dim SocketIndex As Number

    Slot = ActorSlot(Value)

    If Slot < 0 Then
        Return Result
    End If

    AssetSlot = ActorAssetSlot[Slot]
    SocketIndex = Graphics3D.ModelSocketIndex3D(AssetModels[AssetSlot], Name)

    If SocketIndex < 0 Then
        ErrorValue = CHARACTER_ERROR_SOCKET_NOT_FOUND
        Return Result
    End If

    Result.X = RoundedThousandths(Graphics3D.AnimatorSocketWorldValue3D(
        ActorAnimators[Slot],
        ActorParts[Slot, 0],
        SocketIndex,
        Graphics3D.ANIMATOR_SOCKET_POSITION_X
    ))
    Result.Y = RoundedThousandths(Graphics3D.AnimatorSocketWorldValue3D(
        ActorAnimators[Slot],
        ActorParts[Slot, 0],
        SocketIndex,
        Graphics3D.ANIMATOR_SOCKET_POSITION_Y
    ))
    Result.Z = RoundedThousandths(Graphics3D.AnimatorSocketWorldValue3D(
        ActorAnimators[Slot],
        ActorParts[Slot, 0],
        SocketIndex,
        Graphics3D.ANIMATOR_SOCKET_POSITION_Z
    ))

    Return Result

End Function

Public Function SocketValueThousandths(Value As Actor, Name As Text, Property As Number) As Number

    Dim Slot As Number
    Dim AssetSlot As Number
    Dim SocketIndex As Number
    Dim Result As Number

    Slot = ActorSlot(Value)

    If Slot < 0 Then
        Return 0
    End If

    AssetSlot = ActorAssetSlot[Slot]
    SocketIndex = Graphics3D.ModelSocketIndex3D(AssetModels[AssetSlot], Name)

    If SocketIndex < 0 Then
        ErrorValue = CHARACTER_ERROR_SOCKET_NOT_FOUND
        Return 0
    End If

    Result = Graphics3D.AnimatorSocketWorldValue3D(
        ActorAnimators[Slot],
        ActorParts[Slot, 0],
        SocketIndex,
        Property
    )

    Return Result

End Function

''' Draws every actor part in deterministic model-part order.
Public Function Draw(Value As Actor) As Boolean

    Dim Slot As Number
    Dim PartIndex As Number
    Dim Result As Boolean

    Slot = ActorSlot(Value)

    If Slot < 0 Then
        Return False
    End If

    Result = True

    For PartIndex = 0 To ActorPartCounts[Slot] - 1

        If Not Graphics3D.DrawObject3D(ActorParts[Slot, PartIndex]) Then
            Result = False
        End If

    End For

    If Not Result Then
        RendererErrorValue = Graphics3D.LastError()
    End If

    Return Result

End Function

Public Function IsValid(Value As Actor) As Boolean

    Dim Slot As Number

    Slot = RawActorSlot(Value)

    If Slot < 0 Then
        Return False
    End If

    If Not RendererResourcesValid(Slot) Then
        Call InvalidateAfterRendererReset()

        Return False
    End If

    Return True

End Function

Public Function PartCount(Value As Actor) As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    Slot = ActorSlot(Value)

    If Slot < 0 Then
        Return 0
    End If

    ReturnValue = ActorPartCounts[Slot]

    Return ReturnValue

End Function

Public Function ActorPartCount(Value As Actor) As Number

    Dim Result As Number

    Result = PartCount(Value)

    Return Result

End Function

Public Function PrimaryObjectHandle(Value As Actor) As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    Slot = ActorSlot(Value)

    If Slot < 0 Or ActorPartCounts[Slot] = 0 Then
        Return 0
    End If

    ReturnValue = ActorParts[Slot, 0].Handle

    Return ReturnValue

End Function

