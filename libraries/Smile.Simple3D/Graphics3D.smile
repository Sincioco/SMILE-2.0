Public Const PRIMITIVE_CUBE = 1
Public Const PRIMITIVE_PLANE = 2
Public Const PRIMITIVE_PYRAMID = 3
Public Const PRIMITIVE_SPHERE = 4
Public Const PRIMITIVE_CYLINDER = 5
Public Const PRIMITIVE_TORUS = 6
Public Const TEXTURE_FILTER_NEAREST = 0
Public Const TEXTURE_FILTER_LINEAR = 1
Public Const TEXTURE_WRAP_CLAMP = 0
