''' Reads global or generation-safe per-resource M6 diagnostics.
Public Function VfxValue3D(Query As Number, Optional ResourceHandle As Number = 0) As Number

    Dim Result As Number

    Result = Dispatch(
        COMMAND_M6_VALUE,
        Query,
        ResourceHandle,
        0,
        0,
        0,
        0,
        0,
        0,
        0,
        0
    )

    Return Result

End Function

Public Function LiveParticleBatchCount3D() As Number

    Dim Result As Number

    Result = VfxValue3D(VFX_QUERY_LIVE_PARTICLE_BATCHES)

    Return Result

End Function

Public Function LiveRibbonBatchCount3D() As Number

    Dim Result As Number

    Result = VfxValue3D(VFX_QUERY_LIVE_RIBBON_BATCHES)

    Return Result

