Public Function DefaultCamera() As Core.Camera3D

    Dim Camera As Core.Camera3D

    Camera.Position.Y = 300
    Camera.Position.Z = -800
    Camera.UpDirection.Y = 1
    Camera.FovDegrees = 55
    Camera.NearPlane = 1
    Camera.FarPlane = 10000
    Return Camera

End Function

Private Function CreatePrimitiveObject(
    Kind As Number,
    FirstValue As Number,
    SecondValue As Number,
    Segments As Number,
    Rings As Number
) As Core.Object3D

    Dim Result As Core.Object3D

    Result.MeshHandle = Dispatch(COMMAND_CREATE_PRIMITIVE, Kind, FirstValue, SecondValue, Segments, Rings, 0, 0, 0, 0, 0)

    If Result.MeshHandle = 0 Then
        Return Result
    End If

    Result.Handle = Dispatch(COMMAND_CREATE_OBJECT, Result.MeshHandle, 0, 0, 0, 0, 0, 0, 0, 0, 0)

    If Result.Handle = 0 Then

        Call Execute(COMMAND_DESTROY, Result.MeshHandle, 0, 0, 0, 0, 0, 0, 0, 0, 0)

        Result.MeshHandle = 0
        Return Result

    End If

    Result.ScaleX = 100
    Result.ScaleY = 100
    Result.ScaleZ = 100
    Result.ColorRed = 255
    Result.ColorGreen = 255
    Result.ColorBlue = 255
    Result.AlphaPercent = 100
    Result.Visible = True
    Result.CastsShadow = True
    Result.ReceivesShadow = True
    Return Result

End Function

Public Function CreateCube3D(Size As Number) As Core.Object3D

    Dim Result As Core.Object3D

    Result = CreatePrimitiveObject(PRIMITIVE_CUBE, Size, 0, 0, 0)
    Return Result

End Function

