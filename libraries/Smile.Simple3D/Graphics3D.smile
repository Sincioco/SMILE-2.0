Public Function ClearAdditionalLights3DChecked() As Boolean

    Dim Slot As Number
    Dim Result As Boolean

    Result = True

    For Slot = 0 To 3

        If Dispatch(COMMAND_SET_LOCAL_LIGHT, Slot, LIGHT_DISABLED, 0, 0, 0, 0, 0, 0, 0, 0) = 0 Then
            Result = False
        End If

    End For

    Return Result

End Function

