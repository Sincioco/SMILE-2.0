Public Sub SetObjectColor(ByRef Object As Core.Object3D, RedValue As Number, GreenValue As Number, BlueValue As Number)

    Object.ColorRed = RedValue
    Object.ColorGreen = GreenValue
    Object.ColorBlue = BlueValue

    Call Execute(COMMAND_SET_COLOR, Object.Handle, RedValue, GreenValue, BlueValue, Object.AlphaPercent, 0, 0, 0, 0, 0)

End Sub

Public Sub SetObjectOpacity(ByRef Object As Core.Object3D, OpacityValue As Number)

    Object.AlphaPercent = Max(0, Min(100, OpacityValue))

    Call Execute(COMMAND_SET_COLOR, Object.Handle, Object.ColorRed, Object.ColorGreen, Object.ColorBlue, Object.AlphaPercent, 0, 0, 0, 0, 0)

End Sub

