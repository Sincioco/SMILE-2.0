Public Function CreateObjectFromMesh3D(MeshHandle As Number) As Core.Object3D

    Dim Result As Core.Object3D

    Result.MeshHandle = MeshHandle
    Result.Handle = Dispatch(COMMAND_CREATE_OBJECT, MeshHandle, 0, 0, 0, 0, 0, 0, 0, 0, 0)

    If Result.Handle <> 0 Then

        Result.ScaleX = 100
        Result.ScaleY = 100
        Result.ScaleZ = 100
        Result.ColorRed = 255
        Result.ColorGreen = 255
        Result.ColorBlue = 255
        Result.AlphaPercent = 100
        Result.Visible = True
        Result.CastsShadow = True
        Result.ReceivesShadow = True

    End If

    Return Result

End Function

