Public Function CreateAnimator3D(Skeleton As Core.Skeleton3D) As Core.Animator3D

    Dim Result As Core.Animator3D

    Result.Handle = Dispatch(COMMAND_CREATE_ANIMATOR, Skeleton.Handle, 0, 0, 0, 0, 0, 0, 0, 0, 0)

    If Result.Handle <> 0 Then
        Result.SkeletonHandle = Skeleton.Handle
        Result.SpeedPercent = 100
    End If

    Return Result

End Function

''' Creates independent playback state for the animation payload owned by one model.
Public Function CreateModelAnimator3D(Model As Core.Model3D) As Core.Animator3D

    Dim Result As Core.Animator3D

    Result.Handle = Dispatch(COMMAND_CREATE_MODEL_ANIMATOR, Model.Handle, 0, 0, 0, 0, 0, 0, 0, 0, 0)

    If Result.Handle <> 0 Then

        Result.ModelHandle = Model.Handle
        Result.ClipIndex = -1
        Result.SpeedPercent = 100
        Result.ModelAnimator = True

    End If

    Return Result

End Function

Public Function PlayAnimation3D(
    ByRef Animator As Core.Animator3D,
    Clip As Core.AnimationClip3D,
    Looping As Boolean,
    Optional SpeedPercent As Number = 100
) As Boolean

    Dim LoopValue As Number
    Dim Result As Boolean

    If Looping Then
        LoopValue = 1
    Else
        LoopValue = 0
    End If

    Result = Dispatch(
        COMMAND_PLAY_ANIMATOR,
        Animator.Handle,
        Clip.Handle,
        LoopValue,
        SpeedPercent,
        0,
        0,
        0,
        0,
        0,
        0
    ) <> 0

    If Result Then

        Animator.ClipHandle = Clip.Handle
        Animator.Looping = Looping
        Animator.SpeedPercent = SpeedPercent

    End If

    Return Result

End Function

Public Function PlayModelAnimator3D(
    ByRef Animator As Core.Animator3D,
    ClipIndex As Number,
    Mode As Number,
    Optional SpeedPercent As Number = 100
) As Boolean

    Dim Result As Boolean

    Result = Dispatch(
        COMMAND_PLAY_MODEL_ANIMATOR,
        Animator.Handle,
        ClipIndex,
        Mode,
        SpeedPercent,
        0,
        0,
        0,
        0,
        0,
        0
    ) <> 0

    If Result Then

        Animator.ClipIndex = ClipIndex
        Animator.PlaybackMode = Mode
        Animator.Looping = Mode = ANIMATION_LOOP
        Animator.SpeedPercent = SpeedPercent

    End If

    Return Result

End Function

