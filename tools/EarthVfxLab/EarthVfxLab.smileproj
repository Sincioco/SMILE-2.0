<SmileProject Version="1.0">
  <PropertyGroup>
    <ProjectKind>Game</ProjectKind>
    <StartupFile>Program.smile</StartupFile>
    <OutputName>EarthVfxLab</OutputName>
    <ApplicationId>smile.tools.earth-vfx-lab</ApplicationId>
    <WebLoadingAuthor>Louiery R. Sincioco (Sin)</WebLoadingAuthor>
    <WebLoadingLogo>..\..\assets\branding\smile-2.0-logo.png</WebLoadingLogo>
    <GraphicsBackend>DirectX</GraphicsBackend>
    <VSync>true</VSync>
    <ResponsiveWindow>true</ResponsiveWindow>
    <RememberWindowPlacement>true</RememberWindowPlacement>
  </PropertyGroup>
  <ItemGroup>
    <SmileSource Include="Program.smile" StartupOnly="true" />
    <SmileSource Include="EarthLabScene.smile" />
    <SmileSource Include="EarthLabUi.smile" />
    <SmileSource Include="..\Character3DViewer\KaelEarth.smile" />
    <SmileSource Include="..\Character3DViewer\BattleAudio.smile" />
    <Asset Include="Assets\Earth\*.png" />
    <Asset Include="Assets\Earth\*.wav" />
    <Asset Include="Assets\Backgrounds\*.png" />
    <Model3DAsset Include="BuildAssets\kael-v1-animation-checkpoint.glb"
                  Descriptor="BuildAssets\KaelV1.sm3d.json"
                  LogicalPath="Assets/Kael.sm3d" TextureOutputDirectory="Assets/KaelTextures"
                  Profile="Character" Identity="sin-star-i.character.kael" ProductionState="Prototype" />
    <Model3DAsset Include="BuildAssets\earth-rocks.glb"
                  LogicalPath="Assets/Earth/EarthRocks.sm3d" TextureOutputDirectory="Assets/Earth/Textures"
                  Profile="Static" Identity="smile.vfx.earth-rocks" ProductionState="Prototype" />
    <SmileProjectReference Include="..\..\libraries\Smile.Simple3D\Smile.Simple3D.smilelibproj" />
    <SmileProjectReference Include="..\..\libraries\Smile.UI\Smile.UI.smilelibproj" />
  </ItemGroup>
</SmileProject>
