Option Explicit

Import Smile.Tools.WaterLabScene As Scene
Import Smile.Tools.WaterLabUi As UI
Import Smile.Simple3D.WaterVfx3D As Water
Import Smile.Simple3D.WaterFlow3D As Flow
Import Smile.Simple3D.WaterImpact3D As Splash
Import Smile.Simple3D.Graphics3D As G
Import Smile.Simple3D.Character3D As Character
Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.PrecisionMath3D As M
Import Smile.Simple3D.LightningVfx3D As Lightning

Dim Lab As Scene.State
Dim Mode As Number
Dim Failures As Number
Dim Position As P.Vector3
Dim Facing As P.Vector3
Dim Ok As Boolean
Dim LightningAge As Number
Dim Edge As P.Vector3
Dim ReflectionBytesPerPixel As Number

Game Window "Water Lab Native Checks" Size 400 By 300

Call Scene.Start(Lab)
Call Check(Lab.KaelSelected And Character.ClipCount(Lab.Kael) = 16)
Call Scene.SelectCharacter(Lab, False)

Lab.AudioEnabled = False
Lab.Paused = True
Lab.Orbit = False

Do

    Call Check(Lab.Ready)
    Call Check(Lab.Background.Ready)
    Call Check(Lab.Floor.ReflectionsEnabled)
    Call Check(Lab.SpeedPercent = 200)

    Call UI.Update(Lab, KEY_PLUS)
    Call Check(Lab.SpeedPercent = 225)
    Call UI.Update(Lab, KEY_MINUS)
    Call Check(Lab.SpeedPercent = 200)

    Lab.Time = 0
    Lab.Paused = False

    Call Scene.Update(Lab, 16)
    Call Check(Lab.Time = 32)

    Lab.Paused = True

    Call Scene.Update(Lab, 16)
    Call Check(Lab.Time = 32)

    Lab.Mode = Water.STORM
    Lab.Time = 1500

    Call Scene.Update(Lab, 0)

    LightningAge = Lightning.Value(Lightning.QUERY_AGE, Lab.Storm.Bolts[0])
    Lab.SpeedPercent = 400
    Lab.Paused = False

    Call Scene.Update(Lab, 100)
    Call Check(Lab.Time = 1900)
    Call Check(Lightning.Value(Lightning.QUERY_AGE, Lab.Storm.Bolts[0]) - LightningAge = 400)
    Call Check(Lab.Water.Spray.ActiveCount > 0)

    Lab.Paused = True

    Ok = Character.TryRotation(Lab.Mira, Facing)

    Call Check(Ok And Facing.Y = 270.0)
    Call Check(Water.RecoilDistance(0.5) = 0.0)
    Call Check(Water.RecoilDistance(0.86) > 8.0)
    Call Check(Abs(Water.RecoilDistance(1.0)) < 0.001)
    Call Check(Water.BarrierRecoil(0.0) = 0.0)
    Call Check(Water.BarrierRecoil(0.12) > 5.0 And Water.BarrierRecoil(0.12) < 10.0)
    Call Check(Water.BarrierRecoil(0.7) < 2.0)
    Call Check(Water.BarrierRecoil(1.0) = 0.0)

    ''' The closed waterbending skin must meet at its seam and close at the rounded nose.
    Position = Flow.SurfacePoint(P.Vector(0.0, 2.0, 0.0), P.Vector(200.0, 100.0, 0.0),
        0.5, 2500, 0.65, 0.0)
    Edge = Flow.SurfacePoint(P.Vector(0.0, 2.0, 0.0), P.Vector(200.0, 100.0, 0.0),
        0.5, 2500, 0.65, M.PI * 2.0)
    Facing = M.Subtract(Position, Edge)

    Call Check(M.Dot(Facing, Facing) < 0.000001)

    Position = Flow.SurfacePoint(P.Vector(0.0, 2.0, 0.0), P.Vector(200.0, 100.0, 0.0),
        0.5, 2500, 1.0, 1.7)
    Edge = Flow.CenterPoint(P.Vector(0.0, 2.0, 0.0), P.Vector(200.0, 100.0, 0.0),
        0.5, 2500, 1.0)
    Facing = M.Subtract(Position, Edge)

    Call Check(M.Dot(Facing, Facing) < 0.000001)
    Call Check(Position.Y > 100.0 And Position.X > 50.0)

    ''' The combat whip's head reaches caller-provided contact at the shared impact time.
    Position = Flow.AttackCenter(P.Vector(-100.0, 90.0, 0.0), P.Vector(162.0, 58.0, 35.0),
        0.72, 3600, 1.0)
    Facing = M.Subtract(Position, P.Vector(162.0, 58.0, 35.0))

    Call Check(M.Dot(Facing, Facing) < 0.000001)

    For Mode = 1 To 8

        Lab.Mode = Mode

        Call Scene.Restart(Lab)

        Lab.Time = 2400

        Call Scene.Update(Lab, 0)
        Call Scene.Draw(Lab)
        Call Check(Lab.Ready And Lab.ErrorCode = 0 And Lab.Water.Visible)

        If Mode = Water.HEAL Then
            Call Check(Lab.Water.Sheets.PointCount = 8 * 99)
        Else If Mode = Water.SHIELD Then
            Call Check(Lab.Water.Sheets.PointCount = 32 * 51)
        Else If Mode = Water.IMPACT Then
            Call Check(Lab.Water.Sheets.PointCount = 16 * 99)
        Else

            Call Check(Lab.Water.Sheets.PointCount = 32 * 99)
        End If

        Call Check(G.ReflectionValue3D(G.REFLECTION_QUERY_EFFECTIVE) = 1)
        Call Check(G.ReflectionValue3D(G.REFLECTION_QUERY_DRAWS) > 0)
        Call Check(G.ReflectionValue3D(G.REFLECTION_QUERY_COMPOSITIONS) = 1)

        ''' Water must refract the reflected opaque scene, not a fixed green fallback.
        ReflectionBytesPerPixel = 12

        If G.ReflectionValue3D(G.REFLECTION_QUERY_TARGET_FORMAT) = 2 Then
            ReflectionBytesPerPixel = 20
        End If

        Call Check(G.ReflectionValue3D(G.REFLECTION_QUERY_TARGET_BYTES) =
            G.ReflectionValue3D(G.REFLECTION_QUERY_WIDTH) *
            G.ReflectionValue3D(G.REFLECTION_QUERY_HEIGHT) * ReflectionBytesPerPixel)

        ''' Only the shared lightning batch remains; Mira has no staff shimmer batch.

        Call Check(G.LiveParticleBatchCount3D() = 1)

        Show Screen

        Lab.Time = 4000

        If Mode = Water.SHIELD Then
            Lab.Time = 2610
        End If

        Call Scene.Update(Lab, 0)
        Call Scene.Draw(Lab)
        Call Check(Lab.ErrorCode = 0 And Lab.Water.Visible)

        If Mode = Water.TORRENT Then
            Call Check(Lab.Water.PreviousMode = Water.IMPACT)
        End If

        Show Screen

        Lab.Time = 1000

        Call Scene.Update(Lab, 0)
        Call Check(Lab.ErrorCode = 0)

        If Mode = Water.WATER_BEND Then

            Lab.Paused = False

            Call Scene.Update(Lab, 100)
            Call Check(Lab.Water.Spray.ActiveCount > 0)

            Lab.Paused = True

        End If

    End For

Loop Until True

Call CheckWaterbendingTargets(Lab)
Call CheckCompactImpact(Lab)
Call CheckSharedWater(Lab)
Call CheckBackgrounds(Lab)
Call CheckKael(Lab)

Ok = G.ConfigurePostProcessing3D(False, False, False, 100, 1200, 45, 2, 2, 4)

Call Check(Ok)
Call Scene.Draw(Lab)
Call Check(G.ReflectionValue3D(G.REFLECTION_QUERY_TARGET_FORMAT) = 1, "LDR reflection")
Call Check(G.ReflectionValue3D(G.REFLECTION_QUERY_TARGET_BYTES) =
    G.ReflectionValue3D(G.REFLECTION_QUERY_WIDTH) *
    G.ReflectionValue3D(G.REFLECTION_QUERY_HEIGHT) * 12, "LDR bytes")

Show Screen

Call Scene.Destroy(Lab)
Call Check(G.GpuParticleValue3D(G.GPU_PARTICLE_QUERY_TOTAL_CAPACITY) = 0, "GPU cleanup")
Call Check(G.LiveParticleBatchCount3D() = 0, "Particle cleanup")
Call Check(G.LiveMaterialCount3D() = 0, "Material cleanup")
Call Check(G.LiveTextureCount3D() = 0, "Texture cleanup")
Call G.ResetRenderer3D()
Call Check(G.ReflectionValue3D(G.REFLECTION_QUERY_TARGET_BYTES) = 0)

Print "Water Lab native failures: "; Failures

Sub CheckKael(ByRef Value As Scene.State)

    Dim Index As Number
    Dim FrameIndex As Number
    Dim SavedTextures As Number
    Dim SavedMaterials As Number
    Dim LeftStart As P.Vector3
    Dim RightStart As P.Vector3
    Dim LeftNow As P.Vector3
    Dim RightNow As P.Vector3
    Dim Head As P.Vector3
    Dim Delta As P.Vector3
    Dim LeftTravel As Double
    Dim RightTravel As Double
    Dim Low As Double
    Dim High As Double
    Dim Ready As Boolean

    SavedTextures = G.LiveTextureCount3D()
    SavedMaterials = G.LiveMaterialCount3D()

    Call UI.Update(Value, KEY_X)
    Call Check(Value.KaelSelected And Value.KaelAttack = 1 And Value.Paused)

    Value.Demo = False

    ''' The realism toggle changes presentation without replaying the cast or allocating resources.
    Value.Time = 1500

    Call Scene.Update(Value, 0)
    Call Check(Value.Frame.Realistic)
    Call UI.Update(Value, KEY_F)
    Call Scene.Update(Value, 0)
    Call Check(Not Value.Frame.Realistic And Value.Time = 1500 And Value.Paused)
    Call UI.Update(Value, KEY_F)
    Call Scene.Update(Value, 0)
    Call Check(Value.Frame.Realistic And Value.Time = 1500)

    LeftNow = Flow.SurfacePoint(Value.Frame.Origin, Value.Frame.Target, 0.3,
        1500, 0.5, 1.0, True, 1, False)
    RightNow = Flow.SurfacePoint(Value.Frame.Origin, Value.Frame.Target, 0.3,
        1500, 0.5, 1.0, True, 1, True)

    Call Check(M.Length(M.Subtract(LeftNow, RightNow)) > 0.5)
    Call Check(Splash.CanWrap(12.0, 75.0))
    Call Check(Not Splash.CanWrap(0.0, 0.0) And Not Splash.CanWrap(50.0, 75.0))
    Call Check(Not Splash.CanWrap(12.0, 160.0))

    For Index = 0 To 15

        LeftNow = Splash.WrapPoint(P.Vector(-160.0, 0.0, 0.0), P.Vector(162.0, 58.0, 0.0),
            P.Vector(175.0, 38.0, 0.0), 12.0, 75.0, 0.32, Index, 1.0, 0.0)

        Call Check(LeftNow.X > 188.0 And Abs(LeftNow.Z) < 0.001, "Water reaches behind small target")

        For FrameIndex = 0 To 10

            RightNow = Splash.WrapPoint(P.Vector(-160.0, 0.0, 0.0), P.Vector(162.0, 58.0, 0.0),
                P.Vector(175.0, 38.0, 0.0), 12.0, 75.0, 0.6, Index,
                ToDouble(FrameIndex) / 10.0, -1.0)
            Delta = M.Subtract(RightNow, P.Vector(175.0, 38.0, 0.0))

            Call Check(Delta.X * Delta.X + Delta.Z * Delta.Z > 144.0 And RightNow.Y >= 2.0,
                "Target wrap clears cylinder and floor")
        End For
    End For

    For Mode = 1 To 3

        Value.KaelAttack = Mode
        LeftTravel = 0.0
        RightTravel = 0.0
        Low = 10000.0
        High = -10000.0

        Call Scene.Restart(Value)
        Call Check(Character.CurrentClipNameMatches(Value.Kael, Value.Clip))

        For FrameIndex = 0 To 9

            Value.Time = FrameIndex * 500

            Call Scene.Update(Value, 0)
            Call Scene.Draw(Value)
            Call Check(Value.ErrorCode = 0 And G.LastError() = 0)
            Call Check(Value.Frame.WrapStyle = Mode)

            Ready = Character.TrySocketPositionPrecise(Value.Kael, "HandLeft", 0, False, LeftNow)
            Ready = Character.TrySocketPositionPrecise(Value.Kael, "HandRight", 0, False, RightNow) And Ready
            Ready = Character.TrySocketPositionPrecise(Value.Kael, "Head", 0, False, Head) And Ready

            Call Check(Ready)

            If FrameIndex = 0 Then
                LeftStart = LeftNow
                RightStart = RightNow
            End If

            LeftTravel = Max(LeftTravel, M.Length(M.Subtract(LeftNow, LeftStart)))
            RightTravel = Max(RightTravel, M.Length(M.Subtract(RightNow, RightStart)))
            Low = Min(Low, Head.Y)
            High = Max(High, Head.Y)

            Show Screen
        End For

        Call Check(LeftTravel > 30.0 And RightTravel > 30.0 And High - Low > 12.0)

        ''' The held helix clears the body and its closed head reaches the chosen pillar.

        For Index = 0 To 10
            Head = Flow.WrapCenter(Value.Frame.Origin, Value.Frame.Target, 0.3,
                ToDouble(Index) / 10.0, Mode)
            Delta = M.Subtract(Head, Value.Frame.Origin)

            Call Check(Delta.X * Delta.X + Delta.Z * Delta.Z >= 73.9 * 73.9)
        End For

        Head = Flow.SurfacePoint(Value.Frame.Origin, Value.Frame.Target, 0.72,
            3600, 1.0, 1.7, True, Mode)

        Call Check(M.Length(M.Subtract(Head, Value.Frame.Target)) < 0.001)

        Value.Time = 3600

        Call Scene.Update(Value, 0)
        Call Check(Value.Water.PreviousMode = Water.IMPACT And Value.Water.ImpactSprayCount = 96)
        Call Check(Value.Frame.TargetRadius = ToDouble(Value.TargetRadii[Value.TargetIndex]) And
            Value.Frame.TargetHeight = ToDouble(Value.TargetHeights[Value.TargetIndex]))
        Call UI.Update(Value, KEY_X)
        Call Scene.Update(Value, 0)
        Call Check(Not Value.KaelSelected And Value.Frame.WrapStyle = 0)
        Call UI.Update(Value, KEY_X)
        Call Check(G.LiveTextureCount3D() = SavedTextures And G.LiveMaterialCount3D() = SavedMaterials)
    End For

    Value.Demo = True
    Value.Paused = False
    Value.SpeedPercent = 200

    ''' Every progressive-size target receives a surface hit, including the non-wrapping largest.

    For Index = 0 To 3

        Value.TargetIndex = Index
        Value.Paused = True
        Value.Time = 4100

        Call Scene.Update(Value, 0)
        Call Scene.Draw(Value)
        Call Check(Value.ErrorCode = 0 And G.LastError() = 0)

        Delta = M.Subtract(Value.Frame.Target, Value.Frame.TargetCenter)
        Delta.Y = 0.0

        Call Check(Abs(M.Length(Delta) - ToDouble(Value.TargetRadii[Index]) - 1.0) < 0.001)
        Call Check(Splash.CanWrap(Value.Frame.TargetRadius, Value.Frame.TargetHeight) = (Index < 3))

        Show Screen
    End For

    Value.Paused = False

    For Index = 1 To 3
        Value.Time = Value.Duration - 20

        Call Scene.Update(Value, 10)
        Call Check(Value.KaelAttack = Index Mod 3 + 1 And Value.Time = 0)
        Call Check(Character.CurrentClipNameMatches(Value.Kael, Value.Clip))
    End For

    Value.Paused = True

    ''' Keep a visible refracting surface for the following LDR target allocation check.
    Value.Time = 1500

    Call Scene.Update(Value, 0)

End Sub

Sub CheckWaterbendingTargets(ByRef Value As Scene.State)

    Dim TargetIndex As Number
    Dim PillarIndex As Number
    Dim SelectedTarget As Number
    Dim PreviousSerial As Number
    Dim Head As P.Vector3
    Dim Delta As P.Vector3
    Dim Pillar As P.Transform3D
    Dim Ready As Boolean

    Value.Mode = Water.WATER_BEND
    Value.SpeedPercent = 100

    For TargetIndex = 0 To 3

        Call Scene.Restart(Value)
        Call Check(Value.TargetIndex >= 0 And Value.TargetIndex < 4)

        SelectedTarget = Value.TargetIndex
        Value.Time = 1000
        Value.Paused = False

        Call Scene.Update(Value, 0)

        PreviousSerial = Value.Water.Serial

        Call Scene.Update(Value, 100)
        Call Check(Value.TargetIndex = SelectedTarget)
        Call Check(Value.Water.Serial > PreviousSerial And Value.Water.Serial - PreviousSerial <= 20)

        Value.Paused = True
        Value.TargetIndex = TargetIndex
        Value.Time = 3600

        Call Scene.Update(Value, 0)

        Head = Flow.CenterPoint(Value.Frame.Origin, Value.Frame.Target, 0.72, Value.Time, 1.0)
        Delta = M.Subtract(Head, Value.Frame.Target)

        Call Check(M.Dot(Delta, Delta) < 0.000001)
        Call Check(Value.Water.PreviousMode = Water.IMPACT)

        Value.Time = 4300

        Call Scene.Update(Value, 0)

        For PillarIndex = 0 To 3

            Ready = P.TryTransform(Value.Targets[PillarIndex], Pillar)

            Call Check(Ready And Pillar.Position.X >= 175.0)
            Call Check(Pillar.Position.Z = -150.0 + ToDouble(PillarIndex) * 100.0)
            Call Check(Pillar.Position.Y = ToDouble(Value.TargetHeights[PillarIndex]) * 0.5)

            If PillarIndex > 0 Then
                Call Check(Value.TargetRadii[PillarIndex] > Value.TargetRadii[PillarIndex - 1] And
                    Value.TargetHeights[PillarIndex] > Value.TargetHeights[PillarIndex - 1])
            End If

            If PillarIndex = TargetIndex Then
                Call Check(Pillar.Position.X > 183.0)
            Else

                Call Check(Pillar.Position.X = 175.0)
            End If

        End For
    End For

End Sub

Sub CheckCompactImpact(ByRef Value As Scene.State)

    Dim Strip As Number
    Dim Point As P.Vector3
    Dim Delta As P.Vector3

    For Strip = 0 To 15
        Point = Splash.SheetPoint(Value.Frame.Origin, Value.Frame.Target, 0.35, Strip, 1.0, 1.0)
        Delta = M.Subtract(Point, Value.Frame.Target)

        Call Check(M.Dot(Delta, Delta) > 400.0 And M.Dot(Delta, Delta) < 3600.0)
        Call Check(Splash.SheetOpacity(1.0, Strip, 0.5) = 0.0)
    End For

End Sub

''' All presets share the sparse spray and bounded contact burst, including every struck shield.
Sub CheckSharedWater(ByRef Value As Scene.State)

    Dim Sample As Water.Frame
    Dim CastMode As Number
    Dim ContactMembers As Number
    Dim PreviousSerial As Number
    Dim Ready As Boolean

    Sample = Value.Frame
    Sample.Strength = 1.0
    Sample.MemberCount = 4

    For CastMode = Water.HEAL To Water.WATER_BEND

        Mode = CastMode
        Sample.Mode = CastMode
        Sample.Time = 10000
        Sample.Progress = 0.2
        Sample.ImpactActive = False
        Sample.ImpactProgress = 0.0
        Sample.ImpactMember = 0
        Ready = Water.Update(Value.Water, Sample)
        PreviousSerial = Value.Water.Serial
        Sample.Time = Sample.Time + 100
        Ready = Water.Update(Value.Water, Sample) And Ready

        If CastMode = Water.SHIELD Or CastMode = Water.IMPACT Then
            Call Check(Value.Water.Serial = PreviousSerial)
        Else

            Call Check(Value.Water.Serial - PreviousSerial = 20)
        End If

        Call Check(Ready)

        If CastMode <> Water.HEAL Then

            Sample.Progress = 0.72
            Sample.ImpactActive = CastMode = Water.SHIELD
            Sample.ImpactProgress = 0.0

            If CastMode = Water.IMPACT Then
                Sample.Progress = 0.0
            End If

            Ready = Water.Update(Value.Water, Sample)

            Call Check(Ready And Value.Water.ImpactSprayCount = 96)

            PreviousSerial = Value.Water.Serial
            Ready = Water.Update(Value.Water, Sample)

            Call Check(Ready And Value.Water.Serial = PreviousSerial)

            Sample.Time = Sample.Time + 100
            Sample.Progress = 0.776
            Sample.ImpactProgress = 0.2

            If CastMode = Water.IMPACT Then
                Sample.Progress = 0.2
            End If

            Ready = Water.Update(Value.Water, Sample)

            Call Check(Ready And Value.Water.ImpactSprayCount = 128)

            PreviousSerial = Value.Water.Serial
            Sample.Time = Sample.Time + 100
            Sample.Progress = 0.86
            Sample.ImpactProgress = 0.5

            If CastMode = Water.IMPACT Then
                Sample.Progress = 0.5
            End If

            Ready = Water.Update(Value.Water, Sample)

            Call Check(Ready And Value.Water.Serial = PreviousSerial)

        End If

    End For

    ''' Four simultaneous barrier crowns fit the same ribbon allocation alongside lightning.
    Sample.Mode = Water.SHIELD
    Sample.ImpactActive = True
    Sample.ImpactMember = -1

    For ContactMembers = 1 To 4

        Mode = Water.SHIELD
        Sample.MemberCount = ContactMembers
        Sample.Time = Sample.Time + 1000
        Sample.ImpactProgress = 0.0
        Ready = Water.Update(Value.Water, Sample)

        Call Check(Ready And Value.Water.ImpactSprayCount = 96)
        Call Check(Value.Water.Sheets.PointCount = ContactMembers * (8 * 51 + 16 * 23))
        Call Check(Value.Water.Sheets.PointCount <= 32 * 99)
        Call Scene.Draw(Value)
        Call Check(G.LastError() = 0)

        Show Screen

        Sample.Time = Sample.Time + 100
        Sample.ImpactProgress = 0.2
        Ready = Water.Update(Value.Water, Sample)

        Call Check(Ready And Value.Water.ImpactSprayCount = 128)
    End For

End Sub

Sub CheckBackgrounds(ByRef Value As Scene.State)

    Dim Index As Number
    Dim TextureCount As Number
    Dim SavedTime As Number

    TextureCount = G.LiveTextureCount3D()
    SavedTime = Value.Time

    Call Check(Value.BackgroundIndex = 3 And Value.TitleBackground.Ready)

    For Index = 1 To 5

        Call UI.Update(Value, KEY_B)
        Call Scene.Draw(Value)
        Call Check(Value.BackgroundIndex = (3 + Index) Mod 5)
        Call Check(Value.Time = SavedTime And Value.Paused And G.LastError() = 0)
        Call Check(G.LiveTextureCount3D() = TextureCount)

        Show Screen
    End For

End Sub

Sub Check(Condition As Boolean, Optional Label As Text = "")

    If Not Condition Then
        Failures = Failures + 1
        Print "Water Lab check failed in mode "; Mode; " "; Label
    End If

End Sub
