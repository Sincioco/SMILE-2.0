Option Explicit

Import Smile.Tools.WaterLabScene As Scene
Import Smile.Tools.WaterLabUi As UI
Import Smile.Simple3D.WaterVfx3D As Water
Import Smile.Simple3D.WaterFlow3D As Flow
Import Smile.Simple3D.WaterImpact3D As Splash
Import Smile.Simple3D.Graphics3D As G
Import Smile.Simple3D.Character3D As Character
Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.PrecisionMath3D As M
Import Smile.Simple3D.LightningVfx3D As Lightning

Dim Lab As Scene.State
Dim Mode As Number
Dim Failures As Number
Dim Position As P.Vector3
Dim Facing As P.Vector3
Dim Ok As Boolean
Dim LightningAge As Number
Dim Edge As P.Vector3
Dim ReflectionBytesPerPixel As Number

Game Window "Water Lab Native Checks" Size 400 By 300

Call Scene.Start(Lab)

Lab.AudioEnabled = False
Lab.Paused = True
Lab.Orbit = False

Do

    Call Check(Lab.Ready)
    Call Check(Lab.Background.Ready)
    Call Check(Lab.Floor.ReflectionsEnabled)
    Call Check(Lab.SpeedPercent = 200)

    Call UI.Update(Lab, KEY_PLUS)
    Call Check(Lab.SpeedPercent = 225)
    Call UI.Update(Lab, KEY_MINUS)
    Call Check(Lab.SpeedPercent = 200)

    Lab.Time = 0
    Lab.Paused = False

    Call Scene.Update(Lab, 16)
    Call Check(Lab.Time = 32)

    Lab.Paused = True

    Call Scene.Update(Lab, 16)
    Call Check(Lab.Time = 32)

    Lab.Mode = Water.STORM
    Lab.Time = 1500

    Call Scene.Update(Lab, 0)

    LightningAge = Lightning.Value(Lightning.QUERY_AGE, Lab.Storm.Bolts[0])
    Lab.SpeedPercent = 400
    Lab.Paused = False

    Call Scene.Update(Lab, 100)
    Call Check(Lab.Time = 1900)
    Call Check(Lightning.Value(Lightning.QUERY_AGE, Lab.Storm.Bolts[0]) - LightningAge = 400)
    Call Check(Lab.Water.Spray.ActiveCount > 0)

    Lab.Paused = True

    Ok = Character.TryRotation(Lab.Mira, Facing)

    Call Check(Ok And Facing.Y = 270.0)
    Call Check(Water.RecoilDistance(0.5) = 0.0)
    Call Check(Water.RecoilDistance(0.86) > 8.0)
    Call Check(Abs(Water.RecoilDistance(1.0)) < 0.001)
    Call Check(Water.BarrierRecoil(0.0) = 0.0)
    Call Check(Water.BarrierRecoil(0.12) > 5.0 And Water.BarrierRecoil(0.12) < 10.0)
    Call Check(Water.BarrierRecoil(0.7) < 2.0)
    Call Check(Water.BarrierRecoil(1.0) = 0.0)

    ''' The closed waterbending skin must meet at its seam and close at the rounded nose.
    Position = Flow.SurfacePoint(P.Vector(0.0, 2.0, 0.0), P.Vector(200.0, 100.0, 0.0),
        0.5, 2500, 0.65, 0.0)
    Edge = Flow.SurfacePoint(P.Vector(0.0, 2.0, 0.0), P.Vector(200.0, 100.0, 0.0),
        0.5, 2500, 0.65, M.PI * 2.0)
    Facing = M.Subtract(Position, Edge)

    Call Check(M.Dot(Facing, Facing) < 0.000001)

    Position = Flow.SurfacePoint(P.Vector(0.0, 2.0, 0.0), P.Vector(200.0, 100.0, 0.0),
        0.5, 2500, 1.0, 1.7)
    Edge = Flow.CenterPoint(P.Vector(0.0, 2.0, 0.0), P.Vector(200.0, 100.0, 0.0),
        0.5, 2500, 1.0)
    Facing = M.Subtract(Position, Edge)

    Call Check(M.Dot(Facing, Facing) < 0.000001)
    Call Check(Position.Y > 100.0 And Position.X > 50.0)

    ''' The combat whip's head reaches caller-provided contact at the shared impact time.
    Position = Flow.AttackCenter(P.Vector(-100.0, 90.0, 0.0), P.Vector(162.0, 58.0, 35.0),
        0.72, 3600, 1.0)
    Facing = M.Subtract(Position, P.Vector(162.0, 58.0, 35.0))

    Call Check(M.Dot(Facing, Facing) < 0.000001)

    For Mode = 1 To 8

        Lab.Mode = Mode

        Call Scene.Restart(Lab)

        Lab.Time = 2400

        Call Scene.Update(Lab, 0)
        Call Scene.Draw(Lab)
        Call Check(Lab.Ready And Lab.ErrorCode = 0 And Lab.Water.Visible)
        Call Check(G.ReflectionValue3D(G.REFLECTION_QUERY_EFFECTIVE) = 1)
        Call Check(G.ReflectionValue3D(G.REFLECTION_QUERY_DRAWS) > 0)
        Call Check(G.ReflectionValue3D(G.REFLECTION_QUERY_COMPOSITIONS) = 1)

        ''' Water must refract the reflected opaque scene, not a fixed green fallback.
        ReflectionBytesPerPixel = 12

        If G.ReflectionValue3D(G.REFLECTION_QUERY_TARGET_FORMAT) = 2 Then
            ReflectionBytesPerPixel = 20
        End If

        Call Check(G.ReflectionValue3D(G.REFLECTION_QUERY_TARGET_BYTES) =
            G.ReflectionValue3D(G.REFLECTION_QUERY_WIDTH) *
            G.ReflectionValue3D(G.REFLECTION_QUERY_HEIGHT) * ReflectionBytesPerPixel)

        ''' Only the shared lightning batch remains; Mira has no staff shimmer batch.

        Call Check(G.LiveParticleBatchCount3D() = 1)

        Show Screen

        Lab.Time = 4000

        If Mode = Water.SHIELD Then
            Lab.Time = 2610
        End If

        Call Scene.Update(Lab, 0)
        Call Scene.Draw(Lab)
        Call Check(Lab.ErrorCode = 0 And Lab.Water.Visible)

        If Mode = Water.TORRENT Then
            Call Check(Lab.Water.PreviousMode = Water.IMPACT)
        End If

        Show Screen

        Lab.Time = 1000

        Call Scene.Update(Lab, 0)
        Call Check(Lab.ErrorCode = 0)

        If Mode = Water.WATER_BEND Then

            Lab.Paused = False

            Call Scene.Update(Lab, 100)
            Call Check(Lab.Water.Spray.ActiveCount > 0)

            Lab.Paused = True

        End If

    End For

Loop Until True

Call CheckWaterbendingTargets(Lab)
Call CheckWaterbendingImpact(Lab)
Call CheckBackgrounds(Lab)

Ok = G.ConfigurePostProcessing3D(False, False, False, 100, 1200, 45, 2, 2, 4)

Call Check(Ok)
Call Scene.Draw(Lab)
Call Check(G.ReflectionValue3D(G.REFLECTION_QUERY_TARGET_FORMAT) = 1)
Call Check(G.ReflectionValue3D(G.REFLECTION_QUERY_TARGET_BYTES) =
    G.ReflectionValue3D(G.REFLECTION_QUERY_WIDTH) *
    G.ReflectionValue3D(G.REFLECTION_QUERY_HEIGHT) * 12)

Show Screen

Call Scene.Destroy(Lab)
Call Check(G.GpuParticleValue3D(G.GPU_PARTICLE_QUERY_TOTAL_CAPACITY) = 0)
Call Check(G.LiveParticleBatchCount3D() = 0)
Call Check(G.LiveMaterialCount3D() = 0)
Call Check(G.LiveTextureCount3D() = 0)
Call G.ResetRenderer3D()
Call Check(G.ReflectionValue3D(G.REFLECTION_QUERY_TARGET_BYTES) = 0)

Print "Water Lab native failures: "; Failures

Sub CheckWaterbendingTargets(ByRef Value As Scene.State)

    Dim TargetIndex As Number
    Dim PillarIndex As Number
    Dim SelectedTarget As Number
    Dim PreviousSerial As Number
    Dim Head As P.Vector3
    Dim Delta As P.Vector3
    Dim Pillar As P.Transform3D
    Dim Ready As Boolean

    Value.Mode = Water.WATER_BEND
    Value.SpeedPercent = 100

    For TargetIndex = 0 To 3

        Call Scene.Restart(Value)
        Call Check(Value.TargetIndex >= 0 And Value.TargetIndex < 4)

        SelectedTarget = Value.TargetIndex
        Value.Time = 1000
        Value.Paused = False

        Call Scene.Update(Value, 0)

        PreviousSerial = Value.Water.Serial

        Call Scene.Update(Value, 100)
        Call Check(Value.TargetIndex = SelectedTarget)
        Call Check(Value.Water.Serial > PreviousSerial And Value.Water.Serial - PreviousSerial <= 20)

        Value.Paused = True
        Value.TargetIndex = TargetIndex
        Value.Time = 3600

        Call Scene.Update(Value, 0)

        Head = Flow.CenterPoint(Value.Frame.Origin, Value.Frame.Target, 0.72, Value.Time, 1.0)
        Delta = M.Subtract(Head, Value.Frame.Target)

        Call Check(M.Dot(Delta, Delta) < 0.000001)
        Call Check(Value.Water.PreviousMode = Water.IMPACT)

        Value.Time = 4300

        Call Scene.Update(Value, 0)

        For PillarIndex = 0 To 3

            Ready = P.TryTransform(Value.Targets[PillarIndex], Pillar)

            Call Check(Ready And Pillar.Position.X >= 175.0)
            Call Check(Pillar.Position.Z = -120.0 + ToDouble(PillarIndex) * 80.0)

            If PillarIndex = TargetIndex Then
                Call Check(Pillar.Position.X > 183.0)
            Else

                Call Check(Pillar.Position.X = 175.0)
            End If

        End For
    End For

End Sub

Sub CheckWaterbendingImpact(ByRef Value As Scene.State)

    Dim Strip As Number
    Dim Point As P.Vector3
    Dim Delta As P.Vector3
    Dim PreviousSerial As Number

    Value.Mode = Water.WATER_BEND
    Value.SpeedPercent = 100
    Value.Paused = True

    Call Scene.Restart(Value)

    Value.Time = 3500

    Call Scene.Update(Value, 0)
    Call Check(Value.Water.Sheets.PointCount = 32 * 99)

    Value.Time = 3600

    Call Scene.Update(Value, 0)
    Call Check(Value.Water.PreviousWaterbendImpact And Value.Water.ImpactSprayCount = 96)

    PreviousSerial = Value.Water.Serial

    Call Scene.Update(Value, 0)
    Call Check(Value.Water.Serial = PreviousSerial)

    Value.Paused = False

    Call Scene.Update(Value, 300)
    Call Check(Value.Water.ImpactSprayCount = 128)

    PreviousSerial = Value.Water.Serial

    Call Scene.Update(Value, 500)
    Call Check(Value.Water.Serial = PreviousSerial)

    Value.Paused = True

    For Strip = 0 To 15
        Point = Splash.SheetPoint(Value.Frame.Origin, Value.Frame.Target, 0.35, Strip, 1.0, 1.0)
        Delta = M.Subtract(Point, Value.Frame.Target)

        Call Check(M.Dot(Delta, Delta) > 400.0 And M.Dot(Delta, Delta) < 3600.0)
        Call Check(Splash.SheetOpacity(1.0, Strip, 0.5) = 0.0)
    End For

End Sub

Sub CheckBackgrounds(ByRef Value As Scene.State)

    Dim Index As Number
    Dim TextureCount As Number
    Dim SavedTime As Number

    TextureCount = G.LiveTextureCount3D()
    SavedTime = Value.Time

    Call Check(Value.BackgroundIndex = 3 And Value.TitleBackground.Ready)

    For Index = 1 To 5

        Call UI.Update(Value, KEY_B)
        Call Scene.Draw(Value)
        Call Check(Value.BackgroundIndex = (3 + Index) Mod 5)
        Call Check(Value.Time = SavedTime And Value.Paused And G.LastError() = 0)
        Call Check(G.LiveTextureCount3D() = TextureCount)

        Show Screen
    End For

End Sub

Sub Check(Condition As Boolean)

    If Not Condition Then
        Failures = Failures + 1
        Print "Water Lab check failed in mode "; Mode
    End If

End Sub
