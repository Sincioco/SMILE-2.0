''' The Lab owns its preview actors, water context, renderer resources and presentation clock.
Module Smile.Tools.WaterLabScene

Option Explicit

Import Smile.Simple3D.Core As Core
Import Smile.Simple3D.Graphics3D As G
Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.PrecisionMath3D As M
Import Smile.Simple3D.PrecisionCamera3D As Camera
Import Smile.Simple3D.Character3D As Character
Import Smile.Simple3D.WaterVfx3D As Water
Import Smile.Simple3D.WaterStorm3D As Storm
Import Smile.Simple3D.LightningVfx3D As Lightning
Import Smile.Simple3D.Arena3D As Arena
Import Smile.Simple3D.StaticBackdrop3D As Backdrop

Public Type State
    Ready As Boolean
    ErrorCode As Number
    Mode As Number
    Time As Number
    Duration As Number
    SpeedPercent As Number
    TimeRemainder As Number
    Paused As Boolean
    Orbit As Boolean
    AudioEnabled As Boolean
    SoundPlayed As Boolean
    ImpactPlayed As Boolean
    Clip As Text
    Frame As Water.Frame
    Water As Water.Context
    Storm As Storm.Context
    Mira As Character.Actor
    Kael As Character.Actor
    KaelSelected As Boolean
    KaelAttack As Number
    Demo As Boolean
    RealisticWater As Boolean
    Floor As Arena.ArenaFloor
    Background As Backdrop.Backdrop
    TitleBackground As Backdrop.Backdrop
    BackgroundIndex As Number
    Targets[4] As Core.Object3D
    TargetRadii[4] As Number
    TargetHeights[4] As Number
    TargetIndex As Number
    BaseCamera As P.Camera3D
    Camera As P.Camera3D
    Controls As Camera.Controls
End Type

Public Sub Start(ByRef Value As State)

    Dim Index As Number
    Dim Ok As Boolean

    Call G.ResetRenderer3D()

    Value.Background = Backdrop.Create("Assets/Backgrounds/SinStarLandscape.png")
    Value.TitleBackground = Backdrop.Create("Assets/Backgrounds/SinStarTitleWithLogo.png")
    Value.BackgroundIndex = 3
    Ok = G.ConfigureSoftDepth3D(1)
    Ok = Value.TitleBackground.Ready And Ok
    Ok = Backdrop.SetActive(Value.Background) And Ok
    Ok = G.ConfigureDistortion3D(1, 2) And Ok
    Ok = G.ConfigurePostProcessing3D(True, True, True, 100, 1200, 45, 2, 2, 4) And Ok
    Ok = G.SetAmbientLight3D(210, 225, 255, 90) And Ok
    Ok = G.SetDirectionalLight3D(-35, -80, 25, 255, 247, 235, 115) And Ok
    Ok = P.SetPointLight(1, P.Vector(0.0, 240.0, -190.0), 200, 222, 255, 110, 850) And Ok
    Ok = P.SetPointLight(2, P.Vector(-100.0, 170.0, 180.0), 55, 155, 255, 160, 650) And Ok
    Ok = Lightning.Initialize("Assets/Lightning", 4096, G.GPU_PARTICLE_SIMULATION_GPU_FAST, 8192) And Ok
    Value.Mira = Character.LoadActor("Assets/Mira.sm3d")
    Ok = Character.IsValid(Value.Mira) And Ok
    Ok = Character.SetScale(Value.Mira, 12000) And Ok
    Ok = Character.Place(Value.Mira, -160, 0, 0) And Ok
    Ok = Character.Rotate(Value.Mira, 0, -90, 0) And Ok
    Value.Kael = Character.LoadActor("Assets/KaelWater.sm3d")
    Ok = Character.IsValid(Value.Kael) And Ok
    Ok = Character.SetScale(Value.Kael, 12000) And Ok
    Ok = Character.Place(Value.Kael, -160, 0, 0) And Ok
    Ok = Character.Rotate(Value.Kael, 0, -90, 0) And Ok
    Ok = Character.SetPartVisible(Value.Kael, 1, False) And Ok
    Value.KaelSelected = True
    Value.KaelAttack = 1
    Value.TargetIndex = -1
    Value.Demo = True
    Value.RealisticWater = True
    Ok = Water.Prepare(Value.Water, "Assets/Water") And Ok
    Value.Floor = Arena.Create(1000, 800, 45, 65, 95, 45, 1, True)

    Call G.SetObjectColor(Value.Floor.Floor, 0, 0, 0)

    For Index = 0 To 3

        Value.TargetRadii[Index] = 12 + Index * 12
        Value.TargetHeights[Index] = 60 + Index * 35
        Value.Targets[Index] = G.CreateCylinder3D(Value.TargetRadii[Index], Value.TargetHeights[Index])
        Ok = P.SetPosition(Value.Targets[Index], 175.0,
            ToDouble(Value.TargetHeights[Index]) * 0.5, -150.0 + ToDouble(Index) * 100.0) And Ok

        Call G.SetObjectColor(Value.Targets[Index], 40, 85, 120)
    End For

    Value.BaseCamera.Position = P.Vector(10.0, 220.0, -560.0)
    Value.BaseCamera.Target = P.Vector(0.0, 65.0, 0.0)
    Value.BaseCamera.UpDirection = P.Vector(0.0, 1.0, 0.0)
    Value.BaseCamera.FovDegrees = 55.0
    Value.BaseCamera.NearPlane = 1.0
    Value.BaseCamera.FarPlane = 3000.0
    Value.Camera = Value.BaseCamera
    Value.Mode = Water.WATER_BEND
    Value.Duration = 5000
    Value.SpeedPercent = 200
    Value.AudioEnabled = True
    Value.Orbit = True
    Value.Ready = Ok And Value.Floor.Ready

    If Not Value.Ready Then
        Value.ErrorCode = Max(1, G.LastError())
    End If

    Call Restart(Value)

End Sub

Public Sub CycleBackground(ByRef Value As State)

    Dim Ok As Boolean

    Value.BackgroundIndex = (Value.BackgroundIndex + 1) Mod 5

    If Value.BackgroundIndex = 3 Then
        Ok = Backdrop.SetActive(Value.Background)
    Else If Value.BackgroundIndex = 4 Then
        Ok = Backdrop.SetActive(Value.TitleBackground)
    Else
        Ok = Backdrop.ClearActive()
    End If

    If Not Ok Then
        Value.ErrorCode = Max(1, G.LastError())
    End If

End Sub

Public Sub SelectCharacter(ByRef Value As State, KaelSelected As Boolean)

    Value.KaelSelected = KaelSelected
    Value.Mode = Water.WATER_BEND
    Value.KaelAttack = 1
    Value.TargetIndex = -1
    Value.TimeRemainder = 0

    Call Restart(Value)

End Sub

Public Sub Restart(ByRef Value As State)

    Dim Ok As Boolean
    Dim ChosenTarget As Number

    Call StopAudio()

    Value.Time = 0
    Value.TimeRemainder = 0
    Value.SoundPlayed = False
    Value.ImpactPlayed = False
    Value.Clip = "Attack"

    If Not Value.KaelSelected Then
        Value.TargetIndex = 3
    End If

    If Value.Mode = Water.WATER_BEND And Not Value.KaelSelected Then
        Random ChosenTarget From 0 To 3
        Value.TargetIndex = ChosenTarget
    End If

    If Value.Mode = Water.HEAL Then
        Value.Clip = "HealParty"
    Else If Value.Mode = Water.SHIELD Then
        Value.Clip = "Defend"
        Value.Frame.ImpactMember = (Value.Frame.ImpactMember + 1) Mod 4
    End If

    Call Storm.Destroy(Value.Storm)

    If Value.KaelSelected Then

        Value.Mode = Water.TORRENT
        Value.Clip = "WaterWhip"

        If Value.KaelAttack = 2 Then
            Value.Clip = "WaterOrbit"
        Else If Value.KaelAttack = 3 Then
            Value.Clip = "WaterSurge"
        End If

        Value.TargetIndex = (Value.TargetIndex + 1) Mod 4
        Ok = Character.PlayAnimation(Value.Kael, Value.Clip, False)

    Else

        Ok = Character.PlayAnimation(Value.Mira, Value.Clip, False)

    End If

    If Not Ok Then
        Value.ErrorCode = Max(1, G.LastError())
    End If

End Sub

Public Sub SetPaused(ByRef Value As State, Paused As Boolean)

    If Paused Then
        Call StopAudio()
    End If

    Value.Paused = Paused

    Call RebaseAudio(Value)

End Sub

Public Sub SetAudioEnabled(ByRef Value As State, Enabled As Boolean)

    If Not Enabled Then
        Call StopAudio()
    End If

    Value.AudioEnabled = Enabled

    Call RebaseAudio(Value)

End Sub

Public Sub Seek(ByRef Value As State, Time As Number)

    Call StopAudio()

    Value.Time = Max(0, Min(Time, Value.Duration - 1))
    Value.TimeRemainder = 0

    Call RebaseAudio(Value)

End Sub

Private Sub RebaseAudio(ByRef Value As State)

    Value.SoundPlayed = Value.Time >= Value.Duration * 30 / 100
    Value.ImpactPlayed = Value.Time >= Value.Duration * 72 / 100

    If Value.Mode = Water.SHIELD Then
        Value.ImpactPlayed = Value.Time >= 2500
    End If

End Sub

Private Sub StopAudio()

    Stop Sound On Channel 6
    Stop Sound On Channel 7
    Stop Sound On Channel 8

End Sub

Public Sub Update(ByRef Value As State, Elapsed As Number)

    Dim Ok As Boolean
    Dim SimulationElapsed As Number
    Dim StepMilliseconds As Number

    If Not Value.Ready Then
        Return
    End If

    If Not Value.Paused Then

        SimulationElapsed = Elapsed * Value.SpeedPercent + Value.TimeRemainder
        Value.TimeRemainder = SimulationElapsed Mod 100
        SimulationElapsed = SimulationElapsed / 100

    End If

    If Value.Orbit Then
        Value.Controls.OrbitYaw = Value.Controls.OrbitYaw + ToDouble(Elapsed) * 0.003
    End If

    Ok = Camera.AdvanceCameraControls(Value.Controls, Elapsed, False)
    Value.Camera = Camera.ApplyScreenSpaceCameraControls(Value.BaseCamera, Value.Controls)

    ''' Shared particle/lightning updates accept at most 100 ms; retain all scaled time.

    Do
        StepMilliseconds = Min(100, SimulationElapsed)

        Call StepPresentation(Value, StepMilliseconds)

        SimulationElapsed = SimulationElapsed - StepMilliseconds

    Loop Until SimulationElapsed <= 0

End Sub

Private Sub StepPresentation(ByRef Value As State, SimulationElapsed As Number)

    Dim Index As Number
    Dim Ok As Boolean
    Dim Charge As Double
    Dim LoopRemainder As Number
    Dim Direction As P.Vector3

    Value.Time = Value.Time + SimulationElapsed

    If Value.Time >= Value.Duration Then

        LoopRemainder = Value.Time Mod Value.Duration

        If Value.KaelSelected And Value.Demo Then
            Value.KaelAttack = Value.KaelAttack Mod 3 + 1
        End If

        Call Restart(Value)

        Value.Time = LoopRemainder

    End If

    Ok = True
    Value.Frame.Mode = Value.Mode
    Value.Frame.Time = Value.Time
    Value.Frame.Progress = ToDouble(Value.Time) / ToDouble(Value.Duration)
    Value.Frame.Strength = Clamp(Min(Value.Frame.Progress * 5.0,
        (1.0 - Value.Frame.Progress) * 7.0), 0.0, 1.0)
    Value.Frame.MemberCount = 4
    Value.Frame.Members[0] = P.Vector(-160.0, 0.0, 0.0)

    For Index = 1 To 3
        Value.Frame.Members[Index] = P.Vector(175.0, 0.0, -250.0 + ToDouble(Index) * 100.0)
    End For

    Value.Frame.ImpactActive = Value.Mode = Water.SHIELD And Value.Time >= 2500 And Value.Time < 3400
    Value.Frame.ImpactProgress = Clamp(ToDouble(Value.Time - 2500) / 900.0, 0.0, 1.0)

    Charge = 0.0

    If (Value.Mode = Water.TORRENT Or
        Value.Mode = Water.WATER_BALL Or
        Value.Mode = Water.WAVE Or
        Value.Mode = Water.STORM Or
        Value.Mode = Water.WATER_BEND) Then
        Charge = Water.RecoilDistance(Value.Frame.Progress)
    End If

    For Index = 0 To 3
        Ok = P.SetPosition(Value.Targets[Index], 175.0,
            ToDouble(Value.TargetHeights[Index]) * 0.5,
            -150.0 + ToDouble(Index) * 100.0) And Ok
    End For

    Value.Frame.TargetCenter = P.Vector(175.0 + Charge,
        ToDouble(Value.TargetHeights[Value.TargetIndex]) * 0.5,
        -150.0 + ToDouble(Value.TargetIndex) * 100.0)
    Ok = P.SetPosition(Value.Targets[Value.TargetIndex], Value.Frame.TargetCenter.X,
        Value.Frame.TargetCenter.Y, Value.Frame.TargetCenter.Z) And Ok

    Value.Frame.WrapStyle = 0
    Value.Frame.Realistic = Value.KaelSelected And Value.RealisticWater
    Value.Frame.TargetRadius = 0.0
    Value.Frame.TargetHeight = 0.0

    If Value.KaelSelected Then

        Ok = PoseActor(Value.Kael, Value.Clip, Value.Frame.Progress) And Ok
        Value.Frame.Origin = P.Vector(-160.0, 0.0, 0.0)
        Value.Frame.WrapStyle = Value.KaelAttack
        Value.Frame.TargetRadius = ToDouble(Value.TargetRadii[Value.TargetIndex])
        Value.Frame.TargetHeight = ToDouble(Value.TargetHeights[Value.TargetIndex])

    Else

        Ok = PoseActor(Value.Mira, Value.Clip, Value.Frame.Progress) And Ok
        Ok = Character.TrySocketPositionPrecise(Value.Mira, "StaffTip", 0, False, Value.Frame.Origin) And Ok

        If Value.Mode = Water.WATER_BEND Then
            Value.Frame.Origin = P.Vector(-65.0, 2.0, -40.0)
        End If

    End If

    Direction = M.Subtract(Value.Frame.TargetCenter, Value.Frame.Origin)
    Direction.Y = 0.0
    Ok = M.TryNormalize(Direction, Direction) And Ok
    Value.Frame.Target = M.Subtract(Value.Frame.TargetCenter,
        M.Scale(Direction, ToDouble(Value.TargetRadii[Value.TargetIndex]) + 1.0))
    Value.Frame.Target.Y = ToDouble(Value.TargetHeights[Value.TargetIndex]) * 0.65
    Ok = Water.Update(Value.Water, Value.Frame) And Ok
    Ok = Storm.Update(Value.Storm, Value.Frame, P.Vector(-80.0, 115.0, 35.0)) And Ok

    Ok = Lightning.UpdatePrecise(SimulationElapsed, Value.Camera) And Ok

    If (SimulationElapsed > 0 And
        Not Value.Paused And
        Value.AudioEnabled And
        Not Value.SoundPlayed And
        Value.Frame.Progress >= 0.3) Then

        Value.SoundPlayed = True

        If Value.Mode = Water.HEAL Then

            Play Sound "Assets/Audio/mira-heal-party.wav" On Channel 6

        Else If Value.Mode = Water.WAVE Or Value.Mode = Water.STORM Then

            Play Sound "Assets/Water/water-tsunami.wav" On Channel 6

        Else

            Play Sound "Assets/Audio/mira-water-attack.wav" On Channel 6

        End If

        If Value.Mode = Water.STORM Then

            Play Sound "Assets/Lightning/thunder.wav" On Channel 7

        End If

    End If

    If (SimulationElapsed > 0 And
        Not Value.Paused And
        Value.AudioEnabled And
        Not Value.ImpactPlayed) Then

        If Value.Mode = Water.SHIELD And Value.Frame.ImpactActive Then
            Value.ImpactPlayed = True

            Play Sound "Assets/Water/water-barrier-hit.wav" On Channel 8

        Else If ((Value.Mode = Water.TORRENT Or
            (Value.Mode >= Water.WATER_BALL And Value.Mode <= Water.WATER_BEND)) And
            Value.Frame.Progress >= 0.72) Then
            Value.ImpactPlayed = True

            Play Sound "Assets/Water/water-splash.wav" On Channel 8

        End If

    End If

    Call RebaseAudio(Value)

    If Not Ok Then
        Value.ErrorCode = Max(1, G.LastError())
    End If

End Sub

Private Function PoseActor(ByRef Actor As Character.Actor, Clip As Text, Progress As Double) As Boolean

    Dim Index As Number
    Dim Duration As Number
    Dim Ok As Boolean

    For Index = 0 To Character.ClipCount(Actor) - 1

        If Character.ClipName(Actor, Index) = Clip Then
            Duration = Character.ClipDuration(Actor, Index)
        End If

    End For

    Ok = Character.SetAnimationTime(Actor, ToNumber(Round(Progress * ToDouble(Duration))))
    Ok = Character.Update(Actor, 0) And Ok

    Return Ok

End Function

Public Sub Draw(ByRef Value As State)

    Dim Index As Number
    Dim Ok As Boolean

    Ok = Arena.ConfigureForFrame(Value.Floor, True, True)
    Ok = P.SetCamera(Value.Camera) And Ok

    If Value.BackgroundIndex = 1 Then
        Ok = G.BeginAcceptedCamera3D(0, 96, 32) And Ok
    Else If Value.BackgroundIndex = 2 Then
        Ok = G.BeginAcceptedCamera3D(62, 20, 96) And Ok
    Else
        Ok = G.BeginAcceptedCamera3D(0, 0, 0) And Ok
    End If

    Ok = Arena.Draw(Value.Floor, True, True) And Ok

    If Value.KaelSelected Then
        Ok = Character.Draw(Value.Kael) And Ok
    Else
        Ok = Character.Draw(Value.Mira) And Ok
    End If

    For Index = 0 To 3
        Ok = G.DrawObject3D(Value.Targets[Index]) And Ok
    End For

    Call Water.Draw(Value.Water)

    Ok = Lightning.DrawAll() And Ok
    Ok = G.End3DChecked() And Ok

End Sub

Public Sub Destroy(ByRef Value As State)

    Dim Index As Number

    Call StopAudio()
    Call Storm.Destroy(Value.Storm)
    Call Water.Destroy(Value.Water)
    Call Character.Destroy(Value.Mira)
    Call Character.Destroy(Value.Kael)
    Call Lightning.Shutdown()
    Call Arena.Destroy(Value.Floor)
    Call Backdrop.Destroy(Value.Background)
    Call Backdrop.Destroy(Value.TitleBackground)

    For Index = 0 To 3
        Call G.DestroyObject3D(Value.Targets[Index])
    End For

End Sub

End Module
