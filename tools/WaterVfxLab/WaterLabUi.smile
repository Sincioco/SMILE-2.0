''' Lab controls and inspection readouts; effect and renderer ownership stays in WaterLabScene.
Module Smile.Tools.WaterLabUi

Option Explicit

Import Smile.Tools.WaterLabScene As Scene
Import Smile.Simple3D.Graphics3D As G
Import Smile.Simple3D.PrecisionCamera3D As Camera
Import Smile.UI.Controls As UI

Public Function Caption(Mode As Number, Optional KaelSelected As Boolean = False) As Text

    If KaelSelected Then

        If Mode = 1 Then
            Return "Water Whip"
        Else If Mode = 2 Then
            Return "Serpent Orbit"
        End If

        Return "Tidal Surge"

    End If

    If Mode = 1 Then
        Return "Healing Veil"
    Else If Mode = 2 Then
        Return "Tide Barrier"
    Else If Mode = 3 Then
        Return "Torrent"
    Else If Mode = 4 Then
        Return "Impact"
    Else If Mode = 5 Then
        Return "Waterball"
    Else If Mode = 6 Then
        Return "Tsunami"
    Else If Mode = 8 Then
        Return "Waterbending"
    End If

    Return "Tempest Combo"

End Function

Public Sub Update(ByRef Value As Scene.State, Key As Number)

    Dim Index As Number
    Dim ButtonWidth As Number
    Dim EffectCount As Number

    EffectCount = 8

    If Value.KaelSelected Then
        EffectCount = 3
    End If

    ButtonWidth = (Window_Width() - 40) / EffectCount

    For Index = 1 To EffectCount

        If UI.Clicked(20 + (Index - 1) * ButtonWidth, 64, ButtonWidth - 6, 32) Then

            If Value.KaelSelected Then
                Value.KaelAttack = Index
                Value.Demo = False
            Else
                Value.Mode = Index
            End If

            Call Scene.Restart(Value)

        End If

    End For

    If Key = KEY_TAB Then

        If Value.KaelSelected Then
            Value.KaelAttack = Value.KaelAttack Mod 3 + 1
            Value.Demo = False
        Else
            Value.Mode = Value.Mode Mod 8 + 1
        End If

        Call Scene.Restart(Value)

    End If

    If Key = KEY_X Then
        Call Scene.SelectCharacter(Value, Not Value.KaelSelected)
    Else If UI.Clicked(440, 20, 100, 30) Then
        Call Scene.SelectCharacter(Value, False)
    Else If UI.Clicked(548, 20, 100, 30) Then
        Call Scene.SelectCharacter(Value, True)
    End If

    If Value.KaelSelected And (Key = KEY_D Or UI.Clicked(880, 112, 120, 28)) Then
        Value.Demo = Not Value.Demo
    End If

    If Value.KaelSelected And (Key = KEY_F Or UI.Clicked(1010, 112, 190, 28)) Then
        Value.RealisticWater = Not Value.RealisticWater
    End If

    If Key = KEY_SPACE Or UI.Clicked(20, 112, 100, 28) Then
        Call Scene.SetPaused(Value, Not Value.Paused)
    End If

    If Key = KEY_R Or UI.Clicked(128, 112, 100, 28) Then
        Call Scene.Restart(Value)
    End If

    If Value.Paused And Key = KEY_LEFT Then
        Call Scene.Seek(Value, Value.Time - 100)
    Else If Value.Paused And Key = KEY_RIGHT Then
        Call Scene.Seek(Value, Value.Time + 100)
    End If

    If Key = KEY_O Or UI.Clicked(236, 112, 110, 28) Then
        Value.Orbit = Not Value.Orbit
    End If

    If Key = KEY_B Or UI.Clicked(702, 112, 160, 28) Then
        Call Scene.CycleBackground(Value)
    End If

    If UI.Clicked(354, 112, 100, 28) Then
        Call Scene.SetAudioEnabled(Value, Not Value.AudioEnabled)
    End If

    If Key = KEY_MINUS Or UI.Clicked(476, 112, 38, 28) Then
        Value.SpeedPercent = Max(25, Value.SpeedPercent - 25)
    End If

    If Key = KEY_PLUS Or UI.Clicked(638, 112, 38, 28) Then
        Value.SpeedPercent = Min(400, Value.SpeedPercent + 25)
    End If

    If Key = KEY_ENTER Or Pointer_Pressed(POINTER_SECONDARY) Then
        Call Camera.ResetCameraControls(Value.Controls)
    End If

    If Pointer_Y() > 150 And Pointer_Y() < Window_Height() - 60 Then

        If Pointer_Held(POINTER_MIDDLE) Then

            Value.Orbit = False
            Value.Controls.OrbitYaw = Value.Controls.OrbitYaw + ToDouble(Pointer_Delta_X()) * 0.3
            Value.Controls.OrbitPitch = Clamp(Value.Controls.OrbitPitch + ToDouble(Pointer_Delta_Y()) * 0.3, -60.0, 60.0)

        Else If Pointer_Held(POINTER_PRIMARY) Then

            Value.Orbit = False
            Value.Controls.PanX = Clamp(Value.Controls.PanX - ToDouble(Pointer_Delta_X()) * 0.3, -250.0, 250.0)
            Value.Controls.PanY = Clamp(Value.Controls.PanY + ToDouble(Pointer_Delta_Y()) * 0.3, -150.0, 150.0)

        End If

        Value.Controls.ZoomTarget = Clamp(Value.Controls.ZoomTarget -
            ToDouble(Pointer_Wheel_Delta()) * 3.0, -30.0, 45.0)

    End If

End Sub

Public Sub Draw(ByRef Value As Scene.State)

    Dim Index As Number
    Dim ButtonWidth As Number
    Dim EffectCount As Number
    Dim Bottom As Number

    EffectCount = 8

    If Value.KaelSelected Then
        EffectCount = 3
    End If

    ButtonWidth = (Window_Width() - 40) / EffectCount
    Bottom = Window_Height() - 54

    Fill Rectangle 0, 0, Window_Width(), 151, Rgb(6, 16, 30) Opacity 94
    Draw Text "SMILE 2.0 - Water Lab" At 20, 20 Size 24 Color White

    Call UI.DrawButton(440, 20, 100, 30, "Mira", Not Value.KaelSelected)
    Call UI.DrawButton(548, 20, 100, 30, "Kael", Value.KaelSelected)

    Draw Text Value.Clip At 680, 28 Size 13 Color Cyan
    Draw Number Value.Time At 870, 28 Size 13 Color Light_Gray
    Draw Text "/ 5000 ms" At 920, 28 Size 13 Color Light_Gray

    For Index = 1 To EffectCount

        If Value.KaelSelected Then
            Call UI.DrawButton(20 + (Index - 1) * ButtonWidth, 64, ButtonWidth - 6, 32,
                Caption(Index, True), Value.KaelAttack = Index)
        Else

            Call UI.DrawButton(20 + (Index - 1) * ButtonWidth, 64, ButtonWidth - 6, 32,
                Caption(Index), Value.Mode = Index)
        End If

    End For

    Call UI.DrawButton(20, 112, 100, 28, "Pause", Value.Paused)
    Call UI.DrawButton(128, 112, 100, 28, "Restart", False)
    Call UI.DrawButton(236, 112, 110, 28, "Orbit", Value.Orbit)
    Call UI.DrawButton(354, 112, 100, 28, "Sound", Value.AudioEnabled)
    Call UI.DrawButton(476, 112, 38, 28, "-", False)
    Call UI.DrawButton(638, 112, 38, 28, "+", False)
    Call UI.DrawButton(702, 112, 160, 28, BackgroundCaption(Value.BackgroundIndex), False)

    If Value.KaelSelected Then
        Call UI.DrawButton(880, 112, 120, 28, "D: Demo", Value.Demo)
        Call UI.DrawButton(1010, 112, 190, 28, "F: Realistic Water", Value.RealisticWater)
    End If

    Draw Text "Speed" At 529, 118 Size 13 Color Light_Gray
    Draw Number Value.SpeedPercent At 580, 118 Size 13 Color Cyan
    Draw Text "%" At 614, 118 Size 13 Color Cyan

    Fill Rectangle 0, Bottom, Window_Width(), 54, Rgb(6, 16, 30) Opacity 94
    Draw Text "GPU Spray" At 20, Bottom + 8 Size 12 Color Light_Gray
    Draw Number Value.Water.Spray.ActiveCount At 130, Bottom + 8 Size 12 Color Cyan
    Draw Text "D3D11 Backend" At 225, Bottom + 8 Size 12 Color Light_Gray
    Draw Number Value.Water.Spray.EffectiveSimulation At 370, Bottom + 8 Size 12 Color Cyan
    Draw Text "Target Pillar" At 440, Bottom + 8 Size 12 Color Light_Gray
    Draw Number Value.TargetIndex + 1 At 565, Bottom + 8 Size 12 Color Cyan
    Draw Text "Width / Height" At 630, Bottom + 8 Size 12 Color Light_Gray
    Draw Number Value.TargetRadii[Value.TargetIndex] * 2 At 780, Bottom + 8 Size 12 Color Cyan
    Draw Text "/" At 823, Bottom + 8 Size 12 Color Light_Gray
    Draw Number Value.TargetHeights[Value.TargetIndex] At 846, Bottom + 8 Size 12 Color Cyan
    Draw Text "LMB Pan / MMB Orbit / Wheel Zoom / RMB Reset / Space Pause / Arrows Step / Tab Effect / +/- Speed / B Background / X Character" At 20, Bottom + 31 Size 11 Color Light_Gray

    If Not Value.Ready Or Value.ErrorCode <> 0 Then
        Draw Text "Effect needs attention" At 1030, 28 Size 13 Color Red
        Draw Number Value.ErrorCode At 1240, 28 Size 13 Color Red
    End If

End Sub

Private Function BackgroundCaption(Index As Number) As Text

    If Index = 1 Then
        Return "B: Green"
    Else If Index = 2 Then
        Return "B: Purple"
    Else If Index = 3 Then
        Return "B: Scene"
    Else If Index = 4 Then
        Return "B: Logo"
    End If

    Return "B: Black"

End Function

End Module
