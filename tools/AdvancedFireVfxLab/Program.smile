Option Explicit

Import Smile.UI.Controls As UI
Import Smile.Simple3D.Arena3D As Arena3D
Import Smile.Simple3D.StaticBackdrop3D As StaticBackdrop3D
Import Smile.Simple3D.CharacterViewer As CameraMotion
Import Smile.Simple3D.Core As Core
Import Smile.Simple3D.Graphics3D As Graphics3D
Import Smile.Simple3D.FireEmitter3D As Fire
Import Smile.Simple3D.Interaction As Interaction
Import Smile.Simple3D.FixedMath As FixedMath

Const ARENA_WIDTH = 1000
Const ARENA_DEPTH = 1000
Const ARENA_TILE_SIZE = 160
Const ARENA_LINE_THICKNESS = 2
Const START_YAW = 27
Const START_PITCH = 12
Const AUTO_ORBIT_SPEED = 5

Dim Camera As Core.Camera3D
Dim BaseCamera As Core.Camera3D
Dim CameraControls As Core.CameraControl3D
Dim ZoomTarget As Number
Dim ZoomLive As Number
Dim SliderDragOwner As Number
Dim PanRemainderX As Number
Dim PanRemainderY As Number
Dim OrbitRemainderX As Number
Dim OrbitRemainderY As Number
Dim Cinematic As Boolean
Dim CinematicYaw1000 As Number
Dim Demo As Boolean
Dim DemoTime As Number
Dim Arena As Arena3D.ArenaFloor
Dim GridTexture As Core.Texture3D
Dim Landscape As StaticBackdrop3D.Backdrop
Dim TitleBackdrop As StaticBackdrop3D.Backdrop
Dim BackgroundIndex As Number
Dim FloorVisible As Boolean
Dim GridVisible As Boolean
Dim UiVisibility As Number
Dim Emitter As Fire.FireEmitter
Dim Comparison As Fire.FireEmitter
Dim Source As Core.Vector3
Dim Tip As Core.Vector3
Dim Light As Core.Vector3
Dim Direction As Core.Vector3
Dim Empty As Fire.FireEmitter
Dim Key As Number
Dim Station As Number
Dim Quality As Number
Dim Mode As Number
Dim Time As Number
Dim RestartSerial As Number
Dim Previous As Number
Dim Elapsed As Number
Dim FrameRateStarted As Number
Dim FrameRateFrames As Number
Dim FramesPerSecond As Number
Dim Phase As Number
Dim DebugLayer As Number
Dim Preset As Text
Dim Enabled As Boolean
Dim Paused As Boolean
Dim Hdr As Boolean
Dim Soft As Boolean
Dim Distortion As Boolean
Dim Turbulence As Boolean
Dim Wind As Boolean
Dim Ok As Boolean

Game Window "Smile 2.0 - Advance Native Fire Lab" Size 1280 By 720

Station = 1
Quality = 3
Mode = 3
Enabled = True
Hdr = True
Soft = True
Distortion = True
Turbulence = True
DebugLayer = -1
BackgroundIndex = 3
FloorVisible = True
GridVisible = True
UiVisibility = 0

Call Graphics3D.ResetRenderer3D()

Camera = Graphics3D.DefaultCamera()
Camera.Position.X = 230
Camera.Position.Y = 170
Camera.Position.Z = -450
Camera.Target.Y = 90
Camera.Target.Z = 50
BaseCamera = Camera
ZoomTarget = 650
ZoomLive = 650000
Cinematic = True
Demo = True
Arena = Arena3D.Create(ARENA_WIDTH, ARENA_DEPTH, 210, 120, 40,
    ARENA_TILE_SIZE, ARENA_LINE_THICKNESS)

Call Graphics3D.DestroyMaterial3D(Arena.GridMaterial)

Arena.GridMaterial = Graphics3D.CreateMaterial3D(GridTexture,
    Graphics3D.MATERIAL_ALPHA_OPAQUE, 210, 120, 40, 100, True, 0, 50)
Ok = Graphics3D.SetObjectMaterial3D(Arena.Grid, Arena.GridMaterial)

Landscape = StaticBackdrop3D.Create("Assets/Backgrounds/SinStarLandscape.png")
TitleBackdrop = StaticBackdrop3D.Create("Assets/Backgrounds/SinStarTitleWithLogo.png")
Ok = StaticBackdrop3D.SetActive(Landscape)

Ok = Fire.Initialize("Assets/Fire")

Call ApplyModes()
Call Restart()

Previous = Timer()
FrameRateStarted = Previous

Do

    Get Key Key

    If Key = KEY_BACKTICK Then

        UiVisibility = (UiVisibility + 1) Mod 3
        SliderDragOwner = 0

    Else If Key = KEY_TAB Then

        Demo = False
        Station = Station Mod 8 + 1

        Call FrameStation()
        Call Restart()

    Else If Key = KEY_G Then

        Mode = Mode Mod 3 + 1

        Call Restart()

    Else If Key = KEY_B Then

        Call CycleBackground()

    Else If Key = KEY_1 Then

        DebugLayer = (DebugLayer + 2) Mod 6 - 1
        Ok = Fire.SetDebugLayer(Emitter, DebugLayer)

    Else If Key = KEY_F Then

        Enabled = Not Enabled

        Call Fire.SetEnabled(Emitter, Enabled)

    Else If Key = KEY_P Or Key = KEY_SPACE Then

        Paused = Not Paused

    Else If Key = KEY_R Then

        Call Restart()

    Else If Key = KEY_O Then

        Turbulence = Not Turbulence

        Call ApplyWind()

    Else If Key = KEY_W Then

        Wind = Not Wind

        Call ApplyWind()

    Else If Key = KEY_D Then

        Distortion = Not Distortion

        Call ApplyModes()

    Else If Key = KEY_S Then

        Soft = Not Soft

        Call ApplyModes()

    Else If Key = KEY_CONTROL Then

        Hdr = Not Hdr

        Call ApplyModes()

    End If

    Elapsed = Min(50, Max(0, Timer() - Previous))
    Previous = Timer()
    FrameRateFrames = FrameRateFrames + 1

    If Previous - FrameRateStarted >= 500 Then

        FramesPerSecond = FrameRateFrames * 1000 / (Previous - FrameRateStarted)
        FrameRateFrames = 0
        FrameRateStarted = Previous

    End If

    Call UpdateCamera()

    If Demo And Not Paused Then

        DemoTime = DemoTime + Elapsed

        If DemoTime >= 12000 Then

            DemoTime = 0
            Station = Station Mod 7 + 1

            Call FrameStation()
            Call Restart()

        Else If Station = 6 And Time >= 3000 Then

            Call Restart()

        End If

    End If

    If Not Paused Then

        Time = Time + Elapsed

        If Station = 4 Or Station = 5 Then

            Phase = Time Mod 6000

            If Phase > 3000 Then
                Phase = 6000 - Phase
            End If

            Source.X = Phase / 10 - 150
            Tip.X = Source.X + 120

            If Station = 4 Then
                Ok = Fire.SetSegment(Emitter, Source, Tip)
            Else
                Ok = Fire.SetPosition(Emitter, Source)
            End If

        End If

        Call Fire.Update(Elapsed)

    End If

    Light = Fire.LightPosition(Emitter)
    Ok = Graphics3D.SetPointLight3D(0, Light.X, Light.Y, Light.Z, 255, 170, 65,
        Fire.LightIntensity(Emitter), 260)
    Ok = BeginScene()
    Ok = Arena3D.Draw(Arena, FloorVisible, GridVisible) And Ok
    Ok = Fire.Draw(Emitter) And Ok

    If Comparison.Slot <> 0 Then
        Ok = Fire.Draw(Comparison) And Ok
    End If

    Ok = Graphics3D.End3DChecked() And Ok

    Call DrawHud()

    Show Screen

Loop Until Key = KEY_ESCAPE Or Game_Closed()

Call Fire.Shutdown()
Call StaticBackdrop3D.Destroy(Landscape)
Call StaticBackdrop3D.Destroy(TitleBackdrop)
Call Graphics3D.ResetRenderer3D()

Function PanelX() As Number

    Dim Result As Number

    Result = Window_Width() - 268
    Return Result

End Function

Function StationLabel(Value As Number) As Text

    If Value = 1 Then
        Return "Torch"
    Else If Value = 2 Then
        Return "Windy Torch"
    Else If Value = 3 Then
        Return "Brazier"
    Else If Value = 4 Then
        Return "Line Fire"
    Else If Value = 5 Then
        Return "Fireball"
    Else If Value = 6 Then
        Return "Fire Burst"
    Else If Value = 7 Then
        Return "Dragon Breath"
    End If

    Return "CPU / GPU"

End Function

Sub CycleBackground()

    BackgroundIndex = (BackgroundIndex + 1) Mod 5

    Call ApplyBackground()

End Sub

Sub ApplyBackground()

    If BackgroundIndex = 3 Then
        Ok = StaticBackdrop3D.SetActive(Landscape)
    Else If BackgroundIndex = 4 Then
        Ok = StaticBackdrop3D.SetActive(TitleBackdrop)
    Else
        Ok = StaticBackdrop3D.ClearActive()
    End If

End Sub

Function BeginScene() As Boolean

    Dim Result As Boolean

    If BackgroundIndex = 1 Then
        Result = Graphics3D.Begin3D(Camera, 0, 96, 32)
    Else If BackgroundIndex = 2 Then
        Result = Graphics3D.Begin3D(Camera, 62, 20, 96)
    Else
        Result = Graphics3D.Begin3D(Camera, 0, 0, 0)
    End If

    Return Result

End Function

Function BackgroundLabel() As Text

    If BackgroundIndex = 1 Then
        Return "BG Green"
    Else If BackgroundIndex = 2 Then
        Return "BG Purple"
    Else If BackgroundIndex = 3 Then
        Return "BG Landscape"
    Else If BackgroundIndex = 4 Then
        Return "BG Title"
    End If

    Return "BG Black"

End Function

Sub DrawHud()

    Dim X As Number
    Dim Row As Number

    If UiVisibility = 2 Then
        Return
    End If

    X = PanelX()

    Draw Text "SMILE 2.0 - ADVANCE NATIVE FIRE LAB" At 18, 14 Size 20 Color Cyan
    Draw Text Preset At 18, 46 Size 12 Color Light_Gray
    Draw Text "FPS" At 18, 72 Size 12 Color Light_Gray
    Draw Number FramesPerSecond At 54, 72 Size 12 Color Cyan

    If UiVisibility = 0 Then

        Call UI.DrawButton(X, 18, 60, 34, "Fire", Enabled)
        Call UI.DrawButton(X + 64, 18, 60, 34, HdrLabel(), Hdr)
        Call UI.DrawButton(X + 128, 18, 60, 34, "Depth", Soft)
        Call UI.DrawButton(X + 192, 18, 60, 34, "Heat", Distortion)
        Call UI.DrawButton(X, 56, 80, 22, "Turbulence", Turbulence)
        Call UI.DrawButton(X + 84, 56, 80, 22, "Wind", Wind)
        Call UI.DrawButton(X + 168, 56, 84, 22, "Demo", Demo)
        Call UI.DrawPanel(X, 82, 252, Max(446, Window_Height() - 94))

        Draw Text "Fire Status" At X + 16, 98 Size 16 Color White

        Draw Text "Running" At X + 16, 126 Size 11 Color Light_Gray
        Draw Text BackendLabel(Fire.Value(3, Emitter)) At X + 114, 126 Size 11 Color Cyan
        Draw Text "Quality" At X + 16, 148 Size 11 Color Light_Gray
        Draw Text QualityLabel(Fire.Value(2, Emitter)) At X + 114, 148 Size 11 Color Cyan

        Call DrawStat("Particles", 170, Fire.Value(6, Emitter))
        Call DrawStat("Systems", 192, Fire.Value(7, Emitter))
        Call DrawStat("Spawned", 214, Fire.Value(4, Emitter))
        Call DrawStat("Dropped", 236, Fire.Value(5, Emitter))
        Call DrawStat("GPU bytes", 258, Graphics3D.GpuParticleValue3D(17))
        Call DrawStat("Scene AA Samples", 280, Graphics3D.M5Value3D(13, 0))
        Call DrawStat("Error", 302, Fire.Value(12, Empty))

        Draw Text "Fire Sequences" At X + 12, 330 Size 12 Color White

        For Row = 0 To 7
            Call UI.DrawButton(X + 12 + (Row Mod 2) * 118, 352 + (Row / 2) * 24,
                110, 22, StationLabel(Row + 1), Station = Row + 1)
        End For

        Call UI.DrawButton(X + 12, 456, 110, 22, QualityLabel(Quality), True)
        Call UI.DrawButton(X + 130, 456, 110, 22, BackendLabel(Mode), True)
        Call UI.DrawButton(X + 12, 484, 110, 22, "Auto Orbit", Cinematic)
        Call UI.DrawButton(X + 130, 484, 110, 22, "Restart Fire", False)
        Call UI.DrawButton(X + 12, 512, 110, 22, "Floor / Grid", FloorVisible Or GridVisible)
        Call UI.DrawButton(X + 130, 512, 110, 22, BackgroundLabel(), BackgroundIndex > 0)
        Call DrawCameraSlider("H Orbit", Window_Height() - 142, CameraControls.OrbitYaw, -180, 180)
        Call DrawCameraSlider("V Orbit", Window_Height() - 116, CameraControls.OrbitPitch, -75, 75)
        Call DrawCameraSlider("Zoom", Window_Height() - 90, ZoomTarget, 300, 2200)
        Call UI.DrawButton(X + 12, Window_Height() - 64, 110, 24, "Close-up", False)
        Call UI.DrawButton(X + 130, Window_Height() - 64, 110, 24, "Reset View", False)

    End If

    Draw Text "LMB pan  /  MMB orbit  /  Wheel zoom  /  RMB reset  /  Space pause" At 18, Window_Height() - 20 Size 10 Color Light_Gray

    If Paused Then
        Draw Text "Movement paused - camera controls remain active" At 18, 98 Size 12 Color Yellow
    End If

End Sub

Function HdrLabel() As Text

    If Hdr Then
        Return "HDR On"
    End If

    Return "LDR"

End Function

Function BackendLabel(Value As Number) As Text

    If Value = 1 Then
        Return "CPU"
    Else If Value = 2 Then
        Return "GPU"
    Else If Value = 3 Then
        Return "Auto"
    End If

    Return "Unavailable"

End Function

Function QualityLabel(Value As Number) As Text

    If Value = 1 Then
        Return "Low"
    Else If Value = 2 Then
        Return "Medium"
    Else If Value = 3 Then
        Return "High"
    End If

    Return "Unavailable"

End Function

Sub DrawStat(Label As Text, Y As Number, Value As Number)

    Draw Text Label At PanelX() + 16, Y Size 11 Color Light_Gray
    Draw Number Value At PanelX() + 214, Y Size 11 Color Cyan

End Sub

Sub DrawCameraSlider(Label As Text, Y As Number, Value As Number,
    MinimumValue As Number, MaximumValue As Number)

    Draw Text Label At PanelX() + 12, Y + 2 Size 11 Color Light_Gray

    Call UI.DrawSlider(PanelX() + 76, Y, 144, 16, Value, MinimumValue, MaximumValue)

    Draw Number Value At PanelX() + 226, Y + 2 Size 10 Color Cyan

End Sub

Sub ResetView()

    Call Interaction.ResetCameraControls(CameraControls)

    ZoomTarget = 1000
    Cinematic = False
    CinematicYaw1000 = 0
    SliderDragOwner = 0
    PanRemainderX = 0
    PanRemainderY = 0
    OrbitRemainderX = 0
    OrbitRemainderY = 0

End Sub

Sub ResetDemo()

    Call ResetView()

    UiVisibility = 0
    Station = 1
    Demo = True
    DemoTime = 0
    Cinematic = True
    Paused = False
    Hdr = True
    Soft = True
    Distortion = True
    Turbulence = True
    Wind = False
    Mode = Fire.SIMULATION_AUTO
    Quality = Fire.QUALITY_HIGH
    FloorVisible = True
    GridVisible = True
    BackgroundIndex = 3

    Call ApplyBackground()
    Call FrameStation()
    Call ApplyModes()
    Call Restart()

End Sub

Function HandleUi() As Boolean

    Dim X As Number
    Dim Row As Number
    Dim Handled As Boolean

    If UiVisibility <> 0 Then
        Return False
    End If

    X = PanelX()

    If UI.UpdateSlider(SliderDragOwner, 1, X + 76, Window_Height() - 142,
        144, 16, -180, 180, 1, CameraControls.OrbitYaw) Then

        Cinematic = False
        CinematicYaw1000 = 0
        Return True

    End If

    If UI.UpdateSlider(SliderDragOwner, 2, X + 76, Window_Height() - 116,
        144, 16, -75, 75, 1, CameraControls.OrbitPitch) Then
        Return True
    End If

    If UI.UpdateSlider(SliderDragOwner, 3, X + 76, Window_Height() - 90,
        144, 16, 300, 2200, -10, ZoomTarget) Then
        Return True
    End If

    If UI.Clicked(X, 18, 60, 34) Then
        Enabled = Not Enabled

        Call Fire.SetEnabled(Emitter, Enabled)
    Else If UI.Clicked(X + 64, 18, 60, 34) Then
        Hdr = Not Hdr

        Call ApplyModes()
    Else If UI.Clicked(X + 128, 18, 60, 34) Then
        Soft = Not Soft

        Call ApplyModes()
    Else If UI.Clicked(X + 192, 18, 60, 34) Then
        Distortion = Not Distortion

        Call ApplyModes()
    Else If UI.Clicked(X, 56, 80, 22) Then
        Turbulence = Not Turbulence

        Call ApplyWind()
    Else If UI.Clicked(X + 84, 56, 80, 22) Then
        Wind = Not Wind

        Call ApplyWind()
    Else If UI.Clicked(X + 168, 56, 84, 22) Then
        Demo = Not Demo
        DemoTime = 0
    Else If UI.Clicked(X + 12, 456, 110, 22) Then
        Quality = Quality Mod 3 + 1

        Call Restart()
    Else If UI.Clicked(X + 130, 456, 110, 22) Then
        Mode = Mode Mod 3 + 1

        Call Restart()
    Else If UI.Clicked(X + 12, 484, 110, 22) Then
        Cinematic = Not Cinematic
    Else If UI.Clicked(X + 130, 484, 110, 22) Then
        Call Restart()
    Else If UI.Clicked(X + 12, 512, 110, 22) Then
        FloorVisible = Not (FloorVisible Or GridVisible)
        GridVisible = FloorVisible
    Else If UI.Clicked(X + 130, 512, 110, 22) Then
        Call CycleBackground()
    Else If UI.Clicked(X + 12, Window_Height() - 64, 110, 24) Then
        ZoomTarget = 420
    Else If UI.Clicked(X + 130, Window_Height() - 64, 110, 24) Then
        Call ResetView()
    End If

    For Row = 0 To 7

        If UI.Clicked(X + 12 + (Row Mod 2) * 118, 352 + (Row / 2) * 24, 110, 22) Then

            Station = Row + 1
            Demo = False

            Call FrameStation()
            Call Restart()

        End If

    End For

    Handled = UI.Contains(X, 0, 268, Window_Height())
    Return Handled

End Function

Sub UpdateCamera()

    Dim OverPanel As Boolean
    Dim MoveX As Number
    Dim MoveY As Number
    Dim Ease As Number
    Dim Sine As Number
    Dim Cosine As Number
    Dim PitchSine As Number
    Dim PitchCosine As Number
    Dim Distance As Number
    Dim PanX As Number
    Dim PanY As Number
    Dim PanZ As Number

    OverPanel = HandleUi()

    If Pointer_Pressed(POINTER_SECONDARY) Then
        Call ResetDemo()
    End If

    If Not OverPanel Then

        If Pointer_Held(POINTER_MIDDLE) Then

            Cinematic = False
            OrbitRemainderX = OrbitRemainderX + Pointer_Delta_X()
            OrbitRemainderY = OrbitRemainderY + Pointer_Delta_Y()
            MoveX = OrbitRemainderX / 3
            MoveY = OrbitRemainderY / 3
            OrbitRemainderX = OrbitRemainderX - MoveX * 3
            OrbitRemainderY = OrbitRemainderY - MoveY * 3
            CameraControls.OrbitYaw = (CameraControls.OrbitYaw + MoveX) Mod 360
            CameraControls.OrbitPitch = Min(75, Max(-75, CameraControls.OrbitPitch + MoveY))

        Else If Pointer_Held(POINTER_PRIMARY) Then

            Cinematic = False
            PanRemainderX = PanRemainderX + Pointer_Delta_X() * ZoomTarget
            PanRemainderY = PanRemainderY + Pointer_Delta_Y() * ZoomTarget
            MoveX = PanRemainderX / 1600
            MoveY = PanRemainderY / 1600
            PanRemainderX = PanRemainderX - MoveX * 1600
            PanRemainderY = PanRemainderY - MoveY * 1600
            CameraControls.PanX = Min(500, Max(-500, CameraControls.PanX - MoveX))
            CameraControls.PanY = Min(350, Max(-350, CameraControls.PanY + MoveY))

        End If

    End If

    If Not OverPanel Then
        ZoomTarget = Min(2200, Max(300, ZoomTarget - Pointer_Wheel_Delta() * 80))
    End If

    Ease = (ZoomTarget * 1000 - ZoomLive) * Elapsed / (100 + Elapsed)
    ZoomLive = ZoomLive + Ease
    Camera = BaseCamera

    If Station = 4 Then
        Camera.Target.X = Source.X + 60
        Camera.Target.Y = 150
    Else If Station = 5 Then
        Camera.Target.X = Source.X
        Camera.Target.Y = 110
    Else If Station = 3 Then
        Camera.Target.Y = 145
    Else If Station = 7 Then
        Camera.Target.X = 80
        Camera.Target.Y = 60
    End If

    If Cinematic Then
        Ok = CameraMotion.AdvanceOrbitYaw1000(CinematicYaw1000, Elapsed, AUTO_ORBIT_SPEED)
    End If

    Sine = SmoothSine(CinematicYaw1000 + CameraControls.OrbitYaw * 1000 + START_YAW * 1000)
    Cosine = SmoothSine(CinematicYaw1000 + CameraControls.OrbitYaw * 1000 + (START_YAW + 90) * 1000)
    PitchSine = SmoothSine((START_PITCH + CameraControls.OrbitPitch) * 1000)
    PitchCosine = SmoothSine((START_PITCH + 90 + CameraControls.OrbitPitch) * 1000)
    Distance = 515 * ZoomLive / 1000000
    PanX = (Cosine * CameraControls.PanX -
        Sine * PitchSine * CameraControls.PanY / Core.FIXED_ONE) / Core.FIXED_ONE
    PanY = PitchCosine * CameraControls.PanY / Core.FIXED_ONE
    PanZ = (Sine * CameraControls.PanX +
        Cosine * PitchSine * CameraControls.PanY / Core.FIXED_ONE) / Core.FIXED_ONE
    Camera.Target.X = Camera.Target.X + PanX
    Camera.Target.Y = Camera.Target.Y + PanY
    Camera.Target.Z = Camera.Target.Z + PanZ
    Camera.Position.X = Camera.Target.X + Distance * Sine * PitchCosine / Core.FIXED_ONE / Core.FIXED_ONE
    Camera.Position.Y = Camera.Target.Y + Distance * PitchSine / Core.FIXED_ONE
    Camera.Position.Z = Camera.Target.Z - Distance * Cosine * PitchCosine / Core.FIXED_ONE / Core.FIXED_ONE
    Camera.UpDirection.X = 0
    Camera.UpDirection.Y = Core.FIXED_ONE
    Camera.UpDirection.Z = 0

End Sub

Sub FrameStation()

    ZoomTarget = 650
    CameraControls.PanX = 0
    CameraControls.PanY = 0
    CameraControls.OrbitPitch = 0

    If (Station = 3 Or
        Station = 7 Or
        Station = 8) Then
        ZoomTarget = 800
    Else If Station = 4 Or Station = 5 Then
        ZoomTarget = 700
    Else If Station = 6 Then
        ZoomTarget = 850
    End If

End Sub

Function SmoothSine(Angle1000 As Number) As Number

    Dim Angle As Number
    Dim Fraction As Number
    Dim Result As Number

    Angle1000 = (Angle1000 Mod 360000 + 360000) Mod 360000
    Angle = Angle1000 / 1000
    Fraction = Angle1000 Mod 1000
    Result = (FixedMath.SinFixed(Angle) * (1000 - Fraction) +
        FixedMath.SinFixed(Angle + 1) * Fraction) / 1000

    Return Result

End Function

Sub ApplyModes()

    Dim SoftMode As Number
    Dim DistortionMode As Number

    If Soft Then
        SoftMode = 1
    End If

    If Distortion Then
        DistortionMode = 1
    End If

    Ok = Graphics3D.ConfigureSoftDepth3D(SoftMode)
    Ok = Graphics3D.ConfigureDistortion3D(DistortionMode, 2)
    Ok = Graphics3D.ConfigurePostProcessing3D(Hdr, Hdr, Hdr, 100, 1400, 35, 2, 2, 4)

End Sub

Sub ApplyWind()

    Dim WindX As Number
    Dim Strength As Number

    If Wind Or Station = 2 Then
        WindX = 190
    End If

    If Turbulence Then
        Strength = 100
    End If

    Ok = Fire.SetWind(Emitter, WindX, 0, 0)
    Ok = Fire.SetTurbulence(Emitter, Strength)

End Sub

Sub Restart()

    Dim Radius As Number

    If Emitter.Slot <> 0 Then
        Ok = Fire.Destroy(Emitter)
    End If

    If Comparison.Slot <> 0 Then
        Ok = Fire.Destroy(Comparison)
    End If

    Source.X = 0
    Source.Y = 0
    Source.Z = 40
    Tip = Source
    Radius = 22
    Preset = "TorchFire"

    If Station = 3 Then

        Preset = "BrazierFire"
        Radius = 42

    Else If Station = 4 Then

        Preset = "LineFire"
        Radius = 14

    Else If Station = 5 Then

        Preset = "Fireball"
        Source.Y = 75

    Else If Station = 6 Then

        Preset = "FireBurstGen3"
        Radius = 35
        Source.Y = 75

    Else If Station = 7 Then

        Preset = "DragonFireBreathPreview"
        Radius = 26

    End If

    If Station = 4 Then

        Source.Y = 60
        Tip.Y = 120
        Tip.X = 120

    End If

    RestartSerial = RestartSerial + 1
    Emitter = Fire.StartAt(Preset, Source, 20260904 + RestartSerial * 7919, Quality, Mode, Radius)

    If Station = 4 Then
        Ok = Fire.SetSegment(Emitter, Source, Tip)
    End If

    If Station = 7 Then

        Direction.X = 210
        Direction.Y = 50
        Direction.Z = 0
        Ok = Fire.SetDirection(Emitter, Direction)

    End If

    If Station = 8 Then

        Source.X = -120
        Comparison = Fire.StartAt("TorchFire", Source, 20260904, 1, 1, Radius)
        Preset = "CPU Low (left) / Requested Backend (right)"

    End If

    Time = 0
    Enabled = True
    DebugLayer = -1

    Call ApplyWind()

End Sub
