Option Explicit

Import Smile.UI.Controls As UI
Import Smile.Simple3D.Arena3D As Arena3D
Import Smile.Simple3D.ArenaBackdrop3D As Backdrop
Import Smile.Simple3D.Core As Core
Import Smile.Simple3D.Graphics3D As Graphics3D
Import Smile.Simple3D.FireEmitter3D As Fire
Import Smile.Simple3D.ArenaCamera3D As ArenaCamera
Import Smile.Simple3D.PrecisionCamera3D As PreciseCamera
Import Smile.Simple3D.Precision3D As P
Import Smile.Tools.FireLabCharacters As Characters

Const ARENA_WIDTH = 1000
Const ARENA_DEPTH = 800
Const AUTO_ORBIT_SPEED = 5

Dim Camera As P.Camera3D
Dim BaseCamera As P.Camera3D
Dim CameraControls As PreciseCamera.Controls
Dim Zoom As PreciseCamera.ZoomState
Dim OrbitSlider As Number
Dim ZoomTarget As Number
Dim SliderDragOwner As Number
Dim Cinematic As Boolean
Dim Demo As Boolean
Dim DemoTime As Number
Dim Arena As Arena3D.ArenaFloor
Dim Backgrounds As Backdrop.State
Dim BackgroundIndex As Number
Dim FloorVisible As Boolean
Dim GridVisible As Boolean
Dim UiVisibility As Number
Dim Emitter As Fire.FireEmitter
Dim Comparison As Fire.FireEmitter
Dim Source As Core.Vector3
Dim Tip As Core.Vector3
Dim Light As Core.Vector3
Dim Direction As Core.Vector3
Dim Empty As Fire.FireEmitter
Dim Key As Number
Dim Station As Number
Dim Quality As Number
Dim Mode As Number
Dim Time As Number
Dim RestartSerial As Number
Dim Previous As Number
Dim Elapsed As Number
Dim FrameRateStarted As Number
Dim FrameRateFrames As Number
Dim FramesPerSecond As Number
Dim Phase As Number
Dim DebugLayer As Number
Dim Preset As Text
Dim Enabled As Boolean
Dim Paused As Boolean
Dim Hdr As Boolean
Dim Soft As Boolean
Dim Distortion As Boolean
Dim Turbulence As Boolean
Dim Wind As Boolean
Dim Ok As Boolean
Dim Actors As Characters.State
Dim ActiveFire As Fire.FireEmitter

Game Window "Smile 2.0 - Advance Native Fire Lab" Size 1280 By 720

Station = 1
Quality = 3
Mode = 3
Enabled = True
Hdr = True
Soft = True
Distortion = True
Turbulence = True
DebugLayer = -1
BackgroundIndex = 3
FloorVisible = True
GridVisible = True
UiVisibility = 0

Call Graphics3D.ResetRenderer3D()

Camera = P.FromCamera(Graphics3D.DefaultCamera())
Camera.Position.X = 230.0
Camera.Position.Y = 170.0
Camera.Position.Z = -450.0
Camera.Target.Y = 90.0
Camera.Target.Z = 50.0
BaseCamera = Camera

Call ArenaCamera.Reset(CameraControls, Zoom)

Zoom.Target = 0.0
Cinematic = True
Demo = True
Arena = Arena3D.Create(1000, 800)

Backgrounds = Backdrop.Create()
Ok = Backdrop.Apply(Backgrounds, BackgroundIndex)

Ok = Fire.Initialize("Assets/Fire")

Call ApplyModes()
Call Characters.Start(Actors)
Call Restart()

Previous = Timer()
FrameRateStarted = Previous

Do

    Get Key Key

    Call Arena3D.HandleKey(Key, FloorVisible, GridVisible)

    If Key = KEY_BACKTICK Then

        UiVisibility = (UiVisibility + 1) Mod 3
        SliderDragOwner = 0

    Else If Key = KEY_X Then

        Actors.KaelSelected = Not Actors.KaelSelected
        Actors.Active = True
        Demo = True

        Call Restart()

    Else If Key = KEY_TAB Then

        Demo = False
        Actors.Active = False
        Station = Station Mod 8 + 1

        Call FrameStation()
        Call Restart()

    Else If Key = KEY_E Then

        Mode = Mode Mod 3 + 1

        Call Restart()

    Else If Key = KEY_B Then

        Call CycleBackground()

    Else If Key = KEY_1 Then

        DebugLayer = (DebugLayer + 2) Mod 6 - 1

        If ActiveFire.Slot <> 0 Then
            Ok = Fire.SetDebugLayer(ActiveFire, DebugLayer)
        End If

    Else If Key = KEY_O Then

        Enabled = Not Enabled

        If Emitter.Slot <> 0 Then
            Call Fire.SetEnabled(Emitter, Enabled)
        End If

    Else If Key = KEY_P Or Key = KEY_SPACE Then

        Paused = Not Paused

    Else If Key = KEY_R Then

        Call Restart()

    Else If Key = KEY_O Then

        Turbulence = Not Turbulence

        Call ApplyWind()

    Else If Key = KEY_W Then

        Wind = Not Wind

        Call ApplyWind()

    Else If Key = KEY_D Then

        Distortion = Not Distortion

        Call ApplyModes()

    Else If Key = KEY_S Then

        Soft = Not Soft

        Call ApplyModes()

    Else If Key = KEY_CONTROL Then

        Hdr = Not Hdr

        Call ApplyModes()

    End If

    Elapsed = Min(50, Max(0, Timer() - Previous))
    Previous = Timer()
    FrameRateFrames = FrameRateFrames + 1

    If Previous - FrameRateStarted >= 500 Then

        FramesPerSecond = FrameRateFrames * 1000 / (Previous - FrameRateStarted)
        FrameRateFrames = 0
        FrameRateStarted = Previous

    End If

    Call UpdateCamera()

    If (Demo And
        Not Paused And
        Not Actors.Active) Then

        DemoTime = DemoTime + Elapsed

        If DemoTime >= 12000 Then

            DemoTime = 0
            Station = Station Mod 7 + 1

            Call FrameStation()
            Call Restart()

        Else If Station = 6 And Time >= 3000 Then

            Call Restart()

        End If

    End If

    If Not Paused Then

        Time = Time + Elapsed

        If Not Actors.Active And (Station = 4 Or Station = 5) Then

            Phase = Time Mod 6000

            If Phase > 3000 Then
                Phase = 6000 - Phase
            End If

            Source.X = Phase / 10 - 150
            Tip.X = Source.X + 120

            If Station = 4 Then
                Ok = Fire.SetSegment(Emitter, Source, Tip)
            Else
                Ok = Fire.SetPosition(Emitter, Source)
            End If

        End If

        Call Characters.Update(Actors, Elapsed, Demo, Enabled, Quality, Mode, Wind, Turbulence)

        If Actors.Active Then
            Call Fire.Update(Elapsed * 2)
        Else

            Call Fire.Update(Elapsed)
        End If

    End If

    ActiveFire = Emitter

    If Actors.Active Then
        ActiveFire = Characters.ActiveEmitter(Actors)
    End If

    Light = Fire.LightPosition(ActiveFire)
    Ok = Graphics3D.SetPointLight3D(0, Light.X, Light.Y, Light.Z, 255, 170, 65,
        Fire.LightIntensity(ActiveFire), 260)
    Ok = BeginScene() And Ok
    Ok = Arena3D.Draw(Arena, FloorVisible, GridVisible) And Ok

    If Actors.Active Then
        Ok = Characters.Draw(Actors) And Ok
    Else
        Ok = Fire.Draw(Emitter) And Ok
    End If

    If Comparison.Slot <> 0 Then
        Ok = Fire.Draw(Comparison) And Ok
    End If

    Ok = Graphics3D.End3DChecked() And Ok

    Call DrawHud()

    Show Screen

Loop Until Key = KEY_ESCAPE Or Game_Closed()

Call Characters.Shutdown(Actors)
Call Fire.Shutdown()
Call Backdrop.Destroy(Backgrounds)
Call Graphics3D.ResetRenderer3D()

Function PanelX() As Number

    Dim Result As Number

    Result = Window_Width() - 268
    Return Result

End Function

Function StationLabel(Value As Number) As Text

    If Value = 1 Then
        Return "Torch"
    Else If Value = 2 Then
        Return "Windy Torch"
    Else If Value = 3 Then
        Return "Brazier"
    Else If Value = 4 Then
        Return "Line Fire"
    Else If Value = 5 Then
        Return "Fireball"
    Else If Value = 6 Then
        Return "Fire Burst"
    Else If Value = 7 Then
        Return "Dragon Breath"
    End If

    Return "CPU / GPU"

End Function

Sub CycleBackground()

    Call Backdrop.Cycle(BackgroundIndex)

    Call ApplyBackground()

End Sub

Sub ApplyBackground()

    Ok = Backdrop.Apply(Backgrounds, BackgroundIndex)

End Sub

Function BeginScene() As Boolean

    Dim Result As Boolean

    Result = Arena3D.ConfigureForFrame(Arena, FloorVisible, True)
    Result = P.SetCamera(Camera) And Result

    Result = Backdrop.BeginFrame(Backgrounds, BackgroundIndex) And Result

    Return Result

End Function

Function BackgroundLabel() As Text

    If BackgroundIndex = 1 Then
        Return "BG Green"
    Else If BackgroundIndex = 2 Then
        Return "BG Purple"
    Else If BackgroundIndex = 3 Then
        Return "BG Landscape"
    Else If BackgroundIndex = 4 Then
        Return "BG Title"
    End If

    Return "BG Black"

End Function

Sub DrawHud()

    Dim X As Number
    Dim Row As Number
    Dim DisplayedQuality As Number

    If UiVisibility = 2 Then
        Return
    End If

    X = PanelX()

    Draw Text "SMILE 2.0 - ADVANCE NATIVE FIRE LAB" At 18, 14 Size 20 Color White
    Draw Text Preset At 18, 46 Size 12 Color Light_Gray
    Draw Text "FPS" At 18, 72 Size 12 Color Light_Gray
    Draw Number FramesPerSecond At 54, 72 Size 12 Color Cyan

    If UiVisibility = 0 Then

        Call Characters.DrawUi(Actors)

        DisplayedQuality = Quality

        If ActiveFire.Slot <> 0 Then
            DisplayedQuality = Fire.Value(2, ActiveFire)
        End If

        Call UI.DrawButton(X, 18, 60, 34, "Fire", Enabled)
        Call UI.DrawButton(X + 64, 18, 60, 34, HdrLabel(), Hdr)
        Call UI.DrawButton(X + 128, 18, 60, 34, "Depth", Soft)
        Call UI.DrawButton(X + 192, 18, 60, 34, "Heat", Distortion)
        Call UI.DrawButton(X, 56, 80, 22, "Turbulence", Turbulence)
        Call UI.DrawButton(X + 84, 56, 80, 22, "Wind", Wind)
        Call UI.DrawButton(X + 168, 56, 84, 22, "Demo", Demo)
        Call UI.DrawPanel(X, 82, 252, Max(446, Window_Height() - 94))

        Draw Text "Fire Status" At X + 16, 98 Size 16 Color White

        Draw Text "Running" At X + 16, 126 Size 11 Color Light_Gray

        If Actors.Active And ActiveFire.Slot = 0 Then
            Draw Text "Preparing" At X + 114, 126 Size 11 Color Cyan
        Else
            Draw Text BackendLabel(Fire.Value(3, ActiveFire)) At X + 114, 126 Size 11 Color Cyan
        End If

        Draw Text "Quality" At X + 16, 148 Size 11 Color Light_Gray
        Draw Text QualityLabel(DisplayedQuality) At X + 114, 148 Size 11 Color Cyan

        Call DrawStat("Particles", 170, Fire.Value(6, ActiveFire))
        Call DrawStat("Systems", 192, Fire.Value(7, ActiveFire))
        Call DrawStat("Spawned", 214, Fire.Value(4, ActiveFire))
        Call DrawStat("Dropped", 236, Fire.Value(5, ActiveFire))
        Call DrawStat("GPU bytes", 258, Graphics3D.GpuParticleValue3D(17))
        Call DrawStat("Scene AA Samples", 280, Graphics3D.M5Value3D(13, 0))
        Call DrawStat("Error", 302, Fire.Value(12, Empty))

        Draw Text "Fire Sequences" At X + 12, 330 Size 12 Color White

        For Row = 0 To 7
            Call UI.DrawButton(X + 12 + (Row Mod 2) * 118, 352 + (Row / 2) * 24,
                110, 22, StationLabel(Row + 1), Not Actors.Active And Station = Row + 1)
        End For

        Call UI.DrawButton(X + 12, 456, 110, 22, QualityLabel(Quality), True)
        Call UI.DrawButton(X + 130, 456, 110, 22, BackendLabel(Mode), True)
        Call UI.DrawButton(X + 12, 484, 110, 22, "Auto Orbit", Cinematic)
        Call UI.DrawButton(X + 130, 484, 110, 22, "Restart Fire", False)
        Call UI.DrawButton(X + 12, 512, 110, 22, "Floor (F)", FloorVisible)
        Call UI.DrawButton(X + 130, 512, 110, 22, BackgroundLabel(), BackgroundIndex > 0)
        Call DrawCameraSlider("H Orbit", Window_Height() - 142, ToNumber(CameraControls.OrbitYaw), -180, 180)
        Call DrawCameraSlider("V Orbit", Window_Height() - 116, ToNumber(CameraControls.OrbitPitch), -75, 75)
        Call DrawCameraSlider("Zoom", Window_Height() - 90, ZoomTarget, -144, 36)
        Call UI.DrawButton(X + 12, Window_Height() - 64, 110, 24, "Close-up", False)
        Call UI.DrawButton(X + 130, Window_Height() - 64, 110, 24, "Reset View", False)

    End If

    Draw Text "LMB Pan / MMB Orbit / Wheel Zoom / RMB Reset / Space Pause / F Floor / G Grid / B Background" At 18, Window_Height() - 20 Size 10 Color Light_Gray

    If Paused Then
        Draw Text "Movement paused - camera controls remain active" At 18, 224 Size 12 Color Yellow
    End If

End Sub

Function HdrLabel() As Text

    If Hdr Then
        Return "HDR On"
    End If

    Return "LDR"

End Function

Function BackendLabel(Value As Number) As Text

    If Value = 1 Then
        Return "CPU"
    Else If Value = 2 Then
        Return "GPU"
    Else If Value = 3 Then
        Return "Auto"
    End If

    Return "Unavailable"

End Function

Function QualityLabel(Value As Number) As Text

    If Value = 1 Then
        Return "Low"
    Else If Value = 2 Then
        Return "Medium"
    Else If Value = 3 Then
        Return "High"
    End If

    Return "Unavailable"

End Function

Sub DrawStat(Label As Text, Y As Number, Value As Number)

    Draw Text Label At PanelX() + 16, Y Size 11 Color Light_Gray
    Draw Number Value At PanelX() + 214, Y Size 11 Color Cyan

End Sub

Sub DrawCameraSlider(Label As Text, Y As Number, Value As Number,
    MinimumValue As Number, MaximumValue As Number)

    Draw Text Label At PanelX() + 12, Y + 2 Size 11 Color Light_Gray

    Call UI.DrawSlider(PanelX() + 76, Y, 144, 16, Value, MinimumValue, MaximumValue)

    Draw Number Value At PanelX() + 226, Y + 2 Size 10 Color Cyan

End Sub

Sub ResetView()

    Call ArenaCamera.Reset(CameraControls, Zoom)

    ZoomTarget = ArenaCamera.DEFAULT_ZOOM
    Cinematic = False
    SliderDragOwner = 0

End Sub

Sub ResetDemo()

    Call ResetView()

    UiVisibility = 0
    Station = 1
    Demo = True
    DemoTime = 0
    Cinematic = True
    Paused = False
    Hdr = True
    Soft = True
    Distortion = True
    Turbulence = True
    Wind = False
    Mode = Fire.SIMULATION_AUTO
    Quality = Fire.QUALITY_HIGH
    FloorVisible = True
    GridVisible = True
    BackgroundIndex = 3

    Call ApplyBackground()
    Call FrameStation()
    Call ApplyModes()
    Call Restart()

End Sub

Function HandleUi() As Boolean

    Dim X As Number
    Dim Row As Number
    Dim Handled As Boolean

    If UiVisibility <> 0 Then
        Return False
    End If

    X = PanelX()

    If Characters.HandleUi(Actors, Demo) Then

        If Actors.Active And Emitter.Slot <> 0 Then
            Ok = Fire.Destroy(Emitter)
        End If

        If Actors.Active And Comparison.Slot <> 0 Then
            Ok = Fire.Destroy(Comparison)
        End If

        Return True

    End If

    OrbitSlider = ToNumber(CameraControls.OrbitYaw)

    If UI.UpdateSlider(SliderDragOwner, 1, X + 76, Window_Height() - 142,
        144, 16, -180, 180, 1, OrbitSlider) Then

        CameraControls.OrbitYaw = ToDouble(OrbitSlider)

        Cinematic = False
        Return True

    End If

    OrbitSlider = ToNumber(CameraControls.OrbitPitch)

    If UI.UpdateSlider(SliderDragOwner, 2, X + 76, Window_Height() - 116,
        144, 16, -75, 75, 1, OrbitSlider) Then
        CameraControls.OrbitPitch = ToDouble(OrbitSlider)
        Return True
    End If

    If UI.UpdateSlider(SliderDragOwner, 3, X + 76, Window_Height() - 90,
        144, 16, -144, 36, -1, ZoomTarget) Then
        Zoom.Target = ToDouble(ZoomTarget)
        Return True
    End If

    If UI.Clicked(X, 18, 60, 34) Then

        Enabled = Not Enabled

        If Emitter.Slot <> 0 Then
            Call Fire.SetEnabled(Emitter, Enabled)
        End If

    Else If UI.Clicked(X + 64, 18, 60, 34) Then

        Hdr = Not Hdr

        Call ApplyModes()

    Else If UI.Clicked(X + 128, 18, 60, 34) Then

        Soft = Not Soft

        Call ApplyModes()

    Else If UI.Clicked(X + 192, 18, 60, 34) Then

        Distortion = Not Distortion

        Call ApplyModes()

    Else If UI.Clicked(X, 56, 80, 22) Then

        Turbulence = Not Turbulence

        Call ApplyWind()

    Else If UI.Clicked(X + 84, 56, 80, 22) Then

        Wind = Not Wind

        Call ApplyWind()

    Else If UI.Clicked(X + 168, 56, 84, 22) Then

        Demo = Not Demo
        DemoTime = 0

    Else If UI.Clicked(X + 12, 456, 110, 22) Then

        Quality = Quality Mod 3 + 1

        Call Restart()

    Else If UI.Clicked(X + 130, 456, 110, 22) Then

        Mode = Mode Mod 3 + 1

        Call Restart()

    Else If UI.Clicked(X + 12, 484, 110, 22) Then

        Cinematic = Not Cinematic

    Else If UI.Clicked(X + 130, 484, 110, 22) Then

        Call Restart()

    Else If UI.Clicked(X + 12, 512, 110, 22) Then

        FloorVisible = Not FloorVisible

    Else If UI.Clicked(X + 130, 512, 110, 22) Then

        Call CycleBackground()

    Else If UI.Clicked(X + 12, Window_Height() - 64, 110, 24) Then

        Zoom.Target = -72.0

    Else If UI.Clicked(X + 130, Window_Height() - 64, 110, 24) Then

        Call ResetView()

    End If

    For Row = 0 To 7

        If UI.Clicked(X + 12 + (Row Mod 2) * 118, 352 + (Row / 2) * 24, 110, 22) Then

            Station = Row + 1
            Actors.Active = False
            Demo = False

            Call FrameStation()
            Call Restart()

        End If

    End For

    Handled = UI.Contains(X, 0, 268, Window_Height())
    Return Handled

End Function

Sub UpdateCamera()

    Dim OverPanel As Boolean

    ZoomTarget = ToNumber(Zoom.Target)
    OverPanel = HandleUi()

    If Pointer_Pressed(POINTER_SECONDARY) Then
        Call ResetView()
    End If

    If ArenaCamera.UpdatePointer(CameraControls, Zoom, ArenaCamera.ReadPointer(OverPanel)) Then
        Cinematic = False
    End If

    If Cinematic Then
        CameraControls.OrbitYaw = PreciseCamera.NormalizeAngle(CameraControls.OrbitYaw +
            ToDouble(Elapsed) * ToDouble(AUTO_ORBIT_SPEED) / 1000.0)
    End If

    Call ArenaCamera.Advance(CameraControls, Zoom, Elapsed)

    Camera = BaseCamera

    If Actors.Active Then
        Camera.Target = P.Vector(25.0, 65.0, 0.0)
    Else If Station = 4 Then
        Camera.Target = P.Vector(ToDouble(Source.X + 60), 150.0, Camera.Target.Z)
    Else If Station = 5 Then
        Camera.Target = P.Vector(ToDouble(Source.X), 110.0, Camera.Target.Z)
    Else If Station = 3 Then
        Camera.Target.Y = 145.0
    Else If Station = 7 Then
        Camera.Target = P.Vector(80.0, 60.0, Camera.Target.Z)
    End If

    Camera.Position = P.Vector(Camera.Target.X + 230.0, Camera.Target.Y + 120.0,
        Camera.Target.Z - 500.0)
    Camera = ArenaCamera.Compose(Camera, CameraControls)

    If FloorVisible Then
        Call PreciseCamera.KeepCameraAboveGround(Camera, 0.0)
    End If

End Sub

Sub FrameStation()

    If Actors.Active Then
        Zoom.Target = 0.0
        Return
    End If

    Call ArenaCamera.Reset(CameraControls, Zoom)

    Zoom.Target = -16.0
    CameraControls.PanX = 0.0
    CameraControls.PanY = 0.0
    CameraControls.OrbitPitch = 0.0

    If (Station = 3 Or
        Station = 7 Or
        Station = 8) Then
        Zoom.Target = -8.0
    Else If Station = 4 Or Station = 5 Then
        Zoom.Target = -12.0
    Else If Station = 6 Then
        Zoom.Target = -4.0
    End If

End Sub

Sub ApplyModes()

    Dim SoftMode As Number
    Dim DistortionMode As Number

    If Soft Then
        SoftMode = 1
    End If

    If Distortion Then
        DistortionMode = 1
    End If

    Ok = Graphics3D.ConfigureSoftDepth3D(SoftMode)
    Ok = Graphics3D.ConfigureDistortion3D(DistortionMode, 2)
    Ok = Graphics3D.ConfigurePostProcessing3D(Hdr, Hdr, Hdr, 100, 1400, 35, 2, 2, 4)

End Sub

Sub ApplyWind()

    Dim WindX As Number
    Dim Strength As Number

    If Actors.Active Then
        Return
    End If

    If Wind Or Station = 2 Then
        WindX = 190
    End If

    If Turbulence Then
        Strength = 100
    End If

    Ok = Fire.SetWind(Emitter, WindX, 0, 0)
    Ok = Fire.SetTurbulence(Emitter, Strength)

End Sub

Sub Restart()

    Dim Radius As Number

    If Emitter.Slot <> 0 Then
        Ok = Fire.Destroy(Emitter)
    End If

    If Comparison.Slot <> 0 Then
        Ok = Fire.Destroy(Comparison)
    End If

    Call Characters.Restart(Actors)

    If Actors.Active Then

        Preset = "Character Fire Preview"
        Enabled = True
        Return

    End If

    Source.X = 0
    Source.Y = 0
    Source.Z = 40
    Tip = Source
    Radius = 22
    Preset = "TorchFire"

    If Station = 3 Then

        Preset = "BrazierFire"
        Radius = 42

    Else If Station = 4 Then

        Preset = "LineFire"
        Radius = 14

    Else If Station = 5 Then

        Preset = "Fireball"
        Source.Y = 75

    Else If Station = 6 Then

        Preset = "FireBurstGen3"
        Radius = 35
        Source.Y = 75

    Else If Station = 7 Then

        Preset = "DragonFireBreathPreview"
        Radius = 26

    End If

    If Station = 4 Then

        Source.Y = 60
        Tip.Y = 120
        Tip.X = 120

    End If

    RestartSerial = RestartSerial + 1
    Emitter = Fire.StartAt(Preset, Source, 20260904 + RestartSerial * 7919, Quality, Mode, Radius)

    If Station = 4 Then
        Ok = Fire.SetSegment(Emitter, Source, Tip)
    End If

    If Station = 7 Then

        Direction.X = 210
        Direction.Y = 50
        Direction.Z = 0
        Ok = Fire.SetDirection(Emitter, Direction)

    End If

    If Station = 8 Then

        Source.X = -120
        Comparison = Fire.StartAt("TorchFire", Source, 20260904, 1, 1, Radius)
        Preset = "CPU Low (left) / Requested Backend (right)"

    End If

    Time = 0
    Enabled = True
    DebugLayer = -1

    Call ApplyWind()

End Sub
