Public Function FountainAt(Index As Number) As WaterDisk

    Dim Result As WaterDisk

    Select Case Index
        Case 0
            Result.Position = P.Vector(0.00000, 29.40000, -1120.00000)
            Result.Radius = 36.65000
        Case 1
            Result.Position = P.Vector(-1160.00000, 38.12000, 2030.00000)
            Result.Radius = 71.84997
        Case 2
            Result.Position = P.Vector(-2020.00000, 29.40000, -820.00000)
            Result.Radius = 36.64993
        Case 3
            Result.Position = P.Vector(-1299.99996, 29.40000, -820.00000)
            Result.Radius = 36.64996
        Case 4
            Result.Position = P.Vector(-1500.00000, 29.40000, -2430.00000)
            Result.Radius = 36.64993
        Case 5
            Result.Position = P.Vector(2140.00000, 29.40000, -2820.00000)
            Result.Radius = 36.64993
        Case 6
            Result.Position = P.Vector(1500.00000, 29.40000, -1810.00000)
            Result.Radius = 36.64993
    End Select

    Return Result

End Function

