''' Viewer interaction camera state and Double transforms, independent from UI and persistence.
Module Smile.Tools.Character3DViewerCamera

Option Explicit

Import Smile.Simple3D.Core As Core
Import Smile.Simple3D.Character3D As Character3D
Import Smile.Simple3D.CharacterViewer As CharacterViewer
Import Smile.Simple3D.PrecisionCamera3D As PrecisionCamera
Import Smile.Simple3D.Graphics3D As Graphics3D
Import Smile.Simple3D.Precision3D As Precision3D
Import Smile.Simple3D.PrecisionMath3D As Math3D

Public Type State
    Base As Precision3D.Camera3D
    Live As Precision3D.Camera3D
    Controls As PrecisionCamera.Controls
    Frame As PrecisionCamera.Framing
    LocalBounds As Character3D.Bounds3D
    Zoom As PrecisionCamera.ZoomState
    FitLocked As Boolean
    LastFitWidth As Number
    LastFitHeight As Number
    CalibrationOrbitActive As Boolean
    CalibrationOrbitAnchor As Precision3D.Vector3
    CalibrationOrbitOffset As Precision3D.Vector3
    CalibrationOrbitCursorX As Number
    CalibrationOrbitCursorY As Number
    CalibrationOrbitDepth As Double
    AutoOrbit As Boolean
    AutoOrbitYaw As Double
End Type

Public Type PointerInput
    Blocked As Boolean
    OrbitPressed As Boolean
    OrbitHeld As Boolean
    OrbitReleased As Boolean
    PanPressed As Boolean
    PanHeld As Boolean
    PanReleased As Boolean
    WheelDelta As Number
    PointerX As Number
    PointerY As Number
    PointerDeltaX As Number
    PointerDeltaY As Number
    WindowWidth As Number
    WindowHeight As Number
    CalibrationVisible As Boolean
    PartyEnabled As Boolean
    CalibrationOrigin As Precision3D.Vector3
End Type

Public Function ConfigureFraming(ByRef Value As State,
    Profile As CharacterViewer.Profile, ByRef Actor As Character3D.Actor,
    ContentWidth As Number, ContentHeight As Number,
    DragonInspection As Boolean, DragonScalePercent As Number,
    DragonX As Number, DragonY As Number, DragonZ As Number,
    DragonAvailable As Boolean, ArenaCenterX As Number,
    ArenaCenterZ As Number, ArenaDistance As Number,
    ArenaHeight As Number) As Boolean

    Dim Result As Boolean

    Value.Base = Precision3D.FromCamera(Graphics3D.DefaultCamera())
    Value.LocalBounds = Character3D.LocalBounds(Actor)
    Value.Frame = PrecisionCamera.AutoFit(
        Profile,
        Value.LocalBounds,
        ContentWidth,
        ContentHeight,
        Value.Base.FovDegrees
    )

    If DragonInspection Then

        Value.Frame.ScalePercent = DragonScalePercent
        Value.Frame.PositionX = ToDouble(DragonX)
        Value.Frame.PositionY = ToDouble(DragonY)
        Value.Frame.PositionZ = ToDouble(DragonZ)

    End If

    Call SetBaseFromFrame(
        Value,
        DragonAvailable,
        ArenaCenterX,
        ArenaCenterZ,
        ArenaDistance,
        ArenaHeight
    )

    Result = Value.Frame.Valid

    Return Result

End Function

Public Sub Reset(ByRef Value As State, InitialOrbitYaw As Number,
    DefaultZoomDegrees As Number, ZoomInLimit As Number, ZoomOutLimit As Number,
    ZoomRatePerSecond1000 As Number)

    Call PrecisionCamera.ResetCameraControls(Value.Controls)

    Value.Controls.OrbitYaw = ToDouble(InitialOrbitYaw)
    Value.CalibrationOrbitActive = False
    Value.CalibrationOrbitOffset.X = 0.0
    Value.CalibrationOrbitOffset.Y = 0.0
    Value.CalibrationOrbitOffset.Z = 0.0

    Call PrecisionCamera.InitializeZoom(
        Value.Zoom,
        DefaultZoomDegrees,
        ZoomInLimit,
        ZoomOutLimit,
        ZoomRatePerSecond1000
    )

End Sub

Public Sub BeginLoadedLayout(ByRef Value As State,
    WindowWidth As Number, WindowHeight As Number)

    Value.FitLocked = True
    Value.LastFitWidth = WindowWidth
    Value.LastFitHeight = WindowHeight

End Sub

Public Sub LockResponsiveFit(ByRef Value As State)

    Value.FitLocked = True

End Sub

Public Sub SetBaseFromFrame(ByRef Value As State, DragonAvailable As Boolean,
    ArenaCenterX As Number, ArenaCenterZ As Number, ArenaDistance As Number,
    ArenaHeight As Number)

    Value.Base.Position.X = 0.0
    Value.Base.Position.Y = Value.Frame.CameraY
    Value.Base.Position.Z = Value.Frame.CameraZ
    Value.Base.Target.X = 0.0
    Value.Base.Target.Y = Value.Frame.TargetY
    Value.Base.Target.Z = 0.0

    If DragonAvailable Then

        Value.Base.Position.X = ToDouble(ArenaCenterX)
        Value.Base.Position.Y = Value.Frame.TargetY + ToDouble(ArenaHeight)
        Value.Base.Position.Z = ToDouble(ArenaCenterZ) - ToDouble(ArenaDistance)
        Value.Base.Target.X = ToDouble(ArenaCenterX)
        Value.Base.Target.Z = ToDouble(ArenaCenterZ)

    End If

End Sub

Public Sub Compose(ByRef Value As State, FractionalAutoOrbit As Boolean)

    Value.Live = PrecisionCamera.ApplyScreenSpaceCameraControls(Value.Base, Value.Controls)

End Sub

Public Function UpdatePointerControls(ByRef Value As State,
    OrbitPressed As Boolean, OrbitHeld As Boolean, OrbitReleased As Boolean,
    OrbitActive As Boolean, PanPressed As Boolean, PanHeld As Boolean,
    PanReleased As Boolean, PanActive As Boolean, PointerDeltaX As Number,
    PointerDeltaY As Number, OrbitDivisor As Number, PanDivisor As Number) As Boolean

    Dim OrbitDeltaX As Double
    Dim OrbitDeltaY As Double
    Dim PanDeltaX As Double
    Dim PanDeltaY As Double
    Dim Result As Boolean

    If OrbitDivisor <= 0 Or PanDivisor <= 0 Then
        Return False
    End If

    If OrbitActive Then
        OrbitDeltaX = ToDouble(PointerDeltaX) / ToDouble(OrbitDivisor)
        OrbitDeltaY = ToDouble(PointerDeltaY) / ToDouble(OrbitDivisor)
    End If

    If PanActive Then
        PanDeltaX = ToDouble(PointerDeltaX) / ToDouble(PanDivisor)
        PanDeltaY = ToDouble(PointerDeltaY) / ToDouble(PanDivisor)
    End If

    Result = PrecisionCamera.UpdateOrbitControls(
        Value.Controls,
        OrbitPressed,
        OrbitHeld,
        OrbitReleased,
        0,
        0
    )
    Result = PrecisionCamera.UpdatePanZoomControls(
        Value.Controls,
        PanPressed,
        PanHeld,
        PanReleased,
        0,
        0,
        0
    ) And Result

    If OrbitActive Then

        Value.AutoOrbit = False
        Value.Controls.OrbitYaw = Value.Controls.OrbitYaw + OrbitDeltaX
        Value.Controls.OrbitPitch = Value.Controls.OrbitPitch + OrbitDeltaY

    End If

    If PanActive Then

        Value.AutoOrbit = False
        Value.Controls.PanX = Value.Controls.PanX - PanDeltaX
        Value.Controls.PanY = Value.Controls.PanY + PanDeltaY

    End If

    Call ClampControls(Value)

    Return Result

End Function

Public Function CreatePointerInput(Blocked As Boolean,
    OrbitPressed As Boolean, OrbitHeld As Boolean, OrbitReleased As Boolean,
    PanPressed As Boolean, PanHeld As Boolean, PanReleased As Boolean,
    PointerX As Number, PointerY As Number,
    PointerDeltaX As Number, PointerDeltaY As Number,
    WindowWidth As Number, WindowHeight As Number,
    CalibrationVisible As Boolean, PartyEnabled As Boolean) As PointerInput

    Dim Result As PointerInput

    Result.Blocked = Blocked
    Result.OrbitPressed = OrbitPressed
    Result.OrbitHeld = OrbitHeld
    Result.OrbitReleased = OrbitReleased
    Result.PanPressed = PanPressed
    Result.PanHeld = PanHeld
    Result.PanReleased = PanReleased
    Result.PointerX = PointerX
    Result.PointerY = PointerY
    Result.PointerDeltaX = PointerDeltaX
    Result.PointerDeltaY = PointerDeltaY
    Result.WindowWidth = WindowWidth
    Result.WindowHeight = WindowHeight
    Result.CalibrationVisible = CalibrationVisible
    Result.PartyEnabled = PartyEnabled

    Return Result

End Function

Public Function PointerRequiresCalibrationOrigin(ByRef Value As State,
    Input As PointerInput) As Boolean

    Dim BeginOrbit As Boolean
    Dim Result As Boolean

    BeginOrbit = (Not Input.Blocked And
        (Input.OrbitPressed Or
        (Input.OrbitHeld And Not Value.Controls.Orbiting)))
    Result = (BeginOrbit And Input.CalibrationVisible And Not Input.PartyEnabled)

    Return Result

End Function

Public Function UpdatePointerInteraction(ByRef Value As State,
    Input As PointerInput, OrbitDivisor As Number, PanDivisor As Number,
    ZoomStepDegrees As Number) As Boolean

    Dim BeginOrbit As Boolean
    Dim BeginPan As Boolean
    Dim OrbitActive As Boolean
    Dim PanActive As Boolean
    Dim Result As Boolean

    BeginOrbit = (Not Input.Blocked And
        (Input.OrbitPressed Or
        (Input.OrbitHeld And Not Value.Controls.Orbiting)))
    OrbitActive = (BeginOrbit Or
        (Value.Controls.Orbiting And (Input.OrbitHeld Or Input.OrbitReleased)))
    BeginPan = (Not Input.Blocked And
        (Input.PanPressed Or
        (Input.PanHeld And Not Value.Controls.Panning)))
    PanActive = (BeginPan Or
        (Value.Controls.Panning And (Input.PanHeld Or Input.PanReleased)))
    Value.CalibrationOrbitActive = (OrbitActive And
        Input.CalibrationVisible And Not Input.PartyEnabled)

    If BeginOrbit And Value.CalibrationOrbitActive Then
        Call BeginCalibrationOrbitAnchor(
            Value, Input.CalibrationOrigin, Input.PointerX, Input.PointerY,
            Input.WindowWidth, Input.WindowHeight)
    End If

    If Not Input.Blocked And Input.WheelDelta <> 0 Then
        Call AdjustZoomTarget(Value, Input.WheelDelta, ZoomStepDegrees)
    End If

    Result = UpdatePointerControls(
        Value,
        BeginOrbit,
        Input.OrbitHeld,
        Input.OrbitReleased,
        OrbitActive,
        BeginPan,
        Input.PanHeld,
        Input.PanReleased,
        PanActive,
        Input.PointerDeltaX,
        Input.PointerDeltaY,
        OrbitDivisor,
        PanDivisor
    )

    Return Result

End Function

Public Sub ClampControls(ByRef Value As State)

    Value.Controls.PanX = Min(Value.Frame.PanXLimit,
        Max(0.0 - Value.Frame.PanXLimit, Value.Controls.PanX))
    Value.Controls.PanY = Min(Value.Frame.PanYLimit,
        Max(0.0 - Value.Frame.PanYLimit, Value.Controls.PanY))

End Sub

Public Sub CancelPointerControls(ByRef Value As State)

    Value.Controls.Orbiting = False
    Value.Controls.Panning = False
    Value.CalibrationOrbitActive = False

End Sub

Public Function NudgeOrbit(ByRef Value As State, DeltaX As Number,
    DeltaY As Number) As Boolean

    Dim Result As Boolean

    Value.AutoOrbit = False
    Result = PrecisionCamera.UpdateOrbitControls(
        Value.Controls,
        True,
        True,
        True,
        DeltaX,
        DeltaY
    )

    Call ClampControls(Value)

    Return Result

End Function

Public Function NudgePan(ByRef Value As State, DeltaX As Number,
    DeltaY As Number) As Boolean

    Dim Result As Boolean

    Value.AutoOrbit = False
    Result = PrecisionCamera.UpdatePanZoomControls(
        Value.Controls,
        True,
        True,
        True,
        DeltaX,
        DeltaY,
        0
    )

    Call ClampControls(Value)

    Return Result

End Function

Public Sub ToggleAutoOrbit(ByRef Value As State)

    Value.AutoOrbit = Not Value.AutoOrbit
    Value.AutoOrbitYaw = Value.Controls.OrbitYaw

End Sub

Public Sub SetAutoOrbit(ByRef Value As State, Enabled As Boolean)

    Value.AutoOrbit = Enabled

End Sub

Public Sub StartAutoOrbit(ByRef Value As State)

    Value.AutoOrbit = True
    Value.AutoOrbitYaw = Value.Controls.OrbitYaw

End Sub

Public Function AdvanceAutoOrbit(ByRef Value As State, ByRef PartyPhase As Double,
    ElapsedMilliseconds As Number, DegreesPerSecond As Number,
    PartyMode As Boolean) As Boolean

    Dim Advance As Double

    If ElapsedMilliseconds < 0 Or ElapsedMilliseconds > 1000 Then
        Return False
    End If

    If Value.AutoOrbit Then

        Advance = ToDouble(ElapsedMilliseconds) * ToDouble(DegreesPerSecond) / 1000.0

        If PartyMode Then
            PartyPhase = Math3D.WrapDegrees(PartyPhase + Advance)
            Value.AutoOrbitYaw = 120.0 + Sin(Math3D.Radians(PartyPhase)) * 55.0
        Else
            Value.AutoOrbitYaw = Math3D.WrapDegrees(Value.AutoOrbitYaw + Advance)
        End If

        Value.Controls.OrbitYaw = Value.AutoOrbitYaw

    End If

    Return True

End Function

Public Sub AdjustZoomTarget(ByRef Value As State, WheelDelta As Number,
    StepDegrees As Number)

    Call PrecisionCamera.AdjustZoomTarget(Value.Zoom, WheelDelta, StepDegrees)

End Sub

Public Sub SetZoomTarget(ByRef Value As State, Degrees As Number)

    Value.Zoom.Target = ToDouble(Degrees)

End Sub

Public Function AdvanceZoom(ByRef Value As State, ElapsedMilliseconds As Number) As Boolean

    Dim Result As Boolean

    Result = PrecisionCamera.AdvanceZoom(Value.Zoom, ElapsedMilliseconds)
    Value.Controls.Zoom = Value.Zoom.Current

    Return Result

End Function

Public Sub ApplyCloseUp(ByRef Value As State, CloseUpStart As Number,
    ZoomInLimit As Number, MinimumDistance1000 As Number)

    Dim Progress As Double
    Dim Distance As Double

    If Value.Zoom.Current >= ToDouble(CloseUpStart) Or CloseUpStart <= ZoomInLimit Then
        Return
    End If

    Progress = Clamp((ToDouble(CloseUpStart) - Value.Zoom.Current) /
        ToDouble(CloseUpStart - ZoomInLimit), 0.0, 1.0)
    Distance = 1.0 - Progress * (1.0 - ToDouble(MinimumDistance1000) / 1000.0)
    Value.Live.Position = Math3D.Add(Value.Live.Target,
        Math3D.Scale(Math3D.Subtract(Value.Live.Position, Value.Live.Target), Distance))

End Sub

Public Sub UpdateResponsiveFit(ByRef Value As State, Profile As CharacterViewer.Profile,
    WindowWidth As Number, WindowHeight As Number,
    ContentWidth As Number, DragonAvailable As Boolean, ArenaCenterX As Number,
    ArenaCenterZ As Number, ArenaDistance As Number, ArenaHeight As Number)

    If Not Value.FitLocked Then
        Return
    End If

    If WindowWidth = Value.LastFitWidth And WindowHeight = Value.LastFitHeight Then
        Return
    End If

    Value.LastFitWidth = WindowWidth
    Value.LastFitHeight = WindowHeight
    Value.Frame = PrecisionCamera.AutoFit(
        Profile,
        Value.LocalBounds,
        ContentWidth,
        Max(1, WindowHeight),
        Value.Base.FovDegrees + Value.Zoom.Current
    )

    Call SetBaseFromFrame(Value, DragonAvailable, ArenaCenterX, ArenaCenterZ,
        ArenaDistance, ArenaHeight)

End Sub

Public Sub ToggleResponsiveFit(ByRef Value As State,
    Profile As CharacterViewer.Profile, WindowWidth As Number,
    WindowHeight As Number, ContentWidth As Number,
    DragonAvailable As Boolean, ArenaCenterX As Number,
    ArenaCenterZ As Number, ArenaDistance As Number, ArenaHeight As Number)

    Value.FitLocked = Not Value.FitLocked

    If Not Value.FitLocked Then
        Return
    End If

    Value.LastFitWidth = -1
    Value.LastFitHeight = -1

    Call UpdateResponsiveFit(
        Value,
        Profile,
        WindowWidth,
        WindowHeight,
        ContentWidth,
        DragonAvailable,
        ArenaCenterX,
        ArenaCenterZ,
        ArenaDistance,
        ArenaHeight
    )

End Sub

Public Sub BeginCalibrationOrbitAnchor(ByRef Value As State, Origin As Precision3D.Vector3,
    PointerX As Number, PointerY As Number, WindowWidth As Number,
    WindowHeight As Number)

    Dim Projected As PrecisionCamera.ProjectedPoint

    Projected = PrecisionCamera.ProjectViewerPoint(
        Origin, Value.Live, WindowWidth, WindowHeight)
    Value.CalibrationOrbitDepth = Projected.Depth

    If Not Projected.Visible Then
        Value.CalibrationOrbitDepth = Max(Value.Live.NearPlane + 1.0,
            Sqrt(Math3D.Dot(Math3D.Subtract(Value.Live.Position, Value.Live.Target),
                Math3D.Subtract(Value.Live.Position, Value.Live.Target))))
    End If

    Value.CalibrationOrbitCursorX = PointerX
    Value.CalibrationOrbitCursorY = PointerY
    Value.CalibrationOrbitAnchor = PrecisionCamera.CursorPointAtDepth(
        Value.Live,
        Value.CalibrationOrbitCursorX,
        Value.CalibrationOrbitCursorY,
        Value.CalibrationOrbitDepth,
        WindowWidth,
        WindowHeight
    )

End Sub

Public Sub ApplyCalibrationOrbitAnchor(ByRef Value As State, WindowWidth As Number,
    WindowHeight As Number)

    Dim Unshifted As Precision3D.Camera3D

    Unshifted = Value.Live
    Value.Live.Position = Math3D.Add(Value.Live.Position, Value.CalibrationOrbitOffset)
    Value.Live.Target = Math3D.Add(Value.Live.Target, Value.CalibrationOrbitOffset)

    If Value.CalibrationOrbitActive Then
        Value.Live = PrecisionCamera.KeepCursorAnchor(
            Value.Live,
            Value.CalibrationOrbitAnchor,
            Value.CalibrationOrbitCursorX,
            Value.CalibrationOrbitCursorY,
            Value.CalibrationOrbitDepth,
            WindowWidth,
            WindowHeight
        )
        Value.CalibrationOrbitOffset = Math3D.Subtract(
            Value.Live.Position, Unshifted.Position)
    End If

End Sub

Public Sub SetHorizontalOrbit(ByRef Value As State, OrbitYaw As Number)

    Value.Controls.OrbitYaw = Clamp(ToDouble(OrbitYaw), -180.0, 180.0)
    Value.AutoOrbit = False

End Sub

Public Sub AdjustHorizontalOrbit(ByRef Value As State, Amount As Number)

    Value.Controls.OrbitYaw = Clamp(Value.Controls.OrbitYaw + ToDouble(Amount), -180.0, 180.0)
    Value.AutoOrbit = False

End Sub

Public Sub SetVerticalOrbit(ByRef Value As State, OrbitPitch As Number)

    Value.Controls.OrbitPitch = Clamp(ToDouble(OrbitPitch), -180.0, 180.0)
    Value.AutoOrbit = False

End Sub

Public Sub AdjustVerticalOrbit(ByRef Value As State, Amount As Number)

    Value.Controls.OrbitPitch = Clamp(Value.Controls.OrbitPitch + ToDouble(Amount), -180.0, 180.0)
    Value.AutoOrbit = False

End Sub

Public Sub SetZoom(ByRef Value As State, Degrees As Number,
    ZoomInLimit As Number, ZoomOutLimit As Number)

    Degrees = Min(ZoomOutLimit, Max(ZoomInLimit, Degrees))
    Value.Zoom.Current = ToDouble(Degrees)
    Value.Zoom.Target = Value.Zoom.Current
    Value.Controls.Zoom = ToDouble(Degrees)

End Sub

Public Sub AdjustPreciseZoom(ByRef Value As State, WheelDelta As Number,
    ZoomInLimit As Number, ZoomOutLimit As Number)

    Value.Zoom.Target = Clamp(Value.Zoom.Target - ToDouble(WheelDelta),
        ToDouble(ZoomInLimit), ToDouble(ZoomOutLimit))

End Sub

Public Sub KeepAboveGround(ByRef Value As State, FloorHeight As Number)

    Call PrecisionCamera.KeepCameraAboveGround(Value.Live, ToDouble(FloorHeight))

End Sub

Public Function InitialOrbitYaw(DragonAvailable As Boolean,
    ProfileOrbitYaw As Number, ArenaOrbitYaw As Number) As Number

    Dim Result As Number

    Result = ProfileOrbitYaw

    If DragonAvailable Then
        Result = ArenaOrbitYaw
    End If

    Return Result

End Function

Public Function DefaultZoomDegrees(DragonAvailable As Boolean,
    CharacterZoomDegrees As Number, ArenaZoomDegrees As Number) As Number

    Dim Result As Number

    Result = CharacterZoomDegrees

    If DragonAvailable Then
        Result = ArenaZoomDegrees
    End If

    Return Result

End Function

End Module
