''' Town-scale lighting and native water surfaces. All resources belong to the town.
Module Smile.Tools.NerisTownAppearance

Option Explicit

Import Smile.Simple3D.Core As Core
Import Smile.Simple3D.Graphics3D As G
Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.Scene3D As Scene
Import Smile.Tools.NerisTownCrystals As Crystals
Import Smile.Tools.NerisTownTrees As Trees
Import Smile.Tools.NerisTownFlowers As Flowers
Import Smile.Tools.NerisTownSite As Site
Import Smile.Tools.NerisTownLayout As Layout

Public Type State
    Water As Core.Material3D
    Refraction As Core.Material3D
    MoatWater As Core.Material3D
    Surfaces[8] As Core.RibbonBatch3D
    Distortion[8] As Core.RibbonBatch3D
    Time As Number
    Gems As Crystals.State
    Garden As Trees.State
    Flowers As Flowers.State
    Ready As Boolean
End Type

Private Function ApplyLighting() As Boolean

    Dim Ok As Boolean

    Ok = G.ClearAdditionalLights3DChecked()
    Ok = G.SetAmbientLight3D(200, 215, 235, 38) And Ok
    Ok = G.SetDirectionalLight3D(-40, -65, -25, 255, 237, 214, 260) And Ok
    Ok = G.SetPointLight3D(0, -600, 550, -1380, 195, 218, 255, 300, 1800) And Ok
    Ok = G.SetSpotLight3D(1, -4010, 1500, 1610, 255, 236, 209, 480, 2700) And Ok
    Ok = G.SetSpotLightCone3D(1, 22, -70, 43, 40, 65) And Ok
    Ok = G.SetSpotLight3D(2, -1510, 1800, 1700, 255, 237, 215, 480, 3000) And Ok
    Ok = G.SetSpotLightCone3D(2, 40, -130, 78, 40, 65) And Ok
    Ok = G.SetSpotLight3D(3, 1100, 1400, 1770, 231, 241, 255, 460, 2600) And Ok
    Ok = G.SetSpotLightCone3D(3, 0, -70, 35, 42, 65) And Ok

    Call Scene.UseCustomLighting()

    Return Ok

End Function

Private Function BuildSurface(ByRef Batch As Core.RibbonBatch3D, Surface As Number) As Boolean

    Dim Index As Number
    Dim Points As Number
    Dim Corner As Number
    Dim Region As Site.Region
    Dim LeftPoint As P.Vector3
    Dim RightPoint As P.Vector3
    Dim Angle As Double
    Dim CenterX As Double
    Dim CenterZ As Double
    Dim Height As Double
    Dim Radius As Double
    Dim Fountain As Layout.WaterDisk
    Dim Ok As Boolean

    Points = 49
    Ok = True

    If Surface = 0 Then
        Points = Site.WATER_COUNT * 4
    End If

    For Index = 0 To Points - 1

        If Surface = 0 Then

            Region = Site.WaterAt(Index / 4)
            Corner = Index Mod 4
            LeftPoint = P.Vector(Region.X0, 21.85, Region.Z0)
            RightPoint = P.Vector(Region.X1, 21.85, Region.Z0)

            If Corner >= 2 Then
                LeftPoint.Z = Region.Z1
                RightPoint.Z = Region.Z1
            End If

            If Corner = 0 Then
                RightPoint = LeftPoint
            Else If Corner = 3 Then
                LeftPoint = RightPoint
            End If

        Else
            Fountain = Layout.FountainAt(Surface - 1)
            CenterX = Fountain.Position.X
            CenterZ = Fountain.Position.Z
            Height = Fountain.Position.Y
            Radius = Fountain.Radius

            Angle = ToDouble(Index) * 6.283185307179586 / 48.0
            LeftPoint = P.Vector(CenterX, Height, CenterZ)
            RightPoint = P.Vector(CenterX + Cos(Angle) * Radius, Height,
                CenterZ + Sin(Angle) * Radius)

        End If

        Ok = P.SetRibbonPoint(Batch, Index, LeftPoint, RightPoint,
            ToDouble(Index) / ToDouble(Points - 1)) And Ok
        Ok = G.SetRibbonPointColor3D(Batch, Index, 255, 255, 255, 100) And Ok
    End For

    Ok = G.CommitRibbonBatch3D(Batch, Points) And Ok

    Return Ok

End Function

Public Function Create(ByRef Value As State) As Boolean

    Dim NoTexture As Core.Texture3D
    Dim Index As Number
    Dim Ok As Boolean

    Ok = ApplyLighting()
    Ok = Trees.Create(Value.Garden) And Ok
    Ok = Flowers.Create(Value.Flowers) And Ok
    Ok = Crystals.Create(Value.Gems) And Ok
    Ok = G.ConfigureDistortion3D(1, 2) And Ok
    Value.Water = G.CreateEffectMaterial3D(NoTexture, G.MATERIAL_ALPHA_BLEND, 100)
    Value.Refraction = G.CreateEffectMaterial3D(NoTexture, G.MATERIAL_ALPHA_BLEND, 100)
    Value.MoatWater = G.CreateEffectMaterial3D(NoTexture, G.MATERIAL_ALPHA_BLEND, 100)
    Ok = Value.Water.Handle <> 0 And Value.Refraction.Handle <> 0 And Ok
    Ok = G.SetEffectMaterial3D(Value.Water, G.MATERIAL_ALPHA_BLEND, 30, 100, 240, 100, 100) And Ok
    Ok = G.SetEffectMaterialWater3D(Value.Water, True, 45, 0, 0, 24) And Ok
    Ok = G.SetEffectMaterial3D(Value.MoatWater, G.MATERIAL_ALPHA_BLEND, 30, 100, 240, 100, 100) And Ok
    Ok = G.SetEffectMaterialWater3D(Value.MoatWater, True, 45, 0, 0, 24) And Ok
    Ok = G.SetEffectMaterialDistortion3D(Value.Refraction, 1, 90, 0, 20, 80) And Ok

    For Index = 0 To Layout.FOUNTAIN_COUNT

        If Index = 0 Then
            Value.Surfaces[Index] = G.CreateRibbonBatch3D(128, Value.MoatWater)
        Else
            Value.Surfaces[Index] = G.CreateRibbonBatch3D(128, Value.Water)
        End If

        Value.Distortion[Index] = G.CreateRibbonBatch3D(128, Value.Refraction)
        Ok = BuildSurface(Value.Surfaces[Index], Index) And Ok
        Ok = BuildSurface(Value.Distortion[Index], Index) And Ok
    End For

    Value.Ready = Ok

    Return Ok

End Function

Public Sub Update(ByRef Value As State, Elapsed As Number)

    Value.Time = (Value.Time + Max(0, Elapsed)) Mod 3600000
    Value.Ready = G.SetEffectMaterialWater3D(Value.Water, True, 45, 0, Value.Time / 3, 24)
    Value.Ready = G.SetEffectMaterialWater3D(Value.MoatWater, True, 45, 0, Value.Time / 3, 24) And Value.Ready

    Call Crystals.Update(Value.Gems, Elapsed)
    Call Trees.Update(Value.Garden, Elapsed)

End Sub

Public Function Draw(ByRef Value As State) As Boolean

    Dim Index As Number
    Dim Ok As Boolean

    Ok = Value.Ready And Trees.Draw(Value.Garden) And Flowers.Draw(Value.Flowers)

    For Index = 0 To Layout.FOUNTAIN_COUNT
        Ok = G.DrawRibbonBatch3D(Value.Surfaces[Index]) And Ok
        Ok = G.DrawRibbonBatch3D(Value.Distortion[Index]) And Ok
    End For

    Ok = Crystals.Draw(Value.Gems) And Ok

    Return Ok

End Function

Public Sub Destroy(ByRef Value As State)

    Dim Index As Number

    For Index = 0 To Layout.FOUNTAIN_COUNT
        Call G.DestroyRibbonBatch3D(Value.Surfaces[Index])
        Call G.DestroyRibbonBatch3D(Value.Distortion[Index])
    End For

    Call G.DestroyMaterial3D(Value.Water)
    Call G.DestroyMaterial3D(Value.Refraction)
    Call G.DestroyMaterial3D(Value.MoatWater)
    Call Crystals.Destroy(Value.Gems)
    Call Trees.Destroy(Value.Garden)
    Call Flowers.Destroy(Value.Flowers)

    Value.Ready = False

End Sub

End Module
