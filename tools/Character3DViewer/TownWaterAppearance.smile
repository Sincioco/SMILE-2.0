''' Shared nighttime water and all-day reflections for Neris Metropolis.
Module Smile.Tools.TownWaterAppearance

Option Explicit

Import Smile.Simple3D.Core As Core
Import Smile.Simple3D.Graphics3D As G
Import Smile.Tools.TownDocument As Document

Public Function Configure(Intensity As Number, Optional MapName As Text = "") As Boolean

    Dim Enabled As Boolean
    Dim Ok As Boolean

    Enabled = Intensity < 180 Or MapName = "Neris Metropolis"
    Ok = G.ConfigureReflections3D(Enabled, 100, 12, 75, -1, False, True)

    Return Ok

End Function

Public Function Apply(ByRef Material As Core.Material3D, Intensity As Number,
    Optional DayBlue As Number = 240) As Boolean

    Dim Night As Double
    Dim Ok As Boolean

    If Intensity < 0 Then
        Return True
    End If

    ' Water reaches the same deep night tint at the shared 112% moonlight default.
    Night = Clamp((180.0 - ToDouble(Intensity)) /
        (180.0 - ToDouble(Document.NIGHT_INTENSITY)), 0.0, 1.0)
    Ok = G.SetEffectMaterial3D(Material, G.MATERIAL_ALPHA_BLEND,
        ToNumber(30.0 - Night * 23.0), ToNumber(100.0 - Night * 84.0),
        ToNumber(ToDouble(DayBlue) - Night * ToDouble(DayBlue - 33)), 100, 100)

    Return Ok

End Function

End Module
