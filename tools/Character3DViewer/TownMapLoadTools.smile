''' Editor presentation for transparent map-load cells. Mutations stay in TownMapLoads.
Module Smile.Tools.TownMapLoadTools

Option Explicit

Import Smile.Tools.TownSurfaceLayers As Layers
Import Smile.Tools.TownDocument As Document
Import Smile.Tools.TownMapLoads As Links
Import Smile.Tools.TownGuides As Guides
Import Smile.Tools.TownGatewayJourney As Journey
Import Smile.Tools.TownDocumentNavigation As Navigation
Import Smile.Simple3D.SurfaceGrid3D As Grid
Import Smile.Simple3D.TerrainSurface3D As Terrain
Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.PrecisionCamera3D As Camera

Private Dim Borders As Links.Outline

Public Type State
    Labels As Links.LabelSet
    LabelName As Text
    LabelRevision As Number
    Arrivals[4096] As P.Vector3
    Headings[4096] As Double
    ValidArrivals[4096] As Boolean
    Area As Links.Area
    Selected As Boolean
    Moving As Boolean
    AnchorX As Number
    AnchorZ As Number
    X0 As Number
    Z0 As Number
    X1 As Number
    Z1 As Number
    FarX As Boolean
    FarZ As Boolean
    Drawing As Boolean
    Pending As Boolean
    Reassign As Boolean
    First As P.Vector3
    Last As P.Vector3
    Message As Text
End Type

Public Sub Gesture(ByRef Value As State, ByRef Town As Document.State,
    Point As P.Vector3, Available As Boolean, Pressed As Boolean, Held As Boolean, Tool As Number)

    Dim X As Number
    Dim Z As Number
    Dim Index As Number
    Dim Ok As Boolean

    If Tool = 762 Then

        If Available And Pressed Then

            If (Navigation.CanStand(Point.X, Point.Z) And
                Text_Length(Links.DestinationAt(Town, Point.X, Point.Z)) = 0) Then

                Town.HasTeleportSpawn = True
                Town.TeleportSpawn = Point
                Town.Revision = Town.Revision + 1
                Value.Message = "Teleport Spawn placed. Click elsewhere to move it; Ctrl+Z undoes."

            Else
                Value.Message = "Choose walkable ground outside the yellow travel areas."

            End If

        End If

        Return

    End If

    If Tool = 760 Or Tool = 761 Then
        Call TransformGesture(Value, Town, Point, Available, Pressed, Held, Tool = 761)

        Return
    End If

    If Value.Pending Then
        Return
    End If

    If Value.Drawing Then

        If Available Then
            Value.Last = Point
        End If

        If Not Held Then

            Value.Drawing = False
            Value.Pending = True
            Value.Message = "Choose the destination map."

        End If

    Else If Available And Pressed Then

        X = Grid.CellX(Town.Surface, Point.X)
        Z = Grid.CellZ(Town.Surface, Point.Z)
        Index = Links.Find(Town, X, Z)

        If Tool = 19 Then

            If (Town.HasTeleportSpawn And
                Abs(Point.X - Town.TeleportSpawn.X) <= 22.0 And
                Abs(Point.Z - Town.TeleportSpawn.Z) <= 22.0) Then

                Town.HasTeleportSpawn = False
                Town.Revision = Town.Revision + 1
                Value.Message = "Teleport Spawn removed."

            Else
                Ok = Links.Remove(Town, X, Z)
                Value.Message = "Map Load area removed; terrain retained."

            End If

        Else If Tool = 18 And Index < 0 Then

            Value.Message = "Click inside a yellow area to reassign it."

        Else

            Value.First = Point
            Value.Last = Point
            Value.Reassign = Tool = 18
            Value.Pending = Value.Reassign
            Value.Drawing = Not Value.Reassign

        End If

    End If

End Sub

Private Sub TransformGesture(ByRef Value As State, ByRef Town As Document.State,
    Point As P.Vector3, Available As Boolean, Pressed As Boolean, Held As Boolean, Resize As Boolean)

    Dim X As Number
    Dim Z As Number
    Dim DeltaX As Number
    Dim DeltaZ As Number
    Dim Ok As Boolean
    Dim SelectedNow As Boolean

    X = Max(0, Min(Town.Surface.Columns - 1, Grid.CellX(Town.Surface, Point.X)))
    Z = Max(0, Min(Town.Surface.Rows - 1, Grid.CellZ(Town.Surface, Point.Z)))

    If (Not Value.Moving And
        Pressed And
        Available) Then

        ' A selected area also accepts a second click, useful for small distant tiles.

        If (Links.Find(Town, X, Z) >= 0 Or
            Not Value.Selected Or
            Value.Area.Revision <> Town.Revision) Then

            Value.Selected = Links.SelectArea(Town, X, Z, Value.Area)
            Value.Message = "Click inside a yellow Map Load area."

            If Not Value.Selected Then
                Return
            End If

            Value.AnchorX = X
            Value.AnchorZ = Z
            SelectedNow = True
            Value.X0 = Value.Area.X0
            Value.Z0 = Value.Area.Z0
            Value.X1 = Value.Area.X1
            Value.Z1 = Value.Area.Z1
            Value.FarX = Point.X >= (Town.Surface.XEdges[Value.X0] + Town.Surface.XEdges[Value.X1 + 1]) / 2.0
            Value.FarZ = Point.Z >= (Town.Surface.ZEdges[Value.Z0] + Town.Surface.ZEdges[Value.Z1 + 1]) / 2.0

        End If

        Value.Moving = True
        Value.Message = "Map Load: " + Value.Area.Tiles[0].Destination

    End If

    If Value.Moving Then

        If Available And Not SelectedNow Then

            If Resize Then

                If Value.FarX Then
                    Value.X1 = Max(Value.X0, X)
                Else
                    Value.X0 = Min(Value.X1, X)
                End If

                If Value.FarZ Then
                    Value.Z1 = Max(Value.Z0, Z)
                Else
                    Value.Z0 = Min(Value.Z1, Z)
                End If

            Else

                DeltaX = Max(-Value.Area.X0, Min(Town.Surface.Columns - 1 - Value.Area.X1, X - Value.AnchorX))
                DeltaZ = Max(-Value.Area.Z0, Min(Town.Surface.Rows - 1 - Value.Area.Z1, Z - Value.AnchorZ))
                Value.X0 = Value.Area.X0 + DeltaX
                Value.Z0 = Value.Area.Z0 + DeltaZ
                Value.X1 = Value.Area.X1 + DeltaX
                Value.Z1 = Value.Area.Z1 + DeltaZ

            End If

        End If

        If Not Held Then

            X = Value.Area.Tiles[0].X + Value.X0 - Value.Area.X0
            Z = Value.Area.Tiles[0].Z + Value.Z0 - Value.Area.Z0
            Ok = Links.TransformArea(Town, Value.Area, Value.X0, Value.Z0, Value.X1, Value.Z1, Resize)
            Value.Moving = False
            Value.Message = "Area retained: overlap, changed document or nonrectangular resize."

            If Ok Then

                If Resize Then
                    X = Value.X0
                    Z = Value.Z0
                End If

                Value.Selected = Links.SelectArea(Town, X, Z, Value.Area)
                Value.AnchorX = (Value.Area.X0 + Value.Area.X1) / 2
                Value.AnchorZ = (Value.Area.Z0 + Value.Area.Z1) / 2
                Value.Message = "Map Load: " + Value.Area.Tiles[0].Destination + " (Ctrl+Z to undo)"

            Else

                Value.X0 = Value.Area.X0
                Value.Z0 = Value.Area.Z0
                Value.X1 = Value.Area.X1
                Value.Z1 = Value.Area.Z1

            End If

        End If

    End If

End Sub

Public Function Apply(ByRef Value As State, ByRef Town As Document.State, Name As Text) As Boolean

    Dim X0 As Number
    Dim Z0 As Number
    Dim X1 As Number
    Dim Z1 As Number
    Dim Index As Number
    Dim Ok As Boolean

    If Not Value.Pending Then
        Return False
    End If

    ' The session persists the chosen open map before applying this gesture.

    If Not Document.ValidName(Name) Or Name = Town.Name Then
        Value.Message = "Choose a different destination map."
        Return False
    End If

    X0 = Grid.CellX(Town.Surface, Min(Value.First.X, Value.Last.X))
    Z0 = Grid.CellZ(Town.Surface, Min(Value.First.Z, Value.Last.Z))
    X1 = Grid.CellX(Town.Surface, Max(Value.First.X, Value.Last.X))
    Z1 = Grid.CellZ(Town.Surface, Max(Value.First.Z, Value.Last.Z))

    If Value.Reassign Then

        Index = Links.Find(Town, X0, Z0)
        Ok = Index >= 0

        If Ok Then
            Call Links.AssignConnected(Town, Index, Name)
        End If

    Else

        Ok = Links.PlaceRectangle(Town, X0, Z0, X1, Z1, Name)

    End If

    Value.Message = "Area exceeds map bounds or 4096 tiles."

    If Ok Then
        Value.Pending = False
        Value.Message = "Map Load: " + Name
    End If

    Return Ok

End Function

Public Sub DrawPreview(ByRef Value As State, ByRef Town As Document.State, View As P.Camera3D)

    Dim Mark As Guides.Marker

    If Value.Selected And Value.Area.Revision = Town.Revision Then

        Mark.First = P.Vector(Town.Surface.XEdges[Value.X0], Layers.OVERLAY_Y, Town.Surface.ZEdges[Value.Z0])
        Mark.Last = P.Vector(Town.Surface.XEdges[Value.X1 + 1], Layers.OVERLAY_Y, Town.Surface.ZEdges[Value.Z1 + 1])

        Call DrawArea(Town, Mark, View, RGB(80, 255, 220))

    End If

    If Value.Drawing Or Value.Pending Then

        Mark.First = Value.First
        Mark.Last = Value.Last
        Mark.IsRectangle = True

        Call DrawArea(Town, Mark, View, RGB(255, 220, 40))

    End If

End Sub

Private Sub DrawArea(ByRef Town As Document.State, Mark As Guides.Marker,
    View As P.Camera3D, ColorValue As Number)

    Dim Side As Number
    Dim Step As Number
    Dim Steps As Number
    Dim First As P.Vector3
    Dim Last As P.Vector3
    Dim Previous As P.Vector3
    Dim Point As P.Vector3
    Dim Sample As Terrain.Sample
    Dim Amount As Double

    For Side = 0 To 3

        First = Mark.First
        Last = Mark.Last

        If Side = 0 Then
            Last.X = First.X
        Else If Side = 1 Then
            First.X = Last.X
        Else If Side = 2 Then
            Last.Z = First.Z
        Else
            First.Z = Last.Z
        End If

        Steps = Max(1, ToNumber((Abs(Last.X - First.X) + Abs(Last.Z - First.Z)) / Town.Surface.CellSize) + 1)

        For Step = 0 To Steps

            Amount = ToDouble(Step) / ToDouble(Steps)
            Point = P.Vector(First.X + (Last.X - First.X) * Amount, Layers.OVERLAY_Y,
                First.Z + (Last.Z - First.Z) * Amount)
            Sample = Terrain.SamplePoint(Town.Surface, Point.X, Point.Z)
            Point.Y = Point.Y + Sample.Offset

            If Step > 0 Then
                Call Guides.Segment(Previous, Point, View, ColorValue)
            End If

            Previous = Point
        End For
    End For

End Sub

Public Sub Draw(ByRef Value As State, ByRef Town As Document.State, View As P.Camera3D, RightEdge As Number)

    Dim Index As Number
    Dim X As Number
    Dim Z As Number
    Dim Side As Number
    Dim Sample As Terrain.Sample
    Dim Mark As Guides.Marker
    Dim Point As P.Vector3
    Dim ScreenPoint As Camera.ProjectedPoint
    Dim LabelX As Number
    Dim LabelY As Number
    Dim LabelWidth As Number

    If Town.MapTileCount = 0 And Not Town.HasTeleportSpawn Then
        Return
    End If

    Clip Rectangle 0, 128, Max(0, RightEdge), Max(0, Window_Height() - 128)

    Call Links.BuildOutline(Town, Borders)

    For Index = 0 To Town.MapTileCount - 1

        X = Town.MapTiles[Index].X
        Z = Town.MapTiles[Index].Z

        For Side = 0 To 3

            If Borders.Edge[Index, Side] Then

                Mark.First = P.Vector(Town.Surface.XEdges[X], Layers.OVERLAY_Y, Town.Surface.ZEdges[Z])
                Mark.Last = P.Vector(Town.Surface.XEdges[X + 1], Layers.OVERLAY_Y, Town.Surface.ZEdges[Z + 1])

                If Side = 0 Then
                    Mark.Last.X = Mark.First.X
                Else If Side = 1 Then
                    Mark.First.X = Mark.Last.X
                Else If Side = 2 Then
                    Mark.Last.Z = Mark.First.Z
                Else
                    Mark.First.Z = Mark.Last.Z
                End If

                Sample = Terrain.SamplePoint(Town.Surface, Mark.First.X, Mark.First.Z)
                Mark.First.Y = Mark.First.Y + Sample.Offset
                Sample = Terrain.SamplePoint(Town.Surface, Mark.Last.X, Mark.Last.Z)
                Mark.Last.Y = Mark.Last.Y + Sample.Offset

                Call Guides.DrawMarker(Mark, View, RGB(255, 220, 40))

            End If

        End For
    End For

    If Value.LabelName <> Town.Name Or Value.LabelRevision <> Town.Revision Then

        Call Links.BuildLabels(Town, Value.Labels)

        For Index = 0 To Value.Labels.LabelCount - 1
            Value.ValidArrivals[Index] = Journey.GateArrival(Town, Value.Labels.Positions[Index],
                Value.Arrivals[Index], Value.Headings[Index])
        End For

        Value.LabelName = Town.Name
        Value.LabelRevision = Town.Revision

    End If

    For Index = 0 To Value.Labels.LabelCount - 1

        If Value.ValidArrivals[Index] Then
            Call DrawArrival(Town, Value.Arrivals[Index], Value.Headings[Index], View)
        End If

        Point = Value.Labels.Positions[Index]
        Sample = Terrain.SamplePoint(Town.Surface, Point.X, Point.Z)
        Point.Y = Sample.Offset + Layers.OVERLAY_Y
        ScreenPoint = Camera.ProjectViewerPoint(Point, View, Window_Width(), Window_Height())

        If ScreenPoint.Visible Then

            LabelWidth = Text_Length(Value.Labels.Names[Index]) * 8
            LabelX = Max(6, Min(RightEdge - LabelWidth - 6, ToNumber(ScreenPoint.X) - LabelWidth / 2))
            LabelY = ToNumber(ScreenPoint.Y) - 22

            Draw Text Value.Labels.Names[Index] At LabelX + 1, LabelY + 1 Size 14 Color BLACK
            Draw Text Value.Labels.Names[Index] At LabelX, LabelY Size 14 Color RGB(255, 230, 75)

        End If

    End For

    If Town.HasTeleportSpawn Then
        Call DrawArrival(Town, Town.TeleportSpawn, 180.0, View)
    End If

    End Clip

End Sub

Private Sub DrawArrival(ByRef Town As Document.State, Position As P.Vector3,
    Heading As Double, View As P.Camera3D)

    Dim Segment As Number
    Dim Angle As Double
    Dim Mark As Guides.Marker
    Dim Sample As Terrain.Sample

    For Segment = 0 To 32

        Angle = ToDouble(Segment) * 6.283185307179586 / 32.0
        Mark.Last = P.Vector(Position.X + Cos(Angle) * 22.0, 0.0, Position.Z + Sin(Angle) * 22.0)
        Sample = Terrain.SamplePoint(Town.Surface, Mark.Last.X, Mark.Last.Z)
        Mark.Last.Y = Sample.Offset + Layers.OVERLAY_Y

        If Segment > 0 Then
            Call Guides.DrawMarker(Mark, View, RGB(20, 155, 255))
        End If

        Mark.First = Mark.Last
    End For

    Angle = (Heading - 180.0) * 0.017453292519943295
    Mark.First = P.Vector(Position.X, Position.Y + Layers.OVERLAY_Y, Position.Z)
    Sample = Terrain.SamplePoint(Town.Surface, Position.X, Position.Z)
    Mark.First.Y = Sample.Offset + Layers.OVERLAY_Y
    Mark.Last = P.Vector(Position.X + Sin(Angle) * 30.0, Mark.First.Y, Position.Z + Cos(Angle) * 30.0)

    Call Guides.DrawMarker(Mark, View, RGB(20, 155, 255))

End Sub

End Module
