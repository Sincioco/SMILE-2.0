''' Editor presentation for transparent map-load cells. Mutations stay in TownMapLoads.
Module Smile.Tools.TownMapLoadTools

Option Explicit

Import Smile.Tools.TownDocument As Document
Import Smile.Tools.TownMapLoads As Links
Import Smile.Tools.TownGuides As Guides
Import Smile.Simple3D.SurfaceGrid3D As Grid
Import Smile.Simple3D.Precision3D As P

Private Dim Borders As Links.Outline

Public Type State
    Drawing As Boolean
    Pending As Boolean
    Reassign As Boolean
    First As P.Vector3
    Last As P.Vector3
    Message As Text
End Type

Public Sub Gesture(ByRef Value As State, ByRef Town As Document.State,
    Point As P.Vector3, Available As Boolean, Pressed As Boolean, Held As Boolean, Tool As Number)

    Dim X As Number
    Dim Z As Number
    Dim Index As Number
    Dim Ok As Boolean

    If Value.Pending Then
        Return
    End If

    If Value.Drawing Then

        If Available Then
            Value.Last = Point
        End If

        If Not Held Then

            Value.Drawing = False
            Value.Pending = True
            Value.Message = "Choose the destination map."

        End If

    Else If Available And Pressed Then

        X = Grid.CellX(Town.Surface, Point.X)
        Z = Grid.CellZ(Town.Surface, Point.Z)
        Index = Links.Find(Town, X, Z)

        If Tool = 19 Then

            Ok = Links.Remove(Town, X, Z)
            Value.Message = "Map Load area removed; terrain retained."

        Else If Tool = 18 And Index < 0 Then

            Value.Message = "Click inside a yellow area to reassign it."

        Else

            Value.First = Point
            Value.Last = Point
            Value.Reassign = Tool = 18
            Value.Pending = Value.Reassign
            Value.Drawing = Not Value.Reassign

        End If

    End If

End Sub

Public Function Apply(ByRef Value As State, ByRef Town As Document.State, Name As Text) As Boolean

    Dim X0 As Number
    Dim Z0 As Number
    Dim X1 As Number
    Dim Z1 As Number
    Dim Index As Number
    Dim Ok As Boolean

    If Not Value.Pending Then
        Return False
    End If

    ' The session persists the chosen open map before applying this gesture.

    If Not Document.ValidName(Name) Or Name = Town.Name Then
        Value.Message = "Choose a different destination map."
        Return False
    End If

    X0 = Grid.CellX(Town.Surface, Min(Value.First.X, Value.Last.X))
    Z0 = Grid.CellZ(Town.Surface, Min(Value.First.Z, Value.Last.Z))
    X1 = Grid.CellX(Town.Surface, Max(Value.First.X, Value.Last.X))
    Z1 = Grid.CellZ(Town.Surface, Max(Value.First.Z, Value.Last.Z))

    If Value.Reassign Then

        Index = Links.Find(Town, X0, Z0)
        Ok = Index >= 0

        If Ok Then
            Call Links.AssignConnected(Town, Index, Name)
        End If

    Else

        Ok = Links.PlaceRectangle(Town, X0, Z0, X1, Z1, Name)

    End If

    Value.Message = "Area exceeds map bounds or 4096 tiles."

    If Ok Then
        Value.Pending = False
        Value.Message = "Map Load: " + Name
    End If

    Return Ok

End Function

Public Sub DrawPreview(ByRef Value As State, View As P.Camera3D)

    Dim Mark As Guides.Marker

    If Value.Drawing Or Value.Pending Then

        Mark.First = Value.First
        Mark.Last = Value.Last
        Mark.IsRectangle = True

        Call Guides.DrawMarker(Mark, View, RGB(255, 220, 40))

    End If

End Sub

Public Sub Draw(ByRef Town As Document.State, View As P.Camera3D, RightEdge As Number)

    Dim Index As Number
    Dim X As Number
    Dim Z As Number
    Dim Side As Number
    Dim Mark As Guides.Marker

    If Town.MapTileCount = 0 Then
        Return
    End If

    Clip Rectangle 0, 128, Max(0, RightEdge), Max(0, Window_Height() - 128)

    Call Links.BuildOutline(Town, Borders)

    For Index = 0 To Town.MapTileCount - 1

        X = Town.MapTiles[Index].X
        Z = Town.MapTiles[Index].Z

        For Side = 0 To 3

            If Borders.Edge[Index, Side] Then

                Mark.First = P.Vector(Town.Surface.XEdges[X], 23.4, Town.Surface.ZEdges[Z])
                Mark.Last = P.Vector(Town.Surface.XEdges[X + 1], 23.4, Town.Surface.ZEdges[Z + 1])

                If Side = 0 Then
                    Mark.Last.X = Mark.First.X
                Else If Side = 1 Then
                    Mark.First.X = Mark.Last.X
                Else If Side = 2 Then
                    Mark.Last.Z = Mark.First.Z
                Else
                    Mark.First.Z = Mark.Last.Z
                End If

                Call Guides.DrawMarker(Mark, View, RGB(255, 220, 40))

            End If

        End For
    End For

    End Clip

End Sub

End Module
