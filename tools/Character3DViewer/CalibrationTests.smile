''' Injected in place of the interactive startup only; all Viewer procedures are real.
Const TEST_IMPORT_REJECTION_COUNT = 0
Dim TestFailures As Number
Dim TestIndex As Number
Dim TestSavedCount As Number
Dim TestTransactionResult As Boolean
Dim TestCalibrationTransaction As ViewerCalibration.TransactionResult
Dim TestCalibrationOperation As ViewerCalibrationEditing.OperationResult
Dim TestPartyUpdate As ViewerParty.ParticipantUpdateResult
Dim TestFireAge As Number
Dim TestFireGeneration As Number
Dim TestFireAdvanceCount As Number
Dim TestVisualEpoch As Number
Dim TestAnchor As Core.Vector3
Dim TestPosition As Core.Vector3
Dim TestTwin As Character3D.Actor
Dim TestFormationCenter As Core.Vector3
Dim TestFormationFirst As Core.Vector3
Dim TestFormationMiddle As Core.Vector3
Dim TestFormationLast As Core.Vector3
Dim TestLightning As Lightning.LightningEffect
Dim TestLightningAge As Number
Dim TestLightningSource As Core.Vector3
Dim TestLightningTarget As Core.Vector3
Dim TestDataKey As Text
Dim TestSavedJson As Text
Dim TestUndoCount As Number
Dim TestImportFixtureBytes[150000] As Number

Game Window "SMILE Calibration Isolation Tests" Size 640 By 480

Call CalibrationCheck(ViewerProfiles.CalibrationFingerprint(ViewerProfiles.PROFILE_ARIN) =
    TEST_ARIN_PROFILE_FINGERPRINT, "Arin runtime fingerprint matches canonical package")
Call CalibrationCheck(ViewerProfiles.CalibrationFingerprint(ViewerProfiles.PROFILE_ORIN) =
    TEST_ORIN_PROFILE_FINGERPRINT, "Orin runtime fingerprint matches canonical package")

Session.ProfileIndex = ViewerProfiles.PROFILE_ARIN

Call LoadViewer()
Call CalibrationCheck(Session.Ready And Not Session.ViewerError, "Load profile")
Call CheckEquipmentRimRecovery()
Call CheckVraxAttackEffects()
Call CheckZaraAttackEffects()
Call CheckEquipmentGlowAlignment()
Call CalibrationCheck(Not Calibration.StorageRejected, "Accept current Arin saved calibration")
Call CheckGizmoVisibility()
Call CheckPackagedCalibration()
Call CalibrationCheck(Character3D.SocketCount(Character) = ActiveProfile.ExpectedSocketCount,
    "Profile socket contract")
Call CheckImportedProfileTabs()
Call CheckMiraBattles()
Call SelectCharacterTab(1)
Call CalibrationCheck(Session.Ready And Not Session.ViewerError And Not Calibration.StorageRejected,
    "Orin loads with its canonical saved calibration")
Call CheckEquipmentGlowAlignment()
Call CheckPackagedCalibration()
Call SelectCharacterTab(2)
Call CalibrationCheck(Session.Ready And Not Session.ViewerError And Party.Ready,
    "Dragon loads both calibrated companions")
Call CheckFractionalPartySubmission()
Call CheckDragonBattleFireBudget()
Call SelectCharacterTab(1)
Call SelectCharacterTab(2)
Call CheckDragonFireContinuity()

TestTransactionResult = ApplyActorPresentationCommand(
    ViewerUi.INSPECTOR_ACTION_SWORD,
    ViewerInspectorCommands.ACTOR_ACTION_SOURCE_INSPECTOR_POINTER)
TestTransactionResult = ApplyActorPresentationCommand(
    ViewerUi.INSPECTOR_ACTION_SHIELD,
    ViewerInspectorCommands.ACTOR_ACTION_SOURCE_INSPECTOR_POINTER) And TestTransactionResult

Call CalibrationCheck(Session.Ready And Not Equipment.SwordVisible And
    Not Equipment.ShieldVisible,
    "Dragon inspection applies hidden equipment intent to both opponents")

TestTransactionResult = ApplyActorPresentationCommand(
    ViewerUi.INSPECTOR_ACTION_SWORD,
    ViewerInspectorCommands.ACTOR_ACTION_SOURCE_INSPECTOR_POINTER)
TestTransactionResult = ApplyActorPresentationCommand(
    ViewerUi.INSPECTOR_ACTION_SHIELD,
    ViewerInspectorCommands.ACTOR_ACTION_SOURCE_INSPECTOR_POINTER) And TestTransactionResult

Call CalibrationCheck(Session.Ready And Equipment.SwordVisible And
    Equipment.ShieldVisible,
    "Dragon inspection restores equipment visibility for both opponents")
Call SelectCharacterTab(3)
Call CalibrationCheck(Session.Ready And Not Session.ViewerError And Party.Ready,
    "Party loads both calibrated heroes")
Call CalibrationCheck(
    Party.Companion.Profile = ViewerProfiles.PROFILE_ORIN And
    Party.Companion.CalibrationAvailable And
    Calibration.KeyBase = 0 And
    Session.ProfileIndex = ViewerProfiles.PROFILE_ARIN,
    "Party owner creates the calibrated companion without replacing primary context")

TestTransactionResult = ApplyActorPresentationCommand(
    ViewerUi.INSPECTOR_ACTION_SWORD,
    ViewerInspectorCommands.ACTOR_ACTION_SOURCE_INSPECTOR_POINTER)
TestTransactionResult = ApplyActorPresentationCommand(
    ViewerUi.INSPECTOR_ACTION_SHIELD,
    ViewerInspectorCommands.ACTOR_ACTION_SOURCE_INSPECTOR_POINTER) And TestTransactionResult

Call CalibrationCheck(Session.Ready And Not Equipment.SwordVisible And
    Not Equipment.ShieldVisible,
    "Party mode applies hidden equipment intent to both calibrated heroes")

TestTransactionResult = ApplyActorPresentationCommand(
    ViewerUi.INSPECTOR_ACTION_SWORD,
    ViewerInspectorCommands.ACTOR_ACTION_SOURCE_INSPECTOR_POINTER)
TestTransactionResult = ApplyActorPresentationCommand(
    ViewerUi.INSPECTOR_ACTION_SHIELD,
    ViewerInspectorCommands.ACTOR_ACTION_SOURCE_INSPECTOR_POINTER) And TestTransactionResult

Call CalibrationCheck(Session.Ready And Equipment.SwordVisible And
    Equipment.ShieldVisible,
    "Party mode restores equipment visibility for both calibrated heroes")

TestIndex = Calibration.KeyBase
TestPartyUpdate = ViewerParty.UpdateCompanion(
    Party, Calibration, Effects, 0, False)

Call CalibrationCheck(TestPartyUpdate.Updated And TestPartyUpdate.Ready And
    Calibration.KeyBase = TestIndex,
    "Party owner updates its calibrated companion and restores the primary bank")
Call CheckPartyInspector()
Call CheckBeatSequence()
Call SelectCharacterTab(0)
Call CalibrationCheck(Session.Ready And Not Session.ViewerError And Not Calibration.StorageRejected,
    "Return to Arin after Dragon and Party")

Calibration.ImportPending = True
Session.CharacterSwitchBlocked = False

Call SelectCharacterTab(1)
Call CalibrationCheck(Session.SelectedCharacterTab = 0 And Session.CharacterSwitchBlocked,
    "Pending import blocks an actor switch without losing its owner")

Calibration.ImportPending = False
Session.CharacterSwitchBlocked = False

''' The remaining editing checks start from an empty isolated track.

Call ViewerCalibration.ResetBank(Calibration)

Calibration.Saved = False
Calibration.StorageCount = 0
Calibration.UndoCount = 0

TestTransactionResult = ViewerCalibration.Persist(
    Calibration, Character, Playback.SelectedClip,
    ViewerUiState.CalibrationEditing, False)

Call RestartPresentation()

TestIndex = ViewerPlayback.PresentationIndexForRuntimeClip(
    Character, Session.ProfileIndex, Playback.SelectedClip)

Call CalibrationCheck(ViewerPlayback.RuntimeClipForPresentationIndex(
    Character, Session.ProfileIndex, TestIndex) = Playback.SelectedClip,
    "Playback owner maps presentation and runtime clips")
Call CalibrationCheck(ViewerPlayback.SelectedClipName(Character, Playback) =
    Character3D.ClipName(Character, Playback.SelectedClip),
    "Playback owner resolves the selected runtime clip name")

Playback.AnimationCycleElapsed = 123
Playback.SelectedClip = ViewerPlayback.RuntimeClipForPresentationIndex(
    Character, Session.ProfileIndex, 1)

Call ViewerPlayback.RestartPresentation(
    Playback, Character, Session.ProfileIndex)

Call CalibrationCheck(Playback.AnimationCycleElapsed = 0 And
    ViewerPlayback.PresentationIndexForRuntimeClip(
        Character, Session.ProfileIndex, Playback.SelectedClip) = 0,
    "Playback owner restarts the first presentation clip")

Playback.SelectedTimelineEvent = -1

Call ViewerPlayback.RefreshSelectedTimelineEvent(Playback, Character)
Call CalibrationCheck(Playback.SelectedTimelineEvent =
    ViewerPlayback.FirstClipEvent(Character, Playback.SelectedClip),
    "Playback owner refreshes the selected clip event")

Playback.AnimationCycleElapsed = 123
Playback.DemoCompletedLoops = 2
TestTransactionResult = ViewerPlayback.StartSelectedClip(
    Playback, Character, Session.ProfileIndex)

Call CalibrationCheck(TestTransactionResult And
    Playback.AnimationCycleElapsed = 0 And
    Playback.DemoCompletedLoops = 0 And
    Playback.SelectedTimelineEvent = ViewerPlayback.FirstClipEvent(
        Character, Playback.SelectedClip),
    "Playback owner starts a clip and resets its cycle state")

Playback.ScenePaused = False

Session.Ready = ViewerPlayback.SeekFirstFrame(
    Playback, Character) And Session.Ready

Call CalibrationCheck(Playback.ScenePaused And Character3D.AnimationTime(Character) = 0,
    "0-Frame pauses the scene at frame zero")

Playback.ScenePaused = False

Session.Ready = ViewerPlayback.StepFrame(
    Playback, Character, 1) And Session.Ready

Call CalibrationCheck(Playback.ScenePaused And Character3D.AnimationTime(Character) > 0,
    "Frame forward pauses before stepping")

Playback.ScenePaused = False

Session.Ready = ViewerPlayback.StepFrame(
    Playback, Character, -1) And Session.Ready

Call CalibrationCheck(Playback.ScenePaused And Character3D.AnimationTime(Character) = 0,
    "Frame backward pauses before stepping")

Playback.ScenePaused = False

Call ApplyTimelineCommand(
    ViewerTimelineEditing.COMMAND_SEEK_ADJACENT_KEY, -1)
Call CalibrationCheck(Playback.ScenePaused, "Previous key pauses even without saved keys")

Playback.ScenePaused = False

Call ApplyTimelineCommand(
    ViewerTimelineEditing.COMMAND_SEEK_ADJACENT_KEY, 1)
Call CalibrationCheck(Playback.ScenePaused, "Next key pauses even without saved keys")

Session.Ready = ViewerLifecycle.ToggleScenePause(
    Session, Party, Character, Playback, Session.ProfileIndex,
    ViewerUiState, ViewerInputState, Calibration,
    CalibrationAvailable, Effects) And Session.Ready

Call CalibrationCheck(Not Playback.ScenePaused, "Space-style toggle resumes after navigation")

TestTwin = Character3D.LoadWithPolicy(ActiveProfile.AssetPath,
    Character3D.CHARACTER_LOAD_REQUIRE_PBR)

Call CalibrationCheck(Character3D.IsValid(TestTwin) And TestTwin.Handle <> Character.Handle,
    "Two instances of the same model have independent handles")

Session.Ready = Character3D.PlayMode(Character, "Idle", Graphics3D.ANIMATION_LOOP, 100) And Session.Ready
Session.Ready = Character3D.PlayMode(TestTwin, "SwordAttack", Graphics3D.ANIMATION_ONCE, 100) And Session.Ready
Session.Ready = Character3D.SetAnimationTime(Character, 111) And Session.Ready
Session.Ready = Character3D.SetAnimationTime(TestTwin, 444) And Session.Ready

Call CalibrationCheck(Character3D.CurrentClipNameMatches(Character, "Idle") And
    Character3D.CurrentClipNameMatches(TestTwin, "SwordAttack"),
    "Two instances retain different clips")
Call CalibrationCheck(Character3D.AnimationTime(Character) = 111 And
    Character3D.AnimationTime(TestTwin) = 444, "Two instances retain different times")

Session.Ready = Character3D.Update(Character, 16) And Session.Ready

Call CalibrationCheck(Character3D.AnimationTime(Character) > 111 And
    Character3D.AnimationTime(TestTwin) = 444, "Advancing one instance does not advance the other")

Call Character3D.Destroy(TestTwin)

Call ViewerParty.SetPresentationState(Party, 0, ViewerParty.STATE_HIT)
Call ViewerParty.SetPresentationState(Party, 1, ViewerParty.STATE_KO)
Call CalibrationCheck(ViewerParty.PresentationState(Party, 0) = ViewerParty.STATE_HIT And
    ViewerParty.PresentationState(Party, 1) = ViewerParty.STATE_KO,
    "Party actor states remain independent")
Call CalibrationCheck(ViewerParty.PresentationStateName(ViewerParty.STATE_ALIVE) = "Alive" And
    ViewerParty.PresentationStateName(ViewerParty.STATE_ACTING) = "Acting" And
    ViewerParty.PresentationStateName(ViewerParty.STATE_GUARDING) = "Guarding" And
    ViewerParty.PresentationStateName(ViewerParty.STATE_HIT) = "Hit" And
    ViewerParty.PresentationStateName(ViewerParty.STATE_KO) = "KO" And
    ViewerParty.PresentationStateName(ViewerParty.STATE_REVIVING) = "Reviving",
    "Party presentation states are explicit")

Call ViewerParty.SetPresentationState(Party, 0, ViewerParty.STATE_ALIVE)
Call ViewerParty.SetPresentationState(Party, 1, ViewerParty.STATE_ALIVE)

TestFormationCenter.X = ViewerDragon.PositionX()
TestFormationCenter.Z = ViewerDragon.PositionZ()
TestFormationFirst = ViewerParty.FormationPosition(
    TestFormationCenter, PARTY_FORMATION_RADIUS,
    PARTY_FORMATION_START_ANGLE, PARTY_FORMATION_END_ANGLE, 0, 3)
TestFormationMiddle = ViewerParty.FormationPosition(
    TestFormationCenter, PARTY_FORMATION_RADIUS,
    PARTY_FORMATION_START_ANGLE, PARTY_FORMATION_END_ANGLE, 1, 3)
TestFormationLast = ViewerParty.FormationPosition(
    TestFormationCenter, PARTY_FORMATION_RADIUS,
    PARTY_FORMATION_START_ANGLE, PARTY_FORMATION_END_ANGLE, 2, 3)

Call CalibrationCheck(Math3D.Distance(TestFormationFirst, TestFormationMiddle) > 200 And
    Math3D.Distance(TestFormationMiddle, TestFormationLast) > 200,
    "Wider front-arc formation spaces party members apart")
Call CalibrationCheck(Math3D.Distance(TestFormationCenter, TestFormationMiddle) > 400,
    "Party formation begins substantially farther from the boss")

Call ViewerCalibration.ResetBank(Calibration)

Playback.ScenePaused = True
Playback.DemoEnabled = False
Playback.SelectedClip = 3
ViewerUiState.CalibrationTarget = ViewerUi.CALIBRATION_TARGET_SWORD
ViewerUiState.CalibrationAxis = ViewerUi.CALIBRATION_AXIS_X

Call PlaySelectedClip()

Call ViewerCalibration.SetChannelValue(Calibration, 3, 12, 2)

Calibration.Saved = True
Calibration.SavedClip = 3
Calibration.SavedFrame = 0

Call CalibrationCheck(ViewerCalibration.StoreKey(Calibration, 3, 0), "Store first key")

Calibration.KeyBase = CALIBRATION_MAX_CLIPS

Call ViewerCalibration.ResetBank(Calibration)

Call ViewerCalibration.SetChannelValue(Calibration, 3, 12, 19)

Call CalibrationCheck(ViewerCalibration.StoreKey(Calibration, 3, 0), "Second character stores its own frame")

Calibration.KeyBase = 0

Call CalibrationCheck(ViewerCalibration.KeyValue(Calibration, 3, 0, 12) = 2,
    "Second character does not modify Arin's frame")

Calibration.KeyBase = CALIBRATION_MAX_CLIPS

Call CalibrationCheck(ViewerCalibration.KeyValue(Calibration, 3, 0, 12) = 19,
    "Same clip and frame retain distinct values")
Call ViewerCalibration.ResetBank(Calibration)

Calibration.KeyBase = 0

Call CalibrationCheck(ViewerCalibration.KeyCount(Calibration, 3) = 1,
    "Clearing another character preserves Arin")

Calibration.Saved = True
Calibration.SavedClip = 3
Calibration.SavedFrame = 0

TestTransactionResult = ViewerCalibration.Persist(
    Calibration, Character, Playback.SelectedClip,
    ViewerUiState.CalibrationEditing)

Call ApplyCalibrationControlForTest(ViewerUi.CALIBRATION_ACTION_UNDO)
Call CalibrationCheck(ViewerCalibration.KeyCount(Calibration, 3) = 0,
    "Undo also restores a never-saved empty track")

Calibration.Saved = True
Calibration.SavedClip = 3
Calibration.SavedFrame = 0

Call ViewerCalibration.SetChannelValue(Calibration, 3, 12, 2)

Call CalibrationCheck(ViewerCalibration.StoreKey(Calibration, 3, 0), "Restore first key")

TestTransactionResult = ViewerCalibration.Persist(
    Calibration, Character, Playback.SelectedClip,
    ViewerUiState.CalibrationEditing)

Call ViewerCalibration.SetChannelValue(Calibration, 3, 12, 7)

Call ViewerCalibration.Reload(Calibration, Character)
Call CalibrationCheck(ViewerCalibration.KeyCount(Calibration, 3) = 1 And
    ViewerCalibration.KeyValue(Calibration, 3, 0, 12) = 2,
    "Saved edits take precedence over packaged defaults")

Call ViewerCalibration.CopyKey(Calibration, 3, 0)

TestCalibrationTransaction = ViewerCalibration.DeleteCurrentKeyAndPersist(
    Calibration, Character, 3, False, False)

Call CalibrationCheck(TestCalibrationTransaction.Applied And
    TestCalibrationTransaction.Persisted And
    ViewerCalibration.KeyCount(Calibration, 3) = 0,
    "Delete transaction mutates and validates through its owner")

Call CalibrationCheck(ViewerCalibration.PasteClipboardAndPersist(
    Calibration, Character, 3, False, False) And
    ViewerCalibration.KeyValue(Calibration, 3, 0, 12) = 2,
    "Paste transaction restores and validates through its owner")

Call ViewerCalibration.SetChannelValue(Calibration, 3, 12, 7)

Call CalibrationCheck(ViewerCalibration.StoreKey(Calibration, 3, 10), "Store second key")

TestTransactionResult = ViewerCalibration.Persist(
    Calibration, Character, Playback.SelectedClip,
    ViewerUiState.CalibrationEditing)

Call CalibrationCheck(ViewerCalibration.KeyValue(Calibration, 3, 0, 12) = 2,
    "Second key cannot modify first")
Call CalibrationCheck(ViewerCalibration.KeyValue(Calibration, 3, 1, 12) = 7,
    "Second key stores full move channels")
Call CalibrationCheck(ViewerCalibration.AdjacentKeyFrame(
    Calibration, 3, 0, -1) = 10 And
    ViewerCalibration.AdjacentKeyFrame(Calibration, 3, 0, 1) = 10 And
    ViewerCalibration.AdjacentKeyFrame(Calibration, 3, 10, 1) = 0,
    "Calibration owner navigates adjacent keyframes with wraparound")

TestCalibrationTransaction = ViewerCalibration.MoveKeyAndPersist(
    Calibration, Character, 3, 1, 12, False, False)

Call CalibrationCheck(TestCalibrationTransaction.Applied And
    TestCalibrationTransaction.Persisted And
    ViewerCalibration.KeyFrame(Calibration, 3, 1) = 12,
    "Move transaction reorders and validates through its owner")

TestCalibrationTransaction = ViewerCalibration.MoveKeyAndPersist(
    Calibration, Character, 3, 1, 10, False, False)

Call CalibrationCheck(TestCalibrationTransaction.Applied And
    TestCalibrationTransaction.Persisted And
    ViewerCalibration.KeyFrame(Calibration, 3, 1) = 10,
    "Move transaction restores the original test frame")

''' Failed Save/Undo must retain both the last saved bytes and the undo opportunity.
TestDataKey = Calibration.DataKey
TestSavedJson = ViewerCalibration.SavedJson(Calibration, Character)
TestUndoCount = Calibration.UndoCount
Calibration.DataKey = "Viewer Denied Storage Probe"

Call ApplyCalibrationControlForTest(ViewerUi.CALIBRATION_ACTION_UNDO)
Call CalibrationCheck(Calibration.WriteFailed And Not Calibration.StorageRejected,
    "Failed undo remains recoverable")
Call CalibrationCheck(ViewerCalibration.SavedJson(Calibration, Character) = TestSavedJson And
    Calibration.UndoCount = TestUndoCount, "Failed undo keeps saved JSON and undo")
Call CalibrationCheck(ViewerCalibration.KeyCount(Calibration, 3) = 2 And
    ViewerCalibration.KeyValue(Calibration, 3, 1, 12) = 7,
    "Failed undo restores complete key track")
Call ViewerParty.BeginPreviewSession(Party, Character, Playback, Session.ProfileIndex)
Call ViewerCalibrationEditing.BeginEdit(
    Calibration, Character, Playback.SelectedClip,
    ViewerUiState, ViewerCameraState, Effects)

Call ViewerCalibration.SetChannelValue(Calibration, 3, 12, 9)

Call ApplyCalibrationControlForTest(ViewerUi.CALIBRATION_ACTION_SAVE)
Call CalibrationCheck(Calibration.WriteFailed And ViewerUiState.CalibrationEditing,
    "Failed Save Frame keeps edit open for retry or cancel")
Call CalibrationCheck(ViewerCalibration.SavedJson(Calibration, Character) = TestSavedJson,
    "Failed Save Frame does not become downloadable saved JSON")
Call CalibrationCheck(ViewerCalibration.ChannelValue(Calibration, 3, 12) = 9,
    "Failed Save Frame retains the temporary preview adjustment")
Call CancelCalibrationEdit()

Calibration.DataKey = TestDataKey

Call ApplyCalibrationControlForTest(ViewerUi.CALIBRATION_ACTION_UNDO)
Call CalibrationCheck(ViewerCalibration.KeyCount(Calibration, 3) = 1, "Undo insertion")
Call CalibrationCheck(ViewerCalibration.KeyValue(Calibration, 3, 0, 12) = 2,
    "Undo preserves all channels")
Call ApplyCalibrationControlForTest(ViewerUi.CALIBRATION_ACTION_CLEAR)
Call CalibrationCheck(ViewerCalibration.KeyCount(Calibration, 3) = 0,
    "Selected clip cleared")
Call ApplyCalibrationControlForTest(ViewerUi.CALIBRATION_ACTION_UNDO)
Call CalibrationCheck(ViewerCalibration.KeyCount(Calibration, 3) = 1,
    "Undo selected clip delete")

TestSavedCount = Calibration.StorageCount

Call ViewerCalibration.SetStorageByte(10, 0)

Call CalibrationCheck(Not ViewerCalibration.ValidateStorage(
    Calibration, Character, TestSavedCount), "Reject profile fingerprint")

Call ViewerCalibration.SetStorageByte(
    10, Text_Code_At(Calibration.ProfileFingerprint, 0))

Call CalibrationCheck(ViewerCalibration.ValidateStorage(
    Calibration, Character, TestSavedCount), "Decode all named clips")
Call ApplyWristCalibration()
Call ApplyEquipmentCalibration()

ViewerGizmoState.HoldGrip = True
ViewerUiState.CalibrationTransform = ViewerUi.CALIBRATION_TRANSFORM_ROTATE
TestAnchor = ViewerCalibration.EquipmentGripThousandths(
    Character, WEAPON_PART_INDEX, "HandRight")

For TestIndex = 1 To 6

    Call SetCurrentCalibrationValue(45)
    Call ApplyCalibrationControlForTest(ViewerUi.CALIBRATION_ACTION_SAVE)
    Call ApplyCalibrationControlForTest(ViewerUi.CALIBRATION_ACTION_RELOAD)
    Call SetCurrentCalibrationValue(0)
    Call ApplyCalibrationControlForTest(ViewerUi.CALIBRATION_ACTION_SAVE)
    Call ApplyCalibrationControlForTest(ViewerUi.CALIBRATION_ACTION_RELOAD)
End For

TestPosition = ViewerCalibration.EquipmentGripThousandths(
    Character, WEAPON_PART_INDEX, "HandRight")

Call CalibrationCheck(Abs(TestPosition.X - TestAnchor.X) < 1000 And
    Abs(TestPosition.Y - TestAnchor.Y) < 1000 And Abs(TestPosition.Z - TestAnchor.Z) < 1000,
    "Repeated in-place inverse rotations do not accumulate whole-unit drift")
Call CalibrationCheck(ViewerRendering.SocketReferencePart(
    True, "SwordTip", BODY_PART_INDEX, WEAPON_PART_INDEX, SHIELD_PART_INDEX) = WEAPON_PART_INDEX,
    "Sword marker owns equipment transform")
Call CalibrationCheck(ViewerRendering.SocketReferencePart(
    True, "ShieldFireTip", BODY_PART_INDEX, WEAPON_PART_INDEX,
    SHIELD_PART_INDEX) = SHIELD_PART_INDEX,
    "Shield marker owns equipment transform")
Call CalibrationCheck(ViewerRendering.SocketReferencePart(
    True, "HandRight", BODY_PART_INDEX, WEAPON_PART_INDEX, SHIELD_PART_INDEX) = BODY_PART_INDEX,
    "Hand marker owns wrist transform")

Timing.CameraElapsed = 16
Effects.FlamePaused = False

Call UpdateTestEquipmentFire()
Call AdvanceTestSceneVfx()
Call CalibrationCheck(Effects.SwordFire.Slot <> 0 And Not Effects.ShieldFireFailed, "All equipment emitters admitted")

TestFireAge = Fire.Value(10, Effects.SwordFire)

Call UpdateTestEquipmentFire()
Call AdvanceTestSceneVfx()
Call CalibrationCheck(Fire.Value(10, Effects.SwordFire) > TestFireAge, "Flames animate while scene paused")

Effects.FlamePaused = True
TestFireAge = Fire.Value(10, Effects.SwordFire)

Call UpdateTestEquipmentFire()
Call AdvanceTestSceneVfx()
Call CalibrationCheck(Fire.Value(10, Effects.SwordFire) = TestFireAge, "Paused flame clock stays frozen")

TestFireGeneration = Effects.SwordFire.Generation
Equipment.SwordVisible = False
Equipment.ShieldVisible = False

Call UpdateTestEquipmentFire()
Call AdvanceTestSceneVfx()
Call CalibrationCheck(Effects.SwordFire.Slot = 0, "Hidden sword destroys frozen Fire immediately")
Call CalibrationCheck(Not ArinShieldRim.IsVisible(Effects.ShieldRim),
    "Hidden shield clears the frozen ember outline immediately")

Equipment.SwordVisible = True
Equipment.ShieldVisible = True

Call UpdateTestEquipmentFire()
Call AdvanceTestSceneVfx()
Call CalibrationCheck(Effects.SwordFire.Slot = 0 And Not ArinShieldRim.IsVisible(Effects.ShieldRim),
    "Showing equipment while frozen does not resurrect stale effects")

Effects.FlamePaused = False

Call UpdateTestEquipmentFire()
Call AdvanceTestSceneVfx()
Call CalibrationCheck(Effects.SwordFire.Slot <> 0 And Effects.SwordFire.Generation <> TestFireGeneration,
    "Fire resumes from a new current attachment after a frozen hide")

Effects.FlamePaused = True

TestVisualEpoch = Effects.VisualContinuityEpoch

Call ApplyTimelineCommand(
    ViewerTimelineEditing.COMMAND_SEEK_FIRST_FRAME, 0)
Call CalibrationCheck(Effects.VisualContinuityEpoch > TestVisualEpoch, "Seek invalidates visual history")
Call UpdateTestEquipmentFire()
Call AdvanceTestSceneVfx()
Call CalibrationCheck(Fire.Value(10, Effects.SwordFire) = 0, "Seek does not warm up paused flames")

Effects.FlamePaused = False

Call UpdateTestEquipmentFire()
Call AdvanceTestSceneVfx()
Call CalibrationCheck(Fire.Value(10, Effects.SwordFire) <= 20, "Flame resume has no catch-up burst")

Effects.SwordFireReady = False
TestFireAge = Fire.Value(10, Effects.SwordFire)
TestFireAdvanceCount = Effects.Clock.FireAdvanceCount

Call UpdateTestEquipmentFire()
Call AdvanceTestSceneVfx()
Call CalibrationCheck(Fire.Value(10, Effects.SwordFire) > TestFireAge,
    "Unavailable equipment component does not stall shared Fire")
Call CalibrationCheck(Effects.Clock.FireAdvanceCount = TestFireAdvanceCount + 1,
    "Shared Fire advances exactly once per scene frame")

Effects.SwordFireReady = Effects.FireInitialized

Effects.LightningInitialized = Lightning.Initialize("Assets/Lightning", 8192,
    Graphics3D.GPU_PARTICLE_SIMULATION_AUTO, 4096)
TestLightningTarget.X = 40
TestLightningTarget.Y = 80
TestLightning = Lightning.StartAt("StoredStorm", TestLightningSource,
    TestLightningTarget, 8647, Lightning.QUALITY_MEDIUM)

Call CalibrationCheck(Effects.LightningInitialized And TestLightning.Slot <> 0,
    "Shared Lightning test effect admitted")

Effects.FlamePaused = False
Effects.LightningPaused = False
TestFireAge = Fire.Value(10, Effects.SwordFire)
TestLightningAge = Lightning.Value(Lightning.QUERY_AGE, TestLightning)

Call AdvanceTestSceneVfx()
Call CalibrationCheck(Playback.ScenePaused And
    Fire.Value(10, Effects.SwordFire) > TestFireAge And
    Lightning.Value(Lightning.QUERY_AGE, TestLightning) > TestLightningAge,
    "Scene pause leaves Fire and Lightning animating by default")

Effects.LightningPaused = True
TestFireAge = Fire.Value(10, Effects.SwordFire)
TestLightningAge = Lightning.Value(Lightning.QUERY_AGE, TestLightning)

Call AdvanceTestSceneVfx()
Call CalibrationCheck(Fire.Value(10, Effects.SwordFire) > TestFireAge And
    Lightning.Value(Lightning.QUERY_AGE, TestLightning) = TestLightningAge,
    "Frozen Lightning does not stop Fire")

Effects.FlamePaused = True
Effects.LightningPaused = False
TestFireAge = Fire.Value(10, Effects.SwordFire)
TestLightningAge = Lightning.Value(Lightning.QUERY_AGE, TestLightning)

Call AdvanceTestSceneVfx()
Call CalibrationCheck(Fire.Value(10, Effects.SwordFire) = TestFireAge And
    Lightning.Value(Lightning.QUERY_AGE, TestLightning) > TestLightningAge,
    "Frozen Fire does not stop Lightning")

Session.Ready = Lightning.Destroy(TestLightning) And Session.Ready

Call Lightning.Shutdown()

Effects.LightningInitialized = False
Effects.FlamePaused = False
Effects.LightningPaused = False

TestFireGeneration = Effects.SwordFire.Generation

Call PlaySelectedClip(True)
Call UpdateTestEquipmentFire()
Call AdvanceTestSceneVfx()
Call CalibrationCheck(Effects.SwordFire.Generation = TestFireGeneration, "Automatic playback keeps fire tails")
Call SelectClip(0)
Call UpdateTestEquipmentFire()
Call AdvanceTestSceneVfx()
Call CalibrationCheck(Effects.SwordFire.Generation <> TestFireGeneration, "Explicit clip selection clears old fire")

Do

    Playback.ScenePaused = True
    Timing.PresentationElapsed = 60000

    Call AdvanceAnimationSequence()
    Call CalibrationCheck(Not Playback.DemoEnabled And Playback.ScenePaused, "No idle timer enables Demo or resumes")
    Call HandleKeyboard(KEY_SPACE)
    Call CalibrationCheck(Not Playback.ScenePaused, "Space resumes")
    Call HandleKeyboard(KEY_SPACE)
    Call CalibrationCheck(Playback.ScenePaused, "Space pauses")

    Show Screen

Loop Until True

Effects.FlamePaused = True
ViewerUiState.CalibrationVisible = True
DragonState.Visible = False
Rendering.FloorVisible = False
Rendering.GridVisible = False
ViewerUiState.Visibility = 2

Call ResetAll()
Call CalibrationCheck(Not Playback.ScenePaused And Not Effects.FlamePaused And Playback.DemoEnabled, "Reset restores playback defaults")
Call CalibrationCheck(Not ViewerUiState.CalibrationVisible And ViewerUiState.Visibility = 0, "Reset hides pose panel and restores UI")
Call CalibrationCheck(DragonState.Visible And Rendering.FloorVisible And Rendering.GridVisible, "Reset restores the arena")
Call CalibrationCheck(ViewerCalibration.KeyCount(Calibration, 3) = 1,
    "Reset preserves saved corrections")

ViewerUiState.Visibility = 0

Call HandleKeyboard(KEY_BACKTICK)
Call CalibrationCheck(ViewerUiState.Visibility = 1, "First backtick hides panels")
Call HandleKeyboard(KEY_BACKTICK)
Call CalibrationCheck(ViewerUiState.Visibility = 2, "Second backtick hides all UI")
Call HandleKeyboard(KEY_BACKTICK)
Call CalibrationCheck(ViewerUiState.Visibility = 0, "Third backtick restores UI")

Call DestroyViewer()

If TestFailures = 0 Then
    Print "Viewer calibration isolation passed"
Else
    Print "Viewer calibration failures:"
    Print TestFailures
End If

Sub CalibrationCheck(Condition As Boolean, Label As Text)

    If Not Condition Then

        TestFailures = TestFailures + 1
        Print "FAIL:"
        Print Label

    End If

End Sub

Sub ApplyCalibrationControlForTest(Action As Number)

    If Action = ViewerUi.CALIBRATION_ACTION_CLEAR Then
        ViewerUiState.CalibrationClearConfirm = True
    End If

    TestCalibrationOperation = ViewerCalibrationControls.ApplyPointerAction(
        Action,
        Calibration,
        Character,
        Playback,
        Session.ProfileIndex,
        SwordWristNode,
        ShieldWristNode,
        CalibrationAvailable,
        ViewerUiState,
        ViewerGizmoState,
        ViewerCameraState,
        Effects
    )

    Call ViewerSession.ApplyCalibrationOperation(Session, TestCalibrationOperation)

End Sub

Sub CheckEquipmentRimRecovery()

    Dim RimCamera As Precision3D.Camera3D
    Dim Healthy As ArinShieldRim.Context
    Dim Trial As ArinShieldRim.Context
    Dim Original As ArinShieldRim.Context
    Dim Blockers[16] As Core.RibbonBatch3D
    Dim BaseTextures As Number
    Dim BaseMaterials As Number
    Dim BaseRibbons As Number
    Dim BlockerCount As Number
    Dim Index As Number

    RimCamera = Precision3D.FromCamera(Graphics3D.DefaultCamera())
    BaseTextures = Graphics3D.LiveTextureCount3D()
    BaseMaterials = Graphics3D.LiveMaterialCount3D()
    BaseRibbons = Graphics3D.LiveRibbonBatchCount3D()

    Call ArinShieldRim.Update(Healthy, Character, RimCamera, 16)
    Call CalibrationCheck(Healthy.Visible, "Independent rim is healthy before pressure")

    Original = Healthy
    BlockerCount = Graphics3D.VfxValue3D(Graphics3D.VFX_QUERY_MAX_RIBBON_BATCHES)
    BlockerCount = BlockerCount - Graphics3D.LiveRibbonBatchCount3D() - 2

    Call CalibrationCheck(BlockerCount > 0 And BlockerCount <= 16,
        "Bounded rim fixture leaves exactly two ribbon slots")

    For Index = 0 To BlockerCount - 1
        Blockers[Index] = Graphics3D.CreateRibbonBatch3D(2, Healthy.Material)

        Call CalibrationCheck(Blockers[Index].Handle <> 0, "Acquire pressure ribbon")
    End For

    Call ArinShieldRim.Update(Trial, Character, RimCamera, 16, 100, 0, 1)
    Call CheckEmptyEquipmentRim(Trial)
    Call CalibrationCheck(Graphics3D.LiveRibbonBatchCount3D() = BaseRibbons + 3 + BlockerCount And
        Graphics3D.LiveTextureCount3D() = BaseTextures + 1 And
        Graphics3D.LiveMaterialCount3D() = BaseMaterials + 1,
        "Failed third ribbon rolls back the complete candidate")
    Call Graphics3D.DestroyRibbonBatch3D(Blockers[0])
    Call ArinShieldRim.Update(Trial, Character, RimCamera, 16, 100, 0, 1)
    Call CalibrationCheck(Trial.Visible, "Same visible context recovers when capacity returns")

    For Index = 0 To 2

        Call CalibrationCheck(Graphics3D.RibbonBatchHandleValid3D(Trial.Ribbons[Index]),
            "Recovered rim has every required ribbon")
        Call CalibrationCheck(Healthy.Ribbons[Index].Handle = Original.Ribbons[Index].Handle And
            Graphics3D.RibbonBatchHandleValid3D(Healthy.Ribbons[Index]),
            "Independent rim retains its original ribbon")
    End For

    Call CalibrationCheck(Healthy.Texture.Handle = Original.Texture.Handle And
        Healthy.Material.Handle = Original.Material.Handle And Healthy.Visible,
        "Independent texture and material remain intact")

    Original = Trial

    For Index = 0 To 2

        Call ArinShieldRim.Update(Trial, Character, RimCamera, 16, 100, 0, 1)
        Call CalibrationCheck(Trial.Visible And Trial.Texture.Handle = Original.Texture.Handle And
            Trial.Material.Handle = Original.Material.Handle And
            Trial.Ribbons[Index].Handle = Original.Ribbons[Index].Handle,
            "Steady visible update does not reacquire resources")
    End For

    Call CalibrationCheck(Scene3D.BeginPrecise(RimCamera, 8, 12, 20),
        "Begin recovered rim submission")
    Call ArinShieldRim.Draw(Healthy)
    Call ArinShieldRim.Draw(Trial)
    Call CalibrationCheck(Scene3D.EndScene(), "End recovered rim submission")
    Call CalibrationCheck(Graphics3D.RibbonDrawCount3D() = 6,
        "Both independent rims submit all three ribbons")

    For Index = 0 To BlockerCount - 1
        Call Graphics3D.DestroyRibbonBatch3D(Blockers[Index])
    End For

    Call ArinShieldRim.Shutdown(Trial)
    Call ArinShieldRim.Shutdown(Trial)
    Call CheckEmptyEquipmentRim(Trial)
    Call ArinShieldRim.Update(Trial, Character, RimCamera, 16, 100, 0, 2)
    Call CalibrationCheck(Trial.Visible, "Hidden rim restores normally")
    Call ArinShieldRim.Shutdown(Trial)
    Call ArinShieldRim.Shutdown(Healthy)
    Call CalibrationCheck(Graphics3D.LiveTextureCount3D() = BaseTextures And
        Graphics3D.LiveMaterialCount3D() = BaseMaterials And
        Graphics3D.LiveRibbonBatchCount3D() = BaseRibbons,
        "Rim teardown returns every resource to its starting baseline")
    Call CheckEquipmentRimTextureFailure()

End Sub

Sub CheckEquipmentRimTextureFailure()

    Dim Trial As ArinShieldRim.Context
    Dim Blockers[128] As Core.Texture3D
    Dim Camera As Precision3D.Camera3D
    Dim BaseTextures As Number
    Dim BaseMaterials As Number
    Dim BaseRibbons As Number
    Dim BlockerCount As Number
    Dim Index As Number

    Camera = Precision3D.FromCamera(Graphics3D.DefaultCamera())
    BaseTextures = Graphics3D.LiveTextureCount3D()
    BaseMaterials = Graphics3D.LiveMaterialCount3D()
    BaseRibbons = Graphics3D.LiveRibbonBatchCount3D()
    BlockerCount = Graphics3D.MaximumTextureCount3D() - BaseTextures

    Call CalibrationCheck(BlockerCount > 0 And BlockerCount <= 128,
        "Bounded fixture can fill texture capacity")

    For Index = 0 To BlockerCount - 1
        Blockers[Index] = Graphics3D.LoadTexture3D("Assets/Lightning/lightning-ribbon.png")

        Call CalibrationCheck(Blockers[Index].Handle <> 0, "Acquire pressure texture")
    End For

    Call ArinShieldRim.Update(Trial, Character, Camera, 16)
    Call CheckEmptyEquipmentRim(Trial)
    Call CalibrationCheck(Graphics3D.LiveTextureCount3D() = BaseTextures + BlockerCount And
        Graphics3D.LiveMaterialCount3D() = BaseMaterials And
        Graphics3D.LiveRibbonBatchCount3D() = BaseRibbons,
        "Failed first acquisition leaves no dependent resources")
    Call Graphics3D.DestroyTexture3D(Blockers[0])
    Call ArinShieldRim.Update(Trial, Character, Camera, 16)
    Call CalibrationCheck(Trial.Visible And Trial.Texture.Handle <> 0,
        "Same rim recovers after texture capacity returns")
    Call ArinShieldRim.Shutdown(Trial)

    For Index = 0 To BlockerCount - 1
        Call Graphics3D.DestroyTexture3D(Blockers[Index])
    End For

    Call CalibrationCheck(Graphics3D.LiveTextureCount3D() = BaseTextures And
        Graphics3D.LiveMaterialCount3D() = BaseMaterials And
        Graphics3D.LiveRibbonBatchCount3D() = BaseRibbons,
        "Texture-pressure fixture returns to its resource baseline")

End Sub

Sub CheckEmptyEquipmentRim(Value As ArinShieldRim.Context)

    Dim Index As Number

    Call CalibrationCheck(Not Value.Visible And Value.Texture.Handle = 0 And
        Value.Material.Handle = 0, "Failed or hidden rim retains no initialized sentinel")

    For Index = 0 To 2
        Call CalibrationCheck(Value.Ribbons[Index].Handle = 0,
            "Failed or hidden rim retains no partial ribbon")
    End For

End Sub

Sub CheckDragonBattleFireBudget()

    Dim ClipIndex As Number
    Dim Frame As Number
    Dim Blockers[Fire.MAX_EMITTERS] As Fire.FireEmitter
    Dim Index As Number
    Dim Empty As Fire.FireEmitter
    Dim Position As Core.Vector3
    Dim Camera As Core.Camera3D

    Playback.ScenePaused = True
    Playback.AnimationUpdateElapsed = 0
    Timing.CameraElapsed = 16
    Effects.FlamePaused = False

    For ClipIndex = 0 To Character3D.ClipCount(Character) - 1

        If Character3D.ClipName(Character, ClipIndex) = "FireBreath" Then
            Call SelectClip(ClipIndex)
        End If

    End For

    Session.Ready = Character3D.SetAnimationTime(Character, 0) And Session.Ready

    For Frame = 0 To 1

        Call UpdatePartyCompanion()
        Call UpdateDragonOpponent()
        Call UpdateOrinStorm()
        Call UpdateDragon()
        Call AdvanceTestSceneVfx()
    End For

    Call CalibrationCheck(Fire.Value(1, Empty) = 7,
        "Both heroes' six equipment emitters coexist with Dragon mouth heat")

    For Index = 0 To Fire.MAX_EMITTERS - 8
        Blockers[Index] = Fire.StartAt("TorchFire", Position, 7321 + Index)

        Call CalibrationCheck(Blockers[Index].Slot <> 0, "Remaining shared slots admit fire")
    End For

    Session.Ready = Character3D.SetAnimationTime(Character, 1200) And Session.Ready

    Call UpdateDragon()
    Call CalibrationCheck(DragonState.Breath.Slot = 0 And Not DragonState.FireFailed,
        "Temporary full-pool breath rejection remains retryable")

    For Index = 0 To Fire.MAX_EMITTERS - 8
        Session.Ready = Fire.Destroy(Blockers[Index]) And Session.Ready
    End For

    For Frame = 0 To 9

        Call UpdatePartyCompanion()
        Call UpdateDragonOpponent()
        Call UpdateOrinStorm()
        Call UpdateDragon()
        Call AdvanceTestSceneVfx()
    End For

    Call CalibrationCheck(Fire.Value(1, Empty) = 8 And
        DragonState.Breath.Slot <> 0 And Fire.Value(6, DragonState.Breath) > 0,
        "Dragon breath recovers alongside every hero flame and mouth heat")

    Camera = Graphics3D.DefaultCamera()

    Call CalibrationCheck(Graphics3D.Begin3D(Camera, 0, 0, 0), "Begin breath submission")
    Call CalibrationCheck(Fire.Draw(DragonState.Breath), "Submit recovered breath particles")
    Call CalibrationCheck(Graphics3D.End3DChecked(), "Complete breath submission")

    Show Screen

End Sub

Sub CheckDragonFireContinuity()

    Dim ClipIndex As Number
    Dim PreviousGeneration As Number
    Dim PreviousAge As Number
    Dim PreviousCues As Number
    Dim OtherFire As Fire.FireEmitter
    Dim OtherPosition As Core.Vector3

    Playback.ScenePaused = True
    Playback.AnimationUpdateElapsed = 0
    Timing.CameraElapsed = 16
    Effects.FlamePaused = False
    OtherPosition.X = 300
    OtherFire = Fire.StartAt("TorchFire", OtherPosition, 7319,
        Fire.QUALITY_MEDIUM, Fire.SIMULATION_AUTO, 2)

    For ClipIndex = 0 To Character3D.ClipCount(Character) - 1

        If Character3D.ClipName(Character, ClipIndex) = "FireBreath" Then
            Call SelectClip(ClipIndex)
        End If

    End For

    Session.Ready = Character3D.SetAnimationTime(Character, 1200) And Session.Ready

    For ClipIndex = 0 To 9
        Call UpdateDragon()
        Call AdvanceTestSceneVfx()
    End For

    Call CalibrationCheck(DragonState.Breath.Slot <> 0 And Fire.Value(6, DragonState.Breath) > 0,
        "Dragon breath has live particles before freezing")

    PreviousGeneration = DragonState.Breath.Generation
    PreviousAge = Fire.Value(10, DragonState.Breath)
    Effects.FlamePaused = True
    ViewerCameraState.Live.Position.X = ViewerCameraState.Live.Position.X + 40.0

    Call UpdateDragon()
    Call AdvanceTestSceneVfx()
    Call CalibrationCheck(DragonState.Breath.Generation = PreviousGeneration And
        Fire.Value(10, DragonState.Breath) = PreviousAge, "Frozen dragon retains its permitted snapshot")
    Call ApplyTimelineCommand(
        ViewerTimelineEditing.COMMAND_STEP_FRAME, 1)
    Call UpdateDragon()
    Call CalibrationCheck(DragonState.Breath.Slot = 0 And Fire.Value(1, OtherFire) = 1,
        "Forward frozen Dragon seek clears breath and presence, not another owner")

    Effects.FlamePaused = False

    Call UpdateDragon()
    Call AdvanceTestSceneVfx()
    Call CalibrationCheck(DragonState.Breath.Slot <> 0 And
        DragonState.Breath.Generation <> PreviousGeneration And Fire.Value(10, DragonState.Breath) <= 16,
        "Dragon resumes at current pose without stale breath or catch-up")

    Effects.FlamePaused = True

    Call ViewerDragon.ToggleVisible(DragonState, Effects.DragonLight)
    Call UpdateDragon()
    Call CalibrationCheck(Fire.Value(1, OtherFire) = 1,
        "Hidden frozen Dragon releases every owned Fire emitter")
    Call ViewerDragon.ToggleVisible(DragonState, Effects.DragonLight)
    Call UpdateDragon()
    Call CalibrationCheck(Fire.Value(1, OtherFire) = 1,
        "Showing frozen Dragon does not resurrect old Fire")

    Effects.FlamePaused = False

    Call UpdateDragon()

    Effects.FlamePaused = True

    For ClipIndex = 0 To Character3D.ClipCount(Character) - 1

        If Character3D.ClipName(Character, ClipIndex) = "Idle" Then
            Call SelectClip(ClipIndex)
        End If

    End For

    Call UpdateDragon()
    Call CalibrationCheck(Fire.Value(1, OtherFire) = 1,
        "Frozen Dragon clip cut releases incompatible presence and breath")

    Effects.FlamePaused = False

    For ClipIndex = 0 To Character3D.ClipCount(Character) - 1

        If Character3D.ClipName(Character, ClipIndex) = "Fireball" Then
            Call SelectClip(ClipIndex)
        End If

    End For

    Session.Ready = Character3D.SetAnimationTime(Character, 2490) And Session.Ready

    Call UpdateDragon()
    Call AdvanceTestSceneVfx()

    PreviousCues = DragonPresence.ImpactCueCount()
    Effects.FlamePaused = True

    Call UpdateDragon()
    Call ApplyTimelineCommand(
        ViewerTimelineEditing.COMMAND_STEP_FRAME, 1)
    Call UpdateDragon()
    Call CalibrationCheck(Character3D.AnimationTime(Character) > 2500 And
        Fire.Value(1, OtherFire) = 1, "Forward frozen seek past impact clears the projectile")

    Effects.FlamePaused = False

    Call UpdateDragon()
    Call AdvanceTestSceneVfx()
    Call UpdateDragon()
    Call CalibrationCheck(DragonPresence.ImpactCueCount() = PreviousCues,
        "Resume after forward impact seek never replays the skipped impact cue")

    Effects.FlamePaused = True

    Call ApplyTimelineCommand(
        ViewerTimelineEditing.COMMAND_SEEK_FIRST_FRAME, 0)
    Call UpdateDragon()
    Call CalibrationCheck(Fire.Value(1, OtherFire) = 1,
        "Backward frozen seek also releases the Dragon impact burst")

    Effects.FlamePaused = False
    Session.Ready = Character3D.SetAnimationTime(Character, 2490) And Session.Ready

    Call UpdateDragon()

    Session.Ready = Character3D.SetAnimationTime(Character, 2533) And Session.Ready

    Call UpdateDragon()
    Call UpdateDragon()
    Call CalibrationCheck(DragonPresence.ImpactCueCount() = PreviousCues + 1,
        "Continuous playback still submits exactly one normal impact cue")
    Call ViewerDragon.ClearOwnedEffects(DragonState, Effects.DragonLight)

    Session.Ready = Fire.Destroy(OtherFire) And Session.Ready
    Effects.FlamePaused = False

End Sub

Sub CheckBeatSequence()

    Dim Saved As BeatSequence.Bookmark
    Dim Restored As BeatSequence.Bookmark
    Dim Schedule As BeatSequence.Timing
    Dim Subject As Character3D.Actor
    Dim Owner As Number
    Dim Beat As Number
    Dim SampleBeat As Number
    Dim Ok As Boolean

    Saved = BeatSequence.Remember(Party)

    Call BeatSequence.RememberPoses(Saved, Party, Character, DragonState.Actor)

    For Owner = 0 To 2

        Schedule = BeatSequence.Times(Party, Character, Playback.PlaybackSpeed, Owner, 0)

        For Beat = 0 To 3

            SampleBeat = 3 - Beat

            Ok = BeatSequence.Sample(Party, Character, ViewerCameraState.Frame,
                Playback.SelectedClip, DragonState, Playback.PlaybackSpeed,
                Owner, Schedule.Start[SampleBeat])

            If (Not Ok Or
                Party.Turn <> Owner Or
                Party.Elapsed <> Schedule.Start[SampleBeat]) Then
                Print "Beat sample diagnostic: "; Owner; " / "; SampleBeat; " / "; Ok; " / "; Party.Turn; " / "; Party.Elapsed; " / "; Schedule.Start[SampleBeat]
            End If

            Call CalibrationCheck(Ok And Party.Turn = Owner And Party.Elapsed = Schedule.Start[SampleBeat],
                "Four actual hero and Dragon beats seek backwards without advancing the turn")
        End For
    End For

    Party.DragonCounter = 0
    Party.FatalTarget = 0
    Ok = BeatSequence.Sample(Party, Character, ViewerCameraState.Frame,
        Playback.SelectedClip, DragonState, 100, 2, 4800, True)

    Call CalibrationCheck(Ok And Party.Turn = 2 And Party.Elapsed = 4800 And Party.DragonCounter = 0,
        "Restoring a fatal reaction tail does not advance the battle turn")
    Call BeatSequence.Restore(Party, Saved)

    Ok = BeatSequence.Sample(Party, Character, ViewerCameraState.Frame,
        Playback.SelectedClip, DragonState, Playback.PlaybackSpeed, Saved.Turn, Saved.Elapsed, True)

    Call BeatSequence.Restore(Party, Saved)

    Ok = BeatSequence.RestorePoses(Saved, Party, Character, DragonState, Playback.PlaybackSpeed) And Ok

    Call BeatSequence.RememberPoses(Restored, Party, Character, DragonState.Actor)

    For Owner = 0 To 2
        Call CalibrationCheck(Ok And Saved.Clips[Owner] = Restored.Clips[Owner] And
            Saved.Times[Owner] = Restored.Times[Owner] And Saved.Modes[Owner] = Restored.Modes[Owner],
            "Camera preview restores every actor clip, playback mode and time")
    End For

End Sub

Sub CheckPartyInspector()

    Dim Handled As Boolean
    Dim Owner As Number
    Dim PrimaryHandle As Number
    Dim CompanionHandle As Number
    Dim SavedClip As Number
    Dim OriginalJson As Text
    Dim SavedArinJson As Text

    PrimaryHandle = Character.Handle
    CompanionHandle = Party.Companion.Actor.Handle
    SavedArinJson = ViewerCalibration.SavedJson(Calibration, Character)
    Party.Elapsed = 1234
    Party.Stage = 1
    Party.HitTarget = 1
    Party.FatalTarget = 0

    For Owner = 0 To 2

        ''' Inspector selection is independent of the currently acting character.
        Party.Turn = 0
        BeatEditing.Selected = Owner

        Call BeginPartyInspector()

        OriginalJson = ""

        If Owner < 2 Then
            OriginalJson = ViewerCalibration.SavedJson(Calibration, Character)
        End If

        Call CalibrationCheck(Party.UiBound And Session.ProfileIndex = Calibration.OwnerProfile,
            "Party inspector binds the selected profile independently of the acting turn")
        Call CalibrationCheck(CalibrationAvailable = (Owner < 2),
            "Only the two calibrated heroes expose Pose")

        If Owner = 1 Then
            Call CalibrationCheck(Character.Handle = CompanionHandle And
                Calibration.KeyBase = CALIBRATION_MAX_CLIPS And
                Calibration.DataKey = ViewerProfiles.CalibrationKey(ViewerProfiles.PROFILE_ORIN),
                "Orin inspector owns Orin actor, key range and save identity")
        Else If Owner = 2 Then
            Call CalibrationCheck(Character.Handle = DragonState.Actor.Handle,
                "Dragon inspector uses the live boss, without pose storage")
        End If

        SavedClip = Playback.SelectedClip
        Session.Ready = Character3D.SetAnimationTime(Character, 333) And Session.Ready

        Call ApplyTimelineCommand(
            ViewerTimelineEditing.COMMAND_SEEK_FIRST_FRAME, 0)
        Call CalibrationCheck(Playback.ScenePaused And Party.PreviewActive And
            Character3D.AnimationTime(Character) = 0,
            "Party timeline pauses and seeks the active actor")
        Call EndPartyInspector()
        Call AdvancePartyDemo()
        Call CalibrationCheck(Character.Handle = PrimaryHandle And
            Party.Companion.Actor.Handle = CompanionHandle And Party.Elapsed = 1234 And
            Party.Stage = 1 And Party.HitTarget = 1 And Party.FatalTarget = 0,
            "Inspector restores scene ownership and paused demo state stays unchanged")
        Call BeginPartyInspector()

        If Owner < 2 Then

            ViewerUiState.CalibrationVisible = True

            Call ViewerGizmo.Toggle(ViewerGizmoState)
            Call CalibrationCheck(ViewerGizmoState.Visible, "Party hero explicitly enables the gizmo")

            Handled = HandleTransformGizmoKeyboard(KEY_R)

            Call CalibrationCheck(Handled, "Party hero gizmo keyboard command is handled")
            Call SetCurrentCalibrationValue(9)
            Call EndPartyInspector()
            Call HandleKeyboard(KEY_ENTER)
            Call BeginPartyInspector()
            Call CalibrationCheck(Not ViewerGizmoState.Dragging And ViewerUiState.CalibrationEditing And
                Party.Elapsed = 1234 And Playback.ScenePaused,
                "Party Enter confirms gizmo preview without restarting the battle")
            Call CancelCalibrationEdit()
            Call ViewerParty.BeginPreviewSession(
                Party, Character, Playback, Session.ProfileIndex)
            Call ViewerCalibrationEditing.BeginEdit(
                Calibration, Character, Playback.SelectedClip,
                ViewerUiState, ViewerCameraState, Effects)
            Call SetCurrentCalibrationValue(11)
            Call EndPartyInspector()
            Call HandleKeyboard(KEY_ENTER)
            Call BeginPartyInspector()
            Call CalibrationCheck(Not Calibration.WriteFailed And Not ViewerUiState.CalibrationEditing,
                "Party Enter saves the active hero pose without restarting the battle")
            Call ApplyCalibrationControlForTest(ViewerUi.CALIBRATION_ACTION_UNDO)
            Call CalibrationCheck(ViewerCalibration.SavedJson(Calibration, Character) = OriginalJson,
                "Party Undo restores every saved key of only the active hero")
            Call ViewerGizmo.Toggle(ViewerGizmoState)
            Call CalibrationCheck(Not ViewerGizmoState.Visible, "Party hero can hide the gizmo")

        End If

        Session.Ready = ViewerLifecycle.ToggleScenePause(
            Session, Party, Character, Playback, Session.ProfileIndex,
            ViewerUiState, ViewerInputState, Calibration,
            CalibrationAvailable, Effects) And Session.Ready

        Call CalibrationCheck(Not Playback.ScenePaused And Not Party.PreviewActive And
            Playback.SelectedClip = SavedClip And Character3D.AnimationTime(Character) = 333,
            "Resume restores the exact demo clip and time after scrubbing")
        Call EndPartyInspector()
    End For

    Party.Turn = 0
    BeatEditing.Selected = 0

    Call BeginPartyInspector()
    Call CalibrationCheck(ViewerCalibration.SavedJson(Calibration, Character) = SavedArinJson,
        "Companion and Dragon inspection never change Arin's saved keys")
    Call EndPartyInspector()

End Sub

Sub CheckEquipmentGlowAlignment()

    Dim Model As Core.Model3D
    Dim OriginalPosition As Precision3D.Vector3
    Dim BladePoint As Precision3D.Vector3
    Dim GlowPoint As Precision3D.Vector3
    Dim BasePoint As Precision3D.Vector3
    Dim TipPoint As Precision3D.Vector3
    Dim Center As Precision3D.Vector3
    Dim BaseGlow As Precision3D.Vector3
    Dim TipGlow As Precision3D.Vector3
    Dim SurfaceSpan As Double
    Dim OutlineSpan As Double
    Dim Socket As Number
    Dim Pose As Number
    Dim SocketName As Text
    Dim ClipName As Text
    Dim Ready As Boolean

    Ready = Character3D.TryPosition(Character, OriginalPosition)
    Model.Handle = Character3D.ModelHandle(Character)

    For Pose = 0 To 2

        If Pose = 0 Then
            ClipName = "Idle"
        Else If Pose = 1 Then
            ClipName = "SwordAttack"
        Else
            ClipName = "Defend"
        End If

        Call SelectClip(Graphics3D.ModelClipIndex3D(Model, ClipName))

        Ready = Character3D.SetAnimationTime(Character, 166 + Pose * 133) And Ready
        Ready = Character3D.PlacePrecise(Character, OriginalPosition.X + 0.375,
            OriginalPosition.Y + 0.125, OriginalPosition.Z + 0.625) And Ready

        Call UpdateCalibrationForCurrentFrame()
        Call ApplyWristCalibration()
        Call ApplyEquipmentCoupling()

        Ready = ViewerEffects.UpdateEpicGlow(Effects, Character, Session.ProfileIndex,
            ViewerCameraState.Frame.ScalePercent, 0, ClipName, True, True,
            ViewerCalibration.ChannelValue(Calibration, Playback.SelectedClip, 18) <> 0,
            ViewerCalibration.ChannelValue(Calibration, Playback.SelectedClip, 19) <> 0) And Ready

        ''' Exercise both shared styles on each real model, independent of its selected profile style.
        Ready = ViewerEffects.ConfigureEquipmentGlow(Effects.SwordGlow,
            Effects.ShieldGlow, ViewerProfiles.EQUIPMENT_GLOW_FIRE) And Ready
        Ready = ViewerEffects.UpdateEquipmentGlow(Character, Effects.SwordGlow,
            OriginalPosition, ViewerCameraState.Frame.ScalePercent) And Ready

        Call ApplyEquipmentCalibration()

        For Socket = 0 To 2

            If Socket = 0 Then
                SocketName = "HandRight"
            Else If Socket = 1 Then
                SocketName = "SwordBase"
            Else
                SocketName = "SwordTip"
            End If

            Ready = Character3D.TrySocketPositionPrecise(Character, SocketName, 1,
                False, BladePoint) And Ready
            Ready = Precision3D.TrySocketPosition(Effects.SwordGlow,
                Graphics3D.ModelSocketIndex3D(Model, SocketName),
                False, GlowPoint) And Ready

            Call CalibrationCheck(Ready And Abs(BladePoint.X - GlowPoint.X) < 0.001 And
                Abs(BladePoint.Y - GlowPoint.Y) < 0.001 And
                Abs(BladePoint.Z - GlowPoint.Z) < 0.001,
                "Surface coating matches calibrated equipment at fractional placement")

            If Socket = 1 Then
                BasePoint = BladePoint
            Else If Socket = 2 Then
                TipPoint = BladePoint
            End If

        End For

        Center.X = (BasePoint.X + TipPoint.X) / 2.0
        Center.Y = (BasePoint.Y + TipPoint.Y) / 2.0
        Center.Z = (BasePoint.Z + TipPoint.Z) / 2.0
        Ready = ViewerEffects.ConfigureEquipmentGlow(Effects.SwordGlow,
            Effects.ShieldGlow, ViewerProfiles.EQUIPMENT_GLOW_LIGHTNING) And Ready
        Ready = ViewerEffects.UpdateEquipmentGlow(Character, Effects.SwordGlow,
            Center, ViewerCameraState.Frame.ScalePercent, True) And Ready

        Call ApplyEquipmentCalibration()

        Ready = Precision3D.TrySocketPosition(Effects.SwordGlow,
            Graphics3D.ModelSocketIndex3D(Model, "SwordBase"), False, BaseGlow) And Ready
        Ready = Precision3D.TrySocketPosition(Effects.SwordGlow,
            Graphics3D.ModelSocketIndex3D(Model, "SwordTip"), False, TipGlow) And Ready
        SurfaceSpan = (TipPoint.X - BasePoint.X) * (TipPoint.X - BasePoint.X)
        SurfaceSpan = SurfaceSpan + (TipPoint.Y - BasePoint.Y) * (TipPoint.Y - BasePoint.Y)
        SurfaceSpan = SurfaceSpan + (TipPoint.Z - BasePoint.Z) * (TipPoint.Z - BasePoint.Z)
        OutlineSpan = (TipGlow.X - BaseGlow.X) * (TipGlow.X - BaseGlow.X)
        OutlineSpan = OutlineSpan + (TipGlow.Y - BaseGlow.Y) * (TipGlow.Y - BaseGlow.Y)
        OutlineSpan = OutlineSpan + (TipGlow.Z - BaseGlow.Z) * (TipGlow.Z - BaseGlow.Z)

        Call CalibrationCheck(Ready And OutlineSpan > SurfaceSpan And
            OutlineSpan < SurfaceSpan * 1.1,
            "Lightning outline expands the same calibrated equipment on either character")
    End For

    Ready = Character3D.PlacePrecise(Character, OriginalPosition.X,
        OriginalPosition.Y, OriginalPosition.Z) And Ready
    Ready = ViewerEffects.ConfigureEquipmentGlow(Effects.SwordGlow, Effects.ShieldGlow,
        ViewerProfiles.EquipmentGlowStyle(Session.ProfileIndex)) And Ready

    Call SelectClip(0)
    Call CalibrationCheck(Ready, "Glow alignment fixture restores actor placement")

End Sub

Sub CheckFractionalPartySubmission()

    Dim Trial As ViewerParty.State
    Dim Partitioned As ViewerParty.State
    Dim Actions As ViewerParty.FrameActions
    Dim OtherActions As ViewerParty.FrameActions
    Dim FirstFrame As PrecisionCamera.Framing
    Dim FirstActor As Character3D.Actor
    Dim FirstClip As Number
    Dim FirstPosition As Precision3D.Vector3
    Dim SecondPosition As Precision3D.Vector3
    Dim FirstRotation As Precision3D.Vector3
    Dim SecondRotation As Precision3D.Vector3
    Dim Captured As Precision3D.Vector3
    Dim Part As Core.Object3D
    Dim Camera As Precision3D.Camera3D
    Dim Expected As Double
    Dim Ready As Boolean

    Trial = Party
    Trial.Enabled = True
    Trial.Ready = True
    Trial.Turn = 0
    Trial.Stage = 0
    Trial.Elapsed = 650
    Trial.First.Home = Math3D.Vector(0, 0, 0)
    Trial.First.Approach = Math3D.Vector(1, 0, 1)
    Partitioned = Trial
    Actions = ViewerParty.AdvanceChoreography(Trial, 163, True, False, 1200, 100, -1)
    OtherActions = ViewerParty.AdvanceChoreography(Partitioned, 100, True, False, 1200, 100, -1)
    OtherActions = ViewerParty.AdvanceChoreography(Partitioned, 63, True, False, 1200, 100, -1)
    Expected = 163.0 / 650.0

    Call CalibrationCheck(ViewerParty.HERO_APPROACH_DELAY_MILLISECONDS = 250 And
        ViewerParty.HERO_APPROACH_DURATION_MILLISECONDS = 300 And
        ViewerParty.HERO_ATTACK_START_MILLISECONDS = 550,
        "Party uses the accelerated pre-attack approach")
    Call CalibrationCheck(Abs(Actions.FirstPosition.X - Expected) < 1e-12 And
        Actions.FirstPosition.X = OtherActions.FirstPosition.X And
        Trial.Stage = Partitioned.Stage And Trial.Elapsed = Partitioned.Elapsed,
        "Party approach retains fractions and equal elapsed partitions")

    FirstActor = Party.DragonOpponent.Actor
    FirstFrame = Party.DragonOpponent.Frame
    FirstClip = Party.DragonOpponent.Clip
    Ready = Character3D.TryPosition(FirstActor, FirstPosition)
    Ready = Character3D.TryPosition(Trial.Companion.Actor, SecondPosition) And Ready
    Ready = Character3D.TryRotation(FirstActor, FirstRotation) And Ready
    Ready = Character3D.TryRotation(Trial.Companion.Actor, SecondRotation) And Ready

    Call CalibrationCheck(Ready, "Fractional Party proof uses both live actor owners")
    Call CalibrationCheck(ViewerParty.ApplyFrame(Trial, Actions, FirstActor, FirstFrame,
        FirstClip, 100, -208, 70, -120, 180), "Party applies fractional approach")

    Camera = Precision3D.FromCamera(Graphics3D.DefaultCamera())
    Part.Handle = Character3D.PartObjectHandle(FirstActor, 0)

    Call CalibrationCheck(Scene3D.BeginPrecise(Camera, 8, 12, 20), "Begin fractional Party capture")
    Call CalibrationCheck(Character3D.Draw(FirstActor), "Submit the actual Party actor")
    Call CalibrationCheck(Precision3D.TrySubmittedPosition(Part, 0, Captured) And
        Abs(Captured.X - Expected) < 0.000001,
        "Party fraction survives actual renderer capture")
    Call CalibrationCheck(Scene3D.EndScene(), "End fractional Party capture")

    Show Screen

    Trial.Elapsed = 1200 + 1300
    Trial.Stage = 2
    Actions = ViewerParty.AdvanceChoreography(Trial, 163, True, False, 1200, 100, -1)
    Expected = 1.0 - 163.0 / 700.0

    Call CalibrationCheck(Abs(Actions.FirstPosition.X - Expected) < 1e-12,
        "Party return retains its fractional interpolation")
    Call CalibrationCheck(ViewerParty.ApplyFrame(Trial, Actions, FirstActor, FirstFrame,
        FirstClip, 100, -208, 70, -120, 180), "Party applies fractional return")
    Call CalibrationCheck(Scene3D.BeginPrecise(Camera, 8, 12, 20), "Begin Party return capture")
    Call CalibrationCheck(Character3D.Draw(FirstActor), "Submit Party return")
    Call CalibrationCheck(Precision3D.TrySubmittedPosition(Part, 0, Captured) And
        Abs(Captured.X - Expected) < 0.000001,
        "Return fraction survives actual renderer capture")
    Call CalibrationCheck(Scene3D.EndScene(), "End Party return capture")

    Show Screen

    Ready = Character3D.PlacePrecise(FirstActor, FirstPosition.X, FirstPosition.Y, FirstPosition.Z)
    Ready = Character3D.PlacePrecise(Trial.Companion.Actor,
        SecondPosition.X, SecondPosition.Y, SecondPosition.Z) And Ready
    Ready = Character3D.RotatePrecise(FirstActor, FirstRotation.X, FirstRotation.Y, FirstRotation.Z) And Ready
    Ready = Character3D.RotatePrecise(Trial.Companion.Actor,
        SecondRotation.X, SecondRotation.Y, SecondRotation.Z) And Ready

    Call CalibrationCheck(Ready, "Restore both actor transforms without touching calibration")

End Sub

Sub CheckGizmoVisibility()

    Dim SavedJson As Text
    Dim OriginalValue As Number
    Dim PreviewValue As Number
    Dim Handled As Boolean

    SavedJson = ViewerCalibration.SavedJson(Calibration, Character)
    OriginalValue = ViewerCalibrationEditing.CurrentValue(
        Calibration, Playback.SelectedClip, ViewerUiState)
    PreviewValue = 0
    ViewerUiState.CalibrationVisible = True

    If OriginalValue = 0 Then
        PreviewValue = 1
    End If

    Call CalibrationCheck(Not ViewerGizmoState.Visible, "Gizmo defaults hidden")

    Handled = HandleTransformGizmoKeyboard(KEY_R)

    Call CalibrationCheck(Handled And Not ViewerGizmoState.Dragging And Not ViewerUiState.CalibrationEditing,
        "Hidden gizmo cannot start an invisible keyboard drag")
    Call CalibrationCheck(Not HandleTransformGizmoPointer(), "Hidden gizmo does not capture the scene")
    Call SetCurrentCalibrationValue(PreviewValue)
    Call CalibrationCheck(ViewerUiState.CalibrationEditing And
        ViewerCalibrationEditing.CurrentValue(
            Calibration, Playback.SelectedClip, ViewerUiState) = PreviewValue,
        "Numeric pose editing works with the gizmo hidden")
    Call ViewerGizmo.Toggle(ViewerGizmoState)

    Handled = HandleTransformGizmoKeyboard(KEY_R)

    Call CalibrationCheck(ViewerGizmoState.Visible And ViewerGizmoState.Dragging,
        "Explicit Show Gizmo enables handles and keyboard drag")
    Call ViewerGizmo.Toggle(ViewerGizmoState)
    Call CalibrationCheck(Not ViewerGizmoState.Visible And Not ViewerGizmoState.Dragging And
        ViewerUiState.CalibrationEditing And
        ViewerCalibrationEditing.CurrentValue(
            Calibration, Playback.SelectedClip, ViewerUiState) = PreviewValue,
        "Hide ends capture but preserves the unsaved numeric preview")
    Call CalibrationCheck(ViewerCalibration.SavedJson(Calibration, Character) = SavedJson, "Visibility toggle never saves keys")
    Call CancelCalibrationEdit()
    Call CalibrationCheck(ViewerCalibrationEditing.CurrentValue(
        Calibration, Playback.SelectedClip, ViewerUiState) = OriginalValue And
        ViewerCalibration.SavedJson(Calibration, Character) = SavedJson, "Cancel preserves the original saved pose")
    Call ViewerGizmo.Toggle(ViewerGizmoState)
    Call ResetAll()
    Call CalibrationCheck(Not ViewerGizmoState.Visible, "Full reset restores hidden gizmo default")

End Sub

Sub CheckPackagedCalibration()

    Dim OriginalKey As Text
    Dim JsonSnapshot As Text

    JsonSnapshot = ViewerCalibration.SavedJson(Calibration, Character)

    Call CalibrationCheck(Text_Length(JsonSnapshot) > 0, "Saved JSON export is available")

    TestSavedCount = Calibration.StorageCount
    OriginalKey = Calibration.DataKey

    For TestIndex = 0 To TestSavedCount - 1
        TestImportFixtureBytes[TestIndex] = ViewerCalibration.StorageByte(TestIndex)
    End For

    Calibration.DataKey = "ViewerCalibrationTests.MissingPackagedSeed"

    Call ViewerCalibration.ResetBank(Calibration)
    Call ViewerCalibration.Reload(Calibration, Character)
    Call CalibrationCheck(Not Calibration.StorageRejected And
        Calibration.StorageCount = TestSavedCount, "Fresh storage loads packaged calibration")

    For TestIndex = 0 To TestSavedCount - 1
        Call CalibrationCheck(ViewerCalibration.StorageByte(TestIndex) =
            TestImportFixtureBytes[TestIndex],
            "Packaged calibration preserves every canonical byte")
    End For

    Calibration.DataKey = OriginalKey
    Calibration.UndoCount = 0

    Call CheckCalibrationImport(JsonSnapshot)

    Print "CALIBRATION_JSON: " + ViewerCalibration.SavedJson(Calibration, Character)

End Sub

Function ReadImportFixture(Name As Text) As Text

    Dim Loaded As Number
    Dim Index As Number
    Dim Result As Text

    Load Text File "ImportFixtures/" + Name Into TestImportFixtureBytes Count Loaded

    For Index = 0 To Loaded - 1

        If TestImportFixtureBytes[Index] >= 32 Then
            Result = Result + ViewerCalibration.AsciiCharacter(TestImportFixtureBytes[Index])
        End If

    End For

    Return Result

End Function

Sub CheckCalibrationImport(Original As Text)

    Dim Index As Number
    Dim Candidate As Text
    Dim EmptySnapshot As Text
    Dim SavedKey As Text
    Dim SavedUndoCount As Number
    Dim Accepted As Boolean

    Call CalibrationCheck(ViewerCalibration.PrepareImport(
        Calibration, Character, Original, ViewerUiState.CalibrationEditing),
        "Accept shared saved JSON")
    Call CalibrationCheck(ViewerCalibration.CandidateByteCount() = Calibration.StorageCount,
        "Shared import reproduces the complete saved payload")

    For Index = 0 To Calibration.StorageCount - 1
        Call CalibrationCheck(ViewerCalibration.CandidateByteAt(Index) =
            ViewerCalibration.StorageByte(Index),
            "Shared JSON import preserves every saved payload byte")
    End For

    ''' The existing writer canonicalizes records into runtime clip order.

    Call CalibrationCheck(ViewerCalibration.CommitImport(
        Calibration, Character, Playback.SelectedClip,
        ViewerUiState.CalibrationEditing),
        "Import current snapshot through native transaction")

    Original = ViewerCalibration.SavedJson(Calibration, Character)

    If Session.ProfileIndex = ViewerProfiles.PROFILE_ARIN Then

        Candidate = ReadImportFixture("canonical.json")

        Call CalibrationCheck(ViewerCalibration.PrepareImport(
            Calibration, Character, Candidate, ViewerUiState.CalibrationEditing),
            "Accept canonical desktop JSON")

        Candidate = ReadImportFixture("reordered.json")

        Call CalibrationCheck(ViewerCalibration.PrepareImport(
            Calibration, Character, Candidate, ViewerUiState.CalibrationEditing),
            "Names override reordered clip/index hints")

        For Index = 0 To TEST_IMPORT_REJECTION_COUNT - 1

            Candidate = ReadImportFixture(
                "reject-" + ViewerCalibration.NumberText(Index) + ".json")

            Call CalibrationCheck(Not ViewerCalibration.PrepareImport(
                Calibration, Character, Candidate,
                ViewerUiState.CalibrationEditing),
                "Reject malformed snapshot " + ViewerCalibration.NumberText(Index))
            Call CalibrationCheck(ViewerCalibration.SavedJson(Calibration, Character) = Original,
                "Rejected JSON leaves saved bytes unchanged")
        End For

        Candidate = ReadImportFixture("orin.json")

        Call CalibrationCheck(Not ViewerCalibration.PrepareImport(
            Calibration, Character, Candidate, ViewerUiState.CalibrationEditing),
            "Reject Orin JSON on Arin")

        Candidate = " "

        For Index = 0 To 22
            Candidate = Candidate + Candidate
        End For

        Candidate = Candidate + " "

        Call CalibrationCheck(Not ViewerCalibration.PrepareImport(
            Calibration, Character, Candidate, ViewerUiState.CalibrationEditing),
            "Reject oversized JSON before parsing")

        Candidate = ""

    Else

        Candidate = ReadImportFixture("orin.json")

        Call CalibrationCheck(ViewerCalibration.PrepareImport(
            Calibration, Character, Candidate, ViewerUiState.CalibrationEditing),
            "Accept canonical Orin zero-key JSON")

        Candidate = ReadImportFixture("canonical.json")

        Call CalibrationCheck(Not ViewerCalibration.PrepareImport(
            Calibration, Character, Candidate, ViewerUiState.CalibrationEditing),
            "Reject Arin JSON on Orin")

    End If

    EmptySnapshot = (Text_Slice(Calibration.JsonMetadata, 0, Text_Length(Calibration.JsonMetadata) - 1) +
        ",""savedKeyframe"":null,""totalKeyframes"":0,""clips"":[]}")

    Call CalibrationCheck(ViewerCalibration.PrepareImport(
        Calibration, Character, EmptySnapshot, ViewerUiState.CalibrationEditing),
        "Validate deliberate empty replacement")
    Call CalibrationCheck(ViewerCalibration.SavedJson(Calibration, Character) = Original, "Validation alone does not replace keys")

    SavedKey = Calibration.DataKey
    SavedUndoCount = Calibration.UndoCount
    Calibration.DataKey = "Viewer Denied Storage Probe"
    Accepted = ViewerCalibration.CommitImport(
        Calibration, Character, Playback.SelectedClip,
        ViewerUiState.CalibrationEditing)

    Call CalibrationCheck(Not Accepted And Calibration.WriteFailed, "Import reports failed persistent write")
    Call CalibrationCheck(ViewerCalibration.SavedJson(Calibration, Character) = Original And Calibration.UndoCount = SavedUndoCount,
        "Failed import preserves saved track and undo")

    Calibration.DataKey = SavedKey

    Call CalibrationCheck(ViewerCalibration.PrepareImport(
        Calibration, Character, EmptySnapshot, ViewerUiState.CalibrationEditing),
        "Prepare before concurrent saved edit")

    Calibration.ImportBaseline = "Changed Since Validation"

    Call CalibrationCheck(Not ViewerCalibration.CommitImport(
        Calibration, Character, Playback.SelectedClip,
        ViewerUiState.CalibrationEditing),
        "Refuse replacement after baseline changes")
    Call CalibrationCheck(ViewerCalibration.SavedJson(Calibration, Character) = Original, "Changed baseline leaves current keys intact")
    Call CalibrationCheck(ViewerCalibration.PrepareImport(
        Calibration, Character, EmptySnapshot, ViewerUiState.CalibrationEditing),
        "Prepare replacement again after denial")
    Call CalibrationCheck(ViewerCalibration.CommitImport(
        Calibration, Character, Playback.SelectedClip,
        ViewerUiState.CalibrationEditing),
        "Confirmed import replaces saved track")
    Call ApplyCalibrationControlForTest(ViewerUi.CALIBRATION_ACTION_UNDO)
    Call CalibrationCheck(ViewerCalibration.SavedJson(Calibration, Character) = Original, "Undo import restores complete snapshot")

    Calibration.UndoCount = 0

End Sub

Sub UpdateTestEquipmentFire()

    Call ViewerEffects.UpdateEquipmentFire(
        Effects,
        Character,
        Session.ProfileIndex,
        Party.Enabled And
            ViewerParty.PresentationState(Party, 0) = ViewerParty.STATE_KO,
        Equipment.SwordVisible,
        Equipment.ShieldVisible,
        ViewerUiState.CalibrationEditing,
        Playback.ScenePaused,
        Playback.SelectedClip,
        ViewerPlayback.SelectedClipLabel(
            Character, Playback, Session.ProfileIndex),
        ViewerCameraState.Live,
        Timing.CameraElapsed
    )

End Sub

Sub CheckImportedProfileTabs()

    Dim Index As Number
    Dim MismatchedProfile As CharacterViewer.Profile

    If Not ViewerProfiles.INCLUDE_UNITY_CHARACTERS Then
        Return
    End If

    For Index = 4 To 6

        Call SelectCharacterTab(Index)
        Call CalibrationCheck(Session.Ready And Not Session.ViewerError,
            ActiveProfile.DisplayName + " standalone tab loads its canonical asset")
        Call CalibrationCheck(Character3D.HasSocket(Character, "Head"),
            ActiveProfile.DisplayName + " retains its animated Head attachment")

        MismatchedProfile = ActiveProfile
        MismatchedProfile.ExpectedSocketCount = ActiveProfile.ExpectedSocketCount - 1

        Call CalibrationCheck(Not ViewerActors.ValidateProfile(
            Character, Session.ProfileIndex, MismatchedProfile),
            "Standalone validation still rejects mismatched socket inventories")
    End For

    Call SelectCharacterTab(0)
    Call CalibrationCheck(Session.Ready And Not Session.ViewerError,
        "Arin reloads after the imported character tabs")

End Sub

Sub CheckVraxAttackEffects()

    Dim Trial As ViewerDragon.AttackEffects
    Dim Independent As ViewerDragon.AttackEffects
    Dim HeldFire[12] As Fire.FireEmitter
    Dim HeldArcs[8] As Lightning.LightningEffect
    Dim Mouth As Precision3D.Vector3
    Dim LeftArm As Precision3D.Vector3
    Dim RightArm As Precision3D.Vector3
    Dim Target As Precision3D.Vector3
    Dim Original As Lightning.LightningEffect
    Dim BaselineFire As Number
    Dim FireCount As Number
    Dim ArcCount As Number
    Dim Index As Number
    Dim Ok As Boolean

    Ok = ViewerEffects.PrepareLightning(Effects)
    Mouth = Precision3D.Vector(0.25, 100.5, 0.75)
    LeftArm = Precision3D.Vector(-60.25, 70.5, 5.75)
    RightArm = Precision3D.Vector(60.25, 70.5, 5.75)
    Target = Precision3D.Vector(0.25, 25.5, 300.75)
    BaselineFire = Fire.Value(1, Trial.MouthFire)

    Call CalibrationCheck(Ok, "Vrax uses initialized shared lightning")
    Call CalibrationCheck(ViewerDragon.DRAGON_BREATH_RADIUS = 16 And
        ViewerDragon.DRAGON_BREATH_INTENSITY = 300 And
        ViewerDragon.VRAX_BREATH_RADIUS = 24 And
        ViewerDragon.VRAX_BREATH_INTENSITY = 320,
        "Dragon and Vrax use expanded high-intensity breath presets")
    Call CalibrationCheck(Not ViewerDragon.VraxAttackActive("Idle", 400, 1000) And
        Not ViewerDragon.VraxAttackActive("Attack", 100, 1000) And
        Not ViewerDragon.VraxAttackActive("Attack", 800, 1000),
        "Vrax suppresses idle, windup and recovery effects")

    For Index = 0 To 5
        Call CalibrationCheck(ViewerDragon.VraxAttackActive(
            ViewerProfiles.PartyAttackName(ViewerProfiles.PROFILE_VRAX, Index), 400, 1000),
            "Vrax cycles six active attack clips")
    End For

    Call ViewerDragon.UpdateVraxAttackPoints(Independent, "Attack", 400, 1000,
        Mouth, LeftArm, RightArm, Target, True, True, True, False, False, 1)

    Original = Independent.LeftArc

    Call CalibrationCheck(Independent.MouthFire.Slot <> 0 And
        Independent.LeftArc.Slot <> 0 And Independent.RightArc.Slot <> 0,
        "Vrax acquires one mouth emitter and both arm bolts")

    ''' Leave one lightning slot: a partial pair must be rolled back immediately.
    ArcCount = 7 - Lightning.Value(Lightning.QUERY_LIVE_EFFECTS, Original)

    For Index = 0 To ArcCount - 1
        HeldArcs[Index] = Lightning.StartAtPrecise("StoredStorm", Mouth, Target, 7000 + Index)
    End For

    FireCount = 12 - Fire.Value(1, Independent.MouthFire)

    For Index = 0 To FireCount - 1
        HeldFire[Index] = Fire.StartAtPrecise("LineFire", Mouth, 8000 + Index,
            Fire.QUALITY_LOW, Fire.SIMULATION_CPU, 3)
    End For

    Call ViewerDragon.UpdateVraxAttackPoints(Trial, "Attack", 400, 1000,
        Mouth, LeftArm, RightArm, Target, True, True, True, False, False, 1)
    Call CalibrationCheck(Trial.MouthFire.Slot = 0 And Trial.LeftArc.Slot = 0 And
        Trial.RightArc.Slot = 0 And Lightning.Value(Lightning.QUERY_LIVE_EFFECTS, Original) = 7,
        "Vrax pressure leaves no partial arm pair or failed fire lease")

    Ok = Fire.Destroy(HeldFire[FireCount - 1])
    Ok = Lightning.Destroy(HeldArcs[ArcCount - 1]) And Ok

    Call ViewerDragon.UpdateVraxAttackPoints(Trial, "Attack", 420, 1000,
        Mouth, LeftArm, RightArm, Target, True, True, True, False, False, 1)
    Call CalibrationCheck(Ok And Trial.MouthFire.Slot <> 0 And Trial.LeftArc.Slot <> 0 And
        Trial.RightArc.Slot <> 0 And Lightning.IsActive(Original),
        "Vrax retries in place while the independent caller survives")

    Original = Trial.LeftArc
    Target.X = 80.25

    Call ViewerDragon.UpdateVraxAttackPoints(Trial, "Attack", 450, 1000,
        Mouth, LeftArm, RightArm, Target, True, True, True, True, True, 1)
    Call CalibrationCheck(Trial.LeftArc.Generation = Original.Generation And
        Lightning.Value(Lightning.QUERY_MAIN_TARGET_X, Trial.LeftArc) = 0,
        "Vrax family freeze retains the current attachment snapshot")
    Call ViewerDragon.UpdateVraxAttackPoints(Trial, "Attack", 460, 1000,
        Mouth, LeftArm, RightArm, Target, True, True, True, False, False, 1)
    Call CalibrationCheck(Not Lightning.IsActive(Original) And
        Lightning.Value(Lightning.QUERY_MAIN_TARGET_X, Trial.LeftArc) = 80,
        "Vrax resume rebases moving attachments")

    Call ViewerDragon.UpdateVraxAttackPoints(Trial, "Death", 400, 1000,
        Mouth, LeftArm, RightArm, Target, True, True, True, False, False, 1)
    Call CalibrationCheck(Trial.MouthFire.Slot = 0 And Trial.LeftArc.Slot = 0 And
        Trial.RightArc.Slot = 0, "Vrax death clears every owned effect")
    Call ViewerDragon.UpdateVraxAttackPoints(Trial, "Attack2", 400, 1000,
        Mouth, LeftArm, RightArm, Target, True, True, True, False, False, 1)
    Call ViewerDragon.UpdateVraxAttackPoints(Trial, "Attack2", 400, 1000,
        Mouth, LeftArm, RightArm, Target, False, True, True, True, True, 2)
    Call CalibrationCheck(Trial.MouthFire.Slot = 0 And Trial.LeftArc.Slot = 0 And
        Trial.RightArc.Slot = 0 And Independent.LeftArc.Slot <> 0,
        "Vrax hide and discontinuity outrank freeze without clearing another caller")

    Call ViewerDragon.ClearVraxAttacks(Trial)
    Call ViewerDragon.ClearVraxAttacks(Independent)

    For Index = 0 To FireCount - 1
        Ok = Fire.Destroy(HeldFire[Index])
    End For

    For Index = 0 To ArcCount - 1
        Ok = Lightning.Destroy(HeldArcs[Index])
    End For

    Call CalibrationCheck(Fire.Value(1, Trial.MouthFire) = BaselineFire And
        Lightning.Value(Lightning.QUERY_LIVE_EFFECTS, Trial.LeftArc) = 0,
        "Vrax release restores shared budgets")

End Sub

Sub AdvanceTestSceneVfx()

    Session.Ready = ViewerEffects.AdvanceScene(
        Effects,
        Timing.CameraElapsed,
        Playback.ScenePaused,
        ViewerCameraState.Live
    ) And Session.Ready

End Sub

Sub CheckZaraAttackEffects()

    Dim Trial As ViewerEffects.ZaraAttackEffects
    Dim Independent As ViewerEffects.ZaraAttackEffects
    Dim Base As Precision3D.Vector3
    Dim Tip As Precision3D.Vector3
    Dim Target As Precision3D.Vector3
    Dim Original As Lightning.LightningEffect
    Dim EmptyFire As Fire.FireEmitter
    Dim BaselineFire As Number
    Dim Index As Number

    Base = Precision3D.Vector(10.25, 60.5, 0.75)
    Tip = Precision3D.Vector(110.25, 90.5, 0.75)
    Target = Precision3D.Vector(0.0, 0.0, 0.0)
    BaselineFire = Fire.Value(1, EmptyFire)

    Call CalibrationCheck(ViewerEffects.ZaraAttackActive("SwordAttack", 300, 1000) And
        ViewerEffects.ZaraAttackActive("attack6", 700, 1000) And
        Not ViewerEffects.ZaraAttackActive("BlockImpact", 700, 1000) And
        Not ViewerEffects.ZaraAttackActive("SwordAttack", 1000, 1000),
        "Zara effects follow attack clips and exclude guard/completion")
    Call ViewerEffects.UpdateZaraAttackPoints(Independent, "SwordAttack2", 100, 1000,
        Base, Tip, Target, True, True, False, 1)
    Call ViewerEffects.UpdateZaraAttackPoints(Trial, "SwordAttack", 249, 1000,
        Base, Tip, Target, True, True, False, 1)
    Call CalibrationCheck(Trial.BladeArc.Slot <> 0 And Trial.Storm[0].Slot = 0 And
        Lightning.Value(Lightning.QUERY_PALETTE, Trial.BladeArc) = Lightning.PALETTE_RED_WHITE,
        "Zara charges with red-white weapon lightning before impact")

    Original = Trial.BladeArc
    Tip.X = 120.75

    Call ViewerEffects.UpdateZaraAttackPoints(Trial, "SwordAttack", 250, 1000,
        Base, Tip, Target, True, True, True, 1)
    Call CalibrationCheck(Lightning.Value(Lightning.QUERY_MAIN_TARGET_X,
        Trial.BladeArc) = 110 And Trial.Storm[0].Slot = 0,
        "Zara freeze preserves the current charge without starting a storm")
    Call ViewerEffects.UpdateZaraAttackPoints(Trial, "SwordAttack", 251, 1000,
        Base, Tip, Target, True, True, False, 1)
    Call CalibrationCheck(Not Lightning.IsActive(Original) And
        Lightning.IsActive(Independent.BladeArc), "Zara resume preserves independent owners")

    For Index = 0 To 3

        Call CalibrationCheck(Lightning.IsActive(Trial.Storm[Index]) And
            Lightning.Value(Lightning.QUERY_PRESET, Trial.Storm[Index]) = 8 And
            Lightning.Value(Lightning.QUERY_QUALITY, Trial.Storm[Index]) = Lightning.QUALITY_ULTRA And
            Lightning.Value(Lightning.QUERY_PALETTE, Trial.Storm[Index]) = Lightning.PALETTE_RED_WHITE,
            "Zara admits four red-white Ultra StormCrown strikes")
    End For

    Call CalibrationCheck(Lightning.Value(Lightning.QUERY_FIRST_Y, Trial.Storm[0]) = 540 And
        Lightning.Value(Lightning.QUERY_MAIN_TARGET_Y, Trial.Storm[0]) = 12,
        "SwordAttack uses Lightning Lab Godstorm Ultra sky-ring layout")

    Original = Trial.Storm[0]

    Call ViewerEffects.UpdateZaraAttackPoints(Trial, "SwordAttack2", 700, 1000,
        Base, Tip, Target, True, True, False, 1)
    Call CalibrationCheck(Not Lightning.IsActive(Original) And
        Lightning.Value(Lightning.QUERY_PRESET, Trial.Storm[0]) = 2 And
        Lightning.Value(Lightning.QUERY_FIRST_Y, Trial.Storm[0]) = 540 And
        Lightning.Value(Lightning.QUERY_MAIN_TARGET_Y, Trial.Storm[0]) = 12,
        "SwordAttack2 uses Lightning Lab Forked Judgment SkyStrike layout")
    Call ViewerEffects.UpdateZaraAttackPoints(Trial, "SwordAttack2", 100, 1000,
        Base, Tip, Target, True, True, True, 1)
    Call CalibrationCheck(Trial.BladeArc.Slot = 0 And Trial.Storm[0].Slot = 0,
        "Zara backward seek clears stale storms even while frozen")
    Call ViewerEffects.UpdateZaraAttackPoints(Trial, "SwordAttack2", 700, 1000,
        Base, Tip, Target, True, True, False, 1)
    Call ViewerEffects.UpdateZaraAttackPoints(Trial, "SwordAttack2", 700, 1000,
        Base, Tip, Target, False, True, True, 2)
    Call CalibrationCheck(Trial.BladeArc.Slot = 0 And Trial.Storm[0].Slot = 0 And
        Lightning.IsActive(Independent.BladeArc), "Zara hide clears only her owned lightning")
    Call ViewerEffects.ClearZaraAttacks(Independent)
    Call CalibrationCheck(Fire.Value(1, EmptyFire) = BaselineFire And
        Lightning.Value(Lightning.QUERY_LIVE_EFFECTS, Trial.BladeArc) = 0,
        "Zara cleanup restores shared budgets without allocating fire")

End Sub

Sub CheckMiraBattles()

    Dim TabIndex As Number
    Dim Cycle As Number
    Dim Schedule As BeatSequence.Timing
    Dim Saved As BeatSequence.Bookmark
    Dim Ok As Boolean
    Dim Updated As ViewerParty.ParticipantUpdateResult
    Dim Members As Number
    Dim SampleTime As Number
    Dim Bounds As Character3D.Bounds3D

    If Not ViewerProfiles.INCLUDE_MIRA_COMPARISONS Then
        Return
    End If

    For TabIndex = ViewerProfiles.CHARACTER_TAB_MIRA1 To ViewerProfiles.CHARACTER_TAB_MIRA

        Call SelectCharacterTab(TabIndex)
        Call CalibrationCheck(Session.Ready And Character3D.ClipCount(Character) = 9,
            "Each Mira tab loads its own nine-clip package")
        Call CalibrationCheck(Effects.Water.Ready,
            "Every Mira tab owns standalone water effects")
        Call CalibrationCheck(Character3D.HasSocket(Character, "HandLeft") And
            Character3D.HasSocket(Character, "HandRight"),
            "Each Mira tab exposes its own casting and staff hand sockets")

        If TabIndex = ViewerProfiles.CHARACTER_TAB_MIRA Then
            Bounds = Character3D.LocalBounds(Character)

            Call CalibrationCheck(Bounds.Valid And Abs(Bounds.Minimum.Y) <= 1 And
                Abs(ViewerCameraState.Frame.PositionY) < 0.1,
                "Mira staff bind bounds do not lift her above the arena")
        End If

    End For

    For TabIndex = 0 To 1

        Call SelectCharacterTab(3 + TabIndex * 4)

        If Not Party.Water.Ready Then

            Print "Mira water admission tab/stage/error: "; TabIndex; "/"; Party.Water.Effect.FailureStage; "/"; Party.Water.Effect.ErrorCode
            Print "Mira/Party ready: "; Party.Mira.Ready; "/"; Party.Ready
            Print "GPU slots: "; Graphics3D.GpuParticleValue3D(Graphics3D.GPU_PARTICLE_QUERY_TOTAL_CAPACITY)

        End If

        Call CalibrationCheck(Party.Mira.Ready And Party.Water.Ready And
            Party.Mira.Profile = ViewerProfiles.PROFILE_MIRA And
            Not Party.Mira.CalibrationAvailable,
            "Both battles own the new Mira without borrowing a calibration bank")
        Call CalibrationCheck(Party.Mira.Actor.Handle <> Character.Handle And
            Party.Mira.Actor.Handle <> Party.Companion.Actor.Handle,
            "Mira has an independent actor and animation clock")
        Call CalibrationCheck(Abs(Party.Mira.Frame.PositionY) < 0.1,
            "Both party formations preserve Mira's grounded actor frame")

        Members = 3

        If Party.UnityRoster Then
            Members = 4
        End If

        Call CalibrationCheck(Party.ParticipantCount = Members,
            "Formation admits Mira in addition to the existing heroes")

        For Cycle = 0 To 5

            Party.AttackCycle = Cycle
            Party.Turn = 6
            Schedule = BeatSequence.Times(Party, Character, Playback.PlaybackSpeed, 6, 0)
            SampleTime = (Schedule.Start[2] + Schedule.Start[3]) / 2
            Ok = BeatSequence.Sample(Party, Character, ViewerCameraState.Frame,
                Playback.SelectedClip, DragonState, Playback.PlaybackSpeed, 6, SampleTime)
            Updated = ViewerParty.UpdateCompanion(Party, Calibration, Effects, 0, False)
            Ok = ViewerParty.UpdateAdditionalEquipment(Party, Effects, Equipment,
                ViewerCameraState.Live, 0, 0, True, Character, DragonState.Actor) And Ok

            Call CalibrationCheck(Ok And Updated.Ready And Party.Water.Visible,
                "Mira's four attacks and both heals seek and render from her own clip clock")
            Call CalibrationCheck(Party.Water.Targets.MemberCount = Members,
                "Water effects target the final transforms of the current party")

            If Cycle = 1 Or Cycle = 2 Then
                Call CalibrationCheck(DragonState.Clip = "Idle" And
                    ViewerParty.PresentationState(Party, 0) = ViewerParty.STATE_REVIVING,
                    "Healing restores the recipient without making the boss flinch")
            End If

            Saved = BeatSequence.Remember(Party)

            Call BeatSequence.RememberPoses(Saved, Party, Character, DragonState.Actor)

            Ok = BeatSequence.Sample(Party, Character, ViewerCameraState.Frame,
                Playback.SelectedClip, DragonState, Playback.PlaybackSpeed,
                6, Schedule.Start[3] + 800)
            Ok = ViewerParty.UpdateAdditionalEquipment(Party, Effects, Equipment,
                ViewerCameraState.Live, 0, 0, True, Character, DragonState.Actor) And Ok

            Call CalibrationCheck(Ok And Not Party.Water.Visible,
                "Completed Mira casts clear their water particles")

            Call BeatSequence.Restore(Party, Saved)

            Ok = BeatSequence.RestorePoses(Saved, Party, Character, DragonState,
                Playback.PlaybackSpeed)

            Call CalibrationCheck(Ok And Character3D.AnimationTime(Party.Mira.Actor) = Saved.Times[6],
                "Closing camera preview restores Mira's animation time")
        End For

        Ok = BeatSequence.Sample(Party, Character, ViewerCameraState.Frame,
            Playback.SelectedClip, DragonState, Playback.PlaybackSpeed, 6, Schedule.Start[4])

        Call CalibrationCheck(Ok And Party.Turn = 2,
            "Mira's completed turn hands control back to the boss")

        If Not Party.UnityRoster Then

            Call ViewerParty.PrepareDragonTurn(Party, 2)

            Ok = BeatSequence.Sample(Party, Character, ViewerCameraState.Frame,
                Playback.SelectedClip, DragonState, Playback.PlaybackSpeed, 2,
                ViewerParty.DragonImpactTime(Party) * 100 / Playback.PlaybackSpeed + 1, True)

            Call CalibrationCheck(Ok And Party.HitTarget = 6 And
                Character3D.CurrentClipNameMatches(Party.Mira.Actor, "Hit"),
                "Dragon targeting resolves Mira's own hit clip")

        End If

    End For

    Call SelectCharacterTab(0)
    Call CalibrationCheck(Not Party.Mira.Ready And Not Party.Water.Ready,
        "Leaving Party releases Mira's actor and water resources")

End Sub
