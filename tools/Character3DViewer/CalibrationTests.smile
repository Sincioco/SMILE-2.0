''' Injected in place of the interactive startup only; all Viewer procedures are real.
Dim TestFailures As Number
Dim TestIndex As Number
Dim TestSavedCount As Number
Dim TestFireAge As Number
Dim TestFireGeneration As Number
Dim TestFireAdvanceCount As Number
Dim TestVisualEpoch As Number
Dim TestAnchor As Core.Vector3
Dim TestPosition As Core.Vector3
Dim TestTwin As Character3D.Actor
Dim TestFormationFirst As Core.Vector3
Dim TestFormationMiddle As Core.Vector3
Dim TestFormationLast As Core.Vector3
Dim TestLightning As Lightning.LightningEffect
Dim TestLightningAge As Number
Dim TestLightningSource As Core.Vector3
Dim TestLightningTarget As Core.Vector3

Game Window "SMILE Calibration Isolation Tests" Size 640 By 480

Call CalibrationCheck(ViewerProfiles.CalibrationFingerprint(ViewerProfiles.PROFILE_ARIN) =
    TEST_ARIN_PROFILE_FINGERPRINT, "Arin runtime fingerprint matches canonical package")
Call CalibrationCheck(ViewerProfiles.CalibrationFingerprint(ViewerProfiles.PROFILE_ORIN) =
    TEST_ORIN_PROFILE_FINGERPRINT, "Orin runtime fingerprint matches canonical package")

ProfileIndex = ViewerProfiles.PROFILE_ARIN

Call LoadViewer()
Call CalibrationCheck(Ready And Not ViewerError, "Load profile")
Call CalibrationCheck(Not CalibrationStorageRejected, "Accept current Arin saved calibration")
Call CheckPackagedCalibration()
Call CalibrationCheck(Character3D.SocketCount(Character) = ActiveProfile.ExpectedSocketCount,
    "Profile socket contract")
Call SelectCharacterTab(1)
Call CalibrationCheck(Ready And Not ViewerError And Not CalibrationStorageRejected,
    "Orin loads with its canonical saved calibration")
Call CheckPackagedCalibration()
Call SelectCharacterTab(2)
Call CalibrationCheck(Ready And Not ViewerError And PartyReady,
    "Dragon loads both calibrated companions")
Call SelectCharacterTab(3)
Call CalibrationCheck(Ready And Not ViewerError And PartyReady,
    "Party loads both calibrated heroes")
Call SelectCharacterTab(0)
Call CalibrationCheck(Ready And Not ViewerError And Not CalibrationStorageRejected,
    "Return to Arin after Dragon and Party")

''' The remaining editing checks start from an empty isolated track.

Call ClearCalibrationMemory()

CalibrationSaved = False
CalibrationStorageCount = 0
CalibrationUndoCount = 0

Call SaveCalibrationKeyframes(False)
Call RestartPresentation()

ScenePaused = False

Call SeekFirstAnimationFrame()
Call CalibrationCheck(ScenePaused And Character3D.AnimationTime(Character) = 0,
    "0-Frame pauses the scene at frame zero")

ScenePaused = False

Call StepAnimationFrame(1)
Call CalibrationCheck(ScenePaused And Character3D.AnimationTime(Character) > 0,
    "Frame forward pauses before stepping")

ScenePaused = False

Call StepAnimationFrame(-1)
Call CalibrationCheck(ScenePaused And Character3D.AnimationTime(Character) = 0,
    "Frame backward pauses before stepping")

ScenePaused = False

Call SeekCalibrationKeyframe(-1)
Call CalibrationCheck(ScenePaused, "Previous key pauses even without saved keys")

ScenePaused = False

Call SeekCalibrationKeyframe(1)
Call CalibrationCheck(ScenePaused, "Next key pauses even without saved keys")
Call ToggleScenePause()
Call CalibrationCheck(Not ScenePaused, "Space-style toggle resumes after navigation")

TestTwin = Character3D.LoadWithPolicy(ActiveProfile.AssetPath,
    Character3D.CHARACTER_LOAD_REQUIRE_PBR)

Call CalibrationCheck(Character3D.IsValid(TestTwin) And TestTwin.Handle <> Character.Handle,
    "Two instances of the same model have independent handles")

Ready = Character3D.PlayMode(Character, "Idle", Graphics3D.ANIMATION_LOOP, 100) And Ready
Ready = Character3D.PlayMode(TestTwin, "SwordAttack", Graphics3D.ANIMATION_ONCE, 100) And Ready
Ready = Character3D.SetAnimationTime(Character, 111) And Ready
Ready = Character3D.SetAnimationTime(TestTwin, 444) And Ready

Call CalibrationCheck(Character3D.CurrentClipNameMatches(Character, "Idle") And
    Character3D.CurrentClipNameMatches(TestTwin, "SwordAttack"),
    "Two instances retain different clips")
Call CalibrationCheck(Character3D.AnimationTime(Character) = 111 And
    Character3D.AnimationTime(TestTwin) = 444, "Two instances retain different times")

Ready = Character3D.Update(Character, 16) And Ready

Call CalibrationCheck(Character3D.AnimationTime(Character) > 111 And
    Character3D.AnimationTime(TestTwin) = 444, "Advancing one instance does not advance the other")

Call Character3D.Destroy(TestTwin)

Call SetPartyPresentationState(0, PARTY_STATE_HIT)
Call SetPartyPresentationState(1, PARTY_STATE_KO)
Call CalibrationCheck(PartyPresentationState(0) = PARTY_STATE_HIT And
    PartyPresentationState(1) = PARTY_STATE_KO, "Party actor states remain independent")
Call CalibrationCheck(PartyPresentationStateName(PARTY_STATE_ALIVE) = "Alive" And
    PartyPresentationStateName(PARTY_STATE_ACTING) = "Acting" And
    PartyPresentationStateName(PARTY_STATE_GUARDING) = "Guarding" And
    PartyPresentationStateName(PARTY_STATE_HIT) = "Hit" And
    PartyPresentationStateName(PARTY_STATE_KO) = "KO" And
    PartyPresentationStateName(PARTY_STATE_REVIVING) = "Reviving",
    "Party presentation states are explicit")

Call SetPartyPresentationState(0, PARTY_STATE_ALIVE)
Call SetPartyPresentationState(1, PARTY_STATE_ALIVE)

TestFormationFirst = PartyHomePosition(0, 3)
TestFormationMiddle = PartyHomePosition(1, 3)
TestFormationLast = PartyHomePosition(2, 3)

Call CalibrationCheck(Math3D.Distance(TestFormationFirst, TestFormationMiddle) > 90 And
    Math3D.Distance(TestFormationMiddle, TestFormationLast) > 90,
    "Front-arc formation expands to three participants")

Call ClearCalibrationMemory()

ScenePaused = True
DemoEnabled = False
SelectedClip = 3
CalibrationTarget = CALIBRATION_TARGET_SWORD
CalibrationAxis = CALIBRATION_AXIS_X

Call PlaySelectedClip()

SwordPositionCalibration[3, 0] = 2
CalibrationSaved = True
CalibrationSavedClip = 3
CalibrationSavedFrame = 0

Call CalibrationCheck(StoreCalibrationKeyframe(3, 0), "Store first key")

CalibrationClipBase = CALIBRATION_MAX_CLIPS

Call ClearCalibrationMemory()

SwordPositionCalibration[CalibrationClipBase + 3, 0] = 19

Call CalibrationCheck(StoreCalibrationKeyframe(3, 0), "Second character stores its own frame")
Call CalibrationCheck(CalibrationKeyframeValues[3, 12] = 2, "Second character does not modify Arin's frame")
Call CalibrationCheck(CalibrationKeyframeValues[CalibrationClipBase + 3, 12] = 19, "Same clip and frame retain distinct values")
Call ClearCalibrationMemory()
Call CalibrationCheck(CalibrationKeyframeCounts[3] = 1, "Clearing another character preserves Arin")

CalibrationClipBase = 0
CalibrationSaved = True
CalibrationSavedClip = 3
CalibrationSavedFrame = 0

Call SaveCalibrationKeyframes()
Call UndoLastCalibrationChange()
Call CalibrationCheck(CalibrationKeyframeCounts[3] = 0, "Undo also restores a never-saved empty track")

CalibrationSaved = True
CalibrationSavedClip = 3
CalibrationSavedFrame = 0
SwordPositionCalibration[3, 0] = 2

Call CalibrationCheck(StoreCalibrationKeyframe(3, 0), "Restore first key")
Call SaveCalibrationKeyframes()

SwordPositionCalibration[3, 0] = 7

Call LoadSavedCalibration()
Call CalibrationCheck(CalibrationKeyframeCounts[3] = 1 And
    CalibrationKeyframeValues[3, 12] = 2, "Saved edits take precedence over packaged defaults")

SwordPositionCalibration[3, 0] = 7

Call CalibrationCheck(StoreCalibrationKeyframe(3, 10), "Store second key")
Call SaveCalibrationKeyframes()
Call CalibrationCheck(CalibrationKeyframeValues[3, 12] = 2, "Second key cannot modify first")
Call CalibrationCheck(CalibrationKeyframeValues[3, 32] = 7, "Second key stores full move channels")
Call UndoLastCalibrationChange()
Call CalibrationCheck(CalibrationKeyframeCounts[3] = 1, "Undo insertion")
Call CalibrationCheck(CalibrationKeyframeValues[3, 12] = 2, "Undo preserves all channels")
Call ClearSelectedClipCalibration()
Call CalibrationCheck(CalibrationKeyframeCounts[3] = 0, "Selected clip cleared")
Call UndoLastCalibrationChange()
Call CalibrationCheck(CalibrationKeyframeCounts[3] = 1, "Undo selected clip delete")

TestSavedCount = CalibrationStorageCount
CalibrationStorage[10] = 0

Call CalibrationCheck(Not DecodeCalibrationStorage(TestSavedCount), "Reject profile fingerprint")

CalibrationStorage[10] = Text_Code_At(CalibrationProfileFingerprint, 0)

Call CalibrationCheck(DecodeCalibrationStorage(TestSavedCount), "Decode all named clips")
Call ApplyWristCalibration()
Call ApplyEquipmentCalibration()

CalibrationHoldGrip = True
CalibrationTransform = CALIBRATION_TRANSFORM_ROTATE
TestAnchor = EquipmentGripThousandths(WEAPON_PART_INDEX, "HandRight")

For TestIndex = 1 To 6

    Call SetCurrentCalibrationValue(45)
    Call SaveCalibrationFrame()
    Call ReloadCurrentCalibrationKeyframe()
    Call SetCurrentCalibrationValue(0)
    Call SaveCalibrationFrame()
    Call ReloadCurrentCalibrationKeyframe()
End For

TestPosition = EquipmentGripThousandths(WEAPON_PART_INDEX, "HandRight")

Call CalibrationCheck(Abs(TestPosition.X - TestAnchor.X) < 1000 And
    Abs(TestPosition.Y - TestAnchor.Y) < 1000 And Abs(TestPosition.Z - TestAnchor.Z) < 1000,
    "Repeated in-place inverse rotations do not accumulate whole-unit drift")
Call CalibrationCheck(SocketReferencePart("SwordTip") = WEAPON_PART_INDEX, "Sword marker owns equipment transform")
Call CalibrationCheck(SocketReferencePart("ShieldFireTip") = SHIELD_PART_INDEX, "Shield marker owns equipment transform")
Call CalibrationCheck(SocketReferencePart("HandRight") = BODY_PART_INDEX, "Hand marker owns wrist transform")

CameraElapsed = 16
FlameAnimationPaused = False

Call UpdateEquipmentFire()
Call AdvanceSceneVfx()
Call CalibrationCheck(SwordFire.Slot <> 0 And Not ShieldFireFailed, "All equipment emitters admitted")

TestFireAge = Fire.Value(10, SwordFire)

Call UpdateEquipmentFire()
Call AdvanceSceneVfx()
Call CalibrationCheck(Fire.Value(10, SwordFire) > TestFireAge, "Flames animate while scene paused")

FlameAnimationPaused = True
TestFireAge = Fire.Value(10, SwordFire)

Call UpdateEquipmentFire()
Call AdvanceSceneVfx()
Call CalibrationCheck(Fire.Value(10, SwordFire) = TestFireAge, "Paused flame clock stays frozen")

TestFireGeneration = SwordFire.Generation
SwordVisible = False
ShieldVisible = False

Call UpdateEquipmentFire()
Call AdvanceSceneVfx()
Call CalibrationCheck(SwordFire.Slot = 0, "Hidden sword destroys frozen Fire immediately")
Call CalibrationCheck(Not ArinShieldRim.IsVisible(),
    "Hidden shield clears the frozen ember outline immediately")

SwordVisible = True
ShieldVisible = True

Call UpdateEquipmentFire()
Call AdvanceSceneVfx()
Call CalibrationCheck(SwordFire.Slot = 0 And Not ArinShieldRim.IsVisible(),
    "Showing equipment while frozen does not resurrect stale effects")

FlameAnimationPaused = False

Call UpdateEquipmentFire()
Call AdvanceSceneVfx()
Call CalibrationCheck(SwordFire.Slot <> 0 And SwordFire.Generation <> TestFireGeneration,
    "Fire resumes from a new current attachment after a frozen hide")

FlameAnimationPaused = True

TestVisualEpoch = VisualContinuityEpoch

Call SeekFirstAnimationFrame()
Call CalibrationCheck(VisualContinuityEpoch > TestVisualEpoch, "Seek invalidates visual history")
Call UpdateEquipmentFire()
Call AdvanceSceneVfx()
Call CalibrationCheck(Fire.Value(10, SwordFire) = 0, "Seek does not warm up paused flames")

FlameAnimationPaused = False

Call UpdateEquipmentFire()
Call AdvanceSceneVfx()
Call CalibrationCheck(Fire.Value(10, SwordFire) <= 20, "Flame resume has no catch-up burst")

SwordFireReady = False
TestFireAge = Fire.Value(10, SwordFire)
TestFireAdvanceCount = SceneVfxClock.FireAdvanceCount

Call UpdateEquipmentFire()
Call AdvanceSceneVfx()
Call CalibrationCheck(Fire.Value(10, SwordFire) > TestFireAge,
    "Unavailable equipment component does not stall shared Fire")
Call CalibrationCheck(SceneVfxClock.FireAdvanceCount = TestFireAdvanceCount + 1,
    "Shared Fire advances exactly once per scene frame")

SwordFireReady = FireInitialized

LightningInitialized = Lightning.Initialize("Assets/Lightning", 8192,
    Graphics3D.GPU_PARTICLE_SIMULATION_AUTO, 4096)
TestLightningTarget.X = 40
TestLightningTarget.Y = 80
TestLightning = Lightning.StartAt("StoredStorm", TestLightningSource,
    TestLightningTarget, 8647, Lightning.QUALITY_MEDIUM)

Call CalibrationCheck(LightningInitialized And TestLightning.Slot <> 0,
    "Shared Lightning test effect admitted")

FlameAnimationPaused = False
LightningAnimationPaused = True
TestFireAge = Fire.Value(10, SwordFire)
TestLightningAge = Lightning.Value(Lightning.QUERY_AGE, TestLightning)

Call AdvanceSceneVfx()
Call CalibrationCheck(Fire.Value(10, SwordFire) > TestFireAge And
    Lightning.Value(Lightning.QUERY_AGE, TestLightning) = TestLightningAge,
    "Frozen Lightning does not stop Fire")

FlameAnimationPaused = True
LightningAnimationPaused = False
TestFireAge = Fire.Value(10, SwordFire)
TestLightningAge = Lightning.Value(Lightning.QUERY_AGE, TestLightning)

Call AdvanceSceneVfx()
Call CalibrationCheck(Fire.Value(10, SwordFire) = TestFireAge And
    Lightning.Value(Lightning.QUERY_AGE, TestLightning) > TestLightningAge,
    "Frozen Fire does not stop Lightning")

Ready = Lightning.Destroy(TestLightning) And Ready

Call Lightning.Shutdown()

LightningInitialized = False
FlameAnimationPaused = False
LightningAnimationPaused = False

TestFireGeneration = SwordFire.Generation

Call PlaySelectedClip(True)
Call UpdateEquipmentFire()
Call AdvanceSceneVfx()
Call CalibrationCheck(SwordFire.Generation = TestFireGeneration, "Automatic playback keeps fire tails")
Call SelectClip(0)
Call UpdateEquipmentFire()
Call AdvanceSceneVfx()
Call CalibrationCheck(SwordFire.Generation <> TestFireGeneration, "Explicit clip selection clears old fire")

Do

    ScenePaused = True
    PresentationElapsed = 60000

    Call AdvanceAnimationSequence()
    Call CalibrationCheck(Not DemoEnabled And ScenePaused, "No idle timer enables Demo or resumes")
    Call HandleKeyboard(KEY_SPACE)
    Call CalibrationCheck(Not ScenePaused, "Space resumes")
    Call HandleKeyboard(KEY_SPACE)
    Call CalibrationCheck(ScenePaused, "Space pauses")

    Show Screen

Loop Until True

FlameAnimationPaused = True
CalibrationVisible = True
DragonVisible = False
FloorVisible = False
GridVisible = False
UiVisibility = 2

Call ResetAll()
Call CalibrationCheck(Not ScenePaused And Not FlameAnimationPaused And DemoEnabled, "Reset restores playback defaults")
Call CalibrationCheck(Not CalibrationVisible And UiVisibility = 0, "Reset hides pose panel and restores UI")
Call CalibrationCheck(DragonVisible And FloorVisible And GridVisible, "Reset restores the arena")
Call CalibrationCheck(CalibrationKeyframeCounts[3] = 1, "Reset preserves saved corrections")

UiVisibility = 0

Call HandleKeyboard(KEY_BACKTICK)
Call CalibrationCheck(UiVisibility = 1, "First backtick hides panels")
Call HandleKeyboard(KEY_BACKTICK)
Call CalibrationCheck(UiVisibility = 2, "Second backtick hides all UI")
Call HandleKeyboard(KEY_BACKTICK)
Call CalibrationCheck(UiVisibility = 0, "Third backtick restores UI")

Call DestroyViewer()

If TestFailures = 0 Then
    Print "Viewer calibration isolation passed"
Else
    Print "Viewer calibration failures:"
    Print TestFailures
End If

Sub CalibrationCheck(Condition As Boolean, Label As Text)

    If Not Condition Then

        TestFailures = TestFailures + 1
        Print "FAIL:"
        Print Label

    End If

End Sub

Sub CheckPackagedCalibration()

    Dim OriginalKey As Text
    Dim JsonSnapshot As Text

    JsonSnapshot = SavedCalibrationJson()

    Call CalibrationCheck(Text_Length(JsonSnapshot) > 0, "Saved JSON export is available")

    Print "CALIBRATION_JSON: " + JsonSnapshot

    TestSavedCount = CalibrationStorageCount
    OriginalKey = CalibrationDataKey

    For TestIndex = 0 To TestSavedCount - 1
        CalibrationUndoStorage[TestIndex] = CalibrationStorage[TestIndex]
    End For

    CalibrationDataKey = "ViewerCalibrationTests.MissingPackagedSeed"

    Call ClearCalibrationMemory()
    Call LoadSavedCalibration()
    Call CalibrationCheck(Not CalibrationStorageRejected And
        CalibrationStorageCount = TestSavedCount, "Fresh storage loads packaged calibration")

    For TestIndex = 0 To TestSavedCount - 1
        Call CalibrationCheck(CalibrationStorage[TestIndex] = CalibrationUndoStorage[TestIndex],
            "Packaged calibration preserves every canonical byte")
    End For

    CalibrationDataKey = OriginalKey
    CalibrationUndoCount = 0

End Sub
