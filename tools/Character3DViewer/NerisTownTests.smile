''' Focused route-following and town navigation checks; no renderer or UI required.

Option Explicit

Import Smile.Simple3D.PartyTrail3D As Trail
Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.PrecisionMath3D As M
Import Smile.Tools.NerisTownNavigation As Navigation

Dim Path As Trail.State
Dim Leader As P.Vector3
Dim Position As P.Vector3
Dim Index As Number
Dim MemberIndex As Number
Dim Failures As Number

Call Trail.Reset(Path, P.Vector(0.0, 0.0, 0.0), 5, 22.0)

For Index = 1 To 100
    Leader = P.Vector(ToDouble(Index), 0.0, 0.0)

    Call Trail.Advance(Path, Leader, 25, 40.0)
End For

Call Check(Abs(Path.Positions[4].X - 12.0) < 0.001, "Five Members Preserve Spacing")

For Index = 1 To 50

    Leader = P.Vector(100.0, 0.0, ToDouble(Index))

    Call Trail.Advance(Path, Leader, 25, 40.0)

    For MemberIndex = 1 To 4
        Call Check(Abs(Path.Positions[MemberIndex].X - 100.0) < 0.001 Or
            Abs(Path.Positions[MemberIndex].Z) < 0.001, "Followers Take The Corner")
    End For
End For

For Index = 1 To 150
    Call Trail.Advance(Path, Leader, 25, 40.0)
End For

For MemberIndex = 1 To 4
    Call Check(M.Length(M.Subtract(Path.Positions[MemberIndex], Leader)) < 0.001,
        "Stopped Party Gathers At Leader")
    Call Check(Not Path.Moving[MemberIndex], "Gathered Member Stops")
End For

Leader.X = Leader.X + 1.0

Call Trail.Advance(Path, Leader, 25, 40.0)
Call Check(Abs(Path.Positions[4].X - 100.0) < 0.001, "Restart Does Not Pull Followers Backward")
Call Check(Not Navigation.CanStand(0.0, -750.0), "City Hall Walls Block Walking")
Call Check(Not Navigation.CanStand(0.0, 375.0), "Comm Tower Walls Block Walking")
Call Check(Not Navigation.CanStand(580.0, -2200.0), "Civic Canal Blocks Walking")
Call Check(Navigation.CanStand(580.0, -2800.0), "Civic Bridge Is Open")
Call Check(Navigation.CanStand(-580.0, -1120.0), "West City Hall Crossroad Bridge Is Open")
Call Check(Navigation.CanStand(580.0, -1120.0), "East City Hall Crossroad Bridge Is Open")
Call Check(Navigation.CanStand(860.0, -2100.0), "Shop Main Avenue Is Open")
Call Check(Not Navigation.CanStand(2800.0, 0.0), "Waterfront Boundary Blocks Walking")
Call Check(Navigation.CanStand(-3660.0, 1250.0), "Tripo Bridge Crosses Its Moat")
Call Check(Navigation.CanStand(-3500.0, 1100.0), "Tripo Landing Joins Main Avenue On Land")
Call Check(Not Navigation.CanStand(-4500.0, 2000.0), "Tripo Moat Blocks Walking")
Call Check(Navigation.CanStand(-4770.0, 2200.0), "West Castle Circuit Is Walkable")
Call Check(Navigation.CanStand(-2500.0, 2200.0), "Shared Castle Street Is Walkable")
Call Check(Navigation.CanStand(-1160.0, 1450.0), "Royal Bridge Is Open")
Call Check(Navigation.CanStand(-1160.0, 1750.0), "Royal Gate Is Open")
Call Check(Navigation.CanStand(-1160.0, 2240.0), "Royal Central Stairs Are Walkable")
Call Check(Navigation.GroundHeight(-1160.0, 2240.0) > 60.0, "Royal Stairs Raise The Party")
Call Check(Not Navigation.CanStand(-2150.0, 2000.0), "Royal Moat Blocks Walking")
Call Check(Navigation.CanStand(1450.0, 1550.0), "Military Bridge Is Open")
Call Check(Navigation.CanStand(1450.0, 3440.0), "Northern HQ Road Is Open")
Call Check(Navigation.CanStand(2510.0, 2420.0), "Eastern HQ Road Is Open")
Call Check(Not Navigation.CanStand(-2080.0, 880.0), "Estate Walls Block Walking")
Call Check(Not Navigation.CanStand(-2100.0, -1420.0), "Middle Home Walls Block Walking")
Call Check(Not Navigation.CanStand(1190.0, 800.0), "Workers Home Walls Block Walking")
Call Check(Abs(Navigation.GroundHeight(-1160.0, 1450.0) - 23.12) < 0.001, "Bridge Height")

Position = P.Vector(-1160.0, Navigation.GroundHeight(-1160.0, 1200.0), 1200.0)

For Index = 1 To 320
    Position = Navigation.Move(Position, 0.0, 2.0)
End For

Print "Royal Entry Reached"
Print Position.Z

Call Check(Position.Z >= 1839.0, "Party Crosses The Entire Royal Bridge And Open Gate")

Position = Navigation.Move(P.Vector(450.0, 20.9, -2200.0), 200.0, 0.0)

Call Check(Position.X < 500.0, "Large Movement Cannot Tunnel Through Canal")

Position = P.Vector(-860.0, 23.12, -1120.0)

For Index = 1 To 230
    Position = Navigation.Move(Position, 2.0, 0.0)
End For

Call Check(Position.X >= -401.0, "Party Crosses West Canal Directly Into City Hall Forecourt")

Position = P.Vector(860.0, 23.12, -1120.0)

For Index = 1 To 230
    Position = Navigation.Move(Position, -2.0, 0.0)
End For

Call Check(Position.X <= 401.0, "Party Crosses East Canal Directly Into City Hall Forecourt")

Position = P.Vector(0.0, Navigation.GroundHeight(0.0, 105.0), 105.0)

For Index = 1 To 95
    Position = Navigation.Move(Position, 0.0, 1.0)
End For

Call Check(Position.Z > 195.0 And Position.Y > 50.0, "Party Climbs The Scaled Comm Tower Stairs To Its Door")

Position = P.Vector(0.0, Navigation.GroundHeight(0.0, -945.0), -945.0)

For Index = 1 To 70
    Position = Navigation.Move(Position, 0.0, 1.0)
End For

Call Check(Position.Z > -881.0 And Position.Y > 40.0, "Party Climbs City Hall Stairs To Its Door")

If Failures = 0 Then
    Print "PASS Neris Town Routes"
Else
    Print "FAIL Neris Town Routes"
End If

Sub Check(Condition As Boolean, Label As Text)

    If Not Condition Then
        Failures = Failures + 1
        Print "FAIL " + Label
    End If

End Sub
