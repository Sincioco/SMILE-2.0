''' Focused route-following and town navigation checks; no renderer or UI required.

Option Explicit

Import Smile.Simple3D.PartyTrail3D As Trail
Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.PrecisionMath3D As M
Import Smile.Tools.NerisTownNavigation As Navigation
Import Smile.Tools.NerisCastleRoute As Castle
Import Smile.Tools.NerisHorizonRoute As Spaceport
Import Smile.Tools.NerisSpaceportTraffic As Traffic
Import Smile.Tools.NerisRunwayTraffic As Runway
Import Smile.Tools.TownPartyInset As Inset

Dim Path As Trail.State
Dim Leader As P.Vector3
Dim Position As P.Vector3
Dim Index As Number
Dim MemberIndex As Number
Dim Failures As Number

Dim Flights As Traffic.State
Dim EyeView As P.Camera3D
Dim Facing As P.Vector3

For Index = 0 To 3

    Facing = M.Rotate(P.Vector(0.0, 0.0, -1.0), P.Vector(0.0, ToDouble(Index) * 90.0, 0.0))
    EyeView = Inset.Frame(P.Vector(15.0, 23.12, -40.0), ToDouble(Index) * 90.0)

    Call Check(M.Dot(M.Subtract(EyeView.Target, EyeView.Position), Facing) > 199.99 And
        Abs(EyeView.Target.Y - EyeView.Position.Y) < 0.001,
        "Inset Looks Ahead Of Arin At Eye Level In Every Cardinal Direction")
    Call Check(M.Dot(M.Subtract(EyeView.Position, P.Vector(15.0, 23.12, -40.0)), Facing) > 3.99,
        "Inset Lens Sits Ahead Of Arin Rather Than Behind Him")
End For

Call Check(Inset.PANEL_TOP = 531 And Inset.VIEW_TOP = 553,
    "Inset Joins The Minimap Bottom Without A Floating Gap")
Call Check(Inset.Visible(True, False) And Not Inset.Visible(True, False, True) And
    Not Inset.Visible(False, False) And Not Inset.Visible(True, True),
    "POV Is Only Drawn While Moving Visible And Outside Editing")

Call Spaceport.Enable(True)

Position = Navigation.Move(P.Vector(5500.0, 23.12, 1250.0), -100.0, 0.0)

Call Check(Abs(Position.X - 5400.0) < 0.001,
    "Airport Arrival Walks Across Apron Margin To Connecting Road")

Position = Navigation.Move(P.Vector(5400.0, 23.12, 1250.0), 100.0, 0.0)

Call Check(Abs(Position.X - 5500.0) < 0.001,
    "Connecting Road Walks Across Apron Margin Into Airport")

Call Trail.Reset(Path, Spaceport.ToWorld(P.Vector(0.0, 0.8, -20.0)), 4, 22.0)
Call Check(Not Spaceport.CanStand(7390.0, 1250.0), "Closed Terminal Door Blocks Crossing")

For Index = 1 To 12
    Call Spaceport.Update(Path, 4, 100)
End For

Call Check(Spaceport.DoorAngle() = 95.0, "Party Approach Opens Both Terminal Leaves")

Position = Navigation.Move(P.Vector(5500.0, 23.12, 1250.0), 2400.0, 0.0)

Call Check(Abs(Position.X - 7900.0) < 0.001 And Abs(Position.Y - 31.12) < 0.001,
    "Horizon Arrival Reaches The Central Promenade")
Call Check(Not Navigation.CanStand(8480.0, -2400.0), "Pedestrian Route Excludes The Hangar")
Call Check(Not Navigation.CanStand(9700.0, 1250.0), "Pedestrian Route Excludes The Control Tower")
Call Check(Spaceport.CanStand(7800.0, 2750.0), "Terminal Ground Floor Is Open Beyond The Center Aisle")
Call Check(Not Spaceport.CanStand(7710.0, 2050.0), "Passenger Counter Blocks Walking")
Call Check(Not Spaceport.CanStand(8000.0, 2050.0), "Waiting Seats Block Walking")
Call Check(Not Spaceport.CanStand(7410.0, 1450.0), "Closed Glass Beside The Entrance Blocks Walking")
Call Check(Not Spaceport.CanStand(7420.0, 1450.0), "Party Cannot Pass Through Front Glazing")
Call Check(Not Spaceport.CanStand(10950.0, 1250.0), "Runway Is Outside The Passenger Route")
Call Spaceport.Enable(False)
Call Check(Not Spaceport.Contains(7900.0, 1250.0), "Spaceport Navigation Releases With Its Asset")
Call CheckRunway()

Position = Traffic.Position(Flights, False)

Call Check(Position.Y = 0.0 And Position.Z = -90.0, "Transport Starts On Its Apron")
Call Traffic.Advance(Flights, 60000)

Position = Traffic.Position(Flights, False)

Call Check(Position.Y = 0.0, "Transport Waits Sixty Seconds Before Takeoff")
Call Traffic.Advance(Flights, 5000)

Position = Traffic.Position(Flights, False)

Call Check(Position.Y = 450.0 And Position.Z = -90.0, "Transport Ascends Vertically With Easing")
Call Traffic.Advance(Flights, 5000)
Call Check(Not Traffic.Visible(Flights, False), "Transport Leaves View During Flight")
Call Traffic.Advance(Flights, 45000)

Position = Traffic.Position(Flights, False)

Call Check(Position.Y = 450.0 And Traffic.Visible(Flights, False), "Transport Descends On Its Original Apron")
Call Traffic.Advance(Flights, 5000)

Position = Traffic.Position(Flights, False)

Call Check(Position.Y = 0.0 And Flights.TransportTime = 0, "Transport Lands One Minute After Departure")

Flights.RoyalTime = 0
Position = Traffic.Position(Flights, True)

Call Check(Position.Z = 108.0 And Position.Y = 0.0, "Royal Ship Starts Inside Its Hangar")

Flights.RoyalTime = 37500
Position = Traffic.Position(Flights, True)

Call Check(Position.Z = 9.0 And Position.Y = 0.0, "Royal Ship Rolls Out At Ground Level")

Flights.RoyalTime = 60000
Position = Traffic.Position(Flights, True)

Call Check(Position.Z = -90.0 And Position.Y = 450.0, "Royal Ship Clears The Hangar Before Vertical Takeoff")

Flights.RoyalTime = 125000
Position = Traffic.Position(Flights, True)

Call Check(Position.Z = -90.0 And Position.Y = 0.0, "Royal Ship Lands Before Returning To Its Hangar")

Flights.RoyalTime = 142500
Position = Traffic.Position(Flights, True)

Call Check(Position.Z = 9.0 And Position.Y = 0.0, "Royal Ship Rolls Back Into Its Hangar")

Flights.RoyalTime = 179999

Call Traffic.Advance(Flights, 1)

Position = Traffic.Position(Flights, True)

Call Check(Position.Z = 108.0 And Flights.RoyalTime = 0, "Royal Ship Repeats Its Three Minute Cycle")

Call Trail.Reset(Path, P.Vector(0.0, 0.0, 0.0), 5, 22.0)

For Index = 1 To 100
    Leader = P.Vector(ToDouble(Index), 0.0, 0.0)

    Call Trail.Advance(Path, Leader, 25, 40.0)
End For

Call Check(Abs(Path.Positions[4].X - 12.0) < 0.001, "Five Members Preserve Spacing")

For Index = 1 To 50

    Leader = P.Vector(100.0, 0.0, ToDouble(Index))

    Call Trail.Advance(Path, Leader, 25, 40.0)

    For MemberIndex = 1 To 4
        Call Check(Abs(Path.Positions[MemberIndex].X - 100.0) < 0.001 Or
            Abs(Path.Positions[MemberIndex].Z) < 0.001, "Followers Take The Corner")
    End For
End For

For Index = 1 To 150
    Call Trail.Advance(Path, Leader, 25, 40.0)
End For

For MemberIndex = 1 To 4
    Call Check(M.Length(M.Subtract(Path.Positions[MemberIndex], Leader)) < 0.001,
        "Stopped Party Gathers At Leader")
    Call Check(Not Path.Moving[MemberIndex], "Gathered Member Stops")
End For

Leader.X = Leader.X + 1.0

Call Trail.Advance(Path, Leader, 25, 40.0)
Call Check(Abs(Path.Positions[4].X - 100.0) < 0.001, "Restart Does Not Pull Followers Backward")
Call Check(Not Navigation.CanStand(0.0, -750.0), "City Hall Walls Block Walking")
Call Check(Not Navigation.CanStand(0.0, 375.0), "Comm Tower Walls Block Walking")
Call Check(Not Navigation.CanStand(580.0, -2200.0), "Civic Canal Blocks Walking")
Call Check(Navigation.CanStand(580.0, -2800.0), "Civic Bridge Is Open")
Call Check(Navigation.CanStand(-580.0, -1120.0), "West City Hall Crossroad Bridge Is Open")
Call Check(Navigation.CanStand(580.0, -1120.0), "East City Hall Crossroad Bridge Is Open")
Call Check(Navigation.CanStand(860.0, -2100.0), "Shop Main Avenue Is Open")
Call Check(Not Navigation.CanStand(2800.0, 0.0), "Waterfront Boundary Blocks Walking")
Call Check(Navigation.CanStand(-3660.0, 1250.0), "Tripo Bridge Crosses Its Moat")
Call Check(Navigation.CanStand(-3500.0, 1100.0), "Tripo Landing Joins Main Avenue On Land")
Call Check(Not Navigation.CanStand(-4500.0, 2000.0), "Tripo Moat Blocks Walking")
Call Check(Navigation.CanStand(-4770.0, 2200.0), "West Castle Circuit Is Walkable")
Call Check(Navigation.CanStand(-2500.0, 2200.0), "Shared Castle Street Is Walkable")
Call Check(Navigation.CanStand(-1160.0, 1450.0), "Royal Bridge Is Open")
Call Check(Navigation.CanStand(-1160.0, 1750.0), "Royal Gate Is Open")
Call Check(Navigation.CanStand(-1160.0, 2240.0), "Royal Central Stairs Are Walkable")
Call Check(Navigation.GroundHeight(-1160.0, 2240.0) > 60.0, "Royal Stairs Raise The Party")
Call Check(Not Navigation.CanStand(-2150.0, 2000.0), "Royal Moat Blocks Walking")
Call Check(Navigation.CanStand(1450.0, 1550.0), "Military Bridge Is Open")
Call Check(Navigation.CanStand(1450.0, 3440.0), "Northern HQ Road Is Open")
Call Check(Navigation.CanStand(2510.0, 2420.0), "Eastern HQ Road Is Open")
Call Check(Not Navigation.CanStand(-2080.0, 880.0), "Estate Walls Block Walking")
Call Check(Not Navigation.CanStand(-2100.0, -1420.0), "Middle Home Walls Block Walking")
Call Check(Not Navigation.CanStand(1190.0, 800.0), "Workers Home Walls Block Walking")
Call Check(Abs(Navigation.GroundHeight(-1160.0, 1450.0) - 23.12) < 0.001, "Bridge Height")

Position = P.Vector(-1160.0, Navigation.GroundHeight(-1160.0, 1200.0), 1200.0)

For Index = 1 To 320
    Position = Navigation.Move(Position, 0.0, 2.0)
End For

Print "Royal Entry Reached"
Print Position.Z

Call Check(Position.Z >= 1839.0, "Party Crosses The Entire Royal Bridge And Open Gate")

Position = Navigation.Move(P.Vector(450.0, 20.9, -2200.0), 200.0, 0.0)

Call Check(Position.X < 500.0, "Large Movement Cannot Tunnel Through Canal")

Position = P.Vector(-860.0, 23.12, -1120.0)

For Index = 1 To 230
    Position = Navigation.Move(Position, 2.0, 0.0)
End For

Call Check(Position.X >= -401.0, "Party Crosses West Canal Directly Into City Hall Forecourt")

Position = P.Vector(860.0, 23.12, -1120.0)

For Index = 1 To 230
    Position = Navigation.Move(Position, -2.0, 0.0)
End For

Call Check(Position.X <= 401.0, "Party Crosses East Canal Directly Into City Hall Forecourt")

Position = P.Vector(0.0, Navigation.GroundHeight(0.0, 105.0), 105.0)

For Index = 1 To 95
    Position = Navigation.Move(Position, 0.0, 1.0)
End For

Call Check(Position.Z > 195.0 And Position.Y > 50.0, "Party Climbs The Scaled Comm Tower Stairs To Its Door")

Position = P.Vector(0.0, Navigation.GroundHeight(0.0, -945.0), -945.0)

For Index = 1 To 70
    Position = Navigation.Move(Position, 0.0, 1.0)
End For

Call Check(Position.Z > -881.0 And Position.Y > 40.0, "Party Climbs City Hall Stairs To Its Door")

Call CheckCastle()

If Failures = 0 Then
    Print "PASS Neris Town Routes"
Else
    Print "FAIL Neris Town Routes"
End If

Sub Check(Condition As Boolean, Label As Text)

    If Not Condition Then
        Failures = Failures + 1
        Print "FAIL " + Label
    End If

End Sub

Sub CheckRunway()

    Dim Flight As Runway.State
    Dim Clock As Runway.State
    Dim NextFlight As Runway.State
    Dim Point As P.Vector3
    Dim Before As P.Vector3
    Dim Travel As P.Vector3
    Dim Nose As P.Vector3
    Dim Index As Number
    Dim Ok As Boolean

    Flight.Time = 20000
    Point = Runway.Position(Flight)

    Call Check(Point.X = -240.0 And Point.Y = 0.14 And Point.Z = 355.0,
        "Arrivals Touch Down On The Outer Strip")

    Flight.Time = 37000
    Point = Runway.Position(Flight)

    Call Check(Abs(Point.X - 402.5) < 0.01 And Abs(Point.Z - 312.5) < 0.01 And
        Runway.Heading(Flight) = 90.0, "Aircraft Uses The Connecting U Turn Road")

    Flight.Time = 60000
    Point = Runway.Position(Flight)

    Call Check(Point.X = -180.0 And Point.Z = 270.0 And Point.Y = 0.14,
        "Departures Use The Second Strip")

    For Index = 0 To 4

        Select Case Index
            Case 0
                Flight.Time = 10000
            Case 1
                Flight.Time = 25000
            Case 2
                Flight.Time = 37000
            Case 3
                Flight.Time = 53000
            Case 4
                Flight.Time = 66000
        End Select

        Before = Spaceport.ToWorld(Runway.Position(Flight))
        Nose = M.Rotate(P.Vector(0.0, 0.0, -1.0),
            P.Vector(Runway.Pitch(Flight), Runway.Heading(Flight), 0.0))

        Call Runway.Advance(Flight, 10)

        Travel = M.Subtract(Spaceport.ToWorld(Runway.Position(Flight)), Before)
        Ok = M.TryNormalize(Travel, Travel)

        Call Check(Ok And M.Dot(Nose, Travel) > 0.90, "Aircraft Nose Leads Every Moving Flight Phase")
    End For

    For Index = 0 To 9
        Flight = Runway.Scheduled(Clock, Index)
        NextFlight = Runway.Scheduled(Clock, (Index + 1) Mod 10)

        Call Check((NextFlight.Time - Flight.Time + Runway.CYCLE) Mod Runway.CYCLE = 15000,
            "Ten Flights Are Staggered At Fifteen Second Intervals")
    End For

End Sub

Sub CheckCastle()

    Dim Visitors As Trail.State
    Dim Step As Number
    Dim Point As P.Vector3

    Call Castle.Enable(True)
    Call Trail.Reset(Visitors, P.Vector(0.0, 23.12, -2780.0), 4, 22.0)
    Call Castle.Update(Visitors, 4, 100)
    Call Check(Castle.Angle() = 90.0, "West Bridge Starts Raised Without Visitors")
    Call Check(Not Navigation.CanStand(Castle.ORIGIN_X, Castle.ORIGIN_Z - 1290.0), "Raised West Bridge Blocks Crossing")

    Visitors.Positions[0] = P.Vector(Castle.ORIGIN_X, Castle.DECK_Y, Castle.ORIGIN_Z - 1558.0)

    For Step = 1 To 15
        Call Castle.Update(Visitors, 4, 100)
    End For

    Call Check(Abs(Castle.Angle() - 45.0) < 0.001, "Approach Lowers Bridge Smoothly Halfway")
    Call Check(Not Navigation.CanStand(Castle.ORIGIN_X, Castle.ORIGIN_Z - 1290.0), "Moving Bridge Does Not Admit Crossing")

    For Step = 1 To 15
        Call Castle.Update(Visitors, 4, 100)
    End For

    Call Check(Castle.Angle() = 0.0, "Approach Fully Lowers Bridge")
    Call Check(Navigation.CanStand(Castle.ORIGIN_X, Castle.ORIGIN_Z - 1290.0), "Lowered Bridge Admits Party")

    Point = Navigation.Move(P.Vector(Castle.ORIGIN_X, Castle.DECK_Y, Castle.ORIGIN_Z - 1428.0), 0.0, 765.0)

    Call Check(Point.Z > Castle.ORIGIN_Z - 794.0, "Party Crosses Landing Bridge And Twelve Metre Gateway")
    Call Check(Not Navigation.CanStand(Castle.ORIGIN_X + 650.0, Castle.ORIGIN_Z - 1048.0), "Moat Beside Bridge Stays Impassable")
    Call Check(Not Navigation.CanStand(Castle.ORIGIN_X, Castle.ORIGIN_Z - 304.0), "Fountain Is A Solid Obstacle")

    Visitors.Positions[0] = P.Vector(0.0, 23.12, -2780.0)
    Visitors.Positions[3] = P.Vector(Castle.ORIGIN_X + 170.0, Castle.DECK_Y, Castle.ORIGIN_Z + 2.0)

    For Step = 1 To 60
        Call Castle.Update(Visitors, 4, 100)
    End For

    Call Check(Castle.Angle() = 0.0, "Last Follower Inside Keeps Bridge Down")

    Visitors.Positions[3] = Visitors.Positions[0]

    For Step = 1 To 24
        Call Castle.Update(Visitors, 4, 100)
    End For

    Call Check(Castle.Angle() = 0.0, "Bridge Waits Before Closing After Everyone Leaves")

    For Step = 1 To 31
        Call Castle.Update(Visitors, 4, 100)
    End For

    Call Check(Castle.Angle() = 90.0, "Bridge Rises Automatically After Departure")
    Call Check(Not Navigation.CanStand(Castle.ORIGIN_X, Castle.ORIGIN_Z - 1290.0), "Closed Bridge Restores Collision")

    Point = Navigation.Move(P.Vector(Castle.ORIGIN_X, Castle.DECK_Y, Castle.ORIGIN_Z + 36.0), 0.0, 241.0)

    Call Check(Point.Z >= Castle.ORIGIN_Z + 238.0 And Point.Z <= Castle.ORIGIN_Z + 243.1 And
        Abs(Point.Y - Castle.DECK_Y - 51.0) < 0.001,
        "Twenty Stairs Reach The Closed Palace Threshold Without Walking Through Its Door")

    Call Check(Not Castle.Contains(Castle.ORIGIN_X, Castle.ORIGIN_Z - 1928.0),
        "Normal Town Terrain Owns The Front Ground And Road")

    Call Check(Not Castle.CanStand(Castle.ORIGIN_X + 26.0 * Castle.SCALE,
        Castle.ORIGIN_Z - 32.0 * Castle.SCALE), "Courtyard Planter Has Solid Footprint")
    Call Check(Castle.CanStand(Castle.ORIGIN_X, Castle.ORIGIN_Z + 14.2 * Castle.SCALE) And
        Not Castle.CanStand(Castle.ORIGIN_X, Castle.ORIGIN_Z + 14.6 * Castle.SCALE),
        "Closed Palace Door Ends The Exterior Route")

    Visitors.Positions[0] = P.Vector(Castle.ORIGIN_X, Castle.DECK_Y + 51.0,
        Castle.ORIGIN_Z + 14.2 * Castle.SCALE)

    For Step = 1 To 10
        Call Castle.Update(Visitors, 4, 100)
    End For

    Call Check(Castle.DoorAngle() = 95.0 And
        Castle.CanStand(Castle.ORIGIN_X, Castle.ORIGIN_Z + 18.0 * Castle.SCALE),
        "Touching Palace Threshold Opens Both Doors And Admits Entry")

    Visitors.Positions[0].Z = Castle.ORIGIN_Z + 16.0 * Castle.SCALE

    Call Castle.Update(Visitors, 4, 100)
    Call Check(Castle.ConsumeEntry(), "Palace Threshold Emits A Cutscene Entry Event")
    Call Check(Not Castle.ConsumeEntry(), "Palace Entry Is One Shot Per Approach")

    Visitors.Positions[3] = Visitors.Positions[0]
    Visitors.Positions[0] = P.Vector(0.0, 23.12, -2780.0)

    For Step = 1 To 30
        Call Castle.Update(Visitors, 4, 100)
    End For

    Call Check(Castle.DoorAngle() = 95.0, "Follower In The Entrance Keeps Palace Doors Open")

    Visitors.Positions[3] = Visitors.Positions[0]

    For Step = 1 To 30
        Call Castle.Update(Visitors, 4, 100)
    End For

    Call Check(Castle.DoorAngle() = 0.0 And
        Not Castle.CanStand(Castle.ORIGIN_X, Castle.ORIGIN_Z + 18.0 * Castle.SCALE),
        "Palace Doors Close And Restore Collision After Everyone Leaves")

    Call Castle.Enable(False)
    Call Check(Not Castle.Contains(Castle.ORIGIN_X, Castle.ORIGIN_Z + 2.0), "Leaving Preview Releases Its Navigation")

End Sub
