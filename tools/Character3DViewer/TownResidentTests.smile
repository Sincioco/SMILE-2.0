''' Focused proofs for town errands and conversation state, without a graphics window.
Module Smile.Tools.TownResidentTests

Option Explicit

Import Smile.Tools.TownDocument As Document
Import Smile.Tools.TownDocumentNavigation As Navigation
Import Smile.Tools.TownResidentMovement As Movement
Import Smile.Tools.TownResidentDialogue As Dialogue
Import Smile.Tools.TownResidents As Residents
Import Smile.Tools.TownResidentInteraction As Interaction
Import Smile.Tools.TownRoadTravel As Travel
Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.PrecisionMath3D As M
Import Smile.Simple3D.SurfaceGrid3D As Grid

Public Function Run() As Number

    Dim Town As Document.State
    Dim Errand As Movement.State
    Dim People As Residents.State
    Dim Point As P.Vector3
    Dim Initial As P.Vector3
    Dim Forward As P.Vector3
    Dim Delta As P.Vector3
    Dim Target As P.Vector3
    Dim NpcPosition As P.Vector3
    Dim LeaderForward As P.Vector3
    Dim Index As Number
    Dim Failures As Number
    Dim Ok As Boolean

    If (Movement.AvoidsSpawn(P.Vector(-400.0, 0.0, -2780.0), P.Vector(400.0, 0.0, -2780.0)) Or
        Not Movement.AvoidsSpawn(P.Vector(-400.0, 0.0, -2450.0), P.Vector(400.0, 0.0, -2450.0))) Then
        Print "FAIL Resident Errands Keep Arin Spawn Clear"
        Failures = Failures + 1
    End If

    Ok = Document.Blank(Town, "Resident Roads", 20, 20, 20.0)

    Call Grid.PaintRectangle(Town.Surface, 0, 8, 19, 11, Grid.SURFACE_ROAD)
    Call Navigation.Rebuild(Town)

    Initial = P.Vector(Town.Surface.XEdges[10] + 10.0, 23.12, Town.Surface.ZEdges[10] + 10.0)

    Call Movement.Start(Errand, Initial, 0)

    For Index = 0 To 250

        Point = Errand.Position

        Call Movement.Update(Errand, False, 100)

        Delta = M.Subtract(Errand.Position, Point)

        If M.Length(Delta) > 0.001 Then

            Forward = M.Rotate(P.Vector(0.0, 0.0, -1.0), P.Vector(0.0, Errand.Heading, 0.0))

            If M.Dot(Forward, Delta) <= 0.0 Then
                Print "FAIL Resident Must Face The Direction Of Travel"
                Failures = Failures + 1
            End If

        End If

    End For

    If M.Distance(Errand.Position, Initial) < 10.0 Or Not Navigation.IsRoad(Errand.Position) Then
        Print "FAIL Resident Must Complete A Safe Road Errand"
        Failures = Failures + 1
    End If

    Point = Errand.Position

    For Index = 0 To 10
        Call Movement.Update(Errand, True, 100)
    End For

    If M.Distance(Point, Errand.Position) > 0.001 Then
        Print "FAIL Talking Must Pause Resident Movement"
        Failures = Failures + 1
    End If

    People.Enabled = True
    People.Loaded = 1
    People.Speaking = -1
    People.People[0].Ready = True
    NpcPosition = M.Add(Initial, P.Vector(90.0, 0.0, 0.0))
    People.People[0].Motion.Position = NpcPosition
    Ok = Interaction.Request(People, 0, Initial, Target)
    Ok = Travel.Begin(Town, Initial, Target, False, True) And Ok

    If (Not Ok Or
        Not People.ApproachActive Or
        M.Distance(Travel.Target(), Target) > 0.001) Then
        Print "FAIL Clicked Resident Uses A Precise Clear Approach"
        Failures = Failures + 1
    End If

    Point = Initial

    For Index = 0 To 500

        Call Interaction.Advance(People, Point, False)

        If People.Speaking = 0 Then
            Exit For
        End If

        Delta = Travel.Direction(Town, Point, 8.0, 100)
        Point = M.Add(Point, M.Scale(Delta, 8.0))
    End For

    If (People.Speaking <> 0 Or
        Travel.Active() Or
        M.Distance(Point, NpcPosition) > 30.0) Then
        Print "FAIL Clicked Resident Conversation Starts After Approaching"
        Failures = Failures + 1
    End If

    LeaderForward = M.Rotate(P.Vector(0.0, 0.0, -1.0),
        P.Vector(0.0, Movement.Facing(Point, NpcPosition), 0.0))
    Forward = M.Rotate(P.Vector(0.0, 0.0, -1.0),
        P.Vector(0.0, Movement.Facing(NpcPosition, Point), 0.0))

    If (M.Dot(LeaderForward, Forward) > -0.99 Or
        M.Dot(LeaderForward, M.Subtract(NpcPosition, Point)) <= 0.0) Then
        Print "FAIL Conversation Partners Face One Another"
        Failures = Failures + 1
    End If

    People.Speaking = -1
    Ok = Interaction.Request(People, 0, Initial, Target)

    Call Interaction.Advance(People, Initial, True)

    If People.ApproachActive Or People.Speaking >= 0 Then
        Print "FAIL Manual Movement Cancels Pending Conversation"
        Failures = Failures + 1
    End If

    Call Grid.PaintRectangle(Town.Surface, 9, 8, 9, 11, Grid.SURFACE_WATER)
    Call Navigation.Rebuild(Town)

    Point = Initial
    Point.X = Town.Surface.XEdges[8] + 10.0

    If Movement.ClearRoad(Initial, Point) Then
        Print "FAIL Resident Cannot Cross A Water Gap"
        Failures = Failures + 1
    End If

    People.Enabled = True
    People.Nearest = 2
    People.Speaking = -1
    Ok = Residents.Input(People, KEY_E)

    If (Not Ok Or
        Not Residents.Talking(People) Or
        Dialogue.Greeting(2) <> "Hi, my name is Ilan.") Then
        Print "FAIL Nearest Resident Greeting"
        Failures = Failures + 1
    End If

    Ok = Residents.Input(People, KEY_ESCAPE)

    If Not Ok Or Residents.Talking(People) Then
        Print "FAIL Conversation Must Close"
        Failures = Failures + 1
    End If

    Return Failures

End Function

End Module
