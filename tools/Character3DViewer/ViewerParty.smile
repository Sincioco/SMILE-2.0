    EstablishRemaining As Number
    Enabled As Boolean
    Ready As Boolean
    Companion As ViewerActors.Context
    Third As ViewerActors.Context
    Fourth As ViewerActors.Context
    Mira As ViewerActors.Context
    MiraLayout As ParticipantLayout
    Water As MiraWater.Context
    ThirdEffects As ViewerEffects.State
    FourthEffects As ViewerEffects.State
    ThirdLayout As ParticipantLayout
    FourthLayout As ParticipantLayout
    UnityRoster As Boolean
    UnityRosterRequested As Boolean
    BossAttackDuration As Number
