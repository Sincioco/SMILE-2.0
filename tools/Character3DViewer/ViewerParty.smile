    ShotBossHead As Precision3D.Vector3
    ShotMouth As Precision3D.Vector3
End Type

Public Sub SetEnabled(ByRef Value As State, Enabled As Boolean)

    Value.Enabled = Enabled

End Sub

Public Sub SelectUnityRoster(ByRef Value As State, Selected As Boolean)

    Value.UnityRosterRequested = Selected And ViewerProfiles.INCLUDE_UNITY_CHARACTERS
    Value.UnityRoster = Value.UnityRosterRequested

End Sub

Public Sub ResetCameraTracking(ByRef Value As State)

    Value.PreviousCamera = 0
    Value.OrbitPhase = 0.0

End Sub

Public Sub CycleDragonInspectionTarget(ByRef Value As State)

    If Not Value.Enabled Then
        Value.DragonCounter = (Value.DragonCounter + 1) Mod 2
    End If

End Sub

Public Sub PromoteCompanionToDragonOpponent(ByRef Value As State)

    Value.DragonOpponent = Value.Companion

End Sub

Public Type FrameActions
    FirstClip As Text
    SecondClip As Text
    ThirdClip As Text
    FourthClip As Text
    MiraClip As Text
    MiraClipRequested As Boolean
    ThirdClipRequested As Boolean
    FourthClipRequested As Boolean
    FirstClipRequested As Boolean
    SecondClipRequested As Boolean
    PositionsAvailable As Boolean
    FirstPosition As Precision3D.Vector3
    SecondPosition As Precision3D.Vector3
    ThirdPosition As Precision3D.Vector3
    FourthPosition As Precision3D.Vector3
End Type

Public Type PointerDecision
    Consumed As Boolean
    Action As Number
End Type

Public Type PointerResponse
    ResetView As Boolean
    ResetInspector As Boolean
    SpeedDelta As Number
    SpeedTurn As Number
    TogglePause As Boolean
End Type

Public Type ParticipantUpdateResult
    Updated As Boolean
    Ready As Boolean
    FailureStage As Number
End Type

Public Type InspectorBindingResult
    Bound As Boolean
    Context As ViewerActors.Context
End Type

Public Sub ResetChoreography(ByRef Value As State)

    Value.Elapsed = 0
    Value.Turn = 2
    Value.AttackCycle = 0
    Value.DragonOnlyTurn = True
    Value.PreviousShotStage = -1
    Value.FatalTarget = -1
    Value.FatalStarted = False
    Value.HitTarget = -1
    Value.HitResolved = False
    Value.Stage = -1
    Value.DragonCounter = 0
    Value.DragonReactionPending = False

    Call SetPresentationState(Value, MiraBattle.PARTY_TURN, STATE_ALIVE)
    Call SetPresentationState(Value, 0, STATE_ALIVE)
    Call SetPresentationState(Value, 1, STATE_ALIVE)

End Sub

Public Sub InitializeFormation(ByRef Value As State, Center As Core.Vector3,
    Radius As Number, StartAngle As Number, EndAngle As Number,
    FirstApproach As Core.Vector3, SecondApproach As Core.Vector3,
    SecondFacingAdjustment As Number)

    Dim ZaraIndex As Number

    ZaraIndex = 2
    Value.ParticipantCount = LIVE_PARTICIPANT_COUNT

    If Value.UnityRoster Then

        Value.ParticipantCount = 3

        If PARTY_VALOR_VISIBLE Then
            Value.ParticipantCount = 4
            ZaraIndex = 3
        End If

    End If

    If Value.Mira.Ready Then
        Value.ParticipantCount = Value.ParticipantCount + 1
    End If

    Value.MiraLayout.Home = BattleCamera.FormationPosition(Center, Radius,
        StartAngle, EndAngle, Value.ParticipantCount - 1, Value.ParticipantCount)
    Value.MiraLayout.Approach = Value.MiraLayout.Home
    Value.First.Home = BattleCamera.FormationPosition(Center, Radius,
        StartAngle, EndAngle, 0, Value.ParticipantCount)
    Value.Second.Home = BattleCamera.FormationPosition(Center, Radius,
        StartAngle, EndAngle, 1, Value.ParticipantCount)

    If Value.UnityRoster Then

        Value.ThirdLayout.Home = BattleCamera.FormationPosition(Center, Radius,
            StartAngle, EndAngle, 2, Value.ParticipantCount)
        Value.FourthLayout.Home = BattleCamera.FormationPosition(Center, Radius,
            StartAngle, EndAngle, ZaraIndex, Value.ParticipantCount)
        Value.ThirdLayout.Approach = FirstApproach
        Value.FourthLayout.Approach = SecondApproach

        If Not PARTY_VALOR_VISIBLE Then
            ''' Zara's compact stance needs a shorter gap beside Orin's broad shield stance.
            Value.FourthLayout.Home.X = (Value.Second.Home.X +
                (Value.FourthLayout.Home.X - Value.Second.Home.X) * 80 / 100)
            Value.FourthLayout.Home.Z = (Value.Second.Home.Z +
                (Value.FourthLayout.Home.Z - Value.Second.Home.Z) * 80 / 100)
        End If

    End If

    Value.First.Approach = FirstApproach
    Value.Second.Approach = SecondApproach
    Value.First.FacingAdjustment = 0
    Value.Second.FacingAdjustment = SecondFacingAdjustment

End Sub

Public Function ResetDemo(ByRef Value As State, Center As Core.Vector3,
    Radius As Number, StartAngle As Number, EndAngle As Number,
    FirstApproach As Core.Vector3, SecondApproach As Core.Vector3,
    SecondFacingAdjustment As Number,
    SwordVisible As Boolean, ShieldVisible As Boolean) As Boolean

    Dim Result As Boolean
    Dim RolledTarget As Number

    Call ResetChoreography(Value)
    Call InitializeFormation(
        Value, Center, Radius, StartAngle, EndAngle,
        FirstApproach, SecondApproach, SecondFacingAdjustment)

    Value.EstablishRemaining = 0

    If Value.UnityRoster Then
        Value.EstablishRemaining = ESTABLISH_TOTAL_MILLISECONDS
        Value.OrbitPhase = 0.0
    End If

    Random RolledTarget From -1 To Max(1, Value.ParticipantCount - 1)

    Call PrepareDragonTurn(Value, RolledTarget)

    Result = True

    If Value.Ready Then
        Result = Character3D.SetPartVisible(
            Value.Companion.Actor, WEAPON_PART_INDEX, SwordVisible)
        Result = Character3D.SetPartVisible(
            Value.Companion.Actor, SHIELD_PART_INDEX, ShieldVisible) And Result
    End If

    Return Result

End Function

Public Function ApplyEquipmentVisibility(ByRef Value As State,
    ByRef PrimaryActor As Character3D.Actor, CalibrationAvailable As Boolean,
    DragonInspection As Boolean, PartIndex As Number,
    Visible As Boolean, Optional ProfileIndex As Number = -1) As Boolean

    Dim Result As Boolean

    Result = True

    If DragonInspection Then

        Result = Character3D.SetPartVisible(
            Value.DragonOpponent.Actor, PartIndex, Visible)
        Result = Character3D.SetPartVisible(
            Value.Companion.Actor, PartIndex, Visible) And Result

        Return Result

    End If

    If Not CalibrationAvailable And Not ViewerProfiles.IsEquipmentCharacter(ProfileIndex) Then
        Return Result
    End If

    Result = ApplyProfileEquipmentPart(PrimaryActor, ProfileIndex, PartIndex, Visible)

    If Value.Enabled And Value.Ready Then

        Result = Character3D.SetPartVisible(
            Value.Companion.Actor, PartIndex, Visible) And Result

        If Value.Mira.Ready Then
            Result = ApplyProfileEquipmentPart(Value.Mira.Actor,
                Value.Mira.Profile, PartIndex, Visible) And Result
        End If

        If Value.UnityRoster Then
            Result = ApplyProfileEquipmentPart(Value.Third.Actor,
                Value.Third.Profile, PartIndex, Visible) And Result
            Result = ApplyProfileEquipmentPart(Value.Fourth.Actor,
                Value.Fourth.Profile, PartIndex, Visible) And Result
        End If

    End If

    Return Result

End Function

Private Function ApplyProfileEquipmentPart(ByRef Actor As Character3D.Actor,
    ProfileIndex As Number, PartIndex As Number, Visible As Boolean) As Boolean

    Dim Result As Boolean
    Dim ActualPart As Number

    ActualPart = ViewerProfiles.WeaponPart(ProfileIndex)

    If PartIndex = SHIELD_PART_INDEX Then
        ActualPart = ViewerProfiles.ShieldPart(ProfileIndex)
    End If

    If ActualPart < 0 Then
        Return True
    End If

    Result = Character3D.SetPartVisible(Actor, ActualPart, Visible)

    Return Result

End Function

Public Sub ToggleDragonInspectionGlow(ByRef Value As State)

    Value.DragonOpponent.GlowVisible = Not Value.DragonOpponent.GlowVisible
    Value.Companion.GlowVisible = Value.DragonOpponent.GlowVisible

End Sub

Public Function HomePosition(ByRef Value As State, MemberIndex As Number) As Core.Vector3

    Dim Result As Core.Vector3

    Result = Value.First.Home

    If MemberIndex = 1 Then
        Result = Value.Second.Home
    Else If MemberIndex = 4 Then
        Result = Value.ThirdLayout.Home
    Else If MemberIndex = 5 Then
        Result = Value.FourthLayout.Home
    Else If MemberIndex = MiraBattle.PARTY_TURN Then
        Result = Value.MiraLayout.Home
    End If

    Return Result

End Function

Public Function PresentationState(ByRef Value As State, MemberIndex As Number) As Number

    Dim Result As Number

    Result = Value.PrimaryPresentationState

    If Value.UiBound Then
        Result = Value.UiPrimary.PresentationState
    End If

    If MemberIndex = 1 Then
        Result = Value.Companion.PresentationState
    Else If MemberIndex = 4 Then
        Result = Value.Third.PresentationState
    Else If MemberIndex = 5 Then
        Result = Value.Fourth.PresentationState
    Else If MemberIndex = MiraBattle.PARTY_TURN Then
        Result = Value.Mira.PresentationState
    End If

    Return Result

End Function

Public Sub SetPresentationState(ByRef Value As State, MemberIndex As Number,
    Presentation As Number)

    If MemberIndex = 1 Then
        Value.Companion.PresentationState = Presentation
    Else If MemberIndex = 4 Then
        Value.Third.PresentationState = Presentation
    Else If MemberIndex = 5 Then
        Value.Fourth.PresentationState = Presentation
    Else If MemberIndex = MiraBattle.PARTY_TURN Then
        Value.Mira.PresentationState = Presentation
    Else
        Value.PrimaryPresentationState = Presentation
    End If

End Sub

Public Function PresentationStateName(Presentation As Number) As Text

    If Presentation = STATE_ACTING Then
        Return "Acting"
    Else If Presentation = STATE_GUARDING Then
        Return "Guarding"
    Else If Presentation = STATE_HIT Then
        Return "Hit"
    Else If Presentation = STATE_KO Then
        Return "KO"
    Else If Presentation = STATE_REVIVING Then
        Return "Reviving"
    End If

    Return "Alive"

End Function

Public Function BeginInspectorBinding(ByRef Value As State, Primary As ViewerActors.Context,
    Turn As Number) As Boolean

    If Value.UiBound Then
        Return False
    End If

    Value.UiPrimary = Primary
    Value.UiTurn = Turn
    Value.UiBound = True

    Return True

End Function

Public Sub EndInspectorBinding(ByRef Value As State)

    Value.UiBound = False

End Sub

Public Function BeginInspectorSelection(ByRef Value As State,
    Primary As ViewerActors.Context, PartyTurn As Number,
    ByRef Dragon As ViewerDragon.State,
    ViewerError As Boolean) As InspectorBindingResult

    Dim Index As Number
    Dim Result As InspectorBindingResult

    Result.Context = Primary

    If (Not Value.Enabled Or
        Not Value.Ready Or
        ViewerError Or
        Value.UiBound) Then
        Return Result
    End If

    Result.Bound = BeginInspectorBinding(Value, Primary, PartyTurn)

    If Not Result.Bound Then
        Return Result
    End If

    If Value.UiTurn = 1 Then

        Result.Context = Value.Companion

    Else If Value.UiTurn = 4 Then

        Result.Context = Value.Third

    Else If Value.UiTurn = 5 Then

        Result.Context = Value.Fourth

    Else If Value.UiTurn = MiraBattle.PARTY_TURN Then

        Result.Context = Value.Mira

    Else If Value.UiTurn = 2 Then

        Result.Context.Actor = Dragon.Actor
        Result.Context.Profile = ViewerProfiles.PROFILE_DRAGON

        If Dragon.UseVrax Then
            Result.Context.Profile = ViewerProfiles.PROFILE_VRAX
        End If

        Result.Context.CalibrationAvailable = False
        Result.Context.GlowAvailable = False
        Result.Context.WeaponWrist = -1
        Result.Context.ShieldWrist = -1
        Result.Context.Clip = 0
        Result.Context.Ready = Character3D.IsValid(Dragon.Actor)

        For Index = 0 To Character3D.ClipCount(Dragon.Actor) - 1

            If Character3D.ClipName(Dragon.Actor, Index) = Dragon.Clip Then
                Result.Context.Clip = Index
            End If

        End For

    End If

    Return Result

End Function

Public Function EndInspectorSelection(ByRef Value As State,
    Current As ViewerActors.Context,
    ByRef Dragon As ViewerDragon.State) As ViewerActors.Context

    Dim Result As ViewerActors.Context

    Result = Current

    If Not Value.UiBound Then
        Return Result
    End If

    If Value.UiTurn = 1 Then
        Value.Companion = Current
    Else If Value.UiTurn = 4 Then
        Value.Third = Current
    Else If Value.UiTurn = 5 Then
        Value.Fourth = Current
    Else If Value.UiTurn = MiraBattle.PARTY_TURN Then
        Value.Mira = Current
    Else If Value.UiTurn = 2 Then
        Call ViewerDragon.CaptureInspectedActor(
            Dragon,
            Current.Actor,
            Character3D.ClipName(Current.Actor, Current.Clip)
        )
    End If

    Result = Value.UiPrimary

    Call EndInspectorBinding(Value)

    Return Result

End Function

Public Sub CapturePreview(ByRef Value As State, Clip As Number, Time As Number,
    Mode As Number)

    If Value.PreviewActive Then
        Return
    End If

    Value.PreviewClip = Clip
    Value.PreviewTime = Time
    Value.PreviewMode = Mode
    Value.PreviewActive = True

End Sub

Public Function ResolvePreviewMode(UiTurn As Number, ProfileIndex As Number,
    Name As Text) As Number

    Dim Result As Number

    Result = Graphics3D.ANIMATION_LOOP

    If ((UiTurn = 2 And Name <> "Idle") Or
        Name = "SwordAttack" Or
        Name = "SwordAttack2" Or
        Name = "JumpAttack" Or
        Name = "ThorAttack" Or
        Name = "Hit" Or
        ViewerProfiles.HoldsFinalPose(ProfileIndex, Name)) Then
        Result = Graphics3D.ANIMATION_ONCE
    End If

    Return Result

End Function

Public Sub BeginPreview(ByRef Value As State, ByRef Actor As Character3D.Actor,
    Clip As Number, ProfileIndex As Number)

    Dim Mode As Number
    Dim Name As Text

    If Not Value.UiBound Or Value.PreviewActive Then
        Return
    End If

    Name = Character3D.ClipName(Actor, Clip)
    Mode = ResolvePreviewMode(Value.UiTurn, ProfileIndex, Name)

    Call CapturePreview(Value, Clip, Character3D.AnimationTime(Actor), Mode)

End Sub

Public Sub BeginPreviewSession(ByRef Value As State,
    ByRef Actor As Character3D.Actor, ByRef Playback As ViewerPlayback.State,
    ProfileIndex As Number)

    If Not Value.UiBound Then
        Return
    End If

    Call BeginPreview(Value, Actor, Playback.SelectedClip, ProfileIndex)
    Call ViewerPlayback.PauseForPartyPreview(Playback)

End Sub

Public Function RestorePreview(ByRef Value As State,
    ByRef Actor As Character3D.Actor, ByRef Clip As Number,
    PlaybackSpeed As Number) As Boolean

    Dim Name As Text
    Dim Result As Boolean

    If Not Value.PreviewActive Or Not Value.UiBound Then
        Return True
    End If

    Clip = Value.PreviewClip
    Name = Character3D.ClipName(Actor, Clip)
    Result = Character3D.PlayMode(Actor, Name, Value.PreviewMode, PlaybackSpeed)
    Result = Character3D.SetAnimationTime(Actor, Value.PreviewTime) And Result

    Call ClearPreview(Value)

    Return Result

End Function

Public Sub ClearPreview(ByRef Value As State)

    Value.PreviewActive = False

End Sub

Public Sub PrepareDragonTurn(ByRef Value As State, RolledTarget As Number)

    Value.FatalTarget = RolledTarget
    Value.FatalStarted = False
    Value.HitResolved = False
    Value.HitTarget = Value.FatalTarget

    If Value.HitTarget < 0 Then
        Value.HitTarget = Value.DragonCounter Mod Max(1, Value.ParticipantCount)
    End If

    If Value.Mira.Ready Then

        If Value.HitTarget = 2 Then
            Value.HitTarget = MiraBattle.PARTY_TURN
        End If

        If Value.FatalTarget = 2 Then
            Value.FatalTarget = MiraBattle.PARTY_TURN
        End If

    End If

End Sub

Public Function AdvanceElapsed(ByRef Value As State, Elapsed As Number,
    DemoEnabled As Boolean, ScenePaused As Boolean) As Boolean

    If Not Value.Ready Or ScenePaused Then
        Return False
    End If

    If DemoEnabled Then
        Value.Elapsed = Value.Elapsed + Elapsed
    End If

    Return True

End Function

Public Function FormationPosition(Center As Core.Vector3, Radius As Number,
    StartAngle As Number, EndAngle As Number, MemberIndex As Number,
    MemberCount As Number) As Core.Vector3

    Dim Result As Core.Vector3

    Result = BattleCamera.FormationPosition(Center, Radius, StartAngle,
        EndAngle, MemberIndex, MemberCount)

    Return Result

End Function

Public Function AttackDuration(ByRef Value As State,
    Primary As Character3D.Actor, Companion As Character3D.Actor,
    PlaybackSpeed As Number) As Number

    Dim ReturnValue As Number

    Dim Actor As Character3D.Actor
    Dim Index As Number
    Dim Name As Text
    Dim Result As Number

    Actor = Primary
    Name = ViewerProfiles.PartyAttackName(ViewerProfiles.PROFILE_ARIN,
        Value.AttackCycle)

    If Value.Turn = 1 Then
        Actor = Companion
        Name = ViewerProfiles.PartyAttackName(ViewerProfiles.PROFILE_ORIN,
            Value.AttackCycle)
    End If

    If Value.UnityRoster Then

        If Value.Turn = 4 Then
            Actor = Value.Third.Actor
            Name = UnityAttackName(Value)
        Else If Value.Turn = 5 Then
            Actor = Value.Fourth.Actor
            Name = UnityAttackName(Value)
        Else If Value.Turn = 2 Then
            ReturnValue = Value.BossAttackDuration

            Return ReturnValue
        End If

    End If

    If Value.Turn = MiraBattle.PARTY_TURN Then
        Actor = Value.Mira.Actor
        Name = MiraBattle.ClipForCycle(Value.AttackCycle)
    End If

    Result = 1200

    For Index = 0 To Character3D.ClipCount(Actor) - 1

        If Character3D.ClipName(Actor, Index) = Name Then
            Result = (Character3D.ClipDuration(Actor, Index) * 100 /
                Max(25, ActorPlaybackSpeed(Value, Value.Turn, PlaybackSpeed)))
            Exit For
        End If

    End For

    Return Result

End Function

Public Function PlayClip(ByRef Actor As Character3D.Actor, Name As Text,
    ByRef Clip As Number, CompanionActorHandle As Number,
    CompanionProfile As Number, PlaybackSpeed As Number) As Boolean

    Dim HoldFinalPose As Boolean
    Dim Index As Number
    Dim Mode As Number
    Dim Result As Boolean

    Mode = Graphics3D.ANIMATION_LOOP
    HoldFinalPose = (Actor.Handle = CompanionActorHandle And
        ViewerProfiles.HoldsFinalPose(CompanionProfile, Name))
    HoldFinalPose = HoldFinalPose Or Name = "Death"

    If (Name = "SwordAttack" Or
        Name = "SwordAttack2" Or
        Name = "JumpAttack" Or
        Name = "ThorAttack" Or
        Name = "Hit" Or
        Name = "Attack" Or
        Name = "HealOne" Or
        Name = "HealParty" Or
        HoldFinalPose) Then
        Mode = Graphics3D.ANIMATION_ONCE
    End If

    Result = False

    For Index = 0 To Character3D.ClipCount(Actor) - 1

        If Character3D.ClipName(Actor, Index) = Name Then

            If HoldFinalPose And Clip = Index Then
                Return True
            End If

            Clip = Index
            Result = Character3D.PlayMode(Actor, Name, Mode, PlaybackSpeed)
            Exit For

        End If

    End For

    Return Result

End Function

Public Function ApplyFrame(ByRef Value As State, Actions As FrameActions,
    ByRef FirstActor As Character3D.Actor,
    ByRef FirstFrame As PrecisionCamera.Framing,
    ByRef FirstClip As Number, PlaybackSpeed As Number,
    TargetX As Number, TargetY As Number, TargetZ As Number,
    ModelForwardYawOffset As Number) As Boolean

    Dim Result As Boolean

    Result = True

    If Actions.FirstClipRequested Then
        Result = PlayClip(FirstActor, Actions.FirstClip, FirstClip,
            Value.Companion.Actor.Handle, Value.Companion.Profile,
            ActorPlaybackSpeed(Value, 0, PlaybackSpeed))
    End If

    If Actions.SecondClipRequested Then
        Result = PlayClip(Value.Companion.Actor, Actions.SecondClip,
            Value.Companion.Clip, Value.Companion.Actor.Handle,
            Value.Companion.Profile, ActorPlaybackSpeed(Value, 1, PlaybackSpeed)) And Result
    End If

    If Value.UnityRoster Then

        If Actions.ThirdClipRequested Then
            Result = PlayClip(Value.Third.Actor, Actions.ThirdClip, Value.Third.Clip,
                Value.Third.Actor.Handle, Value.Third.Profile,
                ActorPlaybackSpeed(Value, 4, PlaybackSpeed)) And Result
        End If

        If Actions.FourthClipRequested Then
            Result = PlayClip(Value.Fourth.Actor, Actions.FourthClip, Value.Fourth.Clip,
                Value.Fourth.Actor.Handle, Value.Fourth.Profile,
                ActorPlaybackSpeed(Value, 5, PlaybackSpeed)) And Result
        End If

    End If

    If Value.Mira.Ready And Actions.MiraClipRequested Then
        Result = PlayClip(Value.Mira.Actor, Actions.MiraClip, Value.Mira.Clip,
            Value.Mira.Actor.Handle, Value.Mira.Profile,
            ActorPlaybackSpeed(Value, MiraBattle.PARTY_TURN, PlaybackSpeed)) And Result
    End If

    If Not Actions.PositionsAvailable Then
        Return Result
    End If

    If Value.Mira.Ready Then

        Result = PlaceUnityMember(Value.Mira, Precision3D.FromVector(Value.MiraLayout.Home),
            TargetX, TargetY, TargetZ, ModelForwardYawOffset) And Result

        If Value.Turn = MiraBattle.PARTY_TURN And Value.AttackCycle Mod 3 <> 0 Then
            Result = ViewerActors.FaceToward(Value.Mira.Actor, Value.First.Home.X,
                Value.First.Home.Y, Value.First.Home.Z, ModelForwardYawOffset, 0) And Result
        End If

    End If

    FirstFrame.PositionX = Actions.FirstPosition.X
    FirstFrame.PositionZ = Actions.FirstPosition.Z
    Value.Companion.Frame.PositionX = Actions.SecondPosition.X
    Value.Companion.Frame.PositionZ = Actions.SecondPosition.Z
    Result = Character3D.PlacePrecise(FirstActor, FirstFrame.PositionX,
        FirstFrame.PositionY, FirstFrame.PositionZ) And Result
    Result = Character3D.PlacePrecise(Value.Companion.Actor,
        Value.Companion.Frame.PositionX, Value.Companion.Frame.PositionY,
        Value.Companion.Frame.PositionZ) And Result
    Result = ViewerActors.FaceToward(FirstActor, TargetX, TargetY, TargetZ,
        ModelForwardYawOffset, Value.First.FacingAdjustment) And Result
    Result = ViewerActors.FaceToward(Value.Companion.Actor,
        TargetX, TargetY, TargetZ, ModelForwardYawOffset,
        Value.Second.FacingAdjustment) And Result

    If Value.UnityRoster Then
        Result = PlaceUnityMember(Value.Third, Actions.ThirdPosition,
            TargetX, TargetY, TargetZ, ModelForwardYawOffset) And Result
        Result = PlaceUnityMember(Value.Fourth, Actions.FourthPosition,
            TargetX, TargetY, TargetZ, ModelForwardYawOffset) And Result
    End If

    Return Result

End Function

Public Function CreateCompanion(ByRef Value As State,
    ByRef Calibration As ViewerCalibration.State,
    ByRef Effects As ViewerEffects.State,
    ProfileIndex As Number, KeyBase As Number,
    PlaybackSpeed As Number) As Boolean

    Dim Companion As ViewerActors.Context
    Dim Configuration As ViewerCalibration.ConfigurationResult
    Dim EmptyObject As Core.Object3D
    Dim PreviousGlowAvailable As Boolean
    Dim PreviousGlowVisible As Boolean
    Dim PreviousKeyBase As Number
    Dim PreviousShieldGlow As Core.Object3D
    Dim PreviousSwordGlow As Core.Object3D
    Dim PlaybackReady As Boolean
    Dim Result As Boolean

    PreviousKeyBase = Calibration.KeyBase
    PreviousSwordGlow = Effects.SwordGlow
    PreviousShieldGlow = Effects.ShieldGlow
    PreviousGlowAvailable = Effects.EpicGlowAvailable
    PreviousGlowVisible = Effects.EpicGlowVisible
    Companion = ViewerActors.LoadContext(ProfileIndex, KeyBase)
    Value.Ready = Companion.Ready
    PlaybackReady = True

    If Companion.Ready Then

        Configuration = ViewerCalibration.ConfigureForActor(
            Calibration, ProfileIndex, KeyBase, Companion.Actor)
        Companion.CalibrationAvailable = Configuration.Available
        Companion.WeaponWrist = Configuration.SwordWristNode
        Companion.ShieldWrist = Configuration.ShieldWristNode
        Value.Ready = (Configuration.Available And
            Not Calibration.StorageRejected And Value.Ready)

        If Effects.EpicGlowMaterial.Handle = 0 Then

            Effects.SwordGlow = EmptyObject
            Effects.ShieldGlow = EmptyObject
            Effects.EpicGlowAvailable = False
            Effects.EpicGlowVisible = False

            Call ViewerEffects.CreateEpicGlow(
                Effects, ProfileIndex, Companion.Actor)

            Companion.WeaponGlow = Effects.SwordGlow
            Companion.ShieldGlow = Effects.ShieldGlow
            Companion.GlowAvailable = Effects.EpicGlowAvailable
            Companion.GlowVisible = Effects.EpicGlowVisible

        Else

            Companion.GlowAvailable = ViewerEffects.CreateBorrowedEpicGlow(
                Companion.Actor,
                Effects.EpicGlowMaterial,
                Companion.WeaponGlow,
                Companion.ShieldGlow,
                ViewerProfiles.EquipmentGlowStyle(ProfileIndex)
            )
            Companion.GlowVisible = Companion.GlowAvailable

        End If

        PlaybackReady = PlayClip(
            Companion.Actor,
            "Idle",
            Companion.Clip,
            Companion.Actor.Handle,
            ProfileIndex,
            PlaybackSpeed
        )

        Value.Companion = Companion
        Value.Companion.Ready = Value.Ready

    End If

    Calibration.KeyBase = PreviousKeyBase
    Effects.SwordGlow = PreviousSwordGlow
    Effects.ShieldGlow = PreviousShieldGlow
    Effects.EpicGlowAvailable = PreviousGlowAvailable
    Effects.EpicGlowVisible = PreviousGlowVisible
    Result = Companion.Ready And Value.Ready And PlaybackReady

    Return Result

End Function

Public Function UpdateCompanion(ByRef Value As State,
    ByRef Calibration As ViewerCalibration.State,
    ByRef Effects As ViewerEffects.State, AnimationElapsed As Number,
    CalibrationEditing As Boolean) As ParticipantUpdateResult

    Dim Application As ViewerCalibration.ApplicationResult
    Dim CompanionReady As Boolean
    Dim PreviousKeyBase As Number
    Dim Result As ParticipantUpdateResult

    Result.Ready = True

    If Not Value.Ready Then
        Return Result
    End If

    Result.Updated = True
    CompanionReady = ViewerActors.Update(Value.Companion, AnimationElapsed)
    Result.Ready = CompanionReady
    PreviousKeyBase = Calibration.KeyBase
    Calibration.KeyBase = Value.Companion.KeyBase
    Result.Ready = ViewerActors.ApplyPresentationOffset(
        Value.Companion.Actor,
        Value.Companion.Profile,
        Value.Companion.Clip,
        Value.Companion.Frame
    ) And Result.Ready

    If Value.Companion.CalibrationAvailable Then
        Call ViewerCalibration.Evaluate(
            Calibration,
            Value.Companion.Actor,
            Value.Companion.Clip,
            ViewerCalibration.CurrentAnimationFrame(
                Value.Companion.Actor, Value.Companion.Clip),
            CalibrationEditing And
                Calibration.OwnerProfile = Value.Companion.Profile
        )
    End If

    Result.Ready = ViewerCalibration.ApplyWristOffsets(
        Calibration,
        Value.Companion.Actor,
        Value.Companion.Clip,
        Value.Companion.WeaponWrist,
        Value.Companion.ShieldWrist,
        Value.Companion.CalibrationAvailable
    ) And Result.Ready
    Result.Ready = ViewerCalibration.ApplyEquipmentCoupling(
        Calibration,
        Value.Companion.Actor,
        Value.Companion.Clip,
        Value.Companion.WeaponGlow,
        Value.Companion.ShieldGlow,
        Value.Companion.GlowAvailable
    ) And Result.Ready

    If Value.Companion.GlowAvailable Then
        Result.Ready = ViewerEffects.UpdateBorrowedEpicGlow(
            Value.Companion.Actor,
            Value.Companion.WeaponGlow,
            Value.Companion.ShieldGlow,
            Value.Companion.Frame.ScalePercent,
            ViewerCalibration.ChannelValue(
                Calibration, Value.Companion.Clip, 18) <> 0,
            ViewerCalibration.ChannelValue(
                Calibration, Value.Companion.Clip, 19) <> 0,
            ViewerProfiles.EquipmentGlowStyle(Value.Companion.Profile),
            ViewerEffects.Intensity(Effects, Value.Companion.Profile, False),
            ViewerEffects.Intensity(Effects, Value.Companion.Profile, True)
        ) And Result.Ready
    End If

    Application = ViewerCalibration.ApplyEquipmentTransforms(
        Calibration,
        Value.Companion.Actor,
        Value.Companion.Clip,
        Value.Companion.WeaponGlow,
        Value.Companion.ShieldGlow,
        Value.Companion.GlowAvailable,
        Value.Companion.GlowVisible
    )
    Result.Ready = Application.Ready And Result.Ready

    If Not Result.Ready Then

        Result.FailureStage = Application.FailureStage

        If Result.FailureStage = 0 Then
            Result.FailureStage = 71
        End If

    End If

    Calibration.KeyBase = PreviousKeyBase
    Value.Companion.Ready = CompanionReady
    Value.Ready = CompanionReady

    If Value.Mira.Ready Then
        Result.Ready = UpdateUnityMember(Value.Mira, AnimationElapsed) And Result.Ready
        Value.Ready = Result.Ready
    End If

    If Value.UnityRoster Then

        Result.Ready = UpdateUnityMember(Value.Third, AnimationElapsed) And Result.Ready
        Result.Ready = UpdateUnityMember(Value.Fourth, AnimationElapsed) And Result.Ready
        Value.Ready = Result.Ready

    End If

    Return Result

End Function

Public Function UpdateDragonOpponent(ByRef Value As State,
    ByRef Calibration As ViewerCalibration.State,
    ByRef Effects As ViewerEffects.State, AnimationElapsed As Number,
    CalibrationEditing As Boolean, SwordVisible As Boolean,
    ShieldVisible As Boolean, ScenePaused As Boolean,
    SelectedClipLabel As Text, Camera As Precision3D.Camera3D,
    CameraElapsed As Number) As ParticipantUpdateResult

    Dim Result As ParticipantUpdateResult
    Dim SavedCompanion As ViewerActors.Context

    SavedCompanion = Value.Companion
    Value.Companion = Value.DragonOpponent
    Result = UpdateCompanion(
        Value, Calibration, Effects, AnimationElapsed, CalibrationEditing)
    Value.DragonOpponent = Value.Companion
    Value.Companion = SavedCompanion

    Call ViewerEffects.UpdateEquipmentFire(
        Effects,
        Value.DragonOpponent.Actor,
        Value.DragonOpponent.Profile,
        False,
        SwordVisible,
        ShieldVisible,
        CalibrationEditing,
        ScenePaused,
        Value.DragonOpponent.Clip,
        SelectedClipLabel,
        Camera,
        CameraElapsed
    )

    Return Result

End Function

Public Sub UpdateOrinStorm(ByRef Value As State,
    ByRef Dragon As ViewerDragon.State, ByRef Effects As ViewerEffects.State,
    ByRef PrimaryActor As Character3D.Actor, PrimaryProfile As Number,
    PrimaryClip As Number, DragonInspection As Boolean,
    Camera As Precision3D.Camera3D, CameraElapsed As Number,
    SwordVisible As Boolean, ShieldVisible As Boolean,
    ScenePaused As Boolean)

    Dim ClipName As Text
    Dim GlowVisible As Boolean
    Dim Target As Precision3D.Vector3
    Dim Bounds As Character3D.PreciseBounds3D

    If Not ViewerDragon.IsValid(Dragon) Then
        Return
    End If

    If Not Character3D.TrySocketPositionPrecise(Dragon.Actor, "Chest", 0, False, Target) Then
        Bounds = Character3D.WorldBoundsPrecise(Dragon.Actor)
        Target = Bounds.Center
    End If

    If (Value.Enabled Or DragonInspection) And Value.Ready Then

        ClipName = Character3D.ClipName(
            Value.Companion.Actor, Value.Companion.Clip)
        GlowVisible = (Value.Companion.GlowVisible And
            (Effects.EpicGlowVisible Or DragonInspection) And
            PresentationState(Value, 1) <> STATE_KO)

        Call ViewerEffects.UpdateStorm(
            Effects, Value.Companion.Actor, ClipName, Target,
            Camera, CameraElapsed, GlowVisible,
            SwordVisible, ShieldVisible, ScenePaused)

    Else If PrimaryProfile = ViewerProfiles.PROFILE_ORIN Then

        ClipName = Character3D.ClipName(PrimaryActor, PrimaryClip)

        Call ViewerEffects.UpdateStorm(
            Effects, PrimaryActor, ClipName, Target,
            Camera, CameraElapsed, Effects.EpicGlowVisible,
            SwordVisible, ShieldVisible, ScenePaused)

    End If

End Sub

Public Function DragonReactionRequested(ByRef Value As State,
    AttackDurationMilliseconds As Number) As Boolean

    Dim Result As Boolean

    Result = (Value.Enabled And
        Value.DragonReactionPending And
        Value.Stage = 1 And
        Value.Elapsed >= 1300 + AttackDurationMilliseconds * 64 / 100)

    Return Result

End Function

Public Sub ConsumeDragonReaction(ByRef Value As State,
    Requested As Boolean, DragonClip As Text)

    If Requested And DragonClip = "Hit" Then
        Value.DragonReactionPending = False
    End If

End Sub

Public Function UpdateDragon(
    ByRef Value As State,
    ByRef Dragon As ViewerDragon.State,
    ByRef Effects As ViewerEffects.State,
    ByRef PrimaryActor As Character3D.Actor,
    Inspection As Boolean,
    SelectedClipName As Text,
    ScenePaused As Boolean,
    PlaybackSpeed As Number,
    AnimationElapsed As Number
) As Boolean

    Dim Name As Text
    Dim Target As Core.Vector3
    Dim ReactionRequested As Boolean
    Dim Result As Boolean

    If Not ViewerDragon.IsValid(Dragon) Then
        Call ViewerDragon.ClearOwnedEffects(Dragon, Effects.DragonLight)

        Return True
    End If

    If Not Dragon.Visible Then
        Call ViewerDragon.ClearOwnedEffects(Dragon, Effects.DragonLight)

        Return True
    End If

    If Value.UnityRoster Then

        Result = UpdateUnityBoss(Value, Dragon, PrimaryActor, PlaybackSpeed, AnimationElapsed)
        Target = HomePosition(Value, Value.HitTarget)

        Call ViewerDragon.UpdateVraxAttacks(Dragon.Attacks, Dragon.Actor, Dragon.Clip,
            Dragon.Visible, Effects.FireInitialized, Effects.LightningInitialized,
            Effects.FlamePaused, Effects.LightningPaused, Effects.VisualContinuityEpoch,
            Value.Turn = 2, ToDouble(Target.X), 65.0, ToDouble(Target.Z))

        Return Result

    End If

    ReactionRequested = DragonReactionRequested(
        Value,
        AttackDuration(
            Value,
            PrimaryActor,
            Value.Companion.Actor,
            PlaybackSpeed
        )
    )
    Name = ViewerDragon.DesiredClip(
        Dragon,
        Inspection,
        SelectedClipName,
        Value.Enabled,
        ScenePaused,
        Value.Turn,
        Value.DragonCounter,
        ReactionRequested
    )

    Call ConsumeDragonReaction(Value, ReactionRequested, Name)

    If Inspection Then

        Target = Character3D.SocketPosition(
            Value.DragonOpponent.Actor,
            "Chest",
            BODY_PART_INDEX
        )

        If Value.Ready And Value.DragonCounter Mod 2 = 1 Then
            Target = Character3D.SocketPosition(
                Value.Companion.Actor,
                "Chest",
                BODY_PART_INDEX
            )
        End If

    Else If Value.Enabled And Value.HitTarget = MiraBattle.PARTY_TURN Then

        Target = Character3D.SocketPosition(Value.Mira.Actor, "Chest", 0)

    Else If (Value.Enabled And
        Value.Ready And
        Value.HitTarget = 1) Then

        Target = Character3D.SocketPosition(
            Value.Companion.Actor,
            "Chest",
            BODY_PART_INDEX
        )

    Else
        Target = Character3D.SocketPosition(
            PrimaryActor,
            "Chest",
            BODY_PART_INDEX
        )

    End If

    Result = ViewerDragon.Update(
        Dragon,
        Name,
        Inspection,
        PlaybackSpeed,
        AnimationElapsed,
        Target,
        Effects.VisualContinuityEpoch,
        Effects.FlamePaused,
        Effects.FireInitialized,
        Effects.DragonLight
    )

    Return Result

End Function

Public Function PlaceDragonInspectionParticipants(ByRef Value As State,
    Center As Core.Vector3, Radius As Number, StartAngle As Number,
    EndAngle As Number, ModelForwardYawOffset As Number,
    CompanionYawAdjustment As Number) As Boolean

    Dim Home As Core.Vector3
    Dim Result As Boolean

    Home = FormationPosition(
        Center, Radius, StartAngle, EndAngle, 0, 2)
    Value.DragonOpponent.Frame.PositionX = ToDouble(Home.X)
    Value.DragonOpponent.Frame.PositionZ = ToDouble(Home.Z)
    Home = FormationPosition(
        Center, Radius, StartAngle, EndAngle, 1, 2)
    Value.Companion.Frame.PositionX = ToDouble(Home.X)
    Value.Companion.Frame.PositionZ = ToDouble(Home.Z)
    Result = Character3D.PlacePrecise(
        Value.DragonOpponent.Actor,
        Value.DragonOpponent.Frame.PositionX,
        Value.DragonOpponent.Frame.PositionY,
        Value.DragonOpponent.Frame.PositionZ
    )
    Result = Character3D.PlacePrecise(
        Value.Companion.Actor,
        Value.Companion.Frame.PositionX,
        Value.Companion.Frame.PositionY,
        Value.Companion.Frame.PositionZ
    ) And Result
    Result = ViewerActors.FaceToward(
        Value.DragonOpponent.Actor,
        Center.X,
        Center.Y,
        Center.Z,
        ModelForwardYawOffset,
        0
    ) And Result
    Result = ViewerActors.FaceToward(
        Value.Companion.Actor,
        Center.X,
        Center.Y,
        Center.Z,
        ModelForwardYawOffset,
        CompanionYawAdjustment
    ) And Result

    Return Result

End Function

Public Function DragonTurnDuration(ByRef Value As State,
    PlaybackSpeed As Number) As Number

    Dim Result As Number

    Result = 4500

    If Value.DragonCounter Mod 3 = 1 Then
        Result = 2800
    Else If Value.DragonCounter Mod 3 = 2 Then
        Result = 5400
    End If

    Result = Result * 100 / Max(25, PlaybackSpeed)

    Return Result

End Function

Public Function DragonTargetsPrimary(ByRef Value As State) As Boolean

    Dim Result As Boolean

    Result = Value.DragonCounter Mod 2 = 0

    If Value.Enabled Then
        Result = Value.HitTarget = 0
    End If

    Return Result

End Function

Public Function PresentationSecondsRemaining(ByRef Value As State,
    Primary As Character3D.Actor, Companion As Character3D.Actor,
    PlaybackSpeed As Number) As Number

    Dim RequiredMilliseconds As Number
    Dim RemainingMilliseconds As Number
    Dim Result As Number

    RequiredMilliseconds = AttackDuration(
        Value, Primary, Companion, PlaybackSpeed)

    If Value.UnityRoster Then

        If Value.Turn = 2 Then
            RequiredMilliseconds = RequiredMilliseconds + BOSS_TURN_TAIL_MILLISECONDS
        Else
            RequiredMilliseconds = RequiredMilliseconds + UNITY_HERO_TURN_TAIL_MILLISECONDS
        End If

    Else If Value.Turn = 2 Then

        RequiredMilliseconds = DragonTurnDuration(Value, PlaybackSpeed)

    Else
        RequiredMilliseconds = RequiredMilliseconds + PUBLIC_HERO_TURN_TAIL_MILLISECONDS

    End If

    RemainingMilliseconds = Max(0, RequiredMilliseconds - Value.Elapsed)
    Result = (RemainingMilliseconds + 999) / 1000

    Return Result

End Function

Public Function DragonImpactTime(ByRef Value As State) As Number

    If Value.DragonCounter Mod 3 = 2 Then
        Return 2500
    Else If Value.DragonCounter Mod 3 = 1 Then
        Return 1000
    End If

    Return 1200

End Function

Private Function EffectiveDragonTurnDuration(ByRef Value As State,
    PlaybackSpeed As Number) As Number

    Dim ImpactTime As Number
    Dim Result As Number

    Result = DragonTurnDuration(Value, PlaybackSpeed)
    ImpactTime = DragonImpactTime(Value)

    If Value.FatalTarget >= 0 Then
        Result = Max(Result, (ImpactTime + 4300) * 100 /
            Max(25, PlaybackSpeed))
    End If

    Return Result

End Function

Public Function WillPrepareDragonTurn(ByRef Value As State,
    Elapsed As Number, DemoEnabled As Boolean, ScenePaused As Boolean,
    AttackMilliseconds As Number, PlaybackSpeed As Number) As Boolean

    Dim NextElapsed As Number
    Dim Result As Boolean

    Result = False

    If Not Value.Ready Or ScenePaused Then
        Return False
    End If

    NextElapsed = Value.Elapsed

    If DemoEnabled Then
        NextElapsed = NextElapsed + Elapsed
    End If

    If Value.Turn = MiraBattle.PARTY_TURN Or (Value.Turn = 1 And Not Value.Mira.Ready) Then
        Result = NextElapsed >= AttackMilliseconds + PUBLIC_HERO_TURN_TAIL_MILLISECONDS
    Else If (Value.Turn = 2 And
        Not Value.DragonOnlyTurn And
        NextElapsed >= EffectiveDragonTurnDuration(Value, PlaybackSpeed)) Then
        Result = (Value.DragonCounter + 1) Mod 3 = 0
    End If

    Return Result

End Function

Private Sub SetPositions(ByRef Value As State, Progress As Double,
    ByRef Actions As FrameActions)

    Actions.FirstPosition = Precision3D.FromVector(Value.First.Home)
    Actions.SecondPosition = Precision3D.FromVector(Value.Second.Home)

    If Value.Turn = 0 Then
        Actions.FirstPosition = PreciseMath.Lerp(Actions.FirstPosition,
            Precision3D.FromVector(Value.First.Approach), Progress)
    Else If Value.Turn = 1 Then
        Actions.SecondPosition = PreciseMath.Lerp(Actions.SecondPosition,
            Precision3D.FromVector(Value.Second.Approach), Progress)
    End If

    Actions.PositionsAvailable = True

End Sub

Private Sub ApplyMiraSample(ByRef Value As State, AttackStart As Number,
    Duration As Number, ByRef Actions As FrameActions)

    Dim Sample As MiraBattle.Sample

    Sample = MiraBattle.Evaluate(Value.AttackCycle, Value.Elapsed, AttackStart, Duration)

    If Value.Stage <> Sample.Stage Then

        Actions.MiraClip = Sample.Clip
        Actions.MiraClipRequested = True
        Value.Stage = Sample.Stage
        Value.DragonReactionPending = Sample.Stage = 1 And Sample.Clip = "Attack"

        Call SetPresentationState(Value, MiraBattle.PARTY_TURN, STATE_ALIVE)

        If Sample.Stage = 1 Then
            Call SetPresentationState(Value, MiraBattle.PARTY_TURN, STATE_ACTING)
        End If

    End If

    If Sample.Heal And Not Value.HitResolved Then

        Value.HitResolved = True
        Actions.FirstClip = "Idle"
        Actions.FirstClipRequested = True

        Call SetPresentationState(Value, 0, STATE_REVIVING)

        If Sample.HealParty Then

            Actions.SecondClip = "Idle"
            Actions.SecondClipRequested = True
            Actions.FourthClip = "Idle"
            Actions.FourthClipRequested = Value.UnityRoster

            Call SetPresentationState(Value, 1, STATE_REVIVING)
            Call SetPresentationState(Value, 5, STATE_REVIVING)

        End If

    End If

End Sub

Private Function AdvanceDragonTurn(ByRef Value As State,
    PlaybackSpeed As Number, RolledTarget As Number) As FrameActions

    Dim ActionTime As Number
    Dim Actions As FrameActions
    Dim Duration As Number
    Dim ImpactTime As Number

    Duration = EffectiveDragonTurnDuration(Value, PlaybackSpeed)
    ActionTime = Value.Elapsed * PlaybackSpeed / 100
    ImpactTime = DragonImpactTime(Value)

    If Value.Elapsed >= Duration Then

        Value.Elapsed = 0
        Value.Stage = -1
        Value.DragonCounter = Value.DragonCounter + 1

        If Value.DragonOnlyTurn Then

            Value.DragonOnlyTurn = False
            Value.Turn = 0

        Else
            Value.AttackCycle = Value.AttackCycle + 1

            If Value.DragonCounter Mod 3 = 0 Then

                Value.DragonOnlyTurn = True
                Value.Turn = 2

                Call PrepareDragonTurn(Value, RolledTarget)

            Else
                Value.Turn = 0

            End If

        End If

        Return Actions

    End If

    If Value.Stage <> 0 Then

        If Value.Mira.Ready And Value.Mira.PresentationState <> STATE_KO Then

            Actions.MiraClip = "Defend"
            Actions.MiraClipRequested = True

            Call SetPresentationState(Value, MiraBattle.PARTY_TURN, STATE_GUARDING)

        End If

        If PresentationState(Value, 0) <> STATE_KO Then

            Call SetPresentationState(Value, 0, STATE_GUARDING)

            Actions.FirstClip = "Defend"
            Actions.FirstClipRequested = True

        End If

        If PresentationState(Value, 1) <> STATE_KO Then

            Call SetPresentationState(Value, 1, STATE_GUARDING)

            Actions.SecondClip = "Defend"
            Actions.SecondClipRequested = True

        End If

        Value.Stage = 0

    End If

    If ActionTime >= ImpactTime And Not Value.FatalStarted Then

        Value.FatalStarted = True

        Call SetPresentationState(Value, Value.HitTarget, STATE_HIT)

        If Value.HitTarget = 0 Then
            Actions.FirstClip = "Hit"
            Actions.FirstClipRequested = True
        Else If Value.HitTarget = MiraBattle.PARTY_TURN Then
            Actions.MiraClip = "Hit"
            Actions.MiraClipRequested = True
        Else
            Actions.SecondClip = "Hit"
            Actions.SecondClipRequested = True
        End If

    End If

    If (Value.FatalStarted And
        Not Value.HitResolved And
        ActionTime >= ImpactTime + 350) Then

        Value.HitResolved = True

        If Value.FatalTarget >= 0 Then

            Call SetPresentationState(Value, Value.FatalTarget, STATE_KO)

            If Value.FatalTarget = 0 Then
                Actions.FirstClip = "Death"
                Actions.FirstClipRequested = True
            Else If Value.FatalTarget = MiraBattle.PARTY_TURN Then
                Actions.MiraClip = "Death"
                Actions.MiraClipRequested = True
            Else
                Actions.SecondClip = "Death"
                Actions.SecondClipRequested = True
            End If

        Else

            Call SetPresentationState(Value, Value.HitTarget, STATE_GUARDING)

            If Value.HitTarget = 0 Then
                Actions.FirstClip = "Defend"
                Actions.FirstClipRequested = True
            Else If Value.HitTarget = MiraBattle.PARTY_TURN Then
                Actions.MiraClip = "Defend"
                Actions.MiraClipRequested = True
            Else
                Actions.SecondClip = "Defend"
                Actions.SecondClipRequested = True
            End If

        End If

    End If

    Call SetPositions(Value, 0.0, Actions)

    Return Actions

End Function

Public Function AdvanceChoreography(ByRef Value As State,
    Elapsed As Number, DemoEnabled As Boolean, ScenePaused As Boolean,
    AttackMilliseconds As Number, PlaybackSpeed As Number,
    RolledTarget As Number) As FrameActions

    Dim Actions As FrameActions
    Dim Name As Text
    Dim Stage As Number
    Dim Progress As Double

    If Not AdvanceElapsed(Value, Elapsed, DemoEnabled, ScenePaused) Then
        Return Actions
    End If

    If Value.Turn = 2 Then
        Actions = AdvanceDragonTurn(Value, PlaybackSpeed, RolledTarget)

        Return Actions
    End If

    If Value.Elapsed >= AttackMilliseconds + 4000 Then

        Value.Elapsed = 0

        If Value.Turn = 1 And Value.Mira.Ready Then

            Value.Turn = MiraBattle.PARTY_TURN
            Value.HitResolved = False

        Else If Value.Turn = MiraBattle.PARTY_TURN Then

            Value.Turn = 2
            Actions.MiraClip = "Idle"
            Actions.MiraClipRequested = True

        Else
            Value.Turn = (Value.Turn + 1) Mod 3

        End If

        Value.Stage = -1

        If Value.Turn = 2 Then
            Value.DragonOnlyTurn = False

            Call PrepareDragonTurn(Value, RolledTarget)
        End If

    End If

    If Value.Turn = 2 Then
        Actions = AdvanceDragonTurn(Value, PlaybackSpeed, RolledTarget)

        Return Actions
    End If

    If Value.Turn = MiraBattle.PARTY_TURN Then

        Call ApplyMiraSample(Value, 1300, AttackMilliseconds, Actions)
        Call SetPositions(Value, 0.0, Actions)

        Return Actions

    End If

    Stage = 0
    Progress = Clamp(ToDouble(Max(0, Value.Elapsed - 650)) / 650.0, 0.0, 1.0)
    Name = "Walk"

    If Value.Turn = 1 Then
        Name = "Run"
    End If

    If Value.Elapsed >= AttackMilliseconds + 2000 Then

        Stage = 3
        Progress = 0.0
        Name = "Idle"

    Else If Value.Elapsed >= AttackMilliseconds + 1300 Then

        Stage = 2
        Progress = Max(0.0, 1.0 -
            ToDouble(Value.Elapsed - AttackMilliseconds - 1300) / 700.0)
        Name = "Walk"

        If Value.Turn = 1 Then
            Name = "Run"
        End If

    Else If Value.Elapsed >= 1300 Then

        Stage = 1
        Progress = 1.0
        Name = ViewerProfiles.PartyAttackName(ViewerProfiles.PROFILE_ARIN,
            Value.AttackCycle)

        If Value.Turn = 1 Then
            Name = ViewerProfiles.PartyAttackName(ViewerProfiles.PROFILE_ORIN,
                Value.AttackCycle)
        End If

    End If

    If Value.Elapsed < 650 Then
        Stage = -2
        Name = "Idle"
    End If

    If Stage <> Value.Stage Then

        Value.DragonReactionPending = Stage = 1

        If Value.Turn = 0 Then

            If PresentationState(Value, 0) = STATE_KO Then
                Call SetPresentationState(Value, 0, STATE_REVIVING)
            Else If Stage = 3 Then
                Call SetPresentationState(Value, 0, STATE_ALIVE)
            Else If Stage >= 0 Then
                Call SetPresentationState(Value, 0, STATE_ACTING)
            End If

            Actions.FirstClip = Name
            Actions.FirstClipRequested = True

            If PresentationState(Value, 1) <> STATE_KO Then

                Call SetPresentationState(Value, 1, STATE_GUARDING)

                Actions.SecondClip = "Defend"
                Actions.SecondClipRequested = True

            End If

        Else

            If PresentationState(Value, 1) = STATE_KO Then
                Call SetPresentationState(Value, 1, STATE_REVIVING)
            Else If Stage = 3 Then
                Call SetPresentationState(Value, 1, STATE_ALIVE)
            Else If Stage >= 0 Then
                Call SetPresentationState(Value, 1, STATE_ACTING)
            End If

            If PresentationState(Value, 0) <> STATE_KO Then

                Call SetPresentationState(Value, 0, STATE_GUARDING)

                Actions.FirstClip = "Defend"
                Actions.FirstClipRequested = True

            End If

            Actions.SecondClip = Name
            Actions.SecondClipRequested = True

        End If

        Value.Stage = Stage

    End If

    Call SetPositions(Value, Progress, Actions)

    Return Actions

End Function

Public Function AdvanceDemo(ByRef Value As State,
    AnimationElapsed As Number, DemoEnabled As Boolean,
    ScenePaused As Boolean, PlaybackSpeed As Number,
    ByRef PrimaryActor As Character3D.Actor,
    ByRef PrimaryFrame As PrecisionCamera.Framing,
    ByRef PrimaryClip As Number,
    TargetX As Number, TargetY As Number, TargetZ As Number,
    ModelForwardYawOffset As Number) As Boolean

    Dim Actions As FrameActions
    Dim AttackMilliseconds As Number
    Dim Result As Boolean
    Dim RolledTarget As Number

    If Value.UnityRoster Then

        Actions = AdvanceUnityChoreography(Value, AnimationElapsed, DemoEnabled,
            ScenePaused, PrimaryActor, PlaybackSpeed)
        Result = ApplyFrame(Value, Actions, PrimaryActor, PrimaryFrame, PrimaryClip,
            PlaybackSpeed, TargetX, TargetY, TargetZ, ModelForwardYawOffset)

        Return Result

    End If

    AttackMilliseconds = AttackDuration(
        Value, PrimaryActor, Value.Companion.Actor, PlaybackSpeed)
    RolledTarget = -1

    If WillPrepareDragonTurn(
        Value, AnimationElapsed, DemoEnabled, ScenePaused,
        AttackMilliseconds, PlaybackSpeed) Then
        Random RolledTarget From -1 To Max(1, Value.ParticipantCount - 1)
    End If

    Actions = AdvanceChoreography(
        Value, AnimationElapsed, DemoEnabled, ScenePaused,
        AttackMilliseconds, PlaybackSpeed, RolledTarget)
    Result = ApplyFrame(
        Value, Actions, PrimaryActor, PrimaryFrame, PrimaryClip,
        PlaybackSpeed, TargetX, TargetY, TargetZ,
        ModelForwardYawOffset)

    Return Result

End Function

Private Function CameraSocket(Actor As Character3D.Actor, Name As Text,
    Fallback As Precision3D.Vector3) As Precision3D.Vector3

    Dim Result As Precision3D.Vector3
    Dim Valid As Boolean

    Result = Fallback
    Valid = Character3D.TrySocketPositionPrecise(Actor, Name, 0, False, Result)

    Return Result

End Function

Public Function HeroImpactTime(AttackMilliseconds As Number,
    Optional Turn As Number = 0) As Number

    Dim Result As Number
    Dim HitPercent As Number

    HitPercent = HERO_ATTACK_HIT_PERCENT

    If Turn = 5 Then
        HitPercent = ViewerProfiles.ZARA_ATTACK_HIT_PERCENT
    End If

    Result = HERO_ATTACK_START_MILLISECONDS + AttackMilliseconds * HitPercent / 100

    Return Result

End Function

Public Function HeroCameraBeat(Turn As Number, Elapsed As Number,
    AttackMilliseconds As Number) As Number

    Dim Result As Number

    Result = 0

    If Turn = 2 Then
        Return Result
    End If

    Result = HERO_CAMERA_BEAT_CLOSE_UP

    If Elapsed >= HERO_APPROACH_DELAY_MILLISECONDS Then
        Result = HERO_CAMERA_BEAT_APPROACH
    End If

    If Elapsed >= HERO_ATTACK_START_MILLISECONDS Then
        Result = HERO_CAMERA_BEAT_ATTACK
    End If

    If Elapsed >= HeroImpactTime(AttackMilliseconds, Turn) Then
        Result = HERO_CAMERA_BEAT_IMPACT
    End If

    If Elapsed >= HERO_ATTACK_START_MILLISECONDS + AttackMilliseconds Then
        Result = HERO_CAMERA_BEAT_AFTERMATH
    End If

    Return Result

End Function

''' One smooth revolution, then a one-second hold on the live normal orbit.
Public Function EstablishOrbitDegrees(Remaining As Number) As Double

    Dim Progress As Double
    Dim Result As Double

    Progress = Clamp(ToDouble(ESTABLISH_TOTAL_MILLISECONDS - Remaining) /
        ToDouble(ESTABLISH_SPIN_MILLISECONDS), 0.0, 1.0)
    Result = 360.0 * Progress * Progress * (3.0 - 2.0 * Progress)

    Return Result

End Function

Public Function VraxImpactTime(AttackMilliseconds As Number) As Number

    Dim Result As Number

    Result = VRAX_ATTACK_START_MILLISECONDS + AttackMilliseconds / 6

    Return Result

End Function

Public Function VraxCameraBeat(Elapsed As Number, AttackMilliseconds As Number) As Number

    Dim Result As Number

    Result = HERO_CAMERA_BEAT_CLOSE_UP

    If Elapsed >= VRAX_APPROACH_START_MILLISECONDS Then
        Result = HERO_CAMERA_BEAT_APPROACH
    End If

    If Elapsed >= VRAX_ATTACK_START_MILLISECONDS Then
        Result = HERO_CAMERA_BEAT_ATTACK
    End If

    If Elapsed >= VRAX_ATTACK_START_MILLISECONDS + AttackMilliseconds Then
        Result = HERO_CAMERA_BEAT_AFTERMATH
    End If

    Return Result

End Function

Public Function VraxPosition(ByRef Value As State) As Precision3D.Vector3

    Dim Home As Precision3D.Vector3
    Dim Target As Precision3D.Vector3
    Dim Direction As Precision3D.Vector3
    Dim Approach As Precision3D.Vector3
    Dim Result As Precision3D.Vector3
    Dim Progress As Double
    Dim Valid As Boolean

    Home = Precision3D.Vector(ToDouble(ViewerDragon.PositionX()), 0.0,
        ToDouble(ViewerDragon.PositionZ()))
    Result = Home

    If Value.Turn <> 2 Then
        Return Result
    End If

    Target = Precision3D.FromVector(HomePosition(Value, Value.HitTarget))
    Valid = PreciseMath.TryNormalize(PreciseMath.Subtract(Target, Home), Direction)
    Approach = PreciseMath.Subtract(Target, PreciseMath.Scale(Direction, 260.0))
    Progress = Clamp(ToDouble(Value.Elapsed - VRAX_APPROACH_START_MILLISECONDS) /
        ToDouble(VRAX_ATTACK_START_MILLISECONDS - VRAX_APPROACH_START_MILLISECONDS), 0.0, 1.0)

    If Value.Elapsed >= VRAX_ATTACK_START_MILLISECONDS + Value.BossAttackDuration Then
        Progress = 1.0 - Clamp(ToDouble(Value.Elapsed - VRAX_ATTACK_START_MILLISECONDS -
            Value.BossAttackDuration) / ToDouble(VRAX_RETURN_MILLISECONDS), 0.0, 1.0)
    End If

    Progress = Progress * Progress * (3.0 - 2.0 * Progress)
    Result = PreciseMath.Lerp(Home, Approach, Progress)

    Return Result

End Function

''' Apply the same vertical-axis direction and angular clock as Camera 1.
Public Sub OrbitBattleShot(ByRef Value As State, ByRef Camera As Precision3D.Camera3D,
    Beat As Number)

    Dim Offset As Precision3D.Vector3
    Dim Rotation As Precision3D.Vector3
    Dim Degrees As Double

    If (Value.PreviousCamera <> 2 Or
        Value.PreviousCameraTurn <> Value.Turn Or
        Value.PreviousShotStage <> Beat) Then
        Value.ShotOrbitPhase = Value.OrbitPhase
    End If

    Degrees = PreciseMath.WrapDegrees(Value.OrbitPhase - Value.ShotOrbitPhase)
    Rotation = Precision3D.Vector(0.0, -Degrees, 0.0)
    Offset = PreciseMath.Subtract(Camera.Position, Camera.Target)
    Offset = PreciseMath.Rotate(Offset, Rotation)
    Camera.Position = PreciseMath.Add(Camera.Target, Offset)
    Camera.UpDirection = Precision3D.Vector(0.0, 1.0, 0.0)

End Sub

Private Sub ApplyVraxAttackCamera(ByRef Value As State,
    ByRef LiveCamera As Precision3D.Camera3D, AttackMilliseconds As Number)

    Dim Boss As Precision3D.Vector3
    Dim Hero As Precision3D.Vector3
    Dim Anchor As Precision3D.Vector3
    Dim Direction As Precision3D.Vector3
    Dim Side As Precision3D.Vector3
    Dim Desired As Precision3D.Camera3D
    Dim Beat As Number
    Dim Along As Double
    Dim Across As Double
    Dim Valid As Boolean

    Boss = VraxPosition(Value)
    Anchor = Boss
    Hero = Precision3D.FromVector(HomePosition(Value, Value.HitTarget))
    Valid = PreciseMath.TryNormalize(PreciseMath.Subtract(Hero, Boss), Direction)
    Side = Precision3D.Vector(-Direction.Z, 0.0, Direction.X)
    Beat = VraxCameraBeat(Value.Elapsed, AttackMilliseconds)
    Desired = Value.OrbitCamera
    Desired.UpDirection = Precision3D.Vector(0.0, 1.0, 0.0)
    Desired.Target = Boss
    Desired.Target.Y = 155.0
    Desired.Position.Y = 205.0
    Desired.FovDegrees = 40.0
    Along = 640.0
    Across = 45.0

    If Beat = HERO_CAMERA_BEAT_APPROACH Then

        Along = -500.0
        Across = 340.0
        Desired.Position.Y = 285.0
        Desired.Target = PreciseMath.Lerp(Boss, Hero, 0.6)
        Desired.Target.Y = 105.0
        Desired.FovDegrees = 48.0

    Else If Beat = HERO_CAMERA_BEAT_ATTACK Or Beat = HERO_CAMERA_BEAT_AFTERMATH Then

        Anchor = Hero
        Along = 540.0
        Across = 60.0
        Desired.Position.Y = 55.0
        Desired.Target = Boss
        Desired.Target.Y = 125.0
        Desired.FovDegrees = 26.0

    End If

    Desired.Position.X = Anchor.X + Direction.X * Along + Side.X * Across
    Desired.Position.Z = Anchor.Z + Direction.Z * Along + Side.Z * Across

    ''' The attack and aftermath share a planted camera behind the defender.
    ''' Only its look-at target follows Vrax; other battle beats retain their orbit.

    If Beat <> HERO_CAMERA_BEAT_ATTACK And Beat <> HERO_CAMERA_BEAT_AFTERMATH Then
        Call OrbitBattleShot(Value, Desired, Beat)
    End If

    Call BattleCamera.KeepOutsideActorPrecise(Desired, Boss, 300.0)
    Call BattleCamera.KeepOutsideActorPrecise(Desired, Hero, 120.0)

    LiveCamera = Desired
    Value.DragonCamera = Desired
    Value.ActiveCamera = 2
    Value.PreviousCamera = 2
    Value.PreviousCameraTurn = Value.Turn
    Value.PreviousShotStage = Beat

End Sub

Public Sub ApplyAttackCamera(
    ByRef Value As State,
    ByRef LiveCamera As Precision3D.Camera3D,
    PrimaryFrame As PrecisionCamera.Framing,
    DragonActor As Character3D.Actor,
    DragonAvailable As Boolean,
    DragonVisible As Boolean,
    AutoOrbit As Boolean,
    PlaybackSpeed As Number,
    CameraElapsed As Number,
    AttackMilliseconds As Number,
    DragonPositionX As Number,
    DragonPositionZ As Number
)

    Dim Hero As Precision3D.Vector3
    Dim OtherHero As Precision3D.Vector3
    Dim WaistHeight As Double
    Dim Boss As Precision3D.Vector3
    Dim BossHead As Precision3D.Vector3
    Dim Mouth As Precision3D.Vector3
    Dim Desired As Precision3D.Camera3D
    Dim Distance As Double
    Dim DeltaX As Double
    Dim DeltaZ As Double
    Dim Along As Double
    Dim Across As Double
    Dim Height As Double
    Dim Impact1000 As Double
    Dim BattleShot As Boolean
    Dim BossChargeShot As Boolean
    Dim BossClearance As Double
    Dim CameraBeat As Number
    Dim PositionEase As Double
    Dim SceneScale As Double
    Dim ShotSide As Number
    Dim ActionStart As Number
    Dim LowAngleStart As Number
    Dim StableAnchor As Precision3D.Vector3
    Dim EstablishOffset As Precision3D.Vector3
    Dim EstablishRotation As Precision3D.Vector3
    Dim TargetEase As Double

    Value.OrbitCamera = LiveCamera
    Value.ActiveCamera = 1

    ''' Start from a formation-wide orbit before the five hero camera phases.

    If Value.Enabled And Value.UnityRoster Then

        LiveCamera.Position.X = LiveCamera.Target.X + (LiveCamera.Position.X - LiveCamera.Target.X) * 1.65
        LiveCamera.Position.Y = LiveCamera.Target.Y + (LiveCamera.Position.Y - LiveCamera.Target.Y) * 1.65 + 110.0
        LiveCamera.Position.Z = LiveCamera.Target.Z + (LiveCamera.Position.Z - LiveCamera.Target.Z) * 1.65
        LiveCamera.Target.Y = LiveCamera.Target.Y + 110.0

        If Value.EstablishRemaining > 0 Then

            EstablishOffset = PreciseMath.Subtract(LiveCamera.Position, LiveCamera.Target)
            EstablishRotation = Precision3D.Vector(0.0,
                -EstablishOrbitDegrees(Value.EstablishRemaining), 0.0)
            EstablishOffset = PreciseMath.Rotate(EstablishOffset, EstablishRotation)
            LiveCamera.Position = PreciseMath.Add(LiveCamera.Target, EstablishOffset)
            LiveCamera.UpDirection = PreciseMath.Rotate(LiveCamera.UpDirection, EstablishRotation)

        End If

        Value.OrbitCamera = LiveCamera

    End If

    If (Not Value.Enabled Or
        Not Value.Ready Or
        Not DragonAvailable Or
        Not AutoOrbit Or
        Not DragonVisible Or
        Value.EstablishRemaining > 0) Then
        Value.PreviousCamera = 1
        Return
    End If

    If Value.Turn = MiraBattle.PARTY_TURN And Value.AttackCycle Mod 3 <> 0 Then
        Value.PreviousCamera = 1

        Return
    End If

    If Value.UnityRoster And Value.Turn = 2 Then
        Call ApplyVraxAttackCamera(Value, LiveCamera, AttackMilliseconds)

        Return
    End If

    BattleShot = Value.Stage <= 1

    If Value.UnityRoster Then
        BattleShot = Value.Turn <> 2
    End If

    If Value.Turn = 2 Then

        BattleShot = Value.Elapsed < 3000

        If Value.UnityRoster Then
            BattleShot = Value.Elapsed < BOSS_ATTACK_START_MILLISECONDS + AttackMilliseconds
        End If

    End If

    If Not BattleShot Then
        Value.PreviousCamera = 1
        Return
    End If

    ''' Actor homes/travel are stable. Bone bobbing and KO must not drive the camera.
    Hero = Precision3D.Vector(PrimaryFrame.PositionX, PrimaryFrame.PositionY + 68.0, PrimaryFrame.PositionZ)

    If Value.Turn = 1 Then
        Hero = Precision3D.Vector(Value.Companion.Frame.PositionX,
            Value.Companion.Frame.PositionY + 80.0, Value.Companion.Frame.PositionZ)
    Else If Value.Turn = 4 Then
        Hero = Precision3D.Vector(Value.Third.Frame.PositionX,
            Value.Third.Frame.PositionY + 68.0, Value.Third.Frame.PositionZ)
    Else If Value.Turn = 5 Then
        Hero = Precision3D.Vector(Value.Fourth.Frame.PositionX,
            Value.Fourth.Frame.PositionY + 68.0, Value.Fourth.Frame.PositionZ)
    Else If Value.Turn = MiraBattle.PARTY_TURN Then
        Hero = Precision3D.Vector(Value.Mira.Frame.PositionX,
            Value.Mira.Frame.PositionY + 68.0, Value.Mira.Frame.PositionZ)
    End If

    CameraBeat = HeroCameraBeat(Value.Turn, Value.Elapsed, AttackMilliseconds)

    If Value.UnityRoster And CameraBeat >= HERO_CAMERA_BEAT_ATTACK Then

        ''' Choose the reference orbit angle behind this hero, then hold the entire shot.

        If (Value.PreviousCamera <> 2 Or
            Value.PreviousCameraTurn <> Value.Turn Or
            Value.PreviousShotStage < HERO_CAMERA_BEAT_ATTACK) Then

            Boss = Value.OrbitCamera.Target
            Boss.Y = 0.0
            StableAnchor = Precision3D.FromVector(HomePosition(Value, Value.Turn))
            DeltaX = StableAnchor.X - Boss.X
            DeltaZ = StableAnchor.Z - Boss.Z
            Distance = Max(1.0, PreciseMath.Distance(StableAnchor, Boss))
            Desired = Value.OrbitCamera
            Desired.Position = Precision3D.Vector(Boss.X + DeltaX * 846.0 / Distance,
                85.0, Boss.Z + DeltaZ * 846.0 / Distance)
            Desired.Target = Boss
            Desired.Target.Y = 121.0
            Desired.UpDirection = Precision3D.Vector(0.0, 1.0, 0.0)
            Desired.FovDegrees = 24.0
            Value.HeroCamera = Desired

        End If

        LiveCamera = Value.HeroCamera
        Value.ActiveCamera = 2
        Value.PreviousCamera = 2
        Value.PreviousCameraTurn = Value.Turn
        Value.PreviousShotStage = CameraBeat

        Return

    End If

    WaistHeight = Hero.Y - 32.0

    If Value.Turn = 2 Then

        OtherHero = Precision3D.Vector(Value.Companion.Frame.PositionX,
            Value.Companion.Frame.PositionY + 80.0, Value.Companion.Frame.PositionZ)

        If Value.HitTarget = MiraBattle.PARTY_TURN Then
            OtherHero = Precision3D.Vector(Value.Mira.Frame.PositionX,
                Value.Mira.Frame.PositionY + 68.0, Value.Mira.Frame.PositionZ)
        End If

        WaistHeight = Min(Hero.Y, OtherHero.Y) - 32.0
        Hero.X = (Hero.X + OtherHero.X) / 2.0
        Hero.Y = (Hero.Y + OtherHero.Y) / 2.0
        Hero.Z = (Hero.Z + OtherHero.Z) / 2.0

    End If

    ''' Frame the boss at the cut; breathing, recoil and head aim do not shake the lens.

    If Value.PreviousCamera = 1 Or Value.Turn <> Value.PreviousCameraTurn Then

        StableAnchor = Precision3D.Vector(
            ToDouble(DragonPositionX), ToDouble(DRAGON_CAMERA_CHEST_HEIGHT), ToDouble(DragonPositionZ))
        Value.ShotBoss = BattleCamera.BoundedAnchorPrecise(
            CameraSocket(DragonActor, "Chest", StableAnchor), StableAnchor,
            DRAGON_CAMERA_ANCHOR_MAXIMUM_DELTA)
        StableAnchor.Y = ToDouble(DRAGON_CAMERA_HEAD_HEIGHT)
        Value.ShotBossHead = BattleCamera.BoundedAnchorPrecise(
            CameraSocket(DragonActor, "Head", StableAnchor), StableAnchor,
            DRAGON_CAMERA_ANCHOR_MAXIMUM_DELTA)
        StableAnchor.Y = ToDouble(DRAGON_CAMERA_MOUTH_HEIGHT)
        Value.ShotMouth = BattleCamera.BoundedAnchorPrecise(
            CameraSocket(DragonActor, "Mouth", StableAnchor), StableAnchor,
            DRAGON_CAMERA_ANCHOR_MAXIMUM_DELTA)

    End If

    Boss = Value.ShotBoss
    BossHead = Value.ShotBossHead

    ActionStart = HERO_ATTACK_START_MILLISECONDS
    LowAngleStart = ActionStart
    CameraBeat = HeroCameraBeat(Value.Turn, Value.Elapsed, AttackMilliseconds)
    PositionEase = 180.0
    TargetEase = 120.0
    SceneScale = 1.0

    If Value.UnityRoster Then

        SceneScale = 1.35

    Else
        CameraBeat = Value.Stage + 10
        PositionEase = 320.0
        TargetEase = 180.0

    End If

    If Value.Turn = 2 Then
        ActionStart = BOSS_ATTACK_START_MILLISECONDS
        CameraBeat = Value.Stage + 10
    End If

    If Not Value.UnityRoster Then
        ActionStart = 1300
        LowAngleStart = 650
    End If

    BossChargeShot = (Value.Turn = 2 And
        (Value.Elapsed * PlaybackSpeed / 100 < BOSS_ATTACK_START_MILLISECONDS Or
        (Value.DragonCounter Mod 3 = 2 And Value.Elapsed * PlaybackSpeed / 100 < 1750)))
    DeltaX = Hero.X - Boss.X
    DeltaZ = Hero.Z - Boss.Z
    Distance = Max(1.0, PreciseMath.Distance(Hero, Boss))
    Along = 150.0
    Across = 120.0
    Height = 55.0
    ShotSide = -1

    If Value.Turn = 1 Then
        ShotSide = 1
    End If

    If Not Value.UnityRoster And Value.Elapsed < 650 Then

        Along = -45.0
        Across = 190.0
        Height = 10.0

    Else If (Not Value.UnityRoster And
        Value.Stage = 0 And
        Value.Turn <> 2) Then

        Along = 160.0
        Across = 85.0
        Height = 65.0

    Else If Value.Turn <> 2 And CameraBeat = HERO_CAMERA_BEAT_CLOSE_UP Then

        Along = -110.0
        Across = 48.0
        Height = 18.0

    Else If Value.Turn <> 2 And CameraBeat = HERO_CAMERA_BEAT_APPROACH Then

        Along = 115.0
        Across = 28.0
        Height = 18.0
        PositionEase = 70.0
        TargetEase = 70.0

    Else If Value.Turn <> 2 And CameraBeat = HERO_CAMERA_BEAT_ATTACK Then

        Along = 145.0 * SceneScale
        Across = 100.0 * SceneScale
        Height = 15.0

    Else If Value.Turn <> 2 And CameraBeat = HERO_CAMERA_BEAT_IMPACT Then

        Along = 220.0 * SceneScale
        Across = 160.0 * SceneScale
        Height = 65.0 * SceneScale

    Else
        Impact1000 = Clamp(ToDouble(Max(0, Value.Elapsed - ActionStart)) /
            ToDouble(Max(1, AttackMilliseconds)), 0.0, 1.0)
        Along = 150.0 - Impact1000 * 35.0
        Across = 120.0

    End If

    If Value.Elapsed >= LowAngleStart Then
        Height = WaistHeight - Hero.Y
    End If

    If Value.Turn = 2 And Value.Elapsed >= LowAngleStart Then
        Along = 170.0
        Across = 65.0
    End If

    Across = Across * ToDouble(ShotSide)

    Desired = Value.OrbitCamera
    Desired.UpDirection.X = 0.0
    Desired.UpDirection.Y = 1.0
    Desired.UpDirection.Z = 0.0
    Desired.Target.X = (Hero.X + Boss.X) / 2.0
    Desired.Target.Y = Max(Hero.Y + 12.0, BossHead.Y - 35.0)
    Desired.Target.Z = (Hero.Z + Boss.Z) / 2.0

    If Value.Turn <> 2 And CameraBeat = HERO_CAMERA_BEAT_CLOSE_UP Then

        Desired.Target = Hero

    Else If Value.Turn <> 2 And CameraBeat = HERO_CAMERA_BEAT_APPROACH Then

        Desired.Target.X = (Hero.X * 3.0 + Boss.X) / 4.0
        Desired.Target.Y = Hero.Y + 10.0
        Desired.Target.Z = (Hero.Z * 3.0 + Boss.Z) / 4.0

    Else If Value.Turn <> 2 And CameraBeat = HERO_CAMERA_BEAT_ATTACK Then

        Desired.Target.X = (Hero.X * 4.0 + Boss.X) / 5.0
        Desired.Target.Y = WaistHeight + 15.0
        Desired.Target.Z = (Hero.Z * 4.0 + Boss.Z) / 5.0

    Else If Value.Turn <> 2 And CameraBeat = HERO_CAMERA_BEAT_IMPACT Then

        PositionEase = 320.0
        TargetEase = 220.0

    Else If Value.Elapsed >= LowAngleStart Then

        Desired.Target.Y = (WaistHeight + BossHead.Y) / 2.0

    End If

    Desired.Position.X = Hero.X + DeltaX * Along / Distance - DeltaZ * Across / Distance
    Desired.Position.Y = Hero.Y + Height
    Desired.Position.Z = Hero.Z + DeltaZ * Along / Distance + DeltaX * Across / Distance

    If Value.Turn <> 2 And CameraBeat = HERO_CAMERA_BEAT_IMPACT Then

        Desired = Value.OrbitCamera
        Desired.Target.X = Boss.X
        Desired.Target.Y = (Boss.Y + BossHead.Y) / 2.0
        Desired.Target.Z = Boss.Z

    End If

    If Value.Turn = 2 Then

        Desired.Position.X = Desired.Position.X + (Desired.Position.X - Desired.Target.X) * 15.0 / 100.0
        Desired.Position.Y = Desired.Position.Y + (Desired.Position.Y - Desired.Target.Y) * 15.0 / 100.0
        Desired.Position.Z = Desired.Position.Z + (Desired.Position.Z - Desired.Target.Z) * 15.0 / 100.0

    End If

    ''' The orbit stays live. Each battle phase owns its pose and cuts directly.

    Mouth = Value.ShotMouth
    Value.DragonCamera = Desired
    Value.DragonCamera.Position.X = BossHead.X - DeltaX * 120.0 / Distance - DeltaZ * 90.0 / Distance
    Value.DragonCamera.Position.Y = BossHead.Y + 20.0
    Value.DragonCamera.Position.Z = BossHead.Z - DeltaZ * 120.0 / Distance + DeltaX * 90.0 / Distance
    Value.DragonCamera.Target.X = (Mouth.X * 3.0 + Hero.X) / 4.0
    Value.DragonCamera.Target.Y = (Mouth.Y * 3.0 + Hero.Y) / 4.0
    Value.DragonCamera.Target.Z = (Mouth.Z * 3.0 + Hero.Z) / 4.0

    If (Value.PreviousCamera <> 2 Or
        Value.Turn <> Value.PreviousCameraTurn Or
        CameraBeat <> Value.PreviousShotStage) Then

        Value.ShotOrbitPhase = Value.OrbitPhase
        Value.ShotPosition.X = Desired.Position.X
        Value.ShotPosition.Y = Desired.Position.Y
        Value.ShotPosition.Z = Desired.Position.Z
        Value.ShotTarget.X = Desired.Target.X
        Value.ShotTarget.Y = Desired.Target.Y
        Value.ShotTarget.Z = Desired.Target.Z

    End If

    Value.ShotPosition.X = Value.ShotPosition.X + (Desired.Position.X - Value.ShotPosition.X) * ToDouble(CameraElapsed) / (PositionEase + ToDouble(CameraElapsed))
    Value.ShotPosition.Y = Value.ShotPosition.Y + (Desired.Position.Y - Value.ShotPosition.Y) * ToDouble(CameraElapsed) / (PositionEase + ToDouble(CameraElapsed))
    Value.ShotPosition.Z = Value.ShotPosition.Z + (Desired.Position.Z - Value.ShotPosition.Z) * ToDouble(CameraElapsed) / (PositionEase + ToDouble(CameraElapsed))
    Value.ShotTarget.X = Value.ShotTarget.X + (Desired.Target.X - Value.ShotTarget.X) * ToDouble(CameraElapsed) / (TargetEase + ToDouble(CameraElapsed))
    Value.ShotTarget.Y = Value.ShotTarget.Y + (Desired.Target.Y - Value.ShotTarget.Y) * ToDouble(CameraElapsed) / (TargetEase + ToDouble(CameraElapsed))
    Value.ShotTarget.Z = Value.ShotTarget.Z + (Desired.Target.Z - Value.ShotTarget.Z) * ToDouble(CameraElapsed) / (TargetEase + ToDouble(CameraElapsed))
    Value.HeroCamera = Desired
    Value.HeroCamera.Position.X = Value.ShotPosition.X
    Value.HeroCamera.Position.Y = Value.ShotPosition.Y
    Value.HeroCamera.Position.Z = Value.ShotPosition.Z
    Value.HeroCamera.Target.X = Value.ShotTarget.X
    Value.HeroCamera.Target.Y = Value.ShotTarget.Y
    Value.HeroCamera.Target.Z = Value.ShotTarget.Z

    If Value.UnityRoster And CameraBeat <> HERO_CAMERA_BEAT_IMPACT Then
        Call OrbitBattleShot(Value, Value.HeroCamera, CameraBeat)
    End If

    ''' Clear both armored silhouettes after smoothing, including a shield held out in front.
    Hero = Precision3D.Vector(PrimaryFrame.PositionX, PrimaryFrame.PositionY, PrimaryFrame.PositionZ)
    OtherHero = Precision3D.Vector(Value.Companion.Frame.PositionX, Value.Companion.Frame.PositionY, Value.Companion.Frame.PositionZ)

    Call BattleCamera.KeepOutsideActorPrecise(Value.HeroCamera, Hero, 100.0)
    Call BattleCamera.KeepOutsideActorPrecise(Value.HeroCamera, OtherHero, 115.0)

    If Value.Mira.Ready Then
        Hero = Precision3D.Vector(Value.Mira.Frame.PositionX,
            Value.Mira.Frame.PositionY, Value.Mira.Frame.PositionZ)

        Call BattleCamera.KeepOutsideActorPrecise(Value.HeroCamera, Hero, 70.0)
    End If

    If Value.UnityRoster Then

        Hero = Precision3D.Vector(Value.Third.Frame.PositionX,
            Value.Third.Frame.PositionY, Value.Third.Frame.PositionZ)
        OtherHero = Precision3D.Vector(Value.Fourth.Frame.PositionX,
            Value.Fourth.Frame.PositionY, Value.Fourth.Frame.PositionZ)

        If PARTY_VALOR_VISIBLE Then
            Call BattleCamera.KeepOutsideActorPrecise(Value.HeroCamera, Hero, 90.0)
        End If

        Call BattleCamera.KeepOutsideActorPrecise(Value.HeroCamera, OtherHero, 90.0)

    End If

    BossClearance = 180.0

    If Value.UnityRoster Then
        BossClearance = 260.0
    End If

    If (Value.UnityRoster And
        Value.Turn <> 2 And
        CameraBeat >= HERO_CAMERA_BEAT_ATTACK) Then
        Call BattleCamera.KeepOutsideActorPrecise(Value.HeroCamera, Boss, BossClearance)
    End If

    Value.HeroCamera.Position.Y = Max(24.0, Value.HeroCamera.Position.Y)
    Value.DragonCamera.Position.Y = Max(24.0, Value.DragonCamera.Position.Y)

    LiveCamera = Value.HeroCamera
    Value.ActiveCamera = 2

    If BossChargeShot Then
        LiveCamera = Value.DragonCamera
        Value.ActiveCamera = 3
    End If

    Value.PreviousCamera = Value.ActiveCamera
    Value.PreviousCameraTurn = Value.Turn
    Value.PreviousShotStage = CameraBeat

End Sub

Public Function ClassifyPointer(
    PointerX As Number,
    PointerY As Number,
    PrimaryPressed As Boolean,
    SecondaryPressed As Boolean,
    UiVisibility As Number,
    CalibrationVisible As Boolean,
    CapturesActive As Boolean,
    WindowHeight As Number,
    StatusPanelX As Number,
    GlowButtonX As Number,
    GlowButtonWidth As Number,
    Optional UnityRoster As Boolean = False
) As PointerDecision

    Dim Result As PointerDecision
    Dim Left As Number

    Left = 12
    Result.Consumed = (UiVisibility = 0 And Not CalibrationVisible And
        PointerX < Left + 252 And PointerY >= 96 And
        PointerY < WindowHeight - 104)

    If CapturesActive Then
        Result.Consumed = False

        Return Result
    End If

    If SecondaryPressed Then

        Result.Action = POINTER_ACTION_RESET_INSPECTOR
        Result.Consumed = True

        Return Result

    End If

    If Not PrimaryPressed Or UiVisibility <> 0 Then
        Return Result
    End If

    If UnityRoster And Not CalibrationVisible Then

        If InRectangle(PointerX, PointerY, Left + 74, 208, 42, 24) Then
            Result.Action = POINTER_ACTOR_SPEED_BASE
        Else If InRectangle(PointerX, PointerY, Left + 190, 208, 42, 24) Then
            Result.Action = POINTER_ACTOR_SPEED_BASE + 2
        Else If InRectangle(PointerX, PointerY, Left + 74, 236, 42, 24) Then
            Result.Action = POINTER_ACTOR_SPEED_BASE + 4
        Else If InRectangle(PointerX, PointerY, Left + 190, 236, 42, 24) Then
            Result.Action = POINTER_ACTOR_SPEED_BASE + 6
        End If

        If Result.Action >= POINTER_ACTOR_SPEED_BASE Then

            If PointerX >= Left + 212 Or (PointerX >= Left + 96 And PointerX < Left + 116) Then
                Result.Action = Result.Action + 1
            End If

            Result.Consumed = True

            Return Result

        End If

    End If

    If InRectangle(PointerX, PointerY,
        GlowButtonX, 18, GlowButtonWidth, 34) Then
        Result.Action = POINTER_ACTION_TOGGLE_GLOW
    Else If InRectangle(PointerX, PointerY,
        StatusPanelX + 108, 18, 50, 34) Then
        Result.Action = POINTER_ACTION_CYCLE_SOCKET
    Else If Not Result.Consumed Then
        Return Result
    Else If InRectangle(PointerX, PointerY, Left, 104, 76, 30) Then
        Result.Action = POINTER_ACTION_TOGGLE_DRAGON
    Else If InRectangle(PointerX, PointerY, Left + 82, 104, 76, 30) Then
        Result.Action = POINTER_ACTION_TOGGLE_SWORD
    Else If InRectangle(PointerX, PointerY, Left + 164, 104, 76, 30) Then
        Result.Action = POINTER_ACTION_TOGGLE_SHIELD
    Else If InRectangle(PointerX, PointerY, Left, 140, 76, 22) Then
        Result.Action = POINTER_ACTION_TOGGLE_FLOOR
    Else If InRectangle(PointerX, PointerY, Left + 82, 140, 76, 22) Then
        Result.Action = POINTER_ACTION_CYCLE_BACKGROUND
    Else If InRectangle(PointerX, PointerY, Left + 164, 140, 76, 22) Then
        Result.Action = POINTER_ACTION_TOGGLE_GLOW
    Else If InRectangle(PointerX, PointerY, Left + 12, 324, 108, 28) Then
        Result.Action = POINTER_ACTION_TOGGLE_PAUSE
    Else If InRectangle(PointerX, PointerY, Left + 128, 324, 108, 28) Then
        Result.Action = POINTER_ACTION_TOGGLE_ORBIT
    Else If InRectangle(PointerX, PointerY, Left + 12, 360, 224, 28) Then
        Result.Action = POINTER_ACTION_RESTART
    Else If (WindowHeight >= 580 And
        InRectangle(PointerX, PointerY, Left + 12, 410, 108, 24)) Then
        Result.Action = POINTER_ACTION_TOGGLE_FIRE
    Else If (WindowHeight >= 580 And
        InRectangle(PointerX, PointerY, Left + 128, 410, 108, 24)) Then
        Result.Action = POINTER_ACTION_TOGGLE_LIGHTNING
    Else If (WindowHeight >= 580 And
        InRectangle(PointerX, PointerY, Left + 12, 440, 224, 22)) Then
        Result.Action = POINTER_ACTION_TOGGLE_SHIELD_STYLE
    End If

    Return Result

End Function

Public Function PointerResponseForAction(Action As Number) As PointerResponse

    Dim Result As PointerResponse

    Result.SpeedTurn = -1

    If Action >= POINTER_ACTOR_SPEED_BASE And Action < POINTER_ACTOR_SPEED_BASE + 8 Then

        Result.SpeedTurn = (Action - POINTER_ACTOR_SPEED_BASE) / 2

        If Result.SpeedTurn = 2 Then
            Result.SpeedTurn = 5
        Else If Result.SpeedTurn = 3 Then
            Result.SpeedTurn = 2
        End If

        Result.SpeedDelta = -25

        If Action Mod 2 = 1 Then
            Result.SpeedDelta = 25
        End If

        Return Result

    End If

    If Action = POINTER_ACTION_RESET_VIEW Then
        Result.ResetView = True
    Else If (Action = POINTER_ACTION_RESET_INSPECTOR Or
        Action = POINTER_ACTION_RESTART) Then
        Result.ResetInspector = True
    Else If Action = POINTER_ACTION_SPEED_DOWN Then
        Result.SpeedDelta = -25
    Else If Action = POINTER_ACTION_SPEED_UP Then
        Result.SpeedDelta = 25
    Else If Action = POINTER_ACTION_TOGGLE_PAUSE Then
        Result.TogglePause = True
    End If

    Return Result

End Function

Private Function InRectangle(PointerX As Number, PointerY As Number,
    X As Number, Y As Number, Width As Number, Height As Number) As Boolean

    Dim Result As Boolean

    Result = (PointerX >= X And PointerX < X + Width And
        PointerY >= Y And PointerY < Y + Height)

    Return Result

End Function

Public Function ActingName(ByRef Value As State) As Text

    Dim Result As Text

    Result = "Arin"

    If Value.Turn = 1 Then

        Result = "Orin"

    Else If Value.Turn = 2 Then

        Result = "Dragon"

        If Value.UnityRoster Then
            Result = "Vrax"
        End If

    Else If Value.Turn = 4 Then

        Result = "Valor"

    Else If Value.Turn = 5 Then

        Result = "Zara"

    Else If Value.Turn = MiraBattle.PARTY_TURN Then

        Result = "Mira3"

    End If

    Return Result

End Function

Public Function AttackSequenceName(ByRef Value As State) As Text

    Dim Result As Text

    If Value.Turn = MiraBattle.PARTY_TURN Then
        Result = MiraBattle.Caption(Value.AttackCycle)

        Return Result
    End If

    If Value.UnityRoster Then
        Result = UnityAttackName(Value)

        Return Result
    End If

    Result = "Sword Attack"

    If Value.Turn = 0 And Value.AttackCycle Mod 2 = 1 Then

        Result = "Sword Attack 2"

    Else If Value.Turn = 1 Then

        If Value.AttackCycle Mod 3 = 0 Then
            Result = "Sword Attack"
        Else If Value.AttackCycle Mod 3 = 1 Then
            Result = "Jump Attack"
        Else
            Result = "Thor Attack"
        End If

    Else If Value.Turn = 2 Then

        If Value.DragonCounter Mod 3 = 0 Then
            Result = "Fire Breath"
        Else If Value.DragonCounter Mod 3 = 1 Then
            Result = "Claw Strike"
        Else
            Result = "Fireball"
        End If

    End If

    Return Result

End Function

Public Function DrawCompanion(ByRef Value As State, PartyEnabled As Boolean,
    DragonInspection As Boolean, SceneGlowVisible As Boolean,
    SwordVisible As Boolean) As Boolean

    Dim Result As Boolean

    Result = ViewerActors.Draw(Value.Companion)

    If PartyEnabled And Value.Mira.Ready Then
        Result = ViewerActors.Draw(Value.Mira) And Result
    End If

    If Value.UnityRoster Then

        If PARTY_VALOR_VISIBLE Then
            Result = ViewerActors.Draw(Value.Third) And Result
        End If

        Result = ViewerActors.Draw(Value.Fourth) And Result

    End If

    If (Value.Companion.GlowVisible And
        Value.Companion.GlowAvailable And
        (Not PartyEnabled Or PresentationState(Value, 1) <> STATE_KO) And
        (SceneGlowVisible Or DragonInspection) And
        SwordVisible) Then
        Result = Graphics3D.DrawObject3D(Value.Companion.WeaponGlow) And Result
    End If

    Return Result

End Function

Public Function DrawDragonOpponent(ByRef Value As State,
    PartyEnabled As Boolean, DragonInspection As Boolean,
    SceneGlowVisible As Boolean, SwordVisible As Boolean) As Boolean

    Dim Result As Boolean
    Dim SavedCompanion As ViewerActors.Context

    SavedCompanion = Value.Companion
    Value.Companion = Value.DragonOpponent
    Result = DrawCompanion(
        Value, PartyEnabled, DragonInspection, SceneGlowVisible, SwordVisible)
    Value.Companion = SavedCompanion

    Return Result

End Function

Public Sub DestroyParticipants(ByRef Value As State)

    Call ViewerEffects.DestroyEpicGlow(Value.ThirdEffects)
    Call ViewerEffects.DestroyEpicGlow(Value.FourthEffects)
    Call ViewerActors.Destroy(Value.Companion)
    Call ViewerActors.Destroy(Value.DragonOpponent)
    Call ViewerActors.Destroy(Value.Third)
    Call ViewerActors.Destroy(Value.Fourth)
    Call ViewerActors.Destroy(Value.Mira)
    Call MiraWater.Destroy(Value.Water)

    Value.UnityRoster = False

    Value.Ready = False

End Sub

Public Sub DrawOverlay(
    ByRef Value As State,
    UiVisibility As Number,
    WindowHeight As Number,
    DragonVisible As Boolean,
    SwordVisible As Boolean,
    ShieldVisible As Boolean,
    FloorOrGridVisible As Boolean,
    BackgroundVisible As Boolean,
    GlowVisible As Boolean,
    ScenePaused As Boolean,
    AutoOrbit As Boolean,
    FlamePaused As Boolean,
    LightningPaused As Boolean,
    FirePlaybackLabel As Text,
    LightningPlaybackLabel As Text,
    ShieldStyleLabel As Text,
    ShieldFlameStyle As Boolean,
    StormCaption As Text,
    FramesPerSecond As Number,
    ViewerError As Boolean,
    FirstFailureStage As Number,
    Camera As Precision3D.Camera3D
)

    Dim Left As Number
    Dim BossLabel As Text
    Dim Acting As Text
    Dim AttackSequence As Text
    Dim PrimaryState As Number
    Dim CompanionState As Number
    Dim PresentationCaption As Text

    Left = 12
    BossLabel = "Dragon"

    If Value.UnityRoster Then
        BossLabel = "Vrax"
    End If

    Acting = ActingName(Value)
    AttackSequence = AttackSequenceName(Value)
    PrimaryState = PresentationState(Value, 0)
    CompanionState = PresentationState(Value, 1)

    If UiVisibility = 0 Then

        Call UI.DrawPanel(Left, 96, 252, Max(330, WindowHeight - 200))
        Call UI.DrawButton(Left, 104, 76, 30, BossLabel, DragonVisible)
        Call UI.DrawButton(Left + 82, 104, 76, 30, "Weapon", SwordVisible)
        Call UI.DrawButton(Left + 164, 104, 76, 30, "Shield", ShieldVisible)
        Call UI.DrawButton(Left, 140, 76, 22, "Floor/Grid", FloorOrGridVisible)
        Call UI.DrawButton(Left + 82, 140, 76, 22, "Backdrop", BackgroundVisible)
        Call UI.DrawButton(Left + 164, 140, 76, 22, "Glow", GlowVisible)

        If Value.Mira.Ready Then
            Draw Text "Party / Enemy + Mira3" At Left + 16, 178 Size 20 Color WHITE
        Else
            Draw Text "Party / Enemy" At Left + 16, 178 Size 20 Color WHITE
        End If

        If Value.UnityRoster Then

            Call DrawActorSpeed(Value, 0, "Arin", Left + 12, 208)
            Call DrawActorSpeed(Value, 1, "Orin", Left + 128, 208)
            Call DrawActorSpeed(Value, 5, "Zara", Left + 12, 236)
            Call DrawActorSpeed(Value, 2, "Vrax", Left + 128, 236)

        Else
            Draw Text "Arin  •  Paladin" At Left + 16, 212 Size 15 Color CYAN
            Draw Text "Orin  •  Tank" At Left + 16, 238 Size 15 Color WHITE

        End If

        Draw Text Acting + "'s Turn" At Left + 16, 272 Size 16 Color YELLOW

        If Value.Stage = 1 Or Value.Turn = 2 Then
            Draw Text "Attack: " + AttackSequence At Left + 16, 296 Size 13 Color CYAN
        End If

        Call UI.DrawButton(Left + 12, 324, 108, 28, "Pause", ScenePaused)
        Call UI.DrawButton(Left + 128, 324, 108, 28, "Orbit", AutoOrbit)
        Call UI.DrawButton(Left + 12, 360, 224, 28, "Restart Battle Demo", False)

        If WindowHeight >= 580 Then

            Draw Text "VFX Playback" At Left + 16, 394 Size 12 Color WHITE

            Call UI.DrawButton(Left + 12, 410, 108, 24,
                FirePlaybackLabel, FlamePaused)
            Call UI.DrawButton(Left + 128, 410, 108, 24,
                LightningPlaybackLabel, LightningPaused)
            Call UI.DrawButton(Left + 12, 440, 224, 22,
                "Arin Shield: " + ShieldStyleLabel, Not ShieldFlameStyle)

        End If

        If WindowHeight >= 740 Then

            If PrimaryState = STATE_KO Then

                Draw Text "Arin KO - Revives On His Turn" At Left + 16, 470 Size 12 Color YELLOW

            Else If CompanionState = STATE_KO Then

                Draw Text "Orin KO - Revives On His Turn" At Left + 16, 470 Size 12 Color YELLOW

            Else
                PresentationCaption = "Arin " + PresentationStateName(PrimaryState)
                PresentationCaption = PresentationCaption + " / Orin "
                PresentationCaption = PresentationCaption + PresentationStateName(CompanionState)
                Draw Text PresentationCaption At Left + 16, 470 Size 12 Color LIGHT_GRAY

            End If

            Draw Text StormCaption At Left + 16, 488 Size 12 Color CYAN
            Draw Text "Camera" At Left + 16, 528 Size 12 Color LIGHT_GRAY
            Draw Number Value.ActiveCamera At Left + 80, 528 Size 12 Color CYAN

            Call DrawCameraDetails(Camera, Left + 16, 548)

            Draw Text "FPS" At Left + 16, 508 Size 13 Color LIGHT_GRAY
            Draw Number FramesPerSecond At Left + 62, 508 Size 13 Color GREEN

        End If

    End If

    If ViewerError Then
        Draw Text "Party Could Not Load — Select A Character Or Press Enter To Retry" At 18, 112 Size 16 Color YELLOW
        Draw Number FirstFailureStage At 18, 140 Size 14 Color YELLOW
    End If

End Sub

Private Sub DrawCameraDetails(Camera As Precision3D.Camera3D, X As Number, Y As Number)

    Dim Angles As Precision3D.Vector3

    Angles = BattleCamera.ViewAnglesPrecise(Camera)
    Draw Text "Pos XYZ" At X, Y Size 11 Color LIGHT_GRAY
    Draw Number ToNumber(Round(Camera.Position.X)) At X + 74, Y Size 11 Color CYAN
    Draw Number ToNumber(Round(Camera.Position.Y)) At X + 124, Y Size 11 Color CYAN
    Draw Number ToNumber(Round(Camera.Position.Z)) At X + 174, Y Size 11 Color CYAN
    Draw Text "Aim XYZ" At X, Y + 14 Size 11 Color LIGHT_GRAY
    Draw Number ToNumber(Round(Camera.Target.X)) At X + 74, Y + 14 Size 11 Color CYAN
    Draw Number ToNumber(Round(Camera.Target.Y)) At X + 124, Y + 14 Size 11 Color CYAN
    Draw Number ToNumber(Round(Camera.Target.Z)) At X + 174, Y + 14 Size 11 Color CYAN
    Draw Text "Yaw / Pitch" At X, Y + 28 Size 11 Color LIGHT_GRAY
    Draw Number ToNumber(Round(Angles.Y)) At X + 100, Y + 28 Size 11 Color CYAN
    Draw Number ToNumber(Round(Angles.X)) At X + 158, Y + 28 Size 11 Color CYAN
    Draw Text "FOV / Dist" At X, Y + 42 Size 11 Color LIGHT_GRAY
    Draw Number ToNumber(Round(Camera.FovDegrees)) At X + 100, Y + 42 Size 11 Color CYAN
    Draw Number ToNumber(Round(PreciseMath.Distance(Camera.Position, Camera.Target))) At X + 158, Y + 42 Size 11 Color CYAN

End Sub

Public Function CreateAdditionalParticipants(ByRef Value As State,
    PlaybackSpeed As Number, ByRef Effects As ViewerEffects.State) As Boolean

    Dim Result As Boolean

    Value.UnityRoster = (Value.UnityRosterRequested And
        ViewerProfiles.INCLUDE_UNITY_CHARACTERS)

    Result = True

    If ViewerProfiles.INCLUDE_MIRA_COMPARISONS Then

        Value.Mira = ViewerActors.LoadContext(ViewerProfiles.PROFILE_MIRA3, 0)
        Result = Value.Mira.Ready And MiraWater.Prepare(Value.Water)
        Result = PlayClip(Value.Mira.Actor, "Idle", Value.Mira.Clip,
            Value.Mira.Actor.Handle, Value.Mira.Profile,
            ActorPlaybackSpeed(Value, MiraBattle.PARTY_TURN, PlaybackSpeed)) And Result
        Value.Ready = Value.Ready And Result

    End If

    If Not Value.UnityRoster Then
        Return Result
    End If

    Value.Third = ViewerActors.LoadContext(ViewerProfiles.PROFILE_VALOR, 0)
    Value.Fourth = ViewerActors.LoadContext(ViewerProfiles.PROFILE_ZARA, 0)
    Value.BossAttackDuration = 2000
    Result = Value.Third.Ready And Value.Fourth.Ready And Result
    Result = PlayClip(Value.Third.Actor, "Idle", Value.Third.Clip,
        Value.Third.Actor.Handle, Value.Third.Profile,
        ActorPlaybackSpeed(Value, 4, PlaybackSpeed)) And Result
    Result = PlayClip(Value.Fourth.Actor, "Idle", Value.Fourth.Clip,
        Value.Fourth.Actor.Handle, Value.Fourth.Profile,
        ActorPlaybackSpeed(Value, 5, PlaybackSpeed)) And Result

    Call ViewerEffects.ResetEquipmentDefaults(Value.ThirdEffects)
    Call ViewerEffects.ResetEquipmentDefaults(Value.FourthEffects)
    Call ViewerEffects.CreateEpicGlow(Value.ThirdEffects, Value.Third.Profile, Value.Third.Actor)
    Call ViewerEffects.CreateEpicGlow(Value.FourthEffects, Value.Fourth.Profile, Value.Fourth.Actor)

    Value.ThirdEffects.SwordFireReady = Effects.FireInitialized
    Result = Value.ThirdEffects.EpicGlowAvailable And Value.FourthEffects.EpicGlowAvailable And Result
    Value.Ready = Value.Ready And Result

    Return Result

End Function

Public Function UpdateAdditionalEquipment(ByRef Value As State, ByRef Shared As ViewerEffects.State,
    Visibility As ViewerActors.EquipmentVisibility, Camera As Precision3D.Camera3D,
    CameraElapsed As Number, AnimationElapsed As Number, ScenePaused As Boolean,
    Primary As Character3D.Actor, Boss As Character3D.Actor) As Boolean

    Dim Result As Boolean

    If Not Value.Enabled Or Not Value.Ready Then
        Return True
    End If

    Result = True

    If Value.Mira.Ready Then

        Value.Water.Targets.MemberCount = 0

        Call MiraWater.SetAttack(Value.Water.Targets, Boss)
        Call MiraWater.SetMember(Value.Water.Targets, 0, Primary)
        Call MiraWater.SetMember(Value.Water.Targets, 1, Value.Companion.Actor)
        Call MiraWater.SetMember(Value.Water.Targets, 2, Value.Mira.Actor)

        If Value.UnityRoster Then
            Call MiraWater.SetMember(Value.Water.Targets, 3, Value.Fourth.Actor)
        End If

        Result = MiraWater.Update(Value.Water, Value.Mira.Actor,
            Character3D.ClipName(Value.Mira.Actor, Value.Mira.Clip),
            Value.Mira.PresentationState <> STATE_KO,
            Not ScenePaused And Not Value.PreviewActive)

    End If

    If Not Value.UnityRoster Then
        Return Result
    End If

    If PARTY_VALOR_VISIBLE Then
        Result = UpdateMemberEquipment(Value.Third, Value.ThirdEffects, Shared,
            Visibility, Camera, CameraElapsed, AnimationElapsed, ScenePaused)
    Else

        Call ViewerEffects.ClearEquipmentFire(Value.ThirdEffects)
    End If

    Result = UpdateMemberEquipment(Value.Fourth, Value.FourthEffects, Shared,
        Visibility, Camera, CameraElapsed, AnimationElapsed, ScenePaused) And Result

    Return Result

End Function

Private Function UpdateMemberEquipment(ByRef Member As ViewerActors.Context,
    ByRef Effects As ViewerEffects.State, ByRef Shared As ViewerEffects.State,
    Visibility As ViewerActors.EquipmentVisibility, Camera As Precision3D.Camera3D,
    CameraElapsed As Number, AnimationElapsed As Number, ScenePaused As Boolean) As Boolean

    Dim Result As Boolean
    Dim ClipName As Text

    Effects.FireInitialized = Shared.FireInitialized
    Effects.LightningInitialized = Shared.LightningInitialized
    Effects.LightningPaused = Shared.LightningPaused
    Effects.FlamePaused = Shared.FlamePaused
    Effects.VisualContinuityEpoch = Shared.VisualContinuityEpoch
    Effects.EpicGlowVisible = Shared.EpicGlowVisible And Member.PresentationState <> STATE_KO
    Effects.SwordFireVisible = Shared.SwordFireVisible And Effects.EpicGlowVisible
    Effects.ShieldFireVisible = Shared.ShieldFireVisible And Effects.EpicGlowVisible
    Effects.ShieldFlameStyle = Shared.ShieldFlameStyle
    ClipName = Character3D.ClipName(Member.Actor, Member.Clip)
    Result = True

    If Effects.EpicGlowVisible Then
        Result = ViewerEffects.UpdateEpicGlow(Effects, Member.Actor, Member.Profile,
            Member.Frame.ScalePercent, AnimationElapsed, ClipName,
            Visibility.SwordVisible, Visibility.ShieldVisible, False, False)
    End If

    Call ViewerEffects.UpdateEquipmentFire(Effects, Member.Actor, Member.Profile,
        Member.PresentationState = STATE_KO, Visibility.SwordVisible, Visibility.ShieldVisible,
        False, ScenePaused, Member.Clip, ClipName, Camera, CameraElapsed)

    Return Result

End Function

Public Function DrawAdditionalEquipment(ByRef Value As State,
    Visibility As ViewerActors.EquipmentVisibility) As Boolean

    Dim Result As Boolean

    If Not Value.Enabled Or Not Value.Ready Then
        Return True
    End If

    Call MiraWater.Draw(Value.Water)

    If Not Value.UnityRoster Then
        Return True
    End If

    Result = True

    If PARTY_VALOR_VISIBLE And Value.ThirdEffects.EpicGlowVisible Then
        Result = ViewerEffects.DrawEquipmentGlow(Value.ThirdEffects, Value.Third.Profile,
            Visibility.SwordVisible, Visibility.ShieldVisible)
        Result = ViewerEffects.DrawEpicGlow(Value.ThirdEffects, Value.Third.Profile,
            Visibility.SwordVisible, Visibility.ShieldVisible) And Result
    End If

    If Value.FourthEffects.EpicGlowVisible Then
        Result = ViewerEffects.DrawEquipmentGlow(Value.FourthEffects, Value.Fourth.Profile,
            Visibility.SwordVisible, Visibility.ShieldVisible) And Result
    End If

    If PARTY_VALOR_VISIBLE Then
        Call ViewerEffects.DrawEquipmentFire(Value.ThirdEffects,
            Visibility.SwordVisible, Visibility.ShieldVisible)
    End If

    Call ViewerEffects.DrawEquipmentFire(Value.FourthEffects,
        Visibility.SwordVisible, Visibility.ShieldVisible)

    Return Result

End Function

Private Function PlaceUnityMember(ByRef Actor As ViewerActors.Context,
    Position As Precision3D.Vector3, TargetX As Number, TargetY As Number,
    TargetZ As Number, ForwardYaw As Number) As Boolean

    Dim Result As Boolean

    Actor.Frame.PositionX = Position.X
    Actor.Frame.PositionZ = Position.Z
    Result = Character3D.PlacePrecise(Actor.Actor, Position.X,
        Actor.Frame.PositionY, Position.Z)
    Result = ViewerActors.FaceToward(Actor.Actor, TargetX, TargetY, TargetZ,
        ForwardYaw, 0) And Result

    Return Result

End Function

Private Function UpdateUnityMember(ByRef Actor As ViewerActors.Context,
    Elapsed As Number) As Boolean

    Dim Result As Boolean

    Result = ViewerActors.Update(Actor, Elapsed)
    Result = ViewerActors.ApplyPresentationOffset(Actor.Actor,
        Actor.Profile, Actor.Clip, Actor.Frame) And Result

    Return Result

End Function

Private Function UnityAttackName(ByRef Value As State) As Text

    Dim Result As Text

    Result = "SwordAttack"

    If Value.Turn = MiraBattle.PARTY_TURN Then
        Result = MiraBattle.ClipForCycle(Value.AttackCycle)
    Else If Value.Turn = 2 Then
        Result = ViewerProfiles.PartyAttackName(ViewerProfiles.PROFILE_VRAX, Value.DragonCounter)
    Else If Value.Turn = 1 Then
        Result = ViewerProfiles.PartyAttackName(ViewerProfiles.PROFILE_ORIN, Value.AttackCycle)
    Else If Value.AttackCycle Mod 2 = 1 Then
        Result = "SwordAttack2"
    End If

    Return Result

End Function

Private Function AdvanceUnityChoreography(ByRef Value As State,
    Elapsed As Number, DemoEnabled As Boolean, ScenePaused As Boolean,
    Primary As Character3D.Actor, PlaybackSpeed As Number) As FrameActions

    Dim Actions As FrameActions
    Dim AttackMilliseconds As Number
    Dim Duration As Number
    Dim Name As Text
    Dim Progress As Double
    Dim Stage As Number

    If Value.EstablishRemaining > 0 Then

        If DemoEnabled And Not ScenePaused Then
            Value.EstablishRemaining = Max(0, Value.EstablishRemaining - Elapsed)
        End If

        Actions.FirstPosition = Precision3D.FromVector(Value.First.Home)
        Actions.SecondPosition = Precision3D.FromVector(Value.Second.Home)
        Actions.ThirdPosition = Precision3D.FromVector(Value.ThirdLayout.Home)
        Actions.FourthPosition = Precision3D.FromVector(Value.FourthLayout.Home)
        Actions.PositionsAvailable = True

        Return Actions

    End If

    If Not AdvanceElapsed(Value, Elapsed, DemoEnabled, ScenePaused) Then
        Return Actions
    End If

    AttackMilliseconds = AttackDuration(Value, Primary, Value.Companion.Actor, PlaybackSpeed)
    Duration = AttackMilliseconds + UNITY_HERO_TURN_TAIL_MILLISECONDS

    If Value.Turn = 2 Then
        Duration = AttackMilliseconds + BOSS_TURN_TAIL_MILLISECONDS
    End If

    If Value.Elapsed >= Duration Then

        Value.Elapsed = 0
        Value.Stage = -1

        If Value.Turn = 2 Then

            Value.DragonCounter = Value.DragonCounter + 1
            Value.Turn = 0

        Else If Value.Turn = 0 Then

            Value.Turn = 1

        Else If Value.Turn = 1 Then

            Value.Turn = 5

            If PARTY_VALOR_VISIBLE Then
                Value.Turn = 4
            End If

        Else If Value.Turn = 4 Then

            Value.Turn = 5

        Else If Value.Turn = 5 And Value.Mira.Ready Then

            Value.Turn = MiraBattle.PARTY_TURN
            Value.HitResolved = False

        Else
            Value.Turn = 2
            Value.HitTarget = Value.DragonCounter Mod Value.ParticipantCount

            If Value.HitTarget = Value.ParticipantCount - 1 And Value.Mira.Ready Then
                Value.HitTarget = MiraBattle.PARTY_TURN
            End If

            If Value.HitTarget = 2 Then
                Value.HitTarget = 5
            End If

            Value.HitResolved = False
            Value.AttackCycle = Value.AttackCycle + 1

        End If

        AttackMilliseconds = AttackDuration(Value, Primary, Value.Companion.Actor, PlaybackSpeed)

    End If

    Stage = 0
    Name = "Idle"
    Progress = 0.0

    If Value.Turn = 2 Then

        If Value.Elapsed >= VRAX_ATTACK_START_MILLISECONDS + AttackMilliseconds + VRAX_RETURN_MILLISECONDS Then
            Stage = 3
        Else If Value.Elapsed >= VRAX_ATTACK_START_MILLISECONDS + AttackMilliseconds Then
            Stage = 2
        Else If Value.Elapsed >= VRAX_ATTACK_START_MILLISECONDS Then
            Stage = 1
        Else If Value.Elapsed >= VRAX_APPROACH_START_MILLISECONDS Then
            Stage = 2
        End If

    Else If Value.Elapsed >= HERO_RETURN_END_MILLISECONDS + AttackMilliseconds Then

        Stage = 3

    Else If Value.Elapsed >= HERO_ATTACK_START_MILLISECONDS + AttackMilliseconds Then

        Stage = 2
        Name = "Walk"
        Progress = Max(0.0, 1.0 - ToDouble(Value.Elapsed -
            HERO_ATTACK_START_MILLISECONDS - AttackMilliseconds) /
            ToDouble(HERO_RETURN_DURATION_MILLISECONDS))

    Else If Value.Elapsed >= HERO_ATTACK_START_MILLISECONDS Then

        Stage = 1
        Name = UnityAttackName(Value)
        Progress = 1.0

    Else If Value.Elapsed >= HERO_APPROACH_DELAY_MILLISECONDS Then

        Stage = 2
        Name = "Walk"
        Progress = Clamp(ToDouble(Value.Elapsed -
            HERO_APPROACH_DELAY_MILLISECONDS) /
            ToDouble(HERO_APPROACH_DURATION_MILLISECONDS), 0.0, 1.0)

    End If

    If Value.Turn = MiraBattle.PARTY_TURN Then

        Call ApplyMiraSample(Value, HERO_ATTACK_START_MILLISECONDS, AttackMilliseconds, Actions)
        Call SetPositions(Value, 0.0, Actions)

        Actions.ThirdPosition = Precision3D.FromVector(Value.ThirdLayout.Home)
        Actions.FourthPosition = Precision3D.FromVector(Value.FourthLayout.Home)

        Return Actions

    End If

    If Value.Turn = 1 And Name = "Walk" Then
        Name = "Run"
    End If

    If Stage <> Value.Stage Then

        Call SetPresentationState(Value, 0, STATE_ALIVE)
        Call SetPresentationState(Value, 1, STATE_ALIVE)
        Call SetPresentationState(Value, 4, STATE_ALIVE)
        Call SetPresentationState(Value, 5, STATE_ALIVE)

        Actions.FirstClip = "Idle"
        Actions.SecondClip = "Idle"
        Actions.ThirdClip = "Idle"
        Actions.FourthClip = "Idle"
        Actions.MiraClip = "Idle"
        Actions.MiraClipRequested = Value.Mira.Ready
        Actions.FirstClipRequested = True
        Actions.SecondClipRequested = True
        Actions.ThirdClipRequested = True
        Actions.FourthClipRequested = True

        If Value.Turn = 0 Then
            Actions.FirstClip = Name
        Else If Value.Turn = 1 Then
            Actions.SecondClip = Name
        Else If Value.Turn = 4 Then
            Actions.ThirdClip = Name
        Else If Value.Turn = 5 Then
            Actions.FourthClip = Name
        End If

        If Value.Turn <> 2 And Stage = 1 Then
            Call SetPresentationState(Value, Value.Turn, STATE_ACTING)
        End If

        Value.Stage = Stage

    End If

    If (Value.Turn = 2 And
        Not Value.HitResolved And
        Value.Elapsed >= VraxImpactTime(AttackMilliseconds)) Then

        Value.HitResolved = True

        Call SetPresentationState(Value, Value.HitTarget, STATE_HIT)

        If Value.HitTarget = 1 Then
            Actions.SecondClip = "Hit"
            Actions.SecondClipRequested = True
        Else If Value.HitTarget = MiraBattle.PARTY_TURN Then
            Actions.MiraClip = "Hit"
            Actions.MiraClipRequested = True
        Else If Value.HitTarget = 5 Then
            Actions.FourthClip = "Hit"
            Actions.FourthClipRequested = True
        Else
            Actions.FirstClip = "Hit"
            Actions.FirstClipRequested = True
        End If

    End If

    Actions.FirstPosition = Precision3D.FromVector(Value.First.Home)
    Actions.SecondPosition = Precision3D.FromVector(Value.Second.Home)
    Actions.ThirdPosition = Precision3D.FromVector(Value.ThirdLayout.Home)
    Actions.FourthPosition = Precision3D.FromVector(Value.FourthLayout.Home)

    If Value.Turn = 0 Then
        Actions.FirstPosition = PreciseMath.Lerp(Actions.FirstPosition,
            Precision3D.FromVector(Value.First.Approach), Progress)
    Else If Value.Turn = 1 Then
        Actions.SecondPosition = PreciseMath.Lerp(Actions.SecondPosition,
            Precision3D.FromVector(Value.Second.Approach), Progress)
    Else If Value.Turn = 4 Then
        Actions.ThirdPosition = PreciseMath.Lerp(Actions.ThirdPosition,
            Precision3D.FromVector(Value.ThirdLayout.Approach), Progress)
    Else If Value.Turn = 5 Then
        Actions.FourthPosition = PreciseMath.Lerp(Actions.FourthPosition,
            Precision3D.FromVector(Value.FourthLayout.Approach), Progress)
    End If

    Actions.PositionsAvailable = True

    Return Actions

End Function

Private Function UpdateUnityBoss(ByRef Value As State,
    ByRef Boss As ViewerDragon.State, Primary As Character3D.Actor,
    PlaybackSpeed As Number, Elapsed As Number) As Boolean

    Dim Name As Text
    Dim Index As Number
    Dim Result As Boolean
    Dim AttackName As Text
    Dim BossAttackMilliseconds As Number
    Dim BossPlaybackSpeed As Number
    Dim HeroAttackMilliseconds As Number
    Dim HitMilliseconds As Number
    Dim Position As Precision3D.Vector3
    Dim Target As Core.Vector3

    Name = "Idle"
    BossPlaybackSpeed = ActorPlaybackSpeed(Value, 2, PlaybackSpeed)
    HeroAttackMilliseconds = AttackDuration(
        Value, Primary, Value.Companion.Actor, PlaybackSpeed)
    AttackName = ViewerProfiles.PartyAttackName(
        ViewerProfiles.PROFILE_VRAX, Value.DragonCounter)

    For Index = 0 To Character3D.ClipCount(Boss.Actor) - 1

        If Character3D.ClipName(Boss.Actor, Index) = "Hit" Then
            HitMilliseconds = Character3D.ClipDuration(Boss.Actor, Index)
        End If

        If Character3D.ClipName(Boss.Actor, Index) = AttackName Then
            BossAttackMilliseconds = Character3D.ClipDuration(Boss.Actor, Index) * 100
            Value.BossAttackDuration = BossAttackMilliseconds / Max(25, BossPlaybackSpeed)
        End If

    End For

    If Value.Turn = 2 And Value.Stage = 1 Then
        Name = AttackName
    Else If Value.Turn = 2 And Value.Stage = 2 Then
        Name = "Run"
    Else If (Value.Turn <> 2 And
        (Value.Turn <> MiraBattle.PARTY_TURN Or Value.AttackCycle Mod 3 = 0) And
        Value.Stage = 1 And
        Value.Elapsed >= HeroImpactTime(HeroAttackMilliseconds, Value.Turn)) Then
        Name = "Hit"
    End If

    If Boss.Clip = "Hit" And Character3D.AnimationTime(Boss.Actor) < HitMilliseconds Then
        Name = "Hit"
    End If

    If Value.PreviewActive Then
        Name = Boss.Clip
    End If

    Position = VraxPosition(Value)
    Target = Value.Second.Home

    If Value.Turn = 2 Then
        Target = HomePosition(Value, Value.HitTarget)
    End If

    Boss.Frame.PositionX = Position.X
    Boss.Frame.PositionZ = Position.Z
    Result = Character3D.PlacePrecise(Boss.Actor, Position.X,
        Boss.Frame.PositionY, Position.Z)
    Result = ViewerActors.FaceToward(Boss.Actor, Target.X, Target.Y, Target.Z,
        180, 0) And Result
    Result = ViewerDragon.UpdateVraxPreview(Boss, Name, BossPlaybackSpeed, Elapsed) And Result
    Target.Y = 65
    Result = NodeAim3D.Update(Boss.HeadAim, Boss.Actor, Target, Elapsed,
        Value.Turn = 2 And Not Value.PreviewActive) And Result

    Return Result

End Function

Public Function VraxPlaybackSpeed(PartyPlaybackSpeed As Number) As Number

    Dim Result As Number
    Dim VraxProfile As CharacterViewer.Profile

    VraxProfile = ViewerProfiles.ProfileAt(ViewerProfiles.PROFILE_VRAX)
    Result = Max(VraxProfile.MinimumPlaybackSpeed,
        Min(VraxProfile.MaximumPlaybackSpeed, PartyPlaybackSpeed))

    Return Result

End Function

Public Function ActorPlaybackSpeed(ByRef Value As State, Turn As Number,
    Fallback As Number) As Number

    Dim Result As Number

    Result = Fallback

    If (Value.UnityRoster And
        Turn >= 0 And
        Turn < 7) Then

        Result = Value.ActorSpeeds[Turn]

        If Result = 0 Then

            Result = 100

            If Turn = 0 Or Turn = 1 Then
                Result = 150
            End If

        End If

    End If

    Return Result

End Function

Public Sub AdjustActorSpeed(ByRef Value As State, Turn As Number, Amount As Number)

    If (Not Value.UnityRoster Or
        Turn < 0 Or
        Turn >= 7) Then
        Return
    End If

    Value.ActorSpeeds[Turn] = Max(25, Min(200, ActorPlaybackSpeed(Value, Turn, 100) + Amount))

End Sub

Private Sub DrawActorSpeed(ByRef Value As State, Turn As Number,
    Name As Text, X As Number, Y As Number)

    Draw Text Name At X, Y + 6 Size 11 Color CYAN
    Draw Number ActorPlaybackSpeed(Value, Turn, 100) At X + 34, Y + 6 Size 11 Color WHITE

    Call UI.DrawButton(X + 62, Y, 20, 24, "-", False)
    Call UI.DrawButton(X + 84, Y, 20, 24, "+", False)

End Sub

End Module
