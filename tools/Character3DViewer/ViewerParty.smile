Private Const BODY_PART_INDEX = 2

Public Const PARTY_VALOR_VISIBLE = False
Private Const POINTER_ACTOR_SPEED_BASE = 100
Public Const ESTABLISH_SPIN_MILLISECONDS = 2000
Public Const ESTABLISH_TOTAL_MILLISECONDS = 3000
Public Const HERO_APPROACH_DELAY_MILLISECONDS = 250
Public Const HERO_APPROACH_DURATION_MILLISECONDS = 300
Public Const HERO_ATTACK_START_MILLISECONDS = 550
Public Const HERO_ATTACK_HIT_PERCENT = 64
Public Const HERO_RETURN_DURATION_MILLISECONDS = 700
Private Const HERO_RETURN_END_MILLISECONDS = 1250
Private Const PUBLIC_HERO_TURN_TAIL_MILLISECONDS = 4000
Private Const UNITY_HERO_TURN_TAIL_MILLISECONDS = 2550
Private Const BOSS_ATTACK_START_MILLISECONDS = 650
Private Const BOSS_TURN_TAIL_MILLISECONDS = 3250
Public Const VRAX_APPROACH_START_MILLISECONDS = 650
Public Const VRAX_ATTACK_START_MILLISECONDS = 1450
Public Const VRAX_RETURN_MILLISECONDS = 800
Public Const HERO_CAMERA_BEAT_CLOSE_UP = 1
Public Const HERO_CAMERA_BEAT_APPROACH = 2
Public Const HERO_CAMERA_BEAT_ATTACK = 3
Public Const HERO_CAMERA_BEAT_IMPACT = 4
Public Const HERO_CAMERA_BEAT_AFTERMATH = 5

Public Const STATE_ALIVE = 0
Public Const STATE_ACTING = 1
Public Const STATE_GUARDING = 2
Public Const STATE_HIT = 3
Public Const STATE_KO = 4
Public Const STATE_REVIVING = 5
Public Const LIVE_PARTICIPANT_COUNT = 2
Public Const POINTER_ACTION_NONE = 0
Public Const POINTER_ACTION_RESET_VIEW = 1
Public Const POINTER_ACTION_RESET_INSPECTOR = 2
Public Const POINTER_ACTION_TOGGLE_GLOW = 3
Public Const POINTER_ACTION_CYCLE_SOCKET = 4
Public Const POINTER_ACTION_SPEED_DOWN = 5
Public Const POINTER_ACTION_SPEED_UP = 6
Public Const POINTER_ACTION_TOGGLE_DRAGON = 7
Public Const POINTER_ACTION_TOGGLE_SWORD = 8
Public Const POINTER_ACTION_TOGGLE_SHIELD = 9
Public Const POINTER_ACTION_TOGGLE_FLOOR = 10
Public Const POINTER_ACTION_CYCLE_BACKGROUND = 11
Public Const POINTER_ACTION_TOGGLE_PAUSE = 12
Public Const POINTER_ACTION_TOGGLE_ORBIT = 13
Public Const POINTER_ACTION_RESTART = 14
Public Const POINTER_ACTION_TOGGLE_FIRE = 15
Public Const POINTER_ACTION_TOGGLE_LIGHTNING = 16
Public Const POINTER_ACTION_TOGGLE_SHIELD_STYLE = 17
Public Const POINTER_ACTION_TOGGLE_FLOOR_REFLECTIONS = 18
Public Const POINTER_ACTION_TOGGLE_VFX_REFLECTIONS = 19

Public Type ParticipantLayout
    Home As Core.Vector3
    Approach As Core.Vector3
    FacingAdjustment As Number
End Type

