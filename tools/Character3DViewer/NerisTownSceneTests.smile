''' Authored Neris acceptance: real party, camera, doors, court and renderer.

Option Explicit

Import Smile.Tools.NerisTown As Town
Import Smile.Tools.NerisTownParty As Party
Import Smile.Tools.NerisTownMap As TownMap
Import Smile.Tools.NerisTownNavigation As Navigation
Import Smile.Tools.NerisTownCamera As Drone
Import Smile.Tools.NerisTownInspectionTests As InspectionTests
Import Smile.Tools.NerisCastlePreview As Castle
Import Smile.Tools.NerisCastleRoute As CastleRoute
Import Smile.Tools.TownEditorSession As Editor
Import Smile.Tools.TownEditor As Commands
Import Smile.Tools.TownDocument As Document
Import Smile.Tools.TownDocumentStore As Storage
Import Smile.Tools.TownStartingCamera As Starting
Import Smile.Tools.TownCatalogData As Catalog
Import Smile.Tools.TownCatalogFeatures As Features
Import Smile.Tools.TownGeometry As Geometry
Import Smile.Tools.TownAttachments As Attachments
Import Smile.Tools.Character3DViewerCalibration As Calibration
Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.PrecisionMath3D As Math3D
Import Smile.Simple3D.Character3D As Character
Import Smile.Simple3D.ArenaViewport3D As Arena
Import Smile.Simple3D.Graphics3D As G
Import Smile.Simple3D.Scene3D As Scene
Import Smile.Simple3D.FollowCamera3D As Follow
Import Smile.Simple3D.CameraClearance3D As Clearance

Dim Value As Town.State
Dim Fixture As Document.State
Dim Controls As Commands.State
Dim Leaves As Attachments.State
Dim Camera As P.Camera3D
Dim Leader As P.Vector3
Dim Feature As Features.Door
Dim Shape As Catalog.Template
Dim Index As Number
Dim MemberIndex As Number
Dim Failures As Number
Dim KeyTotal As Number
Dim Transfer As Number
Dim Deadline As Number
Dim SawFade As Boolean
Dim Ok As Boolean

Game Window "Neris Authored Scene Check" Size 1100 By 720

Transfer = Data_BundleStart(False, "TownEditor.PermanentNeris", "@NERIS_TOWN@", "")
Deadline = Timer() + 10000

Do
    Show Screen

Loop Until Data_FileStatus(Transfer) <> 0 Or Timer() >= Deadline

Ok = Storage.LoadDocument(Fixture, "TownEditor.PermanentNeris")

Call Check(Transfer > 0 And Data_FileStatus(Transfer) = 1 And Ok, "Accepted Authored Town Imports")
Call Commands.Start(Controls)

Ok = Editor.Available()

Call Check(Ok, "Authored Editor Bootstrap Is Available")
Call Town.Start(Value)
Call LoadTown()
Call Check(Value.Ready And Value.Edited And Not Value.Failed, "Authored Town And Party Load")

If Value.Ready And Not Value.Failed Then

    Camera = Starting.Frame(Fixture)

    Call Check(Value.Cinematic And Value.OverviewOrbit And Not Value.PartyCamera,
        "Authored Town Starts In Its Overview Orbit")

    If Fixture.HasInitialCamera Then
        Call Check(Math3D.Distance(Value.View.LiveCamera.Position, Camera.Position) < 0.01,
            "Overview Uses Authored Initial Camera")
    Else

        Leader = Editor.MapCenter()

        Call Check(Abs(Value.View.LiveCamera.Target.X - Leader.X) < 0.001 And
            Abs(Value.View.LiveCamera.Target.Z - Leader.Z) < 0.001,
            "Legacy Authored Document Without A Camera Fits Its Actual Map Center")
    End If

    Call Check(Value.People.Path.Positions[0].Z = -2780.0,
        "Accepted Town Keeps Its Authored Party Arrival")
    Call Town.ObserveDemoInput(Value, KEY_E)
    Call InspectionTests.Run(Value, Failures)
    Call CheckSpeed(Value)
    Call CheckDrone()
    Call CheckMinimap(Value)

    Call Check(Value.People.Members[0].IdleName = "TownIdle" And
        Character.HasClip(Value.People.Members[0].Body.Actor, "TownIdle"),
        "Arin Uses His Relaxed Town Standing Clip")

    Value.People.Keys.KeyBase = 0

    For Index = 0 To 10
        KeyTotal = KeyTotal + Calibration.KeyCount(Value.People.Keys, Index)
    End For

    Print "Arin Pose Keys " + Calibration.NumberText(KeyTotal)

    For MemberIndex = 0 To Value.People.MemberCount - 1
        Call Check(Character.HasClip(Value.People.Members[MemberIndex].Body.Actor, "Walk") And
            Character.HasClip(Value.People.Members[MemberIndex].Body.Actor, "Run"),
            "Each Current Character Has Real Locomotion Clips")
    End For

    Call Party.Teleport(Value.People, P.Vector(0.0, 23.12, -2780.0))

    Leader = Value.People.Path.Positions[0]

    For Index = 1 To 45
        Leader = Navigation.Move(Leader, Party.WalkingSpeed(Value.People) * 0.025, 0.0)

        Call Party.Update(Value.People, Leader, 25)
    End For

    For MemberIndex = 0 To Value.People.MemberCount - 1
        Call Check(Value.People.Members[MemberIndex].Visible, "Party Emerges On Authored Ground")
    End For

    For MemberIndex = 1 To Value.People.MemberCount - 1
        Call Check(Abs(Value.People.Path.Progress[0] - Value.People.Path.Progress[MemberIndex] -
            ToDouble(MemberIndex) * Value.People.Path.Spacing) < 0.001,
            "Followers Keep Spacing At Default Run Speed")
    End For

    Call Town.Input(Value, KEY_R, True)

    Leader = Navigation.Move(Leader, 1.0, 0.0)

    Call Party.Update(Value.People, Leader, 25)
    Call Check(Value.People.Members[0].Body.Clip = Value.People.Members[0].TravelClip And
        Value.People.Members[0].TravelName = "Walk", "Moving Run Transitions To Walk")
    Call Town.Input(Value, KEY_R, True)
    Call Party.Update(Value.People, Leader, 25)
    Call Check(Value.People.Members[0].Body.Clip = Value.People.Members[0].TravelClip And
        Value.People.Members[0].TravelName = "Run", "Settling Walk Can Switch Back To Run")

    For Index = 1 To 250

        Call Party.Update(Value.People, Leader, 25)

        For MemberIndex = 1 To Value.People.MemberCount - 1
            SawFade = SawFade Or (Value.People.Members[MemberIndex].Opacity > 0.0 And
                Value.People.Members[MemberIndex].Opacity < 100.0)

            Call Check(Math3D.Distance(Value.People.Path.Positions[MemberIndex], Leader) >= 13.999,
                "Gathering Followers Do Not Collide With Arin")
        End For
    End For

    Call Check(SawFade, "Followers Fade While Gathering")

    For MemberIndex = 0 To Value.People.MemberCount - 1
        Call Check(Value.People.Members[MemberIndex].Visible = (MemberIndex = 0),
            "Followers Hide After Gathering And Settling")
    End For

    Call CheckLeaderCycle(Value)
    Call Town.Update(Value, 16)
    Call Town.Draw(Value)
    Call Town.Overlay(Value)
    Call Check(Not Value.Failed And Value.People.Ready, "Authored Scene And Overlay Render")
    Call CheckCastleRender(Value)

    Show Screen

End If

Call Town.Destroy(Value)

' Test real authored door metadata with the reusable attachment owner after releasing the scene.
Ok = Attachments.Create(Leaves)

Call Check(Ok, "Authored Door Resources Load")

For Index = 0 To Fixture.ItemCount - 1

    Shape = Catalog.TemplateAt(Fixture.Items[Index].Template)

    If Fixture.Items[Index].Active And Shape.DoorCount > 0 Then

        Feature = Features.DoorAt(Fixture.Items[Index].Template, 0)
        Leader = Geometry.ToWorld(Fixture.Items[Index], Feature.Position)

        Call Attachments.Update(Leaves, Fixture, Leader, 750)
        Call Check(Leaves.Ready And Leaves.Angles[Index * 4] = 90.0,
            "Authored Door Opens On Approach")
        Call Attachments.Update(Leaves, Fixture, P.Vector(50000.0, 23.0, 50000.0), 2000)
        Call Check(Leaves.Angles[Index * 4] = 0.0, "Authored Door Closes After Departure")

    End If

End For

Call Attachments.Destroy(Leaves)
Call Town.Start(Value)
Call LoadTown()
Call Check(Value.Ready And Value.Edited And Not Value.Failed,
    "Authored Scene Reloads Through Supported Preparation")
Call Town.Update(Value, 16)
Call Town.Draw(Value)
Call Check(Not Value.Failed, "Reloaded Authored Scene Renders")
Call Town.Destroy(Value)
Call Check(G.LiveMeshCount3D() = 0 And G.LiveMaterialCount3D() = 0 And
    G.LiveObjectCount3D() = 0, "Authored Scene Releases Owned Resources")

If Failures = 0 Then
    Print "PASS Neris Town Scene"
Else
    Print "FAIL Neris Town Scene"
End If

Sub CheckMinimap(ByRef Scene As Town.State)

    Call Check(TownMap.MapX(-1075.0, 0, 200) = 100 And TownMap.MapY(0.0, 0, 180) = 90,
        "Minimap Maps Town Center")
    Call Check(TownMap.MapY(400.0, 0, 180) < TownMap.MapY(-400.0, 0, 180),
        "Minimap Keeps North Up")
    Call Check(Scene.Map.Opacity = 0.0, "Minimap Starts Hidden")
    Call Check(TownMap.HeadingFrame(180.0) = 0 And TownMap.HeadingFrame(270.0) = 18 And
        TownMap.HeadingFrame(0.0) = 36 And TownMap.HeadingFrame(90.0) = 54,
        "Headlight Follows Actor Facing In All Four Map Directions")
    Call TownMap.Update(Scene.Map, True, 100)
    Call Check(Scene.Map.Opacity = 40.0, "Moving Minimap Fades In")
    Call TownMap.Update(Scene.Map, True, 100)
    Call Check(Scene.Map.Opacity = 80.0, "Minimap Maximum Opacity Is Eighty Percent")
    Call TownMap.Update(Scene.Map, False, 10000)
    Call Check(Scene.Map.Opacity = 80.0, "Stopped Minimap Holds For Ten Seconds")
    Call TownMap.Update(Scene.Map, False, 400)
    Call Check(Scene.Map.Opacity = 40.0, "Stopped Minimap Fades Out Gradually")
    Call TownMap.Update(Scene.Map, False, 400)
    Call Check(Scene.Map.Opacity = 0.0, "Stopped Minimap Disappears")
    Call TownMap.Update(Scene.Map, True, 200)
    Call TownMap.Update(Scene.Map, False, 9000)
    Call TownMap.Update(Scene.Map, True, 1)
    Call TownMap.Update(Scene.Map, False, 10400)
    Call Check(Scene.Map.Opacity = 40.0, "Movement Restarts Hold And Large Frames Fade Only Remaining Time")
    Call Town.Input(Value, KEY_M, True)
    Call TownMap.Update(Scene.Map, True, 200)
    Call Check(Scene.Map.Disabled And Scene.Map.Opacity = 0.0, "M Keeps Minimap Off While Moving")
    Call Town.Input(Value, KEY_M, True)
    Call Check(Not Scene.Map.Disabled And Scene.Map.Opacity = 80.0 And
        Scene.Map.HoldRemaining = 10000, "M Reveals Map And Restarts Ten Second Hold")
    Call TownMap.Update(Scene.Map, False, 12000)
    Call Check(Scene.Map.Opacity = 80.0, "Manually Shown Map Stays Visible Until M Hides It")

End Sub

Sub LoadTown()

    Dim Step As Number

    For Step = 0 To 180

        Call Town.LoadNext(Value)

        If Value.Ready Or Value.Failed Then
            Exit For
        End If

    End For

End Sub

Sub CheckLeaderCycle(ByRef Scene As Town.State)

    Dim Index As Number
    Dim MemberIndex As Number
    Dim Position As P.Vector3
    Dim ObjectsBefore As Number
    Dim ActorHandles[4] As Number

    Position = Scene.People.Path.Positions[0]
    ObjectsBefore = G.LiveObjectCount3D()

    For Index = 0 To 3
        ActorHandles[Index] = Scene.People.Members[Index].Body.Actor.Handle
    End For

    For Index = 1 To 4

        Call Party.CycleLeader(Scene.People)
        Call Check(Scene.People.Members[0].Body.Profile = Party.ProfileAt(Index Mod 4),
            "Leader Cycles Arin Orin Zara Mira And Wraps")
        Call Check(Math3D.Length(Math3D.Subtract(Scene.People.Path.Positions[0], Position)) < 0.001,
            "Leader Change Preserves The Party Location")
        Call Check(Scene.People.Members[0].Visible And Scene.People.Members[0].Opacity = 100.0,
            "Selected Leader Is Visible Even When Followers Were Hidden")

        For MemberIndex = 0 To 3
            Call Check(Scene.People.Members[MemberIndex].Body.Actor.Handle =
                ActorHandles[(Index + MemberIndex) Mod 4], "Leader Change Preserves Every Actor Identity")
        End For
    End For

    Call Check(Scene.People.Ready And G.LiveObjectCount3D() = ObjectsBefore,
        "Cycling Reuses Loaded Actors And Their Calibration")

End Sub

Sub CheckSpeed(ByRef Scene As Town.State)

    Dim StepIndex As Number

    Call Check(Scene.People.SpeedPercent = 200 And Scene.People.Running And
        Abs(Party.WalkingSpeed(Scene.People) - 560.0 / 3.0) < 0.001,
        "Default Run Is Two Hundred Percent")
    Call Town.Input(Scene, KEY_W, True)
    Call Check(Scene.People.Running, "W Movement Does Not Switch Run To Walk")
    Call Town.Input(Scene, KEY_R, True)
    Call Check(Not Scene.People.Running And
        Abs(Party.WalkingSpeed(Scene.People) - 560.0 / 9.0) < 0.001,
        "Walk Is One Third Of Run Speed")
    Call Town.Input(Scene, KEY_W, True)
    Call Check(Not Scene.People.Running, "W Movement Preserves Selected Walk Mode")
    Call Town.Input(Scene, KEY_R, True)
    Call Check(Scene.People.Running, "R Toggles Back From Walk To Run")
    Call Town.Input(Scene, KEY_PLUS, True)
    Call Check(Scene.People.SpeedPercent = 225, "Plus Speeds Up Locomotion")
    Call Town.Input(Scene, KEY_MINUS, True)
    Call Check(Scene.People.SpeedPercent = 200, "Minus Slows Down Locomotion")

    For StepIndex = 1 To 20
        Call Town.Input(Scene, KEY_MINUS, True)
    End For

    Call Check(Scene.People.SpeedPercent = 25, "Walking Speed Has A Positive Lower Bound")

    For StepIndex = 1 To 20
        Call Town.Input(Scene, KEY_PLUS, True)
    End For

    Call Check(Scene.People.SpeedPercent = 400, "Walking Speed Has An Upper Bound")

    For StepIndex = 1 To 8
        Call Town.Input(Scene, KEY_MINUS, True)
    End For

End Sub

Sub CheckDrone()

    Dim World As Clearance.World
    Dim Flight As Follow.State
    Dim Desired As P.Camera3D
    Dim Displayed As P.Camera3D
    Dim Previous As P.Vector3
    Dim StepIndex As Number
    Dim DroneState As Drone.State
    Dim Leader As P.Vector3

    World.BoxCount = 1
    World.Boxes[0] = Clearance.Box(-50.0, 0.0, -50.0, 50.0, 300.0, 50.0)
    Desired.Target = P.Vector(0.0, 40.0, -160.0)
    Desired.Position = P.Vector(0.0, 120.0, 150.0)

    Call Check(Clearance.Fraction(World, Desired.Target, Desired.Position, 18.0) < 1.0,
        "Camera Sweeps Detect A Building Between Party And Eye")
    Call Follow.Reset(Flight, P.Vector(-180.0, 120.0, 100.0))

    For StepIndex = 1 To 100

        Previous = Flight.Position
        Displayed = Follow.Update(Flight, World, Desired, 16, 18.0)

        Call Check(Clearance.IsClear(World, Displayed.Position, 18.0),
            "Drone Remains Outside Building Bounds")
        Call Check(Math3D.Distance(Previous, Displayed.Position) < 4.5,
            "Avoidable Camera Motion Remains Smooth")
    End For

    Call Check(Flight.Avoiding And Clearance.Fraction(World, Desired.Target,
        Displayed.Position, 18.0, True) > 0.999, "Drone Finds A Clear View Around Building")

    Leader = P.Vector(-1160.0, 23.12, 1800.0)
    DroneState.Yaw = 180.0
    DroneState.Enabled = True

    For StepIndex = 1 To 180
        Displayed = Drone.Frame(DroneState, Desired, Leader, 180.0, False, 16)
    End For

    Call Check(Math3D.Distance(Displayed.Position, Leader) < 110.0,
        "Castle Grounds Use A Close Trailing Distance")

    Leader = P.Vector(0.0, Navigation.GroundHeight(0.0, 405.0), 405.0)
    DroneState.CloseAmount = 1.0
    Displayed = Drone.Frame(DroneState, Desired, Leader, 180.0, False, 16)

    Call Check(Displayed.Target.Z > Displayed.Position.Z And
        Displayed.Target.Y > Displayed.Position.Y, "Close Drone Looks North And Up The Stairs")

    Call Check(Abs(Drone.BoundaryYaw(P.Vector(-4800.0, 0.0, 2200.0), 90.0) + 90.0) < 0.001,
        "West Boundary Places Drone Outside Looking Into Town")
    Call Check(Abs(Drone.BoundaryYaw(P.Vector(0.0, 0.0, 3370.0), 180.0)) < 0.001,
        "North Boundary Reverses The Camera To Look Into Town")

End Sub

Sub Check(Condition As Boolean, Label As Text)

    If Not Condition Then
        Failures = Failures + 1
        Print "FAIL " + Label
    End If

End Sub

Sub CheckCastleRender(ByRef Value As Town.State)

    Dim Part As Number
    Dim Pose As P.Transform3D
    Dim Step As Number
    Dim BeforeTime As Number
    Dim Ok As Boolean

    Ok = Value.Comparison.Ready

    Call CastleRoute.Enable(Ok)

    Print "Castle Parts " + Calibration.NumberText(Value.Comparison.ObjectCount)
    Print "Castle Moving Parts " + Calibration.NumberText(Value.Comparison.LeafCount)

    Call Check(Value.Comparison.Light.Ready, "Castle Crystal And Lamp Halos Initialize")
    Call Check(Value.Comparison.Water.Ready And Value.Comparison.Water.Basins.PointCount = 134 And
        Value.Comparison.Water.Streams.PointCount = 1208,
        "All Fountain Basins Jets And Rings Accept Normalized Ribbon Coordinates")

    BeforeTime = Value.Comparison.Water.Time

    Call Castle.Update(Value.Comparison, 600)
    Call Check(Value.Comparison.Water.Ready And Value.Comparison.Water.Time = BeforeTime + 600,
        "Fountain Animation Advances Without Invalidating Its Resources")
    Call Check(Ok And Value.Comparison.ObjectCount = 98 And Value.Comparison.LeafCount = 7,
        "Detailed West Castle Loads 85 Static Parts, Seven Bridge Parts And Six Door Parts")
    Call DrawCastleCheck(Value)

    For Part = Value.Comparison.Leaf To Value.Comparison.Leaf + Value.Comparison.LeafCount - 1

        Ok = P.TryTransform(Value.Comparison.Objects[Part], Pose)

        Call Check(Ok And Pose.Rotation.X = 90.0, "Native Bridge Mesh Starts Upright At Its Real Hinge")
        Call Check(Abs(Pose.Position.X - CastleRoute.CenterX()) < 0.001 And
            Abs(Pose.Position.Y - 20.87) < 0.001 And Abs(Pose.Position.Z - CastleRoute.CenterZ() + 64.0 * CastleRoute.SCALE) < 0.001,
            "Native Hinge Includes Twenty Centimetres Of Road Clearance")
    End For

    Call Party.Teleport(Value.People, P.Vector(CastleRoute.CenterX(), CastleRoute.DECK_Y, CastleRoute.CenterZ() - 1558.0))

    For Step = 1 To 30
        Call CastleRoute.Update(Value.People.Path, Value.People.MemberCount, 100)
    End For

    Call DrawCastleCheck(Value)

    For Part = Value.Comparison.Leaf To Value.Comparison.Leaf + Value.Comparison.LeafCount - 1
        Ok = P.TryTransform(Value.Comparison.Objects[Part], Pose)

        Call Check(Ok And Pose.Rotation.X = 0.0 And Not Value.Failed,
            "Actual Party Approach Draws The Fully Lowered Native Leaf")
    End For

    Call Party.Teleport(Value.People, P.Vector(0.0, 23.12, -2780.0))

    For Step = 1 To 55
        Call CastleRoute.Update(Value.People.Path, Value.People.MemberCount, 100)
    End For

    Call DrawCastleCheck(Value)

    For Part = Value.Comparison.Leaf To Value.Comparison.Leaf + Value.Comparison.LeafCount - 1
        Ok = P.TryTransform(Value.Comparison.Objects[Part], Pose)

        Call Check(Ok And Pose.Rotation.X = 90.0 And Not Value.Failed,
            "Actual Party Departure Draws The Raised Native Leaf")
    End For

End Sub

Sub DrawCastleCheck(ByRef Value As Town.State)

    Dim Ok As Boolean

    Ok = Arena.BeginFrame(Value.View, Value.BaseCamera, True, False)
    Ok = Castle.Draw(Value.Comparison) And Ok
    Ok = Scene.EndScene() And Ok

    Call Check(Ok, "Castle And Animated Fountain Draw Within Native Resource Budgets")

End Sub
