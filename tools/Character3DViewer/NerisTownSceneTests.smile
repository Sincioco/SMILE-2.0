''' Native real-asset acceptance for loading, calibrated actors, gather and cleanup.

Option Explicit

Import Smile.Tools.NerisTown As Town
Import Smile.Tools.NerisTownParty As Party
Import Smile.Tools.NerisTownAssets As Assets
Import Smile.Tools.NerisTownNavigation As Navigation
Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.PrecisionMath3D As Math3D
Import Smile.Simple3D.Character3D As Character
Import Smile.Simple3D.ArenaCamera3D As Motion
Import Smile.Simple3D.ArenaViewport3D As Arena
Import Smile.Simple3D.Graphics3D As G
Import Smile.Tools.Character3DViewerCalibration As Calibration
Import Smile.Tools.NerisTownTrees As Trees
Import Smile.Tools.NerisTownMap As TownMap
Import Smile.Tools.NerisTownCamera As Drone
Import Smile.Simple3D.FollowCamera3D As Follow
Import Smile.Simple3D.CameraClearance3D As Clearance
Import Smile.Tools.NerisTownSite As Site
Import Smile.Tools.NerisTownLayout As Layout
Import Smile.Tools.NerisTownEntrances As Doors
Import Smile.Tools.NerisTownEntrancesData As DoorData
Import Smile.Tools.NerisTownInspectionTests As InspectionTests

Dim Value As Town.State
Dim Leader As P.Vector3
Dim Index As Number
Dim MemberIndex As Number
Dim Failures As Number
Dim KeyTotal As Number
Dim SawFade As Boolean

Game Window "Neris Town Asset Check" Size 1100 By 720

Call Town.Start(Value)

For Index = 0 To Assets.CHUNK_COUNT + 6
    Call Town.LoadNext(Value)
End For

Call Check(Value.Ready And Not Value.Failed, "All Town And Character Assets Load")
Call Check(Value.Town.Loaded = Assets.CHUNK_COUNT, "Every Town Chunk Loads")

Print "Chunks " + Calibration.NumberText(Value.Town.Loaded) + " Stage " + Calibration.NumberText(Value.Town.Stage) + " Error " + Calibration.NumberText(Value.Town.ErrorCode)
Print "Actors " + Calibration.NumberText(Value.People.Loaded) + " Error " + Calibration.NumberText(Character.LastError())
Print "Meshes " + Calibration.NumberText(G.LiveMeshCount3D()) + "/" + Calibration.NumberText(G.MaximumMeshCount3D())
Print "Materials " + Calibration.NumberText(G.LiveMaterialCount3D()) + "/" + Calibration.NumberText(G.MaximumMaterialCount3D())
Print "Load Town Geometry Ms " + Calibration.NumberText(Value.Town.GeometryMs[0])
Print "Load Town Materials Ms " + Calibration.NumberText(Value.Town.MaterialsMs[0])
Print "Load Tripo Geometry Ms " + Calibration.NumberText(Value.Town.GeometryMs[1])
Print "Load Tripo Materials Ms " + Calibration.NumberText(Value.Town.MaterialsMs[1])

Call Check(Value.View.Ready, "Town Arena Loads")
Call Check(Value.Look.Garden.Ready, "Town Trees And Leaves Load")
Call Check(Value.Look.Gems.Ready, "Town Crystal And Lamp Effects Load")
Call Check(Value.Look.Ready, "Town Water And Garden Resources Load")
Call Check(G.LiveMaterialCount3D() < G.MaximumMaterialCount3D(), "Complete Town Keeps Material Headroom")
Call Check(G.MaximumMaterialCount3D() >= 512, "Native Viewer Uses Expanded Material Capacity")
Call Check(G.MaximumMeshCount3D() >= 256, "Detailed Castle And Town Have Mesh Capacity")

If Value.Ready Then

    Call CheckCamera(Value)
    Call InspectionTests.Run(Value, Failures)
    Call CheckDrone()
    Call CheckSpeed(Value)
    Call CheckGarden(Value)
    Call Check(TownMap.MapX(-1075.0, 0, 200) = 100 And TownMap.MapY(0.0, 0, 180) = 90,
        "Minimap Maps Town Center")
    Call Check(TownMap.MapY(400.0, 0, 180) < TownMap.MapY(-400.0, 0, 180),
        "Minimap Keeps North Up")
    Call Check(Value.Map.Opacity = 0.0, "Minimap Starts Hidden")
    Call Check(TownMap.HeadingFrame(180.0) = 0 And TownMap.HeadingFrame(270.0) = 18 And
        TownMap.HeadingFrame(0.0) = 36 And TownMap.HeadingFrame(90.0) = 54,
        "Headlight Follows Actor Facing In All Four Map Directions")
    Call TownMap.Update(Value.Map, True, 100)
    Call Check(Value.Map.Opacity = 40.0, "Moving Minimap Fades In")
    Call TownMap.Update(Value.Map, True, 100)
    Call Check(Value.Map.Opacity = 80.0, "Minimap Maximum Opacity Is Eighty Percent")
    Call TownMap.Update(Value.Map, False, 10000)
    Call Check(Value.Map.Opacity = 80.0, "Stopped Minimap Holds For Ten Seconds")
    Call TownMap.Update(Value.Map, False, 400)
    Call Check(Value.Map.Opacity = 40.0, "Stopped Minimap Fades Out Gradually")
    Call TownMap.Update(Value.Map, False, 400)
    Call Check(Value.Map.Opacity = 0.0, "Stopped Minimap Disappears")
    Call TownMap.Update(Value.Map, True, 200)
    Call TownMap.Update(Value.Map, False, 9000)
    Call TownMap.Update(Value.Map, True, 1)
    Call TownMap.Update(Value.Map, False, 10400)
    Call Check(Value.Map.Opacity = 40.0, "Movement Restarts Hold And Large Frames Fade Only Remaining Time")
    Call Town.Input(Value, KEY_M, True)
    Call TownMap.Update(Value.Map, True, 200)
    Call Check(Value.Map.Disabled And Value.Map.Opacity = 0.0, "M Keeps Minimap Off While Moving")
    Call Town.Input(Value, KEY_M, True)
    Call Check(Not Value.Map.Disabled And Value.Map.Opacity = 80.0 And
        Value.Map.HoldRemaining = 10000, "M Reveals Map And Restarts Ten Second Hold")
    Call TownMap.Update(Value.Map, False, 12000)
    Call Check(Value.Map.Opacity = 80.0, "Manually Shown Map Stays Visible Until M Hides It")
    Call Check(Value.People.Members[0].IdleName = "TownIdle" And
        Character.HasClip(Value.People.Members[0].Body.Actor, "TownIdle"),
        "Arin Uses His Relaxed Town Standing Clip")

    Value.People.Keys.KeyBase = 0

    For Index = 0 To 10
        KeyTotal = KeyTotal + Calibration.KeyCount(Value.People.Keys, Index)
    End For

    Print "Arin Pose Keys " + Calibration.NumberText(KeyTotal)

    For MemberIndex = 0 To Value.People.MemberCount - 1

        Call Check(Value.People.Members[MemberIndex].Visible = (MemberIndex = 0),
            "Only Arin Visible Before Walking")
        Call Check(Character.HasClip(Value.People.Members[MemberIndex].Body.Actor,
            Value.People.Members[MemberIndex].TravelName), "Character Has Real Locomotion Animation")
        Call Check(Character.HasClip(Value.People.Members[MemberIndex].Body.Actor, "Walk") And
            Character.HasClip(Value.People.Members[MemberIndex].Body.Actor, "Run"),
            "Every Character Has Their Own Walk And Run")
    End For

    Leader = Value.People.Path.Positions[0]

    For Index = 1 To 45
        Leader = Navigation.Move(Leader, Party.WalkingSpeed(Value.People) * 0.025, 0.0)

        Call Party.Update(Value.People, Leader, 25)
    End For

    For MemberIndex = 0 To Value.People.MemberCount - 1
        Call Check(Value.People.Members[MemberIndex].Visible,
            "Every Party Member Emerges While Walking")
    End For

    For MemberIndex = 1 To Value.People.MemberCount - 1
        Call Check(Abs(Value.People.Path.Progress[0] - Value.People.Path.Progress[MemberIndex] -
            ToDouble(MemberIndex) * Value.People.Path.Spacing) < 0.001,
            "Followers Keep Spacing At Default Run Speed")
    End For

    Call Town.Input(Value, KEY_R, True)

    Leader = Navigation.Move(Leader, 1.0, 0.0)

    Call Party.Update(Value.People, Leader, 25)
    Call Check(Value.People.Members[0].Body.Clip = Value.People.Members[0].TravelClip And
        Value.People.Members[0].TravelName = "Walk", "Moving Run Transitions To Walk")
    Call Town.Input(Value, KEY_R, True)
    Call Party.Update(Value.People, Leader, 25)
    Call Check(Value.People.Members[0].Body.Clip = Value.People.Members[0].TravelClip And
        Value.People.Members[0].TravelName = "Run", "Settling Walk Can Switch Back To Run")

    For Index = 1 To 250

        Call Party.Update(Value.People, Leader, 25)

        For MemberIndex = 1 To Value.People.MemberCount - 1
            SawFade = SawFade Or (Value.People.Members[MemberIndex].Opacity > 0.0 And Value.People.Members[MemberIndex].Opacity < 100.0)

            Call Check(Math3D.Distance(Value.People.Path.Positions[MemberIndex], Leader) >= 13.999,
                "Stopped Followers Never Collide With Arin")
        End For
    End For

    Call Check(SawFade, "Followers Fade Gradually Before Hiding")

    For MemberIndex = 0 To Value.People.MemberCount - 1
        Call Check(Value.People.Members[MemberIndex].Visible = (MemberIndex = 0),
            "Followers Hide After Gathering And Settling")
    End For

    Call Town.Update(Value, 16)
    Call Town.Draw(Value)
    Call Check(G.LightValue3D(G.LIGHT_QUERY_DIRECTIONAL, 0, 8) = 2600 And
        G.LightValue3D(G.LIGHT_QUERY_AMBIENT, 0, 4) = 380 And
        G.LightValue3D(G.LIGHT_QUERY_LOCAL, 1, 11) = 4800 And
        G.LightValue3D(G.LIGHT_QUERY_LOCAL, 2, 11) = 4800 And
        G.LightValue3D(G.LIGHT_QUERY_LOCAL, 3, 11) = 4600,
        "Town Keeps Sun Ambient Fill And Dedicated Castle And Military Lights")
    Call Town.Overlay(Value)
    Call Check(Not Value.Failed And Value.People.Ready, "Town Renders With Shared Reflective Arena")
    Call Check(Value.Look.Ready And Value.Look.Time = 16,
        "Water Surface Clock Advances Independently Of Walking")
    Call Check(Value.Look.Surfaces[0].PointCount = Site.WATER_COUNT * 4,
        "All Waterfront Rectangles Have Native Water")

    For Index = 1 To Layout.FOUNTAIN_COUNT
        Call Check(Value.Look.Surfaces[Index].PointCount = 49, "Every Authored Fountain Has Native Water")
    End For

    Call Check(G.DistortionValue3D(G.DISTORTION_QUERY_EMITTERS) = Layout.FOUNTAIN_COUNT + 1 And
        G.DistortionValue3D(G.DISTORTION_QUERY_COMPOSITE_DRAWS) > 0,
        "Water Captures And Refracts The Town Scene")
    Call CheckDoors(Value)
    Call CheckLeaderCycle(Value)

    Show Screen

End If

Call Town.Destroy(Value)
Call Check(Not Value.Ready And Value.Town.ObjectCount = 0 And Value.People.Loaded = 0,
    "Town Releases Owned Resources")
Call Check(Value.Look.Water.Handle = 0 And Value.Look.Refraction.Handle = 0 And Value.Look.MoatWater.Handle = 0 And
    Value.Look.Surfaces[2].Handle = 0 And Value.Look.Distortion[2].Handle = 0,
    "Town Releases Water Materials And Surfaces")

If Failures = 0 Then
    Print "PASS Neris Town Scene"
Else
    Print "FAIL Neris Town Scene"
End If

Sub CheckLeaderCycle(ByRef Scene As Town.State)

    Dim Index As Number
    Dim MemberIndex As Number
    Dim Position As P.Vector3
    Dim ObjectsBefore As Number
    Dim ActorHandles[4] As Number

    Position = Scene.People.Path.Positions[0]
    ObjectsBefore = G.LiveObjectCount3D()

    For Index = 0 To 3
        ActorHandles[Index] = Scene.People.Members[Index].Body.Actor.Handle
    End For

    For Index = 1 To 4

        Call Party.CycleLeader(Scene.People)
        Call Check(Scene.People.Members[0].Body.Profile = Party.ProfileAt(Index Mod 4),
            "Leader Cycles Arin Orin Zara Mira And Wraps")
        Call Check(Math3D.Length(Math3D.Subtract(Scene.People.Path.Positions[0], Position)) < 0.001,
            "Leader Change Preserves The Party Location")
        Call Check(Scene.People.Members[0].Visible And Scene.People.Members[0].Opacity = 100.0,
            "Selected Leader Is Visible Even When Followers Were Hidden")

        For MemberIndex = 0 To 3
            Call Check(Scene.People.Members[MemberIndex].Body.Actor.Handle =
                ActorHandles[(Index + MemberIndex) Mod 4], "Leader Change Preserves Every Actor Identity")
        End For
    End For

    Call Check(Scene.People.Ready And G.LiveObjectCount3D() = ObjectsBefore,
        "Cycling Reuses Loaded Actors And Their Calibration")

End Sub

Sub CheckDoors(ByRef Scene As Town.State)

    Dim Index As Number
    Dim Item As DoorData.Door
    Dim Point As P.Vector3

    Call Check(Scene.Doors.Ready And Scene.Doors.ObjectCount = DoorData.DOOR_COUNT * 4,
        "All Authored Doors Share The Reusable Hinged Leaves")

    For Index = 0 To DoorData.DOOR_COUNT - 1

        Item = DoorData.DoorAt(Index)
        Point = Item.Position
        Point.X = Point.X + Item.RightZ * 3.0
        Point.Z = Point.Z - Item.RightX * 3.0

        Call Doors.Update(Scene.Doors, Point, 750)
        Call Check(Scene.Doors.Angles[Index] = 90.0, "Door Opens Inward On Approach")
        Call Check(Doors.ConsumeEntry(Scene.Doors) = Index, "Door Emits Its Entry Event")
        Call Doors.Update(Scene.Doors, Point, 16)
        Call Check(Doors.ConsumeEntry(Scene.Doors) = -1, "Door Does Not Repeat Entry Every Frame")
        Call Doors.Update(Scene.Doors, P.Vector(2800.0, 21.0, -3400.0), 2000)
        Call Check(Scene.Doors.Angles[Index] = 0.0, "Door Closes After Leaving")
    End For

End Sub

Sub CheckSpeed(ByRef Scene As Town.State)

    Dim StepIndex As Number

    Call Check(Scene.People.SpeedPercent = 200 And Scene.People.Running And
        Abs(Party.WalkingSpeed(Scene.People) - 560.0 / 3.0) < 0.001,
        "Default Run Is Two Hundred Percent")
    Call Town.Input(Scene, KEY_W, True)
    Call Check(Scene.People.Running, "W Movement Does Not Switch Run To Walk")
    Call Town.Input(Scene, KEY_R, True)
    Call Check(Not Scene.People.Running And
        Abs(Party.WalkingSpeed(Scene.People) - 560.0 / 9.0) < 0.001,
        "Walk Is One Third Of Run Speed")
    Call Town.Input(Scene, KEY_W, True)
    Call Check(Not Scene.People.Running, "W Movement Preserves Selected Walk Mode")
    Call Town.Input(Scene, KEY_R, True)
    Call Check(Scene.People.Running, "R Toggles Back From Walk To Run")
    Call Town.Input(Scene, KEY_PLUS, True)
    Call Check(Scene.People.SpeedPercent = 225, "Plus Speeds Up Locomotion")
    Call Town.Input(Scene, KEY_MINUS, True)
    Call Check(Scene.People.SpeedPercent = 200, "Minus Slows Down Locomotion")

    For StepIndex = 1 To 20
        Call Town.Input(Scene, KEY_MINUS, True)
    End For

    Call Check(Scene.People.SpeedPercent = 25, "Walking Speed Has A Positive Lower Bound")

    For StepIndex = 1 To 20
        Call Town.Input(Scene, KEY_PLUS, True)
    End For

    Call Check(Scene.People.SpeedPercent = 400, "Walking Speed Has An Upper Bound")

    For StepIndex = 1 To 8
        Call Town.Input(Scene, KEY_MINUS, True)
    End For

End Sub

Sub CheckCamera(ByRef Scene As Town.State)

    Dim Pointer As Motion.PointerInput
    Dim Changed As Boolean
    Dim Distance As Double

    Call Check(Scene.Flight.Enabled And Scene.Follow And Not Scene.PartyControl,
        "Town Starts With Arrival Framing And Inspection Keys")

    Call Town.Update(Scene, 0)
    Call Check(Scene.Flight.Arrival And Abs(Scene.View.LiveCamera.Position.X) < 0.001 And
        Scene.View.LiveCamera.Position.Z < Scene.People.Path.Positions[0].Z And
        Scene.View.LiveCamera.Target.Z > Scene.People.Path.Positions[0].Z And
        Abs(Scene.View.LiveCamera.Target.X) < 0.001,
        "Arrival Looks North Behind Arin Through The Kingdom Sign")
    Call Town.ResetOverview(Scene)

    Call Check(Scene.BaseCamera.NearPlane = 25.0,
        "Town Camera Preserves Depth Precision For Thin Paving Layers")
    Call Check(Scene.BaseCamera.FovDegrees = 32.0,
        "Town Uses A Natural Narrower Lens")
    Call Check(Not Scene.View.FloorVisible And Not Scene.View.GridVisible,
        "Town Floor And Grid Start Hidden")

    Pointer.OrbitPressed = True
    Pointer.OrbitHeld = True
    Pointer.DeltaX = 1
    Pointer.DeltaY = 1
    Changed = Motion.UpdatePointer(Scene.View.Controls, Scene.View.Zoom, Pointer,
        900.0, 550.0, Scene.View.WorldScale)

    Call Check(Changed And Scene.View.Controls.OrbitYaw = 1.0 And
        Scene.View.Controls.OrbitPitch = 1.0, "Slow Horizontal And Vertical Orbit")

    Pointer.OrbitPressed = False
    Pointer.DeltaX = 24
    Pointer.DeltaY = -16
    Changed = Motion.UpdatePointer(Scene.View.Controls, Scene.View.Zoom, Pointer,
        900.0, 550.0, Scene.View.WorldScale)

    Call Check(Changed And Scene.View.Controls.OrbitYaw = 25.0 And
        Scene.View.Controls.OrbitPitch = -15.0, "Moderate Horizontal And Vertical Orbit")
    Call Town.Input(Scene, KEY_O, True)
    Call Check(Scene.Cinematic And Not Scene.Follow And
        Scene.View.Controls.OrbitYaw = 25.0 And Scene.View.Controls.OrbitPitch = -15.0,
        "O Resumes Cinematic Overview Without Resetting Orbit")
    Call Town.ResetOverview(Scene)
    Call Check(Scene.View.Controls.OrbitYaw = 0.0 And
        Scene.View.Controls.Zoom = ToDouble(Motion.DEFAULT_ZOOM),
        "Right Click Reset Command Restores Default Overview")

    Scene.View.FloorVisible = False
    Scene.View.Controls.OrbitPitch = -75.0
    Scene.View.Controls.PanY = -550.0
    Scene.View.Controls.Zoom = -144.0

    Call Town.Update(Scene, 0)
    Call Check(Scene.View.LiveCamera.Position.Y > 25.0 And
        Scene.View.LiveCamera.Target.Y >= 24.999, "Overview Cannot Move Beneath Town With Floor Hidden")

    Scene.Follow = True
    Scene.View.Controls.OrbitPitch = -75.0
    Scene.View.Controls.PanY = -550.0

    Call Town.Update(Scene, 0)
    Call Check(Scene.View.LiveCamera.Position.Y > 25.0 And
        Scene.View.LiveCamera.Target.Y >= 24.999, "Follow Camera Cannot Move Beneath Town")
    Call Check(Scene.View.LiveCamera.FovDegrees = 32.0,
        "Following Retains The Town Lens")

    Scene.View.Controls.Zoom = ToDouble(Motion.ZOOM_OUT_LIMIT)

    Call Town.Update(Scene, 0)
    Call Check(Abs(Math3D.Length(Math3D.Subtract(Scene.View.LiveCamera.Position,
        Scene.View.LiveCamera.Target)) - 18000.0) < 0.01 And
        Scene.View.LiveCamera.FovDegrees = 32.0, "Tab Follow Can Zoom Out To Whole Town Without Wide Angle")

    Scene.Follow = False

    Call Town.Update(Scene, 0)
    Call Check(Abs(Math3D.Length(Math3D.Subtract(Scene.View.LiveCamera.Position,
        Scene.View.LiveCamera.Target)) - 18000.0) < 0.01,
        "Overview And Follow Share The Same Maximum Distance")

    Scene.Follow = True
    Scene.View.Controls.Zoom = -40.0

    Call Town.Update(Scene, 0)

    Distance = Math3D.Length(Math3D.Subtract(Scene.View.LiveCamera.Position, Scene.View.LiveCamera.Target))

    Call Town.StartOrbit(Scene)
    Call Town.Update(Scene, 0)
    Call Check(Abs(Math3D.Length(Math3D.Subtract(Scene.View.LiveCamera.Position,
        Scene.View.LiveCamera.Target)) - Distance) < 0.01, "O Preserves Current Follow Zoom Distance")

    Scene.Follow = True
    Scene.View.Controls.Zoom = 100.0

    Call Town.Update(Scene, 0)

    Distance = Math3D.Length(Math3D.Subtract(Scene.View.LiveCamera.Position, Scene.View.LiveCamera.Target))

    Call Town.StartOrbit(Scene)
    Call Town.Update(Scene, 0)
    Call Check(Abs(Math3D.Length(Math3D.Subtract(Scene.View.LiveCamera.Position,
        Scene.View.LiveCamera.Target)) - Distance) < 0.01, "O Preserves Zoomed Out Follow Distance")

    Scene.View.FloorVisible = True

    Call Town.Input(Scene, KEY_C, True)
    Call Town.Update(Scene, 0)

    Scene.Cinematic = True
    Scene.Follow = False
    Scene.View.Controls.PanX = 150.0
    Scene.View.Controls.Zoom = ToDouble(Motion.ZOOM_OUT_LIMIT)

    Call Town.OnMovement(Scene, True)
    Call Check(Not Scene.Follow And Not Scene.Cinematic And Scene.View.Controls.PanX = 150.0 And
        Scene.View.Controls.Zoom = ToDouble(Motion.ZOOM_OUT_LIMIT),
        "Movement Stops Orbit Without Changing Overview Framing")

    Scene.Follow = True
    Scene.View.Controls.PanX = 12.0

    Call Town.OnMovement(Scene, False)
    Call Town.OnMovement(Scene, True)
    Call Check(Scene.Follow And Scene.View.Controls.PanX = 12.0 And
        Scene.View.Controls.Zoom = ToDouble(Motion.ZOOM_OUT_LIMIT),
        "Restarting Movement Preserves User Selected Follow Framing")

    Scene.Flight.Enabled = False

    Call CheckTransition(Scene)

    Scene.Flight.Enabled = True

    Call Town.Input(Scene, KEY_C, True)
    Call Town.FitTown(Scene)
    Call Check(Scene.Cinematic And Not Scene.Follow,
        "Fit Keeps An Active Orbit Running")
    Call Arena.AdvanceTransition(Scene.View, 700)
    Call Town.Update(Scene, 0)
    Call Check(Math3D.Distance(Scene.View.LiveCamera.Position, Scene.View.LiveCamera.Target) > 12500.0,
        "Fit Encloses Both Castles And All Neighborhoods")

    Scene.Cinematic = False

    Call Town.FitTown(Scene)
    Call Check(Not Scene.Cinematic, "Fit Also Preserves A Stopped Orbit")

End Sub

Sub CheckDrone()

    Dim World As Clearance.World
    Dim Flight As Follow.State
    Dim Desired As P.Camera3D
    Dim Displayed As P.Camera3D
    Dim Previous As P.Vector3
    Dim StepIndex As Number
    Dim DroneState As Drone.State
    Dim Leader As P.Vector3

    World.BoxCount = 1
    World.Boxes[0] = Clearance.Box(-50.0, 0.0, -50.0, 50.0, 300.0, 50.0)
    Desired.Target = P.Vector(0.0, 40.0, -160.0)
    Desired.Position = P.Vector(0.0, 120.0, 150.0)

    Call Check(Clearance.Fraction(World, Desired.Target, Desired.Position, 18.0) < 1.0,
        "Camera Sweeps Detect A Building Between Party And Eye")
    Call Follow.Reset(Flight, P.Vector(-180.0, 120.0, 100.0))

    For StepIndex = 1 To 100

        Previous = Flight.Position
        Displayed = Follow.Update(Flight, World, Desired, 16, 18.0)

        Call Check(Clearance.IsClear(World, Displayed.Position, 18.0),
            "Drone Remains Outside Building Bounds")
        Call Check(Math3D.Distance(Previous, Displayed.Position) < 4.5,
            "Avoidable Camera Motion Remains Smooth")
    End For

    Call Check(Flight.Avoiding And Clearance.Fraction(World, Desired.Target,
        Displayed.Position, 18.0, True) > 0.999, "Drone Finds A Clear View Around Building")

    Leader = P.Vector(-1160.0, 23.12, 1800.0)
    DroneState.Yaw = 180.0
    DroneState.Enabled = True

    For StepIndex = 1 To 180
        Displayed = Drone.Frame(DroneState, Desired, Leader, 180.0, False, 16)
    End For

    Call Check(Math3D.Distance(Displayed.Position, Leader) < 110.0,
        "Castle Grounds Use A Close Trailing Distance")

    Leader = P.Vector(0.0, Navigation.GroundHeight(0.0, 405.0), 405.0)
    DroneState.CloseAmount = 1.0
    Displayed = Drone.Frame(DroneState, Desired, Leader, 180.0, False, 16)

    Call Check(Displayed.Target.Z > Displayed.Position.Z And
        Displayed.Target.Y > Displayed.Position.Y, "Close Drone Looks North And Up The Stairs")

    Call Check(Abs(Drone.BoundaryYaw(P.Vector(-4800.0, 0.0, 2200.0), 90.0) + 90.0) < 0.001,
        "West Boundary Places Drone Outside Looking Into Town")
    Call Check(Abs(Drone.BoundaryYaw(P.Vector(0.0, 0.0, 3370.0), 180.0)) < 0.001,
        "North Boundary Reverses The Camera To Look Into Town")

End Sub

Sub CheckTransition(ByRef Scene As Town.State)

    Dim StartView As P.Camera3D
    Dim EndView As P.Camera3D
    Dim HalfView As P.Camera3D
    Dim StartDistance As Double
    Dim HalfDistance As Double

    Call Town.ResetOverview(Scene)
    Call Town.Update(Scene, 0)

    StartView = Scene.View.LiveCamera
    StartDistance = Math3D.Length(Math3D.Subtract(StartView.Position, StartView.Target))

    Call Town.Input(Scene, KEY_TAB, True)

    Call Check(Scene.View.TransitionDuration = 1000 And Scene.Flight.Yaw = 180.0 And
        Not Scene.Cinematic, "Tab Uses One Second And Faces North After Orbit")

    Scene.View.TransitionElapsed = 0

    Call Town.Update(Scene, 0)
    Call Check(Scene.Follow And Math3D.Length(Math3D.Subtract(
        StartView.Position, Scene.View.LiveCamera.Position)) < 0.001,
        "Tab Starts At The Displayed Camera Without Snapping")
    Call Arena.AdvanceTransition(Scene.View, 500)
    Call Town.Update(Scene, 0)

    HalfView = Scene.View.LiveCamera
    HalfDistance = Math3D.Length(Math3D.Subtract(HalfView.Position, HalfView.Target))

    Call Check(HalfDistance < StartDistance And HalfDistance > 530.0 And
        HalfView.Position.Y > 25.0 And HalfView.FovDegrees = 32.0,
        "Tab Eases Distance And Target With A Fixed Lens")
    Call Arena.ComposeCamera(Scene.View, Scene.BaseCamera)
    Call Check(Math3D.Length(Math3D.Subtract(HalfView.Position,
        Scene.View.LiveCamera.Position)) < 0.001, "Drawing Does Not Advance Or Snap Transition")
    Call Arena.AdvanceTransition(Scene.View, 500)
    Call Town.Update(Scene, 0)

    EndView = Scene.View.LiveCamera

    Call Check(Scene.View.TransitionDuration = 0 And
        Math3D.Length(Math3D.Subtract(EndView.Position, EndView.Target)) < 533.0,
        "Tab Reaches The Party View After One Second")
    Call Check(EndView.Target.Z > EndView.Position.Z And EndView.Target.Y > EndView.Position.Y,
        "Tab Ends In A North-Facing Horizon Shot")

    StartView = EndView
    StartView.Position.X = StartView.Target.X - (EndView.Position.X - EndView.Target.X)
    StartView.Position.Z = StartView.Target.Z - (EndView.Position.Z - EndView.Target.Z)
    HalfView = Motion.BlendFraming(StartView, EndView, 0.5)

    Call Check(Math3D.Length(Math3D.Subtract(HalfView.Position, HalfView.Target)) > 350.0,
        "Opposing Camera Views Ease Around The Subject Instead Of Through It")
    Call Town.Input(Scene, KEY_TAB, True)
    Call Check(Scene.Follow And Scene.View.TransitionDuration > 0,
        "Tab Refocuses Behind Arin Without Switching To Overview")
    Call Town.ResetOverview(Scene)
    Call Check(Scene.View.TransitionDuration = 0, "Explicit Overview Reset Cancels Easing")

End Sub

Sub CheckGarden(ByRef Scene As Town.State)

    Dim Index As Number
    Dim ObjectsBefore As Number
    Dim Ok As Boolean

    ObjectsBefore = G.LiveObjectCount3D()

    For Index = 0 To 84
        Call Trees.Update(Scene.Look.Garden, 1000)
        Call Check(Scene.Look.Garden.FadingCount <= 1, "Only One Fallen Leaf Fades At A Time")
    End For

    Call Check(Scene.Look.Garden.Ready And G.LiveObjectCount3D() = ObjectsBefore,
        "Two Leaf Recycling Cycles Allocate No New Objects")
    Call Check(Abs(Trees.Breeze(12.0, 0)) > 0.1 And Abs(Trees.Breeze(3.0, 0)) < 1.16,
        "Tree Breezes Continue Regularly Within Gentle Bounds")

    Ok = G.SetEffectMaterialWater3D(Scene.Look.Water, True, 32, 0, 0, -1)

    Call Check(Not Ok, "Water Rejects Negative Ripple Strength")

    Ok = G.SetEffectMaterialWater3D(Scene.Look.Water, True, 32, 0, 0, 101)

    Call Check(Not Ok, "Water Rejects Excessive Ripple Strength")

    Ok = G.SetEffectMaterialWater3D(Scene.Look.Water, True, 32, 0, 0, 0)

    Call Check(Ok, "Water Supports Still Surfaces")

    Ok = G.SetEffectMaterialWater3D(Scene.Look.Water, True, 32, 0, 0)

    Call Check(Ok, "Existing Water Calls Retain Full Strength By Default")

End Sub

Sub Check(Condition As Boolean, Label As Text)

    If Not Condition Then
        Failures = Failures + 1
        Print "FAIL " + Label
    End If

End Sub
