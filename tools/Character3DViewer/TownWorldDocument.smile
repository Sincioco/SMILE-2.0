''' Linked-world authoring data: up to seventeen saved town references and their routes.
Module Smile.Tools.TownWorldDocument

Option Explicit

Public Const MAX_NODES = 17
Public Const MAX_COORDINATE = 10000

Public Type Node
    Town As Text
    X As Number
    Y As Number
End Type

Public Type State
    Name As Text
    Nodes[17] As Node
    NodeCount As Number
    Links[17, 17] As Boolean
    Ports[17, 17] As Number
End Type

Private Dim Bytes[8192] As Number
Private Dim Offset As Number
Private Dim Length As Number
Private Dim Valid As Boolean
Private Dim Candidate As State

Private Sub Put(Value As Number)

    Dim Index As Number

    For Index = 0 To 2
        Bytes[Offset] = Value Mod 256
        Value = Value / 256
        Offset = Offset + 1
    End For

End Sub

Private Function ReadInteger() As Number

    Dim Value As Number

    If Offset + 3 > Length Then
        Valid = False
        Return 0
    End If

    Value = Bytes[Offset] + Bytes[Offset + 1] * 256 + Bytes[Offset + 2] * 65536
    Offset = Offset + 3

    Return Value

End Function

Private Sub PutName(Value As Text)

    Dim Index As Number

    Call Put(Text_Length(Value))

    For Index = 0 To Text_Length(Value) - 1
        Call Put(Text_Code_At(Value, Index))
    End For

End Sub

Private Function GetName() As Text

    Dim Result As Text
    Dim NameLength As Number
    Dim Index As Number
    Dim Code As Number

    NameLength = ReadInteger()

    If NameLength < 1 Or NameLength > 80 Then
        Valid = False
        Return ""
    End If

    For Index = 0 To NameLength - 1

        Code = ReadInteger()

        If (Code < 32 Or
            Code > 1114111 Or
            (Code >= 55296 And Code <= 57343)) Then
            Valid = False
            Return ""
        End If

        Result = Result + Text_From_Code(Code)
    End For

    Return Result

End Function

Public Function Add(ByRef Value As State, Name As Text, X As Number, Y As Number) As Boolean

    Dim Index As Number

    If (Value.NodeCount >= MAX_NODES Or
        Text_Length(Name) < 1 Or
        Text_Length(Name) > 80) Then
        Return False
    End If

    For Index = 0 To Value.NodeCount - 1

        If Value.Nodes[Index].Town = Name Then
            Return False
        End If

    End For

    Value.Nodes[Value.NodeCount].Town = Name
    Value.Nodes[Value.NodeCount].X = Max(0, Min(MAX_COORDINATE, X))
    Value.Nodes[Value.NodeCount].Y = Max(0, Min(MAX_COORDINATE, Y))
    Value.NodeCount = Value.NodeCount + 1

    Return True

End Function

Public Sub Remove(ByRef Value As State, Selected As Number)

    Dim Index As Number
    Dim Other As Number

    If Selected < 0 Or Selected >= Value.NodeCount Then
        Return
    End If

    For Index = Selected To Value.NodeCount - 2

        Value.Nodes[Index] = Value.Nodes[Index + 1]

        For Other = 0 To Value.NodeCount - 1
            Value.Links[Index, Other] = Value.Links[Index + 1, Other]
            Value.Ports[Index, Other] = Value.Ports[Index + 1, Other]
        End For
    End For

    For Index = 0 To Value.NodeCount - 1

        For Other = Selected To Value.NodeCount - 2
            Value.Links[Index, Other] = Value.Links[Index, Other + 1]
            Value.Ports[Index, Other] = Value.Ports[Index, Other + 1]
        End For

        Value.Links[Index, Value.NodeCount - 1] = False
        Value.Links[Value.NodeCount - 1, Index] = False
        Value.Ports[Index, Value.NodeCount - 1] = 0
        Value.Ports[Value.NodeCount - 1, Index] = 0
    End For

    Value.NodeCount = Value.NodeCount - 1

End Sub

Public Function SaveWorld(ByRef Value As State, Optional Key As Text = "") As Boolean

    Dim Index As Number
    Dim Other As Number
    Dim Status As Number
    Dim Result As Boolean

    If (Text_Length(Value.Name) < 1 Or
        Text_Length(Value.Name) > 80 Or
        Value.NodeCount > MAX_NODES) Then
        Return False
    End If

    Offset = 0

    Call Put(2)
    Call PutName(Value.Name)
    Call Put(Value.NodeCount)

    For Index = 0 To Value.NodeCount - 1
        Call PutName(Value.Nodes[Index].Town)
        Call Put(Value.Nodes[Index].X)
        Call Put(Value.Nodes[Index].Y)
    End For

    For Index = 0 To Value.NodeCount - 1

        For Other = 0 To Value.NodeCount - 1

            If Value.Links[Index, Other] Then
                Call Put(1)
            Else

                Call Put(0)
            End If

            Call Put(Value.Ports[Index, Other])
        End For
    End For

    If Key = "" Then
        Key = "TownEditor.World." + Value.Name
    End If

    Save Data Bytes Count Offset To Key Status Status
    Result = Status = DATA_STATUS_OK

    If Result And Key = "TownEditor.World." + Value.Name Then
        Save Data Bytes Count Offset To "TownEditor.World.Last" Status Status
        Result = Status = DATA_STATUS_OK
    End If

    Return Result

End Function

Public Function LoadWorld(ByRef Value As State, Name As Text, Optional Key As Text = "") As Boolean

    Dim Empty As State
    Dim Index As Number
    Dim Other As Number
    Dim Status As Number
    Dim Link As Number
    Dim Version As Number

    If Key = "" Then
        Key = "TownEditor.World." + Name
    End If

    Load Data Key Into Bytes Count Length Status Status

    If Status <> DATA_STATUS_OK Then
        Return False
    End If

    Candidate = Empty
    Offset = 0
    Valid = True

    Version = ReadInteger()

    If Version <> 1 And Version <> 2 Then
        Return False
    End If

    Candidate.Name = GetName()
    Candidate.NodeCount = ReadInteger()

    If ((Name <> "" And Candidate.Name <> Name) Or
        Candidate.NodeCount < 0 Or
        Candidate.NodeCount > MAX_NODES) Then
        Return False
    End If

    For Index = 0 To Candidate.NodeCount - 1

        Candidate.Nodes[Index].Town = GetName()
        Candidate.Nodes[Index].X = ReadInteger()
        Candidate.Nodes[Index].Y = ReadInteger()

        If (Candidate.Nodes[Index].X > MAX_COORDINATE Or
            Candidate.Nodes[Index].Y > MAX_COORDINATE) Then
            Return False
        End If

    End For

    For Index = 0 To Candidate.NodeCount - 1

        For Other = 0 To Candidate.NodeCount - 1

            Link = ReadInteger()

            If Link > 1 Then
                Return False
            End If

            Candidate.Links[Index, Other] = Link = 1

            If Version = 2 Then

                Candidate.Ports[Index, Other] = ReadInteger()

                If Candidate.Ports[Index, Other] > 3 Then
                    Return False
                End If

            Else If Candidate.Nodes[Other].X >= Candidate.Nodes[Index].X Then

                Candidate.Ports[Index, Other] = 2

            End If

        End For
    End For

    If Not Valid Or Offset <> Length Then
        Return False
    End If

    For Index = 0 To Candidate.NodeCount - 1

        For Other = 0 To Candidate.NodeCount - 1
            Candidate.Links[Index, Other] = False
            Candidate.Ports[Index, Other] = 0
        End For
    End For

    Value = Candidate

    Return True

End Function

End Module
