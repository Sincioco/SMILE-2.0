''' Exterior collision and paving height, in arena world units.
Module Smile.Tools.NerisTownNavigation

Option Explicit

Import Smile.Simple3D.Precision3D As P
Import Smile.Tools.NerisTownDistricts As Districts
Import Smile.Tools.NerisTownLayout As Layout
Import Smile.Tools.NerisTownSite As Site
Import Smile.Tools.NerisTownEntranceNavigation As Entries
Import Smile.Tools.NerisTownEntrancesData As DoorData
Import Smile.Tools.TownDocumentNavigation As Edited

Public Function CanStand(X As Double, Z As Double) As Boolean

    Dim ReturnValue As Boolean

    Dim Index As Number
    Dim Tree As Layout.Placement

    If Edited.Active() Then
        ReturnValue = Edited.CanStand(X, Z)

        Return ReturnValue
    End If

    If Not Districts.CanStand(X, Z) Then
        Return False
    End If

    If Entries.DoorwayAt(X, Z) >= 0 Or Entries.SurfaceHeight(X, Z) > -9000.0 Then
        Return True
    End If

    For Index = 0 To Site.SOLID_COUNT - 1

        If Site.Contains(Site.SolidAt(Index), X, Z, 3.0) Then
            Return False
        End If

    End For

    For Index = 0 To Layout.TREE_COUNT - 1

        Tree = Layout.TreeAt(Index)

        If Abs(X - Tree.Position.X) < 8.0 And Abs(Z - Tree.Position.Z) < 8.0 Then
            Return False
        End If

    End For

    Return True

End Function

Public Function GroundHeight(X As Double, Z As Double) As Double

    Dim Result As Double
    Dim Door As Number
    Dim Item As DoorData.Door

    If Edited.Active() Then
        Result = Edited.GroundHeight(X, Z)

        Return Result
    End If

    Result = Max(Districts.GroundHeight(X, Z), Entries.SurfaceHeight(X, Z))
    Door = Entries.DoorwayAt(X, Z)

    If Door >= 0 Then

        Item = DoorData.DoorAt(Door)

        If Entries.Along(Item, X, Z) >= -1.0 Then
            Result = Max(Result, Item.Position.Y)
        End If

    End If

    Return Result

End Function

''' Substeps prevent tunnelling; axis sliding keeps building edges comfortable.
Public Function Move(Position As P.Vector3, DeltaX As Double, DeltaZ As Double) As P.Vector3

    Dim Index As Number
    Dim Steps As Number
    Dim Result As P.Vector3

    Result = Position
    Steps = Max(1, ToNumber(Ceiling(Max(Abs(DeltaX), Abs(DeltaZ)) / 2.0)))

    For Index = 1 To Steps

        If (CanStand(Result.X + DeltaX / ToDouble(Steps), Result.Z) And
            GroundHeight(Result.X + DeltaX / ToDouble(Steps), Result.Z) <= Result.Y + 12.0) Then
            Result.X = Result.X + DeltaX / ToDouble(Steps)
            Result.Y = GroundHeight(Result.X, Result.Z)
        End If

        If (CanStand(Result.X, Result.Z + DeltaZ / ToDouble(Steps)) And
            GroundHeight(Result.X, Result.Z + DeltaZ / ToDouble(Steps)) <= Result.Y + 12.0) Then
            Result.Z = Result.Z + DeltaZ / ToDouble(Steps)
            Result.Y = GroundHeight(Result.X, Result.Z)
        End If

    End For

    Result.Y = GroundHeight(Result.X, Result.Z)

    Return Result

End Function

End Module
