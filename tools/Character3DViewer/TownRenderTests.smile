''' Native real-catalog loading, precise surface rebuild and cleanup acceptance.

Option Explicit

Import Smile.Simple3D.Graphics3D As G
Import Smile.Simple3D.Core As Core
Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.Scene3D As Scene
Import Smile.Simple3D.SurfaceGrid3D As Grid
Import Smile.Simple3D.TerrainSurface3D As Elevation
Import Smile.Simple3D.TerrainWater3D As Flow
Import Smile.Simple3D.SurfacePaint3D As Paint
Import Smile.Tools.TownDocument As Document
Import Smile.Tools.TownDocumentStore As Store
Import Smile.Tools.TownCatalogData As Catalog
Import Smile.Tools.TownInitialSurface As Initial
Import Smile.Tools.TownCatalogRenderer As Renderer
Import Smile.Tools.TownSurfaceRenderer As Terrain
Import Smile.Tools.TownTerrainLighting As TerrainLighting
Import Smile.Tools.TownLighting As Lighting
Import Smile.Tools.TownAttachments As Attachments
Import Smile.Tools.TownCampfires As Campfires
Import Smile.Tools.TownDerivedCache As Derived
Import Smile.Simple3D.FireEmitter3D As Fire
Import Smile.Tools.TownDocumentNavigation As Navigation
Import Smile.Tools.TownEditor As Editor
Import Smile.Tools.TownGuides As Guides
Import Smile.Tools.TownGuideList As GuideList
Import Smile.Tools.TownSelection As Selection
Import Smile.Tools.TownHistory As History
Import Smile.Tools.TownEditorPanel As Panel
Import Smile.Tools.TownSurfaceTools As SurfaceTools
Import Smile.Tools.TownSurfaceStyles As SurfaceStyles
Import Smile.Tools.TownTerrainStyles As Styles
Import Smile.Tools.TownFountains As Fountains
Import Smile.Tools.TownMapLoadTools As MapTools
Import Smile.Simple3D.FountainStreams3D As Jets

Dim Town As Document.State
Dim CanalTown As Document.State
Dim Assets As Renderer.State
Dim Ground As Terrain.State
Dim Doors As Attachments.State
Dim Camera As P.Camera3D
Dim ParallelView As P.Camera3D
Dim Accepted As P.Camera3D
Dim Index As Number
Dim Ok As Boolean
Dim Failures As Number
Dim Frames As Number
Dim Before As Number
Dim Meshes[1024] As Number
Dim Temporary As Core.Object3D
Dim Controls As Editor.State
Dim UntilTime As Number
Dim Action As Number
Dim WithoutCastle[5] As Number
Dim Photograph As Number
Dim PngJob As Number
Dim PngStatus As Number
Dim SpawnUndo As History.State

Game Window "Town Editor Catalog Check" Size 1100 By 720

Call Check(Panel.ContainsPoint(1050, 220, 1100, 720) And
    Not Panel.ContainsPoint(1050, 695, 1100, 720) And
    Not Panel.ContainsPoint(220, 528, 1100, 720),
    "Editor Hit Region Excludes Orbit Fit And Camera Sliders")

For Index = 0 To 1023
    Meshes[Index] = G.CreateMesh3D(3, 3)
End For

Call Check(Meshes[0] <> Meshes[512] And Meshes[511] <> Meshes[1023] And G.MaximumMeshCount3D() = 1024,
    "Mesh Handles Remain Distinct Above Slot 511")
Call Check(G.CreateMesh3D(3, 3) = 0, "Mesh Pool Rejects Allocation Beyond Its Limit")

For Index = 0 To 1023
    Ok = P.SetMeshVertex(Meshes[Index], 0, P.Vector(0.125, 23.125, -0.625))

    Call Check(Ok, "Every Mesh Slot Accepts Fractional Vertices")

    Temporary.MeshHandle = Meshes[Index]

    Call G.DestroyObject3D(Temporary)
End For

Call Initial.Populate(Town.Surface)
Call Document.DefaultSun(Town.Light)

Town.ItemCount = Catalog.INITIAL_ITEMS

For Index = 0 To Catalog.INITIAL_ITEMS - 1
    Town.Items[Index] = Catalog.InitialItem(Index)
End For

Call Renderer.SyncDocument(Assets, Town)

For Index = 0 To Assets.Required - 1
    Call Renderer.LoadNext(Assets)
End For

Call Check(Not Assets.Failed, "Catalog Loads Within Resource Limits")
Call CheckSmoothTerrain()
Call CheckFountainAndSpawn()

Ok = Terrain.Create(Ground)

Call Check(Ground.Textures[0].MipLevels > 1 And Ground.Textures[1].MipLevels > 1 And
    Assets.Grass.MipLevels > 1 And Ground.Textures[2].MipLevels > 1 And
    Ground.Textures[3].MipLevels > 1 And Ground.Textures[4].MipLevels > 1,
    "Terrain Tiles And Paving Filter Distant Repetitions")
Call Check(Ground.Materials[1].Kind = G.MATERIAL_KIND_PBR And
    Assets.Lawn.Kind = G.MATERIAL_KIND_PBR And Ground.Materials[1].RoughnessPercent = 100,
    "Terrain And Courtyard Grass Follow The Sun And Ambient Like Paving")
Call Check(Ground.Materials[3].Kind = G.MATERIAL_KIND_PBR And
    Ground.Materials[3].RoughnessPercent = 38 And Ground.Materials[3].MetallicPercent = 0,
    "Paving Uses A Soft Nonmetallic Stone Sheen")

Ok = Attachments.Create(Doors) And Ok
Ok = Lighting.Apply(Town.Light) And Ok

Call Check(G.LightValue3D(G.LIGHT_QUERY_DIRECTIONAL, 0, 3) > 0,
    "Town Sun And Its Shadow Camera Stay Above The Ground")

Call Check(Ok, "Surface, Light And Door Resources")
Call CheckLocalLighting()
Call Terrain.BeginBuild(Ground, Town)

Do

    Call Terrain.Update(Ground, 16)

    Frames = Frames + 1

Loop Until Ground.Stage = 0 Or Ground.Failed Or Frames >= 200

Call Check(Ground.Stage = 0 And Not Ground.Failed, "Complete Initial Terrain Builds")

For Index = 0 To Ground.ObjectCount - 1

    If (Ground.Objects[Index].MaterialHandle = Ground.Materials[1].Handle Or
        Ground.Objects[Index].MaterialHandle = Ground.Materials[3].Handle) Then
        Call Check(Not Ground.Objects[Index].CastsShadow And Ground.Objects[Index].ReceivesShadow,
            "Grass And Paving Receive Scenery Shadows Without Self Shadow Bands")
    End If

End For

Call Navigation.Rebuild(Town)
Call Check(Navigation.CanStand(0.0, -2780.0), "Arrival Road Remains Walkable")
Call Check(Not Navigation.CanStand(-580.0, -2000.0), "Canal Remains Impassable")

Camera.Position = P.Vector(-2200.0, 6100.0, -7800.0)
Camera.Target = P.Vector(-1100.0, 300.0, 0.0)
Camera.UpDirection = P.Vector(0.0, 1.0, 0.0)
Camera.FovDegrees = 45.0
Camera.NearPlane = 20.0
Camera.FarPlane = 25000.0

Call Attachments.Update(Doors, Town, P.Vector(0.0, 23.12, -2780.0), 16)

Ok = Scene.SetShadowArea(-1000, 650, 0, 8000, 7600, 1, 11000)
Ok = Scene.BeginPrecise(Camera, 12, 20, 32) And Ok
Ok = Renderer.Draw(Assets, Town) And Ok
Ok = Terrain.Draw(Ground) And Ok
Ok = Attachments.Draw(Doors, Town) And Ok
Ok = Scene.EndScene() And Ok

Call Check(Ok, "Complete Catalog, Water And Hinged Leaves Draw")

ParallelView = Camera
ParallelView.Position = P.Vector(-1100.0, 7000.0, 0.0)
ParallelView.UpDirection = P.Vector(0.0, 0.0, 1.0)
ParallelView.OrthographicHeight = 6500.0
Ok = Scene.BeginPrecise(ParallelView, 12, 20, 32)
Ok = Renderer.Draw(Assets, Town) And Ok
Ok = Terrain.Draw(Ground) And Ok
Ok = Scene.EndScene() And Ok
Accepted = P.AcceptedCamera()

Call Check(Ok And Abs(Accepted.OrthographicHeight - 6500.0) < 0.001,
    "Native Orthographic Camera Accepts And Draws The True 2D Projection")

Ok = G.SetViewport3D(800, 500, 256, 170, True)
Ok = Scene.BeginPrecise(Camera, 12, 20, 32) And Ok
Ok = Renderer.Draw(Assets, Town) And Ok
Ok = Scene.EndScene() And Ok

Call G.ResetViewport3D()
Call Check(Ok, "Native Inset Draw Preserves The Surrounding Main View")
Call Check(G.ReplayViewport3D(800, 500, 256, 170),
    "Cached POV Replays Without Starting Or Drawing A Second Scene")
Call Check(Not G.ReplayViewport3D(800, 500, 257, 170),
    "Changed POV Size Requires A Fresh Render")
Call Check(Not G.ReplayViewport3D(-1, 500, 256, 170),
    "Cached POV Rejects An Out Of Bounds Destination")

Photograph = G.CaptureViewport3D()

Call Check(Photograph > 0 And G.DrawViewportCapture3D(Photograph, 420, 215, 240, 150),
    "Town Photograph Draws At Its World Card Coordinates")

Before = Timer()

For Index = 0 To 15
    Ok = G.DrawViewportCapture3D(Photograph, 420, 215, 240, 150)
End For

Call Check(Timer() - Before < 500,
    "Cached Photographs Do Not Wait For Another Display Frame Per Card")
Call Check(Not G.DrawViewportCapture3D(Photograph, 420, 215, 0, 150),
    "Photograph Rejects An Empty Card Without A Clip Crash")
Call Check(G.SaveViewportCapture3D(Photograph, "TownRender.Thumbnail"),
    "Native Photograph Persists Through Checked Save Data")
Call G.ReleaseViewportCapture3D(Photograph)
Call Check(Not G.DrawViewportCapture3D(Photograph, 420, 215, 240, 150),
    "Released Photograph Handle Cannot Replay Stale GPU Memory")

Photograph = G.LoadViewportCapture3D("TownRender.Thumbnail")

Call Check(Photograph > 0 And G.DrawViewportCapture3D(Photograph, 420, 215, 240, 150),
    "Saved Photograph Reopens Without Drawing A Scene")
Call Check(Not G.SaveViewportCapture3D(0, "TownRender.Thumbnail") And
    G.LoadViewportCapture3D("TownRender.Thumbnail.Missing") = 0,
    "Invalid Capture And Missing Save Return Failure Without Damaging The Cache")

PngJob = G.ExportViewportCapturePng3D(Photograph, "@TOWN_PREVIEW_PNG@")
UntilTime = Timer() + 5000

Do
    PngStatus = Data_FileStatus(PngJob)
    Show Screen

Loop Until PngStatus <> 0 Or Timer() >= UntilTime

Call Check(PngJob > 0 And PngStatus = 1, "Native Photograph Exports A Verified PNG In The Background")
Call Check(G.ExportViewportCapturePng3D(0, "@TOWN_PREVIEW_PNG@") = 0,
    "An Invalid Photograph Cannot Replace The Saved PNG")
Call G.ReleaseViewportCapture3D(Photograph)

Print "Meshes"
Print G.LiveMeshCount3D()
Print "Materials"
Print G.LiveMaterialCount3D()
Show Screen

Call Editor.Start(Controls)

Action = Editor.Command(Controls, Town, 2)

Call Check(Controls.Ui.Tool = 13, "Surfaces Defaults To Rectangle")

Action = Editor.Command(Controls, Town, 40)

Call Check(Controls.Ui.Tool = 13, "Changing Surface Retains Rectangle Default")

Action = Editor.Command(Controls, Town, 1)

Town.Name = "Neris Town"
Town.NextIdentity = Town.ItemCount + 1
Before = Town.ItemCount
Ok = Selection.Add(Controls.Selected, Town, 0)
Action = Editor.Command(Controls, Town, 34)

Call Check(Ok And Town.ItemCount = Before + 1, "Duplicate Command Creates A Selected Assembly")

Action = Editor.Command(Controls, Town, 32)

Call Check(Town.ItemCount = Before, "Undo Button Restores The Document")

Action = Editor.Command(Controls, Town, 33)

Call Check(Town.ItemCount = Before + 1, "Redo Button Restores The Duplicate")

Action = Editor.Command(Controls, Town, 32)
Action = Editor.Command(Controls, Town, 53)
Action = Editor.Command(Controls, Town, 73)
Action = Editor.Command(Controls, Town, 74)
Ok = Guides.Add(Controls.Guide.Ink, P.Vector(-1400.0, 23.12, -2100.0),
    P.Vector(-900.0, 23.12, -1100.0), True)
Ok = Guides.Add(Controls.Guide.Ink, P.Vector(-1400.0, 23.12, -2100.0),
    P.Vector(200.0, 23.12, -1100.0), False) And Ok

Call History.Record(Controls.HistoryState, Town, Controls.Guide.Ink)

Action = Editor.Command(Controls, Town, 72)

Call Check(Ok And Controls.Guide.Ink.EntryCount = 0, "Clear Markers Command")

Action = Editor.Command(Controls, Town, 32)

Call Check(Controls.Guide.Ink.EntryCount = 2 And Controls.Guide.ShowGrid And
    Controls.Guide.SnapMode = 1, "Undo Restores Guides Without Changing Grid Preferences")

' These narrow widths occur during both opening and closing, including at high FPS.

For Before = 1 To 32
    Controls.GuideBrowser.Width = Before

    Call GuideList.Draw(Controls.GuideBrowser, Controls.Guide)
End For

Controls.GuideBrowser.Width = 290

Call GuideList.Draw(Controls.GuideBrowser, Controls.Guide)
Call Check(True, "Guide List Opening And Closing Never Pass Nonpositive Clip Dimensions")

Controls.GuideBrowser.Width = 0

UntilTime = Timer() + 1000

Do
    Ok = Scene.BeginPrecise(Camera, 12, 20, 32)
    Ok = Renderer.Draw(Assets, Town) And Ok
    Ok = Terrain.Draw(Ground) And Ok
    Ok = Attachments.Draw(Doors, Town) And Ok
    Ok = Scene.EndScene() And Ok

    Call Editor.Draw(Controls, Town, Camera)

    Show Screen
    Wait 16 Milliseconds

Loop Until Timer() >= UntilTime Or Game_Closed()

Before = Ground.LiveRevision

Call Grid.PaintRectangle(Town.Surface, 2, 2, 8, 8, Grid.SURFACE_ROAD)
Call Terrain.BeginBuild(Ground, Town)
Call Terrain.Update(Ground, 16)
Call Check(Ground.LiveRevision = Before, "Old Terrain Remains Until Replacement Is Ready")

Frames = 0

Do

    Call Terrain.Update(Ground, 16)

    Frames = Frames + 1

Loop Until Ground.Stage = 0 Or Ground.Failed Or Frames >= 200

Call Check(Not Ground.Failed And Ground.LiveRevision = Town.Surface.Revision,
    "Edited Terrain Commits As One Complete Replacement")

Ok = SurfaceTools.Apply(Town.Surface, P.Vector(-3940.0, 23.12, -1664.0),
    P.Vector(-3540.0, 23.12, -1664.0), Grid.SURFACE_ROAD, 120.0, False)

Call Terrain.BeginBuild(Ground, Town)

Frames = 0

Do

    Call Terrain.Update(Ground, 16)

    Frames = Frames + 1

Loop Until Ground.Stage = 0 Or Ground.Failed Or Frames >= 600

Call Check(Ok And Not Ground.Failed And Ground.LiveRevision = Town.Surface.Revision,
    "Adding One Circle To Dense Legacy Neris Does Not Exhaust Terrain Capacity")

' The cleaned canal map exceeded the scratch buffer with its entrance walks.
Before = Ground.LiveRevision
Ok = Store.LoadDocument(CanalTown, "TownRender.Canals")

Call Check(Ok, "Cleaned Canal Regression Document Loads")
Call Terrain.BeginBuild(Ground, CanalTown)

Frames = 0

Do

    Call Terrain.Update(Ground, 16)

    Frames = Frames + 1

    If Ground.Stage <> 0 Then
        Call Check(Ground.LiveRevision = Before,
            "Canal Upload Blocks Never Expose A Partial Terrain Replacement")
    End If

Loop Until Ground.Stage = 0 Or Ground.Failed Or Frames >= 1500

If Ground.Failed Or Ground.Stage <> 0 Then
    Call TerrainDiagnostics()
End If

Call Check(Not Ground.Failed And Ground.Stage = 0 And Ground.ObjectCount > 32,
    "Canal Terrain Streams Beyond One Scratch Buffer Within Existing Object Limits")

Before = Ground.ObjectCount

Call Terrain.BeginBuild(Ground, CanalTown)
Call Check(Ground.CacheRead, "Saved Canal Mesh Recipe Skips Surface Scanning")

Frames = 0

Do

    Call Terrain.Update(Ground, 16)

    Frames = Frames + 1

Loop Until Ground.Stage = 0 Or Ground.Failed Or Frames >= 1500

Call Check(Not Ground.Failed And Ground.Stage = 0 And Ground.ObjectCount = Before,
    "Saved Multi Batch Canal Terrain Reloads Completely")

Call Grid.PaintRectangle(CanalTown.Surface, 0, 0, 0, 0, Grid.SURFACE_ROAD)
Call Terrain.BeginBuild(Ground, CanalTown)
Call Check(Not Ground.CacheRead, "Terrain Edit Rejects The Previous Saved Mesh Recipe")
Call Attachments.Destroy(Doors)
Call Terrain.Destroy(Ground)

' Removing the last Tripo placement releases every resource, while its palette survives.

For Index = 0 To Town.ItemCount - 1

    If Town.Items[Index].Template = 6 Then
        Town.Items[Index].Active = False
    End If

End For

Call Renderer.SyncDocument(Assets, Town)

WithoutCastle[0] = G.LiveModelCount3D()
WithoutCastle[1] = G.LiveMeshCount3D()
WithoutCastle[2] = G.LiveMaterialCount3D()
WithoutCastle[3] = G.LiveTextureCount3D()
WithoutCastle[4] = G.LiveObjectCount3D()

Call Check(Assets.Loaded = Catalog.CHUNK_COUNT And WithoutCastle[0] = Catalog.CHUNK_COUNT,
    "Unplaced Old Castle Owns No Model Resources")

For Index = 0 To Town.ItemCount - 1

    If Town.Items[Index].Template = 6 Then
        Town.Items[Index].Active = True
    End If

End For

Call Renderer.SyncDocument(Assets, Town)

For Index = 0 To 13
    Call Renderer.LoadNext(Assets)
End For

Call Check(Not Assets.Failed And G.LiveModelCount3D() = WithoutCastle[0] + 14,
    "Placing Old Castle Loads Its Fourteen Models On Demand")

For Index = 0 To Town.ItemCount - 1

    If Town.Items[Index].Template = 6 Then
        Town.Items[Index].Active = False
    End If

End For

Call Renderer.SyncDocument(Assets, Town)
Call Check(G.LiveModelCount3D() = WithoutCastle[0] And G.LiveMeshCount3D() = WithoutCastle[1] And
    G.LiveMaterialCount3D() = WithoutCastle[2] And G.LiveTextureCount3D() = WithoutCastle[3] And
    G.LiveObjectCount3D() = WithoutCastle[4], "Removing Old Castle Releases Models Meshes Materials Textures And Objects")
Call Renderer.Destroy(Assets)

Ok = G.ClearAdditionalLights3DChecked()

Call Check(Ok And G.LightValue3D(G.LIGHT_QUERY_LOCAL, 63, 1) = G.LIGHT_DISABLED,
    "Scene Light Cleanup Includes The Last Native Slot")

' A bare shore needs grass and road meshes plus water, never a thin trim mesh.
Ok = Grid.Initialize(Town.Surface, 3, 1, 0.0, 0.0, 20.0, Grid.SURFACE_GROUND)

Call Grid.PaintRectangle(Town.Surface, 1, 0, 1, 0, Grid.SURFACE_WATER)
Call Grid.PaintRectangle(Town.Surface, 2, 0, 2, 0, Grid.SURFACE_ROAD)

Ok = Terrain.Create(Ground) And Ok

Call Terrain.BeginBuild(Ground, Town)

Frames = 0

Do

    Call Terrain.Update(Ground, 16)

    Frames = Frames + 1

Loop Until Ground.Stage = 0 Or Ground.Failed Or Frames >= 200

Call Check(Ok And Not Ground.Failed And Ground.ObjectCount = 3 And Ground.WaterCount = 1,
    "Bare Shore Has A Submerged Bed And No Shimmering Trim")
Call Terrain.Destroy(Ground)
Call Check(G.LiveMeshCount3D() = 0 And G.LiveObjectCount3D() = 0 And
    G.LiveMaterialCount3D() = 0 And G.LiveModelCount3D() = 0,
    "Catalog Resources Release Cleanly")

Controls.Ui.Section = 6
Controls.Ui.MapCount = 16

For Index = 0 To 15
    Controls.Ui.MapNames[Index] = "Destination " + Panel.NumberLabel(Index)
End For

Call Panel.Draw(Controls.Ui, Town, Controls.Guide, 0)

Ok = False

For Index = 0 To Controls.Ui.ControlCount - 1

    If Controls.Ui.Controls[Index].Action = 615 Then
        Ok = True
    End If

End For

Call Check(Ok, "The Sixteenth Destination Has A Visible Control Without Overflow")
Call Panel.Release(Controls.Ui)
Call CheckElevatedTerrain()
Call CheckLandscape("Silverfall")
Call CheckLandscape("Willowstep")
Call CheckCampfires()
Call Scene.Shutdown()

If Failures = 0 Then
    Print "PASS Town Editor Rendering"
Else
    Print "FAIL Town Editor Rendering"
End If

Sub CheckElevatedTerrain()

    Dim X As Number
    Dim Z As Number
    Dim Radius As Double
    Dim Offset As Double
    Dim Brush As Paint.Brush

    Ok = Document.Blank(Town, "Terrain-and-Flowing-Water-MVP", 128, 128, 20.0)

    For Z = 0 To Town.Surface.Rows

        For X = 0 To Town.Surface.Columns
            Radius = Sqrt(Town.Surface.XEdges[X] * Town.Surface.XEdges[X] +
                Town.Surface.ZEdges[Z] * Town.Surface.ZEdges[Z])
            Offset = Max(0.0, 100.0 - Radius * 0.25)
            Ok = Elevation.SetCorner(Town.Surface, X, Z, Offset) And Ok
        End For
    End For

    Brush.Form = Paint.FORM_LINE
    Brush.Surface = Grid.SURFACE_ROAD
    Brush.X0 = -500.0
    Brush.Z0 = -100.0
    Brush.X1 = 500.0
    Brush.Z1 = 100.0
    Brush.Width = 60.0
    Ok = Grid.PaintBrush(Town.Surface, Brush) And Ok

    Ok = Flow.Prepare(Town.Surface, P.Vector(100.0, 0.0, 200.0), P.Vector(500.0, 0.0, 200.0), 40.0, Brush) And Ok
    Ok = Grid.PaintBrush(Town.Surface, Brush) And Ok
    Ok = Flow.Prepare(Town.Surface, P.Vector(-250.0, 0.0, -200.0), P.Vector(-250.0, 0.0, -600.0), 40.0, Brush) And Ok
    Ok = Grid.PaintBrush(Town.Surface, Brush) And Ok
    Ok = Terrain.Create(Ground) And Ok
    Ok = SurfaceStyles.Write(Town.Appearance, 0, 2) And Ok
    Ok = SurfaceStyles.Write(Town.Appearance, 1, 4) And Ok

    Call Terrain.BeginBuild(Ground, Town)

    Frames = 0

    Do

        Call Terrain.Update(Ground, 16)

        Frames = Frames + 1

    Loop Until Ground.Stage = 0 Or Ground.Failed Or Frames >= 300

    Call Check(Ok And Not Ground.Failed And Ground.Stage = 0 And
        Ground.ObjectCount > 0 And Ground.ObjectCount <= 64,
        "128 By 128 Elevated Ground And Clipped Road Upload Within Existing Limits")

    Call Check(Ground.WaterCount >= 2 And Ground.WaterCount <= 4 And
        Ground.FlowMaterials[0].Handle <> 0 And Ground.FlowMaterials[1].Handle <> 0,
        "Independent Directed Streams Fit Existing Ribbon Limit")
    Call Check(Not G.SetEffectMaterialWaterFlow3D(Ground.FlowMaterials[0], True, 0, 0, 100),
        "Zero Direction Rejected")
    Call Check(Not G.SetEffectMaterialWaterFlow3D(Ground.FlowMaterials[0], True, 1000, 0, -1),
        "Negative Flow Speed Rejected")
    Call Check(G.SetEffectMaterialWaterFlow3D(Ground.FlowMaterials[0], True, -1000, 0, 0),
        "Reversed Flow And Zero-Speed Pause Accepted")

    Camera.Position = P.Vector(-1800.0, 1300.0, -1900.0)
    Camera.Target = P.Vector(0.0, 40.0, 0.0)
    Camera.UpDirection = P.Vector(0.0, 1.0, 0.0)
    Camera.OrthographicHeight = 0.0
    Camera.NearPlane = 1.0
    Ok = Scene.BeginPrecise(Camera, 12, 20, 32)
    Ok = Terrain.Draw(Ground) And Ok
    Ok = Scene.EndScene() And Ok

    Call Check(Ok, "Elevated Terrain Renders With Geometric Normals")

    Dim ForestSeen As Boolean
    Dim DesertSeen As Boolean

    For Index = 0 To Ground.ObjectCount - 1
        ForestSeen = ForestSeen Or Ground.Objects[Index].MaterialHandle = Ground.Materials[7].Handle
        DesertSeen = DesertSeen Or Ground.Objects[Index].MaterialHandle = Ground.Materials[11].Handle
    End For

    Call Check(ForestSeen And DesertSeen, "Local Forest And Desert Upload As Distinct Terrain Materials")
    Call Terrain.Destroy(Ground)
    Call Check(G.LiveMeshCount3D() = 0 And G.LiveObjectCount3D() = 0 And
        G.LiveMaterialCount3D() = 0, "Elevated Terrain Resources Release Cleanly")

End Sub

''' Terrain pages must share four exact-size ribbons alongside the live Studio effects.
Sub CheckLandscape(Name As Text)

    Dim Deadline As Number
    Dim EmptyTexture As Core.Texture3D
    Dim EffectMaterial As Core.Material3D
    Dim EffectRibbon As Core.RibbonBatch3D
    Dim GlowRibbon As Core.RibbonBatch3D
    Dim CoreRibbon As Core.RibbonBatch3D
    Dim Reserved As Number
    Dim WaterIndex As Number
    Dim Groups[4] As Number

    EffectMaterial = G.CreateEffectMaterial3D(EmptyTexture, G.MATERIAL_ALPHA_BLEND, 100)
    EffectRibbon = G.CreateRibbonBatch3D(8192, EffectMaterial)
    GlowRibbon = G.CreateRibbonBatch3D(6144, EffectMaterial)
    CoreRibbon = G.CreateRibbonBatch3D(6144, EffectMaterial)

    Call Check(EffectRibbon.Handle <> 0 And GlowRibbon.Handle <> 0 And CoreRibbon.Handle <> 0,
        "Reserve 20480 Points For Shared Studio Effects Before Landscape Loading")

    Ok = Store.LoadDocument(Town, "TownRender." + Name)

    Call Check(Ok, Name + " Portable Regression Fixture Imports")

    If Not Ok Then
        Return
    End If

    Town.Name = "Fresh Water Regression " + Name
    Ok = Derived.WriteNumber(0, "TownPrepared.Terrain10." + Town.Name) And Ok
    Ok = Terrain.Create(Ground)

    Call Terrain.BeginBuild(Ground, Town)

    Deadline = Timer() + 15000

    Do

        Call Terrain.Update(Ground, 16)

    Loop Until Ground.Stage = 0 Or Ground.Failed Or Timer() >= Deadline

    Call Check(Ok And Not Ground.Failed And Ground.Stage = 0 And Ground.WaterCount <= 4,
        Name + " Lake And Stream Fit The Unchanged Native Water Budget")

    Reserved = G.VfxValue3D(G.VFX_QUERY_STAGED_RIBBON_CAPACITY)

    Call Terrain.BeginBuild(Ground, Town)

    Deadline = Timer() + 15000

    Do

        Call Terrain.Update(Ground, 16)

    Loop Until Ground.Stage = 0 Or Ground.Failed Or Timer() >= Deadline

    Call Check(Not Ground.Failed And Ground.Stage = 0 And
        G.VfxValue3D(G.VFX_QUERY_STAGED_RIBBON_CAPACITY) = Reserved,
        Name + " Cached Replacement Fits Alongside Live Water And Effects Without Leaking")

    If Ground.Failed Then

        Call TerrainDiagnostics()

        Print "Landscape Shared Capacity: " + Name
        Print Ground.WaterPatchCount

        For WaterIndex = 0 To Ground.WaterPatchCount - 1
            Groups[Ground.PendingWater[WaterIndex].FlowGroup] = Groups[Ground.PendingWater[WaterIndex].FlowGroup] + 1
        End For

        For WaterIndex = 0 To 3
            Print Groups[WaterIndex]
        End For

        Print Reserved
        Print G.VfxValue3D(G.VFX_QUERY_STAGED_RIBBON_CAPACITY)
        Print Ground.NextWaterCount
        Print G.LastError()

    End If

    Call Terrain.Destroy(Ground)
    Call G.DestroyRibbonBatch3D(EffectRibbon)
    Call G.DestroyRibbonBatch3D(GlowRibbon)
    Call G.DestroyRibbonBatch3D(CoreRibbon)
    Call G.DestroyMaterial3D(EffectMaterial)

End Sub

Sub TerrainDiagnostics()

    Print "Terrain Stage / Row / Objects / Next / Cache Read / Batch / Batches / Patches / Error"
    Print Ground.Stage
    Print Ground.Recipe.Row
    Print Ground.ObjectCount
    Print Ground.NextCount
    Print Ground.CacheRead
    Print Ground.CacheBatch
    Print Ground.CacheBatches
    Print Ground.Recipe.Buffer.PatchCount
    Print G.LastError()

End Sub

Sub CheckCampfires()

    Dim Fires As Campfires.State
    Dim Empty As Fire.FireEmitter
    Dim Frame As Number
    Dim Original As Fire.FireEmitter
    Dim Position As P.Vector3

    Ok = Document.Blank(Town, "Campfire Animation", 8, 8, 20.0)
    Town.ItemCount = 2

    For Frame = 0 To 1

        Town.Items[Frame].Active = True
        Town.Items[Frame].Identity = Frame + 1
        Town.Items[Frame].Template = 39
        Town.Items[Frame].Scale = P.Vector(1000.0, 1000.0, 1000.0)
        Town.Items[Frame].Position = P.Vector(ToDouble(Frame) * 50.0, 23.0, 0.0)
    End For

    Camera.Position = P.Vector(0.0, 60.0, -120.0)
    Camera.Target = P.Vector(0.0, 32.0, 0.0)
    Camera.NearPlane = 1.0
    Camera.OrthographicHeight = 0.0

    For Frame = 1 To 20

        Call Campfires.Update(Fires, Town, Camera, 33)

        Ok = Scene.BeginPrecise(Camera, 12, 20, 32) And Ok
        Ok = Campfires.Draw(Fires) And Ok
        Ok = Scene.EndScene() And Ok
        Show Screen
    End For

    Call Check(Ok And Fire.Value(1, Empty) = 2 And Fire.Value(4, Fires.Flames[0]) > 0 And
        Fire.Value(10, Fires.Flames[0]) = 660,
        "Placed Fires Emit Animated Particles Once Per Frame")

    Original = Fires.Flames[0]
    Town.Items[0].Position.X = 12.0

    Call Campfires.Update(Fires, Town, Camera, 33)

    Position = Fire.LightPositionPrecise(Fires.Flames[0])
    Ok = Lighting.ApplyLocal(Town)

    Call Check(Ok And Position.X = 12.0 And G.ActiveLightCount3D() = 4,
        "Campfire Emitter And Subtle Daylight Glow Follow Placement")

    Town.Items[0].Active = False

    Call Campfires.Update(Fires, Town, Camera, 33)

    Ok = Lighting.ApplyLocal(Town)

    Call Check(Ok And Fire.Value(1, Empty) = 1 And Fire.Value(10, Original) = 0 And
        G.ActiveLightCount3D() = 3, "Deleted Campfire Releases Its Flame And Light")
    Call Campfires.Destroy(Fires)
    Call Check(Fire.Value(1, Empty) = 0, "Leaving Town Releases Campfire Emitters")
    Call Fire.Shutdown()

End Sub

Sub CheckSmoothTerrain()

    Dim Draft As Document.State
    Dim X As Number
    Dim Z As Number
    Dim First As P.Vector3
    Dim Last As P.Vector3
    Dim Ok As Boolean
    Dim Cache As TerrainLighting.State
    Dim Cached As P.Vector3

    Ok = Document.Blank(Draft, "Smooth Shading", 4, 4, 30.0)

    For Z = 0 To 4

        For X = 0 To 4
            Ok = Elevation.SetCorner(Draft.Surface, X, Z, ToDouble(X * X * 4 + Z * Z * 2)) And Ok
        End For
    End For

    Call TerrainLighting.Reset(Cache)

    First = TerrainLighting.Calculate(Draft.Surface, Draft.Surface.XEdges[2] - 0.001,
        Draft.Surface.ZEdges[2])
    Last = TerrainLighting.Calculate(Draft.Surface, Draft.Surface.XEdges[2] + 0.001,
        Draft.Surface.ZEdges[2])

    Call Check(Ok And First.Y > 0.0 And Abs(First.X - Last.X) < 0.001 And
        Abs(First.Y - Last.Y) < 0.001 And Abs(First.Z - Last.Z) < 0.001,
        "Terrain Lighting Is Continuous Across Cell And Triangle Seams")

    Cached = TerrainLighting.Sample(Cache, Draft.Surface, Draft.Surface.XEdges[2] - 0.001,
        Draft.Surface.ZEdges[2])

    Call Check(Cached.X = First.X And Cached.Y = First.Y And Cached.Z = First.Z,
        "Cached Terrain Normals Equal Exact Original Sampling")

    Ok = Elevation.SetCorner(Draft.Surface, 1, 2, 71.0)

    Call TerrainLighting.Reset(Cache)

    Cached = TerrainLighting.Sample(Cache, Draft.Surface, Draft.Surface.XEdges[2] - 0.001,
        Draft.Surface.ZEdges[2])
    First = TerrainLighting.Calculate(Draft.Surface, Draft.Surface.XEdges[2] - 0.001,
        Draft.Surface.ZEdges[2])

    Call Check(Cached.X = First.X And Cached.Y = First.Y And Cached.Z = First.Z,
        "Terrain Edits Invalidate Cached Normals On Rebuild")

    Call Check(Elevation.Corner(Draft.Surface, 2, 2) = 24.0,
        "Smooth Shading Preserves The Authored Collision Heights")

End Sub

Sub CheckLocalLighting()

    Dim Draft As Document.State
    Dim Shape As Catalog.Template
    Dim ItemIndex As Number
    Dim OriginalX As Number
    Dim Expected As Number
    Dim Ok As Boolean

    Call Check(G.MaximumLocalLightCount3D() = 128, "Native Reports Its Local Light Capacity")

    Ok = G.SetPointLight3D(G.MaximumLocalLightCount3D() - 1, 0, 100, 0, 255, 220, 170, 100, 200)

    Call Check(Ok And Not G.SetPointLight3D(G.MaximumLocalLightCount3D(), 0, 100, 0, 255, 220, 170, 100, 200),
        "Last Local Light Is Usable And Out Of Range Slots Are Rejected")

    Ok = G.ClearAdditionalLights3DChecked()

    Call Check(Ok And G.ActiveLightCount3D() = 2, "General Cleanup Clears Every Local Light")
    Call Document.NightSun(Draft.Light)

    For ItemIndex = 0 To Town.ItemCount - 1

        Shape = Catalog.TemplateAt(Town.Items[ItemIndex].Template)

        If Shape.Label = "Crystal Lamp" Then
            Draft.Items[0] = Town.Items[ItemIndex]
            Exit For
        End If

    End For

    Draft.ItemCount = 1
    Ok = Lighting.ApplyLocal(Draft)
    OriginalX = G.LightValue3D(G.LIGHT_QUERY_LOCAL, 4, 2)

    Call Check(Ok And G.ActiveLightCount3D() = 3 And
        ToDouble(G.LightValue3D(G.LIGHT_QUERY_LOCAL, 4, 3)) > Draft.Items[0].Position.Y,
        "Placed Lamp Emits Warm Light Above Its Base At Night")

    Draft.Items[0].Position.X = Draft.Items[0].Position.X + 125.0
    Ok = Lighting.ApplyLocal(Draft)

    Call Check(Ok And G.LightValue3D(G.LIGHT_QUERY_LOCAL, 4, 2) = OriginalX + 125,
        "Lamp Light Follows Edited Placement")

    Draft.Items[0].Active = False
    Ok = Lighting.ApplyLocal(Draft)

    Call Check(Ok And G.ActiveLightCount3D() = 2, "Deleted Lamp Leaves No Light Behind")

    Draft.Items[0].Active = True
    Draft.ItemCount = 75

    For ItemIndex = 1 To Draft.ItemCount - 1
        Draft.Items[ItemIndex] = Draft.Items[0]
        Draft.Items[ItemIndex].Position.X = ToDouble(ItemIndex) * 150.0
    End For

    Ok = Lighting.ApplyLocal(Draft)

    Call Check(Ok And G.ActiveLightCount3D() = 77 And
        G.LightValue3D(G.LIGHT_QUERY_LOCAL, 78, 2) = 11100,
        "Duplicated Lamps Beyond The Former 64-Slot Budget Still Emit At Their Own Position")

    Draft = Town
    Expected = 2

    Call Document.NightSun(Draft.Light)

    For ItemIndex = 0 To Draft.ItemCount - 1

        Shape = Catalog.TemplateAt(Draft.Items[ItemIndex].Template)

        If Shape.Label = "Crystal Lamp" Then
            Expected = Expected + 1
        Else If (Shape.Label = "Royal Castle" Or
            Shape.Label = "Military HQ" Or
            Shape.Label = "Comm Tower" Or
            Shape.Label = "City Hall") Then
            Expected = Expected + 2
        End If

    End For

    Ok = Lighting.ApplyLocal(Draft)

    Call Check(Ok And G.ActiveLightCount3D() = Expected And Expected > 10,
        "All Placed Lamps And Four Landmarks Receive Night Lighting")
    Call Document.DefaultSun(Draft.Light)

    Ok = Lighting.ApplyLocal(Draft)

    Call Check(Ok And G.ActiveLightCount3D() = 2, "Town Accent Lights Switch Off In Daylight")

End Sub

Sub CheckFountainAndSpawn()

    Dim Draft As Document.State
    Dim Streams As Fountains.State
    Dim Shape As Jets.Profile
    Dim Point As P.Vector3
    Dim Low As P.Vector3
    Dim High As P.Vector3
    Dim Marker As MapTools.State
    Dim Ink As Guides.Drawing
    Dim Ok As Boolean
    Dim Capacity As Number

    Ok = Document.Blank(Draft, "Fountain Fixture", 12, 12, 30.0)
    Draft.ItemCount = 1
    Draft.Items[0].Active = True
    Draft.Items[0].Identity = 1
    Draft.Items[0].Template = 20
    Draft.Items[0].Position = P.Vector(100.0, 75.0, 200.0)
    Draft.Items[0].Scale = P.Vector(2000.0, 2000.0, 2000.0)
    Draft.Items[0].Yaw = 90.0
    Shape = Fountains.Profile(Draft.Items[0])
    Point = Jets.StreamPoint(Shape, 0, 1.0)

    Call Check(Abs(Point.X - 100.0) < 0.001 And Abs(Point.Z - 140.0) < 0.001 And
        Abs(Point.Y - 91.8) < 0.001, "Fountain Streams Follow Prop Position Scale Rotation And Basin Height")

    Capacity = G.VfxValue3D(G.VFX_QUERY_STAGED_RIBBON_CAPACITY)
    Ok = Fountains.Update(Streams, Draft, Point, 500)

    Call Check(Ok And Streams.Ready And Streams.Time = 500 And Streams.Batch.Capacity = 544,
        "Small Fountain Publishes Animated Jets And Ripple Rings In One Bounded Batch")

    Ok = Fountains.Update(Streams, Draft, Point, 125) And Ok
    Draft.Items[0].Active = False
    Ok = Fountains.Update(Streams, Draft, Point, 0) And Ok

    Call Check(Ok And Streams.Batch.Handle = 0 And
        G.VfxValue3D(G.VFX_QUERY_STAGED_RIBBON_CAPACITY) = Capacity,
        "Deleting The Last Fountain Releases Its Stream Resources")
    Call Navigation.Rebuild(Draft)
    Call History.Reset(SpawnUndo, Draft, Ink)
    Call MapTools.Gesture(Marker, Draft, P.Vector(0.0, 0.0, 0.0), True, True, False, 762)
    Call History.Record(SpawnUndo, Draft, Ink)

    Call Check(Draft.HasTeleportSpawn, "Blue Spawn Tool Accepts Walkable Ground")

    Ok = History.Restore(SpawnUndo, Draft, Ink, False)

    Call Check(Ok And Not Draft.HasTeleportSpawn, "Undo Restores The Previous Teleport Spawn")

    Low = Styles.Coordinates(2, 1, 0.0, 23.0, 0.0, P.Vector(0.0, 0.94, 0.0))
    High = Styles.Coordinates(2, 1, 0.0, 23.0, 0.0, P.Vector(0.0, 1.0, 0.0))

    Call Check(Low.Y > High.Y + 0.2, "Rock Texture Starts On Lower Foothill Slopes At The Same Altitude")
    Call Navigation.Disable()

End Sub

Sub Check(Condition As Boolean, Label As Text)

    If Not Condition Then
        Print "FAIL " + Label
        Failures = Failures + 1
    End If

End Sub
