''' Soft cyan halos and sparse slow sparkles, owned and released by the town.
Module Smile.Tools.NerisTownCrystals

Option Explicit

Import Smile.Simple3D.Core As Core
Import Smile.Simple3D.Graphics3D As G
Import Smile.Simple3D.Precision3D As P
Import Smile.Tools.NerisTownLayout As Layout

Public Type State
    Texture As Core.Texture3D
    Material As Core.Material3D
    Particles As Core.ParticleBatch3D
    Lamps As Core.ParticleBatch3D
    LightCount As Number
    Time As Double
    Ready As Boolean
End Type

Public Function Create(ByRef Value As State) As Boolean

    Dim Ok As Boolean

    Value.LightCount = Layout.CRYSTAL_COUNT

    Value.Texture = G.LoadTexture3D("Assets/Fire/ember-shape.png",
        G.TEXTURE_FILTER_LINEAR, G.TEXTURE_WRAP_CLAMP)
    Value.Material = G.CreateEffectMaterial3D(Value.Texture, G.MATERIAL_ALPHA_ADDITIVE, 180)
    Value.Particles = G.CreateParticleBatch3D(Value.LightCount * 3, Value.Material,
        G.VFX_BILLBOARD_CAMERA, 1, 1)
    Value.Lamps = G.CreateParticleBatch3D(Layout.LAMP_COUNT * 2, Value.Material,
        G.VFX_BILLBOARD_CAMERA, 1, 1)
    Ok = (Value.Texture.Handle <> 0 And Value.Material.Handle <> 0 And
        Value.Particles.Handle <> 0 And Value.Lamps.Handle <> 0)
    Value.Ready = Ok

    Return Ok

End Function

Public Sub Update(ByRef Value As State, Elapsed As Number)

    Dim Index As Number
    Dim Spark As Number
    Dim Point As P.Vector3
    Dim Phase As Double
    Dim Brightness As Number
    Dim Ok As Boolean

    Value.Time = Value.Time + ToDouble(Elapsed) / 1000.0
    Ok = Value.Ready

    For Index = 0 To Value.LightCount - 1

        Point = Layout.CrystalAt(Index)
        Ok = P.SetParticle(Value.Particles, Index * 3, Point, 8.0, 0.0, 0) And Ok
        Ok = G.SetParticleColor3D(Value.Particles, Index * 3, 65, 205, 255,
            20 + ToNumber(4.0 * Sin(Value.Time * 0.65 + ToDouble(Index)))) And Ok

        For Spark = 1 To 2

            Phase = Value.Time * 0.65 + ToDouble(Index) * 1.71 + ToDouble(Spark) * 2.3
            Point = Layout.CrystalAt(Index)
            Point.X = Point.X + Cos(Phase) * 3.2
            Point.Z = Point.Z + Sin(Phase) * 3.2
            Point.Y = Point.Y + Sin(Phase * 0.7) * 4.0
            Brightness = ToNumber(Max(0.0, Sin(Phase * 1.3)) * 55.0)
            Ok = P.SetParticle(Value.Particles, Index * 3 + Spark, Point, 1.1, 0.0, 0) And Ok
            Ok = G.SetParticleColor3D(Value.Particles, Index * 3 + Spark, 160, 235, 255, Brightness) And Ok
        End For
    End For

    Ok = G.CommitParticleBatch3D(Value.Particles, Value.LightCount * 3) And Ok

    For Index = 0 To Layout.LAMP_COUNT - 1

        Point = Layout.LampAt(Index)
        Ok = P.SetParticle(Value.Lamps, Index * 2, Point, 6.0, 0.0, 0) And Ok
        Ok = G.SetParticleColor3D(Value.Lamps, Index * 2, 255, 177, 68, 16) And Ok
        Ok = P.SetParticle(Value.Lamps, Index * 2 + 1, Point, 2.3, 0.0, 0) And Ok
        Ok = G.SetParticleColor3D(Value.Lamps, Index * 2 + 1, 255, 222, 150, 38) And Ok
    End For

    Ok = G.CommitParticleBatch3D(Value.Lamps, Layout.LAMP_COUNT * 2) And Ok
    Value.Ready = Ok

End Sub

Public Function Draw(ByRef Value As State) As Boolean

    Dim Ok As Boolean

    Ok = Value.Ready And G.DrawParticleBatch3D(Value.Particles)
    Ok = G.DrawParticleBatch3D(Value.Lamps) And Ok

    Return Ok

End Function

Public Sub Destroy(ByRef Value As State)

    Call G.DestroyParticleBatch3D(Value.Particles)
    Call G.DestroyParticleBatch3D(Value.Lamps)
    Call G.DestroyMaterial3D(Value.Material)
    Call G.DestroyTexture3D(Value.Texture)

    Value.Ready = False

End Sub

End Module
