''' Spaceport crystal halos, antenna beacon, pad guidance and night illumination.
Module Smile.Tools.NerisSpaceportGlow

Option Explicit

Import Smile.Simple3D.Core As Core
Import Smile.Simple3D.Graphics3D As G
Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.PrecisionMath3D As M
Import Smile.Tools.NerisSpaceportRoute As Route

Public Const PARTICLE_COUNT = 102

Public Type State
    Texture As Core.Texture3D
    Material As Core.Material3D
    Particles As Core.ParticleBatch3D
    Clock As Number
    BeaconLit As Boolean
    Ready As Boolean
End Type

Public Function Create(ByRef Value As State) As Boolean

    Dim Index As Number
    Dim Point As P.Vector3
    Dim Ok As Boolean

    Value.Texture = G.LoadTexture3D("Assets/Fire/ember-shape.png",
        G.TEXTURE_FILTER_LINEAR, G.TEXTURE_WRAP_CLAMP)
    Value.Material = G.CreateEffectMaterial3D(Value.Texture, G.MATERIAL_ALPHA_ADDITIVE, 180)
    Value.Particles = G.CreateParticleBatch3D(PARTICLE_COUNT, Value.Material, G.VFX_BILLBOARD_CAMERA, 1, 1)
    Ok = Value.Texture.Handle <> 0 And Value.Material.Handle <> 0 And Value.Particles.Handle <> 0

    For Index = 0 To 12

        Select Case Index
            Case 0
                Point = P.Vector(0.0, 306.72, 84.0)
            Case 1
                Point = P.Vector(-34.0, 239.84, 50.0)
            Case 2
                Point = P.Vector(-34.0, 227.84, 118.0)
            Case 3
                Point = P.Vector(-88.0, 208.8, 4.0)
            Case 4
                Point = P.Vector(-88.0, 188.8, 156.0)
            Case 5
                Point = P.Vector(-232.0, 115.84, -110.0)
            Case 6
                Point = P.Vector(-232.0, 99.84, 192.0)
            Case 7
                Point = P.Vector(34.0, 239.84, 50.0)
            Case 8
                Point = P.Vector(34.0, 227.84, 118.0)
            Case 9
                Point = P.Vector(88.0, 208.8, 4.0)
            Case 10
                Point = P.Vector(88.0, 188.8, 156.0)
            Case 11
                Point = P.Vector(232.0, 115.84, -110.0)
            Case 12
                Point = P.Vector(232.0, 99.84, 192.0)
        End Select

        Point = P.Vector(Route.ORIGIN_X - Point.X * Route.SCALE,
            Route.DECK_Y + Point.Y * Route.SCALE, Route.ORIGIN_Z - Point.Z * Route.SCALE)
        Ok = P.SetParticle(Value.Particles, Index, Point, 95.0, 0.0, 0) And Ok
        Ok = G.SetParticleColor3D(Value.Particles, Index, 65, 205, 255, 48) And Ok
    End For

    Point = ToWorld(P.Vector(0.0, 348.2, 84.0))
    Ok = P.SetParticle(Value.Particles, 13, Point, 110.0, 0.0, 0) And Ok
    Ok = G.SetParticleColor3D(Value.Particles, 13, 255, 20, 12, 0) And Ok

    For Index = 14 To PARTICLE_COUNT - 1
        Point = ToWorld(PadLight(Index - 14))
        Ok = P.SetParticle(Value.Particles, Index, Point, 32.0, 0.0, 0) And Ok
        Ok = G.SetParticleColor3D(Value.Particles, Index, 95, 225, 255, 95) And Ok
    End For

    Ok = G.CommitParticleBatch3D(Value.Particles, PARTICLE_COUNT) And Ok
    Value.Ready = Ok

    Return Ok

End Function

Private Function ToWorld(Point As P.Vector3) As P.Vector3

    Point = P.Vector(Route.ORIGIN_X - Point.X * Route.SCALE,
        Route.DECK_Y + Point.Y * Route.SCALE, Route.ORIGIN_Z - Point.Z * Route.SCALE)

    Return Point

End Function

Public Function PadCenter(Index As Number) As P.Vector3

    Dim Point As P.Vector3

    Point = P.Vector(-306.0 + Floor(ToDouble(Index) / 2.0) * 612.0,
        66.0 + ToDouble(Index Mod 2) * 40.0, 44.0 + ToDouble(Index Mod 2) * 112.0)

    Return Point

End Function

Public Function PadLight(Index As Number) As P.Vector3

    Dim Point As P.Vector3
    Dim Angle As Double

    If Index < 64 Then

        Point = PadCenter(Index / 16)
        Angle = M.Radians(ToDouble(Index Mod 16) * 22.5)
        Point = M.Add(Point, P.Vector(Sin(Angle) * 51.0, 0.5, Cos(Angle) * 51.0))

    Else

        Index = Index - 64
        Point = P.Vector(-234.0 + Floor(ToDouble(Index) / 12.0) * 348.0 +
            Floor(ToDouble(Index Mod 12) / 6.0) * 120.0,
            1.0, -145.0 - ToDouble(Index Mod 6) * 18.0)

    End If

    Return Point

End Function

Public Function BeaconOn(Time As Number) As Boolean

    Dim Result As Boolean

    Result = Time Mod 1200 < 240

    Return Result

End Function

Public Sub Update(ByRef Value As State, Elapsed As Number)

    Dim Lit As Boolean
    Dim Alpha As Number

    Value.Clock = (Value.Clock + Max(0, Elapsed) Mod 1200) Mod 1200
    Lit = BeaconOn(Value.Clock)

    If Value.Ready And Lit <> Value.BeaconLit Then

        If Lit Then
            Alpha = 100
        End If

        Value.Ready = G.SetParticleColor3D(Value.Particles, 13, 255, 20, 12, Alpha)
        Value.Ready = G.CommitParticleBatch3D(Value.Particles, PARTICLE_COUNT) And Value.Ready
        Value.BeaconLit = Lit

    End If

End Sub

''' The town owner allocates slots; the eight washes never outlive the active spaceport.
Public Function Apply(ByRef Slot As Number, Night As Double) As Boolean

    Dim Index As Number
    Dim Point As P.Vector3
    Dim Radius As Number
    Dim Ok As Boolean

    Ok = True

    If Not Route.Active() Or Night <= 0.0 Then
        Return Ok
    End If

    For Index = 0 To 7

        If Slot >= G.MaximumLocalLightCount3D() Then
            Return False
        End If

        Radius = 900

        If Index < 4 Then
            Point = M.Add(PadCenter(Index), P.Vector(0.0, 18.0, 0.0))
        Else If Index < 6 Then
            Point = P.Vector(-174.0 + ToDouble(Index - 4) * 348.0, 24.0, -190.0)
            Radius = 1200
        Else If Index = 6 Then
            Point = P.Vector(0.0, 24.0, -196.0)
        Else
            Point = P.Vector(0.0, 75.0, -30.0)
            Radius = 1700
        End If

        Point = ToWorld(Point)
        Ok = G.SetPointLight3D(Slot, ToNumber(Point.X), ToNumber(Point.Y), ToNumber(Point.Z),
            195, 222, 255, ToNumber(Night * 850.0), Radius) And Ok
        Slot = Slot + 1
    End For

    Return Ok

End Function

Public Function Draw(ByRef Value As State) As Boolean

    Dim Ok As Boolean

    Ok = Value.Ready And G.DrawParticleBatch3D(Value.Particles)

    Return Ok

End Function

Public Sub Destroy(ByRef Value As State)

    Call G.DestroyParticleBatch3D(Value.Particles)
    Call G.DestroyMaterial3D(Value.Material)
    Call G.DestroyTexture3D(Value.Texture)

    Value.Ready = False

End Sub

End Module
