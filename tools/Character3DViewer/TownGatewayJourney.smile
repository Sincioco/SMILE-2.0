''' Entry placement and remembered airport returns; owned by the town session.
Module Smile.Tools.TownGatewayJourney

Option Explicit

Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.PrecisionMath3D As M
Import Smile.Tools.TownDocument As Document
Import Smile.Tools.TownDocumentNavigation As Navigation
Import Smile.Tools.TownMapLoads As Tiles
Import Smile.Simple3D.SurfaceGrid3D As Grid

Public Type State
    Origin As Text
    Gateway As Text
    Position As P.Vector3
    ArrivalOrigin As Text
    ArrivalTown As Text
End Type

Public Sub Remember(ByRef Value As State, Origin As Text, Destination As Text,
    Position As P.Vector3)

    Value.ArrivalOrigin = Origin
    Value.ArrivalTown = Destination

    If Destination = "Neris Spaceport" Or Destination = "Horizon Airport" Then

        Value.Origin = Origin
        Value.Gateway = Destination
        Value.Position = Position

    End If

End Sub

Public Function Resolve(ByRef Value As State, Current As Text, ByRef Destination As Text,
    ByRef Position As P.Vector3) As Boolean

    If (Current <> Value.Gateway Or
        Destination <> "Neris Town" Or
        Text_Length(Value.Origin) = 0) Then
        Return False
    End If

    Destination = Value.Origin
    Position = Value.Position

    Return True

End Function

''' Explicit return tiles take precedence over the legacy shared-airport fallback.
Public Function ResolveTile(ByRef Value As State, ByRef Town As Document.State,
    ByRef Destination As Text, ByRef Position As P.Vector3) As Boolean

    Dim Index As Number
    Dim Result As Boolean

    For Index = 0 To Town.MapTileCount - 1

        If Town.MapTiles[Index].Destination = Value.Origin Then
            Return False
        End If

    End For

    Result = Resolve(Value, Town.Name, Destination, Position)

    Return Result

End Function

''' Walk in from the gate, then require a clear marker-free stretch ahead.
Private Function Approach(ByRef Town As Document.State, Gate As P.Vector3,
    Direction As P.Vector3, ByRef Position As P.Vector3, ByRef ClearLength As Double) As Boolean

    Dim Step As Number
    Dim ClearSteps As Number
    Dim Point As P.Vector3

    For Step = 0 To 80

        Point = M.Add(Gate, M.Scale(Direction, ToDouble(Step) * 10.0))

        If Not Navigation.IsRoad(Point) Or Not Navigation.CanStand(Point.X, Point.Z) Then
            Return False
        End If

        If Text_Length(Tiles.DestinationAt(Town, Point.X, Point.Z)) = 0 Then
            ClearSteps = ClearSteps + 1
        Else
            ClearSteps = 0
        End If

        If ClearSteps >= 3 Then
            Exit For
        End If

    End For

    If ClearSteps < 3 Then
        Return False
    End If

    Position = Point
    ClearLength = 0.0

    For Step = 1 To 24

        Point = M.Add(Position, M.Scale(Direction, ToDouble(Step) * 10.0))

        If Text_Length(Tiles.DestinationAt(Town, Point.X, Point.Z)) > 0 Then
            Return False
        End If

        If Not Navigation.IsRoad(Point) Or Not Navigation.CanStand(Point.X, Point.Z) Then
            Exit For
        End If

        ClearLength = ToDouble(Step) * 10.0
    End For

    If ClearLength < 80.0 Then
        Return False
    End If

    Return True

End Function

Public Function GateArrival(ByRef Town As Document.State, Gate As P.Vector3,
    ByRef Position As P.Vector3, ByRef Heading As Double) As Boolean

    Dim Bearing As Number
    Dim Center As P.Vector3
    Dim Inward As P.Vector3
    Dim Direction As P.Vector3
    Dim Candidate As P.Vector3
    Dim ClearLength As Double
    Dim Score As Double
    Dim Best As Double
    Dim Alignment As Double
    Dim Found As Boolean

    Center = P.Vector((Town.Surface.XEdges[0] + Town.Surface.XEdges[Town.Surface.Columns]) * 0.5,
        0.0, (Town.Surface.ZEdges[0] + Town.Surface.ZEdges[Town.Surface.Rows]) * 0.5)
    Inward = M.Subtract(Center, Gate)
    Inward = M.Scale(Inward, 1.0 / Max(1.0, M.Length(Inward)))
    Best = -1.0

    For Bearing = 0 To 7

        Direction = P.Vector(Sin(M.Radians(ToDouble(Bearing) * 45.0)), 0.0,
            Cos(M.Radians(ToDouble(Bearing) * 45.0)))
        Alignment = M.Dot(Direction, Inward)

        If Alignment > 0.05 Then

            If Approach(Town, Gate, Direction, Candidate, ClearLength) Then

                Score = Alignment + ClearLength / 240.0

                If Score > Best Then

                    Best = Score
                    Position = Candidate
                    Position.Y = Navigation.GroundHeight(Position.X, Position.Z)
                    Heading = M.WrapDegrees(ToDouble(Bearing) * 45.0 + 180.0)
                    Found = True

                End If

            End If

        End If

    End For

    Return Found

End Function

''' Exactly one deterministic inward arrival per connected yellow area.
Public Function Arrival(ByRef Town As Document.State, Origin As Text,
    ByRef Position As P.Vector3, ByRef Heading As Double) As Boolean

    Dim Labels As Tiles.LabelSet
    Dim Index As Number

    Call Tiles.BuildLabels(Town, Labels)

    For Index = 0 To Labels.LabelCount - 1

        If Text_Length(Origin) = 0 Or Labels.Names[Index] = Origin Then

            If GateArrival(Town, Labels.Positions[Index], Position, Heading) Then
                Return True
            End If

        End If

    End For

    Return False

End Function

Public Function Teleport(ByRef Town As Document.State, ByRef Position As P.Vector3,
    ByRef Heading As Double) As Boolean

    Dim Found As Boolean

    If Town.HasTeleportSpawn Then

        Position = Town.TeleportSpawn

        If (Navigation.CanStand(Position.X, Position.Z) And
            Text_Length(Tiles.DestinationAt(Town, Position.X, Position.Z)) = 0) Then

            Position.Y = Navigation.GroundHeight(Position.X, Position.Z)
            Heading = 180.0
            Return True

        End If

    End If

    Found = Arrival(Town, "", Position, Heading)

    Return Found

End Function

Public Function TakeArrival(ByRef Value As State, ByRef Town As Document.State,
    ByRef Position As P.Vector3, ByRef Heading As Double) As Boolean

    Dim Result As Boolean

    If Town.Name = Value.ArrivalTown Then
        Result = Arrival(Town, Value.ArrivalOrigin, Position, Heading)
    End If

    Value.ArrivalOrigin = ""
    Value.ArrivalTown = ""

    Return Result

End Function

End Module
