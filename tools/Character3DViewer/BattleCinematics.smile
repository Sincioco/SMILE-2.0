''' Native battle camera lifecycle. Party owns the shared framing and attack shots.
Module Smile.Tools.ViewerBattleCinematics

Option Explicit

Import Smile.Tools.Character3DViewerWorkflow As Workflow
Import Smile.Tools.Character3DViewerParty As Party
Import Smile.Tools.BattleCameraShots As Shots
Import Smile.Tools.ViewerBattlePresentation As Presentation
Import SinStarI.BattleRules As Rules
Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.PrecisionCamera3D As Camera
Import Smile.Simple3D.ArenaCamera3D As Arena

Public Const RETURN_MILLISECONDS = 1000

Public Type State
    Enabled As Boolean
    WasEnabled As Boolean
    Time As Number
    Phase As Number
    Serial As Number
    View As P.Camera3D
    EstablishView As P.Camera3D
    DefaultRequested As Boolean
    ReturnTime As Number
    ReturnFrom As P.Camera3D
End Type

Public Sub Reset(ByRef Value As State, Viewer As Workflow.Session)

    Value.Time = 0
    Value.Phase = -1
    Value.Serial = -1
    Value.WasEnabled = False
    Value.DefaultRequested = False
    Value.EstablishView = Viewer.PartyCameraView(0, 0)

End Sub

''' Start from the rendered view, including manual pan/orbit/zoom, without a cut.
Public Sub ReturnToOrders(ByRef Value As State, Viewer As Workflow.Session)

    Value.DefaultRequested = True
    Value.ReturnTime = 0
    Value.ReturnFrom = Viewer.CurrentCamera()
    Value.Time = Party.ESTABLISH_TOTAL_MILLISECONDS + 1
    Value.WasEnabled = Value.Enabled

    Call Viewer.FollowPartyView(Value.ReturnFrom, True)

End Sub

''' Match Kael Party's complete two-second orbit, then ease into the live shot for one second.
Public Function Establish(Base As P.Camera3D, Following As P.Camera3D, Time As Number) As P.Camera3D

    Dim Controls As Camera.Controls
    Dim Result As P.Camera3D
    Dim Progress As Double

    Controls.OrbitYaw = Party.EstablishOrbitDegrees(Party.ESTABLISH_TOTAL_MILLISECONDS - Time)
    Result = Arena.ComposeOrbit(Base, Controls)

    If Time > Party.ESTABLISH_SPIN_MILLISECONDS Then
        Progress = (ToDouble(Time - Party.ESTABLISH_SPIN_MILLISECONDS) /
            ToDouble(Party.ESTABLISH_TOTAL_MILLISECONDS - Party.ESTABLISH_SPIN_MILLISECONDS))
        Result = Shots.Blend(Result, Following, Progress)
    End If

    Return Result

End Function

Public Sub Update(ByRef Value As State, Viewer As Workflow.Session, Battle As Rules.State,
    Elapsed As Number, Width As Number, Height As Number)

    Dim Restart As Boolean

    If Value.Enabled <> Value.WasEnabled Then
        Value.DefaultRequested = False
    End If

    If Value.DefaultRequested Then

        Value.ReturnTime = Min(RETURN_MILLISECONDS, Value.ReturnTime + Max(0, Elapsed))
        Value.View = Shots.Blend(Value.ReturnFrom, Presentation.OrdersView(),
            ToDouble(Value.ReturnTime) / ToDouble(RETURN_MILLISECONDS))

        Call Viewer.FollowPartyView(Value.View)

        Return

    End If

    If Not Value.Enabled Then
        Value.WasEnabled = False
        Return
    End If

    Value.Time = Value.Time + Elapsed
    Value.View = Presentation.OrdersView()

    If Battle.Phase = Rules.EXECUTING Then
        Value.View = Viewer.PartyCameraView(Max(1, Battle.Duration - 900), Elapsed,
            Battle.ActionSerial <> Value.Serial)
    End If

    If Value.Time <= Party.ESTABLISH_TOTAL_MILLISECONDS Then
        Value.View = Establish(Value.EstablishView, Value.View, Value.Time)
    End If

    Restart = (Not Value.WasEnabled Or
        (Battle.Phase = Rules.WAITING And Value.Phase <> Rules.WAITING))
    Value.WasEnabled = True
    Value.Phase = Battle.Phase
    Value.Serial = Battle.ActionSerial

    Call Viewer.FollowPartyView(Value.View, Restart)

End Sub

End Module
