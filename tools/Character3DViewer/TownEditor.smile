''' Editor gestures and document commands. GPU resources and persistence are separate owners.
Module Smile.Tools.TownEditor

Option Explicit

Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.PrecisionCamera3D As Camera
Import Smile.Simple3D.SurfaceGrid3D As Grid
Import Smile.Simple3D.SurfacePaint3D As SurfacePaint
Import Smile.Tools.TownDocument As Document
Import Smile.Tools.TownSurfaceStyles As SurfaceStyles
Import Smile.Tools.TownStyleTools As StyleTools
Import Smile.Tools.TownSelection As Selection
Import Smile.Tools.TownCatalogData As Catalog
Import Smile.Tools.TownGeometry As Geometry
Import Smile.Tools.TownPicking As Picking
Import Smile.Tools.TownEditorPanel As Panel
Import Smile.Tools.TownGuides As Guides
Import Smile.Tools.TownGuideFiles As GuideFiles
Import Smile.Tools.TownTileGuides As TileGuides
Import Smile.Tools.TownMarkerTools As MarkerTools
Import Smile.Tools.TownMarkerResize As MarkerResize
Import Smile.Tools.TownGuideList As GuideList
Import Smile.Tools.TownHistory As History
Import Smile.Tools.TownMapLoadTools As MapLoadTools
Import Smile.Tools.TownSunControls As Sun
Import Smile.Tools.TownSectionTools As SectionTools
Import Smile.Tools.TownCourtTools As CourtTools
Import Smile.Tools.TownSurfaceTools As SurfaceTools
Import Smile.Tools.TownTerrainTools As TerrainTools
Import Smile.Tools.TownTerrainPanel As TerrainPanel
Import Smile.Tools.TownRampTools As RampTools
Import Smile.Tools.TownWaterTools As WaterTools

Public Type State
    StyleGesture As StyleTools.State
    ViewRequest As Number
    FocusPoint As P.Vector3
    Ui As Panel.State
    Selected As Selection.State
    Guide As Guides.State
    GuideTransfer As GuideFiles.State
    MarkerGesture As MarkerTools.State
    GuideBrowser As GuideList.State
    SectionGesture As SectionTools.State
    CourtGesture As CourtTools.State
    MapGesture As MapLoadTools.State
    SurfaceGesture As SurfaceTools.State
    TerrainGesture As TerrainTools.State
    RampGesture As RampTools.State
    WaterGesture As WaterTools.State
    HistoryState As History.State
    Enabled As Boolean
    Anchored As Boolean
    Anchor As P.Vector3
    Current As P.Vector3
    Rubber As Boolean
    StartX As Number
    StartY As Number
End Type

Public Sub Start(ByRef Value As State)

    Value.Enabled = True
    Value.Ui.Category = 1
    Value.Ui.Tool = 10
    Value.Ui.Surface = Grid.SURFACE_ROAD
    Value.Ui.Width = 3

    Call Selection.SetCategory(Value.Selected, 1)
    Call Guides.Start(Value.Guide)
    Call TerrainTools.Start(Value.TerrainGesture)
    Call RampTools.Start(Value.RampGesture)
    Call WaterTools.Start(Value.WaterGesture)

End Sub

Public Function CapturesMap(ByRef Value As State) As Boolean

    Dim Result As Boolean

    Result = Value.Ui.Section = 7 Or Value.Ui.Category <> 0 Or Value.Ui.Tool = 15 Or Value.Ui.Tool = 16 Or Value.Ui.Tool = 70

    Return Result

End Function

Public Sub UpdateGuideFiles(ByRef Value As State, ByRef Town As Document.State)

    Dim Loaded As Boolean

    If Value.GuideTransfer.Job = 0 Then
        Return
    End If

    Call History.Ensure(Value.HistoryState, Town, Value.Guide.Ink)

    Loaded = GuideFiles.Update(Value.GuideTransfer, Value.Guide)
    Value.Ui.Message = Value.GuideTransfer.Message
    Value.Ui.Busy = Value.Ui.Busy Or Value.GuideTransfer.Job > 0
    Value.Ui.ProgressPercent = Value.GuideTransfer.Progress

    If Loaded Then
        Call History.Record(Value.HistoryState, Town, Value.Guide.Ink)
    End If

End Sub

Public Sub Cancel(ByRef Value As State, ByRef Town As Document.State)

    Call Selection.EndDrag(Value.Selected, Town, True)
    Call Sun.Cancel(Value.Ui.SunSlider, Town)
    Call MarkerTools.Cancel(Value.MarkerGesture, Value.Guide)
    Call SectionTools.Cancel(Value.SectionGesture)
    Call CourtTools.Cancel(Value.CourtGesture, Town)
    Call SurfaceTools.Cancel(Value.SurfaceGesture)
    Call TerrainTools.Cancel(Value.TerrainGesture, Town)
    Call StyleTools.Cancel(Value.StyleGesture, Town)

    Value.RampGesture.Stage = 0
    Value.WaterGesture.Stage = 0
    Value.WaterGesture.WarningRevision = -1

    Value.Rubber = False
    Value.Anchored = False
    Value.MapGesture.Moving = False
    Value.MapGesture.Selected = False
    Value.MapGesture.LabelName = ""
    Value.MapGesture.Drawing = False
    Value.MapGesture.Pending = False

    If Value.Ui.Section = 6 Then
        Value.Ui.Section = 0
    End If

End Sub

Public Sub ResetHistory(ByRef Value As State, ByRef Town As Document.State)

    Call Cancel(Value, Town)
    Call Selection.ClearSelection(Value.Selected)
    Call History.Reset(Value.HistoryState, Town, Value.Guide.Ink)

End Sub

Public Sub AcceptTerrain(ByRef Value As State, ByRef Town As Document.State, Ready As Boolean)

    If StyleTools.Publish(Value.StyleGesture, Ready) Then
        Call History.Record(Value.HistoryState, Town, Value.Guide.Ink)

        Value.Ui.Message = "Terrain style painted. Ctrl+Z to undo."
    End If

    If TerrainTools.Publish(Value.TerrainGesture, Town, Ready, False) Then
        Call History.Record(Value.HistoryState, Town, Value.Guide.Ink)

        Value.Ui.Message = Value.TerrainGesture.Message
    End If

End Sub

Public Sub ResetDocument(ByRef Value As State, ByRef Town As Document.State)

    Call Guides.ClearMarkers(Value.Guide.Ink)
    Call MarkerTools.ClearSelection(Value.Guide)
    Call ResetHistory(Value, Town)

End Sub

Public Function Command(ByRef Value As State, ByRef Town As Document.State, Action As Number) As Number

    Dim Index As Number
    Dim Matching As Number
    Dim Rows As Number
    Dim Shape As Catalog.Template
    Dim Ok As Boolean
    Dim InputText As Text

    If Action = 0 Then
        Return 0
    End If

    If Action >= 600 And Action < 616 Then
        Return Action
    End If

    If Value.TerrainGesture.Pending Or Value.StyleGesture.Pending Then
        Value.Ui.Message = "Preparing terrain; Esc cancels it."
        Return 0
    End If

    If RampTools.Command(Value.RampGesture, Value.TerrainGesture, Town, Action) Then
        Value.Ui.Message = Value.RampGesture.Message
        Return 0
    End If

    Call Cancel(Value, Town)
    Call History.Ensure(Value.HistoryState, Town, Value.Guide.Ink)

    If WaterTools.Command(Value.WaterGesture, Value.TerrainGesture, Town, Action) Then

        Value.Ui.Section = 7
        Value.Ui.Message = Value.WaterGesture.Message
        Return 0

    Else If TerrainTools.Command(Value.TerrainGesture, Action) Then

        Value.Ui.Section = 7
        Value.Ui.Message = Value.TerrainGesture.Message
        Return 0

    Else If Action = 54 Then

        Value.Ui.Section = 7
        Return 0

    Else If Action >= 1 And Action <= 4 Then

        If Value.Ui.Category = Action Then

            Value.Ui.Category = 0
            Value.Ui.Tool = 0
            Value.Ui.Message = "Pan: drag the map. Choose a tab to edit."

            Call Selection.SetCategory(Value.Selected, 0)

            Return 0

        End If

        Value.Ui.Category = Action
        Value.Ui.Page = 0
        Value.Ui.Tool = 10

        For Index = 0 To Catalog.TEMPLATE_COUNT - 1

            Shape = Catalog.TemplateAt(Index)

            If Shape.Category = Action And Shape.PaletteVisible Then
                Value.Ui.Template = Index
                Exit For
            End If

        End For

        If Action = 2 Then
            Value.Ui.Tool = 13
        Else If Action = 4 Then
            Value.Ui.Tool = 91
        End If

        Call Selection.SetCategory(Value.Selected, Action)

    Else If ((Action >= 10 And Action <= 19) Or
        Action = 91 Or
        Action = 92 Or
        Action = 760 Or
        Action = 761) Then

        Value.Ui.Tool = Action

        If Action = 15 Or Action = 16 Then
            Value.Ui.HideGuides = False
        End If

    Else If Action = 93 Or Action = 94 Then

        Value.Ui.Category = 1
        Value.Ui.Tool = Action
        Value.Ui.Message = "Royal Court: one assembly, independent terrain."

    Else If Action = 95 Then

        Call CourtTools.Remove(Town)

        Value.Ui.Message = "Royal Court removed; terrain unchanged."

    Else If Action = 20 Or Action = 21 Then

        For Index = 0 To Catalog.TEMPLATE_COUNT - 1

            Shape = Catalog.TemplateAt(Index)

            If Shape.Category = Value.Ui.Category And Shape.PaletteVisible Then
                Matching = Matching + 1
            End If

        End For

        Rows = Panel.PaletteRows()
        Index = -1

        If Action = 21 Then
            Index = 1
        End If

        Value.Ui.Page = Max(0, Min((Matching - 1) / Rows, Value.Ui.Page + Index))

    Else If Action = 22 Then

        Call Selection.Rotate(Value.Selected, Town, -15.0)

    Else If Action = 23 Then

        Call Selection.Rotate(Value.Selected, Town, 15.0)

    Else If Action = 24 Then

        Call Selection.RemoveSelected(Value.Selected, Town)

    Else If Action = 35 Then

        If Value.Selected.SelectedCount > 0 Then

            InputText = Text_Prompt("Building Rotation", "Set selected buildings to an angle in degrees (decimals allowed).", "0")
            Ok = Selection.SetAngle(Value.Selected, Town, InputText)
            Value.Ui.Message = "Enter an angle from -360 to 360 degrees."

            If Ok Then
                Value.Ui.Message = "Rotation applied. Ctrl+Z undoes it."
            End If

        End If

    Else If Action = 32 Or Action = 33 Then

        Ok = History.Restore(Value.HistoryState, Town, Value.Guide.Ink, Action = 33)

        If Ok Then

            Call Selection.ClearSelection(Value.Selected)
            Call MarkerTools.ClearSelection(Value.Guide)

            Value.Ui.Message = "Undo applied."

            If Action = 33 Then
                Value.Ui.Message = "Redo applied."
            End If

        End If

    Else If Action = 34 Then

        Ok = Selection.Duplicate(Value.Selected, Town, Max(0.001, Value.Guide.Spacing) * 10.0)
        Value.Ui.Message = "Select an item; copies need free space."

        If Ok Then
            Value.Ui.Tool = 10
            Value.Ui.Message = "Duplicated; drag the selected copies."
        End If

    Else If Action >= 40 And Action <= 42 Then

        Value.Ui.Surface = Grid.SURFACE_GROUND
        Value.Ui.Tool = 13

        If Action = 41 Then
            Value.Ui.Surface = Grid.SURFACE_ROAD
        Else If Action = 42 Then
            Value.Ui.Surface = Grid.SURFACE_WATER
        End If

    Else If Action = 46 Then

        Value.Ui.Surface = 5
        Value.Ui.Tool = 760
        Value.Ui.Message = "Drag inside a yellow area to move it; Resize drags its nearest corner."

    Else If Action = 44 Then

        Value.Ui.Width = Max(1, Value.Ui.Width - 1)

    Else If Action = 47 Or Action = 48 Then

        Value.Ui.Tool = Action
        Value.Ui.Message = "Click the center, then the circle edge."

    Else If Action >= 410 And Action <= 412 Then

        Value.Ui.Tool = Action
        Value.Ui.Message = "Triangle: click three corners."

        If Action = 411 Then
            Value.Ui.Message = "Curve: click start, bend, then end."
        Else If Action = 412 Then
            Value.Ui.Message = "Drag a triangle or curve control point."
        End If

    Else If Action >= 750 And Action <= 758 Then

        Value.Ui.Surface = 6

        If Action = 750 Then
            Value.Ui.PaintStyle = Town.TerrainStyle + 1
            Value.Ui.Tool = 750
        Else If Action <= 754 Then
            Value.Ui.PaintStyle = Action - 750
        Else If Action = 758 Then
            Value.Ui.PaintStyle = 5
        Else If Action = 757 Then
            Value.Ui.PaintStyle = 0
        Else
            Value.Ui.Tool = Action - 5
        End If

        Value.Ui.Message = "Click or drag to paint terrain style."

    Else If Action = 49 Then

        Call SurfaceStyles.Reset(Town.Appearance)

        Town.TerrainStyle = (Town.TerrainStyle + 1) Mod 5
        Town.Surface.Revision = Town.Surface.Revision + 1
        Town.Revision = Town.Revision + 1
        Value.Ui.Message = "Terrain appearance changed. Ctrl+Z to undo."

    Else If Action = 45 Then

        Value.Ui.Width = Min(32, Value.Ui.Width + 1)

    Else If Action >= 50 And Action <= 53 Then

        Value.Ui.Section = Action - 50

    Else If Action = 72 Then

        Call Guides.ClearMarkers(Value.Guide.Ink)
        Call MarkerTools.ClearSelection(Value.Guide)

        Value.Ui.Message = "All markers cleared."

    Else If Action = 86 Then

        Value.Ui.Tool = 70
        Value.Ui.HideGuides = False
        Value.Ui.Message = "Drag empty space to select markers; drag an edge to move."

    Else If Action = 98 Or Action = 99 Then

        Value.ViewRequest = Action - 97

    Else If Action = 97 Then

        Value.Ui.GuideListOpen = Not Value.Ui.GuideListOpen

    Else If Action = 96 Then

        Value.Ui.HideGuides = Not Value.Ui.HideGuides

    Else If Action = 87 Then

        Ok = MarkerTools.Duplicate(Value.Guide)
        Value.Ui.Message = "Select markers first; maximum 128 markers."

        If Ok Then
            Value.Ui.Tool = 70
            Value.Ui.Message = "Markers duplicated. Drag the selected copies."
        End If

    Else If Action = 88 Then

        Call MarkerTools.RemoveSelected(Value.Guide)

        Value.Ui.Message = "Selected markers deleted."

    Else If Action = 73 Then

        Value.Guide.ShowGrid = Not Value.Guide.ShowGrid

    Else If Action = 77 Then

        Value.Guide.ShowTileGrid = Not Value.Guide.ShowTileGrid

    Else If Action >= 80 And Action <= 85 Then

        Value.Guide.TileTarget = Action - 80

    Else If Action = 79 Then

        Value.Guide.SnapTiles = Not Value.Guide.SnapTiles

    Else If Action = 78 Then

        InputText = Text_Prompt("Guide Grid Size", "Spacing in meters (0.001 to 10000). Example: 0.25",
            Guides.SpacingLabel(Value.Guide.Spacing))

        If Text_Length(InputText) > 0 Then

            Ok = Guides.SetSpacing(Value.Guide, InputText)
            Value.Ui.Message = "Grid and snap spacing updated."

            If Not Ok Then
                Value.Ui.Message = "Enter 0.001 to 10000 m, up to 6 decimal places."
            End If

        End If

    Else If Action = 74 Then

        Value.Guide.SnapMode = (Value.Guide.SnapMode + 1) Mod 4

    Else If Action = 75 Then

        Value.Guide.Spacing = Max(0.001, Value.Guide.Spacing * 0.5)

    Else If Action = 76 Then

        Value.Guide.Spacing = Min(10000.0, Value.Guide.Spacing * 2.0)

    Else If Action >= 100 And Action < 100 + Catalog.TEMPLATE_COUNT Then

        Value.Ui.Template = Action - 100
        Value.Ui.Tool = 11

    Else If Action = 220 Then

        Town.Light.Shadows = Not Town.Light.Shadows
        Town.Revision = Town.Revision + 1

    Else If Action = 221 Then

        Call Document.ApplySunPreset(Town, False)

    Else If Action = 222 Then

        Call Document.ApplySunPreset(Town, True)

    Else If Action = 223 Or Action = 224 Then

        Call Document.SaveSunPreset(Town, Action = 224)

        Value.Ui.Message = "Day preset stored; save town to keep it."

        If Action = 224 Then
            Value.Ui.Message = "Night preset stored; save town to keep it."
        End If

    Else
        Return Action

    End If

    Call History.Record(Value.HistoryState, Town, Value.Guide.Ink)

    Return 0

End Function

Private Sub PlaceCopy(ByRef Value As State, ByRef Town As Document.State)

    Dim Index As Number
    Dim Sample As Document.Item
    Dim Shape As Catalog.Template
    Dim Ok As Boolean

    Shape = Catalog.TemplateAt(Value.Ui.Template)

    If (Geometry.DrawCost(Town) + Shape.PartCount + Shape.DoorCount * 4 + Shape.WaterCount > 3500 Or
        Geometry.WaterCount(Town) + Shape.WaterCount > 160) Then
        Value.Ui.Message = "Scene is full; remove an item first."
        Return
    End If

    For Index = 0 To Catalog.INITIAL_ITEMS - 1

        Sample = Catalog.InitialItem(Index)

        If Sample.Template = Value.Ui.Template Then
            Exit For
        End If

    End For

    Index = Document.Place(Town, Sample, Value.Current.X, Value.Current.Z)

    If Index < 0 Then
        Value.Ui.Message = "Scene is full; remove an item first."
        Return
    End If

    Call Selection.ClearSelection(Value.Selected)

    Ok = Selection.Add(Value.Selected, Town, Index)
    Value.Ui.Message = "Placed " + Shape.Label

End Sub

Private Sub Paint(ByRef Value As State, ByRef Town As Document.State)

    Dim X1 As Number
    Dim Z1 As Number
    Dim X2 As Number
    Dim Z2 As Number
    Dim Surface As Number
    Dim Before As Number
    Dim Ok As Boolean

    X1 = Grid.CellX(Town.Surface, Value.Anchor.X)
    Z1 = Grid.CellZ(Town.Surface, Value.Anchor.Z)
    X2 = Grid.CellX(Town.Surface, Value.Current.X)
    Z2 = Grid.CellZ(Town.Surface, Value.Current.Z)
    Surface = Value.Ui.Surface
    Before = Town.Surface.Revision

    If Value.Ui.Tool = 14 Then
        Surface = Grid.SURFACE_GROUND
    End If

    If Value.Ui.Tool = 47 Or Value.Ui.Tool = 48 Then
        Ok = SurfaceTools.Apply(Town.Surface, Value.Anchor, Value.Current, Surface,
            ToDouble(Value.Ui.Width * 20), Value.Ui.Tool = 48)
    Else If Value.Ui.Tool = 12 Then
        Call Grid.PaintWorldLine(Town.Surface, Value.Anchor.X, Value.Anchor.Z,
            Value.Current.X, Value.Current.Z, Surface, ToDouble(Value.Ui.Width * 20))
    Else

        Call Grid.PaintRectangle(Town.Surface, X1, Z1, X2, Z2, Surface)
    End If

    If Town.Surface.Revision <> Before Then
        Town.Revision = Town.Revision + 1
        Value.Ui.Message = "Rebuilding terrain..."
    End If

    Value.Anchored = False

End Sub

Public Function Input(ByRef Value As State, ByRef Town As Document.State,
    View As P.Camera3D, Key As Number, Blocked As Boolean) As Number

    Dim Action As Number
    Dim Picked As Number
    Dim Index As Number
    Dim Ok As Boolean
    Dim OnGround As Boolean
    Dim Box As Picking.ScreenBox
    Dim RawPoint As P.Vector3
    Dim Point As Camera.ProjectedPoint
    Dim Radius As Double
    Dim Now As Number
    Dim Elapsed As Number

    If Not Value.Enabled Then
        Return 0
    End If

    Value.Ui.Orthographic = View.OrthographicHeight > 0.0
    Now = Timer()
    Elapsed = Max(0, Now - Value.TerrainGesture.PreviousTime)
    Value.TerrainGesture.PreviousTime = Now

    Call History.Ensure(Value.HistoryState, Town, Value.Guide.Ink)

    Call GuideList.Advance(Value.GuideBrowser, Value.Ui.Section = 3 And Value.Ui.GuideListOpen)

    If GuideList.Hovered(Value.GuideBrowser) Or Value.GuideBrowser.DragScroll Then

        Call GuideList.Input(Value.GuideBrowser, Value.Guide)
        Call History.Record(Value.HistoryState, Town, Value.Guide.Ink)

        If Value.GuideBrowser.FocusPending Then

            Value.GuideBrowser.FocusPending = False
            Value.ViewRequest = 4
            Value.FocusPoint = Value.GuideBrowser.FocusPoint
            Value.Ui.Tool = 70
            Value.Ui.HideGuides = False

        End If

        Return 0

    End If

    If Value.Ui.Section = 1 Or Value.Ui.SunSlider.DragOwner > 0 Then

        Index = Sun.Input(Value.Ui.SunSlider, Town, Panel.LeftEdge() + 10, Key, Blocked)

        If Index > 0 Then

            If Index = 2 Then
                Call History.Record(Value.HistoryState, Town, Value.Guide.Ink)
            End If

            Return 0

        End If

    End If

    If Not Blocked Then
        Action = Command(Value, Town, Panel.Input(Value.Ui))
    End If

    If Key_Event_Held(KEY_CONTROL) And Key = KEY_Z Then

        Index = 32

        If Key_Event_Held(KEY_SHIFT) Then
            Index = 33
        End If

        Action = Command(Value, Town, Index)

    Else If Key_Event_Held(KEY_CONTROL) And Key = KEY_Y Then

        Action = Command(Value, Town, 33)

    Else If Key_Event_Held(KEY_CONTROL) And Key = KEY_D Then

        Index = 34

        If Value.Ui.Section = 3 Then
            Index = 87
        End If

        Action = Command(Value, Town, Index)

    Else If Key = KEY_ESCAPE Then

        Call Cancel(Value, Town)

    Else If Key = KEY_DELETE Then

        Index = 24

        If Value.Ui.Tool = 93 Or Value.Ui.Tool = 94 Then
            Index = 95
        End If

        If Value.Ui.Section = 3 Then
            Index = 88
        End If

        Action = Command(Value, Town, Index)

    End If

    If Value.Ui.Section = 7 Then

        OnGround = Picking.TerrainPoint(Town, View, Pointer_X(), Pointer_Y(), Window_Width(), Window_Height(), Value.Current)

        If Value.TerrainGesture.Tool.Mode = 5 Or Value.TerrainGesture.Tool.Mode = 6 Then

            If (OnGround And
                Not Blocked And
                Not Panel.Hovered() And
                Not Key_Held(KEY_SHIFT) And
                Pointer_Pressed(POINTER_PRIMARY) And
                Key <> KEY_ESCAPE And
                Not Value.TerrainGesture.Pending) Then

                Point = Camera.ProjectViewerPoint(Value.Current, View, Window_Width(), Window_Height())
                Radius = Camera.WorldSizeForPixels(14, Max(View.NearPlane, Point.Depth), View.FovDegrees, Window_Height())

                If View.OrthographicHeight > 0.0 Then
                    Radius = View.OrthographicHeight * 14.0 / ToDouble(Window_Height())
                End If

                If Value.TerrainGesture.Tool.Mode = 5 Then
                    Call RampTools.Point(Value.RampGesture, Town, Guides.Snap(Value.Guide, Value.Current, Radius))

                    Value.Ui.Message = Value.RampGesture.Message
                Else

                    Call WaterTools.Point(Value.WaterGesture, Town, Value.TerrainGesture, Value.Current)

                    Value.Ui.Message = Value.WaterGesture.Message
                End If

            End If

            Return Action

        End If

        Ok = TerrainTools.Gesture(Value.TerrainGesture, Town, Value.Current,
            OnGround And Not Blocked And Not Panel.Hovered() And Not Key_Held(KEY_SHIFT),
            Pointer_Pressed(POINTER_PRIMARY) And Key <> KEY_ESCAPE, Pointer_Held(POINTER_PRIMARY), Elapsed)
        Value.Ui.Message = Value.TerrainGesture.Message

        If Ok Then
            Call History.Record(Value.HistoryState, Town, Value.Guide.Ink)
        End If

        Return Action

    End If

    If Value.Ui.Category = 2 And Value.Ui.Surface = 6 Then

        OnGround = Picking.TerrainPoint(Town, View, Pointer_X(), Pointer_Y(), Window_Width(), Window_Height(), Value.Current)

        Call StyleTools.Gesture(Value.StyleGesture, Town, Value.Current,
            OnGround And Not Blocked And Not Panel.Hovered() And Not Key_Held(KEY_SHIFT),
            Pointer_Pressed(POINTER_PRIMARY) And Key <> KEY_ESCAPE, Pointer_Held(POINTER_PRIMARY),
            Value.Ui.Tool = 751, Value.Ui.PaintStyle)

        If Value.StyleGesture.Pending Then
            Value.Ui.Message = "Applying terrain style..."
        End If

        Return Action

    End If

    OnGround = Picking.Ground(View, Pointer_X(), Pointer_Y(), Window_Width(), Window_Height(), Value.Current)
    OnGround = (OnGround And Value.Current.X >= Town.Surface.XEdges[0] And
        Value.Current.X < Town.Surface.XEdges[Town.Surface.Columns] And
        Value.Current.Z >= Town.Surface.ZEdges[0] And
        Value.Current.Z < Town.Surface.ZEdges[Town.Surface.Rows])
    RawPoint = Value.Current

    Point = Camera.ProjectViewerPoint(RawPoint, View, Window_Width(), Window_Height())
    Radius = Camera.WorldSizeForPixels(14, Max(View.NearPlane, Point.Depth), View.FovDegrees, Window_Height())

    If View.OrthographicHeight > 0.0 Then
        Radius = View.OrthographicHeight * 14.0 / ToDouble(Window_Height())
    End If

    If (Value.Ui.Category = 2 And
        Value.Ui.Surface = 5 And
        ((Value.Ui.Tool >= 17 And Value.Ui.Tool <= 19) Or
        Value.Ui.Tool = 760 Or Value.Ui.Tool = 761)) Then

        OnGround = Picking.TerrainPoint(Town, View, Pointer_X(), Pointer_Y(), Window_Width(), Window_Height(), RawPoint)

        Call MapLoadTools.Gesture(Value.MapGesture, Town, RawPoint,
            OnGround And Not Blocked And Not Panel.Hovered() And Not Key_Held(KEY_SHIFT),
            Pointer_Pressed(POINTER_PRIMARY), Pointer_Held(POINTER_PRIMARY), Value.Ui.Tool)

        Value.Ui.Message = Value.MapGesture.Message

        If Not Value.MapGesture.Drawing And Not Value.MapGesture.Moving Then
            Call History.Record(Value.HistoryState, Town, Value.Guide.Ink)
        End If

        Return Action

    End If

    If Value.Ui.Tool = 93 Or Value.Ui.Tool = 94 Then

        Call CourtTools.Gesture(Value.CourtGesture, Town, Value.Guide, RawPoint,
            OnGround And Not Blocked And Not Panel.Hovered() And Not Key_Held(KEY_SHIFT),
            Pointer_Pressed(POINTER_PRIMARY), Pointer_Held(POINTER_PRIMARY), Value.Ui.Tool = 94)

        If Text_Length(Value.CourtGesture.Message) > 0 Then
            Value.Ui.Message = Value.CourtGesture.Message
        End If

        If Not Value.CourtGesture.Dragging Then
            Call History.Record(Value.HistoryState, Town, Value.Guide.Ink)
        End If

        Return Action

    End If

    If Value.Ui.Tool = 91 Or Value.Ui.Tool = 92 Then

        Call SectionTools.Gesture(Value.SectionGesture, Town, Value.Guide, RawPoint,
            OnGround And Not Blocked And Not Panel.Hovered() And Not Key_Held(KEY_SHIFT),
            Pointer_Pressed(POINTER_PRIMARY), Pointer_Held(POINTER_PRIMARY), Value.Ui.Tool = 92)

        Value.Ui.Message = Value.SectionGesture.Message

        Return Action

    End If

    Value.Current = Guides.Snap(Value.Guide, RawPoint, Radius)

    If Value.Guide.SnapTiles And Value.Ui.Category <> 2 Then
        Value.Current = Guides.SnapTile(Town.Surface, RawPoint)
    End If

    If (Value.Ui.Category = 2 And
        Value.Ui.Tool >= 12 And
        Value.Ui.Tool <= 14) Then
        Value.Current = RawPoint
    End If

    If Value.Ui.Tool >= 410 And Value.Ui.Tool <= 412 Then

        If Value.Ui.Tool = 412 Then
            Ok = SurfaceTools.EditPoint(Value.SurfaceGesture, Town.Surface, Value.Current, Radius,
                OnGround And Not Blocked And Not Panel.Hovered() And Not Key_Held(KEY_SHIFT),
                Pointer_Pressed(POINTER_PRIMARY), Pointer_Held(POINTER_PRIMARY))
        Else If (OnGround And
            Not Blocked And
            Not Panel.Hovered() And
            Not Key_Held(KEY_SHIFT) And
            Pointer_Pressed(POINTER_PRIMARY)) Then
            Ok = SurfaceTools.AddPoint(Value.SurfaceGesture, Town.Surface, Value.Current,
                SurfacePaint.FORM_TRIANGLE + Value.Ui.Tool - 410, Value.Ui.Surface,
                ToDouble(Value.Ui.Width * 20))
        End If

        If Ok Then
            Town.Revision = Town.Revision + 1

            Call History.Record(Value.HistoryState, Town, Value.Guide.Ink)
        End If

        If Text_Length(Value.SurfaceGesture.Message) > 0 Then
            Value.Ui.Message = Value.SurfaceGesture.Message
        End If

        Return Action

    End If

    If Value.Ui.Tool = 70 Or Value.MarkerGesture.Dragging Then

        If Value.Ui.HideGuides Then
            Return Action
        End If

        Call MarkerTools.Input(Value.MarkerGesture, Value.Guide, RawPoint, Radius,
            OnGround And Not Blocked And Not Panel.Hovered() And Not Key_Held(KEY_SHIFT))

        If Not Value.MarkerGesture.Dragging Then
            Call History.Record(Value.HistoryState, Town, Value.Guide.Ink)
        End If

        Return Action

    End If

    If Value.Selected.Dragging Then

        If OnGround Then
            Call Selection.DragSnapped(Value.Selected, Town, RawPoint, Value.Guide, Radius)
        End If

        If Not Pointer_Held(POINTER_PRIMARY) Then
            Call Selection.EndDrag(Value.Selected, Town, False)
            Call History.Record(Value.HistoryState, Town, Value.Guide.Ink)
        End If

    Else If Value.Rubber And Not Pointer_Held(POINTER_PRIMARY) Then

        For Index = 0 To Town.ItemCount - 1

            If Town.Items[Index].Active And Town.Items[Index].Category = Value.Ui.Category Then

                Box = Picking.Project(Town.Items[Index], View, Window_Width(), Window_Height())

                If (Box.Visible And
                    Box.X1 >= Min(Value.StartX, Pointer_X()) And
                    Box.X0 <= Max(Value.StartX, Pointer_X()) And
                    Box.Y1 >= Min(Value.StartY, Pointer_Y()) And
                    Box.Y0 <= Max(Value.StartY, Pointer_Y())) Then
                    Ok = Selection.Add(Value.Selected, Town, Index)
                End If

            End If

        End For

        Value.Rubber = False

    Else If (CapturesMap(Value) And
        Not Blocked And
        Not Panel.Hovered() And
        Not Key_Held(KEY_SHIFT) And
        Pointer_Pressed(POINTER_PRIMARY)) Then

        If (Value.Ui.Tool = 15 Or Value.Ui.Tool = 16) And OnGround Then

            If Value.Anchored Then

                Ok = Guides.Add(Value.Guide.Ink, Value.Anchor, Value.Current, Value.Ui.Tool = 16)
                Value.Anchored = False
                Value.Ui.Message = "Marker added (temporary)."

                If Not Ok Then
                    Value.Ui.Message = "Use a new endpoint; limit 128 markers."
                End If

            Else
                Value.Anchor = Value.Current
                Value.Anchored = True

            End If

        Else If Value.Ui.Category = 2 And OnGround Then

            If Value.Anchored Then

                Call Paint(Value, Town)

            Else
                Value.Anchor = Value.Current
                Value.Anchored = True

                If Value.Ui.Tool = 47 Or Value.Ui.Tool = 48 Then
                    Value.Ui.Message = "Center set. Click the circle edge."
                End If

            End If

        Else If Value.Ui.Tool = 11 And OnGround Then

            Call PlaceCopy(Value, Town)

        Else
            Picked = Picking.ItemAt(Town, Value.Ui.Category, View, Pointer_X(), Pointer_Y(), Window_Width(), Window_Height())

            If Picked >= 0 Then

                If Not Value.Selected.Selected[Picked] And Not Key_Held(KEY_CONTROL) Then
                    Call Selection.ClearSelection(Value.Selected)
                End If

                Ok = Selection.Add(Value.Selected, Town, Picked)

                If OnGround Then
                    Call Selection.BeginDrag(Value.Selected, Town, RawPoint)
                End If

            Else

                If Not Key_Held(KEY_CONTROL) Then
                    Call Selection.ClearSelection(Value.Selected)
                End If

                Value.Rubber = True
                Value.StartX = Pointer_X()
                Value.StartY = Pointer_Y()

            End If

        End If

    End If

    If Not Value.Selected.Dragging Then
        Call History.Record(Value.HistoryState, Town, Value.Guide.Ink)
    End If

    Return Action

End Function

Private Sub Outline(X0 As Number, Y0 As Number, X1 As Number, Y1 As Number)

    Dim ColorValue As Number

    ColorValue = RGB(70, 230, 215)
    Draw Line X0, Y0, X1, Y0, ColorValue
    Draw Line X1, Y0, X1, Y1, ColorValue
    Draw Line X1, Y1, X0, Y1, ColorValue
    Draw Line X0, Y1, X0, Y0, ColorValue

End Sub

Public Sub ApplyMapDestination(ByRef Value As State, ByRef Town As Document.State, Name As Text)

    Dim Ok As Boolean

    Ok = MapLoadTools.Apply(Value.MapGesture, Town, Name)
    Value.Ui.Message = Value.MapGesture.Message

    If Ok Then
        Value.Ui.Section = 0

        Call History.Record(Value.HistoryState, Town, Value.Guide.Ink)
    End If

End Sub

Public Sub Draw(ByRef Value As State, ByRef Town As Document.State, View As P.Camera3D)

    Dim Index As Number
    Dim Box As Picking.ScreenBox
    Dim Preview As Guides.Marker

    If Not Value.Enabled Then
        Return
    End If

    If Not Value.Ui.HideGuides Then

        Call Guides.Draw(Value.Guide, Town.Surface, View, Panel.LeftEdge())
        Call TileGuides.Draw(Value.Guide, Town, View, Panel.LeftEdge())
        Call MarkerTools.Draw(Value.MarkerGesture, View)

        If Value.Ui.Tool = 70 Then

            Clip Rectangle 0, 128, Panel.LeftEdge() - Value.GuideBrowser.Width, Window_Height() - 178

            Call MarkerResize.Draw(Value.Guide, View)

            End Clip

        End If

    End If

    Call MapLoadTools.Draw(Value.MapGesture, Town, View, Panel.LeftEdge())
    Call MapLoadTools.DrawPreview(Value.MapGesture, Town, View)
    Call SectionTools.Draw(Value.SectionGesture, Town, View)
    Call CourtTools.Draw(Value.CourtGesture, Town, View)

    If Value.Ui.Tool >= 410 And Value.Ui.Tool <= 412 Then

        Clip Rectangle 0, 128, Panel.LeftEdge(), Window_Height() - 178

        Call SurfaceTools.DrawShape(Value.SurfaceGesture, Town.Surface, Value.Current,
            View, Value.Ui.Tool = 412)

        End Clip

    End If

    For Index = 0 To Town.ItemCount - 1

        If Value.Selected.Selected[Index] Then

            Box = Picking.Project(Town.Items[Index], View, Window_Width(), Window_Height())

            If Box.Visible Then
                Call Outline(Box.X0, Max(94, Box.Y0), Min(Panel.LeftEdge(), Box.X1), Box.Y1)
            End If

        End If

    End For

    If Value.Rubber Then
        Call Outline(Value.StartX, Value.StartY, Pointer_X(), Pointer_Y())
    End If

    If Value.StyleGesture.Active Then
        Preview = TileGuides.CellRectangle(Town.Surface, Value.StyleGesture.First, Value.StyleGesture.Last)

        Call Guides.DrawMarker(Preview, View, RGB(70, 230, 215))
    End If

    If Value.Anchored And (Value.Ui.Tool < 15 Or Not Value.Ui.HideGuides) Then

        Preview.First = Value.Anchor
        Preview.Last = Value.Current
        Preview.IsRectangle = Value.Ui.Tool <> 12 And Value.Ui.Tool <> 15

        If Value.Ui.Category = 2 And (Value.Ui.Tool = 13 Or Value.Ui.Tool = 14) Then
            Preview = TileGuides.CellRectangle(Town.Surface, Value.Anchor, Value.Current)
        End If

        If Value.Ui.Tool = 47 Or Value.Ui.Tool = 48 Then
            Call SurfaceTools.Preview(Value.Anchor, Value.Current, ToDouble(Value.Ui.Width * 20),
                Value.Ui.Tool = 48, View)
        Else

            Call Guides.DrawMarker(Preview, View, RGB(70, 230, 215))
        End If

    End If

    Value.Ui.CanUndo = History.UndoCount(Value.HistoryState) > 0
    Value.Ui.CanRedo = History.RedoCount(Value.HistoryState) > 0

    Call Panel.Draw(Value.Ui, Town, Value.Guide, Value.Selected.SelectedCount)

    If Value.Ui.Section = 7 Then

        Call TerrainPanel.Draw(Value.Ui, Value.TerrainGesture, Value.RampGesture, Value.WaterGesture, Town)

        If Not Panel.Hovered() Then

            Clip Rectangle 0, 128, Panel.LeftEdge(), Window_Height() - 178

            If Value.TerrainGesture.Tool.Mode = 5 Then
                Call TerrainPanel.RampPreview(Value.RampGesture, View)
            Else If Value.TerrainGesture.Tool.Mode = 6 Then
                Call TerrainPanel.WaterPreview(Value.WaterGesture, Town, Value.Current, View)
            Else

                Call TerrainPanel.Preview(Value.TerrainGesture, Town, Value.Current, View)
            End If

            End Clip

        End If

    End If

    Call GuideList.Draw(Value.GuideBrowser, Value.Guide)

End Sub

End Module
