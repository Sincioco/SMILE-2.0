''' Unboxed conversation captions and stock controls; the shop session owns purchases.
Module Smile.Tools.TownArmoryPanel

Option Explicit

Import Smile.Tools.TownArmoryCatalog As Catalog
Import Smile.Tools.Character3DViewerCalibration As Formatting

Public Const BUY = 6
Public Const END_CONVERSATION = 7
Public Const PREVIOUS_ITEM = 8
Public Const NEXT_ITEM = 9

Public Type Bounds
    X As Number
    Y As Number
    Width As Number
    ActionY As Number
    ControlWidth As Number
End Type

Public Function Layout() As Bounds

    Dim Result As Bounds

    Result.X = Max(24, Window_Width() * 4 / 100)
    Result.Y = Window_Height() - 138
    Result.Width = Window_Width() - Result.X * 2
    Result.ActionY = Result.Y + 96
    Result.ControlWidth = Result.Width / 4

    Return Result

End Function

Public Function Hit(B As Bounds, X As Number, Y As Number) As Number

    Dim ReturnValue As Number

    If (X < B.X Or X >= B.X + B.ControlWidth * 4 Or
        Y < B.ActionY - 6 Or Y >= B.ActionY + 28) Then
        ReturnValue = -1

        Return ReturnValue
    End If

    If X < B.X + B.ControlWidth Then
        Return PREVIOUS_ITEM
    Else If X < B.X + B.ControlWidth * 2 Then
        Return NEXT_ITEM
    Else If X < B.X + B.ControlWidth * 3 Then
        Return BUY
    End If

    Return END_CONVERSATION

End Function

Private Sub Caption(Value As Text, X As Number, Y As Number, Font As Number, Tint As Number)

    Draw Text Value At X - 1, Y - 1 Size Font Color BLACK
    Draw Text Value At X + 1, Y - 1 Size Font Color BLACK
    Draw Text Value At X - 1, Y + 1 Size Font Color BLACK
    Draw Text Value At X + 1, Y + 1 Size Font Color BLACK
    Draw Text Value At X, Y Size Font Color Tint

End Sub

Public Sub Draw(B As Bounds, Selected As Number, Message As Text)

    Dim Item As Catalog.Weapon
    Dim Stock As Text
    Dim Font As Number

    Item = Catalog.ItemAt(Selected)
    Font = Max(12, Min(18, B.Width / 65))
    Stock = Formatting.NumberText(Selected + 1) + " / " + Formatting.NumberText(Catalog.ITEM_COUNT) + "   " + Item.Name
    Stock = Stock + "   |   " + Formatting.NumberText(Item.Price) + " gold   |   Attack +" + Formatting.NumberText(Item.Attack)

    Call Caption("Garran: " + Message, B.X, B.Y, Font, WHITE)
    Call Caption(Stock, B.X, B.Y + 36, Font, RGB(239, 206, 145))
    Call Caption(Item.Kind, B.X, B.Y + 63, Font - 1, WHITE)
    Call Caption("Up: Previous", B.X, B.ActionY, Font - 1, WHITE)
    Call Caption("Down: Next", B.X + B.ControlWidth, B.ActionY, Font - 1, WHITE)
    Call Caption("Enter: Buy", B.X + B.ControlWidth * 2, B.ActionY, Font - 1, WHITE)
    Call Caption("Esc: End conversation", B.X + B.ControlWidth * 3, B.ActionY, Font - 1, WHITE)

End Sub

End Module
