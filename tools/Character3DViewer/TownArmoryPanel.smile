''' Conversation overlay and hit regions; the shop session owns purchases.
Module Smile.Tools.TownArmoryPanel

Option Explicit

Import Smile.Tools.TownArmoryCatalog As Catalog
Import Smile.Tools.Character3DViewerCalibration As Formatting

Public Type Bounds
    X As Number
    Y As Number
    Width As Number
    Height As Number
    MenuX As Number
    MenuWidth As Number
    RowHeight As Number
End Type

Public Function Layout() As Bounds

    Dim Result As Bounds

    Result.X = Window_Width() * 7 / 100
    Result.Y = Max(112, Window_Height() * 14 / 100)
    Result.Width = Window_Width() - Result.X * 2
    Result.Height = Window_Height() - Result.Y - Max(48, Window_Height() * 8 / 100)
    Result.MenuWidth = Result.Width * 43 / 100
    Result.MenuX = Result.X + Result.Width - Result.MenuWidth - 18
    Result.RowHeight = Max(18, Min(45, (Result.Height - 286) / Catalog.ITEM_COUNT))

    If Result.Height < 480 Then
        Result.RowHeight = Max(18, (Result.Height - 244) / Catalog.ITEM_COUNT)
    End If

    Return Result

End Function

Public Function Hit(B As Bounds, X As Number, Y As Number) As Number

    Dim ReturnValue As Number

    Dim Index As Number

    If (X >= B.X + B.Width - 78 And
        X < B.X + B.Width - 12 And
        Y >= B.Y + 8 And
        Y < B.Y + 40) Then
        Return 7
    End If

    If X >= B.MenuX And X < B.MenuX + B.MenuWidth Then

        For Index = 0 To Catalog.ITEM_COUNT - 1

            If Y >= B.Y + 82 + Index * B.RowHeight And Y < B.Y + 82 + (Index + 1) * B.RowHeight Then
                Return Index
            End If

        End For

        If Y >= B.Y + B.Height - 158 And Y < B.Y + B.Height - 124 Then
            Return 6
        End If

    End If

    ReturnValue = -1

    Return ReturnValue

End Function

Public Sub Draw(B As Bounds, Selected As Number, Message As Text, Purchases As Number)

    Dim Index As Number
    Dim Y As Number
    Dim Tint As Number
    Dim Item As Catalog.Weapon
    Dim SelectedItem As Catalog.Weapon
    Dim Font As Number

    Font = Max(12, Min(18, B.Width / 65))
    Fill Rectangle B.X - 3, B.Y - 3, B.Width + 6, 3, RGB(201, 157, 86)
    Fill Rectangle B.X - 3, B.Y + B.Height, B.Width + 6, 3, RGB(201, 157, 86)
    Fill Rectangle B.X - 3, B.Y, 3, B.Height, RGB(201, 157, 86)
    Fill Rectangle B.X + B.Width, B.Y, 3, B.Height, RGB(201, 157, 86)
    Fill Rectangle B.X, B.Y, B.Width, 50, RGB(15, 23, 30) Opacity 96
    Draw Text "GARRAN'S ARMORY" At B.X + 22, B.Y + 12 Size 24 Color RGB(239, 206, 145)
    Fill Rectangle B.X + B.Width - 78, B.Y + 8, 66, 32, RGB(60, 47, 39)
    Draw Text "Close" At B.X + B.Width - 67, B.Y + 16 Size 15 Color WHITE

    Fill Rectangle B.X, B.Y + B.Height - 112, B.Width, 112, RGB(12, 22, 31) Opacity 96
    Draw Text "Garran  /  Weaponsmith" At B.X + 22, B.Y + B.Height - 98 Size 18 Color RGB(239, 206, 145)

    Draw Text "Welcome to my armory shop. What can I get you?" At B.X + 22, B.Y + B.Height - 68 Size Font Color WHITE
    Draw Text Message At B.X + 22, B.Y + B.Height - 36 Size Font - 1 Color RGB(137, 224, 196)
    Fill Rectangle B.MenuX - 12, B.Y + 60, B.MenuWidth + 24, B.Height - 182, RGB(12, 22, 31) Opacity 94
    Draw Text "WEAPONS" At B.MenuX + 10, B.Y + 63 Size Font Color RGB(239, 206, 145)

    For Index = 0 To Catalog.ITEM_COUNT - 1

        Item = Catalog.ItemAt(Index)
        Y = B.Y + 82 + Index * B.RowHeight
        Tint = RGB(23, 37, 47)

        If Index = Selected Then
            Tint = RGB(63, 80, 79)
        End If

        Fill Rectangle B.MenuX, Y, B.MenuWidth, B.RowHeight - 2, Tint
        Draw Text Item.Name At B.MenuX + 10, Y + 6 Size Font Color WHITE
        Draw Text Formatting.NumberText(Item.Price) + " G" At B.MenuX + B.MenuWidth - 78, Y + 6 Size Font Color RGB(239, 206, 145)
    End For

    SelectedItem = Catalog.ItemAt(Selected)
    Y = B.Y + 86 + Catalog.ITEM_COUNT * B.RowHeight

    If B.Height >= 480 Then
        Draw Text SelectedItem.Kind At B.MenuX, Y Size Font - 3 Color RGB(210, 218, 218)
        Draw Text "Attack +" + Formatting.NumberText(SelectedItem.Attack) At B.MenuX, Y + 20 Size Font - 2 Color RGB(137, 224, 196)
    End If

    Fill Rectangle B.MenuX, B.Y + B.Height - 158, B.MenuWidth, 34, RGB(133, 95, 42)
    Draw Text "Buy  /  " + Formatting.NumberText(SelectedItem.Price) + " gold" At B.MenuX + 14, B.Y + B.Height - 150 Size Font Color WHITE
    Draw Text "Demo purchases: " + Formatting.NumberText(Purchases) + "   |   Up/Down: Select   Enter: Buy   Esc: End Conversation" At B.X + 22, B.Y + B.Height + 12 Size Font - 2 Color WHITE

End Sub

End Module
