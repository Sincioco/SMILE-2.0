''' Checked inputs and two-generation commit points for disposable prepared map data.
Module Smile.Tools.TownDerivedCache

Option Explicit

Import Smile.Tools.TownDocument As Document
Import Smile.Tools.TownSurfaceStyles As Styles
Import Smile.Tools.TownDocumentStore As Store
Import Smile.Tools.TownDecks As Decks
Import Smile.Simple3D.SurfaceGrid3D As Grid
Import Smile.Simple3D.SurfacePaint3D As Paint
Import Smile.Simple3D.TerrainHeights3D As Heights

Private Dim Saved As Document.State
Private Dim Metadata[4] As Number
Private Dim Reference[1024] As Number

Public Function SameSurface(ByRef First As Grid.State, ByRef Second As Grid.State) As Boolean

    Dim Index As Number
    Dim FirstValue As Paint.Brush
    Dim SecondValue As Paint.Brush

    If Not Heights.Same(First.Heights, Second.Heights) Then
        Return False
    End If

    If (First.Columns <> Second.Columns Or
        First.Rows <> Second.Rows Or
        First.OriginX <> Second.OriginX Or
        First.OriginZ <> Second.OriginZ Or
        First.CellSize <> Second.CellSize Or
        First.Curves.BrushCount <> Second.Curves.BrushCount) Then
        Return False
    End If

    For Index = 0 To First.Columns

        If First.XEdges[Index] <> Second.XEdges[Index] Then
            Return False
        End If

    End For

    For Index = 0 To First.Rows

        If First.ZEdges[Index] <> Second.ZEdges[Index] Then
            Return False
        End If

    End For

    For Index = 0 To (First.Columns * First.Rows + 15) / 16 - 1

        If First.Cells[Index] <> Second.Cells[Index] Then
            Return False
        End If

    End For

    For Index = 0 To First.Curves.BrushCount - 1

        FirstValue = First.Curves.Brushes[Index]
        SecondValue = Second.Curves.Brushes[Index]

        If (FirstValue.Form <> SecondValue.Form Or
            FirstValue.Surface <> SecondValue.Surface Or
            FirstValue.X0 <> SecondValue.X0 Or
            FirstValue.Z0 <> SecondValue.Z0 Or
            FirstValue.X1 <> SecondValue.X1 Or
            FirstValue.Z1 <> SecondValue.Z1 Or
            FirstValue.Width <> SecondValue.Width Or
            FirstValue.WaterMode <> SecondValue.WaterMode Or
            FirstValue.FlowSign <> SecondValue.FlowSign Or
            FirstValue.FlowSpeed <> SecondValue.FlowSpeed) Then
            Return False
        End If

        If (FirstValue.Form >= Paint.FORM_TRIANGLE And
            (FirstValue.X2 <> SecondValue.X2 Or FirstValue.Z2 <> SecondValue.Z2)) Then
            Return False
        End If

    End For

    Return True

End Function

Public Function ReadKey(ByRef Town As Document.State, Category As Text,
    AllItems As Boolean) As Text

    Dim Generation As Number
    Dim Prefix As Text
    Dim Key As Text

    Prefix = "TownPrepared." + Category + "." + Town.Name
    Generation = ReadNumber(Prefix)

    If Generation >= 1 And Generation <= 2 Then

        Key = Prefix + "." + Text_From_Code(48 + Generation)

        If Matches(Town, Key, AllItems) Then
            Return Key
        End If

    End If

    ' Portable records live under an immutable save/import job key. Later edits
    ' can rebuild native generations without changing this saved revision.
    Key = BundleKey(Town.Name)

    If Text_Length(Key) = 0 Then
        Return ""
    End If

    If Category = "Terrain9" Then
        Key = Key + ".Terrain"
    Else If Category = "Roads1" Then
        Key = Key + ".Roads"
    Else
        Return ""
    End If

    If Matches(Town, Key, AllItems) Then
        Return Key
    End If

    Return ""

End Function

Private Function BundleKey(Name As Text) As Text

    Dim Length As Number
    Dim Status As Number
    Dim Index As Number
    Dim Key As Text

    Load Data "TownPrepared.Bundle." + Name Into Reference Count Length Status Status

    If (Status <> DATA_STATUS_OK Or
        Length < 1 Or
        Length > 1024) Then
        Return ""
    End If

    Key = ""

    For Index = 0 To Length - 1
        Key = Key + Text_From_Code(Reference[Index])
    End For

    If ReadNumber(Key + ".PreparedVersion") <> 9 Then
        Return ""
    End If

    Return Key

End Function

Public Sub AliasBundle(ByRef Town As Document.State, OriginalName As Text)

    Dim Key As Text
    Dim Ok As Boolean

    Key = BundleKey(OriginalName)

    If Text_Length(Key) = 0 Then
        Return
    End If

    If Matches(Town, Key + ".Terrain", False) And Matches(Town, Key + ".Roads", True) Then
        Ok = BindBundle(Town, Key)
    End If

End Sub

Private Function Matches(ByRef Town As Document.State, Key As Text, AllItems As Boolean) As Boolean

    Dim Index As Number
    Dim FirstValue As Document.Item
    Dim SecondValue As Document.Item
    Dim Openings As Decks.State

    If Not Store.LoadDocument(Saved, Key + ".Input") Then
        Return False
    End If

    If Not SameSurface(Town.Surface, Saved.Surface) Then
        Return False
    End If

    If Not AllItems And Not Styles.Same(Town.Appearance, Saved.Appearance) Then
        Return False
    End If

    If AllItems Then

        If Town.ItemCount <> Saved.ItemCount Then
            Return False
        End If

        For Index = 0 To Town.ItemCount - 1

            FirstValue = Town.Items[Index]
            SecondValue = Saved.Items[Index]

            If (FirstValue.Active <> SecondValue.Active Or
                FirstValue.Template <> SecondValue.Template Or
                FirstValue.Yaw <> SecondValue.Yaw Or
                FirstValue.Position.X <> SecondValue.Position.X Or
                FirstValue.Position.Y <> SecondValue.Position.Y Or
                FirstValue.Position.Z <> SecondValue.Position.Z Or
                FirstValue.Scale.X <> SecondValue.Scale.X Or
                FirstValue.Scale.Y <> SecondValue.Scale.Y Or
                FirstValue.Scale.Z <> SecondValue.Scale.Z) Then
                Return False
            End If

        End For

    Else

        Call Decks.Capture(Openings, Saved)

        If Not Decks.Matches(Openings, Town) Then
            Return False
        End If

    End If

    Return True

End Function

Public Function BindBundle(ByRef Town As Document.State, Key As Text) As Boolean

    Dim Index As Number
    Dim Status As Number
    Dim Ok As Boolean

    If ReadNumber(Key + ".PreparedVersion") <> 9 Then
        Return True
    End If

    If Text_Length(Key) > 1024 Then
        Return False
    End If

    Ok = Store.SaveDocument(Town, Key + ".Terrain.Input", False)
    Ok = Store.SaveDocument(Town, Key + ".Roads.Input", False) And Ok

    If Not Ok Then
        Return False
    End If

    For Index = 0 To Text_Length(Key) - 1
        Reference[Index] = Text_Code_At(Key, Index)
    End For

    Save Data Reference Count Text_Length(Key) To "TownPrepared.Bundle." + Town.Name Status Status
    Ok = Status = DATA_STATUS_OK

    Return Ok

End Function

Public Function WriteKey(Name As Text, Category As Text) As Text

    Dim Generation As Number
    Dim Prefix As Text
    Dim Result As Text

    Prefix = "TownPrepared." + Category + "." + Name
    Generation = ReadNumber(Prefix)

    If Generation = 0 Then
        Generation = 2
    End If

    Generation = 3 - Max(1, Min(2, Generation))
    Result = Prefix + "." + Text_From_Code(48 + Generation)

    Return Result

End Function

Public Function Commit(ByRef Town As Document.State, Category As Text, Key As Text) As Boolean

    Dim Generation As Number

    If Not Store.SaveDocument(Town, Key + ".Input", False) Then
        Return False
    End If

    Generation = Text_Code_At(Key, Text_Length(Key) - 1) - 48
    Dim Ok As Boolean

    Ok = WriteNumber(Generation, "TownPrepared." + Category + "." + Town.Name)

    Return Ok

End Function

Public Function ReadNumber(Key As Text) As Number

    Dim Status As Number
    Dim Length As Number
    Dim Index As Number
    Dim Result As Number

    Load Data Key Into Metadata Count Length Status Status

    If Status <> DATA_STATUS_OK Or Length <> 4 Then
        Return 0
    End If

    For Index = 0 To 3
        Result = Result * 256 + Metadata[Index]
    End For

    Return Result

End Function

Public Function WriteNumber(Value As Number, Key As Text) As Boolean

    Dim Index As Number
    Dim Status As Number
    Dim Ok As Boolean

    For Index = 0 To 3
        Metadata[3 - Index] = Value Mod 256
        Value = Value / 256
    End For

    Save Data Metadata Count 4 To Key Status Status
    Ok = Status = DATA_STATUS_OK

    Return Ok

End Function

End Module
