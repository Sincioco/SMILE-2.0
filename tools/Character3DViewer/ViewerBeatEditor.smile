''' Beat-shot selection, drafts and presentation. Party remains the scene/actor owner.
Module Smile.Tools.ViewerBeatEditor

Option Explicit

Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.PrecisionMath3D As M
Import Smile.Simple3D.PrecisionCamera3D As Projection
Import Smile.Simple3D.Character3D As C
Import Smile.Tools.BattleCameraShots As Shots
Import Smile.Tools.Character3DViewerBeatHeadPersistence As HeadPersistence
Import Smile.Tools.BattleCameraTimeline As Track
Import Smile.Tools.ViewerBeatTimeline As Timeline
Import Smile.Tools.ViewerBeatSequence As Sequence
Import Smile.Tools.Character3DViewerCamera As Camera
Import Smile.Tools.Character3DViewerParty As Party
Import Smile.UI.Controls As UI
Import Smile.Tools.Character3DViewerInput As Input

Public Type State
    Tracks[7] As Track.Definition
    Working As Track.Definition
    Timeline As Timeline.State
    SourceSchedule As Sequence.Timing
    ShotIndex As Number
    HeadStorage As HeadPersistence.State
    HeadIds[2] As Number
    CornerX[2, 8] As Number
    CornerY[2, 8] As Number
    CornerVisible[2, 8] As Boolean
    Clipboard As Shots.Shot
    ClipboardName As Text
    Selected As Number
    Beat As Number
    DisplayBeat As Number
    Preview As Boolean
    Playing As Boolean
    Editing As Boolean
    Scrubbing As Boolean
    Dirty As Boolean
    Seek As Boolean
    ContinuousSample As Boolean
    Reframe As Boolean
    Elapsed As Number
    Schedule As Sequence.Timing
    Draft As Shots.Shot
    UseDefault As Boolean
    ResetShot As Shots.Shot
    ResetRequested As Boolean
    NewEdit As Boolean
    Camera As Camera.State
    OriginalCamera As Camera.State
    Bookmark As Sequence.Bookmark
    WasPaused As Boolean
    WasDemo As Boolean
    DragMarker As Number
    Marker As Number
    TimelineDrag As Boolean
    PickPending As Boolean
    PickX As Number
    PickY As Number
    PickCamera As P.Camera3D
    DragOrigin As P.Vector3
    DragDepth As Double
    DragOffset As P.Vector3
    HeadActors[2] As C.Actor
    Heads[2] As P.Vector3
    BoxX[2] As Number
    BoxY[2] As Number
    BoxWidth[2] As Number
    BoxHeight[2] As Number
    BoxVisible[2] As Boolean
    Message As Text
End Type

Public Type PointerCoordinates
    ViewportY As Number
    PanelY As Number
End Type

Public Function Key(Identity As Number, Beat As Number) As Text

    Dim Result As Text

    Result = "BattleCamera." + Sequence.Name(Identity) + ".Beat" + Digit(Beat + 1)

    Return Result

End Function

Public Sub LoadShots(ByRef Value As State)

    Dim Identity As Number
    Dim Beat As Number
    Dim Loaded As Boolean

    Value.DragMarker = -1

    For Identity = 0 To 6

        Call Track.Initialize(Value.Tracks[Identity])

        Loaded = HeadPersistence.LoadEntry(Value.HeadStorage, Identity,
            "BattleCamera.Head." + Sequence.Name(Identity))
        Loaded = Track.ReadDefinition("BattleCamera.Sequence." + Sequence.Name(Identity) + ".V2",
            Value.Tracks[Identity])

        If Not Loaded Then

            For Beat = 0 To 3
                Loaded = Shots.ReadShot(Key(Identity, Beat), Value.Tracks[Identity].Cameras[Beat])
            End For

        End If

    End For

End Sub

Public Function Head(Value As State, Identity As Number) As Shots.HeadReference

    Dim Result As Shots.HeadReference

    Result = HeadPersistence.Current(Value.HeadStorage, Identity)

    Return Result

End Function

Public Function Slot(Value As State, Unity As Boolean, Beat As Number) As Number

    Dim Result As Number

    Result = Sequence.Identity(Unity, Value.Selected) * 4 + Beat

    Return Result

End Function

Public Function SelectActor(ByRef Value As State, Selected As Number) As Boolean

    If Value.Preview Then
        Value.Message = "Save Or Close Preview Before Selecting"
        Return False
    End If

    Value.Selected = Selected
    Value.Message = "Select A Beat To Edit Its Camera"

    Return True

End Function

Public Sub Open(ByRef Value As State, ByRef Scene As Party.State,
    Primary As C.Actor, Boss As C.Actor, CurrentCamera As Camera.State,
    Paused As Boolean, Demo As Boolean, Speed As Number, Beat As Number, Edit As Boolean)

    Dim Bounds As C.PreciseBounds3D
    Dim RetainDraft As Boolean

    Call StoreDraft(Value)

    If Not Value.Preview Then

        Value.Bookmark = Sequence.Remember(Scene)

        Call Sequence.RememberPoses(Value.Bookmark, Scene, Primary, Boss)

        Value.OriginalCamera = CurrentCamera
        Value.WasPaused = Paused
        Value.WasDemo = Demo
        Value.Working = Value.Tracks[Sequence.Identity(Scene.UnityRoster, Value.Selected)]
        Value.Timeline.DragKind = 0
        Value.Timeline.RepeatDirection = 0

    End If

    RetainDraft = Value.Editing And Beat = Value.ShotIndex
    Value.Beat = Beat
    Value.ShotIndex = Beat
    Value.Preview = True
    Value.Playing = False
    Value.Editing = Edit
    Value.Scrubbing = Not Edit
    Value.NewEdit = Not RetainDraft

    If Not RetainDraft Then
        Value.Draft = Value.Working.Cameras[Beat]
        Value.UseDefault = Not Value.Draft.Saved
    End If

    Value.HeadActors[0] = Sequence.Actor(Scene, Primary, Boss, Value.Selected)
    Value.HeadActors[1] = Sequence.Actor(Scene, Primary, Boss, Sequence.Opponent(Scene, Value.Selected))

    Value.HeadIds[0] = Sequence.Identity(Scene.UnityRoster, Value.Selected)
    Value.HeadIds[1] = Sequence.Identity(Scene.UnityRoster, Sequence.Opponent(Scene, Value.Selected))

    Call InitializeHead(Value, 0)
    Call InitializeHead(Value, 1)

    Value.SourceSchedule = Sequence.Times(Scene, Primary, Speed, Value.Selected, 0)
    Value.Schedule = Track.Schedule(Value.Working, Value.SourceSchedule, 0)
    Value.Timeline.FrameRate = Max(1, C.ClipSampleRate(Value.HeadActors[0], 0))
    Value.Elapsed = Value.Schedule.Start[Beat]
    Value.Seek = True
    Value.ContinuousSample = False
    Value.Reframe = Edit
    Value.Message = "MMB Orbit; LMB Pan; Wheel Zoom; RMB Reset"

End Sub

Private Function CurrentShot(Value As State, Unity As Boolean, Identity As Number,
    Beat As Number) As Shots.Shot

    Dim Result As Shots.Shot

    Result = Value.Tracks[Identity].Cameras[Beat]

    If Value.Preview And Identity = Sequence.Identity(Unity, Value.Selected) Then
        Result = Value.Working.Cameras[Beat]
    End If

    If (Value.Editing And
        Beat = Value.ShotIndex And
        Identity = Sequence.Identity(Unity, Value.Selected)) Then

        If Not Value.UseDefault Then
            Result = Value.Draft
        End If

    End If

    Return Result

End Function

Public Function PlaybackCamera(Value As State, Unity As Boolean, Turn As Number,
    Attacker As C.Actor, Target As C.Actor, TargetIdentity As Number, Schedule As Sequence.Timing,
    Time As Number, Fallback As P.Camera3D) As P.Camera3D

    Dim Identity As Number
    Dim Current As Shots.Shot
    Dim Previous As Shots.Shot
    Dim Following As Shots.Shot
    Dim Result As P.Camera3D
    Dim Definition As Track.Definition
    Dim Index As Number
    Dim Before As Number
    Dim After As Number
    Dim StartTime As Number
    Dim EndTime As Number
    Dim Progress As Double

    Identity = Sequence.Identity(Unity, Turn)
    Definition = Value.Tracks[Identity]

    If Value.Preview And Identity = Sequence.Identity(Unity, Value.Selected) Then
        Definition = Value.Working
    End If

    Index = Track.AtTime(Definition, Schedule, Time)
    StartTime = Track.TimeAt(Definition, Schedule, Index)
    EndTime = Schedule.Start[4]
    Before = Track.Neighbor(Definition, Schedule, StartTime, -1)
    After = Track.Neighbor(Definition, Schedule, StartTime, 1)
    Current = CurrentShot(Value, Unity, Identity, Index)

    If Before >= 0 Then
        Previous = CurrentShot(Value, Unity, Identity, Before)
    End If

    If After >= 0 Then
        Following = CurrentShot(Value, Unity, Identity, After)
        EndTime = Track.TimeAt(Definition, Schedule, After)
    End If

    Progress = Clamp(ToDouble(Time - StartTime) / ToDouble(Max(1, EndTime - StartTime)), 0.0, 1.0)
    Result = Shots.ResolveLinked(Current, Previous, Following,
        Sequence.Head(Attacker, Head(Value, Identity).Offset),
        Sequence.Head(Target, Head(Value, TargetIdentity).Offset), Fallback, Progress)

    Return Result

End Function

Public Sub Update(ByRef Value As State, ByRef Scene As Party.State,
    Primary As C.Actor, Boss As C.Actor, ByRef Live As P.Camera3D,
    Speed As Number, Elapsed As Number, Width As Number, Height As Number,
    ApplySaved As Boolean)

    Dim Attacker As C.Actor
    Dim Target As C.Actor
    Dim Schedule As Sequence.Timing
    Dim Ok As Boolean
    Dim Index As Number
    Dim Projected As Projection.ProjectedPoint
    Dim WidthValue As Double
    Dim HeightValue As Double
    Dim Focal As Double

    Attacker = Sequence.Actor(Scene, Primary, Boss, Scene.Turn)
    Target = Sequence.Actor(Scene, Primary, Boss, Sequence.Opponent(Scene, Scene.Turn))
    Value.SourceSchedule = Sequence.Times(Scene, Primary, Speed, Scene.Turn, Scene.Elapsed)
    Schedule = Track.Schedule(Value.Tracks[Sequence.Identity(Scene.UnityRoster, Scene.Turn)],
        Value.SourceSchedule, Scene.Elapsed)
    Value.Timeline.Clock = Value.Timeline.Clock + Max(0, Elapsed)

    If Value.Preview Then
        Schedule = Track.Schedule(Value.Working, Value.SourceSchedule, Value.Elapsed)
    End If

    If Not Value.Preview Then

        If ApplySaved And Scene.EstablishRemaining = 0 Then
            Live = PlaybackCamera(Value, Scene.UnityRoster, Scene.Turn, Attacker, Target,
                Sequence.Identity(Scene.UnityRoster, Sequence.Opponent(Scene, Scene.Turn)), Schedule, Scene.Elapsed, Live)
            Value.Camera.Live = Live
        End If

        Return

    End If

    Value.Schedule = Schedule
    Value.DisplayBeat = Schedule.Beat
    Value.HeadActors[0] = Attacker
    Value.HeadActors[1] = Target
    Value.HeadIds[0] = Sequence.Identity(Scene.UnityRoster, Scene.Turn)
    Value.HeadIds[1] = Sequence.Identity(Scene.UnityRoster, Sequence.Opponent(Scene, Scene.Turn))
    Value.Heads[0] = Sequence.Head(Attacker, Head(Value, Value.HeadIds[0]).Offset)
    Value.Heads[1] = Sequence.Head(Target, Head(Value, Value.HeadIds[1]).Offset)

    If Value.Reframe Then

        If Value.ResetRequested Then
            Value.Draft = Value.ResetShot
            Value.ResetRequested = False
        End If

        If Not Value.Draft.Saved Then
            Call Shots.Capture(Value.Draft, Live, Value.Heads[0], Value.Heads[1])
        End If

        If Value.NewEdit Then
            Value.ResetShot = Value.Draft
            Value.NewEdit = False
        End If

        Value.Camera.Base = Shots.Resolve(Value.Draft, Value.Heads[0], Value.Heads[1], Live, 0.0)
        Value.Camera.Live = Value.Camera.Base
        Value.Camera.Frame.PanXLimit = 1000.0
        Value.Camera.Frame.PanYLimit = 1000.0

        Call Camera.Reset(Value.Camera, 0, 0, -100, 100, 120000)

        Value.Reframe = False

    End If

    If Value.Editing And Not Value.Scrubbing Then

        Ok = Camera.AdvanceZoom(Value.Camera, Elapsed)

        Call Camera.ComposeShot(Value.Camera)
        Call Camera.KeepAboveGround(Value.Camera, 0)
        Call Shots.Capture(Value.Draft, Value.Camera.Live, Value.Heads[0], Value.Heads[1])

        Live = Value.Camera.Live

    Else
        Live = PlaybackCamera(Value, Scene.UnityRoster, Scene.Turn, Attacker, Target,
                Sequence.Identity(Scene.UnityRoster, Sequence.Opponent(Scene, Scene.Turn)), Schedule, Scene.Elapsed, Live)
        Value.Camera.Live = Live

    End If

    Call ProjectHeads(Value, Live, Width, Height)

End Sub

Public Function SaveShot(ByRef Value As State, Unity As Boolean) As Boolean

    If Not Value.Editing Then
        Return False
    End If

    Call StoreDraft(Value)

    If Not Track.WriteDefinition("BattleCamera.Sequence." +
        Sequence.Name(Sequence.Identity(Unity, Value.Selected)) + ".V2", Value.Working) Then
        Value.Message = "Save Failed; Draft Retained"
        Return False
    End If

    Value.Tracks[Sequence.Identity(Unity, Value.Selected)] = Value.Working
    Value.Dirty = False
    Value.Message = "Camera Saved"

    Return True

End Function

Public Function SetHead(ByRef Value As State, Identity As Number,
    Candidate As Shots.HeadReference) As Boolean

    Dim Result As Boolean

    Result = HeadPersistence.Replace(Value.HeadStorage, Identity, Candidate)

    If Result Then
        Value.Message = Sequence.Name(Identity) + " Head Adjustment Pending"
    End If

    Return Result

End Function

Public Function SaveHead(ByRef Value As State, Index As Number) As Boolean

    Dim Identity As Number
    Dim Result As Boolean

    If Index < 0 Or Index > 1 Then
        Return False
    End If

    Identity = Value.HeadIds[Index]
    Result = HeadPersistence.SaveEntry(Value.HeadStorage, Identity,
        "BattleCamera.Head." + Sequence.Name(Identity))

    If Result Then
        Value.Message = Sequence.Name(Identity) + " Head Cuboid Saved"
    Else
        Value.Message = Sequence.Name(Identity) + " Head Save Failed; Retry Or Discard"
    End If

    Return Result

End Function

Public Function RetryHeadSave(ByRef Value As State) As Boolean

    Dim Identity As Number
    Dim Result As Boolean

    Identity = HeadPersistence.FirstFailed(Value.HeadStorage)

    If Identity < 0 Then
        Identity = HeadPersistence.FirstPending(Value.HeadStorage)
    End If

    If Identity < 0 Then
        Value.Message = "No Head Adjustment Needs Retry"
        Return False
    End If

    Result = HeadPersistence.SaveEntry(Value.HeadStorage, Identity,
        "BattleCamera.Head." + Sequence.Name(Identity))

    If Result Then
        Value.Message = Sequence.Name(Identity) + " Head Cuboid Saved"
    Else
        Value.Message = Sequence.Name(Identity) + " Head Save Failed; Retry Or Discard"
    End If

    Return Result

End Function

Public Function DiscardHeadChanges(ByRef Value As State) As Boolean

    Dim Identity As Number
    Dim Result As Boolean

    Identity = HeadPersistence.FirstFailed(Value.HeadStorage)

    If Identity < 0 Then
        Identity = HeadPersistence.FirstPending(Value.HeadStorage)
    End If

    If Identity < 0 Then
        Value.Message = "No Pending Head Adjustment To Discard"
        Return False
    End If

    Result = HeadPersistence.Discard(Value.HeadStorage, Identity)

    If Result Then
        Value.Reframe = Value.Editing
        Value.Message = (Sequence.Name(Identity) +
            " Head Changes Discarded; Camera Draft Kept")
    End If

    Return Result

End Function

Public Function HeadWarning(Value As State) As Text

    Dim Identity As Number
    Dim Result As Text

    Identity = HeadPersistence.FirstFailed(Value.HeadStorage)

    If Identity >= 0 Then
        Result = Sequence.Name(Identity) + " Head Save Failed - Retry Or Discard"
    End If

    Return Result

End Function

Public Function HasPendingHead(Value As State) As Boolean

    Dim Result As Boolean

    Result = HeadPersistence.FirstPending(Value.HeadStorage) >= 0

    Return Result

End Function

Public Sub Copy(ByRef Value As State, Unity As Boolean)

    Value.Clipboard = Value.Tracks[Sequence.Identity(Unity, Value.Selected)].Cameras[Value.Beat]

    If Value.Editing Then
        Value.Clipboard = Value.Draft
    End If

    Value.ClipboardName = (Sequence.Name(Sequence.Identity(Unity, Value.Selected)) +
        " Shot " + ShotNumber(Value.ShotIndex + 1))
    Value.Message = "Copied " + Value.ClipboardName

End Sub

Public Function Digit(Value As Number) As Text

    Dim Result As Text

    Result = Text_Slice("0123456789", Value, 1)

    Return Result

End Function

Private Function ShotNumber(Value As Number) As Text

    Dim Result As Text

    Result = Digit(Value Mod 10)

    If Value >= 10 Then
        Result = Digit(Value / 10) + Result
    End If

    Return Result

End Function

Public Sub Paste(ByRef Value As State)

    If Not Value.Editing Or Not Value.Clipboard.Saved Then
        Value.Message = "Copy A Shot; Select A Destination Beat"
        Return
    End If

    Value.Draft = Value.Clipboard
    Value.UseDefault = False
    Value.Playing = False

    If Value.ShotIndex = 0 And Value.Draft.Connection = -1 Then
        Value.Draft.Connection = 0
    Else If (Track.Neighbor(Value.Working, Value.Schedule, Track.TimeAt(Value.Working, Value.Schedule, Value.ShotIndex), 1) < 0 And
        Value.Draft.Connection = 1) Then
        Value.Draft.Connection = 0
    End If

    Value.Dirty = True
    Value.Scrubbing = False
    Value.Reframe = True
    Value.NewEdit = True
    Value.Elapsed = Track.TimeAt(Value.Working, Value.Schedule, Value.ShotIndex)
    Value.Seek = True
    Value.Message = "Pasted " + Value.ClipboardName + "; Save To Keep"

End Sub

Public Function Contains(X As Number, Y As Number, PanelLeft As Number, Top As Number,
    Width As Number, Height As Number) As Boolean

    Dim Result As Boolean

    Result = X >= PanelLeft And X < PanelLeft + Width And Y >= Top And Y < Top + Height

    Return Result

End Function

Public Function ResolvePointerCoordinates(ViewportY As Number,
    ScrollOffset As Number) As PointerCoordinates

    Dim Result As PointerCoordinates

    Result.ViewportY = ViewportY
    Result.PanelY = ViewportY + ScrollOffset

    Return Result

End Function

Public Function PanelContentHeight(Editing As Boolean) As Number

    If Editing Then
        Return 520
    End If

    Return 283

End Function

''' Commands 1-4 edit a beat, 5 preview, 6 save, 7 copy, 8 paste, 9 cancel.
Public Function Pointer(ByRef Value As State, Unity As Boolean, Live As P.Camera3D,
    Width As Number, Height As Number, ScrollOffset As Number,
    PanelTop As Number, PanelHeight As Number) As Number

    Dim ReturnValue As Number

    Dim ViewportX As Number
    Dim ViewportY As Number
    Dim PanelY As Number
    Dim Coordinates As PointerCoordinates
    Dim PanelLeft As Number
    Dim Index As Number
    Dim Cursor As P.Vector3
    Dim Delta As P.Vector3
    Dim Projected As Projection.ProjectedPoint
    Dim Amount As Double
    Dim TimelineCommand As Number
    Dim Candidate As Shots.HeadReference
    Dim Changed As Boolean

    ViewportX = Pointer_X()
    Coordinates = ResolvePointerCoordinates(Pointer_Y(), ScrollOffset)
    ViewportY = Coordinates.ViewportY
    PanelY = Coordinates.PanelY
    PanelLeft = Width - 268

    If Value.DragMarker >= 0 Then

        If Not Pointer_Held(POINTER_PRIMARY) Then

            Changed = SaveHead(Value, Value.DragMarker)

            Value.DragMarker = -1
            Return 100

        End If

        Cursor = Projection.CursorPointAtDepth(Live, ViewportX, ViewportY,
            Value.DragDepth, Width, Height)
        Delta = Sequence.LocalOffset(Value.HeadActors[Value.DragMarker], M.Subtract(Cursor, Value.DragOrigin))
        Delta = M.Add(Value.DragOffset, Delta)

        If M.Length(Delta) <= 1000.0 Then

            Candidate = Head(Value, Value.HeadIds[Value.DragMarker])
            Candidate.Offset = Delta
            Changed = SetHead(Value, Value.HeadIds[Value.DragMarker], Candidate)

        End If

        Return 100

    End If

    If Value.Preview Then

        TimelineCommand = Timeline.Pointer(Value.Timeline, Value.Working,
            Value.SourceSchedule, Value.Elapsed, Value.Editing, Width, Height)

        If TimelineCommand <> 0 Then
            Call ApplyTimelineCommand(Value, Unity, TimelineCommand, Live)

            Return 100
        End If

    End If

    If Contains(ViewportX, ViewportY, PanelLeft, PanelTop, 252, PanelHeight) Then

        If Not Pointer_Pressed(POINTER_PRIMARY) Then
            Return 100
        End If

        If Contains(ViewportX, PanelY, PanelLeft + 8, 172, 236, 26) Then
            Return 5
        End If

        For Index = 0 To 3

            If Contains(ViewportX, PanelY, PanelLeft + 8 + Index * 60, 208, 56, 26) Then
                ReturnValue = Index + 1

                Return ReturnValue
            End If

        End For

        For Index = 0 To 3

            If Contains(ViewportX, PanelY, PanelLeft + 8 + Index * 60, 266, 56, 26) Then
                ReturnValue = Index + 6

                Return ReturnValue
            End If

        End For

        If Not Value.Editing Then
            Return 100
        End If

        If Contains(ViewportX, PanelY, PanelLeft + 8, 302, 236, 26) Then

            Call ResumeCamera(Value)

            Value.Draft.Motion = (Value.Draft.Motion + 1) Mod 5
            Value.UseDefault = False
            Value.Dirty = True

        Else If Contains(ViewportX, PanelY, PanelLeft + 8, 334, 236, 26) Then

            Call ResumeCamera(Value)

            Value.Draft.Connection = Value.Draft.Connection + 1
            Value.UseDefault = False

            If Value.Draft.Connection > 1 Then
                Value.Draft.Connection = -1
            End If

            If ((Value.ShotIndex = 0 And Value.Draft.Connection = -1) Or
                (Track.Neighbor(Value.Working, Value.Schedule,
                Track.TimeAt(Value.Working, Value.Schedule, Value.ShotIndex), 1) < 0 And
                Value.Draft.Connection = 1)) Then
                Value.Draft.Connection = 0
            End If

            Value.Dirty = True

        Else If Contains(ViewportX, PanelY, PanelLeft + 8, 366, 236, 24) Then

            Value.Marker = 1 - Value.Marker

        Else If Contains(ViewportX, PanelY, PanelLeft + 8, 394, 236, 24) Then

            Amount = -2.0

            If ViewportX >= PanelLeft + 126 Then
                Amount = 2.0
            End If

            Candidate = Head(Value, Value.HeadIds[Value.Marker])
            Candidate.Size.X = Clamp(Candidate.Size.X + Amount, 1.0, 1000.0)
            Changed = SetHead(Value, Value.HeadIds[Value.Marker], Candidate)

        Else If Contains(ViewportX, PanelY, PanelLeft + 8, 422, 236, 24) Then

            Amount = -2.0

            If ViewportX >= PanelLeft + 126 Then
                Amount = 2.0
            End If

            Candidate = Head(Value, Value.HeadIds[Value.Marker])
            Candidate.Size.Y = Clamp(Candidate.Size.Y + Amount, 1.0, 1000.0)
            Changed = SetHead(Value, Value.HeadIds[Value.Marker], Candidate)

        Else If Contains(ViewportX, PanelY, PanelLeft + 8, 450, 236, 24) Then

            Amount = -2.0

            If ViewportX >= PanelLeft + 126 Then
                Amount = 2.0
            End If

            Candidate = Head(Value, Value.HeadIds[Value.Marker])
            Candidate.Size.Z = Clamp(Candidate.Size.Z + Amount, 1.0, 1000.0)
            Changed = SetHead(Value, Value.HeadIds[Value.Marker], Candidate)

        Else If Contains(ViewportX, PanelY, PanelLeft + 8, 486, 114, 26) Then

            Call ResetDefaults(Value, False)

        Else If Contains(ViewportX, PanelY, PanelLeft + 130, 486, 114, 26) Then

            Call ResetDefaults(Value, True)

        Else If Contains(ViewportX, PanelY, PanelLeft + 8, 520, 236, 26) Then

            Call ResetLengths(Value)

        Else If Contains(ViewportX, PanelY, PanelLeft + 8, 576, 114, 26) Then

            Changed = RetryHeadSave(Value)

        Else If Contains(ViewportX, PanelY, PanelLeft + 130, 576, 114, 26) Then

            Changed = DiscardHeadChanges(Value)

        End If

        If (Changed And
            PanelY >= 394 And
            PanelY < 474) Then
            Changed = SaveHead(Value, Value.Marker)
        End If

        Return 100

    End If

    If (Value.Editing And
        Not Value.Scrubbing And
        Pointer_Pressed(POINTER_PRIMARY)) Then

        For Index = 0 To 1

            If (Value.BoxVisible[Index] And
                Contains(ViewportX, ViewportY, Value.BoxX[Index], Value.BoxY[Index],
                Value.BoxWidth[Index], Value.BoxHeight[Index])) Then

                Value.DragMarker = Index
                Value.Marker = Index
                Projected = Projection.ProjectViewerPoint(Value.Heads[Index], Live, Width, Height)
                Value.DragDepth = Projected.Depth
                Value.DragOrigin = Projection.CursorPointAtDepth(Live, ViewportX,
                    ViewportY, Projected.Depth, Width, Height)
                Value.DragOffset = Head(Value, Value.HeadIds[0]).Offset

                If Index = 1 Then
                    Value.DragOffset = Head(Value, Value.HeadIds[1]).Offset
                End If

                Return 100

            End If

        End For

    End If

    Return 0

End Function

Public Function MotionName(Motion As Number) As Text

    If Motion = 1 Then
        Return "Orbit Left"
    Else If Motion = 2 Then
        Return "Orbit Right"
    Else If Motion = 3 Then
        Return "Zoom Forward"
    Else If Motion = 4 Then
        Return "Zoom Backward"
    End If

    Return "Stationary"

End Function

Public Function ConnectionName(Connection As Number) As Text

    If Connection = -1 Then
        Return "From Previous"
    Else If Connection = 1 Then
        Return "To Next"
    End If

    Return "Cut / No Connection"

End Function

Public Sub Draw(Value As State, Unity As Boolean, Width As Number, Height As Number,
    TargetName As Text, ClipName As Text, ScrollOffset As Number,
    PanelTop As Number, PanelHeight As Number)

    Dim PanelLeft As Number
    Dim Index As Number
    Dim Label As Text
    Dim Position As Number
    Dim EndPosition As Number
    Dim Tint As Number
    Dim Warning As Text

    PanelLeft = Width - 268

    Clip Rectangle PanelLeft, PanelTop, 252, PanelHeight

    Draw Text "BEAT CAMERA: " + Sequence.Name(Sequence.Identity(Unity, Value.Selected)) At PanelLeft + 8, 120 - ScrollOffset Size 14 Color WHITE
    Draw Text "Target: " + TargetName At PanelLeft + 8, 142 - ScrollOffset Size 11 Color CYAN
    Draw Text "Tab / Click To Select" At PanelLeft + 8, 157 - ScrollOffset Size 10 Color LIGHT_GRAY

    Call UI.DrawButton(PanelLeft + 8, 172 - ScrollOffset, 236, 26,
        "Preview Beats", Value.Preview)

    For Index = 0 To 3

        Label = "Beat " + Digit(Index + 1)

        If Value.Tracks[Sequence.Identity(Unity, Value.Selected)].Cameras[Index].Saved Then
            Label = Label + " *"
        End If

        Call UI.DrawButton(PanelLeft + 8 + Index * 60, 208 - ScrollOffset, 56, 26, Label,
            Value.Editing And Value.ShotIndex = Index)
    End For

    Label = "Defaults Until Saved"

    If Value.Editing Then

        Label = "Editing Beat " + Digit(Value.Beat + 1)

        If Value.ShotIndex >= 4 Then
            Label = "Editing Extra Shot " + ShotNumber(Value.ShotIndex - 3)
        End If

    Else If Value.Preview Then

        Label = "Preview Only - Saved Shots Unchanged"

    End If

    Draw Text Label At PanelLeft + 8, 245 - ScrollOffset Size 11 Color YELLOW

    Call UI.DrawButton(PanelLeft + 8, 266 - ScrollOffset, 56, 26, "Save", False)
    Call UI.DrawButton(PanelLeft + 68, 266 - ScrollOffset, 56, 26, "Copy", False)
    Call UI.DrawButton(PanelLeft + 128, 266 - ScrollOffset, 56, 26, "Paste", False)
    Call UI.DrawButton(PanelLeft + 188, 266 - ScrollOffset, 56, 26, "Cancel", False)

    If Value.Editing Then

        Call UI.DrawButton(PanelLeft + 8, 302 - ScrollOffset, 236, 26,
            "Motion: " + MotionName(Value.Draft.Motion), False)
        Call UI.DrawButton(PanelLeft + 8, 334 - ScrollOffset, 236, 26,
            "Connect: " + ConnectionName(Value.Draft.Connection), False)

        Label = "Head Box: Attacker"

        If Value.Marker = 1 Then
            Label = "Head Box: Target"
        End If

        Call UI.DrawButton(PanelLeft + 8, 366 - ScrollOffset, 236, 24, Label, False)
        Call UI.DrawButton(PanelLeft + 8, 394 - ScrollOffset, 114, 24, "Width -", False)
        Call UI.DrawButton(PanelLeft + 130, 394 - ScrollOffset, 114, 24, "Width +", False)
        Call UI.DrawButton(PanelLeft + 8, 422 - ScrollOffset, 114, 24, "Height -", False)
        Call UI.DrawButton(PanelLeft + 130, 422 - ScrollOffset, 114, 24, "Height +", False)
        Call UI.DrawButton(PanelLeft + 8, 450 - ScrollOffset, 114, 24, "Depth -", False)
        Call UI.DrawButton(PanelLeft + 130, 450 - ScrollOffset, 114, 24, "Depth +", False)

        Draw Text "Head Cuboids Auto-Save Per Character" At PanelLeft + 8, 475 - ScrollOffset Size 9 Color CYAN

        Call UI.DrawButton(PanelLeft + 8, 486 - ScrollOffset, 114, 26, "Reset Beat", False)
        Call UI.DrawButton(PanelLeft + 130, 486 - ScrollOffset, 114, 26,
            "Reset All Beats", False)
        Call UI.DrawButton(PanelLeft + 8, 520 - ScrollOffset, 236, 26,
            "Reset All Beat Lengths", False)

        Draw Text "Resets Are Drafts Until Save" At PanelLeft + 8, 550 - ScrollOffset Size 9 Color LIGHT_GRAY

        Call UI.DrawButton(PanelLeft + 8, 576 - ScrollOffset, 114, 26,
            "Retry Head Save", False)
        Call UI.DrawButton(PanelLeft + 130, 576 - ScrollOffset, 114, 26,
            "Discard Head", False)

    Else
        Draw Text "Animation: " + ClipName At PanelLeft + 8, 307 - ScrollOffset Size 11 Color WHITE
        Draw Text "Copy A Shot; Select Another Character" At PanelLeft + 8, 335 - ScrollOffset Size 10 Color LIGHT_GRAY
        Draw Text "Then Edit A Beat And Paste" At PanelLeft + 8, 353 - ScrollOffset Size 10 Color LIGHT_GRAY

    End If

    End Clip

    Call UI.DrawVerticalScrollbar(
        PanelLeft, PanelTop, 252, PanelHeight,
        PanelContentHeight(Value.Editing), ScrollOffset)

    Warning = HeadWarning(Value)

    If Text_Length(Warning) > 0 Then
        Draw Text Warning At 280, 98 Size 11 Color YELLOW
    End If

    Draw Text Value.Message At 280, 116 Size 11 Color YELLOW

    If Not Value.Preview Then
        Return
    End If

    Label = "Beat Sequence Paused - Space To Play; Camera Controls Active"

    If Value.Playing Then
        Label = "Beat Sequence Playing - Space To Pause"
    End If

    Fill Rectangle 18, 40, Max(0, PanelLeft - 24), 18, Rgb(4, 9, 24) Opacity 80
    Draw Text Label At 18, 42 Size 12 Color YELLOW

    For Index = 0 To 1

        If Value.BoxVisible[Index] Then

            Tint = CYAN
            Label = "Attacker"

            If Index = 1 Then
                Tint = YELLOW
                Label = "Target"
            End If

            Call DrawHeadEdges(Value, Index, Tint)

            Draw Text Label At Value.BoxX[Index], Value.BoxY[Index] - 16 Size 12 Color Tint

        End If

    End For

    Call Timeline.Draw(Value.Timeline, Value.Working, Value.SourceSchedule,
        Value.Elapsed, Value.ShotIndex, Value.Editing, Width, Height)

End Sub

Public Sub StoreDraft(ByRef Value As State)

    Dim DefaultShot As Shots.Shot

    If Value.Editing Then

        Value.Working.Cameras[Value.ShotIndex] = Value.Draft

        If Value.UseDefault Then
            Value.Working.Cameras[Value.ShotIndex] = DefaultShot
        End If

    End If

End Sub

Public Sub SeekTo(ByRef Value As State, Time As Number, Index As Number)

    Call StoreDraft(Value)

    Value.Playing = False
    Value.Schedule = Track.Schedule(Value.Working, Value.SourceSchedule, Time)
    Value.Elapsed = Min(Max(Time, 0), Value.Schedule.Start[4] - 1)

    If Index < 0 Then
        Index = Track.AtTime(Value.Working, Value.Schedule, Value.Elapsed)
    End If

    Value.ShotIndex = Index
    Value.Beat = Value.Working.Beat[Index]
    Value.Draft = Value.Working.Cameras[Index]
    Value.UseDefault = Not Value.Draft.Saved
    Value.ResetShot = Value.Draft
    Value.NewEdit = True
    Value.Seek = True
    Value.ContinuousSample = False
    Value.Reframe = False
    Value.Scrubbing = True

End Sub

Public Sub ResumeCamera(ByRef Value As State)

    If Not Value.Editing Or Not Value.Scrubbing Then
        Return
    End If

    Call SeekTo(Value, Value.Elapsed, -1)

    Value.Camera.Base = Value.Camera.Live
    Value.UseDefault = False
    Value.Playing = False
    Value.Camera.Frame.PanXLimit = 1000.0
    Value.Camera.Frame.PanYLimit = 1000.0

    Call Camera.Reset(Value.Camera, 0, 0, -100, 100, 120000)
    Call Shots.Capture(Value.Draft, Value.Camera.Base, Value.Heads[0], Value.Heads[1])

    Value.ResetShot = Value.Draft
    Value.Reframe = False
    Value.Scrubbing = False

End Sub

Public Sub ResetCameraView(ByRef Value As State)

    If Not Value.Editing Then
        Return
    End If

    Value.Reframe = True
    Value.ResetRequested = True
    Value.Scrubbing = False
    Value.Seek = True
    Value.Playing = False
    Value.ContinuousSample = False
    Value.Message = "Camera View Reset To Edit Start"

End Sub

Public Sub RestartPresentation(ByRef Value As State)

    If Not Value.Preview Then
        Return
    End If

    Call SeekTo(Value, 0, 0)

    Value.Playing = True
    Value.Scrubbing = True
    Value.Message = "Beat Sequence Playing From Start"

End Sub

Public Sub AdvancePreview(ByRef Value As State, Elapsed As Number)

    If Not Value.Preview Or Not Value.Playing Then
        Return
    End If

    Value.Elapsed = Min(Value.Schedule.Start[4] - 1, Value.Elapsed + Max(0, Elapsed))
    Value.Seek = True
    Value.ContinuousSample = True
    Value.Scrubbing = True
    Value.Reframe = False

    If Value.Elapsed >= Value.Schedule.Start[4] - 1 Then

        Call SeekTo(Value, Value.Elapsed, -1)

        Value.ContinuousSample = True
        Value.Message = "Sequence End - Space To Replay"

    End If

End Sub

''' Reset is staged in Working; saved sequences and head references are untouched.
''' One beat restores its built-in camera while retaining timing and extra shots.
Public Sub ResetDefaults(ByRef Value As State, AllBeats As Boolean)

    Dim DefaultTrack As Track.Definition
    Dim DefaultShot As Shots.Shot
    Dim Beat As Number

    If Not Value.Editing Then
        Return
    End If

    Call StoreDraft(Value)

    Beat = Value.Working.Beat[Value.ShotIndex]

    If AllBeats Then

        Call Track.Initialize(DefaultTrack)

        Value.Working = DefaultTrack
        Value.Message = "All Four Beats And Timing Reset; Save To Keep"

    Else
        Value.Working.Cameras[Beat] = DefaultShot
        Value.Message = "Beat Camera Reset; Timing Retained; Save To Keep"

    End If

    ''' Do not let SeekTo write the old draft over the reset.
    Value.Editing = False
    Value.Schedule = Track.Schedule(Value.Working, Value.SourceSchedule, 0)

    Call SeekTo(Value, Value.Schedule.Start[Beat], Beat)

    Value.Editing = True
    Value.UseDefault = True
    Value.Dirty = True

End Sub

''' Restore timing only. Extra shots retain their relative position in each beat.
Public Sub ResetLengths(ByRef Value As State)

    Dim Index As Number

    If Not Value.Editing Then
        Return
    End If

    Call StoreDraft(Value)

    For Index = 0 To 3
        Value.Working.Scale[Index] = 1.0
    End For

    Value.Schedule = Track.Schedule(Value.Working, Value.SourceSchedule, 0)

    Call SeekTo(Value, Track.TimeAt(Value.Working, Value.Schedule, Value.ShotIndex),
        Value.ShotIndex)

    Value.Dirty = True
    Value.Message = "Default Beat Lengths Restored; Cameras Kept; Save To Keep"

End Sub

Private Sub ApplyTimelineCommand(ByRef Value As State, Unity As Boolean,
    Command As Number, Live As P.Camera3D)

    Dim Index As Number
    Dim NewShot As Shots.Shot
    Dim Changed As Boolean

    If Command = 20 Then

        Call SeekTo(Value, Value.Timeline.OutputTime, -1)

    Else If Command = 21 Or Command = 22 Then

        Call SeekTo(Value, Value.Timeline.OutputTime, Value.Timeline.OutputIndex)

        If Command = 22 Then
            Value.Dirty = True
        End If

    Else If Command = 23 Then

        Call StoreDraft(Value)
        Call Shots.Capture(NewShot, Live, Value.Heads[0], Value.Heads[1])

        Index = Track.Insert(Value.Working, Value.Schedule, Value.Elapsed, NewShot)

        If Index >= 0 Then

            Call SeekTo(Value, Value.Elapsed, Index)

            Value.Dirty = True
            Value.Message = "Shot Added; Adjust Camera And Save"

        Else
            Value.Message = "Choose Space Between Markers; Limit 16 Extra Shots"

        End If

    Else If Command = 24 Then

        Call StoreDraft(Value)

        Changed = Track.Remove(Value.Working, Value.ShotIndex)

        If Changed Then

            Value.Editing = False

            Call SeekTo(Value, Value.Elapsed, -1)

            Value.Editing = True
            Value.Dirty = True
            Value.Message = "Extra Shot Removed; Save To Keep"

        Else
            Value.Message = "Beats 1-4 Cannot Be Deleted"

        End If

    End If

End Sub

Private Sub InitializeHead(ByRef Value As State, Index As Number)

    Dim Bounds As C.PreciseBounds3D
    Dim Size As Double
    Dim Initial As Shots.HeadReference

    Initial = Head(Value, Value.HeadIds[Index])

    If Initial.Size.X > 0.0 Then
        Return
    End If

    Bounds = C.WorldBoundsPrecise(Value.HeadActors[Index])
    Size = Max(8.0, Bounds.Size.Y * 0.15)
    Initial.Size = P.Vector(Size, Size, Size)

    Call HeadPersistence.Initialize(Value.HeadStorage, Value.HeadIds[Index], Initial)

End Sub

Private Sub ProjectHeads(ByRef Value As State, Live As P.Camera3D, Width As Number, Height As Number)

    Dim Index As Number
    Dim Corner As Number
    Dim Point As P.Vector3
    Dim Rotation As P.Vector3
    Dim Size As P.Vector3
    Dim Projected As Projection.ProjectedPoint
    Dim Ok As Boolean
    Dim RightEdge As Number
    Dim Bottom As Number

    For Index = 0 To 1

        Size = Head(Value, Value.HeadIds[Index]).Size
        Ok = C.TryRotation(Value.HeadActors[Index], Rotation)
        Rotation = P.Vector(0.0, Rotation.Y, 0.0)
        Value.BoxVisible[Index] = False
        Value.BoxX[Index] = 1000000
        Value.BoxY[Index] = 1000000
        RightEdge = -1000000
        Bottom = -1000000

        For Corner = 0 To 7

            Point = P.Vector(ToDouble((Corner Mod 2) * 2 - 1) * Size.X * 0.5,
                ToDouble((Corner / 2 Mod 2) * 2 - 1) * Size.Y * 0.5,
                ToDouble((Corner / 4 Mod 2) * 2 - 1) * Size.Z * 0.5)
            Point = M.Add(Value.Heads[Index], M.Rotate(Point, Rotation))
            Projected = Projection.ProjectViewerPoint(Point, Live, Width, Height)
            Value.CornerVisible[Index, Corner] = Projected.Visible

            If Projected.Visible Then

                Value.BoxVisible[Index] = True
                Value.CornerX[Index, Corner] = ToNumber(Projected.X)
                Value.CornerY[Index, Corner] = ToNumber(Projected.Y)
                Value.BoxX[Index] = Min(Value.BoxX[Index], Value.CornerX[Index, Corner])
                Value.BoxY[Index] = Min(Value.BoxY[Index], Value.CornerY[Index, Corner])
                RightEdge = Max(RightEdge, Value.CornerX[Index, Corner])
                Bottom = Max(Bottom, Value.CornerY[Index, Corner])

            End If

        End For

        Value.BoxWidth[Index] = Max(12, RightEdge - Value.BoxX[Index])
        Value.BoxHeight[Index] = Max(12, Bottom - Value.BoxY[Index])
    End For

End Sub

Private Sub DrawHeadEdges(Value As State, Index As Number, Tint As Number)

    Dim Corner As Number
    Dim StepValue As Number
    Dim Axis As Number
    Dim Other As Number

    For Corner = 0 To 7

        StepValue = 1

        For Axis = 0 To 2

            Other = Corner + StepValue

            If Corner / StepValue Mod 2 = 0 Then

                If Value.CornerVisible[Index, Corner] And Value.CornerVisible[Index, Other] Then
                    Draw Line Value.CornerX[Index, Corner], Value.CornerY[Index, Corner], Value.CornerX[Index, Other], Value.CornerY[Index, Other], Tint
                End If

            End If

            StepValue = StepValue * 2
        End For
    End For

End Sub

Public Function Keyboard(ByRef Value As State, Unity As Boolean,
    BossVisible As Boolean, PressedKey As Number) As Boolean

    Dim Command As Number
    Dim Changed As Boolean

    Command = Input.ClassifyBeatKey(PressedKey)

    If Command = 1 Then
        Changed = SelectActor(Value, Sequence.NextActor(Unity, Value.Selected, BossVisible))
        Return True
    End If

    If Not Value.Preview Then
        Return False
    End If

    If PressedKey = KEY_SPACE Then

        Call StoreDraft(Value)

        Value.Playing = Not Value.Playing
        Value.Scrubbing = True
        Value.Reframe = False

        If Value.Playing And Value.Elapsed >= Value.Schedule.Start[4] - 1 Then
            Value.Elapsed = 0
            Value.Seek = True
        End If

        Value.Message = "Beat Sequence Paused - Space To Play"

        If Value.Playing Then
            Value.Message = "Beat Sequence Playing - Space To Pause"
        Else

            Call SeekTo(Value, Value.Elapsed, -1)
        End If

        Return True

    End If

    If Value.Editing And Command >= 2 Then

        Call ResumeCamera(Value)

        Value.UseDefault = False

        If Command = 2 Then
            Changed = Camera.NudgeOrbit(Value.Camera, -2, 0)
        Else If Command = 3 Then
            Changed = Camera.NudgeOrbit(Value.Camera, 2, 0)
        Else If Command = 4 Then
            Changed = Camera.NudgeOrbit(Value.Camera, 0, 2)
        Else If Command = 5 Then
            Changed = Camera.NudgeOrbit(Value.Camera, 0, -2)
        Else If Command = 6 Then
            Value.Reframe = True
            Value.ResetRequested = True
        End If

        Value.Dirty = Value.Dirty Or Changed

    End If

    Return True

End Function

End Module
