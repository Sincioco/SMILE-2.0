''' Map-relative pan reach and ground contact for the shared arena camera controls.
Module Smile.Tools.NerisTownInspectionLimits

Option Explicit

Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.PrecisionMath3D As M
Import Smile.Simple3D.PrecisionCamera3D As Camera
Import Smile.Simple3D.ArenaViewport3D As Arena
Import Smile.Simple3D.ArenaCamera3D As Motion
Import Smile.Tools.TownDocumentNavigation As Document

Public Const GROUND_CLEARANCE = 25.01

''' A conservative sphere fit retains the full terrain at every 3D orbit bearing.
Public Function FitDistance(Base As P.Camera3D, Width As Number, Height As Number) As Double

    Dim Low As P.Vector3
    Dim High As P.Vector3
    Dim Center As P.Vector3
    Dim Radius As Double
    Dim Angle As Double
    Dim Result As Double

    Call Document.SurfaceBounds(Low, High)

    Center = M.Scale(M.Add(Low, High), 0.5)
    Radius = M.Distance(Low, High) * 0.5 + M.Distance(Center, Base.Target)
    Angle = M.Radians(Base.FovDegrees * 0.5)
    Angle = Atan2(Sin(Angle) * Min(ToDouble(Max(100, Width)) / ToDouble(Max(1, Window_Height())),
        ToDouble(Max(100, Height)) / ToDouble(Max(1, Window_Height()))), Cos(Angle))
    Result = Max(100.0, Radius / Sin(Angle))

    Return Result

End Function

''' Prepare one fixed viewing ray. Repeated wheel events never change this reference.
Public Sub BeginZoom(ByRef View As Arena.State, ByRef Base As P.Camera3D,
    Optional RightInset As Number = 0)

    Dim Direction As P.Vector3
    Dim Point As P.Vector3
    Dim PreviousDistance As Double

    If View.Distance.Prepared Then
        Return
    End If

    Base = View.LiveCamera
    PreviousDistance = M.Distance(Base.Position, Base.Target)

    If M.TryNormalize(M.Subtract(Base.Target, Base.Position), Direction) Then

        If Document.GroundRay(Base.Position, Direction, Base.FarPlane, Point) Then
            Base.Target = Point
        End If

    End If

    View.MinimumDistance = 0.25
    ' Retargeting along the viewing ray preserves the exact eye at the 1x limit.
    View.MaximumDistance = Max(View.MinimumDistance, View.MaximumDistance +
        M.Distance(Base.Position, Base.Target) - PreviousDistance)

    If RightInset > 0 Then
        View.MaximumDistance = Max(View.MaximumDistance,
            FitDistance(Base, Window_Width() - RightInset * 2 - 32, Window_Height() - 256))
    End If

    Call Arena.ResetControls(View)
    Call Arena.BeginTransition(View, 0)
    Call Arena.ConfigureDistance(View, Base)

    View.Distance.Prepared = True

End Sub

Public Sub Apply(ByRef View As Arena.State, Base As P.Camera3D,
    Optional GroundHeight As Double = GROUND_CLEARANCE)

    If View.Controls.Panning Then
        Call PanBounds(View, Base, GroundHeight)
    End If

    Call GroundZoom(View, Base, GroundHeight)
    Call PanBounds(View, Base, GroundHeight)

End Sub

''' Stop at ground contact on the same ray and discard input past that boundary.
Private Sub GroundZoom(ByRef View As Arena.State, Base As P.Camera3D,
    Optional GroundHeight As Double = GROUND_CLEARANCE)

    Dim Shot As P.Camera3D
    Dim Ray As P.Vector3
    Dim Point As P.Vector3
    Dim FloorDistance As Double

    Shot = Motion.ComposeDistance(Base, View.Controls, View.MaximumDistance,
        Max(1.48, View.MaximumPitch))
    FloorDistance = 0.5

    If M.TryNormalize(M.Subtract(Shot.Target, Shot.Position), Ray) Then

        If Document.GroundRay(Shot.Position, Ray, View.MaximumDistance + 1.0, Point) Then
            FloorDistance = Max(FloorDistance,
                View.MaximumDistance - M.Distance(Shot.Position, Point) + 0.5)
        Else If View.Distance.Prepared Then
            ' A sky/void ray has no visible surface to approach. Keep its starting eye.
            FloorDistance = M.Distance(Base.Position, Base.Target)
        End If

    End If

    View.Distance.Minimum = Min(View.MaximumDistance, FloorDistance)
    View.Distance.Current = Max(View.Distance.Current, View.Distance.Minimum)
    View.Distance.Target = Max(View.Distance.Target, View.Distance.Minimum)

End Sub

''' A map edge can reach sixteen pixels inside the viewport, at any zoom or bearing.
Private Sub PanBounds(ByRef View As Arena.State, Base As P.Camera3D,
    Optional GroundHeight As Double = GROUND_CLEARANCE)

    Dim Neutral As Camera.Controls
    Dim Shot As P.Camera3D
    Dim Low As P.Vector3
    Dim High As P.Vector3
    Dim Point As P.Vector3
    Dim Delta As P.Vector3
    Dim Forward As P.Vector3
    Dim RightValue As P.Vector3
    Dim UpValue As P.Vector3
    Dim MinimumX As Double
    Dim MaximumX As Double
    Dim MinimumY As Double
    Dim MaximumY As Double
    Dim HalfWidth As Double
    Dim HalfHeight As Double
    Dim Depth As Double
    Dim X As Double
    Dim Y As Double
    Dim Angle As Double
    Dim Index As Number
    Dim Found As Boolean
    Dim Ok As Boolean

    Neutral = View.Controls
    Neutral.PanX = 0.0
    Neutral.PanY = 0.0
    Shot = Motion.ComposeDistance(Base, Neutral, View.Distance.Current, Max(1.48, View.MaximumPitch))
    Ok = M.TryNormalize(M.Subtract(Shot.Target, Shot.Position), Forward)
    Ok = M.TryNormalize(M.Cross(Shot.UpDirection, Forward), RightValue) And Ok

    If Not Ok Then
        Return
    End If

    UpValue = M.Cross(Forward, RightValue)
    Angle = M.Radians(Shot.FovDegrees * 0.5)
    HalfHeight = Sin(Angle) / Cos(Angle)
    HalfWidth = HalfHeight * ToDouble(Max(1, Window_Width() - 32)) / ToDouble(Max(1, Window_Height()))
    View.WorldScale = Max(6.0, M.Distance(Shot.Position, Shot.Target) * HalfHeight * 6.0 / ToDouble(Max(1, Window_Height())))
    HalfHeight = HalfHeight * ToDouble(Max(1, Window_Height() - 32)) / ToDouble(Max(1, Window_Height()))

    If Shot.OrthographicHeight > 0.0 Then

        Depth = Max(1.0, M.Distance(Shot.Position, Shot.Target))
        HalfHeight = Shot.OrthographicHeight * 0.5 / Depth
        HalfWidth = HalfHeight * ToDouble(Max(1, Window_Width() - 32)) / ToDouble(Max(1, Window_Height()))
        View.WorldScale = Shot.OrthographicHeight * 3.0 / ToDouble(Max(1, Window_Height()))

    End If

    Call Document.SurfaceBounds(Low, High)

    For Index = 0 To 3

        Point = Low

        If Index Mod 2 = 1 Then
            Point.X = High.X
        End If

        If Index >= 2 Then
            Point.Z = High.Z
        End If

        Delta = M.Subtract(Point, Shot.Position)
        Depth = M.Dot(Delta, Forward)

        If Depth > Shot.NearPlane Then

            X = M.Dot(Delta, RightValue)
            Y = M.Dot(Delta, UpValue)

            If Not Found Then

                MinimumX = X - Depth * HalfWidth
                MaximumX = X + Depth * HalfWidth
                MinimumY = Y - Depth * HalfHeight
                MaximumY = Y + Depth * HalfHeight

            Else
                MinimumX = Min(MinimumX, X - Depth * HalfWidth)
                MaximumX = Max(MaximumX, X + Depth * HalfWidth)
                MinimumY = Min(MinimumY, Y - Depth * HalfHeight)
                MaximumY = Max(MaximumY, Y + Depth * HalfHeight)

            End If

            Found = True

        End If

    End For

    If Found And View.Controls.Panning Then
        View.Controls.PanX = Clamp(View.Controls.PanX, Min(0.0, MinimumX), Max(0.0, MaximumX))
        View.Controls.PanY = Clamp(View.Controls.PanY, Min(0.0, MinimumY), Max(0.0, MaximumY))
    End If

    If View.Controls.Panning And UpValue.Y > 0.0001 Then
        View.Controls.PanY = Max(View.Controls.PanY, (Min(GroundHeight, Shot.Position.Y) - Shot.Position.Y) / UpValue.Y)
    End If

    ' The shared input gate must admit the document-sized reach before this precise clamp.
    View.PanXLimit = Max(Abs(MinimumX), Abs(MaximumX)) + View.MaximumDistance
    View.PanYLimit = Max(Abs(MinimumY), Abs(MaximumY)) + View.MaximumDistance

End Sub

End Module
