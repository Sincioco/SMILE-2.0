''' Regression for stair-stepped terrain, exact shoreline collision and decimal orientation.
Module Smile.Tools.TownCurvesTests

Option Explicit

Import Smile.Simple3D.SurfaceGrid3D As Grid
Import Smile.Simple3D.SurfacePaint3D As Paint
Import Smile.Simple3D.SurfaceContours3D As Contours
Import Smile.Simple3D.Precision3D As P
Import Smile.Tools.TownDocument As Document
Import Smile.Tools.TownDocumentStore As Storage
Import Smile.Tools.TownDocumentNavigation As Navigation
Import Smile.Tools.TownCatalogData As Catalog
Import Smile.Tools.TownSelection As Selection
Import Smile.Tools.TownDerivedCache As Derived

Private Dim Town As Document.State
Private Dim Loaded As Document.State

Private Sub Check(Condition As Boolean, Label As Text, ByRef Failures As Number)

    If Not Condition Then
        Print "FAIL " + Label
        Failures = Failures + 1
    End If

End Sub

Public Function Run() As Number

    Dim Brush As Paint.Brush
    Dim Slice As Contours.Slice
    Dim Selected As Selection.State
    Dim Ok As Boolean
    Dim Failures As Number
    Dim Radius As Double
    Dim FaceIndex As Number
    Dim RoadArea As Double
    Dim Face As Contours.Triangle
    Dim SelectedCurves As Paint.State

    Ok = Document.Blank(Town, "Smooth Circle Regression", 40, 40, 10.0)

    Call Grid.PaintRectangle(Town.Surface, 0, 0, 39, 39, Grid.SURFACE_WATER)

    Brush.Form = Paint.FORM_RING
    Brush.Surface = Grid.SURFACE_ROAD
    Brush.X1 = 100.0
    Brush.Width = 20.0
    Ok = Grid.PaintBrush(Town.Surface, Brush) And Ok

    Call Check(Ok And Grid.ReadPoint(Town.Surface, 100.0, 0.0) = Grid.SURFACE_BRIDGE,
        "Ring Road Crosses Water", Failures)
    Call Check(Grid.ReadPoint(Town.Surface, 0.0, 0.0) = Grid.SURFACE_WATER,
        "Ring Preserves Its Center", Failures)
    Call Navigation.Rebuild(Town)
    Call Check(Navigation.CanStand(77.0, 77.0) And Not Navigation.CanStand(78.0, 78.0),
        "Shoreline Collision Follows Circle Within The Same Grid Cell", Failures)

    Slice = Contours.Split(Town.Surface, P.Vector(100.0, 0.0, 0.0),
        P.Vector(120.0, 0.0, 0.0), P.Vector(120.0, 0.0, 10.0))
    Radius = Sqrt(Slice.EdgeB.X * Slice.EdgeB.X + Slice.EdgeB.Z * Slice.EdgeB.Z)

    Call Check(Slice.FaceCount = 1 And Slice.Rail And Abs(Radius - 110.0) < 0.01,
        "Mesh Boundary Follows Analytic Arc Instead Of Tile Edge", Failures)

    Slice = Contours.Split(Town.Surface, P.Vector(120.0, 0.0, 0.0),
        P.Vector(120.0, 0.0, 10.0), P.Vector(100.0, 0.0, 0.0))

    Call Check((Slice.Faces[0].PointB.X - Slice.Faces[0].PointA.X) *
        (Slice.Faces[0].PointC.Z - Slice.Faces[0].PointA.Z) -
        (Slice.Faces[0].PointB.Z - Slice.Faces[0].PointA.Z) *
        (Slice.Faces[0].PointC.X - Slice.Faces[0].PointA.X) > 0.0,
        "Arc Triangles Keep Their Winding And Do Not Shade As Dark Teeth", Failures)

    Slice = Contours.Split(Town.Surface, P.Vector(120.0, 0.0, 0.0),
        P.Vector(100.0, 0.0, 0.0), P.Vector(120.0, 0.0, -10.0))

    Call Check((Slice.Faces[0].PointB.X - Slice.Faces[0].PointA.X) *
        (Slice.Faces[0].PointC.Z - Slice.Faces[0].PointA.Z) -
        (Slice.Faces[0].PointB.Z - Slice.Faces[0].PointA.Z) *
        (Slice.Faces[0].PointC.X - Slice.Faces[0].PointA.X) > 0.0,
        "Second Boundary Rotation Preserves Front Face", Failures)

    Brush.Form = Paint.FORM_CIRCLE
    Brush.Surface = Grid.SURFACE_GROUND
    Brush.X1 = 50.0
    Ok = Grid.PaintBrush(Town.Surface, Brush)

    Call Grid.PaintWorldLine(Town.Surface, -130.0, 0.0, 130.0, 0.0, Grid.SURFACE_ROAD, 14.0)
    Call Grid.PaintRectangle(Town.Surface, 18, 18, 21, 21, Grid.SURFACE_GROUND)
    Call Check(Grid.ReadPoint(Town.Surface, 0.0, 0.0) = Grid.SURFACE_GROUND And
        Grid.ReadPoint(Town.Surface, 60.0, 0.0) = Grid.SURFACE_BRIDGE,
        "Rectangle And Line Retain Ordered Curved Painting", Failures)

    Town.TerrainStyle = 3

    Ok = Storage.SaveDocument(Town, "TownEditor.CurveRegression")
    Ok = Storage.LoadDocument(Loaded, "TownEditor.CurveRegression") And Ok

    Call Check(Ok And Loaded.Surface.Curves.BrushCount = 4 And
        Grid.ReadPoint(Loaded.Surface, 77.0, 77.0) = Grid.SURFACE_BRIDGE,
        "Curves And Base Terrain Survive Save Reopen", Failures)

    Town.Items[0] = Catalog.InitialItem(0)
    Town.ItemCount = 1
    Selected.Selected[0] = True
    Selected.SelectedCount = 1
    Ok = Selection.SetAngle(Selected, Town, "-22.5")

    Call Check(Ok And Town.Items[0].Yaw = 337.5, "Exact Decimal Building Rotation", Failures)
    Call Check(Not Selection.SetAngle(Selected, Town, "bad") And
        Not Selection.SetAngle(Selected, Town, "999"), "Invalid Rotation Leaves Pose Intact", Failures)
    Call Check(Not Selection.SetAngle(Selected, Town, ".5") And
        Not Selection.SetAngle(Selected, Town, "1."), "Incomplete Decimal Cannot Trigger Runtime Error", Failures)

    Ok = Grid.Initialize(Town.Surface, 2, 1, 0.0, 0.0, 20.0, Grid.SURFACE_GROUND)

    Call Grid.PaintRectangle(Town.Surface, 1, 0, 1, 0, Grid.SURFACE_WATER)

    Slice = Contours.Split(Town.Surface, P.Vector(0.0, 0.0, 0.0),
        P.Vector(0.0, 0.0, 20.0), P.Vector(20.0, 0.0, 20.0), Grid.ReadBase(Town.Surface, 0, 0))

    Call Check(Ok And Slice.FaceCount = 1 And Slice.Faces[0].PointC.X = 20.0,
        "Legacy Tile Owns Its Edge Without Artificial Curve Slivers", Failures)

    Call Check(Loaded.TerrainStyle = 3, "Terrain Style Survives Save And Reopen", Failures)

    Ok = Grid.Initialize(Town.Surface, 4, 4, -20.0, -20.0, 10.0, Grid.SURFACE_WATER)
    Brush.Form = Paint.FORM_RECTANGLE
    Brush.Surface = Grid.SURFACE_GROUND
    Brush.X0 = -20.0
    Brush.X1 = 20.0
    Brush.Z0 = -20.0
    Brush.Z1 = 0.0
    Ok = Grid.PaintBrush(Town.Surface, Brush)
    Brush.Surface = Grid.SURFACE_ROAD
    Brush.X0 = 0.0
    Brush.Z1 = 20.0
    Ok = Grid.PaintBrush(Town.Surface, Brush)
    Slice = Contours.Split(Town.Surface, P.Vector(10.0, 0.0, 0.0),
        P.Vector(-10.0, 0.0, 10.0), P.Vector(-10.0, 0.0, -10.0))

    For FaceIndex = 0 To Slice.FaceCount - 1

        Face = Slice.Faces[FaceIndex]

        If Face.Kind = Grid.SURFACE_ROAD Then
            RoadArea = RoadArea + Abs((Face.PointB.X - Face.PointA.X) * (Face.PointC.Z - Face.PointA.Z) -
                (Face.PointB.Z - Face.PointA.Z) * (Face.PointC.X - Face.PointA.X)) * 0.5
        End If

    End For

    Call Check(Abs(RoadArea - 50.0) < 0.1 And Slice.Rail,
        "Waterworks Three Surface Join Keeps The Straight Road Edge Without Wedges", Failures)

    Call Paint.SelectRegion(Town.Surface.Curves, SelectedCurves, -1.0, -1.0, 1.0, 1.0)
    Call Check(Paint.Resolve(SelectedCurves, 0.5, 0.5, Grid.SURFACE_WATER) = Grid.SURFACE_BRIDGE And
        Paint.Resolve(SelectedCurves, 0.5, -0.5, Grid.SURFACE_WATER) = Grid.SURFACE_ROAD,
        "Region Filtering Preserves Ordered Road And Underlying Water Painting", Failures)

    Brush.Form = Paint.FORM_CIRCLE
    Brush.Surface = Grid.SURFACE_GROUND
    Brush.X0 = 0.0
    Brush.Z0 = 0.0
    Brush.X1 = 1.0
    Ok = Grid.PaintBrush(Town.Surface, Brush)

    Call Paint.SelectRegion(Town.Surface.Curves, SelectedCurves, -1.0, -1.0, 1.0, 1.0)
    Call Check(Paint.Resolve(SelectedCurves, 0.0, 0.0, Grid.SURFACE_WATER) = Grid.SURFACE_GROUND,
        "A Later Ground Brush Still Erases Earlier Road Painting", Failures)
    Call Paint.SelectRegion(Town.Surface.Curves, SelectedCurves, 100.0, 100.0, 101.0, 101.0)
    Call Check(SelectedCurves.BrushCount = 0,
        "Distant Brushes Are Excluded From Terrain Sampling", Failures)

    Ok = Grid.Initialize(Town.Surface, 4, 4, -20.0, -20.0, 10.0, Grid.SURFACE_WATER)
    Brush.Form = Paint.FORM_RECTANGLE
    Brush.Surface = Grid.SURFACE_GROUND
    Brush.X0 = -20.0
    Brush.X1 = 20.0
    Brush.Z0 = -20.0
    Brush.Z1 = 0.0
    Ok = Grid.PaintBrush(Town.Surface, Brush)
    Brush.Form = Paint.FORM_CIRCLE
    Brush.Surface = Grid.SURFACE_ROAD
    Brush.X0 = 10.0
    Brush.Z0 = 0.0
    Brush.X1 = 12.0
    Ok = Grid.PaintBrush(Town.Surface, Brush)
    Slice = Contours.Split(Town.Surface, P.Vector(10.0, 0.0, 0.0),
        P.Vector(-10.0, 0.0, 10.0), P.Vector(-10.0, 0.0, -10.0))

    Call Check(Slice.Rail And Abs(Slice.EdgeA.Z) < 0.01,
        "Curved Road Shoreline Join Does Not Produce A Ground Spike", Failures)

    Ok = Document.Blank(Town, "Rounded Junction Regression", 20, 20, 10.0)
    Brush.Form = Paint.FORM_FILLET
    Brush.Surface = Grid.SURFACE_ROAD
    Brush.X0 = 20.0
    Brush.Z0 = 20.0
    Brush.X1 = 0.0
    Brush.Z1 = 0.0
    Brush.Width = 20.0
    Ok = Grid.PaintBrush(Town.Surface, Brush) And Ok

    Call Check(Ok And Paint.Contains(Brush, 5.0, 5.0) And
        Not Paint.Contains(Brush, 6.0, 6.0) And Not Paint.Contains(Brush, -1.0, 1.0),
        "Junction Fillet Fills Only The Corner Outside Its Tangent Circle", Failures)
    Call Paint.SelectRegion(Town.Surface.Curves, SelectedCurves, 0.0, 0.0, 10.0, 10.0)
    Call Check(SelectedCurves.BrushCount = 1 And
        Paint.Resolve(SelectedCurves, 5.0, 5.0, Grid.SURFACE_GROUND) = Grid.SURFACE_ROAD,
        "Region Filtering Retains The Complete Junction Corner", Failures)

    Ok = Storage.SaveDocument(Town, "TownEditor.FilletRegression")
    Ok = Storage.LoadDocument(Loaded, "TownEditor.FilletRegression") And Ok

    Call Check(Ok And Loaded.Surface.Curves.Brushes[0].Form = Paint.FORM_FILLET And
        Grid.ReadPoint(Loaded.Surface, 5.0, 5.0) = Grid.SURFACE_ROAD And
        Grid.ReadPoint(Loaded.Surface, 6.0, 6.0) = Grid.SURFACE_GROUND,
        "TWN8 Preserves The Rounded Junction After Save And Reopen", Failures)

    Brush.X1 = Brush.X0
    Brush.Z1 = Brush.Z0

    Call Check(Not Paint.Valid(Brush), "Degenerate Junction Brush Is Rejected", Failures)

    Brush.Form = Paint.FORM_JUNCTION
    Brush.X0 = 0.0
    Brush.Z0 = 0.0
    Brush.X1 = 10.0
    Brush.Z1 = 10.0
    Brush.Width = 20.0
    Ok = Grid.PaintBrush(Town.Surface, Brush)

    Call Check(Ok And Paint.Contains(Brush, 15.0, 15.0) And
        Paint.Contains(Brush, -15.0, -15.0) And Not Paint.Contains(Brush, 16.0, 16.0) And
        Not Paint.Contains(Brush, 35.0, 0.0),
        "Compact Crossing Rounds Four Corners Without Extending The Road Arms", Failures)

    Ok = Storage.SaveDocument(Town, "TownEditor.FilletRegression")
    Ok = Storage.LoadDocument(Loaded, "TownEditor.FilletRegression") And Ok

    Call Check(Ok And Loaded.Surface.Curves.Brushes[1].Form = Paint.FORM_JUNCTION,
        "Compact Crossing Survives Save And Reopen", Failures)

    Ok = Document.Blank(Town, "Triangle And Curve Regression", 40, 40, 10.0)
    Brush.Form = Paint.FORM_TRIANGLE
    Brush.Surface = Grid.SURFACE_WATER
    Brush.X0 = -100.0
    Brush.Z0 = -100.0
    Brush.X1 = -40.0
    Brush.Z1 = -40.0
    Brush.X2 = 0.0
    Brush.Z2 = -100.0
    Ok = Grid.PaintBrush(Town.Surface, Brush) And Ok

    Call Check(Ok And Grid.ReadPoint(Town.Surface, -50.0, -70.0) = Grid.SURFACE_WATER And
        Grid.ReadPoint(Town.Surface, -50.0, -30.0) = Grid.SURFACE_GROUND,
        "Three Corner Water Shape Preserves Its Pointed Outline", Failures)

    Brush.Form = Paint.FORM_CURVE
    Brush.Surface = Grid.SURFACE_ROAD
    Brush.X0 = -100.0
    Brush.Z0 = 0.0
    Brush.X1 = 0.0
    Brush.Z1 = 160.0
    Brush.X2 = 100.0
    Brush.Z2 = 0.0
    Brush.Width = 20.0
    Ok = Grid.PaintBrush(Town.Surface, Brush)

    Call Check(Ok And Grid.ReadPoint(Town.Surface, 0.0, 80.0) = Grid.SURFACE_ROAD And
        Grid.ReadPoint(Town.Surface, 0.0, 100.0) = Grid.SURFACE_GROUND And
        Grid.ReadPoint(Town.Surface, 100.0, 0.0) = Grid.SURFACE_ROAD,
        "Curve Uses Its Bend Control And Thickness With Round Ends", Failures)
    Call Paint.SelectRegion(Town.Surface.Curves, SelectedCurves, 95.0, -5.0, 105.0, 5.0)
    Call Check(SelectedCurves.BrushCount = 1 And
        Paint.Resolve(SelectedCurves, 100.0, 0.0, Grid.SURFACE_GROUND) = Grid.SURFACE_ROAD,
        "Sampling Bounds Include The Third Control Point", Failures)

    Ok = Storage.SaveDocument(Town, "TownEditor.ShapeRegression")
    Ok = Storage.LoadDocument(Loaded, "TownEditor.ShapeRegression") And Ok

    Call Check(Ok And Derived.SameSurface(Town.Surface, Loaded.Surface) And
        Loaded.Surface.Curves.Brushes[1].X2 = 100.0 And
        Grid.ReadPoint(Loaded.Surface, 0.0, 80.0) = Grid.SURFACE_ROAD,
        "TWN9 Preserves Triangle And Curve Control Points", Failures)

    Loaded.Surface.Curves.Brushes[1].X2 = 101.0

    Call Check(Not Derived.SameSurface(Town.Surface, Loaded.Surface),
        "Moving The Third Point Rejects Stale Saved Preparation", Failures)

    Return Failures

End Function

End Module
