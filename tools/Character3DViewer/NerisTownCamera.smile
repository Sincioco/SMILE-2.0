''' Town drone framing and inward-facing boundary policy; arena retains input/zoom.
Module Smile.Tools.NerisTownCamera

Option Explicit

Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.PrecisionMath3D As M
Import Smile.Simple3D.PrecisionCamera3D As Camera
Import Smile.Simple3D.CameraClearance3D As Clearance
Import Smile.Simple3D.FollowCamera3D As Follow
Import Smile.Simple3D.ArenaViewport3D As Arena
Import Smile.Simple3D.ArenaCamera3D As Motion
Import Smile.Tools.NerisTownObstacles As Obstacles
Import Smile.Tools.NerisTownNavigation As Navigation
Import Smile.Tools.NerisTownEntranceNavigation As Entries
Import Smile.Tools.TownDocumentNavigation As Edited
Import Smile.Tools.NerisTownInspectionLimits As Limits

Public Type State
    World As Clearance.World
    Flight As Follow.State
    Enabled As Boolean
    Arrival As Boolean
    Focusing As Boolean
    CloseAmount As Double
    Suspended As Boolean
    Yaw As Double
    MovementView As P.Camera3D
    WasMoving As Boolean
    OrbitAtParty As Boolean
    OrbitOffset As P.Vector3
    OrbitLookOffset As P.Vector3
    Peeking As Boolean
    CursorOrbit As Boolean
    CursorAnchor As P.Vector3
    CursorX As Number
    CursorY As Number
    CursorDepth As Double
    CursorZoom As Boolean
    CursorZoomLast As Double
End Type

''' Keep the displayed pose while moving the zoom plane to the picked surface.
Public Sub BeginCursorZoom(ByRef Value As State, ByRef View As Arena.State,
    ByRef Base As P.Camera3D, Point As P.Vector3, X As Number, Y As Number)

    Dim Projected As Camera.ProjectedPoint
    Dim Forward As P.Vector3
    Dim RightValue As P.Vector3
    Dim UpValue As P.Vector3
    Dim PendingZoom As Double

    Projected = Camera.ProjectViewerPoint(Point, View.LiveCamera, Window_Width(), Window_Height())

    If Not Projected.Visible Or Not Camera.Basis(View.LiveCamera, Forward, RightValue, UpValue) Then
        Return
    End If

    If Value.CursorZoom Then
        PendingZoom = View.Zoom.Target - View.Zoom.Current
    End If

    Base = View.LiveCamera
    Base.Target = M.Add(Base.Position, M.Scale(Forward, Projected.Depth))
    View.MinimumDistance = Min(View.MinimumDistance, 0.25)
    View.MaximumDistance = Max(View.MaximumDistance, Projected.Depth)
    Value.Suspended = True
    Value.Focusing = False
    Value.Arrival = False
    Value.Peeking = False
    Value.OrbitAtParty = False
    Value.CursorOrbit = False
    Value.CursorZoom = True
    Value.CursorZoomLast = ToDouble(Motion.DEFAULT_ZOOM)
    Value.CursorAnchor = Point
    Value.CursorX = X
    Value.CursorY = Y

    Call Motion.Reset(View.Controls, View.Zoom)
    Call Arena.BeginTransition(View, 0)

    View.Zoom.Target = Clamp(View.Zoom.Current + PendingZoom, View.Zoom.Minimum, View.Zoom.Maximum)
    View.Controls.ZoomTarget = View.Zoom.Target

End Sub

Private Sub KeepZoomPoint(ByRef Value As State, ByRef View As Arena.State)

    Dim Projected As Camera.ProjectedPoint
    Dim Shot As P.Camera3D
    Dim Delta As P.Vector3
    Dim Forward As P.Vector3
    Dim RightValue As P.Vector3
    Dim UpValue As P.Vector3

    If Not Value.CursorZoom Or Value.CursorZoomLast = View.Controls.Zoom Then
        Return
    End If

    Projected = Camera.ProjectViewerPoint(Value.CursorAnchor, View.LiveCamera, Window_Width(), Window_Height())

    If Not Projected.Visible Or Not Camera.Basis(View.LiveCamera, Forward, RightValue, UpValue) Then
        Value.CursorZoom = False
        Return
    End If

    Shot = Camera.KeepCursorAnchor(View.LiveCamera, Value.CursorAnchor,
        Value.CursorX, Value.CursorY, Projected.Depth, Window_Width(), Window_Height())
    Delta = M.Subtract(Shot.Position, View.LiveCamera.Position)
    View.Controls.PanX = View.Controls.PanX + M.Dot(Delta, RightValue)
    View.Controls.PanY = View.Controls.PanY + M.Dot(Delta, UpValue)
    View.LiveCamera = Shot
    Value.CursorZoomLast = View.Controls.Zoom

End Sub

' Exact overhead and level-front framing share the editor's projection and picking contract.
Public Function EditingView(View As P.Camera3D, Mode As Number) As P.Camera3D

    Dim Result As P.Camera3D
    Dim Offset As P.Vector3
    Dim Distance As Double
    Dim Horizontal As Double

    Result = View
    Offset = M.Subtract(View.Position, View.Target)
    Distance = Max(200.0, M.Length(Offset))
    Result.OrthographicHeight = 0.0
    Result.UpDirection = P.Vector(0.0, 1.0, 0.0)

    If Mode = 1 Then

        Result.Position = M.Add(View.Target, P.Vector(0.0, Distance, 0.0))
        Result.UpDirection = P.Vector(0.0, 0.0, 1.0)
        Result.OrthographicHeight = Distance / Camera.FocalRatio(View.FovDegrees)

        If View.OrthographicHeight > 0.0 Then
            Result.OrthographicHeight = View.OrthographicHeight
            Result.UpDirection = View.UpDirection
        End If

    Else

        Horizontal = Sqrt(Offset.X * Offset.X + Offset.Z * Offset.Z)

        If Horizontal < 0.001 Then
            Offset = M.Scale(View.UpDirection, -1.0)
            Horizontal = Max(0.001, M.Length(Offset))
        End If

        Offset = P.Vector(Offset.X / Horizontal, 0.0, Offset.Z / Horizontal)

        If Mode = 2 Then
            Offset = M.Add(M.Scale(Offset, Cos(M.Radians(35.0))), P.Vector(0.0, Sin(M.Radians(35.0)), 0.0))
        End If

        If Mode = 3 Then
            Result.Target.Y = Max(Result.Target.Y, Navigation.GroundHeight(Result.Target.X, Result.Target.Z) + 26.0)
        End If

        Result.Position = M.Add(Result.Target, M.Scale(Offset, Distance))

    End If

    Return Result

End Function

''' Advance clockwise to the next cardinal bearing, discarding any off-angle remainder.
Public Sub TurnClockwise(ByRef Value As State, ByRef View As Arena.State, ByRef Base As P.Camera3D)

    Dim Bearing As P.Vector3
    Dim Angle As Double
    Dim Snapped As Double
    Dim Turn As Double

    Base = View.LiveCamera
    Bearing = M.Subtract(Base.Position, Base.Target)

    If Base.OrthographicHeight > 0.0 Then
        Bearing = Base.UpDirection
    End If

    Angle = M.Degrees(Atan2(Bearing.X, Bearing.Z))
    Snapped = Floor((Angle + 0.00001) / 90.0) * 90.0
    Turn = Snapped - Angle

    If Abs(Turn) < 0.01 Then
        Turn = -90.0
    End If

    Base.Position = M.Add(Base.Target, M.Rotate(M.Subtract(Base.Position, Base.Target), P.Vector(0.0, Turn, 0.0)))
    Base.UpDirection = M.Rotate(Base.UpDirection, P.Vector(0.0, Turn, 0.0))
    Value.Suspended = True
    Value.Focusing = False
    Value.Arrival = False
    Value.Peeking = False
    Value.CursorOrbit = False
    Value.CursorZoom = False
    Value.OrbitAtParty = False

    Call Motion.Reset(View.Controls, View.Zoom)
    Call Arena.BeginTransition(View, 0)
    Call Arena.ComposeCamera(View, Base)

End Sub

Public Sub BeginCursorOrbit(ByRef Value As State, View As P.Camera3D,
    Point As P.Vector3, X As Number, Y As Number)

    Dim Projected As Camera.ProjectedPoint

    Projected = Camera.ProjectViewerPoint(Point, View, Window_Width(), Window_Height())
    Value.CursorZoom = False
    Value.CursorOrbit = Projected.Visible
    Value.CursorAnchor = Point
    Value.CursorX = X
    Value.CursorY = Y
    Value.CursorDepth = Projected.Depth

End Sub

Public Sub FinishCursorOrbit(ByRef Value As State, ByRef View As Arena.State,
    ByRef Base As P.Camera3D)

    If Not Value.CursorOrbit Then
        Return
    End If

    Base = View.LiveCamera
    Value.CursorOrbit = False

    Call Motion.Reset(View.Controls, View.Zoom)
    Call Arena.BeginTransition(View, 0)

End Sub

''' Retarget an orbit without moving the displayed eye or retaining old input offsets.
Public Sub AnchorPoint(ByRef Value As State, ByRef View As Arena.State,
    ByRef Base As P.Camera3D, Point As P.Vector3)

    Base = View.LiveCamera
    Base.Target = Point
    ' A picked point may be closer than the old orbit minimum; do not push the eye away.
    View.MinimumDistance = Min(View.MinimumDistance, Max(0.25, M.Distance(Base.Position, Point)))
    Value.OrbitAtParty = False
    Value.Suspended = True
    Value.Focusing = False
    Value.Arrival = False
    Value.Peeking = False
    Value.CursorOrbit = False
    Value.CursorZoom = False

    Call Motion.Reset(View.Controls, View.Zoom)
    Call Arena.BeginTransition(View, 0)

End Sub

''' The leader is the pivot, but keeps the same off-center place in the displayed shot.
Public Sub AnchorParty(ByRef Value As State, ByRef View As Arena.State,
    ByRef Base As P.Camera3D, Leader As P.Vector3)

    Dim Anchor As P.Vector3

    Anchor = M.Add(Leader, P.Vector(0.0, 14.0, 0.0))

    Call AnchorPoint(Value, View, Base, View.LiveCamera.Target)

    Value.OrbitOffset = M.Subtract(Base.Position, Anchor)
    Value.OrbitLookOffset = M.Subtract(Base.Target, Anchor)
    Value.OrbitAtParty = True

End Sub

Public Sub Start(ByRef Value As State)

    Dim Empty As State

    Value = Empty
    Value.Enabled = True

    Call Obstacles.Populate(Value.World)

End Sub

Public Sub Focus(ByRef Value As State, Yaw As Double, Displayed As P.Camera3D)

    Value.Arrival = False
    Value.Yaw = Yaw
    Value.Suspended = False
    Value.WasMoving = False
    Value.OrbitAtParty = False
    Value.Peeking = False
    Value.CursorOrbit = False
    Value.CursorZoom = False

    Call Follow.Reset(Value.Flight, Displayed.Position)

End Sub

''' A drag in party framing borrows the view without replacing movement axes.
Public Function MovingGesture(ByRef Value As State, ByRef View As Arena.State,
    Input As Motion.PointerInput, PartyCamera As Boolean, MovingHeld As Boolean) As Boolean

    Dim Held As Boolean
    Dim Owned As Boolean

    Held = Input.PanHeld Or Input.OrbitHeld

    If Value.OrbitAtParty Then
        Return False
    End If

    Owned = Value.Peeking Or (PartyCamera And MovingHeld And Not Input.Blocked And Held)

    If (PartyCamera And
        MovingHeld And
        Not Input.Blocked And
        Held) Then

        Value.Peeking = True
        Value.Arrival = False
        Value.Enabled = True
        Value.Suspended = False
        Value.OrbitAtParty = False

    Else If Value.Peeking And Not Held Then

        Call Arena.BeginTransition(View, 1000)

        View.Controls.PanX = 0.0
        View.Controls.PanY = 0.0
        View.Controls.OrbitYaw = 0.0
        View.Controls.OrbitPitch = 0.0
        View.Controls.Panning = False
        View.Controls.Orbiting = False
        Value.Peeking = False
        Value.Focusing = True

    End If

    Return Owned

End Function

''' Freeze input axes for each continuous movement gesture, avoiding chase-yaw feedback.
Public Function MovementCamera(ByRef Value As State, Displayed As P.Camera3D,
    Moving As Boolean) As P.Camera3D

    Dim Result As P.Camera3D

    If (Not Value.WasMoving Or
        Not Value.Enabled Or
        Value.Suspended) Then
        Value.MovementView = Displayed
    End If

    Value.WasMoving = Moving
    Result = Value.MovementView

    Return Result

End Function

''' Blend the trailing bearing toward the nearest outside edge: the eye looks inward.
Public Function BoundaryYaw(Position As P.Vector3, Heading As Double) As Double

    Dim Distance As Double
    Dim EdgeYaw As Double
    Dim Candidate As Double
    Dim South As Double
    Dim West As Double
    Dim Amount As Double
    Dim Result As Double

    South = -3400.0
    West = -2400.0

    If Position.X < -2400.0 Then
        South = 900.0
        West = -4840.0
    End If

    Distance = Position.Z - South
    EdgeYaw = 180.0
    Candidate = 3400.0 - Position.Z

    If Candidate < Distance Then
        Distance = Candidate
        EdgeYaw = 0.0
    End If

    Candidate = Position.X - West

    If Candidate < Distance Then
        Distance = Candidate
        EdgeYaw = -90.0
    End If

    Candidate = 2600.0 - Position.X

    If Candidate < Distance Then
        Distance = Candidate
        EdgeYaw = 90.0
    End If

    Amount = Clamp((600.0 - Distance) / 500.0, 0.0, 1.0)
    Amount = Amount * Amount * (3.0 - 2.0 * Amount)
    Result = Heading + Camera.NormalizeAngle(EdgeYaw - Heading) * Amount

    Return Result

End Function

''' Courtyards and doorway approaches need a close trailing view, even when clear.
Public Function CloseGrounds(Leader As P.Vector3) As Boolean

    Dim Result As Boolean

    If Edited.Active() Then
        Result = Edited.InsideStructure(Leader)
        Return Result
    End If

    Result = ((Leader.X >= -1930.0 And Leader.X <= -390.0 And
        Leader.Z >= 1650.0 And Leader.Z <= 3030.0) Or
        (Leader.X >= 680.0 And Leader.X <= 2220.0 And
        Leader.Z >= 1730.0 And Leader.Z <= 3110.0) Or
        Entries.DoorwayAt(Leader.X, Leader.Z) >= 0)

    Return Result

End Function

Public Function Frame(ByRef Value As State, Base As P.Camera3D, Leader As P.Vector3,
    Heading As Double, Moving As Boolean, Elapsed As Number) As P.Camera3D

    Dim Result As P.Camera3D
    Dim Goal As Double
    Dim StepValue As Double
    Dim Angle As Double
    Dim DesiredClose As Double
    Dim Distance As Double
    Dim Height As Double
    Dim Ahead As Double
    Dim StepHeight As Double
    Dim LookAhead As P.Vector3

    If Value.Arrival Then
        Return Base
    End If

    If Value.Suspended And Value.OrbitAtParty Then

        Result = Base
        Result.Target = M.Add(Leader, P.Vector(0.0, 14.0, 0.0))
        Result.Position = M.Add(Result.Target, Value.OrbitOffset)
        Result.Target = M.Add(Result.Target, Value.OrbitLookOffset)

        Return Result

    End If

    If (Value.Enabled And
        Not Value.Suspended And
        Moving) Then

        Goal = BoundaryYaw(Leader, Heading)
        StepValue = (Camera.NormalizeAngle(Goal - Value.Yaw) *
            ToDouble(Max(0, Elapsed)) / (1800.0 + ToDouble(Max(0, Elapsed))))
        Value.Yaw = Camera.NormalizeAngle(Value.Yaw + Clamp(StepValue,
            -ToDouble(Elapsed) * 0.018, ToDouble(Elapsed) * 0.018))

    End If

    Angle = M.Radians(Value.Yaw)
    DesiredClose = 0.0

    If CloseGrounds(Leader) Then
        DesiredClose = 1.0
    End If

    Value.CloseAmount = (Value.CloseAmount + (DesiredClose - Value.CloseAmount) *
        ToDouble(Max(0, Elapsed)) / (1200.0 + ToDouble(Max(0, Elapsed))))
    Distance = 300.0 - 215.0 * Value.CloseAmount
    Height = 26.0 - 2.0 * Value.CloseAmount
    Ahead = 55.0 - 29.0 * Value.CloseAmount
    LookAhead = M.Add(Leader, P.Vector(-Sin(Angle) * Ahead, 0.0, -Cos(Angle) * Ahead))
    StepHeight = Clamp(Navigation.GroundHeight(LookAhead.X, LookAhead.Z) - Leader.Y, 0.0, 38.0)
    Result = Base
    Result.OrthographicHeight = 0.0
    Result.UpDirection = P.Vector(0.0, 1.0, 0.0)
    Result.Target = M.Add(LookAhead, P.Vector(0.0, 42.0 + (StepHeight - 16.0) * Value.CloseAmount, 0.0))
    Result.Position = M.Add(Leader, P.Vector(Sin(Angle) * Distance, Height, Cos(Angle) * Distance))

    Return Result

End Function

Public Sub Settle(ByRef Value As State, Displayed As P.Camera3D)

    Call Follow.Reset(Value.Flight, Displayed.Position)

    Value.Flight.Target = Displayed.Target
    Value.Flight.TargetReady = True

End Sub

Public Sub ArrivalFrame(ByRef Value As State, ByRef View As Arena.State,
    ByRef Base As P.Camera3D, Leader As P.Vector3, Optional Heading As Double = 180.0)

    Dim Forward As P.Vector3

    Forward = P.Vector(Sin(M.Radians(Heading - 180.0)), 0.0, Cos(M.Radians(Heading - 180.0)))
    Base.OrthographicHeight = 0.0
    Base.UpDirection = P.Vector(0.0, 1.0, 0.0)
    Base.Target = M.Add(Leader, M.Add(M.Scale(Forward, 55.0), P.Vector(0.0, 42.0, 0.0)))
    Base.Position = M.Add(Leader, M.Add(M.Scale(Forward, -300.0), P.Vector(0.0, 26.0, 0.0)))

    Call Focus(Value, Heading, Base)
    Call Motion.Reset(View.Controls, View.Zoom)
    Call Arena.BeginTransition(View, 0)
    Call Arena.ComposeCamera(View, Base)

    Value.Arrival = True

End Sub

''' Follow the unzoomed shot first. Direct zoom must never enter the slow drone solver.
Public Sub Compose(ByRef Value As State, ByRef View As Arena.State,
    Base As P.Camera3D, Following As Boolean, Elapsed As Number,
    Optional LowShot As Boolean = False, Optional FreeInspect As Boolean = False)

    Dim Resolved As P.Camera3D
    Dim Lift As Double
    Dim FloorVisible As Boolean

    Resolved = Base

    If Value.Focusing Or Value.Arrival Then
        Call Settle(Value, Base)
    Else If (Following And
        Value.Enabled And
        Not Value.Suspended) Then
        Resolved = Resolve(Value, Base, Elapsed)
    End If

    Call Constrain(View, Resolved, LowShot, FreeInspect)

    If FreeInspect Then
        Call Limits.Apply(View, Resolved, Navigation.GroundHeight(Resolved.Position.X, Resolved.Position.Z) + 0.1)
    Else If Not Following Then
        Call Limits.Apply(View, Resolved)
    End If

    ' Apply town ground clearance once, translating both eye and target to retain pitch.
    FloorVisible = View.FloorVisible
    View.FloorVisible = False

    Call Arena.ComposeCamera(View, Resolved)
    Call KeepZoomPoint(Value, View)

    If Following And Value.Focusing Then
        Call ClearFocus(Value, View)
    End If

    If Following And Value.OrbitAtParty Then
        View.LiveCamera = Camera.KeepOrbitAnchor(Resolved, View.LiveCamera,
            M.Subtract(Resolved.Target, Value.OrbitLookOffset))
    End If

    If Value.CursorOrbit Then
        View.LiveCamera = Camera.KeepCursorAnchor(View.LiveCamera, Value.CursorAnchor,
            Value.CursorX, Value.CursorY, Value.CursorDepth, Window_Width(), Window_Height())
    End If

    View.FloorVisible = FloorVisible
    Lift = Max(0.0, 25.01 - View.LiveCamera.Position.Y)

    If FreeInspect Then
        Lift = Max(0.0, Navigation.GroundHeight(View.LiveCamera.Position.X, View.LiveCamera.Position.Z) +
            0.1 - View.LiveCamera.Position.Y)
    End If

    View.LiveCamera.Position.Y = View.LiveCamera.Position.Y + Lift
    View.LiveCamera.Target.Y = View.LiveCamera.Target.Y + Lift

    ' Easing and input offsets happen after the drone solver, including drone-off follow.

    If Following And Edited.Elevated() Then
        View.LiveCamera = Edited.ClearTerrainSight(View.LiveCamera)
    End If

    ' Elevated town views need more depth precision than a nearby character shot.
    ' The 6.2 cm bridge paving/deck gap otherwise collapses in the 24-bit buffer.
    View.LiveCamera.NearPlane = Max(25.0, (View.LiveCamera.Position.Y - 25.0) * 0.1)

    If FreeInspect Then
        View.LiveCamera.NearPlane = Max(0.25, (View.LiveCamera.Position.Y -
            Navigation.GroundHeight(View.LiveCamera.Position.X, View.LiveCamera.Position.Z)) * 0.1)
    Else If Following And Edited.Elevated() Then
        View.LiveCamera.NearPlane = Max(0.25, Min(25.0,
            M.Distance(View.LiveCamera.Position, View.LiveCamera.Target) * 0.1))
    End If

    Value.Focusing = Value.Focusing And View.TransitionDuration > 0

End Sub

''' Easing can cross a wall even when both endpoint shots are clear.
Private Sub ClearFocus(ByRef Value As State, ByRef View As Arena.State)

    Dim Amount As Double
    Dim Forward As P.Vector3
    Dim Direction As P.Vector3

    Forward = M.Subtract(View.LiveCamera.Target, View.LiveCamera.Position)

    If Edited.Active() Then
        Call Edited.PopulateCamera(Value.World, View.LiveCamera.Target)
    End If

    Amount = Clearance.Fraction(Value.World, View.LiveCamera.Target,
        View.LiveCamera.Position, 18.0, True)

    If Amount < 1.0 Then
        View.LiveCamera.Position = M.Lerp(View.LiveCamera.Target,
            View.LiveCamera.Position, Amount * 0.98)
    End If

    ' Preserve a valid view direction when the focus is almost touching a wall.

    If (M.Distance(View.LiveCamera.Target, View.LiveCamera.Position) < 1.0 And
        M.TryNormalize(Forward, Direction)) Then
        View.LiveCamera.Target = M.Add(View.LiveCamera.Position, Direction)
    End If

    Call Settle(Value, View.LiveCamera)

End Sub

''' Following a party center can use either free orbit or the low party framing.
Public Function GroundShot(Value As State, PartyCamera As Boolean) As Boolean

    Dim Result As Boolean

    Result = PartyCamera Or (Value.Arrival And Not Value.Suspended)

    Return Result

End Function

''' Manual inspection reaches the horizon; automatic party/building shots may look up.
Public Function MinimumPitch(LowShot As Boolean) As Double

    Dim ReturnValue As Double

    If LowShot Then
        ReturnValue = -20.0

        Return ReturnValue
    End If

    Return 0.0

End Function

Private Sub Constrain(ByRef View As Arena.State, Base As P.Camera3D, LowShot As Boolean, FreeInspect As Boolean)

    Dim Offset As P.Vector3
    Dim BasePitch As Double
    Dim Pitch As Double

    Offset = M.Subtract(Base.Position, Base.Target)
    BasePitch = Atan2(Offset.Y, Sqrt(Offset.X * Offset.X + Offset.Z * Offset.Z))
    Pitch = Clamp(BasePitch + M.Radians(View.Controls.OrbitPitch),
        M.Radians(MinimumPitch(LowShot)), Max(M.Radians(80.0), View.MaximumPitch))

    If FreeInspect Then
        ' Ground-level flight stays available; orbit must not rotate below the
        ' horizon and then lift the target thousands of units to clear the floor.
        Pitch = Clamp(BasePitch + M.Radians(View.Controls.OrbitPitch), 0.0, M.Radians(80.0))
    End If

    View.Controls.OrbitPitch = M.Degrees(Pitch - BasePitch)

End Sub

Public Function Resolve(ByRef Value As State, Desired As P.Camera3D,
    Elapsed As Number) As P.Camera3D

    Dim Result As P.Camera3D

    If Edited.Active() Then
        Call Edited.PopulateCamera(Value.World, Desired.Target)
    End If

    Result = Follow.Update(Value.Flight, Value.World, Desired, Elapsed, 18.0 - 12.0 * Value.CloseAmount)
    Result = Edited.ClearTerrainSight(Result)

    Return Result

End Function

End Module
