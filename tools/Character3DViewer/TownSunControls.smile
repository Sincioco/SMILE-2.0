''' Sun slider presentation and a cancelable live-light gesture; no scene geometry.
Module Smile.Tools.TownSunControls

Option Explicit

Import Smile.UI.Controls As UI
Import Smile.Tools.TownDocument As Document

Public Type State
    DragOwner As Number
    Original As Document.Sun
    Revision As Number
End Type

Public Function Minimum(Row As Number) As Number

    Dim ReturnValue As Number

    If Row = 6 Then
        ReturnValue = -85

        Return ReturnValue
    End If

    Return 0

End Function

Public Function Maximum(Row As Number) As Number

    Select Case Row
        Case 3
            Return 1000
        Case 4
            Return 100
        Case 5
            Return 360
        Case 6
            Return 85
    End Select

    Return 255

End Function

Public Function Reading(Light As Document.Sun, Row As Number) As Number

    Dim Result As Number

    Select Case Row
        Case 0
            Result = Light.RedValue
        Case 1
            Result = Light.GreenValue
        Case 2
            Result = Light.BlueValue
        Case 3
            Result = Light.Intensity
        Case 4
            Result = Light.Ambient
        Case 5
            Result = (ToNumber(Round(Light.Azimuth)) Mod 360 + 360) Mod 360

            If Light.Azimuth = 360.0 Then
                Result = 360
            End If

        Case 6
            Result = ToNumber(Round(Light.Elevation))
    End Select

    Return Result

End Function

Public Sub SetValue(ByRef Town As Document.State, Row As Number, Setting As Number)

    Setting = Max(Minimum(Row), Min(Maximum(Row), Setting))

    If Reading(Town.Light, Row) = Setting Then
        Return
    End If

    Select Case Row
        Case 0
            Town.Light.RedValue = Setting
        Case 1
            Town.Light.GreenValue = Setting
        Case 2
            Town.Light.BlueValue = Setting
        Case 3
            Town.Light.Intensity = Setting
        Case 4
            Town.Light.Ambient = Setting
        Case 5
            Town.Light.Azimuth = ToDouble(Setting)
        Case 6
            Town.Light.Elevation = ToDouble(Setting)
    End Select

    Town.Revision = Town.Revision + 1

End Sub

Public Sub Cancel(ByRef Value As State, ByRef Town As Document.State)

    If Value.DragOwner > 0 Then

        Town.Light = Value.Original
        Town.Revision = Value.Revision
        Value.DragOwner = 0

    End If

End Sub

Private Function RowY(Row As Number) As Number

    Dim Result As Number

    Result = 212 + Row * Min(32, Max(16, (Window_Height() - 537) / 7))

    Return Result

End Function

''' 0 unhandled, 1 preview, 2 complete (one undo step), 3 canceled.
Public Function Input(ByRef Value As State, ByRef Town As Document.State,
    X As Number, Key As Number, Blocked As Boolean) As Number

    Dim Row As Number
    Dim Setting As Number

    If Value.DragOwner > 0 And Key = KEY_ESCAPE Then
        Call Cancel(Value, Town)

        Return 3
    End If

    If Blocked And Value.DragOwner = 0 Then
        Return 0
    End If

    If Value.DragOwner = 0 Then
        Value.Original = Town.Light
        Value.Revision = Town.Revision
    End If

    For Row = 0 To 6

        Setting = Reading(Town.Light, Row)

        If UI.UpdateSlider(Value.DragOwner, Row + 1, X + 110, RowY(Row),
            125, 24, Minimum(Row), Maximum(Row), 1, Setting) Then

            Call SetValue(Town, Row, Setting)

            If Value.DragOwner = 0 Then
                Return 2
            End If

            Return 1

        End If

    End For

    Return 0

End Function

Public Sub Draw(Light As Document.Sun, X As Number)

    Dim Row As Number
    Dim Y As Number
    Dim Setting As Number
    Dim Offset As Number
    Dim Label As Text

    For Row = 0 To 6

        Select Case Row
            Case 0
                Label = "Sun Red"
            Case 1
                Label = "Sun Green"
            Case 2
                Label = "Sun Blue"
            Case 3
                Label = "Intensity %"
            Case 4
                Label = "Ambient %"
            Case 5
                Label = "Azimuth"
            Case 6
                Label = "Elevation"
        End Select

        Y = RowY(Row)
        Setting = Reading(Light, Row)
        Offset = (Setting - Minimum(Row)) * 125 / (Maximum(Row) - Minimum(Row))
        Draw Text Label At X, Y + 5 Size 13 Color WHITE
        Fill Rectangle X + 110, Y + 10, 125, 4, RGB(62, 83, 104)
        Fill Rectangle X + 107 + Offset, Y + 6, 6, 12, RGB(70, 210, 205)
        Draw Number Setting At X + 245, Y + 5 Size 13 Color RGB(160, 220, 230)
    End For

End Sub

End Module
