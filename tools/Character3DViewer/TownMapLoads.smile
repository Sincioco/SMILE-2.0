''' Transparent travel cells; terrain remains unchanged underneath each marker.
Module Smile.Tools.TownMapLoads

Option Explicit

Import Smile.Tools.TownDocument As Document
Import Smile.Simple3D.SurfaceGrid3D As Grid
Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.SurfaceSections3D As Regions

Private Dim Lookup[512, 512] As Number
Private Dim Queue[4096] As Number
Private Dim Seen[4096] As Boolean

Public Type LabelSet
    Names[4096] As Text
    Positions[4096] As P.Vector3
    LabelCount As Number
End Type

Public Type Area
    Tiles[4096] As Document.MapTile
    TileCount As Number
    X0 As Number
    Z0 As Number
    X1 As Number
    Z1 As Number
    Revision As Number
End Type

Public Type Outline
    Edge[4096, 4] As Boolean
End Type

Private Sub IndexTiles(ByRef Town As Document.State)

    Dim X As Number
    Dim Z As Number
    Dim Index As Number

    For Z = 0 To Town.Surface.Rows - 1

        For X = 0 To Town.Surface.Columns - 1
            Lookup[X, Z] = 0
        End For
    End For

    For Index = 0 To Town.MapTileCount - 1
        Lookup[Town.MapTiles[Index].X, Town.MapTiles[Index].Z] = Index + 1
        Seen[Index] = False
    End For

End Sub

Private Function AdjacentTile(ByRef Town As Document.State,
    X As Number, Z As Number, Side As Number) As Number

    Dim Result As Number

    If Side = 0 Then
        X = X - 1
    Else If Side = 1 Then
        X = X + 1
    Else If Side = 2 Then
        Z = Z - 1
    Else
        Z = Z + 1
    End If

    Result = -1

    If (X >= 0 And
        X < Town.Surface.Columns And
        Z >= 0 And
        Z < Town.Surface.Rows) Then
        Result = Lookup[X, Z] - 1
    End If

    Return Result

End Function

''' Only exposed edges are visible, including holes and separate destinations.
Public Sub BuildOutline(ByRef Town As Document.State, ByRef Value As Outline)

    Dim Index As Number
    Dim Side As Number
    Dim Adjacent As Number

    Call IndexTiles(Town)

    For Index = 0 To Town.MapTileCount - 1

        For Side = 0 To 3

            Adjacent = AdjacentTile(Town, Town.MapTiles[Index].X, Town.MapTiles[Index].Z, Side)
            Value.Edge[Index, Side] = True

            If Adjacent >= 0 Then
                Value.Edge[Index, Side] = Town.MapTiles[Adjacent].Destination <> Town.MapTiles[Index].Destination
            End If

        End For
    End For

End Sub

Public Function Find(ByRef Town As Document.State, X As Number, Z As Number) As Number

    Dim ReturnValue As Number

    Dim Index As Number

    For Index = 0 To Town.MapTileCount - 1

        If Town.MapTiles[Index].X = X And Town.MapTiles[Index].Z = Z Then
            Return Index
        End If

    End For

    ReturnValue = -1

    Return ReturnValue

End Function

Public Function DestinationAt(ByRef Town As Document.State, X As Double, Z As Double) As Text

    Dim Index As Number
    Dim Result As Text

    Index = Find(Town, Grid.CellX(Town.Surface, X), Grid.CellZ(Town.Surface, Z))

    If Index >= 0 Then
        Result = Town.MapTiles[Index].Destination
    End If

    Return Result

End Function

Public Function Neighbor(ByRef Town As Document.State, X As Number, Z As Number) As Text

    Dim ReturnValue As Text

    Dim Index As Number

    For Index = 0 To Town.MapTileCount - 1

        If Abs(Town.MapTiles[Index].X - X) + Abs(Town.MapTiles[Index].Z - Z) <= 1 Then
            ReturnValue = Town.MapTiles[Index].Destination

            Return ReturnValue
        End If

    End For

    Return ""

End Function

Private Function CollectConnected(ByRef Town As Document.State,
    First As Number, SameDestination As Boolean) As Number

    Dim Result As Number

    Call IndexTiles(Town)

    Result = FloodConnected(Town, First, SameDestination)
    Return Result

End Function

Private Function FloodConnected(ByRef Town As Document.State,
    First As Number, SameDestination As Boolean) As Number

    Dim Index As Number
    Dim X As Number
    Dim Z As Number
    Dim Head As Number
    Dim Tail As Number
    Dim Side As Number
    Dim Adjacent As Number

    If First < 0 Or First >= Town.MapTileCount Then
        Return 0
    End If

    Queue[0] = First
    Seen[First] = True
    Tail = 1

    Do

        Index = Queue[Head]
        Head = Head + 1
        X = Town.MapTiles[Index].X
        Z = Town.MapTiles[Index].Z

        For Side = 0 To 3

            Adjacent = AdjacentTile(Town, X, Z, Side)

            If Adjacent >= 0 Then

                If (SameDestination And
                    Town.MapTiles[Adjacent].Destination <> Town.MapTiles[First].Destination) Then
                    Adjacent = -1
                End If

            End If

            If Adjacent >= 0 Then

                If Not Seen[Adjacent] Then

                    Seen[Adjacent] = True
                    Queue[Tail] = Adjacent
                    Tail = Tail + 1

                End If

            End If

        End For

    Loop Until Head = Tail

    Return Tail

End Function

''' One upright label per connected area, including separate areas sharing a destination.
Public Sub BuildLabels(ByRef Town As Document.State, ByRef Value As LabelSet)

    Dim Index As Number
    Dim Member As Number
    Dim AreaCount As Number
    Dim Tile As Document.MapTile
    Dim Center As P.Vector3

    Call IndexTiles(Town)

    Value.LabelCount = 0

    For Index = 0 To Town.MapTileCount - 1

        If Not Seen[Index] Then

            AreaCount = FloodConnected(Town, Index, True)
            Center = P.Vector(0.0, 0.0, 0.0)

            For Member = 0 To AreaCount - 1
                Tile = Town.MapTiles[Queue[Member]]
                Center.X = Center.X + (Town.Surface.XEdges[Tile.X] + Town.Surface.XEdges[Tile.X + 1]) / 2.0
                Center.Z = Center.Z + (Town.Surface.ZEdges[Tile.Z] + Town.Surface.ZEdges[Tile.Z + 1]) / 2.0
            End For

            Center.X = Center.X / ToDouble(AreaCount)
            Center.Z = Center.Z / ToDouble(AreaCount)
            Value.Positions[Value.LabelCount] = Center
            Value.Names[Value.LabelCount] = Town.MapTiles[Index].Destination
            Value.LabelCount = Value.LabelCount + 1

        End If

    End For

End Sub

Public Sub AssignConnected(ByRef Town As Document.State, First As Number,
    Destination As Text, Optional Merge As Boolean = False)

    Dim AreaCount As Number
    Dim Index As Number

    If Not Document.ValidName(Destination) Then
        Return
    End If

    AreaCount = CollectConnected(Town, First, Not Merge)

    For Index = 0 To AreaCount - 1
        Town.MapTiles[Queue[Index]].Destination = Destination
    End For

    If AreaCount > 0 Then
        Town.Revision = Town.Revision + 1
    End If

End Sub

Public Function Place(ByRef Town As Document.State, X As Number, Z As Number, Destination As Text) As Boolean

    Dim Index As Number
    Dim Inherited As Text

    If (X < 0 Or
        Z < 0 Or
        X >= Town.Surface.Columns Or
        Z >= Town.Surface.Rows) Then
        Return False
    End If

    Inherited = Neighbor(Town, X, Z)

    If Text_Length(Inherited) > 0 Then
        Destination = Inherited
    End If

    If Not Document.ValidName(Destination) Then
        Return False
    End If

    Index = Find(Town, X, Z)

    If Index < 0 Then

        If Town.MapTileCount = Document.MAX_MAP_TILES Then
            Return False
        End If

        Index = Town.MapTileCount
        Town.MapTileCount = Town.MapTileCount + 1
        Town.MapTiles[Index].X = X
        Town.MapTiles[Index].Z = Z

    End If

    Call AssignConnected(Town, Index, Destination, True)

    Return True

End Function

''' Validate the complete rectangle before adding any tile; connect the group once.
Public Function PlaceRectangle(ByRef Town As Document.State, X0 As Number, Z0 As Number,
    X1 As Number, Z1 As Number, Destination As Text) As Boolean

    Dim X As Number
    Dim Z As Number
    Dim Index As Number
    Dim Needed As Number
    Dim First As Number

    If (X0 < 0 Or
        Z0 < 0 Or
        X1 < X0 Or
        Z1 < Z0 Or
        X1 >= Town.Surface.Columns Or
        Z1 >= Town.Surface.Rows Or
        Not Document.ValidName(Destination) Or
        Destination = Town.Name) Then
        Return False
    End If

    Needed = (X1 - X0 + 1) * (Z1 - Z0 + 1)

    For Z = Z0 To Z1

        For X = X0 To X1
            Lookup[X, Z] = 0
        End For
    End For

    For Index = 0 To Town.MapTileCount - 1

        X = Town.MapTiles[Index].X
        Z = Town.MapTiles[Index].Z

        If (X >= X0 And
            X <= X1 And
            Z >= Z0 And
            Z <= Z1) Then
            Lookup[X, Z] = Index + 1
            Needed = Needed - 1
        End If

    End For

    If Town.MapTileCount + Needed > Document.MAX_MAP_TILES Then
        Return False
    End If

    For Z = Z0 To Z1

        For X = X0 To X1

            Index = Lookup[X, Z] - 1

            If Index < 0 Then

                Index = Town.MapTileCount
                Town.MapTileCount = Town.MapTileCount + 1
                Town.MapTiles[Index].X = X
                Town.MapTiles[Index].Z = Z

            End If

            Town.MapTiles[Index].Destination = Destination
            First = Index
        End For
    End For

    Call AssignConnected(Town, First, Destination, True)

    Return True

End Function

Public Function Remove(ByRef Town As Document.State, X As Number, Z As Number) As Boolean

    Dim Index As Number
    Dim AreaCount As Number
    Dim Kept As Number
    Dim Last As Document.MapTile

    Index = Find(Town, X, Z)

    If Index < 0 Then
        Return False
    End If

    AreaCount = CollectConnected(Town, Index, True)

    For Index = 0 To Town.MapTileCount - 1

        If Not Seen[Index] Then
            Town.MapTiles[Kept] = Town.MapTiles[Index]
            Kept = Kept + 1
        End If

    End For

    For Index = Kept To Town.MapTileCount - 1
        Town.MapTiles[Index] = Last
    End For

    Town.MapTileCount = Kept
    Town.Revision = Town.Revision + 1

    Return True

End Function

''' Capture one connected destination without exposing the flood-fill scratch.
Public Function SelectArea(ByRef Town As Document.State, X As Number, Z As Number,
    ByRef Value As Area) As Boolean

    Dim Index As Number
    Dim Tile As Document.MapTile
    Dim Result As Boolean

    Value.TileCount = CollectConnected(Town, Find(Town, X, Z), True)
    Value.Revision = Town.Revision
    Value.X0 = Town.Surface.Columns
    Value.Z0 = Town.Surface.Rows
    Value.X1 = -1
    Value.Z1 = -1

    For Index = 0 To Value.TileCount - 1

        Tile = Town.MapTiles[Queue[Index]]
        Value.Tiles[Index] = Tile
        Value.X0 = Min(Value.X0, Tile.X)
        Value.Z0 = Min(Value.Z0, Tile.Z)
        Value.X1 = Max(Value.X1, Tile.X)
        Value.Z1 = Max(Value.Z1, Tile.Z)
    End For

    Result = Value.TileCount > 0
    Return Result

End Function

''' Validate bounds, overlap and capacity before changing any travel cell.
Public Function TransformArea(ByRef Town As Document.State, ByRef Value As Area,
    X0 As Number, Z0 As Number, X1 As Number, Z1 As Number, Resize As Boolean) As Boolean

    Dim AreaCount As Number
    Dim Needed As Number
    Dim Index As Number
    Dim X As Number
    Dim Z As Number
    Dim Existing As Number
    Dim Kept As Number
    Dim Tile As Document.MapTile
    Dim Empty As Document.MapTile

    If (Value.TileCount = 0 Or
        Value.Revision <> Town.Revision Or
        X0 < 0 Or
        Z0 < 0 Or
        X1 < X0 Or
        Z1 < Z0 Or
        X1 >= Town.Surface.Columns Or
        Z1 >= Town.Surface.Rows) Then
        Return False
    End If

    If Resize Then

        If Value.TileCount <> (Value.X1 - Value.X0 + 1) * (Value.Z1 - Value.Z0 + 1) Then
            Return False
        End If

    Else

        If X1 - X0 <> Value.X1 - Value.X0 Or Z1 - Z0 <> Value.Z1 - Value.Z0 Then
            Return False
        End If

    End If

    AreaCount = CollectConnected(Town, Find(Town, Value.Tiles[0].X, Value.Tiles[0].Z), True)
    Needed = Value.TileCount

    If Resize Then
        Needed = (X1 - X0 + 1) * (Z1 - Z0 + 1)
    End If

    If (AreaCount <> Value.TileCount Or
        Town.MapTileCount - AreaCount + Needed > Document.MAX_MAP_TILES) Then
        Return False
    End If

    For Index = 0 To Needed - 1

        If Resize Then
            X = X0 + Index Mod (X1 - X0 + 1)
            Z = Z0 + Index / (X1 - X0 + 1)
        Else
            X = Value.Tiles[Index].X + X0 - Value.X0
            Z = Value.Tiles[Index].Z + Z0 - Value.Z0
        End If

        Existing = Lookup[X, Z] - 1

        If Existing >= 0 Then

            If Not Seen[Existing] Then
                Return False
            End If

        End If

    End For

    If (X0 = Value.X0 And
        Z0 = Value.Z0 And
        X1 = Value.X1 And
        Z1 = Value.Z1) Then
        Return True
    End If

    For Index = 0 To Town.MapTileCount - 1

        If Not Seen[Index] Then
            Town.MapTiles[Kept] = Town.MapTiles[Index]
            Kept = Kept + 1
        End If

    End For

    Tile.Destination = Value.Tiles[0].Destination

    For Index = 0 To Needed - 1

        If Resize Then
            Tile.X = X0 + Index Mod (X1 - X0 + 1)
            Tile.Z = Z0 + Index / (X1 - X0 + 1)
        Else
            Tile.X = Value.Tiles[Index].X + X0 - Value.X0
            Tile.Z = Value.Tiles[Index].Z + Z0 - Value.Z0
        End If

        Town.MapTiles[Kept] = Tile
        Kept = Kept + 1
    End For

    For Index = Kept To Town.MapTileCount - 1
        Town.MapTiles[Index] = Empty
    End For

    Town.MapTileCount = Kept
    Town.Revision = Town.Revision + 1
    Return True

End Function

''' Remap travel cells by their physical area, including cells split by new edges.
Public Function Transfer(ByRef Source As Document.State, ByRef Target As Document.State,
    Area As Regions.Region, DeltaX As Double, DeltaZ As Double, Move As Boolean) As Boolean

    Dim Destination As Regions.Region
    Dim X As Number
    Dim Z As Number
    Dim Index As Number
    Dim ReadX As Number
    Dim ReadZ As Number
    Dim WorldX As Double
    Dim WorldZ As Double
    Dim SampleX As Double
    Dim SampleZ As Double

    For Z = 0 To Source.Surface.Rows - 1

        For X = 0 To Source.Surface.Columns - 1
            Lookup[X, Z] = 0
        End For
    End For

    For Index = 0 To Source.MapTileCount - 1
        Lookup[Source.MapTiles[Index].X, Source.MapTiles[Index].Z] = Index + 1
    End For

    Target.MapTileCount = 0
    Destination = Regions.Shift(Area, DeltaX, DeltaZ)

    For Z = 0 To Target.Surface.Rows - 1

        WorldZ = (Target.Surface.ZEdges[Z] + Target.Surface.ZEdges[Z + 1]) * 0.5

        For X = 0 To Target.Surface.Columns - 1

            WorldX = (Target.Surface.XEdges[X] + Target.Surface.XEdges[X + 1]) * 0.5
            SampleX = WorldX
            SampleZ = WorldZ

            If Regions.Contains(Destination, WorldX, WorldZ) Then
                SampleX = WorldX - DeltaX
                SampleZ = WorldZ - DeltaZ
            End If

            ReadX = Grid.CellX(Source.Surface, SampleX)
            ReadZ = Grid.CellZ(Source.Surface, SampleZ)
            Index = Lookup[ReadX, ReadZ] - 1

            If (Move And
                Regions.Contains(Area, WorldX, WorldZ) And
                Not Regions.Contains(Destination, WorldX, WorldZ)) Then
                Index = -1
            End If

            If Index >= 0 Then

                If Target.MapTileCount >= Document.MAX_MAP_TILES Then
                    Return False
                End If

                Target.MapTiles[Target.MapTileCount].X = X
                Target.MapTiles[Target.MapTileCount].Z = Z
                Target.MapTiles[Target.MapTileCount].Destination = Source.MapTiles[Index].Destination
                Target.MapTileCount = Target.MapTileCount + 1

            End If

        End For
    End For

    Return True

End Function

End Module
