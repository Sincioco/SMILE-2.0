''' Ten staggered flights arrive, use the U-turn road, and depart on the other strip.
Module Smile.Tools.NerisRunwayTraffic

Option Explicit

Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.PrecisionMath3D As M

Public Const CYCLE = 150000
Public Const INTERVAL = 15000
Public Const FLIGHT_COUNT = 10
Public Const SCALE = 0.55

Public Type State
    Time As Number
End Type

Public Sub Advance(ByRef Value As State, Elapsed As Number)

    Value.Time = (Value.Time + Max(0, Elapsed) Mod CYCLE) Mod CYCLE

End Sub

Public Function Scheduled(Value As State, Index As Number) As State

    Dim Result As State

    Result.Time = (Value.Time + Index * INTERVAL) Mod CYCLE

    Return Result

End Function

Private Function Fraction(Time As Number, Start As Number, Duration As Number) As Double

    Dim Result As Double

    Result = Clamp(ToDouble(Time - Start) / ToDouble(Duration), 0.0, 1.0)

    Return Result

End Function

Public Function Position(Value As State) As P.Vector3

    Dim Result As P.Vector3
    Dim T As Double

    If Value.Time >= 60000 Then
        T = Fraction(Value.Time, 60000, 15000)
        Result = P.Vector(-180.0 - 1620.0 * T, 0.14 + 350.0 * T * T, 270.0)
    Else If Value.Time >= 45000 Then
        T = Fraction(Value.Time, 45000, 15000)
        Result = P.Vector(360.0 - 540.0 * T * T, 0.14, 270.0)
    Else If Value.Time >= 42000 Then
        Result = P.Vector(360.0, 0.14, 270.0)
    Else If Value.Time >= 32000 Then
        T = Fraction(Value.Time, 32000, 10000)
        Result = P.Vector(360.0 + 42.5 * Sin(M.Radians(180.0 * T)),
            0.14, 312.5 + 42.5 * Cos(M.Radians(180.0 * T)))
    Else If Value.Time >= 20000 Then
        T = Fraction(Value.Time, 20000, 12000)
        Result = P.Vector(-240.0 + 600.0 * (2.0 * T - T * T), 0.14, 355.0)
    Else
        T = Fraction(Value.Time, 0, 20000)
        Result = P.Vector(-1700.0 + 1460.0 * T, 0.14 + 300.0 * (1.0 - T) * (1.0 - T), 355.0)
    End If

    Return Result

End Function

''' Cooked models face -Z; heading follows the tangent throughout the U-turn.
Public Function Heading(Value As State) As Double

    Dim Result As Double

    Result = 180.0

    If Value.Time >= 42000 Then
        Result = 0.0
    Else If Value.Time >= 32000 Then
        Result = 180.0 + 180.0 * Fraction(Value.Time, 32000, 10000)
    End If

    Result = M.WrapDegrees(Result + 180.0)

    Return Result

End Function

Public Function Pitch(Value As State) As Double

    Dim Result As Double

    If Value.Time < 20000 Then
        Result = -8.0 * (1.0 - Fraction(Value.Time, 0, 20000))
    Else If Value.Time >= 60000 Then
        Result = 12.0 * Fraction(Value.Time, 60000, 15000)
    End If

    Return Result

End Function

Public Function Visible(Value As State) As Boolean

    Dim Result As Boolean

    Result = Value.Time < 75000

    Return Result

End Function

End Module
