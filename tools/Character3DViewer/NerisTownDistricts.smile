''' Saved waterfront land, water and ground heights; native coordinates.
Module Smile.Tools.NerisTownDistricts

Option Explicit

Import Smile.Tools.NerisTownLayout As Layout
Import Smile.Tools.NerisTownSite As Site

Public Function CanStand(X As Double, Z As Double) As Boolean

    Dim Index As Number
    Dim OnLand As Boolean

    For Index = 0 To Site.BRIDGE_COUNT - 1

        If Site.Contains(Site.BridgeAt(Index), X, Z, -4.0) Then
            Return True
        End If

    End For

    For Index = 0 To Site.LAND_COUNT - 1
        OnLand = OnLand Or Site.Contains(Site.LandAt(Index), X, Z, -4.0)
    End For

    If Not OnLand Then
        Return False
    End If

    For Index = 0 To Site.WATER_COUNT - 1

        If Site.Contains(Site.WaterAt(Index), X, Z, 3.0) Then
            Return False
        End If

    End For

    Return True

End Function

Public Function GroundHeight(X As Double, Z As Double) As Double

    Dim Result As Double

    Result = Layout.PavingHeight(X, Z)

    If X > -1910.0 And X < -410.0 And Z > 1710.0 And Z < 2990.0 Then
        Result = Max(Result, 22.52)
    End If

    If X > 680.0 And X < 2220.0 And Z > 1730.0 And Z < 3110.0 Then
        Result = Max(Result, 23.6)
    End If

    Return Result

End Function

End Module
