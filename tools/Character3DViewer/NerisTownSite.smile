        Case 9
            Result = Box(460.000, 3110.000, 2440.000, 3330.000)
        Case 10
            Result = Box(460.000, 1730.000, 680.000, 3110.000)
        Case 11
            Result = Box(2220.000, 1730.000, 2440.000, 3110.000)
        Case 12
            Result = Box(-660.000, -3400.000, -500.000, -440.000)
        Case 13
            Result = Box(500.000, -3400.000, 660.000, -440.000)
        Case 14
            Result = Box(-660.000, -440.000, 660.000, -280.000)
        Case 15
            Result = Box(-4900.000, -3550.000, -4840.000, 3550.000)
        Case 16
            Result = Box(-4840.000, -3550.000, -2400.000, 900.000)
        Case 17
            Result = Box(-4840.000, 3520.000, -2400.000, 3550.000)
        Case 18
            Result = Box(2600.000, -3550.000, 2750.000, 3550.000)
        Case 19
            Result = Box(-2400.000, -3550.000, 2600.000, -3400.000)
        Case 20
            Result = Box(-2400.000, 3520.000, 2600.000, 3550.000)
    End Select

    Return Result

End Function

Public Const BRIDGE_COUNT = 10

Public Function BridgeAt(Index As Number) As Region

    Dim Result As Region

    Select Case Index
        Case 0
            Result = Box(-1250.000, 1270.000, -1070.000, 1810.000)
        Case 1
            Result = Box(-3740.000, 1060.000, -3580.000, 1480.000)
        Case 2
            Result = Box(1310.000, 1400.000, 1590.000, 1940.000)
        Case 3
            Result = Box(-730.000, -1170.000, -430.000, -1070.000)
        Case 4
            Result = Box(430.000, -1170.000, 730.000, -1070.000)
        Case 5
            Result = Box(-730.000, -1760.000, -430.000, -1640.000)
        Case 6
            Result = Box(430.000, -1760.000, 730.000, -1640.000)
        Case 7
            Result = Box(-730.000, -2860.000, -430.000, -2740.000)
        Case 8
            Result = Box(430.000, -2860.000, 730.000, -2740.000)
        Case 9
            Result = Box(-70.000, -520.000, 70.000, -200.000)
    End Select

    Return Result

End Function

Public Const LAND_COUNT = 3

Public Function LandAt(Index As Number) As Region

    Dim Result As Region

    Select Case Index
        Case 0
            Result = Box(-2400.000, -3400.000, 2600.000, 3520.000)
        Case 1
            Result = Box(-4840.000, 900.000, -2380.000, 3520.000)
        Case 2
            Result = Box(-2700.000, 900.000, -2300.000, 1180.000)
    End Select

    Return Result

End Function

