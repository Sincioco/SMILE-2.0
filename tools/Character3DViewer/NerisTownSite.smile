''' Generated from the saved Blender waterfront. No runtime ownership.
Module Smile.Tools.NerisTownSite

Option Explicit

Public Type Region
    X0 As Double
    Z0 As Double
    X1 As Double
    Z1 As Double
End Type

Public Const WEST = -4900
Public Const SOUTH = -3550
Public Const EAST = 2750
Public Const NORTH = 3550

Private Function Box(X0 As Double, Z0 As Double, X1 As Double, Z1 As Double) As Region

    Dim Result As Region

    Result.X0 = X0
    Result.Z0 = Z0
    Result.X1 = X1
    Result.Z1 = Z1

    Return Result

End Function

Public Const WATER_COUNT = 21

Public Function WaterAt(Index As Number) As Region

    Dim Result As Region

    Select Case Index
        Case 0
            Result = Box(-2290.000, 1330.000, -30.000, 1650.000)
        Case 1
            Result = Box(-2290.000, 3030.000, -30.000, 3350.000)
        Case 2
            Result = Box(-2290.000, 1650.000, -1930.000, 3030.000)
        Case 3
            Result = Box(-390.000, 1650.000, -30.000, 3030.000)
        Case 4
