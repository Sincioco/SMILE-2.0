''' Fractional orbit composition for the native battle presentation.
Module Smile.Tools.BattleCamera

Option Explicit

Import Smile.Simple3D.Core As Core
Import Smile.Simple3D.Interaction As Interaction
Import Smile.Simple3D.FixedMath As Fixed

''' A continuous front-of-boss sweep with gentle turnarounds and no angle truncation.
Public Function FrontArcYaw1000(Phase1000 As Number) As Number

    Dim Angle As Number
    Dim Fraction As Number
    Dim Sine As Number
    Dim Result As Number

    Phase1000 = (Phase1000 Mod 360000 + 360000) Mod 360000
    Angle = Phase1000 / 1000
    Fraction = Phase1000 Mod 1000
    Sine = (Fixed.SinFixed(Angle) * (1000 - Fraction) +
        Fixed.SinFixed(Angle + 1) * Fraction) / 1000
    Result = 120000 + Sine * 55000 / Core.FIXED_ONE

    Return Result

End Function

Public Function Orbit(Base As Core.Camera3D, Controls As Core.CameraControl3D,
    Yaw1000 As Number) As Core.Camera3D

    Dim First As Core.Camera3D
    Dim Second As Core.Camera3D
    Dim Fraction As Number

    Yaw1000 = (Yaw1000 Mod 360000 + 360000) Mod 360000
    Controls.OrbitYaw = Yaw1000 / 1000
    Fraction = Yaw1000 Mod 1000
    First = Interaction.ApplyScreenSpaceCameraControls(Base, Controls)
    Controls.OrbitYaw = (Controls.OrbitYaw + 1) Mod 360
    Second = Interaction.ApplyScreenSpaceCameraControls(Base, Controls)
    First.Position.X = First.Position.X + (Second.Position.X - First.Position.X) * Fraction / 1000
    First.Position.Y = First.Position.Y + (Second.Position.Y - First.Position.Y) * Fraction / 1000
    First.Position.Z = First.Position.Z + (Second.Position.Z - First.Position.Z) * Fraction / 1000
    First.Target.X = First.Target.X + (Second.Target.X - First.Target.X) * Fraction / 1000
    First.Target.Y = First.Target.Y + (Second.Target.Y - First.Target.Y) * Fraction / 1000
    First.Target.Z = First.Target.Z + (Second.Target.Z - First.Target.Z) * Fraction / 1000
    First.UpDirection.X = First.UpDirection.X + (Second.UpDirection.X - First.UpDirection.X) * Fraction / 1000
    First.UpDirection.Y = First.UpDirection.Y + (Second.UpDirection.Y - First.UpDirection.Y) * Fraction / 1000
    First.UpDirection.Z = First.UpDirection.Z + (Second.UpDirection.Z - First.UpDirection.Z) * Fraction / 1000

    Return First

End Function

End Module
