''' Focused relative-shot, persistence, head identity and camera-control regressions.
Module Smile.Tools.BeatCameraTests

Option Explicit

Import Smile.Tools.BattleCameraShots As Shots
Import Smile.Tools.ViewerBeatEditor As Editor
Import Smile.Tools.ViewerBeatSequence As Sequence
Import Smile.Tools.Character3DViewerProfiles As Profiles
Import Smile.Tools.BattleCameraTimeline As Track
Import Smile.Tools.ViewerBeatTimeline As Timeline
Import Smile.Tools.Character3DViewerCamera As Camera
Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.PrecisionMath3D As M

Private Sub Check(Condition As Boolean, Label As Text, ByRef Failures As Number)

    If Not Condition Then
        Print "FAIL: Beat Camera "; Label
        Failures = Failures + 1
    End If

End Sub

Public Function Run() As Number

    Dim Failures As Number
    Dim Value As Shots.Shot
    Dim Decoded As Shots.Shot
    Dim SavedHead As Shots.HeadReference
    Dim LoadedHead As Shots.HeadReference
    Dim First As P.Camera3D
    Dim Resolved As P.Camera3D
    Dim Second As P.Camera3D
    Dim Attacker As P.Vector3
    Dim Target As P.Vector3
    Dim Shift As P.Vector3
    Dim Rotation As P.Vector3
    Dim Text As Text
    Dim Result As Boolean
    Dim Ui As Editor.State
    Dim Controls As Camera.State
    Dim Previous As Shots.Shot
    Dim Following As Shots.Shot
    Dim Legacy As Shots.Shot
    Dim Index As Number

    Attacker = P.Vector(0.125, 80.375, 10.625)
    Target = P.Vector(0.125, 155.875, 310.625)
    First.Position = P.Vector(100.875, 110.125, -240.625)
    First.Target = P.Vector(0.375, 100.875, 180.125)
    First.UpDirection = P.Vector(0.0, 1.0, 0.0)
    First.FovDegrees = 38.125
    First.NearPlane = 0.1
    First.FarPlane = 5000.0

    Call Shots.Capture(Value, First, Attacker, Target)

    Resolved = Shots.Resolve(Value, Attacker, Target, First, 0.0)

    Call Check(M.Distance(Resolved.Position, First.Position) < 1e-9, "Capture Round Trip", Failures)
    Call Check(M.Distance(Resolved.Target, First.Target) < 1e-9, "Aim Round Trip", Failures)

    Shift = P.Vector(-125.375, 10.625, 90.125)
    Resolved = Shots.Resolve(Value, M.Add(Attacker, Shift), M.Add(Target, Shift), First, 0.0)

    Call Check(M.Distance(Resolved.Position, M.Add(First.Position, Shift)) < 1e-9, "Formation Translation", Failures)

    Rotation.Y = 90.0
    Resolved = Shots.Resolve(Value, M.Rotate(Attacker, Rotation), M.Rotate(Target, Rotation), First, 0.0)

    Call Check(M.Distance(Resolved.Position, M.Rotate(First.Position, Rotation)) < 1e-9, "Attacker Target Rotation", Failures)

    Text = Shots.Encode(Value)
    Result = Shots.Decode(Text, Decoded)

    Call Check(Result And Text_Slice(Text, 0, 13) = "SMILE-Shot-2|" And
        Decoded.FrameVersion = 2 And Decoded.Eye.X = Value.Eye.X And
        Decoded.Fov = Value.Fov, "Stable Binary64 Text Round Trip", Failures)

    Call CheckStableVerticalFrame(Failures, First)

    Result = Shots.Decode("SMILE-Shot-1|0|0|-18|0|0|1|40|0|0|", Legacy)

    Call Check(Result And Not Shots.CanResolve(Legacy),
        "Unsafe Legacy Shot Is Rejected For Playback", Failures)

    Resolved = Shots.Resolve(Legacy, Attacker, Target, First, 0.0)

    Call Check(M.Distance(Resolved.Position, First.Position) < 1e-9 And
        M.Distance(Resolved.Target, First.Target) < 1e-9,
        "Unsafe Legacy Shot Uses Built In Camera", Failures)

    Result = Shots.Decode("SMILE-Shot-1|0|10|-0.2|0|5|1|40|0|0|", Legacy)

    Call Check(Result And Shots.CanResolve(Legacy) And
        Text_Slice(Shots.Encode(Legacy), 0, 13) = "SMILE-Shot-1|",
        "Bounded Legacy Shot Remains Playable", Failures)

    Resolved = Shots.Resolve(Legacy, Attacker, Target, First, 0.0)

    Call Check(Abs(Resolved.Position.Y - 75.275) < 1e-9,
        "Bounded Legacy Shot Retains Shot 1 Coordinates", Failures)

    Result = Shots.Decode("SMILE-Shot-1|1e999|", Decoded)

    Call Check(Not Result And Decoded.Fov = Value.Fov, "Malformed Save Preserves Destination", Failures)

    Result = Shots.WriteShot("BeatCamera.Test.Shot", Value)
    Result = Shots.ReadShot("BeatCamera.Test.Shot", Decoded) And Result

    Call Check(Result And Decoded.Eye.X = Value.Eye.X, "Actual Save Data Round Trip", Failures)

    SavedHead.Offset = P.Vector(0.125, 3.375, -1.625)
    SavedHead.Size = P.Vector(20.125, 30.375, 15.625)
    Result = Shots.WriteHead("BeatCamera.Test.Head", SavedHead)
    Result = Shots.ReadHead("BeatCamera.Test.Head", LoadedHead) And Result

    Call Check(Result And LoadedHead.Size.Z = SavedHead.Size.Z And LoadedHead.Offset.Y = SavedHead.Offset.Y, "Head Cuboid Persistence", Failures)

    For Index = 1 To 4

        Value.Motion = Index
        Resolved = Shots.Resolve(Value, Attacker, Target, First, 0.0)
        Second = Shots.Resolve(Value, Attacker, Target, First, 1.0)

        Call Check(M.Distance(Resolved.Position, First.Position) < 1e-9 And
            M.Distance(Second.Position, First.Position) > 1.0, "Motion Endpoints", Failures)
    End For

    Resolved = Shots.Blend(First, Second, 0.0)

    Call Check(M.Distance(Resolved.Position, First.Position) < 1e-9, "Connection Start", Failures)

    Resolved = Shots.Blend(First, Second, 1.0)

    Call Check(M.Distance(Resolved.Position, Second.Position) < 1e-9, "Connection End", Failures)
    Call CheckLinkedCameraIntegrity(Failures)

    Value.Motion = 0
    Value.Connection = 1
    Following = Value
    Following.Eye.X = Following.Eye.X + 80.0
    Following.Connection = -1
    Resolved = Shots.ResolveLinked(Value, Previous, Following, Attacker, Target, First, 1.0)
    Second = Shots.ResolveLinked(Following, Value, Previous, Attacker, Target, First, 0.0)

    Call Check(M.Distance(Resolved.Position, Second.Position) < 1e-9,
        "Reciprocal Connections Meet Without Replaying Transition", Failures)

    Resolved = Shots.ResolveLinked(Value, Previous, Previous, Attacker, Target, First, 1.0)
    Second = Shots.Resolve(Value, Attacker, Target, First, 1.0)

    Call Check(M.Distance(Resolved.Position, Second.Position) < 1e-9,
        "Missing Neighbor Does Not Invent A Shot", Failures)

    Resolved = Shots.ResolveLinked(Previous, Value, Following, Attacker, Target, First, 0.5)

    Call Check(M.Distance(Resolved.Position, First.Position) < 1e-9,
        "Unauthored Beat Retains Actual Default Camera", Failures)

    Ui.Editing = True
    Ui.Draft = Value
    Ui.References[0] = SavedHead
    Ui.References[1].Size = P.Vector(40.0, 45.0, 35.0)

    Call Editor.Copy(Ui, True)

    Ui.Selected = 1
    Ui.Beat = 2

    Call Editor.Paste(Ui)
    Call Check(Ui.Draft.Eye.X = Value.Eye.X And Ui.References[1].Size.X = 40.0,
        "Cross Character Copy Preserves Destination Head", Failures)
    Call Check(Sequence.Identity(False, 2) <> Sequence.Identity(True, 2), "Independent Boss Identities", Failures)

    If Profiles.INCLUDE_MIRA_COMPARISONS Then
        Call Check(Sequence.NextActor(False, 1, True) = 6 And
            Sequence.NextActor(True, 5, True) = 6 And
            Sequence.NextActor(False, 6, True) = 2 And
            Sequence.NextActor(True, 6, True) = 2,
            "Mira And Both Bosses In Selection Cycle", Failures)
    Else

        Call Check(Sequence.NextActor(False, 1, True) = 2 And Sequence.NextActor(True, 5, True) = 2,
            "Both Bosses In Selection Cycle", Failures)
    End If

    Controls.Base = First
    Controls.Base.Position = P.Vector(-400.0, 140.0, 0.0)
    Controls.Base.Target = P.Vector(0.0, 100.0, 0.0)

    Call Camera.ComposeShot(Controls)
    Call Check(M.Distance(Controls.Live.Position, Controls.Base.Position) < 1e-9,
        "Arbitrary Shot Basis Without Jump", Failures)

    Controls.Controls.PanX = 0.125

    Call Camera.ComposeShot(Controls)
    Call Check(Abs(Controls.Live.Position.Z - Controls.Base.Position.Z) > 0.1,
        "Pan Follows Saved Camera Right Axis", Failures)

    Call CheckTimeline(Failures, Value)
    Call CheckLargeFrame(Failures, 0.375)

    Return Failures

End Function

Private Sub CheckLinkedCameraIntegrity(ByRef Failures As Number)

    Dim FirstShot As Shots.Shot
    Dim SecondShot As Shots.Shot
    Dim EmptyShot As Shots.Shot
    Dim First As P.Camera3D
    Dim Second As P.Camera3D
    Dim Resolved As P.Camera3D
    Dim NearbyBefore As P.Camera3D
    Dim NearbyAfter As P.Camera3D
    Dim Backward As P.Camera3D
    Dim VerticalFirst As P.Camera3D
    Dim VerticalSecond As P.Camera3D
    Dim Attacker As P.Vector3
    Dim Target As P.Vector3

    Attacker = P.Vector(0.0, 100.0, 0.0)
    Target = P.Vector(0.0, 100.0, 300.0)
    First.Position = P.Vector(0.0, 100.0, -100.0)
    First.Target = Attacker
    First.UpDirection = P.Vector(0.0, 1.0, 0.0)
    First.FovDegrees = 45.0
    First.NearPlane = 0.1
    First.FarPlane = 5000.0

    FirstShot.Saved = True
    FirstShot.FrameVersion = 2
    FirstShot.Eye = P.Vector(-100.0, 0.0, 0.0)
    FirstShot.Aim = P.Vector(0.0, 0.0, 0.0)
    FirstShot.Fov = 45.0
    FirstShot.Connection = 1
    SecondShot = FirstShot
    SecondShot.Eye = P.Vector(100.0, 0.0, 0.0)
    SecondShot.Connection = 0
    First = Shots.Resolve(FirstShot, Attacker, Target, First, 0.0)
    Second = Shots.Resolve(SecondShot, Attacker, Target, First, 0.0)
    NearbyBefore = Shots.ResolveLinked(FirstShot, EmptyShot, SecondShot,
        Attacker, Target, First, 0.49)
    Resolved = Shots.ResolveLinked(FirstShot, EmptyShot, SecondShot,
        Attacker, Target, First, 0.5)
    NearbyAfter = Shots.ResolveLinked(FirstShot, EmptyShot, SecondShot,
        Attacker, Target, First, 0.51)

    Call Check(M.Distance(Resolved.Position, Resolved.Target) > 0.000001,
        "Linked Camera Midpoint Keeps A Viewing Direction", Failures)
    Call Check(P.SetCamera(NearbyBefore) And P.SetCamera(Resolved) And
        P.SetCamera(NearbyAfter),
        "Linked Camera Midpoint And Nearby Samples Reach The Native Renderer", Failures)
    Call Check(M.Distance(NearbyBefore.Position, Resolved.Position) < 10.0 And
        M.Distance(Resolved.Position, NearbyAfter.Position) < 10.0,
        "Opposing Linked Views Follow A Bounded Continuous Arc", Failures)

    Backward = Shots.ResolveLinked(FirstShot, EmptyShot, SecondShot,
        Attacker, Target, First, 0.25)
    Resolved = Shots.ResolveLinked(FirstShot, EmptyShot, SecondShot,
        Attacker, Target, First, 0.75)
    Resolved = Shots.ResolveLinked(FirstShot, EmptyShot, SecondShot,
        Attacker, Target, First, 0.25)

    Call Check(M.Distance(Backward.Position, Resolved.Position) < 1e-9 And
        M.Distance(Backward.Target, Resolved.Target) < 1e-9,
        "Linked Camera Seeking Is Stateless", Failures)

    VerticalFirst = First
    VerticalFirst.Position = P.Vector(0.0, 0.0, 0.0)
    VerticalFirst.Target = P.Vector(0.0, 100.0, 0.0)
    VerticalFirst.UpDirection = P.Vector(0.0, 1.0, 0.0)
    VerticalSecond = VerticalFirst
    VerticalSecond.Position.X = 10.0
    VerticalSecond.Target.X = 10.0
    Resolved = Shots.Blend(VerticalFirst, VerticalSecond, 0.5)

    Call Check(Abs(M.Dot(M.Subtract(Resolved.Target, Resolved.Position),
        Resolved.UpDirection)) < 0.000001 And P.SetCamera(Resolved),
        "Linked Camera Repairs A Parallel Up Direction", Failures)

End Sub

Private Sub CheckStableVerticalFrame(ByRef Failures As Number, Lens As P.Camera3D)

    Dim Value As Shots.Shot
    Dim Attacker As P.Vector3
    Dim Target As P.Vector3
    Dim DroppedTarget As P.Vector3
    Dim Camera As P.Camera3D
    Dim Resolved As P.Camera3D

    Attacker = P.Vector(0.0, 80.0, 0.0)
    Target = P.Vector(0.0, 160.0, 100.0)
    Camera = Lens
    Camera.Position = P.Vector(20.0, 110.0, -1800.0)
    Camera.Target = P.Vector(0.0, 140.0, 100.0)

    Call Shots.Capture(Value, Camera, Attacker, Target)

    DroppedTarget = Target
    DroppedTarget.Y = 110.0
    Resolved = Shots.Resolve(Value, Attacker, DroppedTarget, Lens, 0.0)

    Call Check(Value.Eye.Z < -1.0 And
        Abs(Resolved.Position.Y - Camera.Position.Y) < 1e-9,
        "Distant Camera Does Not Amplify Animated Head Height", Failures)
    Call Check(Abs(Resolved.Target.Y - 90.0) < 1e-9,
        "Between Actor Aim Follows Bounded Head Height", Failures)

End Sub

Private Sub CheckTimeline(ByRef Failures As Number, Camera As Shots.Shot)

    Dim Definition As Track.Definition
    Dim Loaded As Track.Definition
    Dim Source As Sequence.Timing
    Dim Timed As Sequence.Timing
    Dim Edited As Editor.State
    Dim Extra As Number
    Dim Result As Boolean
    Dim Encoded As Text

    Source.Start[1] = 1000
    Source.Start[2] = 2000
    Source.Start[3] = 4000
    Source.Start[4] = 5000

    Call Track.Initialize(Definition)
    Call Track.Resize(Definition, Source, 0, 1500)

    Timed = Track.Schedule(Definition, Source, 1750)

    Call Check(Timed.Start[1] = 1500 And Timed.Start[2] = 2000 And
        Timed.Start[4] = 5000, "Camera Boundary Preserves Battle Duration And Later Beats", Failures)
    Call Check(Source.Start[1] = 1000 And Source.Start[3] = 4000,
        "Camera Edit Leaves Original Action Schedule Unchanged", Failures)

    Extra = Track.Insert(Definition, Timed, 1750, Camera)

    Call Check(Extra = 4 And Track.Neighbor(Definition, Timed, 1500, 1) = 4 And
        Track.Neighbor(Definition, Timed, 2000, -1) = 4,
        "Next And Previous Include Extra Shots", Failures)
    Call Check(Track.AtTime(Definition, Timed, 1800) = 4,
        "Inserted Camera Owns Its Interval", Failures)

    Result = Track.MoveShot(Definition, Timed, Extra, 3000)

    Call Check(Result And Track.TimeAt(Definition, Timed, Extra) = 3000,
        "Extra Marker Moves Across Main Beats", Failures)

    Result = Track.Remove(Definition, 2)

    Call Check(Not Result And Definition.ShotCount = 5, "Main Beats Cannot Be Deleted", Failures)

    Definition.Cameras[0] = Camera
    Encoded = Track.Encode(Definition)
    Result = Track.Decode(Encoded, Loaded)

    Call Check(Result And Loaded.ShotCount = 5 And
        Loaded.Cameras[4].Eye.X = Camera.Eye.X And Loaded.Scale[0] = 1.5,
        "Sequence And Camera Serialization", Failures)

    Result = Track.WriteDefinition("BeatCamera.Test.Sequence.V2", Definition)
    Result = Track.ReadDefinition("BeatCamera.Test.Sequence.V2", Loaded) And Result

    Call Check(Result And Track.TimeAt(Loaded, Timed, 4) = 3000,
        "Actual Atomic Sequence Save Data Round Trip", Failures)

    Result = Track.Decode("SMILE-Sequence-2|21|", Loaded)

    Call Check(Not Result And Loaded.ShotCount = 5,
        "Malformed Sequence Preserves Existing Data", Failures)
    Call Check(Timeline.StepTime(0, 30, 1, 5000) = 33 And
        Timeline.StepTime(33, 30, -1, 5000) = 0,
        "Forward And Backward Frame Navigation", Failures)

    Edited.Working = Definition
    Edited.SourceSchedule = Source
    Edited.Editing = True
    Edited.Preview = True
    Edited.Draft = Camera

    Call Editor.SeekTo(Edited, 3000, 4)
    Call Check(Edited.ShotIndex = 4 And Edited.Editing And Edited.Scrubbing,
        "Marker Navigation Keeps Edit Mode", Failures)

    Edited.Camera.Live.Position = P.Vector(10.0, 20.0, 30.0)
    Edited.Camera.Live.Target = P.Vector(0.0, 20.0, 100.0)
    Edited.Camera.Live.FovDegrees = 40.0
    Edited.Heads[1].Z = 100.0

    Call Editor.ResumeCamera(Edited)
    Call Check(Not Edited.Scrubbing And Edited.Camera.Base.Position.X = 10.0,
        "Camera Controls Resume From Scrubbed View", Failures)

    Result = Editor.Keyboard(Edited, True, True, KEY_SPACE)

    Call Editor.AdvancePreview(Edited, 100)
    Call Check(Result And Edited.Playing And Edited.Elapsed = 3100 And
        Edited.Seek And Edited.ContinuousSample,
        "Space Plays Beat Sequence From Current Position", Failures)

    Result = Editor.Keyboard(Edited, True, True, KEY_SPACE)

    Call Editor.AdvancePreview(Edited, 100)
    Call Check(Not Edited.Playing And Edited.Elapsed = 3100,
        "Space Pauses Beat Sequence Without Advancing", Failures)

    Edited.Dirty = True
    Result = Editor.SaveShot(Edited, True)

    Call Check(Result And Edited.Preview And Edited.Editing And
        Not Edited.Dirty And Edited.ShotIndex = 4 And Edited.Elapsed = 3100 And
        Edited.Tracks[0].Cameras[4].Eye.X = Edited.Draft.Eye.X,
        "Save Persists Draft Without Closing Or Moving Editor", Failures)

    Edited.Tracks[0] = Definition
    Edited.References[0].Offset.X = 0.375

    Call Editor.ResetLengths(Edited)

    Timed = Track.Schedule(Edited.Working, Source, 0)

    Call Check(Timed.Start[1] = 1000 And Timed.Start[2] = 2000 And
        Timed.Start[3] = 4000 And Edited.Working.ShotCount = 5 And
        Edited.Working.Cameras[0].Eye.X = Definition.Cameras[0].Eye.X And
        Edited.Working.Cameras[4].Saved And Edited.Working.Cameras[4].Motion = Edited.Draft.Motion And
        Edited.Tracks[0].Scale[0] = 1.5 And Edited.References[0].Offset.X = 0.375,
        "Reset Lengths Preserves Cameras Extra Shots Heads And Saved Timing", Failures)

    Call Track.Resize(Edited.Working, Source, 0, 1500)
    Call Editor.ResetDefaults(Edited, False)
    Call Editor.StoreDraft(Edited)
    Call Check(Edited.ShotIndex = 2 And Edited.UseDefault And
        Not Edited.Working.Cameras[2].Saved And Edited.Working.Cameras[0].Saved And
        Edited.Working.ShotCount = 5 And Edited.Working.Scale[0] = 1.5,
        "Reset Beat Restores Only Current Main Camera In Draft", Failures)

    Call Editor.ResetDefaults(Edited, True)
    Call Editor.StoreDraft(Edited)

    Timed = Track.Schedule(Edited.Working, Source, 0)

    Call Check(Edited.Working.ShotCount = 4 And Not Edited.Working.Cameras[0].Saved And
        Not Edited.Working.Cameras[2].Saved And Timed.Start[1] = 1000 And
        Timed.Start[4] = 5000 And Edited.Tracks[0].ShotCount = 5 And
        Edited.Tracks[0].Cameras[0].Saved And Edited.References[0].Offset.X = 0.375,
        "Reset All Restores Four Default Cameras And Timing Without Changing Saves Or Heads", Failures)

    Encoded = Track.Encode(Edited.Working)
    Result = Track.Decode(Encoded, Loaded)

    Call Check(Result And Loaded.ShotCount = 4 And Not Loaded.Cameras[0].Saved,
        "Default Camera Fallback Survives Sequence Serialization", Failures)

    Edited.Elapsed = 3990
    Edited.Playing = True

    Call Editor.AdvancePreview(Edited, 100)

    Result = Editor.Keyboard(Edited, True, True, KEY_SPACE)

    Call Check(Not Edited.Playing And Edited.ShotIndex = 3,
        "Pause Selects Camera Under Playhead After Crossing Beats", Failures)

    Result = Track.Remove(Definition, 4)

    Call Check(Result And Definition.ShotCount = 4,
        "Optional Camera Marker Removal", Failures)

    Edited.Editing = True
    Edited.Preview = True
    Edited.Playing = True
    Edited.Scrubbing = True
    Edited.Seek = False
    Edited.Reframe = False
    Edited.ResetRequested = False

    Call Editor.ResetCameraView(Edited)

    Call Check(Edited.Reframe And Edited.ResetRequested And Edited.Seek And
        Not Edited.Playing And Not Edited.Scrubbing,
        "Camera View Button Resets Active Beat Camera", Failures)

    Edited.Working = Definition
    Edited.SourceSchedule = Source
    Edited.Elapsed = 3100

    Call Editor.RestartPresentation(Edited)

    Call Check(Edited.Elapsed = 0 And Edited.ShotIndex = 0 And
        Edited.Playing And Edited.Scrubbing,
        "Camera Present Button Restarts Beat Sequence", Failures)

End Sub

''' Native regression: noncontiguous local-array initialization used to skip a
''' Windows stack guard page before any SMILE statement in this procedure ran.
Private Sub CheckLargeFrame(ByRef Failures As Number, Fraction As Double)

    Dim Numbers[8192] As Number
    Dim Fractions[8192] As Double

    Numbers[8191] = 37
    Fractions[8191] = Fraction

    Call Check(Numbers[0] = 0 And Fractions[0] = 0.0 And
        Numbers[8191] = 37 And Fractions[8191] = 0.375,
        "Large Native Stack Frame Preserves Locals And Double Arguments", Failures)

End Sub

End Module
