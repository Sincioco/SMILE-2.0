''' Committed spatial snapshot for party movement through an edited town.
Module Smile.Tools.TownDocumentNavigation

Option Explicit

Import Smile.Tools.TownSurfaceLayers As Layers
Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.PrecisionMath3D As M
Import Smile.Simple3D.SurfaceGrid3D As Grid
Import Smile.Tools.TownDocument As Document
Import Smile.Tools.TownCatalogData As Catalog
Import Smile.Tools.TownCatalogFeatures As Features
Import Smile.Tools.TownGeometry As Geometry
Import Smile.Simple3D.CameraClearance3D As Clearance

Private Dim Surface As Grid.State
Private Dim Items[1024] As Document.Item
Private Dim Shapes[35] As Catalog.Template
Private Dim ItemCount As Number
Private Dim Enabled As Boolean
Private Dim CameraDirty As Boolean
Private Dim CameraAnchor As P.Vector3
Private Dim CameraWorld As Clearance.World
Private Dim LowX[1024] As Double
Private Dim LowZ[1024] As Double
Private Dim HighX[1024] As Double
Private Dim HighZ[1024] As Double

Public Sub Rebuild(ByRef Town As Document.State)

    Dim Index As Number
    Dim Corner As Number
    Dim LocalPoint As P.Vector3
    Dim WorldPoint As P.Vector3
    Dim Shape As Catalog.Template

    Surface = Town.Surface
    ItemCount = Town.ItemCount

    For Index = 0 To ItemCount - 1

        Items[Index] = Town.Items[Index]
        Shape = Catalog.TemplateAt(Items[Index].Template)
        LowX[Index] = 1.0E+20
        LowZ[Index] = 1.0E+20
        HighX[Index] = -1.0E+20
        HighZ[Index] = -1.0E+20

        For Corner = 0 To 3

            LocalPoint = P.Vector(Shape.Low.X - 20.0, 0.0, Shape.Low.Z - 20.0)

            If Corner Mod 2 = 1 Then
                LocalPoint.X = Shape.High.X + 20.0
            End If

            If Corner >= 2 Then
                LocalPoint.Z = Shape.High.Z + 20.0
            End If

            WorldPoint = Geometry.ToWorld(Items[Index], LocalPoint)
            LowX[Index] = Min(LowX[Index], WorldPoint.X)
            LowZ[Index] = Min(LowZ[Index], WorldPoint.Z)
            HighX[Index] = Max(HighX[Index], WorldPoint.X)
            HighZ[Index] = Max(HighZ[Index], WorldPoint.Z)
        End For
    End For

    For Index = 0 To Catalog.TEMPLATE_COUNT - 1
        Shapes[Index] = Catalog.TemplateAt(Index)
    End For

    Enabled = True
    CameraDirty = True

End Sub

Private Function NearWorld(Index As Number, X As Double, Z As Double) As Boolean

    Dim Result As Boolean

    Result = (Items[Index].Active And X >= LowX[Index] And X <= HighX[Index] And
        Z >= LowZ[Index] And Z <= HighZ[Index])

    Return Result

End Function

Public Sub Disable()

    Enabled = False

End Sub

Public Function Active() As Boolean

    Return Enabled

End Function

''' Closest point inside a traversable road cell, using the committed map surface.
Public Function NearestRoad(Point As P.Vector3, ByRef Result As P.Vector3) As Boolean

    Dim X As Number
    Dim Z As Number
    Dim Candidate As P.Vector3
    Dim Distance As Double
    Dim Best As Double
    Dim MarginX As Double
    Dim MarginZ As Double
    Dim Found As Boolean

    If Not Enabled Then
        Return False
    End If

    X = Grid.CellX(Surface, Point.X)
    Z = Grid.CellZ(Surface, Point.Z)

    If ((Grid.ReadCell(Surface, X, Z) = Grid.SURFACE_ROAD Or
        Grid.ReadCell(Surface, X, Z) = Grid.SURFACE_BRIDGE) And
        CanStand(Point.X, Point.Z)) Then

        Result = Point
        Result.Y = GroundHeight(Point.X, Point.Z)
        Return True

    End If

    Best = 1.0E+20

    For Z = 0 To Surface.Rows - 1

        For X = 0 To Surface.Columns - 1

            If (Grid.ReadCell(Surface, X, Z) = Grid.SURFACE_ROAD Or
                Grid.ReadCell(Surface, X, Z) = Grid.SURFACE_BRIDGE) Then

                MarginX = Min(12.0, (Surface.XEdges[X + 1] - Surface.XEdges[X]) * 0.25)
                MarginZ = Min(12.0, (Surface.ZEdges[Z + 1] - Surface.ZEdges[Z]) * 0.25)
                Candidate.X = Clamp(Point.X, Surface.XEdges[X] + MarginX, Surface.XEdges[X + 1] - MarginX)
                Candidate.Z = Clamp(Point.Z, Surface.ZEdges[Z] + MarginZ, Surface.ZEdges[Z + 1] - MarginZ)
                Distance = ((Candidate.X - Point.X) * (Candidate.X - Point.X) +
                    (Candidate.Z - Point.Z) * (Candidate.Z - Point.Z))

                If Distance < Best And CanStand(Candidate.X, Candidate.Z) Then

                    Candidate.Y = GroundHeight(Candidate.X, Candidate.Z)
                    Result = Candidate
                    Best = Distance
                    Found = True

                End If

            End If

        End For
    End For

    Return Found

End Function

Public Sub SurfaceBounds(ByRef Low As P.Vector3, ByRef High As P.Vector3)

    Low = P.Vector(-4900.0, Layers.ROAD_Y, -3550.0)
    High = P.Vector(2750.0, Layers.ROAD_Y, 3550.0)

    If Enabled Then
        Low = P.Vector(Surface.OriginX, Layers.ROAD_Y, Surface.OriginZ)
        High = P.Vector(Surface.XEdges[Surface.Columns], Layers.ROAD_Y, Surface.ZEdges[Surface.Rows])
    End If

End Sub

Private Function InBox(Box As Features.Box, Point As P.Vector3, Margin As Double) As Boolean

    Dim Result As Boolean

    Result = (Point.X >= Box.X0 - Margin And Point.X <= Box.X1 + Margin And
        Point.Z >= Box.Z0 - Margin And Point.Z <= Box.Z1 + Margin)

    Return Result

End Function

Private Function NearItem(Index As Number, Point As P.Vector3) As Boolean

    Dim Shape As Catalog.Template
    Dim Result As Boolean

    Shape = Shapes[Items[Index].Template]
    Result = (Point.X >= Shape.Low.X - 20.0 And Point.X <= Shape.High.X + 20.0 And
        Point.Z >= Shape.Low.Z - 20.0 And Point.Z <= Shape.High.Z + 20.0)

    Return Result

End Function

Private Function Approach(Item As Document.Item, Point As P.Vector3, Optional HeightOnly As Boolean = False) As Double

    Dim Index As Number
    Dim Door As Features.Door
    Dim Relative As P.Vector3
    Dim Height As Double
    Dim Shape As Catalog.Template

    Height = -10000.0
    Shape = Shapes[Item.Template]

    For Index = 0 To Shape.DoorCount - 1

        Door = Features.DoorAt(Item.Template, Index)
        Relative = M.Rotate(M.Subtract(Point, Door.Position), P.Vector(0.0, -Door.Yaw, 0.0))

        If (Abs(Relative.X) < Max(0.1, Door.Width / 2.0 - 3000.0 / Item.Scale.X) And
            Relative.Z >= -18000.0 / Item.Scale.Z And
            Relative.Z <= 4000.0 / Item.Scale.Z) Then

            If Not HeightOnly Or Relative.Z >= -1000.0 / Item.Scale.Z Then
                Height = Max(Height, Door.Position.Y)
            End If

        End If

    End For

    Return Height

End Function

Public Function CanStand(X As Double, Z As Double) As Boolean

    Dim Index As Number
    Dim Part As Number
    Dim Cell As Number
    Dim Point As P.Vector3
    Dim Shape As Catalog.Template
    Dim Blocked As Boolean
    Dim Supported As Boolean
    Dim Opening As Boolean

    Cell = Grid.ReadCell(Surface, Grid.CellX(Surface, X), Grid.CellZ(Surface, Z))

    Supported = Cell <> Grid.SURFACE_EMPTY And Cell <> Grid.SURFACE_WATER

    For Index = 0 To ItemCount - 1

        If NearWorld(Index, X, Z) Then

            Point = Geometry.ToLocal(Items[Index], P.Vector(X, Items[Index].Position.Y, Z))

            If NearItem(Index, Point) Then

                Shape = Shapes[Items[Index].Template]

                Opening = Approach(Items[Index], Point) > -9000.0

                For Part = 0 To Shape.FloorCount - 1
                    Supported = Supported Or InBox(Features.FloorAt(Items[Index].Template, Part), Point, 0.015)
                End For

                For Part = 0 To Shape.StepCount - 1

                    If InBox(Features.StepAt(Items[Index].Template, Part), Point, 0.015) Then
                        Supported = True
                        Opening = True
                    End If

                End For

                For Part = 0 To Shape.SolidCount - 1

                    If (Not Opening And InBox(Features.SolidAt(Items[Index].Template, Part), Point,
                        3000.0 / Max(Items[Index].Scale.X, Items[Index].Scale.Z))) Then
                        Blocked = True
                    End If

                End For

            End If

        End If

    End For

    Blocked = Supported And Not Blocked

    Return Blocked

End Function

Public Function GroundHeight(X As Double, Z As Double) As Double

    Dim Index As Number
    Dim Part As Number
    Dim Cell As Number
    Dim Point As P.Vector3
    Dim Shape As Catalog.Template
    Dim Box As Features.Box
    Dim Height As Double
    Dim LocalHeight As Double

    Cell = Grid.ReadCell(Surface, Grid.CellX(Surface, X), Grid.CellZ(Surface, Z))
    Height = Layers.GROUND_WALK_Y

    If Cell = Grid.SURFACE_ROAD Or Cell = Grid.SURFACE_BRIDGE Then
        Height = Layers.ROAD_Y
    End If

    For Index = 0 To ItemCount - 1

        If NearWorld(Index, X, Z) Then

            Point = Geometry.ToLocal(Items[Index], P.Vector(X, Items[Index].Position.Y, Z))

            If NearItem(Index, Point) Then

                Shape = Shapes[Items[Index].Template]
                LocalHeight = Approach(Items[Index], Point, True)

                For Part = 0 To Shape.StepCount - 1

                    Box = Features.StepAt(Items[Index].Template, Part)

                    If InBox(Box, Point, 0.015) Then
                        LocalHeight = Max(LocalHeight, Box.Height)
                    End If

                End For

                For Part = 0 To Shape.FloorCount - 1

                    Box = Features.FloorAt(Items[Index].Template, Part)

                    If InBox(Box, Point, 0.015) Then
                        LocalHeight = Max(LocalHeight, Box.Height)
                    End If

                End For

                If LocalHeight > -9000.0 Then
                    Height = Max(Height, Items[Index].Position.Y + LocalHeight * Items[Index].Scale.Y / 1000.0)
                End If

            End If

        End If

    End For

    Return Height

End Function

Public Function InsideStructure(Position As P.Vector3) As Boolean

    Dim Index As Number
    Dim Point As P.Vector3

    For Index = 0 To ItemCount - 1

        If Items[Index].Active And Items[Index].Category = Document.CATEGORY_BUILDINGS Then

            Point = Geometry.ToLocal(Items[Index], Position)

            If NearItem(Index, Point) Then
                Return True
            End If

        End If

    End For

    Return False

End Function

''' Refresh nearby template volumes after edits or meaningful camera movement.
Public Sub PopulateCamera(ByRef World As Clearance.World, Focus As P.Vector3)

    Dim Index As Number
    Dim Part As Number
    Dim Corner As Number
    Dim LocalPoint As P.Vector3
    Dim Point As P.Vector3
    Dim Box As Clearance.Bounds
    Dim Bounds As Clearance.Bounds
    Dim Shape As Catalog.Template
    Dim Margin As Double

    If CameraDirty Or M.Distance(Focus, CameraAnchor) > 80.0 Then

        CameraWorld.BoxCount = 0
        CameraAnchor = Focus
        CameraDirty = False

        For Index = 0 To ItemCount - 1

            If Items[Index].Active Then

                Shape = Shapes[Items[Index].Template]
                LocalPoint = Geometry.ToLocal(Items[Index], Focus)
                Margin = 1000000.0 / Min(Items[Index].Scale.X, Items[Index].Scale.Z)

                If (LocalPoint.X >= Shape.Low.X - Margin And
                    LocalPoint.X <= Shape.High.X + Margin And
                    LocalPoint.Z >= Shape.Low.Z - Margin And
                    LocalPoint.Z <= Shape.High.Z + Margin) Then

                    For Part = 0 To Shape.CameraCount - 1

                        Box = Features.CameraAt(Items[Index].Template, Part)
                        Bounds.Low = P.Vector(1000000000.0, 1000000000.0, 1000000000.0)
                        Bounds.High = P.Vector(-1000000000.0, -1000000000.0, -1000000000.0)

                        For Corner = 0 To 7

                            Point = Box.Low

                            If Corner Mod 2 = 1 Then
                                Point.X = Box.High.X
                            End If

                            If (Corner / 2) Mod 2 = 1 Then
                                Point.Y = Box.High.Y
                            End If

                            If Corner >= 4 Then
                                Point.Z = Box.High.Z
                            End If

                            Point = Geometry.ToWorld(Items[Index], Point)
                            Bounds.Low = P.Vector(Min(Bounds.Low.X, Point.X), Min(Bounds.Low.Y, Point.Y), Min(Bounds.Low.Z, Point.Z))
                            Bounds.High = P.Vector(Max(Bounds.High.X, Point.X), Max(Bounds.High.Y, Point.Y), Max(Bounds.High.Z, Point.Z))
                        End For

                        If CameraWorld.BoxCount < 512 Then
                            CameraWorld.Boxes[CameraWorld.BoxCount] = Bounds
                            CameraWorld.BoxCount = CameraWorld.BoxCount + 1
                        End If

                    End For

                End If

            End If

        End For

    End If

    World = CameraWorld

End Sub

End Module
