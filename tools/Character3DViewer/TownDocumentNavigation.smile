''' Committed spatial snapshot for party movement through an edited town.
Module Smile.Tools.TownDocumentNavigation

Option Explicit

Import Smile.Tools.TownSurfaceLayers As Layers
Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.PrecisionMath3D As M
Import Smile.Simple3D.SurfaceGrid3D As Grid
Import Smile.Tools.TownDocument As Document
Import Smile.Tools.TownCollisionWorld As Collision

Import Smile.Tools.TownCatalogData As Catalog
Import Smile.Tools.TownCatalogFeatures As Features
Import Smile.Tools.TownGeometry As Geometry
Import Smile.Simple3D.CameraClearance3D As Clearance
Import Smile.Simple3D.TerrainSurface3D As Terrain
Import Smile.Simple3D.TerrainRay3D As TerrainRay
Import Smile.Tools.TownNearestRoadSearch As RoadSearch

Private Dim Snapshot As Collision.State
Private Dim Enabled As Boolean
Private Dim SnapshotVersion As Number
Private Dim CameraDirty As Boolean
Private Dim CameraAnchor As P.Vector3
Private Dim CameraWorld As Clearance.World

Public Sub Rebuild(ByRef Town As Document.State)

    Call Collision.Build(Snapshot, Town)

    SnapshotVersion = SnapshotVersion + 1
    Enabled = True
    CameraDirty = True

End Sub

Public Sub Disable()

    Enabled = False
    SnapshotVersion = SnapshotVersion + 1

End Sub

''' A new committed collision snapshot invalidates derived road connections.
Public Function Version() As Number

    Return SnapshotVersion

End Function

Public Function Active() As Boolean

    Return Enabled

End Function

Public Function EnteredTemplate(Position As P.Vector3, Template As Number) As Number

    Dim Result As Number

    Result = -1

    If Enabled Then
        Result = Collision.EnteredTemplate(Snapshot, Position, Template)
    End If

    Return Result

End Function

Public Function Elevated() As Boolean

    Dim Result As Boolean

    Result = Enabled And Snapshot.Surface.Heights.Nonzero > 0
    Return Result

End Function

Public Function ClearTerrainSight(Camera As P.Camera3D) As P.Camera3D

    Dim Point As P.Vector3
    Dim Delta As P.Vector3
    Dim Length As Double
    Dim Distance As Double

    If Elevated() Then

        Camera.Position.Y = Max(Camera.Position.Y,
            GroundHeight(Camera.Position.X, Camera.Position.Z) + 18.0)
        Delta = M.Subtract(Camera.Position, Camera.Target)
        Length = M.Length(Delta)

        If TerrainRay.Pick(Snapshot.Surface, Camera.Target, Delta, Layers.GROUND_WALK_Y, Length, Point) Then
            Distance = Max(1.0, M.Distance(Camera.Target, Point) * 0.98)
            Camera.Position = M.Add(Camera.Target, M.Scale(Delta, Distance / Max(1.0, Length)))
        End If

        Camera.Position.Y = Max(Camera.Position.Y,
            GroundHeight(Camera.Position.X, Camera.Position.Z) + 18.0)

    End If

    Return Camera

End Function

Public Sub StepNearestRoad(ByRef Search As RoadSearch.State, Point As P.Vector3)

    Dim Kind As Number

    If Not Search.Started Or Search.Version <> SnapshotVersion Then

        Call RoadSearch.Begin(Search, Point, SnapshotVersion)

        Kind = Grid.ReadPoint(Snapshot.Surface, Point.X, Point.Z)

        If Enabled And (Kind = Grid.SURFACE_ROAD Or Kind = Grid.SURFACE_BRIDGE) Then

            If CanStand(Point.X, Point.Z) Then

                Search.Result = Point
                Search.Found = True
                Search.Ready = True

            End If

        End If

    End If

    If Not Enabled Then
        Search.Ready = True
        Search.Found = False
    End If

    If Not Search.Ready Then
        Call RoadSearch.Step(Search, Snapshot)
    End If

    If Search.Ready And Search.Found Then
        Search.Result.Y = GroundHeight(Search.Result.X, Search.Result.Z)
    End If

End Sub

''' Synchronous compatibility query; resident loading uses StepNearestRoad instead.
Public Function NearestRoad(Point As P.Vector3, ByRef Result As P.Vector3) As Boolean

    Dim Search As RoadSearch.State
    Dim Found As Boolean

    Do

        Call StepNearestRoad(Search, Point)

    Loop Until Search.Ready

    Result = Search.Result
    Found = Search.Found

    Return Found

End Function

''' Read the committed road mask without borrowing the party's route planner.
Public Function IsRoad(Point As P.Vector3) As Boolean

    Dim Cell As Number
    Dim Result As Boolean

    Cell = Grid.ReadPoint(Snapshot.Surface, Point.X, Point.Z)
    Result = Enabled And (Cell = Grid.SURFACE_ROAD Or Cell = Grid.SURFACE_BRIDGE)
    Result = Result And CanStand(Point.X, Point.Z)

    Return Result

End Function

Public Function GroundRay(Origin As P.Vector3, Ray As P.Vector3,
    Distance As Double, ByRef Point As P.Vector3) As Boolean

    Dim Result As Boolean
    Dim Depth As Double

    If Not Enabled And Ray.Y < -0.000001 Then

        Depth = (Layers.ROAD_Y - Origin.Y) / Ray.Y
        Point = M.Add(Origin, M.Scale(Ray, Depth))
        Result = (Depth >= 0.0 And Depth <= Distance And
            Point.X >= -4900.0 And Point.X <= 2750.0 And
            Point.Z >= -3550.0 And Point.Z <= 3550.0)

        Return Result

    End If

    Result = TerrainRay.Pick(Snapshot.Surface, Origin, Ray, Layers.ROAD_Y, Distance, Point)

    Return Result

End Function

Public Sub SurfaceBounds(ByRef Low As P.Vector3, ByRef High As P.Vector3)

    Low = P.Vector(-4900.0, Layers.ROAD_Y, -3550.0)
    High = P.Vector(2750.0, Layers.ROAD_Y, 3550.0)

    If Enabled Then

        Low = P.Vector(Snapshot.Surface.OriginX, Layers.ROAD_Y, Snapshot.Surface.OriginZ)
        High = P.Vector(Snapshot.Surface.XEdges[Snapshot.Surface.Columns], Layers.ROAD_Y, Snapshot.Surface.ZEdges[Snapshot.Surface.Rows])
        Low.Y = Layers.GROUND_Y + Snapshot.MinimumHeight
        High.Y = Layers.ROAD_Y + Snapshot.MaximumHeight

    End If

End Sub

Public Function CanStand(X As Double, Z As Double) As Boolean

    Dim Result As Boolean

    Result = Collision.CanStand(Snapshot, X, Z)

    Return Result

End Function

Public Function GroundHeight(X As Double, Z As Double) As Double

    Dim Result As Double

    Result = Collision.GroundHeight(Snapshot, X, Z)
    Return Result

End Function

Public Function CanTraverse(First As P.Vector3, Last As P.Vector3) As Boolean

    Dim Ok As Boolean

    Ok = Not Enabled Or Collision.CanTraverse(Snapshot, First, Last)
    Return Ok

End Function

Public Function InsideStructure(Position As P.Vector3) As Boolean

    Dim Index As Number
    Dim Point As P.Vector3

    For Index = 0 To Snapshot.ItemCount - 1

        If (Snapshot.Items[Index].Active And
            Snapshot.Items[Index].Category = Document.CATEGORY_BUILDINGS) Then

            Point = Geometry.ToLocal(Snapshot.Items[Index], Position)

            If Collision.NearItem(Snapshot, Index, Point) Then
                Return True
            End If

        End If

    End For

    Return False

End Function

''' Refresh nearby template volumes after edits or meaningful camera movement.
Public Sub PopulateCamera(ByRef World As Clearance.World, Focus As P.Vector3)

    Dim Index As Number
    Dim Part As Number
    Dim Corner As Number
    Dim LocalPoint As P.Vector3
    Dim Point As P.Vector3
    Dim Box As Clearance.Bounds
    Dim Bounds As Clearance.Bounds
    Dim Shape As Catalog.Template
    Dim Margin As Double

    If CameraDirty Or M.Distance(Focus, CameraAnchor) > 80.0 Then

        CameraWorld.BoxCount = 0
        CameraAnchor = Focus
        CameraDirty = False

        For Index = 0 To Snapshot.ItemCount - 1

            If Snapshot.Items[Index].Active Then

                Shape = Snapshot.Shapes[Snapshot.Items[Index].Template]
                LocalPoint = Geometry.ToLocal(Snapshot.Items[Index], Focus)
                Margin = 1000000.0 / Min(Snapshot.Items[Index].Scale.X, Snapshot.Items[Index].Scale.Z)

                If (LocalPoint.X >= Shape.Low.X - Margin And
                    LocalPoint.X <= Shape.High.X + Margin And
                    LocalPoint.Z >= Shape.Low.Z - Margin And
                    LocalPoint.Z <= Shape.High.Z + Margin) Then

                    For Part = 0 To Shape.CameraCount - 1

                        Box = Features.CameraAt(Snapshot.Items[Index].Template, Part)
                        Bounds.Low = P.Vector(1000000000.0, 1000000000.0, 1000000000.0)
                        Bounds.High = P.Vector(-1000000000.0, -1000000000.0, -1000000000.0)

                        For Corner = 0 To 7

                            Point = Box.Low

                            If Corner Mod 2 = 1 Then
                                Point.X = Box.High.X
                            End If

                            If (Corner / 2) Mod 2 = 1 Then
                                Point.Y = Box.High.Y
                            End If

                            If Corner >= 4 Then
                                Point.Z = Box.High.Z
                            End If

                            Point = Geometry.ToWorld(Snapshot.Items[Index], Point)
                            Bounds.Low = P.Vector(Min(Bounds.Low.X, Point.X), Min(Bounds.Low.Y, Point.Y), Min(Bounds.Low.Z, Point.Z))
                            Bounds.High = P.Vector(Max(Bounds.High.X, Point.X), Max(Bounds.High.Y, Point.Y), Max(Bounds.High.Z, Point.Z))
                        End For

                        If CameraWorld.BoxCount < 512 Then
                            CameraWorld.Boxes[CameraWorld.BoxCount] = Bounds
                            CameraWorld.BoxCount = CameraWorld.BoxCount + 1
                        End If

                    End For

                End If

            End If

        End For

    End If

    World = CameraWorld

End Sub

End Module
