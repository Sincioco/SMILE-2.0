<SmileProject Version="1.0">
  <PropertyGroup>
    <ProjectKind>Game</ProjectKind>
    <StartupFile>Program.smile</StartupFile>
    <OutputName>Character3DViewer</OutputName>
    <ApplicationId>smile.tools.character3d-viewer</ApplicationId>
    <WebLoadingAuthor>Louiery R. Sincioco (Sin)</WebLoadingAuthor>
    <WebLoadingLogo>..\..\assets\branding\smile-2.0-logo-web.png</WebLoadingLogo>
    <RememberWindowPlacement>true</RememberWindowPlacement>
    <ResponsiveWindow>true</ResponsiveWindow>
    <GraphicsBackend>DirectX</GraphicsBackend>
    <VSync>true</VSync>
  </PropertyGroup>
  <ItemGroup>
    <SmileSource Include="Program.smile" StartupOnly="true" />
    <SmileSource Include="Profiles.smile" />
    <SmileSource Include="OrinStorm.smile" />
    <SmileSource Include="ArinShieldRim.smile" />
    <SmileSource Include="BattleAudio.smile" />
    <SmileSource Include="BattleCamera.smile" />
    <SmileSource Include="DragonPresence.smile" />
    <SmileSource Include="CalibrationJson.smile" />
    <SmileSource Include="ViewerTiming.smile" />
    <SmileSource Include="ViewerSession.smile" />
    <SmileSource Include="ViewerPlayback.smile" />
    <SmileSource Include="ViewerActors.smile" />
    <SmileSource Include="ViewerCamera.smile" />
    <SmileSource Include="ViewerCalibration.smile" />
    <SmileSource Include="ViewerCalibrationEditing.smile" />
    <SmileSource Include="ViewerInput.smile" />
    <SmileSource Include="ViewerTimelineEditing.smile" />
    <SmileSource Include="ViewerUi.smile" />
    <SmileSource Include="ViewerGizmo.smile" />
    <SmileSource Include="ViewerParty.smile" />
    <SmileSource Include="ViewerEffects.smile" />
    <SmileSource Include="ViewerDragon.smile" />
    <SmileSource Include="ViewerRendering.smile" />
    <Model3DAsset Include="BuildAssets\ArinV57\arin-v5.7-idle-equipment-checkpoint.glb"
                  Descriptor="BuildAssets\ArinV57\ArinV57.sm3d.json"
                  LogicalPath="Assets\Generation2\ArinV57\ArinV57.sm3d"
                  TextureOutputDirectory="Assets\Generation2\ArinV57\Textures"
                  Profile="Character"
                  Identity="sin-star-i.character-1.paladin"
                  ProductionState="Prototype" />
    <Model3DAsset Include="BuildAssets\ArinV56\arin-integrated-candidate-v5.6.glb"
                  Descriptor="BuildAssets\ArinV56\ArinV56.sm3d.json"
                  LogicalPath="Assets\Generation2\ArinV56\ArinV56.sm3d"
                  TextureOutputDirectory="Assets\Generation2\ArinV56\Textures"
                  Profile="Character"
                  Identity="sin-star-i.character-1.paladin"
                  ProductionState="Prototype" />
    <Model3DAsset Include="BuildAssets\OrinV13\orin-v1.3-animation-checkpoint.glb"
                  Descriptor="BuildAssets\OrinV13\OrinV13.sm3d.json"
                  LogicalPath="Assets\Generation2\OrinV13\OrinV13.sm3d"
                  TextureOutputDirectory="Assets\Generation2\OrinV13\Textures"
                  Profile="Character"
                  Identity="sin-star-i.character-2.tank"
                  ProductionState="Prototype" />
    <Model3DAsset Include="BuildAssets\ArinPrototype\sin-star-i-character-1-paladin-tripo-v01.original.glb"
                  Descriptor="BuildAssets\ArinPrototype\ArinPrototype.sm3d.json"
                  LogicalPath="Assets\Generation2\Arin\ArinPrototype.sm3d"
                  TextureOutputDirectory="Assets\Generation2\Arin\Textures"
                  Profile="Character"
                  Identity="sin-star-i.character-1.paladin"
                  ProductionState="Prototype" />
    <Model3DAsset Include="BuildAssets\RedDragon\red-dragon-v1.1-animated.glb"
                  Descriptor="BuildAssets\RedDragon\RedDragonV11.sm3d.json"
                  LogicalPath="Assets\Generation2\RedDragon\RedDragon.sm3d"
                  TextureOutputDirectory="Assets\Generation2\RedDragon\Textures"
                  Profile="Character"
                  Identity="sin-star-i.boss.red-dragon"
                  ProductionState="Prototype" />
    <Asset Include="TechnicalAssets\Generation2\AnimationArticulated.sm3d" />
    <Asset Include="TechnicalAssets\Generation2\VfxAtlas.png" />
    <Asset Include="Assets\Backgrounds\SinStarLandscape.png" />
    <Asset Include="Assets\Backgrounds\SinStarTitleWithLogo.png" />
    <Asset Include="Assets\Calibration\arin-v5.7.smkf" />
    <Asset Include="Assets\Calibration\orin-v1.3.smkf" />
    <Asset Include="Assets\Calibration\arin-v5.7.metadata.json" />
    <Asset Include="Assets\Calibration\orin-v1.3.metadata.json" />
    <Asset Include="Assets\Fire\fire-shape-atlas.png" />
    <Asset Include="Assets\Fire\smoke-shape-atlas.png" />
    <Asset Include="Assets\Fire\ember-shape.png" />
    <Asset Include="Assets\Lightning\lightning-ribbon.png" />
    <Asset Include="Assets\Lightning\lightning-spark.png" />
    <Asset Include="Assets\Lightning\thunder.wav" />
    <Asset Include="Assets\Audio\arin-flame-slash.wav" />
    <Asset Include="Assets\Audio\arin-flame-crosscut.wav" />
    <Asset Include="Assets\Audio\dragon-fire-breath.wav" />
    <Asset Include="Assets\Audio\dragon-claw-strike.wav" />
    <Asset Include="Assets\Audio\dragon-fireball-impact.wav" />
    <SmileProjectReference Include="..\..\libraries\Smile.Simple3D\Smile.Simple3D.smilelibproj" />
    <SmileProjectReference Include="..\..\libraries\Smile.UI\Smile.UI.smilelibproj" />
  </ItemGroup>
</SmileProject>
