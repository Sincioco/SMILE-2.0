    Z0 As Double
    X1 As Double
    Z1 As Double
    Height As Double
End Type

Public Type Door
    Position As P.Vector3
    Width As Double
    Height As Double
    Yaw As Double
End Type

Public Type WaterDisk
    Position As P.Vector3
    RadiusX As Double
    RadiusZ As Double
End Type

