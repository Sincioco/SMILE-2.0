''' Incremental surface generation. Keep the live terrain until its replacement is complete.
Module Smile.Tools.TownSurfaceRenderer

Option Explicit

Import Smile.Tools.TownSurfaceLayers As Layers
Import Smile.Tools.TownTerrainStyles As Styles
Import Smile.Tools.TownDecks As Decks
Import Smile.Tools.TownDocument As Document
Import Smile.Simple3D.Core As Core
Import Smile.Simple3D.Graphics3D As G
Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.PrecisionMath3D As M
Import Smile.Simple3D.SurfaceGrid3D As Grid
Import Smile.Simple3D.TerrainSurface3D As Terrain
Import Smile.Simple3D.SurfaceContours3D As Contours
Import Smile.Simple3D.SurfacePaint3D As Paint
Import Smile.Tools.TownTerrainCache As Cache
Import Smile.Tools.TownTerrainBuilder As Builder
Import Smile.Tools.TownDerivedCache As Derived
Import Smile.Tools.TownTerrainLighting As Lighting

Private Dim CacheTown As Document.State

Public Type State
    Recipe As Builder.State
    Lighting As Lighting.State
    Objects[64] As Core.Object3D
    NextObjects[64] As Core.Object3D
    Water[4] As Core.RibbonBatch3D
    NextWater[4] As Core.RibbonBatch3D
    PendingWater[8192] As Cache.Patch
    WaterPatchCount As Number
    Materials[15] As Core.Material3D
    FlowMaterials[3] As Core.Material3D
    NextFlowMaterials[3] As Core.Material3D
    FlowGroup As Number
    PendingStyle As Number
    StyleGroup As Number
    Textures[5] As Core.Texture3D
    LiveRevision As Number
    PendingRevision As Number
    Stage As Number
    Kind As Number
    Cursor As Number
    ObjectCount As Number
    WaterCount As Number
    NextCount As Number
    NextWaterCount As Number
    Failed As Boolean
    Time As Number
    CacheKey As Text
    CacheRead As Boolean
    CacheOk As Boolean
    CacheBatch As Number
    CacheBatches As Number
End Type

Public Function Create(ByRef Value As State) As Boolean

    Dim Index As Number
    Dim EmptyTexture As Core.Texture3D
    Dim TileTexture As Core.Texture3D
    Dim Ok As Boolean

    ' Both ground surfaces share the document sun, ambient and shadow response.
    Value.Textures[0] = G.LoadTexture3DEx("Assets/Neris/Neris-Grass-Color.png",
        G.TEXTURE_USAGE_COLOR, G.TEXTURE_FILTER_ANISOTROPIC, G.TEXTURE_WRAP_REPEAT, 16)
    Value.Textures[1] = G.LoadTexture3DEx("Assets/Neris/Neris-Paving.png",
        G.TEXTURE_USAGE_COLOR, G.TEXTURE_FILTER_ANISOTROPIC, G.TEXTURE_WRAP_REPEAT, 16)
    Value.Textures[2] = G.LoadTexture3DEx("Assets/Neris/Greyglass-Strata.png",
        G.TEXTURE_USAGE_COLOR, G.TEXTURE_FILTER_ANISOTROPIC, G.TEXTURE_WRAP_REPEAT, 16)
    Value.Textures[3] = G.LoadTexture3DEx("Assets/Neris/Green-Slope-Tile.png",
        G.TEXTURE_USAGE_COLOR, G.TEXTURE_FILTER_ANISOTROPIC, G.TEXTURE_WRAP_REPEAT, 16)
    Value.Textures[4] = G.LoadTexture3DEx("Assets/Neris/Snow-Slope-Tile.png",
        G.TEXTURE_USAGE_COLOR, G.TEXTURE_FILTER_ANISOTROPIC, G.TEXTURE_WRAP_REPEAT, 16)
    Ok = True

    For Index = 0 To 4
        Ok = Value.Textures[Index].Handle <> 0 And Ok
    End For
    Value.Materials[1] = G.CreatePbrMaterial3D(Value.Textures[0], EmptyTexture,
        EmptyTexture, EmptyTexture, G.MATERIAL_ALPHA_OPAQUE, True)
    Value.Materials[3] = G.CreatePbrMaterial3D(Value.Textures[1], EmptyTexture,
        EmptyTexture, EmptyTexture, G.MATERIAL_ALPHA_OPAQUE, True)
    Ok = G.SetPbrMaterialFactors3D(Value.Materials[3], 255, 255, 255, 100, 0, 38, 0, 100) And Ok
    Ok = G.SetPbrMaterialFactors3D(Value.Materials[1], 255, 255, 255, 100, 0, 100, 0, 100) And Ok
    Value.Materials[4] = G.CreateMaterial3D(EmptyTexture, 0, 220, 214, 188, 100, False, 0, 0)
    Value.Materials[5] = G.CreateMaterial3D(EmptyTexture, 0, 175, 136, 66, 100, False, 0, 0)
    Value.Materials[6] = G.CreateMaterial3D(EmptyTexture, 0, 35, 78, 139, 100, False, 0, 0)
    Value.Materials[2] = G.CreateEffectMaterial3D(EmptyTexture, G.MATERIAL_ALPHA_BLEND, 100)
    Ok = G.SetEffectMaterial3D(Value.Materials[2], G.MATERIAL_ALPHA_BLEND, 30, 100, 240, 100, 100) And Ok
    Ok = G.SetEffectMaterialWater3D(Value.Materials[2], True, 45, 0, 0, 2) And Ok
    Ok = (Value.Materials[1].Handle <> 0 And Value.Materials[3].Handle <> 0 And
        Value.Materials[4].Handle <> 0 And Ok)

    For Index = 1 To 4

        TileTexture = EmptyTexture

        If Index = 1 Then
            TileTexture = Value.Textures[3]
        Else If Index = 2 Then
            TileTexture = Value.Textures[2]
        Else If Index = 4 Then
            TileTexture = Value.Textures[4]
        End If

        Value.Materials[Styles.Slot(1, Index)] = Styles.Material(Index, False, TileTexture)
        Value.Materials[Styles.Slot(3, Index)] = Styles.Material(Index, True, TileTexture)
        Ok = Ok And Value.Materials[Styles.Slot(1, Index)].Handle <> 0 And Value.Materials[Styles.Slot(3, Index)].Handle <> 0
    End For

    Value.LiveRevision = -1
    Value.Failed = Not Ok

    Return Ok

End Function

Public Sub BeginBuild(ByRef Value As State, ByRef Town As Document.State)

    Dim Index As Number
    Dim EmptyTexture As Core.Texture3D
    Dim Ok As Boolean

    For Index = 0 To Value.NextCount - 1
        Call G.DestroyObject3D(Value.NextObjects[Index])
    End For

    For Index = 0 To Value.NextWaterCount - 1
        Call G.DestroyRibbonBatch3D(Value.NextWater[Index])
    End For

    Call Builder.Begin(Value.Recipe, Town)
    Call Lighting.Reset(Value.Lighting)

    Ok = Not Value.Recipe.Failed

    If Value.Recipe.Flows.GroupCount > 0 Then
        Ok = G.SetEffectMaterial3D(Value.Materials[2], G.MATERIAL_ALPHA_BLEND, 30, 100, 140, 100, 100) And Ok
    Else
        Ok = G.SetEffectMaterial3D(Value.Materials[2], G.MATERIAL_ALPHA_BLEND, 30, 100, 240, 100, 100) And Ok
    End If

    For Index = 0 To 2

        Call G.DestroyMaterial3D(Value.NextFlowMaterials[Index])

        If Index < Value.Recipe.Flows.GroupCount Then

            Value.NextFlowMaterials[Index] = G.CreateEffectMaterial3D(EmptyTexture, G.MATERIAL_ALPHA_BLEND, 100)
            Ok = G.SetEffectMaterial3D(Value.NextFlowMaterials[Index], G.MATERIAL_ALPHA_BLEND, 30, 100, 140, 100, 100) And Ok
            Ok = G.SetEffectMaterialWater3D(Value.NextFlowMaterials[Index], True, 30, 0, 0, 12) And Ok
            Ok = G.SetEffectMaterialWaterFlow3D(Value.NextFlowMaterials[Index], True,
                ToNumber(Value.Recipe.Flows.Direction[Index].X * 1000.0),
                ToNumber(Value.Recipe.Flows.Direction[Index].Z * 1000.0), Value.Recipe.Flows.Speed[Index]) And Ok

        End If

    End For

    CacheTown = Town
    Value.CacheBatch = 0
    Value.CacheBatches = 0
    Value.CacheKey = Derived.ReadKey(Town, "Terrain9", False)
    Value.CacheRead = Text_Length(Value.CacheKey) > 0
    Value.CacheOk = True

    If Value.CacheRead Then
        Value.CacheBatches = Derived.ReadNumber(Value.CacheKey + ".Batches")
        Value.CacheRead = Value.CacheBatches > 0 And Value.CacheBatches <= 64
    End If

    If Not Value.CacheRead Then
        Value.CacheKey = Derived.WriteKey(Town.Name, "Terrain9")
    End If

    Value.WaterPatchCount = 0
    Value.PendingStyle = Town.TerrainStyle
    Value.Recipe.Buffer.PatchCount = 0
    Value.PendingRevision = Town.Surface.Revision
    Value.Recipe.Row = 0
    Value.StyleGroup = 0
    Value.Kind = 1
    Value.FlowGroup = 0
    Value.Cursor = 0
    Value.NextCount = 0
    Value.NextWaterCount = 0
    Value.Failed = Not Ok
    Value.Stage = 1

    If Value.CacheRead Then
        Call ReadCachedBatch(Value)
    End If

End Sub

Private Sub ReadCachedBatch(ByRef Value As State)

    Dim Index As Number

    If Cache.LoadBatch(Value.Recipe.Buffer, Value.CacheKey, Value.CacheBatch) Then

        Value.CacheBatch = Value.CacheBatch + 1
        Value.Recipe.Row = Value.Recipe.Surface.Rows
        Value.Stage = 2

    Else

        ' A missing/corrupt derived page never replaces the previous live terrain.

        For Index = 0 To Value.NextCount - 1
            Call G.DestroyObject3D(Value.NextObjects[Index])
        End For

        For Index = 0 To Value.NextWaterCount - 1
            Call G.DestroyRibbonBatch3D(Value.NextWater[Index])
        End For

        Value.NextCount = 0
        Value.NextWaterCount = 0
        Value.WaterPatchCount = 0
        Value.CacheRead = False
        Value.CacheOk = True
        Value.CacheBatch = 0
        Value.CacheKey = Derived.WriteKey(CacheTown.Name, "Terrain9")
        Value.Recipe.Row = 0
        Value.Recipe.Buffer.PatchCount = 0
        Value.Stage = 1

    End If

End Sub

Private Function Vertex(ByRef Value As State, Mesh As Number, Index As Number, X As Double,
    Y As Double, Z As Double, Kind As Number) As Boolean

    Dim Ok As Boolean
    Dim Style As Number
    Dim Uv As P.Vector3

    Style = Value.PendingStyle

    If Value.StyleGroup > 0 Then
        Style = Value.StyleGroup - 1
    End If

    Uv = Styles.Coordinates(Style, Kind, X, Y, Z, P.Vector(0.0, 1.0, 0.0))
    Ok = P.SetMeshVertex(Mesh, Index, P.Vector(X, Y, Z))
    Ok = G.SetMeshUv3D(Mesh, Index, ToNumber(Uv.X * 1000.0), ToNumber(Uv.Y * 1000.0)) And Ok
    Ok = G.SetMeshNormal3D(Mesh, Index, 0, 1000, 0) And Ok

    Return Ok

End Function

Private Function TerrainVertex(ByRef Value As State, Mesh As Number, Index As Number,
    X As Double, Y As Double, Z As Double, Kind As Number) As Boolean

    Dim Normal As P.Vector3
    Dim Uv As P.Vector3
    Dim Ok As Boolean
    Dim Style As Number

    Normal = Lighting.Sample(Value.Lighting, Value.Recipe.Surface, X, Z)
    Ok = Vertex(Value, Mesh, Index, X, Y, Z, Kind)
    Style = Value.PendingStyle

    If Value.StyleGroup > 0 Then
        Style = Value.StyleGroup - 1
    End If

    Uv = Styles.Coordinates(Style, Kind, X, Y, Z, Normal)
    Ok = G.SetMeshUv3D(Mesh, Index, ToNumber(Uv.X * 1000.0), ToNumber(Uv.Y * 1000.0)) And Ok

    Ok = G.SetMeshNormal3D(Mesh, Index, ToNumber(Normal.X * 1000.0),
        ToNumber(Normal.Y * 1000.0), ToNumber(Normal.Z * 1000.0)) And Ok

    Return Ok

End Function

Private Sub UploadNext(ByRef Value As State)

    Dim Index As Number
    Dim StopIndex As Number
    Dim Total As Number
    Dim WaterPoints As Number
    Dim PointStep As Number
    Dim Mesh As Number
    Dim Point As Number
    Dim Part As Cache.Patch
    Dim Height As Double
    Dim WaterHeight As Double
    Dim Ok As Boolean
    Dim NormalIndex As Number
    Dim FaceNormal As P.Vector3
    Dim Style As Number

    StopIndex = Value.Cursor

    Do

        If StopIndex >= Value.Recipe.Buffer.PatchCount Or Total = 2048 Then
            Exit Do
        End If

        If (Value.Recipe.Buffer.Patches[StopIndex].Kind = Value.Kind And
            (Value.Kind <> 2 Or Value.Recipe.Buffer.Patches[StopIndex].FlowGroup = Value.FlowGroup) And
            Value.Recipe.Buffer.Patches[StopIndex].Style = Value.StyleGroup) Then

            Total = Total + 1

            If Value.Recipe.Buffer.Patches[StopIndex].Plane = 5 Then
                WaterPoints = WaterPoints + 3
            Else
                WaterPoints = WaterPoints + 4
            End If

        End If

        StopIndex = StopIndex + 1

    Loop

    Ok = True
    ' Match the authored lawn (-0.01 m), below castle/HQ floors at 0.13-0.152 m.
    Height = Layers.GROUND_Y

    If Value.Kind = 3 Then
        Height = Layers.ROAD_Y
    End If

    If Total > 0 Then

        If Value.Kind = 2 Then

            If Value.NextWaterCount >= 4 Then
                Value.Failed = True
                Return
            End If

            If Value.FlowGroup = 0 Then
                Value.NextWater[Value.NextWaterCount] = G.CreateRibbonBatch3D(WaterPoints, Value.Materials[2])
            Else
                Value.NextWater[Value.NextWaterCount] = G.CreateRibbonBatch3D(WaterPoints, Value.NextFlowMaterials[Value.FlowGroup - 1])
            End If

            Ok = Value.NextWater[Value.NextWaterCount].Handle <> 0

        Else

            If Value.NextCount >= 64 Then
                Value.Failed = True
                Return
            End If

            Mesh = G.CreateMesh3D(Total * 4, Total * 6)
            Ok = Mesh <> 0

        End If

        For Index = Value.Cursor To StopIndex - 1

            Part = Value.Recipe.Buffer.Patches[Index]

            If (Part.Kind = Value.Kind And
                (Value.Kind <> 2 Or Part.FlowGroup = Value.FlowGroup) And
                Part.Style = Value.StyleGroup) Then

                If Value.Kind = 2 And Part.Plane = 5 Then

                    Ok = P.SetRibbonPoint(Value.NextWater[Value.NextWaterCount], Point,
                        P.Vector(Part.X0, Part.Y0, Part.Z0), P.Vector(Part.X0, Part.Y0, Part.Z0), 0.0) And Ok
                    Ok = P.SetRibbonPoint(Value.NextWater[Value.NextWaterCount], Point + 1,
                        P.Vector(Part.X0, Part.Y0, Part.Z0), P.Vector(Part.X1, Part.Y1, Part.Z1), 0.0) And Ok
                    Ok = P.SetRibbonPoint(Value.NextWater[Value.NextWaterCount], Point + 2,
                        P.Vector(Part.X2, Part.Y2, Part.Z2), P.Vector(Part.X2, Part.Y2, Part.Z2), 1.0) And Ok

                Else If Value.Kind = 2 Then

                    WaterHeight = Layers.WATER_Y

                    If Part.Y0 > 0.0 Then
                        WaterHeight = Part.Y0
                    End If

                    Ok = P.SetRibbonPoint(Value.NextWater[Value.NextWaterCount], Point,
                        P.Vector(Part.X0, WaterHeight, Part.Z0), P.Vector(Part.X0, WaterHeight, Part.Z0), 0.0) And Ok
                    Ok = P.SetRibbonPoint(Value.NextWater[Value.NextWaterCount], Point + 1,
                        P.Vector(Part.X0, WaterHeight, Part.Z0), P.Vector(Part.X1, WaterHeight, Part.Z0), 0.0) And Ok
                    Ok = P.SetRibbonPoint(Value.NextWater[Value.NextWaterCount], Point + 2,
                        P.Vector(Part.X0, WaterHeight, Part.Z1), P.Vector(Part.X1, WaterHeight, Part.Z1), 1.0) And Ok
                    Ok = P.SetRibbonPoint(Value.NextWater[Value.NextWaterCount], Point + 3,
                        P.Vector(Part.X1, WaterHeight, Part.Z1), P.Vector(Part.X1, WaterHeight, Part.Z1), 1.0) And Ok

                    Ok = G.SetRibbonPointColor3D(Value.NextWater[Value.NextWaterCount], Point, 255, 255, 255, 100) And Ok
                    Ok = G.SetRibbonPointColor3D(Value.NextWater[Value.NextWaterCount], Point + 1, 255, 255, 255, 100) And Ok
                    Ok = G.SetRibbonPointColor3D(Value.NextWater[Value.NextWaterCount], Point + 2, 255, 255, 255, 100) And Ok
                    Ok = G.SetRibbonPointColor3D(Value.NextWater[Value.NextWaterCount], Point + 3, 255, 255, 255, 100) And Ok

                Else If Part.Plane = 5 Then

                    Ok = TerrainVertex(Value, Mesh, Point, Part.X0, Part.Y0, Part.Z0, Value.Kind) And Ok
                    Ok = TerrainVertex(Value, Mesh, Point + 1, Part.X1, Part.Y1, Part.Z1, Value.Kind) And Ok
                    Ok = TerrainVertex(Value, Mesh, Point + 2, Part.X2, Part.Y2, Part.Z2, Value.Kind) And Ok
                    Ok = TerrainVertex(Value, Mesh, Point + 3, Part.X2, Part.Y2, Part.Z2, Value.Kind) And Ok

                    FaceNormal = M.Cross(P.Vector(Part.X1 - Part.X0, Part.Y1 - Part.Y0, Part.Z1 - Part.Z0),
                        P.Vector(Part.X2 - Part.X0, Part.Y2 - Part.Y0, Part.Z2 - Part.Z0))

                    If Abs(FaceNormal.Y) < 0.000001 Then

                        ' Vertical curb faces retain their outward normal, not the ground gradient.
                        Ok = M.TryNormalize(FaceNormal, FaceNormal) And Ok

                        For NormalIndex = 0 To 3
                            Ok = G.SetMeshNormal3D(Mesh, Point + NormalIndex,
                                ToNumber(FaceNormal.X * 1000.0), ToNumber(FaceNormal.Y * 1000.0),
                                ToNumber(FaceNormal.Z * 1000.0)) And Ok
                        End For

                    End If

                Else If Part.Plane = 3 Then

                    Ok = Vertex(Value, Mesh, Point, Part.X0, Height, Part.Z0, Value.Kind) And Ok
                    Ok = Vertex(Value, Mesh, Point + 1, Part.X1, Height, Part.Z1, Value.Kind) And Ok
                    Ok = Vertex(Value, Mesh, Point + 2, Part.X2, Height, Part.Z2, Value.Kind) And Ok
                    Ok = Vertex(Value, Mesh, Point + 3, Part.X2, Height, Part.Z2, Value.Kind) And Ok

                Else If Part.Plane = 4 Then

                    Ok = Vertex(Value, Mesh, Point, Part.X0, Part.Y0, Part.Z0, Value.Kind) And Ok
                    Ok = Vertex(Value, Mesh, Point + 1, Part.X0, Part.Y1, Part.Z0, Value.Kind) And Ok
                    Ok = Vertex(Value, Mesh, Point + 2, Part.X1, Part.Y1, Part.Z1, Value.Kind) And Ok
                    Ok = Vertex(Value, Mesh, Point + 3, Part.X1, Part.Y0, Part.Z1, Value.Kind) And Ok

                Else If Part.Plane = 1 Then

                    Ok = Vertex(Value, Mesh, Point, Part.X0, Part.Y0, Part.Z0, Value.Kind) And Ok
                    Ok = Vertex(Value, Mesh, Point + 1, Part.X0, Part.Y1, Part.Z0, Value.Kind) And Ok
                    Ok = Vertex(Value, Mesh, Point + 2, Part.X1, Part.Y1, Part.Z0, Value.Kind) And Ok
                    Ok = Vertex(Value, Mesh, Point + 3, Part.X1, Part.Y0, Part.Z0, Value.Kind) And Ok

                Else If Part.Plane = 2 Then

                    Ok = Vertex(Value, Mesh, Point, Part.X0, Part.Y0, Part.Z0, Value.Kind) And Ok
                    Ok = Vertex(Value, Mesh, Point + 1, Part.X0, Part.Y1, Part.Z0, Value.Kind) And Ok
                    Ok = Vertex(Value, Mesh, Point + 2, Part.X0, Part.Y1, Part.Z1, Value.Kind) And Ok
                    Ok = Vertex(Value, Mesh, Point + 3, Part.X0, Part.Y0, Part.Z1, Value.Kind) And Ok

                Else

                    If Part.Y0 > 0.0 Then
                        Height = Part.Y0
                    End If

                    Ok = Vertex(Value, Mesh, Point, Part.X0, Height, Part.Z0, Value.Kind) And Ok
                    Ok = Vertex(Value, Mesh, Point + 1, Part.X0, Height, Part.Z1, Value.Kind) And Ok
                    Ok = Vertex(Value, Mesh, Point + 2, Part.X1, Height, Part.Z1, Value.Kind) And Ok
                    Ok = Vertex(Value, Mesh, Point + 3, Part.X1, Height, Part.Z0, Value.Kind) And Ok

                End If

                PointStep = 4

                If Value.Kind = 2 And Part.Plane = 5 Then
                    ' Collapsed endpoints already isolate adjacent triangles; no fourth point is needed.
                    PointStep = 3
                End If

                If Value.Kind = 2 Then

                    For NormalIndex = 0 To PointStep - 1
                        Ok = G.SetRibbonPointColor3D(Value.NextWater[Value.NextWaterCount], Point + NormalIndex, 255, 255, 255, 100) And Ok
                    End For

                Else
                    Ok = G.SetMeshTriangle3D(Mesh, Point / 2, Point, Point + 1, Point + 2) And Ok
                    Ok = G.SetMeshTriangle3D(Mesh, Point / 2 + 1, Point, Point + 2, Point + 3) And Ok

                End If

                Point = Point + PointStep

            End If

        End For

        If Value.Kind = 2 Then

            Ok = G.CommitRibbonBatch3D(Value.NextWater[Value.NextWaterCount], Point) And Ok
            Value.NextWaterCount = Value.NextWaterCount + 1

        Else
            Ok = G.CommitMesh3D(Mesh) And Ok
            Value.NextObjects[Value.NextCount] = G.CreateObjectFromMesh3D(Mesh)
            Style = Value.PendingStyle

            If Value.StyleGroup > 0 Then
                Style = Value.StyleGroup - 1
            End If

            Ok = G.SetObjectMaterial3D(Value.NextObjects[Value.NextCount], Value.Materials[Styles.Slot(Value.Kind, Style)]) And Ok
            Ok = G.SetObjectCullMode3D(Value.NextObjects[Value.NextCount], G.OBJECT_CULL_NONE) And Ok

            ' Flat terrain receives scenery shadows. Casting onto itself creates
            ' moving PCF bands across the town-sized shadow map; rails still cast.
            Ok = G.SetObjectShadowsChecked3D(Value.NextObjects[Value.NextCount],
                Value.Kind = 4 Or Value.Kind = 5, True) And Ok
            Value.NextCount = Value.NextCount + 1

        End If

    End If

    Value.Failed = Not Ok
    Value.Cursor = StopIndex

    If Value.Cursor >= Value.Recipe.Buffer.PatchCount Then

        If ((Value.Kind = 1 Or Value.Kind = 3) And
            Value.StyleGroup < 5 And
            Value.Recipe.Appearance.Nonzero > 0) Then

            Value.StyleGroup = Value.StyleGroup + 1

        Else If Value.Kind = 2 And Value.FlowGroup < Value.Recipe.Flows.GroupCount Then

            Value.FlowGroup = Value.FlowGroup + 1

        Else
            Value.Kind = Value.Kind + 1
            Value.StyleGroup = 0
            Value.FlowGroup = 0

        End If

        Value.Cursor = 0

    End If

End Sub

''' Preflight then publish water in one update, without holding two full water copies.
Private Sub UploadWater(ByRef Value As State)

    Dim Index As Number
    Dim Points As Number
    Dim Groups[4] As Number
    Dim Batches As Number
    Dim LivePoints As Number
    Dim AvailablePoints As Number
    Dim AvailableBatches As Number

    For Index = 0 To Value.WaterPatchCount - 1

        Groups[Value.PendingWater[Index].FlowGroup] = Groups[Value.PendingWater[Index].FlowGroup] + 1

        If Value.PendingWater[Index].Plane = 5 Then
            Points = Points + 3
        Else
            Points = Points + 4
        End If

    End For

    For Index = 0 To 3
        Batches = Batches + (Groups[Index] + 2047) / 2048
    End For

    For Index = 0 To Value.WaterCount - 1
        LivePoints = LivePoints + G.VfxValue3D(G.VFX_QUERY_RESOURCE_CAPACITY, Value.Water[Index].Handle)
    End For

    AvailablePoints = (G.VfxValue3D(G.VFX_QUERY_MAX_STAGED_RIBBON_POINTS) -
        G.VfxValue3D(G.VFX_QUERY_STAGED_RIBBON_CAPACITY))
    AvailableBatches = (G.VfxValue3D(G.VFX_QUERY_MAX_RIBBON_BATCHES) -
        G.VfxValue3D(G.VFX_QUERY_LIVE_RIBBON_BATCHES))

    If (Batches > 4 Or
        Points > AvailablePoints + LivePoints Or
        Batches > AvailableBatches + Value.WaterCount) Then
        Value.Failed = True
        Return
    End If

    If Points > AvailablePoints Or Batches > AvailableBatches Then

        ' The complete CPU recipe and land are ready; no draw occurs during this swap.

        For Index = 0 To Value.WaterCount - 1
            Call G.DestroyRibbonBatch3D(Value.Water[Index])
        End For

        Value.WaterCount = 0

    End If

    Do

        Call UploadNext(Value)

    Loop Until Value.Kind > 2 Or Value.Failed

End Sub

Public Sub Update(ByRef Value As State, Elapsed As Number)

    Dim Index As Number
    Dim Ok As Boolean
    Dim Deadline As Number

    Value.Time = (Value.Time + Max(0, Elapsed)) Mod 3600000
    Ok = G.SetEffectMaterialWater3D(Value.Materials[2], True, 45, 0, Value.Time / 8, 2)

    For Index = 0 To 2

        If Value.FlowMaterials[Index].Handle <> 0 Then
            Ok = G.SetEffectMaterialWater3D(Value.FlowMaterials[Index], True, 30, 0, Value.Time, 12) And Ok
        End If

        If Value.NextFlowMaterials[Index].Handle <> 0 Then
            Ok = G.SetEffectMaterialWater3D(Value.NextFlowMaterials[Index], True, 30, 0, Value.Time, 12) And Ok
        End If

    End For

    If Value.Failed Then
        Return
    End If

    If Value.Stage = 1 Then

        Deadline = Timer() + 3

        For Index = 1 To 14

            Call Builder.ScanRow(Value.Recipe)

            Value.Failed = Value.Recipe.Failed

            Value.Recipe.Row = Value.Recipe.Row + 1

            ' Flush a bounded block before the next row can fill the scratch array.
            ' Uploaded objects remain private until every row has finished.

            If (Value.Recipe.Buffer.PatchCount >= 32768 Or
                Value.Recipe.Row >= Value.Recipe.Surface.Rows Or
                Value.Failed) Then

                Value.CacheOk = Cache.SaveBatch(Value.Recipe.Buffer, Value.CacheKey, Value.CacheBatch) And Value.CacheOk
                Value.CacheBatch = Value.CacheBatch + 1
                Value.Stage = 2
                Exit For

            End If

            If Timer() >= Deadline Then
                Exit For
            End If

        End For

    Else If Value.Stage = 2 Then

        If Value.Kind = 2 Then

            ' Collect water across recipe pages before allocating exact-size ribbons.
            ' The CPU bound equals the existing four batches of 2048 patches.

            For Index = 0 To Value.Recipe.Buffer.PatchCount - 1

                If Value.Recipe.Buffer.Patches[Index].Kind = 2 Then

                    If Value.WaterPatchCount >= 8192 Then
                        Value.Failed = True
                        Return
                    End If

                    Value.PendingWater[Value.WaterPatchCount] = Value.Recipe.Buffer.Patches[Index]
                    Value.WaterPatchCount = Value.WaterPatchCount + 1

                End If

            End For

            Value.Kind = 3
            Value.Cursor = 0

        End If

        Call UploadNext(Value)

        If Value.Kind > 6 And Not Value.Failed Then

            If Value.CacheRead And Value.CacheBatch < Value.CacheBatches Then

                Value.StyleGroup = 0
                Value.Kind = 1
                Value.Cursor = 0

                Call ReadCachedBatch(Value)

                Return

            End If

            If Value.Recipe.Row < Value.Recipe.Surface.Rows Then

                Value.Recipe.Buffer.PatchCount = 0
                Value.StyleGroup = 0
                Value.Kind = 1
                Value.Cursor = 0
                Value.Stage = 1
                Return

            End If

            For Index = 0 To Value.WaterPatchCount - 1
                Value.Recipe.Buffer.Patches[Index] = Value.PendingWater[Index]
            End For

            Value.Recipe.Buffer.PatchCount = Value.WaterPatchCount
            Value.Kind = 2
            Value.FlowGroup = 0
            Value.StyleGroup = 0
            Value.Cursor = 0
            Value.Stage = 3

        End If

    Else If Value.Stage = 3 Then

        Call UploadWater(Value)

        If Value.Kind > 2 And Not Value.Failed Then

            For Index = 0 To 63
                Call G.DestroyObject3D(Value.Objects[Index])

                Value.Objects[Index] = Value.NextObjects[Index]
                Value.NextObjects[Index].Handle = 0
                Value.NextObjects[Index].MeshHandle = 0
            End For

            For Index = 0 To 3
                Call G.DestroyRibbonBatch3D(Value.Water[Index])

                Value.Water[Index] = Value.NextWater[Index]
                Value.NextWater[Index].Handle = 0
            End For

            Value.ObjectCount = Value.NextCount
            Value.WaterCount = Value.NextWaterCount
            Value.NextCount = 0
            Value.NextWaterCount = 0

            For Index = 0 To 2
                Call G.DestroyMaterial3D(Value.FlowMaterials[Index])

                Value.FlowMaterials[Index] = Value.NextFlowMaterials[Index]
                Value.NextFlowMaterials[Index].Handle = 0
            End For

            If Not Value.CacheRead And Value.CacheOk Then

                Ok = Derived.WriteNumber(Value.CacheBatch, Value.CacheKey + ".Batches")

                If Ok Then
                    Ok = Derived.Commit(CacheTown, "Terrain9", Value.CacheKey)
                End If

            End If

            Value.LiveRevision = Value.PendingRevision
            Value.Stage = 0

        End If

    End If

End Sub

Public Function Draw(ByRef Value As State) As Boolean

    Dim Index As Number
    Dim Ok As Boolean

    Ok = True

    For Index = 0 To Value.ObjectCount - 1
        Ok = G.DrawObject3D(Value.Objects[Index]) And Ok
    End For

    For Index = 0 To Value.WaterCount - 1
        Ok = G.DrawRibbonBatch3D(Value.Water[Index]) And Ok
    End For

    Return Ok

End Function

Public Sub Destroy(ByRef Value As State)

    Dim Index As Number

    For Index = 0 To 63
        Call G.DestroyObject3D(Value.Objects[Index])
        Call G.DestroyObject3D(Value.NextObjects[Index])
    End For

    For Index = 0 To 3
        Call G.DestroyRibbonBatch3D(Value.Water[Index])
        Call G.DestroyRibbonBatch3D(Value.NextWater[Index])
    End For

    For Index = 1 To 14
        Call G.DestroyMaterial3D(Value.Materials[Index])
    End For

    For Index = 0 To 2
        Call G.DestroyMaterial3D(Value.FlowMaterials[Index])
        Call G.DestroyMaterial3D(Value.NextFlowMaterials[Index])
    End For

    For Index = 0 To 4
        Call G.DestroyTexture3D(Value.Textures[Index])
    End For

    Value.Stage = 0

End Sub

End Module
