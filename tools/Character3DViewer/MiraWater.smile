''' Mira's water presentation uses caller-owned renderer resources and the actor's clip clock.
Module Smile.Tools.MiraWater

Option Explicit

Import Smile.Simple3D.Core As Core
Import Smile.Simple3D.Character3D As Character
Import Smile.Simple3D.Graphics3D As Graphics
Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.PrecisionMath3D As M
Import Smile.Tools.BattleAudio As Audio

Private Const CAPACITY = 128

Public Type Targets
    Attack As P.Vector3
    Members[4] As P.Vector3
    MemberCount As Number
End Type

Public Type Context
    Ready As Boolean
    Visible As Boolean
    Texture As Core.Texture3D
    Material As Core.Material3D
    Particles As Core.ParticleBatch3D
    Cue As Audio.CueState
    Targets As Targets
End Type

Public Function Prepare(ByRef Value As Context) As Boolean

    Dim ReturnValue As Boolean

    If Value.Ready Then
        Return True
    End If

    Value.Texture = Graphics.LoadTexture3D("TechnicalAssets\Generation2\VfxAtlas.png",
        Graphics.TEXTURE_FILTER_LINEAR, Graphics.TEXTURE_WRAP_CLAMP)
    Value.Material = Graphics.CreateEffectMaterial3D(Value.Texture,
        Graphics.MATERIAL_ALPHA_ADDITIVE, 220)
    Value.Particles = Graphics.CreateParticleBatch3D(CAPACITY, Value.Material,
        Graphics.VFX_BILLBOARD_CAMERA, 4, 4)
    Value.Ready = Value.Texture.Handle <> 0 And Value.Material.Handle <> 0 And Value.Particles.Handle <> 0

    If Not Value.Ready Then
        Call Destroy(Value)
    End If

    ReturnValue = Value.Ready

    Return ReturnValue

End Function

Public Sub Destroy(ByRef Value As Context)

    Call Graphics.DestroyParticleBatch3D(Value.Particles)
    Call Graphics.DestroyEffectMaterial3D(Value.Material)
    Call Graphics.DestroyTexture3D(Value.Texture)

    Stop Sound On Channel 6

    Value.Ready = False
    Value.Visible = False
    Value.Cue.Clip = ""
    Value.Targets.MemberCount = 0

End Sub

Public Sub SetMember(ByRef Value As Targets, Index As Number, Actor As Character.Actor)

    Dim Ok As Boolean

    If Index >= 0 And Index < 4 Then
        Ok = Character.TryPosition(Actor, Value.Members[Index])
        Value.MemberCount = Max(Value.MemberCount, Index + 1)
    End If

End Sub

Public Sub SetAttack(ByRef Value As Targets, Actor As Character.Actor)

    Dim Ok As Boolean

    If Character.HasSocket(Actor, "Chest") Then
        Ok = Character.TrySocketPositionPrecise(Actor, "Chest", 0, False, Value.Attack)
    End If

    If Not Ok And Character.HasSocket(Actor, "Head") Then
        Ok = Character.TrySocketPositionPrecise(Actor, "Head", 0, False, Value.Attack)
    End If

End Sub

Public Sub UseStandaloneTargets(ByRef Value As Context, Actor As Character.Actor)

    Dim Ok As Boolean

    Value.Targets.MemberCount = 1
    Ok = Character.TryPosition(Actor, Value.Targets.Members[0])
    Value.Targets.Attack = Value.Targets.Members[0]
    Value.Targets.Attack.Y = Value.Targets.Attack.Y + 55.0
    Value.Targets.Attack.Z = Value.Targets.Attack.Z + 180.0

End Sub

Private Function AddDrop(ByRef Value As Context, Index As Number,
    Position As P.Vector3, Size As Double, Opacity As Number) As Boolean

    Dim Result As Boolean
    Dim RedValue As Number

    RedValue = 70

    If Index Mod 4 = 0 Then
        RedValue = 215
    End If

    Result = P.SetParticle(Value.Particles, Index, Position, Size, 0.0, 4 + Index Mod 4)
    Result = Graphics.SetParticleColor3D(Value.Particles, Index,
        RedValue, 215, 255, Max(0, Min(100, Opacity))) And Result

    Return Result

End Function

Public Function Update(ByRef Value As Context, Actor As Character.Actor,
    Name As Text, Enabled As Boolean, Audible As Boolean) As Boolean

    Dim Duration As Number
    Dim Time As Number
    Dim Index As Number
    Dim ParticleCount As Number
    Dim Member As Number
    Dim Members As Number
    Dim Phase As Double
    Dim Envelope As Double
    Dim Along As Double
    Dim Angle As Double
    Dim Rise As Double
    Dim Radius As Double
    Dim Point As P.Vector3
    Dim Origin As P.Vector3
    Dim Offset As P.Vector3
    Dim Result As Boolean
    Dim Ok As Boolean
    Dim Healing As Boolean
    Dim Opacity As Number

    If Not Value.Ready Then
        Return True
    End If

    Time = Character.AnimationTime(Actor)
    Healing = Name = "HealOne" Or Name = "HealParty"
    Value.Visible = Enabled And (Healing Or Name = "Attack")

    For Index = 0 To Character.ClipCount(Actor) - 1

        If Character.ClipName(Actor, Index) = Name Then
            Duration = Character.ClipDuration(Actor, Index)
        End If

    End For

    Phase = ToDouble(Time) / ToDouble(Max(1, Duration))
    Envelope = Clamp(Min((Phase - 0.12) * 5.0, (0.94 - Phase) * 6.0), 0.0, 1.0)
    Value.Visible = Value.Visible And Envelope > 0.0

    If Audio.CrossedCue(Value.Cue, Name, Time, Duration / 4,
        Audible And Enabled And (Healing Or Name = "Attack")) Then

        If Name = "HealOne" Then

            Play Sound "Assets/Audio/mira-heal-one.wav" On Channel 6

        Else If Name = "HealParty" Then

            Play Sound "Assets/Audio/mira-heal-party.wav" On Channel 6

        Else

            Play Sound "Assets/Audio/mira-water-attack.wav" On Channel 6

        End If

    End If

    If Not Audible Then
        Stop Sound On Channel 6
    End If

    If Not Value.Visible Then
        Result = Graphics.CommitParticleBatch3D(Value.Particles, 0)

        Return Result
    End If

    Ok = Character.TrySocketPositionPrecise(Actor, "HandLeft", 0, False, Origin)
    Result = Ok
    Opacity = ToNumber(Round(Envelope * 80.0))

    If Healing Then

        Members = Min(4, Value.Targets.MemberCount)

        If Name = "HealOne" Then
            Members = Min(1, Members)
        End If

        For Member = 0 To Members - 1

            For Index = 0 To 23

                Along = ToDouble((Index * 41 + Time / 3) Mod 1000) / 1000.0
                Angle = ToDouble(Index) * 30.0 + ToDouble(Time) * 0.24
                Radius = 27.0 + Along * 9.0
                Offset = M.Rotate(P.Vector(Radius, 4.0 + Along * 72.0, 0.0),
                    P.Vector(0.0, Angle, 0.0))
                Point = M.Add(Value.Targets.Members[Member], Offset)
                Result = AddDrop(Value, ParticleCount, Point, 7.0 - Along * 3.0, Opacity) And Result
                ParticleCount = ParticleCount + 1
            End For
        End For

    Else

        For Index = 0 To 95

            Along = ToDouble((Index * 10 + Time) Mod 1000) / 1000.0
            Point = M.Lerp(Origin, Value.Targets.Attack, Along)
            Rise = 36.0 * Along * (1.0 - Along)
            Offset = M.Rotate(P.Vector(4.0 + Along * 8.0, 0.0, 0.0),
                P.Vector(0.0, ToDouble(Index * 47 + Time / 2), 0.0))
            Point = M.Add(Point, Offset)
            Point.Y = Point.Y + Rise
            Result = AddDrop(Value, ParticleCount, Point, 8.0 + Along * 4.0, Opacity) And Result
            ParticleCount = ParticleCount + 1
        End For

    End If

    For Index = 0 To 15

        Offset = M.Rotate(P.Vector(8.0, ToDouble(Index Mod 4) - 2.0, 0.0),
            P.Vector(0.0, ToDouble(Index) * 22.5 + ToDouble(Time) * 0.3, 0.0))
        Point = M.Add(Origin, Offset)
        Result = AddDrop(Value, ParticleCount, Point, 5.0, Opacity) And Result
        ParticleCount = ParticleCount + 1
    End For

    Result = Graphics.CommitParticleBatch3D(Value.Particles, ParticleCount) And Result

    Return Result

End Function

Public Sub Draw(ByRef Value As Context)

    Dim Drawn As Boolean

    If Value.Ready And Value.Visible Then
        Drawn = Graphics.DrawParticleBatch3D(Value.Particles)
    End If

End Sub

End Module
