''' Maps clip time and final actor positions into reusable water presentation.
Module Smile.Tools.MiraWater

Option Explicit

Import Smile.Simple3D.Character3D As Character
Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.PrecisionMath3D As M
Import Smile.Simple3D.WaterVfx3D As Water
Import Smile.Simple3D.WaterStorm3D As Storm
Import Smile.Simple3D.CharacterGlow3D As Glow
Import Smile.Tools.BattleAudio As Audio

Public Type Targets
    Attack As P.Vector3
    Members[4] As P.Vector3
    MemberCount As Number
End Type

Public Type Context
    Ready As Boolean
    Visible As Boolean
    Effect As Water.Context
    Storm As Storm.Context
    Glow As Glow.Context
    Conductor As P.Vector3
    Cue As Audio.CueState
    ImpactCue As Audio.CueState
    Targets As Targets
    AttackMode As Number
    GuardTime As Number
    Guarding As Boolean
    ImpactElapsed As Number
    ImpactMember As Number
End Type

Public Function Prepare(ByRef Value As Context) As Boolean

    Dim Result As Boolean

    Value.Ready = Water.Prepare(Value.Effect, "Assets/Water")
    Value.AttackMode = Water.TORRENT
    Result = Value.Ready

    Return Result

End Function

Public Sub Destroy(ByRef Value As Context)

    Dim Empty As Context

    Call Glow.Destroy(Value.Glow)
    Call Water.Destroy(Value.Effect)
    Call Storm.Destroy(Value.Storm)

    Stop Sound On Channel 6
    Stop Sound On Channel 8

    Value = Empty

End Sub

Public Sub SetMember(ByRef Value As Targets, Index As Number, Actor As Character.Actor)

    Dim Ok As Boolean

    If Index >= 0 And Index < 4 Then
        Ok = Character.TryPosition(Actor, Value.Members[Index])
        Value.MemberCount = Max(Value.MemberCount, Index + 1)
    End If

End Sub

Public Sub SetAttack(ByRef Value As Targets, Actor As Character.Actor)

    Dim Ok As Boolean

    If Character.HasSocket(Actor, "Chest") Then
        Ok = Character.TrySocketPositionPrecise(Actor, "Chest", 0, False, Value.Attack)
    End If

    If Not Ok And Character.HasSocket(Actor, "Head") Then
        Ok = Character.TrySocketPositionPrecise(Actor, "Head", 0, False, Value.Attack)
    End If

End Sub

Public Sub UseStandaloneTargets(ByRef Value As Context, Actor As Character.Actor)

    Dim Ok As Boolean
    Dim Rotation As P.Vector3

    Value.Targets.MemberCount = 1
    Ok = Character.TryPosition(Actor, Value.Targets.Members[0])
    Ok = Character.TryRotation(Actor, Rotation) And Ok
    Value.Targets.Attack = M.Add(Value.Targets.Members[0],
        M.Rotate(P.Vector(0.0, 55.0, -180.0), Rotation))
    Value.Guarding = False
    Value.ImpactElapsed = -1

End Sub

''' Apply after the caller restores the boss's authored pose; never accumulate displacement.
Public Function ApplyRecoil(Mira As Character.Actor, Boss As Character.Actor) As Boolean

    Dim Source As P.Vector3
    Dim Position As P.Vector3
    Dim Direction As P.Vector3
    Dim Duration As Number
    Dim Index As Number
    Dim Progress As Double
    Dim Ok As Boolean

    For Index = 0 To Character.ClipCount(Mira) - 1

        If Character.ClipName(Mira, Index) = "Attack" Then
            Duration = Character.ClipDuration(Mira, Index)
        End If

    End For

    Progress = ToDouble(Character.AnimationTime(Mira)) / ToDouble(Max(1, Duration))
    Ok = Character.TryPosition(Mira, Source)
    Ok = Character.TryPosition(Boss, Position) And Ok
    Direction = M.Subtract(Position, Source)
    Direction.Y = 0.0
    Ok = M.TryNormalize(Direction, Direction) And Ok
    Position = M.Add(Position, M.Scale(Direction, Water.RecoilDistance(Progress)))
    Ok = Character.PlacePrecise(Boss, Position.X, Position.Y, Position.Z) And Ok

    Return Ok

End Function

Public Function Update(ByRef Value As Context, Actor As Character.Actor,
    Name As Text, Enabled As Boolean, Audible As Boolean,
    Optional StaffVisible As Boolean = True) As Boolean

    Dim Duration As Number
    Dim Time As Number
    Dim Index As Number
    Dim Healing As Boolean
    Dim Guarding As Boolean
    Dim Ok As Boolean
    Dim Sample As Water.Frame
    Dim Charge As Double
    Dim CueTime As Number
    Dim ImpactClock As Number

    If Not Value.Ready Then
        Return True
    End If

    Time = Character.AnimationTime(Actor)
    Healing = Name = "HealOne" Or Name = "HealParty"
    Guarding = Value.Guarding Or Name = "Defend" Or Name = "Hit"

    For Index = 0 To Character.ClipCount(Actor) - 1

        If Character.ClipName(Actor, Index) = Name Then
            Duration = Character.ClipDuration(Actor, Index)
        End If

    End For

    Sample.Time = Time
    Sample.Progress = ToDouble(Time) / ToDouble(Max(1, Duration))
    Sample.Strength = Clamp(Min((Sample.Progress - 0.12) * 5.0,
        (0.98 - Sample.Progress) * 8.0), 0.0, 1.0)
    Sample.Target = Value.Targets.Attack
    Sample.MemberCount = Value.Targets.MemberCount
    Sample.ImpactMember = Value.ImpactMember
    Sample.Mode = Value.AttackMode

    If Character.HasSocket(Actor, "StaffTip") Then
        Ok = Character.TrySocketPositionPrecise(Actor, "StaffTip", 0, False, Sample.Origin)
    Else
        Ok = Character.TrySocketPositionPrecise(Actor, "HandLeft", 0, False, Sample.Origin)
    End If

    For Index = 0 To Sample.MemberCount - 1
        Sample.Members[Index] = Value.Targets.Members[Index]
    End For

    If Healing Then

        Sample.Mode = Water.HEAL

        If Name = "HealOne" Then
            Sample.MemberCount = Min(1, Sample.MemberCount)
        End If

    Else If Guarding Then

        Sample.Mode = Water.SHIELD
        Sample.Strength = Clamp(Sample.Progress * 4.0, 0.0, 1.0)
        Sample.ImpactActive = Value.ImpactElapsed >= 0 And Value.ImpactElapsed < 900
        Sample.ImpactProgress = Clamp(ToDouble(Value.ImpactElapsed) / 900.0, 0.0, 1.0)

        If Value.Guarding Then
            Sample.Time = Value.GuardTime
            Sample.Strength = Clamp(ToDouble(Value.GuardTime) / 300.0, 0.0, 1.0)
        End If

        If Name = "Defend" And Not Value.Guarding Then
            Sample.ImpactActive = Sample.Progress >= 0.5
            Sample.ImpactProgress = Clamp((Sample.Progress - 0.5) * 2.0, 0.0, 1.0)
        End If

        If Name = "Hit" And Not Value.Guarding Then

            Sample.Strength = 1.0 - Sample.Progress * 0.65
            Sample.ImpactActive = True
            Sample.ImpactProgress = Sample.Progress

        End If

    Else If Name <> "Attack" Then

        Sample.Mode = 0

    End If

    If Not Enabled Then
        Sample.Mode = 0
    End If

    If Audio.CrossedCue(Value.Cue, Name, Time, Duration / 4,
        Audible And Enabled And (Healing Or Name = "Attack" Or Guarding)) Then

        If Name = "HealOne" Then

            Play Sound "Assets/Audio/mira-heal-one.wav" On Channel 6

        Else If Name = "HealParty" Then

            Play Sound "Assets/Audio/mira-heal-party.wav" On Channel 6

        Else If Name = "Attack" And Value.AttackMode >= Water.WAVE Then

            Play Sound "Assets/Water/water-tsunami.wav" On Channel 6

        Else

            Play Sound "Assets/Audio/mira-water-attack.wav" On Channel 6

        End If

    End If

    CueTime = Duration * 72 / 100
    ImpactClock = Time

    If Value.Guarding Then
        CueTime = 0
        ImpactClock = Value.ImpactElapsed
    Else If Name = "Defend" Then
        CueTime = Duration / 2
    Else If Name = "Hit" Then
        CueTime = 0
    End If

    If Audio.CrossedCue(Value.ImpactCue, Name, ImpactClock, CueTime,
        Audible And Enabled And (Guarding Or (Name = "Attack" And Value.AttackMode >= Water.WATER_BALL))) Then

        If Guarding Then

            Play Sound "Assets/Water/water-barrier-hit.wav" On Channel 8

        Else

            Play Sound "Assets/Water/water-splash.wav" On Channel 8

        End If

    End If

    If Not Audible Then
        Stop Sound On Channel 6
        Stop Sound On Channel 8
    End If

    Ok = Water.Update(Value.Effect, Sample) And Ok
    Charge = 0.0

    If Sample.Mode <> 0 Then
        Charge = Sample.Strength
    End If

    Ok = Glow.Update(Value.Glow, Actor, Charge, StaffVisible, Enabled,
        Sample.Time, Value.Effect.DropTexture) And Ok
    Ok = Storm.Update(Value.Storm, Sample, Value.Conductor) And Ok
    Value.Visible = Value.Effect.Visible

    Return Ok

End Function

Public Sub Draw(ByRef Value As Context)

    Call Water.Draw(Value.Effect)
    Call Glow.Draw(Value.Glow)

End Sub

End Module
