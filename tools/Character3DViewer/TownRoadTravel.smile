''' One active road journey. Goal-directed search is time-budgeted; movement uses normal collision.
Module Smile.Tools.TownRoadTravel

Option Explicit

Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.PrecisionMath3D As M
Import Smile.Simple3D.SurfaceGrid3D As Grid
Import Smile.Tools.TownDocument As Document
Import Smile.Tools.TownDocumentNavigation As Navigation

Private Dim Surface As Grid.State
Private Dim Parents[262144] As Number
Private Dim Queue[262144] As Number
Private Dim Scores[262144] As Double
Private Dim Tail As Number
Private Dim GoalCell As Number
Private Dim Cursor As Number
Private Dim Stage As Number
Private Dim Revision As Number
Private Dim TownName As Text
Private Dim Destination As P.Vector3
Private Dim Previous As P.Vector3
Private Dim Stalled As Number
Private Dim Notice As Text
Private Dim WaypointCursor As Number
Private Dim Waypoint As P.Vector3

Public Sub Cancel(Optional Message As Text = "")

    Stage = 0
    Notice = Message

End Sub

Public Function Active() As Boolean

    Dim Result As Boolean

    Result = Stage > 0

    Return Result

End Function

Public Function Message() As Text

    Return Notice

End Function

Public Function Target() As P.Vector3

    Return Destination

End Function

Private Function Center(Cell As Number) As P.Vector3

    Dim X As Number
    Dim Z As Number
    Dim Result As P.Vector3

    X = Cell Mod Surface.Columns
    Z = Cell / Surface.Columns
    Result = P.Vector((Surface.XEdges[X] + Surface.XEdges[X + 1]) * 0.5, 23.12,
        (Surface.ZEdges[Z] + Surface.ZEdges[Z + 1]) * 0.5)

    Return Result

End Function

Private Function Road(X As Number, Z As Number) As Boolean

    Dim Kind As Number
    Dim Result As Boolean

    Kind = Grid.ReadCell(Surface, X, Z)
    Result = Kind = Grid.SURFACE_ROAD Or Kind = Grid.SURFACE_BRIDGE

    Return Result

End Function

Private Function ClearSegment(First As P.Vector3, Last As P.Vector3,
    Optional RequireRoad As Boolean = True) As Boolean

    Dim Steps As Number
    Dim Index As Number
    Dim Point As P.Vector3

    Steps = Max(1, ToNumber(Floor(M.Length(M.Subtract(Last, First)) / 5.0)) + 1)

    For Index = 0 To Steps

        Point = M.Add(First, M.Scale(M.Subtract(Last, First), ToDouble(Index) / ToDouble(Steps)))

        If (Not Navigation.CanStand(Point.X, Point.Z) Or
            (RequireRoad And Not Road(Grid.CellX(Surface, Point.X), Grid.CellZ(Surface, Point.Z)))) Then
            Return False
        End If

    End For

    Return True

End Function

Private Sub Push(Cell As Number)

    Dim Slot As Number
    Dim Parent As Number
    Dim Point As P.Vector3
    Dim Goal As P.Vector3

    Point = Center(Cell)
    Goal = Center(GoalCell)
    Scores[Cell] = Abs(Point.X - Goal.X) + Abs(Point.Z - Goal.Z)
    Slot = Tail
    Tail = Tail + 1

    Do

        If Not (Slot > 0) Then
            Exit Do
        End If

        Parent = (Slot - 1) / 2

        If Scores[Queue[Parent]] <= Scores[Cell] Then
            Exit Do
        End If

        Queue[Slot] = Queue[Parent]
        Slot = Parent

    Loop

    Queue[Slot] = Cell

End Sub

Private Function Pop() As Number

    Dim Result As Number
    Dim Last As Number
    Dim Slot As Number
    Dim Child As Number

    Result = Queue[0]
    Tail = Tail - 1
    Last = Queue[Tail]

    Do

        If Not (Slot * 2 + 1 < Tail) Then
            Exit Do
        End If

        Child = Slot * 2 + 1

        If Child + 1 < Tail And Scores[Queue[Child + 1]] < Scores[Queue[Child]] Then
            Child = Child + 1
        End If

        If Scores[Last] <= Scores[Queue[Child]] Then
            Exit Do
        End If

        Queue[Slot] = Queue[Child]
        Slot = Child

    Loop

    Queue[Slot] = Last

    Return Result

End Function

Private Function LaneCenter(Cell As Number) As P.Vector3

    Dim X As Number
    Dim Z As Number
    Dim ColumnStart As Number
    Dim ColumnEnd As Number
    Dim RowStart As Number
    Dim RowEnd As Number
    Dim Width As Double
    Dim Depth As Double
    Dim Result As P.Vector3

    X = Cell Mod Surface.Columns
    Z = Cell / Surface.Columns
    ColumnStart = X
    ColumnEnd = X
    RowStart = Z
    RowEnd = Z

    Do

        If Not (ColumnStart > 0 And Road(ColumnStart - 1, Z)) Then
            Exit Do
        End If

        ColumnStart = ColumnStart - 1

    Loop

    Do

        If Not (ColumnEnd + 1 < Surface.Columns And Road(ColumnEnd + 1, Z)) Then
            Exit Do
        End If

        ColumnEnd = ColumnEnd + 1

    Loop

    Do

        If Not (RowStart > 0 And Road(X, RowStart - 1)) Then
            Exit Do
        End If

        RowStart = RowStart - 1

    Loop

    Do

        If Not (RowEnd + 1 < Surface.Rows And Road(X, RowEnd + 1)) Then
            Exit Do
        End If

        RowEnd = RowEnd + 1

    Loop

    Width = Surface.XEdges[ColumnEnd + 1] - Surface.XEdges[ColumnStart]
    Depth = Surface.ZEdges[RowEnd + 1] - Surface.ZEdges[RowStart]
    Result = Center(Cell)

    ' At junctions retain the safe cell turn instead of centering across another road.

    If Width < Depth * 0.5 Then
        Result.X = (Surface.XEdges[ColumnStart] + Surface.XEdges[ColumnEnd + 1]) * 0.5
    Else If Depth < Width * 0.5 Then
        Result.Z = (Surface.ZEdges[RowStart] + Surface.ZEdges[RowEnd + 1]) * 0.5
    End If

    If Not ClearSegment(Center(Cell), Result) Then
        Result = Center(Cell)
    End If

    Return Result

End Function

Public Function Begin(ByRef Town As Document.State, Leader As P.Vector3,
    Clicked As P.Vector3) As Boolean

    Dim StartPoint As P.Vector3
    Dim StartCell As Number
    Dim Index As Number
    Dim PickRadius As Double

    Call Cancel()

    If (Not Navigation.NearestRoad(Leader, StartPoint) Or
        Not Navigation.NearestRoad(Clicked, Destination)) Then
        Notice = "No walkable road found."
        Return False
    End If

    Surface = Town.Surface
    PickRadius = Max(Surface.XEdges[Surface.Columns] - Surface.OriginX,
        Surface.ZEdges[Surface.Rows] - Surface.OriginZ) / 128.0

    If M.Length(M.Subtract(Clicked, Destination)) > PickRadius Then
        Notice = "Click a road on the minimap."
        Return False
    End If

    StartCell = Grid.CellZ(Surface, StartPoint.Z) * Surface.Columns + Grid.CellX(Surface, StartPoint.X)
    GoalCell = Grid.CellZ(Surface, Destination.Z) * Surface.Columns + Grid.CellX(Surface, Destination.X)
    Destination = LaneCenter(GoalCell)

    If (Not ClearSegment(Leader, Center(StartCell), False) Or
        Not ClearSegment(Center(GoalCell), Destination)) Then
        Notice = "The nearest road is obstructed."
        Return False
    End If

    For Index = 0 To Surface.Columns * Surface.Rows - 1
        Parents[Index] = 0
    End For

    Parents[StartCell] = -1
    Queue[0] = StartCell
    Tail = 1
    WaypointCursor = -2
    Stage = 1
    Revision = Town.Revision
    TownName = Town.Name
    Previous = Leader
    Stalled = 0
    Notice = "Finding a connected road route..."

    Return True

End Function

Private Sub Visit(X As Number, Z As Number, FromCell As Number)

    Dim Cell As Number
    Dim Point As P.Vector3

    If (X < 0 Or
        Z < 0 Or
        X >= Surface.Columns Or
        Z >= Surface.Rows Or
        Not Road(X, Z)) Then
        Return
    End If

    Cell = Z * Surface.Columns + X

    If Parents[Cell] <> 0 Then
        Return
    End If

    Point = Center(Cell)

    If Not Navigation.CanStand(Point.X, Point.Z) Then
        Parents[Cell] = -2
        Return
    End If

    If Not ClearSegment(Center(FromCell), Point) Then
        Return
    End If

    Parents[Cell] = FromCell + 1

    Call Push(Cell)

End Sub

Private Sub Search()

    Dim Work As Number
    Dim Cell As Number
    Dim X As Number
    Dim Z As Number
    Dim Started As Number

    Started = Timer()

    For Work = 0 To 2047

        If Tail = 0 Then
            Call Cancel("That road is disconnected or obstructed.")

            Return
        End If

        Cell = Pop()

        If Cell = GoalCell Then

            Cursor = -1

            Do
                Cursor = Cursor + 1
                Queue[Cursor] = Cell
                Cell = Parents[Cell] - 1

            Loop Until Cell < 0

            Stage = 2
            Notice = "Running to the minimap destination."
            Return

        End If

        X = Cell Mod Surface.Columns
        Z = Cell / Surface.Columns

        Call Visit(X - 1, Z, Cell)
        Call Visit(X + 1, Z, Cell)
        Call Visit(X, Z - 1, Cell)
        Call Visit(X, Z + 1, Cell)

        If Timer() - Started >= 3 Then
            Return
        End If

    End For

End Sub

Public Function Direction(ByRef Town As Document.State, Leader As P.Vector3,
    StepDistance As Double, Elapsed As Number) As P.Vector3

    Dim Result As P.Vector3
    Dim Point As P.Vector3
    Dim Delta As P.Vector3
    Dim Distance As Double

    If Stage = 0 Then
        Return Result
    End If

    If Town.Name <> TownName Or Town.Revision <> Revision Then
        Call Cancel("Route canceled because the map changed.")

        Return Result
    End If

    If Stage = 1 Then
        Call Search()

        Return Result
    End If

    If WaypointCursor <> Cursor Then

        Waypoint = Destination

        If Cursor >= 0 Then

            Waypoint = LaneCenter(Queue[Cursor])

            If Not ClearSegment(Leader, Waypoint) Then
                Waypoint = Center(Queue[Cursor])
            End If

        End If

        WaypointCursor = Cursor

    End If

    Point = Waypoint
    Delta = M.Subtract(Point, Leader)
    Delta.Y = 0.0
    Distance = M.Length(Delta)

    If Distance < 0.25 Then

        Cursor = Cursor - 1
        Stalled = 0

        If Cursor < -1 Then
            Call Cancel("Destination reached.")
        End If

        Return Result

    End If

    If M.Length(M.Subtract(Leader, Previous)) < 0.01 Then
        Stalled = Stalled + Elapsed
    Else
        Stalled = 0
    End If

    Previous = Leader

    If Stalled > 2000 Then
        Call Cancel("Route blocked. Choose another road.")

        Return Result
    End If

    Result = M.Scale(Delta, Min(1.0, StepDistance / Distance) / Max(0.001, StepDistance))

    Return Result

End Function

End Module
