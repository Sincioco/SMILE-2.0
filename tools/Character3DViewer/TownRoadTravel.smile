''' One active road journey. Cached distance-based A* yields between frames; movement uses normal collision.
Module Smile.Tools.TownRoadTravel

Option Explicit

Import Smile.Tools.TownSurfaceLayers As Layers
Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.PrecisionMath3D As M
Import Smile.Simple3D.SurfaceGrid3D As Grid
Import Smile.Tools.TownDocument As Document
Import Smile.Tools.TownDocumentNavigation As Navigation
Import Smile.Tools.TownRoadNetwork As Network
Import Smile.Tools.TownRoadSearch As Search
Import Smile.Tools.TownRoadStops As Stops

Private Dim Surface As Grid.State
Private Dim Queue[262144] As Number
Private Dim Turns[262144] As Number
Private Dim TurnCount As Number
Private Dim TurnCursor As Number
Private Dim BuildCell As Number
Private Dim StartedAt As Number
Private Dim PlanningTime As Number
Private Dim GoalCell As Number
Private Dim Cursor As Number
Private Dim Stage As Number
Private Dim Revision As Number
Private Dim CollisionVersion As Number
Private Dim TownName As Text
Private Dim Destination As P.Vector3
Private Dim Previous As P.Vector3
Private Dim Stalled As Number
Private Dim Notice As Text
Private Dim WaypointCursor As Number
Private Dim Waypoint As P.Vector3

Public Sub Cancel(Optional Message As Text = "")

    Stage = 0
    Notice = Message

    Call Stops.Reset()

End Sub

Public Function Active() As Boolean

    Dim Result As Boolean

    Result = Stage > 0

    Return Result

End Function

Public Function Message() As Text

    Return Notice

End Function

Public Function Target() As P.Vector3

    Return Destination

End Function

''' Remaining route bends for the minimap; completed straight sections need no points.
Public Function RouteCount() As Number

    Dim Result As Number

    If Stage = 2 Then
        Result = TurnCursor + 2
    End If

    Return Result

End Function

Public Function RoutePoint(Index As Number) As P.Vector3

    Dim Result As P.Vector3

    Result = Destination

    If Index <= TurnCursor Then
        Result = Center(Queue[Turns[TurnCursor - Index]])
    End If

    Return Result

End Function

Private Function Center(Cell As Number) As P.Vector3

    Dim X As Number
    Dim Z As Number
    Dim Result As P.Vector3

    X = Cell Mod Surface.Columns
    Z = Cell / Surface.Columns
    Result = P.Vector((Surface.XEdges[X] + Surface.XEdges[X + 1]) * 0.5, Layers.ROAD_Y,
        (Surface.ZEdges[Z] + Surface.ZEdges[Z + 1]) * 0.5)

    Return Result

End Function

Private Function Road(X As Number, Z As Number) As Boolean

    Dim Kind As Number
    Dim Result As Boolean

    Kind = Grid.ReadCell(Surface, X, Z)
    Result = Kind = Grid.SURFACE_ROAD Or Kind = Grid.SURFACE_BRIDGE

    Return Result

End Function

Private Function ClearSegment(First As P.Vector3, Last As P.Vector3,
    Optional RequireRoad As Boolean = True) As Boolean

    Dim Steps As Number
    Dim Index As Number
    Dim Point As P.Vector3

    Steps = Max(1, ToNumber(Floor(M.Length(M.Subtract(Last, First)) / 5.0)) + 1)

    For Index = 0 To Steps

        Point = M.Add(First, M.Scale(M.Subtract(Last, First), ToDouble(Index) / ToDouble(Steps)))

        If (Not Navigation.CanStand(Point.X, Point.Z) Or
            (RequireRoad And Not Road(Grid.CellX(Surface, Point.X), Grid.CellZ(Surface, Point.Z)))) Then
            Return False
        End If

    End For

    Return True

End Function

Private Function LaneCenter(Cell As Number) As P.Vector3

    Dim X As Number
    Dim Z As Number
    Dim ColumnStart As Number
    Dim ColumnEnd As Number
    Dim RowStart As Number
    Dim RowEnd As Number
    Dim Width As Double
    Dim Depth As Double
    Dim Result As P.Vector3

    X = Cell Mod Surface.Columns
    Z = Cell / Surface.Columns
    ColumnStart = X
    ColumnEnd = X
    RowStart = Z
    RowEnd = Z

    Do

        If Not (ColumnStart > 0 And Road(ColumnStart - 1, Z)) Then
            Exit Do
        End If

        ColumnStart = ColumnStart - 1

    Loop

    Do

        If Not (ColumnEnd + 1 < Surface.Columns And Road(ColumnEnd + 1, Z)) Then
            Exit Do
        End If

        ColumnEnd = ColumnEnd + 1

    Loop

    Do

        If Not (RowStart > 0 And Road(X, RowStart - 1)) Then
            Exit Do
        End If

        RowStart = RowStart - 1

    Loop

    Do

        If Not (RowEnd + 1 < Surface.Rows And Road(X, RowEnd + 1)) Then
            Exit Do
        End If

        RowEnd = RowEnd + 1

    Loop

    Width = Surface.XEdges[ColumnEnd + 1] - Surface.XEdges[ColumnStart]
    Depth = Surface.ZEdges[RowEnd + 1] - Surface.ZEdges[RowStart]
    Result = Center(Cell)

    ' At junctions retain the safe cell turn instead of centering across another road.

    If Width < Depth * 0.5 Then
        Result.X = (Surface.XEdges[ColumnStart] + Surface.XEdges[ColumnEnd + 1]) * 0.5
    Else If Depth < Width * 0.5 Then
        Result.Z = (Surface.ZEdges[RowStart] + Surface.ZEdges[RowEnd + 1]) * 0.5
    End If

    If Not ClearSegment(Center(Cell), Result) Then
        Result = Center(Cell)
    End If

    Return Result

End Function

Public Function Append(ByRef Town As Document.State, Clicked As P.Vector3) As Boolean

    Dim Point As P.Vector3
    Dim PickRadius As Double

    PickRadius = Max(Town.Surface.XEdges[Town.Surface.Columns] - Town.Surface.OriginX,
        Town.Surface.ZEdges[Town.Surface.Rows] - Town.Surface.OriginZ) / 128.0

    If Not Navigation.NearestRoad(Clicked, Point) Then
        Notice = "No walkable road found."
        Return False
    End If

    If M.Length(M.Subtract(Clicked, Point)) > PickRadius Then
        Notice = "Click a road on the minimap."
        Return False
    End If

    If Not Stops.Append(Point) Then
        Notice = "Destination queue is full (64 stops)."
        Return False
    End If

    Return True

End Function

Public Function Begin(ByRef Town As Document.State, Leader As P.Vector3,
    Clicked As P.Vector3, Optional ContinueTrip As Boolean = False) As Boolean

    Dim StartPoint As P.Vector3
    Dim StartCell As Number
    Dim PickRadius As Double

    Stage = 0
    Notice = ""

    If Not ContinueTrip Then
        Call Stops.Reset()
    End If

    If (Not Navigation.NearestRoad(Leader, StartPoint) Or
        Not Navigation.NearestRoad(Clicked, Destination)) Then
        Call Cancel("No walkable road found.")

        Return False
    End If

    Surface = Town.Surface
    PickRadius = Max(Surface.XEdges[Surface.Columns] - Surface.OriginX,
        Surface.ZEdges[Surface.Rows] - Surface.OriginZ) / 128.0

    If M.Length(M.Subtract(Clicked, Destination)) > PickRadius Then
        Call Cancel("Click a road on the minimap.")

        Return False
    End If

    StartCell = Grid.CellZ(Surface, StartPoint.Z) * Surface.Columns + Grid.CellX(Surface, StartPoint.X)
    GoalCell = Grid.CellZ(Surface, Destination.Z) * Surface.Columns + Grid.CellX(Surface, Destination.X)
    Destination = LaneCenter(GoalCell)

    If (Not ClearSegment(Leader, Center(StartCell), False) Or
        Not ClearSegment(Center(GoalCell), Destination)) Then
        Call Cancel("The nearest road is obstructed.")

        Return False
    End If

    Call Network.Adopt(Town)
    Call Search.Begin(StartCell, GoalCell)

    StartedAt = Timer()
    PlanningTime = 0
    WaypointCursor = -2
    Stage = 1
    Revision = Town.Revision
    CollisionVersion = Navigation.Version()
    TownName = Town.Name
    Previous = Leader
    Stalled = 0
    Notice = "Acquiring GPS signal, stand by..."

    Return True

End Function

Public Sub Prepare(ByRef Town As Document.State)

    If Stage <> 1 And Stage <> 3 Then
        Call Network.Prepare(Town)
    End If

End Sub

Public Function Preparation() As Number

    Dim Result As Number

    Result = Network.Progress()

    Return Result

End Function

Public Function ThinkingTime() As Number

    Return PlanningTime

End Function

Private Sub Plan()

    Dim Status As Number
    Dim Work As Number

    If Stage = 1 Then

        Status = Search.Advance()

        If Status = 3 Then
            Call Cancel("That road is disconnected or obstructed.")

            Return
        End If

        If Status = 2 Then

            Cursor = -1
            BuildCell = GoalCell
            TurnCount = 1
            Turns[0] = 0
            Stage = 3

        End If

    End If

    If Stage = 3 Then

        For Work = 0 To 1023

            Cursor = Cursor + 1
            Queue[Cursor] = BuildCell
            BuildCell = Search.Parent(BuildCell)

            If Cursor >= 2 Then

                If Queue[Cursor] - Queue[Cursor - 1] <> Queue[Cursor - 1] - Queue[Cursor - 2] Then
                    Turns[TurnCount] = Cursor - 1
                    TurnCount = TurnCount + 1
                End If

            End If

            If BuildCell < 0 Then

                If Cursor > Turns[TurnCount - 1] Then
                    Turns[TurnCount] = Cursor
                    TurnCount = TurnCount + 1
                End If

                TurnCursor = TurnCount - 1
                Stage = 2
                PlanningTime = Timer() - StartedAt
                Notice = "GPS signal acquired, going to destination..."
                Return

            End If

        End For

    End If

End Sub

Public Function Direction(ByRef Town As Document.State, Leader As P.Vector3,
    StepDistance As Double, Elapsed As Number) As P.Vector3

    Dim Result As P.Vector3
    Dim Point As P.Vector3
    Dim Delta As P.Vector3
    Dim Distance As Double
    Dim NextStop As P.Vector3
    Dim Started As Boolean

    If Stage = 0 Then
        Return Result
    End If

    If (Town.Name <> TownName Or Town.Revision <> Revision Or
        Navigation.Version() <> CollisionVersion) Then
        Call Cancel("Route canceled because the map changed.")

        Return Result
    End If

    If Stage = 1 Or Stage = 3 Then
        Call Plan()

        Return Result
    End If

    If WaypointCursor <> Cursor Then

        Waypoint = Destination

        If Cursor >= 0 Then

            Waypoint = LaneCenter(Queue[Cursor])

            If Not ClearSegment(Leader, Waypoint) Then
                Waypoint = Center(Queue[Cursor])
            End If

        End If

        WaypointCursor = Cursor

    End If

    Do

        If TurnCursor < 0 Then
            Exit Do
        End If

        If Turns[TurnCursor] <= Cursor Then
            Exit Do
        End If

        TurnCursor = TurnCursor - 1

    Loop

    Point = Waypoint
    Delta = M.Subtract(Point, Leader)
    Delta.Y = 0.0
    Distance = M.Length(Delta)

    If Distance < 0.25 Then

        Cursor = Cursor - 1
        Stalled = 0

        If Cursor < -1 Then

            If Stops.Size() > 0 Then
                NextStop = Stops.Take()
                Started = Begin(Town, Leader, NextStop, True)
            Else

                Call Cancel("Destination reached.")
            End If

        End If

        Return Result

    End If

    If M.Length(M.Subtract(Leader, Previous)) < 0.01 Then
        Stalled = Stalled + Elapsed
    Else
        Stalled = 0
    End If

    Previous = Leader

    If Stalled > 2000 Then
        Call Cancel("Route blocked. Choose another road.")

        Return Result
    End If

    Result = M.Scale(Delta, Min(1.0, StepDistance / Distance) / Max(0.001, StepDistance))

    Return Result

End Function

End Module
