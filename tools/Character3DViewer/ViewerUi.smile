''' Character Viewer presentation and calibration-control state, independent from stored key data.
Module Smile.Tools.Character3DViewerUi

Option Explicit

Import Smile.Simple3D.Character3D As Character3D
Import Smile.Simple3D.Graphics3D As Graphics3D
Import Smile.UI.Controls As UI
Import Smile.Tools.Character3DViewerCalibration As ViewerCalibration
Import Smile.Tools.Character3DViewerInput As ViewerInput
Import Smile.Tools.Character3DViewerProfiles As ViewerProfiles

Public Const ANIMATION_BUTTON_Y = 352
Public Const ANIMATION_BUTTON_WIDTH = 70
Public Const ANIMATION_BUTTON_HEIGHT = 18
Public Const ANIMATION_BUTTON_COLUMN_GAP = 8
Public Const ANIMATION_BUTTON_COLUMN_COUNT = 3
Public Const ANIMATION_BUTTON_ROW_GAP = 4
Public Const CAMERA_SLIDER_WIDTH = 146
Public Const CAMERA_SLIDER_HEIGHT = 16
Public Const TIMELINE_LEFT = 18
Public Const TIMELINE_HEIGHT = 18
Public Const TIMELINE_KEYFRAME_HIT_RADIUS = 7
Public Const CALIBRATION_IMPORT_WIDTH = 152
Public Const CALIBRATION_DOWNLOAD_OFFSET = 158
Public Const CALIBRATION_DOWNLOAD_WIDTH = 172
Public Const CALIBRATION_FILENAME_OFFSET = 336
Public Const CALIBRATION_TRANSFER_TEXT_OFFSET = 510
Public Const CALIBRATION_PANEL_X = 18
Public Const CALIBRATION_PANEL_Y = 92
Public Const CALIBRATION_PANEL_WIDTH = 430
Public Const CALIBRATION_PANEL_HEIGHT = 354
Public Const CALIBRATION_SLIDER_X = 34
Public Const CALIBRATION_SLIDER_Y = 204
Public Const CALIBRATION_SLIDER_WIDTH = 360
Public Const CALIBRATION_SLIDER_HEIGHT = 20
Public Const CALIBRATION_TARGET_SWORD_WRIST = 0
Public Const CALIBRATION_TARGET_SHIELD_WRIST = 1
Public Const CALIBRATION_TARGET_SWORD = 2
Public Const CALIBRATION_TARGET_SHIELD = 3
Public Const CALIBRATION_AXIS_X = 0
Public Const CALIBRATION_AXIS_Y = 1
Public Const CALIBRATION_AXIS_Z = 2
Public Const CALIBRATION_TRANSFORM_ROTATE = 0
Public Const CALIBRATION_TRANSFORM_MOVE = 1
Public Const CALIBRATION_ACTION_NONE = 0
Public Const CALIBRATION_ACTION_PREVIOUS_KEY = 1
Public Const CALIBRATION_ACTION_NEXT_KEY = 2
Public Const CALIBRATION_ACTION_WEAPON_WRIST = 3
Public Const CALIBRATION_ACTION_SHIELD_WRIST = 4
Public Const CALIBRATION_ACTION_WEAPON = 5
Public Const CALIBRATION_ACTION_SHIELD = 6
Public Const CALIBRATION_ACTION_AXIS_X = 7
Public Const CALIBRATION_ACTION_AXIS_Y = 8
Public Const CALIBRATION_ACTION_AXIS_Z = 9
Public Const CALIBRATION_ACTION_ROTATE = 10
Public Const CALIBRATION_ACTION_MOVE = 11
Public Const CALIBRATION_ACTION_RESET = 12
Public Const CALIBRATION_ACTION_SAVE = 13
Public Const CALIBRATION_ACTION_CANCEL = 14
Public Const CALIBRATION_ACTION_CLEAR = 15
Public Const CALIBRATION_ACTION_COPY = 16
Public Const CALIBRATION_ACTION_PASTE = 17
Public Const CALIBRATION_ACTION_DELETE = 18
Public Const CALIBRATION_ACTION_RELOAD = 19
Public Const CALIBRATION_ACTION_HOLD_GRIP = 20
Public Const CALIBRATION_ACTION_UNDO = 21
Public Const CALIBRATION_ACTION_DECOUPLE_WEAPON = 22
Public Const CALIBRATION_ACTION_DECOUPLE_SHIELD = 23

Private Const MINIMUM_VIEWER_WIDTH = 800
Private Const MINIMUM_VIEWER_HEIGHT = 540

Public Type State
    Visibility As Number
    CalibrationVisible As Boolean
    CalibrationTarget As Number
    CalibrationAxis As Number
    CalibrationTransform As Number
    CalibrationEditing As Boolean
    CalibrationEditingClip As Number
    CalibrationEditingFrame As Number
    CalibrationAutoOrbitWasEnabled As Boolean
    CalibrationClearConfirm As Boolean
    CalibrationClearAllStage As Number
End Type

Public Sub Reset(ByRef Value As State)

    Value.Visibility = 0
    Value.CalibrationVisible = False
    Value.CalibrationEditing = False
    Value.CalibrationClearConfirm = False
    Value.CalibrationClearAllStage = 0

End Sub

Public Sub ResetCalibration(ByRef Value As State, Target As Number,
    Axis As Number, Transform As Number)

    Value.CalibrationVisible = False
    Value.CalibrationTarget = Target
    Value.CalibrationAxis = Axis
    Value.CalibrationTransform = Transform
    Value.CalibrationEditing = False
    Value.CalibrationClearConfirm = False
    Value.CalibrationClearAllStage = 0

End Sub

Public Sub CycleVisibility(ByRef Value As State)

    Value.Visibility = (Value.Visibility + 1) Mod 3

End Sub

Public Sub BeginCalibrationEdit(ByRef Value As State, Clip As Number,
    Frame As Number, AutoOrbitEnabled As Boolean)

    Value.CalibrationEditing = True
    Value.CalibrationClearConfirm = False
    Value.CalibrationEditingClip = Clip
    Value.CalibrationEditingFrame = Frame
    Value.CalibrationAutoOrbitWasEnabled = AutoOrbitEnabled

End Sub

Public Sub FinishCalibrationEdit(ByRef Value As State)

    Value.CalibrationEditing = False

End Sub

Public Sub BeginClearConfirmation(ByRef Value As State)

    Value.CalibrationClearConfirm = True
    Value.CalibrationClearAllStage = 0

End Sub

Public Sub ClearConfirmation(ByRef Value As State)

    Value.CalibrationClearConfirm = False
    Value.CalibrationClearAllStage = 0

End Sub

Public Function PlaybackLabel(Family As Text, Paused As Boolean,
    PausedVerb As Text) As Text

    Dim Result As Text

    If Paused Then
        Result = "Play " + Family
    Else
        Result = PausedVerb + " " + Family
    End If

    Return Result

End Function

Public Function CalibrationTargetLabel(Target As Number) As Text

    Dim Result As Text

    If Target = 0 Then
        Result = "Weapon Wrist"
    Else If Target = 1 Then
        Result = "Shield Wrist"
    Else If Target = 2 Then
        Result = "Weapon"
    Else
        Result = "Shield"
    End If

    Return Result

End Function

Public Function CalibrationAxisLabel(Axis As Number) As Text

    Dim Result As Text

    If Axis = 0 Then
        Result = "X"
    Else If Axis = 1 Then
        Result = "Y"
    Else
        Result = "Z"
    End If

    Return Result

End Function

Public Function CalibrationTransformLabel(Transform As Number) As Text

    Dim Result As Text

    If Transform = 1 Then
        Result = "Move"
    Else
        Result = "Rotate"
    End If

    Return Result

End Function

Public Function CalibrationUnitLabel(Transform As Number) As Text

    Dim Result As Text

    If Transform = 1 Then
        Result = "units"
    Else
        Result = "degrees"
    End If

    Return Result

End Function

Public Function CalibrationResetClipLabel(Confirming As Boolean) As Text

    Dim Result As Text

    If Confirming Then
        Result = "Confirm Current Clip?"
    Else
        Result = "Delete All Key Frames"
    End If

    Return Result

End Function

Public Function CalibrationResetAllLabel(Stage As Number) As Text

    Dim Result As Text

    If Stage = 1 Then
        Result = "Confirm All?"
    Else If Stage >= 2 Then
        Result = "Really Clear?"
    Else
        Result = "Reset All"
    End If

    Return Result

End Function

Public Function BackgroundLabel(Index As Number) As Text

    Dim Result As Text

    If Index = 1 Then
        Result = "BG GREEN"
    Else If Index = 2 Then
        Result = "BG PURPLE"
    Else If Index = 3 Then
        Result = "BG SCENE"
    Else If Index = 4 Then
        Result = "BG LOGO"
    Else
        Result = "BG BLACK"
    End If

    Return Result

End Function

Public Function DragonLabel(Inspection As Boolean, Available As Boolean,
    Visible As Boolean) As Text

    Dim Result As Text

    If Inspection Then

        Result = "VFX ON"

        If Not Visible Then
            Result = "VFX OFF"
        End If

    Else If Not Available Then

        Result = "NO DRAGON"

    Else If Visible Then

        Result = "DRAGON ON"

    Else
        Result = "DRAGON OFF"

    End If

    Return Result

End Function

Public Function MaterialInspectionLabel(Inspection As Number) As Text

    Dim Result As Text

    If Inspection = Graphics3D.MATERIAL_INSPECTION_LIT Then
        Result = "Lit"
    Else If Inspection = Graphics3D.MATERIAL_INSPECTION_BASE_COLOR Then
        Result = "Base Color"
    Else If Inspection = Graphics3D.MATERIAL_INSPECTION_NORMAL Then
        Result = "Normal"
    Else If Inspection = Graphics3D.MATERIAL_INSPECTION_ROUGHNESS Then
        Result = "Roughness"
    Else If Inspection = Graphics3D.MATERIAL_INSPECTION_METALLIC Then
        Result = "Metallic"
    Else If Inspection = Graphics3D.MATERIAL_INSPECTION_OCCLUSION Then
        Result = "Occlusion"
    Else
        Result = "Emissive"
    End If

    Return Result

End Function

Public Function DemoLabel(PartyEnabled As Boolean, ScenePaused As Boolean,
    DemoEnabled As Boolean) As Text

    Dim Result As Text

    If PartyEnabled And ScenePaused Then
        Result = "RESUME"
    Else If PartyEnabled Then
        Result = "PAUSE"
    Else If DemoEnabled Then
        Result = "DEMO ON"
    Else
        Result = "DEMO OFF"
    End If

    Return Result

End Function

Public Function DemoStatusLabel(PartyEnabled As Boolean,
    ScenePaused As Boolean, DemoEnabled As Boolean) As Text

    Dim Result As Text

    If PartyEnabled And ScenePaused Then
        Result = "Paused"
    Else If DemoEnabled Then
        Result = "On"
    Else
        Result = "Off"
    End If

    Return Result

End Function

Public Function PartyRoleLabel(Role As Text) As Text

    Dim Result As Text

    Result = Role

    If Result = "" Then
        Result = "Technical"
    End If

    Return Result

End Function

Public Function StatusPanelX(WindowWidth As Number) As Number

    Dim Result As Number

    Result = Max(492, WindowWidth - 268)

    Return Result

End Function

Public Function AnimationButtonX(WindowWidth As Number) As Number

    Dim Result As Number

    Result = StatusPanelX(WindowWidth) + 12

    Return Result

End Function

Public Function GlowButtonX(WindowWidth As Number, DiagnosticProfiles As Boolean,
    PartyEnabled As Boolean) As Number

    Dim Result As Number

    Result = StatusPanelX(WindowWidth) + 162

    If DiagnosticProfiles And Not PartyEnabled Then
        Result = StatusPanelX(WindowWidth) + 216
    End If

    Return Result

End Function

Public Function GlowButtonWidth(DiagnosticProfiles As Boolean,
    PartyEnabled As Boolean) As Number

    Dim Result As Number

    Result = 90

    If DiagnosticProfiles And Not PartyEnabled Then
        Result = 36
    End If

    Return Result

End Function

Public Function TimelineWidth(WindowWidth As Number, TimelineLeft As Number) As Number

    Dim Result As Number

    Result = Max(120, StatusPanelX(WindowWidth) - TimelineLeft - 20)

    Return Result

End Function

Public Function LayoutTooSmall(WindowWidth As Number, WindowHeight As Number) As Boolean

    Dim Result As Boolean

    Result = WindowWidth < MINIMUM_VIEWER_WIDTH Or WindowHeight < MINIMUM_VIEWER_HEIGHT

    Return Result

End Function

Public Function CalibrationPointerAction(PointerX As Number, PointerY As Number,
    PrimaryPressed As Boolean, Target As Number) As Number

    Dim Result As Number

    If Not PrimaryPressed Then
        Return Result
    End If

    If InRectangle(PointerX, PointerY, 292, 96, 68, 22) Then
        Result = CALIBRATION_ACTION_PREVIOUS_KEY
    Else If InRectangle(PointerX, PointerY, 364, 96, 68, 22) Then
        Result = CALIBRATION_ACTION_NEXT_KEY
    Else If InRectangle(PointerX, PointerY, 34, 128, 92, 24) Then
        Result = CALIBRATION_ACTION_WEAPON_WRIST
    Else If InRectangle(PointerX, PointerY, 130, 128, 96, 24) Then
        Result = CALIBRATION_ACTION_SHIELD_WRIST
    Else If InRectangle(PointerX, PointerY, 230, 128, 76, 24) Then
        Result = CALIBRATION_ACTION_WEAPON
    Else If InRectangle(PointerX, PointerY, 310, 128, 76, 24) Then
        Result = CALIBRATION_ACTION_SHIELD
    Else If InRectangle(PointerX, PointerY, 34, 158, 48, 24) Then
        Result = CALIBRATION_ACTION_AXIS_X
    Else If InRectangle(PointerX, PointerY, 86, 158, 48, 24) Then
        Result = CALIBRATION_ACTION_AXIS_Y
    Else If InRectangle(PointerX, PointerY, 138, 158, 48, 24) Then
        Result = CALIBRATION_ACTION_AXIS_Z
    Else If InRectangle(PointerX, PointerY, 202, 158, 72, 24) Then
        Result = CALIBRATION_ACTION_ROTATE
    Else If (InRectangle(PointerX, PointerY, 278, 158, 72, 24) And
        Target >= CALIBRATION_TARGET_SWORD) Then
        Result = CALIBRATION_ACTION_MOVE
    Else If InRectangle(PointerX, PointerY, 354, 158, 78, 24) Then
        Result = CALIBRATION_ACTION_RESET
    Else If InRectangle(PointerX, PointerY, 332, 412, 100, 24) Then
        Result = CALIBRATION_ACTION_SAVE
    Else If InRectangle(PointerX, PointerY, 244, 412, 84, 24) Then
        Result = CALIBRATION_ACTION_CANCEL
    Else If InRectangle(PointerX, PointerY, 34, 412, 196, 24) Then
        Result = CALIBRATION_ACTION_CLEAR
    Else If InRectangle(PointerX, PointerY, 34, 268, 80, 24) Then
        Result = CALIBRATION_ACTION_COPY
    Else If InRectangle(PointerX, PointerY, 118, 268, 80, 24) Then
        Result = CALIBRATION_ACTION_PASTE
    Else If InRectangle(PointerX, PointerY, 202, 268, 90, 24) Then
        Result = CALIBRATION_ACTION_DELETE
    Else If InRectangle(PointerX, PointerY, 34, 298, 100, 24) Then
        Result = CALIBRATION_ACTION_RELOAD
    Else If InRectangle(PointerX, PointerY, 140, 298, 100, 24) Then
        Result = CALIBRATION_ACTION_HOLD_GRIP
    Else If InRectangle(PointerX, PointerY, 246, 298, 186, 24) Then
        Result = CALIBRATION_ACTION_UNDO
    Else If InRectangle(PointerX, PointerY, 34, 374, 194, 24) Then
        Result = CALIBRATION_ACTION_DECOUPLE_WEAPON
    Else If InRectangle(PointerX, PointerY, 236, 374, 196, 24) Then
        Result = CALIBRATION_ACTION_DECOUPLE_SHIELD
    End If

    Return Result

End Function

Public Function ApplyCalibrationSelection(ByRef Value As State,
    Action As Number) As Boolean

    Dim Result As Boolean

    Result = True

    If Action = CALIBRATION_ACTION_WEAPON_WRIST Then
        Value.CalibrationTarget = CALIBRATION_TARGET_SWORD_WRIST
        Value.CalibrationTransform = CALIBRATION_TRANSFORM_ROTATE
    Else If Action = CALIBRATION_ACTION_SHIELD_WRIST Then
        Value.CalibrationTarget = CALIBRATION_TARGET_SHIELD_WRIST
        Value.CalibrationTransform = CALIBRATION_TRANSFORM_ROTATE
    Else If Action = CALIBRATION_ACTION_WEAPON Then
        Value.CalibrationTarget = CALIBRATION_TARGET_SWORD
    Else If Action = CALIBRATION_ACTION_SHIELD Then
        Value.CalibrationTarget = CALIBRATION_TARGET_SHIELD
    Else If Action = CALIBRATION_ACTION_AXIS_X Then
        Value.CalibrationAxis = CALIBRATION_AXIS_X
    Else If Action = CALIBRATION_ACTION_AXIS_Y Then
        Value.CalibrationAxis = CALIBRATION_AXIS_Y
    Else If Action = CALIBRATION_ACTION_AXIS_Z Then
        Value.CalibrationAxis = CALIBRATION_AXIS_Z
    Else If Action = CALIBRATION_ACTION_ROTATE Then
        Value.CalibrationTransform = CALIBRATION_TRANSFORM_ROTATE
    Else If Action = CALIBRATION_ACTION_MOVE Then
        Value.CalibrationTransform = CALIBRATION_TRANSFORM_MOVE
    Else
        Result = False
    End If

    Return Result

End Function

Public Sub DrawCharacterStatusSummary(
    PanelLeft As Number,
    DisplayName As Text,
    PartyRole As Text,
    ClipLabel As Text,
    CandidateVersion As Text,
    PlaybackSpeed As Number,
    MaterialInspection As Number,
    DrawCallCount As Number,
    TriangleCount As Number,
    DemoStatus As Text,
    SecondsRemaining As Number,
    ZoomDegrees As Number,
    FramesPerSecond As Number
)

    Dim PanelText As Number

    PanelText = PanelLeft + 16

    Draw Text "CHARACTER STATUS" At PanelText, 96 Size 16 Color WHITE
    Draw Text "Name" At PanelText, 124 Size 12 Color LIGHT_GRAY
    Draw Text DisplayName At PanelLeft + 116, 124 Size 12 Color CYAN
    Draw Text "Party Role" At PanelText, 146 Size 12 Color LIGHT_GRAY
    Draw Text PartyRoleLabel(PartyRole) At PanelLeft + 116, 146 Size 12 Color CYAN
    Draw Text "Animation" At PanelText, 168 Size 12 Color LIGHT_GRAY
    Draw Text ClipLabel At PanelLeft + 116, 168 Size 12 Color GREEN
    Draw Text "Candidate" At PanelText, 190 Size 12 Color LIGHT_GRAY
    Draw Text CandidateVersion At PanelLeft + 116, 190 Size 11 Color YELLOW
    Draw Text "Speed" At PanelText, 216 Size 12 Color LIGHT_GRAY
    Draw Number PlaybackSpeed At PanelLeft + 116, 216 Size 12 Color WHITE

    Call UI.DrawButton(PanelLeft + 172, 204, 30, 24, "-", False)
    Call UI.DrawButton(PanelLeft + 208, 204, 30, 24, "+", False)

    Draw Text "Material" At PanelText, 240 Size 12 Color LIGHT_GRAY
    Draw Text MaterialInspectionLabel(MaterialInspection) At PanelLeft + 116, 240 Size 12 Color YELLOW
    Draw Text "Draws / Triangles" At PanelText, 262 Size 12 Color LIGHT_GRAY
    Draw Number DrawCallCount At PanelLeft + 148, 262 Size 12 Color WHITE
    Draw Number TriangleCount At PanelLeft + 192, 262 Size 12 Color WHITE
    Draw Text "Demo / Next" At PanelText, 284 Size 12 Color LIGHT_GRAY
    Draw Text DemoStatus At PanelLeft + 116, 284 Size 12 Color CYAN
    Draw Number SecondsRemaining At PanelLeft + 172, 284 Size 12 Color WHITE
    Draw Text "seconds" At PanelLeft + 192, 284 Size 11 Color LIGHT_GRAY
    Draw Text "Zoom / FPS" At PanelText, 306 Size 12 Color LIGHT_GRAY
    Draw Number ZoomDegrees At PanelLeft + 116, 306 Size 12 Color CYAN
    Draw Text "level" At PanelLeft + 146, 306 Size 11 Color LIGHT_GRAY
    Draw Number FramesPerSecond At PanelLeft + 190, 306 Size 12 Color GREEN
    Draw Text "fps" At PanelLeft + 216, 306 Size 11 Color LIGHT_GRAY

End Sub

Public Sub DrawCameraControls(PanelLeft As Number, WindowHeight As Number,
    HorizontalOrbit As Number, VerticalOrbit As Number, ZoomDegrees As Number,
    ZoomInLimit As Number, ZoomOutLimit As Number)

    Call DrawCameraSlider(PanelLeft, "H Orbit", WindowHeight - 142,
        HorizontalOrbit, -180, 180)
    Call DrawCameraSlider(PanelLeft, "V Orbit", WindowHeight - 116,
        VerticalOrbit, -180, 180)
    Call DrawCameraSlider(PanelLeft, "Zoom", WindowHeight - 90,
        ZoomDegrees, ZoomInLimit, ZoomOutLimit)

End Sub

Public Sub DrawAnimationButtons(ProfileIndex As Number,
    SelectedPresentationIndex As Number, WindowWidth As Number)

    Dim ButtonX As Number
    Dim ButtonY As Number
    Dim ClipCount As Number
    Dim Column As Number
    Dim Index As Number
    Dim Row As Number

    ClipCount = ViewerProfiles.ClipCount(ProfileIndex)

    For Index = 0 To ClipCount - 1

        Column = Index Mod ANIMATION_BUTTON_COLUMN_COUNT
        Row = Index / ANIMATION_BUTTON_COLUMN_COUNT
        ButtonX = AnimationButtonX(WindowWidth)
        ButtonX = ButtonX + Column * (ANIMATION_BUTTON_WIDTH + ANIMATION_BUTTON_COLUMN_GAP)
        ButtonY = ANIMATION_BUTTON_Y
        ButtonY = ButtonY + Row * (ANIMATION_BUTTON_HEIGHT + ANIMATION_BUTTON_ROW_GAP)

        Call UI.DrawButton(
            ButtonX,
            ButtonY,
            ANIMATION_BUTTON_WIDTH,
            ANIMATION_BUTTON_HEIGHT,
            ViewerProfiles.ClipLabel(ProfileIndex, Index),
            Index = SelectedPresentationIndex
        )
    End For

End Sub

Public Sub DrawCalibrationPanel(
    ByRef Value As State,
    ByRef Calibration As ViewerCalibration.State,
    SelectedClip As Number,
    SelectedClipLabel As Text,
    SelectedClipName As Text,
    CurrentFrame As Number,
    CurrentKeyframe As Number,
    CurrentValue As Number,
    MinimumValue As Number,
    MaximumValue As Number,
    GizmoVisible As Boolean,
    HoldGrip As Boolean,
    GripLimit As Boolean,
    ScenePaused As Boolean,
    WeaponDecoupled As Boolean,
    ShieldDecoupled As Boolean
)

    Call UI.DrawPanel(CALIBRATION_PANEL_X, CALIBRATION_PANEL_Y,
        CALIBRATION_PANEL_WIDTH, CALIBRATION_PANEL_HEIGHT, 90)

    Draw Text "Pose Calibration" At 32, 102 Size 16 Color WHITE
    Draw Text SelectedClipLabel At 174, 104 Size 12 Color CYAN

    Call UI.DrawButton(292, 96, 68, 22, "Prev Key", False)
    Call UI.DrawButton(364, 96, 68, 22, "Next Key", False)
    Call UI.DrawButton(34, 128, 92, 24, "Weapon Wrist",
        Value.CalibrationTarget = CALIBRATION_TARGET_SWORD_WRIST)
    Call UI.DrawButton(130, 128, 96, 24, "Shield Wrist",
        Value.CalibrationTarget = CALIBRATION_TARGET_SHIELD_WRIST)
    Call UI.DrawButton(230, 128, 76, 24, "Weapon",
        Value.CalibrationTarget = CALIBRATION_TARGET_SWORD)
    Call UI.DrawButton(310, 128, 76, 24, "Shield",
        Value.CalibrationTarget = CALIBRATION_TARGET_SHIELD)
    Call UI.DrawButton(34, 158, 48, 24, "X", Value.CalibrationAxis = CALIBRATION_AXIS_X)
    Call UI.DrawButton(86, 158, 48, 24, "Y", Value.CalibrationAxis = CALIBRATION_AXIS_Y)
    Call UI.DrawButton(138, 158, 48, 24, "Z", Value.CalibrationAxis = CALIBRATION_AXIS_Z)
    Call UI.DrawButton(202, 158, 72, 24, "Rotate",
        Value.CalibrationTransform = CALIBRATION_TRANSFORM_ROTATE)
    Call UI.DrawButton(278, 158, 72, 24, "Move",
        Value.CalibrationTransform = CALIBRATION_TRANSFORM_MOVE)
    Call UI.DrawButton(354, 158, 78, 24, "Reset", False)

    Draw Text CalibrationTargetLabel(Value.CalibrationTarget) At 34, 187 Size 12 Color LIGHT_GRAY
    Draw Text CalibrationTransformLabel(Value.CalibrationTransform) At 142, 187 Size 12 Color CYAN
    Draw Text CalibrationAxisLabel(Value.CalibrationAxis) At 208, 187 Size 12 Color CYAN
    Draw Number CurrentValue At 230, 187 Size 12 Color WHITE
    Draw Text CalibrationUnitLabel(Value.CalibrationTransform) At 274, 187 Size 11 Color LIGHT_GRAY

    Call UI.DrawSlider(CALIBRATION_SLIDER_X, CALIBRATION_SLIDER_Y,
        CALIBRATION_SLIDER_WIDTH, CALIBRATION_SLIDER_HEIGHT,
        CurrentValue, MinimumValue, MaximumValue, 6)

    If GizmoVisible Then
        Draw Text "G Move  •  R/E Rotate  •  X/Y/Z Constrain" At 34, 232 Size 11 Color WHITE
        Draw Text "Enter Confirm/Save  •  Esc Cancel  •  Drag Colored Handles" At 34, 248 Size 10 Color LIGHT_GRAY
    Else
        Draw Text "Numeric Controls  •  X/Y/Z Select Axis" At 34, 232 Size 11 Color WHITE
        Draw Text "Enter Save  •  Esc Cancel  •  Show Gizmo For Mouse Handles" At 34, 248 Size 10 Color LIGHT_GRAY
    End If

    Call UI.DrawButton(34, 268, 80, 24, "Copy Key", CurrentKeyframe >= 0 And Not Value.CalibrationEditing)
    Call UI.DrawButton(118, 268, 80, 24, "Paste Key", Calibration.ClipboardAvailable And Not Value.CalibrationEditing)
    Call UI.DrawButton(202, 268, 90, 24, "Delete Key", CurrentKeyframe >= 0 And Not Value.CalibrationEditing)

    If GizmoVisible Then
        Call UI.DrawButton(300, 268, 132, 24, "Hide Gizmo", True)
    Else

        Call UI.DrawButton(300, 268, 132, 24, "Show Gizmo", False)
    End If

    Call UI.DrawButton(34, 298, 100, 24, "Reload Key", CurrentKeyframe >= 0)
    Call UI.DrawButton(140, 298, 100, 24, "In Place", HoldGrip)
    Call UI.DrawButton(246, 298, 186, 24, "Undo Last Change", Calibration.UndoCount > 0)
    Call UI.DrawButton(34, 374, 194, 24, "Decouple Weapon", WeaponDecoupled)
    Call UI.DrawButton(236, 374, 196, 24, "Decouple Shield", ShieldDecoupled)
    Call UI.DrawButton(34, 412, 196, 24,
        CalibrationResetClipLabel(Value.CalibrationClearConfirm),
        Value.CalibrationClearConfirm)
    Call UI.DrawButton(332, 412, 100, 24, "Save Frame",
        CurrentKeyframe >= 0 And Not Value.CalibrationEditing)
    Call UI.DrawButton(244, 412, 84, 24, "Cancel", Value.CalibrationEditing)

    Fill Rectangle 34, 412, 196, 2, Rgb(210, 70, 76) Opacity 90
    Fill Rectangle 34, 434, 196, 2, Rgb(210, 70, 76) Opacity 90
    Fill Rectangle 34, 412, 2, 24, Rgb(210, 70, 76) Opacity 90
    Fill Rectangle 228, 412, 2, 24, Rgb(210, 70, 76) Opacity 90

    If Calibration.StorageRejected Then

        Draw Text "Storage blocked; no saved data replaced. See status." At 34, 330 Size 10 Color YELLOW

    Else If Calibration.WriteFailed Then

        Draw Text "Save failed; previous keys kept. Retry or Cancel." At 34, 330 Size 10 Color YELLOW

    Else If Value.CalibrationClearConfirm Then

        Draw Text "Delete saved keys for:" At 34, 330 Size 10 Color YELLOW
        Draw Text SelectedClipName At 188, 330 Size 10 Color WHITE
        Draw Number ViewerCalibration.KeyCount(Calibration, SelectedClip) At 350, 330 Size 10 Color YELLOW

    Else If GripLimit Then

        Draw Text "In Place reached the saved position limit" At 34, 330 Size 10 Color YELLOW

    Else If Value.CalibrationEditing Then

        If ScenePaused Then
            Draw Text "Editing — movement paused by Space" At 34, 330 Size 11 Color YELLOW
        Else
            Draw Text "Editing live — Space pauses movement" At 34, 330 Size 11 Color YELLOW
        End If

    Else
        Draw Text "In Place: rotate equipment without shifting its grip" At 34, 330 Size 10 Color LIGHT_GRAY

    End If

    If Calibration.SaveLimitReached Then

        Draw Text "Keyframe limit reached" At 34, 350 Size 11 Color YELLOW

    Else

        Draw Text "Keys" At 34, 350 Size 11 Color LIGHT_GRAY
        Draw Number ViewerCalibration.KeyCount(Calibration, SelectedClip) At 68, 350 Size 11 Color CYAN

        If Value.CalibrationEditing Then
            Draw Text "Editing frame" At 104, 350 Size 11 Color YELLOW
            Draw Number Value.CalibrationEditingFrame At 200, 350 Size 11 Color WHITE
        Else
            Draw Text "Current frame" At 104, 350 Size 11 Color LIGHT_GRAY
            Draw Number CurrentFrame At 200, 350 Size 11 Color WHITE
        End If

        If CurrentKeyframe >= 0 Then
            Draw Text "KEYED" At 230, 350 Size 11 Color GREEN
        End If

    End If

End Sub

Public Sub DrawTimeline(
    ByRef Actor As Character3D.Actor,
    ByRef Calibration As ViewerCalibration.State,
    ByRef Input As ViewerInput.State,
    SelectedClip As Number,
    SelectedClipName As Text,
    SelectedTimelineEvent As Number,
    CalibrationAvailable As Boolean,
    WindowWidth As Number,
    WindowHeight As Number
)

    Dim Duration As Number
    Dim EventIndex As Number
    Dim EventTime As Number
    Dim Keyframe As Number
    Dim KeyframeFrame As Number
    Dim KeyframeTime As Number
    Dim MarkerX As Number
    Dim ProgressWidth As Number
    Dim TimelineY As Number
    Dim Width As Number

    Duration = Max(1, Character3D.ClipDuration(Actor, SelectedClip))
    TimelineY = WindowHeight - 64
    Width = TimelineWidth(WindowWidth, TIMELINE_LEFT)
    ProgressWidth = Character3D.AnimationTime(Actor) * Width / Duration

    Call UI.DrawButton(TIMELINE_LEFT, WindowHeight - 96, 62, 24, "0-Frame", False)
    Call UI.DrawButton(TIMELINE_LEFT + 68, WindowHeight - 96, 62, 24, "< Key", False)
    Call UI.DrawButton(TIMELINE_LEFT + 136, WindowHeight - 96, 62, 24, "Key >", False)
    Call UI.DrawButton(TIMELINE_LEFT + 204, WindowHeight - 96, 62, 24,
        "< Frame", Input.FrameButtonRepeatDirection < 0)
    Call UI.DrawButton(TIMELINE_LEFT + 272, WindowHeight - 96, 62, 24,
        "Frame >", Input.FrameButtonRepeatDirection > 0)

    Draw Text SelectedClipName At TIMELINE_LEFT + 348, WindowHeight - 88 Size 11 Color CYAN

    If SelectedTimelineEvent > 0 Then

        Draw Text Character3D.EventName(Actor, SelectedTimelineEvent) At TIMELINE_LEFT + 518, WindowHeight - 88 Size 11 Color YELLOW
        Draw Number Character3D.EventTime(Actor, SelectedTimelineEvent) At TIMELINE_LEFT + 616, WindowHeight - 88 Size 11 Color WHITE
        Draw Number Character3D.EventValue(Actor, SelectedTimelineEvent) At TIMELINE_LEFT + 672, WindowHeight - 88 Size 11 Color CYAN

    Else
        Draw Text "No authored event" At TIMELINE_LEFT + 518, WindowHeight - 88 Size 11 Color LIGHT_GRAY

    End If

    Fill Rectangle TIMELINE_LEFT, TimelineY, Width, TIMELINE_HEIGHT, Rgb(18, 35, 58) Opacity 88
    Fill Rectangle TIMELINE_LEFT, TimelineY, ProgressWidth, TIMELINE_HEIGHT, Rgb(16, 102, 136) Opacity 90

    For EventIndex = 1 To Character3D.EventCount(Actor)

        If Character3D.EventClipIndex(Actor, EventIndex) = SelectedClip Then

            EventTime = Character3D.EventTime(Actor, EventIndex)
            MarkerX = TIMELINE_LEFT + EventTime * Width / Duration

            Fill Rectangle MarkerX, TimelineY - 3, 2, TIMELINE_HEIGHT + 6, YELLOW Opacity 100

        End If

    End For

    If CalibrationAvailable Then

        For Keyframe = 0 To ViewerCalibration.KeyCount(Calibration, SelectedClip) - 1

            KeyframeFrame = ViewerCalibration.KeyFrame(Calibration, SelectedClip, Keyframe)

            If (Input.TimelineKeyframeDragging And
                Keyframe = Input.TimelineDraggedKeyframe) Then
                KeyframeFrame = Input.TimelineDraggedTargetFrame
            End If

            KeyframeTime = ViewerCalibration.FrameTimeMilliseconds(
                Actor, SelectedClip, KeyframeFrame)
            MarkerX = TIMELINE_LEFT + KeyframeTime * Width / Duration

            Fill Rectangle MarkerX - 1, TimelineY - 5, 3, TIMELINE_HEIGHT + 10, GREEN Opacity 100
        End For

    End If

    Draw Number Character3D.AnimationTime(Actor) At TIMELINE_LEFT + 6, TimelineY + 3 Size 10 Color WHITE
    Draw Number Duration At TIMELINE_LEFT + Width - 48, TimelineY + 3 Size 10 Color WHITE

    If CalibrationAvailable Then

        If Calibration.ImportPending Then
            Call UI.DrawButton(TIMELINE_LEFT, WindowHeight - 43,
                CALIBRATION_IMPORT_WIDTH, 18, "Replace Keys?", True)
        Else

            Call UI.DrawButton(TIMELINE_LEFT, WindowHeight - 43,
                CALIBRATION_IMPORT_WIDTH, 18, "Import Key Frames", False)
        End If

        Call UI.DrawButton(TIMELINE_LEFT + CALIBRATION_DOWNLOAD_OFFSET, WindowHeight - 43,
            CALIBRATION_DOWNLOAD_WIDTH, 18, "Download Key Frames", False)

        Draw Text Calibration.FileLabel At TIMELINE_LEFT + CALIBRATION_FILENAME_OFFSET, WindowHeight - 39 Size 9 Color LIGHT_GRAY

        If (Text_Width(Calibration.TransferMessage, 9) <=
            Width - CALIBRATION_TRANSFER_TEXT_OFFSET) Then
            Draw Text Calibration.TransferMessage At TIMELINE_LEFT + CALIBRATION_TRANSFER_TEXT_OFFSET, WindowHeight - 39 Size 9 Color CYAN
        End If

    End If

End Sub

Private Sub DrawCameraSlider(PanelLeft As Number, Label As Text, Y As Number,
    Value As Number, MinimumValue As Number, MaximumValue As Number)

    Draw Text Label At PanelLeft + 12, Y + 2 Size 11 Color LIGHT_GRAY

    Call UI.DrawSlider(PanelLeft + 76, Y, CAMERA_SLIDER_WIDTH, CAMERA_SLIDER_HEIGHT,
        Value, MinimumValue, MaximumValue)

    Draw Number Value At PanelLeft + 226, Y + 2 Size 10 Color CYAN

End Sub

Private Function InRectangle(PointerX As Number, PointerY As Number,
    X As Number, Y As Number, Width As Number, Height As Number) As Boolean

    Dim Result As Boolean

    Result = PointerX >= X And PointerX < X + Width
    Result = Result And PointerY >= Y And PointerY < Y + Height

    Return Result

End Function

End Module
