Public Type State
    Visibility As Number
    CalibrationVisible As Boolean
    CalibrationTarget As Number
    CalibrationAxis As Number
    CalibrationTransform As Number
    CalibrationEditing As Boolean
    CalibrationEditingClip As Number
    CalibrationEditingFrame As Number
    CalibrationAutoOrbitWasEnabled As Boolean
    CalibrationClearConfirm As Boolean
    CalibrationClearAllStage As Number
End Type

Public Type SliderUpdate
    Consumed As Boolean
    Changed As Boolean
    Action As Number
    Value As Number
End Type

Public Sub Reset(ByRef Value As State)

    Value.Visibility = 0
    Value.CalibrationVisible = False
    Value.CalibrationEditing = False
    Value.CalibrationClearConfirm = False
    Value.CalibrationClearAllStage = 0

End Sub

Public Function UpdateCameraSliders(ByRef DragOwner As Number,
    Visibility As Number, PanelLeft As Number, WindowHeight As Number,
    HorizontalOrbit As Number, VerticalOrbit As Number, Zoom As Number,
    ZoomInLimit As Number, ZoomOutLimit As Number) As SliderUpdate

    Dim CurrentValue As Number
    Dim Result As SliderUpdate

    If Visibility <> 0 Then
        Return Result
    End If

    CurrentValue = HorizontalOrbit

    If UI.UpdateSlider(
        DragOwner,
        SLIDER_ACTION_HORIZONTAL_ORBIT,
        PanelLeft + 76,
        WindowHeight - 142,
        CAMERA_SLIDER_WIDTH,
        CAMERA_SLIDER_HEIGHT,
        -180,
        180,
        1,
        CurrentValue
    ) Then

        Result.Consumed = True
        Result.Changed = CurrentValue <> HorizontalOrbit
        Result.Action = SLIDER_ACTION_HORIZONTAL_ORBIT
        Result.Value = CurrentValue

        Return Result

    End If

    CurrentValue = VerticalOrbit

    If UI.UpdateSlider(
        DragOwner,
        SLIDER_ACTION_VERTICAL_ORBIT,
        PanelLeft + 76,
        WindowHeight - 116,
        CAMERA_SLIDER_WIDTH,
        CAMERA_SLIDER_HEIGHT,
        -180,
        180,
        1,
        CurrentValue
    ) Then

        Result.Consumed = True
        Result.Changed = CurrentValue <> VerticalOrbit
        Result.Action = SLIDER_ACTION_VERTICAL_ORBIT
        Result.Value = CurrentValue

        Return Result

    End If

    CurrentValue = Zoom

    If UI.UpdateSlider(
        DragOwner,
        SLIDER_ACTION_ZOOM,
        PanelLeft + 76,
        WindowHeight - 90,
        CAMERA_SLIDER_WIDTH,
        CAMERA_SLIDER_HEIGHT,
        ZoomInLimit,
        ZoomOutLimit,
        -1,
        CurrentValue
    ) Then

        Result.Consumed = True
        Result.Changed = CurrentValue <> Zoom
        Result.Action = SLIDER_ACTION_ZOOM
        Result.Value = CurrentValue

    End If

    Return Result

End Function

Public Function UpdateCalibrationSlider(ByRef DragOwner As Number,
    CurrentCalibrationValue As Number,
    MinimumValue As Number, MaximumValue As Number) As SliderUpdate

    Dim CurrentValue As Number
    Dim Result As SliderUpdate

    CurrentValue = CurrentCalibrationValue

    If UI.UpdateSlider(
        DragOwner,
        SLIDER_ACTION_CALIBRATION,
        CALIBRATION_SLIDER_X,
        CALIBRATION_SLIDER_Y,
        CALIBRATION_SLIDER_WIDTH,
        CALIBRATION_SLIDER_HEIGHT,
        MinimumValue,
        MaximumValue,
        1,
        CurrentValue
    ) Then

        Result.Consumed = True
        Result.Changed = CurrentValue <> CurrentCalibrationValue
        Result.Action = SLIDER_ACTION_CALIBRATION
        Result.Value = CurrentValue

    End If

    Return Result

End Function

Public Sub ResetCalibration(ByRef Value As State, Target As Number,
    Axis As Number, Transform As Number)

    Value.CalibrationVisible = False
    Value.CalibrationTarget = Target
    Value.CalibrationAxis = Axis
    Value.CalibrationTransform = Transform
    Value.CalibrationEditing = False
    Value.CalibrationClearConfirm = False
    Value.CalibrationClearAllStage = 0

End Sub

Public Sub CycleVisibility(ByRef Value As State)

    Value.Visibility = (Value.Visibility + 1) Mod 3

End Sub

Public Function ToggleCalibrationPanel(ByRef Value As State,
    Available As Boolean) As Boolean

    Dim ReturnValue As Boolean

    Value.CalibrationVisible = Available And Not Value.CalibrationVisible

    ReturnValue = Value.CalibrationVisible

    Return ReturnValue

End Function

Public Sub SetCalibrationVisible(ByRef Value As State, Visible As Boolean,
    Available As Boolean)

    Value.CalibrationVisible = Visible And Available

End Sub

Public Sub HideCalibration(ByRef Value As State)

    Value.CalibrationVisible = False

End Sub

Public Sub BeginCalibrationEdit(ByRef Value As State, Clip As Number,
    Frame As Number, AutoOrbitEnabled As Boolean)

    Value.CalibrationEditing = True
    Value.CalibrationClearConfirm = False
    Value.CalibrationEditingClip = Clip
    Value.CalibrationEditingFrame = Frame
    Value.CalibrationAutoOrbitWasEnabled = AutoOrbitEnabled

End Sub

Public Sub FinishCalibrationEdit(ByRef Value As State)

    Value.CalibrationEditing = False

End Sub

Public Sub BeginClearConfirmation(ByRef Value As State)

    Value.CalibrationClearConfirm = True
    Value.CalibrationClearAllStage = 0

End Sub

Public Sub ClearConfirmation(ByRef Value As State)

    Value.CalibrationClearConfirm = False
    Value.CalibrationClearAllStage = 0

End Sub

Public Function PlaybackLabel(Family As Text, Paused As Boolean,
    PausedVerb As Text) As Text

    Dim Result As Text

    If Paused Then
        Result = "Play " + Family
    Else
        Result = PausedVerb + " " + Family
    End If

    Return Result

End Function

Public Function CalibrationTargetLabel(Target As Number) As Text

    Dim Result As Text

    If Target = 0 Then
        Result = "Weapon Wrist"
    Else If Target = 1 Then
        Result = "Shield Wrist"
    Else If Target = 2 Then
        Result = "Weapon"
    Else
        Result = "Shield"
    End If

    Return Result

End Function

Public Function CalibrationAxisLabel(Axis As Number) As Text

    Dim Result As Text

    If Axis = 0 Then
        Result = "X"
    Else If Axis = 1 Then
        Result = "Y"
    Else
        Result = "Z"
    End If

    Return Result

End Function

Public Function CalibrationTransformLabel(Transform As Number) As Text

    Dim Result As Text

    If Transform = 1 Then
        Result = "Move"
    Else
        Result = "Rotate"
    End If

    Return Result

End Function

Public Function CalibrationUnitLabel(Transform As Number) As Text

    Dim Result As Text

    If Transform = 1 Then
        Result = "units"
    Else
        Result = "degrees"
    End If

    Return Result

End Function

Public Function CalibrationResetClipLabel(Confirming As Boolean) As Text

    Dim Result As Text

    If Confirming Then
        Result = "Confirm Current Clip?"
    Else
        Result = "Delete All Key Frames"
    End If

    Return Result

End Function

Public Function CalibrationResetAllLabel(Stage As Number) As Text

    Dim Result As Text

    If Stage = 1 Then
        Result = "Confirm All?"
    Else If Stage >= 2 Then
        Result = "Really Clear?"
    Else
        Result = "Reset All"
    End If

    Return Result

End Function

Public Function BackgroundLabel(Index As Number) As Text

    Dim Result As Text

    If Index = 1 Then
        Result = "BG GREEN"
    Else If Index = 2 Then
        Result = "BG PURPLE"
    Else If Index = 3 Then
        Result = "BG SCENE"
    Else If Index = 4 Then
        Result = "BG LOGO"
    Else
        Result = "BG BLACK"
    End If

    Return Result

End Function

Public Function DragonLabel(Inspection As Boolean, Available As Boolean,
    Visible As Boolean) As Text

    Dim Result As Text

    If Inspection Then

        Result = "VFX ON"

        If Not Visible Then
            Result = "VFX OFF"
        End If

    Else If Not Available Then

        Result = "NO DRAGON"

    Else If Visible Then

        Result = "DRAGON ON"

    Else
        Result = "DRAGON OFF"

    End If

    Return Result

End Function

Public Function MaterialInspectionLabel(Inspection As Number) As Text

    Dim Result As Text

    If Inspection = Graphics3D.MATERIAL_INSPECTION_LIT Then
        Result = "Lit"
    Else If Inspection = Graphics3D.MATERIAL_INSPECTION_BASE_COLOR Then
        Result = "Base Color"
    Else If Inspection = Graphics3D.MATERIAL_INSPECTION_NORMAL Then
        Result = "Normal"
    Else If Inspection = Graphics3D.MATERIAL_INSPECTION_ROUGHNESS Then
        Result = "Roughness"
    Else If Inspection = Graphics3D.MATERIAL_INSPECTION_METALLIC Then
        Result = "Metallic"
    Else If Inspection = Graphics3D.MATERIAL_INSPECTION_OCCLUSION Then
        Result = "Occlusion"
    Else
        Result = "Emissive"
    End If

    Return Result

End Function

Public Function DemoLabel(PartyEnabled As Boolean, ScenePaused As Boolean,
    DemoEnabled As Boolean) As Text

    Dim Result As Text

    If PartyEnabled And ScenePaused Then
        Result = "RESUME"
    Else If PartyEnabled Then
        Result = "PAUSE"
    Else If DemoEnabled Then
        Result = "DEMO ON"
    Else
        Result = "DEMO OFF"
    End If

    Return Result

End Function

Public Function DemoStatusLabel(PartyEnabled As Boolean,
    ScenePaused As Boolean, DemoEnabled As Boolean) As Text

    Dim Result As Text

    If PartyEnabled And ScenePaused Then
        Result = "Paused"
    Else If DemoEnabled Then
        Result = "On"
    Else
        Result = "Off"
    End If

    Return Result

End Function

Public Function PartyRoleLabel(Role As Text) As Text

    Dim Result As Text

    Result = Role

    If Result = "" Then
        Result = "Technical"
    End If

    Return Result

End Function

Public Function StatusPanelX(WindowWidth As Number) As Number

    Dim Result As Number

    Result = Max(492, WindowWidth - 268)

    Return Result

End Function

Public Function AnimationButtonX(WindowWidth As Number) As Number

    Dim Result As Number

    Result = StatusPanelX(WindowWidth) + 12

    Return Result

End Function

Public Function GlowButtonX(WindowWidth As Number, DiagnosticProfiles As Boolean,
    PartyEnabled As Boolean) As Number

    Dim Result As Number

    Result = StatusPanelX(WindowWidth) + 162

    If DiagnosticProfiles And Not PartyEnabled Then
        Result = StatusPanelX(WindowWidth) + 216
    End If

    Return Result

End Function

Public Function GlowButtonWidth(DiagnosticProfiles As Boolean,
    PartyEnabled As Boolean) As Number

    Dim Result As Number

    Result = 90

    If DiagnosticProfiles And Not PartyEnabled Then
        Result = 36
    End If

    Return Result

End Function

Public Function TimelineWidth(WindowWidth As Number, TimelineLeft As Number) As Number

    Dim Result As Number

    Result = Max(120, StatusPanelX(WindowWidth) - TimelineLeft - 20)

    Return Result

End Function

Public Function TimelineFrameAtPointer(PointerX As Number, WindowWidth As Number,
    Duration As Number, SampleRate As Number, SampleCount As Number) As Number

    Dim Result As Number
    Dim TargetTime As Number

    TargetTime = (PointerX - TIMELINE_LEFT) * Duration
    TargetTime = TargetTime / Max(1, TimelineWidth(WindowWidth, TIMELINE_LEFT))
    TargetTime = Max(0, Min(Duration, TargetTime))
    Result = (TargetTime * Max(1, SampleRate) + 500) / 1000
    Result = Min(SampleCount - 1, Max(0, Result))

    Return Result

End Function

Public Function TimelineKeyframeAtPointer(
    ByRef Actor As Character3D.Actor,
    ByRef Calibration As ViewerCalibration.State,
    CalibrationAvailable As Boolean,
    SelectedClip As Number,
    PointerX As Number,
    PointerY As Number,
    WindowWidth As Number,
    WindowHeight As Number
) As Number

    Dim Duration As Number
    Dim Index As Number
    Dim KeyframeTime As Number
    Dim MarkerX As Number
    Dim Result As Number
    Dim TimelineY As Number
    Dim Width As Number

    Result = -1

    If Not CalibrationAvailable Then
        Return Result
    End If

    TimelineY = WindowHeight - 64
    Width = TimelineWidth(WindowWidth, TIMELINE_LEFT)

    If Not InRectangle(
        PointerX,
        PointerY,
        TIMELINE_LEFT,
        TimelineY - TIMELINE_KEYFRAME_HIT_RADIUS,
        Width,
        TIMELINE_HEIGHT + TIMELINE_KEYFRAME_HIT_RADIUS * 2
    ) Then
        Return Result
    End If

    Duration = Max(1, Character3D.ClipDuration(Actor, SelectedClip))

    For Index = 0 To ViewerCalibration.KeyCount(Calibration, SelectedClip) - 1

        KeyframeTime = ViewerCalibration.FrameTimeMilliseconds(
            Actor,
            SelectedClip,
            ViewerCalibration.KeyFrame(Calibration, SelectedClip, Index)
        )
        MarkerX = TIMELINE_LEFT + KeyframeTime * Width / Duration

        If Abs(PointerX - MarkerX) <= TIMELINE_KEYFRAME_HIT_RADIUS Then
            Result = Index
            Exit For
        End If

    End For

    Return Result

End Function

Public Function LayoutTooSmall(WindowWidth As Number, WindowHeight As Number) As Boolean

    Dim Result As Boolean

    Result = WindowWidth < MINIMUM_VIEWER_WIDTH Or WindowHeight < MINIMUM_VIEWER_HEIGHT

    Return Result

End Function

Public Function CharacterTabsContain(PointerX As Number, PointerY As Number) As Boolean

    Dim Result As Boolean

    Result = InRectangle(PointerX, PointerY, 18, 62, 404, 26)

    Return Result

End Function

Public Function CharacterTabAtPointer(PointerX As Number, PointerY As Number) As Number

    Dim Result As Number

    Result = -1

    If InRectangle(PointerX, PointerY, 104, 62, 72, 26) Then
        Result = 0
    Else If InRectangle(PointerX, PointerY, 182, 62, 72, 26) Then
        Result = 1
    Else If InRectangle(PointerX, PointerY, 260, 62, 72, 26) Then
        Result = 2
    Else If InRectangle(PointerX, PointerY, 338, 62, 72, 26) Then
        Result = 3
    End If

    Return Result

End Function

Public Function TimelineContains(PointerX As Number, PointerY As Number,
    WindowWidth As Number, WindowHeight As Number) As Boolean

    Dim Result As Boolean

    Result = InRectangle(
        PointerX, PointerY,
        TIMELINE_LEFT, WindowHeight - 64,
        TimelineWidth(WindowWidth, TIMELINE_LEFT), TIMELINE_HEIGHT)

    Return Result

End Function

Public Function CalibrationGizmoButtonContains(PointerX As Number,
    PointerY As Number) As Boolean

    Dim Result As Boolean

    Result = InRectangle(PointerX, PointerY, 300, 268, 132, 24)

    Return Result

End Function

Public Function TransferActionAtPointer(PointerX As Number, PointerY As Number,
    WindowHeight As Number, CalibrationAvailable As Boolean,
    FileLabelWidth As Number) As Number

    Dim Result As Number

    Result = TRANSFER_ACTION_NONE

    If Not CalibrationAvailable Then
        Return Result
    End If

    If InRectangle(PointerX, PointerY,
        TIMELINE_LEFT + CALIBRATION_DOWNLOAD_OFFSET, WindowHeight - 43,
        CALIBRATION_DOWNLOAD_WIDTH, 18) Then
        Result = TRANSFER_ACTION_DOWNLOAD
    Else If InRectangle(PointerX, PointerY, TIMELINE_LEFT, WindowHeight - 43,
        CALIBRATION_IMPORT_WIDTH, 18) Then
        Result = TRANSFER_ACTION_IMPORT
    Else If InRectangle(PointerX, PointerY,
        TIMELINE_LEFT + CALIBRATION_FILENAME_OFFSET, WindowHeight - 40,
        FileLabelWidth, 14) Then
        Result = TRANSFER_ACTION_OPEN
    End If

    Return Result

End Function

Public Function CalibrationPanelContains(PointerX As Number, PointerY As Number,
    Visibility As Number, CalibrationAvailable As Boolean,
    CalibrationVisible As Boolean) As Boolean

    Dim Result As Boolean

    Result = Visibility = 0 And CalibrationAvailable And CalibrationVisible
    Result = Result And InRectangle(
        PointerX, PointerY,
        CALIBRATION_PANEL_X, CALIBRATION_PANEL_Y,
        CALIBRATION_PANEL_WIDTH, CALIBRATION_PANEL_HEIGHT)

    Return Result

End Function

Public Function InspectorBlocksScene(PointerX As Number, PointerY As Number,
    WindowWidth As Number, WindowHeight As Number, Visibility As Number) As Boolean

    Dim PanelLeft As Number
    Dim Result As Boolean

    PanelLeft = StatusPanelX(WindowWidth)
    Result = PointerY < 90 Or PointerY >= WindowHeight - 100
    Result = Result Or (Visibility = 0 And PointerX >= PanelLeft And PointerY >= 82)

    Return Result

End Function

Public Function InspectorActionAtPointer(
    PointerX As Number,
    PointerY As Number,
    WindowWidth As Number,
    WindowHeight As Number,
    Visibility As Number,
    DiagnosticProfiles As Boolean,
    PartyEnabled As Boolean,
    ProfileIndex As Number,
    SwordFireReady As Boolean,
    KeyframeIndex As Number
) As Number

    Dim AnimationIndex As Number
    Dim PanelLeft As Number
    Dim Result As Number

    PanelLeft = StatusPanelX(WindowWidth)
    Result = INSPECTOR_ACTION_NONE

    If InRectangle(PointerX, PointerY, TIMELINE_LEFT, WindowHeight - 96, 62, 24) Then

        Result = INSPECTOR_ACTION_FIRST_FRAME

    Else If InRectangle(PointerX, PointerY,
        TIMELINE_LEFT + 68, WindowHeight - 96, 62, 24) Then

        Result = INSPECTOR_ACTION_PREVIOUS_KEY

    Else If InRectangle(PointerX, PointerY,
        TIMELINE_LEFT + 136, WindowHeight - 96, 62, 24) Then

        Result = INSPECTOR_ACTION_NEXT_KEY

    Else If InRectangle(PointerX, PointerY,
        TIMELINE_LEFT + 204, WindowHeight - 96, 62, 24) Then

        Result = INSPECTOR_ACTION_PREVIOUS_FRAME

    Else If InRectangle(PointerX, PointerY,
        TIMELINE_LEFT + 272, WindowHeight - 96, 62, 24) Then

        Result = INSPECTOR_ACTION_NEXT_FRAME

    Else If KeyframeIndex >= 0 Then

        Result = INSPECTOR_ACTION_KEYFRAME

    Else If InRectangle(PointerX, PointerY, TIMELINE_LEFT, WindowHeight - 64,
        TimelineWidth(WindowWidth, TIMELINE_LEFT), TIMELINE_HEIGHT) Then

        Result = INSPECTOR_ACTION_TIMELINE

    Else If Visibility <> 0 Then

        Return Result

    Else If InRectangle(PointerX, PointerY, PanelLeft, 18, 44, 34) Then

        Result = INSPECTOR_ACTION_LIGHTING

    Else If InRectangle(PointerX, PointerY, PanelLeft + 48, 18, 56, 34) Then

        Result = INSPECTOR_ACTION_MATERIAL

    Else If InRectangle(PointerX, PointerY, PanelLeft + 108, 18, 50, 34) Then

        Result = INSPECTOR_ACTION_SOCKET

    Else If (DiagnosticProfiles And
        Not PartyEnabled And
        InRectangle(PointerX, PointerY, PanelLeft + 162, 18, 50, 34)) Then

        Result = INSPECTOR_ACTION_PROFILE

    Else If InRectangle(PointerX, PointerY,
        GlowButtonX(WindowWidth, DiagnosticProfiles, PartyEnabled), 18,
        GlowButtonWidth(DiagnosticProfiles, PartyEnabled), 34) Then

        Result = INSPECTOR_ACTION_GLOW

    Else If InRectangle(PointerX, PointerY, PanelLeft, 56, 72, 22) Then

        Result = INSPECTOR_ACTION_DRAGON

    Else If InRectangle(PointerX, PointerY, PanelLeft + 76, 56, 48, 22) Then

        Result = INSPECTOR_ACTION_BACKGROUND

    Else If InRectangle(PointerX, PointerY, PanelLeft + 128, 56, 36, 22) Then

        Result = INSPECTOR_ACTION_CALIBRATION

    Else If InRectangle(PointerX, PointerY, PanelLeft + 168, 56, 40, 22) Then

        Result = INSPECTOR_ACTION_SWORD

    Else If InRectangle(PointerX, PointerY, PanelLeft + 212, 56, 40, 22) Then

        Result = INSPECTOR_ACTION_SHIELD

    Else If InRectangle(PointerX, PointerY, PanelLeft + 178, 330, 74, 18) Then

        Result = INSPECTOR_ACTION_DEMO

    Else If InRectangle(PointerX, PointerY, PanelLeft + 12, 444, 78, 22) Then

        Result = INSPECTOR_ACTION_FLOOR

    Else If InRectangle(PointerX, PointerY, PanelLeft + 94, 444, 76, 22) Then

        If ProfileIndex = ViewerProfiles.PROFILE_DRAGON Then
            Result = INSPECTOR_ACTION_DRAGON_HEAD
        Else If ProfileIndex = ViewerProfiles.PROFILE_ORIN Then
            Result = INSPECTOR_ACTION_STORM_STYLE
        Else
            Result = INSPECTOR_ACTION_SWORD_FIRE
        End If

    Else If InRectangle(PointerX, PointerY, PanelLeft + 174, 444, 78, 22) Then

        If ProfileIndex = ViewerProfiles.PROFILE_DRAGON Then
            Result = INSPECTOR_ACTION_DRAGON_TARGET
        Else If ProfileIndex = ViewerProfiles.PROFILE_ORIN Then
            Result = INSPECTOR_ACTION_STORM_STYLE
        Else
            Result = INSPECTOR_ACTION_SHIELD_FIRE
        End If

    Else If (ProfileIndex = ViewerProfiles.PROFILE_ORIN And
        InRectangle(PointerX, PointerY, PanelLeft + 12, 470, 128, 20)) Then

        Result = INSPECTOR_ACTION_STORM_COMFORT

    Else If (ProfileIndex = ViewerProfiles.PROFILE_ORIN And
        InRectangle(PointerX, PointerY, PanelLeft + 144, 470, 108, 20)) Then

        Result = INSPECTOR_ACTION_LIGHTNING_PAUSE

    Else If (SwordFireReady And
        InRectangle(PointerX, PointerY, PanelLeft + 12, 470, 128, 20)) Then

        Result = INSPECTOR_ACTION_FLAME_PAUSE

    Else If (ProfileIndex = ViewerProfiles.PROFILE_ARIN And
        InRectangle(PointerX, PointerY, PanelLeft + 144, 470, 108, 20)) Then

        Result = INSPECTOR_ACTION_SHIELD_FIRE_STYLE

    Else If InRectangle(PointerX, PointerY, PanelLeft + 172, 204, 30, 24) Then

        Result = INSPECTOR_ACTION_SPEED_DOWN

    Else If InRectangle(PointerX, PointerY, PanelLeft + 208, 204, 30, 24) Then

        Result = INSPECTOR_ACTION_SPEED_UP

    Else If InRectangle(PointerX, PointerY,
        PanelLeft + 12, WindowHeight - 64, 52, 24) Then

        Result = INSPECTOR_ACTION_RESET_VIEW

    Else If InRectangle(PointerX, PointerY,
        PanelLeft + 68, WindowHeight - 64, 74, 24) Then

        Result = INSPECTOR_ACTION_RESTART_PRESENTATION

    Else If InRectangle(PointerX, PointerY,
        PanelLeft + 146, WindowHeight - 64, 40, 24) Then

        Result = INSPECTOR_ACTION_RESET_ALL

    Else If InRectangle(PointerX, PointerY,
        PanelLeft + 190, WindowHeight - 64, 50, 24) Then

        Result = INSPECTOR_ACTION_FIT

    Else
        AnimationIndex = AnimationButtonAtPointer(
            PointerX, PointerY, ProfileIndex, WindowWidth)

        If AnimationIndex >= 0 Then
            Result = INSPECTOR_ACTION_CLIP_BASE + AnimationIndex
        End If

    End If

    Return Result

End Function

Public Function CalibrationPointerAction(PointerX As Number, PointerY As Number,
    PrimaryPressed As Boolean, Target As Number) As Number

    Dim Result As Number

    If Not PrimaryPressed Then
        Return Result
    End If

    If InRectangle(PointerX, PointerY, 292, 96, 68, 22) Then
        Result = CALIBRATION_ACTION_PREVIOUS_KEY
    Else If InRectangle(PointerX, PointerY, 364, 96, 68, 22) Then
        Result = CALIBRATION_ACTION_NEXT_KEY
    Else If InRectangle(PointerX, PointerY, 34, 128, 92, 24) Then
        Result = CALIBRATION_ACTION_WEAPON_WRIST
    Else If InRectangle(PointerX, PointerY, 130, 128, 96, 24) Then
        Result = CALIBRATION_ACTION_SHIELD_WRIST
    Else If InRectangle(PointerX, PointerY, 230, 128, 76, 24) Then
        Result = CALIBRATION_ACTION_WEAPON
    Else If InRectangle(PointerX, PointerY, 310, 128, 76, 24) Then
        Result = CALIBRATION_ACTION_SHIELD
    Else If InRectangle(PointerX, PointerY, 34, 158, 48, 24) Then
        Result = CALIBRATION_ACTION_AXIS_X
    Else If InRectangle(PointerX, PointerY, 86, 158, 48, 24) Then
        Result = CALIBRATION_ACTION_AXIS_Y
    Else If InRectangle(PointerX, PointerY, 138, 158, 48, 24) Then
        Result = CALIBRATION_ACTION_AXIS_Z
    Else If InRectangle(PointerX, PointerY, 202, 158, 72, 24) Then
        Result = CALIBRATION_ACTION_ROTATE
    Else If (InRectangle(PointerX, PointerY, 278, 158, 72, 24) And
        Target >= CALIBRATION_TARGET_SWORD) Then
        Result = CALIBRATION_ACTION_MOVE
    Else If InRectangle(PointerX, PointerY, 354, 158, 78, 24) Then
        Result = CALIBRATION_ACTION_RESET
    Else If InRectangle(PointerX, PointerY, 332, 412, 100, 24) Then
        Result = CALIBRATION_ACTION_SAVE
    Else If InRectangle(PointerX, PointerY, 244, 412, 84, 24) Then
        Result = CALIBRATION_ACTION_CANCEL
    Else If InRectangle(PointerX, PointerY, 34, 412, 196, 24) Then
        Result = CALIBRATION_ACTION_CLEAR
    Else If InRectangle(PointerX, PointerY, 34, 268, 80, 24) Then
        Result = CALIBRATION_ACTION_COPY
    Else If InRectangle(PointerX, PointerY, 118, 268, 80, 24) Then
        Result = CALIBRATION_ACTION_PASTE
    Else If InRectangle(PointerX, PointerY, 202, 268, 90, 24) Then
        Result = CALIBRATION_ACTION_DELETE
    Else If InRectangle(PointerX, PointerY, 34, 298, 100, 24) Then
        Result = CALIBRATION_ACTION_RELOAD
    Else If InRectangle(PointerX, PointerY, 140, 298, 100, 24) Then
        Result = CALIBRATION_ACTION_HOLD_GRIP
    Else If InRectangle(PointerX, PointerY, 246, 298, 186, 24) Then
        Result = CALIBRATION_ACTION_UNDO
    Else If InRectangle(PointerX, PointerY, 34, 374, 194, 24) Then
        Result = CALIBRATION_ACTION_DECOUPLE_WEAPON
    Else If InRectangle(PointerX, PointerY, 236, 374, 196, 24) Then
        Result = CALIBRATION_ACTION_DECOUPLE_SHIELD
    End If

    Return Result

End Function

Public Function CalibrationValueAtPointer(PointerX As Number,
    MinimumValue As Number, MaximumValue As Number) As Number

    Dim Result As Number

    Result = (PointerX - CALIBRATION_SLIDER_X) * (MaximumValue - MinimumValue)
    Result = Result / CALIBRATION_SLIDER_WIDTH + MinimumValue

    Return Result

End Function

Public Function ApplyCalibrationSelection(ByRef Value As State,
    Action As Number) As Boolean

    Dim Result As Boolean

    Result = True

    If Action = CALIBRATION_ACTION_WEAPON_WRIST Then
        Value.CalibrationTarget = CALIBRATION_TARGET_SWORD_WRIST
        Value.CalibrationTransform = CALIBRATION_TRANSFORM_ROTATE
    Else If Action = CALIBRATION_ACTION_SHIELD_WRIST Then
        Value.CalibrationTarget = CALIBRATION_TARGET_SHIELD_WRIST
        Value.CalibrationTransform = CALIBRATION_TRANSFORM_ROTATE
    Else If Action = CALIBRATION_ACTION_WEAPON Then
        Value.CalibrationTarget = CALIBRATION_TARGET_SWORD
    Else If Action = CALIBRATION_ACTION_SHIELD Then
        Value.CalibrationTarget = CALIBRATION_TARGET_SHIELD
    Else If Action = CALIBRATION_ACTION_AXIS_X Then
        Value.CalibrationAxis = CALIBRATION_AXIS_X
    Else If Action = CALIBRATION_ACTION_AXIS_Y Then
        Value.CalibrationAxis = CALIBRATION_AXIS_Y
    Else If Action = CALIBRATION_ACTION_AXIS_Z Then
        Value.CalibrationAxis = CALIBRATION_AXIS_Z
    Else If Action = CALIBRATION_ACTION_ROTATE Then
        Value.CalibrationTransform = CALIBRATION_TRANSFORM_ROTATE
    Else If Action = CALIBRATION_ACTION_MOVE Then
        Value.CalibrationTransform = CALIBRATION_TRANSFORM_MOVE
    Else
        Result = False
    End If

    Return Result

End Function

Public Sub DrawMinimumSizeNotice(WindowWidth As Number, WindowHeight As Number)

    Fill Rectangle 0, 0, WindowWidth, WindowHeight, Rgb(4, 9, 24) Opacity 92
    Draw Text "CHARACTER VIEWER NEEDS MORE ROOM" At 28, 40 Size 22 Color YELLOW
    Draw Text "Resize to at least 800 by 540 logical units." At 28, 78 Size 15 Color WHITE
    Draw Text "Right-click still resets the scene." At 28, 108 Size 13 Color LIGHT_GRAY

End Sub

Public Sub DrawHeader(DisplayName As Text, PartyRole As Text,
    PartyEnabled As Boolean, SelectedCharacterTab As Number, WindowWidth As Number)

    Dim Subtitle As Text

    If WindowWidth < 1100 Then
        Subtitle = DisplayName + "  •  "
        Subtitle = Subtitle + PartyRoleLabel(PartyRole) + "  •  PBR"
    Else
        Subtitle = DisplayName + "  •  Party role: "
        Subtitle = Subtitle + PartyRoleLabel(PartyRole) + "  •  Renderer3D PBR"
    End If

    Draw Text "SMILE 2.0 - 3D Viewer, Animation Editor" At 18, 10 Size 22 Color WHITE

    If PartyEnabled Then
        Subtitle = "Sin Star I  •  Arin And Orin  •  Party Battle Preview"
    End If

    Draw Text Subtitle At 18, 42 Size 13 Color LIGHT_GRAY
    Draw Text "Character" At 18, 68 Size 13 Color WHITE

    Call UI.DrawButton(104, 62, 72, 26, "Arin", SelectedCharacterTab = 0)
    Call UI.DrawButton(182, 62, 72, 26, "Orin", SelectedCharacterTab = 1)
    Call UI.DrawButton(260, 62, 72, 26, "Dragon", SelectedCharacterTab = 2)
    Call UI.DrawButton(338, 62, 72, 26, "Party", SelectedCharacterTab = 3)

End Sub

Public Sub DrawInspectorToolbar(
    WindowWidth As Number,
    WindowHeight As Number,
    DiagnosticProfiles As Boolean,
    PartyEnabled As Boolean,
    SocketGizmosVisible As Boolean,
    EpicGlowVisible As Boolean,
    DragonControlLabel As Text,
    DragonVisible As Boolean,
    BackgroundControlLabel As Text,
    BackgroundVisible As Boolean,
    CalibrationAvailable As Boolean,
    CalibrationVisible As Boolean,
    SwordVisible As Boolean,
    ShieldVisible As Boolean
)

    Dim PanelLeft As Number

    PanelLeft = StatusPanelX(WindowWidth)

    Call UI.DrawButton(PanelLeft, 18, 44, 34, "LIGHT", False)
    Call UI.DrawButton(PanelLeft + 48, 18, 56, 34, "CHANNEL", False)
    Call UI.DrawButton(PanelLeft + 108, 18, 50, 34, "SOCKET", SocketGizmosVisible)

    If DiagnosticProfiles And Not PartyEnabled Then
        Call UI.DrawButton(PanelLeft + 162, 18, 50, 34, "PROFILE", False)
    End If

    Call UI.DrawButton(
        GlowButtonX(WindowWidth, DiagnosticProfiles, PartyEnabled),
        18,
        GlowButtonWidth(DiagnosticProfiles, PartyEnabled),
        34,
        "GLOW",
        EpicGlowVisible
    )
    Call UI.DrawButton(PanelLeft, 56, 72, 22, DragonControlLabel, DragonVisible)
    Call UI.DrawButton(PanelLeft + 76, 56, 48, 22,
        BackgroundControlLabel, BackgroundVisible)

    If CalibrationAvailable Then
        Call UI.DrawButton(PanelLeft + 128, 56, 36, 22, "Pose", CalibrationVisible)
    Else
        Draw Text "Pose" At PanelLeft + 132, 62 Size 10 Color GRAY
    End If

    Call UI.DrawButton(PanelLeft + 168, 56, 40, 22, "Weapon", SwordVisible)
    Call UI.DrawButton(PanelLeft + 212, 56, 40, 22, "Shield", ShieldVisible)

    Call UI.DrawPanel(PanelLeft, 82, 252, Max(446, WindowHeight - 94))

End Sub

Public Sub DrawDemoControl(PanelLeft As Number, PartyEnabled As Boolean,
    ScenePaused As Boolean, DemoEnabled As Boolean)

    Draw Text "ANIMATIONS" At PanelLeft + 16, 334 Size 13 Color WHITE

    Call UI.DrawButton(PanelLeft + 178, 330, 74, 18,
        DemoLabel(PartyEnabled, ScenePaused, DemoEnabled), DemoEnabled)

End Sub

Public Sub DrawProfileEffectControls(
    WindowWidth As Number,
    ProfileIndex As Number,
    FloorOrGridVisible As Boolean,
    SwordFireVisible As Boolean,
    ShieldFireVisible As Boolean,
    StormStyleLabel As Text,
    StormComfortLabel As Text,
    LightningPlaybackLabel As Text,
    LightningPaused As Boolean,
    DragonHeadTracking As Boolean,
    DragonTargetsArin As Boolean,
    SwordFireReady As Boolean,
    FlamePlaybackLabel As Text,
    FlamePlaying As Boolean,
    ShieldFireStyleLabel As Text,
    ShieldFlameStyle As Boolean
)

    Dim PanelLeft As Number

    PanelLeft = StatusPanelX(WindowWidth)

    Call UI.DrawButton(PanelLeft + 12, 444, 78, 22, "Floor/Grid", FloorOrGridVisible)

    If ProfileIndex = ViewerProfiles.PROFILE_ARIN Then

        Call UI.DrawButton(PanelLeft + 94, 444, 76, 22, "Sword Fire", SwordFireVisible)
        Call UI.DrawButton(PanelLeft + 174, 444, 78, 22, "Shield Fire", ShieldFireVisible)

    Else If ProfileIndex = ViewerProfiles.PROFILE_ORIN Then

        Call UI.DrawButton(PanelLeft + 94, 444, 158, 22, StormStyleLabel, True)
        Call UI.DrawButton(PanelLeft + 12, 470, 128, 20, StormComfortLabel, True)
        Call UI.DrawButton(PanelLeft + 144, 470, 108, 20,
            LightningPlaybackLabel, LightningPaused)

    Else If ProfileIndex = ViewerProfiles.PROFILE_DRAGON Then

        Call UI.DrawButton(PanelLeft + 94, 444, 76, 22, "Head Aim", DragonHeadTracking)

        If DragonTargetsArin Then
            Call UI.DrawButton(PanelLeft + 174, 444, 78, 22, "At Arin", True)
        Else

            Call UI.DrawButton(PanelLeft + 174, 444, 78, 22, "At Orin", True)
        End If

    End If

    If SwordFireReady And ProfileIndex = ViewerProfiles.PROFILE_ARIN Then
        Call UI.DrawButton(PanelLeft + 12, 470, 128, 20,
            FlamePlaybackLabel, FlamePlaying)
        Call UI.DrawButton(PanelLeft + 144, 470, 108, 20,
            ShieldFireStyleLabel, Not ShieldFlameStyle)
    End If

End Sub

Public Sub DrawAnimationDetails(
    PanelLeft As Number,
