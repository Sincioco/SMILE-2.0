Public Sub DrawFooterMessage(WindowWidth As Number, WindowHeight As Number,
    CalibrationAvailable As Boolean, TransferMessage As Text)

    If (CalibrationAvailable And
        Text_Width(TransferMessage, 9) >
            TimelineWidth(WindowWidth, TIMELINE_LEFT) - CALIBRATION_TRANSFER_TEXT_OFFSET) Then
        Draw Text TransferMessage At TIMELINE_LEFT, WindowHeight - 22 Size 9 Color CYAN
    Else
        Draw Text "LMB pan  •  MMB orbit  •  Wheel zoom  •  Space pause  •  RMB reset  •  D dragon  •  W sword  •  S shield" At 16, WindowHeight - 22 Size 11 Color LIGHT_GRAY
    End If

End Sub

Public Sub DrawPauseStatus(PanelLeft As Number, CalibrationEditing As Boolean,
    ScenePaused As Boolean, CharacterSwitchBlocked As Boolean, PartyEnabled As Boolean)

    If (CalibrationEditing Or
        ScenePaused Or
        CharacterSwitchBlocked) Then
        Fill Rectangle 18, 40, Max(0, PanelLeft - 24), 18, Rgb(4, 9, 24)
    End If

    If CharacterSwitchBlocked Then

        Draw Text "Save Or Cancel The Pose Before Switching" At 18, 42 Size 12 Color YELLOW

    Else If CalibrationEditing Then

        If PartyEnabled Then
            Draw Text "Pose Edit Active - Save Or Cancel Before Resuming" At 18, 42 Size 12 Color YELLOW
        Else If ScenePaused Then
            Draw Text "Pose Edit Active - Space To Resume" At 18, 42 Size 12 Color YELLOW
        Else
            Draw Text "Pose Edit Active - Space To Pause Movement" At 18, 42 Size 12 Color YELLOW
        End If

    Else If ScenePaused Then

        Draw Text "Paused - Space To Resume; Camera Controls Remain Active" At 18, 42 Size 12 Color YELLOW

    End If

End Sub

Public Sub DrawRecoveryOverlay(Visibility As Number, ViewerError As Boolean,
    FirstViewerError As Number, FirstRendererError As Number,
    FirstFailureStage As Number)

    If Visibility <> 0 Or Not ViewerError Then
        Return
    End If

    Fill Rectangle 120, 142, 580, 210, Rgb(56, 8, 18) Opacity 80
    Draw Text "CHARACTER VIEWER RECOVERY" At 148, 166 Size 22 Color WHITE
    Draw Text "The 3D renderer or character resource became unavailable." At 148, 204 Size 14 Color LIGHT_GRAY
    Draw Text "Viewer error" At 148, 238 Size 13 Color LIGHT_GRAY
    Draw Number FirstViewerError At 270, 238 Size 13 Color YELLOW
    Draw Text "Renderer error" At 348, 238 Size 13 Color LIGHT_GRAY
    Draw Number FirstRendererError At 486, 238 Size 13 Color YELLOW
    Draw Text "Failure stage" At 148, 270 Size 13 Color LIGHT_GRAY
    Draw Number FirstFailureStage At 270, 270 Size 13 Color YELLOW
    Draw Text "Press Enter or click Reset to reload the profile safely." At 148, 310 Size 14 Color CYAN

End Sub

