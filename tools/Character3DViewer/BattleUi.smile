''' Bottom-center battle controls. Planning and combat own all game decisions.
Module Smile.Tools.ViewerBattleUi

Option Explicit

Import Smile.Tools.ViewerBattlePlanning As Planning
Import SinStarI.BattleRules As Rules
Import SinStarI.BattleAttacks As Attacks
Import SinStarI.BattleUI As Icons
Import SinStarI.Progression As Growth
Import SinStarI.StatsView As StatsView
Import Smile.Tools.ViewerBattleGrowthView As GrowthView
Import Smile.UI.Controls As UI

Public Type State
    Page As Number
    Selection As Number
    PendingMagic As Number
    Stats As StatsView.State
End Type

Public Function PanelLeft() As Number

    If Window_Width() >= 1100 Then
        Return 278
    End If

    Return 18

End Function

Public Function PanelWidth() As Number

    Dim Result As Number

    Result = (Window_Width() - PanelLeft() * 2) / 5
    Return Result

End Function

Public Function PanelTop() As Number

    Dim Result As Number

    Result = Window_Height() - 245
    Return Result

End Function

Private Function Rows(Page As Number, Actor As Number) As Number

    Dim Result As Number

    Result = 3

    If Page = 1 Then
        Result = 6
    Else If Page = 2 Then
        Result = Attacks.AttackCount(Actor)
    Else If Page = 3 Then
        Result = 2
    Else If Page = 4 Then
        Result = 4
    Else If Page = 5 Then
        Result = 1
    End If

    Return Result

End Function

Private Function MenuTop(Page As Number, Actor As Number) As Number

    Dim Result As Number

    Result = PanelTop() + 30

    If Page > 0 Then
        Result = PanelTop() - Rows(Page, Actor) * 32 + 20
    End If

    Return Result

End Function

Private Function MenuCommand(Index As Number) As Number

    If Index = 1 Then
        Return Rules.FIRE
    Else If Index = 2 Then
        Return Rules.ITEM
    Else If Index = 3 Then
        Return Rules.DEFEND
    Else If Index = 4 Then
        Return Rules.LIMIT_BREAK
    Else If Index = 5 Then
        Return Rules.RUN
    End If

    Return Rules.ATTACK

End Function

Private Function Enabled(Page As Number, Battle As Rules.State, Index As Number) As Boolean

    Dim Result As Boolean

    Result = True

    If Page = 1 And Index >= 3 Then
        Result = Rules.CanCommand(Battle.Members[Battle.Turn], MenuCommand(Index))
    Else If Page = 3 Then
        Result = Rules.CanCommand(Battle.Members[Battle.Turn], Rules.MagicFor(Battle.Turn, Index))
    Else If Page = 4 Then
        Result = Rules.Available(Battle.Members[Index])
    End If

    Return Result

End Function

Private Function Label(Page As Number, Battle As Rules.State, Index As Number) As Text

    Dim Result As Text
    Dim Command As Number

    If Page = 0 Then

        If Index = 0 Then
            Return "Fight"
        Else If Index = 1 Then
            Return "Order"
        End If

        Return "Auto"

    Else If Page = 1 Then

        Select Case Index
            Case 0
                Return "Fight >"
            Case 1
                Return "Magic >"
            Case 2
                Return "Item >"
            Case 3
                Return "Defend +300%"
            Case 4
                Return "Limit Break"
        End Select

        Return "Run"

    Else If Page = 2 Then

        Result = Attacks.Label(Battle.Turn, Index)

    Else If Page = 3 Then

        Command = Rules.MagicFor(Battle.Turn, Index)
        Result = Rules.CommandName(Command) + " " + Growth.NumberText(Rules.Cost(Command)) + " MP"

    Else If Page = 4 Then

        Result = Growth.Name(Index) + " " + Growth.NumberText(Battle.Members[Index].HP) + " HP"

    Else

        Result = "No Items Yet - Back"

    End If

    Return Result

End Function

Public Sub Accept(ByRef Value As State, ByRef Encounter As Planning.State)

    Dim Accepted As Boolean
    Dim Turn As Number

    Turn = Encounter.Combat.Turn

    If Not Enabled(Value.Page, Encounter.Combat, Value.Selection) Then
        Return
    End If

    If Value.Page = 0 Then

        If Value.Selection = 0 Then
            Call Planning.Repeat(Encounter)
        Else If Value.Selection = 1 Then
            Value.Page = 1
            Value.Selection = 0
        Else

            Call Planning.BeginRound(Encounter)
        End If

    Else If Value.Page = 1 Then

        If Value.Selection <= 2 Then

            Value.Page = Value.Selection + 2

            If Value.Selection = 2 Then
                Value.Page = 5
            End If

            Value.Selection = 0

            If Value.Page = 2 Then
                Value.Selection = Encounter.Combat.Members[Turn].LastAttack
            End If

        Else

            Accepted = Planning.Plan(Encounter, MenuCommand(Value.Selection), 4)

        End If

    Else If Value.Page = 2 Then

        Accepted = Planning.Plan(Encounter, Rules.ATTACK, 4, Value.Selection)

    Else If Value.Page = 3 Then

        Value.PendingMagic = Rules.MagicFor(Turn, Value.Selection)

        If Value.PendingMagic = Rules.HEAL Then
            Value.Page = 4
            Value.Selection = Rules.HealingTarget(Encounter.Combat)
        Else
            Accepted = Planning.Plan(Encounter, Value.PendingMagic, 4)
        End If

    Else If Value.Page = 4 Then

        Accepted = Planning.Plan(Encounter, Value.PendingMagic, Value.Selection)

    Else

        Value.Page = 1
        Value.Selection = 2

    End If

    If Accepted Or Turn <> Encounter.Combat.Turn Or Not Encounter.Planning Then
        Value.Page = 0
        Value.Selection = 0
    End If

End Sub

Public Sub Update(ByRef Value As State, ByRef Encounter As Planning.State, Key As Number)

    Dim Index As Number
    Dim Column As Number
    Dim X As Number
    Dim Y As Number
    Dim Confirm As Boolean
    Dim RowCount As Number

    If (Key <> KEY_NONE Or
        Pointer_Pressed(POINTER_PRIMARY) Or
        Pointer_Pressed(POINTER_SECONDARY) Or
        Pointer_Pressed(POINTER_MIDDLE)) Then
        Call Planning.Interrupt(Encounter)
    End If

    If Value.Stats.Visible Then
        Call StatsView.Update(Value.Stats, Key)

        Return
    End If

    For Index = 0 To 4

        Column = Index

        If Index >= 2 Then
            Column = Index + 1
        End If

        X = PanelLeft() + Column * PanelWidth()
        Y = PanelTop() + 124

        If Index = 4 Then
            X = Window_Width() / 2 - 78
            Y = 136
        End If

        If UI.Clicked(X + 5, Y, (PanelWidth() - 14) / 2, 19) Then
            Call StatsView.Open(Value.Stats, Index, False)
        Else If UI.Clicked(X + PanelWidth() / 2, Y, (PanelWidth() - 14) / 2, 19) Then
            Call StatsView.Open(Value.Stats, Index, True)
        End If

    End For

    If Not Encounter.Planning Or Value.Stats.Visible Then
        Return
    End If

    If (Key = KEY_ESCAPE Or Key = KEY_LEFT) And Value.Page > 0 Then

        Value.Page = Max(0, Value.Page - 1)

        If Value.Page > 1 Then
            Value.Page = 1
        End If

        Value.Selection = 0
        Return

    End If

    RowCount = Rows(Value.Page, Encounter.Combat.Turn)
    Y = MenuTop(Value.Page, Encounter.Combat.Turn)
    X = PanelLeft() + PanelWidth() * 2
    Confirm = Key = KEY_ENTER Or Key = KEY_SPACE Or Key = KEY_RIGHT

    If Key = KEY_UP Then
        Value.Selection = (Value.Selection + RowCount - 1) Mod RowCount
    Else If Key = KEY_DOWN Then
        Value.Selection = (Value.Selection + 1) Mod RowCount
    End If

    For Index = 0 To RowCount - 1

        If UI.Clicked(X + 3, Y + Index * 32, PanelWidth() - 12, 30) Then
            Value.Selection = Index
            Confirm = True
        End If

    End For

    If Confirm Then
        Call Accept(Value, Encounter)
    End If

End Sub

Public Function Blocked(Value As State) As Boolean

    Dim Result As Boolean

    Result = (Value.Stats.Visible Or Value.Page > 0 Or
        UI.Contains(PanelLeft(), PanelTop() - 36, PanelWidth() * 5, 190) Or
        UI.Contains(Window_Width() / 2 - 150, 92, 300, 67))
    Return Result

End Function

Private Sub Bar(Name As Text, Current As Number, Maximum As Number,
    X As Number, Y As Number, BarWidth As Number, Tint As Number)

    Fill Rectangle X, Y, BarWidth, 18, Rgb(26, 35, 54) Opacity 80
    Fill Rectangle X, Y, BarWidth * Current / Max(1, Maximum), 18, Tint Opacity 80
    Draw Text Name At X + 3, Y + 3 Size 10 Color WHITE
    Draw Text Growth.NumberText(Current) + "/" + Growth.NumberText(Maximum) At X + BarWidth / 2, Y + 2 Size 12 Color WHITE Centered

End Sub

Private Sub DrawMenu(Value As State, Battle As Rules.State)

    Dim Index As Number
    Dim X As Number
    Dim Y As Number
    Dim Tint As Number
    Dim Command As Number

    X = PanelLeft() + PanelWidth() * 2
    Y = MenuTop(Value.Page, Battle.Turn)

    If Value.Page > 0 Then

        Call UI.DrawPanel(X - 8, Y - 27, PanelWidth() + 10, Rows(Value.Page, Battle.Turn) * 32 + 37)

        Draw Rectangle X - 8, Y - 27, PanelWidth() + 10, Rows(Value.Page, Battle.Turn) * 32 + 37, Rgb(52, 85, 116)
        Draw Text Growth.Name(Battle.Turn) + " - Orders" At X + 4, Y - 20 Size 12 Color CYAN

    End If

    For Index = 0 To Rows(Value.Page, Battle.Turn) - 1

        Tint = WHITE
        Command = Rules.ATTACK

        If Value.Page = 1 Then
            Command = MenuCommand(Index)
        Else If Value.Page = 3 Or Value.Page = 4 Then
            Command = Rules.HEAL
        Else If Value.Page = 5 Then
            Command = Rules.ITEM
        End If

        If Not Enabled(Value.Page, Battle, Index) Then
            Tint = Rgb(105, 114, 130)
        End If

        If Index = Value.Selection Then
            Fill Rectangle X + 3, Y + Index * 32, PanelWidth() - 12, 30, Rgb(23, 83, 114) Opacity 80
        End If

        Call Icons.Icon(Command, X + 8, Y + Index * 32 + 3, Tint)

        Draw Text Label(Value.Page, Battle, Index) At X + 35, Y + Index * 32 + 9 Size 11 Color Tint
    End For

End Sub

Public Sub Draw(Value As State, Encounter As Planning.State, Inspecting As Boolean)

    Dim Index As Number
    Dim Column As Number
    Dim X As Number
    Dim Y As Number
    Dim Member As Rules.Member
    Dim Caption As Text
    Dim Root As State
    Dim Parent As State

    Y = PanelTop()

    For Index = 0 To 3

        Member = Encounter.Combat.Members[Index]
        Column = Index

        If Index >= 2 Then
            Column = Index + 1
        End If

        X = PanelLeft() + Column * PanelWidth()

        Call UI.DrawPanel(X, Y, PanelWidth() - 6, 145)

        If Encounter.Combat.Turn = Index And Encounter.Combat.Phase < Rules.VICTORY Then
            Draw Rectangle X, Y, PanelWidth() - 6, 145, CYAN
            Fill Rectangle X, Y, PanelWidth() - 6, 3, CYAN
        End If

        Draw Text Growth.Name(Index) + " Lv " + Growth.NumberText(Member.Level) At X + 7, Y + 9 Size 14 Color WHITE

        Call Bar("HP", Member.HP, Member.Stats.HP, X + 7, Y + 31, PanelWidth() - 20, Rgb(169, 48, 67))
        Call Bar("MP", Member.MP, Member.Stats.MP, X + 7, Y + 52, PanelWidth() - 20, Rgb(35, 96, 185))
        Call Bar("LB", Member.LB, Member.Stats.HP, X + 7, Y + 73, PanelWidth() - 20, Rgb(166, 111, 29))
        Call Icons.Icon(Member.LastCommand, X + 7, Y + 96, CYAN)

        Caption = Rules.CommandName(Member.LastCommand)

        If Member.LastCommand = Rules.ATTACK Then
            Caption = Attacks.Label(Index, Member.LastAttack)
        End If

        If Member.HP = 0 Then
            Caption = "Knocked Out"
        Else If Member.Escaped Then
            Caption = "Escaped"
        End If

        Draw Text Caption At X + 34, Y + 102 Size 10 Color WHITE

        Call UI.DrawButton(X + 5, Y + 124, (PanelWidth() - 14) / 2, 19, "Stats Table", False)
        Call UI.DrawButton(X + PanelWidth() / 2, Y + 124, (PanelWidth() - 14) / 2, 19, "Graphs", False)
    End For

    X = PanelLeft() + PanelWidth() * 2

    Call UI.DrawPanel(X, Y, PanelWidth() - 6, 145)

    Draw Text "Round " + Growth.NumberText(Encounter.Combat.Round) At X + 9, Y + 9 Size 13 Color CYAN

    If Not Encounter.Planning Then

        Caption = "Auto Battle"

        If Encounter.Combat.StopRequested Then
            Caption = "Orders Next Round"
        Else If Encounter.Combat.Phase >= Rules.VICTORY Then
            Caption = "Battle Finished"
        End If

        Draw Text Caption At X + 8, Y + 60 Size 11 Color WHITE

    End If

    Call UI.DrawPanel(PanelLeft(), Y - 36, PanelWidth() * 5 - 6, 29)

    Caption = Encounter.Combat.Message

    If Inspecting Then
        Caption = "Inspector Open - Battle Paused (` To Resume)"
    End If

    Draw Text Caption At PanelLeft() + 9, Y - 28 Size 13 Color WHITE

    Call UI.DrawPanel(Window_Width() / 2 - 150, 94, 300, 64)

    Draw Text "Kael - Level 20" At Window_Width() / 2, 99 Size 15 Color WHITE Centered
    Draw Text "HP " + Growth.NumberText(Encounter.Combat.Members[4].HP) + "/" + Growth.NumberText(Encounter.Combat.Members[4].Stats.HP) At Window_Width() / 2, 119 Size 12 Color CYAN Centered

    X = Window_Width() / 2 - 78

    Call UI.DrawButton(X + 5, 136, (PanelWidth() - 14) / 2, 19, "Stats Table", False)
    Call UI.DrawButton(X + PanelWidth() / 2, 136, (PanelWidth() - 14) / 2, 19, "Graphs", False)

    Draw Text "Arrows: Choose | Enter/Space: Confirm | Esc: Back | Input During Battle: Orders Next Round | `: Panels" At PanelLeft(), Window_Height() - 24 Size 11 Color LIGHT_GRAY

    ''' Popups draw after the HUD so its message strip cannot cover menu choices.

    If Encounter.Planning Then

        Root.Selection = 1
        Parent.Page = 1
        Parent.Selection = 0

        If Value.Page > 0 Then
            Call DrawMenu(Root, Encounter.Combat)
        End If

        If Value.Page > 1 Then
            Call DrawMenu(Parent, Encounter.Combat)
        End If

        Call DrawMenu(Value, Encounter.Combat)

    End If

    If Value.Stats.Visible Then
        Call GrowthView.Draw(Value.Stats)
    End If

End Sub

End Module
