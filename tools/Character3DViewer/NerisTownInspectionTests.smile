''' Focused native regressions for town inspection and direct wheel zoom.
Module Smile.Tools.NerisTownInspectionTests

Option Explicit

Import Smile.Tools.NerisTown As Town
Import Smile.Tools.NerisTownParty As Party
Import Smile.Tools.NerisTownMap As TownMap
Import Smile.Tools.NerisTownCamera As Drone
Import Smile.Tools.NerisTownKeyboard As Keyboard
Import Smile.Tools.Character3DViewerCamera As ViewerCamera
Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.PrecisionMath3D As M
Import Smile.Simple3D.ArenaViewport3D As Arena
Import Smile.Simple3D.ArenaCamera3D As Motion
Import Smile.Simple3D.PrecisionCamera3D As Camera
Import Smile.Tools.TownPicking As Picking
Import Smile.Tools.TownEditorSession As Authoring
Import Smile.Tools.NerisTownNavigation As Navigation
Import Smile.Tools.NerisTownInspectionLimits As Limits
Import Smile.Tools.TownDocumentNavigation As Edited
Import Smile.Simple3D.CameraClearance3D As Clearance

Public Sub Run(ByRef Value As Town.State, ByRef Failures As Number)

    Dim SavedMap As TownMap.State
    Dim SavedPosition As P.Vector3

    SavedMap = Value.Map
    SavedPosition = Value.People.Path.Positions[0]

    Call ZoomAfterTab(Value, Failures)
    Call PartyMovementAcrossCameras(Value, Failures)
    Call IdleOrbit(Value, Failures)
    Call WalkingCameraGesture(Value, Failures)
    Call BridgeDepthPrecision(Value, Failures)
    Call InspectionPitch(Value, Failures)
    Call MapPanAndGroundZoom(Value, Failures)
    Call SkyTargetZoom(Value, Failures)
    Call BehindLeader(Value, Failures)
    Call FollowPartyOrbit(Value, Failures)

    Call ShiftMiddlePan(Value, Failures)
    Call KeyboardModes(Value, Failures)
    Call CursorOrbit(Value, Failures)
    Call RightClickOrbit(Value, Failures)
    Call MapOrbit(Value, Failures)
    Call QuarterTurn(Value, Failures)
    Call FrontView(Value, Failures)
    Call CursorZoom(Value, Failures)
    Call OrbitZoom(Value, Failures)
    Call FocusWallClearance(Failures)

    Call Party.Teleport(Value.People, SavedPosition)
    Call Party.Update(Value.People, SavedPosition, 0)

    Value.Map = SavedMap
    Value.Look.Time = 0

End Sub

Private Sub FocusWallClearance(ByRef Failures As Number)

    Dim Flight As Drone.State
    Dim View As Arena.State
    Dim Shot As P.Camera3D
    Dim Wall As Clearance.Bounds
    Dim Index As Number
    Dim Forward As P.Vector3
    Dim RightValue As P.Vector3
    Dim UpValue As P.Vector3

    Call Edited.PopulateCamera(Flight.World, P.Vector(-900.0, 60.0, -2460.0))

    For Index = 0 To Flight.World.BoxCount - 1

        Wall = Flight.World.Boxes[Index]

        If Wall.High.Y - Wall.Low.Y > 60.0 Then
            Exit For
        End If

    End For

    Call Check(Index < Flight.World.BoxCount, "Focus Wall Fixture Has A Building", Failures)

    Shot.Position = P.Vector(Wall.High.X + 100.0, (Wall.Low.Y + Wall.High.Y) * 0.5,
        (Wall.Low.Z + Wall.High.Z) * 0.5)
    Shot.Target = P.Vector(Wall.Low.X - 100.0, Shot.Position.Y, Shot.Position.Z)
    Shot.FovDegrees = 32.0
    Shot.FarPlane = 50000.0
    View.LiveCamera = Shot
    View.MaximumDistance = 50000.0
    Flight.Focusing = True

    Call Motion.Reset(View.Controls, View.Zoom)
    Call Arena.BeginTransition(View, 1000)
    Call Arena.AdvanceTransition(View, 500)
    Call Drone.Compose(Flight, View, Shot, True, 16, True)
    Call Check(Clearance.Fraction(Flight.World, View.LiveCamera.Target,
        View.LiveCamera.Position, 18.0, True) > 0.999 And
        M.Distance(View.LiveCamera.Position, Shot.Position) > 1.0,
        "Eased Focus Does Not Put The Camera Behind A Building Wall", Failures)
    Call Check(M.Distance(Flight.Flight.Position, View.LiveCamera.Position) < 0.01,
        "Follow Recovery Starts From The Cleared Focus Shot", Failures)

    Shot.Target.X = Wall.Low.X - 18.01
    View.LiveCamera = Shot
    Flight.Focusing = True

    Call Arena.BeginTransition(View, 1000)
    Call Arena.AdvanceTransition(View, 500)
    Call Drone.Compose(Flight, View, Shot, True, 16, True)
    Call Check(Camera.Basis(View.LiveCamera, Forward, RightValue, UpValue) And
        M.Distance(View.LiveCamera.Position, View.LiveCamera.Target) >= 0.999,
        "Focus Beside A Wall Retains A Nonzero Camera Direction", Failures)

End Sub

Private Sub OrbitZoom(ByRef Value As Town.State, ByRef Failures As Number)

    Dim Pointer As Motion.PointerInput
    Dim Anchor As P.Vector3
    Dim Eye As P.Vector3
    Dim Pixel As Camera.ProjectedPoint
    Dim Before As Double
    Dim Yaw As Double
    Dim Mode As Number
    Dim Direction As Number
    Dim Frame As Number
    Dim Ok As Boolean
    Dim Anchored As Boolean

    For Mode = 0 To 2

        Call Town.ResetOverview(Value)
        Call Arena.AdvanceTransition(Value.View, 1000)
        Call Town.Update(Value, 0)

        Value.IdleOrbit = Mode = 1
        Value.OrbitPaused = Mode = 2

        For Direction = 0 To 1

            Eye = Value.View.LiveCamera.Position
            Ok = Picking.OrbitPoint(Value.View.LiveCamera, 430, 360,
                Window_Width(), Window_Height(), Anchor)
            Before = M.Distance(Eye, Anchor)

            Call Town.UpdateIdle(Value, True, 0, True)
            Call Town.BeginPointerZoom(Value, 430, 360)
            Call Check(Ok And Value.Flight.CursorZoom And M.Distance(Eye, Value.View.LiveCamera.Position) < 0.01,
                "Orbit Wheel Picks The Cursor World Point Without Jumping", Failures)

            Yaw = Value.View.Controls.OrbitYaw
            Pointer.Wheel = 3 - Direction * 6
            Ok = Motion.UpdatePointer(Value.View.Controls, Value.View.Zoom, Pointer)
            Anchored = True

            For Frame = 1 To 20
                Call Motion.Advance(Value.View.Controls, Value.View.Zoom, 16)
                Call Town.Update(Value, 16)

                Pixel = Camera.ProjectViewerPoint(Anchor, Value.View.LiveCamera, Window_Width(), Window_Height())
                Anchored = Anchored And Pixel.Visible And Abs(Pixel.X - 430.0) < 0.5 And Abs(Pixel.Y - 360.0) < 0.5
            End For

            Call Check(Anchored And Value.Cinematic And Not Value.IdleOrbit,
                "Cursor Point Stays Under The Mouse While Zoom And Orbit Advance Together", Failures)
            Call Check((Mode = 2 And Value.View.Controls.OrbitYaw = Yaw) Or
                (Mode <> 2 And Value.View.Controls.OrbitYaw <> Yaw),
                "Zoom Keeps Active Orbit Moving And Paused Orbit Paused", Failures)
            Call Check((Direction = 0 And M.Distance(Value.View.LiveCamera.Position, Anchor) < Before) Or
                (Direction = 1 And M.Distance(Value.View.LiveCamera.Position, Anchor) > Before),
                "Orbit Zoom Moves Toward Or Away From The Picked Map Point", Failures)
        End For
    End For

    Call Town.ResetOverview(Value)

    Call Check(Not Value.Flight.CursorZoom,
        "Reset Overview Releases The Previous Cursor Zoom Anchor", Failures)

End Sub

Private Sub CursorZoom(ByRef Value As Town.State, ByRef Failures As Number)

    Dim Point As P.Vector3
    Dim Pixel As Camera.ProjectedPoint
    Dim Before As P.Camera3D
    Dim Mode As Number
    Dim Step As Number
    Dim Pending As Double

    For Mode = 0 To 1

        Call Town.ResetOverview(Value)

        Value.Cinematic = False
        Value.Follow = False
        Value.PartyCamera = False

        If Mode = 1 Then
            Call Town.TopDown(Value, True)
        End If

        Before = Value.View.LiveCamera
        Point = Camera.CursorPointAtDepth(Before, 350, 300,
            M.Distance(Before.Position, Before.Target) * 0.7, Window_Width(), Window_Height())

        Call Drone.BeginCursorZoom(Value.Flight, Value.View, Value.BaseCamera, Point, 350, 300)
        Call Check(M.Distance(Before.Position, Value.View.LiveCamera.Position) < 0.0001,
            "Beginning Cursor Zoom Does Not Jump The Camera", Failures)

        Call Camera.AdjustZoomTarget(Value.View.Zoom, 1, 24)
        Call Motion.Advance(Value.View.Controls, Value.View.Zoom, 16)

        Pending = Value.View.Zoom.Target - Value.View.Zoom.Current

        Call Drone.BeginCursorZoom(Value.Flight, Value.View, Value.BaseCamera, Point, 350, 300)
        Call Check(Abs(Value.View.Zoom.Target - Value.View.Zoom.Current - Pending) < 0.0001,
            "Rapid Wheel Events Retain Unfinished Zoom Instead Of Discarding It", Failures)

        For Step = 0 To 1

            Value.View.Zoom.Current = -48.0 + ToDouble(Step) * 56.0
            Value.View.Zoom.Target = Value.View.Zoom.Current
            Value.View.Controls.Zoom = Value.View.Zoom.Current

            Call Drone.Compose(Value.Flight, Value.View, Value.BaseCamera, False, 0)

            Pixel = Camera.ProjectViewerPoint(Point, Value.View.LiveCamera, Window_Width(), Window_Height())

            Call Check(Pixel.Visible And Abs(Pixel.X - 350.0) < 0.1 And Abs(Pixel.Y - 300.0) < 0.1,
                "Cursor Zoom In And Out Retains The Picked Object In Perspective And True 2D", Failures)
        End For

        Value.Flight.CursorZoom = False
    End For

    Call Town.ResetOverview(Value)

End Sub

Private Sub FrontView(ByRef Value As Town.State, ByRef Failures As Number)

    Dim Before As P.Camera3D
    Dim After As P.Camera3D
    Dim Offset As P.Vector3
    Dim Index As Number

    For Index = 0 To 1

        Call Town.ResetOverview(Value)

        If Index = 1 Then
            Call Town.TopDown(Value, True)
        End If

        Before = Value.View.LiveCamera

        Call Town.Input(Value, KEY_2, False)

        After = Value.View.LiveCamera
        Offset = M.Subtract(After.Position, After.Target)

        Call Check(Abs(Offset.Y) < 0.001 And Before.Target.X = After.Target.X And Before.Target.Z = After.Target.Z And
            After.Position.Y >= Navigation.GroundHeight(After.Target.X, After.Target.Z) + 26.0 And
            Abs(M.Distance(Before.Position, Before.Target) - M.Length(Offset)) < 0.001 And
            Before.FovDegrees = After.FovDegrees And After.OrthographicHeight = 0.0,
            "Key 2 Levels The Current View And Preserves Its Center Distance And Lens", Failures)

        If Index = 0 Then
            Call Check(Abs(Offset.X * (Before.Position.Z - Before.Target.Z) -
                Offset.Z * (Before.Position.X - Before.Target.X)) < 0.1,
                "Front View Preserves The Current Horizontal Bearing", Failures)
        Else

            Call Check(M.Dot(Offset, Before.UpDirection) < 0.0,
                "Front View From True 2D Uses The Current Screen Orientation", Failures)
        End If

    End For

    Call Town.ResetOverview(Value)

End Sub

Private Sub QuarterTurn(ByRef Value As Town.State, ByRef Failures As Number)

    Dim Before As P.Camera3D
    Dim Point As P.Vector3
    Dim Pixel As Camera.ProjectedPoint
    Dim Center As Camera.ProjectedPoint
    Dim Index As Number

    Call Town.TopDown(Value)

    Before = Value.View.LiveCamera
    Point = M.Add(Before.Target, P.Vector(100.0, 0.0, 0.0))

    Call Drone.TurnClockwise(Value.Flight, Value.View, Value.BaseCamera)

    Pixel = Camera.ProjectViewerPoint(Point, Value.View.LiveCamera, Window_Width(), Window_Height())
    Center = Camera.ProjectViewerPoint(Before.Target, Value.View.LiveCamera, Window_Width(), Window_Height())

    Call Check(Pixel.Y > Center.Y And Abs(Pixel.X - Center.X) < 0.1 And
        M.Distance(Before.Target, Value.View.LiveCamera.Target) < 0.01 And
        Abs(M.Distance(Before.Position, Before.Target) -
        M.Distance(Value.View.LiveCamera.Position, Value.View.LiveCamera.Target)) < 0.01 And
        Before.FovDegrees = Value.View.LiveCamera.FovDegrees,
        "Clockwise Quarter Turn Moves Right To Down And Preserves Center Zoom Lens", Failures)

    For Index = 1 To 3
        Call Drone.TurnClockwise(Value.Flight, Value.View, Value.BaseCamera)
    End For

    Call Check(M.Distance(Before.Position, Value.View.LiveCamera.Position) < 0.01 And
        M.Distance(Before.Target, Value.View.LiveCamera.Target) < 0.01,
        "Four Quarter Turns Restore The Exact Camera", Failures)

    Value.View.LiveCamera = Drone.EditingView(Before, 1)
    Value.View.LiveCamera.UpDirection = M.Rotate(P.Vector(0.0, 0.0, 1.0), P.Vector(0.0, -18.0, 0.0))

    Call Drone.TurnClockwise(Value.Flight, Value.View, Value.BaseCamera)
    Call Check(M.Distance(Value.View.LiveCamera.UpDirection, P.Vector(-1.0, 0.0, 0.0)) < 0.001,
        "Angled R Snaps Forward To The Next Cardinal Instead Of Adding Ninety", Failures)
    Call Drone.TurnClockwise(Value.Flight, Value.View, Value.BaseCamera)
    Call Check(M.Distance(Value.View.LiveCamera.UpDirection, P.Vector(0.0, 0.0, -1.0)) < 0.001,
        "Aligned R Advances To The Clockwise Cardinal", Failures)
    Call Town.ResetOverview(Value)

End Sub

Private Sub FollowPartyOrbit(ByRef Value As Town.State, ByRef Failures As Number)

    Dim Before As P.Camera3D
    Dim Anchor As P.Vector3
    Dim Keys As Keyboard.HeldKeys
    Dim Index As Number
    Dim Pixel As Camera.ProjectedPoint
    Dim BeforePixel As Camera.ProjectedPoint

    Call Town.Input(Value, KEY_TAB, False)
    Call Arena.AdvanceTransition(Value.View, 1000)
    Call Town.Update(Value, 0)

    Before = Value.View.LiveCamera

    Call Town.BeginPointerOrbit(Value)
    Call Town.Update(Value, 0)

    Anchor = M.Add(Value.People.Path.Positions[0], P.Vector(0.0, 14.0, 0.0))

    BeforePixel = Camera.ProjectViewerPoint(Anchor, Before, Window_Width(), Window_Height())

    Call Check(Value.Follow And Value.PartyCamera And Value.Flight.OrbitAtParty And
        M.Distance(Before.Position, Value.View.LiveCamera.Position) < 0.01 And
        M.Distance(Before.Target, Value.View.LiveCamera.Target) < 0.01,
        "Middle Press After Tab Preserves Eye Aim Zoom And Off Center Leader", Failures)

    For Index = 0 To 1

        Call Motion.ApplyDrag(Value.View.Controls, True, False,
            1 + Index * 14, 1 + Index * 7, 400.0, 400.0)
        Call Town.Update(Value, 16)

        Pixel = Camera.ProjectViewerPoint(Anchor, Value.View.LiveCamera, Window_Width(), Window_Height())

        Call Check(Value.Follow And Not Value.Flight.CursorOrbit And
            Abs(Pixel.X - BeforePixel.X) < 0.01 And Abs(Pixel.Y - BeforePixel.Y) < 0.01 And
            Abs(M.Distance(Anchor, Before.Position) - M.Distance(Anchor, Value.View.LiveCamera.Position)) < 0.01,
            "Slow And Moderate Mouse Orbit Keep Arin As Pivot Without Recentering Him", Failures)
    End For

    Keys.ArrowSide = 1.0

    Call Town.AdvanceKeyboard(Value, Keys, 100)
    Call Town.Update(Value, 16)

    Pixel = Camera.ProjectViewerPoint(Anchor, Value.View.LiveCamera, Window_Width(), Window_Height())

    Call Check(Value.Follow And Abs(Pixel.Y - BeforePixel.Y) < 0.01,
        "Arrow Orbit Retains The Follow Party Anchor", Failures)
    Call Town.MoveParty(Value, P.Vector(0.0, 0.0, 1.0), 100)
    Call Town.Update(Value, 16)

    Anchor = M.Add(Value.People.Path.Positions[0], P.Vector(0.0, 14.0, 0.0))
    Pixel = Camera.ProjectViewerPoint(Anchor, Value.View.LiveCamera, Window_Width(), Window_Height())

    Call Check(Abs(Pixel.X - BeforePixel.X) < 0.01 And Abs(Pixel.Y - BeforePixel.Y) < 0.01,
        "Orbit Anchor Travels With Arin When The Party Walks", Failures)
    Call Town.ResetOverview(Value)

End Sub

Private Sub SkyTargetZoom(ByRef Value As Town.State, ByRef Failures As Number)

    Dim Before As P.Camera3D
    Dim Forward As P.Vector3
    Dim After As P.Vector3
    Dim Ok As Boolean
    Dim SavedMaximumDistance As Double

    Call Town.ResetOverview(Value)

    Value.Cinematic = False
    ' Reproduce the expanded airport view, whose ground ray exceeds the old map's radius.
    SavedMaximumDistance = Value.View.MaximumDistance
    Value.View.MaximumDistance = 40000.0
    Value.BaseCamera.Position = P.Vector(-13136.0, 17119.0, 2077.0)
    Value.BaseCamera.Target = P.Vector(-13115.0, 17057.0, 2031.0)

    Call Arena.BeginTransition(Value.View, 0)
    Call Motion.Reset(Value.View.Controls, Value.View.Zoom)
    Call Drone.Compose(Value.Flight, Value.View, Value.BaseCamera, False, 0)

    Before = Value.View.LiveCamera
    Ok = M.TryNormalize(M.Subtract(Before.Target, Before.Position), Forward)

    Call Limits.BeginZoom(Value.View, Value.BaseCamera)
    Call Drone.Compose(Value.Flight, Value.View, Value.BaseCamera, False, 0)

    Ok = M.TryNormalize(M.Subtract(Value.View.LiveCamera.Target, Value.View.LiveCamera.Position), After)

    Call Check(M.Distance(Before.Position, Value.View.LiveCamera.Position) < 0.001 And
        M.Distance(Forward, After) < 0.001,
        "Ground Zoom Preparation Preserves The Displayed Eye And Viewing Direction", Failures)

    Value.View.Zoom.Current = ToDouble(Motion.ZOOM_IN_LIMIT)
    Value.View.Zoom.Target = Value.View.Zoom.Current
    Value.View.Controls.Zoom = Value.View.Zoom.Current

    Call Drone.Compose(Value.Flight, Value.View, Value.BaseCamera, False, 0)
    Call Check(Abs(Value.View.LiveCamera.Position.Y - Limits.GROUND_CLEARANCE) < 0.01,
        "Sky Target At Distance Eighty Can Zoom All The Way To Ground", Failures)

    Value.View.MaximumDistance = SavedMaximumDistance

    Call Town.ResetOverview(Value)

End Sub

Private Sub BehindLeader(ByRef Value As Town.State, ByRef Failures As Number)

    Dim SavedYaw As Double
    Dim Forward As P.Vector3
    Dim Offset As P.Vector3
    Dim Index As Number

    SavedYaw = Value.People.Members[0].Yaw

    For Index = 0 To 3

        Value.People.Members[0].Yaw = ToDouble(Index) * 90.0

        Call Town.Input(Value, KEY_TAB, False)
        Call Arena.AdvanceTransition(Value.View, 1000)
        Call Town.Update(Value, 0)

        Forward = P.Vector(-Sin(M.Radians(Value.People.Members[0].Yaw)), 0.0,
            -Cos(M.Radians(Value.People.Members[0].Yaw)))
        Offset = M.Subtract(Value.View.LiveCamera.Position, Value.People.Path.Positions[0])

        Call Check(M.Dot(Offset, Forward) < -20.0 And
            M.Dot(M.Subtract(Value.View.LiveCamera.Target, Value.View.LiveCamera.Position), Forward) > 20.0,
            "Tab Places The Camera Behind The Leader Looking Along His Facing", Failures)
        Call Check(Image_Loaded(Value.Map.Headlight) And TownMap.HeadingFrame(Value.People.Members[0].Yaw) =
            ((Index + 2) Mod 4) * 18, "Edited Map Retains The Loaded Four-Direction Headlight", Failures)
    End For

    Value.People.Members[0].Yaw = SavedYaw

    Call Town.ResetOverview(Value)

End Sub

Private Sub MapPanAndGroundZoom(ByRef Value As Town.State, ByRef Failures As Number)

    Dim Before As P.Camera3D
    Dim Contact As P.Camera3D
    Dim Offset As P.Vector3
    Dim Index As Number
    Dim Ok As Boolean

    Call Town.ResetOverview(Value)

    Value.Cinematic = False

    Call Drone.Compose(Value.Flight, Value.View, Value.BaseCamera, False, 0)

    Value.View.Controls.Panning = True

    Call Motion.ApplyDrag(Value.View.Controls, False, True, -600, 0,
        Value.View.PanXLimit, Value.View.PanYLimit, Value.View.WorldScale)
    Call Drone.Compose(Value.Flight, Value.View, Value.BaseCamera, False, 16)
    Call Check(Value.View.Controls.PanX > 2160.0,
        "Map Pan Moves Beyond The Former Character Sized Horizontal Stop", Failures)

    Value.View.Controls.PanX = 0.0
    Value.View.Controls.PanY = -1500.0

    Call Drone.Compose(Value.Flight, Value.View, Value.BaseCamera, False, 16)
    Call Check(Value.View.LiveCamera.Target.Y < 0.0 And Value.View.LiveCamera.Position.Y > 25.01,
        "Pan Can Aim Below The Map While The Camera Remains Above It", Failures)

    Value.View.Controls.Panning = False
    Before = Value.View.LiveCamera
    Value.View.Zoom.Current = ToDouble(Motion.ZOOM_IN_LIMIT)
    Value.View.Zoom.Target = Value.View.Zoom.Current
    Value.View.Controls.Zoom = Value.View.Zoom.Current

    Call Drone.Compose(Value.Flight, Value.View, Value.BaseCamera, False, 16)

    Contact = Value.View.LiveCamera
    Offset = M.Cross(M.Subtract(Before.Position, Before.Target), M.Subtract(Contact.Position, Before.Target))

    Call Check(Abs(Contact.Position.Y - 25.01) < 0.01 And M.Length(Offset) < 0.1 And
        M.Distance(Contact.Target, Before.Target) < 0.001,
        "Zoom Stops At Ground On The Original Ray Without Sliding Or Moving The Target", Failures)

    For Index = 0 To 4
        Value.View.Zoom.Target = ToDouble(Motion.ZOOM_IN_LIMIT)
        Value.View.Zoom.Current = ToDouble(Motion.ZOOM_IN_LIMIT)
        Value.View.Controls.Zoom = Value.View.Zoom.Current

        Call Drone.Compose(Value.Flight, Value.View, Value.BaseCamera, False, 16)
    End For

    Call Check(M.Distance(Contact.Position, Value.View.LiveCamera.Position) < 0.001,
        "Repeated Zoom In At The Ground Cannot Drift Into Space", Failures)

    Value.View.Zoom.Target = Value.View.Zoom.Target + 8.0

    Call Motion.Advance(Value.View.Controls, Value.View.Zoom, 100)
    Call Drone.Compose(Value.Flight, Value.View, Value.BaseCamera, False, 100)
    Call Check(Value.View.LiveCamera.Position.Y > Contact.Position.Y + 1.0,
        "Zoom Out Responds Immediately After Ground Contact", Failures)
    Call Town.ResetOverview(Value)

End Sub

Private Sub CursorOrbit(ByRef Value As Town.State, ByRef Failures As Number)

    Dim Point As P.Vector3
    Dim Before As P.Camera3D
    Dim Pixel As Camera.ProjectedPoint
    Dim Depth As Double
    Dim Ok As Boolean
    Dim X As Number
    Dim Y As Number

    Call Town.ResetOverview(Value)

    Value.Cinematic = False
    X = Window_Width() / 2 + 55
    Y = Window_Height() / 2 + 45
    Ok = Picking.Ground(Value.View.LiveCamera, X, Y, Window_Width(), Window_Height(), Point)
    Before = Value.View.LiveCamera

    Call Keyboard.Capture(Value.Keys, Value.View, Value.BaseCamera)
    Call Drone.BeginCursorOrbit(Value.Flight, Before, Point, X, Y)
    Call Drone.Compose(Value.Flight, Value.View, Value.BaseCamera, False, 0)

    Call Check(Ok And M.Distance(Before.Position, Value.View.LiveCamera.Position) < 0.01,
        "Picking An Off-Center Orbit Pivot Does Not Jump The Camera", Failures)
    Call Motion.ApplyDrag(Value.View.Controls, True, False, 1, 1, 10000.0, 10000.0)
    Call Drone.Compose(Value.Flight, Value.View, Value.BaseCamera, False, 16)

    Pixel = Camera.ProjectViewerPoint(Point, Value.View.LiveCamera, Window_Width(), Window_Height())

    Call Check(Abs(Pixel.X - ToDouble(X)) < 0.01 And Abs(Pixel.Y - ToDouble(Y)) < 0.01,
        "Slow Orbit Keeps The Clicked World Point Beneath Its Original Pixel", Failures)
    Call Motion.ApplyDrag(Value.View.Controls, True, False, 15, 8, 10000.0, 10000.0)
    Call Drone.Compose(Value.Flight, Value.View, Value.BaseCamera, False, 16)

    Pixel = Camera.ProjectViewerPoint(Point, Value.View.LiveCamera, Window_Width(), Window_Height())
    Before = Value.View.LiveCamera

    Call Check(Abs(Pixel.X - ToDouble(X)) < 0.01 And Abs(Pixel.Y - ToDouble(Y)) < 0.01,
        "Moderate Orbit Keeps The Same Picked Pivot", Failures)
    Call Drone.FinishCursorOrbit(Value.Flight, Value.View, Value.BaseCamera)
    Call Drone.Compose(Value.Flight, Value.View, Value.BaseCamera, False, 0)
    Call Check(M.Distance(Before.Position, Value.View.LiveCamera.Position) < 0.01,
        "Releasing Cursor Orbit Preserves Its Final Framing", Failures)

    Depth = 123.0
    Ok = P.TryCursorDepth(-1, 0, Window_Width(), Window_Height(), Depth)

    Call Check(Not Ok And Depth = 123.0, "Invalid Depth Pick Does Not Mutate Output", Failures)
    Call Town.ResetOverview(Value)

End Sub

Public Sub RightClickOrbit(ByRef Value As Town.State, ByRef Failures As Number)

    Dim Before As P.Camera3D
    Dim Point As P.Vector3
    Dim Radius As Double
    Dim Index As Number
    Dim Bearing As Double
    Dim Elevation As Double
    Dim Offset As P.Vector3

    Call Town.ResetOverview(Value)
    Call Arena.AdvanceTransition(Value.View, 1000)
    Call Town.Update(Value, 0)

    Value.BaseCamera.Position = M.Add(Value.BaseCamera.Target, P.Vector(30.0, 20.0, 40.0))
    ' A pan can leave historical follow intent after the displayed mode becomes Free Camera.
    Value.Follow = True
    Value.PartyCamera = False
    Value.Cinematic = False

    Call Motion.Reset(Value.View.Controls, Value.View.Zoom)
    Call Arena.ComposeCamera(Value.View, Value.BaseCamera)
    Call Town.StartOverviewOrbit(Value)
    Call Town.Update(Value, 0)

    Before = Value.View.LiveCamera
    Point = Before.Target
    Radius = M.Distance(Before.Position, Before.Target)
    Offset = M.Subtract(Before.Position, Before.Target)
    Bearing = M.Degrees(Atan2(Offset.X, Offset.Z))
    Elevation = M.Degrees(Atan2(Offset.Y, Sqrt(Offset.X * Offset.X + Offset.Z * Offset.Z)))

    Call Check(Value.Cinematic And Not Value.Follow And Not Value.OrbitPaused And
        Radius > 8000.0 And Value.View.Controls.PanX = 0.0,
        "Right Click Restores Bird Eye Zoom And Starts Orbit", Failures)

    If Value.Horizon.Ready Then
        Call Check(Abs(Radius - 14682.0) < 0.01 And
            M.Distance(Point, Authoring.MapCenter(0.0)) < 0.01 And
            Abs(Bearing + 98.0) < 0.01 And Abs(Elevation - 33.0) < 0.01,
            "Horizon Overview Matches The Approved Front View Around Map Center", Failures)
    Else If Value.Harbor.Ready Then
        Call Check(Abs(Radius - 11438.0) < 0.01 And
            M.Distance(Point, Authoring.MapCenter(1044.0)) < 0.01 And
            Abs(Bearing + 21.0) < 0.01 And Abs(Elevation - 17.0) < 0.01,
            "Spaceport Overview Starts At The Approved Front Angle Around Map Center", Failures)
    Else If Value.Edited Then
        Call Check(M.Distance(Point, P.Vector(-1225.0, 150.0, 375.0)) < 0.01 And
            M.Distance(M.Subtract(Before.Position, Point), P.Vector(4475.0, 2907.0, -6616.0)) < 0.01,
            "Neris Town Right Click Keeps Approved Angle Around Map Center", Failures)
    Else

        Call Check(M.Distance(Point, P.Vector(-1075.0, 150.0, 0.0)) < 0.01 And
            Abs(Radius - 8725.0) < 0.01 And Abs(Bearing + 179.0) < 0.01 And
            Abs(Elevation - 33.0) < 0.01,
            "Legacy Factory Town Keeps Its Own Overview Center And Angle", Failures)
    End If

    For Index = 1 To 4
        Call Town.Update(Value, 1000)
        Call Check(M.Distance(Point, Value.View.LiveCamera.Target) < 0.01 And
            Abs(M.Distance(Value.View.LiveCamera.Position, Point) - Radius) < 0.01,
            "Overview Orbit Keeps Its Town Center And Distance", Failures)
    End For

    Call Town.ResetOverview(Value)

    Before = Value.View.LiveCamera
    Value.Follow = True
    Value.PartyCamera = True

    Call Town.StartOverviewOrbit(Value)
    Call Town.Update(Value, 0)
    Call Check(Not Value.Follow And Value.Cinematic And Value.OverviewOrbit And
        M.Distance(Before.Position, Value.View.LiveCamera.Position) < 0.01 And
        M.Distance(Before.Target, Value.View.LiveCamera.Target) < 0.01,
        "Right Click From Follow Restores The Newly Loaded Tab Overview", Failures)

End Sub

Public Sub MapOrbit(ByRef Value As Town.State, ByRef Failures As Number)

    Dim Before As P.Camera3D
    Dim Offset As P.Vector3
    Dim Index As Number
    Dim Steady As Boolean
    Dim ExpectedRadius As Double
    Dim Anchor As P.Vector3
    Dim Forward As P.Vector3
    Dim AfterForward As P.Vector3
    Dim Ok As Boolean
    Dim Pixel As Camera.ProjectedPoint

    Call Town.ResetOverview(Value)

    Value.Cinematic = False
    Value.View.Controls.PanX = 437.0
    Value.View.Controls.PanY = 92.0
    Value.View.Controls.OrbitYaw = 17.0
    Value.View.Zoom.Current = -55.0
    Value.View.Zoom.Target = -90.0
    Value.View.Controls.Zoom = -55.0

    Call Town.Update(Value, 0)
    Call Town.Draw(Value)

    Show Screen

    Before = Value.View.LiveCamera
    Anchor = Picking.OrbitCenter(Before, Window_Width(), Window_Height())
    Ok = M.TryNormalize(M.Subtract(Before.Target, Before.Position), Forward)

    Call Town.StartOrbit(Value)

    Before.Target = Anchor
    Offset = M.Subtract(Before.Position, Before.Target)
    ExpectedRadius = M.Length(Offset)

    Call Check(M.Distance(Before.Position, Value.BaseCamera.Position) < 0.001 And
        M.Distance(Before.Target, Value.BaseCamera.Target) < 0.001 And Not Value.Follow,
        "Orbit Keeps The Current Eye And Uses The Visible Viewport Center", Failures)
    Call Check(Before.FovDegrees = Value.BaseCamera.FovDegrees And
        Value.View.Controls.PanX = 0.0 And Value.View.Controls.Zoom = ToDouble(Motion.DEFAULT_ZOOM),
        "Current Zoom And Pan Are Baked Into The Orbit Without Changing The Shot", Failures)

    Value.OrbitPaused = True

    Call Town.Update(Value, 16)

    Ok = M.TryNormalize(M.Subtract(Value.View.LiveCamera.Target, Value.View.LiveCamera.Position), AfterForward)
    Pixel = Camera.ProjectViewerPoint(Anchor, Value.View.LiveCamera, Window_Width(), Window_Height())

    Call Check(M.Distance(Before.Position, Value.View.LiveCamera.Position) < 0.01,
        "Space Pause Holds Map Orbit Framing", Failures)
    Call Check(M.Distance(Forward, AfterForward) < 0.000001 And
        Before.FovDegrees = Value.View.LiveCamera.FovDegrees And
        Abs(Pixel.X - ToDouble(Window_Width()) * 0.5) < 0.001 And
        Abs(Pixel.Y - ToDouble(Window_Height()) * 0.5) < 0.001 And
        Not Value.OverviewOrbit And Value.View.TransitionDuration = 0,
        "Orbit Starts Without Changing Direction Lens Or Screen Composition", Failures)

    Value.OrbitPaused = False
    Steady = True

    ' Sample the composed camera across one complete revolution, without waiting.

    For Index = 1 To 1440
        Call Town.Update(Value, 100)

        Steady = (Steady And M.Distance(Before.Target, Value.View.LiveCamera.Target) < 0.01 And
            Abs(Before.Position.Y - Value.View.LiveCamera.Position.Y) < 0.01 And
            Abs(M.Distance(Value.View.LiveCamera.Position, Value.View.LiveCamera.Target) - ExpectedRadius) < 0.01)
    End For

    Call Check(Steady, "Full Map Orbit Keeps Height Zoom And Center Without Building Detours", Failures)
    Call Check(M.Distance(Before.Position, Value.View.LiveCamera.Position) < 0.01,
        "Steady Map Orbit Completes One Revolution At 2.5 Degrees Per Second", Failures)
    Call Town.ResetOverview(Value)

End Sub

Private Sub ShiftMiddlePan(ByRef Value As Town.State, ByRef Failures As Number)

    Dim Pointer As Motion.PointerInput
    Dim ActorPointer As ViewerCamera.PointerInput
    Dim ActorCamera As ViewerCamera.State
    Dim Ok As Boolean

    Call Motion.Reset(Value.View.Controls, Value.View.Zoom)

    Pointer.PanModifier = True
    Pointer.OrbitPressed = True
    Pointer.OrbitHeld = True
    Pointer.DeltaX = 12
    Pointer.DeltaY = 6
    Ok = Motion.UpdatePointer(Value.View.Controls, Value.View.Zoom, Pointer)

    Call Check(Value.View.Controls.Panning And Not Value.View.Controls.Orbiting And
        Value.View.Controls.PanX < 0.0 And Value.View.Controls.PanY > 0.0 And
        Value.View.Controls.OrbitYaw = 0.0,
        "Shared Shift Middle Drag Pans In Both Axes", Failures)

    Pointer.PanModifier = False
    Pointer.OrbitPressed = False
    Ok = Motion.UpdatePointer(Value.View.Controls, Value.View.Zoom, Pointer)

    Call Check(Value.View.Controls.Panning And Value.View.Controls.OrbitYaw = 0.0,
        "Releasing Shift Mid-Drag Keeps Pan Until Mouse Release", Failures)

    Pointer.OrbitHeld = False
    Pointer.OrbitReleased = True
    Ok = Motion.UpdatePointer(Value.View.Controls, Value.View.Zoom, Pointer)

    Call Check(Not Value.View.Controls.Panning And Not Value.View.Controls.Orbiting,
        "Middle Release Ends Captured Pan", Failures)

    ActorCamera.Frame.PanXLimit = 500.0
    ActorCamera.Frame.PanYLimit = 500.0
    ActorPointer = ViewerCamera.CreatePointerInput(False, True, True, False,
        False, False, False, 400, 300, 12, 6, 1440, 994, True, False, True)
    Ok = ViewerCamera.UpdatePointerInteraction(ActorCamera, ActorPointer, 1, 3, 8)

    Call Check(ActorCamera.Controls.Panning And Not ActorCamera.CalibrationOrbitActive And
        ActorCamera.Controls.PanX < 0.0 And ActorCamera.Controls.PanY > 0.0,
        "Character And Party Camera Uses Shared Shift Middle Pan", Failures)

    ActorPointer.PanModifier = False
    ActorPointer.OrbitPressed = False
    Ok = ViewerCamera.UpdatePointerInteraction(ActorCamera, ActorPointer, 1, 3, 8)

    Call Check(ActorCamera.Controls.Panning And ActorCamera.Controls.OrbitYaw = 0.0,
        "Character Camera Keeps Pan Capture After Shift Release", Failures)
    Call Town.ResetOverview(Value)

End Sub

Private Sub KeyboardModes(ByRef Value As Town.State, ByRef Failures As Number)

    Dim Keys As Keyboard.HeldKeys
    Dim Empty As Keyboard.HeldKeys
    Dim Leader As P.Vector3
    Dim Follower As P.Vector3
    Dim Eye As P.Vector3
    Dim Aim As P.Vector3
    Dim Zoom As Double
    Dim Yaw As Double
    Dim Index As Number

    Call Check(Not Value.Keys.FlyInspect, "Fly Inspect Starts Off", Failures)
    Call Town.ResetOverview(Value)
    Call Town.Update(Value, 0)

    Value.Cinematic = False
    Leader = Value.People.Path.Positions[0]
    Zoom = Value.View.Zoom.Target
    Yaw = Value.View.Controls.OrbitYaw
    Keys.ArrowForward = 1.0
    Keys.ArrowSide = -1.0

    Call Town.AdvanceKeyboard(Value, Keys, 100)
    Call Check(Value.View.Zoom.Target < Zoom And Value.View.Controls.OrbitYaw < Yaw,
        "Held Up Zooms In And Left Orbits Left With Fly Off", Failures)
    Call Check(M.Distance(Leader, Value.People.Path.Positions[0]) < 0.001,
        "Arrow Inspection Never Moves The Party", Failures)

    Keys.ArrowForward = -1.0
    Keys.ArrowSide = 1.0

    Call Town.AdvanceKeyboard(Value, Keys, 100)
    Call Check(Abs(Value.View.Zoom.Target - Zoom) < 0.001 And
        Abs(Value.View.Controls.OrbitYaw - Yaw) < 0.001,
        "Down And Right Reverse Zoom And Orbit", Failures)

    Call Town.ResetOverview(Value)
    Call Town.Input(Value, KEY_SPACE, False)
    Call Check(Value.Cinematic And Value.OrbitPaused, "Space Pauses Automatic Orbit", Failures)
    Call Town.Input(Value, KEY_SPACE, False)
    Call Check(Value.Cinematic And Not Value.OrbitPaused, "Space Resumes Automatic Orbit", Failures)
    Call Town.ToggleInspection(Value)

    Keys = Empty
    Keys.ArrowForward = 1.0
    Eye = Value.View.LiveCamera.Position
    Leader = Value.People.Path.Positions[0]
    Follower = Value.People.Path.Positions[1]

    For Index = 0 To 30
        Call Town.AdvanceKeyboard(Value, Keys, 16)
        Call Drone.Compose(Value.Flight, Value.View, Value.BaseCamera, False, 16)
    End For

    Call Check(M.Distance(Eye, Value.View.LiveCamera.Position) > 1.0 And
        M.Distance(Leader, Value.People.Path.Positions[0]) < 0.001 And
        M.Distance(Follower, Value.People.Path.Positions[1]) < 0.001,
        "Fly Arrows Move The Camera And Freeze All Party Slots", Failures)

    Call Keyboard.StopTravel(Value.Keys)

    Keys = Empty
    Keys.Vertical = 1.0
    Eye = Value.BaseCamera.Position
    Aim = M.Subtract(Value.BaseCamera.Target, Eye)

    For Index = 0 To 20
        Call Town.AdvanceKeyboard(Value, Keys, 16)
        Call Drone.Compose(Value.Flight, Value.View, Value.BaseCamera, False, 16)
    End For

    Call Check(Value.BaseCamera.Position.Y > Eye.Y And
        Abs(Value.BaseCamera.Position.X - Eye.X) < 0.001 And
        Abs(Value.BaseCamera.Position.Z - Eye.Z) < 0.001 And
        M.Distance(Aim, M.Subtract(Value.BaseCamera.Target, Value.BaseCamera.Position)) < 0.001,
        "Fly Space Ascends Vertically Without Changing The View Direction", Failures)
    Call Keyboard.StopTravel(Value.Keys)

    Keys.Vertical = -1.0
    Eye = Value.BaseCamera.Position

    For Index = 0 To 20
        Call Town.AdvanceKeyboard(Value, Keys, 16)
        Call Drone.Compose(Value.Flight, Value.View, Value.BaseCamera, False, 16)
    End For

    Call Check(Value.BaseCamera.Position.Y < Eye.Y And
        M.Distance(Leader, Value.People.Path.Positions[0]) < 0.001,
        "Fly Shift Space Descends Without Moving The Party", Failures)

    Keys = Empty
    Keys.ArrowForward = 1.0

    Call Keyboard.StopTravel(Value.Keys)
    Call Motion.Reset(Value.View.Controls, Value.View.Zoom)

    Value.BaseCamera.Position = P.Vector(0.0, 40.0, -2780.0)
    Value.BaseCamera.Target = P.Vector(0.0, 0.0, -2700.0)
    Value.View.LiveCamera = Value.BaseCamera

    For Index = 0 To 60
        Call Town.AdvanceKeyboard(Value, Keys, 100)
        Call Drone.Compose(Value.Flight, Value.View, Value.BaseCamera, False, 100, False, True)
    End For

    Eye = Value.View.LiveCamera.Position

    Call Check(Abs(Eye.Y - Navigation.GroundHeight(Eye.X, Eye.Z) - 0.1) < 0.01,
        "Fly Inspect Reaches Ground Level Without Passing Through The Floor", Failures)
    Call Town.ToggleInspection(Value)

    Eye = Value.BaseCamera.Position
    Keys = Empty

    Call Town.AdvanceKeyboard(Value, Keys, 100)
    Call Check(Not Value.Keys.FlyInspect And M.Distance(Eye, Value.BaseCamera.Position) < 0.001,
        "Turning Fly Off Cancels Residual Camera Travel", Failures)

    Keys.Sideways = 1.0

    Call Party.Teleport(Value.People, P.Vector(0.0, 23.12, -2780.0))
    Call Town.ResetOverview(Value)
    Call Town.Update(Value, 0)

    Leader = Value.People.Path.Positions[0]

    For Index = 0 To 30
        Call Town.AdvanceKeyboard(Value, Keys, 16)
    End For

    Call Check(M.Distance(Leader, Value.People.Path.Positions[0]) > 1.0,
        "WASD Resumes Party Movement After Fly Is Turned Off", Failures)
    Call Town.ResetOverview(Value)

End Sub

Private Sub InspectionPitch(ByRef Value As Town.State, ByRef Failures As Number)

    Dim Offset As P.Vector3
    Dim Pitch As Double

    Call Town.ResetOverview(Value)

    Value.Cinematic = False
    Value.Follow = False
    Value.View.Controls.OrbitPitch = -75.0
    Value.View.Zoom.Current = 18000.0
    Value.View.Zoom.Target = 18000.0

    Call Town.Update(Value, 0)

    Offset = M.Subtract(Value.View.LiveCamera.Position, Value.View.LiveCamera.Target)
    Pitch = M.Degrees(Atan2(Offset.Y, Sqrt(Offset.X * Offset.X + Offset.Z * Offset.Z)))

    Call Check(Abs(Pitch) < 0.01 And Value.View.LiveCamera.Target.Y < 1000.0,
        "Inspection Cannot Lift Its Aim Into The Sky At Maximum Zoom", Failures)

    Value.Follow = True
    Value.Flight.OrbitAtParty = True
    Value.Flight.Suspended = True
    Value.Flight.OrbitOffset = Offset
    Value.Flight.OrbitLookOffset = P.Vector(0.0, 0.0, 0.0)
    Value.View.Controls.OrbitPitch = -75.0

    Call Town.Update(Value, 0)

    Offset = M.Subtract(Value.View.LiveCamera.Position, Value.View.LiveCamera.Target)
    Pitch = M.Degrees(Atan2(Offset.Y, Sqrt(Offset.X * Offset.X + Offset.Z * Offset.Z)))

    Call Check(Abs(Pitch) < 0.01,
        "Manual Orbit Around The Party Reaches Zero But Rejects Sky-Facing Pitch", Failures)

    Value.Follow = False
    Value.Flight.OrbitAtParty = False
    Value.View.Controls.OrbitPitch = 160.0

    Call Town.Update(Value, 0)

    Offset = M.Subtract(Value.View.LiveCamera.Position, Value.View.LiveCamera.Target)
    Pitch = M.Degrees(Atan2(Offset.Y, Sqrt(Offset.X * Offset.X + Offset.Z * Offset.Z)))

    Call Check(Pitch <= 80.01 And Pitch >= 79.99,
        "Inspection Keeps Its Upper Orbit Bound", Failures)
    Call Check(Drone.MinimumPitch(True) = -20.0,
        "Party Following Retains Its Low Horizon Range", Failures)
    Call Town.ResetOverview(Value)

    Value.Cinematic = False
    Value.Keys.FlyInspect = True
    Value.View.Controls.OrbitPitch = -120.0
    Value.View.Zoom.Current = 18000.0
    Value.View.Zoom.Target = 18000.0

    Call Town.Update(Value, 0)

    Offset = M.Subtract(Value.View.LiveCamera.Position, Value.View.LiveCamera.Target)
    Pitch = M.Degrees(Atan2(Offset.Y, Sqrt(Offset.X * Offset.X + Offset.Z * Offset.Z)))

    Call Check(Abs(Pitch) < 0.01 And Value.View.LiveCamera.Target.Y < 1000.0,
        "Fly Inspect Orbit Stops At Horizon Without Lifting The Town Out Of View", Failures)

    Value.Keys.FlyInspect = False

    Call Town.ResetOverview(Value)

End Sub

Private Sub BridgeDepthPrecision(ByRef Value As Town.State, ByRef Failures As Number)

    Dim Depth As Double
    Dim NearValue As Double
    Dim FarValue As Double
    Dim Gap As Double
    Dim PavingDepth As Double
    Dim SupportDepth As Double
    Dim Index As Number
    Dim Separated As Boolean

    Call Town.ResetOverview(Value)

    ' Evaluate the distant bridge range at the actual far-zoom camera, not the closer reset shot.
    Value.View.Zoom.Current = ToDouble(Motion.ZOOM_OUT_LIMIT)
    Value.View.Zoom.Target = Value.View.Zoom.Current
    Value.View.Controls.Zoom = Value.View.Zoom.Current

    Call Town.Update(Value, 0)

    NearValue = Value.View.LiveCamera.NearPlane
    FarValue = Value.View.LiveCamera.FarPlane
    ' Native bridge deck is Y22.5; paving is Y23.12. At 35 degrees this
    ' projects to about 0.356 camera-depth units, below one old depth-buffer step.
    Gap = 0.62 * Sin(M.Radians(35.0))
    Separated = True

    For Index = 0 To 8

        Depth = 18000.0 + ToDouble(Index) * 500.0
        PavingDepth = (FarValue / (FarValue - NearValue) -
            FarValue * NearValue / ((FarValue - NearValue) * Depth))
        SupportDepth = (FarValue / (FarValue - NearValue) -
            FarValue * NearValue / ((FarValue - NearValue) * (Depth + Gap)))
        Separated = Separated And (SupportDepth - PavingDepth) * 16777215.0 > 4.0
    End For

    Call Check(Separated, "Moving Overview Keeps Bridge Deck And Paving Depths Distinct", Failures)
    Call Town.Input(Value, KEY_TAB, True)
    Call Arena.AdvanceTransition(Value.View, 1000)
    Call Town.Update(Value, 0)
    Call Check(Value.View.LiveCamera.NearPlane = 25.0,
        "Ground-Level Party Shot Retains Its Close Clipping Distance", Failures)
    Call Town.ResetOverview(Value)

End Sub

Private Sub WalkingCameraGesture(ByRef Value As Town.State, ByRef Failures As Number)

    Dim Input As Motion.PointerInput
    Dim Owned As Boolean
    Dim OriginalZoom As Double
    Dim Index As Number

    Call Town.Input(Value, KEY_TAB, True)

    OriginalZoom = Value.View.Zoom.Target

    For Index = 0 To 1

        Input.PanHeld = Index = 0
        Input.OrbitHeld = Index = 1
        Owned = Drone.MovingGesture(Value.Flight, Value.View, Input, Value.PartyCamera, True)

        Call Motion.ApplyDrag(Value.View.Controls, Input.OrbitHeld, Input.PanHeld, 20, 10, 360.0, 220.0)
        Call Check(Owned And Value.Flight.Peeking And Value.PartyCamera And Not Value.Flight.Suspended,
            "Walking Pan And Orbit Retain Party Framing", Failures)

        Input.PanHeld = False
        Input.OrbitHeld = False
        Owned = Drone.MovingGesture(Value.Flight, Value.View, Input, Value.PartyCamera, True)

        Call Check(Owned And Not Value.Flight.Peeking And Value.View.TransitionDuration = 1000 And
            Value.View.Controls.PanX = 0.0 And Value.View.Controls.OrbitYaw = 0.0 And
            Value.View.Zoom.Target = OriginalZoom And Value.PartyCamera,
            "Released Walking Gesture Eases Back In One Second And Retains Zoom", Failures)
        Call Arena.AdvanceTransition(Value.View, 1000)
    End For

    Input.PanHeld = True
    Owned = Drone.MovingGesture(Value.Flight, Value.View, Input, False, True)

    Call Check(Not Owned, "Free Camera Drag Does Not Switch To Party Framing", Failures)
    Call Town.ResetOverview(Value)

End Sub

Private Sub IdleOrbit(ByRef Value As Town.State, ByRef Failures As Number)

    Call Town.ResetOverview(Value)

    Call Arena.BeginTransition(Value.View, 1000)

    Value.View.PreviousTime = Timer() - 250

    Call Arena.Update(Value.View, KEY_NONE, True, 24)
    Call Check(Value.View.TransitionElapsed >= 250 And Value.View.TransitionDuration = 1000,
        "Minimap Pointer Ownership Still Advances Camera Easing", Failures)
    Call Arena.AdvanceTransition(Value.View, 1000)

    Value.Cinematic = False
    Value.IdleOrbit = False
    Value.IdleTime = 0

    Value.Keys.FlyInspect = True

    Call Town.UpdateIdle(Value, False, 20000)
    Call Check(Not Value.Cinematic And Value.IdleTime = 0,
        "Fly Inspect Remains Still Instead Of Starting Idle Orbit", Failures)

    Value.Keys.FlyInspect = False

    Value.Map.Opacity = 80.0

    Call Town.UpdateIdle(Value, False, 20000, False, True)
    Call Check(Not Value.Cinematic And Value.IdleTime = 0,
        "Hovering The Visible Minimap Prevents Idle Orbit From Hiding It", Failures)

    Value.Map.Opacity = 0.0

    Call Town.UpdateIdle(Value, False, 20000, False, True)
    Call Check(Value.Cinematic And Value.IdleOrbit,
        "Hovering A Hidden Minimap Does Not Block Idle Orbit", Failures)
    Call Town.UpdateIdle(Value, True, 0)

    Call Town.UpdateIdle(Value, False, 19999)
    Call Check(Not Value.Cinematic, "Idle Orbit Waits The Full Twenty Seconds", Failures)
    Call Town.UpdateIdle(Value, True, 1)
    Call Check(Value.IdleTime = 0, "Input Restarts The Idle Countdown", Failures)
    Call Town.UpdateIdle(Value, False, 20000)
    Call Check(Value.Cinematic And Value.IdleOrbit And Not Value.PartyCamera,
        "Twenty Seconds Of Inactivity Starts Inspection Orbit", Failures)
    Call Town.UpdateIdle(Value, True, 1)
    Call Check(Not Value.Cinematic And Not Value.IdleOrbit And Value.IdleTime = 0,
        "Input Immediately Stops Automatic Idle Orbit", Failures)
    Call Town.UpdateIdle(Value, False, 20000)
    Call Town.Input(Value, KEY_TAB, True)
    Call Check(Not Value.IdleOrbit And Value.IdleTime = 0 And Value.InputActive,
        "Input Wakes Idle Orbit Before Routing To Minimap Or Camera", Failures)
    Call Authoring.BeginEditing()
    Call Town.UpdateIdle(Value, False, 20000)
    Call Check(Not Value.Cinematic And Not Value.IdleOrbit And Value.IdleTime = 0,
        "Editor Remains Still After The Idle Orbit Interval", Failures)

    ' The legacy scene does not delegate input to an editable document.

    Call Authoring.Input(Value.View.LiveCamera, KEY_TAB, True)
    Call Town.Input(Value, KEY_TAB, True)

End Sub

Private Sub PartyMovementAcrossCameras(ByRef Value As Town.State, ByRef Failures As Number)

    Dim StartPosition As P.Vector3
    Dim StartView As P.Camera3D
    Dim StopPosition As P.Vector3
    Dim Mode As Number
    Dim Frame As Number

    StartPosition = P.Vector(0.0, 23.12, -2780.0)

    For Mode = 0 To 5

        Call Party.Teleport(Value.People, StartPosition)
        Call Town.ResetOverview(Value)

        If Mode = 1 Then
            Call Town.StartOrbit(Value)
        Else If Mode = 2 Then
            Call Motion.ApplyDrag(Value.View.Controls, False, True, 20, 10, 360.0, 220.0)
        Else If Mode = 3 Then
            Call Motion.ApplyDrag(Value.View.Controls, True, False, 20, 10, 360.0, 220.0)
        Else If Mode = 4 Then
            Call Town.FitTown(Value)
        Else If Mode = 5 Then
            Call Town.Input(Value, KEY_TAB, True)
        End If

        StartView = Value.BaseCamera

        For Frame = 1 To 60
            Call Town.MoveParty(Value, P.Vector(1.0, 0.0, 0.0), 16)
        End For

        Call Check(Value.People.Path.Positions[0].X > StartPosition.X + 50.0 And
            M.Distance(Value.People.Path.Positions[1], StartPosition) > 1.0,
            "Leader And Followers Move After Overview Orbit Pan Fit And Tab", Failures)
        Call Check(Not Value.Cinematic And
            M.Distance(StartView.Position, Value.BaseCamera.Position) < 0.001,
            "Movement Stops Showcase Orbit Without Becoming Free Camera Travel", Failures)

        StopPosition = Value.People.Path.Positions[0]

        Call Town.MoveParty(Value, P.Vector(0.0, 0.0, 0.0), 100)
        Call Check(M.Distance(StopPosition, Value.People.Path.Positions[0]) < 0.001,
            "Released Movement Stops The Leader In Every Camera Mode", Failures)
    End For

    Call Party.Teleport(Value.People, StartPosition)
    Call Town.ResetOverview(Value)

End Sub

Private Sub ZoomAfterTab(ByRef Value As Town.State, ByRef Failures As Number)

    Dim Pointer As Motion.PointerInput
    Dim Before As P.Vector3
    Dim After As P.Vector3
    Dim Settled As P.Camera3D
    Dim Index As Number
    Dim Ok As Boolean
    Dim StableAngle As Boolean

    Value.View.FloorVisible = False
    StableAngle = True

    Call Town.Input(Value, KEY_TAB, True)
    Call Arena.AdvanceTransition(Value.View, 1000)
    Call Town.Update(Value, 0)

    Ok = M.TryNormalize(M.Subtract(Value.View.LiveCamera.Target,
        Value.View.LiveCamera.Position), Before)
    Pointer.Wheel = -5
    Ok = Motion.UpdatePointer(Value.View.Controls, Value.View.Zoom, Pointer)

    For Index = 1 To 180

        Call Motion.Advance(Value.View.Controls, Value.View.Zoom, 16)
        Call Town.Update(Value, 16)

        Ok = M.TryNormalize(M.Subtract(Value.View.LiveCamera.Target,
            Value.View.LiveCamera.Position), After)
        StableAngle = StableAngle And M.Distance(Before, After) < 0.001
    End For

    Settled = Value.View.LiveCamera
    Ok = M.TryNormalize(M.Subtract(Settled.Target, Settled.Position), After)

    Call Check(StableAngle,
        "Tab Wheel Zoom Preserves The Horizon Angle", Failures)
    Call Check(Value.View.Zoom.Current = Value.View.Zoom.Target,
        "Wheel Zoom Reaches Its Requested Target", Failures)

    For Index = 1 To 60
        Call Motion.Advance(Value.View.Controls, Value.View.Zoom, 16)
        Call Town.Update(Value, 16)
    End For

    Call Check(M.Distance(Settled.Position, Value.View.LiveCamera.Position) < 0.01 And
        M.Distance(Settled.Target, Value.View.LiveCamera.Target) < 0.01,
        "Released Wheel Leaves No Slow Drone Zoom Drift", Failures)

    Pointer.Wheel = 5
    Ok = Motion.UpdatePointer(Value.View.Controls, Value.View.Zoom, Pointer)

    For Index = 1 To 60
        Call Motion.Advance(Value.View.Controls, Value.View.Zoom, 16)
        Call Town.Update(Value, 16)
    End For

    Ok = M.TryNormalize(M.Subtract(Value.View.LiveCamera.Target,
        Value.View.LiveCamera.Position), After)

    Call Check(M.Distance(Before, After) < 0.001 And
        M.Distance(Value.View.LiveCamera.Position, Value.View.LiveCamera.Target) < 400.0,
        "Wheel Zoom In Returns To The Same Party Framing", Failures)
    Call Town.ResetOverview(Value)

End Sub

Private Sub Check(Condition As Boolean, Label As Text, ByRef Failures As Number)

    If Not Condition Then
        Failures = Failures + 1
        Print "FAIL " + Label
    End If

End Sub

End Module
