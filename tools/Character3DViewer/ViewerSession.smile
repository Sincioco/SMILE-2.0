''' Application-session identity, readiness and first-failure ownership.
Module Smile.Tools.Character3DViewerSession

Option Explicit

Import Smile.Simple3D.Character3D As Character3D
Import Smile.Simple3D.Graphics3D As Graphics3D
Import Smile.Simple3D.Scene3D As Scene3D
Import Smile.Tools.Character3DViewerCalibration As ViewerCalibration
Import Smile.Tools.Character3DViewerCalibrationEditing As ViewerCalibrationEditing
Import Smile.Tools.Character3DViewerParty As ViewerParty
Import Smile.Tools.Character3DViewerProfiles As ViewerProfiles

Public Type State
    SelectedCharacterTab As Number
    DragonInspection As Boolean
    CharacterSwitchBlocked As Boolean
    Ready As Boolean
    Running As Boolean
    ViewerError As Boolean
    FirstViewerError As Number
    FirstRendererError As Number
    FirstFailureStage As Number
    ViewerEpoch As Number
    ProfileIndex As Number
End Type

Public Sub SelectCharacterTab(ByRef Value As State, Index As Number)

    Value.SelectedCharacterTab = Index
    Value.DragonInspection = Index = 2
    Value.ProfileIndex = ViewerProfiles.PROFILE_ARIN

    If Index = 1 Then
        Value.ProfileIndex = ViewerProfiles.PROFILE_ORIN
    Else If Index = 2 Then
        Value.ProfileIndex = ViewerProfiles.PROFILE_DRAGON
    End If

End Sub

Public Function ShouldSelectCharacterTab(ByRef Value As State,
    Index As Number, PartyEnabled As Boolean) As Boolean

    Dim Result As Boolean

    Result = True

    If (Index = Value.SelectedCharacterTab And
        Not Value.ViewerError And
        (PartyEnabled Or
        Value.DragonInspection Or
        ViewerProfiles.IsPartyCharacter(Value.ProfileIndex))) Then
        Result = False
    End If

    Return Result

End Function

Public Sub CycleProfile(ByRef Value As State)

    Value.DragonInspection = False
    Value.SelectedCharacterTab = 0
    Value.ProfileIndex = ViewerProfiles.NextProfile(Value.ProfileIndex)

    If Value.ProfileIndex = ViewerProfiles.PROFILE_ORIN Then
        Value.SelectedCharacterTab = 1
    Else If Value.ProfileIndex = ViewerProfiles.PROFILE_DRAGON Then
        Value.SelectedCharacterTab = 2
        Value.DragonInspection = True
    End If

End Sub

Public Sub Start(ByRef Value As State)

    Value.Running = True

End Sub

Public Sub ContinueRunning(ByRef Value As State, Closed As Boolean)

    Value.Running = Value.Running And Not Closed

End Sub

Public Sub BlockCharacterSwitch(ByRef Value As State)

    Value.CharacterSwitchBlocked = True

End Sub

Public Sub ClearCharacterSwitchBlock(ByRef Value As State)

    Value.CharacterSwitchBlocked = False

End Sub

Public Sub CaptureResourceEpoch(ByRef Value As State)

    Value.ViewerEpoch = Graphics3D.ResourceEpoch3D()

End Sub

Public Sub ResetFailure(ByRef Value As State)

    Value.Ready = True
    Value.ViewerError = False
    Value.FirstViewerError = 0
    Value.FirstRendererError = 0
    Value.FirstFailureStage = 0

End Sub

Public Sub RecordError(ByRef Value As State)

    Value.ViewerError = True

    If Value.FirstViewerError = 0 Then

        Value.FirstViewerError = Character3D.LastError()

        If Value.FirstViewerError = 0 Then
            Value.FirstViewerError = Scene3D.LastError()
        End If

    End If

    If Value.FirstRendererError = 0 Then

        Value.FirstRendererError = Character3D.LastRendererError()

        If Value.FirstRendererError = 0 Then
            Value.FirstRendererError = Scene3D.LastRendererError()
        End If

        If Value.FirstRendererError = 0 Then
            Value.FirstRendererError = Graphics3D.LastError()
        End If

    End If

End Sub

Public Sub CaptureFailure(ByRef Value As State, Stage As Number)

    If Value.Ready Or Value.FirstFailureStage <> 0 Then
        Return
    End If

    Value.FirstFailureStage = Stage
    Value.FirstViewerError = Character3D.LastError()

    If Value.FirstViewerError = 0 Then
        Value.FirstViewerError = Scene3D.LastError()
    End If

    Value.FirstRendererError = Character3D.LastRendererError()

    If Value.FirstRendererError = 0 Then
        Value.FirstRendererError = Scene3D.LastRendererError()
    End If

    If Value.FirstRendererError = 0 Then
        Value.FirstRendererError = Graphics3D.LastError()
    End If

End Sub

Public Sub ApplyCalibrationOperation(ByRef Value As State,
    Result As ViewerCalibrationEditing.OperationResult)

    Value.Ready = Result.Ready And Value.Ready

    Call CaptureOperationFailure(
        Value, Result.Applied, Result.FailureStage, 0)

    If Result.Finished Then
        Call ClearCharacterSwitchBlock(Value)
    End If

End Sub

Public Sub ApplyCalibrationResult(ByRef Value As State,
    Result As ViewerCalibration.ApplicationResult)

    Value.Ready = Result.Ready And Value.Ready

    Call CaptureOperationFailure(Value, True, Result.FailureStage, 71)

End Sub

Public Sub ApplyParticipantUpdate(ByRef Value As State,
    Result As ViewerParty.ParticipantUpdateResult)

    Value.Ready = Result.Ready And Value.Ready

    Call CaptureOperationFailure(
        Value, Result.Updated, Result.FailureStage, 71)

End Sub

Private Sub CaptureOperationFailure(ByRef Value As State,
    Attempted As Boolean, FailureStage As Number, DefaultStage As Number)

    Dim Stage As Number

    If Not Attempted Or Value.Ready Then
        Return
    End If

    Stage = FailureStage

    If Stage = 0 Then
        Stage = DefaultStage
    End If

    If Stage <> 0 Then
        Call CaptureFailure(Value, Stage)
    End If

End Sub

End Module
