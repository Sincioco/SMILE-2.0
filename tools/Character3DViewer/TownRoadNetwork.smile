''' Gameplay's active road graph; immutable saves own a separate instance of the same builder.
Module Smile.Tools.TownRoadNetwork

Option Explicit

Import Smile.Tools.TownRoadGraph As Graph
Import Smile.Tools.TownDocument As Document
Import Smile.Tools.TownDocumentNavigation As Navigation
Import Smile.Simple3D.Precision3D As P

Private Dim Live As Graph.State

Public Sub Adopt(ByRef Town As Document.State)

    Call Graph.Adopt(Live, Town, Navigation.Version())

End Sub

Public Sub Prepare(ByRef Town As Document.State, Optional Budget As Number = 2)

    Call Graph.Prepare(Live, Town, Navigation.Version(), Budget)

End Sub

Public Function Size() As Number

    Dim Result As Number

    Result = Graph.Size(Live)

    Return Result

End Function

Public Function Center(Cell As Number) As P.Vector3

    Dim Result As P.Vector3

    Result = Graph.Center(Live, Cell)

    Return Result

End Function

Public Function Neighbor(Cell As Number, Side As Number) As Number

    Dim Result As Number

    Result = Graph.Neighbor(Live, Cell, Side)

    Return Result

End Function

Public Function Connection(Cell As Number, Side As Number, Deadline As Number) As Number

    Dim Result As Number

    Result = Graph.Connection(Live, Cell, Side, Deadline)

    Return Result

End Function

Public Function Progress() As Number

    Dim Result As Number

    Result = Graph.Progress(Live)

    Return Result

End Function

Public Function CollisionChecks() As Number

    Dim Result As Number

    Result = Graph.CollisionChecks(Live)

    Return Result

End Function

End Module
