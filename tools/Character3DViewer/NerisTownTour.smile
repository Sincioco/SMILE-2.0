''' Simple map-wide orbit framing from the approved overview perspective.
Module Smile.Tools.NerisTownTour

Option Explicit

Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.PrecisionMath3D As M

Public Sub Frame(ByRef Camera As P.Camera3D, Center As P.Vector3,
    Optional Radius As Double = 8725.0, Optional Heading As Double = -179.0,
    Optional Elevation As Double = 33.0)

    Dim Pitch As Double
    Dim Bearing As Double

    Pitch = M.Radians(Elevation)
    Bearing = M.Radians(Heading)
    Camera.OrthographicHeight = 0.0
    Camera.UpDirection = P.Vector(0.0, 1.0, 0.0)
    Camera.FovDegrees = 32.0
    Camera.Target = Center
    Camera.Position = M.Add(Center, P.Vector(Sin(Bearing) * Cos(Pitch) * Radius,
        Sin(Pitch) * Radius, Cos(Bearing) * Cos(Pitch) * Radius))

End Sub

''' Retain the displayed bearing; the live orbit clock advances from this angle.
Public Sub ContinueOrbit(ByRef Overview As P.Camera3D, Displayed As P.Camera3D)

    Dim Offset As P.Vector3
    Dim Heading As Double
    Dim Radius As Double

    Offset = M.Subtract(Displayed.Position, Displayed.Target)
    Heading = Atan2(Offset.X, Offset.Z)
    Offset = M.Subtract(Overview.Position, Overview.Target)
    Radius = Sqrt(Offset.X * Offset.X + Offset.Z * Offset.Z)
    Overview.Position = M.Add(Overview.Target,
        P.Vector(Sin(Heading) * Radius, Offset.Y, Cos(Heading) * Radius))

End Sub

''' Sin's September 29 reference view, read from the camera HUD in the approved image.
Public Sub TownOverview(ByRef Camera As P.Camera3D, Center As P.Vector3)

    Camera.OrthographicHeight = 0.0
    Camera.UpDirection = P.Vector(0.0, 1.0, 0.0)
    Camera.FovDegrees = 32.0
    Camera.Target = Center
    Camera.Position = M.Add(Center, P.Vector(4475.0, 2907.0, -6616.0))

End Sub

End Module
