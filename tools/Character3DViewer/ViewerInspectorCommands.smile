''' Focused inspector routing for rendering and VFX commands that own their state.
Module Smile.Tools.Character3DViewerInspectorCommands

Option Explicit

Import Smile.Tools.Character3DViewerEffects As ViewerEffects
Import Smile.Tools.Character3DViewerCamera As ViewerCamera
Import Smile.Tools.Character3DViewerDragon As ViewerDragon
Import Smile.Tools.Character3DViewerInput As ViewerInput
Import Smile.Tools.Character3DViewerParty As ViewerParty
Import Smile.Tools.Character3DViewerRendering As ViewerRendering
Import Smile.Tools.Character3DViewerUi As ViewerUi

Public Type OperationResult
    Handled As Boolean
    Ready As Boolean
End Type

Public Function ApplyPresentationAction(Action As Number,
    ByRef Rendering As ViewerRendering.State, BackgroundCount As Number,
    ByRef Effects As ViewerEffects.State,
    ByRef Dragon As ViewerDragon.State) As OperationResult

    Dim Result As OperationResult

    Result.Ready = True

    If Action = ViewerUi.INSPECTOR_ACTION_LIGHTING Then
        Result.Ready = ViewerRendering.CycleLighting(Rendering)
    Else If Action = ViewerUi.INSPECTOR_ACTION_MATERIAL Then
        Result.Ready = ViewerRendering.CycleMaterialInspection(Rendering)
    Else If Action = ViewerUi.INSPECTOR_ACTION_SOCKET Then
        Call ViewerRendering.CycleSocketDisplay(Rendering)
    Else If Action = ViewerUi.INSPECTOR_ACTION_BACKGROUND Then
        Call ViewerRendering.CycleBackground(Rendering, BackgroundCount)
    Else If Action = ViewerUi.INSPECTOR_ACTION_FLOOR Then
        Call ViewerRendering.ToggleFloorAndGrid(Rendering)
    Else If Action = ViewerUi.INSPECTOR_ACTION_STORM_STYLE Then
        Call ViewerEffects.CycleStormStyle(Effects)
    Else If Action = ViewerUi.INSPECTOR_ACTION_SWORD_FIRE Then
        Call ViewerEffects.ToggleSwordFire(Effects)
    Else If Action = ViewerUi.INSPECTOR_ACTION_SHIELD_FIRE Then
        Call ViewerEffects.ToggleShieldFire(Effects)
    Else If Action = ViewerUi.INSPECTOR_ACTION_STORM_COMFORT Then
        Call ViewerEffects.CycleStormSceneComfort()
    Else If Action = ViewerUi.INSPECTOR_ACTION_LIGHTNING_PAUSE Then
        Call ViewerEffects.ToggleLightningPause(Effects)
    Else If Action = ViewerUi.INSPECTOR_ACTION_FLAME_PAUSE Then
        Call ViewerEffects.ToggleFlamePause(Effects)
    Else If Action = ViewerUi.INSPECTOR_ACTION_SHIELD_FIRE_STYLE Then
        Call ViewerEffects.ToggleShieldFireStyle(Effects)
    Else If Action = ViewerUi.INSPECTOR_ACTION_DRAGON Then
        Call ViewerDragon.ToggleVisible(Dragon, Effects.DragonLight)
    Else
        Return Result
    End If

    Result.Handled = True

    Return Result

End Function

Public Function ApplyPartyPresentationAction(Action As Number,
    ByRef Rendering As ViewerRendering.State, BackgroundCount As Number,
    ByRef Effects As ViewerEffects.State,
    ByRef Camera As ViewerCamera.State,
    ByRef Dragon As ViewerDragon.State) As OperationResult

    Dim Result As OperationResult

    Result.Ready = True

    If Action = ViewerParty.POINTER_ACTION_CYCLE_SOCKET Then
        Call ViewerRendering.CycleSocketDisplay(Rendering)
    Else If Action = ViewerParty.POINTER_ACTION_TOGGLE_FLOOR Then
        Call ViewerRendering.ToggleFloorAndGrid(Rendering)
    Else If Action = ViewerParty.POINTER_ACTION_CYCLE_BACKGROUND Then
        Call ViewerRendering.CycleBackground(Rendering, BackgroundCount)
    Else If Action = ViewerParty.POINTER_ACTION_TOGGLE_ORBIT Then
        Call ViewerCamera.ToggleAutoOrbit(Camera)
    Else If Action = ViewerParty.POINTER_ACTION_TOGGLE_FIRE Then
        Call ViewerEffects.ToggleFlamePause(Effects)
    Else If Action = ViewerParty.POINTER_ACTION_TOGGLE_LIGHTNING Then
        Call ViewerEffects.ToggleLightningPause(Effects)
    Else If Action = ViewerParty.POINTER_ACTION_TOGGLE_SHIELD_STYLE Then
        Call ViewerEffects.ToggleShieldFireStyle(Effects)
    Else If Action = ViewerParty.POINTER_ACTION_TOGGLE_DRAGON Then
        Call ViewerDragon.ToggleVisible(Dragon, Effects.DragonLight)
    Else
        Return Result
    End If

    Result.Handled = True

    Return Result

End Function

Public Function ApplyKeyboardNavigationAction(Action As Number,
    ByRef Rendering As ViewerRendering.State, BackgroundCount As Number,
    SocketCount As Number,
    ByRef Camera As ViewerCamera.State,
    ByRef Effects As ViewerEffects.State,
    ByRef Dragon As ViewerDragon.State) As OperationResult

    Dim Result As OperationResult

    Result.Ready = True

    If Action = ViewerInput.INSPECTOR_KEY_TOGGLE_FLOOR Then
        Call ViewerRendering.ToggleFloorAndGrid(Rendering)
    Else If Action = ViewerInput.INSPECTOR_KEY_CYCLE_BACKGROUND Then
        Call ViewerRendering.CycleBackground(Rendering, BackgroundCount)
    Else If Action = ViewerInput.INSPECTOR_KEY_SOCKET_PREVIOUS Then
        Call ViewerRendering.SelectPreviousSocket(Rendering, SocketCount)
    Else If Action = ViewerInput.INSPECTOR_KEY_SOCKET_NEXT Then
        Call ViewerRendering.SelectNextSocket(Rendering, SocketCount)
    Else If Action = ViewerInput.INSPECTOR_KEY_ORBIT_LEFT Then
        Result.Ready = ViewerCamera.NudgeOrbit(Camera, -5, 0)
    Else If Action = ViewerInput.INSPECTOR_KEY_ORBIT_RIGHT Then
        Result.Ready = ViewerCamera.NudgeOrbit(Camera, 5, 0)
    Else If Action = ViewerInput.INSPECTOR_KEY_ORBIT_UP Then
        Result.Ready = ViewerCamera.NudgeOrbit(Camera, 0, -5)
    Else If Action = ViewerInput.INSPECTOR_KEY_ORBIT_DOWN Then
        Result.Ready = ViewerCamera.NudgeOrbit(Camera, 0, 5)
    Else If Action = ViewerInput.INSPECTOR_KEY_PAN Then
        Result.Ready = ViewerCamera.NudgePan(Camera, 5, 0)
    Else If Action = ViewerInput.INSPECTOR_KEY_TOGGLE_ORBIT Then
        Call ViewerCamera.ToggleAutoOrbit(Camera)
    Else If Action = ViewerInput.INSPECTOR_KEY_TOGGLE_GRID Then
        Call ViewerRendering.ToggleGrid(Rendering)
    Else If Action = ViewerInput.INSPECTOR_KEY_TOGGLE_DRAGON Then
        Call ViewerDragon.ToggleVisible(Dragon, Effects.DragonLight)
    Else
        Return Result
    End If

    Result.Handled = True

    Return Result

End Function

End Module
