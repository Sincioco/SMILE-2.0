''' Resource owner for the detailed castle. Does not mutate the town catalog or document.
Module Smile.Tools.NerisCastlePreview

Option Explicit

Import Smile.Simple3D.Core As Core
Import Smile.Simple3D.Graphics3D As G
Import Smile.Simple3D.Precision3D As P
Import Smile.Tools.NerisCastleRoute As Route
Import Smile.Tools.NerisCastleGlow As Glow
Import Smile.Tools.NerisCastleFountain As Fountain
Import Smile.Tools.Character3DViewerCalibration As Numbers

Public Type State
    Models[15] As Core.Model3D
    Objects[98] As Core.Object3D
    ObjectCount As Number
    Leaf As Number
    LeafCount As Number
    Doors[2] As Number
    Light As Glow.State
    Water As Fountain.State
    Ready As Boolean
    Visible As Boolean
    Offset As P.Vector3
End Type

Public Function Create(ByRef Value As State) As Boolean

    Dim Index As Number
    Dim Part As Number
    Dim Name As Text
    Dim Object As Core.Object3D
    Dim Ok As Boolean

    If Value.Ready Then
        Return True
    End If

    Ok = True

    For Index = 0 To 14

        Name = "Castle-" + Numbers.NumberText(Index)

        If Index < 10 Then
            Name = "Castle-0" + Numbers.NumberText(Index)
        End If

        If Index = 12 Then
            Name = "Drawbridge"
        Else If Index = 13 Then
            Name = "Door-West"
        Else If Index = 14 Then
            Name = "Door-East"
        End If

        Value.Models[Index] = G.LoadModelGeometry3D("Assets/Neris/CastleV2/" + Name + ".sm3d")
        Ok = Value.Models[Index].GeometryReady And Ok
        Ok = G.PrepareModelPbr3D(Value.Models[Index], G.TEXTURE_FILTER_ANISOTROPIC, 1, 16) And Ok

        For Part = 0 To Value.Models[Index].PartCount - 1

            ' Only the site's flat top remains; buried foundation faces and moat are omitted.

            Object = G.CreateModelPart3D(Value.Models[Index], Part)
            Ok = Object.Handle <> 0 And Ok
            Ok = P.SetScale(Object, Route.SCALE * 100.0, Route.SCALE * 100.0, Route.SCALE * 100.0) And Ok

            If Index = 12 Then

                If Part = 0 Then
                    Value.Leaf = Value.ObjectCount
                End If

                Value.LeafCount = Value.LeafCount + 1
                Ok = P.SetPosition(Object, Route.ORIGIN_X,
                    Route.DECK_Y - 0.25 * Route.SCALE,
                    Route.ORIGIN_Z - 64.0 * Route.SCALE) And Ok

            Else If Index >= 13 Then

                If Part = 0 Then
                    Value.Doors[Index - 13] = Value.ObjectCount
                End If

                Ok = P.SetPosition(Object, Route.ORIGIN_X + ToDouble((Index - 13) * 6 - 3) * Route.SCALE,
                    Route.DECK_Y + 3.0 * Route.SCALE, Route.ORIGIN_Z + 14.55 * Route.SCALE) And Ok

            Else
                Ok = P.SetPosition(Object, Route.ORIGIN_X, Route.DECK_Y, Route.ORIGIN_Z) And Ok

            End If

            Value.Objects[Value.ObjectCount] = Object
            Value.ObjectCount = Value.ObjectCount + 1
        End For
    End For

    Ok = Glow.Create(Value.Light) And Ok
    Ok = Fountain.Create(Value.Water) And Ok
    Value.Ready = Ok
    Value.Visible = Ok
    Value.Offset = P.Vector(0.0, 0.0, 0.0)

    Call Route.Enable(Ok)

    Return Ok

End Function

''' Move every mesh and attached effect from the same document-owned offset.
Public Sub Synchronize(ByRef Value As State, Visible As Boolean, Offset As P.Vector3)

    Dim Index As Number
    Dim Transform As P.Transform3D
    Dim Ok As Boolean

    Call Route.Place(Offset.X, Offset.Z)

    If Value.Visible <> Visible Then
        Call Route.Enable(Visible And Value.Ready)
    End If

    Value.Visible = Visible And Value.Ready

    If Not Value.Ready Or (Value.Offset.X = Offset.X And Value.Offset.Z = Offset.Z) Then
        Return
    End If

    For Index = 0 To Value.ObjectCount - 1

        Ok = P.TryTransform(Value.Objects[Index], Transform)

        If Ok Then
            Ok = P.SetPosition(Value.Objects[Index], Transform.Position.X + Offset.X - Value.Offset.X,
                Transform.Position.Y, Transform.Position.Z + Offset.Z - Value.Offset.Z)
        End If

    End For

    Value.Offset = Offset

    Call Glow.Place(Value.Light)

End Sub

Public Function ApplyLighting(ByRef Value As State) As Boolean

    Dim Ok As Boolean

    Ok = True

    If Value.Ready And Value.Visible Then
        Ok = Glow.ApplyLighting()
    Else
        Ok = G.DisableLight3D(0) And G.DisableLight3D(1) And G.DisableLight3D(2) And G.DisableLight3D(3)
    End If

    Return Ok

End Function

Public Sub Update(ByRef Value As State, Elapsed As Number)

    Call Fountain.Update(Value.Water, Elapsed)

End Sub

Public Function Draw(ByRef Value As State) As Boolean

    Dim Index As Number
    Dim Ok As Boolean

    If Not Value.Ready Or Not Value.Visible Then
        Return True
    End If

    Ok = True

    For Index = Value.Leaf To Value.Leaf + Value.LeafCount - 1
        Ok = P.SetRotation(Value.Objects[Index], Route.Angle(), 0.0, 0.0) And Ok
    End For

    For Index = 0 To 2
        Ok = P.SetRotation(Value.Objects[Value.Doors[0] + Index], 0.0, -Route.DoorAngle(), 0.0) And Ok
        Ok = P.SetRotation(Value.Objects[Value.Doors[1] + Index], 0.0, Route.DoorAngle(), 0.0) And Ok
    End For

    For Index = 0 To Value.ObjectCount - 1
        Ok = G.DrawObject3D(Value.Objects[Index]) And Ok
    End For

    Ok = Glow.Draw(Value.Light) And Ok
    Ok = Fountain.Draw(Value.Water) And Ok

    Return Ok

End Function

Public Sub Destroy(ByRef Value As State)

    Dim Index As Number
    Dim Empty As State

    For Index = 0 To Value.ObjectCount - 1
        Call G.DestroyObject3D(Value.Objects[Index])
    End For

    For Index = 0 To 14
        Call G.DestroyModel3D(Value.Models[Index])
    End For

    Call Glow.Destroy(Value.Light)
    Call Fountain.Destroy(Value.Water)
    Call Route.Enable(False)

    Value = Empty

End Sub

End Module
