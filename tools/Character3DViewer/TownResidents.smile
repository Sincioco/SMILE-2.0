''' Authored town resident lifecycle. Incremental loading, bounded errands and conversations.
Module Smile.Tools.TownResidents

Option Explicit

Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.PrecisionMath3D As M
Import Smile.Simple3D.Character3D As Character
Import Smile.Simple3D.Graphics3D As G
Import Smile.Tools.TownDocumentNavigation As Navigation
Import Smile.Tools.TownNearestRoadSearch As RoadSearch
Import Smile.Tools.TownResidentMovement As Movement
Import Smile.Tools.TownResidentDialogue As Dialogue
Import Smile.Tools.TownNpcLayout As Layout

Public Type Resident
    Kind As Number
    Actor As Character.Actor
    Motion As Movement.State
    Clip As Text
    Ready As Boolean
End Type

Public Type State
    Layout As Layout.State
    TownName As Text
    Total As Number
    NextKind As Number
    People[9] As Resident
    Loaded As Number
    Version As Number
    Nearest As Number
    Speaking As Number
    Approaching As Number
    ApproachVersion As Number
    ApproachActive As Boolean
    Enabled As Boolean
    Failed As Boolean
    Placement As RoadSearch.State
End Type

Public Sub Destroy(ByRef Value As State)

    Dim Index As Number
    Dim Empty As State

    For Index = 0 To Value.Loaded - 1
        Call Character.Destroy(Value.People[Index].Actor)
    End For

    Value = Empty
    Value.Speaking = -1
    Value.Nearest = -1

End Sub

Private Sub LoadNext(ByRef Value As State)

    Dim Index As Number
    Dim Kind As Number
    Dim Position As P.Vector3
    Dim Empty As RoadSearch.State
    Dim Bounds As Character.Bounds3D
    Dim Height As Double
    Dim Ok As Boolean

    Index = Value.Loaded

    Kind = Value.NextKind

    Do

        If Kind >= Layout.NPC_COUNT Then
            Value.Failed = True
            Return
        End If

        If Value.Layout.People[Kind].Active Then
            Exit Do
        End If

        Kind = Kind + 1

    Loop

    Position = Value.Layout.People[Kind].Position

    If Not Value.Layout.Authored Then

        If Not Value.Placement.Ready Or Value.Placement.Version <> Navigation.Version() Then
            Call Navigation.StepNearestRoad(Value.Placement, Position)

            Return
        End If

        If Not Value.Placement.Found Then
            Value.Failed = True
            Return
        End If

        Position = Value.Placement.Result

    End If

    Value.Placement = Empty
    Value.People[Index].Kind = Kind
    Value.NextKind = Kind + 1
    Value.People[Index].Actor = Character.LoadActor("Assets/Neris/Residents/" + Dialogue.NameAt(Kind) + ".sm3d")
    Ok = Character.IsValid(Value.People[Index].Actor)
    Bounds = Character.LocalBounds(Value.People[Index].Actor)
    Height = 21.0

    If Kind >= 5 Then
        Height = 14.5
    End If

    If Kind = 8 Then
        Height = 8.5
    End If

    Ok = Character.SetScale(Value.People[Index].Actor,
        ToNumber(Round(Height * 100000.0 / ToDouble(Max(1, Bounds.Size.Y))))) And Ok
    Ok = Character.PlayAnimation(Value.People[Index].Actor, "Idle", True) And Ok
    Value.People[Index].Clip = "Idle"

    Call Movement.Start(Value.People[Index].Motion, Position, Kind)

    Value.People[Index].Motion.Heading = Value.Layout.People[Kind].Heading

    Value.People[Index].Ready = Ok
    Value.Loaded = Value.Loaded + 1
    Value.Failed = Not Ok

End Sub

Public Function Talking(ByRef Value As State) As Boolean

    Dim Result As Boolean

    Result = Value.Enabled And Value.Speaking >= 0

    Return Result

End Function

Public Function Input(ByRef Value As State, Key As Number) As Boolean

    If Not Value.Enabled Then
        Return False
    End If

    If Value.Speaking >= 0 Then

        If (Key = KEY_E Or
            Key = KEY_ENTER Or
            Key = KEY_ESCAPE) Then
            Value.Speaking = -1
        End If

        Return True

    End If

    If Key = KEY_E And Value.Nearest >= 0 Then

        Value.Speaking = Value.Nearest
        Value.ApproachActive = False
        Return True

    End If

    Return False

End Function

Public Sub Update(ByRef Value As State, TownName As Text, Spawns As Layout.State, Paused As Boolean,
    Leader As P.Vector3, Elapsed As Number)

    Dim Index As Number
    Dim Distance As Double
    Dim Best As Double
    Dim Pausing As Boolean
    Dim Clip As Text
    Dim Position As P.Vector3
    Dim Ok As Boolean

    If Not Spawns.Authored Then
        Spawns = Layout.Defaults(TownName)
    End If

    If Value.TownName <> TownName Or Not Layout.Same(Value.Layout, Spawns) Then

        Call Destroy(Value)

        Value.Layout = Spawns
        Value.TownName = TownName
        Value.Total = Layout.Population(Spawns)
        Value.Enabled = Value.Total > 0

    End If

    If Not Value.Enabled Then
        Return
    End If

    If Value.Loaded < Value.Total And Not Value.Failed Then
        Call LoadNext(Value)
    End If

    If Paused Then
        Value.Speaking = -1
        Value.ApproachActive = False
    End If

    Best = 55.0
    Value.Nearest = -1

    For Index = 0 To Value.Loaded - 1

        If Value.People[Index].Ready Then

            If Value.Version <> Navigation.Version() And Not Value.Layout.Authored Then

                If Navigation.NearestRoad(Value.People[Index].Motion.Position, Position) Then
                    Call Movement.Start(Value.People[Index].Motion, Position, Value.People[Index].Kind)
                End If

            End If

            Distance = M.Distance(Leader, Value.People[Index].Motion.Position)
            Pausing = (Paused Or Distance < 42.0 Or Value.Speaking = Index Or
                (Value.ApproachActive And Value.Approaching = Index))

            If (Distance < Best And
                Movement.ClearRoad(Leader, Value.People[Index].Motion.Position, False)) Then
                Value.Nearest = Index
                Best = Distance
            End If

            Call Movement.Update(Value.People[Index].Motion, Pausing, Elapsed)

            Clip = "Idle"

            If Value.People[Index].Motion.Moving And Not Pausing Then

                Clip = "Walk"

                If Value.People[Index].Motion.Running Then
                    Clip = "Run"
                End If

            End If

            Ok = True

            If Clip <> Value.People[Index].Clip Then
                Ok = Character.CrossFade(Value.People[Index].Actor, Clip, 180, G.ANIMATION_LOOP)
                Value.People[Index].Clip = Clip
            End If

            Position = Value.People[Index].Motion.Position

            If Value.Speaking = Index Then
                Value.People[Index].Motion.Heading = Movement.Facing(Position, Leader)
            End If

            Ok = Character.Update(Value.People[Index].Actor, Elapsed) And Ok
            Ok = Character.PlacePrecise(Value.People[Index].Actor, Position.X, Position.Y, Position.Z) And Ok
            Ok = Character.RotatePrecise(Value.People[Index].Actor, 0.0, Value.People[Index].Motion.Heading, 0.0) And Ok
            Value.People[Index].Ready = Ok
            Value.Failed = Value.Failed Or Not Ok

        End If

    End For

    Value.Version = Navigation.Version()

End Sub

Public Function Draw(ByRef Value As State, TownName As Text) As Boolean

    Dim Index As Number
    Dim Ok As Boolean

    Ok = True

    If Value.Enabled And TownName = Value.TownName Then

        For Index = 0 To Value.Loaded - 1

            If Value.People[Index].Ready Then
                Ok = Character.Draw(Value.People[Index].Actor) And Ok
            End If

        End For

    End If

    Return Ok

End Function

Public Function OverlayHeight(ByRef Value As State) As Number

    If (Value.Enabled And
        (Value.Nearest >= 0 Or Value.Speaking >= 0 Or
        Value.Loaded < Value.Total Or Value.Failed)) Then
        Return 186
    End If

    Return 0

End Function

Public Sub Overlay(ByRef Value As State)

    Dim Nearest As Number
    Dim Speaking As Number

    Nearest = -1
    Speaking = -1

    If Value.Nearest >= 0 Then
        Nearest = Value.People[Value.Nearest].Kind
    End If

    If Value.Speaking >= 0 Then
        Speaking = Value.People[Value.Speaking].Kind
    End If

    If Value.Enabled Then
        Call Dialogue.Draw(Nearest, Speaking, Value.Loaded, Value.Failed, Value.Total)
    End If

End Sub

End Module
