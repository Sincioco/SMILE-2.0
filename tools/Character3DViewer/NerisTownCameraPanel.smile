''' Town-only camera controls. The scene handles Orbit/Fit; arena owns camera motion.
Module Smile.Tools.NerisTownCameraPanel

Option Explicit

Import Smile.UI.Controls As UI
Import Smile.Tools.TownViewportLayout As Layout
Import Smile.Simple3D.PrecisionMath3D As M
Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.ArenaViewport3D As Arena
Import Smile.Simple3D.ArenaCamera3D As Motion
Import Smile.Tools.Character3DViewerCalibration As Numbers
Import Smile.Tools.Character3DViewerTiming As Timing
Import Smile.Tools.NerisTownCamera As Drone
Import Smile.Tools.NerisTownInspectionLimits As Limits
Import Smile.Simple3D.Graphics3D As G

Public Type State
    DragRow As Number
    FrameRate As Timing.FrameRateState
    PreviousTime As Number
    GeometryTime As Number
    MapTriangles As Number
    MapVertices As Number
    HelpOpen As Boolean
    StatisticsHidden As Boolean
    LoadStarted As Number
    LoadMilliseconds As Number
    Loading As Boolean
End Type

''' Count submitted mesh instances before EndScene releases snapshots; offscreen objects count too.
Public Sub CaptureGeometry(ByRef Value As State)

    Dim Index As Number
    Dim Mesh As Number
    Dim SubmissionTotal As Number

    If Value.GeometryTime > 0 And Timer() - Value.GeometryTime < 500 Then
        Return
    End If

    Value.GeometryTime = Timer()
    Value.MapTriangles = 0
    Value.MapVertices = 0
    SubmissionTotal = G.M5Value3D(G.M5_QUERY_PHYSICAL_SUBMISSIONS, 0)

    For Index = 0 To SubmissionTotal - 1

        Mesh = G.M5Value3D(G.M5_QUERY_SNAPSHOT_MESH, Index)

        If Mesh <> 0 Then
            Value.MapTriangles = Value.MapTriangles + G.MeshIndexCount3D(Mesh) / 3
            Value.MapVertices = Value.MapVertices + G.MeshVertexCount3D(Mesh)
        End If

    End For

End Sub

''' Explicit U.S. grouping, independent of the Windows regional setting.
Public Function CountLabel(Value As Number) As Text

    Dim Digits As Text
    Dim Result As Text
    Dim Index As Number

    Digits = Numbers.NumberText(Value)

    For Index = 0 To Text_Length(Digits) - 1

        If Index > 0 And (Text_Length(Digits) - Index) Mod 3 = 0 Then
            Result = Result + ","
        End If

        Result = Result + Text_Slice(Digits, Index, 1)
    End For

    Return Result

End Function

Public Function MeasureLabel(Value As Double) As Text

    Dim Hundredths As Number
    Dim Fraction As Number
    Dim Result As Text

    Hundredths = ToNumber(Round(Value * 100.0))
    Fraction = Hundredths Mod 100
    Result = CountLabel(Hundredths / 100)

    If Fraction > 0 Then

        Result = Result + "." + Numbers.NumberText(Fraction / 10)

        If Fraction Mod 10 > 0 Then
            Result = Result + Numbers.NumberText(Fraction Mod 10)
        End If

    End If

    Return Result

End Function

Public Function Hovered(Optional HelpOpen As Boolean = False) As Boolean

    Dim Result As Boolean

    Result = ((Pointer_X() >= Window_Width() - 574 And Pointer_X() <= Window_Width() - 294 And
        Pointer_Y() >= 8 And Pointer_Y() <= 120) Or
        (HelpOpen And UI.Contains(18, Window_Height() - 236, 570, 184)) Or
        Layout.Hovered(0) Or Layout.Hovered(1) Or Layout.Hovered(2) Or
        Layout.Hovered(3) Or Layout.Hovered(4) Or Layout.Hovered(5) Or Layout.Hovered(6))

    Return Result

End Function

''' 1 toggles orbit, 2 fits, 3 signals manual rotation, 4 toggles Fly Inspect.
Public Function Input(ByRef Value As State, ByRef View As Arena.State,
    ByRef Base As P.Camera3D, Blocked As Boolean, Following As Boolean) As Number

    Dim Row As Number
    Dim Amount As Double
    Dim Offset As P.Vector3
    Dim Result As Number
    Dim Now As Number

    Now = Timer()

    If Value.PreviousTime > 0 Then
        Call Timing.Advance(Value.FrameRate, Max(0, Now - Value.PreviousTime))
    End If

    Value.PreviousTime = Now

    If Not Blocked And Layout.Clicked(0) Then
        Value.HelpOpen = Not Value.HelpOpen
        Return 0
    End If

    If (Not Blocked And
        Hovered(Value.HelpOpen) And
        Pointer_Pressed(POINTER_PRIMARY)) Then

        If Layout.Hovered(3) Then
            Return 1
        Else If Layout.Hovered(4) Then
            Return 2
        Else If Layout.Hovered(5) Then
            Return 4
        End If

        If Pointer_X() < Window_Width() - 574 Or Pointer_X() > Window_Width() - 294 Then
            Return 0
        End If

        For Row = 1 To 3

            If Abs(Pointer_Y() - (8 + Row * 30)) <= 12 Then

                Value.DragRow = Row

                If Row = 3 And Not Following Then
                    Call Limits.BeginZoom(View, Base)
                End If

            End If

        End For

    End If

    If Value.DragRow > 0 And Pointer_Held(POINTER_PRIMARY) Then

        Amount = Clamp(ToDouble(Pointer_X() - (Window_Width() - 476)) / 164.0, 0.0, 1.0)
        Offset = M.Subtract(Base.Position, Base.Target)

        If Value.DragRow = 1 Then
            View.Controls.OrbitYaw = Amount * 360.0 - 180.0 - M.Degrees(Atan2(Offset.X, Offset.Z))
            Result = 3
        Else If Value.DragRow = 2 Then
            View.Controls.OrbitPitch = (Drone.MinimumPitch(Following) +
                Amount * (80.0 - Drone.MinimumPitch(Following)) -
                M.Degrees(Atan2(Offset.Y, Sqrt(Offset.X * Offset.X + Offset.Z * Offset.Z))))
            Result = 3
        Else
            View.Zoom.Target = ToDouble(Motion.ZOOM_IN_LIMIT) + Amount * ToDouble(Motion.ZOOM_OUT_LIMIT - Motion.ZOOM_IN_LIMIT)
            View.Controls.ZoomTarget = View.Zoom.Target
        End If

    End If

    If Pointer_Released(POINTER_PRIMARY) Or Not Pointer_Held(POINTER_PRIMARY) Then
        Value.DragRow = 0
    End If

    Return Result

End Function

Private Sub Slider(Label As Text, Row As Number, Amount As Double, Reading As Number)

    Dim PanelX As Number
    Dim SliderY As Number

    PanelX = Window_Width() - 574
    SliderY = 8 + Row * 30
    Draw Text Label At PanelX + 12, SliderY - 8 Size 12 Color WHITE
    Fill Rectangle PanelX + 98, SliderY - 2, 164, 4, RGB(62, 83, 104)
    Fill Rectangle PanelX + 98 + ToNumber(Round(Clamp(Amount, 0.0, 1.0) * 164.0)) - 3, SliderY - 6, 6, 12, RGB(70, 210, 205)
    Draw Text Numbers.NumberText(Reading) At PanelX + 202, SliderY - 20 Size 11 Color RGB(160, 220, 230)

End Sub

Public Sub Draw(ByRef Value As State, ByRef View As Arena.State,
    Orbiting As Boolean, PartyCamera As Boolean, DroneEnabled As Boolean, Following As Boolean,
    FlyInspect As Boolean, Optional Editing As Boolean = False)

    Dim Offset As P.Vector3
    Dim Horizontal As Double
    Dim Vertical As Double

    Offset = M.Subtract(View.LiveCamera.Position, View.LiveCamera.Target)
    Horizontal = M.Degrees(Atan2(Offset.X, Offset.Z))
    Vertical = M.Degrees(Atan2(Offset.Y, Sqrt(Offset.X * Offset.X + Offset.Z * Offset.Z)))

    Fill Rectangle Window_Width() - 574, 8, 280, 112, RGB(12, 20, 32) Opacity 80

    Call Slider("H Orbit", 1, (Horizontal + 180.0) / 360.0, ToNumber(Round(Horizontal)))
    Call Slider("V Orbit", 2, (Vertical - Drone.MinimumPitch(Following)) /
        (80.0 - Drone.MinimumPitch(Following)), ToNumber(Round(Vertical)))
    Call Slider("Zoom", 3, (View.Zoom.Target - ToDouble(Motion.ZOOM_IN_LIMIT)) / ToDouble(Motion.ZOOM_OUT_LIMIT - Motion.ZOOM_IN_LIMIT), ToNumber(Round(M.Length(Offset))))
    Call Layout.DrawButton(3, Orbiting)
    Call Layout.DrawButton(4, False)
    Call Layout.DrawButton(5, FlyInspect)
    Call Diagnostics(Value.FrameRate, View.LiveCamera, Horizontal, Vertical,
        Orbiting, PartyCamera, DroneEnabled, FlyInspect)
    Call Help(Value, FlyInspect, Editing)

End Sub

Public Sub MapStatistics(ByRef Value As State, ByRef View As Arena.State,
    Optional Conversation As Boolean = False)

    Dim Labels[6] As Text
    Dim Readings[6] As Text
    Dim Index As Number
    Dim LabelWidth As Number
    Dim ReadingWidth As Number
    Dim PanelWidth As Number
    Dim StatsY As Number
    Dim ReadingX As Number
    Dim WidthMeters As Double
    Dim LengthMeters As Double

    If Value.StatisticsHidden Then
        Return
    End If

    WidthMeters = ToDouble(View.Floor.Width) / 10.0
    LengthMeters = ToDouble(View.Floor.Depth) / 10.0
    Labels[0] = "Map Polygons (Triangles)"
    Labels[1] = "Map Vertices"
    Labels[2] = "Map Area (m²)"
    Labels[3] = "Map Length (m)"
    Labels[4] = "Map Width (m)"
    Labels[5] = "Map Load Time (ms)"
    Readings[0] = CountLabel(Value.MapTriangles)
    Readings[1] = CountLabel(Value.MapVertices)
    Readings[2] = MeasureLabel(WidthMeters * LengthMeters)
    Readings[3] = MeasureLabel(LengthMeters)
    Readings[4] = MeasureLabel(WidthMeters)
    Readings[5] = CountLabel(Value.LoadMilliseconds)

    If Value.Loading Then
        Readings[5] = "Loading..."
    End If

    For Index = 0 To 5
        LabelWidth = Max(LabelWidth, Text_Width(Labels[Index], 11))
        ReadingWidth = Max(ReadingWidth, Text_Width(Readings[Index], 11))
    End For

    PanelWidth = 8 + LabelWidth + 16 + ReadingWidth + 8
    StatsY = Window_Height() - 126

    If Conversation Then
        StatsY = StatsY - 130
    End If

    Fill Rectangle 18, StatsY, PanelWidth, 114, RGB(12, 20, 32) Opacity 80

    For Index = 0 To 5
        Draw Text Labels[Index] At 26, StatsY + 4 + Index * 18 Size 11 Color LIGHT_GRAY
        ReadingX = 18 + PanelWidth - 8 - Text_Width(Readings[Index], 11)
        Draw Text Readings[Index] At ReadingX, StatsY + 4 + Index * 18 Size 11 Color CYAN
    End For

End Sub

Private Sub Help(ByRef Value As State, Flying As Boolean, Editing As Boolean)

    Dim Y As Number

    Call Layout.DrawButton(0, Value.HelpOpen)

    If Not Value.HelpOpen Then
        Return
    End If

    Y = Window_Height() - 236
    Fill Rectangle 18, Y, 570, 184, RGB(12, 23, 36) Opacity 96
    Draw Text "Map Controls" At 30, Y + 10 Size 16 Color CYAN

    If Flying Then
        Draw Text "WASD / Arrows: Fly   Space: Up   Shift+Space: Down" At 30, Y + 40 Size 13 Color WHITE
    Else
        Draw Text "WASD: Party   Up/Down: Zoom   Left/Right: Orbit" At 30, Y + 40 Size 13 Color WHITE
    End If

    Draw Text "Middle: Orbit   Shift+Middle / Left: Pan   Wheel: Zoom" At 30, Y + 64 Size 13 Color WHITE
    Draw Text "O / Orbit: Orbit Current View   Right Click: Reset Orbit" At 30, Y + 88 Size 13 Color WHITE
    Draw Text "1: Top   2: Front   F/G: Floor/Grid   B: Backdrop" At 30, Y + 112 Size 13 Color WHITE
    Draw Text "Tab: Follow   M: Minimap   Ctrl+M: Stats   Ctrl+F: POV" At 30, Y + 136 Size 13 Color WHITE

    If Editing Then
        Draw Text "R: Next 90 CW   Shift+Left: Pan   Ctrl+Z: Undo" At 30, Y + 160 Size 13 Color WHITE
    Else If Flying Then
        Draw Text "Fly Inspect: Return To Inspection" At 30, Y + 160 Size 13 Color WHITE
    Else
        Draw Text "R: Walk/Run   +/-: Speed   Space: Pause/Resume Orbit" At 30, Y + 160 Size 13 Color WHITE
    End If

End Sub

Private Sub Diagnostics(ByRef FrameRate As Timing.FrameRateState, Camera As P.Camera3D,
    Yaw As Double, Pitch As Double, Orbiting As Boolean,
    PartyCamera As Boolean, DroneEnabled As Boolean, FlyInspect As Boolean)

    Dim X As Number
    Dim Y As Number
    Dim Mode As Text

    X = Window_Width() - 280
    Y = 14
    Mode = "Inspect"

    If FlyInspect Then
        Mode = "Fly Inspect"
    Else If Orbiting Then
        Mode = "Orbit"
    Else If PartyCamera And DroneEnabled Then
        Mode = "Drone / Party"
    Else If PartyCamera Then
        Mode = "Party"
    End If

    Fill Rectangle X - 8, Y - 6, 276, 112, RGB(12, 20, 32) Opacity 80
    Draw Text "FPS" At X, Y Size 12 Color LIGHT_GRAY
    Draw Number Timing.FramesPerSecond(FrameRate) At X + 96, Y Size 12 Color GREEN
    Draw Text "Camera" At X, Y + 18 Size 12 Color LIGHT_GRAY
    Draw Text Mode At X + 96, Y + 18 Size 12 Color CYAN
    Draw Text "Pos XYZ" At X, Y + 36 Size 12 Color LIGHT_GRAY
    Draw Text "Aim XYZ" At X, Y + 54 Size 12 Color LIGHT_GRAY
    Draw Number ToNumber(Round(Camera.Position.X)) At X + 96, Y + 36 Size 12 Color CYAN
    Draw Number ToNumber(Round(Camera.Position.Y)) At X + 152, Y + 36 Size 12 Color CYAN
    Draw Number ToNumber(Round(Camera.Position.Z)) At X + 208, Y + 36 Size 12 Color CYAN
    Draw Number ToNumber(Round(Camera.Target.X)) At X + 96, Y + 54 Size 12 Color CYAN
    Draw Number ToNumber(Round(Camera.Target.Y)) At X + 152, Y + 54 Size 12 Color CYAN
    Draw Number ToNumber(Round(Camera.Target.Z)) At X + 208, Y + 54 Size 12 Color CYAN
    Draw Text "Yaw / Pitch" At X, Y + 72 Size 12 Color LIGHT_GRAY
    Draw Number ToNumber(Round(Yaw)) At X + 96, Y + 72 Size 12 Color CYAN
    Draw Number ToNumber(Round(Pitch)) At X + 152, Y + 72 Size 12 Color CYAN
    Draw Text "FOV / Dist" At X, Y + 90 Size 12 Color LIGHT_GRAY
    Draw Number ToNumber(Round(Camera.FovDegrees)) At X + 96, Y + 90 Size 12 Color CYAN
    Draw Number ToNumber(Round(M.Distance(Camera.Position, Camera.Target))) At X + 152, Y + 90 Size 12 Color CYAN

End Sub

End Module
