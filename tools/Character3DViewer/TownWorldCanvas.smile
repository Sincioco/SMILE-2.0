''' World graph layout, pointer gestures and visible connection endpoints.
Module Smile.Tools.TownWorldCanvas

Option Explicit

Import Smile.Tools.TownWorldDocument As Document
Import Smile.Tools.TownWorldView As View
Import Smile.Tools.TownWorldPreviews As Previews

Public Type State
    Camera As View.State
    Selected As Number
    DragNode As Boolean
    OffsetX As Number
    OffsetY As Number
    ClickNode As Number
    ClickTime As Number
    ClickX As Number
    ClickY As Number
    EnterRequested As Boolean
End Type

Public Function X(ByRef Value As State, ByRef Map As Document.State, Index As Number, RightEdge As Number,
    Optional Side As Number = -1) As Number

    Dim Result As Number

    Result = View.ToScreen(Value.Camera, 100 + Map.Nodes[Index].X * Max(100, RightEdge - 200) / 1000, RightEdge / 2, False)

    If Side = 0 Then
        Result = Result - View.HalfWidth(Value.Camera)
    Else If Side = 2 Then
        Result = Result + View.HalfWidth(Value.Camera)
    End If

    Return Result

End Function

Public Function Y(ByRef Value As State, ByRef Map As Document.State, Index As Number, Height As Number,
    Optional Side As Number = -1) As Number

    Dim Result As Number

    Result = View.ToScreen(Value.Camera, 200 + Map.Nodes[Index].Y * Max(100, Height - 400) / 1000, Height / 2, True)

    If Side = 1 Then
        Result = Result - View.HalfHeight(Value.Camera)
    Else If Side = 3 Then
        Result = Result + View.HalfHeight(Value.Camera)
    End If

    Return Result

End Function

''' Frame every card without changing the saved graph coordinates.
Public Sub Fit(ByRef Value As State, ByRef Map As Document.State, RightEdge As Number, Height As Number)

    Dim Index As Number
    Dim MinX As Number
    Dim MaxX As Number
    Dim MinY As Number
    Dim MaxY As Number
    Dim Zoom As Number

    Value.Camera.Zoom = 100
    Value.Camera.PanX = 0
    Value.Camera.PanY = 0

    If Map.NodeCount = 0 Then
        Return
    End If

    MinX = X(Value, Map, 0, RightEdge, 0)
    MaxX = X(Value, Map, 0, RightEdge, 2)
    MinY = Y(Value, Map, 0, Height, 1)
    MaxY = Y(Value, Map, 0, Height, 3)

    For Index = 1 To Map.NodeCount - 1
        MinX = Min(MinX, X(Value, Map, Index, RightEdge, 0))
        MaxX = Max(MaxX, X(Value, Map, Index, RightEdge, 2))
        MinY = Min(MinY, Y(Value, Map, Index, Height, 1))
        MaxY = Max(MaxY, Y(Value, Map, Index, Height, 3))
    End For

    Zoom = Min((RightEdge - 40) * 100 / Max(1, MaxX - MinX),
        (Height - 280) * 100 / Max(1, MaxY - MinY))
    Value.Camera.Zoom = Max(25, Min(100, Zoom))
    Value.Camera.PanX = (RightEdge / 2 - (MinX + MaxX) / 2) * Value.Camera.Zoom / 100
    Value.Camera.PanY = 60 + (Height / 2 - (MinY + MaxY) / 2) * Value.Camera.Zoom / 100

End Sub

Public Function Gesture(ByRef Value As State, ByRef Map As Document.State,
    Px As Number, Py As Number, Pressed As Boolean, Held As Boolean, Available As Boolean,
    RightEdge As Number, Height As Number, Optional Now As Number = -1) As Boolean

    Dim Index As Number
    Dim Changed As Boolean

    If Now < 0 Then
        Now = Timer()
    End If

    If Value.DragNode Then

        Value.DragNode = Held

        If (Held And
            Available And
            (Abs(Px - Value.ClickX) > 5 Or Abs(Py - Value.ClickY) > 5)) Then

            Value.ClickNode = 0
            Map.Nodes[Value.Selected].X = Max(0, Min(Document.MAX_COORDINATE,
                (View.World(Value.Camera, Px - Value.OffsetX, RightEdge / 2, False) - 100) * 1000 / Max(100, RightEdge - 200)))
            Map.Nodes[Value.Selected].Y = Max(0, Min(Document.MAX_COORDINATE,
                (View.World(Value.Camera, Py - Value.OffsetY, Height / 2, True) - 200) * 1000 / Max(100, Height - 400)))
            Changed = True

        End If

    Else If Pressed And Available Then

        For Index = 0 To Map.NodeCount - 1

            If (Abs(Px - X(Value, Map, Index, RightEdge)) < View.HalfWidth(Value.Camera) And
                Abs(Py - Y(Value, Map, Index, Height)) < View.HalfHeight(Value.Camera)) Then

                Value.Selected = Index

                If (Value.ClickNode = Index + 1 And
                    Now - Value.ClickTime <= 450 And
                    Now >= Value.ClickTime And
                    Abs(Px - Value.ClickX) <= 5 And
                    Abs(Py - Value.ClickY) <= 5) Then

                    Value.EnterRequested = True
                    Value.ClickNode = 0
                    Return False

                End If

                Value.ClickNode = Index + 1
                Value.ClickTime = Now
                Value.ClickX = Px
                Value.ClickY = Py
                Value.DragNode = True
                Value.OffsetX = Px - X(Value, Map, Index, RightEdge)
                Value.OffsetY = Py - Y(Value, Map, Index, Height)
                Return False

            End If

        End For

        Value.Selected = -1
        Value.ClickNode = 0

    End If

    Return Changed

End Function

Private Sub Arrow(Ax As Number, Ay As Number, Bx As Number, EndY As Number)

    Dim Dx As Double
    Dim Dy As Double
    Dim Length As Double
    Dim TipX As Number
    Dim TipY As Number

    Dx = ToDouble(Bx - Ax)
    Dy = ToDouble(EndY - Ay)
    Length = Max(1.0, Sqrt(Dx * Dx + Dy * Dy))
    Dx = Dx / Length
    Dy = Dy / Length
    TipX = Ax + (Bx - Ax) * 2 / 3
    TipY = Ay + (EndY - Ay) * 2 / 3
    Draw Line TipX, TipY, TipX - ToNumber(Dx * 10.0 + Dy * 5.0), TipY - ToNumber(Dy * 10.0 - Dx * 5.0), RGB(60, 185, 184)
    Draw Line TipX, TipY, TipX - ToNumber(Dx * 10.0 - Dy * 5.0), TipY - ToNumber(Dy * 10.0 + Dx * 5.0), RGB(60, 185, 184)

End Sub

Public Sub Draw(ByRef Value As State, ByRef Map As Document.State, ByRef Images As Previews.State, RightEdge As Number, Height As Number)

    Dim Index As Number
    Dim Other As Number
    Dim ColorValue As Number
    Dim Ax As Number
    Dim Ay As Number
    Dim Bx As Number
    Dim EndY As Number

    For Index = 0 To Map.NodeCount - 1

        For Other = Index + 1 To Map.NodeCount - 1

            If Map.Links[Index, Other] Or Map.Links[Other, Index] Then

                Ax = X(Value, Map, Index, RightEdge, Map.Ports[Index, Other])
                Ay = Y(Value, Map, Index, Height, Map.Ports[Index, Other])
                Bx = X(Value, Map, Other, RightEdge, Map.Ports[Other, Index])
                EndY = Y(Value, Map, Other, Height, Map.Ports[Other, Index])

                If Not Map.Links[Index, Other] Then
                    Ax = X(Value, Map, Index, RightEdge)
                    Ay = Y(Value, Map, Index, Height)
                End If

                If Not Map.Links[Other, Index] Then
                    Bx = X(Value, Map, Other, RightEdge)
                    EndY = Y(Value, Map, Other, Height)
                End If

                Draw Line Ax, Ay, Bx, EndY, RGB(60, 185, 184)

                If Map.Links[Index, Other] Then
                    Call Arrow(Ax, Ay, Bx, EndY)
                End If

                If Map.Links[Other, Index] Then
                    Call Arrow(Bx, EndY, Ax, Ay)
                End If

            End If

        End For
    End For

    For Index = 0 To Map.NodeCount - 1

        ColorValue = RGB(28, 55, 76)

        If Value.Selected = Index Then
            ColorValue = RGB(22, 110, 135)
        End If

        Ax = X(Value, Map, Index, RightEdge)
        Ay = Y(Value, Map, Index, Height)
        Bx = View.HalfWidth(Value.Camera)
        EndY = View.HalfHeight(Value.Camera)
        Fill Rectangle Ax - Bx, Ay - EndY, Bx * 2, EndY * 2, ColorValue

        Call Previews.Draw(Images, Index, Ax - Bx + 6, Ay - EndY + 6, Bx * 2 - 12, EndY * 2 - 54)
        Call View.Label(Map.Nodes[Index].Town, Ax, Ay + EndY - 42, Bx * 2 - 12,
            Max(13, Min(18, 16 * View.Scale(Value.Camera) / 100)), 38)
    End For

End Sub

End Module
