''' World graph layout, pointer gestures and visible connection endpoints.
Module Smile.Tools.TownWorldCanvas

Option Explicit

Import Smile.Tools.TownWorldDocument As Document
Import Smile.Tools.TownWorldView As View
Import Smile.Tools.TownWorldPreviews As Previews

Public Type State
    Camera As View.State
    Selected As Number
    DragNode As Boolean
    DragPort As Boolean
    SourceNode As Number
    SourcePort As Number
    OffsetX As Number
    OffsetY As Number
    PointerX As Number
    PointerY As Number
    PendingDelete As Boolean
    DeleteFirst As Number
    DeleteSecond As Number
End Type

Public Function X(ByRef Value As State, ByRef Map As Document.State, Index As Number, RightEdge As Number,
    Optional Side As Number = -1) As Number

    Dim Result As Number

    Result = View.ToScreen(Value.Camera, 100 + Map.Nodes[Index].X * Max(100, RightEdge - 200) / 1000, RightEdge / 2, False)

    If Side = 0 Then
        Result = Result - View.HalfWidth(Value.Camera)
    Else If Side = 2 Then
        Result = Result + View.HalfWidth(Value.Camera)
    End If

    Return Result

End Function

Public Function Y(ByRef Value As State, ByRef Map As Document.State, Index As Number, Height As Number,
    Optional Side As Number = -1) As Number

    Dim Result As Number

    Result = View.ToScreen(Value.Camera, 200 + Map.Nodes[Index].Y * Max(100, Height - 400) / 1000, Height / 2, True)

    If Side = 1 Then
        Result = Result - View.HalfHeight(Value.Camera)
    Else If Side = 3 Then
        Result = Result + View.HalfHeight(Value.Camera)
    End If

    Return Result

End Function

''' Frame every card without changing the saved graph coordinates.
Public Sub Fit(ByRef Value As State, ByRef Map As Document.State, RightEdge As Number, Height As Number)

    Dim Index As Number
    Dim MinX As Number
    Dim MaxX As Number
    Dim MinY As Number
    Dim MaxY As Number
    Dim Zoom As Number

    Value.Camera.Zoom = 100
    Value.Camera.PanX = 0
    Value.Camera.PanY = 0

    If Map.NodeCount = 0 Then
        Return
    End If

    MinX = X(Value, Map, 0, RightEdge, 0)
    MaxX = X(Value, Map, 0, RightEdge, 2)
    MinY = Y(Value, Map, 0, Height, 1)
    MaxY = Y(Value, Map, 0, Height, 3)

    For Index = 1 To Map.NodeCount - 1
        MinX = Min(MinX, X(Value, Map, Index, RightEdge, 0))
        MaxX = Max(MaxX, X(Value, Map, Index, RightEdge, 2))
        MinY = Min(MinY, Y(Value, Map, Index, Height, 1))
        MaxY = Max(MaxY, Y(Value, Map, Index, Height, 3))
    End For

    Zoom = Min((RightEdge - 40) * 100 / Max(1, MaxX - MinX),
        (Height - 280) * 100 / Max(1, MaxY - MinY))
    Value.Camera.Zoom = Max(25, Min(100, Zoom))
    Value.Camera.PanX = (RightEdge / 2 - (MinX + MaxX) / 2) * Value.Camera.Zoom / 100
    Value.Camera.PanY = 60 + (Height / 2 - (MinY + MaxY) / 2) * Value.Camera.Zoom / 100

End Sub

Private Function PickPort(ByRef Value As State, ByRef Map As Document.State, Px As Number, Py As Number,
    RightEdge As Number, Height As Number) As Number

    Dim ReturnValue As Number

    Dim Index As Number
    Dim Side As Number
    Dim Result As Number

    For Index = 0 To Map.NodeCount - 1

        For Side = 0 To 3

            If (Abs(Px - X(Value, Map, Index, RightEdge, Side)) <= 10 And
                Abs(Py - Y(Value, Map, Index, Height, Side)) <= 10) Then
                Result = Index * 4 + Side
                Return Result
            End If

        End For
    End For

    ReturnValue = -1

    Return ReturnValue

End Function

Private Function OnLine(ByRef Value As State, ByRef Map As Document.State, First As Number, Second As Number,
    Px As Number, Py As Number, RightEdge As Number, Height As Number) As Boolean

    Dim Ax As Double
    Dim Ay As Double
    Dim Dx As Double
    Dim Dy As Double
    Dim LengthSquared As Double
    Dim Amount As Double
    Dim Result As Boolean

    Ax = ToDouble(X(Value, Map, First, RightEdge, Map.Ports[First, Second]))
    Ay = ToDouble(Y(Value, Map, First, Height, Map.Ports[First, Second]))
    Dx = ToDouble(X(Value, Map, Second, RightEdge, Map.Ports[Second, First])) - Ax
    Dy = ToDouble(Y(Value, Map, Second, Height, Map.Ports[Second, First])) - Ay
    LengthSquared = Dx * Dx + Dy * Dy

    If LengthSquared < 1.0 Then
        Return False
    End If

    Amount = Clamp(((ToDouble(Px) - Ax) * Dx + (ToDouble(Py) - Ay) * Dy) / LengthSquared, 0.0, 1.0)
    Dx = ToDouble(Px) - Ax - Amount * Dx
    Dy = ToDouble(Py) - Ay - Amount * Dy
    Result = Dx * Dx + Dy * Dy <= 49.0

    Return Result

End Function

Public Function Gesture(ByRef Value As State, ByRef Map As Document.State,
    Px As Number, Py As Number, Pressed As Boolean, Held As Boolean, Available As Boolean,
    RightEdge As Number, Height As Number) As Boolean

    Dim Picked As Number
    Dim Index As Number
    Dim Other As Number
    Dim Changed As Boolean

    Value.PointerX = Px
    Value.PointerY = Py

    If Value.PendingDelete Then
        Return False
    End If

    If Value.DragPort Then

        If Not Held Then

            Value.DragPort = False

            If Available Then

                Picked = PickPort(Value, Map, Px, Py, RightEdge, Height)

                If Picked >= 0 Then
                    Changed = Document.Connect(Map, Value.SourceNode, Value.SourcePort, Picked / 4, Picked Mod 4)
                End If

            End If

        End If

    Else If Value.DragNode Then

        Value.DragNode = Held

        If Held And Available Then

            Map.Nodes[Value.Selected].X = Max(0, Min(Document.MAX_COORDINATE,
                (View.World(Value.Camera, Px - Value.OffsetX, RightEdge / 2, False) - 100) * 1000 / Max(100, RightEdge - 200)))
            Map.Nodes[Value.Selected].Y = Max(0, Min(Document.MAX_COORDINATE,
                (View.World(Value.Camera, Py - Value.OffsetY, Height / 2, True) - 200) * 1000 / Max(100, Height - 400)))
            Changed = True

        End If

    Else If Pressed And Available Then

        Picked = PickPort(Value, Map, Px, Py, RightEdge, Height)

        If Picked >= 0 Then

            Value.SourceNode = Picked / 4
            Value.SourcePort = Picked Mod 4
            Value.Selected = Value.SourceNode
            Value.DragPort = True
            Return False

        End If

        For Index = 0 To Map.NodeCount - 1

            If (Abs(Px - X(Value, Map, Index, RightEdge)) < View.HalfWidth(Value.Camera) And
                Abs(Py - Y(Value, Map, Index, Height)) < View.HalfHeight(Value.Camera)) Then

                Value.Selected = Index
                Value.DragNode = True
                Value.OffsetX = Px - X(Value, Map, Index, RightEdge)
                Value.OffsetY = Py - Y(Value, Map, Index, Height)
                Return False

            End If

        End For

        For Index = 0 To Map.NodeCount - 1

            For Other = Index + 1 To Map.NodeCount - 1

                If (Map.Links[Index, Other] And
                    OnLine(Value, Map, Index, Other, Px, Py, RightEdge, Height)) Then

                    Value.PendingDelete = True
                    Value.DeleteFirst = Index
                    Value.DeleteSecond = Other
                    Return False

                End If

            End For
        End For

        Value.Selected = -1

    End If

    Return Changed

End Function

Public Function ConfirmDelete(ByRef Value As State, ByRef Map As Document.State, Accepted As Boolean) As Boolean

    Dim Changed As Boolean

    Changed = Accepted And Value.PendingDelete

    If Changed Then
        Map.Links[Value.DeleteFirst, Value.DeleteSecond] = False
        Map.Links[Value.DeleteSecond, Value.DeleteFirst] = False
    End If

    Value.PendingDelete = False

    Return Changed

End Function

Public Sub Draw(ByRef Value As State, ByRef Map As Document.State, ByRef Images As Previews.State, RightEdge As Number, Height As Number)

    Dim Index As Number
    Dim Other As Number
    Dim Side As Number
    Dim ColorValue As Number
    Dim Ax As Number
    Dim Ay As Number
    Dim Bx As Number
    Dim EndY As Number

    For Index = 0 To Map.NodeCount - 1

        For Other = Index + 1 To Map.NodeCount - 1

            If Map.Links[Index, Other] Then

                Ax = X(Value, Map, Index, RightEdge, Map.Ports[Index, Other])
                Ay = Y(Value, Map, Index, Height, Map.Ports[Index, Other])
                Bx = X(Value, Map, Other, RightEdge, Map.Ports[Other, Index])
                EndY = Y(Value, Map, Other, Height, Map.Ports[Other, Index])
                Draw Line Ax, Ay, Bx, EndY, RGB(60, 185, 184)

            End If

        End For
    End For

    If Value.DragPort Then

        Ax = X(Value, Map, Value.SourceNode, RightEdge, Value.SourcePort)
        Ay = Y(Value, Map, Value.SourceNode, Height, Value.SourcePort)
        Draw Line Ax, Ay, Value.PointerX, Value.PointerY, RGB(245, 210, 70)

    End If

    For Index = 0 To Map.NodeCount - 1

        ColorValue = RGB(28, 55, 76)

        If Value.Selected = Index Then
            ColorValue = RGB(22, 110, 135)
        End If

        Ax = X(Value, Map, Index, RightEdge)
        Ay = Y(Value, Map, Index, Height)
        Bx = View.HalfWidth(Value.Camera)
        EndY = View.HalfHeight(Value.Camera)
        Fill Rectangle Ax - Bx, Ay - EndY, Bx * 2, EndY * 2, ColorValue

        Call Previews.Draw(Images, Index, Ax - Bx + 6, Ay - EndY + 6, Bx * 2 - 12, EndY * 3 / 2 - 12)
        Call View.Label(Map.Nodes[Index].Town, Ax, Ay + EndY / 2, Bx * 2 - 12,
            Max(6, 13 * View.Scale(Value.Camera) / 100), EndY / 2 - 3)

        For Side = 0 To 3
            Fill Rectangle X(Value, Map, Index, RightEdge, Side) - 4, Y(Value, Map, Index, Height, Side) - 4, 8, 8, RGB(245, 210, 70)
        End For
    End For

End Sub

End Module
