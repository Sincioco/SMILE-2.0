''' A quiet ember outline; the original shield flames remain a separate viewer option.
Module Smile.Tools.ArinShieldRim

Option Explicit

Import Smile.Simple3D.Core As Core
Import Smile.Simple3D.Graphics3D As Graphics3D
Import Smile.Simple3D.Character3D As Character3D
Import Smile.Simple3D.PrecisionMath3D As Math3D
Import Smile.Simple3D.Precision3D As Precision3D

Private Dim Texture As Core.Texture3D
Private Dim Material As Core.Material3D
Private Dim Ribbons[3] As Core.RibbonBatch3D
Private Dim Points[8] As Precision3D.Vector3
Private Dim Names[8] As Text
Private Dim Clock As Number
Private Dim Visible As Boolean

Public Sub Update(Actor As Character3D.Actor, Camera As Precision3D.Camera3D, Elapsed As Number,
    Optional Intensity As Number = 100)

    Dim Index As Number
    Dim Layer As Number
    Dim PointIndex As Number
    Dim Side As Precision3D.Vector3
    Dim Tangent As Precision3D.Vector3
    Dim View As Precision3D.Vector3
    Dim Center As Precision3D.Vector3
    Dim Width As Number
    Dim Opacity As Number
    Dim Ok As Boolean
    Dim Normalized As Boolean
    Dim WidthOffset As Precision3D.Vector3

    If Material.Handle = 0 Then

        Texture = Graphics3D.LoadTexture3D("Assets/Lightning/lightning-ribbon.png")
        Material = Graphics3D.CreateEffectMaterial3D(Texture, Graphics3D.MATERIAL_ALPHA_ADDITIVE, 220)
        Names[0] = "ShieldRim0"
        Names[1] = "ShieldRim1"
        Names[2] = "ShieldRim2"
        Names[3] = "ShieldRim3"
        Names[4] = "ShieldRim4"
        Names[5] = "ShieldRim5"
        Names[6] = "ShieldRim6"
        Names[7] = "ShieldRim7"

        For Layer = 0 To 2
            Ribbons[Layer] = Graphics3D.CreateRibbonBatch3D(9, Material)
        End For

    End If

    Clock = (Clock + Elapsed) Mod 120000
    Ok = Material.Handle <> 0

    For Index = 0 To 7
        Ok = Character3D.TrySocketPositionPrecise(Actor, Names[Index], 0, False, Points[Index]) And Ok
    End For

    For Layer = 0 To 2

        Width = 1 + Layer * Layer
        Opacity = Min(100, (85 - Layer * 32) * Max(0, Min(200, Intensity)) / 100)

        For Index = 0 To 8

            PointIndex = Index Mod 8
            Center = Points[PointIndex]
            Tangent = Math3D.Subtract(Points[(PointIndex + 1) Mod 8], Points[(PointIndex + 7) Mod 8])
            View = Math3D.Subtract(Camera.Position, Center)
            Normalized = Math3D.TryNormalize(Math3D.Cross(Tangent, View), Side)

            If Not Normalized Then
                Side = Precision3D.Vector(1.0, 0.0, 0.0)
            End If

            WidthOffset = Math3D.Scale(Side, ToDouble(Width))
            Ok = Precision3D.SetRibbonPoint(Ribbons[Layer], Index,
                Math3D.Subtract(Center, WidthOffset), Math3D.Add(Center, WidthOffset), 0.5) And Ok
            Ok = Graphics3D.SetRibbonPointColor3D(Ribbons[Layer], Index,
                255, 105 + (Clock / 80 + PointIndex * 11) Mod 40, 12, Opacity) And Ok
        End For

        Ok = Graphics3D.CommitRibbonBatch3D(Ribbons[Layer], 9) And Ok
    End For

    Visible = Ok

End Sub

Public Sub Draw()

    Dim Layer As Number
    Dim Ok As Boolean
    Dim Normalized As Boolean
    Dim WidthOffset As Precision3D.Vector3

    If Not Visible Then
        Return
    End If

    For Layer = 0 To 2
        Ok = Graphics3D.DrawRibbonBatch3D(Ribbons[Layer])
    End For

End Sub

Public Function IsVisible() As Boolean

    Return Visible

End Function

Public Sub Shutdown()

    Dim Layer As Number

    For Layer = 0 To 2
        Call Graphics3D.DestroyRibbonBatch3D(Ribbons[Layer])
    End For

    Call Graphics3D.DestroyEffectMaterial3D(Material)
    Call Graphics3D.DestroyTexture3D(Texture)

    Visible = False

End Sub

End Module
