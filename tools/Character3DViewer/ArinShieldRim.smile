''' Caller-owned equipment rims; original shield flames remain a separate viewer option.
Module Smile.Tools.ArinShieldRim

Option Explicit

Import Smile.Simple3D.Core As Core
Import Smile.Simple3D.Graphics3D As Graphics3D
Import Smile.Simple3D.Character3D As Character3D
Import Smile.Simple3D.PrecisionMath3D As Math3D
Import Smile.Simple3D.Precision3D As Precision3D

Public Type Context
    Texture As Core.Texture3D
    Material As Core.Material3D
    Ribbons[3] As Core.RibbonBatch3D
    Points[8] As Precision3D.Vector3
    Names[8] As Text
    Clock As Number
    Visible As Boolean
End Type

Public Sub Update(ByRef Value As Context, Actor As Character3D.Actor, Camera As Precision3D.Camera3D, Elapsed As Number,
    Optional Intensity As Number = 100, Optional PartIndex As Number = 0,
    Optional ColorStyle As Number = 0, Optional SocketPrefix As Text = "ShieldRim")

    Dim Index As Number
    Dim Layer As Number
    Dim PointIndex As Number
    Dim Side As Precision3D.Vector3
    Dim Tangent As Precision3D.Vector3
    Dim View As Precision3D.Vector3
    Dim Center As Precision3D.Vector3
    Dim Width As Number
    Dim Opacity As Number
    Dim Ok As Boolean
    Dim Normalized As Boolean
    Dim WidthOffset As Precision3D.Vector3

    If Value.Material.Handle = 0 Then

        If Not TryAcquire(Value, SocketPrefix) Then
            Value.Visible = False

            Return
        End If

    End If

    Value.Clock = (Value.Clock + Elapsed) Mod 120000
    Ok = Value.Material.Handle <> 0

    For Index = 0 To 7
        Ok = Character3D.TrySocketPositionPrecise(Actor, Value.Names[Index], PartIndex, False, Value.Points[Index]) And Ok
    End For

    For Layer = 0 To 2

        Width = 1 + Layer * Layer
        Opacity = Min(100, (85 - Layer * 32) * Max(0, Min(200, Intensity)) / 100)

        For Index = 0 To 8

            PointIndex = Index Mod 8
            Center = Value.Points[PointIndex]
            Tangent = Math3D.Subtract(Value.Points[(PointIndex + 1) Mod 8], Value.Points[(PointIndex + 7) Mod 8])
            View = Math3D.Subtract(Camera.Position, Center)
            Normalized = Math3D.TryNormalize(Math3D.Cross(Tangent, View), Side)

            If Not Normalized Then
                Side = Precision3D.Vector(1.0, 0.0, 0.0)
            End If

            WidthOffset = Math3D.Scale(Side, ToDouble(Width))
            Ok = Precision3D.SetRibbonPoint(Value.Ribbons[Layer], Index,
                Math3D.Subtract(Center, WidthOffset), Math3D.Add(Center, WidthOffset), 0.5) And Ok

            If ColorStyle = 2 Then
                Ok = Graphics3D.SetRibbonPointColor3D(Value.Ribbons[Layer], Index,
                    255, 255, 255, Opacity) And Ok
            Else If ColorStyle = 1 Then
                Ok = Graphics3D.SetRibbonPointColor3D(Value.Ribbons[Layer], Index,
                    255 - Layer * 100, 255 - Layer * 45, 255, Opacity) And Ok
            Else

                Ok = Graphics3D.SetRibbonPointColor3D(Value.Ribbons[Layer], Index,
                    255, 105 + (Value.Clock / 80 + PointIndex * 11) Mod 40, 12, Opacity) And Ok
            End If

        End For

        Ok = Graphics3D.CommitRibbonBatch3D(Value.Ribbons[Layer], 9) And Ok
    End For

    Value.Visible = Ok

End Sub

Private Function TryAcquire(ByRef Value As Context, SocketPrefix As Text) As Boolean

    Dim Candidate As Context
    Dim Layer As Number
    Dim Ready As Boolean

    Candidate.Texture = Graphics3D.LoadTexture3D("Assets/Lightning/lightning-ribbon.png")

    If Candidate.Texture.Handle = 0 Then
        Return False
    End If

    Candidate.Material = Graphics3D.CreateEffectMaterial3D(
        Candidate.Texture, Graphics3D.MATERIAL_ALPHA_ADDITIVE, 220)
    Ready = Candidate.Material.Handle <> 0

    For Layer = 0 To 2

        If Ready Then
            Candidate.Ribbons[Layer] = Graphics3D.CreateRibbonBatch3D(9, Candidate.Material)
            Ready = Candidate.Ribbons[Layer].Handle <> 0
        End If

    End For

    If Not Ready Then
        Call Shutdown(Candidate)

        Return False
    End If

    Candidate.Names[0] = SocketPrefix + "0"
    Candidate.Names[1] = SocketPrefix + "1"
    Candidate.Names[2] = SocketPrefix + "2"
    Candidate.Names[3] = SocketPrefix + "3"
    Candidate.Names[4] = SocketPrefix + "4"
    Candidate.Names[5] = SocketPrefix + "5"
    Candidate.Names[6] = SocketPrefix + "6"
    Candidate.Names[7] = SocketPrefix + "7"
    Value = Candidate

    Return True

End Function

Public Sub Draw(ByRef Value As Context)

    Dim Layer As Number
    Dim Ok As Boolean

    If Not Value.Visible Then
        Return
    End If

    For Layer = 0 To 2
        Ok = Graphics3D.DrawRibbonBatch3D(Value.Ribbons[Layer])
    End For

End Sub

Public Function IsVisible(ByRef Value As Context) As Boolean

    Dim ReturnValue As Boolean

    ReturnValue = Value.Visible

    Return ReturnValue

End Function

Public Sub Shutdown(ByRef Value As Context)

    Dim Layer As Number

    For Layer = 2 Down To 0
        Call Graphics3D.DestroyRibbonBatch3D(Value.Ribbons[Layer])
    End For

    Call Graphics3D.DestroyEffectMaterial3D(Value.Material)
    Call Graphics3D.DestroyTexture3D(Value.Texture)

    Value.Visible = False

End Sub

End Module
