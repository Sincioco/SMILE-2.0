''' Integrated same-model actor and real storm ownership fixture.

Option Explicit

Import Smile.Simple3D.Core As Core
Import Smile.Simple3D.Precision3D As Precision3D
Import Smile.Simple3D.Character3D As Character3D
Import Smile.Simple3D.Graphics3D As Graphics3D
Import Smile.Simple3D.LightningVfx3D As Lightning
Import Smile.Simple3D.LightPool3D As LightPool3D
Import Smile.Simple3D.Math3D As Math3D
Import Smile.Simple3D.Scene3D As Scene3D
Import Smile.Simple3D.SceneVfx3D As SceneVfx3D
Import Smile.Tools.OrinStorm As OrinStorm
Import Smile.Simple3D.FireEmitter3D As Fire
Import Smile.Assets.OrinV13Equipment As EquipmentAsset
Import Smile.Tools.Character3DViewerProfiles As ViewerProfiles

Dim Camera As Precision3D.Camera3D
Dim Target As Precision3D.Vector3
Dim CapacitySource As Core.Vector3
Dim CapacityTarget As Core.Vector3
Dim FirstActor As Character3D.Actor
Dim SecondActor As Character3D.Actor
Dim FirstStorm As OrinStorm.Context
Dim SecondStorm As OrinStorm.Context
Dim ReplacementStorm As OrinStorm.Context
Dim StaleStorm As OrinStorm.Context
Dim FirstLight As LightPool3D.Lease
Dim SecondLight As LightPool3D.Lease
Dim StaleLight As LightPool3D.Lease
Dim ReplacementLight As LightPool3D.Lease
Dim RejectedEffect As Lightning.LightningEffect
Dim VfxClock As SceneVfx3D.Clock
Dim FirstHead As Core.Vector3
Dim SecondHead As Core.Vector3
Dim CorrectedHead As Core.Vector3
Dim FirstCorrectedHead As Core.Vector3
Dim WristNode As Number
Dim GroundOffset As Number
Dim ComfortCameraPosition As Precision3D.Vector3
Dim Ready As Boolean
Dim FrameReady As Boolean
Dim Destroyed As Boolean
Dim ThunderBefore As Number
Dim FirstTailCount As Number
Dim FirstCorrectionYaw As Number
Dim SecondCorrectionYaw As Number
Dim Failures As Number
Dim CheckIndex As Number

Game Window "Character Viewer Two-Orin Isolation Tests" Size 960 By 540

Do

    Call RunIsolationChecks()

Loop Until True

Sub RunIsolationChecks()

    Call Graphics3D.ResetRenderer3D()

    Camera = Precision3D.FromCamera(Graphics3D.DefaultCamera())
    Camera.Position = Precision3D.Vector(0.25, 180.5, -650.75)
    Camera.Target = Precision3D.Vector(0.25, 100.5, 0.75)
    Target = Precision3D.Vector(0.375, 70.5, 220.625)
    CapacitySource = Math3D.Vector(-20, 240, 100)
    CapacityTarget = Math3D.Vector(20, 10, 100)
    Ready = Scene3D.SetQuality(Scene3D.QUALITY_MEDIUM)
    Ready = LightPool3D.Initialize(2, 2) And Ready
    FirstLight = LightPool3D.Acquire()
    SecondLight = LightPool3D.Acquire()
    Ready = LightPool3D.IsValid(FirstLight) And LightPool3D.IsValid(SecondLight) And Ready
    Ready = Lightning.Initialize("Assets/Lightning", 8192,
        Graphics3D.GPU_PARTICLE_SIMULATION_AUTO, 4096) And Ready

    Call SceneVfx3D.Initialize(VfxClock)
    Call OrinStorm.Prepare(Ready)

    FirstStorm = OrinStorm.Create()
    SecondStorm = OrinStorm.Create()
    FirstActor = Character3D.LoadWithPolicy("Assets/Generation2/OrinV13/OrinV13.sm3d",
        Character3D.CHARACTER_LOAD_REQUIRE_PBR)
    SecondActor = Character3D.LoadWithPolicy("Assets/Generation2/OrinV13/OrinV13.sm3d",
        Character3D.CHARACTER_LOAD_REQUIRE_PBR)

    Call Check(Ready)
    Call Check(Character3D.IsValid(FirstActor) And Character3D.IsValid(SecondActor))
    Call Check(Character3D.ModelHandle(FirstActor) = Character3D.ModelHandle(SecondActor))
    Call Check(Character3D.AnimatorHandle(FirstActor) <> Character3D.AnimatorHandle(SecondActor))
    Call Check(OrinStorm.IsValid(FirstStorm) And OrinStorm.IsValid(SecondStorm))
    Call Check(LightPool3D.RendererSlot(FirstLight) <> LightPool3D.RendererSlot(SecondLight))

    Call Check(Character3D.SetScale(FirstActor, 25000))
    Call Check(Character3D.SetScale(SecondActor, 25000))

    ' Reuse the current Orin standing baseline; never save fixture corrections.
    GroundOffset = ViewerProfiles.ClipVerticalOffset1000(
        ViewerProfiles.PROFILE_ORIN, "Idle", 0) * 25000 / 100000

    Call Check(Character3D.Place(FirstActor, -135, GroundOffset, 0))
    Call Check(Character3D.Place(SecondActor, 135, GroundOffset, 40))

    FirstCorrectionYaw = 2
    SecondCorrectionYaw = -3

    Call Check(Character3D.Rotate(FirstActor, 0, 15 + FirstCorrectionYaw, 0))
    Call Check(Character3D.Rotate(SecondActor, 0, -20 + SecondCorrectionYaw, 0))
    Call Check(Character3D.PlayMode(FirstActor, "ThorAttack",
        Graphics3D.ANIMATION_ONCE, 100))
    Call Check(Character3D.PlayMode(SecondActor, "SwordAttack",
        Graphics3D.ANIMATION_ONCE, 175))
    Call Check(Character3D.SetAnimationTime(FirstActor, 900))
    Call Check(Character3D.SetAnimationTime(SecondActor, 900))
    Call Check(Character3D.Update(FirstActor, 100))
    Call Check(Character3D.Update(SecondActor, 100))

    FirstHead = Character3D.SocketPosition(FirstActor, "HammerHead", 1)
    SecondHead = Character3D.SocketPosition(SecondActor, "HammerHead", 1)

    Call Check(Character3D.AnimationTime(FirstActor) <> Character3D.AnimationTime(SecondActor))
    Call Check(FirstHead.X <> SecondHead.X And FirstHead.Y > -100 And SecondHead.Y > -100)

    WristNode = FindRightWrist(FirstActor)

    Call Check(WristNode >= 0)
    Call Check(Character3D.SetNodeRotationOffset(FirstActor, WristNode, 20, 5, 0))

    FirstCorrectedHead = Character3D.SocketPosition(FirstActor, "HammerHead", 1)
    CorrectedHead = Character3D.SocketPosition(SecondActor, "HammerHead", 1)

    Call Check(Not SamePoint(FirstHead, FirstCorrectedHead))
    Call Check(SamePoint(SecondHead, CorrectedHead))
    Call Check(Character3D.SetNodeRotationOffset(SecondActor, WristNode, -15, 0, 10))

    CorrectedHead = Character3D.SocketPosition(SecondActor, "HammerHead", 1)

    Call Check(Not SamePoint(SecondHead, CorrectedHead))

    CorrectedHead = Character3D.SocketPosition(FirstActor, "HammerHead", 1)

    Call Check(SamePoint(FirstCorrectedHead, CorrectedHead))

    Call OrinStorm.SetStyle(FirstStorm, 1)
    Call OrinStorm.SetStyle(SecondStorm, 3)
    Call OrinStorm.Update(FirstStorm, FirstActor, "ThorAttack", Target, Camera,
        50, True, True, True, False, False, FirstLight)
    Call OrinStorm.Update(SecondStorm, SecondActor, "SwordAttack", Target, Camera,
        50, True, True, True, False, False, SecondLight)
    Call Check(SceneVfx3D.BeginFrame(VfxClock, 50, False, False))
    Call Check(SceneVfx3D.AdvancePrecise(VfxClock, Camera, False, True))
    Call Check(OrinStorm.EffectiveEffectCount(FirstStorm) =
        OrinStorm.MAX_LIGHTNING_EFFECTS_PER_CONTEXT)
    Call Check(OrinStorm.EffectiveEffectCount(SecondStorm) > 0)
    Call Check(OrinStorm.FallbackCause(FirstStorm) = OrinStorm.FALLBACK_CONTEXT_BUDGET)
    Call Check(OrinStorm.TrailParticleCount(FirstStorm) > 0)
    Call Check(OrinStorm.TrailParticleCount(SecondStorm) > 0)
    Call Check(Graphics3D.LightValue3D(Graphics3D.LIGHT_QUERY_LOCAL,
        LightPool3D.RendererSlot(FirstLight), 11) > 0)
    Call Check(Graphics3D.LightValue3D(Graphics3D.LIGHT_QUERY_LOCAL,
        LightPool3D.RendererSlot(SecondLight), 11) > 0)

    FirstTailCount = OrinStorm.TrailParticleCount(SecondStorm)

    FrameReady = Scene3D.BeginPrecise(Camera, 3, 7, 16)

    If FrameReady Then

        FrameReady = Character3D.Draw(FirstActor)
        FrameReady = Character3D.Draw(SecondActor) And FrameReady

        Call OrinStorm.Draw(FirstStorm)
        Call OrinStorm.Draw(SecondStorm)

        FrameReady = SceneVfx3D.DrawLightning(True) And FrameReady

    End If

    Ready = Scene3D.EndScene() And Ready

    Show Screen

    Call Check(FrameReady And Ready)
    Call Check(Graphics3D.VfxValue3D(Graphics3D.VFX_QUERY_RIBBON_DRAWS) > 0)
    Call Check(VfxClock.LightningAdvanceCount = 1)
    Call Check(Not SceneVfx3D.AdvancePrecise(VfxClock, Camera, False, True))
    Call Check(VfxClock.DuplicateAdvanceCount = 1)

    RejectedEffect = Lightning.StartAt("StoredStorm", CapacitySource, CapacityTarget,
        8002, Lightning.QUALITY_LOW)

    Call Check(Lightning.Value(Lightning.QUERY_LIVE_EFFECTS, RejectedEffect) =
        Lightning.MAX_EFFECTS)
    Call Check(RejectedEffect.Slot = 0 And
        Lightning.Value(Lightning.QUERY_LAST_ERROR, RejectedEffect) = Lightning.ERROR_CAPACITY)
    Call Check(Lightning.Value(Lightning.QUERY_LIVE_EFFECTS, RejectedEffect) = Lightning.MAX_EFFECTS)

    Ready = Character3D.PlayMode(SecondActor, "Idle", Graphics3D.ANIMATION_LOOP, 80) And Ready
    Ready = Character3D.SetAnimationTime(SecondActor, 0) And Ready

    Call OrinStorm.Update(SecondStorm, SecondActor, "Idle", Target, Camera,
        50, True, True, True, False, False, SecondLight)

    ' Idle now replenishes the shared corona while older swing particles fade.

    Call Check(OrinStorm.TrailParticleCount(SecondStorm) > FirstTailCount)

    FirstTailCount = OrinStorm.TrailParticleCount(SecondStorm)

    ThunderBefore = OrinStorm.ThunderEventCount(FirstStorm)
    Ready = Character3D.SetAnimationTime(FirstActor, 2500) And Ready

    Call OrinStorm.Update(SecondStorm, SecondActor, "Idle", Target, Camera,
        50, True, True, True, True, False, SecondLight)
    Call Check(OrinStorm.TrailParticleCount(SecondStorm) = FirstTailCount)
    Call OrinStorm.Update(FirstStorm, FirstActor, "ThorAttack", Target, Camera,
        50, True, False, True, True, False, FirstLight)
    Call Check(SceneVfx3D.BeginFrame(VfxClock, 50, False, True))
    Call Check(SceneVfx3D.AdvancePrecise(VfxClock, Camera, False, True))
    Call Check(OrinStorm.TrailParticleCount(FirstStorm) = 0)
    Call Check(OrinStorm.RenderVisibility(FirstStorm) = 1)
    Call Check(Graphics3D.LightValue3D(Graphics3D.LIGHT_QUERY_LOCAL,
        LightPool3D.RendererSlot(FirstLight), 11) = 0)
    Call Check(OrinStorm.EffectiveEffectCount(SecondStorm) > 0)
    Call Check(VfxClock.LightningRestageCount = 1)
    Call PresentActors("Frozen: First Hammer Hidden, Second Actor Retained")

    Call OrinStorm.Update(SecondStorm, SecondActor, "Idle", Target, Camera,
        50, True, True, True, False, False, SecondLight)
    Call OrinStorm.Update(FirstStorm, FirstActor, "ThorAttack", Target, Camera,
        50, True, True, True, False, False, FirstLight)
    Call Check(SceneVfx3D.BeginFrame(VfxClock, 50, False, False))
    Call Check(SceneVfx3D.AdvancePrecise(VfxClock, Camera, False, True))
    Call Check(OrinStorm.ThunderEventCount(FirstStorm) = ThunderBefore)
    Call Check(OrinStorm.RenderVisibility(FirstStorm) = 2)
    Call PresentActors("Resumed Without Replayed Thunder")

    Call OrinStorm.SetSceneComfort(OrinStorm.SCENE_COMFORT_OFF)

    Call Check(OrinStorm.SceneComfortName() = "Flash/Shake Off")
    Call Check(OrinStorm.StyleName(FirstStorm) = "Storm Lance")
    Call Check(OrinStorm.StyleName(SecondStorm) = "Godstorm")

    ComfortCameraPosition = Camera.Position

    ' Reverse staging order while frozen; neither context may override scene Off.

    Call OrinStorm.Update(SecondStorm, SecondActor, "Idle", Target, Camera,
        0, True, True, True, True, False, SecondLight)
    Call OrinStorm.Update(FirstStorm, FirstActor, "ThorAttack", Target, Camera,
        0, True, True, True, True, False, FirstLight)
    Call Check(OrinStorm.SceneComfortValue() = OrinStorm.SCENE_COMFORT_OFF)
    Call Check(ComfortCameraPosition.X = Camera.Position.X And
        ComfortCameraPosition.Y = Camera.Position.Y And
        ComfortCameraPosition.Z = Camera.Position.Z)

    Ready = Character3D.SetVisible(FirstActor, False) And Ready

    Call OrinStorm.Update(FirstStorm, FirstActor, "ThorAttack", Target, Camera,
        50, False, True, True, True, False, FirstLight)
    Call Check(OrinStorm.EffectiveEffectCount(FirstStorm) = 0)
    Call Check(OrinStorm.RenderVisibility(FirstStorm) = 0)
    Call Check(OrinStorm.EffectiveEffectCount(SecondStorm) > 0)
    Call PresentActors("Scene Comfort Off: First Hidden, Second Still Active")

    StaleStorm = FirstStorm
    StaleLight = FirstLight
    Destroyed = OrinStorm.Destroy(FirstStorm)

    Call Check(Destroyed And Not OrinStorm.IsValid(StaleStorm))
    Call Check(LightPool3D.Release(FirstLight))
    Call Check(OrinStorm.IsValid(SecondStorm) And LightPool3D.IsValid(SecondLight))
    Call PresentActors("First Context Released: Second Actor Still Renders")

    ReplacementLight = LightPool3D.Acquire()

    Call Check(LightPool3D.IsValid(ReplacementLight))
    Call Check(Not LightPool3D.IsValid(StaleLight))
    Call Check(Not LightPool3D.Disable(StaleLight))
    Call Check(LightPool3D.IsValid(ReplacementLight) And LightPool3D.IsValid(SecondLight))
    Call Check(LightPool3D.Release(ReplacementLight))

    ReplacementStorm = OrinStorm.Create()

    Call Check(OrinStorm.IsValid(ReplacementStorm))
    Call Check(ReplacementStorm.Handle <> StaleStorm.Handle)
    Call Check(Not OrinStorm.IsValid(StaleStorm))
    Call Check(OrinStorm.TrailRequestedSimulation(SecondStorm) =
        Graphics3D.GPU_PARTICLE_SIMULATION_AUTO)
    Call Check(OrinStorm.TrailEffectiveSimulation(SecondStorm) =
        Graphics3D.GPU_PARTICLE_SIMULATION_CPU_DETERMINISTIC Or
        OrinStorm.TrailEffectiveSimulation(SecondStorm) =
            Graphics3D.GPU_PARTICLE_SIMULATION_GPU_FAST)

    Call TestEquipmentStyles()
    Call Character3D.Destroy(FirstActor)
    Call Character3D.Destroy(SecondActor)

    Destroyed = OrinStorm.Destroy(ReplacementStorm)
    Destroyed = OrinStorm.Destroy(SecondStorm) And Destroyed

    Call Check(Destroyed)
    Call Check(LightPool3D.Release(SecondLight))
    Call Check(LightPool3D.LiveLeaseCount() = 0)

    Call OrinStorm.Shutdown()
    Call Fire.Shutdown()
    Call Lightning.Shutdown()
    Call LightPool3D.Shutdown()
    Call Character3D.Shutdown()
    Call Scene3D.Shutdown()
    Call Check(Character3D.LiveActorCount() = 0)
    Call Check(Lightning.Value(Lightning.QUERY_LIVE_EFFECTS, RejectedEffect) = 0)
    Call Check(Graphics3D.GpuParticleValue3D(Graphics3D.GPU_PARTICLE_QUERY_LIVE_SYSTEMS) = 0)

    If Failures = 0 Then
        Print "Character Viewer two-Orin isolation tests passed"
    Else
        Print "Character Viewer two-Orin isolation tests failed: "; Failures
    End If

End Sub

Sub TestEquipmentStyles()

    Dim EmptyFire As Fire.FireEmitter
    Dim FirstContour As Precision3D.Contour3D
    Dim SecondContour As Precision3D.Contour3D
    Dim Before As Precision3D.Vector3
    Dim LocalContour As Precision3D.Contour3D
    Dim TestLight As LightPool3D.Lease
    Dim ActiveBefore As Number
    Dim ExpectedHead As Precision3D.Vector3
    Dim ClipIndex As Number
    Dim ChargeTime As Number

    ' Authored socket and generated local data must agree after the GLB-to-SM3D Z flip.
    LocalContour.PointCount = 3
    LocalContour.Points[0] = Precision3D.Vector(0.10433297, -0.10733642, -0.28690409)
    LocalContour.Points[1] = Precision3D.Vector(0.11433297, -0.10733642, -0.28690409)
    LocalContour.Points[2] = Precision3D.Vector(0.10433297, -0.09733642, -0.28690409)

    Call Check(Character3D.TrySocketContourPrecise(FirstActor, "SwordBase", 1,
        LocalContour, FirstContour))
    Call Check(Character3D.TrySocketPositionPrecise(FirstActor, "HammerHead", 1, False, ExpectedHead))
    Call Check(Abs(FirstContour.Points[0].X - ExpectedHead.X) < 0.001 And
        Abs(FirstContour.Points[0].Y - ExpectedHead.Y) < 0.001 And
        Abs(FirstContour.Points[0].Z - ExpectedHead.Z) < 0.001)

    LocalContour = EquipmentAsset.WeaponOutline()

    Call Check(Character3D.TrySocketContourPrecise(FirstActor, "SwordBase", 1,
        LocalContour, FirstContour))
    Call Check(Character3D.TrySocketContourPrecise(SecondActor, "SwordBase", 1,
        LocalContour, SecondContour))
    Call Check(FirstContour.Points[0].X <> SecondContour.Points[0].X)

    Before = SecondContour.Points[0]
    LocalContour.PointCount = 2

    Call Check(Not Character3D.TrySocketContourPrecise(SecondActor, "SwordBase", 1,
        LocalContour, SecondContour))
    Call Check(SecondContour.Points[0].X = Before.X)
    Call Check(Fire.Initialize("Assets/Fire"))
    Call OrinStorm.SetEquipmentStyle(ReplacementStorm, OrinStorm.EQUIPMENT_BLUE_FLAME)
    Call OrinStorm.SetEquipmentStyle(SecondStorm, OrinStorm.EQUIPMENT_BLUE_FLAME)
    Call OrinStorm.UpdateEquipmentFire(ReplacementStorm, FirstActor, "Idle", True,
        True, True, False, True)
    Call OrinStorm.UpdateEquipmentFire(SecondStorm, SecondActor, "Idle", True,
        True, True, False, True)
    Call Check(Fire.Value(1, EmptyFire) = 4)

    TestLight = LightPool3D.Acquire()

    Call Check(Character3D.PlayAnimation(FirstActor, "ThorAttack", False))

    For ClipIndex = 0 To Character3D.ClipCount(FirstActor) - 1

        If Character3D.ClipName(FirstActor, ClipIndex) = "ThorAttack" Then
            ChargeTime = Character3D.ClipDuration(FirstActor, ClipIndex) * 3 / 10
        End If

    End For

    Call Check(Character3D.SetAnimationTime(FirstActor, ChargeTime))
    Call OrinStorm.Update(ReplacementStorm, FirstActor, "ThorAttack", Target, Camera,
        50, True, True, True, False, True, TestLight)
    Call Check(Character3D.PlayAnimation(FirstActor, "Idle", True))
    Call OrinStorm.Update(ReplacementStorm, FirstActor, "Idle", Target, Camera,
        50, True, True, True, False, True, TestLight)
    Call Check(OrinStorm.EffectiveEffectCount(ReplacementStorm) = 1)
    Call Check(LightPool3D.Release(TestLight))

    Call Check(SceneVfx3D.BeginFrame(VfxClock, 50, False, False))
    Call Check(SceneVfx3D.AdvancePrecise(VfxClock, Camera, True, True))

    Call Check(Scene3D.BeginPrecise(Camera, 3, 7, 16))
    Call OrinStorm.Draw(ReplacementStorm)
    Call OrinStorm.Draw(SecondStorm)
    Call Check(Scene3D.EndScene())

    Show Screen

    ActiveBefore = Fire.Value(1, EmptyFire)

    Call OrinStorm.UpdateEquipmentFire(ReplacementStorm, FirstActor, "Idle", True,
        False, True, True, True)
    Call Check(Fire.Value(1, EmptyFire) = ActiveBefore - 1)
    Call Check(OrinStorm.EquipmentStyle(SecondStorm) = OrinStorm.EQUIPMENT_BLUE_FLAME)
    Call OrinStorm.SetEquipmentStyle(ReplacementStorm, OrinStorm.EQUIPMENT_NEON_ARCS)
    Call Check(Fire.Value(1, EmptyFire) = 2)
    Call OrinStorm.SetEquipmentStyle(SecondStorm, OrinStorm.EQUIPMENT_NEON_ARCS)
    Call Check(Fire.Value(1, EmptyFire) = 0)

    TestLight = LightPool3D.Acquire()

    Call OrinStorm.Update(ReplacementStorm, FirstActor, "Idle", Target, Camera,
        50, True, True, True, False, True, TestLight)
    Call OrinStorm.Update(SecondStorm, SecondActor, "Idle", Target, Camera,
        50, True, True, True, False, True, SecondLight)
    Call Check(OrinStorm.EffectiveEffectCount(ReplacementStorm) = 4)
    Call Check(OrinStorm.EffectiveEffectCount(SecondStorm) = 4)
    Call Check(OrinStorm.TrailParticleCount(ReplacementStorm) = 0)
    Call Check(OrinStorm.TrailParticleCount(SecondStorm) = 0)
    Call Check(SceneVfx3D.BeginFrame(VfxClock, 50, False, False))
    Call Check(SceneVfx3D.AdvancePrecise(VfxClock, Camera, True, True))
    Call PresentActors("Independent Neon Edge Contours")
    Call OrinStorm.SetEquipmentStyle(SecondStorm, OrinStorm.EQUIPMENT_LIGHTNING)
    Call Check(OrinStorm.EquipmentStyle(SecondStorm) = OrinStorm.EQUIPMENT_LIGHTNING)
    Call Check(OrinStorm.EquipmentStyle(ReplacementStorm) = OrinStorm.EQUIPMENT_NEON_ARCS)
    Call Check(LightPool3D.Release(TestLight))

End Sub

Sub Check(Condition As Boolean)

    CheckIndex = CheckIndex + 1

    If Not Condition Then
        Failures = Failures + 1
        Print "Two-Orin isolation failed check "; CheckIndex
    End If

End Sub

Function FindRightWrist(Value As Character3D.Actor) As Number

    Dim Index As Number
    Dim Result As Number

    Result = -1

    For Index = 0 To Character3D.SocketCount(Value) - 1

        If Character3D.SocketName(Value, Index) = "HandRight" Then
            Result = Character3D.SocketNodeIndex(Value, Index)
        End If

    End For

    Return Result

End Function

Function SamePoint(First As Core.Vector3, Second As Core.Vector3) As Boolean

    Dim Result As Boolean

    Result = First.X = Second.X And First.Y = Second.Y And First.Z = Second.Z

    Return Result

End Function

Sub PresentActors(Label As Text)

    Dim Rendered As Boolean

    Rendered = Scene3D.BeginPrecise(Camera, 3, 7, 16)

    If Rendered Then

        Rendered = Character3D.Draw(FirstActor)
        Rendered = Character3D.Draw(SecondActor) And Rendered

        Call OrinStorm.Draw(FirstStorm)
        Call OrinStorm.Draw(SecondStorm)

        Rendered = SceneVfx3D.DrawLightning(True) And Rendered

    End If

    Rendered = Scene3D.EndScene() And Rendered

    Draw Text Label At 18, 18 Size 18 Color WHITE

    If OrinStorm.TrailEffectiveSimulation(SecondStorm) = Graphics3D.GPU_PARTICLE_SIMULATION_GPU_FAST Then
        Draw Text "Hammer Trail Backend: GPU" At 18, 44 Size 18 Color WHITE
    Else
        Draw Text "Hammer Trail Backend: CPU Fallback" At 18, 44 Size 18 Color WHITE
    End If

    Show Screen

    Call Check(Rendered)
    Call Check(Graphics3D.VfxValue3D(Graphics3D.VFX_QUERY_RIBBON_DRAWS) > 0)

End Sub
