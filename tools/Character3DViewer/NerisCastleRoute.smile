''' Placement and bounded walkable route for the detailed west-side castle.
Module Smile.Tools.NerisCastleRoute

Option Explicit

Import Smile.Tools.TownSurfaceLayers As Layers
Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.PartyTrail3D As Trail
Import Smile.Tools.ProximityDrawbridge As Bridge

Public Const ORIGIN_X = -3660.0
Public Const ORIGIN_Z = 2440.0
Public Const SCALE = 17.0
Public Const DECK_Y = Layers.ROAD_Y + Layers.STRUCTURE_CLEARANCE
Public Const DISPLAY_NAME = "Royal Court"

Private Dim Enabled As Boolean
Private Dim Motion As Bridge.State
Private Dim DoorRotation As Double
Private Dim DoorHold As Number
Private Dim Entered As Boolean
Private Dim PendingEntry As Boolean
Private Dim OffsetX As Double
Private Dim OffsetZ As Double

Public Sub Place(X As Double, Z As Double)

    OffsetX = X
    OffsetZ = Z

End Sub

Public Function CenterX() As Double

    Dim Result As Double

    Result = ORIGIN_X + OffsetX

    Return Result

End Function

Public Function CenterZ() As Double

    Dim Result As Double

    Result = ORIGIN_Z + OffsetZ

    Return Result

End Function

Public Sub Enable(Value As Boolean)

    Enabled = Value
    DoorRotation = 0.0
    DoorHold = 0
    Entered = False
    PendingEntry = False

    Call Bridge.Reset(Motion)

End Sub

Public Function Active() As Boolean

    Return Enabled

End Function

Public Function MapLabel() As Text

    If Enabled Then
        Return DISPLAY_NAME
    End If

    Return ""

End Function

Public Function Angle() As Double

    Dim ReturnValue As Double

    ReturnValue = Motion.Angle

    Return ReturnValue

End Function

Public Function LocalPoint(X As Double, Z As Double) As P.Vector3

    Dim Result As P.Vector3

    Result = P.Vector((X - CenterX()) / SCALE, 0.0, (Z - CenterZ()) / SCALE)

    Return Result

End Function

Public Function Contains(X As Double, Z As Double) As Boolean

    Dim Point As P.Vector3
    Dim Result As Boolean

    Point = LocalPoint(X, Z)
    Result = Enabled And Abs(Point.X) <= 70.0 And Point.Z >= -84.0 And Point.Z <= 82.0

    Return Result

End Function

Public Function OccupiedBy(X As Double, Z As Double) As Boolean

    Dim Point As P.Vector3
    Dim Result As Boolean

    Point = LocalPoint(X, Z)
    Result = ((Abs(Point.X) <= 56.0 And Point.Z >= -84.0 And Point.Z <= 68.0) Or
        (Abs(Point.X) <= 25.0 And Point.Z >= -115.0 And Point.Z < -80.0))

    Return Result

End Function

Public Sub Update(ByRef Path As Trail.State, ActorCount As Number, Elapsed As Number)

    Dim Index As Number
    Dim Occupied As Boolean
    Dim NearDoor As Boolean
    Dim Local As P.Vector3
    Dim Leader As P.Vector3

    For Index = 0 To Min(ActorCount, 5) - 1
        Occupied = Occupied Or OccupiedBy(Path.Positions[Index].X, Path.Positions[Index].Z)
        Local = LocalPoint(Path.Positions[Index].X, Path.Positions[Index].Z)
        NearDoor = NearDoor Or (Abs(Local.X) < 3.6 And Local.Z > 13.2 And Local.Z < 24.0 And
            Abs(Path.Positions[Index].Y - DECK_Y - 3.0 * SCALE) < 15.0)
    End For

    Call Bridge.Update(Motion, Occupied, Elapsed)

    If NearDoor Then

        DoorHold = 1000
        DoorRotation = Min(95.0, DoorRotation + ToDouble(Elapsed) * 0.10)

    Else

        DoorHold = Max(0, DoorHold - Elapsed)

        If DoorHold = 0 Then
            DoorRotation = Max(0.0, DoorRotation - ToDouble(Elapsed) * 0.075)
        End If

        Entered = False

    End If

    Leader = LocalPoint(Path.Positions[0].X, Path.Positions[0].Z)

    If (Abs(Leader.X) < 2.8 And
        Leader.Z >= 15.0 And
        DoorRotation >= 75.0 And
        Not Entered) Then
        PendingEntry = True
        Entered = True
    End If

End Sub

Public Function DoorAngle() As Double

    Return DoorRotation

End Function

''' Consume once per entry; a future cutscene owner can use this event.
Public Function ConsumeEntry() As Boolean

    Dim Result As Boolean

    Result = PendingEntry
    PendingEntry = False

    Return Result

End Function

Public Function CanStand(X As Double, Z As Double) As Boolean

    Dim Point As P.Vector3
    Dim Result As Boolean
    Dim PlanterX As Double
    Dim PlanterZ As Double

    Point = LocalPoint(X, Z)

    If Point.Z >= -84.0 And Point.Z < -64.0 Then

        Result = Abs(Point.X) <= 4.8 And Bridge.Passable(Motion)

    Else If Point.Z >= -64.0 And Point.Z < -50.0 Then

        Result = Abs(Point.X) <= 5.5

    Else If Point.Z >= -50.0 And Point.Z < 14.0 Then

        Result = Abs(Point.X) <= 35.0

        If Point.X * Point.X + (Point.Z + 18.0) * (Point.Z + 18.0) < 39.0625 Then
            Result = False
        End If

        PlanterX = Abs(Point.X) - 26.0
        PlanterZ = Min(Abs(Point.Z + 32.0), Min(Abs(Point.Z + 12.0), Abs(Point.Z - 6.0)))

        If PlanterX * PlanterX + PlanterZ * PlanterZ < 4.41 Then
            Result = False
        End If

    Else If Point.Z >= 14.0 And Point.Z <= 23.2 Then

        Result = Abs(Point.X) <= 2.8 And (Point.Z <= 14.3 Or DoorRotation >= 75.0)

    End If

    Return Result

End Function

Public Function GroundHeight(X As Double, Z As Double) As Double

    Dim Point As P.Vector3
    Dim Result As Double

    Result = DECK_Y
    Point = LocalPoint(X, Z)

    ' The movable leaf must clear painted roads after the court is relocated.

    If Point.Z >= -84.0 And Point.Z < -64.0 Then
        Result = DECK_Y
    Else If (Point.Z >= 2.0 And
        Point.Z < 14.0 And
        Abs(Point.X) <= 7.0) Then
        Result = DECK_Y + Min(20.0, Floor((Point.Z - 2.0) / 0.6) + 1.0) * 0.15 * SCALE
    Else If Point.Z >= 14.0 Then
        Result = DECK_Y + 3.0 * SCALE
    Else If Point.Z >= -46.0 Then
        Result = DECK_Y + 0.02 * SCALE
    End If

    Return Result

End Function

End Module
