''' Southwest placement, ground-level access and entrance lifecycle.
Module Smile.Tools.NerisSpaceportRoute

Option Explicit

Import Smile.Tools.TownSurfaceLayers As Layers
Import Smile.Simple3D.PartyTrail3D As Trail
Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.PrecisionMath3D As M
Import Smile.Tools.NerisSpaceportGround As Ground

Public Const ORIGIN_X = -5500.0
Public Const ORIGIN_Z = -7600.0
' Keep the authored terminal apron above the editable road beneath it.
Public Const DECK_Y = Layers.ROAD_Y + Layers.STRUCTURE_CLEARANCE
Public Const SCALE = 10.0

Public Type State
    Enabled As Boolean
    DoorRotation As Double
    DoorHold As Number
    Entered As Boolean
    PendingEntry As Boolean
    Pivot As P.Vector3
    Turn As Double
End Type

Private Dim Current As State

''' Exchange the full route context, then exchange it back before returning to the live scene.
Public Sub Exchange(ByRef Other As State)

    Dim Previous As State

    Previous = Current
    Current = Other
    Other = Previous

End Sub

Public Sub Configure(Center As P.Vector3, Rotation As Double)

    Current.Pivot = Center
    Current.Turn = Rotation

End Sub

Public Function Placed(Point As P.Vector3) As P.Vector3

    Dim Result As P.Vector3

    Result = M.Add(Current.Pivot, M.Rotate(M.Subtract(Point, Current.Pivot), P.Vector(0.0, Current.Turn, 0.0)))

    Return Result

End Function

Public Function Original(Point As P.Vector3) As P.Vector3

    Dim Result As P.Vector3

    Result = M.Add(Current.Pivot, M.Rotate(M.Subtract(Point, Current.Pivot), P.Vector(0.0, -Current.Turn, 0.0)))

    Return Result

End Function

Public Function Heading(Yaw As Double) As Double

    Dim Result As Double

    Result = M.WrapDegrees(Yaw + Current.Turn)

    Return Result

End Function

Public Sub Enable(Value As Boolean)

    Current.Enabled = Value
    Current.DoorRotation = 0.0
    Current.DoorHold = 0
    Current.Entered = False
    Current.PendingEntry = False

End Sub

Public Function Active() As Boolean

    Dim ReturnValue As Boolean

    ReturnValue = Current.Enabled

    Return ReturnValue

End Function

Public Function Contains(X As Double, Z As Double) As Boolean

    Dim Result As Boolean
    Dim Source As P.Vector3

    Source = Original(P.Vector(X, 0.0, Z))
    X = Source.X
    Z = Source.Z

    Result = Current.Enabled And Ground.Contains((ORIGIN_X - X) / SCALE, (ORIGIN_Z - Z) / SCALE)

    Return Result

End Function

''' Only the swinging doorway narrows the route; the halls and aprons stay open.
Public Function CanStand(X As Double, Z As Double) As Boolean

    Dim LocalX As Double
    Dim LocalZ As Double
    Dim Result As Boolean
    Dim Source As P.Vector3

    Source = Original(P.Vector(X, 0.0, Z))
    X = Source.X
    Z = Source.Z

    LocalX = (ORIGIN_X - X) / SCALE
    LocalZ = (ORIGIN_Z - Z) / SCALE
    Result = Current.Enabled And Ground.CanStand(LocalX, LocalZ)

    If (LocalZ > -47.0 And
        LocalZ < -44.0 And
        Abs(LocalX) < 6.7) Then
        Result = Result And Abs(LocalX) < 5.6 And Current.DoorRotation >= 80.0
    End If

    Return Result

End Function

Public Sub Update(ByRef Path As Trail.State, ActorCount As Number, Elapsed As Number)

    Dim Index As Number
    Dim X As Double
    Dim Z As Double
    Dim NearDoor As Boolean
    Dim Source As P.Vector3

    If Not Current.Enabled Then
        Return
    End If

    For Index = 0 To Min(ActorCount, 5) - 1

        Source = Original(Path.Positions[Index])
        X = (ORIGIN_X - Source.X) / SCALE
        Z = (ORIGIN_Z - Source.Z) / SCALE
        NearDoor = NearDoor Or (Abs(X) < 9.0 And Z > -57.0 And Z < -24.0 And
            Abs(Path.Positions[Index].Y - DECK_Y) < 18.0)
    End For

    If NearDoor Then

        Current.DoorHold = 1500
        Current.DoorRotation = Min(95.0, Current.DoorRotation + ToDouble(Elapsed) * 0.065)

    Else

        Current.DoorHold = Max(0, Current.DoorHold - Elapsed)

        If Current.DoorHold = 0 Then
            Current.DoorRotation = Max(0.0, Current.DoorRotation - ToDouble(Elapsed) * 0.045)
        End If

        Current.Entered = False

    End If

    Source = Original(Path.Positions[0])
    X = (ORIGIN_X - Source.X) / SCALE
    Z = (ORIGIN_Z - Source.Z) / SCALE

    If (Abs(X) < 5.6 And
        Z >= -44.5 And
        Z < -24.0 And
        Current.DoorRotation >= 80.0 And
        Not Current.Entered) Then
        Current.PendingEntry = True
        Current.Entered = True
    End If

End Sub

Public Function DoorAngle() As Double

    Dim ReturnValue As Double

    ReturnValue = Current.DoorRotation

    Return ReturnValue

End Function

''' One entry event per approach, for the spaceport cutscene owner to consume.
Public Function ConsumeEntry() As Boolean

    Dim Result As Boolean

    Result = Current.PendingEntry
    Current.PendingEntry = False

    Return Result

End Function

Public Function ToWorld(Point As P.Vector3) As P.Vector3

    Dim Result As P.Vector3

    Result = Placed(P.Vector(ORIGIN_X - Point.X * SCALE, DECK_Y + Point.Y * SCALE,
        ORIGIN_Z - Point.Z * SCALE))

    Return Result

End Function

End Module
