''' Shared blue circle and facing line for arrivals and NPC spawns.
Module Smile.Tools.TownSpawnMarker

Option Explicit

Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.TerrainSurface3D As Terrain
Import Smile.Tools.TownDocument As Document
Import Smile.Tools.TownGuides As Guides
Import Smile.Tools.TownSurfaceLayers As Layers

Public Sub Draw(ByRef Town As Document.State, Position As P.Vector3,
    Heading As Double, View As P.Camera3D, Optional Radius As Double = 22.0)

    Dim Segment As Number
    Dim Angle As Double
    Dim Mark As Guides.Marker
    Dim Sample As Terrain.Sample

    For Segment = 0 To 32

        Angle = ToDouble(Segment) * 6.283185307179586 / 32.0
        Mark.Last = P.Vector(Position.X + Cos(Angle) * Radius, 0.0, Position.Z + Sin(Angle) * Radius)
        Sample = Terrain.SamplePoint(Town.Surface, Mark.Last.X, Mark.Last.Z)
        Mark.Last.Y = Sample.Offset + Layers.OVERLAY_Y

        If Segment > 0 Then
            Call Guides.DrawMarker(Mark, View, RGB(20, 155, 255))
        End If

        Mark.First = Mark.Last
    End For

    Angle = (Heading - 180.0) * 0.017453292519943295
    Mark.First = P.Vector(Position.X, Position.Y + Layers.OVERLAY_Y, Position.Z)
    Sample = Terrain.SamplePoint(Town.Surface, Position.X, Position.Z)
    Mark.First.Y = Sample.Offset + Layers.OVERLAY_Y
    Mark.Last = P.Vector(Position.X + Sin(Angle) * (Radius * 1.36), Mark.First.Y, Position.Z + Cos(Angle) * (Radius * 1.36))

    Call Guides.DrawMarker(Mark, View, RGB(20, 155, 255))

End Sub

End Module
