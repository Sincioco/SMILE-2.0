''' Horizon placement and ground-floor access; furniture and flight lanes stay solid.
Module Smile.Tools.NerisHorizonRoute

Option Explicit

Import Smile.Tools.TownSurfaceLayers As Layers
Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.PrecisionMath3D As M
Import Smile.Simple3D.PartyTrail3D As Trail

Public Const ORIGIN_X = 7400.0
Public Const ORIGIN_Z = 1250.0
Public Const DECK_Y = Layers.ROAD_Y
Public Const SCALE = 10.0
Public Const YAW = 90.0

Public Type State
    Enabled As Boolean
    DoorRotation As Double
    DoorHold As Number
    Entered As Boolean
    PendingEntry As Boolean
    Pivot As P.Vector3
    Turn As Double
End Type

Private Dim Current As State

''' Exchange the full route context, then exchange it back before returning to the live scene.
Public Sub Exchange(ByRef Other As State)

    Dim Previous As State

    Previous = Current
    Current = Other
    Other = Previous

End Sub

Public Sub Configure(Center As P.Vector3, Rotation As Double)

    Current.Pivot = Center
    Current.Turn = Rotation

End Sub

Public Function Placed(Point As P.Vector3) As P.Vector3

    Dim Result As P.Vector3

    Result = M.Add(Current.Pivot, M.Rotate(M.Subtract(Point, Current.Pivot), P.Vector(0.0, Current.Turn, 0.0)))

    Return Result

End Function

Public Function Original(Point As P.Vector3) As P.Vector3

    Dim Result As P.Vector3

    Result = M.Add(Current.Pivot, M.Rotate(M.Subtract(Point, Current.Pivot), P.Vector(0.0, -Current.Turn, 0.0)))

    Return Result

End Function

Public Function Heading(Yaw As Double) As Double

    Dim Result As Double

    Result = M.WrapDegrees(Yaw + Current.Turn)

    Return Result

End Function

Public Sub Enable(Value As Boolean)

    Current.Enabled = Value
    Current.DoorRotation = 0.0
    Current.DoorHold = 0
    Current.Entered = False
    Current.PendingEntry = False

End Sub

Public Function Active() As Boolean

    Dim ReturnValue As Boolean

    ReturnValue = Current.Enabled

    Return ReturnValue

End Function

Public Function Contains(X As Double, Z As Double) As Boolean

    Dim Result As Boolean
    Dim Source As P.Vector3

    Source = Original(P.Vector(X, 0.0, Z))
    X = Source.X
    Z = Source.Z

    Result = Current.Enabled And X >= 5400.0 And X <= 11400.0 And Z >= -3550.0 And Z <= 6050.0

    Return Result

End Function

Public Function CanStand(X As Double, Z As Double) As Boolean

    Dim LocalX As Double
    Dim LocalZ As Double
    Dim Result As Boolean
    Dim Source As P.Vector3

    Source = Original(P.Vector(X, 0.0, Z))
    X = Source.X
    Z = Source.Z

    LocalX = (ORIGIN_Z - Z) / SCALE
    LocalZ = (X - ORIGIN_X) / SCALE

    Result = Current.Enabled And Abs(LocalX) <= 475.0 And LocalZ >= -195.0 And LocalZ < -3.0
    ' The entrance walkway reaches the deck edge where the editable road ends.
    Result = Result Or (Current.Enabled And Abs(LocalX) <= 11.0 And LocalZ >= -200.0 And LocalZ <= 4.0)
    Result = Result Or (Current.Enabled And GroundFloor(LocalX, LocalZ))
    Result = Result Or (Current.Enabled And Abs(LocalX) >= 272.0 And Abs(LocalX) <= 292.0 And
        LocalZ >= -195.0 And LocalZ <= 185.0)

    If (Abs(LocalX) <= 11.7 And
        LocalZ > -2.5 And
        LocalZ < 1.5) Then
        Result = Result And Current.DoorRotation >= 80.0
    End If

    Return Result

End Function

Private Function GroundFloor(X As Double, Z As Double) As Boolean

    Dim Index As Number
    Dim Center As Double

    If (Abs(X) > 256.0 Or
        Z < 3.0 Or
        Z > 145.0) Then
        Return False
    End If

    If ((Abs(Abs(X) - 80.0) < 13.0 Or Abs(Abs(X) - 120.0) < 13.0) And
        Abs(Z - 31.0) < 3.0) Then
        Return False
    End If

    If (Abs(Abs(X) - 190.0) < 6.0 And
        Z > 41.0 And
        Z < 78.0) Then
        Return False
    End If

    For Index = 0 To 18

        Center = -234.0 + ToDouble(Index) * 26.0

        If (Index <> 9 And
            Abs(X - Center) < 2.0 And
            (Abs(Z - 52.0) < 2.0 Or Abs(Z - 104.0) < 2.0)) Then
            Return False
        End If

    End For

    For Index = 0 To 2

        Center = 80.0 + ToDouble(Index) * 65.0

        If (Abs(Abs(X) - Center) < 9.5 And
            (Abs(Z - 60.0) < 2.5 Or Abs(Z - 112.0) < 2.5)) Then
            Return False
        End If

    End For

    Return True

End Function

Public Function ToWorld(Point As P.Vector3) As P.Vector3

    Dim Result As P.Vector3

    Result = P.Vector(ORIGIN_X + Point.Z * SCALE, DECK_Y + Point.Y * SCALE,
        ORIGIN_Z - Point.X * SCALE)
    Result = Placed(Result)

    Return Result

End Function

Public Function GroundHeight(X As Double, Z As Double) As Double

    Dim Result As Double
    Dim Depth As Double
    Dim Source As P.Vector3

    Source = Original(P.Vector(X, 0.0, Z))
    X = Source.X
    Z = Source.Z

    Result = DECK_Y
    Depth = (X - ORIGIN_X) / SCALE

    If (Abs(Z - ORIGIN_Z) <= 2600.0 And
        Depth >= 0.0 And
        Depth <= 150.0) Then
        Result = DECK_Y + 0.8 * SCALE
    Else If (Abs(Z - ORIGIN_Z) <= 330.0 And
        Depth >= -31.0 And
        Depth < -23.0) Then
        Result = DECK_Y + Min(0.8, Floor((Depth + 31.0) / 2.0 + 1.0) * 0.2) * SCALE
    Else If (Abs(Z - ORIGIN_Z) <= 330.0 And
        Depth >= -23.0 And
        Depth < 0.0) Then
        Result = DECK_Y + 0.8 * SCALE
    End If

    Return Result

End Function

''' Proximity includes every follower; crossing queues one event for a future cutscene.
Public Sub Update(ByRef Path As Trail.State, ActorCount As Number, Elapsed As Number)

    Dim Index As Number
    Dim X As Double
    Dim Z As Double
    Dim NearDoor As Boolean
    Dim Source As P.Vector3

    If Not Current.Enabled Then
        Return
    End If

    For Index = 0 To Min(ActorCount, 5) - 1
        Source = Original(Path.Positions[Index])
        X = (ORIGIN_Z - Source.Z) / SCALE
        Z = (Source.X - ORIGIN_X) / SCALE
        NearDoor = NearDoor Or (Abs(X) < 15.0 And Z > -32.0 And Z < 18.0)
    End For

    If NearDoor Then

        Current.DoorHold = 1800
        Current.DoorRotation = Min(95.0, Current.DoorRotation + ToDouble(Elapsed) * 0.09)

    Else

        Current.DoorHold = Max(0, Current.DoorHold - Elapsed)

        If Current.DoorHold = 0 Then
            Current.DoorRotation = Max(0.0, Current.DoorRotation - ToDouble(Elapsed) * 0.06)
        End If

    End If

    Source = Original(Path.Positions[0])
    X = (ORIGIN_Z - Source.Z) / SCALE
    Z = (Source.X - ORIGIN_X) / SCALE

    If Z < -8.0 Then
        Current.Entered = False
    End If

    If (Abs(X) < 11.0 And
        Z > 1.5 And
        Z < 18.0 And
        Current.DoorRotation >= 80.0 And
        Not Current.Entered) Then
        Current.PendingEntry = True
        Current.Entered = True
    End If

End Sub

Public Function DoorAngle() As Double

    Dim ReturnValue As Double

    ReturnValue = Current.DoorRotation

    Return ReturnValue

End Function

Public Function ConsumeEntry() As Boolean

    Dim Result As Boolean

    Result = Current.PendingEntry
    Current.PendingEntry = False

    Return Result

End Function

End Module
