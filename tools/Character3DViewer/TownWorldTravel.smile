''' Read-only atlas projection of destinations authored on each town's yellow areas.
Module Smile.Tools.TownWorldTravel

Option Explicit

Import Smile.Tools.TownWorldDocument As World
Import Smile.Tools.TownDocument As Document
Import Smile.Tools.TownTabs As Tabs
Import Smile.Tools.TownLibrary As Library

Public Type State
    Names[16] As Text
    Revisions[16] As Number
    Known[16] As Boolean
    Missing[16] As Boolean
End Type

''' One directed edge per destination; repeated tiles do not duplicate lines.
Public Sub ReadTown(ByRef Map As World.State, Node As Number, ByRef Town As Document.State)

    Dim Other As Number
    Dim Index As Number
    Dim X As Double
    Dim Z As Double
    Dim Side As Number
    Dim Edge As Double
    Dim Distance As Double
    Dim Best[16] As Double

    For Other = 0 To Map.NodeCount - 1
        Map.Links[Node, Other] = False
        Map.Ports[Node, Other] = 0
        Best[Other] = 1.0E+20
    End For

    For Index = 0 To Town.MapTileCount - 1

        For Other = 0 To Map.NodeCount - 1

            If Other <> Node And Town.MapTiles[Index].Destination = Map.Nodes[Other].Town Then

                X = (Town.Surface.XEdges[Town.MapTiles[Index].X] +
                    Town.Surface.XEdges[Town.MapTiles[Index].X + 1]) * 0.5
                Z = (Town.Surface.ZEdges[Town.MapTiles[Index].Z] +
                    Town.Surface.ZEdges[Town.MapTiles[Index].Z + 1]) * 0.5
                Distance = X - Town.Surface.XEdges[0]
                Side = 0
                Edge = Town.Surface.ZEdges[Town.Surface.Rows] - Z

                If Edge < Distance Then
                    Distance = Edge
                    Side = 1
                End If

                Edge = Town.Surface.XEdges[Town.Surface.Columns] - X

                If Edge < Distance Then
                    Distance = Edge
                    Side = 2
                End If

                Edge = Z - Town.Surface.ZEdges[0]

                If Edge < Distance Then
                    Distance = Edge
                    Side = 3
                End If

                Map.Links[Node, Other] = True

                If Distance < Best[Other] Then
                    Best[Other] = Distance
                    Map.Ports[Node, Other] = Side
                End If

            End If

        End For
    End For

End Sub

Public Sub Reset(ByRef Value As State, ByRef Map As World.State)

    Dim Empty As State
    Dim Node As Number
    Dim Other As Number

    Value = Empty

    For Node = 0 To Map.NodeCount - 1

        For Other = 0 To Map.NodeCount - 1
            Map.Links[Node, Other] = False
            Map.Ports[Node, Other] = 0
        End For
    End For

End Sub

Private Sub ReadClosedTown(ByRef Value As State, ByRef Map As World.State, Node As Number)

    Dim Town As Document.State
    Dim Ok As Boolean

    Ok = Library.RecoverNamed(Town, Map.Nodes[Node].Town)
    Value.Known[Node] = True
    Value.Missing[Node] = Not Ok
    Value.Names[Node] = Map.Nodes[Node].Town

    If Ok Then
        Call ReadTown(Map, Node, Town)

        Value.Revisions[Node] = Town.Revision
    End If

End Sub

''' Open documents include unsaved edits. Resolve at most one closed town per frame.
Public Sub Update(ByRef Value As State, ByRef Map As World.State, ByRef Opened As Tabs.State)

    Dim Node As Number
    Dim Index As Number
    Dim Found As Boolean
    Dim ReadClosed As Boolean

    For Node = 0 To Map.NodeCount - 1

        Found = False

        For Index = 0 To Opened.TabCount - 1

            If Opened.Documents[Index].Name = Map.Nodes[Node].Town Then

                Found = True

                If (Not Value.Known[Node] Or
                    Value.Names[Node] <> Map.Nodes[Node].Town Or
                    Value.Revisions[Node] <> Opened.Documents[Index].Revision) Then

                    Call ReadTown(Map, Node, Opened.Documents[Index])

                    Value.Names[Node] = Map.Nodes[Node].Town
                    Value.Revisions[Node] = Opened.Documents[Index].Revision
                    Value.Known[Node] = True
                    Value.Missing[Node] = False

                End If

                Exit For

            End If

        End For

        If (Not Found And
            Not Value.Known[Node] And
            Not ReadClosed) Then
            Call ReadClosedTown(Value, Map, Node)

            ReadClosed = True
        End If

    End For

End Sub

End Module
