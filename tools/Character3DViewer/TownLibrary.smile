''' Native document saves and recovery. Named versions retain their own working copy.
Module Smile.Tools.TownLibrary

Option Explicit

Import Smile.Tools.TownDocument As Document
Import Smile.Tools.TownDocumentStore As Storage

Public Const PERMANENT_COUNT = 14

Public Function PermanentName(Index As Number) As Text

    Select Case Index
        Case 0
            Return "Neris Town"
        Case 1
            Return "Neris Spaceport"
        Case 2
            Return "Horizon Airport"
        Case 3
            Return "Neris Canals"
        Case 4
            Return "Neris Star Lake"
        Case 5
            Return "Neris Crown Isles"
        Case 6
            Return "East Valley"
        Case 7
            Return "Orin's Village"
        Case 8
            Return "Neris Waterworks"
        Case 9
            Return "Verdant Reach"
        Case 10
            Return "Greyglass Pass"
        Case 11
            Return "Sunglass Expanse"
        Case 12
            Return "Ancient Relay"
        Case 13
            Return "Neris Relief Quarter"
    End Select

    Return ""

End Function

Public Function PermanentKey(Name As Text) As Text

    Dim Key As Text
    Dim Index As Number

    If Name = "Neris Town" Then
        Return "TownEditor.PermanentNeris"
    End If

    For Index = 1 To PERMANENT_COUNT - 1

        If Name = PermanentName(Index) Then
            Key = "TownEditor.Permanent." + Name
            Exit For
        End If

    End For

    Return Key

End Function

Public Function RecoverNamed(ByRef Town As Document.State, Name As Text) As Boolean

    Dim Ok As Boolean
    Dim Key As Text

    Key = PermanentKey(Name)

    If Text_Length(Key) > 0 Then
        Ok = Storage.LoadDocument(Town, Key, True)
    End If

    If Not Ok Then
        Ok = Storage.LoadDocument(Town, "TownEditor.Recovery." + Name, True)
    End If

    If Not Ok Then
        Ok = Storage.LoadDocument(Town, "TownEditor.Town." + Name)
    End If

    Return Ok

End Function

''' The single permanent key is the commit point; retain the previous map first.
Public Function UpdatePermanent(ByRef Incoming As Document.State,
    ByRef Previous As Document.State, Name As Text) As Boolean

    Dim Key As Text
    Dim Ok As Boolean

    Key = PermanentKey(Name)

    If Text_Length(Key) = 0 Or Incoming.Name <> Name Then
        Return False
    End If

    Ok = Storage.SaveDocument(Previous,
        "TownEditor.Recovery." + Name + " Before Permanent Update", False)

    If Not Ok Then
        Return False
    End If

    Ok = Storage.SaveDocument(Incoming, Key, False)

    Return Ok

End Function

Public Function Recover(ByRef Town As Document.State) As Boolean

    Dim Ok As Boolean

    Ok = Storage.LoadDocument(Town, "TownEditor.PermanentNeris", True)

    If Not Ok Then
        Ok = Storage.LoadDocument(Town, "TownEditor.Working", True)
    End If

    If Not Ok Then
        Ok = Storage.LoadDocument(Town, "TownEditor.Current")
    End If

    If Ok Then
        Town.Name = "Neris Town"
    End If

    Return Ok

End Function

Public Function Remember(ByRef Town As Document.State) As Boolean

    Dim Ok As Boolean
    Dim Key As Text

    Ok = Storage.SaveDocument(Town, "TownEditor.Recovery." + Town.Name, False)
    Ok = Storage.SaveDocument(Town, "TownEditor.Working", False) And Ok
    Key = PermanentKey(Town.Name)

    If Text_Length(Key) > 0 Then
        Ok = Storage.SaveDocument(Town, Key, False) And Ok
    End If

    Return Ok

End Function

Public Function SaveCurrent(ByRef Town As Document.State) As Boolean

    Dim Ok As Boolean
    Dim SavedRevision As Number

    SavedRevision = Town.SavedRevision
    Ok = Storage.SaveDocument(Town, "TownEditor.Town." + Town.Name)
    Ok = Storage.SaveDocument(Town, "TownEditor.Current") And Ok

    If Not Ok Then
        Town.SavedRevision = SavedRevision
        Return False
    End If

    Ok = Remember(Town)

    Return Ok

End Function

Public Function OpenNamed(ByRef Town As Document.State, Name As Text) As Boolean

    Dim Ok As Boolean

    If Text_Length(Name) < 1 Or Text_Length(Name) > 80 Then
        Return False
    End If

    Ok = Remember(Town)

    If Not Ok Then
        Return False
    End If

    Ok = RecoverNamed(Town, Name)

    Return Ok

End Function

End Module
