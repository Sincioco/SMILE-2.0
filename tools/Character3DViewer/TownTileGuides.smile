''' Exact terrain-cell guides, filtered by surface, and world-space assembly footprints.
Module Smile.Tools.TownTileGuides

Option Explicit

Import Smile.Tools.TownSurfaceLayers As Layers
Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.SurfaceGrid3D As Grid
Import Smile.Tools.TownDocument As Document
Import Smile.Tools.TownCatalogData As Catalog
Import Smile.Tools.TownGeometry As Geometry
Import Smile.Tools.TownGuides As Guides
Import Smile.Tools.TownPicking As Picking

Public Function Matches(Surface As Number, Target As Number) As Boolean

    Dim Result As Boolean

    Result = Target = 0 Or Target >= 4 Or Surface = Target

    If Surface = Grid.SURFACE_BRIDGE And (Target = 2 Or Target = 3) Then
        Result = True
    End If

    Return Result

End Function

Public Function CellRectangle(ByRef Surface As Grid.State, First As P.Vector3,
    Last As P.Vector3) As Guides.Marker

    Dim Mark As Guides.Marker
    Dim X0 As Number
    Dim X1 As Number
    Dim Z0 As Number
    Dim Z1 As Number

    X0 = Max(0, Min(Surface.Columns - 1, Grid.CellX(Surface, Min(First.X, Last.X))))
    X1 = Max(0, Min(Surface.Columns - 1, Grid.CellX(Surface, Max(First.X, Last.X))))
    Z0 = Max(0, Min(Surface.Rows - 1, Grid.CellZ(Surface, Min(First.Z, Last.Z))))
    Z1 = Max(0, Min(Surface.Rows - 1, Grid.CellZ(Surface, Max(First.Z, Last.Z))))
    Mark.First = P.Vector(Surface.XEdges[X0], Layers.ROAD_Y, Surface.ZEdges[Z0])
    Mark.Last = P.Vector(Surface.XEdges[X1 + 1], Layers.ROAD_Y, Surface.ZEdges[Z1 + 1])
    Mark.IsRectangle = True

    Return Mark

End Function

Private Sub Footprint(Item As Document.Item, View As P.Camera3D)

    Dim Shape As Catalog.Template
    Dim Points[4] As P.Vector3
    Dim Index As Number

    Shape = Catalog.TemplateAt(Item.Template)
    Points[0] = Geometry.ToWorld(Item, P.Vector(Shape.Low.X, 0.0, Shape.Low.Z))
    Points[1] = Geometry.ToWorld(Item, P.Vector(Shape.High.X, 0.0, Shape.Low.Z))
    Points[2] = Geometry.ToWorld(Item, P.Vector(Shape.High.X, 0.0, Shape.High.Z))
    Points[3] = Geometry.ToWorld(Item, P.Vector(Shape.Low.X, 0.0, Shape.High.Z))

    For Index = 0 To 3
        Points[Index].Y = Layers.ROAD_Y
    End For

    For Index = 0 To 3
        Call Guides.Segment(Points[Index], Points[(Index + 1) Mod 4], View, RGB(255, 209, 94))
    End For

End Sub

''' Clip the work to the visible ground when all viewport corners intersect it.
Private Sub VisibleCells(ByRef Surface As Grid.State, View As P.Camera3D, RightEdge As Number,
    ByRef X0 As Number, ByRef Z0 As Number, ByRef X1 As Number, ByRef Z1 As Number)

    Dim Low As P.Vector3
    Dim High As P.Vector3

    X0 = 0
    Z0 = 0
    X1 = Surface.Columns - 1
    Z1 = Surface.Rows - 1

    If Picking.GroundBounds(View, Window_Width(), Window_Height(), RightEdge, 128, Low, High) Then

        X0 = Max(0, Grid.CellX(Surface, Low.X))
        X1 = Min(X1, Grid.CellX(Surface, High.X))
        Z0 = Max(0, Grid.CellZ(Surface, Low.Z))
        Z1 = Min(Z1, Grid.CellZ(Surface, High.Z))

    End If

End Sub

Public Sub Draw(ByRef Guide As Guides.State, ByRef Town As Document.State,
    View As P.Camera3D, RightEdge As Number)

    Dim X As Number
    Dim Z As Number
    Dim X0 As Number
    Dim X1 As Number
    Dim Z0 As Number
    Dim Z1 As Number
    Dim RunStart As Number
    Dim Included As Boolean
    Dim Index As Number
    Dim Point As P.Vector3
    Dim Mark As Guides.Marker

    If Not Guide.ShowTileGrid Then
        Return
    End If

    Call VisibleCells(Town.Surface, View, RightEdge, X0, Z0, X1, Z1)

    Clip Rectangle 0, 128, RightEdge, Max(0, Window_Height() - 128)

    If Guide.TileTarget = 0 Or Guide.TileTarget >= 4 Then

        For X = X0 To X1 + 1
            Call Guides.Segment(P.Vector(Town.Surface.XEdges[X], Layers.ROAD_Y, Town.Surface.ZEdges[Z0]),
                P.Vector(Town.Surface.XEdges[X], Layers.ROAD_Y, Town.Surface.ZEdges[Z1 + 1]), View, RGB(150, 198, 208))
        End For

        For Z = Z0 To Z1 + 1
            Call Guides.Segment(P.Vector(Town.Surface.XEdges[X0], Layers.ROAD_Y, Town.Surface.ZEdges[Z]),
                P.Vector(Town.Surface.XEdges[X1 + 1], Layers.ROAD_Y, Town.Surface.ZEdges[Z]), View, RGB(150, 198, 208))
        End For

    Else

        For X = X0 To X1 + 1

            RunStart = -1

            For Z = Z0 To Z1 + 1

                Included = False

                If Z <= Z1 Then
                    Included = ((X > 0 And Matches(Grid.ReadCell(Town.Surface, X - 1, Z), Guide.TileTarget)) Or
                        (X < Town.Surface.Columns And Matches(Grid.ReadCell(Town.Surface, X, Z), Guide.TileTarget)))
                End If

                If Included And RunStart < 0 Then
                    RunStart = Z
                Else If Not Included And RunStart >= 0 Then
                    Call Guides.Segment(P.Vector(Town.Surface.XEdges[X], Layers.ROAD_Y, Town.Surface.ZEdges[RunStart]),
                        P.Vector(Town.Surface.XEdges[X], Layers.ROAD_Y, Town.Surface.ZEdges[Z]), View, RGB(150, 198, 208))

                    RunStart = -1
                End If

            End For
        End For

        For Z = Z0 To Z1 + 1

            RunStart = -1

            For X = X0 To X1 + 1

                Included = False

                If X <= X1 Then
                    Included = ((Z > 0 And Matches(Grid.ReadCell(Town.Surface, X, Z - 1), Guide.TileTarget)) Or
                        (Z < Town.Surface.Rows And Matches(Grid.ReadCell(Town.Surface, X, Z), Guide.TileTarget)))
                End If

                If Included And RunStart < 0 Then
                    RunStart = X
                Else If Not Included And RunStart >= 0 Then
                    Call Guides.Segment(P.Vector(Town.Surface.XEdges[RunStart], Layers.ROAD_Y, Town.Surface.ZEdges[Z]),
                        P.Vector(Town.Surface.XEdges[X], Layers.ROAD_Y, Town.Surface.ZEdges[Z]), View, RGB(150, 198, 208))

                    RunStart = -1
                End If

            End For
        End For

    End If

    If Guide.TileTarget >= 4 Then

        For Index = 0 To Town.ItemCount - 1

            If (Town.Items[Index].Active And
                ((Guide.TileTarget = 4 And Town.Items[Index].Category = Document.CATEGORY_BUILDINGS) Or
                (Guide.TileTarget = 5 And Town.Items[Index].Category = Document.CATEGORY_DECORATIONS))) Then
                Call Footprint(Town.Items[Index], View)
            End If

        End For

    End If

    If Pointer_X() < RightEdge And Pointer_Y() >= 128 Then

        If Picking.Ground(View, Pointer_X(), Pointer_Y(), Window_Width(), Window_Height(), Point) Then

            If (Point.X >= Town.Surface.XEdges[0] And
                Point.X < Town.Surface.XEdges[Town.Surface.Columns] And
                Point.Z >= Town.Surface.ZEdges[0] And
                Point.Z < Town.Surface.ZEdges[Town.Surface.Rows]) Then
                Mark = CellRectangle(Town.Surface, Point, Point)

                Call Guides.DrawMarker(Mark, View, RGB(255, 235, 125))
            End If

        End If

    End If

    End Clip

End Sub

End Module
