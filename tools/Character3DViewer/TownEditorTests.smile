''' Focused authoring checks; no renderer or input automation.

Option Explicit

Import Smile.Simple3D.SurfaceGrid3D As Grid
Import Smile.Tools.TownSurfaceLayers As Layers
Import Smile.Simple3D.Precision3D As P
Import Smile.Tools.TownDocument As Document
Import Smile.Tools.TownSectionTests As SectionTests
Import Smile.Tools.TownCurvesTests As CurveTests
Import Smile.Tools.TownSelection As Selection
Import Smile.Tools.TownCatalogData As Catalog
Import Smile.Tools.TownInitialSurface As Initial
Import Smile.Tools.TownDocumentStore As Storage
Import Smile.Tools.TownWorldDocument As World
Import Smile.Tools.TownWorldTests As WorldTests
Import Smile.Tools.TownGatewayTests As GatewayTests
Import Smile.Tools.TownResidentTests As ResidentTests
Import Smile.Tools.TownDemo As Demo
Import Smile.Tools.TownGuideEditingTests As GuideEditingTests
Import Smile.Tools.TownGuides As Guides
Import Smile.Tools.TownTileGuides As TileGuides
Import Smile.Tools.TownMarkerTools As MarkerTools
Import Smile.Tools.TownHistory As History
Import Smile.Tools.TownMapLoads As Links
Import Smile.Tools.TownGuideFiles As GuideFiles
Import Smile.Tools.TownRoadTravel As Roads
Import Smile.Tools.TownMinimapInput As MinimapInput
Import Smile.Simple3D.ArenaCamera3D As Motion
Import Smile.Tools.TownRoadStops As Stops
Import Smile.Tools.TownRoadSearchTests As RoadSearchTests
Import Smile.Tools.TownPreparationTests As PreparationTests
Import Smile.Tools.TownDocumentNavigation As Navigation
Import Smile.Tools.TownDecks As Decks
Import Smile.Tools.TownGeometry As Geometry
Import Smile.Simple3D.PrecisionMath3D As Math3D

Dim Town As Document.State
Dim Selected As Selection.State
Dim Sample As Document.Item
Dim Placed As Number
Dim Revision As Number
Dim Surface As Grid.State
Dim Ok As Boolean
Dim Failures As Number
Dim X As Number
Dim Map As World.State
Dim LoadedMap As World.State
Dim RequestId As Number
Dim BadBytes[8] As Number
Dim Status As Number
Dim Guide As Guides.State
Dim Journal As History.State
Dim Point As P.Vector3
Dim Identity As Number
Dim BeforeSurface As Number
Dim CellPreview As Guides.Marker
Dim MarkerGesture As MarkerTools.State
Dim Showcase As Demo.State
Dim DemoChoices As Demo.Selection
Dim ReopenedChoices As Demo.Selection

Call CheckMinimapGesture()
Call Demo.Start(Showcase)
Call Check(Showcase.Enabled, "Town Demo Starts Enabled")

Ok = Demo.StopOnInput(Showcase, False, False)

Call Check(Not Ok And Showcase.Enabled, "Hover Alone Leaves Demo Running")

Ok = Demo.StopOnInput(Showcase, True, True)

Call Check(Not Ok And Showcase.Enabled, "Demo Button Retains Its Toggle")
Call Demo.Toggle(Showcase)
Call Check(Not Showcase.Enabled, "Demo Button Turns It Off")
Call Demo.Toggle(Showcase)

Showcase.Elapsed = 1000
Ok = Demo.StopOnInput(Showcase, True, False)

Call Check(Ok And Not Showcase.Enabled And Showcase.Elapsed = 0,
    "Click Or Key Stops Demo And Clears Its Timer")

Call Check(Demo.DefaultIncluded("Neris Town") And Demo.DefaultIncluded("Neris Spaceport") And
    Demo.DefaultIncluded("Horizon Airport") And Demo.DefaultIncluded("Neris Star Lake") And
    Not Demo.DefaultIncluded("Neris Canals") And Not Demo.DefaultIncluded("New Map"),
    "Only The Four Approved Maps Default To Demo On")
Call Demo.Start(Showcase)

Showcase.Elapsed = 29000
Ok = Demo.Advance(Showcase, 999, True)

Call Check(Not Ok, "Demo Waits Until Thirty Seconds")

Ok = Demo.Advance(Showcase, 1, True)

Call Check(Ok And Showcase.Elapsed = 0, "Demo Changes Maps At Thirty Seconds")

Ok = Demo.SetIncluded(DemoChoices, "Preference Fixture", True)

Call Check(Ok And Demo.Included(ReopenedChoices, "Preference Fixture"),
    "Map Demo Choice Persists When Reopened")

Ok = Demo.SetIncluded(DemoChoices, "Preference Fixture", False)

Call Check(Ok And Not Demo.Included(DemoChoices, "Preference Fixture"),
    "Map Demo Toggle Can Be Turned Off")

Call Check(Layers.BED_Y < Layers.GROUND_Y And Layers.GROUND_Y < Layers.WATER_Y And
    Layers.WATER_Y < Layers.ROAD_Y, "Physical Terrain Layers Stay Strictly Ordered")
Call Check(Layers.STRUCTURE_CLEARANCE - 0.07 * 17.0 >= Layers.MIN_DECK_GAP,
    "Raised Deck Policy Clears Recessed Drawbridge Support Above Roads")
Call Check(Layers.ROAD_Y - 22.5 >= Layers.MIN_DECK_GAP,
    "Painted Bridge Paving Clears Existing Civic Bridge Support")

Ok = Guides.SetSpacing(Guide, "0.25")
Guide.SnapMode = 1
Point = Guides.Snap(Guide, P.Vector(3.2, 7.0, -3.2), 0.0)

Call Check(Ok And Guide.Spacing = 0.25 And Point.X = 2.5 And Point.Z = -2.5 And Point.Y = 7.0,
    "Quarter Meter Grid Snaps At Exact World Spacing")
Call Check(Guides.SpacingLabel(Guide.Spacing) = "0.25", "Fractional Grid Label Keeps Decimal Precision")

Ok = Guides.SetSpacing(Guide, ".125")

Call Check(Ok And Guide.Spacing = 0.125 And Guides.SpacingLabel(Guide.Spacing) = "0.125",
    "Sub Meter Input Accepts A Leading Decimal Point")

Ok = Guides.SetSpacing(Guide, "0") Or Guides.SetSpacing(Guide, "abc") Or Guides.SetSpacing(Guide, "1..2")

Call Check(Not Ok And Guide.Spacing = 0.125, "Invalid Spacing Preserves The Previous Grid")

Ok = Guides.SetSpacing(Guide, "0.001")

Call Check(Ok And Guide.Spacing = 0.001, "Millimeter Guide Spacing Is Available")

Guide.Spacing = 2.0
Guide.SnapMode = 0

Ok = Grid.Initialize(Surface, 12, 10, -40.0, -20.0, 20.0, Grid.SURFACE_GROUND)

Surface.XEdges[1] = -35.0
CellPreview = TileGuides.CellRectangle(Surface, P.Vector(-39.0, 0.0, -19.0), P.Vector(-36.0, 0.0, -1.0))

Call Check(CellPreview.First.X = -40.0 And CellPreview.Last.X = -35.0 And
    CellPreview.First.Z = -20.0 And CellPreview.Last.Z = 0.0,
    "Paint Preview Uses Actual Narrow Cell Bounds")

Point = Guides.SnapTile(Surface, P.Vector(-34.0, 77.0, -1.0))

Call Check(Point.X = -35.0 And Point.Z = 0.0 And Point.Y = 77.0,
    "Object Tile Snap Uses Actual Edges Without Changing Height")
Call Check(TileGuides.Matches(Grid.SURFACE_BRIDGE, 2) And TileGuides.Matches(Grid.SURFACE_BRIDGE, 3) And
    Not TileGuides.Matches(Grid.SURFACE_GROUND, 2), "Grid Filters Include Bridge In Both Water And Road")

Surface.XEdges[1] = -20.0

Call Check(Ok And Grid.CellX(Surface, -40.01) = -1 And
    Grid.CellZ(Surface, 0.0) = 1, "World Picking Uses Floor At Negative Coordinates")
Call Grid.PaintLine(Surface, 1, 2, 8, 2, Grid.SURFACE_ROAD)

For X = 1 To 8
    Call Check(Grid.ReadCell(Surface, X, 2) = Grid.SURFACE_ROAD, "Line Includes Every Endpoint Cell")
End For

Call Check(Grid.ReadCell(Surface, 0, 2) = Grid.SURFACE_GROUND And
    Grid.ReadCell(Surface, 9, 2) = Grid.SURFACE_GROUND, "Line Does Not Paint Beyond Endpoints")
Call Grid.PaintRectangle(Surface, 8, 8, 3, 4, Grid.SURFACE_WATER)
Call Grid.PaintRectangle(Surface, 9, 4, 11, 8, Grid.SURFACE_WATER)
Call Check(Not Grid.Bank(Surface, 8, 6, 9, 6), "Joined Water Has No Internal Bank")
Call Check(Grid.Bank(Surface, 3, 4, 2, 4), "Expanded Water Keeps Its Outer Bank")
Call Grid.PaintLine(Surface, 2, 6, 11, 6, Grid.SURFACE_ROAD)
Call Check(Grid.ReadCell(Surface, 4, 6) = Grid.SURFACE_BRIDGE,
    "Road Across Water Retains Its Underlying Water")
Call Check(Not Grid.Bank(Surface, 4, 5, 4, 6), "Bridge Does Not Split A Water Border")
Call Grid.PaintRectangle(Surface, 3, 4, 11, 8, Grid.SURFACE_GROUND)
Call Check(Grid.ReadCell(Surface, 4, 6) = Grid.SURFACE_GROUND,
    "Ground Erases Road And Water Together")

Ok = Grid.Initialize(Surface, 12, 10, 0.0, 0.0, 20.0, Grid.SURFACE_GROUND)

Call Grid.PaintLine(Surface, 2, 2, 7, 7, Grid.SURFACE_ROAD, 3)
Call Check(Grid.ReadCell(Surface, 1, 1) = Grid.SURFACE_ROAD And
    Grid.ReadCell(Surface, 8, 8) = Grid.SURFACE_ROAD And
    Grid.ReadCell(Surface, 3, 2) = Grid.SURFACE_ROAD,
    "Wide Diagonal Line Includes Continuous Width And Both Ends")
Call Grid.PaintRectangle(Surface, -10, -10, -1, -1, Grid.SURFACE_WATER)
Call Check(Grid.ReadCell(Surface, 0, 0) = Grid.SURFACE_GROUND,
    "Out Of Bounds Rectangle Does Not Touch The Grid")

Ok = Grid.Initialize(Surface, Grid.MAX_COLUMNS, Grid.MAX_ROWS,
    0.0, 0.0, 20.0, Grid.SURFACE_GROUND)

Call Check(Ok, "Maximum Grid Initializes Without A Native Stack Overflow")
Call Grid.PaintRectangle(Surface, 15, 0, 16, 0, Grid.SURFACE_WATER)
Call Check(Grid.ReadCell(Surface, 14, 0) = Grid.SURFACE_GROUND And
    Grid.ReadCell(Surface, 15, 0) = Grid.SURFACE_WATER And
    Grid.ReadCell(Surface, 16, 0) = Grid.SURFACE_WATER And
    Grid.ReadCell(Surface, 17, 0) = Grid.SURFACE_GROUND,
    "Packed Cell Boundaries Preserve Their Neighbors")
Call Grid.PaintRectangle(Surface, Grid.MAX_COLUMNS - 1, Grid.MAX_ROWS - 1,
    Grid.MAX_COLUMNS - 1, Grid.MAX_ROWS - 1, Grid.SURFACE_ROAD)
Call Check(Grid.ReadCell(Surface, Grid.MAX_COLUMNS - 1, Grid.MAX_ROWS - 1) =
    Grid.SURFACE_ROAD, "Maximum Grid Last Cell Is Addressable")

Surface.XEdges[1] = 13.25

Call Check(Grid.CellX(Surface, 13.24) = 0 And Grid.CellX(Surface, 13.25) = 1,
    "Refined Surface Edges Preserve Authored Coordinates")

Ok = Document.Blank(Town, "Test Town", 20, 20, 20.0)
Sample.Category = Document.CATEGORY_BUILDINGS
Sample.Template = 2
Sample.Position = P.Vector(0.0, 21.16, 0.0)
Sample.Scale = P.Vector(2000.0, 2000.0, 2000.0)
Placed = Document.Place(Town, Sample, 80.0, 90.0)

Call Check(Ok And Placed = 0 And Town.Items[0].Position.Y = 21.16,
    "Placing An Assembly Preserves Its Authored Vertical Position")
Call Selection.SetCategory(Selected, Document.CATEGORY_DECORATIONS)

Ok = Selection.Add(Selected, Town, 0)

Call Check(Not Ok And Selected.SelectedCount = 0, "Decoration Mode Cannot Select A Building")
Call Selection.SetCategory(Selected, Document.CATEGORY_BUILDINGS)

Ok = Selection.Add(Selected, Town, 0)
Placed = Document.Place(Town, Sample, 120.0, 90.0)
Ok = Selection.Add(Selected, Town, Placed) And Ok
Revision = Town.Revision

Call Selection.BeginDrag(Selected, Town, P.Vector(0.0, 0.0, 0.0))
Call Selection.Drag(Selected, Town, P.Vector(15.0, 800.0, -20.0))
Call Check(Ok And Selected.SelectedCount = 2 And Town.Items[0].Position.X = 95.0 And
    Town.Items[1].Position.X = 135.0 And Town.Items[0].Position.Z = 70.0 And
    Town.Items[0].Position.Y = 21.16, "Group Drag Changes Only Horizontal Coordinates")
Call Selection.EndDrag(Selected, Town, True)
Call Check(Town.Items[0].Position.X = 80.0 And Town.Items[1].Position.X = 120.0 And
    Town.Revision = Revision, "Cancelled Drag Restores Every Selected Assembly")
Call Selection.BeginDrag(Selected, Town, P.Vector(0.0, 0.0, 0.0))
Call Selection.Drag(Selected, Town, P.Vector(15.0, 0.0, -20.0))
Call Selection.EndDrag(Selected, Town, False)
Call Check(Town.Revision = Revision + 1, "Group Drag Commits One Document Revision")
Call Selection.Rotate(Selected, Town, 90.0)
Call Check(Town.Items[0].Yaw = 90.0 And Town.Items[1].Yaw = 90.0,
    "Selected Buildings Rotate Together")
Call Selection.RemoveSelected(Selected, Town)
Call Check(Not Town.Items[0].Active And Not Town.Items[1].Active And Selected.SelectedCount = 0,
    "Delete Affects Selected Items And Clears Selection")

Call Initial.Populate(Surface)

Sample = Catalog.InitialItem(0)

Call Check(Surface.Columns > 380 And Surface.Rows > 350 And Sample.Active,
    "Saved Town Catalog And Exact Terrain Load")
Call Check(Grid.ReadCell(Surface, Grid.CellX(Surface, 0.0), Grid.CellZ(Surface, -3000.0)) =
    Grid.SURFACE_ROAD, "Initial Main Avenue Remains Paved")
Call Check(Grid.ReadCell(Surface, Grid.CellX(Surface, -580.0), Grid.CellZ(Surface, -2000.0)) =
    Grid.SURFACE_WATER, "Initial Civic Canal Remains Water")
Call Check(Grid.ReadCell(Surface, Grid.CellX(Surface, -580.0), Grid.CellZ(Surface, -1700.0)) =
    Grid.SURFACE_BRIDGE, "Initial Bridge Retains Road Over Water")

Town.Surface = Surface
Town.Name = "Neris " + Text_From_Code(22478) + Text_From_Code(127795)
Placed = Document.Place(Town, Sample, 32.25, -18.625)
Town.Light.RedValue = 161
Town.Light.GreenValue = 179
Town.Light.BlueValue = 203
Town.Light.Intensity = 145
Town.Light.Ambient = 61
Town.Light.Azimuth = 217.5
Town.Light.Elevation = 33.25
Town.Light.Shadows = False
Town.Light.ShadowOpacity = 37
Ok = Storage.SaveDocument(Town, "TownEditor.FoundationFixture")

Call Check(Ok And Not Document.Dirty(Town), "Viewer Save Commits A Complete Town")

Town.Name = "Temporary"
Town.Items[0].Position.X = 999.0

Call Document.DefaultSun(Town.Light)

Ok = Storage.LoadDocument(Town, "TownEditor.FoundationFixture")

Call Check(Ok And Town.Name = "Neris " + Text_From_Code(22478) + Text_From_Code(127795) And
    Town.Items[0].Position.X = 32.25 And Town.Items[0].Position.Z = -18.625,
    "Named Town And Precise Positions Round Trip Through Native Save Storage")
Call Check(Town.Light.RedValue = 161 And Town.Light.GreenValue = 179 And
    Town.Light.BlueValue = 203 And Town.Light.Intensity = 145 And Town.Light.Ambient = 61 And
    Town.Light.Azimuth = 217.5 And Town.Light.Elevation = 33.25 And Not Town.Light.Shadows And Town.Light.ShadowOpacity = 37,
    "Every Edited Sun Setting Reopens With Its Own Town")
Call Check(Grid.ReadCell(Town.Surface, Grid.CellX(Town.Surface, -580.0),
    Grid.CellZ(Town.Surface, -1700.0)) = Grid.SURFACE_BRIDGE,
    "Packed Terrain Round Trip Preserves Bridges")

Revision = Town.Revision
Ok = Storage.LoadDocument(Town, "TownEditor.MissingFixture")

Call Check(Not Ok And Town.Revision = Revision And Town.Items[0].Position.X = 32.25,
    "Failed Load Preserves The Current Document")

Call Grid.PaintLine(Surface, -5, -5, -1, -1, Grid.SURFACE_ROAD)

Ok = Grid.Initialize(Surface, 8, 8, 0.0, 0.0, 20.0, Grid.SURFACE_GROUND)
Surface.XEdges[1] = 1.0

Call Grid.PaintWorldLine(Surface, 10.0, 50.0, 140.0, 50.0, Grid.SURFACE_ROAD, 20.0)
Call Check(Grid.ReadCell(Surface, 1, 2) = Grid.SURFACE_ROAD And
    Grid.ReadCell(Surface, 1, 1) = Grid.SURFACE_GROUND,
    "Physical Line Width Does Not Depend On Refined Edge Density")

Save Data BadBytes Count 8 To "TownEditor.CorruptFixture" Status Status
Revision = Town.Revision
Ok = Storage.LoadDocument(Town, "TownEditor.CorruptFixture")

Call Check(Not Ok And Town.Revision = Revision, "Corrupt Payload Cannot Replace The Town")

Map.Name = "World " + Text_From_Code(22478)
Ok = World.Add(Map, Town.Name, 120, 400)
Ok = World.Add(Map, "Another Town", 820, 670) And Ok
Map.Links[0, 1] = True
Map.Links[1, 0] = True
Ok = World.SaveWorld(Map) And Ok
Ok = World.LoadWorld(LoadedMap, Map.Name) And Ok

Call Check(Ok And LoadedMap.NodeCount = 2 And LoadedMap.Nodes[0].Town = Town.Name And
    LoadedMap.Nodes[1].X = 820 And LoadedMap.Links[1, 0], "World Towns Positions And Routes Round Trip")

RequestId = Storage.QueueBlender(Town, 2)

Call Check(RequestId > 0, "Complete Blender Request Is Written Atomically")

Call CheckEditing()
Call CheckMapLoads()
Call CheckPresetsAndGuideFiles()
Call CheckRoadTrips()

Failures = Failures + RoadSearchTests.Run()
Failures = Failures + PreparationTests.Run()

Call CheckCastleDecks()

Failures = Failures + SectionTests.Run()
Failures = Failures + CurveTests.Run()
Failures = Failures + WorldTests.Run()
Failures = Failures + GatewayTests.Run()
Failures = Failures + ResidentTests.Run()
Failures = Failures + GuideEditingTests.Run()

If Failures = 0 Then
    Print "PASS Town Editor Foundations"
Else
    Print "FAIL Town Editor Foundations"
End If

Sub Check(Condition As Boolean, Label As Text)

    If Not Condition Then
        Failures = Failures + 1
        Print "FAIL " + Label
    End If

End Sub

Sub CheckMinimapGesture()

    Dim Gesture As MinimapInput.State
    Dim Input As Motion.PointerInput
    Dim Empty As Motion.PointerInput
    Dim Action As Number

    Input.PanPressed = True
    Input.PanHeld = True
    Action = MinimapInput.Update(Gesture, Input, 100, 100, True)

    Call Check(Action = 1, "Minimap Press Waits Before Selecting A Destination")

    Input.PanPressed = False
    Action = MinimapInput.Update(Gesture, Input, 120, 110, True)

    Call Check(Action = 1 And Gesture.DeltaX = 20 And Gesture.DeltaY = 10,
        "Left Drag Pans The Minimap")

    Input.PanHeld = False
    Input.PanReleased = True
    Action = MinimapInput.Update(Gesture, Input, 120, 110, False)

    Call Check(Action = 1 And Gesture.Button = 0,
        "Drag Release Outside The Minimap Cannot Start A Journey")

    Input = Empty
    Input.PanPressed = True
    Input.PanHeld = True
    Action = MinimapInput.Update(Gesture, Input, 100, 100, True)
    Input.PanPressed = False
    Input.PanHeld = False
    Input.PanReleased = True
    Action = MinimapInput.Update(Gesture, Input, 101, 100, True)

    Call Check(Action = 2, "A Click Without Drag Selects Its Destination On Release")

    Input = Empty
    Input.OrbitPressed = True
    Input.OrbitHeld = True
    Input.PanModifier = True
    Action = MinimapInput.Update(Gesture, Input, 100, 100, True)
    Input.OrbitPressed = False
    Input.PanModifier = False
    Action = MinimapInput.Update(Gesture, Input, 90, 80, False)

    Call Check(Action = 1 And Gesture.DeltaX = -10 And Gesture.DeltaY = -20,
        "Shift Middle Drag Keeps Its Capture Outside The Map And After Shift Release")

End Sub

Sub CheckRoadTrips()

    Dim Leader As P.Vector3
    Dim Direction As P.Vector3
    Dim Frame As Number
    Dim Kind As Number
    Dim StayedOnRoad As Boolean
    Dim RouteChecked As Boolean
    Dim FirstBend As P.Vector3
    Dim LastBend As P.Vector3
    Dim LateralTravel As Double
    Dim ForwardOnly As Boolean

    Ok = Document.Blank(Town, "Road Fixture", 20, 12, 20.0)
    Ok = Grid.Initialize(Town.Surface, 20, 12, 0.0, 0.0, 20.0, Grid.SURFACE_GROUND) And Ok

    Call Grid.PaintLine(Town.Surface, 1, 2, 8, 2, Grid.SURFACE_ROAD)
    Call Grid.PaintLine(Town.Surface, 8, 2, 8, 8, Grid.SURFACE_ROAD)
    Call Grid.PaintLine(Town.Surface, 8, 8, 15, 8, Grid.SURFACE_ROAD)
    Call Grid.PaintRectangle(Town.Surface, 8, 4, 8, 4, Grid.SURFACE_WATER)
    Call Grid.PaintRectangle(Town.Surface, 8, 4, 8, 4, Grid.SURFACE_ROAD)
    Call Grid.PaintRectangle(Town.Surface, 12, 3, 12, 3, Grid.SURFACE_ROAD)
    Call Navigation.Rebuild(Town)

    Leader = P.Vector(30.0, 23.12, 50.0)
    StayedOnRoad = True
    Ok = Roads.Begin(Town, Leader, P.Vector(310.0, 23.12, 170.0)) And Ok

    For Frame = 0 To 1000

        Direction = Roads.Direction(Town, Leader, 3.0, 16)

        If Not RouteChecked And Roads.RouteCount() > 0 Then

            FirstBend = Roads.RoutePoint(1)
            LastBend = Roads.RoutePoint(Roads.RouteCount() - 1)

            Call Check(Roads.RouteCount() = 5 And FirstBend.X = 170.0 And FirstBend.Z = 50.0 And
                LastBend.X = 310.0 And LastBend.Z = 170.0,
                "Minimap Route Keeps Both Road Bends And The Destination")

            RouteChecked = True

        End If

        Leader = Math3D.Add(Leader, Math3D.Scale(Direction, 3.0))
        Kind = Grid.ReadCell(Town.Surface, Grid.CellX(Town.Surface, Leader.X), Grid.CellZ(Town.Surface, Leader.Z))
        StayedOnRoad = StayedOnRoad And (Kind = Grid.SURFACE_ROAD Or Kind = Grid.SURFACE_BRIDGE)

        If Not Roads.Active() Then
            Exit For
        End If

    End For

    Call Check(Ok And StayedOnRoad And Abs(Leader.X - 310.0) < 0.5 And Abs(Leader.Z - 170.0) < 0.5,
        "Auto Run Follows Road Bends And Bridge Without Cutting Across Ground")
    Call Check(RouteChecked And Roads.RouteCount() = 0, "Arrived Route Releases Its Minimap Line")

    Ok = Roads.Begin(Town, Leader, P.Vector(170.0, 23.12, 170.0))
    Ok = Roads.Append(Town, P.Vector(30.0, 23.12, 50.0)) And Ok

    Call Check(Stops.Size() = 1, "Shift Click Retains The Current Leg And Queues A Destination")

    For Frame = 0 To 2000

        Direction = Roads.Direction(Town, Leader, 3.0, 16)
        Leader = Math3D.Add(Leader, Math3D.Scale(Direction, 3.0))

        If Not Roads.Active() Then
            Exit For
        End If

    End For

    Call Check(Ok And Stops.Size() = 0 And Not Roads.Active() And
        Abs(Leader.X - 30.0) < 0.5 And Abs(Leader.Z - 50.0) < 0.5,
        "Queued Trip Reaches Each Destination In Order Without Another Click")

    Ok = Roads.Begin(Town, Leader, P.Vector(170.0, 23.12, 170.0))
    Ok = Roads.Append(Town, P.Vector(310.0, 23.12, 170.0)) And Ok
    Ok = Roads.Begin(Town, Leader, P.Vector(170.0, 23.12, 50.0)) And Ok

    Call Check(Ok And Stops.Size() = 0, "Normal Minimap Click Replaces The Destination Queue")

    Ok = Roads.Begin(Town, Leader, P.Vector(250.0, 23.12, 70.0))

    For Frame = 0 To 20
        Direction = Roads.Direction(Town, Leader, 3.0, 16)
    End For

    Call Check(Ok And Not Roads.Active() And Math3D.Length(Direction) = 0.0,
        "Disconnected Minimap Destination Does Not Move Party")

    Ok = Roads.Begin(Town, Leader, P.Vector(30.0, 23.12, 50.0))
    Town.Revision = Town.Revision + 1
    Direction = Roads.Direction(Town, Leader, 3.0, 16)

    Call Check(Ok And Not Roads.Active(), "An Edited Map Cancels The Old Journey")

    Ok = Grid.Initialize(Town.Surface, 20, 12, 0.0, 0.0, 20.0, Grid.SURFACE_GROUND)

    Call Grid.PaintRectangle(Town.Surface, 0, 0, 19, 4, Grid.SURFACE_ROAD)
    Call Navigation.Rebuild(Town)

    Leader = P.Vector(10.0, 23.12, 10.0)
    Ok = Roads.Begin(Town, Leader, P.Vector(370.0, 23.12, 10.0)) And Ok

    For Frame = 0 To 1000

        Direction = Roads.Direction(Town, Leader, 3.0, 16)
        Leader = Math3D.Add(Leader, Math3D.Scale(Direction, 3.0))

        If Not Roads.Active() Then
            Exit For
        End If

    End For

    Call Check(Ok And Abs(Leader.X - 370.0) < 0.5 And Abs(Leader.Z - 50.0) < 0.5,
        "Wide Road Travel And Destination Use The Road Middle Instead Of Its Edge")

    Ok = Grid.Initialize(Town.Surface, 20, 12, 0.0, 0.0, 20.0, Grid.SURFACE_GROUND)

    Call Grid.PaintRectangle(Town.Surface, 1, 2, 18, 4, Grid.SURFACE_ROAD)
    Call Grid.PaintRectangle(Town.Surface, 8, 0, 10, 11, Grid.SURFACE_ROAD)
    Call Navigation.Rebuild(Town)

    Leader = P.Vector(30.0, 23.12, 50.0)
    LateralTravel = 0.0
    ForwardOnly = True
    Ok = Roads.Begin(Town, Leader, P.Vector(370.0, 23.12, 50.0)) And Ok

    For Frame = 0 To 1000

        Direction = Roads.Direction(Town, Leader, 3.0, 16)
        ForwardOnly = ForwardOnly And Direction.X >= -0.001
        LateralTravel = LateralTravel + Abs(Direction.Z * 3.0)
        Leader = Math3D.Add(Leader, Math3D.Scale(Direction, 3.0))

        If Not Roads.Active() Then
            Exit For
        End If

    End For

    Call Check(Ok And ForwardOnly And Not Roads.Active() And LateralTravel <= 20.5 And
        Abs(Leader.X - 370.0) < 0.5 And Abs(Leader.Z - 70.0) < 0.5,
        "Crossroad Travel Follows The Displayed Route Without Repeated Lane Hunting")

    Ok = Links.PlaceRectangle(Town, 1, 1, 3, 2, "Horizon Airport")

    Call Check(Ok And Town.MapTileCount = 6 And
        Links.DestinationAt(Town, 30.0, 30.0) = "Horizon Airport",
        "Map Load Rectangle Commits All Selected Tiles Together")

    Ok = Links.PlaceRectangle(Town, 4, 1, 5, 2, "Neris Spaceport")

    Call Check(Ok And Town.MapTileCount = 10 And
        Links.DestinationAt(Town, 30.0, 30.0) = "Neris Spaceport",
        "Connected Map Load Rectangles Share The Chosen Destination")

    Ok = Links.PlaceRectangle(Town, -1, 0, 5, 2, "Neris Town")

    Call Check(Not Ok And Town.MapTileCount = 10,
        "Invalid Map Load Rectangle Does Not Partially Paint")

End Sub

Sub CheckPresetsAndGuideFiles()

    Dim LoadedGuide As Guides.State
    Dim OriginalLight As Document.Sun

    Ok = Document.Blank(Town, "Preset Fixture", 8, 8, 10.0)
    Town.Light.Intensity = 123
    Town.Light.Azimuth = 172.125
    OriginalLight = Town.Light

    Call Document.SaveSunPreset(Town, False)
    Call Document.NightSun(Town.Light)

    Town.Light.Intensity = 140

    Call Document.SaveSunPreset(Town, True)

    Ok = Storage.SaveDocument(Town, "TownEditor.PresetFixture", False) And Ok

    Call Document.DefaultSun(Town.Light)

    Ok = Storage.LoadDocument(Town, "TownEditor.PresetFixture") And Ok

    Call Check(Ok And Town.Presets.HasDay And Town.Presets.HasNight And
        Town.Presets.NightActive And Town.Light.Intensity = 140,
        "Custom Bright Night Preset And Active Mode Survive Reload")
    Call Document.ApplySunPreset(Town, False)
    Call Check(Not Town.Presets.NightActive And Town.Light.Intensity = OriginalLight.Intensity And
        Town.Light.Azimuth = OriginalLight.Azimuth, "Day Toggle Restores The Custom Day Exactly")
    Call History.Reset(Journal, Town, Guide.Ink)

    Town.Light.Intensity = 199

    Call Document.SaveSunPreset(Town, False)
    Call History.Record(Journal, Town, Guide.Ink)

    Ok = History.Restore(Journal, Town, Guide.Ink, False)

    Call Check(Ok And Town.Presets.Day.Intensity = 123, "Custom Preset Save Can Be Undone")

    Guide.Spacing = 0.0125
    Guide.SnapMode = 3
    Guide.ShowGrid = True
    Guide.ShowTileGrid = True
    Guide.TileTarget = 4
    Guide.SnapTiles = True
    Guide.Ink.EntryCount = 2
    Guide.Ink.Markers[0].First = P.Vector(-125.125, 23.0, 99.5)
    Guide.Ink.Markers[0].Last = P.Vector(25.75, 23.0, -66.25)
    Guide.Ink.Markers[1] = Guide.Ink.Markers[0]
    Guide.Ink.Markers[1].IsRectangle = True
    Ok = GuideFiles.SaveSnapshot(Guide, "TownEditor.GuideFixture")
    Ok = GuideFiles.LoadSnapshot(LoadedGuide, "TownEditor.GuideFixture") And Ok

    Call Check(Ok And LoadedGuide.Spacing = 0.0125 And LoadedGuide.SnapMode = 3 And
        LoadedGuide.ShowGrid And LoadedGuide.ShowTileGrid And LoadedGuide.SnapTiles And
        LoadedGuide.TileTarget = 4 And LoadedGuide.Ink.EntryCount = 2,
        "Guide Files Preserve Grid Options And Every Marker")
    Call Check(LoadedGuide.Ink.Markers[0].First.X = -125.125 And
        LoadedGuide.Ink.Markers[1].Last.Z = -66.25 And LoadedGuide.Ink.Markers[1].IsRectangle,
        "Guide Files Keep Signed Fractional Coordinates And Shapes")

    Ok = GuideFiles.LoadSnapshot(LoadedGuide, "TownEditor.PresetFixture")

    Call Check(Not Ok And LoadedGuide.Ink.EntryCount = 2 And LoadedGuide.Spacing = 0.0125,
        "Rejecting A Different File Type Leaves Existing Guides Intact")

End Sub

Sub CheckMapLoads()

    Ok = Document.Blank(Town, "Map Tile Fixture", 20, 20, 20.0)

    Call Grid.PaintRectangle(Town.Surface, 2, 2, 4, 4, Grid.SURFACE_ROAD)
    Call History.Reset(Journal, Town, Guide.Ink)

    Ok = Links.Place(Town, 2, 2, "Neris Spaceport")
    Ok = Links.Place(Town, 3, 2, "Horizon Airport") And Ok
    Ok = Links.Place(Town, 4, 3, "Horizon Airport") And Ok

    Call Check(Ok And Links.Neighbor(Town, 3, 2) = "Neris Spaceport" And
        Links.Neighbor(Town, 4, 3) = "Horizon Airport", "Adjacent Tiles Inherit; Diagonal Tiles Remain Separate")
    Call Links.AssignConnected(Town, 0, "Another Town")
    Call Check(Town.MapTiles[0].Destination = "Another Town" And
        Town.MapTiles[1].Destination = "Another Town" And Town.MapTiles[2].Destination = "Horizon Airport",
        "Reassign Changes Only The Connected Tile Area")
    Call History.Record(Journal, Town, Guide.Ink)

    Ok = Links.Remove(Town, 2, 2)

    Call History.Record(Journal, Town, Guide.Ink)
    Call Check(Ok And Town.MapTileCount = 1 And Grid.ReadCell(Town.Surface, 2, 2) = Grid.SURFACE_ROAD,
        "Deleting A Map Load Area Retains Its Underlying Road And Separate Area")

    Ok = History.Restore(Journal, Town, Guide.Ink, False)

    Call Check(Ok And Town.MapTileCount = 3 And Links.Find(Town, 2, 2) >= 0, "Undo Restores Complete Map Load Area")

    Ok = Storage.SaveDocument(Town, "TownEditor.MapTileFixture", False)
    Town.MapTileCount = 0
    Ok = Storage.LoadDocument(Town, "TownEditor.MapTileFixture") And Ok

    Call Check(Ok And Town.MapTileCount = 3 And
        Links.DestinationAt(Town, -150.0, -150.0) = "Another Town", "Map Load Destinations Survive Native Save/Open")
    Call CheckMapAreas()

End Sub

Sub CheckMapAreas()

    Dim Borders As Links.Outline
    Dim Index As Number
    Dim Side As Number
    Dim Edges As Number

    Ok = Document.Blank(Town, "Map Area Fixture", 12, 12, 20.0)
    Ok = Links.PlaceRectangle(Town, 0, 0, 2, 1, "Neris Spaceport") And Ok

    Call Links.BuildOutline(Town, Borders)

    For Index = 0 To Town.MapTileCount - 1

        For Side = 0 To 3

            If Borders.Edge[Index, Side] Then
                Edges = Edges + 1
            End If

        End For
    End For

    Call Check(Ok And Edges = 10 And Not Borders.Edge[0, 1] And Not Borders.Edge[0, 3],
        "Rectangle Has Only Its Outer Perimeter Including At The Map Edge")

    Ok = Links.PlaceRectangle(Town, 5, 0, 6, 1, "Neris Spaceport")

    Call History.Reset(Journal, Town, Guide.Ink)
    Call Links.AssignConnected(Town, 0, "Horizon Airport")
    Call History.Record(Journal, Town, Guide.Ink)
    Call Check(Town.MapTiles[5].Destination = "Horizon Airport" And
        Town.MapTiles[6].Destination = "Neris Spaceport", "Reassign Changes The Whole Area But Not A Separate Island")

    Ok = History.Restore(Journal, Town, Guide.Ink, False)

    Call Check(Ok And Town.MapTiles[0].Destination = "Neris Spaceport" And
        Town.MapTiles[5].Destination = "Neris Spaceport", "One Undo Restores The Whole Reassigned Area")

    Ok = Links.Remove(Town, 1, 1)

    Call History.Record(Journal, Town, Guide.Ink)
    Call Check(Ok And Town.MapTileCount = 4 And Links.Find(Town, 0, 0) = -1 And
        Links.Find(Town, 5, 0) >= 0, "One Interior Click Deletes The Entire Rectangle Only")

    Ok = History.Restore(Journal, Town, Guide.Ink, False)

    Call Check(Ok And Town.MapTileCount = 10, "One Undo Restores Every Cell Of The Deleted Rectangle")

    ' A legacy area with a missing tile must show its actual shape, not a bounding box.
    Town.MapTiles[1].Destination = "Another Map"

    Call Links.BuildOutline(Town, Borders)
    Call Check(Borders.Edge[0, 1] And Borders.Edge[2, 0] And Borders.Edge[4, 2],
        "Different Destination Keeps Its Boundary Inside A Previously Painted Rectangle")
    Call Links.AssignConnected(Town, 0, "Horizon Airport")
    Call Check(Town.MapTiles[1].Destination = "Another Map",
        "Reassign Respects The Same Destination Boundary As The Outline And Delete")

    Ok = Links.Remove(Town, 0, 0)

    Call Check(Ok And Town.MapTileCount = 5 And Links.Find(Town, 1, 0) >= 0,
        "Delete Preserves Neighboring Areas With A Different Destination")

End Sub

Sub CheckEditing()

    Ok = Document.Blank(Town, "History Fixture", 20, 20, 20.0)
    Sample = Catalog.InitialItem(0)
    Sample.Yaw = 35.0
    Placed = Document.Place(Town, Sample, 13.0, 47.0)
    Placed = Document.Place(Town, Sample, 53.0, 47.0)

    Call Guides.Start(Guide)
    Call Selection.SetCategory(Selected, Sample.Category)

    Ok = Selection.Add(Selected, Town, 0)
    Ok = Selection.Add(Selected, Town, 1) And Ok

    Call History.Reset(Journal, Town, Guide.Ink)

    Guide.SnapMode = 1

    Call Selection.BeginDrag(Selected, Town, P.Vector(18.0, 23.12, 45.0))
    Call Selection.DragSnapped(Selected, Town, P.Vector(18.0, 23.12, 45.0), Guide, 5.0)
    Call Check(Town.Items[0].Position.X = 13.0 And Not Selected.Changed,
        "Selecting An Off-Grid Item Does Not Snap Or Move It")
    Call Selection.DragSnapped(Selected, Town, P.Vector(27.0, 23.12, 50.0), Guide, 5.0)
    Call Check(Town.Items[0].Position.X = 20.0 And Town.Items[0].Position.Z = 60.0 And
        Town.Items[1].Position.X = 60.0, "Grid Snaps Assembly Origin And Preserves Group Spacing")
    Call Selection.EndDrag(Selected, Town, False)
    Call History.Record(Journal, Town, Guide.Ink)
    Call History.Record(Journal, Town, Guide.Ink)
    Call Check(History.UndoCount(Journal) = 1, "Complete Group Drag Is One Undo Step")

    Ok = History.Restore(Journal, Town, Guide.Ink, False)

    Call Check(Ok And Town.Items[0].Position.X = 13.0 And Town.Items[1].Position.X = 53.0,
        "Undo Restores The Whole Group")

    Ok = History.Restore(Journal, Town, Guide.Ink, True)
    Ok = Selection.Duplicate(Selected, Town, 20.0) And Ok

    Call History.Record(Journal, Town, Guide.Ink)
    Call Check(Ok And Town.ItemCount = 4 And Selected.SelectedCount = 2 And
        Selected.Selected[2] And Not Selected.Selected[0] And Town.Items[2].Yaw = 35.0 And
        Town.Items[2].Scale.X = Sample.Scale.X And Town.Items[2].Position.Y = Sample.Position.Y And
        Town.Items[2].Position.X = 40.0 And Town.Items[3].Position.X = 80.0,
        "Duplicate Selects New Identities And Preserves Every Authored Transform")

    Identity = Town.Items[3].Identity
    Ok = History.Restore(Journal, Town, Guide.Ink, False)

    Call Check(Ok And Town.ItemCount = 2, "Undo Removes A Duplicate Group")

    Ok = History.Restore(Journal, Town, Guide.Ink, True)
    Town.Name = "Saved Version"
    Town.SavedRevision = Town.Revision
    Revision = Town.SavedRevision
    BeforeSurface = Town.Surface.Revision

    Call Grid.PaintRectangle(Town.Surface, 1, 1, 3, 3, Grid.SURFACE_WATER)

    Town.Revision = Town.Revision + 1

    Call History.Record(Journal, Town, Guide.Ink)

    Ok = History.Restore(Journal, Town, Guide.Ink, False)

    Call Check(Ok And Grid.ReadCell(Town.Surface, 2, 2) = Grid.SURFACE_GROUND And
        Town.Surface.Revision > BeforeSurface And Town.Name = "Saved Version" And
        Town.SavedRevision = Revision, "Undo Rebuilds Terrain Without Rolling Back Save Identity")

    Ok = History.Restore(Journal, Town, Guide.Ink, True)

    Call Check(Ok And Grid.ReadCell(Town.Surface, 2, 2) = Grid.SURFACE_WATER, "Redo Restores Painted Water")

    Ok = History.Restore(Journal, Town, Guide.Ink, False)
    Placed = Document.Place(Town, Sample, 99.0, 99.0)

    Call History.Record(Journal, Town, Guide.Ink)
    Call Check(History.RedoCount(Journal) = 0 And Town.Items[Placed].Identity > Identity,
        "New Edit Discards Redo Without Reusing Item Identities")

    For X = 1 To 25
        Town.Light.Ambient = X
        Town.Revision = Town.Revision + 1

        Call History.Record(Journal, Town, Guide.Ink)
    End For

    Call Check(History.UndoCount(Journal) = 20, "History Retains Twenty Bounded Undo Steps")

    For X = 1 To 20
        Ok = History.Restore(Journal, Town, Guide.Ink, False)
    End For

    Call Check(Ok And Town.Light.Ambient = 5 And History.UndoCount(Journal) = 0,
        "Wrapped History Restores Lighting In Order")

    Revision = Town.Revision
    BeforeSurface = Town.Surface.Revision
    Town.SavedRevision = Town.Revision

    Call History.Reset(Journal, Town, Guide.Ink)

    Ok = Guides.Add(Guide.Ink, P.Vector(0.0, 0.0, 0.0), P.Vector(100.0, 0.0, 0.0), False)
    Ok = Guides.Add(Guide.Ink, P.Vector(30.0, 0.0, 30.0), P.Vector(80.0, 0.0, 70.0), True) And Ok

    Call History.Record(Journal, Town, Guide.Ink)
    Call Guides.ClearMarkers(Guide.Ink)
    Call History.Record(Journal, Town, Guide.Ink)

    Ok = History.Restore(Journal, Town, Guide.Ink, False) And Ok

    Call Check(Ok And Guide.Ink.EntryCount = 2 And Town.Revision = Revision And
        Town.Surface.Revision = BeforeSurface And Not Document.Dirty(Town),
        "Clear Markers Is Undoable Without Mutating The Saved Town Or Terrain")

    Guide.Selected[0] = True
    Guide.Selected[1] = True
    Ok = MarkerTools.Duplicate(Guide)

    Call History.Record(Journal, Town, Guide.Ink)
    Call Check(Ok And Guide.Ink.EntryCount = 4 And Guide.Selected[2] And Guide.Selected[3] And
        Not Guide.Selected[0] And Guide.Ink.Markers[3].IsRectangle And
        Guide.Ink.Markers[2].Last.X - Guide.Ink.Markers[2].First.X = 100.0,
        "Guide Duplicate Copies The Selected Shapes And Selects Only The Copies")

    Ok = History.Restore(Journal, Town, Guide.Ink, False)

    Call MarkerTools.ClearSelection(Guide)
    Call Check(Ok And Guide.Ink.EntryCount = 2 And Town.Revision = Revision,
        "Undo Marker Duplication Preserves The Saved Town")
    Call Check(MarkerTools.Hit(Guide, P.Vector(50.0, 23.12, 1.0), 3.0) = 0 And
        MarkerTools.Hit(Guide, P.Vector(200.0, 23.12, 200.0), 3.0) = -1,
        "Marker Selection Hits A Line Near Its Edge And Rejects Empty Ground")

    Guide.SnapMode = 0

    Call MarkerTools.Gesture(MarkerGesture, Guide, P.Vector(-10.0, 23.12, -10.0), 1.0,
        True, True, True, False)
    Call MarkerTools.Gesture(MarkerGesture, Guide, P.Vector(110.0, 23.12, 80.0), 1.0,
        True, False, False, False)
    Call Check(MarkerTools.SelectedCount(Guide) = 2,
        "Rubber Selection Selects Multiple Guide Markers")
    Call MarkerTools.Gesture(MarkerGesture, Guide, P.Vector(40.0, 23.12, 0.0), 1.0,
        True, True, True, False)
    Call MarkerTools.Gesture(MarkerGesture, Guide, P.Vector(60.0, 23.12, 10.0), 1.0,
        True, False, True, False)
    Call MarkerTools.Gesture(MarkerGesture, Guide, P.Vector(60.0, 23.12, 10.0), 1.0,
        True, False, False, False)
    Call History.Record(Journal, Town, Guide.Ink)
    Call Check(Guide.Ink.Markers[0].First.X = 20.0 And Guide.Ink.Markers[1].First.X = 50.0,
        "One Drag Moves The Entire Selected Guide Group")

    Ok = History.Restore(Journal, Town, Guide.Ink, False)

    Call Check(Ok And Guide.Ink.Markers[0].First.X = 0.0 And Guide.Ink.Markers[1].First.X = 30.0,
        "Guide Group Movement Is One Undo Step")

    Guide.SnapMode = 2
    Point = Guides.Snap(Guide, P.Vector(99.0, 47.0, 2.0), 5.0)

    Call Check(Point.X = 100.0 And Point.Z = 0.0 And Point.Y = 47.0,
        "Marker Endpoints Snap Without Changing Height")

    Point = Guides.Snap(Guide, P.Vector(50.0, 0.0, 2.0), 5.0)

    Call Check(Point.X = 50.0 And Point.Z = 0.0, "Line Interior Snaps To Nearest Segment")

    Point = Guides.Snap(Guide, P.Vector(50.0, 0.0, 32.0), 5.0)

    Call Check(Point.X = 50.0 And Point.Z = 30.0, "Rectangle Edge Is A Snap Guide")

    Point = Guides.Snap(Guide, P.Vector(78.0, 0.0, 68.0), 5.0)

    Call Check(Point.X = 80.0 And Point.Z = 70.0, "Rectangle Corner Takes Priority")

    Point = Guides.Snap(Guide, P.Vector(-31.0, 0.0, -51.0), 5.0)

    Call Check(Point.X = -31.0 And Point.Z = -51.0, "Distant Markers Do Not Attract Placement")

    Guide.SnapMode = 3
    Point = Guides.Snap(Guide, P.Vector(-31.0, 0.0, -51.0), 5.0)

    Call Check(Point.X = -40.0 And Point.Z = -60.0, "Combined Mode Falls Back To Grid At Negative Coordinates")

    Point = Guides.Snap(Guide, P.Vector(50.0, 0.0, 32.0), 5.0)

    Call Check(Point.X = 50.0 And Point.Z = 30.0, "Nearby Marker Takes Priority Over Grid")

    Guide.SnapMode = 0
    Point = Guides.Snap(Guide, P.Vector(11.5, 0.0, 12.5), 5.0)

    Call Check(Point.X = 11.5 And Point.Z = 12.5, "Snap Off Preserves Free Placement")

End Sub

Sub CheckCastleDecks()

    Dim Openings As Decks.State
    Dim Angle As Number
    Dim Point As P.Vector3
    Dim First As Double
    Dim Last As Double
    Dim Cursor As Double
    Dim Start As P.Vector3
    Dim Finish As P.Vector3
    Dim Ok As Boolean
    Dim HasPiece As Boolean

    Ok = Document.Blank(Town, "Castle Water Fixture", 200, 200, 20.0)

    Call Grid.PaintRectangle(Town.Surface, 0, 0, 199, 199, Grid.SURFACE_WATER)

    Town.ItemCount = 1
    Town.Items[0] = Catalog.InitialItem(45)
    Town.Items[0].Position = P.Vector(210.0, 22.52, 150.0)

    For Angle = 0 To 3

        Town.Items[0].Yaw = ToDouble(Angle) * 90.0 + 27.0

        Call Navigation.Rebuild(Town)
        Call Decks.Capture(Openings, Town)

        For X = -540 To -210
            Point = Geometry.ToWorld(Town.Items[0], P.Vector(0.0, 0.0, ToDouble(X)))

            Call Check(Navigation.CanStand(Point.X, Point.Z), "Relocated Rotated Castle Bridge Crosses Water Into Courtyard")
            Call Check(Abs(Navigation.GroundHeight(Point.X, Point.Z) - 22.52) < 0.05,
                "Castle Floor Walking Height Follows The Assembly")
        End For

        Point = Geometry.ToWorld(Town.Items[0], P.Vector(100.0, 0.0, -160.0))

        Call Check(Navigation.CanStand(Point.X, Point.Z), "Courtyard Supports Party Above Water")

        Point = Geometry.ToWorld(Town.Items[0], P.Vector(0.0, 0.0, -160.0))

        Call Check(Not Navigation.CanStand(Point.X, Point.Z), "Castle Fountain Remains Solid")

        Point = Geometry.ToWorld(Town.Items[0], P.Vector(100.0, 0.0, -300.0))

        Call Check(Not Navigation.CanStand(Point.X, Point.Z), "Castle Curtain Wall Remains Solid")

        Point = Geometry.ToWorld(Town.Items[0], P.Vector(80.0, 0.0, -450.0))

        Call Check(Not Navigation.CanStand(Point.X, Point.Z), "Water Beside The Bridge Stays Unwalkable")

        Cursor = 0.0
        Start = Geometry.ToWorld(Town.Items[0], P.Vector(-100.0, 0.0, -450.0))
        Finish = Geometry.ToWorld(Town.Items[0], P.Vector(100.0, 0.0, -450.0))
        HasPiece = Decks.NextRail(Openings, Start, Finish, Cursor, First, Last)

        Call Check(HasPiece And First = 0.0 And Last > 0.26 And Last < 0.28,
            "Automatic Rail Stops Before The Moved Bridge")

        HasPiece = Decks.NextRail(Openings, Start, Finish, Cursor, First, Last)

        Call Check(HasPiece And First > 0.72 And First < 0.74 And Last = 1.0,
            "Automatic Rail Resumes After The Moved Bridge")
        Call Check(Decks.Matches(Openings, Town), "Unchanged Decks Reuse Terrain")

        Town.Items[0].Position.X = Town.Items[0].Position.X + 11.0

        Call Check(Not Decks.Matches(Openings, Town), "Moving A Castle Invalidates Terrain Rail Openings")
    End For

    Point = Geometry.ToWorld(Town.Items[0], P.Vector(100.0, 0.0, -160.0))
    Town.Items[0].Active = False

    Call Navigation.Rebuild(Town)
    Call Check(Not Navigation.CanStand(Point.X, Point.Z), "Removed Castle Cannot Leave A Walkable Water Footprint")

End Sub
