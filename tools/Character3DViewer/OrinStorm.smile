''' Orin's presentation uses calibrated equipment sockets and the shared lightning module.
Module Smile.Tools.OrinStorm

Option Explicit

Import Smile.Simple3D.Core As Core
Import Smile.Simple3D.Character3D As Character3D
Import Smile.Simple3D.Graphics3D As Graphics3D
Import Smile.Simple3D.LightningVfx3D As Lightning
Import Smile.Simple3D.Math3D As Math3D
Import Smile.Simple3D.FixedMath As Fixed

Public Type ChargeState
    Energy As Number
    ContactApplied As Boolean
    ReleaseApplied As Boolean
End Type

Private Dim Available As Boolean
Private Dim Ok As Boolean
Private Dim Effects[8] As Lightning.LightningEffect
Private Dim PreviousClip As Text
Private Dim PreviousTime As Number
Private Dim StateText As Text
Private Dim ThunderPlayed As Boolean
Private Dim FirstError As Number
Private Dim RimNames[8] As Text
Private Dim ChargeValue As ChargeState
Private Dim Comfort As Number
Private Dim AttackStyle As Number
Private Dim FlashOpacity As Number
Private Dim RenderVisible As Boolean
Private Dim TrailTexture As Core.Texture3D
Private Dim TrailMaterial As Core.Material3D
Private Dim HammerTrail As Core.GpuParticleSystem3D
Private Dim TrailPrevious As Core.Vector3
Private Dim TrailHasPrevious As Boolean
Private Dim TrailCursor As Number
Private Dim TrailSerial As Number
Private Dim AttackPhase As Number
Private Dim ImpactGround As Core.Vector3

''' Pure caller-owned state; independent of rendering, handles and effect visibility.
Public Sub BeginAction(ByRef Value As ChargeState)

    Value.ContactApplied = False
    Value.ReleaseApplied = False

End Sub

Public Function AdvanceCharge(ByRef Value As ChargeState, Progress1000 As Number,
    Charging As Boolean, Attacking As Boolean) As Number

    Dim Events As Number

    If (Charging And
        Progress1000 >= 350 And
        Not Value.ContactApplied) Then

        Value.Energy = 1000
        Value.ContactApplied = True
        Events = 1

    End If

    If (Attacking And
        Progress1000 >= 640 And
        Not Value.ReleaseApplied) Then

        Value.Energy = Max(0, Value.Energy - 350)
        Value.ReleaseApplied = True
        Events = Events + 2

    End If

    Return Events

End Function

Public Sub Initialize()

    Available = Lightning.Initialize("Assets/Lightning", 8192,
        Graphics3D.GPU_PARTICLE_SIMULATION_AUTO, 4096)
    TrailTexture = Graphics3D.LoadTexture3D("Assets/Lightning/lightning-spark.png")
    TrailMaterial = Graphics3D.CreateEffectMaterial3D(TrailTexture,
        Graphics3D.MATERIAL_ALPHA_ADDITIVE, 300)
    HammerTrail = Graphics3D.CreateGpuParticleSystem3D(1024, TrailMaterial,
        Graphics3D.GPU_PARTICLE_SIMULATION_AUTO, 10)
    TrailHasPrevious = False
    TrailCursor = 0
    TrailSerial = 0
    AttackPhase = 0

    If HammerTrail.Handle <> 0 Then

        Ok = Graphics3D.SetGpuParticleRender3D(HammerTrail, Graphics3D.GPU_PARTICLE_SHADER_THERMAL, 2)
        Ok = Graphics3D.SetGpuParticleForces3D(HammerTrail, 0, -75, 0, 0, 0, 0, 0, 170)
        Ok = Graphics3D.SetGpuParticleThermalEvolution3D(HammerTrail, 0, 250, 0, 800)

    End If

    FirstError = 0
    PreviousClip = ""
    PreviousTime = 0
    StateText = "Stored Storm"
    ChargeValue.Energy = 1000

    If Comfort = 0 Then
        Comfort = 2
    End If

    FlashOpacity = 0

    Call BeginAction(ChargeValue)

    RimNames[0] = "ShieldRim0"
    RimNames[1] = "ShieldRim1"
    RimNames[2] = "ShieldRim2"
    RimNames[3] = "ShieldRim3"
    RimNames[4] = "ShieldRim4"
    RimNames[5] = "ShieldRim5"
    RimNames[6] = "ShieldRim6"
    RimNames[7] = "ShieldRim7"

    If Available Then
        Ok = Lightning.SetFlashMode(Comfort)
    Else
        FirstError = Lightning.Value(Lightning.QUERY_LAST_ERROR, Effects[0])
    End If

End Sub

Private Sub ClearEffect(Index As Number)

    If Effects[Index].Slot <> 0 Then
        Ok = Lightning.Destroy(Effects[Index])
    End If

End Sub

Public Sub Shutdown()

    Dim Index As Number

    For Index = 0 To 7
        Call ClearEffect(Index)
    End For

    Call Lightning.Shutdown()
    Call Graphics3D.DestroyGpuParticleSystem3D(HammerTrail)
    Call Graphics3D.DestroyEffectMaterial3D(TrailMaterial)
    Call Graphics3D.DestroyTexture3D(TrailTexture)

    Available = False

End Sub

Private Sub Attach(Index As Number, Source As Core.Vector3, Target As Core.Vector3,
    Preset As Text, Width As Number, Power As Number, Branches As Number)

    Dim EffectQuality As Number

    EffectQuality = Lightning.QUALITY_HIGH

    If Index >= 3 Then
        EffectQuality = Lightning.QUALITY_ULTRA
    End If

    If Math3D.Distance(Source, Target) < 1 Then
        Return
    End If

    If Effects[Index].Slot <> 0 Then

        If Lightning.Value(Lightning.QUERY_FINISHED, Effects[Index]) <> 0 Then

            If Index >= 3 And AttackPhase = 2 Then
                Return
            End If

            Call ClearEffect(Index)

        End If

    End If

    If Effects[Index].Slot = 0 Then

        Effects[Index] = Lightning.StartAt(Preset, Source, Target, 1307 + Index * 137,
            EffectQuality)

        If Effects[Index].Slot = 0 Then
            FirstError = Lightning.Value(Lightning.QUERY_LAST_ERROR, Effects[0])
            Return
        End If

        Ok = Lightning.SetBranchBudget(Effects[Index], Branches)
        Ok = Lightning.SetSparkIntensity(Effects[Index], 75)

    End If

    Ok = Lightning.SetEndpoints(Effects[Index], Source, Target)
    Ok = Lightning.SetStyle(Effects[Index], Width, Power)

End Sub

Private Sub UpdateHammerTrail(Position As Core.Vector3, Elapsed As Number,
    Attacking As Boolean, Visible As Boolean, MotionPaused As Boolean, Paused As Boolean)

    Dim SparkCount As Number
    Dim Index As Number
    Dim Step As Number
    Dim Noise As Number
    Dim Distance As Number
    Dim Point As Core.Vector3
    Dim Velocity As Core.Vector3

    If HammerTrail.Handle = 0 Then
        Return
    End If

    Step = Min(100, Max(0, Elapsed))
    Distance = Math3D.Distance(TrailPrevious, Position)

    If (Not TrailHasPrevious Or
        Not Visible Or
        MotionPaused Or
        Distance > 100) Then
        TrailPrevious = Position
        Distance = 0
    End If

    If (Visible And
        Attacking And
        Not MotionPaused And
        Not Paused And
        Step > 0) Then

        SparkCount = Min(32, Max(1, Step / 8) + Distance / 2)
        Velocity.X = (Position.X - TrailPrevious.X) * 180 / Step
        Velocity.Y = (Position.Y - TrailPrevious.Y) * 180 / Step
        Velocity.Z = (Position.Z - TrailPrevious.Z) * 180 / Step

        For Index = 0 To SparkCount - 1

            TrailSerial = TrailSerial + 1
            Noise = (TrailSerial * 7919) Mod 104729
            Point.X = TrailPrevious.X + (Position.X - TrailPrevious.X) * (Index + 1) / SparkCount
            Point.Y = TrailPrevious.Y + (Position.Y - TrailPrevious.Y) * (Index + 1) / SparkCount
            Point.Z = TrailPrevious.Z + (Position.Z - TrailPrevious.Z) * (Index + 1) / SparkCount
            Ok = Graphics3D.KillGpuParticleSlot3D(HammerTrail, TrailCursor)
            Ok = Graphics3D.SetGpuParticleSpawnKinematics3D(HammerTrail, TrailCursor,
                Point.X, Point.Y, Point.Z,
                Velocity.X + Noise Mod 41 - 20, Velocity.Y + Noise / 41 Mod 50,
                Velocity.Z + Noise / 2050 Mod 41 - 20) And Ok
            Ok = Graphics3D.SetGpuParticleSpawnVisual3D(HammerTrail, TrailCursor,
                650 + Noise Mod 400, 1 + Noise Mod 2, 1, Noise Mod 360, 85, 1000, 800) And Ok
            Ok = Graphics3D.CommitGpuParticleSpawn3D(HammerTrail, TrailCursor,
                TrailSerial, Max(1, Noise)) And Ok
            TrailCursor = (TrailCursor + 1) Mod 1024
        End For

    End If

    If Not Paused Then
        Ok = Graphics3D.AdvanceGpuParticleSystem3D(HammerTrail, Step)
    End If

    TrailPrevious = Position
    TrailHasPrevious = Visible

End Sub

Private Sub UpdateRim(Actor As Character3D.Actor, Visible As Boolean)

    Dim Point As Core.Vector3
    Dim First As Core.Vector3
    Dim Second As Core.Vector3
    Dim Index As Number
    Dim Name As Text

    If Not Visible Then
        Call ClearEffect(0)

        Return
    End If

    First = Character3D.SocketPosition(Actor, "ShieldRim0", 0)
    Second = Character3D.SocketPosition(Actor, "ShieldRim1", 0)

    If Effects[0].Slot = 0 Then

        Effects[0] = Lightning.StartAt("StoredStorm", First, Second, 1300, Lightning.QUALITY_MEDIUM)

        If Effects[0].Slot = 0 Then
            FirstError = Lightning.Value(Lightning.QUERY_LAST_ERROR, Effects[0])
            Return
        End If

        Ok = Lightning.SetStyle(Effects[0], 1, 720)
        Ok = Lightning.SetBranchBudget(Effects[0], 0)
        Ok = Lightning.SetPathJitter(Effects[0], 0)
        Ok = Lightning.SetSparkIntensity(Effects[0], 15)

        For Index = 2 To 7
            Name = RimNames[Index]
            Point = Character3D.SocketPosition(Actor, Name, 0)

            Ok = Lightning.AddChainTarget(Effects[0], Point)
        End For

        Ok = Lightning.AddChainTarget(Effects[0], First)

    Else

        Ok = Lightning.SetEndpoints(Effects[0], First, Second)

        For Index = 2 To 7
            Name = RimNames[Index]
            Point = Character3D.SocketPosition(Actor, Name, 0)

            Ok = Lightning.SetChainTarget(Effects[0], Index - 2, Point)
        End For

        Ok = Lightning.SetChainTarget(Effects[0], 6, First)

    End If

End Sub

Public Sub Update(Actor As Character3D.Actor, Clip As Text, Target As Core.Vector3,
    ByRef Camera As Core.Camera3D, Elapsed As Number, Enabled As Boolean,
    WeaponVisible As Boolean, ShieldVisible As Boolean, Paused As Boolean, MotionPaused As Boolean)

    Dim Head As Core.Vector3
    Dim LeftPoint As Core.Vector3
    Dim RightPoint As Core.Vector3
    Dim Index As Number
    Dim Duration As Number
    Dim Time As Number
    Dim Progress As Number
    Dim Power As Number
    Dim Attack As Boolean
    Dim Charge As Boolean
    Dim Release As Boolean
    Dim Events As Number

    If Not Available Then
        Return
    End If

    If Paused Then

        ''' Keep this VFX snapshot while animation and camera controls continue.
        ''' Restage billboards for the live camera without aging or moving emitters.
        TrailHasPrevious = False
        Ok = Lightning.Update(0, Camera)
        Return

    End If

    Time = Character3D.AnimationTime(Actor)
    Duration = 1

    For Index = 0 To Character3D.ClipCount(Actor) - 1

        If Character3D.ClipName(Actor, Index) = Clip Then
            Duration = Max(1, Character3D.ClipDuration(Actor, Index))
        End If

    End For

    Progress = Min(1000, Time * 1000 / Duration)

    If Clip <> PreviousClip Or Time < PreviousTime Then

        TrailHasPrevious = False
        AttackPhase = 0

        For Index = 3 To 7
            Call ClearEffect(Index)
        End For

        ThunderPlayed = False

        Call BeginAction(ChargeValue)

    End If

    PreviousClip = Clip
    PreviousTime = Time
    Attack = Clip = "SwordAttack" Or Clip = "JumpAttack" Or Clip = "ThorAttack"
    Charge = Clip = "ThorAttack" And Progress >= 120 And Progress < 520
    Release = Attack And Progress >= 640
    Events = 0

    If Not MotionPaused Then
        Events = AdvanceCharge(ChargeValue, Progress, Clip = "ThorAttack", Attack)
    End If

    Power = 150 + ChargeValue.Energy * 500 / 1000
    StateText = "Stored Storm"
    FlashOpacity = Max(0, FlashOpacity - Elapsed)

    If Charge Then
        Power = Min(1000, 650 + Progress / 2)
        StateText = "Sky Charge"
    Else If Release Then
        Power = 1000
        StateText = "Lightning Discharge"
    End If

    If Clip = "Death" And Progress > 600 Then
        Enabled = False
        StateText = "Storm Fading"
    End If

    RenderVisible = Enabled

    If Not Enabled Then

        TrailHasPrevious = False

        For Index = 0 To 7
            Call ClearEffect(Index)
        End For

        Ok = Lightning.Update(Elapsed, Camera)
        Ok = Graphics3D.AdvanceGpuParticleSystem3D(HammerTrail, Min(100, Max(0, Elapsed))) And Ok
        Ok = Graphics3D.SetPointLight3D(2, 0, 0, 0, 150, 190, 255, 0, 130)
        FlashOpacity = 0

        Return

    End If

    Call UpdateRim(Actor, ShieldVisible)

    Head = Character3D.SocketPosition(Actor, "HammerHead", 1)
    LeftPoint = Character3D.SocketPosition(Actor, "HammerLeft", 1)
    RightPoint = Character3D.SocketPosition(Actor, "HammerRight", 1)

    Call UpdateHammerTrail(Head, Elapsed, Attack, WeaponVisible, MotionPaused, Paused)

    If WeaponVisible Then

        Call Attach(1, LeftPoint, RightPoint, "StoredStorm", 1, Power, 2)

        LeftPoint.Y = LeftPoint.Y + 3
        RightPoint.Y = RightPoint.Y + 3

        Call Attach(2, RightPoint, LeftPoint, "StoredStorm", 1, Power, 1)

    Else

        For Index = 1 To 7
            Call ClearEffect(Index)
        End For

    End If

    Call UpdateBattleEffects(Head, Target, Charge And WeaponVisible, Release And WeaponVisible)

    If (Release And
        WeaponVisible And
        Not MotionPaused And
        Events >= 2 And
        Not ThunderPlayed) Then

        ThunderPlayed = True
        FlashOpacity = 180

        Play Sound "Assets/Lightning/thunder.wav"

    End If

    If Effects[1].Slot <> 0 Then
        Ok = Lightning.SetCharge(Effects[1], ChargeValue.Energy)
    End If

    If Comfort <> 3 And FlashOpacity > 0 Then
        Camera.Position.X = Camera.Position.X + FlashOpacity / (Comfort * 90)
    End If

    If WeaponVisible Then
        Ok = Graphics3D.SetPointLight3D(2, Head.X, Head.Y, Head.Z,
            150, 190, 255, Power / 5, 130)
    Else
        Ok = Graphics3D.SetPointLight3D(2, 0, 0, 0, 150, 190, 255, 0, 130)
    End If

    If Paused Then
        Ok = Lightning.Update(0, Camera)
    Else

        Ok = Lightning.Update(Elapsed, Camera)
    End If

    If Lightning.Value(Lightning.QUERY_LAST_ERROR, Effects[0]) <> 0 And FirstError = 0 Then
        FirstError = Lightning.Value(Lightning.QUERY_LAST_ERROR, Effects[0])
    End If

End Sub

Private Sub UpdateBattleEffects(Head As Core.Vector3, Target As Core.Vector3,
    Charging As Boolean, Releasing As Boolean)

    Dim NextPhase As Number
    Dim Index As Number
    Dim Angle As Number
    Dim Sky As Core.Vector3
    Dim EndPoint As Core.Vector3
    Dim Opposite As Core.Vector3

    If Charging Then
        NextPhase = 1
    Else If Releasing Then
        NextPhase = 2
    End If

    If NextPhase <> AttackPhase Then

        For Index = 3 To 7
            Call ClearEffect(Index)
        End For

        ImpactGround = Head
        ImpactGround.Y = 3
        AttackPhase = NextPhase

    End If

    If Charging Then

        StateText = "Forked Judgment"

        ''' The Lab's four SkyStrike recipe converges on the raised hammer.

        For Index = 3 To 6

            Angle = (Index - 3) * 90
            Sky = Head
            Sky.X = Sky.X + Fixed.SinFixed(Angle) * 220 / Core.FIXED_ONE
            Sky.Y = Sky.Y + 400
            Sky.Z = Sky.Z + Fixed.CosFixed(Angle) * 220 / Core.FIXED_ONE

            Call Attach(Index, Sky, Head, "SkyStrike", 3, 1000, 24)
        End For

    Else If Releasing Then

        StateText = StyleName()

        For Index = 3 To 6

            Angle = (Index - 3) * 45
            EndPoint = ImpactGround
            EndPoint.X = EndPoint.X + Fixed.SinFixed(Angle) * 250 / Core.FIXED_ONE
            EndPoint.Z = EndPoint.Z + Fixed.CosFixed(Angle) * 250 / Core.FIXED_ONE
            Opposite = ImpactGround
            Opposite.X = Opposite.X - Fixed.SinFixed(Angle) * 250 / Core.FIXED_ONE
            Opposite.Z = Opposite.Z - Fixed.CosFixed(Angle) * 250 / Core.FIXED_ONE

            If AttackStyle = 1 Then

                Call Attach(Index, Head, Target, "WeaponCorona", 2, 1000, 6)

            Else If AttackStyle = 2 Then

                Call Attach(Index, Head, EndPoint, "ChainTempest", 2, 1000, 10)

            Else If AttackStyle = 3 Then

                Sky = Target
                Sky.Y = Sky.Y + 400
                Sky.X = Sky.X + (Index - 4) * 80

                Call Attach(Index, Sky, EndPoint, "SkyStrike", 3, 1000, 24)

            Else

                ''' Pair opposite spokes to reuse the Lab's eight-ray slam within the scene budget.

                Call Attach(Index, ImpactGround, EndPoint, "ThunderGroundSlam", 3, 1000, 18)

                If Effects[Index].Slot <> 0 Then

                    If Lightning.Value(Lightning.QUERY_CHAIN_TARGETS, Effects[Index]) = 0 Then
                        Ok = Lightning.AddChainTarget(Effects[Index], ImpactGround)
                        Ok = Lightning.AddChainTarget(Effects[Index], Opposite) And Ok
                    End If

                End If

            End If

        End For

        Call Attach(7, Head, Target, "StoredStorm", 2, 1000, 8)

    End If

End Sub

Public Sub DrawFlash()

    If (Available And
        RenderVisible And
        Comfort <> 3 And
        FlashOpacity > 0) Then
        Fill Rectangle 0, 0, Window_Width(), Window_Height(), Rgb(155, 195, 255) Opacity FlashOpacity / (Comfort * 18)
    End If

End Sub

Public Sub CycleStyle()

    Dim Index As Number

    AttackStyle = (AttackStyle + 1) Mod 4

    For Index = 3 To 7
        Call ClearEffect(Index)
    End For

End Sub

Public Function StyleName() As Text

    If AttackStyle = 1 Then
        Return "Storm Lance"
    Else If AttackStyle = 2 Then
        Return "Chain Arcs"
    Else If AttackStyle = 3 Then
        Return "Godstorm"
    End If

    Return "Thunder Smash"

End Function

Public Sub CycleComfort()

    Comfort = Comfort Mod 3 + 1
    Ok = Lightning.SetFlashMode(Comfort)

End Sub

Public Function ComfortName() As Text

    If Comfort = 1 Then
        Return "Flash/Shake Full"
    Else If Comfort = 2 Then
        Return "Flash/Shake Low"
    End If

    Return "Flash/Shake Off"

End Function

Public Function StoredCharge() As Number

    Dim ReturnValue As Number

    ReturnValue = ChargeValue.Energy

    Return ReturnValue

End Function

Public Sub Draw()

    If Available And RenderVisible Then

        Ok = Lightning.DrawAll()

        If HammerTrail.Handle <> 0 Then
            Ok = Graphics3D.DrawGpuParticleSystem3D(HammerTrail) And Ok
        End If

    End If

End Sub

Public Function Caption() As Text

    Return StateText

End Function

Public Function LastError() As Number

    Return FirstError

End Function

End Module
