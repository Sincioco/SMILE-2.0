''' Per-actor Orin presentation staged through scene-owned lightning and light resources.
Module Smile.Tools.OrinStorm

Option Explicit

Import Smile.Simple3D.Core As Core
Import Smile.Simple3D.Precision3D As Precision3D
Import Smile.Simple3D.PrecisionMath3D As PreciseMath
Import Smile.Simple3D.Character3D As Character3D
Import Smile.Simple3D.Graphics3D As Graphics3D
Import Smile.Simple3D.LightningVfx3D As Lightning
Import Smile.Simple3D.FireEmitter3D As Fire
Import Smile.Simple3D.LightPool3D As LightPool3D
Import Smile.Simple3D.Math3D As Math3D
Import Smile.Simple3D.FixedMath As Fixed
Import Smile.Assets.OrinV13Equipment As EquipmentAsset

Public Const MAX_CONTEXTS = 4
Public Const SCENE_COMFORT_FULL = 1
Public Const SCENE_COMFORT_REDUCED = 2
Public Const SCENE_COMFORT_OFF = 3
Public Const MAX_LIGHTNING_EFFECTS_PER_CONTEXT = 4
Public Const FALLBACK_NONE = 0
Public Const FALLBACK_CONTEXT_BUDGET = 1
Public Const FALLBACK_SHARED_CAPACITY = 2
Public Const FALLBACK_PARTICLE_BACKEND = 3
Public Const EQUIPMENT_LIGHTNING = 0
Public Const EQUIPMENT_BLUE_FLAME = 1
Public Const EQUIPMENT_NEON_ARCS = 2

Private Const HANDLE_FACTOR = 10
Private Const MAX_GENERATION = 1000000

Public Type ChargeState
    Energy As Number
    ContactApplied As Boolean
    ReleaseApplied As Boolean
End Type

Public Type Context
    Handle As Number
End Type

Private Dim Prepared As Boolean
Private Dim EngineAvailable As Boolean
Private Dim WorkResult As Boolean
Private Dim SceneComfort As Number
Private Dim ContextUsed[4] As Boolean
Private Dim ContextGeneration[4] As Number
Private Dim Effects[4, 8] As Lightning.LightningEffect
Private Dim PreviousClips[4] As Text
Private Dim PreviousTimes[4] As Number
Private Dim StateTexts[4] As Text
Private Dim ThunderPlayed[4] As Boolean
Private Dim ThunderEventCounts[4] As Number
Private Dim FirstErrors[4] As Number
Private Dim ChargeValues[4] As ChargeState
Private Dim AttackStyles[4] As Number
Private Dim FlashOpacities[4] As Number
Private Dim ImpactShakes[4] As Number
Private Dim RenderVisible[4] As Boolean
Private Dim WeaponRenderVisible[4] As Boolean
Private Dim FrozenRebase[4] As Boolean
Private Dim HammerTrails[4] As Lightning.WeaponTrail
Private Dim EquipmentStyles[4] As Number
Private Dim EquipmentFires[4, 2] As Fire.FireEmitter
Private Dim FireClips[4] As Text
Private Dim FireTimes[4] As Number
Private Dim FireWasFrozen[4] As Boolean
Private Dim NeonElapsed[4] As Number
Private Dim AttackPhases[4] As Number
Private Dim ActionIdentities[4] As Number
Private Dim RequestedEffects[4] As Number
Private Dim EffectiveEffects[4] As Number
Private Dim RequestedQualities[4] As Number
Private Dim EffectiveQualities[4] As Number
Private Dim FallbackCauses[4] As Number
Private Dim ImpactGrounds[4] As Precision3D.Vector3
Private Dim RimNames[8] As Text

''' Pure caller-owned state; independent of rendering, handles and effect visibility.
Public Sub BeginAction(ByRef Value As ChargeState)

    Value.ContactApplied = False
    Value.ReleaseApplied = False

End Sub

Public Function AdvanceCharge(ByRef Value As ChargeState, Progress1000 As Number,
    Charging As Boolean, Attacking As Boolean) As Number

    Dim Events As Number

    If (Charging And
        Progress1000 >= 350 And
        Not Value.ContactApplied) Then

        Value.Energy = 1000
        Value.ContactApplied = True
        Events = 1

    End If

    If (Attacking And
        Progress1000 >= 640 And
        Not Value.ReleaseApplied) Then

        Value.Energy = Max(0, Value.Energy - 350)
        Value.ReleaseApplied = True
        Events = Events + 2

    End If

    Return Events

End Function

Private Function RawSlot(Value As Context) As Number

    Dim ReturnValue As Number

    Dim Generation As Number
    Dim Slot As Number

    Slot = (Value.Handle Mod HANDLE_FACTOR) - 1
    Generation = Value.Handle / HANDLE_FACTOR

    If (Not Prepared Or
        Slot < 0 Or
        Slot >= MAX_CONTEXTS) Then
        ReturnValue = -1

        Return ReturnValue
    End If

    If Not ContextUsed[Slot] Or ContextGeneration[Slot] <> Generation Then
        ReturnValue = -1

        Return ReturnValue
    End If

    Return Slot

End Function

Public Function IsValid(Value As Context) As Boolean

    Dim Result As Boolean

    Result = RawSlot(Value) >= 0

    Return Result

End Function

Public Sub Prepare(LightningAvailable As Boolean)

    If Prepared Then
        Call Shutdown()
    End If

    EngineAvailable = LightningAvailable
    Prepared = True
    SceneComfort = SCENE_COMFORT_REDUCED
    RimNames[0] = "ShieldRim0"
    RimNames[1] = "ShieldRim1"
    RimNames[2] = "ShieldRim2"
    RimNames[3] = "ShieldRim3"
    RimNames[4] = "ShieldRim4"
    RimNames[5] = "ShieldRim5"
    RimNames[6] = "ShieldRim6"
    RimNames[7] = "ShieldRim7"

    If EngineAvailable Then
        WorkResult = Lightning.SetFlashMode(SceneComfort)
    End If

End Sub

Public Function Create() As Context

    Dim Index As Number
    Dim Result As Context

    If Not Prepared Then
        Return Result
    End If

    For Index = 0 To MAX_CONTEXTS - 1

        If Not ContextUsed[Index] Then

            ContextGeneration[Index] = ContextGeneration[Index] + 1

            If ContextGeneration[Index] <= 0 Or ContextGeneration[Index] > MAX_GENERATION Then
                ContextGeneration[Index] = 1
            End If

            ContextUsed[Index] = True
            PreviousClips[Index] = ""
            PreviousTimes[Index] = 0
            StateTexts[Index] = "Stored Storm"
            ChargeValues[Index].Energy = 1000
            AttackStyles[Index] = 0
            FlashOpacities[Index] = 0
            ImpactShakes[Index] = 0
            RenderVisible[Index] = False
            WeaponRenderVisible[Index] = False
            FrozenRebase[Index] = False
            HammerTrails[Index].HasPrevious = False
            EquipmentStyles[Index] = EQUIPMENT_LIGHTNING
            FireClips[Index] = ""
            FireTimes[Index] = 0
            FireWasFrozen[Index] = False
            NeonElapsed[Index] = 0
            AttackPhases[Index] = 0
            ActionIdentities[Index] = 1
            RequestedEffects[Index] = 0
            EffectiveEffects[Index] = 0
            RequestedQualities[Index] = Lightning.QUALITY_MEDIUM
            EffectiveQualities[Index] = 0
            FallbackCauses[Index] = FALLBACK_NONE
            ThunderPlayed[Index] = False
            ThunderEventCounts[Index] = 0
            FirstErrors[Index] = 0

            Call BeginAction(ChargeValues[Index])

            Call CreateHammerTrail(Index)

            If EngineAvailable And HammerTrails[Index].Particles.Handle = 0 Then
                FirstErrors[Index] = Lightning.ERROR_RENDERER
            End If

            Result.Handle = ContextGeneration[Index] * HANDLE_FACTOR + Index + 1
            Return Result

        End If

    End For

    Return Result

End Function

Private Sub CreateHammerTrail(Slot As Number)

    If Not EngineAvailable Or HammerTrails[Slot].Particles.Handle <> 0 Then
        Return
    End If

    HammerTrails[Slot] = Lightning.CreateWeaponTrail()

    If HammerTrails[Slot].Particles.Handle = 0 And FirstErrors[Slot] = 0 Then
        FirstErrors[Slot] = Lightning.ERROR_RENDERER
    End If

End Sub

Private Sub ClearHammerTrail(Slot As Number)

    Call Lightning.DestroyWeaponTrail(HammerTrails[Slot])

End Sub

Private Sub ClearEffect(Slot As Number, Index As Number)

    If Effects[Slot, Index].Slot <> 0 Then
        WorkResult = Lightning.Destroy(Effects[Slot, Index])
    End If

End Sub

Private Function OwnedEffectCount(Slot As Number) As Number

    Dim CurrentCount As Number
    Dim Index As Number

    For Index = 0 To 7

        If Effects[Slot, Index].Slot <> 0 Then
            CurrentCount = CurrentCount + 1
        End If

    End For

    Return CurrentCount

End Function

Private Function CanAdmitEffect(Slot As Number, Index As Number,
    Quality As Number) As Boolean

    RequestedEffects[Slot] = RequestedEffects[Slot] + 1
    RequestedQualities[Slot] = Max(RequestedQualities[Slot], Quality)

    If (Effects[Slot, Index].Slot = 0 And
        OwnedEffectCount(Slot) >= MAX_LIGHTNING_EFFECTS_PER_CONTEXT) Then
        FallbackCauses[Slot] = FALLBACK_CONTEXT_BUDGET
        Return False
    End If

    Return True

End Function

Public Function Destroy(ByRef Value As Context) As Boolean

    Dim Index As Number
    Dim Slot As Number

    Slot = RawSlot(Value)

    If Slot < 0 Then
        Return False
    End If

    For Index = 0 To 7
        Call ClearEffect(Slot, Index)
    End For

    Call ClearHammerTrail(Slot)
    Call ClearEquipmentFire(Slot)

    ContextUsed[Slot] = False
    RenderVisible[Slot] = False
    WeaponRenderVisible[Slot] = False
    HammerTrails[Slot].HasPrevious = False
    Value.Handle = 0

    Return True

End Function

Public Sub Shutdown()

    Dim Index As Number
    Dim Value As Context

    If Prepared Then

        For Index = 0 To MAX_CONTEXTS - 1

            If ContextUsed[Index] Then
                Value.Handle = ContextGeneration[Index] * HANDLE_FACTOR + Index + 1
                WorkResult = Destroy(Value)
            End If

        End For

    End If

    EngineAvailable = False
    Prepared = False

End Sub

Private Sub Attach(Slot As Number, Index As Number, Source As Precision3D.Vector3,
    Target As Precision3D.Vector3, Preset As Text, Width As Number, Power As Number,
    Branches As Number)

    Dim EffectQuality As Number

    EffectQuality = Lightning.QUALITY_HIGH

    If Index >= 3 Then
        EffectQuality = Lightning.QUALITY_ULTRA
    End If

    If Not CanAdmitEffect(Slot, Index, EffectQuality) Then
        Return
    End If

    If PreciseMath.Distance(Source, Target) < 1.0 Then
        Return
    End If

    If Effects[Slot, Index].Slot <> 0 Then

        If Lightning.Value(Lightning.QUERY_FINISHED, Effects[Slot, Index]) <> 0 Then

            If Index >= 3 And AttackPhases[Slot] = 2 Then
                Return
            End If

            Call ClearEffect(Slot, Index)

        End If

    End If

    If Effects[Slot, Index].Slot = 0 Then

        Effects[Slot, Index] = Lightning.StartAtPrecise(Preset, Source, Target,
            1307 + Slot * 997 + Index * 137, EffectQuality)

        If Effects[Slot, Index].Slot = 0 Then

            FirstErrors[Slot] = Lightning.Value(Lightning.QUERY_LAST_ERROR, Effects[Slot, 0])

            If FirstErrors[Slot] = Lightning.ERROR_CAPACITY Then
                FallbackCauses[Slot] = FALLBACK_SHARED_CAPACITY
            End If

            Return

        End If

        WorkResult = Lightning.SetBranchBudget(Effects[Slot, Index], Branches)
        WorkResult = Lightning.SetSparkIntensity(Effects[Slot, Index], 75) And WorkResult

    End If

    EffectiveQualities[Slot] = Max(EffectiveQualities[Slot], EffectQuality)

    WorkResult = Lightning.SetEndpointsPrecise(Effects[Slot, Index], Source, Target)
    WorkResult = Lightning.SetStyle(Effects[Slot, Index], Width, Power) And WorkResult

End Sub

Private Sub UpdateRim(Slot As Number, Actor As Character3D.Actor, Visible As Boolean,
    Optional Intensity As Number = 100)

    Dim FirstPoint As Precision3D.Vector3
    Dim Index As Number
    Dim Name As Text
    Dim Point As Precision3D.Vector3
    Dim SecondPoint As Precision3D.Vector3

    If Not Visible Then
        Call ClearEffect(Slot, 0)

        Return
    End If

    If Not CanAdmitEffect(Slot, 0, Lightning.QUALITY_MEDIUM) Then
        Return
    End If

    If Not Character3D.TrySocketPositionPrecise(Actor, "ShieldRim0", 2, False, FirstPoint) Then
        FirstErrors[Slot] = Lightning.ERROR_INVALID_POSITION
        Return
    End If

    If Not Character3D.TrySocketPositionPrecise(Actor, "ShieldRim1", 2, False, SecondPoint) Then
        FirstErrors[Slot] = Lightning.ERROR_INVALID_POSITION
        Return
    End If

    If Effects[Slot, 0].Slot = 0 Then

        Effects[Slot, 0] = Lightning.StartAtPrecise("StoredStorm", FirstPoint, SecondPoint,
            1300 + Slot * 997, Lightning.QUALITY_MEDIUM)

        If Effects[Slot, 0].Slot = 0 Then

            FirstErrors[Slot] = Lightning.Value(Lightning.QUERY_LAST_ERROR, Effects[Slot, 0])

            If FirstErrors[Slot] = Lightning.ERROR_CAPACITY Then
                FallbackCauses[Slot] = FALLBACK_SHARED_CAPACITY
            End If

            Return

        End If

        WorkResult = Lightning.SetStyle(Effects[Slot, 0], 1, 720)
        WorkResult = Lightning.SetBranchBudget(Effects[Slot, 0], 0) And WorkResult
        WorkResult = Lightning.SetPathJitter(Effects[Slot, 0], 0) And WorkResult
        WorkResult = Lightning.SetSparkIntensity(Effects[Slot, 0], 15) And WorkResult

        For Index = 2 To 7

            Name = RimNames[Index]

            If Not Character3D.TrySocketPositionPrecise(Actor, Name, 2, False, Point) Then
                FirstErrors[Slot] = Lightning.ERROR_INVALID_POSITION
                Return
            End If

            WorkResult = Lightning.AddChainTargetPrecise(Effects[Slot, 0], Point) And WorkResult
        End For

        WorkResult = Lightning.AddChainTargetPrecise(Effects[Slot, 0], FirstPoint) And WorkResult

    Else

        WorkResult = Lightning.SetEndpointsPrecise(Effects[Slot, 0], FirstPoint, SecondPoint)

        For Index = 2 To 7

            Name = RimNames[Index]

            If Not Character3D.TrySocketPositionPrecise(Actor, Name, 2, False, Point) Then
                FirstErrors[Slot] = Lightning.ERROR_INVALID_POSITION
                Return
            End If

            WorkResult = Lightning.SetChainTargetPrecise(Effects[Slot, 0], Index - 2, Point) And WorkResult
        End For

        WorkResult = Lightning.SetChainTargetPrecise(Effects[Slot, 0], 6, FirstPoint) And WorkResult

    End If

    EffectiveQualities[Slot] = Max(EffectiveQualities[Slot], Lightning.QUALITY_MEDIUM)

    WorkResult = Lightning.SetStyle(Effects[Slot, 0], 1, 720 * Intensity / 100)

    If EquipmentStyles[Slot] <> EQUIPMENT_LIGHTNING Then
        WorkResult = Lightning.SetSparkIntensity(Effects[Slot, 0], 0) And WorkResult
    End If

End Sub

Public Sub Update(Value As Context, Actor As Character3D.Actor, Clip As Text,
    Target As Precision3D.Vector3, ByRef Camera As Precision3D.Camera3D, Elapsed As Number,
    Enabled As Boolean, WeaponVisible As Boolean, ShieldVisible As Boolean,
    Paused As Boolean, MotionPaused As Boolean, Light As LightPool3D.Lease,
    Optional WeaponIntensity As Number = 100, Optional ShieldIntensity As Number = 100)

    Dim Attack As Boolean
    Dim Charge As Boolean
    Dim Duration As Number
    Dim Events As Number
    Dim Head As Precision3D.Vector3
    Dim WeaponBase As Precision3D.Vector3
    Dim WeaponTip As Precision3D.Vector3
    Dim Index As Number
    Dim LeftPoint As Precision3D.Vector3
    Dim Power As Number
    Dim Progress As Number
    Dim Release As Boolean
    Dim RightPoint As Precision3D.Vector3
    Dim Slot As Number
    Dim Time As Number

    Slot = RawSlot(Value)

    If Slot < 0 Or Not EngineAvailable Then
        Return
    End If

    Time = Character3D.AnimationTime(Actor)
    Duration = 1

    For Index = 0 To Character3D.ClipCount(Actor) - 1

        If Character3D.ClipName(Actor, Index) = Clip Then
            Duration = Max(1, Character3D.ClipDuration(Actor, Index))
        End If

    End For

    Progress = Min(1000, Time * 1000 / Duration)

    If Clip = "Death" And Progress > 600 Then
        Enabled = False
        StateTexts[Slot] = "Storm Fading"
    End If

    RenderVisible[Slot] = Enabled
    WeaponRenderVisible[Slot] = Enabled And WeaponVisible
    RequestedEffects[Slot] = 0
    EffectiveEffects[Slot] = OwnedEffectCount(Slot)
    RequestedQualities[Slot] = Lightning.QUALITY_MEDIUM
    EffectiveQualities[Slot] = 0
    FallbackCauses[Slot] = FALLBACK_NONE

    If Not Enabled Then

        For Index = 0 To 7
            Call ClearEffect(Slot, Index)
        End For

        Call ClearHammerTrail(Slot)
        Call ClearEquipmentFire(Slot)

        WorkResult = LightPool3D.Disable(Light)
        FlashOpacities[Slot] = 0
        ImpactShakes[Slot] = 0
        EffectiveEffects[Slot] = 0
        EffectiveQualities[Slot] = 0
        FrozenRebase[Slot] = Paused Or MotionPaused
        PreviousClips[Slot] = Clip
        PreviousTimes[Slot] = Time

        Return

    End If

    If Not ShieldVisible Then
        Call ClearEffect(Slot, 0)
    End If

    If Not WeaponVisible Then

        For Index = 1 To 7
            Call ClearEffect(Slot, Index)
        End For

        Call ClearHammerTrail(Slot)

        WorkResult = LightPool3D.Disable(Light)
        FlashOpacities[Slot] = 0
        ImpactShakes[Slot] = 0

    End If

    If Paused Then

        If Clip <> PreviousClips[Slot] Or Time <> PreviousTimes[Slot] Then
            ActionIdentities[Slot] = ActionIdentities[Slot] + 1
        End If

        FrozenRebase[Slot] = True
        PreviousClips[Slot] = Clip
        PreviousTimes[Slot] = Time
        HammerTrails[Slot].HasPrevious = False
        EffectiveEffects[Slot] = OwnedEffectCount(Slot)

        Return

    End If

    If FrozenRebase[Slot] Then

        FrozenRebase[Slot] = False
        PreviousClips[Slot] = Clip
        PreviousTimes[Slot] = Time
        HammerTrails[Slot].HasPrevious = False
        ThunderPlayed[Slot] = Progress >= 640
        ChargeValues[Slot].ContactApplied = Progress >= 350
        ChargeValues[Slot].ReleaseApplied = Progress >= 640

    Else If (Clip <> PreviousClips[Slot] Or
        Time < PreviousTimes[Slot] Or
        (MotionPaused And Time <> PreviousTimes[Slot])) Then

        ActionIdentities[Slot] = ActionIdentities[Slot] + 1
        HammerTrails[Slot].HasPrevious = False
        AttackPhases[Slot] = 0

        For Index = 3 To 7
            Call ClearEffect(Slot, Index)
        End For

        ThunderPlayed[Slot] = Progress >= 640
        ChargeValues[Slot].ContactApplied = Progress >= 350
        ChargeValues[Slot].ReleaseApplied = Progress >= 640

    End If

    PreviousClips[Slot] = Clip
    PreviousTimes[Slot] = Time
    Attack = Clip = "SwordAttack" Or Clip = "JumpAttack" Or Clip = "ThorAttack"
    Charge = Clip = "ThorAttack" And Progress >= 120 And Progress < 520
    Release = Attack And Progress >= 640
    Events = 0

    If Not MotionPaused Then
        Events = AdvanceCharge(ChargeValues[Slot], Progress, Clip = "ThorAttack", Attack)
    End If

    Power = 150 + ChargeValues[Slot].Energy * 500 / 1000
    StateTexts[Slot] = "Stored Storm"
    FlashOpacities[Slot] = Max(0, FlashOpacities[Slot] - Elapsed)
    ImpactShakes[Slot] = Max(0, ImpactShakes[Slot] - Elapsed)

    If Charge Then
        Power = Min(1000, 650 + Progress / 2)
        StateTexts[Slot] = "Sky Charge"
    Else If Release Then
        Power = 1000
        StateTexts[Slot] = "Lightning Discharge"
    End If

    NeonElapsed[Slot] = (NeonElapsed[Slot] + Max(0, Min(100, Elapsed))) Mod 104000

    If Charge Or Release Then

        Call ClearEffect(Slot, 0)
        Call ClearEffect(Slot, 2)

        If EquipmentStyles[Slot] = EQUIPMENT_NEON_ARCS And AttackPhases[Slot] = 0 Then
            Call ClearEffect(Slot, 1)
            Call ClearEffect(Slot, 7)
        End If

    Else If EquipmentStyles[Slot] <> EQUIPMENT_NEON_ARCS Then

        Call UpdateRim(Slot, Actor, ShieldVisible And ShieldIntensity > 0, ShieldIntensity)

    End If

    If (EquipmentStyles[Slot] = EQUIPMENT_BLUE_FLAME And
        Not Charge And
        Not Release) Then
        Call ClearEffect(Slot, 1)
        Call ClearEffect(Slot, 2)
    End If

    If Not Character3D.TrySocketPositionPrecise(Actor, "HammerHead", 1, False, Head) Then
        FirstErrors[Slot] = Lightning.ERROR_INVALID_POSITION
        Return
    End If

    If Not Character3D.TrySocketPositionPrecise(Actor, "HammerLeft", 1, False, LeftPoint) Then
        FirstErrors[Slot] = Lightning.ERROR_INVALID_POSITION
        Return
    End If

    If Not Character3D.TrySocketPositionPrecise(Actor, "HammerRight", 1, False, RightPoint) Then
        FirstErrors[Slot] = Lightning.ERROR_INVALID_POSITION
        Return
    End If

    If (WeaponVisible And
        WeaponIntensity > 0 And
        EquipmentStyles[Slot] = EQUIPMENT_LIGHTNING) Then

        WorkResult = Character3D.TrySocketPositionPrecise(Actor, "SwordBase", 1, False, WeaponBase)
        WorkResult = Character3D.TrySocketPositionPrecise(Actor, "SwordTip", 1, False, WeaponTip) And WorkResult

        If Not WorkResult Then
            FirstErrors[Slot] = Lightning.ERROR_INVALID_POSITION
            Return
        End If

        Call CreateHammerTrail(Slot)

        WorkResult = Lightning.UpdateWeaponTrail(HammerTrails[Slot], WeaponBase,
            WeaponTip, Elapsed, MotionPaused, False, WeaponIntensity)

        If Not WorkResult And FirstErrors[Slot] = 0 Then
            FirstErrors[Slot] = Lightning.ERROR_RENDERER
        End If

    End If

    If (WeaponVisible And
        WeaponIntensity > 0 And
        (EquipmentStyles[Slot] = EQUIPMENT_LIGHTNING Or Charge)) Then

        Call Attach(Slot, 1, LeftPoint, RightPoint, "StoredStorm", 1, Power * WeaponIntensity / 100, 2)

        If Not Charge And Not Release Then

            LeftPoint.Y = LeftPoint.Y + 3.0
            RightPoint.Y = RightPoint.Y + 3.0

            Call Attach(Slot, 2, RightPoint, LeftPoint, "StoredStorm", 1, Power * WeaponIntensity / 100, 1)

        End If

    Else If Not WeaponVisible Then

        For Index = 1 To 7
            Call ClearEffect(Slot, Index)
        End For

    End If

    If WeaponIntensity <= 0 Then

        Call ClearHammerTrail(Slot)
        Call ClearEffect(Slot, 1)
        Call ClearEffect(Slot, 2)

    End If

    Call UpdateBattleEffects(Slot, Head, Target, Charge And WeaponVisible,
        Release And WeaponVisible)

    If (EquipmentStyles[Slot] = EQUIPMENT_NEON_ARCS And
        Not Charge And
        Not Release) Then
        Call UpdateNeonContours(Slot, Actor, WeaponVisible, ShieldVisible,
            WeaponIntensity, ShieldIntensity, NeonElapsed[Slot])
    End If

    If (Release And
        WeaponVisible And
        Not MotionPaused And
        Events >= 2 And
        Not ThunderPlayed[Slot]) Then

        ThunderPlayed[Slot] = True
        ThunderEventCounts[Slot] = ThunderEventCounts[Slot] + 1
        FlashOpacities[Slot] = 180

        If Clip = "ThorAttack" Or Clip = "JumpAttack" Then
            ImpactShakes[Slot] = 260
        End If

        Play Sound "Assets/Lightning/thunder.wav"

    End If

    If Effects[Slot, 1].Slot <> 0 And EquipmentStyles[Slot] = EQUIPMENT_LIGHTNING Then

        WorkResult = Lightning.SetCharge(Effects[Slot, 1], ChargeValues[Slot].Energy)
        WorkResult = Lightning.SetStyle(Effects[Slot, 1], 1,
            (520 + ChargeValues[Slot].Energy * 480 / 1000) * WeaponIntensity / 100)
        WorkResult = Lightning.SetSparkIntensity(Effects[Slot, 1], WeaponIntensity)

    End If

    If SceneComfort <> SCENE_COMFORT_OFF And ImpactShakes[Slot] > 0 Then
        ''' A short decaying impact only, never the continuous camera or ordinary slash.
        Camera.Position.X = Camera.Position.X + ToDouble(Fixed.SinFixed(ImpactShakes[Slot] * 4) * ImpactShakes[Slot]) / ToDouble(Core.FIXED_ONE * SceneComfort * 50)
        Camera.Position.Y = Max(24.0, Camera.Position.Y + ToDouble(Fixed.SinFixed(ImpactShakes[Slot] * 5) * ImpactShakes[Slot]) / ToDouble(Core.FIXED_ONE * SceneComfort * 85))
    End If

    If WeaponVisible And WeaponIntensity > 0 Then
        WorkResult = LightPool3D.SetPointPrecise(Light, Head,
            150, 190, 255, Power * WeaponIntensity / 500, 130)
    Else
        WorkResult = LightPool3D.Disable(Light)
    End If

    EffectiveEffects[Slot] = OwnedEffectCount(Slot)

    If (HammerTrails[Slot].Particles.Handle <> 0 And
        HammerTrails[Slot].Particles.RequestedSimulation <> HammerTrails[Slot].Particles.EffectiveSimulation And
        FallbackCauses[Slot] = FALLBACK_NONE) Then
        FallbackCauses[Slot] = FALLBACK_PARTICLE_BACKEND
    End If

End Sub

Private Sub ClearEquipmentFire(Slot As Number)

    Dim Index As Number

    For Index = 0 To 1

        If EquipmentFires[Slot, Index].Slot <> 0 Then
            WorkResult = Fire.Destroy(EquipmentFires[Slot, Index])
        End If

    End For

End Sub

Public Sub SetEquipmentStyle(Value As Context, Style As Number)

    Dim Slot As Number
    Dim Index As Number

    Slot = RawSlot(Value)

    If (Slot < 0 Or
        Style < EQUIPMENT_LIGHTNING Or
        Style > EQUIPMENT_NEON_ARCS) Then
        Return
    End If

    If EquipmentStyles[Slot] = Style Then
        Return
    End If

    Call ClearHammerTrail(Slot)
    Call ClearEquipmentFire(Slot)

    For Index = 0 To 2
        Call ClearEffect(Slot, Index)
    End For

    If EquipmentStyles[Slot] = EQUIPMENT_NEON_ARCS And AttackPhases[Slot] = 0 Then
        Call ClearEffect(Slot, 7)
    End If

    EquipmentStyles[Slot] = Style
    FireWasFrozen[Slot] = True

End Sub

Public Function EquipmentStyle(Value As Context) As Number

    Dim Slot As Number
    Dim Result As Number

    Slot = RawSlot(Value)

    If Slot >= 0 Then
        Result = EquipmentStyles[Slot]
    End If

    Return Result

End Function

Private Function ReadEquipmentContour(Actor As Character3D.Actor, Prefix As Text,
    Part As Number, ByRef Contour As Precision3D.Contour3D) As Boolean

    Dim Index As Number
    Dim Name As Text
    Dim Ok As Boolean

    If Prefix = "WeaponRim" Then
        Ok = Character3D.TrySocketContourPrecise(Actor, "SwordBase", Part,
            EquipmentAsset.WeaponOutline(), Contour)

        Return Ok
    End If

    Contour.PointCount = 8
    Ok = True

    For Index = 0 To 7
        Name = Prefix + Text_Slice("01234567", Index, 1)
        Ok = Character3D.TrySocketPositionPrecise(Actor, Name, Part, False, Contour.Points[Index]) And Ok
    End For

    Return Ok

End Function

''' Attachment and lifetime ownership only; the scene advances the shared Fire family once.
Public Sub UpdateEquipmentFire(Value As Context, Actor As Character3D.Actor,
    Clip As Text, Enabled As Boolean, WeaponVisible As Boolean,
    ShieldVisible As Boolean, FirePaused As Boolean, MotionPaused As Boolean,
    Optional WeaponIntensity As Number = 100, Optional ShieldIntensity As Number = 100)

    Dim Slot As Number
    Dim Index As Number
    Dim Time As Number
    Dim Inheritance As Number
    Dim Contour As Precision3D.Contour3D
    Dim Radius As Number
    Dim Intensity As Number
    Dim Prefix As Text
    Dim Ok As Boolean
    Dim Visible As Boolean

    Slot = RawSlot(Value)

    If Slot < 0 Then
        Return
    End If

    If Not Enabled Or EquipmentStyles[Slot] <> EQUIPMENT_BLUE_FLAME Then
        Call ClearEquipmentFire(Slot)

        Return
    End If

    Time = Character3D.AnimationTime(Actor)
    Inheritance = 10

    If (MotionPaused Or
        FireWasFrozen[Slot] Or
        Clip <> FireClips[Slot] Or
        Time < FireTimes[Slot]) Then
        Inheritance = 0
    End If

    Ok = True

    For Index = 0 To 1

        Prefix = "WeaponRim"
        Visible = WeaponVisible And WeaponIntensity > 0
        Intensity = WeaponIntensity * 2
        Radius = 3

        If Index = 1 Then

            Prefix = "ShieldRim"
            Visible = ShieldVisible And ShieldIntensity > 0
            Intensity = 21 * ShieldIntensity / 100

        End If

        If Not Visible Then

            If EquipmentFires[Slot, Index].Slot <> 0 Then
                WorkResult = Fire.Destroy(EquipmentFires[Slot, Index])
            End If

        Else If Not FirePaused Then

            Ok = ReadEquipmentContour(Actor, Prefix, Index + 1, Contour) And Ok

            If Not Ok Then
                FirstErrors[Slot] = Fire.ERROR_SOURCE
                Return
            End If

            If Index = 0 Then
                Radius = Max(2, ToNumber(Ceiling(Precision3D.ContourLength(Contour) / 40.0)))
            End If

            If EquipmentFires[Slot, Index].Slot = 0 Then
                EquipmentFires[Slot, Index] = Fire.StartAtPrecise("LineFire", Contour.Points[0],
                    1307 + Slot * 997 + Index, Fire.QUALITY_HIGH, Fire.SIMULATION_AUTO, Radius)
            End If

            Ok = Fire.SetContourPrecise(EquipmentFires[Slot, Index], Contour) And Ok
            Ok = Fire.SetPalette(EquipmentFires[Slot, Index], Fire.PALETTE_BLUE_WHITE) And Ok

            Call Fire.SetIntensity(EquipmentFires[Slot, Index], Intensity)
            Call Fire.SetSourceVelocityInheritance(EquipmentFires[Slot, Index], Inheritance)

        End If

        Inheritance = 0
    End For

    If Not Ok Then
        FirstErrors[Slot] = Fire.Value(12, EquipmentFires[Slot, 0])
    End If

    FireWasFrozen[Slot] = FirePaused
    FireClips[Slot] = Clip
    FireTimes[Slot] = Time

End Sub

Private Sub UpdateContourEffect(Slot As Number, Index As Number,
    Contour As Precision3D.Contour3D, Travelling As Boolean, Elapsed As Number,
    Width As Number, Power As Number)

    If Not CanAdmitEffect(Slot, Index, Lightning.QUALITY_HIGH) Then
        Return
    End If

    If Effects[Slot, Index].Slot = 0 Then
        Effects[Slot, Index] = Lightning.StartAtPrecise("StoredStorm", Contour.Points[0],
            Contour.Points[1], 1307 + Slot * 997 + Index, Lightning.QUALITY_HIGH)
    End If

    If Travelling Then
        WorkResult = Lightning.SetTravellingEdgePrecise(Effects[Slot, Index], Contour, Elapsed, Power)
    Else
        WorkResult = Lightning.SetContourPrecise(Effects[Slot, Index], Contour, Width, Power)
    End If

    If Not WorkResult Then
        FirstErrors[Slot] = Lightning.Value(Lightning.QUERY_LAST_ERROR, Effects[Slot, Index])
    End If

End Sub

Private Sub UpdateNeonContours(Slot As Number, Actor As Character3D.Actor,
    WeaponVisible As Boolean, ShieldVisible As Boolean, WeaponIntensity As Number,
    ShieldIntensity As Number, Elapsed As Number)

    Dim Contour As Precision3D.Contour3D
    Dim Ok As Boolean

    If ShieldVisible And ShieldIntensity > 0 Then

        Ok = ReadEquipmentContour(Actor, "ShieldRim", 2, Contour)

        If Ok Then
            Call UpdateContourEffect(Slot, 0, Contour, False, Elapsed, Max(1, 2 * ShieldIntensity / 100), 900 * ShieldIntensity / 100)
            Call UpdateContourEffect(Slot, 7, Contour, True, Elapsed + 300, 1, 1000 * ShieldIntensity / 100)
        Else
            FirstErrors[Slot] = Lightning.ERROR_INVALID_POSITION
        End If

    Else

        Call ClearEffect(Slot, 0)
        Call ClearEffect(Slot, 7)

    End If

    If WeaponVisible And WeaponIntensity > 0 Then

        Ok = ReadEquipmentContour(Actor, "WeaponRim", 1, Contour)

        If Ok Then
            Call UpdateContourEffect(Slot, 2, Contour, False, Elapsed, Max(1, 2 * WeaponIntensity / 100), 900 * WeaponIntensity / 100)
            Call UpdateContourEffect(Slot, 1, Contour, True, Elapsed, 1, 1000 * WeaponIntensity / 100)
        Else
            FirstErrors[Slot] = Lightning.ERROR_INVALID_POSITION
        End If

    Else

        Call ClearEffect(Slot, 1)
        Call ClearEffect(Slot, 2)

    End If

End Sub

Private Sub UpdateBattleEffects(Slot As Number, Head As Precision3D.Vector3,
    Target As Precision3D.Vector3, Charging As Boolean, Releasing As Boolean)

    Dim Angle As Number
    Dim EndPoint As Precision3D.Vector3
    Dim Index As Number
    Dim NextPhase As Number
    Dim Opposite As Precision3D.Vector3
    Dim Sky As Precision3D.Vector3

    If Charging Then
        NextPhase = 1
    Else If Releasing Then
        NextPhase = 2
    End If

    If NextPhase <> AttackPhases[Slot] Then

        For Index = 3 To 7
            Call ClearEffect(Slot, Index)
        End For

        ''' Discharge at the enemy's feet, latched once so a released strike cannot chase.
        ImpactGrounds[Slot] = Target
        ImpactGrounds[Slot].Y = 3.0
        AttackPhases[Slot] = NextPhase

    End If

    If Charging Then

        StateTexts[Slot] = "Forked Judgment"

        For Index = 3 To 6

            Angle = (Index - 3) * 90
            Sky = Head
            Sky.X = Sky.X + ToDouble(Fixed.SinFixed(Angle) * 220 / Core.FIXED_ONE)
            Sky.Y = Sky.Y + 400.0
            Sky.Z = Sky.Z + ToDouble(Fixed.CosFixed(Angle) * 220 / Core.FIXED_ONE)

            Call Attach(Slot, Index, Sky, Head, "SkyStrike", 3, 1000, 24)
        End For

    Else If Releasing Then

        StateTexts[Slot] = StyleNameFromSlot(Slot)

        For Index = 3 To 6

            Angle = (Index - 3) * 45
            EndPoint = ImpactGrounds[Slot]
            EndPoint.X = EndPoint.X + ToDouble(Fixed.SinFixed(Angle) * 250 / Core.FIXED_ONE)
            EndPoint.Z = EndPoint.Z + ToDouble(Fixed.CosFixed(Angle) * 250 / Core.FIXED_ONE)
            Opposite = ImpactGrounds[Slot]
            Opposite.X = Opposite.X - ToDouble(Fixed.SinFixed(Angle) * 250 / Core.FIXED_ONE)
            Opposite.Z = Opposite.Z - ToDouble(Fixed.CosFixed(Angle) * 250 / Core.FIXED_ONE)

            If AttackStyles[Slot] = 1 Then

                Call Attach(Slot, Index, Head, Target, "WeaponCorona", 2, 1000, 6)

            Else If AttackStyles[Slot] = 2 Then

                Call Attach(Slot, Index, Head, EndPoint, "ChainTempest", 2, 1000, 10)

            Else If AttackStyles[Slot] = 3 Then

                Sky = Target
                Sky.Y = Sky.Y + 400.0
                Sky.X = Sky.X + ToDouble((Index - 4) * 80)

                Call Attach(Slot, Index, Sky, EndPoint, "SkyStrike", 3, 1000, 24)

            Else

                Call Attach(Slot, Index, ImpactGrounds[Slot], EndPoint,
                    "ThunderGroundSlam", 3, 1000, 18)

                If Effects[Slot, Index].Slot <> 0 Then

                    If Lightning.Value(Lightning.QUERY_CHAIN_TARGETS,
                        Effects[Slot, Index]) = 0 Then
                        WorkResult = Lightning.AddChainTargetPrecise(Effects[Slot, Index],
                            ImpactGrounds[Slot])
                        WorkResult = Lightning.AddChainTargetPrecise(Effects[Slot, Index],
                            Opposite) And WorkResult
                    End If

                End If

            End If

        End For

        Call Attach(Slot, 7, Head, Target, "StoredStorm", 2, 1000, 8)

    End If

End Sub

Public Sub DrawFlash(Value As Context)

    Dim Slot As Number

    Slot = RawSlot(Value)

    If Slot < 0 Then
        Return
    End If

    If (EngineAvailable And
        RenderVisible[Slot] And
        SceneComfort <> SCENE_COMFORT_OFF And
        FlashOpacities[Slot] > 0) Then
        Fill Rectangle 0, 0, Window_Width(), Window_Height(), Rgb(155, 195, 255) Opacity FlashOpacities[Slot] / (SceneComfort * 18)
    End If

End Sub

Public Sub CycleStyle(Value As Context)

    Dim Index As Number
    Dim Slot As Number

    Slot = RawSlot(Value)

    If Slot < 0 Then
        Return
    End If

    AttackStyles[Slot] = (AttackStyles[Slot] + 1) Mod 4

    For Index = 3 To 7
        Call ClearEffect(Slot, Index)
    End For

End Sub

Public Sub SetStyle(Value As Context, Style As Number)

    Dim Slot As Number

    Slot = RawSlot(Value)

    If Slot >= 0 Then
        AttackStyles[Slot] = Max(0, Min(3, Style))
    End If

End Sub

Private Function StyleNameFromSlot(Slot As Number) As Text

    If AttackStyles[Slot] = 1 Then
        Return "Storm Lance"
    Else If AttackStyles[Slot] = 2 Then
        Return "Chain Arcs"
    Else If AttackStyles[Slot] = 3 Then
        Return "Godstorm"
    End If

    Return "Thunder Smash"

End Function

Public Function StyleName(Value As Context) As Text

    Dim ReturnValue As Text

    Dim Slot As Number

    Slot = RawSlot(Value)

    If Slot < 0 Then
        Return "Unavailable"
    End If

    ReturnValue = StyleNameFromSlot(Slot)

    Return ReturnValue

End Function

Public Sub SetSceneComfort(Value As Number)

    Dim Index As Number

    SceneComfort = Max(SCENE_COMFORT_FULL, Min(SCENE_COMFORT_OFF, Value))

    If EngineAvailable Then
        WorkResult = Lightning.SetFlashMode(SceneComfort)
    End If

    For Index = 0 To MAX_CONTEXTS - 1
        FlashOpacities[Index] = 0
        ImpactShakes[Index] = 0
    End For

End Sub

Public Sub CycleSceneComfort()

    Call SetSceneComfort(SceneComfort Mod SCENE_COMFORT_OFF + 1)

End Sub

Public Function SceneComfortValue() As Number

    Return SceneComfort

End Function

Public Function SceneComfortName() As Text

    If SceneComfort = SCENE_COMFORT_FULL Then
        Return "Flash/Shake Full"
    Else If SceneComfort = SCENE_COMFORT_REDUCED Then
        Return "Flash/Shake Reduced"
    End If

    Return "Flash/Shake Off"

End Function

Public Function StoredCharge(Value As Context) As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    Slot = RawSlot(Value)

    If Slot < 0 Then
        Return 0
    End If

    ReturnValue = ChargeValues[Slot].Energy

    Return ReturnValue

End Function

Public Sub Draw(Value As Context)

    Dim Slot As Number
    Dim Index As Number

    Slot = RawSlot(Value)

    If Slot < 0 Then
        Return
    End If

    For Index = 0 To 1

        If EquipmentFires[Slot, Index].Slot <> 0 Then
            WorkResult = Fire.Draw(EquipmentFires[Slot, Index])
        End If

    End For

    If (EngineAvailable And
        RenderVisible[Slot] And
        WeaponRenderVisible[Slot]) Then

        If HammerTrails[Slot].Particles.Handle <> 0 Then
            WorkResult = Graphics3D.DrawGpuParticleSystem3D(HammerTrails[Slot].Particles)
        End If

    End If

End Sub

Public Function Caption(Value As Context) As Text

    Dim ReturnValue As Text

    Dim Slot As Number

    Slot = RawSlot(Value)

    If Slot < 0 Then
        Return "Storm unavailable"
    End If

    ReturnValue = StateTexts[Slot]

    Return ReturnValue

End Function

Public Function LastError(Value As Context) As Number

    Dim ReturnValue2 As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    Slot = RawSlot(Value)

    If Slot < 0 Then
        ReturnValue2 = Lightning.ERROR_INVALID_EFFECT

        Return ReturnValue2
    End If

    ReturnValue = FirstErrors[Slot]

    Return ReturnValue

End Function

Public Function ActionIdentity(Value As Context) As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    Slot = RawSlot(Value)

    If Slot < 0 Then
        Return 0
    End If

    ReturnValue = ActionIdentities[Slot]

    Return ReturnValue

End Function

Public Function RequestedEffectCount(Value As Context) As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    Slot = RawSlot(Value)

    If Slot < 0 Then
        Return 0
    End If

    ReturnValue = RequestedEffects[Slot]

    Return ReturnValue

End Function

Public Function EffectiveEffectCount(Value As Context) As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    Slot = RawSlot(Value)

    If Slot < 0 Then
        Return 0
    End If

    ReturnValue = OwnedEffectCount(Slot)

    Return ReturnValue

End Function

Public Function TrailParticleCount(Value As Context) As Number

    Dim ReturnValue As Number
    Dim Slot As Number

    Slot = RawSlot(Value)

    If Slot < 0 Then
        Return 0
    End If

    If HammerTrails[Slot].Particles.Handle = 0 Then
        Return 0
    End If

    ReturnValue = Graphics3D.GpuParticleValue3D(
        Graphics3D.GPU_PARTICLE_QUERY_RESOURCE_ACTIVE,
        HammerTrails[Slot].Particles.Handle
    )

    Return ReturnValue

End Function

Public Function TrailRequestedSimulation(Value As Context) As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    Slot = RawSlot(Value)

    If Slot < 0 Then
        Return 0
    End If

    ReturnValue = HammerTrails[Slot].Particles.RequestedSimulation

    Return ReturnValue

End Function

Public Function TrailEffectiveSimulation(Value As Context) As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    Slot = RawSlot(Value)

    If Slot < 0 Then
        Return 0
    End If

    ReturnValue = HammerTrails[Slot].Particles.EffectiveSimulation

    Return ReturnValue

End Function

Public Function ThunderEventCount(Value As Context) As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    Slot = RawSlot(Value)

    If Slot < 0 Then
        Return 0
    End If

    ReturnValue = ThunderEventCounts[Slot]

    Return ReturnValue

End Function

Public Function RenderVisibility(Value As Context) As Number

    Dim Slot As Number

    Slot = RawSlot(Value)

    If Slot < 0 Then
        Return 0
    End If

    If Not RenderVisible[Slot] Then
        Return 0
    End If

    If Not WeaponRenderVisible[Slot] Then
        Return 1
    End If

    Return 2

End Function

Public Function RequestedQuality(Value As Context) As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    Slot = RawSlot(Value)

    If Slot < 0 Then
        Return 0
    End If

    ReturnValue = RequestedQualities[Slot]

    Return ReturnValue

End Function

Public Function EffectiveQuality(Value As Context) As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    Slot = RawSlot(Value)

    If Slot < 0 Then
        Return 0
    End If

    ReturnValue = EffectiveQualities[Slot]

    Return ReturnValue

End Function

Public Function FallbackCause(Value As Context) As Number

    Dim ReturnValue As Number

    Dim Slot As Number

    Slot = RawSlot(Value)

    If Slot < 0 Then
        Return FALLBACK_SHARED_CAPACITY
    End If

    ReturnValue = FallbackCauses[Slot]

    Return ReturnValue

End Function

End Module
