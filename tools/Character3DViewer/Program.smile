''' Reusable SM3D character inspection project. Arin and Orin share the editor and party arena.

Option Explicit

Import Smile.Simple3D.Character3D As Character3D
Import Smile.Simple3D.CharacterViewer As CharacterViewer
Import Smile.Simple3D.Core As Core
Import Smile.Simple3D.Graphics3D As Graphics3D
Import Smile.Simple3D.Scene3D As Scene3D
Import Smile.Tools.Character3DViewerProfiles As ViewerProfiles
Import Smile.Tools.BattleCamera As BattleCamera
Import Smile.Tools.Character3DViewerTiming As ViewerTiming
Import Smile.Tools.Character3DViewerSession As ViewerSession
Import Smile.Tools.Character3DViewerPlayback As ViewerPlayback
Import Smile.Tools.Character3DViewerActors As ViewerActors
Import Smile.Tools.Character3DViewerCamera As ViewerCamera
Import Smile.Tools.Character3DViewerCalibration As ViewerCalibration
Import Smile.Tools.Character3DViewerCalibrationEditing As ViewerCalibrationEditing
Import Smile.Tools.Character3DViewerCalibrationControls As ViewerCalibrationControls
Import Smile.Tools.Character3DViewerInput As ViewerInput
Import Smile.Tools.Character3DViewerInspectorCommands As ViewerInspectorCommands
Import Smile.Tools.Character3DViewerInspectorPresentation As ViewerInspectorPresentation
Import Smile.Tools.Character3DViewerTimelineEditing As ViewerTimelineEditing
Import Smile.Tools.Character3DViewerUi As ViewerUi
Import Smile.Tools.Character3DViewerGizmo As ViewerGizmo
Import Smile.Tools.Character3DViewerParty As ViewerParty
Import Smile.Tools.Character3DViewerEffects As ViewerEffects
Import Smile.Tools.Character3DViewerDragon As ViewerDragon
Import Smile.Tools.Character3DViewerRendering As ViewerRendering

Const ANIMATION_CYCLE_MILLISECONDS = 5000
Const ORBIT_POINTER_DIVISOR = 1
Const PAN_POINTER_DIVISOR = 3
Const DEFAULT_ZOOM_DEGREES = -16
Const ZOOM_IN_LIMIT = -144
Const CLOSE_UP_ZOOM_START = -48
Const CLOSE_UP_MINIMUM_DISTANCE_1000 = 100
Const ZOOM_OUT_LIMIT = 36
Const MAX_RAW_FRAME_MILLISECONDS = 60000
Const MAX_ANIMATION_ELAPSED = 250
Const MAX_CAMERA_ELAPSED = 250
Const FRAME_BUTTON_REPEAT_MILLISECONDS = 300
Const SHIELD_PART_INDEX = 0
Const WEAPON_PART_INDEX = 1
Const BODY_PART_INDEX = 2
Const CHARACTER_MODEL_FORWARD_YAW_OFFSET = 180
Const ORIN_ARENA_YAW_ADJUSTMENT = -55
Const ARENA_INITIAL_ORBIT_YAW = 0
Const ARENA_ORBIT_DEGREES_PER_SECOND = 12
Const ARENA_CAMERA_DISTANCE = 480
Const ARENA_CAMERA_HEIGHT = 180
Const ARENA_CAMERA_CENTER_X = -70
Const ARENA_CAMERA_CENTER_Z = -45
Const ARENA_DEFAULT_ZOOM_DEGREES = -15
Const ARENA_FLOOR_WIDTH = 1000
Const ARENA_FLOOR_DEPTH = 1000
Const CALIBRATION_MAX_CLIPS = ViewerCalibration.MAX_CLIPS
Const BACKGROUND_COUNT = 5
Const BACKDROP_LANDSCAPE_PATH = "Assets\Backgrounds\SinStarLandscape.png"
Const BACKDROP_TITLE_PATH = "Assets\Backgrounds\SinStarTitleWithLogo.png"
Const PARTY_FORMATION_RADIUS = 300
Const PARTY_FORMATION_START_ANGLE = 10
Const PARTY_FORMATION_END_ANGLE = 50
Dim Party As ViewerParty.State
Dim Character As Character3D.Actor
Dim CharacterBounds As Character3D.Bounds3D
Dim ActiveProfile As CharacterViewer.Profile
Dim Rendering As ViewerRendering.State
Dim Effects As ViewerEffects.State
Dim DragonState As ViewerDragon.State
Dim Key As Number
Dim FrameRate As ViewerTiming.FrameRateState
Dim Timing As ViewerTiming.ClockState
Dim Session As ViewerSession.State
Dim Playback As ViewerPlayback.State
Dim ViewerCameraState As ViewerCamera.State
Dim Calibration As ViewerCalibration.State
Dim ViewerInputState As ViewerInput.State
Dim ViewerUiState As ViewerUi.State
Dim ViewerGizmoState As ViewerGizmo.State
Dim Equipment As ViewerActors.EquipmentVisibility
Dim CalibrationAvailable As Boolean
Dim SwordWristNode As Number
Dim ShieldWristNode As Number

Game Window "SMILE 2.0 - 3D Viewer, Animation Editor" Size 1600 By 640

Call Graphics3D.ResetRenderer3D()

Call ViewerSession.SelectCharacterTab(Session, 3)
Call ViewerParty.SetEnabled(Party, True)

Call ViewerPlayback.Reset(Playback, 100)
Call ViewerInput.Reset(ViewerInputState)
Call ViewerUi.Reset(ViewerUiState)
Call ViewerGizmo.Reset(ViewerGizmoState)
Call ViewerRendering.Reset(Rendering, 3)

Call LoadViewer()
Call ViewerSession.CaptureFailure(Session, 20)

Call ViewerSession.Start(Session)

Call ViewerTiming.Start(Timing, Timer())

Do

    Get Key Key

    Call HandleKeyboard(Key)

    Call ViewerSession.CaptureFailure(Session, 21)

    ViewerInputState.InterfaceBlocked = HandleInterfacePointer()

    Call ViewerSession.CaptureFailure(Session, 22)

    Call UpdateCameraPointer(ViewerInputState.InterfaceBlocked)

    Call ViewerSession.CaptureFailure(Session, 23)

    Session.Ready = ViewerTiming.AdvanceClock(
        Timing,
        Timer(),
        MAX_ANIMATION_ELAPSED,
        MAX_CAMERA_ELAPSED,
        MAX_RAW_FRAME_MILLISECONDS
    ) And Session.Ready

    Call ViewerSession.CaptureFailure(Session, 24)

    Call ViewerTiming.Advance(FrameRate, Timing.RawFrameMilliseconds)

    If Not Session.ViewerError Then

        If Not Playback.ScenePaused Then
            Call AdvanceAnimationSequence()

            Call ViewerSession.CaptureFailure(Session, 2)
        End If

        Call ViewerPlayback.ResolveAnimationElapsed(Playback, Timing.AnimationElapsed)

        If Party.Enabled Then
            Call AdvancePartyDemo()
        End If

        Session.Ready = Character3D.Update(Character, Playback.AnimationUpdateElapsed) And Session.Ready

        Call ViewerSession.CaptureFailure(Session, 3)

        Session.Ready = ViewerActors.ApplyPresentationOffset(
            Character,
            Session.ProfileIndex,
            Playback.SelectedClip,
            ViewerCameraState.Frame
        ) And Session.Ready

        If CalibrationAvailable Then

            Call UpdateCalibrationForCurrentFrame()
            Call ApplyWristCalibration()
            Call ApplyEquipmentCoupling()
            Call ViewerSession.CaptureFailure(Session, 4)

        End If

        Session.Ready = ViewerCamera.AdvanceZoom(
            ViewerCameraState, Timing.CameraElapsed) And Session.Ready

        Call ViewerSession.CaptureFailure(Session, 5)

        If Not Playback.ScenePaused Then
            Session.Ready = ViewerCamera.AdvanceAutoOrbit(
                ViewerCameraState,
                Party.OrbitPhase1000,
                Timing.CameraElapsed,
                ARENA_ORBIT_DEGREES_PER_SECOND,
                Party.Enabled
            ) And Session.Ready

            Call ViewerSession.CaptureFailure(Session, 6)
        End If

        Call ViewerCamera.UpdateResponsiveFit(
            ViewerCameraState,
            ActiveProfile,
            Window_Width(),
            Window_Height(),
            Max(1, Window_Width() - 284),
            DragonState.Available,
            ARENA_CAMERA_CENTER_X,
            ARENA_CAMERA_CENTER_Z,
            ARENA_CAMERA_DISTANCE,
            ARENA_CAMERA_HEIGHT
        )

        Call ViewerCamera.Compose(
            ViewerCameraState, Party.Enabled And ViewerCameraState.AutoOrbit)

        Call ViewerCamera.ApplyCloseUp(ViewerCameraState, CLOSE_UP_ZOOM_START,
            ZOOM_IN_LIMIT, CLOSE_UP_MINIMUM_DISTANCE_1000)
        Call ViewerCamera.ApplyCalibrationOrbitAnchor(
            ViewerCameraState, Window_Width(), Window_Height())

        If Effects.EpicGlowVisible Then

            If Not ViewerEffects.UpdateEpicGlow(
                Effects,
                Character,
                Session.ProfileIndex,
                ViewerCameraState.Frame.ScalePercent,
                Playback.AnimationUpdateElapsed,
                ViewerPlayback.SelectedClipName(Character, Playback),
                Equipment.SwordVisible,
                Equipment.ShieldVisible,
                ViewerCalibration.ChannelValue(
                    Calibration, Playback.SelectedClip, 18) <> 0,
                ViewerCalibration.ChannelValue(
                    Calibration, Playback.SelectedClip, 19) <> 0
            ) Then
                Effects.EpicGlowVisible = False
            End If

        End If

        If CalibrationAvailable Then
            Call ApplyEquipmentCalibration()

            Call ViewerSession.CaptureFailure(Session, 7)
        End If

        Call ViewerEffects.UpdateEquipmentFire(
            Effects,
            Character,
            Session.ProfileIndex,
            Party.Enabled And
                ViewerParty.PresentationState(Party, 0) = ViewerParty.STATE_KO,
            Equipment.SwordVisible,
            Equipment.ShieldVisible,
            ViewerUiState.CalibrationEditing,
            Playback.ScenePaused,
            Playback.SelectedClip,
            ViewerPlayback.SelectedClipLabel(
                Character, Playback, Session.ProfileIndex),
            ViewerCameraState.Live,
            Timing.CameraElapsed
        )

        If Party.Enabled Or Session.DragonInspection Then
            Call UpdatePartyCompanion()
        End If

        If Session.DragonInspection Then
            Call UpdateDragonOpponent()
        End If

        Call UpdateDragon()
        Call ViewerParty.ApplyAttackCamera(
            Party,
            ViewerCameraState.Live,
            ViewerCameraState.Frame,
            DragonState.Actor,
            DragonState.Available,
            DragonState.Visible,
            ViewerCameraState.AutoOrbit,
            Playback.PlaybackSpeed,
            Timing.CameraElapsed,
            ViewerParty.AttackDuration(
                Party,
                Character,
                Party.Companion.Actor,
                Playback.PlaybackSpeed
            ),
            ViewerDragon.PositionX(),
            ViewerDragon.PositionZ()
        )

        If Rendering.FloorVisible Then
            Call ViewerCamera.KeepAboveGround(ViewerCameraState, 0)
        End If

        Call UpdateBattleAudio()
        Call UpdateOrinStorm()

        Session.Ready = ViewerEffects.AdvanceScene(
            Effects,
            Timing.CameraElapsed,
            Playback.ScenePaused,
            ViewerCameraState.Live
        ) And Session.Ready

        If Rendering.SocketGizmosVisible Then
            Session.Ready = ViewerRendering.UpdateSocketGizmos(
                Rendering,
                Character,
                ViewerProfiles.IsPartyCharacter(Session.ProfileIndex),
                BODY_PART_INDEX,
                WEAPON_PART_INDEX,
                SHIELD_PART_INDEX
            ) And Session.Ready
        End If

        If Character3D.IsValid(Character) Then
            CharacterBounds = Character3D.WorldBounds(Character, ActiveProfile.AnimationMargin)
        End If

        Session.Ready = ViewerRendering.BeginScene(
            Rendering, ViewerCameraState.Live) And Session.Ready

        Call ViewerSession.CaptureFailure(Session, 8)

        If Session.Ready Then

            If Rendering.FloorVisible Then
                Session.Ready = ViewerRendering.DrawFloor(Rendering)

                Call ViewerSession.CaptureFailure(Session, 9)
            End If

            If Rendering.GridVisible Then
                Session.Ready = ViewerRendering.DrawGrid(Rendering) And Session.Ready

                Call ViewerSession.CaptureFailure(Session, 10)
            End If

            If DragonState.Visible And Not Session.DragonInspection Then
                Session.Ready = ViewerDragon.Draw(DragonState) And Session.Ready

                Call ViewerSession.CaptureFailure(Session, 11)
            End If

            If Effects.EpicGlowVisible Then

                If ((Not Party.Enabled Or
                    ViewerParty.PresentationState(Party, 0) <> ViewerParty.STATE_KO) And
                    Not ViewerEffects.DrawEquipmentGlow(
                        Effects,
                        Session.ProfileIndex,
                        Equipment.SwordVisible,
                        Equipment.ShieldVisible
                    )) Then
                    Effects.EpicGlowVisible = False
                End If

            End If

            Session.Ready = Character3D.Draw(Character) And Session.Ready

            If (Party.Enabled Or Session.DragonInspection) And Party.Ready Then
                Session.Ready = ViewerParty.DrawCompanion(
                    Party,
                    Party.Enabled,
                    Session.DragonInspection,
                    Effects.EpicGlowVisible,
                    Equipment.SwordVisible
                ) And Session.Ready
            End If

            If Session.DragonInspection Then
                Session.Ready = ViewerParty.DrawDragonOpponent(
                    Party,
                    Party.Enabled,
                    Session.DragonInspection,
                    Effects.EpicGlowVisible,
                    Equipment.SwordVisible
                ) And Session.Ready
            End If

            Call ViewerSession.CaptureFailure(Session, 12)

            Call ViewerEffects.DrawEquipmentFire(
                Effects, Equipment.SwordVisible, Equipment.ShieldVisible)

            Session.Ready = ViewerEffects.DrawScene(Effects) And Session.Ready

            Call ViewerDragon.DrawEffects(DragonState)

            If Effects.EpicGlowVisible Then

                If Not ViewerEffects.DrawEpicGlow(
                    Effects,
                    Session.ProfileIndex,
                    Equipment.SwordVisible,
                    Equipment.ShieldVisible
                ) Then
                    Effects.EpicGlowVisible = False
                End If

            End If

            If Rendering.SocketGizmosVisible Then
                Session.Ready = ViewerRendering.DrawSocketGizmos(Rendering) And Session.Ready
            End If

            Session.Ready = Scene3D.EndScene() And Session.Ready

            Call ViewerSession.CaptureFailure(Session, 13)

        End If

        If Not Session.Ready Then
            Call ViewerSession.RecordError(Session)
        End If

    End If

    Call ViewerEffects.DrawStormFlash(Effects)
    Call DrawViewerOverlay()

    Show Screen

    Call ViewerSession.ContinueRunning(Session, Game_Closed())

Loop Until Not Session.Running

Call DestroyViewer()

Sub LoadViewer()

    Session.Ready = ViewerRendering.PrepareAssetLoading(3)

    Call ViewerParty.EndInspectorBinding(Party)
    Call ViewerParty.ClearPreview(Party)

    ActiveProfile = ViewerProfiles.ProfileAt(Session.ProfileIndex)

    Call ViewerCalibration.SelectProfileBank(
        Calibration, Session.ProfileIndex)

    Call ViewerDragon.SetAvailable(
        DragonState,
        ViewerProfiles.IsPartyCharacter(Session.ProfileIndex) Or Session.DragonInspection
    )

    Call ViewerActors.ResetEquipmentVisibility(Equipment)

    Session.Ready = CharacterViewer.ValidateProfile(ActiveProfile) And Session.Ready
    Session.Ready = Window_Title(ViewerTitle()) And Session.Ready

    Call ViewerSession.CaptureFailure(Session, 30)

    Character = ViewerActors.LoadPrimary(ActiveProfile)
    Session.Ready = Character3D.IsValid(Character) And Session.Ready

    Call ViewerSession.CaptureFailure(Session, 31)

    Session.Ready = ViewerActors.ValidateProfile(
        Character, Session.ProfileIndex, ActiveProfile) And Session.Ready

    Call ViewerSession.CaptureFailure(Session, 32)

    Session.Ready = ViewerCamera.ConfigureFraming(
        ViewerCameraState,
        ActiveProfile,
        Character,
        Max(1, Window_Width() - 284),
        Max(1, Window_Height()),
        Session.DragonInspection,
        ViewerDragon.ScalePercent(),
        ViewerDragon.PositionX(),
        0,
        ViewerDragon.PositionZ(),
        DragonState.Available,
        ARENA_CAMERA_CENTER_X,
        ARENA_CAMERA_CENTER_Z,
        ARENA_CAMERA_DISTANCE,
        ARENA_CAMERA_HEIGHT
    ) And Session.Ready

    Call ViewerSession.CaptureFailure(Session, 33)

    Call ViewerRendering.CreateBackdrops(
        Rendering,
        BACKDROP_LANDSCAPE_PATH,
        BACKDROP_TITLE_PATH
    )

    Call ViewerRendering.CreateArena(
        Rendering,
        ViewerRendering.ArenaFloorExtent(
            ViewerCameraState.Frame.FloorWidth,
            DragonState.Available,
            ARENA_FLOOR_WIDTH
        ),
        ViewerRendering.ArenaFloorExtent(
            ViewerCameraState.Frame.FloorDepth,
            DragonState.Available,
            ARENA_FLOOR_DEPTH
        )
    )

    Session.Ready = ViewerRendering.ArenaReady(Rendering) And Session.Ready

    Call ViewerSession.CaptureFailure(Session, 34)

    Call ViewerCamera.BeginLoadedLayout(
        ViewerCameraState, Window_Width(), Window_Height())

    Call ViewerCamera.Reset(
        ViewerCameraState,
        0,
        ViewerCamera.DefaultZoomDegrees(
            DragonState.Available,
            DEFAULT_ZOOM_DEGREES,
            ARENA_DEFAULT_ZOOM_DEGREES
        ),
        ZOOM_IN_LIMIT, ZOOM_OUT_LIMIT, 96000)

    Session.Ready = ViewerRendering.ConfigureShadowArea(
        ViewerCameraState.Frame,
        DragonState.Available,
        ViewerDragon.PositionX(),
        ViewerDragon.PositionZ(),
        ARENA_FLOOR_WIDTH,
        ARENA_FLOOR_DEPTH
    ) And Session.Ready

    Call ViewerSession.CaptureFailure(Session, 35)

    Session.Ready = ViewerRendering.ApplyLighting(Rendering) And Session.Ready

    Session.Ready = ViewerActors.PreparePrimaryPresentation(
        Character,
        ViewerCameraState.Frame,
        Session.ProfileIndex,
        Session.DragonInspection,
        DragonState.Available,
        ViewerDragon.PositionX(),
        0,
        ViewerDragon.PositionZ(),
        ViewerDragon.RotationY(),
        CHARACTER_MODEL_FORWARD_YAW_OFFSET,
        ORIN_ARENA_YAW_ADJUSTMENT
    ) And Session.Ready

    Call ViewerSession.CaptureFailure(Session, 36)

    Session.Ready = ViewerDragon.Create(
        DragonState,
        Character,
        Session.DragonInspection
    ) And Session.Ready

    Call ViewerSession.CaptureFailure(Session, 37)

    Session.Ready = ViewerRendering.CreateSocketGizmos(Rendering) And Session.Ready

    Call ViewerSession.CaptureFailure(Session, 38)

    Call ViewerEffects.CreateEpicGlow(Effects, Session.ProfileIndex, Character)

    Call ViewerSession.CaptureFailure(Session, 39)

    Call ConfigureCalibration()

    Call ViewerSession.CaptureFailure(Session, 40)

    Call ViewerPlayback.UseDefaultSpeed(
        Playback, ActiveProfile.DefaultPlaybackSpeed)

    Session.Ready = ViewerRendering.ResetMaterialInspection(Rendering) And Session.Ready

    Call ViewerSession.CaptureFailure(Session, 41)

    Call RestartPresentation()

    Call ViewerSession.CaptureFailure(Session, 42)

    Call ViewerEffects.ResetEquipmentDefaults(Effects)

    Session.Ready = ViewerEffects.PrepareShared(Effects) And Session.Ready

    Call ViewerEffects.PrepareFire(
        Effects,
        DragonState.Available,
        CalibrationAvailable And Session.ProfileIndex = ViewerProfiles.PROFILE_ARIN
    )

    If DragonState.Available Then
        Call ViewerDragon.InitializeEffects()
    End If

    If Party.Enabled Then

        Session.Ready = ViewerParty.CreateCompanion(
            Party,
            Calibration,
            Effects,
            ViewerProfiles.PROFILE_ORIN,
            CALIBRATION_MAX_CLIPS,
            Playback.PlaybackSpeed
        ) And Session.Ready

        Call ConfigureCalibration()
        Call ResetPartyDemo()

    End If

    If Session.DragonInspection Then

        Session.Ready = ViewerParty.CreateCompanion(
            Party,
            Calibration,
            Effects,
            ViewerProfiles.PROFILE_ARIN,
            0,
            Playback.PlaybackSpeed
        ) And Session.Ready

        Party.DragonOpponent = Party.Companion

        Session.Ready = ViewerParty.CreateCompanion(
            Party,
            Calibration,
            Effects,
            ViewerProfiles.PROFILE_ORIN,
            CALIBRATION_MAX_CLIPS,
            Playback.PlaybackSpeed
        ) And Session.Ready

        Call PositionDragonOpponents()

        Call ViewerEffects.EnableSwordFire(Effects)

    End If

    If (Party.Enabled Or
        Session.DragonInspection Or
        Session.ProfileIndex = ViewerProfiles.PROFILE_ORIN) Then
        Session.Ready = ViewerEffects.PrepareLightning(Effects) And Session.Ready
    End If

    Call ViewerSession.CaptureResourceEpoch(Session)

    If Not Session.Ready Then
        Call ViewerSession.RecordError(Session)
    End If

End Sub

Sub UpdateDragon()

    Session.Ready = ViewerParty.UpdateDragon(
        Party,
        DragonState,
        Effects,
        Character,
        Session.DragonInspection,
        ViewerPlayback.SelectedClipName(Character, Playback),
        Playback.ScenePaused,
        Playback.PlaybackSpeed,
        Playback.AnimationUpdateElapsed
    ) And Session.Ready

End Sub

Sub UpdateBattleAudio()

    Dim Audible As Boolean
    Dim Name As Text

    Name = ViewerPlayback.SelectedClipName(Character, Playback)
    Audible = Not Playback.ScenePaused And Not ViewerUiState.CalibrationEditing

    Call ViewerEffects.UpdateArinAudio(
        Effects, Session.ProfileIndex, Name,
        Character3D.AnimationTime(Character), Audible)

    Call ViewerDragon.UpdateAudio(DragonState, Audible)

End Sub

Sub CancelInteractionCaptures()

    If ViewerGizmoState.Dragging Then
        Call ViewerGizmo.FinishDrag(ViewerGizmoState)
    End If

    If ViewerInputState.TimelineKeyframeDragging Then
        Session.Ready = Character3D.SetAnimationTime(
            Character,
            ViewerCalibration.FrameTimeMilliseconds(
                Character,
                Playback.SelectedClip,
                ViewerInputState.TimelineDraggedOriginalFrame
            )
        ) And Session.Ready
    End If

    If (ViewerInputState.TimelineScrubbing Or
        ViewerInputState.TimelineKeyframeDragging) Then
        Call RestorePartyPreview()
    End If

    Call ViewerInput.CancelCaptures(ViewerInputState)
    Call ViewerCamera.CancelPointerControls(ViewerCameraState)

End Sub

Sub HandleKeyboard(PressedKey As Number)

    If (Party.Enabled And
        (PressedKey = KEY_4 Or
        (PressedKey = KEY_ENTER And Not ViewerUiState.CalibrationEditing And Not ViewerGizmoState.Dragging))) Then

        If PressedKey = KEY_ENTER Then
            Call ResetPartyInspector()
        End If

        Return

    End If

    Call BeginPartyInspector()
    Call HandleInspectorKeyboard(PressedKey)
    Call EndPartyInspector()

End Sub

Sub HandleInspectorKeyboard(PressedKey As Number)

    Dim Action As Number
    Dim InspectorResult As ViewerInspectorCommands.OperationResult

    If PressedKey = KEY_BACKTICK Then

        Call ViewerUi.CycleVisibility(ViewerUiState)
        Call CancelInteractionCaptures()

        Return

    End If

    If HandleTransformGizmoKeyboard(PressedKey) Then
        Return
    End If

    Action = ViewerInput.ClassifyInspectorKey(
        PressedKey,
        Key_Event_Held(KEY_CONTROL),
        ViewerUiState.CalibrationEditing,
        Party.Enabled,
        Rendering.SocketGizmosVisible,
        Character3D.ClipCount(Character)
    )

    InspectorResult = ViewerInspectorCommands.ApplyKeyboardNavigationAction(
        Action,
        Rendering,
        BACKGROUND_COUNT,
        Character3D.SocketCount(Character),
        ViewerCameraState,
        Effects,
        DragonState
    )

    If InspectorResult.Handled Then
        Session.Ready = InspectorResult.Ready And Session.Ready

        Return
    End If

    If ApplyActorPresentationCommand(
        Action,
        ViewerInspectorCommands.ACTOR_ACTION_SOURCE_INSPECTOR_KEYBOARD) Then
        Return
    End If

    If Action = ViewerInput.INSPECTOR_KEY_TOGGLE_PAUSE Then

        Call ToggleScenePause()

    Else If Action = ViewerInput.INSPECTOR_KEY_FRAME_PREVIOUS Then

        Call ApplyTimelineCommand(
            ViewerTimelineEditing.COMMAND_STEP_FRAME, -1)

    Else If Action = ViewerInput.INSPECTOR_KEY_FRAME_NEXT Then

        Call ApplyTimelineCommand(
            ViewerTimelineEditing.COMMAND_STEP_FRAME, 1)

    Else If Action = ViewerInput.INSPECTOR_KEY_CLIP_1 Then

        Call SelectPresentationClip(0)

    Else If Action = ViewerInput.INSPECTOR_KEY_CLIP_2 Then

        Call SelectPresentationClip(1)

    Else If Action = ViewerInput.INSPECTOR_KEY_CLIP_3 Then

        Call SelectPresentationClip(2)

    Else If Action = ViewerInput.INSPECTOR_KEY_RESET Then

        If Session.ViewerError Then
            Call RetryViewer()
        Else

            Call ResetAll()
        End If

    Else If Action = ViewerInput.INSPECTOR_KEY_CYCLE_PROFILE Then

        Call CycleProfile()

    Else If Action = ViewerInput.INSPECTOR_KEY_NEXT_CLIP Then

        Call SelectPresentationClip(
            (ViewerPlayback.PresentationIndexForRuntimeClip(
                Character, Session.ProfileIndex, Playback.SelectedClip) + 1) Mod
                ViewerProfiles.ClipCount(Session.ProfileIndex)
        )

    Else If Action = ViewerInput.INSPECTOR_KEY_RESTART_CLIP Then

        Call PlaySelectedClip()

    End If

End Sub

Function HandleTransformGizmoKeyboard(PressedKey As Number) As Boolean

    Dim Action As Number
    Dim Result As ViewerCalibrationEditing.OperationResult

    Action = ViewerInput.ClassifyGizmoKey(
        PressedKey,
        CalibrationAvailable,
        ViewerUiState.CalibrationVisible,
        ViewerUiState.Visibility,
        ViewerUiState.CalibrationTarget >= ViewerUi.CALIBRATION_TARGET_SWORD,
        ViewerGizmoState.Dragging,
        ViewerUiState.CalibrationEditing
    )

    If Action = ViewerInput.GIZMO_KEY_NONE Then
        Return False
    End If

    If ViewerCalibrationControls.GizmoKeyRequiresPartyPreview(
        Action, ViewerGizmoState.Visible, ViewerUiState.CalibrationEditing,
        ViewerGizmoState.Dragging, Calibration.StorageRejected) Then
        Call BeginPartyPreview()
    End If

    Result = ViewerCalibrationControls.ApplyGizmoKeyboardAction(
        Action,
        Calibration, Character, Playback.SelectedClip,
        SwordWristNode, ShieldWristNode, CalibrationAvailable,
        ViewerUiState, ViewerGizmoState, ViewerCameraState, Effects)

    Call ApplyCalibrationEditingResult(Result)

    Return True

End Function

Function HandleTransformGizmoPointer() As Boolean

    Dim ReturnValue As Boolean

    Dim Decision As ViewerGizmo.PointerDecision
    Dim GizmoButtonContains As Boolean
    Dim Origin As Core.Vector3
    Dim Result As ViewerCalibrationEditing.OperationResult

    GizmoButtonContains = ViewerUi.CalibrationGizmoButtonContains(
        Pointer_X(), Pointer_Y())
    Origin = ViewerGizmoState.Origin

    If (CalibrationAvailable And
        ViewerUiState.CalibrationVisible And
        ViewerUiState.Visibility = 0 And
        Not Session.ViewerError And
        ViewerGizmoState.Visible And
        Not GizmoButtonContains) Then
        Origin = ViewerCalibrationEditing.GizmoOrigin(
            Character, ViewerUiState)
    End If

    Decision = ViewerGizmo.ClassifyPointer(
        ViewerGizmoState,
        CalibrationAvailable,
        ViewerUiState.CalibrationVisible,
        ViewerUiState.Visibility,
        Session.ViewerError,
        GizmoButtonContains,
        Pointer_Pressed(POINTER_PRIMARY),
        Pointer_Held(POINTER_PRIMARY),
        Pointer_Released(POINTER_PRIMARY),
        Pointer_Pressed(POINTER_SECONDARY),
        Pointer_X(),
        Pointer_Y(),
        Pointer_Delta_X(),
        Pointer_Delta_Y(),
        Pointer_Inside(),
        90,
        Window_Height() - 100,
        ViewerUi.StatusPanelX(Window_Width()),
        ViewerUi.CALIBRATION_PANEL_X,
        ViewerUi.CALIBRATION_PANEL_Y,
        ViewerUi.CALIBRATION_PANEL_WIDTH,
        ViewerUi.CALIBRATION_PANEL_HEIGHT,
        ViewerUiState.CalibrationTransform,
        ViewerUiState.CalibrationAxis,
        Origin,
        ViewerCameraState.Live,
        Window_Width(),
        Window_Height()
    )

    If ViewerCalibrationControls.GizmoPointerRequiresPartyPreview(
        Decision.Action, ViewerGizmoState.Visible,
        ViewerUiState.CalibrationEditing) Then
        Call BeginPartyPreview()
    End If

    Result = ViewerCalibrationControls.ApplyGizmoPointerAction(
        Decision, Pointer_Released(POINTER_PRIMARY),
        Calibration, Character, Playback.SelectedClip,
        SwordWristNode, ShieldWristNode, CalibrationAvailable,
        ViewerUiState, ViewerGizmoState, ViewerCameraState, Effects,
        Window_Width(), Window_Height())

    Call ApplyCalibrationEditingResult(Result)

    ReturnValue = Decision.Consumed

    Return ReturnValue

End Function

Sub UpdateTransformGizmo()

    Call ViewerGizmo.UpdateProjection(
        ViewerGizmoState,
        ViewerCalibrationEditing.GizmoOrigin(Character, ViewerUiState),
        ViewerCameraState.Live,
        Window_Width(),
        Window_Height()
    )

End Sub

Sub ToggleScenePause()

    If Party.Enabled And Playback.ScenePaused Then

        If ViewerUiState.CalibrationEditing Then
            Call ViewerSession.BlockCharacterSwitch(Session)

            Return
        End If

        Call RestorePartyPreview()

    End If

    Call ViewerPlayback.TogglePause(Playback)

End Sub

Function ApplyActorPresentationCommand(
    Action As Number, ActionSource As Number) As Boolean

    Dim ReturnValue As Boolean

    Dim Result As ViewerInspectorCommands.OperationResult
    Dim RestoreInspector As Boolean

    RestoreInspector = (Party.UiBound And
        ViewerInspectorCommands.ActorPresentationRequiresPrimaryActor(
            Action, ActionSource))

    If RestoreInspector Then
        Call EndPartyInspector()
    End If

    Result = ViewerInspectorCommands.ApplyActorPresentationAction(
        Action, ActionSource, Equipment, Party, Character,
        CalibrationAvailable, Session.DragonInspection,
        WEAPON_PART_INDEX, SHIELD_PART_INDEX, Effects)
    Session.Ready = Result.Ready And Session.Ready

    If RestoreInspector Then
        Call BeginPartyInspector()
    End If

    ReturnValue = Result.Handled

    Return ReturnValue

End Function

Sub RetryViewer()

    Call DestroyViewerResources()
    Call Character3D.Shutdown()
    Call Scene3D.Shutdown()
    Call Graphics3D.ResetRenderer3D()

    Call ViewerSession.ResetFailure(Session)

    Call LoadViewer()

End Sub

Sub CycleProfile()

    If Not ViewerProfiles.INCLUDE_DIAGNOSTIC_PROFILES Or Party.Enabled Then
        Return
    End If

    If ViewerUiState.CalibrationEditing Then
        Call ViewerSession.BlockCharacterSwitch(Session)

        Return
    End If

    Call DestroyViewerResources()

    Call ViewerParty.SetEnabled(Party, False)
    Call ViewerSession.CycleProfile(Session)

    Call ViewerSession.ResetFailure(Session)

    Call LoadViewer()

End Sub

Sub AdvanceAnimationSequence()

    If Party.Enabled Then
        Return
    End If

    If ViewerPlayback.AdvanceDemo(
        Playback, Character, Session.ProfileIndex,
        ANIMATION_CYCLE_MILLISECONDS, Timing.PresentationElapsed) Then
        Call PlaySelectedClip(True)
    End If

End Sub

Function HandleInterfacePointer() As Boolean

    Dim Blocked As Boolean
    Dim Index As Number

    If ViewerInput.HasInterfaceCapture(
        ViewerInputState, ViewerGizmoState.Dragging) Then

        Call BeginPartyInspector()

        Blocked = HandleInspectorPointer()

        Call EndPartyInspector()

        Return Blocked

    End If

    If ViewerUiState.Visibility = 2 Then

        If Pointer_Pressed(POINTER_SECONDARY) Then

            If Party.Enabled Then
                Call ResetPartyInspector()
            Else If Session.ViewerError Then
                Call RetryViewer()
            Else

                Call ResetAll()
            End If

            Return True

        End If

        Return False

    End If

    If ViewerUi.CharacterTabsContain(Pointer_X(), Pointer_Y()) Then

        If Pointer_Pressed(POINTER_PRIMARY) Then

            Index = ViewerUi.CharacterTabAtPointer(Pointer_X(), Pointer_Y())

            If Index >= 0 Then
                Call SelectCharacterTab(Index)
            End If

        End If

        Return True

    End If

    If Party.Enabled Then

        If HandlePartyPointer() Then
            Return True
        End If

        Call BeginPartyInspector()

        Blocked = HandleInspectorPointer()

        Call EndPartyInspector()

        Return Blocked

    End If

    Blocked = HandleInspectorPointer()

    Return Blocked

End Function

Function HandleInspectorPointer() As Boolean

    Dim Action As Number
    Dim Blocked As Boolean
    Dim Gesture As ViewerInput.PointerGestureUpdate
    Dim InspectorResult As ViewerInspectorCommands.OperationResult
    Dim KeyframeIndex As Number
    Dim TransferAction As Number
    Dim WheelDelta As Number

    If HandleTransformGizmoPointer() Then
        Return True
    End If

    Gesture = ViewerInput.UpdateBeforeSliders(
        ViewerInputState,
        Timer(),
        FRAME_BUTTON_REPEAT_MILLISECONDS,
        Pointer_Pressed(POINTER_PRIMARY),
        Pointer_Held(POINTER_PRIMARY),
        Pointer_Pressed(POINTER_SECONDARY)
    )

    If Gesture.Action = ViewerInput.POINTER_GESTURE_STEP_FRAME Then
        Call ApplyTimelineCommand(
            ViewerTimelineEditing.COMMAND_STEP_FRAME, Gesture.Value)
    Else If Gesture.Action = ViewerInput.POINTER_GESTURE_UPDATE_KEYFRAME Then
        Call UpdateTimelineKeyframeDrag()
    Else If Gesture.Action = ViewerInput.POINTER_GESTURE_FINISH_KEYFRAME Then
        Call FinishTimelineKeyframeDrag()
    End If

    If Gesture.Consumed Then
        Return True
    End If

    If HandleSharedSliders() Then
        Return True
    End If

    Gesture = ViewerInput.UpdateTimelineScrub(
        ViewerInputState,
        Pointer_Pressed(POINTER_PRIMARY),
        Pointer_Held(POINTER_PRIMARY),
        Pointer_Released(POINTER_PRIMARY)
    )

    If Gesture.Action = ViewerInput.POINTER_GESTURE_SEEK_TIMELINE Then
        Call ApplyTimelineCommand(
            ViewerTimelineEditing.COMMAND_SEEK_POINTER, 0)
    End If

    If Gesture.Consumed Then
        Return True
    End If

    If Not Pointer_Inside() Then
        Return False
    End If

    If Pointer_Pressed(POINTER_SECONDARY) Then

        If Session.ViewerError Then
            Call RetryViewer()
        Else

            Call ResetAll()
        End If

        Return True

    End If

    If ViewerUi.TimelineContains(
        Pointer_X(), Pointer_Y(), Window_Width(), Window_Height()) Then

        WheelDelta = Pointer_Wheel_Delta()

        If WheelDelta > 0 Then
            Call ApplyTimelineCommand(
                ViewerTimelineEditing.COMMAND_STEP_FRAME, 1)
        Else If WheelDelta < 0 Then
            Call ApplyTimelineCommand(
                ViewerTimelineEditing.COMMAND_STEP_FRAME, -1)
        End If

        If WheelDelta <> 0 Then
            Return True
        End If

    End If

    If ViewerUi.LayoutTooSmall(Window_Width(), Window_Height()) Then
        Return True
    End If

    TransferAction = ViewerUi.TransferActionAtPointer(
        Pointer_X(),
        Pointer_Y(),
        Window_Height(),
        CalibrationAvailable,
        Text_Width(Calibration.FileLabel, 9)
    )

    If TransferAction <> ViewerUi.TRANSFER_ACTION_NONE Then

        If Pointer_Pressed(POINTER_PRIMARY) Then

            If TransferAction = ViewerUi.TRANSFER_ACTION_DOWNLOAD Then
                Call ViewerCalibration.Download(Calibration, Character)
            Else If TransferAction = ViewerUi.TRANSFER_ACTION_IMPORT Then
                Call HandleCalibrationImport()
            Else If TransferAction = ViewerUi.TRANSFER_ACTION_OPEN Then
                Call ViewerCalibration.OpenOrDownload(Calibration, Character)
            End If

        End If

        Return True

    End If

    If ViewerUi.CalibrationPanelContains(
        Pointer_X(), Pointer_Y(), ViewerUiState.Visibility,
        CalibrationAvailable, ViewerUiState.CalibrationVisible) Then
        Call HandleCalibrationPanelPointer()

        Return True
    End If

    Blocked = ViewerUi.InspectorBlocksScene(
        Pointer_X(), Pointer_Y(), Window_Width(), Window_Height(),
        ViewerUiState.Visibility)

    If Not Pointer_Pressed(POINTER_PRIMARY) Then
        Return Blocked
    End If

    KeyframeIndex = ViewerUi.TimelineKeyframeAtPointer(
        Character,
        Calibration,
        CalibrationAvailable,
        Playback.SelectedClip,
        Pointer_X(),
        Pointer_Y(),
        Window_Width(),
        Window_Height()
    )

    Action = ViewerUi.InspectorActionAtPointer(
        Pointer_X(),
        Pointer_Y(),
        Window_Width(),
        Window_Height(),
        ViewerUiState.Visibility,
        ViewerProfiles.INCLUDE_DIAGNOSTIC_PROFILES,
        Party.Enabled,
        Session.ProfileIndex,
        Effects.SwordFireReady,
        KeyframeIndex
    )

    InspectorResult = ViewerInspectorCommands.ApplyPresentationAction(
        Action, Rendering, BACKGROUND_COUNT, Effects, DragonState)

    If InspectorResult.Handled Then
        Session.Ready = InspectorResult.Ready And Session.Ready

        Return Blocked
    End If

    If ApplyActorPresentationCommand(
        Action,
        ViewerInspectorCommands.ACTOR_ACTION_SOURCE_INSPECTOR_POINTER) Then
        Return Blocked
    End If

    If Action = ViewerUi.INSPECTOR_ACTION_FIRST_FRAME Then

        Call ApplyTimelineCommand(
            ViewerTimelineEditing.COMMAND_SEEK_FIRST_FRAME, 0)

    Else If Action = ViewerUi.INSPECTOR_ACTION_PREVIOUS_KEY Then

        Call ApplyTimelineCommand(
            ViewerTimelineEditing.COMMAND_SEEK_ADJACENT_KEY, -1)

    Else If Action = ViewerUi.INSPECTOR_ACTION_NEXT_KEY Then

        Call ApplyTimelineCommand(
            ViewerTimelineEditing.COMMAND_SEEK_ADJACENT_KEY, 1)

    Else If Action = ViewerUi.INSPECTOR_ACTION_PREVIOUS_FRAME Then

        Call ApplyTimelineCommand(
            ViewerTimelineEditing.COMMAND_STEP_FRAME, -1)

        Call ViewerInput.BeginFrameRepeat(
            ViewerInputState, -1,
            Timer() + FRAME_BUTTON_REPEAT_MILLISECONDS)

    Else If Action = ViewerUi.INSPECTOR_ACTION_NEXT_FRAME Then

        Call ApplyTimelineCommand(
            ViewerTimelineEditing.COMMAND_STEP_FRAME, 1)

        Call ViewerInput.BeginFrameRepeat(
            ViewerInputState, 1,
            Timer() + FRAME_BUTTON_REPEAT_MILLISECONDS)

    Else If Action = ViewerUi.INSPECTOR_ACTION_KEYFRAME Then

        Call ApplyTimelineCommand(
            ViewerTimelineEditing.COMMAND_BEGIN_KEYFRAME_DRAG, KeyframeIndex)

    Else If Action = ViewerUi.INSPECTOR_ACTION_TIMELINE Then

        Call ApplyTimelineCommand(
            ViewerTimelineEditing.COMMAND_SEEK_POINTER, 0)

    Else If Action = ViewerUi.INSPECTOR_ACTION_PROFILE Then

        Call CycleProfile()

    Else If Action = ViewerUi.INSPECTOR_ACTION_CALIBRATION Then

        ViewerUiState.CalibrationVisible = CalibrationAvailable And Not ViewerUiState.CalibrationVisible

        If ViewerUiState.CalibrationVisible Then
            Call BeginPartyPreview()
        Else

            Call ViewerGizmo.Hide(ViewerGizmoState)
            Call ViewerInput.CancelCaptures(ViewerInputState)
        End If

    Else If Action = ViewerUi.INSPECTOR_ACTION_DEMO Then

        If ViewerPlayback.ApplyDemoToggle(Playback, Party.Enabled) Then
            Call ToggleScenePause()
        Else

            Call PlaySelectedClip()
        End If

    Else If Action = ViewerUi.INSPECTOR_ACTION_DRAGON_HEAD Then

        Call ViewerDragon.ToggleHeadTracking(DragonState)

    Else If Action = ViewerUi.INSPECTOR_ACTION_DRAGON_TARGET Then

        If Not Party.Enabled Then
            Party.DragonCounter = (Party.DragonCounter + 1) Mod 2
        End If

    Else If Action = ViewerUi.INSPECTOR_ACTION_SPEED_DOWN Then

        Call AdjustPlaybackSpeed(-25)

    Else If Action = ViewerUi.INSPECTOR_ACTION_SPEED_UP Then

        Call AdjustPlaybackSpeed(25)

    Else If Action = ViewerUi.INSPECTOR_ACTION_RESET_VIEW Then

        Call ResetView()

    Else If Action = ViewerUi.INSPECTOR_ACTION_RESTART_PRESENTATION Then

        Call RestartPresentation()

    Else If Action = ViewerUi.INSPECTOR_ACTION_RESET_ALL Then

        Call ResetAll()

    Else If Action = ViewerUi.INSPECTOR_ACTION_FIT Then

        Call ViewerCamera.ToggleResponsiveFit(
            ViewerCameraState,
            ActiveProfile,
            Window_Width(),
            Window_Height(),
            Max(1, Window_Width() - 284),
            DragonState.Available,
            ARENA_CAMERA_CENTER_X,
            ARENA_CAMERA_CENTER_Z,
            ARENA_CAMERA_DISTANCE,
            ARENA_CAMERA_HEIGHT
        )

    Else If Action >= ViewerUi.INSPECTOR_ACTION_CLIP_BASE Then

        Call SelectPresentationClip(Action - ViewerUi.INSPECTOR_ACTION_CLIP_BASE)

    End If

    Return Blocked

End Function

Function HandleSharedSliders() As Boolean

    Dim ReturnValue As Boolean

    Dim Update As ViewerUi.SliderUpdate

    Update = ViewerUi.UpdateCameraSliders(
        ViewerInputState.SliderDragOwner,
        ViewerUiState.Visibility,
        ViewerUi.StatusPanelX(Window_Width()),
        Window_Height(),
        ViewerCameraState.Controls.OrbitYaw,
        ViewerCameraState.Controls.OrbitPitch,
        CharacterViewer.ZoomTargetDegrees(ViewerCameraState.Zoom),
        ZOOM_IN_LIMIT,
        ZOOM_OUT_LIMIT
    )

    If Update.Action = ViewerUi.SLIDER_ACTION_HORIZONTAL_ORBIT Then
        Call ViewerCamera.SetHorizontalOrbit(ViewerCameraState, Update.Value)
    Else If Update.Action = ViewerUi.SLIDER_ACTION_VERTICAL_ORBIT Then
        Call ViewerCamera.SetVerticalOrbit(ViewerCameraState, Update.Value)
    Else If Update.Action = ViewerUi.SLIDER_ACTION_ZOOM Then
        Call ViewerCamera.SetZoomTarget(ViewerCameraState, Update.Value)
    End If

    If Update.Consumed Then
        Return True
    End If

    If ViewerUiState.CalibrationVisible Or ViewerInputState.SliderDragOwner = 4 Then

        Update = ViewerUi.UpdateCalibrationSlider(
            ViewerInputState.SliderDragOwner,
            ViewerCalibrationEditing.CurrentValue(
                Calibration, Playback.SelectedClip, ViewerUiState),
            ViewerCalibration.MinimumValue(ViewerUiState.CalibrationTransform),
            ViewerCalibration.MaximumValue(ViewerUiState.CalibrationTransform)
        )

        If Update.Consumed And Update.Changed Then
            Call SetCurrentCalibrationValue(Update.Value)
        End If

    End If

    ReturnValue = Update.Consumed

    Return ReturnValue

End Function

Sub HandleCalibrationPanelPointer()

    Dim Action As Number
    Dim Result As ViewerCalibrationEditing.OperationResult

    Action = ViewerCalibrationControls.ActionAtPointer(
        Pointer_X(),
        Pointer_Y(),
        Pointer_Pressed(POINTER_PRIMARY),
        ViewerUiState.CalibrationTarget
    )

    If ViewerCalibrationControls.RequiresPartyPreview(
        Action, ViewerUiState.CalibrationEditing) Then
        Call BeginPartyPreview()
    End If

    Result = ViewerCalibrationControls.ApplyPointerAction(
        Action,
        Calibration,
        Character,
        Playback,
        Session.ProfileIndex,
        SwordWristNode,
        ShieldWristNode,
        CalibrationAvailable,
        ViewerUiState,
        ViewerGizmoState,
        ViewerCameraState,
        Effects
    )

    Call ApplyCalibrationEditingResult(Result)

End Sub

Sub UpdateCameraPointer(Blocked As Boolean)

    Dim OrbitPressed As Boolean
    Dim OrbitHeld As Boolean
    Dim OrbitReleased As Boolean
    Dim OrbitActive As Boolean
    Dim PanPressed As Boolean
    Dim PanHeld As Boolean
    Dim PanReleased As Boolean
    Dim PanActive As Boolean
    Dim WheelDelta As Number
    Dim PointerDeltaX As Number
    Dim PointerDeltaY As Number

    OrbitPressed = (Not Blocked And
        (Pointer_Pressed(POINTER_MIDDLE) Or
        (Pointer_Held(POINTER_MIDDLE) And Not ViewerCameraState.Controls.Orbiting)))
    OrbitHeld = Pointer_Held(POINTER_MIDDLE)
    OrbitReleased = Pointer_Released(POINTER_MIDDLE)
    OrbitActive = (OrbitPressed Or
        (ViewerCameraState.Controls.Orbiting And (OrbitHeld Or OrbitReleased)))
    PanPressed = (Not Blocked And
        (Pointer_Pressed(POINTER_PRIMARY) Or
        (Pointer_Held(POINTER_PRIMARY) And Not ViewerCameraState.Controls.Panning)))
    PanHeld = Pointer_Held(POINTER_PRIMARY)
    PanReleased = Pointer_Released(POINTER_PRIMARY)
    PanActive = (PanPressed Or
        (ViewerCameraState.Controls.Panning And (PanHeld Or PanReleased)))
    PointerDeltaX = Pointer_Delta_X()
    PointerDeltaY = Pointer_Delta_Y()

    ViewerCameraState.CalibrationOrbitActive = OrbitActive And ViewerUiState.CalibrationVisible And Not Party.Enabled

    If OrbitPressed And ViewerCameraState.CalibrationOrbitActive Then
        Call ViewerCamera.BeginCalibrationOrbitAnchor(
            ViewerCameraState,
            ViewerCalibrationEditing.GizmoOrigin(
                Character, ViewerUiState),
            Pointer_X(),
            Pointer_Y(),
            Window_Width(),
            Window_Height()
        )
    End If

    If Not Blocked Then
        WheelDelta = Pointer_Wheel_Delta()
    End If

    If WheelDelta <> 0 Then
        Call ViewerCamera.AdjustZoomTarget(ViewerCameraState, WheelDelta, 8)
    End If

    Session.Ready = ViewerCamera.UpdatePointerControls(
        ViewerCameraState,
        OrbitPressed,
        OrbitHeld,
        OrbitReleased,
        OrbitActive,
        PanPressed,
        PanHeld,
        PanReleased,
        PanActive,
        PointerDeltaX,
        PointerDeltaY,
        ORBIT_POINTER_DIVISOR,
        PAN_POINTER_DIVISOR
    ) And Session.Ready

End Sub

Sub UpdateOrinStorm()

    Call ViewerParty.UpdateOrinStorm(
        Party, DragonState, Effects, Character,
        Session.ProfileIndex, Playback.SelectedClip,
        Session.DragonInspection, ViewerCameraState.Live,
        Timing.CameraElapsed, Equipment.SwordVisible,
        Equipment.ShieldVisible, Playback.ScenePaused)

End Sub

Sub AdjustPlaybackSpeed(Amount As Number)

    Dim Result As ViewerPlayback.SpeedAdjustmentResult

    Result = ViewerPlayback.AdjustSpeedForContext(
        Playback,
        ActiveProfile.MinimumPlaybackSpeed,
        ActiveProfile.MaximumPlaybackSpeed,
        Amount,
        Party.Enabled,
        Party.PreviewActive
    )

    If Result.Blocked Then
        Call ViewerCalibration.SetTransferMessage(
            Calibration, "Resume Or Reset Before Changing Demo Speed")

        Return
    End If

    If Result.ResetPartyDemo Then
        Call ResetPartyDemo()
    Else

        Call PlaySelectedClip()
    End If

End Sub

Sub RestartPresentation()

    If Party.Enabled And Party.Ready Then
        Call ResetPartyInspector()

        Return
    End If

    Call ResetView()

    Call ViewerCamera.StartAutoOrbit(ViewerCameraState)

    Call ViewerPlayback.RestartPresentation(
        Playback, Character, Session.ProfileIndex)

    Call PlaySelectedClip()

End Sub

Sub ResetView()

    Party.PreviousCamera = 0
    Party.OrbitPhase1000 = 0

    Call ViewerCamera.Reset(
        ViewerCameraState,
        ViewerCamera.InitialOrbitYaw(
            DragonState.Available,
            ViewerProfiles.InitialOrbitYaw(Session.ProfileIndex),
            ARENA_INITIAL_ORBIT_YAW
        ),
        ViewerCamera.DefaultZoomDegrees(
            DragonState.Available,
            DEFAULT_ZOOM_DEGREES,
            ARENA_DEFAULT_ZOOM_DEGREES
        ),
        ZOOM_IN_LIMIT,
        ZOOM_OUT_LIMIT,
        96000
    )

End Sub

Sub ResetAll()

    If Party.UiBound Then

        Call CancelCalibrationEdit()
        Call RestorePartyPreview()
        Call EndPartyInspector()

    End If

    Call ViewerParty.ClearPreview(Party)

    If ViewerUiState.CalibrationEditing Then
        Call CancelCalibrationEdit()
    End If

    Call ViewerPlayback.ResetControls(
        Playback, ActiveProfile.DefaultPlaybackSpeed)

    Call ViewerCamera.LockResponsiveFit(ViewerCameraState)

    Call ViewerRendering.ResetControls(Rendering, 3)

    Effects.EpicGlowVisible = ViewerProfiles.EpicGlowVisibleByDefault(Session.ProfileIndex) And Effects.EpicGlowAvailable

    Call ViewerDragon.ResetVisibility(DragonState)

    Call ViewerActors.ResetEquipmentVisibility(Equipment)

    Call ViewerEffects.ResetPlaybackControls(Effects)

    Call ViewerUi.Reset(ViewerUiState)
    Call ViewerInput.CancelCaptures(ViewerInputState)
    Call ViewerGizmo.Hide(ViewerGizmoState)
    Call ViewerCamera.CancelPointerControls(ViewerCameraState)

    Session.Ready = ViewerRendering.ApplyLighting(Rendering) And Session.Ready

    Session.Ready = ViewerActors.ApplyArenaFacing(
        Character,
        Session.ProfileIndex,
        Session.DragonInspection,
        DragonState.Available,
        ViewerDragon.PositionX(),
        0,
        ViewerDragon.PositionZ(),
        ViewerDragon.RotationY(),
        CHARACTER_MODEL_FORWARD_YAW_OFFSET,
        ORIN_ARENA_YAW_ADJUSTMENT
    ) And Session.Ready

    If CalibrationAvailable Then
        Session.Ready = ViewerActors.ApplyEquipmentVisibility(
            Character, Equipment) And Session.Ready
    End If

    Session.Ready = ViewerRendering.ApplyMaterialInspection(Rendering) And Session.Ready

    If Party.Enabled And Party.Ready Then

        Call ResetPartyDemo()
        Call ResetView()

        Call ViewerCamera.SetAutoOrbit(ViewerCameraState, True)

    Else

        Call RestartPresentation()

    End If

End Sub

Sub SelectClip(Index As Number)

    Call BeginPartyPreview()
    Call CancelCalibrationEdit()

    Call ViewerPlayback.SelectClip(Playback, Index, Party.Enabled)

    ViewerUiState.CalibrationClearConfirm = False
    ViewerUiState.CalibrationClearAllStage = 0

    Call PlaySelectedClip()

End Sub

Sub SelectPresentationClip(Index As Number)

    Dim RuntimeClip As Number

    RuntimeClip = ViewerPlayback.RuntimeClipForPresentationIndex(
        Character, Session.ProfileIndex, Index)

    If RuntimeClip >= 0 Then
        Call SelectClip(RuntimeClip)
    End If

End Sub

Sub ApplyTimelineCommand(Command As Number, Value As Number)

    Dim Result As ViewerCalibrationEditing.OperationResult

    If Command = ViewerTimelineEditing.COMMAND_SEEK_POINTER Then
        Call ViewerInput.BeginTimelineScrub(ViewerInputState)
    End If

    Call BeginPartyPreview()

    Result = ViewerTimelineEditing.ApplyCommand(
        Command, Value, ViewerInputState, Calibration,
        Character, Playback, Session.ProfileIndex,
        SwordWristNode, ShieldWristNode, CalibrationAvailable,
        ViewerUiState, ViewerGizmoState, ViewerCameraState, Effects,
        Pointer_X(), Window_Width())

    Call ApplyCalibrationEditingResult(Result)

End Sub

Sub UpdateTimelineKeyframeDrag()

    Session.Ready = ViewerTimelineEditing.UpdateKeyframeDrag(
        ViewerInputState,
        Calibration,
        Character,
        Playback.SelectedClip,
        Pointer_X(),
        Window_Width(),
        Effects
    ) And Session.Ready

End Sub

Sub FinishTimelineKeyframeDrag()

    Dim Result As ViewerCalibrationEditing.OperationResult

    Result = ViewerTimelineEditing.FinishKeyframeDrag(
        ViewerInputState,
        Calibration,
        Character,
        Playback.SelectedClip,
        Session.ProfileIndex,
        SwordWristNode,
        ShieldWristNode,
        CalibrationAvailable,
        ViewerUiState.CalibrationEditing,
        Effects
    )

    Call ApplyCalibrationEditingResult(Result)

End Sub

Sub ConfigureCalibration()

    Dim Configuration As ViewerCalibration.ConfigurationResult

    Call ViewerSession.ClearCharacterSwitchBlock(Session)

    Call ViewerUi.ResetCalibration(
        ViewerUiState,
        ViewerUi.CALIBRATION_TARGET_SWORD_WRIST,
        ViewerUi.CALIBRATION_AXIS_X,
        ViewerUi.CALIBRATION_TRANSFORM_ROTATE
    )
    Call ViewerGizmo.Reset(ViewerGizmoState)

    Configuration = ViewerCalibration.ConfigureForActor(
        Calibration,
        Session.ProfileIndex,
        Calibration.KeyBase,
        Character
    )
    CalibrationAvailable = Configuration.Available
    SwordWristNode = Configuration.SwordWristNode
    ShieldWristNode = Configuration.ShieldWristNode

End Sub

Sub HandleCalibrationImport()

    Dim Result As ViewerCalibrationEditing.OperationResult

    Call BeginPartyPreview()

    Call ViewerPlayback.PauseForCalibration(Playback, Party.Enabled)

    Result = ViewerCalibrationEditing.ImportOrCommit(
        Calibration, Character, Playback.SelectedClip, Session.ProfileIndex,
        SwordWristNode, ShieldWristNode, CalibrationAvailable,
        ViewerUiState, Effects)

    Call ApplyCalibrationEditingResult(Result)

End Sub

Sub UpdateCalibrationForCurrentFrame()

    Call ViewerCalibrationEditing.EvaluateCurrent(
        Calibration,
        Character,
        Playback.SelectedClip,
        Session.ProfileIndex,
        ViewerUiState.CalibrationEditing,
        CalibrationAvailable
    )

End Sub

Sub ApplyWristCalibration()

    Session.Ready = ViewerCalibration.ApplyWristOffsets(
        Calibration,
        Character,
        Playback.SelectedClip,
        SwordWristNode,
        ShieldWristNode,
        CalibrationAvailable
    ) And Session.Ready

End Sub

Sub ApplyEquipmentCoupling()

    Session.Ready = ViewerCalibration.ApplyEquipmentCoupling(
        Calibration,
        Character,
        Playback.SelectedClip,
        Effects.SwordGlow,
        Effects.ShieldGlow,
        Effects.EpicGlowAvailable
    ) And Session.Ready

End Sub

Sub ApplyEquipmentCalibration()

    Dim Application As ViewerCalibration.ApplicationResult
    Dim FailureStage As Number

    Application = ViewerCalibration.ApplyEquipmentTransforms(
        Calibration,
        Character,
        Playback.SelectedClip,
        Effects.SwordGlow,
        Effects.ShieldGlow,
        Effects.EpicGlowAvailable,
        Effects.EpicGlowVisible
    )
    Session.Ready = Application.Ready And Session.Ready

    If Not Session.Ready Then

        FailureStage = Application.FailureStage

        If FailureStage = 0 Then
            FailureStage = 71
        End If

        Call ViewerSession.CaptureFailure(Session, FailureStage)

    End If

End Sub

Sub ApplyCalibrationEditingResult(
    Result As ViewerCalibrationEditing.OperationResult)

    Session.Ready = Result.Ready And Session.Ready

    If (Result.Applied And
        Not Session.Ready And
        Result.FailureStage <> 0) Then
        Call ViewerSession.CaptureFailure(Session, Result.FailureStage)
    End If

    If Result.Finished Then
        Call ViewerSession.ClearCharacterSwitchBlock(Session)
    End If

End Sub

Sub BeginCalibrationEdit()

    If ViewerUiState.CalibrationEditing Then
        Return
    End If

    Call BeginPartyPreview()
    Call ViewerCalibrationEditing.BeginEdit(
        Calibration, Character, Playback.SelectedClip,
        ViewerUiState, ViewerCameraState, Effects)

End Sub

Sub CancelCalibrationEdit()

    Dim Result As ViewerCalibrationEditing.OperationResult

    Result = ViewerCalibrationEditing.CancelEdit(
        Calibration, Character, Playback.SelectedClip,
        SwordWristNode, ShieldWristNode, CalibrationAvailable,
        ViewerUiState, ViewerGizmoState, ViewerCameraState, Effects)

    Call ApplyCalibrationEditingResult(Result)

End Sub

Sub SetCurrentCalibrationValue(Value As Number)

    Dim Result As ViewerCalibrationEditing.OperationResult

    If Not ViewerUiState.CalibrationEditing Then
        Call BeginPartyPreview()
    End If

    Result = ViewerCalibrationEditing.SetCurrentValue(
        Calibration, Character, Playback.SelectedClip,
        SwordWristNode, ShieldWristNode, CalibrationAvailable,
        ViewerUiState, ViewerGizmoState, ViewerCameraState, Effects, Value)

    Call ApplyCalibrationEditingResult(Result)

End Sub

Sub SaveCalibrationFrame()

    Dim Result As ViewerCalibrationEditing.OperationResult

    If Calibration.StorageRejected Then
        Return
    End If

    If Not ViewerUiState.CalibrationEditing Then
        Call BeginPartyPreview()
    End If

    Result = ViewerCalibrationEditing.SaveCurrentFrame(
        Calibration, Character, Playback.SelectedClip,
        ViewerUiState, ViewerGizmoState, ViewerCameraState, Effects)

    Call ApplyCalibrationEditingResult(Result)

End Sub

Sub PlaySelectedClip(Optional RetainFireTails As Boolean = False)

    ''' Explicit editor navigation is a cut, not a corrected-pose cross-fade.
    ''' Automatic demo changes keep existing fire but never inherit across the cut.

    If Not RetainFireTails Then
    Call ViewerEffects.InvalidateVisualHistory(Effects)
    End If

    Session.Ready = ViewerPlayback.StartSelectedClip(
        Playback, Character, Session.ProfileIndex) And Session.Ready

    Call ViewerEffects.ResetArinAudio(Effects)

    Call UpdateCalibrationForCurrentFrame()
    Call ApplyWristCalibration()

    If Effects.EpicGlowAvailable Then
        Call ViewerEffects.ResetEpicGlowTrails(Effects, Character)
    End If

End Sub

Sub DrawViewerOverlay()

    Call BeginPartyInspector()

    If (ViewerUiState.Visibility = 0 And
        CalibrationAvailable And
        ViewerUiState.CalibrationVisible And
        ViewerGizmoState.Visible) Then

        Call UpdateTransformGizmo()

        ViewerGizmoState.HoverAxis = ViewerGizmo.AxisAtPointer(
            ViewerGizmoState,
            Pointer_X(),
            Pointer_Y(),
            Pointer_Inside(),
            90,
            Window_Height() - 100,
            ViewerUi.StatusPanelX(Window_Width()),
            ViewerUi.CALIBRATION_PANEL_X,
            ViewerUi.CALIBRATION_PANEL_Y,
            ViewerUi.CALIBRATION_PANEL_WIDTH,
            ViewerUi.CALIBRATION_PANEL_HEIGHT,
            ViewerUiState.CalibrationTransform,
            ViewerUiState.CalibrationAxis,
            ViewerCameraState.Live,
            Window_Width(),
            Window_Height()
        )

        Call ViewerGizmo.Draw(
            ViewerGizmoState,
            ViewerUiState.CalibrationTransform,
            ViewerUiState.CalibrationAxis,
            ViewerCameraState.Live,
            Window_Width(),
            Window_Height()
        )

    End If

    Call DrawInspectorOverlay()
    Call EndPartyInspector()

End Sub

Sub DrawInspectorOverlay()

    Dim DragonTargetsArin As Boolean

    If ViewerUiState.Visibility = 2 Then
        Return
    End If

    If ViewerUi.LayoutTooSmall(Window_Width(), Window_Height()) Then
        Call ViewerUi.DrawMinimumSizeNotice(Window_Width(), Window_Height())

        Return
    End If

    Call ViewerInspectorPresentation.DrawIdentityAndToolbar(
        ViewerUiState.Visibility,
        ActiveProfile.DisplayName,
        ActiveProfile.PartyRole,
        Party.Enabled,
        Session.SelectedCharacterTab,
        Window_Width(),
        Window_Height(),
        ViewerProfiles.INCLUDE_DIAGNOSTIC_PROFILES,
        Rendering.SocketGizmosVisible,
        Effects.EpicGlowVisible,
        ViewerUi.DragonLabel(Session.DragonInspection,
            DragonState.Available, DragonState.Visible),
        DragonState.Visible,
        ViewerUi.BackgroundLabel(Rendering.BackgroundIndex),
        Rendering.BackgroundIndex > 0,
        CalibrationAvailable,
        ViewerUiState.CalibrationVisible,
        Equipment.SwordVisible,
        Equipment.ShieldVisible
    )

    If Party.Enabled And Not ViewerUiState.CalibrationVisible Then
        Call ViewerParty.DrawOverlay(
            Party,
            ViewerUiState.Visibility,
            Window_Height(),
            DragonState.Visible,
            Equipment.SwordVisible,
            Equipment.ShieldVisible,
            Rendering.FloorVisible Or Rendering.GridVisible,
            Rendering.BackgroundIndex > 0,
            Effects.EpicGlowVisible,
            Playback.ScenePaused,
            ViewerCameraState.AutoOrbit,
            Effects.FlamePaused,
            Effects.LightningPaused,
            ViewerUi.PlaybackLabel("Fire", Effects.FlamePaused, "Freeze"),
            ViewerUi.PlaybackLabel("Lightning", Effects.LightningPaused, "Freeze"),
            ViewerEffects.ShieldFireStyleLabel(Effects),
            Effects.ShieldFlameStyle,
            ViewerEffects.StormCaption(Effects),
            ViewerTiming.FramesPerSecond(FrameRate),
            Session.ViewerError,
            Session.FirstFailureStage,
            ViewerCameraState.Live
        )
    End If

    If ViewerUiState.Visibility = 0 Then

        Call ViewerInspectorPresentation.DrawStatusAndAnimation(
            Window_Width(),
            Window_Height(),
            Session.ProfileIndex,
            ActiveProfile.DisplayName,
            ActiveProfile.PartyRole,
            ViewerPlayback.SelectedClipLabel(
                Character, Playback, Session.ProfileIndex),
            ActiveProfile.CandidateVersion,
            Playback.PlaybackSpeed,
            Rendering.MaterialInspection,
            Graphics3D.DrawCallCount3D(),
            Graphics3D.SubmittedTriangleCount3D(),
            ViewerUi.DemoStatusLabel(
                Party.Enabled, Playback.ScenePaused, Playback.DemoEnabled),
            AnimationSecondsRemaining(),
            CharacterViewer.ZoomDegrees(ViewerCameraState.Zoom),
            ViewerTiming.FramesPerSecond(FrameRate),
            ViewerPlayback.PresentationIndexForRuntimeClip(
                Character, Session.ProfileIndex, Playback.SelectedClip),
            Character3D.ClipDuration(Character, Playback.SelectedClip),
            Character3D.ClipSampleRate(Character, Playback.SelectedClip),
            Character3D.ClipSampleCount(Character, Playback.SelectedClip),
            Character3D.ClipEventCount(Character, Playback.SelectedClip),
            Character3D.ClipCount(Character),
            Character3D.SocketCount(Character),
            Character3D.EventCount(Character),
            Party.Enabled,
            Playback.ScenePaused,
            Playback.DemoEnabled
        )

        DragonTargetsArin = ViewerParty.DragonTargetsPrimary(Party)

        Call ViewerInspectorPresentation.DrawEffectsAndCamera(
            Window_Width(),
            Window_Height(),
            Session.ProfileIndex,
            Rendering.FloorVisible Or Rendering.GridVisible,
            Effects.SwordFireVisible,
            Effects.ShieldFireVisible,
            ViewerEffects.StormStyleName(Effects),
            ViewerEffects.StormSceneComfortName(),
            ViewerUi.PlaybackLabel("Lightning", Effects.LightningPaused, "Freeze"),
            Effects.LightningPaused,
            DragonState.HeadTracking,
            DragonTargetsArin,
            Effects.SwordFireReady,
            ViewerUi.PlaybackLabel("Flames", Effects.FlamePaused, "Pause"),
            Not Effects.FlamePaused,
            ViewerEffects.ShieldFireStyleLabel(Effects),
            Effects.ShieldFlameStyle,
            ViewerCameraState.Controls.OrbitYaw,
            ViewerCameraState.Controls.OrbitPitch,
            CharacterViewer.ZoomDegrees(ViewerCameraState.Zoom),
            ZOOM_IN_LIMIT,
            ZOOM_OUT_LIMIT,
            ViewerCameraState.FitLocked
        )

    End If

    Call ViewerInspectorPresentation.DrawWorkspace(
        ViewerUiState,
        Character,
        Calibration,
        ViewerInputState,
        Playback.SelectedClip,
        ViewerPlayback.SelectedClipName(Character, Playback),
        ViewerPlayback.SelectedClipLabel(
            Character, Playback, Session.ProfileIndex),
        Playback.SelectedTimelineEvent,
        CalibrationAvailable,
        Window_Width(),
        Window_Height(),
        ViewerCalibration.CurrentAnimationFrame(
            Character, Playback.SelectedClip),
        ViewerCalibration.KeyIndex(
            Calibration,
            Playback.SelectedClip,
            ViewerCalibration.CurrentAnimationFrame(
                Character, Playback.SelectedClip)
        ),
        ViewerCalibrationEditing.CurrentValue(
            Calibration, Playback.SelectedClip, ViewerUiState),
        ViewerCalibration.MinimumValue(ViewerUiState.CalibrationTransform),
        ViewerCalibration.MaximumValue(ViewerUiState.CalibrationTransform),
        ViewerGizmoState.Visible,
        ViewerGizmoState.HoldGrip,
        ViewerGizmoState.GripLimit,
        Playback.ScenePaused,
        ViewerCalibration.ChannelValue(
            Calibration, Playback.SelectedClip, 18) <> 0,
        ViewerCalibration.ChannelValue(
            Calibration, Playback.SelectedClip, 19) <> 0,
        Calibration.TransferMessage,
        Session.CharacterSwitchBlocked,
        Party.Enabled,
        Session.ViewerError,
        Session.FirstViewerError,
        Session.FirstRendererError,
        Session.FirstFailureStage
    )

End Sub

Function ViewerTitle() As Text

    Dim Result As Text

    Result = "SMILE 2.0 - 3D Viewer, Animation Editor - " + ViewerProfiles.ModelFileName(Session.ProfileIndex)

    Return Result

End Function

Function AnimationSecondsRemaining() As Number

    Dim Result As Number

    If Party.Enabled Then
        Result = ViewerParty.PresentationSecondsRemaining(
            Party, Character, Party.Companion.Actor,
            Playback.PlaybackSpeed)
    Else
        Result = ViewerPlayback.DemoSecondsRemaining(
            Playback, Character, Session.ProfileIndex,
            ANIMATION_CYCLE_MILLISECONDS)
    End If

    Return Result

End Function

Sub DestroyViewer()

    Call DestroyViewerResources()
    Call Character3D.Shutdown()
    Call Scene3D.Shutdown()
    Call Graphics3D.ResetRenderer3D()

End Sub

Sub DestroyViewerResources()

    Call ViewerParty.DestroyParticipants(Party)
    Call ViewerDragon.Shutdown(DragonState, Effects.DragonLight)

    Session.Ready = ViewerEffects.ShutdownShared(Effects) And Session.Ready

    Call ViewerRendering.DestroyBackdrops(Rendering)
    Call ViewerEffects.DestroyEpicGlow(Effects)
    Call ViewerRendering.DestroySocketGizmos(Rendering)
    Call ViewerRendering.DestroyArena(Rendering)

    Call Character3D.Destroy(Character)

End Sub

Sub SelectCharacterTab(Index As Number)

    If Not ViewerSession.ShouldSelectCharacterTab(
        Session, Index, Party.Enabled) Then
        Return
    End If

    If (ViewerUiState.CalibrationEditing Or
        Calibration.ImportPending) Then
        Call ViewerSession.BlockCharacterSwitch(Session)

        Return
    End If

    Call CancelInteractionCaptures()

    Fill Rectangle 300, 120, Max(240, Window_Width() - 600), 44, Rgb(8, 16, 30)
    Draw Text "Loading Selected Character..." At 312, 132 Size 16 Color WHITE
    Show Screen

    Call DestroyViewerResources()

    Call ViewerSession.SelectCharacterTab(Session, Index)
    Call ViewerParty.SetEnabled(Party, Index = 3)

    Call ViewerSession.ResetFailure(Session)

    Call ViewerPlayback.PrepareCharacterSwitch(Playback)

    Call LoadViewer()

End Sub

Function CaptureActorContext() As ViewerActors.Context

    Dim Result As ViewerActors.Context

    Result = ViewerActors.Capture(
        Character,
        ViewerCameraState.Frame,
        Session.ProfileIndex,
        Playback.SelectedClip,
        Calibration.KeyBase,
        SwordWristNode,
        ShieldWristNode,
        Effects.SwordGlow,
        Effects.ShieldGlow,
        CalibrationAvailable,
        Effects.EpicGlowAvailable,
        Effects.EpicGlowVisible,
        Party.PrimaryPresentationState
    )

    Return Result

End Function

Sub UseActorContext(Context As ViewerActors.Context)

    Call ViewerActors.Apply(
        Context,
        Character,
        ViewerCameraState.Frame,
        Session.ProfileIndex,
        Playback.SelectedClip,
        Calibration.KeyBase,
        SwordWristNode,
        ShieldWristNode,
        Effects.SwordGlow,
        Effects.ShieldGlow,
        CalibrationAvailable,
        Effects.EpicGlowAvailable,
        Effects.EpicGlowVisible,
        Party.PrimaryPresentationState
    )

    ActiveProfile = ViewerProfiles.ProfileAt(Session.ProfileIndex)

End Sub

Sub BeginPartyInspector()

    Dim Binding As ViewerParty.InspectorBindingResult
    Dim WasVisible As Boolean

    If (Not Party.Enabled Or
        Not Party.Ready Or
        Session.ViewerError Or
        Party.UiBound) Then
        Return
    End If

    Binding = ViewerParty.BeginInspectorSelection(
        Party,
        CaptureActorContext(),
        Party.Turn,
        DragonState
    )

    If Not Binding.Bound Then
        Return
    End If

    Call UseActorContext(Binding.Context)

    If Calibration.OwnerProfile <> Session.ProfileIndex Then

        ''' One editing owner at a time. Never carry a pending import, Undo, or
        ''' clipboard into another character's independent storage identity.
        WasVisible = ViewerUiState.CalibrationVisible

        Call ConfigureCalibration()

        ViewerUiState.CalibrationVisible = WasVisible And CalibrationAvailable

        Call ViewerPlayback.RefreshSelectedTimelineEvent(
            Playback, Character)

    End If

End Sub

Sub EndPartyInspector()

    If Not Party.UiBound Then
        Return
    End If

    Call UseActorContext(ViewerParty.EndInspectorSelection(
        Party,
        CaptureActorContext(),
        DragonState
    ))

End Sub

Sub BeginPartyPreview()

    If Not Party.UiBound Then
        Return
    End If

    Call ViewerParty.BeginPreview(
        Party,
        Character,
        Playback.SelectedClip,
        Session.ProfileIndex
    )

    Call ViewerPlayback.PauseForPartyPreview(Playback)

End Sub

Sub RestorePartyPreview()

    If Not Party.PreviewActive Or Not Party.UiBound Then
        Return
    End If

    Session.Ready = ViewerParty.RestorePreview(
        Party,
        Character,
        Playback.SelectedClip,
        Playback.PlaybackSpeed
    ) And Session.Ready

    ViewerUiState.CalibrationVisible = False

    Call ViewerInput.CancelCaptures(ViewerInputState)

    Call UpdateCalibrationForCurrentFrame()
    Call ViewerEffects.InvalidateVisualHistory(Effects)

End Sub

Sub ResetPartyInspector()

    Call BeginPartyInspector()
    Call CancelCalibrationEdit()
    Call RestorePartyPreview()
    Call EndPartyInspector()

    If Session.ViewerError Then
        Call RetryViewer()
    Else

        Call ResetAll()
    End If

End Sub

Sub PositionDragonOpponents()

    Dim Center As Core.Vector3

    Center.X = ViewerDragon.PositionX()
    Center.Z = ViewerDragon.PositionZ()
    Session.Ready = ViewerParty.PlaceDragonInspectionParticipants(
        Party,
        Center,
        PARTY_FORMATION_RADIUS,
        PARTY_FORMATION_START_ANGLE,
        PARTY_FORMATION_END_ANGLE,
        CHARACTER_MODEL_FORWARD_YAW_OFFSET,
        ORIN_ARENA_YAW_ADJUSTMENT
    ) And Session.Ready

End Sub

Sub UpdateDragonOpponent()

    Dim Update As ViewerParty.ParticipantUpdateResult

    Update = ViewerParty.UpdateDragonOpponent(
        Party,
        Calibration,
        Effects,
        Playback.AnimationUpdateElapsed,
        ViewerUiState.CalibrationEditing,
        Equipment.SwordVisible,
        Equipment.ShieldVisible,
        Playback.ScenePaused,
        ViewerPlayback.ClipLabel(
            Party.DragonOpponent.Actor,
            Party.DragonOpponent.Profile,
            Party.DragonOpponent.Clip
        ),
        ViewerCameraState.Live,
        Timing.CameraElapsed
    )

    Session.Ready = Update.Ready And Session.Ready

    If Update.Updated And Not Session.Ready Then
        Call CapturePartyParticipantFailure(Update.FailureStage)
    End If

End Sub

Sub ResetPartyDemo()

    Dim Center As Core.Vector3
    Dim FirstApproach As Core.Vector3
    Dim SecondApproach As Core.Vector3

    Call ViewerPlayback.EnablePartyDemo(Playback)

    ViewerUiState.CalibrationVisible = False
    Center.X = ViewerDragon.PositionX()
    Center.Z = ViewerDragon.PositionZ()
    FirstApproach.X = -21
    FirstApproach.Z = -44
    SecondApproach.X = -49
    SecondApproach.Z = 4

    ''' Only one hero approaches at a time; animated full-model bounds must not move these shots.

    Session.Ready = ViewerParty.ResetDemo(
        Party,
        Center,
        PARTY_FORMATION_RADIUS,
        PARTY_FORMATION_START_ANGLE,
        PARTY_FORMATION_END_ANGLE,
        FirstApproach,
        SecondApproach,
        ORIN_ARENA_YAW_ADJUSTMENT,
        Equipment.SwordVisible,
        Equipment.ShieldVisible
    ) And Session.Ready

End Sub

Sub AdvancePartyDemo()

    Session.Ready = ViewerParty.AdvanceDemo(
        Party,
        Playback.AnimationUpdateElapsed,
        Playback.DemoEnabled,
        Playback.ScenePaused,
        Playback.PlaybackSpeed,
        Character,
        ViewerCameraState.Frame,
        Playback.SelectedClip,
        ViewerDragon.PositionX(),
        0,
        ViewerDragon.PositionZ(),
        CHARACTER_MODEL_FORWARD_YAW_OFFSET
    ) And Session.Ready

End Sub

Sub UpdatePartyCompanion()

    Dim Update As ViewerParty.ParticipantUpdateResult

    If Not Party.Ready Then
        Return
    End If

    Update = ViewerParty.UpdateCompanion(
        Party,
        Calibration,
        Effects,
        Playback.AnimationUpdateElapsed,
        ViewerUiState.CalibrationEditing
    )
    Session.Ready = Update.Ready And Session.Ready

    If Update.Updated And Not Session.Ready Then
        Call CapturePartyParticipantFailure(Update.FailureStage)
    End If

End Sub

Sub CapturePartyParticipantFailure(FailureStage As Number)

    If FailureStage = 0 Then
        FailureStage = 71
    End If

    Call ViewerSession.CaptureFailure(Session, FailureStage)

End Sub

Function HandlePartyPointer() As Boolean

    Dim ReturnValue2 As Boolean

    Dim ReturnValue As Boolean

    Dim CapturesActive As Boolean
    Dim Decision As ViewerParty.PointerDecision
    Dim InspectorResult As ViewerInspectorCommands.OperationResult

    CapturesActive = ViewerInput.HasInterfaceCapture(
        ViewerInputState, ViewerGizmoState.Dragging)
    Decision = ViewerParty.ClassifyPointer(
        Pointer_X(),
        Pointer_Y(),
        Pointer_Pressed(POINTER_PRIMARY),
        Pointer_Pressed(POINTER_SECONDARY),
        ViewerUiState.Visibility,
        ViewerUiState.CalibrationVisible,
        CapturesActive,
        Window_Height(),
        ViewerUi.StatusPanelX(Window_Width()),
        ViewerUi.GlowButtonX(Window_Width(),
            ViewerProfiles.INCLUDE_DIAGNOSTIC_PROFILES, Party.Enabled),
        ViewerUi.GlowButtonWidth(
            ViewerProfiles.INCLUDE_DIAGNOSTIC_PROFILES, Party.Enabled)
    )

    InspectorResult = ViewerInspectorCommands.ApplyPartyPresentationAction(
        Decision.Action, Rendering, BACKGROUND_COUNT,
        Effects, ViewerCameraState, DragonState)

    If InspectorResult.Handled Then

        Session.Ready = InspectorResult.Ready And Session.Ready

        ReturnValue2 = Decision.Consumed

        Return ReturnValue2

    End If

    If ApplyActorPresentationCommand(
        Decision.Action,
        ViewerInspectorCommands.ACTOR_ACTION_SOURCE_PARTY_POINTER) Then
        ReturnValue2 = Decision.Consumed

        Return ReturnValue2
    End If

    If Decision.Action = ViewerParty.POINTER_ACTION_RESET_VIEW Then

        Call ResetView()

    Else If Decision.Action = ViewerParty.POINTER_ACTION_RESET_INSPECTOR Then

        Call ResetPartyInspector()

    Else If Decision.Action = ViewerParty.POINTER_ACTION_SPEED_DOWN Then

        Call AdjustPlaybackSpeed(-25)

    Else If Decision.Action = ViewerParty.POINTER_ACTION_SPEED_UP Then

        Call AdjustPlaybackSpeed(25)

    Else If Decision.Action = ViewerParty.POINTER_ACTION_TOGGLE_PAUSE Then

        Call BeginPartyInspector()
        Call ToggleScenePause()
        Call EndPartyInspector()

    Else If Decision.Action = ViewerParty.POINTER_ACTION_RESTART Then

        Call ResetPartyInspector()

    End If

    ReturnValue = Decision.Consumed

    Return ReturnValue

End Function
