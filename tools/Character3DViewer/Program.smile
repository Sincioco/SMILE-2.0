Sub DrawCameraSlider(
    Label As Text,
    Y As Number,
    Value As Number,
    MinimumValue As Number,
    MaximumValue As Number
)

    Dim KnobX As Number
    Dim PanelLeft As Number
    Dim ProgressWidth As Number

    PanelLeft = StatusPanelX()
    ProgressWidth = (Value - MinimumValue) * CAMERA_SLIDER_WIDTH / Max(1, MaximumValue - MinimumValue)
    ProgressWidth = Min(CAMERA_SLIDER_WIDTH, Max(0, ProgressWidth))
    KnobX = PanelLeft + 76 + ProgressWidth

    Draw Text Label At PanelLeft + 12, Y + 2 Size 11 Color LIGHT_GRAY

    Call UI.DrawSlider(PanelLeft + 76, Y, CAMERA_SLIDER_WIDTH, CAMERA_SLIDER_HEIGHT,
        Value, MinimumValue, MaximumValue)

    Draw Number Value At PanelLeft + 226, Y + 2 Size 10 Color CYAN

End Sub

Sub DrawCalibrationPanel()

    Dim CurrentFrame As Number
    Dim CurrentKeyframe As Number
    Dim KnobX As Number
    Dim MaximumValue As Number
    Dim MinimumValue As Number
    Dim ProgressWidth As Number
    Dim SliderRange As Number
    Dim Value As Number

    CurrentFrame = CurrentAnimationFrame()
    CurrentKeyframe = CalibrationKeyframeIndex(Playback.SelectedClip, CurrentFrame)
    Value = CurrentCalibrationValue()
    MinimumValue = CalibrationMinimumValue()
    MaximumValue = CalibrationMaximumValue()
    SliderRange = MaximumValue - MinimumValue
    ProgressWidth = (Value - MinimumValue) * CALIBRATION_SLIDER_WIDTH / SliderRange
    KnobX = CALIBRATION_SLIDER_X + ProgressWidth

    Call UI.DrawPanel(CALIBRATION_PANEL_X, CALIBRATION_PANEL_Y, CALIBRATION_PANEL_WIDTH, CALIBRATION_PANEL_HEIGHT, 90)

    Draw Text "Pose Calibration" At 32, 102 Size 16 Color WHITE
    Draw Text SelectedClipLabel() At 174, 104 Size 12 Color CYAN

    Call DrawButton(292, 96, 68, 22, "Prev Key", False)
    Call DrawButton(364, 96, 68, 22, "Next Key", False)

    Call DrawButton(34, 128, 92, 24, "Weapon Wrist", ViewerUiState.CalibrationTarget = CALIBRATION_TARGET_SWORD_WRIST)
    Call DrawButton(130, 128, 96, 24, "Shield Wrist", ViewerUiState.CalibrationTarget = CALIBRATION_TARGET_SHIELD_WRIST)
    Call DrawButton(230, 128, 76, 24, "Weapon", ViewerUiState.CalibrationTarget = CALIBRATION_TARGET_SWORD)
    Call DrawButton(310, 128, 76, 24, "Shield", ViewerUiState.CalibrationTarget = CALIBRATION_TARGET_SHIELD)
    Call DrawButton(34, 158, 48, 24, "X", ViewerUiState.CalibrationAxis = CALIBRATION_AXIS_X)
    Call DrawButton(86, 158, 48, 24, "Y", ViewerUiState.CalibrationAxis = CALIBRATION_AXIS_Y)
    Call DrawButton(138, 158, 48, 24, "Z", ViewerUiState.CalibrationAxis = CALIBRATION_AXIS_Z)
    Call DrawButton(202, 158, 72, 24, "Rotate", ViewerUiState.CalibrationTransform = CALIBRATION_TRANSFORM_ROTATE)
    Call DrawButton(278, 158, 72, 24, "Move", ViewerUiState.CalibrationTransform = CALIBRATION_TRANSFORM_MOVE)
    Call DrawButton(354, 158, 78, 24, "Reset", False)

    Draw Text CalibrationTargetLabel() At 34, 187 Size 12 Color LIGHT_GRAY
    Draw Text CalibrationTransformLabel() At 142, 187 Size 12 Color CYAN
    Draw Text CalibrationAxisLabel() At 208, 187 Size 12 Color CYAN
    Draw Number Value At 230, 187 Size 12 Color WHITE
    Draw Text CalibrationUnitLabel() At 274, 187 Size 11 Color LIGHT_GRAY

    Call UI.DrawSlider(CALIBRATION_SLIDER_X, CALIBRATION_SLIDER_Y,
        CALIBRATION_SLIDER_WIDTH, CALIBRATION_SLIDER_HEIGHT, Value, MinimumValue, MaximumValue, 6)

    If ViewerGizmoState.Visible Then
        Draw Text "G Move  •  R/E Rotate  •  X/Y/Z Constrain" At 34, 232 Size 11 Color WHITE
        Draw Text "Enter Confirm/Save  •  Esc Cancel  •  Drag Colored Handles" At 34, 248 Size 10 Color LIGHT_GRAY
    Else

        Draw Text "Numeric Controls  •  X/Y/Z Select Axis" At 34, 232 Size 11 Color WHITE
        Draw Text "Enter Save  •  Esc Cancel  •  Show Gizmo For Mouse Handles" At 34, 248 Size 10 Color LIGHT_GRAY
    End If

    Call DrawButton(34, 268, 80, 24, "Copy Key", CurrentKeyframe >= 0 And Not ViewerUiState.CalibrationEditing)
    Call DrawButton(118, 268, 80, 24, "Paste Key", Calibration.ClipboardAvailable And Not ViewerUiState.CalibrationEditing)
    Call DrawButton(202, 268, 90, 24, "Delete Key", CurrentKeyframe >= 0 And Not ViewerUiState.CalibrationEditing)

    If ViewerGizmoState.Visible Then
        Call DrawButton(300, 268, 132, 24, "Hide Gizmo", True)
    Else

        Call DrawButton(300, 268, 132, 24, "Show Gizmo", False)
    End If

    Call DrawButton(34, 298, 100, 24, "Reload Key", CurrentKeyframe >= 0)
    Call DrawButton(140, 298, 100, 24, "In Place", ViewerGizmoState.HoldGrip)
    Call DrawButton(246, 298, 186, 24, "Undo Last Change", Calibration.UndoCount > 0)
    Call DrawButton(34, 374, 194, 24, "Decouple Weapon", CalibrationChannelValue(Playback.SelectedClip, 18) <> 0)
    Call DrawButton(236, 374, 196, 24, "Decouple Shield", CalibrationChannelValue(Playback.SelectedClip, 19) <> 0)

    Call DrawButton(34, 412, 196, 24, CalibrationResetClipLabel(), ViewerUiState.CalibrationClearConfirm)
    Call DrawButton(332, 412, 100, 24, "Save Frame", CurrentKeyframe >= 0 And Not ViewerUiState.CalibrationEditing)
    Call DrawButton(244, 412, 84, 24, "Cancel", ViewerUiState.CalibrationEditing)

    Fill Rectangle 34, 412, 196, 2, Rgb(210, 70, 76) Opacity 90
    Fill Rectangle 34, 434, 196, 2, Rgb(210, 70, 76) Opacity 90
    Fill Rectangle 34, 412, 2, 24, Rgb(210, 70, 76) Opacity 90
    Fill Rectangle 228, 412, 2, 24, Rgb(210, 70, 76) Opacity 90

    If Calibration.StorageRejected Then

        Draw Text "Storage blocked; no saved data replaced. See status." At 34, 330 Size 10 Color YELLOW

    Else If Calibration.WriteFailed Then

        Draw Text "Save failed; previous keys kept. Retry or Cancel." At 34, 330 Size 10 Color YELLOW

    Else If ViewerUiState.CalibrationClearConfirm Then

        Draw Text "Delete saved keys for:" At 34, 330 Size 10 Color YELLOW
        Draw Text SelectedClipName() At 188, 330 Size 10 Color WHITE
        Draw Number ViewerCalibration.KeyCount(Calibration, Playback.SelectedClip) At 350, 330 Size 10 Color YELLOW

    Else If ViewerGizmoState.GripLimit Then

        Draw Text "In Place reached the saved position limit" At 34, 330 Size 10 Color YELLOW

    Else If ViewerUiState.CalibrationEditing Then

        If Playback.ScenePaused Then
            Draw Text "Editing — movement paused by Space" At 34, 330 Size 11 Color YELLOW
        Else
            Draw Text "Editing live — Space pauses movement" At 34, 330 Size 11 Color YELLOW
        End If

    Else
        Draw Text "In Place: rotate equipment without shifting its grip" At 34, 330 Size 10 Color LIGHT_GRAY

    End If

    If Calibration.SaveLimitReached Then

        Draw Text "Keyframe limit reached" At 34, 350 Size 11 Color YELLOW

    Else
        Draw Text "Keys" At 34, 350 Size 11 Color LIGHT_GRAY
        Draw Number ViewerCalibration.KeyCount(Calibration, Playback.SelectedClip) At 68, 350 Size 11 Color CYAN

        If ViewerUiState.CalibrationEditing Then
            Draw Text "Editing frame" At 104, 350 Size 11 Color YELLOW
            Draw Number ViewerUiState.CalibrationEditingFrame At 200, 350 Size 11 Color WHITE
        Else
            Draw Text "Current frame" At 104, 350 Size 11 Color LIGHT_GRAY
            Draw Number CurrentFrame At 200, 350 Size 11 Color WHITE
        End If

        If CurrentKeyframe >= 0 Then
            Draw Text "KEYED" At 230, 350 Size 11 Color GREEN
        End If

    End If

End Sub

