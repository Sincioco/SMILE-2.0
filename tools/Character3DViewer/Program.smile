Function TimelineWidth() As Number

    Dim Result As Number

    Result = Max(120, StatusPanelX() - TIMELINE_LEFT - 20)
    Return Result

End Function

Sub DrawTimeline()

    Dim Duration As Number
    Dim EventIndex As Number
    Dim EventTime As Number
    Dim Keyframe As Number
    Dim KeyframeFrame As Number
    Dim KeyframeTime As Number
    Dim MarkerX As Number
    Dim ProgressWidth As Number
    Dim TimelineY As Number
    Dim Width As Number

    Duration = Max(1, Character3D.ClipDuration(Character, Playback.SelectedClip))
    TimelineY = Window_Height() - 64
    Width = TimelineWidth()
    ProgressWidth = Character3D.AnimationTime(Character) * Width / Duration

    Call DrawButton(TIMELINE_LEFT, Window_Height() - 96, 62, 24, "0-Frame", False)
    Call DrawButton(TIMELINE_LEFT + 68, Window_Height() - 96, 62, 24, "< Key", False)
    Call DrawButton(TIMELINE_LEFT + 136, Window_Height() - 96, 62, 24, "Key >", False)
    Call DrawButton(TIMELINE_LEFT + 204, Window_Height() - 96, 62, 24, "< Frame", ViewerInputState.FrameButtonRepeatDirection < 0)
    Call DrawButton(TIMELINE_LEFT + 272, Window_Height() - 96, 62, 24, "Frame >", ViewerInputState.FrameButtonRepeatDirection > 0)

    Draw Text SelectedClipName() At TIMELINE_LEFT + 348, Window_Height() - 88 Size 11 Color CYAN

    If Playback.SelectedTimelineEvent > 0 Then

        Draw Text Character3D.EventName(Character, Playback.SelectedTimelineEvent) At TIMELINE_LEFT + 518, Window_Height() - 88 Size 11 Color YELLOW
        Draw Number Character3D.EventTime(Character, Playback.SelectedTimelineEvent) At TIMELINE_LEFT + 616, Window_Height() - 88 Size 11 Color WHITE
        Draw Number Character3D.EventValue(Character, Playback.SelectedTimelineEvent) At TIMELINE_LEFT + 672, Window_Height() - 88 Size 11 Color CYAN

    Else
        Draw Text "No authored event" At TIMELINE_LEFT + 518, Window_Height() - 88 Size 11 Color LIGHT_GRAY

    End If

    Fill Rectangle TIMELINE_LEFT, TimelineY, Width, TIMELINE_HEIGHT, Rgb(18, 35, 58) Opacity 88
    Fill Rectangle TIMELINE_LEFT, TimelineY, ProgressWidth, TIMELINE_HEIGHT, Rgb(16, 102, 136) Opacity 90

    For EventIndex = 1 To Character3D.EventCount(Character)

        If Character3D.EventClipIndex(Character, EventIndex) = Playback.SelectedClip Then

            EventTime = Character3D.EventTime(Character, EventIndex)
            MarkerX = TIMELINE_LEFT + EventTime * Width / Duration

            Fill Rectangle MarkerX, TimelineY - 3, 2, TIMELINE_HEIGHT + 6, YELLOW Opacity 100

        End If

    End For

    If CalibrationAvailable Then

        For Keyframe = 0 To ViewerCalibration.KeyCount(Calibration, Playback.SelectedClip) - 1

            KeyframeFrame = ViewerCalibration.KeyFrame(Calibration, Playback.SelectedClip, Keyframe)

            If (ViewerInputState.TimelineKeyframeDragging And
                Keyframe = ViewerInputState.TimelineDraggedKeyframe) Then
                KeyframeFrame = ViewerInputState.TimelineDraggedTargetFrame
            End If

            KeyframeTime = CalibrationFrameTimeMilliseconds(
                Playback.SelectedClip,
                KeyframeFrame
            )
            MarkerX = TIMELINE_LEFT + KeyframeTime * Width / Duration

            Fill Rectangle MarkerX - 1, TimelineY - 5, 3, TIMELINE_HEIGHT + 10, GREEN Opacity 100
        End For

    End If

    Draw Number Character3D.AnimationTime(Character) At TIMELINE_LEFT + 6, TimelineY + 3 Size 10 Color WHITE
    Draw Number Duration At TIMELINE_LEFT + Width - 48, TimelineY + 3 Size 10 Color WHITE

    If CalibrationAvailable Then

        If Calibration.ImportPending Then
            Call DrawButton(TIMELINE_LEFT, Window_Height() - 43,
                CALIBRATION_IMPORT_WIDTH, 18, "Replace Keys?", True)
        Else

            Call DrawButton(TIMELINE_LEFT, Window_Height() - 43,
                CALIBRATION_IMPORT_WIDTH, 18, "Import Key Frames", False)
        End If

        Call DrawButton(TIMELINE_LEFT + CALIBRATION_DOWNLOAD_OFFSET, Window_Height() - 43,
            CALIBRATION_DOWNLOAD_WIDTH, 18, "Download Key Frames", False)

        Draw Text Calibration.FileLabel At TIMELINE_LEFT + CALIBRATION_FILENAME_OFFSET, Window_Height() - 39 Size 9 Color LIGHT_GRAY

        If (Text_Width(Calibration.TransferMessage, 9) <=
            Width - CALIBRATION_TRANSFER_TEXT_OFFSET) Then
            Draw Text Calibration.TransferMessage At TIMELINE_LEFT + CALIBRATION_TRANSFER_TEXT_OFFSET, Window_Height() - 39 Size 9 Color CYAN
        End If

    End If

End Sub

