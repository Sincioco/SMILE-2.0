''' Standalone window and frame-loop owner for the shared Viewer workflow.

Option Explicit

Import Smile.Tools.Character3DViewerWorkflow As ViewerWorkflow
Import Smile.Tools.Character3DViewerProfiles As Profiles

Dim Viewer As New ViewerWorkflow.Session()
Dim Key As Number

Game Window "SMILE 2.0 - 3D Viewer, Animation Editor" Size 1600 By 640

Call Viewer.Start(Profiles.CHARACTER_TAB_PARTY_VRAX, False, Window_Width(), Window_Height())

Do

    Get Key Key

    Call Viewer.StandaloneInput(Key)
    Call Viewer.UpdateFrame(Window_Width(), Window_Height())
    Call Viewer.DrawFrame()
    Call Viewer.DrawStandaloneOverlay()

    Show Screen

Loop Until Game_Closed()

Call Viewer.Release()
