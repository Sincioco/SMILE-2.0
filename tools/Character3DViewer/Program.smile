Dim OrinLight As LightPool3D.Lease
Dim DragonLight As LightPool3D.Lease
Dim DragonFireFailed As Boolean
Dim DragonReactionPending As Boolean
Dim DragonAvailable As Boolean
Dim DragonVisible As Boolean
Dim SwordVisible As Boolean
Dim ShieldVisible As Boolean
Dim CalibrationAvailable As Boolean
Dim CalibrationVisible As Boolean
Dim CalibrationTarget As Number
Dim CalibrationAxis As Number
Dim CalibrationTransform As Number
Dim SwordWristCalibration[128, CALIBRATION_AXIS_COUNT] As Number
Dim ShieldWristCalibration[128, CALIBRATION_AXIS_COUNT] As Number
Dim SwordCalibration[128, CALIBRATION_AXIS_COUNT] As Number
Dim ShieldCalibration[128, CALIBRATION_AXIS_COUNT] As Number
Dim SwordPositionCalibration[128, CALIBRATION_AXIS_COUNT] As Number
Dim ShieldPositionCalibration[128, CALIBRATION_AXIS_COUNT] As Number
Dim CalibrationKeyframeCounts[128] As Number
Dim CalibrationKeyframeFrames[128, CALIBRATION_MAX_KEYFRAMES] As Number
Dim CalibrationKeyframeValues[128, CALIBRATION_KEYFRAME_VALUES_PER_CLIP] As Number
Dim CalibrationStorage[CALIBRATION_STORAGE_CAPACITY] As Number
Dim CalibrationStorageCount As Number
Dim CalibrationStorageRejected As Boolean
Dim CalibrationPersistenceStatus As Number
Dim CalibrationWriteFailed As Boolean
Dim CalibrationPreviousStorage[CALIBRATION_STORAGE_CAPACITY] As Number
Dim CalibrationUndoStorage[CALIBRATION_STORAGE_CAPACITY] As Number
Dim CalibrationUndoCount As Number
Dim CalibrationUndoApplying As Boolean
Dim CalibrationSaved As Boolean
Dim CalibrationSavedClip As Number
Dim CalibrationSavedTime As Number
Dim CalibrationSavedFrame As Number
Dim CalibrationSaveLimitReached As Boolean
