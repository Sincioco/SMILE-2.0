''' Reusable SM3D character inspection project. Arin is the included sample asset.

Option Explicit

Import Smile.Simple3D.Character3D As Character3D
Import Smile.Simple3D.CharacterViewer As CharacterViewer
Import Smile.UI.Controls As UI
Import Smile.Simple3D.Arena3D As Arena3D
