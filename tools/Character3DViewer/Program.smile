Sub DrawButton(X As Number, Y As Number, Width As Number, Height As Number,
    Label As Text, Selected As Boolean)

    Call UI.DrawButton(X, Y, Width, Height, Label, Selected)

End Sub

Sub DestroyViewer()

    Call DestroyViewerResources()
    Call Character3D.Shutdown()
    Call Scene3D.Shutdown()
    Call Graphics3D.ResetRenderer3D()

End Sub

Sub DestroyViewerResources()

    Dim Index As Number

    Call DestroyPartyCompanion()
    Call Graphics3D.DestroyObject3D(DragonOpponent.WeaponGlow)
    Call Graphics3D.DestroyObject3D(DragonOpponent.ShieldGlow)
    Call Character3D.Destroy(DragonOpponent.Actor)
    Call DestroyDragon()
    Call DragonPresence.Shutdown()
    Call OrinStorm.Shutdown()
    Call Lightning.Shutdown()
    Call Fire.Shutdown()

    If LightPool3D.IsValid(OrinLight) Then
        Session.Ready = LightPool3D.Release(OrinLight) And Session.Ready
    End If

    If LightPool3D.IsValid(DragonLight) Then
        Session.Ready = LightPool3D.Release(DragonLight) And Session.Ready
    End If

    Call LightPool3D.Shutdown()

    SwordFire.Slot = 0
    SwordFireReady = False

    For Index = 0 To 2
        ShieldFire[Index].Slot = 0
    End For

    Call DestroyBackdrop()
    Call DestroyEpicGlow()
    Call DestroySocketGizmos()
    Call DestroyStudioGrid()

    Call Character3D.Destroy(Character)

End Sub

Sub SelectCharacterTab(Index As Number)

    If (Index = Session.SelectedCharacterTab And
        Not Session.ViewerError And
        (PartyMode Or Session.DragonInspection Or ViewerProfiles.IsPartyCharacter(Session.ProfileIndex))) Then
        Return
    End If

    If (ViewerUiState.CalibrationEditing Or
        Calibration.ImportPending) Then
        Session.CharacterSwitchBlocked = True
        Return
    End If

    Call CancelInteractionCaptures()

    Fill Rectangle 300, 120, Max(240, Window_Width() - 600), 44, Rgb(8, 16, 30)
    Draw Text "Loading Selected Character..." At 312, 132 Size 16 Color WHITE
    Show Screen

    Call DestroyViewerResources()

    Session.SelectedCharacterTab = Index
    PartyMode = Index = 3
    Session.DragonInspection = Index = 2
    Session.ProfileIndex = ViewerProfiles.PROFILE_ARIN

    If Index = 1 Then
        Session.ProfileIndex = ViewerProfiles.PROFILE_ORIN
    Else If Index = 2 Then
        Session.ProfileIndex = ViewerProfiles.PROFILE_DRAGON
    End If

    Call ViewerSession.ResetFailure(Session)

    Playback.DemoEnabled = True
    Playback.ScenePaused = False

    Call LoadViewer()

End Sub

Function CaptureActorContext() As ViewerActorContext

    Dim Result As ViewerActorContext

    Result.Actor = Character
    Result.Frame = ViewerCameraState.Frame
    Result.Profile = Session.ProfileIndex
    Result.Clip = Playback.SelectedClip
    Result.KeyBase = Calibration.KeyBase
    Result.WeaponWrist = SwordWristNode
    Result.ShieldWrist = ShieldWristNode
    Result.WeaponGlow = SwordGlow
    Result.ShieldGlow = ShieldGlow
    Result.CalibrationAvailable = CalibrationAvailable
    Result.GlowAvailable = EpicGlowAvailable
    Result.GlowVisible = EpicGlowVisible
    Result.PresentationState = PresentationState

    Return Result

End Function

Sub UseActorContext(Context As ViewerActorContext)

    Character = Context.Actor
    ViewerCameraState.Frame = Context.Frame
    Session.ProfileIndex = Context.Profile
    ActiveProfile = ViewerProfiles.ProfileAt(Session.ProfileIndex)
    Playback.SelectedClip = Context.Clip
    Calibration.KeyBase = Context.KeyBase
    SwordWristNode = Context.WeaponWrist
    ShieldWristNode = Context.ShieldWrist
    SwordGlow = Context.WeaponGlow
    ShieldGlow = Context.ShieldGlow
    CalibrationAvailable = Context.CalibrationAvailable
    EpicGlowAvailable = Context.GlowAvailable
    EpicGlowVisible = Context.GlowVisible
    PresentationState = Context.PresentationState

End Sub

Sub BeginPartyInspector()

    Dim Index As Number
    Dim WasVisible As Boolean

    If (Not PartyMode Or
        Not PartyReady Or
        Session.ViewerError Or
        PartyUiBound) Then
        Return
    End If

    PartyUiPrimary = CaptureActorContext()
    PartyUiTurn = PartyTurn
    PartyUiBound = True

    If PartyUiTurn = 1 Then

        Call UseActorContext(PartyCompanion)

    Else If PartyUiTurn = 2 Then

        Character = Dragon
        Session.ProfileIndex = ViewerProfiles.PROFILE_DRAGON
        ActiveProfile = ViewerProfiles.ProfileAt(Session.ProfileIndex)
        CalibrationAvailable = False
        EpicGlowAvailable = False
        SwordWristNode = -1
        ShieldWristNode = -1
        Playback.SelectedClip = 0

        For Index = 0 To Character3D.ClipCount(Character) - 1

            If Character3D.ClipName(Character, Index) = DragonClip Then
                Playback.SelectedClip = Index
            End If

        End For

    End If

    If Calibration.OwnerProfile <> Session.ProfileIndex Then

        ''' One editing owner at a time. Never carry a pending import, Undo, or
        ''' clipboard into another character's independent storage identity.
        WasVisible = ViewerUiState.CalibrationVisible

        Call ConfigureCalibration()

        ViewerUiState.CalibrationVisible = WasVisible And CalibrationAvailable
        Playback.SelectedTimelineEvent = FirstClipEvent()

    End If

End Sub

Sub EndPartyInspector()

    If Not PartyUiBound Then
        Return
    End If

    If PartyUiTurn = 1 Then

        PartyCompanion = CaptureActorContext()

        Call UseActorContext(PartyUiPrimary)

    Else If PartyUiTurn = 2 Then

        Dragon = Character
        DragonClip = SelectedClipName()

        Call UseActorContext(PartyUiPrimary)

    End If

    PartyUiBound = False

End Sub

Sub BeginPartyPreview()

    Dim Name As Text

    If Not PartyUiBound Then
        Return
    End If

    If Not PartyPreviewActive Then

        PartyPreviewClip = Playback.SelectedClip
        PartyPreviewTime = Character3D.AnimationTime(Character)
        PartyPreviewMode = Graphics3D.ANIMATION_LOOP
        Name = SelectedClipName()

        If ((PartyUiTurn = 2 And Name <> "Idle") Or
            Name = "SwordAttack" Or
            Name = "SwordAttack2" Or
            Name = "JumpAttack" Or
            Name = "ThorAttack" Or
            Name = "Hit" Or
            ViewerProfiles.HoldsFinalPose(Session.ProfileIndex, Name)) Then
            PartyPreviewMode = Graphics3D.ANIMATION_ONCE
        End If

        PartyPreviewActive = True

    End If

    Playback.ScenePaused = True

End Sub

Sub RestorePartyPreview()

    If Not PartyPreviewActive Or Not PartyUiBound Then
        Return
    End If

    Playback.SelectedClip = PartyPreviewClip
    Session.Ready = Character3D.PlayMode(Character, SelectedClipName(),
        PartyPreviewMode, Playback.PlaybackSpeed) And Session.Ready
    Session.Ready = Character3D.SetAnimationTime(Character, PartyPreviewTime) And Session.Ready
    PartyPreviewActive = False
    ViewerUiState.CalibrationVisible = False

    Call ViewerInput.CancelCaptures(ViewerInputState)

    Call UpdateCalibrationForCurrentFrame()
    Call InvalidateVisualHistory()

End Sub

Sub ResetPartyInspector()

    Call BeginPartyInspector()
    Call CancelCalibrationEdit()
    Call RestorePartyPreview()
    Call EndPartyInspector()

    If Session.ViewerError Then
        Call RetryViewer()
    Else

        Call ResetAll()
    End If

End Sub

Sub CreatePartyCompanion(Optional CompanionIndex As Number = ViewerProfiles.PROFILE_ORIN)

    Dim Primary As ViewerActorContext
    Dim CompanionProfile As CharacterViewer.Profile
    Dim CompanionBounds As Character3D.Bounds3D
    Dim CompanionModel As Core.Model3D
    Dim CompanionAnimator As Core.Animator3D

    Primary = CaptureActorContext()
    Session.ProfileIndex = CompanionIndex
    CompanionProfile = ViewerProfiles.ProfileAt(Session.ProfileIndex)
    Character = Character3D.LoadWithPolicy(
        CompanionProfile.AssetPath, Character3D.CHARACTER_LOAD_REQUIRE_PBR
    )
    PartyReady = Character3D.IsValid(Character)

    If PartyReady Then

        CompanionBounds = Character3D.LocalBounds(Character)
        ViewerCameraState.Frame = CharacterViewer.AutoFit(CompanionProfile, CompanionBounds)
        PartyReady = ViewerCameraState.Frame.Valid
        Session.Ready = Character3D.SetScale(Character, ViewerCameraState.Frame.ScalePercent) And Session.Ready
        Session.Ready = Character3D.SetShadows(Character, True, True) And Session.Ready
        Calibration.KeyBase = 0

        If CompanionIndex = ViewerProfiles.PROFILE_ORIN Then
            Calibration.KeyBase = CALIBRATION_MAX_CLIPS
        End If

        Call ConfigureCalibration()

        PartyReady = CalibrationAvailable And Not Calibration.StorageRejected And PartyReady
        CompanionModel.Handle = Character3D.ModelHandle(Character)
        CompanionAnimator.Handle = Character3D.AnimatorHandle(Character)

        If EpicGlowMaterial.Handle = 0 Then

            Call CreateEpicGlow()

        Else

        SwordGlow = Graphics3D.CreateModelPart3D(CompanionModel, WEAPON_PART_INDEX)
        ShieldGlow = Graphics3D.CreateModelPart3D(CompanionModel, SHIELD_PART_INDEX)
        EpicGlowAvailable = SwordGlow.Handle <> 0 And ShieldGlow.Handle <> 0
        EpicGlowVisible = EpicGlowAvailable

        If EpicGlowAvailable Then

            Session.Ready = Graphics3D.SetObjectMaterial3D(SwordGlow, EpicGlowMaterial) And Session.Ready
            Session.Ready = Graphics3D.SetObjectMaterial3D(ShieldGlow, EpicGlowMaterial) And Session.Ready
            Session.Ready = Graphics3D.SetObjectAnimator3D(SwordGlow, CompanionAnimator) And Session.Ready
            Session.Ready = Graphics3D.SetObjectAnimator3D(ShieldGlow, CompanionAnimator) And Session.Ready
            Session.Ready = Graphics3D.SetObjectCullMode3D(ShieldGlow, Graphics3D.OBJECT_CULL_FRONT) And Session.Ready

            Call Graphics3D.SetObjectColor(SwordGlow, 255, 255, 255)
            Call Graphics3D.SetObjectColor(ShieldGlow, 255, 255, 255)
            Call Graphics3D.SetObjectOpacity(SwordGlow, 95)
            Call Graphics3D.SetObjectOpacity(ShieldGlow, 90)
            Call Graphics3D.SetObjectShadows3D(SwordGlow, False, False)
            Call Graphics3D.SetObjectShadows3D(ShieldGlow, False, False)

        End If

        End If

        Call PlayPartyClip(Character, "Idle", Playback.SelectedClip)

        PartyCompanion = CaptureActorContext()

    End If

    Call UseActorContext(Primary)

    If Not Session.DragonInspection Then
        Call ConfigureCalibration()
    End If

    If PartyMode Then
        Call ResetPartyDemo()
    End If

    Session.Ready = PartyReady And Session.Ready

End Sub

Sub PositionDragonOpponents()

    Dim Home As Core.Vector3

    Home = PartyHomePosition(0, 2)
    DragonOpponent.Frame.PositionX = Home.X
    DragonOpponent.Frame.PositionZ = Home.Z
    Home = PartyHomePosition(1, 2)
    PartyCompanion.Frame.PositionX = Home.X
    PartyCompanion.Frame.PositionZ = Home.Z
    Session.Ready = Character3D.Place(DragonOpponent.Actor, DragonOpponent.Frame.PositionX,
        DragonOpponent.Frame.PositionY, DragonOpponent.Frame.PositionZ) And Session.Ready
    Session.Ready = Character3D.Place(PartyCompanion.Actor, PartyCompanion.Frame.PositionX,
        PartyCompanion.Frame.PositionY, PartyCompanion.Frame.PositionZ) And Session.Ready
    Session.Ready = FaceDragon(DragonOpponent.Actor, 0) And Session.Ready
    Session.Ready = FaceDragon(PartyCompanion.Actor, ORIN_ARENA_YAW_ADJUSTMENT) And Session.Ready

End Sub

Sub UpdateDragonOpponent()

    Dim SavedCompanion As ViewerActorContext
    Dim Primary As ViewerActorContext

    SavedCompanion = PartyCompanion
    PartyCompanion = DragonOpponent

    Call UpdatePartyCompanion()

    DragonOpponent = PartyCompanion
    PartyCompanion = SavedCompanion
    Primary = CaptureActorContext()

    Call UseActorContext(DragonOpponent)
    Call UpdateEquipmentFire()
    Call UseActorContext(Primary)

End Sub

Function DrawDragonOpponent() As Boolean

    Dim SavedCompanion As ViewerActorContext
    Dim Result As Boolean

    SavedCompanion = PartyCompanion
    PartyCompanion = DragonOpponent
    Result = DrawPartyCompanion()
    PartyCompanion = SavedCompanion

    Return Result

End Function

Function PartyHomePosition(MemberIndex As Number, MemberCount As Number) As Core.Vector3

    Dim Center As Core.Vector3
    Dim Result As Core.Vector3

    Center.X = DRAGON_POSITION_X
    Center.Z = DRAGON_POSITION_Z
    Result = BattleCamera.FormationPosition(Center, PARTY_FORMATION_RADIUS,
        PARTY_FORMATION_START_ANGLE, PARTY_FORMATION_END_ANGLE,
        MemberIndex, MemberCount)

    Return Result

End Function

Function PartyPresentationState(MemberIndex As Number) As Number

    Dim Result As Number

    Result = PresentationState

    If PartyUiBound Then
        Result = PartyUiPrimary.PresentationState
    End If

    If MemberIndex = 1 Then
        Result = PartyCompanion.PresentationState
    End If

    Return Result

End Function

Sub SetPartyPresentationState(MemberIndex As Number, State As Number)

    If MemberIndex = 1 Then
        PartyCompanion.PresentationState = State
    Else
        PresentationState = State
    End If

End Sub

Function PartyPresentationStateName(State As Number) As Text

    If State = PARTY_STATE_ACTING Then
        Return "Acting"
    Else If State = PARTY_STATE_GUARDING Then
        Return "Guarding"
    Else If State = PARTY_STATE_HIT Then
        Return "Hit"
    Else If State = PARTY_STATE_KO Then
        Return "KO"
    Else If State = PARTY_STATE_REVIVING Then
        Return "Reviving"
    End If

    Return "Alive"

End Function

Sub InitializePartyFormation()

    PartyParticipantCount = 2
    PartyParticipants[0].Home = PartyHomePosition(0, PartyParticipantCount)
    PartyParticipants[1].Home = PartyHomePosition(1, PartyParticipantCount)
    PartyParticipants[0].Approach.X = -21
    PartyParticipants[0].Approach.Z = -44
    PartyParticipants[1].Approach.X = -49
    PartyParticipants[1].Approach.Z = 4
    PartyParticipants[0].FacingAdjustment = 0
    PartyParticipants[1].FacingAdjustment = ORIN_ARENA_YAW_ADJUSTMENT

    ''' Only one hero approaches at a time; animated full-model bounds must not move these shots.

End Sub

Sub ResetPartyDemo()

    PartyElapsed = 0
    PartyTurn = 2
    PartyAttackCycle = 0
    PartyDragonOnlyTurn = True
    PartyFatalTarget = -1
    PartyFatalStarted = False
    PartyHitTarget = -1
    PartyHitResolved = False
    DragonCounter = 0
    PartyStage = -1
    DragonReactionPending = False
    Playback.DemoEnabled = True
    ViewerUiState.CalibrationVisible = False

    Call SetPartyPresentationState(0, PARTY_STATE_ALIVE)
    Call SetPartyPresentationState(1, PARTY_STATE_ALIVE)
    Call InitializePartyFormation()
    Call PreparePartyDragonTurn()

    If PartyReady Then
        Session.Ready = Character3D.SetPartVisible(PartyCompanion.Actor, WEAPON_PART_INDEX, SwordVisible) And Session.Ready
        Session.Ready = Character3D.SetPartVisible(PartyCompanion.Actor, SHIELD_PART_INDEX, ShieldVisible) And Session.Ready
    End If

End Sub

Sub PreparePartyDragonTurn()

    Random PartyFatalTarget From -1 To 1
    PartyFatalStarted = False
    PartyHitResolved = False
    PartyHitTarget = PartyFatalTarget

    If PartyHitTarget < 0 Then
        PartyHitTarget = DragonCounter Mod PartyParticipantCount
    End If

End Sub

Function PartyAttackDuration() As Number

    Dim Actor As Character3D.Actor
    Dim Index As Number
    Dim Name As Text
    Dim Result As Number

    Actor = Character
    Name = ViewerProfiles.PartyAttackName(ViewerProfiles.PROFILE_ARIN, PartyAttackCycle)

    If PartyTurn = 1 Then
        Actor = PartyCompanion.Actor
        Name = ViewerProfiles.PartyAttackName(ViewerProfiles.PROFILE_ORIN, PartyAttackCycle)
    End If

    Result = 1200

    For Index = 0 To Character3D.ClipCount(Actor) - 1

        If Character3D.ClipName(Actor, Index) = Name Then
            Result = Character3D.ClipDuration(Actor, Index) * 100 / Max(25, Playback.PlaybackSpeed)
            Exit For
        End If

    End For

    Return Result

End Function

Sub PlayPartyClip(ByRef Actor As Character3D.Actor, Name As Text, ByRef Clip As Number)

    Dim Index As Number
    Dim Mode As Number
    Dim HoldGuard As Boolean

    Mode = Graphics3D.ANIMATION_LOOP
    HoldGuard = (Actor.Handle = PartyCompanion.Actor.Handle And
        ViewerProfiles.HoldsFinalPose(PartyCompanion.Profile, Name))
    HoldGuard = HoldGuard Or Name = "Death"

    If (Name = "SwordAttack" Or
        Name = "SwordAttack2" Or
        Name = "JumpAttack" Or
        Name = "ThorAttack" Or
        Name = "Hit" Or
        HoldGuard) Then
        Mode = Graphics3D.ANIMATION_ONCE
    End If

    For Index = 0 To Character3D.ClipCount(Actor) - 1

        If Character3D.ClipName(Actor, Index) = Name Then

            If HoldGuard And Clip = Index Then
                Return
            End If

            Clip = Index
            Session.Ready = Character3D.PlayMode(Actor, Name, Mode, Playback.PlaybackSpeed) And Session.Ready
            Exit For

        End If

    End For

End Sub

Sub AdvancePartyDemo()

    Dim AttackDuration As Number
    Dim Stage As Number
    Dim Travel1000 As Number
    Dim Name As Text
    Dim Home As Core.Vector3
    Dim Approach As Core.Vector3
    Dim TravelOffset As Number

    If Not PartyReady Or Playback.ScenePaused Then
        Return
    End If

    If Playback.DemoEnabled Then
        PartyElapsed = PartyElapsed + Playback.AnimationUpdateElapsed
    End If

    If PartyTurn = 2 Then
        Call AdvanceDragonTurn()

        Return
    End If

    AttackDuration = PartyAttackDuration()

    If PartyElapsed >= AttackDuration + 4000 Then

        PartyElapsed = 0
        PartyTurn = (PartyTurn + 1) Mod 3
        PartyStage = -1

        If PartyTurn = 2 Then
            PartyDragonOnlyTurn = False

            Call PreparePartyDragonTurn()
        End If

    End If

    If PartyTurn = 2 Then
        Call AdvanceDragonTurn()

        Return
    End If

    Stage = 0
    Travel1000 = Min(1000, Max(0, PartyElapsed - 650) * 1000 / 650)
    Name = "Walk"

    If PartyTurn = 1 Then
        Name = "Run"
    End If

    If PartyElapsed >= AttackDuration + 2000 Then

        Stage = 3
        Travel1000 = 0
        Name = "Idle"

    Else If PartyElapsed >= AttackDuration + 1300 Then

        Stage = 2
        Travel1000 = Max(0, 1000 - (PartyElapsed - AttackDuration - 1300) * 1000 / 700)
        Name = "Walk"

        If PartyTurn = 1 Then
            Name = "Run"
        End If

    Else If PartyElapsed >= 1300 Then

        Stage = 1
        Travel1000 = 1000
        Name = ViewerProfiles.PartyAttackName(ViewerProfiles.PROFILE_ARIN, PartyAttackCycle)

        If PartyTurn = 1 Then
            Name = ViewerProfiles.PartyAttackName(ViewerProfiles.PROFILE_ORIN, PartyAttackCycle)
        End If

    End If

    If PartyElapsed < 650 Then
        Stage = -2
        Name = "Idle"
    End If

    If Stage <> PartyStage Then

        DragonReactionPending = Stage = 1

        If PartyTurn = 0 Then

            If PartyPresentationState(0) = PARTY_STATE_KO Then
                Call SetPartyPresentationState(0, PARTY_STATE_REVIVING)
            Else If Stage = 3 Then
                Call SetPartyPresentationState(0, PARTY_STATE_ALIVE)
            Else If Stage >= 0 Then
                Call SetPartyPresentationState(0, PARTY_STATE_ACTING)
            End If

            Call PlayPartyClip(Character, Name, Playback.SelectedClip)

            If PartyPresentationState(1) <> PARTY_STATE_KO Then
                Call SetPartyPresentationState(1, PARTY_STATE_GUARDING)
                Call PlayPartyClip(PartyCompanion.Actor, "Defend", PartyCompanion.Clip)
            End If

        Else

            If PartyPresentationState(1) = PARTY_STATE_KO Then
                Call SetPartyPresentationState(1, PARTY_STATE_REVIVING)
            Else If Stage = 3 Then
                Call SetPartyPresentationState(1, PARTY_STATE_ALIVE)
            Else If Stage >= 0 Then
                Call SetPartyPresentationState(1, PARTY_STATE_ACTING)
            End If

            If PartyPresentationState(0) <> PARTY_STATE_KO Then
                Call SetPartyPresentationState(0, PARTY_STATE_GUARDING)
                Call PlayPartyClip(Character, "Defend", Playback.SelectedClip)
            End If

            Call PlayPartyClip(PartyCompanion.Actor, Name, PartyCompanion.Clip)

        End If

        PartyStage = Stage

    End If

    Home = PartyParticipants[0].Home
    ViewerCameraState.Frame.PositionX = Home.X
    ViewerCameraState.Frame.PositionZ = Home.Z
    Home = PartyParticipants[1].Home
    PartyCompanion.Frame.PositionX = Home.X
    PartyCompanion.Frame.PositionZ = Home.Z

    If PartyTurn = 0 Then

        Approach = PartyParticipants[0].Approach
        TravelOffset = Approach.X - ViewerCameraState.Frame.PositionX
        ViewerCameraState.Frame.PositionX = ViewerCameraState.Frame.PositionX + TravelOffset * Travel1000 / 1000
        TravelOffset = Approach.Z - ViewerCameraState.Frame.PositionZ
        ViewerCameraState.Frame.PositionZ = ViewerCameraState.Frame.PositionZ + TravelOffset * Travel1000 / 1000

    Else
        Approach = PartyParticipants[1].Approach
        TravelOffset = Approach.X - PartyCompanion.Frame.PositionX
        PartyCompanion.Frame.PositionX = PartyCompanion.Frame.PositionX + TravelOffset * Travel1000 / 1000
        TravelOffset = Approach.Z - PartyCompanion.Frame.PositionZ
        PartyCompanion.Frame.PositionZ = PartyCompanion.Frame.PositionZ + TravelOffset * Travel1000 / 1000

    End If

    Session.Ready = Character3D.Place(Character, ViewerCameraState.Frame.PositionX, ViewerCameraState.Frame.PositionY, ViewerCameraState.Frame.PositionZ) And Session.Ready
    Session.Ready = Character3D.Place(PartyCompanion.Actor,
        PartyCompanion.Frame.PositionX, PartyCompanion.Frame.PositionY, PartyCompanion.Frame.PositionZ) And Session.Ready
    Session.Ready = FaceDragon(Character, PartyParticipants[0].FacingAdjustment) And Session.Ready
    Session.Ready = FaceDragon(PartyCompanion.Actor,
        PartyParticipants[1].FacingAdjustment) And Session.Ready

End Sub

Sub AdvanceDragonTurn()

    Dim Stage As Number
    Dim Duration As Number
    Dim ActionTime As Number
    Dim Home As Core.Vector3
    Dim ImpactTime As Number

    Duration = DragonTurnDuration()
    ActionTime = PartyElapsed * Playback.PlaybackSpeed / 100
    ImpactTime = DragonImpactTime()

    If PartyFatalTarget >= 0 Then
        Duration = Max(Duration, (ImpactTime + 4300) * 100 / Max(25, Playback.PlaybackSpeed))
    End If

    If PartyElapsed >= Duration Then

        PartyElapsed = 0
        PartyStage = -1
        DragonCounter = DragonCounter + 1

        If PartyDragonOnlyTurn Then

            PartyDragonOnlyTurn = False
            PartyTurn = 0

        Else

            PartyAttackCycle = PartyAttackCycle + 1

            If DragonCounter Mod 3 = 0 Then

                PartyDragonOnlyTurn = True
                PartyTurn = 2

                Call PreparePartyDragonTurn()

            Else
                PartyTurn = 0

            End If

        End If

        Return

    End If

    If PartyStage <> 0 Then

        If PartyPresentationState(0) <> PARTY_STATE_KO Then
            Call SetPartyPresentationState(0, PARTY_STATE_GUARDING)
            Call PlayPartyClip(Character, "Defend", Playback.SelectedClip)
        End If

        If PartyPresentationState(1) <> PARTY_STATE_KO Then
            Call SetPartyPresentationState(1, PARTY_STATE_GUARDING)
            Call PlayPartyClip(PartyCompanion.Actor, "Defend", PartyCompanion.Clip)
        End If

        PartyStage = 0

    End If

    If ActionTime >= ImpactTime And Not PartyFatalStarted Then

        PartyFatalStarted = True

        Call SetPartyPresentationState(PartyHitTarget, PARTY_STATE_HIT)

        If PartyHitTarget = 0 Then
            Call PlayPartyClip(Character, "Hit", Playback.SelectedClip)
        Else

            Call PlayPartyClip(PartyCompanion.Actor, "Hit", PartyCompanion.Clip)
        End If

    End If

    If (PartyFatalStarted And
        Not PartyHitResolved And
        ActionTime >= ImpactTime + 350) Then

        PartyHitResolved = True

        If PartyFatalTarget >= 0 Then

            Call SetPartyPresentationState(PartyFatalTarget, PARTY_STATE_KO)

            If PartyFatalTarget = 0 Then
            Call PlayPartyClip(Character, "Death", Playback.SelectedClip)
            Else

                Call PlayPartyClip(PartyCompanion.Actor, "Death", PartyCompanion.Clip)
            End If

        Else

            Call SetPartyPresentationState(PartyHitTarget, PARTY_STATE_GUARDING)

            If PartyHitTarget = 0 Then
                Call PlayPartyClip(Character, "Defend", Playback.SelectedClip)
            Else

                Call PlayPartyClip(PartyCompanion.Actor, "Defend", PartyCompanion.Clip)
            End If

        End If

    End If

    Home = PartyParticipants[0].Home
    ViewerCameraState.Frame.PositionX = Home.X
    ViewerCameraState.Frame.PositionZ = Home.Z
    Home = PartyParticipants[1].Home
    PartyCompanion.Frame.PositionX = Home.X
    PartyCompanion.Frame.PositionZ = Home.Z
    Session.Ready = Character3D.Place(Character, ViewerCameraState.Frame.PositionX, ViewerCameraState.Frame.PositionY, ViewerCameraState.Frame.PositionZ) And Session.Ready
    Session.Ready = Character3D.Place(PartyCompanion.Actor,
        PartyCompanion.Frame.PositionX, PartyCompanion.Frame.PositionY, PartyCompanion.Frame.PositionZ) And Session.Ready
    Session.Ready = FaceDragon(Character, PartyParticipants[0].FacingAdjustment) And Session.Ready
    Session.Ready = FaceDragon(PartyCompanion.Actor,
        PartyParticipants[1].FacingAdjustment) And Session.Ready

End Sub

Function DragonTurnDuration() As Number

    Dim Result As Number

    Result = 4500

    If DragonCounter Mod 3 = 1 Then
        Result = 2800
    Else If DragonCounter Mod 3 = 2 Then
        Result = 5400
    End If

    Result = Result * 100 / Max(25, Playback.PlaybackSpeed)

    Return Result

End Function

Function DragonImpactTime() As Number

    If DragonCounter Mod 3 = 2 Then
        Return 2500
    Else If DragonCounter Mod 3 = 1 Then
        Return 1000
    End If

    Return 1200

End Function

Function ShieldFireStyleLabel() As Text

    If ShieldFlameStyle Then
        Return "Flames"
    End If

    Return "Ember Outline"

End Function

Sub ToggleShieldFireStyle()

    ShieldFlameStyle = Not ShieldFlameStyle
    ShieldFireFailed = False

    Call ClearEquipmentFire()

End Sub

Sub UpdatePartyCompanion()

    Dim Primary As ViewerActorContext
    Dim Center As Core.Vector3
    Dim Tip As Core.Vector3

    If Not PartyReady Then
        Return
    End If

    Primary = CaptureActorContext()

    Call UseActorContext(PartyCompanion)

    Session.Ready = Character3D.Update(Character, Playback.AnimationUpdateElapsed) And Session.Ready

    Call ApplyCharacterPresentationOffset()
    Call UpdateCalibrationForCurrentFrame()
    Call ApplyWristCalibration()
    Call ApplyEquipmentCoupling()

    If EpicGlowAvailable Then

        Center = Character3D.SocketPosition(Character, "SwordBase", BODY_PART_INDEX, CalibrationChannelValue(Playback.SelectedClip, 18) <> 0)
        Tip = Character3D.SocketPosition(Character, "SwordTip", BODY_PART_INDEX, CalibrationChannelValue(Playback.SelectedClip, 18) <> 0)
        Center.X = (Center.X + Tip.X) / 2
        Center.Y = (Center.Y + Tip.Y) / 2
        Center.Z = (Center.Z + Tip.Z) / 2
        Session.Ready = UpdateEquipmentGlow(SwordGlow, Center) And Session.Ready
        Center = Character3D.SocketPosition(Character, "ShieldCenter", BODY_PART_INDEX, CalibrationChannelValue(Playback.SelectedClip, 19) <> 0)
        Session.Ready = UpdateEquipmentGlow(ShieldGlow, Center) And Session.Ready

    End If

    Call ApplyEquipmentCalibration()

    PartyCompanion = CaptureActorContext()

    Call UseActorContext(Primary)

End Sub

Function DrawPartyCompanion() As Boolean

    Dim Result As Boolean

    Result = Character3D.Draw(PartyCompanion.Actor)

    If (PartyCompanion.GlowVisible And
        PartyCompanion.GlowAvailable And
        (Not PartyMode Or PartyPresentationState(1) <> PARTY_STATE_KO) And
        (EpicGlowVisible Or Session.DragonInspection)) Then

        If SwordVisible Then
            Result = Graphics3D.DrawObject3D(PartyCompanion.WeaponGlow) And Result
        End If

    End If

    Return Result

End Function

Sub DestroyPartyCompanion()

    Call Graphics3D.DestroyObject3D(PartyCompanion.WeaponGlow)
    Call Graphics3D.DestroyObject3D(PartyCompanion.ShieldGlow)
    Call Character3D.Destroy(PartyCompanion.Actor)

    PartyReady = False

End Sub

Function HandlePartyPointer() As Boolean

    Dim Left As Number
    Dim Result As Boolean

    Left = 12
    Result = (ViewerUiState.Visibility = 0 And Not ViewerUiState.CalibrationVisible And
        Pointer_X() < Left + 252 And Pointer_Y() >= 96 And
        Pointer_Y() < Window_Height() - 104)

    If (ViewerInputState.TimelineScrubbing Or
        ViewerInputState.TimelineKeyframeDragging Or
        ViewerInputState.FrameButtonRepeatDirection <> 0 Or
        ViewerInputState.SliderDragOwner <> 0 Or
        ViewerGizmoState.Dragging) Then
        Return False
    End If

    If Pointer_Pressed(POINTER_SECONDARY) Then
        Call ResetPartyInspector()

        Return True
    End If

    If Not Pointer_Pressed(POINTER_PRIMARY) Or ViewerUiState.Visibility <> 0 Then
        Return Result
    End If

    If PointerInRectangle(StatusPanelX() + 12, Window_Height() - 64, 52, 24) Then
        Call ResetView()

        Return True
    Else If (PointerInRectangle(StatusPanelX() + 68, Window_Height() - 64, 74, 24) Or
        PointerInRectangle(StatusPanelX() + 146, Window_Height() - 64, 40, 24)) Then
        Call ResetPartyInspector()

        Return True
    Else If PointerInRectangle(GlowButtonX(), 18, GlowButtonWidth(), 34) Then
        Call ToggleEpicGlow()

        Return True
    Else If PointerInRectangle(StatusPanelX() + 108, 18, 50, 34) Then
        Call CycleSocketDisplay()

        Return True
    Else If PointerInRectangle(StatusPanelX() + 172, 204, 30, 24) Then
        Call AdjustPlaybackSpeed(-25)

        Return True
    Else If PointerInRectangle(StatusPanelX() + 208, 204, 30, 24) Then
        Call AdjustPlaybackSpeed(25)

        Return True
    End If

    If Not Result Then
        Return False
    End If

    If PointerInRectangle(Left, 104, 76, 30) Then

        Call ToggleDragon()

    Else If PointerInRectangle(Left + 82, 104, 76, 30) Then

        Call ToggleSword()

    Else If PointerInRectangle(Left + 164, 104, 76, 30) Then

        Call ToggleShield()

    Else If PointerInRectangle(Left, 140, 76, 22) Then

        Call ToggleFloorAndGrid()

    Else If PointerInRectangle(Left + 82, 140, 76, 22) Then

        Call CycleBackground()

    Else If PointerInRectangle(Left + 164, 140, 76, 22) Then

        Call ToggleEpicGlow()

    Else If PointerInRectangle(Left + 12, 324, 108, 28) Then

        Call BeginPartyInspector()
        Call ToggleScenePause()
        Call EndPartyInspector()

    Else If PointerInRectangle(Left + 128, 324, 108, 28) Then

        Call ViewerCamera.ToggleAutoOrbit(ViewerCameraState)

    Else If PointerInRectangle(Left + 12, 360, 224, 28) Then

        Call ResetPartyInspector()

    Else If Window_Height() >= 580 And PointerInRectangle(Left + 12, 410, 108, 24) Then

        FlameAnimationPaused = Not FlameAnimationPaused

    Else If Window_Height() >= 580 And PointerInRectangle(Left + 128, 410, 108, 24) Then

        LightningAnimationPaused = Not LightningAnimationPaused

    Else If Window_Height() >= 580 And PointerInRectangle(Left + 12, 440, 224, 22) Then

        Call ToggleShieldFireStyle()

    End If

    Return Result

End Function

Sub DrawPartyOverlay()

    Dim Left As Number
    Dim Acting As Text
    Dim AttackSequence As Text

    Left = 12
    Acting = "Arin"

    If PartyTurn = 1 Then
        Acting = "Orin"
    Else If PartyTurn = 2 Then
        Acting = "Dragon"
    End If

    AttackSequence = "Sword Attack"

    If PartyTurn = 0 And PartyAttackCycle Mod 2 = 1 Then

        AttackSequence = "Sword Attack 2"

    Else If PartyTurn = 1 Then

        If PartyAttackCycle Mod 3 = 0 Then
            AttackSequence = "Sword Attack"
        Else If PartyAttackCycle Mod 3 = 1 Then
            AttackSequence = "Jump Attack"
        Else
            AttackSequence = "Thor Attack"
        End If

    Else If PartyTurn = 2 Then

        If DragonCounter Mod 3 = 0 Then
            AttackSequence = "Fire Breath"
        Else If DragonCounter Mod 3 = 1 Then
            AttackSequence = "Claw Strike"
        Else
            AttackSequence = "Fireball"
        End If

    End If

    If ViewerUiState.Visibility = 0 Then

        Call UI.DrawPanel(Left, 96, 252, Max(330, Window_Height() - 200))
        Call DrawButton(Left, 104, 76, 30, "Dragon", DragonVisible)
        Call DrawButton(Left + 82, 104, 76, 30, "Weapon", SwordVisible)
        Call DrawButton(Left + 164, 104, 76, 30, "Shield", ShieldVisible)
        Call DrawButton(Left, 140, 76, 22, "Floor/Grid", FloorVisible Or GridVisible)
        Call DrawButton(Left + 82, 140, 76, 22, "Backdrop", BackgroundIndex > 0)
        Call DrawButton(Left + 164, 140, 76, 22, "Glow", EpicGlowVisible)

        Draw Text "Party / Enemy" At Left + 16, 178 Size 20 Color WHITE
        Draw Text "Arin  •  Paladin" At Left + 16, 212 Size 15 Color CYAN
        Draw Text "Orin  •  Tank" At Left + 16, 238 Size 15 Color WHITE
        Draw Text Acting + "'s Turn" At Left + 16, 272 Size 16 Color YELLOW

        If PartyStage = 1 Or PartyTurn = 2 Then
            Draw Text "Attack: " + AttackSequence At Left + 16, 296 Size 13 Color CYAN
        End If

        Call DrawButton(Left + 12, 324, 108, 28, "Pause", Playback.ScenePaused)
        Call DrawButton(Left + 128, 324, 108, 28, "Orbit", ViewerCameraState.AutoOrbit)
        Call DrawButton(Left + 12, 360, 224, 28, "Restart Battle Demo", False)

        If Window_Height() >= 580 Then

            Draw Text "VFX Playback" At Left + 16, 394 Size 12 Color WHITE

        Call DrawButton(Left + 12, 410, 108, 24,
            VfxPlaybackLabel("Fire", FlameAnimationPaused), FlameAnimationPaused)
        Call DrawButton(Left + 128, 410, 108, 24,
            VfxPlaybackLabel("Lightning", LightningAnimationPaused), LightningAnimationPaused)
        Call DrawButton(Left + 12, 440, 224, 22, "Arin Shield: " + ShieldFireStyleLabel(), Not ShieldFlameStyle)

        End If

        If Window_Height() >= 740 Then

            If PartyPresentationState(0) = PARTY_STATE_KO Then
                Draw Text "Arin KO - Revives On His Turn" At Left + 16, 470 Size 12 Color YELLOW
            Else If PartyPresentationState(1) = PARTY_STATE_KO Then
                Draw Text "Orin KO - Revives On His Turn" At Left + 16, 470 Size 12 Color YELLOW
            Else
                Draw Text "Arin " + PartyPresentationStateName(PartyPresentationState(0)) + " / Orin " + PartyPresentationStateName(PartyPresentationState(1)) At Left + 16, 470 Size 12 Color LIGHT_GRAY
            End If

            Draw Text OrinStorm.Caption(OrinStormContext) At Left + 16, 488 Size 12 Color CYAN
            Draw Text "Camera" At Left + 16, 528 Size 12 Color LIGHT_GRAY
            Draw Number PartyActiveCamera At Left + 80, 528 Size 12 Color CYAN

            Call DrawPartyCameraDetails(Left + 16, 548)

            Draw Text "FPS" At Left + 16, 508 Size 13 Color LIGHT_GRAY
            Draw Number ViewerTiming.FramesPerSecond(FrameRate) At Left + 62, 508 Size 13 Color GREEN

        End If

    End If

    If Session.ViewerError Then
        Draw Text "Party Could Not Load — Select A Character Or Press Enter To Retry" At 18, 112 Size 16 Color YELLOW
        Draw Number Session.FirstFailureStage At 18, 140 Size 14 Color YELLOW
    End If

End Sub

Sub DrawPartyCameraDetails(X As Number, Y As Number)

    Dim Angles As Core.Vector3

    Angles = BattleCamera.ViewAngles(ViewerCameraState.Live)
    Draw Text "Pos XYZ" At X, Y Size 11 Color LIGHT_GRAY
    Draw Number ViewerCameraState.Live.Position.X At X + 74, Y Size 11 Color CYAN
    Draw Number ViewerCameraState.Live.Position.Y At X + 124, Y Size 11 Color CYAN
    Draw Number ViewerCameraState.Live.Position.Z At X + 174, Y Size 11 Color CYAN
    Draw Text "Aim XYZ" At X, Y + 14 Size 11 Color LIGHT_GRAY
    Draw Number ViewerCameraState.Live.Target.X At X + 74, Y + 14 Size 11 Color CYAN
    Draw Number ViewerCameraState.Live.Target.Y At X + 124, Y + 14 Size 11 Color CYAN
    Draw Number ViewerCameraState.Live.Target.Z At X + 174, Y + 14 Size 11 Color CYAN
    Draw Text "Yaw / Pitch" At X, Y + 28 Size 11 Color LIGHT_GRAY
    Draw Number Angles.Y At X + 100, Y + 28 Size 11 Color CYAN
    Draw Number Angles.X At X + 158, Y + 28 Size 11 Color CYAN
    Draw Text "FOV / Dist" At X, Y + 42 Size 11 Color LIGHT_GRAY
    Draw Number ViewerCameraState.Live.FovDegrees At X + 100, Y + 42 Size 11 Color CYAN
    Draw Number Math3D.Distance(ViewerCameraState.Live.Position, ViewerCameraState.Live.Target) At X + 158, Y + 42 Size 11 Color CYAN

End Sub
