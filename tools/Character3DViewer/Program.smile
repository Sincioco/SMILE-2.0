    Dim Result As Text

    If Session.DragonInspection Then

        Result = "VFX ON"

        If Not DragonState.Visible Then
            Result = "VFX OFF"
        End If

    Else If Not DragonState.Available Then

        Result = "NO DRAGON"

    Else If DragonState.Visible Then

        Result = "DRAGON ON"

    Else
