Dim CalibrationClipboardValues[CALIBRATION_CHANNEL_COUNT] As Number
Dim TransformGizmo As CharacterViewer.TransformGizmo
Dim TransformGizmoOrigin As Core.Vector3
Dim TransformGizmoWorldSize As Number
Dim TransformGizmoDragging As Boolean
Dim TransformGizmoPointerOwned As Boolean
Dim TransformGizmoOpenedEdit As Boolean
Dim TransformGizmoDragStartValue As Number
Dim TransformGizmoDragRemainder As Number
Dim SliderDragOwner As Number
Dim SwordWristCalibrationBeforeEdit[CALIBRATION_AXIS_COUNT] As Number
Dim ShieldWristCalibrationBeforeEdit[CALIBRATION_AXIS_COUNT] As Number
Dim SwordCalibrationBeforeEdit[CALIBRATION_AXIS_COUNT] As Number
Dim ShieldCalibrationBeforeEdit[CALIBRATION_AXIS_COUNT] As Number
Dim SwordPositionCalibrationBeforeEdit[CALIBRATION_AXIS_COUNT] As Number
Dim ShieldPositionCalibrationBeforeEdit[CALIBRATION_AXIS_COUNT] As Number
Dim TimelineScrubbing As Boolean
Dim TimelineKeyframeDragging As Boolean
Dim TimelineDraggedKeyframe As Number
Dim TimelineDraggedOriginalFrame As Number
Dim TimelineDraggedTargetFrame As Number
Dim TimelineDraggedKeyframeValues[CALIBRATION_CHANNEL_COUNT] As Number

Game Window "SMILE 2.0 - 3D Viewer, Animation Editor" Size 1600 By 640

Call Graphics3D.ResetRenderer3D()

SelectedCharacterTab = 2
PartyMode = True
ProfileIndex = ViewerProfiles.PROFILE_ARIN
DemoEnabled = True
UiVisibility = 0
BackgroundIndex = 3

Call LoadViewer()
Call CaptureViewerFailure(20)

WindowActivated = Window_Activate()

Running = True
PreviousTime = Timer()

Do

    Get Key Key

    Call HandleKeyboard(Key)

    Call CaptureViewerFailure(21)

    InterfacePointerBlocked = HandleInterfacePointer()

    Call CaptureViewerFailure(22)

    Call UpdateCameraPointer(InterfacePointerBlocked)

    Call CaptureViewerFailure(23)

    CurrentTime = Timer()
    RawFrameMilliseconds = Max(0, CurrentTime - PreviousTime)
    PreviousTime = CurrentTime

    Ready = CharacterViewer.AdvanceClock(
        ViewerClock,
        RawFrameMilliseconds,
        MAX_ANIMATION_ELAPSED,
        MAX_CAMERA_ELAPSED,
        MAX_RAW_FRAME_MILLISECONDS
    ) And Ready

    Call CaptureViewerFailure(24)

    RawFrameMilliseconds = ViewerClock.RawFrameMilliseconds
    AnimationElapsed = ViewerClock.AnimationElapsed
    CameraElapsed = ViewerClock.CameraElapsed
    PresentationElapsed = ViewerClock.PresentationElapsed
    DroppedAnimationMilliseconds = ViewerClock.DroppedAnimationMilliseconds
    DroppedCameraMilliseconds = ViewerClock.DroppedCameraMilliseconds
    LongPauseCount = ViewerClock.LongPauseCount

    Call AdvanceFrameRate()

    If Not ViewerError Then

        If Not ScenePaused Then
            Call AdvanceAnimationSequence()

            Call CaptureViewerFailure(2)
        End If

        If ScenePaused Then
            AnimationUpdateElapsed = 0
        Else
            AnimationUpdateElapsed = AnimationElapsed
        End If

        If PartyMode Then
            Call AdvancePartyDemo()
        End If

        Ready = Character3D.Update(Character, AnimationUpdateElapsed) And Ready

        Call CaptureViewerFailure(3)
        Call ApplyCharacterPresentationOffset()

        If CalibrationAvailable Then

            Call UpdateCalibrationForCurrentFrame()
            Call ApplyWristCalibration()
            Call ApplyEquipmentCoupling()
            Call CaptureViewerFailure(4)

        End If

        Call AdvanceSmoothZoom()

        Call CaptureViewerFailure(5)

        If Not ScenePaused Then
            Call AdvanceAutoOrbit()

            Call CaptureViewerFailure(6)
        End If

        Call UpdateResponsiveFit()

        If PartyMode And AutoOrbit Then
            Camera = BattleCamera.Orbit(BaseCamera, CameraControls, AutoOrbitYaw1000)
        Else
            Camera = Interaction.ApplyScreenSpaceCameraControls(BaseCamera, CameraControls)
        End If

        Call ApplyCloseUpZoom()
        Call ApplyPartyAttackCamera()

        If EpicGlowVisible Then

            If Not UpdateEpicGlow() Then
                EpicGlowVisible = False
            End If

        End If

        If CalibrationAvailable Then
            Call ApplyEquipmentCalibration()

            Call CaptureViewerFailure(7)
        End If

        Call UpdateEquipmentFire()

        If PartyMode Then
            Call UpdatePartyCompanion()
        End If

        Call UpdateDragon()
        Call UpdateBattleAudio()
        Call UpdateOrinStorm()

        If SocketGizmosVisible Then
            Call UpdateSocketGizmos()
        End If

        If Character3D.IsValid(Character) Then
            CharacterBounds = Character3D.WorldBounds(Character, ActiveProfile.AnimationMargin)
        End If

        Ready = BeginViewerScene() And Ready

        Call CaptureViewerFailure(8)

        If Ready Then

            If FloorVisible Then
                Ready = Arena3D.Draw(Arena, True, False)

                Call CaptureViewerFailure(9)
            End If

            If GridVisible Then
                Ready = DrawStudioGrid() And Ready

                Call CaptureViewerFailure(10)
            End If

            If DragonVisible Then
                Ready = DrawDragon() And Ready

                Call CaptureViewerFailure(11)
            End If

            If EpicGlowVisible Then

                If Not DrawEquipmentGlow() Then
                    EpicGlowVisible = False
                End If

            End If

            Ready = Character3D.Draw(Character) And Ready

            If PartyMode And PartyReady Then
                Ready = DrawPartyCompanion() And Ready
            End If

            Call CaptureViewerFailure(12)

            If SwordFire.Slot <> 0 And Not SwordFireFailed Then
                SwordFireFailed = Not Fire.Draw(SwordFire)
            End If

            Call DrawShieldFire()
            Call OrinStorm.Draw()
            Call DragonPresence.Draw()

            If DragonVisible And DragonBreath.Slot <> 0 Then
                DragonFireFailed = Not Fire.Draw(DragonBreath)
            End If

            If EpicGlowVisible Then

                If Not DrawEpicGlow() Then
                    EpicGlowVisible = False
                End If

            End If

            If SocketGizmosVisible Then
                Ready = DrawSocketGizmos() And Ready
            End If

            Ready = Scene3D.EndScene() And Ready

            Call CaptureViewerFailure(13)

        End If

        If Not Ready Then
            Call RecordViewerError()
        End If

    End If

    Call OrinStorm.DrawFlash()
    Call DrawViewerOverlay()

    Show Screen

    Running = Running And Not Game_Closed()

Loop Until Not Running

Call DestroyViewer()

Sub LoadViewer()

    ActiveProfile = ViewerProfiles.ProfileAt(ProfileIndex)
    CalibrationProfileFingerprint = ViewerProfiles.CalibrationFingerprint(ProfileIndex)
    CalibrationFilePath = ViewerProfiles.CalibrationFile(ProfileIndex)
    CalibrationDataKey = ViewerProfiles.CalibrationKey(ProfileIndex)
    CalibrationClipBase = 0

    If ProfileIndex = ViewerProfiles.PROFILE_ORIN Then
        CalibrationClipBase = CALIBRATION_MAX_CLIPS
    End If

    DragonAvailable = ViewerProfiles.IsPartyCharacter(ProfileIndex)
    DragonVisible = DragonAvailable
    SwordVisible = True
    ShieldVisible = True
    Ready = CharacterViewer.ValidateProfile(ActiveProfile)
    Ready = Window_Title(ViewerTitle()) And Ready

    Call CaptureViewerFailure(30)

    Character = Character3D.LoadWithPolicy(
        ActiveProfile.AssetPath,
        Character3D.CHARACTER_LOAD_REQUIRE_PBR
    )
    Ready = Character3D.IsValid(Character) And Ready

    Call CaptureViewerFailure(31)

    Ready = ValidateLoadedProfile() And Ready

    Call CaptureViewerFailure(32)

    LocalCharacterBounds = Character3D.LocalBounds(Character)
    BaseCamera = Graphics3D.DefaultCamera()
    ViewerFrame = CharacterViewer.AutoFit(
        ActiveProfile,
        LocalCharacterBounds,
        Max(1, Window_Width() - 284),
        Max(1, Window_Height()),
        BaseCamera.FovDegrees
    )
    Ready = ViewerFrame.Valid And Ready

    Call CaptureViewerFailure(33)

    BaseCamera.Position.X = 0
    BaseCamera.Position.Y = ViewerFrame.CameraY
    BaseCamera.Position.Z = ViewerFrame.CameraZ
    BaseCamera.Target.X = 0
    BaseCamera.Target.Y = ViewerFrame.TargetY
    BaseCamera.Target.Z = 0

    If DragonAvailable Then

        BaseCamera.Position.X = ARENA_CAMERA_CENTER_X
        BaseCamera.Position.Y = ViewerFrame.TargetY + ARENA_CAMERA_HEIGHT
        BaseCamera.Position.Z = ARENA_CAMERA_CENTER_Z - ARENA_CAMERA_DISTANCE
        BaseCamera.Target.X = ARENA_CAMERA_CENTER_X
        BaseCamera.Target.Z = ARENA_CAMERA_CENTER_Z

    End If

    Call CreateBackdrop()
    Call CreateStudioGrid()

    Call CaptureViewerFailure(34)

    FloorVisible = True
    GridVisible = True
    FitLocked = True
    LastFitWidth = Window_Width()
    LastFitHeight = Window_Height()

    Call Interaction.ResetCameraControls(CameraControls)
    Call CharacterViewer.InitializeZoom(
        SmoothZoom,
        DefaultZoomDegrees(),
        ZOOM_IN_LIMIT,
        ZOOM_OUT_LIMIT,
        96000
    )

    Ready = Scene3D.SetQuality(Scene3D.QUALITY_HIGH)

    If DragonAvailable Then
        Ready = Scene3D.SetShadowArea(
            DRAGON_POSITION_X / 2,
            ViewerFrame.TargetY,
            DRAGON_POSITION_Z / 2,
            ARENA_FLOOR_WIDTH,
            ARENA_FLOOR_DEPTH,
            ViewerFrame.ShadowNear,
            ARENA_FLOOR_DEPTH
        ) And Ready
    Else
        Ready = Scene3D.SetShadowArea(
            0,
            ViewerFrame.TargetY,
            0,
            ViewerFrame.ShadowWidth,
            ViewerFrame.ShadowDepth,
            ViewerFrame.ShadowNear,
            ViewerFrame.ShadowFar
        ) And Ready
    End If

    Call CaptureViewerFailure(35)

    Call ApplyLighting()

    Ready = Character3D.SetScale(Character, ViewerFrame.ScalePercent) And Ready
    Ready = Character3D.Place(
        Character,
        ViewerFrame.PositionX,
        ViewerFrame.PositionY,
        ViewerFrame.PositionZ
    ) And Ready

    Call ApplyArenaFacing()

    Ready = Character3D.SetShadows(Character, True, True) And Ready

    Call CaptureViewerFailure(36)

    SocketGizmosVisible = False

    Call CreateDragon()

    Call CaptureViewerFailure(37)

    Call CreateSocketGizmos()

    Call CaptureViewerFailure(38)

    Call CreateEpicGlow()

    Call CaptureViewerFailure(39)

    Call ConfigureCalibration()

    Call CaptureViewerFailure(40)

    PlaybackSpeed = ActiveProfile.DefaultPlaybackSpeed
    MaterialInspection = Graphics3D.MATERIAL_INSPECTION_LIT
    Ready = Graphics3D.SetMaterialInspection3D(MaterialInspection) And Ready

    Call CaptureViewerFailure(41)

    Call RestartPresentation()

    Call CaptureViewerFailure(42)

    SwordFireVisible = True
    ShieldFireVisible = True
    FlameAnimationPaused = False
    ShieldFireFailed = False
    SwordFireFailed = False
    SwordFireReady = False

    FireInitialized = False

    If DragonAvailable Then
        FireInitialized = Fire.Initialize("Assets/Fire")

        Call DragonPresence.Initialize()
    End If

    If CalibrationAvailable And ProfileIndex = ViewerProfiles.PROFILE_ARIN Then
        SwordFireReady = FireInitialized
        SwordFireFailed = Not SwordFireReady
    End If

    If SwordFireReady Then
        SwordFireReady = Graphics3D.ConfigureSoftDepth3D(1)
        SwordFireReady = Graphics3D.ConfigureDistortion3D(1, 2) And SwordFireReady
    End If

    If PartyMode Then
        Call CreatePartyCompanion()
    End If

    If PartyMode Or ProfileIndex = ViewerProfiles.PROFILE_ORIN Then
        Call OrinStorm.Initialize()
    End If

    ViewerEpoch = Graphics3D.ResourceEpoch3D()

    If Not Ready Then
        Call RecordViewerError()
    End If

End Sub

Function ValidateLoadedProfile() As Boolean

    Dim Result As Boolean
    Dim Index As Number

    Result = Character3D.IsValid(Character)
    Result = Character3D.ClipCount(Character) = ActiveProfile.ExpectedClipCount And Result
    Result = Character3D.SocketCount(Character) = ActiveProfile.ExpectedSocketCount And Result

    For Index = 0 To ViewerProfiles.ClipCount(ProfileIndex) - 1
        Result = Character3D.HasClip(
            Character,
            ViewerProfiles.ClipName(ProfileIndex, Index)
        ) And Result
    End For

    For Index = 0 To ViewerProfiles.SocketCount(ProfileIndex) - 1
        Result = Character3D.HasSocket(
            Character,
            ViewerProfiles.SocketName(ProfileIndex, Index)
        ) And Result
    End For

    Return Result

End Function

Function ViewerFloorWidth() As Number

    Dim Result As Number

    Result = ViewerFrame.FloorWidth

    If DragonAvailable Then
        Result = Max(Result, ARENA_FLOOR_WIDTH)
    End If

    Return Result

End Function

Function ViewerFloorDepth() As Number

    Dim Result As Number

    Result = ViewerFrame.FloorDepth

    If DragonAvailable Then
        Result = Max(Result, ARENA_FLOOR_DEPTH)
    End If

    Return Result

End Function

Function InitialViewerOrbitYaw() As Number

    Dim Result As Number

    If DragonAvailable Then
        Result = ARENA_INITIAL_ORBIT_YAW
    Else
        Result = ViewerProfiles.InitialOrbitYaw(ProfileIndex)
    End If

    Return Result

End Function

Function DefaultZoomDegrees() As Number

    Dim Result As Number

    If DragonAvailable Then
        Result = ARENA_DEFAULT_ZOOM_DEGREES
    Else
        Result = DEFAULT_ZOOM_DEGREES
    End If

    Return Result

End Function

Sub ApplyArenaFacing()

    If DragonAvailable Then
        Ready = FaceDragon(Character, CharacterArenaYawAdjustment()) And Ready
    Else
        Ready = Character3D.Rotate(Character, 0, 0, 0) And Ready
    End If

End Sub

Function CharacterArenaYawAdjustment() As Number

    Dim Result As Number

    If ProfileIndex = ViewerProfiles.PROFILE_ORIN Then
        Result = ORIN_ARENA_YAW_ADJUSTMENT
    End If

    Return Result

End Function

Function FaceDragon(
    ByRef Value As Character3D.Actor,
    YawAdjustment As Number
) As Boolean

    Dim DragonYaw As Number
    Dim Result As Boolean

    Result = Character3D.LookAt(Value, DRAGON_POSITION_X, 0, DRAGON_POSITION_Z)

    If Result Then

        DragonYaw = Character3D.RotationY(Value) + CHARACTER_MODEL_FORWARD_YAW_OFFSET
        DragonYaw = DragonYaw + YawAdjustment
        Result = Character3D.Rotate(Value, 0, DragonYaw, 0)

    End If

    Return Result

End Function

Sub ApplyCharacterPresentationOffset()

    Dim Offset1000 As Number
    Dim OffsetY As Number

    If Not Character3D.IsValid(Character) Then
        Return
    End If

    Offset1000 = ViewerProfiles.ClipVerticalOffset1000(
        ProfileIndex,
        SelectedClipName(),
        CurrentAnimationFrame()
    )
    OffsetY = Offset1000 * ViewerFrame.ScalePercent / 100000
    Ready = Character3D.Place(
        Character,
        ViewerFrame.PositionX,
        ViewerFrame.PositionY + OffsetY,
        ViewerFrame.PositionZ
    ) And Ready

End Sub

Sub CreateDragon()

    Dim DragonReady As Boolean

    If Not DragonAvailable Then
        Return
    End If

    Dragon = Character3D.LoadWithPolicy(DRAGON_ASSET_PATH, Character3D.CHARACTER_LOAD_REQUIRE_PBR)
    DragonReady = Character3D.IsValid(Dragon)
    DragonFireFailed = False
    DragonClip = "Idle"

    If DragonReady Then

        DragonReady = Character3D.SetScale(Dragon, DRAGON_SCALE_PERCENT) And DragonReady
        DragonReady = Character3D.Place(Dragon, DRAGON_POSITION_X, 0, DRAGON_POSITION_Z) And DragonReady
        DragonReady = Character3D.Rotate(Dragon, 0, DRAGON_ROTATION_Y, 0) And DragonReady
        DragonReady = Character3D.PlayAnimation(Dragon, DragonClip, True) And DragonReady

    End If

    If Not DragonReady Then
        Ready = False

        Call DestroyDragon()
    End If

End Sub

Function DrawDragon() As Boolean

    Dim Result As Boolean

    Result = DragonAvailable And Character3D.IsValid(Dragon)

    If Result Then
        Result = Character3D.Draw(Dragon)
    End If

    Return Result

End Function

Sub DestroyDragon()

    Dim Ok As Boolean

    If DragonBreath.Slot <> 0 Then
        Ok = Fire.Destroy(DragonBreath)
    End If

    Call Character3D.Destroy(Dragon)

End Sub

Sub UpdateDragon()

    Dim Name As Text
    Dim Mouth As Core.Vector3
    Dim Target As Core.Vector3
    Dim Direction As Core.Vector3
    Dim Time As Number
    Dim Travel1000 As Number
    Dim Breathe As Boolean
    Dim Ok As Boolean

    If Not DragonAvailable Or Not Character3D.IsValid(Dragon) Then
        Return
    End If

    Name = "Idle"

    If PartyMode And PartyTurn = 2 Then

        If DragonCounter Mod 3 = 0 Then
            Name = "FireBreath"
        Else If DragonCounter Mod 3 = 1 Then
            Name = "ClawStrike"
        Else
            Name = "Fireball"
        End If

    Else If (PartyMode And
        DragonReactionPending And
        PartyStage = 1 And
        PartyElapsed >= 1300 + PartyAttackDuration() * 64 / 100) Then

        Name = "Hit"
        DragonReactionPending = False

    Else If DragonClip = "Hit" And Character3D.AnimationTime(Dragon) < 800 Then

        Name = "Hit"

    End If

    If Name <> DragonClip Then

        DragonClip = Name

        If Name = "Idle" Then
            Ready = Character3D.PlayMode(Dragon, Name, Graphics3D.ANIMATION_LOOP, PlaybackSpeed) And Ready
        Else
            Ready = Character3D.PlayMode(Dragon, Name, Graphics3D.ANIMATION_ONCE, PlaybackSpeed) And Ready
        End If

    End If

    Ready = Character3D.Update(Dragon, AnimationUpdateElapsed) And Ready
    Time = Character3D.AnimationTime(Dragon)
    Travel1000 = 0

    If Name = "ClawStrike" Then

        Travel1000 = Min(1000, Time * 1000 / 1100)

        If Time > 1100 Then
            Travel1000 = Max(0, (2200 - Time) * 1000 / 1100)
        End If

        Travel1000 = Travel1000 * Travel1000 / 1000 * (3000 - 2 * Travel1000) / 1000

    End If

    Ready = Character3D.Place(Dragon,
        DRAGON_POSITION_X + 79 * Travel1000 / 1000, 0,
        DRAGON_POSITION_Z + 30 * Travel1000 / 1000) And Ready
    Breathe = (DragonVisible And Name = "FireBreath" And Time >= 850 And Time < 3100)

    If (Breathe And
        FireInitialized And
        Not DragonFireFailed) Then

        Mouth = Character3D.SocketPosition(Dragon, "Mouth")
        Target = Character3D.SocketPosition(Character, "Chest", BODY_PART_INDEX)

        If PartyReady And Time > 1900 Then
            Target = Character3D.SocketPosition(PartyCompanion.Actor, "Chest", BODY_PART_INDEX)
        End If

        If DragonBreath.Slot = 0 Then
            DragonBreath = Fire.StartAt("DragonFireBreathPreview", Mouth, 3117,
                Fire.QUALITY_HIGH, Fire.SIMULATION_AUTO, 6)
            DragonFireFailed = DragonBreath.Slot = 0
        End If

        If DragonBreath.Slot <> 0 Then

            Direction = Math3D.Subtract(Target, Mouth)
            Direction.X = Direction.X * 2
            Direction.Y = Direction.Y * 2
            Direction.Z = Direction.Z * 2
            Ok = Fire.SetPosition(DragonBreath, Mouth)
            Ok = Fire.SetDirection(DragonBreath, Direction) And Ok
            DragonFireFailed = Not Ok

            Call Fire.SetIntensity(DragonBreath, 160)
            Call Fire.SetSourceVelocityInheritance(DragonBreath, 0)

        End If

    Else If DragonBreath.Slot <> 0 Then

        Ok = Fire.Destroy(DragonBreath)

    End If

    Target = Character3D.SocketPosition(Character, "Chest", BODY_PART_INDEX)

    If PartyReady And DragonCounter Mod 2 = 1 Then
        Target = Character3D.SocketPosition(PartyCompanion.Actor, "Chest", BODY_PART_INDEX)
    End If

    Call DragonPresence.Update(Dragon, Name, Time, Target, DragonVisible And FireInitialized)

    If (FireInitialized And
        Not SwordFireReady And
        Not FlameAnimationPaused) Then
        Call Fire.Update(CameraElapsed)
    End If

End Sub

Sub UpdateBattleAudio()

    Dim Name As Text
    Dim CueTime As Number
    Dim Audible As Boolean

    Name = SelectedClipName()
    CueTime = -1

    If ProfileIndex = ViewerProfiles.PROFILE_ARIN Then

        If Name = "SwordAttack" Then
            CueTime = 280
        Else If Name = "SwordAttack2" Then
            CueTime = 160
        End If

    End If

    Audible = Not ScenePaused And Not CalibrationEditing

    If BattleAudio.CrossedCue(ArinAudio, Name,
        Character3D.AnimationTime(Character), CueTime, Audible) Then

        If Name = "SwordAttack" Then

            Play Sound "Assets/Audio/arin-flame-slash.wav"

        Else

            Play Sound "Assets/Audio/arin-flame-crosscut.wav"

        End If

    End If

    If Not DragonAvailable Or Not Character3D.IsValid(Dragon) Then
        Return
    End If

    CueTime = -1

    If DragonClip = "FireBreath" Then
        CueTime = 100
    Else If DragonClip = "ClawStrike" Then
        CueTime = 200
    End If

    If BattleAudio.CrossedCue(DragonAudio, DragonClip,
        Character3D.AnimationTime(Dragon), CueTime, Audible And DragonVisible) Then

        If DragonClip = "FireBreath" Then

            Play Sound "Assets/Audio/dragon-fire-breath.wav"

        Else

            Play Sound "Assets/Audio/dragon-claw-strike.wav"

        End If

    End If

End Sub

Sub CreateStudioGrid()

    Arena = Arena3D.Create(ViewerFloorWidth(), ViewerFloorDepth(), 24, 150, 255)
    Ready = Arena.Ready And Ready

End Sub

Function DrawStudioGrid() As Boolean

    Dim Result As Boolean

    Result = Arena3D.Draw(Arena, False, True)
    Return Result

End Function

Sub DestroyStudioGrid()

    Call Arena3D.Destroy(Arena)

End Sub

Sub AdvanceFrameRate()

    FrameRateElapsed = FrameRateElapsed + RawFrameMilliseconds
    FrameRateFrames = FrameRateFrames + 1

    If FrameRateElapsed >= 500 Then

        CurrentFramesPerSecond = FrameRateFrames * 1000 / FrameRateElapsed
        FrameRateElapsed = 0
        FrameRateFrames = 0

    End If

End Sub

Sub HandleKeyboard(PressedKey As Number)

    If PressedKey = KEY_BACKTICK Then

        UiVisibility = (UiVisibility + 1) Mod 3
        SliderDragOwner = 0
        TimelineScrubbing = False
        TimelineKeyframeDragging = False
        FrameButtonRepeatDirection = 0
        Return

    End If

    If HandleTransformGizmoKeyboard(PressedKey) Then
        Return
    End If

    If PressedKey = KEY_SPACE Then
        Call ToggleScenePause()

        Return
    End If

    If PressedKey = KEY_F Then
        Call ToggleFloorAndGrid()

        Return
    End If

    If PressedKey = KEY_D Then
        Call ToggleDragon()

        Return
    End If

    If PressedKey = KEY_W Then
        Call ToggleSword()

        Return
    End If

    If PressedKey = KEY_S Then
        Call ToggleShield()

        Return
    End If

    If CalibrationEditing Then
        Return
    End If

    If PartyMode Then

        If (PressedKey = KEY_1 Or
            PressedKey = KEY_2 Or
            PressedKey = KEY_3 Or
            PressedKey = KEY_TAB Or
            PressedKey = KEY_R Or
            ((PressedKey = KEY_LEFT Or PressedKey = KEY_RIGHT) And Key_Held(KEY_CONTROL))) Then
            Return
        End If

    End If

    If PressedKey = KEY_B Then

        Call CycleBackground()

    Else If PressedKey = KEY_LEFT And Key_Held(KEY_CONTROL) Then

        Call StepAnimationFrame(-1)

    Else If PressedKey = KEY_RIGHT And Key_Held(KEY_CONTROL) Then

        Call StepAnimationFrame(1)

    Else If PressedKey = KEY_LEFT And SocketGizmosVisible Then

        Call SelectPreviousSocket()

    Else If PressedKey = KEY_RIGHT And SocketGizmosVisible Then

        Call SelectNextSocket()

    Else If PressedKey = KEY_LEFT Then

        Call NudgeOrbit(-5, 0)

    Else If PressedKey = KEY_RIGHT Then

        Call NudgeOrbit(5, 0)

    Else If PressedKey = KEY_UP Then

        Call NudgeOrbit(0, -5)

    Else If PressedKey = KEY_DOWN Then

        Call NudgeOrbit(0, 5)

    Else If PressedKey = KEY_A Then

        Call NudgePan(5, 0)

    Else If PressedKey = KEY_1 And Character3D.ClipCount(Character) > 0 Then

        Call SelectPresentationClip(0)

    Else If PressedKey = KEY_2 And Character3D.ClipCount(Character) > 1 Then

        Call SelectPresentationClip(1)

    Else If PressedKey = KEY_3 And Character3D.ClipCount(Character) > 2 Then

        Call SelectPresentationClip(2)

    Else If PressedKey = KEY_ENTER Then

        If ViewerError Then
            Call RetryViewer()
        Else

            Call ResetAll()
        End If

    Else If PressedKey = KEY_O Then

        Call ToggleAutoOrbit()

    Else If PressedKey = KEY_G Then

        GridVisible = Not GridVisible

    Else If PressedKey = KEY_4 Then

        Call CycleProfile()

    Else If PressedKey = KEY_TAB Then

        Call SelectPresentationClip(
            (PresentationIndexForRuntimeClip(SelectedClip) + 1) Mod
                ViewerProfiles.ClipCount(ProfileIndex)
        )

    Else If PressedKey = KEY_R Then

        Call PlaySelectedClip()

    End If

End Sub

Function HandleTransformGizmoKeyboard(PressedKey As Number) As Boolean

    If (Not CalibrationAvailable Or
        Not CalibrationVisible Or
        PartyMode Or
        UiVisibility <> 0) Then
        Return False
    End If

    If PressedKey = KEY_ESCAPE Then

        If TransformGizmoDragging Then
            Call CancelTransformGizmoDrag()
        Else If CalibrationEditing Then
            Call CancelCalibrationEdit()
        End If

        Return True

    Else If PressedKey = KEY_X Then

        Call SelectTransformGizmoAxis(CALIBRATION_AXIS_X)

        Return True

    Else If PressedKey = KEY_Y Then

        Call SelectTransformGizmoAxis(CALIBRATION_AXIS_Y)

        Return True

    Else If PressedKey = KEY_Z Then

        Call SelectTransformGizmoAxis(CALIBRATION_AXIS_Z)

        Return True

    Else If (PressedKey = KEY_G And
        CalibrationTarget >= CALIBRATION_TARGET_SWORD) Then

        CalibrationTransform = CALIBRATION_TRANSFORM_MOVE

        Call BeginTransformGizmoDrag(False)

        Return True

    Else If PressedKey = KEY_R Or PressedKey = KEY_E Then

        CalibrationTransform = CALIBRATION_TRANSFORM_ROTATE

        Call BeginTransformGizmoDrag(False)

        Return True

    Else If PressedKey = KEY_ENTER Then

        If TransformGizmoDragging Then
            Call FinishTransformGizmoDrag()
        Else If CalibrationEditing Then
            Call SaveCalibrationFrame()
        Else
            Return False
        End If

        Return True

    End If

    Return False

End Function

Sub SelectTransformGizmoAxis(Axis As Number)

    If Axis < CALIBRATION_AXIS_X Or Axis > CALIBRATION_AXIS_Z Then
        Return
    End If

    If TransformGizmoDragging Then

        Call SetCurrentCalibrationValue(TransformGizmoDragStartValue)

        CalibrationAxis = Axis
        TransformGizmoDragStartValue = CurrentCalibrationValue()
        TransformGizmoDragRemainder = 0

    Else
        CalibrationAxis = Axis

    End If

End Sub

Sub BeginTransformGizmoDrag(PointerOwned As Boolean)

    If TransformGizmoDragging Then
        TransformGizmoPointerOwned = PointerOwned

        Return
    End If

    TransformGizmoOpenedEdit = Not CalibrationEditing

    Call BeginCalibrationEdit()

    TransformGizmoDragging = True
    TransformGizmoPointerOwned = PointerOwned
    TransformGizmoDragStartValue = CurrentCalibrationValue()
    TransformGizmoDragRemainder = 0

End Sub

Sub FinishTransformGizmoDrag()

    TransformGizmoDragging = False
    TransformGizmoPointerOwned = False
    TransformGizmoOpenedEdit = False
    TransformGizmoDragRemainder = 0

End Sub

Sub CancelTransformGizmoDrag()

    Dim OpenedEdit As Boolean

    If Not TransformGizmoDragging Then
        Return
    End If

    OpenedEdit = TransformGizmoOpenedEdit

    If OpenedEdit Then
        Call CancelCalibrationEdit()
    Else

        Call SetCurrentCalibrationValue(TransformGizmoDragStartValue)
    End If

    Call FinishTransformGizmoDrag()

End Sub

Function HandleTransformGizmoPointer() As Boolean

    Dim Axis As Number

    If (Not CalibrationAvailable Or
        Not CalibrationVisible Or
        PartyMode Or
        UiVisibility <> 0 Or
        ViewerError) Then
        Return False
    End If

    Call UpdateTransformGizmo()

    If TransformGizmoDragging Then

        If Pointer_Pressed(POINTER_SECONDARY) Then
            Call CancelTransformGizmoDrag()

            Return True
        End If

        If TransformGizmoPointerOwned Then

            If Pointer_Released(POINTER_PRIMARY) Then
                Call FinishTransformGizmoDrag()

                Return True
            End If

            If Pointer_Held(POINTER_PRIMARY) Or Pointer_Pressed(POINTER_PRIMARY) Then
                Call UpdateTransformGizmoFromPointer()
            End If

        Else

            If Pointer_Pressed(POINTER_PRIMARY) Then
                Call FinishTransformGizmoDrag()

                Return True
            End If

            Call UpdateTransformGizmoFromPointer()

        End If

        Return True

    End If

    If (Not Pointer_Inside() Or
        Not Pointer_Pressed(POINTER_PRIMARY) Or
        Pointer_Y() < 90 Or
        Pointer_X() >= StatusPanelX() Or
        PointerInRectangle(CALIBRATION_PANEL_X, CALIBRATION_PANEL_Y,
            CALIBRATION_PANEL_WIDTH, CALIBRATION_PANEL_HEIGHT)) Then
        Return False
    End If

    Axis = -1

    If CalibrationTransform = CALIBRATION_TRANSFORM_MOVE Then
        Axis = CharacterViewer.TransformGizmoMoveAxisAtPointer(
            TransformGizmo,
            Pointer_X(),
            Pointer_Y(),
            CalibrationAxis,
            TRANSFORM_GIZMO_HIT_RADIUS
        )
    Else
        Axis = CharacterViewer.TransformGizmoRotationAxisAtPointer(
            TransformGizmoOrigin,
            Pointer_X(),
            Pointer_Y(),
            CalibrationAxis,
            TransformGizmoWorldSize,
            Camera,
            Window_Width(),
            Window_Height(),
            TRANSFORM_GIZMO_RING_SEGMENTS,
            TRANSFORM_GIZMO_HIT_RADIUS
        )
    End If

    If Axis < 0 Then
        Return False
    End If

    CalibrationAxis = Axis

    Call BeginTransformGizmoDrag(True)

    Return True

End Function

Sub UpdateTransformGizmoFromPointer()

    Dim PointerAmount As Number
    Dim ValueAmount As Number

    If CalibrationTransform = CALIBRATION_TRANSFORM_MOVE Then

        PointerAmount = CharacterViewer.TransformGizmoAxisPointerDelta(
            TransformGizmo,
            CalibrationAxis,
            Pointer_Delta_X(),
            Pointer_Delta_Y()
        )
        ValueAmount = CharacterViewer.RetainedPointerDelta(
            TransformGizmoDragRemainder,
            PointerAmount,
            TRANSFORM_GIZMO_MOVE_DIVISOR
        )

    Else

        If CalibrationAxis = CALIBRATION_AXIS_X Then
            PointerAmount = 0 - Pointer_Delta_Y()
        Else If CalibrationAxis = CALIBRATION_AXIS_Y Then
            PointerAmount = Pointer_Delta_X()
        Else
            PointerAmount = Pointer_Delta_X() - Pointer_Delta_Y()
        End If

        ValueAmount = CharacterViewer.RetainedPointerDelta(
            TransformGizmoDragRemainder,
            PointerAmount,
            TRANSFORM_GIZMO_ROTATE_DIVISOR
        )

    End If

    If ValueAmount <> 0 Then
        Call AdjustCalibrationValue(ValueAmount)
        Call UpdateTransformGizmo()
    End If

End Sub

Sub UpdateTransformGizmo()

    TransformGizmoOrigin = CurrentTransformGizmoOrigin()
    TransformGizmoWorldSize = Max(36, ViewerFrame.FittedHeight / 5)
    TransformGizmo = CharacterViewer.ProjectTransformGizmo(
        TransformGizmoOrigin,
        TransformGizmoWorldSize,
        Camera,
        Window_Width(),
        Window_Height()
    )

End Sub

Function CurrentTransformGizmoOrigin() As Core.Vector3

    Dim Result As Core.Vector3
    Dim SocketName As Text
    Dim PartIndex As Number

    PartIndex = BODY_PART_INDEX
    SocketName = "HandRight"

    If CalibrationTarget = CALIBRATION_TARGET_SHIELD_WRIST Then
        SocketName = "HandLeft"
    Else If CalibrationTarget = CALIBRATION_TARGET_SWORD Then
        PartIndex = WEAPON_PART_INDEX
        SocketName = "SwordBase"
    Else If CalibrationTarget = CALIBRATION_TARGET_SHIELD Then
        PartIndex = SHIELD_PART_INDEX
        SocketName = "ShieldCenter"
    End If

    Result.X = Character3D.SocketValueThousandths(Character, SocketName,
        Graphics3D.ANIMATOR_SOCKET_POSITION_X, PartIndex) / 1000
    Result.Y = Character3D.SocketValueThousandths(Character, SocketName,
        Graphics3D.ANIMATOR_SOCKET_POSITION_Y, PartIndex) / 1000
    Result.Z = Character3D.SocketValueThousandths(Character, SocketName,
        Graphics3D.ANIMATOR_SOCKET_POSITION_Z, PartIndex) / 1000

    Return Result

End Function

Sub ToggleScenePause()

    ScenePaused = Not ScenePaused

End Sub

Sub ToggleDemo()

    DemoEnabled = Not DemoEnabled
    AnimationCycleElapsed = 0

    Call PlaySelectedClip()

End Sub

Sub CycleBackground()

    BackgroundIndex = (BackgroundIndex + 1) Mod BACKGROUND_COUNT

End Sub

Sub ToggleDragon()

    If DragonAvailable Then
        DragonVisible = Not DragonVisible
    End If

End Sub

Sub ToggleSword()

    If CalibrationAvailable Then

        SwordVisible = Not SwordVisible
        Ready = Character3D.SetPartVisible(
            Character,
            WEAPON_PART_INDEX,
            SwordVisible
        ) And Ready

        If PartyMode And PartyReady Then
            Ready = Character3D.SetPartVisible(PartyCompanion.Actor, WEAPON_PART_INDEX, SwordVisible) And Ready
        End If

    End If

End Sub

Sub ToggleShield()

    If CalibrationAvailable Then

        ShieldVisible = Not ShieldVisible
        Ready = Character3D.SetPartVisible(
            Character,
            SHIELD_PART_INDEX,
            ShieldVisible
        ) And Ready

        If PartyMode And PartyReady Then
            Ready = Character3D.SetPartVisible(PartyCompanion.Actor, SHIELD_PART_INDEX, ShieldVisible) And Ready
        End If

    End If

End Sub

Function BeginViewerScene() As Boolean

    Dim Result As Boolean

    Result = ApplyBackdrop()

    If Not Result Then
        Return False
    End If

    If BackgroundIndex = 1 Then
        Result = Scene3D.Begin(Camera, 0, 96, 32)
    Else If BackgroundIndex = 2 Then
        Result = Scene3D.Begin(Camera, 62, 20, 96)
    Else
        Result = Scene3D.Begin(Camera, 0, 0, 0)
    End If

    Return Result

End Function

Sub CreateBackdrop()

    Dim BackdropReady As Boolean

    BackdropAvailable = False
    BackdropTextureIndex = -1
    BackdropLandscapeTexture = StaticBackdrop3D.Create(BACKDROP_LANDSCAPE_PATH)
    BackdropTitleTexture = StaticBackdrop3D.Create(BACKDROP_TITLE_PATH)
    BackdropReady = BackdropLandscapeTexture.Ready
    BackdropReady = BackdropTitleTexture.Ready And BackdropReady

    If Not BackdropReady Then
        Call DestroyBackdrop()

        Return
    End If

    BackdropAvailable = BackdropReady

End Sub

Function ApplyBackdrop() As Boolean

    Dim Result As Boolean

    Result = True

    If BackdropTextureIndex = BackgroundIndex Then
        Return True
    End If

    If BackdropAvailable And BackgroundIndex = 3 Then
        Result = StaticBackdrop3D.SetActive(BackdropLandscapeTexture)
    Else If BackdropAvailable And BackgroundIndex = 4 Then
        Result = StaticBackdrop3D.SetActive(BackdropTitleTexture)
    Else
        Result = StaticBackdrop3D.ClearActive()
    End If

    If Result Then
        BackdropTextureIndex = BackgroundIndex
    End If

    Return Result

End Function

Sub DestroyBackdrop()

    Dim BackdropCleared As Boolean

    BackdropCleared = StaticBackdrop3D.ClearActive()

    Call StaticBackdrop3D.Destroy(BackdropLandscapeTexture)
    Call StaticBackdrop3D.Destroy(BackdropTitleTexture)

    BackdropAvailable = False
    BackdropTextureIndex = -1

End Sub

Sub ToggleFloorAndGrid()

    If FloorVisible Or GridVisible Then
        FloorVisible = False
        GridVisible = False
    Else
        FloorVisible = True
        GridVisible = True
    End If

End Sub

Sub ToggleEpicGlow()

    If EpicGlowAvailable Then

        EpicGlowVisible = Not EpicGlowVisible

        If EpicGlowVisible Then
            Call ResetEpicGlowTrails()
        End If

    End If

End Sub

Sub RecordViewerError()

    ViewerError = True

    If FirstViewerError = 0 Then

        FirstViewerError = Character3D.LastError()

        If FirstViewerError = 0 Then
            FirstViewerError = Scene3D.LastError()
        End If

    End If

    If FirstRendererError = 0 Then

        FirstRendererError = Character3D.LastRendererError()

        If FirstRendererError = 0 Then
            FirstRendererError = Scene3D.LastRendererError()
        End If

        If FirstRendererError = 0 Then
            FirstRendererError = Graphics3D.LastError()
        End If

    End If

End Sub

Sub CaptureViewerFailure(Stage As Number)

    If Ready Or FirstFailureStage <> 0 Then
        Return
    End If

    FirstFailureStage = Stage
    FirstViewerError = Character3D.LastError()

    If FirstViewerError = 0 Then
        FirstViewerError = Scene3D.LastError()
    End If

    FirstRendererError = Character3D.LastRendererError()

    If FirstRendererError = 0 Then
        FirstRendererError = Scene3D.LastRendererError()
    End If

    If FirstRendererError = 0 Then
        FirstRendererError = Graphics3D.LastError()
    End If

End Sub

Sub RetryViewer()

    Call DestroyViewerResources()
    Call Character3D.Shutdown()
    Call Scene3D.Shutdown()
    Call Graphics3D.ResetRenderer3D()

    Ready = True
    ViewerError = False
    FirstViewerError = 0
    FirstRendererError = 0
    FirstFailureStage = 0

    Call LoadViewer()

End Sub

Sub CycleProfile()

    If CalibrationEditing Then
        CharacterSwitchBlocked = True
        Return
    End If

    Call DestroyViewerResources()

    PartyMode = False
    SelectedCharacterTab = 0
    ProfileIndex = (ProfileIndex + 1) Mod ViewerProfiles.ProfileCount()

    If ProfileIndex = ViewerProfiles.PROFILE_ORIN Then
        SelectedCharacterTab = 1
    End If

    Ready = True
    ViewerError = False
    FirstViewerError = 0
    FirstRendererError = 0
    FirstFailureStage = 0

    Call LoadViewer()

End Sub

Sub CycleMaterialInspection()

    MaterialInspection = (MaterialInspection + 1) Mod 7
    Ready = Graphics3D.SetMaterialInspection3D(MaterialInspection) And Ready

End Sub

Sub ToggleAutoOrbit()

    AutoOrbit = Not AutoOrbit
    AutoOrbitYaw1000 = CameraControls.OrbitYaw * 1000

    If Not AutoOrbit Then
        Call RecordCameraInteraction()
    End If

End Sub

Sub AdvanceAutoOrbit()

    If AutoOrbit Then

        If PartyMode Then
            Ready = CharacterViewer.AdvanceOrbitYaw1000(
                PartyOrbitPhase1000, CameraElapsed, ARENA_ORBIT_DEGREES_PER_SECOND) And Ready
            AutoOrbitYaw1000 = BattleCamera.FrontArcYaw1000(PartyOrbitPhase1000)
        Else
            Ready = CharacterViewer.AdvanceOrbitYaw1000(
                AutoOrbitYaw1000, CameraElapsed, ARENA_ORBIT_DEGREES_PER_SECOND) And Ready
        End If

        CameraControls.OrbitYaw = AutoOrbitYaw1000 / 1000

    End If

End Sub

Sub ApplyPartyAttackCamera()

    Dim Hero As Core.Vector3
    Dim OtherHero As Core.Vector3
    Dim WaistHeight As Number
    Dim Boss As Core.Vector3
    Dim BossHead As Core.Vector3
    Dim Mouth As Core.Vector3
    Dim Desired As Core.Camera3D
    Dim Distance As Number
    Dim DeltaX As Number
    Dim DeltaZ As Number
    Dim Along As Number
    Dim Across As Number
    Dim Height As Number
    Dim Impact1000 As Number
    Dim BattleShot As Boolean
    Dim BossChargeShot As Boolean

    PartyOrbitCamera = Camera
    PartyActiveCamera = 1

    If (Not PartyMode Or
        Not PartyReady Or
        Not DragonAvailable Or
        Not AutoOrbit Or
        Not DragonVisible) Then
        PartyPreviousCamera = 1
        Return
    End If

    BattleShot = PartyStage <= 1

    If PartyTurn = 2 Then
        BattleShot = PartyElapsed < 3000
    End If

    If Not BattleShot Then
        PartyPreviousCamera = 1
        Return
    End If

    Hero = Character3D.SocketPosition(Character, "Chest", BODY_PART_INDEX)

    If PartyTurn = 1 Then
        Hero = Character3D.SocketPosition(PartyCompanion.Actor, "Chest", BODY_PART_INDEX)
    End If

    WaistHeight = Hero.Y - 32

    If PartyTurn = 2 Then

        OtherHero = Character3D.SocketPosition(PartyCompanion.Actor, "Chest", BODY_PART_INDEX)
        WaistHeight = Min(Hero.Y, OtherHero.Y) - 32
        Hero.X = (Hero.X + OtherHero.X) / 2
        Hero.Y = (Hero.Y + OtherHero.Y) / 2
        Hero.Z = (Hero.Z + OtherHero.Z) / 2

    End If

    Boss = Character3D.SocketPosition(Dragon, "Chest")
    BossHead = Character3D.SocketPosition(Dragon, "Head")
    BossChargeShot = (PartyTurn = 2 And
        (PartyElapsed * PlaybackSpeed / 100 < 650 Or
        (DragonCounter Mod 3 = 2 And PartyElapsed * PlaybackSpeed / 100 < 1750)))
    DeltaX = Hero.X - Boss.X
    DeltaZ = Hero.Z - Boss.Z
    Distance = Max(1, Math3D.Distance(Hero, Boss))
    Along = 150
    Across = 120
    Height = 55

    If PartyElapsed < 650 Then

        Along = -105
        Across = 125
        Height = 35

    Else If PartyStage = 0 And PartyTurn <> 2 Then

        Along = 160
        Across = 55
        Height = 65

    Else
        Impact1000 = Min(1000, Max(0, PartyElapsed - 1300) * 1000 / Max(1, PartyAttackDuration()))
        Along = 150 - Impact1000 * 35 / 1000
        Across = 120

    End If

    If PartyElapsed >= 650 Then
        Height = WaistHeight - Hero.Y
    End If

    If PartyTurn = 2 And PartyElapsed >= 650 Then
        Along = 170
        Across = 65
    End If

    Desired = PartyOrbitCamera
    Desired.UpDirection.X = 0
    Desired.UpDirection.Y = Core.FIXED_ONE
    Desired.UpDirection.Z = 0
    Desired.Target.X = (Hero.X + Boss.X) / 2
    Desired.Target.Y = Max(Hero.Y + 12, BossHead.Y - 35)

    If PartyElapsed >= 650 Then
        Desired.Target.Y = (WaistHeight + BossHead.Y) / 2
    End If

    Desired.Target.Z = (Hero.Z + Boss.Z) / 2
    Desired.Position.X = Hero.X + DeltaX * Along / Distance - DeltaZ * Across / Distance
    Desired.Position.Y = Hero.Y + Height
    Desired.Position.Z = Hero.Z + DeltaZ * Along / Distance + DeltaX * Across / Distance

    If PartyTurn = 2 Then

        Desired.Position.X = Desired.Position.X + (Desired.Position.X - Desired.Target.X) * 15 / 100
        Desired.Position.Y = Desired.Position.Y + (Desired.Position.Y - Desired.Target.Y) * 15 / 100
        Desired.Position.Z = Desired.Position.Z + (Desired.Position.Z - Desired.Target.Z) * 15 / 100

    End If

    ''' The orbit stays live. The two battle cameras have independent poses and cut directly.

    Mouth = Character3D.SocketPosition(Dragon, "Mouth")
    PartyDragonCamera = Desired
    PartyDragonCamera.Position.X = BossHead.X - DeltaX * 120 / Distance - DeltaZ * 90 / Distance
    PartyDragonCamera.Position.Y = BossHead.Y + 20
    PartyDragonCamera.Position.Z = BossHead.Z - DeltaZ * 120 / Distance + DeltaX * 90 / Distance
    PartyDragonCamera.Target.X = (Mouth.X * 3 + Hero.X) / 4
    PartyDragonCamera.Target.Y = (Mouth.Y * 3 + Hero.Y) / 4
    PartyDragonCamera.Target.Z = (Mouth.Z * 3 + Hero.Z) / 4

    If PartyPreviousCamera <> 2 Or PartyTurn <> PartyPreviousCameraTurn Then

        PartyShotPosition1000.X = Desired.Position.X * 1000
        PartyShotPosition1000.Y = Desired.Position.Y * 1000
        PartyShotPosition1000.Z = Desired.Position.Z * 1000
        PartyShotTarget1000.X = Desired.Target.X * 1000
        PartyShotTarget1000.Y = Desired.Target.Y * 1000
        PartyShotTarget1000.Z = Desired.Target.Z * 1000

    End If

    PartyShotPosition1000.X = PartyShotPosition1000.X + (Desired.Position.X * 1000 - PartyShotPosition1000.X) * CameraElapsed / (320 + CameraElapsed)
    PartyShotPosition1000.Y = PartyShotPosition1000.Y + (Desired.Position.Y * 1000 - PartyShotPosition1000.Y) * CameraElapsed / (320 + CameraElapsed)
    PartyShotPosition1000.Z = PartyShotPosition1000.Z + (Desired.Position.Z * 1000 - PartyShotPosition1000.Z) * CameraElapsed / (320 + CameraElapsed)
    PartyShotTarget1000.X = PartyShotTarget1000.X + (Desired.Target.X * 1000 - PartyShotTarget1000.X) * CameraElapsed / (180 + CameraElapsed)
    PartyShotTarget1000.Y = PartyShotTarget1000.Y + (Desired.Target.Y * 1000 - PartyShotTarget1000.Y) * CameraElapsed / (180 + CameraElapsed)
    PartyShotTarget1000.Z = PartyShotTarget1000.Z + (Desired.Target.Z * 1000 - PartyShotTarget1000.Z) * CameraElapsed / (180 + CameraElapsed)
    PartyHeroCamera = Desired
    PartyHeroCamera.Position.X = PartyShotPosition1000.X / 1000
    PartyHeroCamera.Position.Y = PartyShotPosition1000.Y / 1000
    PartyHeroCamera.Position.Z = PartyShotPosition1000.Z / 1000
    PartyHeroCamera.Target.X = PartyShotTarget1000.X / 1000
    PartyHeroCamera.Target.Y = PartyShotTarget1000.Y / 1000
    PartyHeroCamera.Target.Z = PartyShotTarget1000.Z / 1000
    Camera = PartyHeroCamera
    PartyActiveCamera = 2

    If BossChargeShot Then
        Camera = PartyDragonCamera
        PartyActiveCamera = 3
    End If

    PartyPreviousCamera = PartyActiveCamera
    PartyPreviousCameraTurn = PartyTurn

End Sub

Sub AdvanceAnimationSequence()

    Dim ClipCount As Number
    Dim CurrentAnimationTime As Number

    If Not DemoEnabled Or PartyMode Then
        Return
    End If

    ClipCount = Character3D.ClipCount(Character)
    CurrentAnimationTime = Character3D.AnimationTime(Character)
    AnimationCycleElapsed = AnimationCycleElapsed + PresentationElapsed

    If CurrentAnimationTime < DemoPreviousAnimationTime Then
        DemoCompletedLoops = DemoCompletedLoops + 1
    End If

    DemoPreviousAnimationTime = CurrentAnimationTime

    If (DemoCompletedLoops >= DemoRequiredLoops() Or
        (SelectedClipMode() = Graphics3D.ANIMATION_ONCE And
        AnimationCycleElapsed >= DemoSequenceTargetMilliseconds() And
        CurrentAnimationTime >= Character3D.ClipDuration(Character, SelectedClip))) Then
        SelectedClip = RuntimeClipForPresentationIndex(
            (PresentationIndexForRuntimeClip(SelectedClip) + 1) Mod ClipCount
        )

        Call PlaySelectedClip(True)
    End If

End Sub

Function HandleInterfacePointer() As Boolean

    Dim Blocked As Boolean
    Dim ClipCount As Number
    Dim Index As Number
    Dim KeyframeIndex As Number
    Dim Column As Number
    Dim Row As Number
    Dim PanelLeft As Number
    Dim WheelDelta As Number

    If UiVisibility = 2 Then

        If Pointer_Pressed(POINTER_SECONDARY) Then

            If ViewerError Then
                Call RetryViewer()
            Else

                Call ResetAll()
            End If

            Return True

        End If

        Return False

    End If

    PanelLeft = StatusPanelX()

    If PointerInRectangle(18, 62, 326, 26) Then

        If Pointer_Pressed(POINTER_PRIMARY) Then

            If PointerInRectangle(104, 62, 72, 26) Then
                Call SelectCharacterTab(0)
            Else If PointerInRectangle(182, 62, 72, 26) Then
                Call SelectCharacterTab(1)
            Else If PointerInRectangle(260, 62, 72, 26) Then
                Call SelectCharacterTab(2)
            End If

        End If

        Return True

    End If

    If PartyMode Then
        Blocked = HandlePartyPointer()

        Return Blocked
    End If

    If HandleTransformGizmoPointer() Then
        Return True
    End If

    If FrameButtonRepeatDirection <> 0 Then

        If (Pointer_Pressed(POINTER_SECONDARY) Or
            (Not Pointer_Held(POINTER_PRIMARY) And Not Pointer_Pressed(POINTER_PRIMARY))) Then

            FrameButtonRepeatDirection = 0

        Else

            If Timer() >= FrameButtonRepeatAt Then
                Call StepAnimationFrame(FrameButtonRepeatDirection)

                ''' No catch-up burst if rendering or input stalls.
                FrameButtonRepeatAt = Timer() + FRAME_BUTTON_REPEAT_MILLISECONDS
            End If

            Return True

        End If

    End If

    If TimelineKeyframeDragging Then

        If Pointer_Pressed(POINTER_PRIMARY) Or Pointer_Held(POINTER_PRIMARY) Then
            Call UpdateTimelineKeyframeDrag()
        Else

            Call FinishTimelineKeyframeDrag()
        End If

        Return True

    End If

    If HandleSharedSliders() Then
        Return True
    End If

    If (TimelineScrubbing And
        Not Pointer_Held(POINTER_PRIMARY) And
        Not Pointer_Pressed(POINTER_PRIMARY)) Then
        TimelineScrubbing = False
    End If

    If Not Pointer_Inside() Then
        Return False
    End If

    If Pointer_Pressed(POINTER_SECONDARY) Then

        If ViewerError Then
            Call RetryViewer()
        Else

            Call ResetAll()
        End If

        Return True

    End If

    If TimelineScrubbing Then

        If Pointer_Pressed(POINTER_PRIMARY) Or Pointer_Held(POINTER_PRIMARY) Then
            Call SeekFromPointer()
        End If

        If Pointer_Released(POINTER_PRIMARY) Then
            TimelineScrubbing = False
        End If

        Return True

    End If

    If PointerInRectangle(
            TIMELINE_LEFT,
            Window_Height() - 64,
            TimelineWidth(),
            TIMELINE_HEIGHT
        ) Then

        WheelDelta = Pointer_Wheel_Delta()

        If WheelDelta > 0 Then
            Call StepAnimationFrame(1)
        Else If WheelDelta < 0 Then
            Call StepAnimationFrame(-1)
        End If

        If WheelDelta <> 0 Then
            Return True
        End If

    End If

    If ViewerLayoutTooSmall() Then
        Return True
    End If

    If (CalibrationAvailable And
        PointerInRectangle(TIMELINE_LEFT, Window_Height() - 40,
            Text_Width(CalibrationFilePath, 9), 14)) Then

        If Pointer_Pressed(POINTER_PRIMARY) Then
            Ready = File_Reveal(CalibrationFilePath) Or Ready
        End If

        Return True

    End If

    If (UiVisibility = 0 And
        CalibrationAvailable And
        CalibrationVisible And
        PointerInRectangle(
            CALIBRATION_PANEL_X,
            CALIBRATION_PANEL_Y,
            CALIBRATION_PANEL_WIDTH,
            CALIBRATION_PANEL_HEIGHT
        )) Then
        Call HandleCalibrationPanelPointer()

        Return True
    End If

    Blocked = (Pointer_Y() < 90 Or
        Pointer_Y() >= Window_Height() - 100 Or
        (UiVisibility = 0 And Pointer_X() >= PanelLeft And Pointer_Y() >= 82))

    If Not Pointer_Pressed(POINTER_PRIMARY) Then
        Return Blocked
    End If

    KeyframeIndex = TimelineKeyframeAtPointer()

    If PointerInRectangle(TIMELINE_LEFT, Window_Height() - 96, 62, 24) Then

        Call SeekFirstAnimationFrame()

    Else If PointerInRectangle(TIMELINE_LEFT + 68, Window_Height() - 96, 62, 24) Then

        Call SeekCalibrationKeyframe(-1)

    Else If PointerInRectangle(TIMELINE_LEFT + 136, Window_Height() - 96, 62, 24) Then

        Call SeekCalibrationKeyframe(1)

    Else If PointerInRectangle(TIMELINE_LEFT + 204, Window_Height() - 96, 62, 24) Then

        Call StepAnimationFrame(-1)

        FrameButtonRepeatDirection = -1
        FrameButtonRepeatAt = Timer() + FRAME_BUTTON_REPEAT_MILLISECONDS

    Else If PointerInRectangle(TIMELINE_LEFT + 272, Window_Height() - 96, 62, 24) Then

        Call StepAnimationFrame(1)

        FrameButtonRepeatDirection = 1
        FrameButtonRepeatAt = Timer() + FRAME_BUTTON_REPEAT_MILLISECONDS

    Else If KeyframeIndex >= 0 Then

        Call BeginTimelineKeyframeDrag(KeyframeIndex)

    Else If PointerInRectangle(
        TIMELINE_LEFT,
        Window_Height() - 64,
        TimelineWidth(),
        TIMELINE_HEIGHT
    ) Then

        TimelineScrubbing = True

        Call SeekFromPointer()

    Else If UiVisibility <> 0 Then

        Return Blocked

    Else If PointerInRectangle(PanelLeft, 18, 44, 34) Then

        Call CycleLighting()

    Else If PointerInRectangle(PanelLeft + 48, 18, 56, 34) Then

        Call CycleMaterialInspection()

    Else If PointerInRectangle(PanelLeft + 108, 18, 50, 34) Then

        Call CycleSocketDisplay()

    Else If PointerInRectangle(PanelLeft + 162, 18, 50, 34) Then

        Call CycleProfile()

    Else If PointerInRectangle(PanelLeft + 216, 18, 36, 34) Then

        Call ToggleEpicGlow()

    Else If PointerInRectangle(PanelLeft, 56, 72, 22) Then

        Call ToggleDragon()

    Else If PointerInRectangle(PanelLeft + 76, 56, 48, 22) Then

        Call CycleBackground()

    Else If PointerInRectangle(PanelLeft + 128, 56, 36, 22) Then

        CalibrationVisible = CalibrationAvailable And Not CalibrationVisible

    Else If PointerInRectangle(PanelLeft + 168, 56, 40, 22) Then

        Call ToggleSword()

    Else If PointerInRectangle(PanelLeft + 212, 56, 40, 22) Then

        Call ToggleShield()

    Else If PointerInRectangle(PanelLeft + 178, 330, 74, 18) Then

        Call ToggleDemo()

    Else If PointerInRectangle(PanelLeft + 12, 444, 78, 22) Then

        Call ToggleFloorAndGrid()

    Else If PointerInRectangle(PanelLeft + 94, 444, 76, 22) Then

        If ProfileIndex = ViewerProfiles.PROFILE_ORIN Then
            Call OrinStorm.CycleStyle()
        Else
            SwordFireVisible = Not SwordFireVisible
        End If

    Else If PointerInRectangle(PanelLeft + 174, 444, 78, 22) Then

        If ProfileIndex = ViewerProfiles.PROFILE_ORIN Then
            Call OrinStorm.CycleStyle()
        Else
            ShieldFireVisible = Not ShieldFireVisible
        End If

    Else If (ProfileIndex = ViewerProfiles.PROFILE_ORIN And
        PointerInRectangle(PanelLeft + 12, 470, 128, 20)) Then

        Call OrinStorm.CycleComfort()

    Else If (SwordFireReady And
        PointerInRectangle(PanelLeft + 12, 470, 128, 20)) Then

        FlameAnimationPaused = Not FlameAnimationPaused

    Else If PointerInRectangle(PanelLeft + 172, 204, 30, 24) Then

        Call AdjustPlaybackSpeed(-25)

    Else If PointerInRectangle(PanelLeft + 208, 204, 30, 24) Then

        Call AdjustPlaybackSpeed(25)

    Else If PointerInRectangle(PanelLeft + 12, Window_Height() - 64, 52, 24) Then

        Call ResetView()

    Else If PointerInRectangle(PanelLeft + 68, Window_Height() - 64, 74, 24) Then

        Call RestartPresentation()

    Else If PointerInRectangle(PanelLeft + 146, Window_Height() - 64, 40, 24) Then

        Call ResetAll()

    Else If PointerInRectangle(PanelLeft + 190, Window_Height() - 64, 50, 24) Then

        FitLocked = Not FitLocked

        If FitLocked Then

            LastFitWidth = -1
            LastFitHeight = -1

            Call UpdateResponsiveFit()

        End If

    End If

    If UiVisibility <> 0 Then
        Return Blocked
    End If

    ClipCount = ViewerProfiles.ClipCount(ProfileIndex)

    For Index = 0 To ClipCount - 1

        Column = Index Mod ANIMATION_BUTTON_COLUMN_COUNT
        Row = Index / ANIMATION_BUTTON_COLUMN_COUNT

        If PointerInRectangle(
            AnimationButtonX() + Column * (ANIMATION_BUTTON_WIDTH + ANIMATION_BUTTON_COLUMN_GAP),
            ANIMATION_BUTTON_Y + Row * (ANIMATION_BUTTON_HEIGHT + ANIMATION_BUTTON_ROW_GAP),
            ANIMATION_BUTTON_WIDTH,
            ANIMATION_BUTTON_HEIGHT
        ) Then
            Call SelectPresentationClip(Index)
        End If

    End For

    Return Blocked

End Function

Function HandleSharedSliders() As Boolean

    Dim Value As Number
    Dim PanelLeft As Number
    Dim PreviousValue As Number

    If UiVisibility <> 0 Then
        Return False
    End If

    PanelLeft = StatusPanelX()
    Value = CameraControls.OrbitYaw

    If UI.UpdateSlider(SliderDragOwner, 1, PanelLeft + 76, Window_Height() - 142,
        CAMERA_SLIDER_WIDTH, CAMERA_SLIDER_HEIGHT, -180, 180, 1, Value) Then

        CameraControls.OrbitYaw = Value
        AutoOrbit = False
        Return True

    End If

    Value = CameraControls.OrbitPitch

    If UI.UpdateSlider(SliderDragOwner, 2, PanelLeft + 76, Window_Height() - 116,
        CAMERA_SLIDER_WIDTH, CAMERA_SLIDER_HEIGHT, -180, 180, 1, Value) Then

        CameraControls.OrbitPitch = Value
        AutoOrbit = False
        Return True

    End If

    Value = CharacterViewer.ZoomTargetDegrees(SmoothZoom)

    If UI.UpdateSlider(SliderDragOwner, 3, PanelLeft + 76, Window_Height() - 90,
        CAMERA_SLIDER_WIDTH, CAMERA_SLIDER_HEIGHT, ZOOM_IN_LIMIT, ZOOM_OUT_LIMIT, -1, Value) Then
        SmoothZoom.Target1000 = Value * 1000
        Return True
    End If

    If CalibrationVisible Or SliderDragOwner = 4 Then

        Value = CurrentCalibrationValue()
        PreviousValue = Value

        If UI.UpdateSlider(SliderDragOwner, 4, CALIBRATION_SLIDER_X, CALIBRATION_SLIDER_Y,
            CALIBRATION_SLIDER_WIDTH, CALIBRATION_SLIDER_HEIGHT,
            CalibrationMinimumValue(), CalibrationMaximumValue(), 1, Value) Then

            If Value <> PreviousValue Then
                Call SetCurrentCalibrationValue(Value)
            End If

            Return True

        End If

    End If

    Return False

End Function

Sub HandleCalibrationPanelPointer()

    If Not Pointer_Pressed(POINTER_PRIMARY) Then
        Return
    End If

    If PointerInRectangle(292, 96, 68, 22) Then

        Call SeekCalibrationKeyframe(-1)

    Else If PointerInRectangle(364, 96, 68, 22) Then

        Call SeekCalibrationKeyframe(1)

    Else If PointerInRectangle(34, 128, 92, 24) Then

        CalibrationTarget = CALIBRATION_TARGET_SWORD_WRIST
        CalibrationTransform = CALIBRATION_TRANSFORM_ROTATE

    Else If PointerInRectangle(130, 128, 96, 24) Then

        CalibrationTarget = CALIBRATION_TARGET_SHIELD_WRIST
        CalibrationTransform = CALIBRATION_TRANSFORM_ROTATE

    Else If PointerInRectangle(230, 128, 76, 24) Then

        CalibrationTarget = CALIBRATION_TARGET_SWORD
        CalibrationGripAnchorActive = False

    Else If PointerInRectangle(310, 128, 76, 24) Then

        CalibrationTarget = CALIBRATION_TARGET_SHIELD
        CalibrationGripAnchorActive = False

    Else If PointerInRectangle(34, 158, 48, 24) Then

        CalibrationAxis = CALIBRATION_AXIS_X

    Else If PointerInRectangle(86, 158, 48, 24) Then

        CalibrationAxis = CALIBRATION_AXIS_Y

    Else If PointerInRectangle(138, 158, 48, 24) Then

        CalibrationAxis = CALIBRATION_AXIS_Z

    Else If PointerInRectangle(202, 158, 72, 24) Then

        CalibrationTransform = CALIBRATION_TRANSFORM_ROTATE

    Else If (PointerInRectangle(278, 158, 72, 24) And
        CalibrationTarget >= CALIBRATION_TARGET_SWORD) Then

        CalibrationTransform = CALIBRATION_TRANSFORM_MOVE

    Else If PointerInRectangle(354, 158, 78, 24) Then

        Call ResetCalibrationTarget()

    Else If PointerInRectangle(332, 412, 100, 24) Then

        Call SaveCalibrationFrame()

    Else If PointerInRectangle(244, 412, 84, 24) Then

        Call CancelCalibrationEdit()

    Else If PointerInRectangle(34, 412, 196, 24) Then

        If CalibrationClearConfirm Then
            Call ClearSelectedClipCalibration()
        Else
            CalibrationClearConfirm = True
            CalibrationClearAllStage = 0
        End If

    Else If PointerInRectangle(34, 268, 80, 24) Then

        If Not CalibrationEditing Then
            Call CopyCurrentCalibrationKeyframe()
        End If

    Else If PointerInRectangle(118, 268, 80, 24) Then

        If Not CalibrationEditing Then
            Call PasteCalibrationKeyframe()
        End If

    Else If PointerInRectangle(202, 268, 90, 24) Then

        If Not CalibrationEditing Then
            Call DeleteCurrentCalibrationKeyframe()
        End If

    Else If PointerInRectangle(34, 298, 100, 24) Then

        Call ReloadCurrentCalibrationKeyframe()

    Else If PointerInRectangle(140, 298, 100, 24) Then

        CalibrationHoldGrip = Not CalibrationHoldGrip

        Call InvalidateVisualHistory()

        CalibrationGripAnchorActive = False

    Else If PointerInRectangle(246, 298, 186, 24) Then

        Call UndoLastCalibrationChange()

    Else If PointerInRectangle(34, 374, 194, 24) Then

        Call BeginCalibrationEdit()

        SwordDecoupled[CalibrationClipBase + SelectedClip] = 1 - SwordDecoupled[CalibrationClipBase + SelectedClip]

    Else If PointerInRectangle(236, 374, 196, 24) Then

        Call BeginCalibrationEdit()

        ShieldDecoupled[CalibrationClipBase + SelectedClip] = 1 - ShieldDecoupled[CalibrationClipBase + SelectedClip]

    End If

End Sub

Sub UpdateCameraPointer(Blocked As Boolean)

    Dim OrbitPressed As Boolean
    Dim OrbitHeld As Boolean
    Dim OrbitReleased As Boolean
    Dim OrbitActive As Boolean
    Dim PanPressed As Boolean
    Dim PanHeld As Boolean
    Dim PanReleased As Boolean
    Dim PanActive As Boolean
    Dim WheelDelta As Number
    Dim PointerDeltaX As Number
    Dim PointerDeltaY As Number
    Dim OrbitDeltaX As Number
    Dim OrbitDeltaY As Number
    Dim PanDeltaX As Number
    Dim PanDeltaY As Number

    OrbitPressed = (Not Blocked And
        (Pointer_Pressed(POINTER_MIDDLE) Or
        (Pointer_Held(POINTER_MIDDLE) And Not CameraControls.Orbiting)))
    OrbitHeld = Pointer_Held(POINTER_MIDDLE)
    OrbitReleased = Pointer_Released(POINTER_MIDDLE)
    OrbitActive = (OrbitPressed Or
        (CameraControls.Orbiting And (OrbitHeld Or OrbitReleased)))
    PanPressed = (Not Blocked And
        (Pointer_Pressed(POINTER_PRIMARY) Or
        (Pointer_Held(POINTER_PRIMARY) And Not CameraControls.Panning)))
    PanHeld = Pointer_Held(POINTER_PRIMARY)
    PanReleased = Pointer_Released(POINTER_PRIMARY)
    PanActive = (PanPressed Or
        (CameraControls.Panning And (PanHeld Or PanReleased)))
    PointerDeltaX = Pointer_Delta_X()
    PointerDeltaY = Pointer_Delta_Y()

    If OrbitPressed Then
        OrbitPointerRemainderX = 0
        OrbitPointerRemainderY = 0
    End If

    If OrbitActive Then
        OrbitDeltaX = CharacterViewer.RetainedPointerDelta(
            OrbitPointerRemainderX,
            PointerDeltaX,
            ORBIT_POINTER_DIVISOR
        )
        OrbitDeltaY = CharacterViewer.RetainedPointerDelta(
            OrbitPointerRemainderY,
            PointerDeltaY,
            ORBIT_POINTER_DIVISOR
        )
    End If

    If PanPressed Then
        PanPointerRemainderX = 0
        PanPointerRemainderY = 0
    End If

    If PanActive Then
        PanDeltaX = CharacterViewer.RetainedPointerDelta(
            PanPointerRemainderX,
            PointerDeltaX,
            PAN_POINTER_DIVISOR
        )
        PanDeltaY = CharacterViewer.RetainedPointerDelta(
            PanPointerRemainderY,
            PointerDeltaY,
            PAN_POINTER_DIVISOR
        )
    End If

    If Not Blocked Then
        WheelDelta = Pointer_Wheel_Delta()
    End If

    If WheelDelta <> 0 Then
        Call AdjustZoomTarget(WheelDelta)
    End If

    Ready = Interaction.UpdateOrbitControls(
        CameraControls,
        OrbitPressed,
        OrbitHeld,
        OrbitReleased,
        0,
        0
    ) And Ready
    Ready = Interaction.UpdatePanZoomControls(
        CameraControls,
        PanPressed,
        PanHeld,
        PanReleased,
        0,
        0,
        0
    ) And Ready

    If OrbitActive Then

        Call RecordCameraInteraction()

        CameraControls.OrbitYaw = CameraControls.OrbitYaw + OrbitDeltaX
        CameraControls.OrbitPitch = CameraControls.OrbitPitch + OrbitDeltaY

    End If

    If PanActive Then

        Call RecordCameraInteraction()

        CameraControls.PanX = CameraControls.PanX - PanDeltaX
        CameraControls.PanY = CameraControls.PanY + PanDeltaY

    End If

    Call ClampCameraControls()

    If PanReleased Then
        PanPointerRemainderX = 0
        PanPointerRemainderY = 0
    End If

    If OrbitReleased Then
        OrbitPointerRemainderX = 0
        OrbitPointerRemainderY = 0
    End If

End Sub

Sub CreateSocketGizmos()

    Dim EmptyTexture As Core.Texture3D
    Dim Index As Number
    Dim GizmosReady As Boolean

    GizmosReady = True
    SocketGizmoCount = 4
    SelectedSocket = 0
    ShowAllSocketOrigins = False
    SocketMarkerMaterial = Graphics3D.CreateMaterial3D(
        EmptyTexture,
        Graphics3D.MATERIAL_ALPHA_ADDITIVE,
        120,
        220,
        255,
        75,
        True,
        100,
        50
    )
    GizmosReady = SocketMarkerMaterial.Handle <> 0 And GizmosReady

    If SocketMarkerMaterial.Handle <> 0 Then
        SocketMarkers = Graphics3D.CreateParticleBatch3D(
            64,
            SocketMarkerMaterial,
            Graphics3D.VFX_BILLBOARD_CAMERA,
            1,
            1
        )
        GizmosReady = SocketMarkers.Handle <> 0 And GizmosReady
    End If

    For Index = 0 To SocketGizmoCount - 1

        SocketGizmos[Index] = Graphics3D.CreateCube3D(3)
        GizmosReady = SocketGizmos[Index].Handle <> 0 And GizmosReady
        GizmosReady = Graphics3D.SetObjectShadowsChecked3D(
            SocketGizmos[Index],
            False,
            False
        ) And GizmosReady

        If Index = 0 Then
            Call Graphics3D.SetObjectColor(SocketGizmos[Index], 255, 255, 255)
        Else If Index = 1 Then
            Call Graphics3D.SetObjectColor(SocketGizmos[Index], 255, 60, 60)
        Else If Index = 2 Then
            Call Graphics3D.SetObjectColor(SocketGizmos[Index], 70, 255, 90)
        Else

            Call Graphics3D.SetObjectColor(SocketGizmos[Index], 80, 140, 255)
        End If

    End For

    If Not GizmosReady Then
        Ready = False

        Call DestroySocketGizmos()
    End If

End Sub

Sub DestroySocketGizmos()

    Dim Index As Number

    Call Graphics3D.DestroyParticleBatch3D(SocketMarkers)
    Call Graphics3D.DestroyMaterial3D(SocketMarkerMaterial)

    For Index = 0 To SocketGizmoCount - 1
        Call Graphics3D.DestroyObject3D(SocketGizmos[Index])
    End For

    SocketGizmoCount = 0
    SocketGizmosVisible = False
    ShowAllSocketOrigins = False

End Sub

Function SocketReferencePart(Name As Text) As Number

    Dim Result As Number

    Result = 0

    If ViewerProfiles.IsPartyCharacter(ProfileIndex) Then

        Result = BODY_PART_INDEX

        If Name = "SwordBase" Or Name = "SwordTip" Then
            Result = WEAPON_PART_INDEX
        Else If (Name = "ShieldCenter" Or
            Name = "ShieldFireLeft" Or
            Name = "ShieldFireRight" Or
            Name = "ShieldFireTip") Then
            Result = SHIELD_PART_INDEX
        End If

    End If

    Return Result

End Function

Sub UpdateSocketGizmos()

    Dim SocketIndex As Number
    Dim Name As Text
    Dim PositionX1000 As Number
    Dim PositionY1000 As Number
    Dim PositionZ1000 As Number
    Dim AxisX1000 As Number
    Dim AxisY1000 As Number
    Dim AxisZ1000 As Number
    Dim AxisLength As Number
    Dim MatrixProperty As Number
    Dim Axis As Number
    Dim SocketCount As Number

    SocketCount = Character3D.SocketCount(Character)
    Name = Character3D.SocketName(Character, SelectedSocket)
    PositionX1000 = Character3D.SocketValueThousandths(
        Character,
        Name,
        Graphics3D.ANIMATOR_SOCKET_POSITION_X,
        SocketReferencePart(Name)
    )
    PositionY1000 = Character3D.SocketValueThousandths(
        Character,
        Name,
        Graphics3D.ANIMATOR_SOCKET_POSITION_Y,
        SocketReferencePart(Name)
    )
    PositionZ1000 = Character3D.SocketValueThousandths(
        Character,
        Name,
        Graphics3D.ANIMATOR_SOCKET_POSITION_Z,
        SocketReferencePart(Name)
    )

    For Axis = 0 To 3

        AxisX1000 = 0
        AxisY1000 = 0
        AxisZ1000 = 0

        If Axis > 0 Then

            MatrixProperty = Graphics3D.ANIMATOR_SOCKET_MATRIX_M11 + (Axis - 1) * 3
            AxisX1000 = Character3D.SocketValueThousandths(
                Character,
                Name,
                MatrixProperty,
                SocketReferencePart(Name)
            )
            AxisY1000 = Character3D.SocketValueThousandths(
                Character,
                Name,
                MatrixProperty + 1,
                SocketReferencePart(Name)
            )
            AxisZ1000 = Character3D.SocketValueThousandths(
                Character,
                Name,
                MatrixProperty + 2,
                SocketReferencePart(Name)
            )
            AxisLength = Max(1, Max(Abs(AxisX1000), Max(Abs(AxisY1000), Abs(AxisZ1000))))
            AxisX1000 = AxisX1000 * 8000 / AxisLength
            AxisY1000 = AxisY1000 * 8000 / AxisLength
            AxisZ1000 = AxisZ1000 * 8000 / AxisLength

        End If

        Call Graphics3D.SetObjectPosition(
            SocketGizmos[Axis],
            (PositionX1000 + AxisX1000) / 1000,
            (PositionY1000 + AxisY1000) / 1000,
            (PositionZ1000 + AxisZ1000) / 1000
        )
    End For

    If ShowAllSocketOrigins Then

        For SocketIndex = 0 To SocketCount - 1

            Name = Character3D.SocketName(Character, SocketIndex)
            PositionX1000 = Character3D.SocketValueThousandths(
                Character,
                Name,
                Graphics3D.ANIMATOR_SOCKET_POSITION_X,
                SocketReferencePart(Name)
            )
            PositionY1000 = Character3D.SocketValueThousandths(
                Character,
                Name,
                Graphics3D.ANIMATOR_SOCKET_POSITION_Y,
                SocketReferencePart(Name)
            )
            PositionZ1000 = Character3D.SocketValueThousandths(
                Character,
                Name,
                Graphics3D.ANIMATOR_SOCKET_POSITION_Z,
                SocketReferencePart(Name)
            )
            Ready = Graphics3D.SetParticle3D(
                SocketMarkers,
                SocketIndex,
                PositionX1000 / 1000,
                PositionY1000 / 1000,
                PositionZ1000 / 1000,
                4,
                0
            ) And Ready
            Ready = Graphics3D.SetParticleColor3D(
                SocketMarkers,
                SocketIndex,
                120,
                220,
                255,
                75
            ) And Ready
        End For

        Ready = Graphics3D.CommitParticleBatch3D(SocketMarkers, SocketCount) And Ready

    End If

End Sub

Function DrawSocketGizmos() As Boolean

    Dim Result As Boolean
    Dim Index As Number

    Result = True

    For Index = 0 To SocketGizmoCount - 1
        Result = Graphics3D.DrawObject3D(SocketGizmos[Index]) And Result
    End For

    If ShowAllSocketOrigins Then
        Result = Graphics3D.DrawParticleBatch3D(SocketMarkers) And Result
    End If

    Return Result

End Function

Sub CreateEpicGlow()

    Dim EmptyTexture As Core.Texture3D
    Dim CharacterModel As Core.Model3D
    Dim CharacterAnimator As Core.Animator3D
    Dim GlowReady As Boolean

    EpicGlowAvailable = ViewerProfiles.EpicGlowAvailable(ProfileIndex)
    EpicGlowAvailable = Character3D.HasSocket(Character, "SwordBase") And EpicGlowAvailable
    EpicGlowAvailable = Character3D.HasSocket(Character, "SwordTip") And EpicGlowAvailable
    EpicGlowAvailable = Character3D.HasSocket(Character, "ShieldCenter") And EpicGlowAvailable
    EpicGlowVisible = ViewerProfiles.EpicGlowVisibleByDefault(ProfileIndex) And EpicGlowAvailable

    If Not EpicGlowAvailable Then
        Return
    End If

    EpicGlowTexture = Graphics3D.LoadTexture3D(
        "TechnicalAssets\Generation2\VfxAtlas.png",
        Graphics3D.TEXTURE_FILTER_LINEAR,
        Graphics3D.TEXTURE_WRAP_CLAMP
    )
    GlowReady = EpicGlowTexture.Handle <> 0

    If GlowReady Then
        EpicGlowMaterial = Graphics3D.CreateEffectMaterial3D(
            EmptyTexture,
            Graphics3D.MATERIAL_ALPHA_ADDITIVE,
            220
        )
        GlowReady = EpicGlowMaterial.Handle <> 0
    End If

    If GlowReady Then
        EpicGlowParticleMaterial = Graphics3D.CreateEffectMaterial3D(
            EpicGlowTexture,
            Graphics3D.MATERIAL_ALPHA_ADDITIVE,
            220
        )
        GlowReady = EpicGlowParticleMaterial.Handle <> 0
    End If

    If GlowReady Then

        CharacterModel.Handle = Character3D.ModelHandle(Character)
        CharacterAnimator.Handle = Character3D.AnimatorHandle(Character)
        SwordGlow = Graphics3D.CreateModelPart3D(CharacterModel, WEAPON_PART_INDEX)
        ShieldGlow = Graphics3D.CreateModelPart3D(CharacterModel, SHIELD_PART_INDEX)
        GlowReady = SwordGlow.Handle <> 0 And ShieldGlow.Handle <> 0

    End If

    If GlowReady Then

        GlowReady = Graphics3D.SetObjectMaterial3D(SwordGlow, EpicGlowMaterial)
        GlowReady = Graphics3D.SetObjectAnimator3D(SwordGlow, CharacterAnimator) And GlowReady
        GlowReady = Graphics3D.SetObjectMaterial3D(ShieldGlow, EpicGlowMaterial)
        GlowReady = Graphics3D.SetObjectAnimator3D(ShieldGlow, CharacterAnimator) And GlowReady
        GlowReady = Graphics3D.SetObjectCullMode3D(
            ShieldGlow,
            Graphics3D.OBJECT_CULL_FRONT
        ) And GlowReady

        Call Graphics3D.SetObjectColor(SwordGlow, 255, 182, 48)
        Call Graphics3D.SetObjectOpacity(SwordGlow, 95)
        Call Graphics3D.SetObjectShadows3D(SwordGlow, False, False)
        Call Graphics3D.SetObjectColor(ShieldGlow, 255, 196, 64)

        If ProfileIndex = ViewerProfiles.PROFILE_ORIN Then
            Call Graphics3D.SetObjectColor(SwordGlow, 255, 255, 255)
            Call Graphics3D.SetObjectColor(ShieldGlow, 255, 255, 255)
        End If

        Call Graphics3D.SetObjectOpacity(ShieldGlow, 90)
        Call Graphics3D.SetObjectShadows3D(ShieldGlow, False, False)

    End If

    If GlowReady Then
        SwordTrail = Graphics3D.CreateParticleBatch3D(
            EQUIPMENT_TRAIL_POINT_COUNT,
            EpicGlowParticleMaterial,
            Graphics3D.VFX_BILLBOARD_CAMERA,
            4,
            4
        )
        GlowReady = SwordTrail.Handle <> 0
    End If

    If GlowReady Then
        ShieldTrail = Graphics3D.CreateParticleBatch3D(
            EQUIPMENT_TRAIL_POINT_COUNT,
            EpicGlowParticleMaterial,
            Graphics3D.VFX_BILLBOARD_CAMERA,
            4,
            4
        )
        GlowReady = ShieldTrail.Handle <> 0
    End If

    If Not GlowReady Then
        Call DestroyEpicGlow()
    Else

        Call ResetEpicGlowTrails()
    End If

End Sub

Sub DestroyEpicGlow()

    Call Graphics3D.DestroyObject3D(SwordGlow)
    Call Graphics3D.DestroyParticleBatch3D(SwordTrail)
    Call Graphics3D.DestroyParticleBatch3D(ShieldTrail)
    Call Graphics3D.DestroyObject3D(ShieldGlow)
    Call Graphics3D.DestroyEffectMaterial3D(EpicGlowParticleMaterial)
    Call Graphics3D.DestroyEffectMaterial3D(EpicGlowMaterial)
    Call Graphics3D.DestroyTexture3D(EpicGlowTexture)

    EpicGlowAvailable = False
    EpicGlowVisible = False

End Sub

''' Resolve sockets through the actual equipment object AFTER pose calibration.
''' Its object matrix includes move/pivot edits and its wrist-decoupling policy.
Sub InvalidateVisualHistory()

    ''' Saturating serial plus a dirty bit stays safe even at the serial limit.
    VisualContinuityEpoch = Min(2147483647, VisualContinuityEpoch + 1)
    VisualHistoryDirty = True

End Sub

Sub UpdateEquipmentFire()

    EquipmentFireFirstSample = VisualHistoryDirty Or EquipmentFireEpoch <> VisualContinuityEpoch

    If EquipmentFireFirstSample Then

        Call ClearEquipmentFire()

        If EpicGlowAvailable Then
            Call ResetEpicGlowTrails()
        End If

        EquipmentFireEpoch = VisualContinuityEpoch
        VisualHistoryDirty = False

    End If

    If Not SwordFireReady Then
        Return
    End If

    Call RecordOptionalFireFailure()

    EquipmentFireWarmup = False

    Call UpdateSwordFire()
    Call UpdateShieldFire()

    If Not FlameAnimationPaused Then

        If EquipmentFireWarmup Then
            Call Fire.Update(100)
        End If

        Call Fire.Update(CameraElapsed)

    End If

    FlamesWerePaused = FlameAnimationPaused

    Call RecordOptionalFireFailure()

End Sub

Sub UpdateOrinStorm()

    Dim Target As Core.Vector3
    Dim Clip As Text

    If Not DragonAvailable Or Not Character3D.IsValid(Dragon) Then
        Return
    End If

    Target = Character3D.SocketPosition(Dragon, "Chest")

    If PartyMode And PartyReady Then
        Clip = Character3D.ClipName(PartyCompanion.Actor, PartyCompanion.Clip)

        Call OrinStorm.Update(PartyCompanion.Actor, Clip, Target, Camera, CameraElapsed,
            EpicGlowVisible, SwordVisible, ShieldVisible, FlameAnimationPaused, ScenePaused)
    Else If ProfileIndex = ViewerProfiles.PROFILE_ORIN Then
        Clip = Character3D.ClipName(Character, SelectedClip)

        Call OrinStorm.Update(Character, Clip, Target, Camera, CameraElapsed,
            EpicGlowVisible, SwordVisible, ShieldVisible, FlameAnimationPaused, ScenePaused)
    End If

End Sub

Sub RecordOptionalFireFailure()

    If EquipmentFireFirstError = 0 And (SwordFireFailed Or ShieldFireFailed) Then

        EquipmentFireFirstError = Fire.Value(12, SwordFire)

        If EquipmentFireFirstError = 0 Then
            EquipmentFireFirstError = Fire.ERROR_RENDERER
        End If

    End If

End Sub

Sub UpdateSwordFire()

    Dim Base As Core.Vector3
    Dim Tip As Core.Vector3
    Dim Delta As Core.Vector3
    Dim Length As Number
    Dim Time As Number
    Dim Restart As Boolean
    Dim Ok As Boolean
    Dim Inheritance As Number

    If SwordFireFailed And SwordFire.Slot <> 0 Then
        Ok = Fire.Destroy(SwordFire)
    End If

    If Not SwordFireReady Or SwordFireFailed Then
        Return
    End If

    If Not SwordFireVisible Or Not SwordVisible Then

        If SwordFire.Slot <> 0 Then
            Ok = Fire.Destroy(SwordFire)
        End If

        Return

    End If

    If (UiVisibility = 0 And
        CalibrationAvailable And
        CalibrationVisible) Then
        Call UpdateTransformGizmo()
        Call DrawTransformGizmo()
    End If

    Base = Character3D.SocketPosition(Character, "SwordBase", WEAPON_PART_INDEX)
    Tip = Character3D.SocketPosition(Character, "SwordTip", WEAPON_PART_INDEX)
    Delta.X = Tip.X - Base.X
    Delta.Y = Tip.Y - Base.Y
    Delta.Z = Tip.Z - Base.Z
    Length = Math3D.Length(Delta)
    Time = Character3D.AnimationTime(Character)

    If Length < 4 Or Length > 10000 Then
        SwordFireFailed = True
        Return
    End If

    ''' Loops and clip changes retain world-space particles; paused pose edits clear stale fire.
    Restart = False

    If ScenePaused And CalibrationEditing Then
        Restart = (Restart Or Base.X <> SwordFireBase.X Or Base.Y <> SwordFireBase.Y Or
            Base.Z <> SwordFireBase.Z Or Tip.X <> SwordFireTip.X Or
            Tip.Y <> SwordFireTip.Y Or Tip.Z <> SwordFireTip.Z)
    End If

    If Restart And SwordFire.Slot <> 0 Then
        Ok = Fire.Destroy(SwordFire)
    End If

    If SwordFire.Slot = 0 Then

        SwordFire = Fire.StartAt("PaladinFlameBlade", Base, 5701,
            Fire.QUALITY_HIGH, Fire.SIMULATION_AUTO, Max(2, Length / 12))
        SwordFireFailed = SwordFire.Slot = 0

        If SwordFireFailed Then
            Return
        End If

        Ok = Fire.SetSegment(SwordFire, Base, Tip)

        EquipmentFireWarmup = True

    Else
        Ok = Fire.SetSegment(SwordFire, Base, Tip)

    End If

    ''' Low inheritance leaves the fuller flame behind the moving blade instead of throwing it ahead.
    Inheritance = 10

    If SelectedClipLabel() = "Walk" Then
        Inheritance = 15
    Else If SelectedClipLabel() = "Run" Then
        Inheritance = 20
    Else If SelectedClipLabel() = "Attack" Or SelectedClipLabel() = "Attack 2" Then
        Inheritance = 10
    End If

    If (Time < SwordFireTime Or
        SelectedClip <> SwordFireClip Or
        ScenePaused Or
        FlameAnimationPaused Or
        FlamesWerePaused Or
        EquipmentFireFirstSample) Then
        Inheritance = 0
    End If

    Call Fire.SetIntensity(SwordFire, 200)
    Call Fire.SetSourceVelocityInheritance(SwordFire, Inheritance)

    SwordFireFailed = Not Ok
    SwordFireBase = Base
    SwordFireTip = Tip
    SwordFireClip = SelectedClip
    SwordFireTime = Time

End Sub

Sub UpdateShieldFire()

    Dim Points[3] As Core.Vector3
    Dim Index As Number
    Dim NextIndex As Number
    Dim Time As Number
    Dim Restart As Boolean
    Dim Ok As Boolean

    If ShieldFireFailed Then

        For Index = 0 To 2

            If ShieldFire[Index].Slot <> 0 Then
                Ok = Fire.Destroy(ShieldFire[Index])
            End If

        End For

        Return

    End If

    If Not ShieldFireVisible Or Not ShieldVisible Then

        For Index = 0 To 2

            If ShieldFire[Index].Slot <> 0 Then
                Ok = Fire.Destroy(ShieldFire[Index])
            End If

        End For

        Return

    End If

    Points[0] = Character3D.SocketPosition(Character, "ShieldFireLeft", SHIELD_PART_INDEX)
    Points[1] = Character3D.SocketPosition(Character, "ShieldFireRight", SHIELD_PART_INDEX)
    Points[2] = Character3D.SocketPosition(Character, "ShieldFireTip", SHIELD_PART_INDEX)
    Time = Character3D.AnimationTime(Character)
    Restart = False

    For Index = 0 To 2

        If ScenePaused And CalibrationEditing Then
            Restart = (Restart Or Points[Index].X <> ShieldFirePoints[Index].X Or
                Points[Index].Y <> ShieldFirePoints[Index].Y Or
                Points[Index].Z <> ShieldFirePoints[Index].Z)
        End If

    End For

    Ok = True

    For Index = 0 To 2

        If Restart And ShieldFire[Index].Slot <> 0 Then
            Ok = Fire.Destroy(ShieldFire[Index]) And Ok
        End If

        If ShieldFire[Index].Slot = 0 Then

            ShieldFire[Index] = Fire.StartAt("LineFire", Points[Index], 5710 + Index,
                Fire.QUALITY_HIGH, Fire.SIMULATION_AUTO, 3)
            Ok = ShieldFire[Index].Slot <> 0 And Ok
            EquipmentFireWarmup = True

        End If

        NextIndex = (Index + 1) Mod 3
        Ok = Fire.SetSegment(ShieldFire[Index], Points[Index], Points[NextIndex]) And Ok

        Call Fire.SetIntensity(ShieldFire[Index], 75)
        Call Fire.SetSourceVelocityInheritance(ShieldFire[Index], 10)

        If (Time < ShieldFireTime Or
            SelectedClip <> ShieldFireClip Or
            ScenePaused Or
            FlameAnimationPaused Or
            FlamesWerePaused Or
            EquipmentFireFirstSample) Then
            Call Fire.SetSourceVelocityInheritance(ShieldFire[Index], 0)
        End If

        ShieldFirePoints[Index] = Points[Index]
    End For

    ShieldFireFailed = Not Ok
    ShieldFireClip = SelectedClip
    ShieldFireTime = Time

End Sub

Sub DrawShieldFire()

    Dim Index As Number
    Dim Ok As Boolean

    If ShieldFireFailed Then
        Return
    End If

    Ok = True

    For Index = 0 To 2

        If ShieldFire[Index].Slot <> 0 Then
            Ok = Fire.Draw(ShieldFire[Index]) And Ok
        End If

    End For

    ShieldFireFailed = Not Ok

End Sub

Function UpdateEpicGlow() As Boolean

    Dim SwordBase As Core.Vector3
    Dim SwordCenter As Core.Vector3
    Dim SwordTip As Core.Vector3
    Dim ShieldCenter As Core.Vector3
    Dim Result As Boolean

    SwordBase = Character3D.SocketPosition(Character, "SwordBase", BODY_PART_INDEX, SwordDecoupled[CalibrationClipBase + SelectedClip] <> 0)
    SwordTip = Character3D.SocketPosition(Character, "SwordTip", BODY_PART_INDEX, SwordDecoupled[CalibrationClipBase + SelectedClip] <> 0)
    ShieldCenter = Character3D.SocketPosition(Character, "ShieldCenter", BODY_PART_INDEX, ShieldDecoupled[CalibrationClipBase + SelectedClip] <> 0)
    SwordCenter.X = (SwordBase.X + SwordTip.X) / 2
    SwordCenter.Y = (SwordBase.Y + SwordTip.Y) / 2
    SwordCenter.Z = (SwordBase.Z + SwordTip.Z) / 2

    If ProfileIndex = ViewerProfiles.PROFILE_ARIN Then
        Call UpdateEpicGlowTrailState(SwordTip, ShieldCenter)
        Call AdvanceEpicGlowTrails(SwordTip, ShieldCenter)
    End If

    Result = UpdateEquipmentGlow(SwordGlow, SwordCenter)
    Result = UpdateEquipmentGlow(ShieldGlow, ShieldCenter) And Result
    Result = UpdateEpicGlowTrailBatches() And Result

    Return Result

End Function

Function UpdateEquipmentGlow(
    ByRef GlowObject As Core.Object3D,
    Center As Core.Vector3
) As Boolean

    Dim OutlineScale As Number
    Dim RotationY As Number
    Dim ScaleDelta As Number
    Dim PositionX As Number
    Dim PositionY As Number
    Dim PositionZ As Number
    Dim ActorPosition As Core.Vector3
    Dim Result As Boolean

    ActorPosition.X = Character3D.PositionX(Character)
    ActorPosition.Y = Character3D.PositionY(Character)
    ActorPosition.Z = Character3D.PositionZ(Character)
    ScaleDelta = Max(2, ViewerFrame.ScalePercent / EQUIPMENT_GLOW_SCALE_DIVISOR)
    OutlineScale = ViewerFrame.ScalePercent + ScaleDelta
    PositionX = (Center.X - ActorPosition.X) * ScaleDelta / ViewerFrame.ScalePercent
    PositionY = (Center.Y - ActorPosition.Y) * ScaleDelta / ViewerFrame.ScalePercent
    PositionZ = (Center.Z - ActorPosition.Z) * ScaleDelta / ViewerFrame.ScalePercent
    PositionX = ActorPosition.X - PositionX
    PositionY = ActorPosition.Y - PositionY
    PositionZ = ActorPosition.Z - PositionZ

    RotationY = Character3D.RotationY(Character)

    Result = Graphics3D.SetObjectPositionChecked3D(GlowObject, PositionX, PositionY, PositionZ)
    Result = Graphics3D.SetObjectRotationChecked3D(GlowObject, 0, RotationY, 0) And Result
    Result = Graphics3D.SetObjectScaleChecked3D(
        GlowObject,
        OutlineScale,
        OutlineScale,
        OutlineScale
    ) And Result

    Return Result

End Function

Function DrawEquipmentGlow() As Boolean

    Dim Result As Boolean

    Result = True

    If SwordVisible Then
        Result = Graphics3D.DrawObject3D(SwordGlow)
    End If

    If (ShieldVisible And
        Not SwordFireReady And
        ProfileIndex <> ViewerProfiles.PROFILE_ORIN) Then
        Result = Graphics3D.DrawObject3D(ShieldGlow) And Result
    End If

    Return Result

End Function

Sub ResetEpicGlowTrails()

    Dim SwordTip As Core.Vector3
    Dim ShieldCenter As Core.Vector3

    SwordTip = Character3D.SocketPosition(Character, "SwordTip", BODY_PART_INDEX)
    ShieldCenter = Character3D.SocketPosition(Character, "ShieldCenter", BODY_PART_INDEX)

    Call SeedEpicGlowTrails(SwordTip, ShieldCenter)

    EquipmentTrailAnimationTime = Character3D.AnimationTime(Character)
    SwordTrailActive = False
    ShieldTrailActive = False

End Sub

Sub SeedEpicGlowTrails(SwordTip As Core.Vector3, ShieldCenter As Core.Vector3)

    Dim Index As Number

    For Index = 0 To EQUIPMENT_TRAIL_POINT_COUNT - 1
        SwordTrailPoints[Index] = SwordTip
        ShieldTrailPoints[Index] = ShieldCenter
    End For

    EquipmentTrailElapsed = 0

End Sub

Sub UpdateEpicGlowTrailState(SwordTip As Core.Vector3, ShieldCenter As Core.Vector3)

    Dim AnimationTime As Number
    Dim NextSwordTrailActive As Boolean
    Dim NextShieldTrailActive As Boolean

    AnimationTime = Character3D.AnimationTime(Character)
    NextSwordTrailActive = (SwordVisible And
        (SelectedClipName() = "SwordAttack" Or SelectedClipName() = "SwordAttack2") And
        AnimationTime >= SWORD_TRAIL_START_MILLISECONDS And
        AnimationTime <= SWORD_TRAIL_END_MILLISECONDS)
    NextShieldTrailActive = (ShieldVisible And
        SelectedClipName() = "BlockImpact" And
        AnimationTime >= SHIELD_TRAIL_START_MILLISECONDS And
        AnimationTime <= SHIELD_TRAIL_END_MILLISECONDS)

    If ((NextSwordTrailActive And Not SwordTrailActive) Or
        (NextShieldTrailActive And Not ShieldTrailActive) Or
        AnimationTime < EquipmentTrailAnimationTime) Then
        Call SeedEpicGlowTrails(SwordTip, ShieldCenter)
    End If

    SwordTrailActive = NextSwordTrailActive
    ShieldTrailActive = NextShieldTrailActive
    EquipmentTrailAnimationTime = AnimationTime

End Sub

Sub AdvanceEpicGlowTrails(SwordTip As Core.Vector3, ShieldCenter As Core.Vector3)

    Dim Index As Number

    If Not SwordTrailActive And Not ShieldTrailActive Then
        Return
    End If

    EquipmentTrailElapsed = EquipmentTrailElapsed + AnimationUpdateElapsed

    If EquipmentTrailElapsed < EQUIPMENT_TRAIL_SAMPLE_MILLISECONDS Then
        Return
    End If

    For Index = 0 To EQUIPMENT_TRAIL_POINT_COUNT - 2
        SwordTrailPoints[Index] = SwordTrailPoints[Index + 1]
        ShieldTrailPoints[Index] = ShieldTrailPoints[Index + 1]
    End For

    SwordTrailPoints[EQUIPMENT_TRAIL_POINT_COUNT - 1] = SwordTip
    ShieldTrailPoints[EQUIPMENT_TRAIL_POINT_COUNT - 1] = ShieldCenter
    EquipmentTrailElapsed = EquipmentTrailElapsed Mod EQUIPMENT_TRAIL_SAMPLE_MILLISECONDS

End Sub

Function UpdateEpicGlowTrailBatches() As Boolean

    Dim ParticleSize As Number
    Dim Opacity As Number
    Dim Index As Number
    Dim Result As Boolean

    Result = True

    For Index = 0 To EQUIPMENT_TRAIL_POINT_COUNT - 1

        Opacity = Index * 7
        ParticleSize = Max(1, SWORD_TRAIL_PARTICLE_SIZE - 1 + Index / 2)
        Result = Graphics3D.SetParticle3D(
            SwordTrail,
            Index,
            SwordTrailPoints[Index].X,
            SwordTrailPoints[Index].Y,
            SwordTrailPoints[Index].Z,
            ParticleSize,
            0,
            4 + Index Mod 4
        ) And Result
        Result = Graphics3D.SetParticleColor3D(
            SwordTrail,
            Index,
            72,
            196,
            255,
            Opacity
        ) And Result
        ParticleSize = Max(1, SHIELD_TRAIL_PARTICLE_SIZE - 1 + Index / 2)
        Result = Graphics3D.SetParticle3D(
            ShieldTrail,
            Index,
            ShieldTrailPoints[Index].X,
            ShieldTrailPoints[Index].Y,
            ShieldTrailPoints[Index].Z,
            ParticleSize,
            0,
            Index Mod 4
        ) And Result
        Result = Graphics3D.SetParticleColor3D(
            ShieldTrail,
            Index,
            255,
            196,
            64,
            Opacity * 3 / 4
        ) And Result
    End For

    If SwordTrailActive Then
        Result = Graphics3D.CommitParticleBatch3D(
            SwordTrail,
            EQUIPMENT_TRAIL_POINT_COUNT
        ) And Result
    Else
        Result = Graphics3D.CommitParticleBatch3D(SwordTrail, 0) And Result
    End If

    If ShieldTrailActive Then
        Result = Graphics3D.CommitParticleBatch3D(
            ShieldTrail,
            EQUIPMENT_TRAIL_POINT_COUNT
        ) And Result
    Else
        Result = Graphics3D.CommitParticleBatch3D(ShieldTrail, 0) And Result
    End If

    Return Result

End Function

Function DrawEpicGlow() As Boolean

    Dim Result As Boolean

    Result = True

    If ProfileIndex <> ViewerProfiles.PROFILE_ARIN Then
        Return True
    End If

    If SwordVisible Then
        Result = Graphics3D.DrawParticleBatch3D(SwordTrail)
    End If

    If ShieldVisible And Not SwordFireReady Then
        Result = Graphics3D.DrawParticleBatch3D(ShieldTrail) And Result
    End If

    Return Result

End Function

Sub CycleSocketDisplay()

    If Not SocketGizmosVisible Then
        SocketGizmosVisible = True
        ShowAllSocketOrigins = False
    Else If Not ShowAllSocketOrigins Then
        ShowAllSocketOrigins = True
    Else
        SocketGizmosVisible = False
        ShowAllSocketOrigins = False
    End If

End Sub

Sub SelectPreviousSocket()

    Dim SocketCount As Number

    SocketCount = Character3D.SocketCount(Character)
    SelectedSocket = (SelectedSocket + SocketCount - 1) Mod SocketCount

End Sub

Sub SelectNextSocket()

    SelectedSocket = (SelectedSocket + 1) Mod Character3D.SocketCount(Character)

End Sub

Sub AdjustPlaybackSpeed(Amount As Number)

    PlaybackSpeed = Min(ActiveProfile.MaximumPlaybackSpeed,
        Max(ActiveProfile.MinimumPlaybackSpeed, PlaybackSpeed + Amount))

    If PartyMode Then
        Call ResetPartyDemo()
    Else

        Call PlaySelectedClip()
    End If

End Sub

Sub ClampCameraControls()

    CameraControls.PanX = Min(ViewerFrame.PanXLimit,
        Max(0 - ViewerFrame.PanXLimit, CameraControls.PanX))
    CameraControls.PanY = Min(ViewerFrame.PanYLimit,
        Max(0 - ViewerFrame.PanYLimit, CameraControls.PanY))

End Sub

Sub NudgeOrbit(DeltaX As Number, DeltaY As Number)

    Call RecordCameraInteraction()

    Ready = Interaction.UpdateOrbitControls(
        CameraControls,
        True,
        True,
        True,
        DeltaX,
        DeltaY
    ) And Ready

    Call ClampCameraControls()

End Sub

Sub NudgePan(DeltaX As Number, DeltaY As Number)

    Call RecordCameraInteraction()

    Ready = Interaction.UpdatePanZoomControls(
        CameraControls,
        True,
        True,
        True,
        DeltaX,
        DeltaY,
        0
    ) And Ready

    Call ClampCameraControls()

End Sub

Sub NudgeZoom(WheelDelta As Number)

    Call AdjustZoomTarget(WheelDelta)

End Sub

Sub AdjustZoomTarget(WheelDelta As Number)

    Call CharacterViewer.AdjustZoomTarget(SmoothZoom, WheelDelta, 8)

End Sub

Sub AdvanceSmoothZoom()

    Ready = CharacterViewer.AdvanceZoom(SmoothZoom, CameraElapsed) And Ready
    CameraControls.Zoom = CharacterViewer.ZoomDegrees(SmoothZoom)

End Sub

Sub ApplyCloseUpZoom()

    Dim Progress1000 As Number
    Dim Distance1000 As Number

    If SmoothZoom.Current1000 >= CLOSE_UP_ZOOM_START * 1000 Then
        Return
    End If

    ''' Continue past the lens limit by moving toward the current (panned) anchor.
    ''' Recompose from the base camera every frame; never accumulate camera drift.
    Progress1000 = ((CLOSE_UP_ZOOM_START * 1000 - SmoothZoom.Current1000) /
        (CLOSE_UP_ZOOM_START - ZOOM_IN_LIMIT))
    Progress1000 = Min(1000, Max(0, Progress1000))
    Distance1000 = 1000 - Progress1000 * (1000 - CLOSE_UP_MINIMUM_DISTANCE_1000) / 1000
    Camera.Position.X = (Camera.Target.X +
        (Camera.Position.X - Camera.Target.X) * Distance1000 / 1000)
    Camera.Position.Y = (Camera.Target.Y +
        (Camera.Position.Y - Camera.Target.Y) * Distance1000 / 1000)
    Camera.Position.Z = (Camera.Target.Z +
        (Camera.Position.Z - Camera.Target.Z) * Distance1000 / 1000)

End Sub

Sub UpdateResponsiveFit()

    If Not FitLocked Then
        Return
    End If

    If Window_Width() = LastFitWidth And Window_Height() = LastFitHeight Then
        Return
    End If

    LastFitWidth = Window_Width()
    LastFitHeight = Window_Height()
    ViewerFrame = CharacterViewer.AutoFit(
        ActiveProfile,
        LocalCharacterBounds,
        Max(1, Window_Width() - 284),
        Max(1, Window_Height()),
        BaseCamera.FovDegrees + CharacterViewer.ZoomDegrees(SmoothZoom)
    )
    BaseCamera.Position.Y = ViewerFrame.CameraY
    BaseCamera.Position.Z = ViewerFrame.CameraZ
    BaseCamera.Target.Y = ViewerFrame.TargetY

    If DragonAvailable Then

        BaseCamera.Position.X = ARENA_CAMERA_CENTER_X
        BaseCamera.Position.Y = ViewerFrame.TargetY + ARENA_CAMERA_HEIGHT
        BaseCamera.Position.Z = ARENA_CAMERA_CENTER_Z - ARENA_CAMERA_DISTANCE
        BaseCamera.Target.X = ARENA_CAMERA_CENTER_X
        BaseCamera.Target.Z = ARENA_CAMERA_CENTER_Z

    End If

End Sub

Sub RestartPresentation()

    If PartyMode And PartyReady Then
        Call ResetPartyDemo()
    End If

    Call ResetView()

    AutoOrbit = True
    AutoOrbitYaw1000 = CameraControls.OrbitYaw * 1000
    AnimationCycleElapsed = 0
    SelectedClip = RuntimeClipForPresentationIndex(0)

    Call PlaySelectedClip()

End Sub

Sub ResetView()

    Call Interaction.ResetCameraControls(CameraControls)

    CameraControls.OrbitYaw = InitialViewerOrbitYaw()
    PartyPreviousCamera = 0
    PartyOrbitPhase1000 = 0
    PanPointerRemainderX = 0
    PanPointerRemainderY = 0
    OrbitPointerRemainderX = 0
    OrbitPointerRemainderY = 0

    Call CharacterViewer.InitializeZoom(
        SmoothZoom,
        DefaultZoomDegrees(),
        ZOOM_IN_LIMIT,
        ZOOM_OUT_LIMIT,
        96000
    )

End Sub

Sub ResetAll()

    If CalibrationEditing Then
        Call CancelCalibrationEdit()
    End If

    PlaybackSpeed = ActiveProfile.DefaultPlaybackSpeed
    ScenePaused = False
    FlameAnimationPaused = False
    UiVisibility = 0
    SwordFireFailed = False
    ShieldFireFailed = False
    EquipmentFireFirstError = 0
    DemoEnabled = True
    FitLocked = True
    LightingIndex = 0
    MaterialInspection = Graphics3D.MATERIAL_INSPECTION_LIT
    BackgroundIndex = 3
    SocketGizmosVisible = False
    ShowAllSocketOrigins = False
    FloorVisible = True
    GridVisible = True
    EpicGlowVisible = ViewerProfiles.EpicGlowVisibleByDefault(ProfileIndex) And EpicGlowAvailable
    DragonVisible = DragonAvailable
    SwordVisible = True
    ShieldVisible = True
    SwordFireVisible = True
    ShieldFireVisible = True
    CalibrationVisible = False
    SliderDragOwner = 0
    FrameButtonRepeatDirection = 0
    TimelineScrubbing = False
    TimelineKeyframeDragging = False

    Call ClearEquipmentFire()
    Call ApplyLighting()
    Call ApplyArenaFacing()

    If CalibrationAvailable Then
        Ready = Character3D.SetPartVisible(Character, WEAPON_PART_INDEX, True) And Ready
        Ready = Character3D.SetPartVisible(Character, SHIELD_PART_INDEX, True) And Ready
    End If

    Ready = Graphics3D.SetMaterialInspection3D(MaterialInspection) And Ready

    Call RestartPresentation()

End Sub

Sub ClearEquipmentFire()

    Dim Index As Number
    Dim Ok As Boolean

    If SwordFire.Slot <> 0 Then
        Ok = Fire.Destroy(SwordFire)
    End If

    For Index = 0 To 2

        If ShieldFire[Index].Slot <> 0 Then
            Ok = Fire.Destroy(ShieldFire[Index])
        End If

    End For

End Sub

Sub RecordCameraInteraction()

    AutoOrbit = False

End Sub

Sub SelectClip(Index As Number)

    SelectedClip = Index
    AnimationCycleElapsed = 0
    DemoEnabled = False
    CalibrationClearConfirm = False
    CalibrationClearAllStage = 0

    Call PlaySelectedClip()

End Sub

Sub SelectPresentationClip(Index As Number)

    Dim RuntimeClip As Number

    RuntimeClip = RuntimeClipForPresentationIndex(Index)

    If RuntimeClip >= 0 Then
        Call SelectClip(RuntimeClip)
    End If

End Sub

Function RuntimeClipForPresentationIndex(Index As Number) As Number

    Dim ClipIndex As Number
    Dim DesiredName As Text
    Dim Result As Number

    Result = -1

    If Index < 0 Or Index >= ViewerProfiles.ClipCount(ProfileIndex) Then
        Return Result
    End If

    DesiredName = ViewerProfiles.ClipName(ProfileIndex, Index)

    For ClipIndex = 0 To Character3D.ClipCount(Character) - 1

        If Character3D.ClipName(Character, ClipIndex) = DesiredName Then
            Return ClipIndex
        End If

    End For

    Return Result

End Function

Function PresentationIndexForRuntimeClip(RuntimeClip As Number) As Number

    Dim Index As Number
    Dim RuntimeName As Text
    Dim Result As Number

    Result = 0
    RuntimeName = Character3D.ClipName(Character, RuntimeClip)

    For Index = 0 To ViewerProfiles.ClipCount(ProfileIndex) - 1

        If ViewerProfiles.ClipName(ProfileIndex, Index) = RuntimeName Then
            Return Index
        End If

    End For

    Return Result

End Function

Sub StepAnimationFrame(Direction As Number)

    Dim SampleRate As Number
    Dim StepMilliseconds As Number
    Dim TargetTime As Number

    Call CancelCalibrationEdit()

    SampleRate = Character3D.ClipSampleRate(Character, SelectedClip)
    StepMilliseconds = Max(1, 1000 / Max(1, SampleRate))
    TargetTime = Character3D.AnimationTime(Character) + Direction * StepMilliseconds
    TargetTime = Max(0, Min(Character3D.ClipDuration(Character, SelectedClip), TargetTime))
    Ready = Character3D.SetAnimationTime(Character, TargetTime) And Ready

    Call InvalidateVisualHistory()

End Sub

Sub SeekFirstAnimationFrame()

    Call CancelCalibrationEdit()

    SelectedTimelineEvent = FirstClipEvent()
    Ready = Character3D.SetAnimationTime(Character, 0) And Ready

    Call InvalidateVisualHistory()

End Sub

Sub SeekCalibrationKeyframe(Direction As Number)

    Dim CandidateIndex As Number
    Dim CurrentFrame As Number
    Dim Index As Number
    Dim KeyCount As Number
    Dim TargetFrame As Number
    Dim TargetTime As Number

    If CalibrationEditing Then
        Call CancelCalibrationEdit()
    End If

    KeyCount = CalibrationKeyframeCounts[CalibrationClipBase + SelectedClip]

    If KeyCount <= 0 Then
        Return
    End If

    CurrentFrame = CurrentAnimationFrame()

    If Direction < 0 Then

        CandidateIndex = KeyCount - 1

        For Index = 0 To KeyCount - 1

            If CalibrationKeyframeFrames[CalibrationClipBase + SelectedClip, Index] < CurrentFrame Then
                CandidateIndex = Index
            End If

        End For

    Else
        CandidateIndex = 0

        For Index = 0 To KeyCount - 1

            If CalibrationKeyframeFrames[CalibrationClipBase + SelectedClip, Index] > CurrentFrame Then
                CandidateIndex = Index
                Exit For
            End If

        End For

    End If

    TargetFrame = CalibrationKeyframeFrames[CalibrationClipBase + SelectedClip, CandidateIndex]
    TargetTime = CalibrationFrameTimeMilliseconds(SelectedClip, TargetFrame)
    Ready = Character3D.SetAnimationTime(Character, TargetTime) And Ready

    Call InvalidateVisualHistory()

    Call UpdateCalibrationForCurrentFrame()
    Call ApplyWristCalibration()

End Sub

Sub SeekAuthoredEvent(Direction As Number)

    Dim CandidateIndex As Number
    Dim CandidateTime As Number
    Dim CurrentAnimationTime As Number
    Dim Duration As Number
    Dim EventIndex As Number
    Dim EventTime As Number

    CurrentAnimationTime = Character3D.AnimationTime(Character)
    Duration = Character3D.ClipDuration(Character, SelectedClip)

    If Direction < 0 Then
        CandidateTime = -1
    Else
        CandidateTime = Duration + 1
    End If

    CandidateIndex = 0

    For EventIndex = 1 To Character3D.EventCount(Character)

        If Character3D.EventClipIndex(Character, EventIndex) = SelectedClip Then

            EventTime = Character3D.EventTime(Character, EventIndex)

            If Direction < 0 And EventTime < CurrentAnimationTime Then

                If EventTime > CandidateTime Then
                    CandidateTime = EventTime
                    CandidateIndex = EventIndex
                End If

            Else If Direction > 0 And EventTime > CurrentAnimationTime Then

                If EventTime < CandidateTime Then
                    CandidateTime = EventTime
                    CandidateIndex = EventIndex
                End If

            End If

        End If

    End For

    If CandidateTime < 0 Then
        CandidateTime = 0
        CandidateIndex = 0
    Else If CandidateTime > Duration Then
        CandidateTime = Duration
        CandidateIndex = 0
    End If

    SelectedTimelineEvent = CandidateIndex
    Ready = Character3D.SetAnimationTime(Character, CandidateTime) And Ready

    Call InvalidateVisualHistory()

End Sub

Sub SeekFromPointer()

    Dim Duration As Number
    Dim TargetTime As Number

    Call CancelCalibrationEdit()

    Duration = Character3D.ClipDuration(Character, SelectedClip)
    TargetTime = (Pointer_X() - TIMELINE_LEFT) * Duration / Max(1, TimelineWidth())
    TargetTime = Max(0, Min(Duration, TargetTime))
    SelectedTimelineEvent = NearestClipEvent(TargetTime)
    Ready = Character3D.SetAnimationTime(Character, TargetTime) And Ready

    Call InvalidateVisualHistory()

End Sub

Function TimelineFrameFromPointer() As Number

    Dim Duration As Number
    Dim Result As Number
    Dim SampleRate As Number
    Dim TargetTime As Number

    Duration = Character3D.ClipDuration(Character, SelectedClip)
    TargetTime = (Pointer_X() - TIMELINE_LEFT) * Duration / Max(1, TimelineWidth())
    TargetTime = Max(0, Min(Duration, TargetTime))
    SampleRate = Max(1, Character3D.ClipSampleRate(Character, SelectedClip))
    Result = (TargetTime * SampleRate + 500) / 1000
    Result = Min(Character3D.ClipSampleCount(Character, SelectedClip) - 1, Max(0, Result))

    Return Result

End Function

Function TimelineKeyframeAtPointer() As Number

    Dim Duration As Number
    Dim Index As Number
    Dim KeyframeTime As Number
    Dim MarkerX As Number
    Dim Result As Number
    Dim TimelineY As Number
    Dim Width As Number

    Result = -1
    TimelineY = Window_Height() - 64

    If Not PointerInRectangle(
        TIMELINE_LEFT,
        TimelineY - TIMELINE_KEYFRAME_HIT_RADIUS,
        TimelineWidth(),
        TIMELINE_HEIGHT + TIMELINE_KEYFRAME_HIT_RADIUS * 2
    ) Then
        Return Result
    End If

    Duration = Max(1, Character3D.ClipDuration(Character, SelectedClip))
    Width = TimelineWidth()

    For Index = 0 To CalibrationKeyframeCounts[CalibrationClipBase + SelectedClip] - 1

        KeyframeTime = CalibrationFrameTimeMilliseconds(
            SelectedClip,
            CalibrationKeyframeFrames[CalibrationClipBase + SelectedClip, Index]
        )
        MarkerX = TIMELINE_LEFT + KeyframeTime * Width / Duration

        If Abs(Pointer_X() - MarkerX) <= TIMELINE_KEYFRAME_HIT_RADIUS Then
            Result = Index
            Exit For
        End If

    End For

    Return Result

End Function

Sub BeginTimelineKeyframeDrag(KeyframeIndex As Number)

    Dim Channel As Number

    TimelineKeyframeDragging = True
    TimelineScrubbing = False
    TimelineDraggedKeyframe = KeyframeIndex
    TimelineDraggedOriginalFrame = CalibrationKeyframeFrames[CalibrationClipBase + SelectedClip, KeyframeIndex]
    TimelineDraggedTargetFrame = TimelineDraggedOriginalFrame

    For Channel = 0 To CALIBRATION_CHANNEL_COUNT - 1
        TimelineDraggedKeyframeValues[Channel] = CalibrationKeyframeValues[CalibrationClipBase + SelectedClip, KeyframeIndex * CALIBRATION_CHANNEL_COUNT + Channel]
    End For

    Call UpdateTimelineKeyframeDrag()

End Sub

Sub UpdateTimelineKeyframeDrag()

    Dim ExistingKeyframe As Number
    Dim TargetFrame As Number
    Dim TargetTime As Number

    TargetFrame = TimelineFrameFromPointer()
    ExistingKeyframe = CalibrationKeyframeIndex(SelectedClip, TargetFrame)

    If ExistingKeyframe < 0 Or ExistingKeyframe = TimelineDraggedKeyframe Then
        TimelineDraggedTargetFrame = TargetFrame
    End If

    TargetTime = CalibrationFrameTimeMilliseconds(SelectedClip, TimelineDraggedTargetFrame)
    Ready = Character3D.SetAnimationTime(Character, TargetTime) And Ready

    Call InvalidateVisualHistory()

End Sub

Sub FinishTimelineKeyframeDrag()

    Dim Channel As Number
    Dim Index As Number
    Dim KeyCount As Number
    Dim Position As Number
    Dim RemainingCount As Number
    Dim Shift As Number

    TimelineKeyframeDragging = False

    If TimelineDraggedTargetFrame = TimelineDraggedOriginalFrame Then
        Return
    End If

    KeyCount = CalibrationKeyframeCounts[CalibrationClipBase + SelectedClip]
    RemainingCount = KeyCount - 1

    For Shift = TimelineDraggedKeyframe To RemainingCount - 1

        CalibrationKeyframeFrames[CalibrationClipBase + SelectedClip, Shift] = CalibrationKeyframeFrames[CalibrationClipBase + SelectedClip, Shift + 1]

        For Channel = 0 To CALIBRATION_CHANNEL_COUNT - 1
            CalibrationKeyframeValues[CalibrationClipBase + SelectedClip, Shift * CALIBRATION_CHANNEL_COUNT + Channel] = CalibrationKeyframeValues[CalibrationClipBase + SelectedClip, (Shift + 1) * CALIBRATION_CHANNEL_COUNT + Channel]
        End For
    End For

    Position = RemainingCount

    For Index = 0 To RemainingCount - 1

        If CalibrationKeyframeFrames[CalibrationClipBase + SelectedClip, Index] >= TimelineDraggedTargetFrame Then
            Position = Index
            Exit For
        End If

    End For

    For Shift = RemainingCount Down To Position + 1

        CalibrationKeyframeFrames[CalibrationClipBase + SelectedClip, Shift] = CalibrationKeyframeFrames[CalibrationClipBase + SelectedClip, Shift - 1]

        For Channel = 0 To CALIBRATION_CHANNEL_COUNT - 1
            CalibrationKeyframeValues[CalibrationClipBase + SelectedClip, Shift * CALIBRATION_CHANNEL_COUNT + Channel] = CalibrationKeyframeValues[CalibrationClipBase + SelectedClip, (Shift - 1) * CALIBRATION_CHANNEL_COUNT + Channel]
        End For
    End For

    CalibrationKeyframeFrames[CalibrationClipBase + SelectedClip, Position] = TimelineDraggedTargetFrame

    For Channel = 0 To CALIBRATION_CHANNEL_COUNT - 1
        CalibrationKeyframeValues[CalibrationClipBase + SelectedClip, Position * CALIBRATION_CHANNEL_COUNT + Channel] = TimelineDraggedKeyframeValues[Channel]
    End For

    Call RefreshCalibrationSavedStatus()
    Call SaveCalibrationKeyframes()
    Call UpdateCalibrationForCurrentFrame()
    Call ApplyWristCalibration()

End Sub

Sub SetHorizontalOrbitFromPointer()

    Dim Value As Number

    Value = ((Pointer_X() - StatusPanelX() - 76) * 360 / CAMERA_SLIDER_WIDTH) - 180
    CameraControls.OrbitYaw = Min(180, Max(-180, Value))
    AutoOrbit = False

End Sub

Sub AdjustHorizontalOrbit(Amount As Number)

    CameraControls.OrbitYaw = Min(180, Max(-180, CameraControls.OrbitYaw + Amount))
    AutoOrbit = False

End Sub

Sub SetVerticalOrbitFromPointer()

    Dim Value As Number

    Value = ((Pointer_X() - StatusPanelX() - 76) * 360 / CAMERA_SLIDER_WIDTH) - 180
    CameraControls.OrbitPitch = Min(180, Max(-180, Value))
    AutoOrbit = False

End Sub

Sub AdjustVerticalOrbit(Amount As Number)

    CameraControls.OrbitPitch = Min(180, Max(-180, CameraControls.OrbitPitch + Amount))
    AutoOrbit = False

End Sub

Sub SetZoomFromPointer()

    Dim Value As Number

    Value = ((Pointer_X() - StatusPanelX() - 76) *
        (ZOOM_OUT_LIMIT - ZOOM_IN_LIMIT) /
        CAMERA_SLIDER_WIDTH) + ZOOM_IN_LIMIT
    Value = Min(ZOOM_OUT_LIMIT, Max(ZOOM_IN_LIMIT, Value))
    SmoothZoom.Current1000 = Value * 1000
    SmoothZoom.Target1000 = SmoothZoom.Current1000
    SmoothZoom.AdvanceRemainder = 0
    CameraControls.Zoom = Value

End Sub

Sub AdjustPreciseZoom(WheelDelta As Number)

    Dim Value As Number

    Value = CharacterViewer.ZoomTargetDegrees(SmoothZoom) - WheelDelta
    Value = Min(ZOOM_OUT_LIMIT, Max(ZOOM_IN_LIMIT, Value))
    SmoothZoom.Current1000 = Value * 1000
    SmoothZoom.Target1000 = SmoothZoom.Current1000
    SmoothZoom.AdvanceRemainder = 0
    CameraControls.Zoom = Value

End Sub

Sub CycleLighting()

    LightingIndex = (LightingIndex + 1) Mod 4

    Call ApplyLighting()

End Sub

Sub ApplyLighting()

    If LightingIndex = 0 Then

        Ready = Graphics3D.ClearAdditionalLights3DChecked() And Ready
        Ready = Graphics3D.SetAmbientLight3D(255, 255, 255, 68) And Ready
        Ready = Graphics3D.SetDirectionalLight3D(-35, -80, 25, 255, 248, 235, 220) And Ready
        Ready = Graphics3D.SetPointLight3D(0, -80, 120, -30, 170, 205, 255, 260, 360) And Ready
        Ready = Graphics3D.SetPointLight3D(1, 80, 80, 0, 255, 205, 145, 180, 300) And Ready

        Call Scene3D.UseCustomLighting()

    Else If LightingIndex = 1 Then

        Ready = Scene3D.UseLighting("CharacterStudio") And Ready

    Else If LightingIndex = 2 Then

        Ready = Scene3D.UseLighting("Daylight") And Ready

    Else
        Ready = Scene3D.UseLighting("Moonlight") And Ready

    End If

End Sub

Sub ConfigureCalibration()

    Dim Index As Number
    Dim Name As Text

    SwordWristNode = -1
    ShieldWristNode = -1

    For Index = 0 To Character3D.SocketCount(Character) - 1

        Name = Character3D.SocketName(Character, Index)

        If Name = "HandRight" Then
            SwordWristNode = Character3D.SocketNodeIndex(Character, Index)
        Else If Name = "HandLeft" Then
            ShieldWristNode = Character3D.SocketNodeIndex(Character, Index)
        End If

    End For

    CalibrationAvailable = (ViewerProfiles.IsPartyCharacter(ProfileIndex) And
        Character3D.PartCount(Character) > WEAPON_PART_INDEX And
        SwordWristNode >= 0 And
        ShieldWristNode >= 0)
    CalibrationVisible = False
    CalibrationTarget = CALIBRATION_TARGET_SWORD_WRIST
    CalibrationAxis = CALIBRATION_AXIS_X
    CalibrationTransform = CALIBRATION_TRANSFORM_ROTATE
    CalibrationSaved = False
    CalibrationEditing = False
    TransformGizmoDragging = False
    TransformGizmoPointerOwned = False
    TransformGizmoOpenedEdit = False
    TransformGizmoDragRemainder = 0
    CharacterSwitchBlocked = False
    CalibrationClearConfirm = False
    CalibrationClearAllStage = 0
    CalibrationClipboardAvailable = False
    CalibrationSaveLimitReached = False

    Call ClearCalibrationMemory()

    CalibrationStorageCount = 0
    CalibrationStorageRejected = False
    CalibrationUndoCount = 0

    If CalibrationAvailable Then
        Call LoadSavedCalibration()
    End If

    If (CalibrationAvailable And
        CalibrationStorageCount = 0 And
        Not CalibrationStorageRejected) Then
        Call SaveCalibrationKeyframes(False)
    End If

End Sub

Sub LoadSavedCalibration()

    Dim LoadedCount As Number
    Dim SavedValue As Number
    Dim StorageVersion As Number

    Load Data CalibrationDataKey Into CalibrationStorage Count LoadedCount

    If LoadedCount > 0 Then

        If DecodeCalibrationStorage(LoadedCount) Then
            CalibrationStorageCount = LoadedCount
            Return
        End If

        Call ClearCalibrationMemory()

        CalibrationStorageRejected = True

        Return

    End If

    If ProfileIndex <> ViewerProfiles.PROFILE_ARIN Then
        Return
    End If

    Load StorageVersion From "CharacterViewerCalibrationVersion" Default 0

    If StorageVersion <> 2 Then
        Return
    End If

    Load CalibrationSavedClip From "CharacterViewerCalibrationClip" Default 0
    Load CalibrationSavedTime From "CharacterViewerCalibrationTime" Default 0
    Load CalibrationSavedFrame From "CharacterViewerCalibrationFrame" Default 0

    If CalibrationSavedClip < 0 Or CalibrationSavedClip >= Character3D.ClipCount(Character) Then
        Return
    End If

    Load SavedValue From "CharacterViewerSwordWristX" Default 0
    SwordWristCalibration[CalibrationClipBase + CalibrationSavedClip, CALIBRATION_AXIS_X] = SavedValue
    Load SavedValue From "CharacterViewerSwordWristY" Default 0
    SwordWristCalibration[CalibrationClipBase + CalibrationSavedClip, CALIBRATION_AXIS_Y] = SavedValue
    Load SavedValue From "CharacterViewerSwordWristZ" Default 0
    SwordWristCalibration[CalibrationClipBase + CalibrationSavedClip, CALIBRATION_AXIS_Z] = SavedValue
    Load SavedValue From "CharacterViewerShieldWristX" Default 0
    ShieldWristCalibration[CalibrationClipBase + CalibrationSavedClip, CALIBRATION_AXIS_X] = SavedValue
    Load SavedValue From "CharacterViewerShieldWristY" Default 0
    ShieldWristCalibration[CalibrationClipBase + CalibrationSavedClip, CALIBRATION_AXIS_Y] = SavedValue
    Load SavedValue From "CharacterViewerShieldWristZ" Default 0
    ShieldWristCalibration[CalibrationClipBase + CalibrationSavedClip, CALIBRATION_AXIS_Z] = SavedValue
    Load SavedValue From "CharacterViewerSwordX" Default 0
    SwordCalibration[CalibrationClipBase + CalibrationSavedClip, CALIBRATION_AXIS_X] = SavedValue
    Load SavedValue From "CharacterViewerSwordY" Default 0
    SwordCalibration[CalibrationClipBase + CalibrationSavedClip, CALIBRATION_AXIS_Y] = SavedValue
    Load SavedValue From "CharacterViewerSwordZ" Default 0
    SwordCalibration[CalibrationClipBase + CalibrationSavedClip, CALIBRATION_AXIS_Z] = SavedValue
    Load SavedValue From "CharacterViewerShieldX" Default 0
    ShieldCalibration[CalibrationClipBase + CalibrationSavedClip, CALIBRATION_AXIS_X] = SavedValue
    Load SavedValue From "CharacterViewerShieldY" Default 0
    ShieldCalibration[CalibrationClipBase + CalibrationSavedClip, CALIBRATION_AXIS_Y] = SavedValue
    Load SavedValue From "CharacterViewerShieldZ" Default 0
    ShieldCalibration[CalibrationClipBase + CalibrationSavedClip, CALIBRATION_AXIS_Z] = SavedValue
    Load SavedValue From "CharacterViewerSwordPositionX" Default 0
    SwordPositionCalibration[CalibrationClipBase + CalibrationSavedClip, CALIBRATION_AXIS_X] = SavedValue
    Load SavedValue From "CharacterViewerSwordPositionY" Default 0
    SwordPositionCalibration[CalibrationClipBase + CalibrationSavedClip, CALIBRATION_AXIS_Y] = SavedValue
    Load SavedValue From "CharacterViewerSwordPositionZ" Default 0
    SwordPositionCalibration[CalibrationClipBase + CalibrationSavedClip, CALIBRATION_AXIS_Z] = SavedValue
    Load SavedValue From "CharacterViewerShieldPositionX" Default 0
    ShieldPositionCalibration[CalibrationClipBase + CalibrationSavedClip, CALIBRATION_AXIS_X] = SavedValue
    Load SavedValue From "CharacterViewerShieldPositionY" Default 0
    ShieldPositionCalibration[CalibrationClipBase + CalibrationSavedClip, CALIBRATION_AXIS_Y] = SavedValue
    Load SavedValue From "CharacterViewerShieldPositionZ" Default 0
    ShieldPositionCalibration[CalibrationClipBase + CalibrationSavedClip, CALIBRATION_AXIS_Z] = SavedValue
    CalibrationSaved = True

    If Not StoreCalibrationKeyframe(CalibrationSavedClip, CalibrationSavedFrame) Then
        Return
    End If

    Call SaveCalibrationKeyframes()

End Sub

Sub ClearCalibrationMemory()

    Dim Axis As Number
    Dim Clip As Number

    For Clip = 0 To CALIBRATION_MAX_CLIPS - 1

        CalibrationKeyframeCounts[CalibrationClipBase + Clip] = 0
        SwordDecoupled[CalibrationClipBase + Clip] = 0
        ShieldDecoupled[CalibrationClipBase + Clip] = 0

        For Axis = 0 To CALIBRATION_AXIS_COUNT - 1

            SwordWristCalibration[CalibrationClipBase + Clip, Axis] = 0
            ShieldWristCalibration[CalibrationClipBase + Clip, Axis] = 0
            SwordCalibration[CalibrationClipBase + Clip, Axis] = 0
            ShieldCalibration[CalibrationClipBase + Clip, Axis] = 0
            SwordPositionCalibration[CalibrationClipBase + Clip, Axis] = 0
            ShieldPositionCalibration[CalibrationClipBase + Clip, Axis] = 0
        End For
    End For

    CalibrationSaved = False
    CalibrationSavedClip = 0
    CalibrationSavedTime = 0
    CalibrationSavedFrame = 0

End Sub

Function DecodeCalibrationStorage(LoadedCount As Number) As Boolean

    Dim Channel As Number
    Dim Clip As Number
    Dim EncodedValue As Number
    Dim FrameValue As Number
    Dim Index As Number
    Dim Keyframe As Number
    Dim KeyframeCount As Number
    Dim Result As Boolean
    Dim StoredClipCount As Number
    Dim StoredChannels As Number
    Dim StoredClip As Number
    Dim NameLength As Number
    Dim NameOffset As Number
    Dim NameIndex As Number
    Dim Candidate As Number
    Dim Matches As Boolean
    Dim Name As Text
    Dim SeenClips[CALIBRATION_MAX_CLIPS] As Number
    Dim SavedRecord As Number
    Dim PreviousFrame As Number

    Result = False

    If LoadedCount < 10 Then
        Return False
    End If

    If (CalibrationStorage[0] <> 83 Or
        CalibrationStorage[1] <> 77 Or
        CalibrationStorage[2] <> 75 Or
        CalibrationStorage[3] <> 70 Or
        (CalibrationStorage[4] <> 2 And
        CalibrationStorage[4] <> CALIBRATION_STORAGE_VERSION)) Then
        Return False
    End If

    If ProfileIndex = ViewerProfiles.PROFILE_ORIN And CalibrationStorage[4] <> 3 Then
        Return False
    End If

    StoredClipCount = CalibrationStorage[5]
    StoredChannels = 18

    If CalibrationStorage[4] >= 2 Then
        StoredChannels = CALIBRATION_CHANNEL_COUNT
    End If

    If (StoredClipCount < 0 Or
        StoredClipCount > CALIBRATION_MAX_CLIPS Or
        StoredClipCount > Character3D.ClipCount(Character) Or
        CalibrationStorage[6] < 0 Or
        CalibrationStorage[6] > 1) Then
        Return False
    End If

    CalibrationSaved = CalibrationStorage[6] <> 0
    SavedRecord = CalibrationStorage[7]
    CalibrationSavedClip = -1
    CalibrationSavedFrame = CalibrationStorage[8] + CalibrationStorage[9] * 256
    Index = 10

    If CalibrationStorage[4] = 3 Then

        If LoadedCount < 74 Then
            Return False
        End If

        For NameIndex = 0 To 63

            If CalibrationStorage[10 + NameIndex] <> Text_Code_At(CalibrationProfileFingerprint, NameIndex) Then
                Return False
            End If

        End For

        Index = 74

    End If

    For StoredClip = 0 To StoredClipCount - 1

        Clip = -1

        If CalibrationStorage[4] = 3 Then

            If Index >= LoadedCount Then
                Return False
            End If

            NameLength = CalibrationStorage[Index]
            Index = Index + 1
            NameOffset = Index
            Index = Index + NameLength

            If (NameLength < 1 Or
                NameLength > 128 Or
                Index > LoadedCount) Then
                Return False
            End If

            For Candidate = 0 To Character3D.ClipCount(Character) - 1

                Name = Character3D.ClipName(Character, Candidate)
                Matches = Text_Length(Name) = NameLength

                If Matches Then

                    For NameIndex = 0 To NameLength - 1

                        If CalibrationStorage[NameOffset + NameIndex] <> Text_Code_At(Name, NameIndex) Then
                            Matches = False
                        End If

                    End For

                End If

                If Matches Then
                    Clip = Candidate
                End If

            End For

        Else

            ''' v2's frozen historical ordering is mapped by name, never today's index.
            Name = LegacyCalibrationClipName(StoredClip)

            For Candidate = 0 To Character3D.ClipCount(Character) - 1

                If Character3D.ClipName(Character, Candidate) = Name Then
                    Clip = Candidate
                End If

            End For

        End If

        If Clip < 0 Then
            Return False
        End If

        If SeenClips[Clip] <> 0 Then
            Return False
        End If

        SeenClips[Clip] = 1

        If SavedRecord = StoredClip Then
            CalibrationSavedClip = Clip
        End If

        If Index + 1 >= LoadedCount Then
            Return False
        End If

        KeyframeCount = CalibrationStorage[Index] + CalibrationStorage[Index + 1] * 256
        Index = Index + 2

        If (KeyframeCount < 0 Or
            KeyframeCount > CALIBRATION_MAX_KEYFRAMES Or
            Index + KeyframeCount * (2 + StoredChannels * 2) > LoadedCount) Then
            Return False
        End If

        CalibrationKeyframeCounts[CalibrationClipBase + Clip] = KeyframeCount
        PreviousFrame = -1

        For Keyframe = 0 To KeyframeCount - 1

            FrameValue = CalibrationStorage[Index] + CalibrationStorage[Index + 1] * 256
            Index = Index + 2

            If (FrameValue <= PreviousFrame Or
                FrameValue >= Character3D.ClipSampleCount(Character, Clip)) Then
                Return False
            End If

            CalibrationKeyframeFrames[CalibrationClipBase + Clip, Keyframe] = FrameValue
            PreviousFrame = FrameValue

            CalibrationKeyframeValues[CalibrationClipBase + Clip, Keyframe * CALIBRATION_CHANNEL_COUNT + 18] = 0
            CalibrationKeyframeValues[CalibrationClipBase + Clip, Keyframe * CALIBRATION_CHANNEL_COUNT + 19] = 0

            For Channel = 0 To StoredChannels - 1

                EncodedValue = CalibrationStorage[Index] + CalibrationStorage[Index + 1] * 256
                Index = Index + 2

                If EncodedValue < 0 Or EncodedValue > 360 Then
                    Return False
                End If

                If Channel >= 18 And (EncodedValue < 180 Or EncodedValue > 181) Then
                    Return False
                End If

                If (Channel >= 12 And
                    Channel < 18 And
                    (EncodedValue < 80 Or EncodedValue > 280)) Then
                    Return False
                End If

                CalibrationKeyframeValues[CalibrationClipBase + Clip, Keyframe * CALIBRATION_CHANNEL_COUNT + Channel] = EncodedValue - 180
            End For
        End For
    End For

    If Index <> LoadedCount Then
        Return False
    End If

    If CalibrationSaved And CalibrationSavedClip < 0 Then
        Return False
    End If

    If CalibrationSaved Then

        If CalibrationKeyframeIndex(CalibrationSavedClip, CalibrationSavedFrame) < 0 Then
            Return False
        End If

    End If

    If Not CalibrationSaved Then
        Call RefreshCalibrationSavedStatus()
    Else
        CalibrationSavedTime = CalibrationFrameTimeMilliseconds(
            CalibrationSavedClip,
            CalibrationSavedFrame
        )
    End If

    Result = True

    Return Result

End Function

Function LegacyCalibrationClipName(Index As Number) As Text

    Dim Result As Text

    If Index = 0 Then
        Result = "BlockImpact"
    Else If Index = 1 Then
        Result = "Defend"
    Else If Index = 2 Then
        Result = "Hit"
    Else If Index = 3 Then
        Result = "Idle"
    Else If Index = 4 Then
        Result = "Run"
    Else If Index = 5 Then
        Result = "SwordAttack"
    Else If Index = 6 Then
        Result = "SwordAttack2"
    Else If Index = 7 Then
        Result = "Walk"
    End If

    Return Result

End Function

Sub SaveCalibrationKeyframes(Optional Persist As Boolean = True)

    Dim Channel As Number
    Dim Clip As Number
    Dim EncodedValue As Number
    Dim FrameValue As Number
    Dim Keyframe As Number
    Dim KeyframeCount As Number
    Dim StorageCount As Number
    Dim StorageVersion As Number
    Dim Index As Number
    Dim Name As Text

    If CalibrationStorageRejected Then
        Return
    End If

    If Persist And Not CalibrationUndoApplying Then

        CalibrationUndoCount = CalibrationStorageCount

        For Index = 0 To CalibrationUndoCount - 1
            CalibrationUndoStorage[Index] = CalibrationStorage[Index]
        End For

    End If

    CalibrationStorage[0] = 83
    CalibrationStorage[1] = 77
    CalibrationStorage[2] = 75
    CalibrationStorage[3] = 70
    CalibrationStorage[4] = CALIBRATION_STORAGE_VERSION
    CalibrationStorage[5] = Character3D.ClipCount(Character)

    If CalibrationSaved Then
        CalibrationStorage[6] = 1
    Else
        CalibrationStorage[6] = 0
    End If

    CalibrationStorage[7] = CalibrationSavedClip
    CalibrationStorage[8] = CalibrationSavedFrame Mod 256
    CalibrationStorage[9] = CalibrationSavedFrame / 256

    For Index = 0 To 63
        CalibrationStorage[10 + Index] = Text_Code_At(CalibrationProfileFingerprint, Index)
    End For

    StorageCount = 74

    For Clip = 0 To Character3D.ClipCount(Character) - 1

        Name = Character3D.ClipName(Character, Clip)
        CalibrationStorage[StorageCount] = Text_Length(Name)
        StorageCount = StorageCount + 1

        For Index = 0 To Text_Length(Name) - 1
            CalibrationStorage[StorageCount] = Text_Code_At(Name, Index)
            StorageCount = StorageCount + 1
        End For

        KeyframeCount = CalibrationKeyframeCounts[CalibrationClipBase + Clip]
        CalibrationStorage[StorageCount] = KeyframeCount Mod 256
        CalibrationStorage[StorageCount + 1] = KeyframeCount / 256
        StorageCount = StorageCount + 2

        For Keyframe = 0 To KeyframeCount - 1

            FrameValue = CalibrationKeyframeFrames[CalibrationClipBase + Clip, Keyframe]
            CalibrationStorage[StorageCount] = FrameValue Mod 256
            CalibrationStorage[StorageCount + 1] = FrameValue / 256
            StorageCount = StorageCount + 2

            For Channel = 0 To CALIBRATION_CHANNEL_COUNT - 1
                EncodedValue = CalibrationKeyframeValues[CalibrationClipBase + Clip, Keyframe * CALIBRATION_CHANNEL_COUNT + Channel] + 180
                CalibrationStorage[StorageCount] = EncodedValue Mod 256
                CalibrationStorage[StorageCount + 1] = EncodedValue / 256
                StorageCount = StorageCount + 2
            End For
        End For
    End For

    If Not DecodeCalibrationStorage(StorageCount) Then
        CalibrationStorageRejected = True
        Return
    End If

    CalibrationStorageCount = StorageCount

    If Persist Then

        Save Data CalibrationStorage Count StorageCount To CalibrationDataKey

        StorageVersion = 3

        If ProfileIndex = ViewerProfiles.PROFILE_ARIN Then
            Save StorageVersion To "CharacterViewerCalibrationVersion"
        End If

        Call InvalidateVisualHistory()

    End If

End Sub

Function CalibrationKeyframeIndex(Clip As Number, FrameValue As Number) As Number

    Dim Index As Number
    Dim Result As Number

    Result = -1

    For Index = 0 To CalibrationKeyframeCounts[CalibrationClipBase + Clip] - 1

        If CalibrationKeyframeFrames[CalibrationClipBase + Clip, Index] = FrameValue Then
            Result = Index
            Exit For
        End If

    End For

    Return Result

End Function

Function StoreCalibrationKeyframe(Clip As Number, FrameValue As Number) As Boolean

    Dim Channel As Number
    Dim Index As Number
    Dim KeyCount As Number
    Dim Position As Number
    Dim Result As Boolean
    Dim Shift As Number

    KeyCount = CalibrationKeyframeCounts[CalibrationClipBase + Clip]
    Position = KeyCount

    For Index = 0 To KeyCount - 1

        If CalibrationKeyframeFrames[CalibrationClipBase + Clip, Index] >= FrameValue Then
            Position = Index
            Exit For
        End If

    End For

    If (Position < KeyCount And
        CalibrationKeyframeFrames[CalibrationClipBase + Clip, Position] = FrameValue) Then

        Result = True

    Else If KeyCount >= CALIBRATION_MAX_KEYFRAMES Then

        Return False

    Else

        For Shift = KeyCount Down To Position + 1

            CalibrationKeyframeFrames[CalibrationClipBase + Clip, Shift] = CalibrationKeyframeFrames[CalibrationClipBase + Clip, Shift - 1]

            For Channel = 0 To CALIBRATION_CHANNEL_COUNT - 1
                CalibrationKeyframeValues[CalibrationClipBase + Clip, Shift * CALIBRATION_CHANNEL_COUNT + Channel] = CalibrationKeyframeValues[CalibrationClipBase + Clip, (Shift - 1) * CALIBRATION_CHANNEL_COUNT + Channel]
            End For
        End For

        CalibrationKeyframeFrames[CalibrationClipBase + Clip, Position] = FrameValue
        CalibrationKeyframeCounts[CalibrationClipBase + Clip] = KeyCount + 1
        Result = True

    End If

    For Channel = 0 To CALIBRATION_CHANNEL_COUNT - 1
        CalibrationKeyframeValues[CalibrationClipBase + Clip, Position * CALIBRATION_CHANNEL_COUNT + Channel] = CalibrationChannelValue(Clip, Channel)
    End For

    Return Result

End Function

Sub RefreshCalibrationSavedStatus()

    Dim Clip As Number

    CalibrationSaved = False
    CalibrationSavedClip = 0
    CalibrationSavedFrame = 0
    CalibrationSavedTime = 0

    For Clip = 0 To Character3D.ClipCount(Character) - 1

        If CalibrationKeyframeCounts[CalibrationClipBase + Clip] > 0 And Not CalibrationSaved Then

            CalibrationSaved = True
            CalibrationSavedClip = Clip
            CalibrationSavedFrame = CalibrationKeyframeFrames[CalibrationClipBase + Clip, CalibrationKeyframeCounts[CalibrationClipBase + Clip] - 1]
            CalibrationSavedTime = CalibrationFrameTimeMilliseconds(
                CalibrationSavedClip,
                CalibrationSavedFrame
            )

        End If

    End For

End Sub

Sub DeleteCurrentCalibrationKeyframe()

    Dim Channel As Number
    Dim CurrentFrame As Number
    Dim CurrentKeyframe As Number
    Dim KeyCount As Number
    Dim Shift As Number

    CurrentFrame = CurrentAnimationFrame()
    CurrentKeyframe = CalibrationKeyframeIndex(SelectedClip, CurrentFrame)

    If CurrentKeyframe < 0 Then
        Return
    End If

    KeyCount = CalibrationKeyframeCounts[CalibrationClipBase + SelectedClip]

    For Shift = CurrentKeyframe To KeyCount - 2

        CalibrationKeyframeFrames[CalibrationClipBase + SelectedClip, Shift] = CalibrationKeyframeFrames[CalibrationClipBase + SelectedClip, Shift + 1]

        For Channel = 0 To CALIBRATION_CHANNEL_COUNT - 1
            CalibrationKeyframeValues[CalibrationClipBase + SelectedClip, Shift * CALIBRATION_CHANNEL_COUNT + Channel] = CalibrationKeyframeValues[CalibrationClipBase + SelectedClip, (Shift + 1) * CALIBRATION_CHANNEL_COUNT + Channel]
        End For
    End For

    CalibrationKeyframeCounts[CalibrationClipBase + SelectedClip] = KeyCount - 1
    CalibrationSaveLimitReached = False
    CalibrationClearConfirm = False
    CalibrationClearAllStage = 0

    Call RefreshCalibrationSavedStatus()
    Call SaveCalibrationKeyframes()
    Call UpdateCalibrationForCurrentFrame()
    Call ApplyWristCalibration()

End Sub

Sub CopyCurrentCalibrationKeyframe()

    Dim Channel As Number
    Dim CurrentFrame As Number
    Dim CurrentKeyframe As Number

    CurrentFrame = CurrentAnimationFrame()
    CurrentKeyframe = CalibrationKeyframeIndex(SelectedClip, CurrentFrame)

    If CurrentKeyframe < 0 Then
        Return
    End If

    For Channel = 0 To CALIBRATION_CHANNEL_COUNT - 1
        CalibrationClipboardValues[Channel] = CalibrationKeyframeValues[CalibrationClipBase + SelectedClip, CurrentKeyframe * CALIBRATION_CHANNEL_COUNT + Channel]
    End For

    CalibrationClipboardAvailable = True

End Sub

Sub ReloadCurrentCalibrationKeyframe()

    Dim Channel As Number
    Dim CurrentFrame As Number
    Dim CurrentKeyframe As Number

    CurrentFrame = CurrentAnimationFrame()
    CurrentKeyframe = CalibrationKeyframeIndex(SelectedClip, CurrentFrame)

    If CurrentKeyframe < 0 Then
        Return
    End If

    For Channel = 0 To CALIBRATION_CHANNEL_COUNT - 1

        Call SetCalibrationChannelValue(
            SelectedClip,
            Channel,
            CalibrationKeyframeValues[CalibrationClipBase + SelectedClip, CurrentKeyframe * CALIBRATION_CHANNEL_COUNT + Channel]
        )
    End For

    CalibrationSaveLimitReached = False
    CalibrationClearConfirm = False
    CalibrationClearAllStage = 0

    Call ApplyWristCalibration()
    Call ApplyEquipmentCalibration()
    Call FinishCalibrationEdit()

    Call InvalidateVisualHistory()

End Sub

Sub PasteCalibrationKeyframe()

    Dim Channel As Number
    Dim CurrentFrame As Number

    If Not CalibrationClipboardAvailable Then
        Return
    End If

    CurrentFrame = CurrentAnimationFrame()

    For Channel = 0 To CALIBRATION_CHANNEL_COUNT - 1

        Call SetCalibrationChannelValue(
            SelectedClip,
            Channel,
            CalibrationClipboardValues[Channel]
        )
    End For

    CalibrationSavedClip = SelectedClip
    CalibrationSavedFrame = CurrentFrame
    CalibrationSavedTime = CalibrationFrameTimeMilliseconds(SelectedClip, CurrentFrame)
    CalibrationSaveLimitReached = Not StoreCalibrationKeyframe(SelectedClip, CurrentFrame)

    If Not CalibrationSaveLimitReached Then

        CalibrationSaved = True

        Call SaveCalibrationKeyframes()
        Call UpdateCalibrationForCurrentFrame()
        Call ApplyWristCalibration()

    End If

End Sub

Function CalibrationChannelValue(Clip As Number, Channel As Number) As Number

    Dim Axis As Number
    Dim Result As Number

    Axis = Channel Mod CALIBRATION_AXIS_COUNT

    If Channel < 3 Then
        Result = SwordWristCalibration[CalibrationClipBase + Clip, Axis]
    Else If Channel < 6 Then
        Result = ShieldWristCalibration[CalibrationClipBase + Clip, Axis]
    Else If Channel < 9 Then
        Result = SwordCalibration[CalibrationClipBase + Clip, Axis]
    Else If Channel < 12 Then
        Result = ShieldCalibration[CalibrationClipBase + Clip, Axis]
    Else If Channel < 15 Then
        Result = SwordPositionCalibration[CalibrationClipBase + Clip, Axis]
    Else If Channel < 18 Then
        Result = ShieldPositionCalibration[CalibrationClipBase + Clip, Axis]
    Else If Channel = 18 Then
        Result = SwordDecoupled[CalibrationClipBase + Clip]
    Else
        Result = ShieldDecoupled[CalibrationClipBase + Clip]
    End If

    Return Result

End Function

Sub SetCalibrationChannelValue(Clip As Number, Channel As Number, Value As Number)

    Dim Axis As Number

    Axis = Channel Mod CALIBRATION_AXIS_COUNT

    If Channel < 3 Then
        SwordWristCalibration[CalibrationClipBase + Clip, Axis] = Value
    Else If Channel < 6 Then
        ShieldWristCalibration[CalibrationClipBase + Clip, Axis] = Value
    Else If Channel < 9 Then
        SwordCalibration[CalibrationClipBase + Clip, Axis] = Value
    Else If Channel < 12 Then
        ShieldCalibration[CalibrationClipBase + Clip, Axis] = Value
    Else If Channel < 15 Then
        SwordPositionCalibration[CalibrationClipBase + Clip, Axis] = Value
    Else If Channel < 18 Then
        ShieldPositionCalibration[CalibrationClipBase + Clip, Axis] = Value
    Else If Channel = 18 Then
        SwordDecoupled[CalibrationClipBase + Clip] = Value
    Else
        ShieldDecoupled[CalibrationClipBase + Clip] = Value
    End If

End Sub

Function CurrentAnimationFrame() As Number

    Dim Result As Number
    Dim SampleRate As Number

    SampleRate = Max(1, Character3D.ClipSampleRate(Character, SelectedClip))
    Result = (Character3D.AnimationTime(Character) * SampleRate + 500) / 1000
    Result = Min(Character3D.ClipSampleCount(Character, SelectedClip) - 1, Max(0, Result))

    Return Result

End Function

Function CalibrationFrameTimeMilliseconds(Clip As Number, FrameValue As Number) As Number

    Dim Result As Number
    Dim SampleRate As Number

    SampleRate = Max(1, Character3D.ClipSampleRate(Character, Clip))
    Result = (FrameValue * 1000 + SampleRate / 2) / SampleRate

    Return Result

End Function

Function InterpolateCalibrationChannel(
    Channel As Number,
    StartValue As Number,
    EndValue As Number,
    CurrentFrame As Number,
    StartFrame As Number,
    EndFrame As Number
) As Number

    Dim Delta As Number
    Dim Result As Number

    If StartFrame = EndFrame Then
        Return StartValue
    End If

    If CurrentFrame = EndFrame Then
        Return EndValue
    End If

    If Channel >= 18 Then
        Return StartValue
    End If

    Delta = EndValue - StartValue

    If Channel < 12 Then

        If Delta > 180 Then
            Delta = Delta - 360
        Else If Delta < -180 Then
            Delta = Delta + 360
        End If

    End If

    Result = StartValue + Delta * (CurrentFrame - StartFrame) / (EndFrame - StartFrame)

    If Channel < 12 Then

        If Result > 180 Then
            Result = Result - 360
        Else If Result < -180 Then
            Result = Result + 360
        End If

    End If

    Return Result

End Function

Sub UpdateCalibrationForCurrentFrame()

    Dim Channel As Number
    Dim CurrentFrame As Number
    Dim EndFrame As Number
    Dim EndKeyframe As Number
    Dim EndValue As Number
    Dim FrameCount As Number
    Dim Index As Number
    Dim KeyCount As Number
    Dim ResultValue As Number
    Dim StartFrame As Number
    Dim StartKeyframe As Number
    Dim StartValue As Number

    If Not CalibrationAvailable Or CalibrationEditing Then
        Return
    End If

    KeyCount = CalibrationKeyframeCounts[CalibrationClipBase + SelectedClip]

    If KeyCount = 0 Then

        For Channel = 0 To CALIBRATION_CHANNEL_COUNT - 1
            Call SetCalibrationChannelValue(SelectedClip, Channel, 0)
        End For

        Return

    End If

    CurrentFrame = CurrentAnimationFrame()
    FrameCount = Max(1, Character3D.ClipSampleCount(Character, SelectedClip))
    StartKeyframe = 0
    EndKeyframe = 0

    If KeyCount = 1 Then

        StartKeyframe = 0
        EndKeyframe = 0

    Else If CurrentFrame < CalibrationKeyframeFrames[CalibrationClipBase + SelectedClip, 0] Then

        StartKeyframe = KeyCount - 1
        EndKeyframe = 0
        CurrentFrame = CurrentFrame + FrameCount

    Else If CurrentFrame > CalibrationKeyframeFrames[CalibrationClipBase + SelectedClip, KeyCount - 1] Then

        StartKeyframe = KeyCount - 1
        EndKeyframe = 0

    Else If CurrentFrame = CalibrationKeyframeFrames[CalibrationClipBase + SelectedClip, KeyCount - 1] Then

        StartKeyframe = KeyCount - 1
        EndKeyframe = KeyCount - 1

    Else If CurrentFrame > CalibrationKeyframeFrames[CalibrationClipBase + SelectedClip, 0] Then

        For Index = 1 To KeyCount - 1

            If CurrentFrame <= CalibrationKeyframeFrames[CalibrationClipBase + SelectedClip, Index] Then

                StartKeyframe = Index - 1
                EndKeyframe = Index
                Exit For

            End If

        End For

    End If

    StartFrame = CalibrationKeyframeFrames[CalibrationClipBase + SelectedClip, StartKeyframe]
    EndFrame = CalibrationKeyframeFrames[CalibrationClipBase + SelectedClip, EndKeyframe]

    If (StartKeyframe = KeyCount - 1 And
        EndKeyframe = 0 And
        KeyCount > 1) Then
        EndFrame = EndFrame + FrameCount
    End If

    For Channel = 0 To CALIBRATION_CHANNEL_COUNT - 1

        StartValue = CalibrationKeyframeValues[CalibrationClipBase + SelectedClip, StartKeyframe * CALIBRATION_CHANNEL_COUNT + Channel]
        EndValue = CalibrationKeyframeValues[CalibrationClipBase + SelectedClip, EndKeyframe * CALIBRATION_CHANNEL_COUNT + Channel]
        ResultValue = InterpolateCalibrationChannel(
            Channel,
            StartValue,
            EndValue,
            CurrentFrame,
            StartFrame,
            EndFrame
        )

        Call SetCalibrationChannelValue(SelectedClip, Channel, ResultValue)
    End For

End Sub

Sub ApplyWristCalibration()

    If Not CalibrationAvailable Then
        Return
    End If

    Ready = Character3D.SetNodeRotationOffset(
        Character,
        SwordWristNode,
        SwordWristCalibration[CalibrationClipBase + SelectedClip, CALIBRATION_AXIS_X],
        SwordWristCalibration[CalibrationClipBase + SelectedClip, CALIBRATION_AXIS_Y],
        SwordWristCalibration[CalibrationClipBase + SelectedClip, CALIBRATION_AXIS_Z]
    ) And Ready
    Ready = Character3D.SetNodeRotationOffset(
        Character,
        ShieldWristNode,
        ShieldWristCalibration[CalibrationClipBase + SelectedClip, CALIBRATION_AXIS_X],
        ShieldWristCalibration[CalibrationClipBase + SelectedClip, CALIBRATION_AXIS_Y],
        ShieldWristCalibration[CalibrationClipBase + SelectedClip, CALIBRATION_AXIS_Z]
    ) And Ready

End Sub

Sub ApplyEquipmentCoupling()

    Ready = Character3D.SetPartNodeOffsetsEnabled(
        Character, WEAPON_PART_INDEX, SwordDecoupled[CalibrationClipBase + SelectedClip] = 0
    ) And Ready
    Ready = Character3D.SetPartNodeOffsetsEnabled(
        Character, SHIELD_PART_INDEX, ShieldDecoupled[CalibrationClipBase + SelectedClip] = 0
    ) And Ready

    If EpicGlowAvailable Then
        Ready = Graphics3D.SetObjectNodeOffsetsEnabled3D(SwordGlow, SwordDecoupled[CalibrationClipBase + SelectedClip] = 0) And Ready
        Ready = Graphics3D.SetObjectNodeOffsetsEnabled3D(ShieldGlow, ShieldDecoupled[CalibrationClipBase + SelectedClip] = 0) And Ready
    End If

End Sub

Sub ApplyEquipmentCalibration()

    Dim GlowReady As Boolean
    Dim ShieldPivotX1000 As Number
    Dim ShieldPivotY1000 As Number
    Dim ShieldPivotZ1000 As Number
    Dim SwordPivotX1000 As Number
    Dim SwordPivotY1000 As Number
    Dim SwordPivotZ1000 As Number

    Call ApplyEquipmentCoupling()

    SwordPivotX1000 = Character3D.SocketValueThousandths(
        Character,
        "HandRight",
        Graphics3D.ANIMATOR_SOCKET_POSITION_X,
        BODY_PART_INDEX
    )
    SwordPivotY1000 = Character3D.SocketValueThousandths(
        Character,
        "HandRight",
        Graphics3D.ANIMATOR_SOCKET_POSITION_Y,
        BODY_PART_INDEX
    )
    SwordPivotZ1000 = Character3D.SocketValueThousandths(
        Character,
        "HandRight",
        Graphics3D.ANIMATOR_SOCKET_POSITION_Z,
        BODY_PART_INDEX
    )
    ShieldPivotX1000 = Character3D.SocketValueThousandths(
        Character,
        "HandLeft",
        Graphics3D.ANIMATOR_SOCKET_POSITION_X,
        BODY_PART_INDEX
    )
    ShieldPivotY1000 = Character3D.SocketValueThousandths(
        Character,
        "HandLeft",
        Graphics3D.ANIMATOR_SOCKET_POSITION_Y,
        BODY_PART_INDEX
    )
    ShieldPivotZ1000 = Character3D.SocketValueThousandths(
        Character,
        "HandLeft",
        Graphics3D.ANIMATOR_SOCKET_POSITION_Z,
        BODY_PART_INDEX
    )
    Ready = Character3D.SetPartPositionOffset(
        Character,
        WEAPON_PART_INDEX,
        SwordPositionCalibration[CalibrationClipBase + SelectedClip, CALIBRATION_AXIS_X],
        SwordPositionCalibration[CalibrationClipBase + SelectedClip, CALIBRATION_AXIS_Y],
        SwordPositionCalibration[CalibrationClipBase + SelectedClip, CALIBRATION_AXIS_Z]
    ) And Ready

    Call CaptureViewerFailure(71)

    Ready = Character3D.SetPartPositionOffset(
        Character,
        SHIELD_PART_INDEX,
        ShieldPositionCalibration[CalibrationClipBase + SelectedClip, CALIBRATION_AXIS_X],
        ShieldPositionCalibration[CalibrationClipBase + SelectedClip, CALIBRATION_AXIS_Y],
        ShieldPositionCalibration[CalibrationClipBase + SelectedClip, CALIBRATION_AXIS_Z]
    ) And Ready

    Call CaptureViewerFailure(72)

    Ready = Character3D.SetPartPivotRotationThousandths(
        Character,
        WEAPON_PART_INDEX,
        SwordPivotX1000,
        SwordPivotY1000,
        SwordPivotZ1000,
        SwordCalibration[CalibrationClipBase + SelectedClip, CALIBRATION_AXIS_X],
        SwordCalibration[CalibrationClipBase + SelectedClip, CALIBRATION_AXIS_Y],
        SwordCalibration[CalibrationClipBase + SelectedClip, CALIBRATION_AXIS_Z]
    ) And Ready

    Call CaptureViewerFailure(73)

    Ready = Character3D.SetPartPivotRotationThousandths(
        Character,
        SHIELD_PART_INDEX,
        ShieldPivotX1000,
        ShieldPivotY1000,
        ShieldPivotZ1000,
        ShieldCalibration[CalibrationClipBase + SelectedClip, CALIBRATION_AXIS_X],
        ShieldCalibration[CalibrationClipBase + SelectedClip, CALIBRATION_AXIS_Y],
        ShieldCalibration[CalibrationClipBase + SelectedClip, CALIBRATION_AXIS_Z]
    ) And Ready

    Call CaptureViewerFailure(74)

    If EpicGlowVisible Then

        GlowReady = Graphics3D.SetObjectPositionChecked3D(
            SwordGlow,
            SwordGlow.Position.X + SwordPositionCalibration[CalibrationClipBase + SelectedClip, CALIBRATION_AXIS_X],
            SwordGlow.Position.Y + SwordPositionCalibration[CalibrationClipBase + SelectedClip, CALIBRATION_AXIS_Y],
            SwordGlow.Position.Z + SwordPositionCalibration[CalibrationClipBase + SelectedClip, CALIBRATION_AXIS_Z]
        )
        GlowReady = Graphics3D.SetObjectPositionChecked3D(
            ShieldGlow,
            ShieldGlow.Position.X + ShieldPositionCalibration[CalibrationClipBase + SelectedClip, CALIBRATION_AXIS_X],
            ShieldGlow.Position.Y + ShieldPositionCalibration[CalibrationClipBase + SelectedClip, CALIBRATION_AXIS_Y],
            ShieldGlow.Position.Z + ShieldPositionCalibration[CalibrationClipBase + SelectedClip, CALIBRATION_AXIS_Z]
        ) And GlowReady

        GlowReady = Graphics3D.SetObjectPivotRotationThousandths3D(
            SwordGlow,
            SwordPivotX1000,
            SwordPivotY1000,
            SwordPivotZ1000,
            SwordCalibration[CalibrationClipBase + SelectedClip, CALIBRATION_AXIS_X],
            SwordCalibration[CalibrationClipBase + SelectedClip, CALIBRATION_AXIS_Y],
            SwordCalibration[CalibrationClipBase + SelectedClip, CALIBRATION_AXIS_Z]
        ) And GlowReady
        GlowReady = Graphics3D.SetObjectPivotRotationThousandths3D(
            ShieldGlow,
            ShieldPivotX1000,
            ShieldPivotY1000,
            ShieldPivotZ1000,
            ShieldCalibration[CalibrationClipBase + SelectedClip, CALIBRATION_AXIS_X],
            ShieldCalibration[CalibrationClipBase + SelectedClip, CALIBRATION_AXIS_Y],
            ShieldCalibration[CalibrationClipBase + SelectedClip, CALIBRATION_AXIS_Z]
        ) And GlowReady

        If Not GlowReady Then
            EpicGlowVisible = False
        End If

    End If

End Sub

Function CurrentCalibrationValue() As Number

    Dim Result As Number

    If (CalibrationTransform = CALIBRATION_TRANSFORM_MOVE And
        CalibrationTarget = CALIBRATION_TARGET_SWORD) Then
        Result = SwordPositionCalibration[CalibrationClipBase + SelectedClip, CalibrationAxis]
    Else If (CalibrationTransform = CALIBRATION_TRANSFORM_MOVE And
        CalibrationTarget = CALIBRATION_TARGET_SHIELD) Then
        Result = ShieldPositionCalibration[CalibrationClipBase + SelectedClip, CalibrationAxis]
    Else If CalibrationTarget = CALIBRATION_TARGET_SWORD_WRIST Then
        Result = SwordWristCalibration[CalibrationClipBase + SelectedClip, CalibrationAxis]
    Else If CalibrationTarget = CALIBRATION_TARGET_SHIELD_WRIST Then
        Result = ShieldWristCalibration[CalibrationClipBase + SelectedClip, CalibrationAxis]
    Else If CalibrationTarget = CALIBRATION_TARGET_SWORD Then
        Result = SwordCalibration[CalibrationClipBase + SelectedClip, CalibrationAxis]
    Else
        Result = ShieldCalibration[CalibrationClipBase + SelectedClip, CalibrationAxis]
    End If

    Return Result

End Function

Function CalibrationMinimumValue() As Number

    Dim Result As Number

    If CalibrationTransform = CALIBRATION_TRANSFORM_MOVE Then
        Result = CALIBRATION_MINIMUM_POSITION
    Else
        Result = CALIBRATION_MINIMUM_DEGREES
    End If

    Return Result

End Function

Function CalibrationMaximumValue() As Number

    Dim Result As Number

    If CalibrationTransform = CALIBRATION_TRANSFORM_MOVE Then
        Result = CALIBRATION_MAXIMUM_POSITION
    Else
        Result = CALIBRATION_MAXIMUM_DEGREES
    End If

    Return Result

End Function

Function CalibrationTransformLabel() As Text

    Dim Result As Text

    If CalibrationTransform = CALIBRATION_TRANSFORM_MOVE Then
        Result = "Move"
    Else
        Result = "Rotate"
    End If

    Return Result

End Function

Function CalibrationUnitLabel() As Text

    Dim Result As Text

    If CalibrationTransform = CALIBRATION_TRANSFORM_MOVE Then
        Result = "units"
    Else
        Result = "degrees"
    End If

    Return Result

End Function

Sub BeginCalibrationEdit()

    Dim Axis As Number

    If CalibrationEditing Then
        Return
    End If

    CalibrationEditing = True
    CalibrationClearConfirm = False
    CalibrationEditingClip = SelectedClip
    CalibrationEditingFrame = CurrentAnimationFrame()
    SwordDecoupledBeforeEdit = SwordDecoupled[CalibrationClipBase + SelectedClip]
    ShieldDecoupledBeforeEdit = ShieldDecoupled[CalibrationClipBase + SelectedClip]
    CalibrationAutoOrbitWasEnabled = AutoOrbit
    CalibrationSavedBeforeEdit = CalibrationSaved

    For Axis = 0 To CALIBRATION_AXIS_COUNT - 1

        SwordWristCalibrationBeforeEdit[Axis] = SwordWristCalibration[CalibrationClipBase + SelectedClip, Axis]
        ShieldWristCalibrationBeforeEdit[Axis] = ShieldWristCalibration[CalibrationClipBase + SelectedClip, Axis]
        SwordCalibrationBeforeEdit[Axis] = SwordCalibration[CalibrationClipBase + SelectedClip, Axis]
        ShieldCalibrationBeforeEdit[Axis] = ShieldCalibration[CalibrationClipBase + SelectedClip, Axis]
        SwordPositionCalibrationBeforeEdit[Axis] = SwordPositionCalibration[CalibrationClipBase + SelectedClip, Axis]
        ShieldPositionCalibrationBeforeEdit[Axis] = ShieldPositionCalibration[CalibrationClipBase + SelectedClip, Axis]
    End For

    AutoOrbit = False

    Call InvalidateVisualHistory()

End Sub

Sub FinishCalibrationEdit()

    CalibrationGripAnchorActive = False

    If Not CalibrationEditing Then
        Return
    End If

    CalibrationEditing = False
    TransformGizmoDragging = False
    TransformGizmoPointerOwned = False
    TransformGizmoOpenedEdit = False
    TransformGizmoDragRemainder = 0
    CharacterSwitchBlocked = False
    AutoOrbit = CalibrationAutoOrbitWasEnabled

    Call InvalidateVisualHistory()

End Sub

Sub CancelCalibrationEdit()

    Dim Axis As Number

    If Not CalibrationEditing Then
        Return
    End If

    For Axis = 0 To CALIBRATION_AXIS_COUNT - 1

        SwordWristCalibration[CalibrationClipBase + CalibrationEditingClip, Axis] = SwordWristCalibrationBeforeEdit[Axis]
        ShieldWristCalibration[CalibrationClipBase + CalibrationEditingClip, Axis] = ShieldWristCalibrationBeforeEdit[Axis]
        SwordCalibration[CalibrationClipBase + CalibrationEditingClip, Axis] = SwordCalibrationBeforeEdit[Axis]
        ShieldCalibration[CalibrationClipBase + CalibrationEditingClip, Axis] = ShieldCalibrationBeforeEdit[Axis]
        SwordPositionCalibration[CalibrationClipBase + CalibrationEditingClip, Axis] = SwordPositionCalibrationBeforeEdit[Axis]
        ShieldPositionCalibration[CalibrationClipBase + CalibrationEditingClip, Axis] = ShieldPositionCalibrationBeforeEdit[Axis]
    End For

    CalibrationSaved = CalibrationSavedBeforeEdit
    SwordDecoupled[CalibrationClipBase + CalibrationEditingClip] = SwordDecoupledBeforeEdit
    ShieldDecoupled[CalibrationClipBase + CalibrationEditingClip] = ShieldDecoupledBeforeEdit
    CalibrationClearConfirm = False

    Call ApplyWristCalibration()
    Call ApplyEquipmentCalibration()
    Call FinishCalibrationEdit()

End Sub

Sub SetCurrentCalibrationValue(Value As Number)

    Dim ClampedValue As Number
    Dim HoldGrip As Boolean
    Dim PartIndex As Number
    Dim SocketName As Text
    Dim PreviousValue As Number

    PreviousValue = CurrentCalibrationValue()
    CalibrationGripLimit = False

    HoldGrip = (CalibrationHoldGrip And CalibrationTransform = CALIBRATION_TRANSFORM_ROTATE And
        CalibrationTarget >= CALIBRATION_TARGET_SWORD)

    If HoldGrip Then

        PartIndex = WEAPON_PART_INDEX
        SocketName = "HandRight"

        If CalibrationTarget = CALIBRATION_TARGET_SHIELD Then
            PartIndex = SHIELD_PART_INDEX
            SocketName = "HandLeft"
        End If

        If (Not CalibrationGripAnchorActive Or
            CalibrationGripAnchorTarget <> CalibrationTarget Or
            CalibrationGripAnchorFrame <> CurrentAnimationFrame()) Then

            CalibrationGripAnchor = EquipmentGripThousandths(PartIndex, SocketName)
            CalibrationGripAnchorActive = True
            CalibrationGripAnchorTarget = CalibrationTarget
            CalibrationGripAnchorFrame = CurrentAnimationFrame()
            CalibrationGripBasePosition.X = SwordPositionCalibration[CalibrationClipBase + SelectedClip, 0]
            CalibrationGripBasePosition.Y = SwordPositionCalibration[CalibrationClipBase + SelectedClip, 1]
            CalibrationGripBasePosition.Z = SwordPositionCalibration[CalibrationClipBase + SelectedClip, 2]

            If PartIndex = SHIELD_PART_INDEX Then

                CalibrationGripBasePosition.X = ShieldPositionCalibration[CalibrationClipBase + SelectedClip, 0]
                CalibrationGripBasePosition.Y = ShieldPositionCalibration[CalibrationClipBase + SelectedClip, 1]
                CalibrationGripBasePosition.Z = ShieldPositionCalibration[CalibrationClipBase + SelectedClip, 2]

            End If

        End If

    Else
        CalibrationGripAnchorActive = False

    End If

    Call BeginCalibrationEdit()

    If CalibrationTransform = CALIBRATION_TRANSFORM_MOVE Then
        ClampedValue = Min(CALIBRATION_MAXIMUM_POSITION,
            Max(CALIBRATION_MINIMUM_POSITION, Value))
    Else
        ClampedValue = Min(CALIBRATION_MAXIMUM_DEGREES,
            Max(CALIBRATION_MINIMUM_DEGREES, Value))
    End If

    If (CalibrationTransform = CALIBRATION_TRANSFORM_MOVE And
        CalibrationTarget = CALIBRATION_TARGET_SWORD) Then
        SwordPositionCalibration[CalibrationClipBase + SelectedClip, CalibrationAxis] = ClampedValue
    Else If (CalibrationTransform = CALIBRATION_TRANSFORM_MOVE And
        CalibrationTarget = CALIBRATION_TARGET_SHIELD) Then
        ShieldPositionCalibration[CalibrationClipBase + SelectedClip, CalibrationAxis] = ClampedValue
    Else If CalibrationTarget = CALIBRATION_TARGET_SWORD_WRIST Then
        SwordWristCalibration[CalibrationClipBase + SelectedClip, CalibrationAxis] = ClampedValue
    Else If CalibrationTarget = CALIBRATION_TARGET_SHIELD_WRIST Then
        ShieldWristCalibration[CalibrationClipBase + SelectedClip, CalibrationAxis] = ClampedValue
    Else If CalibrationTarget = CALIBRATION_TARGET_SWORD Then
        SwordCalibration[CalibrationClipBase + SelectedClip, CalibrationAxis] = ClampedValue
    Else
        ShieldCalibration[CalibrationClipBase + SelectedClip, CalibrationAxis] = ClampedValue
    End If

    CalibrationSaveLimitReached = False
    CalibrationClearConfirm = False
    AutoOrbit = False

    Call ApplyWristCalibration()
    Call ApplyEquipmentCalibration()

    If HoldGrip Then

        If Not RestoreEquipmentGrip(PartIndex, SocketName) Then

            CalibrationGripLimit = True

            If PartIndex = WEAPON_PART_INDEX Then
                SwordCalibration[CalibrationClipBase + SelectedClip, CalibrationAxis] = PreviousValue
            Else
                ShieldCalibration[CalibrationClipBase + SelectedClip, CalibrationAxis] = PreviousValue
            End If

            Call ApplyEquipmentCalibration()

        End If

    End If

    Call InvalidateVisualHistory()

End Sub

Function EquipmentGripThousandths(PartIndex As Number, SocketName As Text) As Core.Vector3

    Dim Result As Core.Vector3

    Result.X = Character3D.SocketValueThousandths(Character, SocketName,
        Graphics3D.ANIMATOR_SOCKET_POSITION_X, PartIndex)
    Result.Y = Character3D.SocketValueThousandths(Character, SocketName,
        Graphics3D.ANIMATOR_SOCKET_POSITION_Y, PartIndex)
    Result.Z = Character3D.SocketValueThousandths(Character, SocketName,
        Graphics3D.ANIMATOR_SOCKET_POSITION_Z, PartIndex)

    Return Result

End Function

Function RestoreEquipmentGrip(PartIndex As Number, SocketName As Text) As Boolean

    Dim Position As Core.Vector3
    Dim Correction As Core.Vector3
    Dim Angles As Core.Vector3
    Dim Inverse As Core.Matrix4
    Dim NextPosition As Core.Vector3

    ''' Recalculate from the captured base, never from an already rounded drag sample.

    If PartIndex = WEAPON_PART_INDEX Then

        SwordPositionCalibration[CalibrationClipBase + SelectedClip, 0] = CalibrationGripBasePosition.X
        SwordPositionCalibration[CalibrationClipBase + SelectedClip, 1] = CalibrationGripBasePosition.Y
        SwordPositionCalibration[CalibrationClipBase + SelectedClip, 2] = CalibrationGripBasePosition.Z

    Else

        ShieldPositionCalibration[CalibrationClipBase + SelectedClip, 0] = CalibrationGripBasePosition.X
        ShieldPositionCalibration[CalibrationClipBase + SelectedClip, 1] = CalibrationGripBasePosition.Y
        ShieldPositionCalibration[CalibrationClipBase + SelectedClip, 2] = CalibrationGripBasePosition.Z

    End If

    Call ApplyEquipmentCalibration()

    Position = EquipmentGripThousandths(PartIndex, SocketName)
    Correction.X = CalibrationGripAnchor.X - Position.X
    Correction.Y = CalibrationGripAnchor.Y - Position.Y
    Correction.Z = CalibrationGripAnchor.Z - Position.Z
    Angles.X = SwordCalibration[CalibrationClipBase + SelectedClip, CALIBRATION_AXIS_X]
    Angles.Y = SwordCalibration[CalibrationClipBase + SelectedClip, CALIBRATION_AXIS_Y]
    Angles.Z = SwordCalibration[CalibrationClipBase + SelectedClip, CALIBRATION_AXIS_Z]

    If PartIndex = SHIELD_PART_INDEX Then

        Angles.X = ShieldCalibration[CalibrationClipBase + SelectedClip, CALIBRATION_AXIS_X]
        Angles.Y = ShieldCalibration[CalibrationClipBase + SelectedClip, CALIBRATION_AXIS_Y]
        Angles.Z = ShieldCalibration[CalibrationClipBase + SelectedClip, CALIBRATION_AXIS_Z]

    End If

    ''' Part translation precedes the XYZ pivot rotation; undo Z, Y, X for compensation.
    Inverse = Math3D.Multiply(Math3D.RotationZ(-Angles.Z), Math3D.RotationY(-Angles.Y))
    Inverse = Math3D.Multiply(Inverse, Math3D.RotationX(-Angles.X))
    Correction = Math3D.TransformPoint(Correction, Inverse)

    If PartIndex = WEAPON_PART_INDEX Then

        NextPosition.X = SwordPositionCalibration[CalibrationClipBase + SelectedClip, 0] + RoundedGripOffset(Correction.X)
        NextPosition.Y = SwordPositionCalibration[CalibrationClipBase + SelectedClip, 1] + RoundedGripOffset(Correction.Y)
        NextPosition.Z = SwordPositionCalibration[CalibrationClipBase + SelectedClip, 2] + RoundedGripOffset(Correction.Z)

    Else

        NextPosition.X = ShieldPositionCalibration[CalibrationClipBase + SelectedClip, 0] + RoundedGripOffset(Correction.X)
        NextPosition.Y = ShieldPositionCalibration[CalibrationClipBase + SelectedClip, 1] + RoundedGripOffset(Correction.Y)
        NextPosition.Z = ShieldPositionCalibration[CalibrationClipBase + SelectedClip, 2] + RoundedGripOffset(Correction.Z)

    End If

    If (Abs(NextPosition.X) > CALIBRATION_MAXIMUM_POSITION Or
        Abs(NextPosition.Y) > CALIBRATION_MAXIMUM_POSITION Or
        Abs(NextPosition.Z) > CALIBRATION_MAXIMUM_POSITION) Then
        Return False
    End If

    If PartIndex = WEAPON_PART_INDEX Then

        SwordPositionCalibration[CalibrationClipBase + SelectedClip, 0] = NextPosition.X
        SwordPositionCalibration[CalibrationClipBase + SelectedClip, 1] = NextPosition.Y
        SwordPositionCalibration[CalibrationClipBase + SelectedClip, 2] = NextPosition.Z

    Else

        ShieldPositionCalibration[CalibrationClipBase + SelectedClip, 0] = NextPosition.X
        ShieldPositionCalibration[CalibrationClipBase + SelectedClip, 1] = NextPosition.Y
        ShieldPositionCalibration[CalibrationClipBase + SelectedClip, 2] = NextPosition.Z

    End If

    Call ApplyEquipmentCalibration()

    Return True

End Function

Function RoundedGripOffset(Value As Number) As Number

    Dim Result As Number

    If Value < 0 Then
        Result = (Value - 500) / 1000
    Else
        Result = (Value + 500) / 1000
    End If

    Return Result

End Function

Sub AdjustCalibrationValue(Amount As Number)

    Call SetCurrentCalibrationValue(CurrentCalibrationValue() + Amount)

End Sub

Sub SetCalibrationFromPointer()

    Dim MaximumValue As Number
    Dim MinimumValue As Number
    Dim Value As Number

    MinimumValue = CalibrationMinimumValue()
    MaximumValue = CalibrationMaximumValue()
    Value = ((Pointer_X() - CALIBRATION_SLIDER_X) *
        (MaximumValue - MinimumValue) /
        CALIBRATION_SLIDER_WIDTH) + MinimumValue

    Call SetCurrentCalibrationValue(Value)

End Sub

Sub ResetCalibrationTarget()

    Dim Axis As Number

    CalibrationGripAnchorActive = False

    Call BeginCalibrationEdit()

    For Axis = 0 To CALIBRATION_AXIS_COUNT - 1

        If (CalibrationTransform = CALIBRATION_TRANSFORM_MOVE And
            CalibrationTarget = CALIBRATION_TARGET_SWORD) Then
            SwordPositionCalibration[CalibrationClipBase + SelectedClip, Axis] = 0
        Else If (CalibrationTransform = CALIBRATION_TRANSFORM_MOVE And
            CalibrationTarget = CALIBRATION_TARGET_SHIELD) Then
            ShieldPositionCalibration[CalibrationClipBase + SelectedClip, Axis] = 0
        Else If CalibrationTarget = CALIBRATION_TARGET_SWORD_WRIST Then
            SwordWristCalibration[CalibrationClipBase + SelectedClip, Axis] = 0
        Else If CalibrationTarget = CALIBRATION_TARGET_SHIELD_WRIST Then
            ShieldWristCalibration[CalibrationClipBase + SelectedClip, Axis] = 0
        Else If CalibrationTarget = CALIBRATION_TARGET_SWORD Then
            SwordCalibration[CalibrationClipBase + SelectedClip, Axis] = 0
        Else
            ShieldCalibration[CalibrationClipBase + SelectedClip, Axis] = 0
        End If

    End For

    CalibrationSaveLimitReached = False
    CalibrationClearConfirm = False
    AutoOrbit = False

    Call ApplyWristCalibration()
    Call ApplyEquipmentCalibration()

    Call InvalidateVisualHistory()

End Sub

Sub ClearSelectedClipCalibration()

    Dim Axis As Number

    For Axis = 0 To CALIBRATION_AXIS_COUNT - 1

        SwordWristCalibration[CalibrationClipBase + SelectedClip, Axis] = 0
        ShieldWristCalibration[CalibrationClipBase + SelectedClip, Axis] = 0
        SwordCalibration[CalibrationClipBase + SelectedClip, Axis] = 0
        ShieldCalibration[CalibrationClipBase + SelectedClip, Axis] = 0
        SwordPositionCalibration[CalibrationClipBase + SelectedClip, Axis] = 0
        ShieldPositionCalibration[CalibrationClipBase + SelectedClip, Axis] = 0
    End For

    CalibrationKeyframeCounts[CalibrationClipBase + SelectedClip] = 0
    SwordDecoupled[CalibrationClipBase + SelectedClip] = 0
    ShieldDecoupled[CalibrationClipBase + SelectedClip] = 0
    CalibrationClearConfirm = False
    CalibrationSaveLimitReached = False

    Call RefreshCalibrationSavedStatus()
    Call SaveCalibrationKeyframes()

    Call ApplyWristCalibration()
    Call ApplyEquipmentCalibration()
    Call FinishCalibrationEdit()

End Sub

Sub ClearAllCalibration()

    Call ClearCalibrationMemory()

    CalibrationClearConfirm = False
    CalibrationClearAllStage = 0
    CalibrationSaveLimitReached = False

    Call SaveCalibrationKeyframes()

    Call ApplyWristCalibration()
    Call ApplyEquipmentCalibration()
    Call FinishCalibrationEdit()

End Sub

Function CalibrationResetClipLabel() As Text

    Dim Result As Text

    If CalibrationClearConfirm Then
        Result = "Confirm Current Clip?"
    Else
        Result = "Delete All Key Frames"
    End If

    Return Result

End Function

Function CalibrationResetAllLabel() As Text

    Dim Result As Text

    If CalibrationClearAllStage = 1 Then
        Result = "Confirm All?"
    Else If CalibrationClearAllStage >= 2 Then
        Result = "Really Clear?"
    Else
        Result = "Reset All"
    End If

    Return Result

End Function

Sub SaveCalibrationFrame()

    If CalibrationStorageRejected Then
        Return
    End If

    Call BeginCalibrationEdit()

    CalibrationSavedClip = SelectedClip
    CalibrationSavedFrame = CalibrationEditingFrame
    CalibrationSavedTime = CalibrationFrameTimeMilliseconds(
        CalibrationSavedClip,
        CalibrationSavedFrame
    )
    CalibrationClearConfirm = False
    CalibrationSaveLimitReached = Not StoreCalibrationKeyframe(
        CalibrationSavedClip,
        CalibrationSavedFrame
    )

    If Not CalibrationSaveLimitReached Then
        CalibrationSaved = True

        Call SaveCalibrationKeyframes()
    End If

    Call FinishCalibrationEdit()

End Sub

Sub UndoLastCalibrationChange()

    Dim Index As Number

    If CalibrationUndoCount <= 0 Or CalibrationStorageRejected Then
        Return
    End If

    Call FinishCalibrationEdit()
    Call ClearCalibrationMemory()

    For Index = 0 To CalibrationUndoCount - 1
        CalibrationStorage[Index] = CalibrationUndoStorage[Index]
    End For

    If Not DecodeCalibrationStorage(CalibrationUndoCount) Then
        CalibrationStorageRejected = True
        Return
    End If

    CalibrationUndoApplying = True

    Call SaveCalibrationKeyframes()

    CalibrationUndoApplying = False
    CalibrationUndoCount = 0

    Call UpdateCalibrationForCurrentFrame()
    Call ApplyWristCalibration()
    Call ApplyEquipmentCalibration()

    Call InvalidateVisualHistory()

End Sub

Sub PlaySelectedClip(Optional RetainFireTails As Boolean = False)

    ''' Explicit editor navigation is a cut, not a corrected-pose cross-fade.
    ''' Automatic demo changes keep existing fire but never inherit across the cut.

    If Not RetainFireTails Then
        Call InvalidateVisualHistory()
    End If

    SelectedTimelineEvent = FirstClipEvent()
    Ready = Character3D.PlayMode(
        Character,
        SelectedClipName(),
        SelectedClipMode(),
        PlaybackSpeed
    ) And Ready
    ArinAudio.Clip = ""
    AnimationCycleElapsed = 0
    DemoCompletedLoops = 0
    DemoPreviousAnimationTime = Character3D.AnimationTime(Character)

    Call UpdateCalibrationForCurrentFrame()
    Call ApplyWristCalibration()

    If EpicGlowAvailable Then
        Call ResetEpicGlowTrails()
    End If

End Sub

Function FirstClipEvent() As Number

    Dim EventIndex As Number
    Dim Result As Number

    Result = 0

    For EventIndex = 1 To Character3D.EventCount(Character)

        If Character3D.EventClipIndex(Character, EventIndex) = SelectedClip And Result = 0 Then
            Result = EventIndex
        End If

    End For

    Return Result

End Function

Function NearestClipEvent(TimeValue As Number) As Number

    Dim BestDistance As Number
    Dim Distance As Number
    Dim EventIndex As Number
    Dim Result As Number

    BestDistance = 2147483647
    Result = 0

    For EventIndex = 1 To Character3D.EventCount(Character)

        If Character3D.EventClipIndex(Character, EventIndex) = SelectedClip Then

            Distance = Abs(Character3D.EventTime(Character, EventIndex) - TimeValue)

            If Distance < BestDistance Then
                BestDistance = Distance
                Result = EventIndex
            End If

        End If

    End For

    Return Result

End Function

Function SelectedClipName() As Text

    Dim Result As Text

    Result = Character3D.ClipName(Character, SelectedClip)

    Return Result

End Function

Function SelectedClipLabel() As Text

    Dim Result As Text

    Result = ViewerProfiles.ClipLabel(
        ProfileIndex,
        PresentationIndexForRuntimeClip(SelectedClip)
    )

    Return Result

End Function

Function SelectedClipMode() As Number

    Dim Result As Number

    Result = Graphics3D.ANIMATION_LOOP

    If ViewerProfiles.HoldsFinalPose(ProfileIndex, SelectedClipName()) Then
        Result = Graphics3D.ANIMATION_ONCE
    End If

    Return Result

End Function

Function LightingLabel() As Text

    Dim Result As Text

    If LightingIndex = 0 Then
        Result = "Viewer Studio"
    Else If LightingIndex = 1 Then
        Result = "Character Studio"
    Else If LightingIndex = 2 Then
        Result = "Daylight"
    Else
        Result = "Moonlight"
    End If

    Return Result

End Function

Function PointerInRectangle(X As Number, Y As Number, Width As Number, Height As Number) As Boolean

    Dim Result As Boolean

    Result = UI.Contains(X, Y, Width, Height)
    Return Result

End Function

Function StatusPanelX() As Number

    Dim Result As Number

    Result = Max(492, Window_Width() - 268)

    Return Result

End Function

Function AnimationButtonX() As Number

    Dim Result As Number

    Result = StatusPanelX() + 12

    Return Result

End Function

Function TransformGizmoAxisPoint(Axis As Number) As Core.ProjectedPoint3D

    Dim Result As Core.ProjectedPoint3D

    Result = TransformGizmo.XAxis

    If Axis = CALIBRATION_AXIS_Y Then
        Result = TransformGizmo.YAxis
    Else If Axis = CALIBRATION_AXIS_Z Then
        Result = TransformGizmo.ZAxis
    End If

    Return Result

End Function

Function TransformGizmoAxisColor(Axis As Number, Selected As Boolean) As Number

    Dim Result As Number

    If Axis = CALIBRATION_AXIS_X Then

        If Selected Then
            Result = Rgb(255, 126, 126)
        Else
            Result = Rgb(224, 52, 52)
        End If

    Else If Axis = CALIBRATION_AXIS_Y Then

        If Selected Then
            Result = Rgb(142, 255, 142)
        Else
            Result = Rgb(48, 204, 72)
        End If

    Else

        If Selected Then
            Result = Rgb(136, 184, 255)
        Else
            Result = Rgb(54, 112, 240)
        End If

    End If

    Return Result

End Function

Sub DrawTransformGizmo()

    If Not TransformGizmo.Visible Then
        Return
    End If

    If CalibrationTransform = CALIBRATION_TRANSFORM_MOVE Then
        Call DrawTransformGizmoMove()
    Else

        Call DrawTransformGizmoRotate()
    End If

    Fill Circle TransformGizmo.Origin.X, TransformGizmo.Origin.Y, 4, Rgb(242, 242, 242)

End Sub

Sub DrawTransformGizmoMove()

    Dim Axis As Number
    Dim AxisPoint As Core.ProjectedPoint3D
    Dim ColorValue As Number
    Dim Selected As Boolean
    Dim Label As Text

    For Axis = CALIBRATION_AXIS_X To CALIBRATION_AXIS_Z

        AxisPoint = TransformGizmoAxisPoint(Axis)
        Selected = Axis = CalibrationAxis
        ColorValue = TransformGizmoAxisColor(Axis, Selected)

        Draw Line TransformGizmo.Origin.X, TransformGizmo.Origin.Y, AxisPoint.X, AxisPoint.Y, ColorValue

        If Selected Then
            Draw Line TransformGizmo.Origin.X + 1, TransformGizmo.Origin.Y, AxisPoint.X + 1, AxisPoint.Y, ColorValue
            Draw Line TransformGizmo.Origin.X, TransformGizmo.Origin.Y + 1, AxisPoint.X, AxisPoint.Y + 1, ColorValue
        End If

        Fill Circle AxisPoint.X, AxisPoint.Y, 5, ColorValue
        Label = "X"

        If Axis = CALIBRATION_AXIS_Y Then
            Label = "Y"
        Else If Axis = CALIBRATION_AXIS_Z Then
            Label = "Z"
        End If

        Draw Text Label At AxisPoint.X + 7, AxisPoint.Y - 7 Size 12 Color ColorValue
    End For

End Sub

Sub DrawTransformGizmoRotate()

    Dim Axis As Number
    Dim Segment As Number
    Dim ColorValue As Number
    Dim Selected As Boolean
    Dim StartPoint As Core.ProjectedPoint3D
    Dim EndPoint As Core.ProjectedPoint3D

    For Axis = CALIBRATION_AXIS_X To CALIBRATION_AXIS_Z

        Selected = Axis = CalibrationAxis
        ColorValue = TransformGizmoAxisColor(Axis, Selected)
        StartPoint = CharacterViewer.ProjectTransformRingPoint(
            TransformGizmoOrigin,
            Axis,
            0,
            TRANSFORM_GIZMO_RING_SEGMENTS,
            TransformGizmoWorldSize,
            Camera,
            Window_Width(),
            Window_Height()
        )

        For Segment = 1 To TRANSFORM_GIZMO_RING_SEGMENTS

            EndPoint = CharacterViewer.ProjectTransformRingPoint(
                TransformGizmoOrigin,
                Axis,
                Segment,
                TRANSFORM_GIZMO_RING_SEGMENTS,
                TransformGizmoWorldSize,
                Camera,
                Window_Width(),
                Window_Height()
            )

            If StartPoint.Visible And EndPoint.Visible Then

                Draw Line StartPoint.X, StartPoint.Y, EndPoint.X, EndPoint.Y, ColorValue

                If Selected Then
                    Draw Line StartPoint.X + 1, StartPoint.Y, EndPoint.X + 1, EndPoint.Y, ColorValue
                End If

            End If

            StartPoint = EndPoint
        End For
    End For

    ColorValue = TransformGizmoAxisColor(CALIBRATION_AXIS_X,
        CalibrationAxis = CALIBRATION_AXIS_X)
    Draw Text "X" At TransformGizmo.XAxis.X + 5, TransformGizmo.XAxis.Y - 6 Size 11 Color ColorValue
    ColorValue = TransformGizmoAxisColor(CALIBRATION_AXIS_Y,
        CalibrationAxis = CALIBRATION_AXIS_Y)
    Draw Text "Y" At TransformGizmo.YAxis.X + 5, TransformGizmo.YAxis.Y - 6 Size 11 Color ColorValue
    ColorValue = TransformGizmoAxisColor(CALIBRATION_AXIS_Z,
        CalibrationAxis = CALIBRATION_AXIS_Z)
    Draw Text "Z" At TransformGizmo.ZAxis.X + 5, TransformGizmo.ZAxis.Y - 6 Size 11 Color ColorValue

End Sub

Sub DrawViewerOverlay()

    Dim PanelLeft As Number
    Dim PanelText As Number
    Dim Subtitle As Text

    If UiVisibility = 2 Then
        Return
    End If

    PanelLeft = StatusPanelX()
    PanelText = PanelLeft + 16

    If ViewerLayoutTooSmall() Then

        Fill Rectangle 0, 0, Window_Width(), Window_Height(), Rgb(4, 9, 24) Opacity 92
        Draw Text "CHARACTER VIEWER NEEDS MORE ROOM" At 28, 40 Size 22 Color YELLOW
        Draw Text "Resize to at least 800 by 540 logical units." At 28, 78 Size 15 Color WHITE
        Draw Text "Right-click still resets the scene." At 28, 108 Size 13 Color LIGHT_GRAY
        Return

    End If

    If Window_Width() < 1100 Then
        Subtitle = ActiveProfile.DisplayName + "  •  " + PartyRoleLabel() + "  •  PBR"
    Else
        Subtitle = ActiveProfile.DisplayName + "  •  Party role: " + PartyRoleLabel() + "  •  Renderer3D PBR"
    End If

    Draw Text "SMILE 2.0 - 3D Viewer, Animation Editor" At 18, 10 Size 22 Color CYAN

    If PartyMode Then
        Subtitle = "Sin Star I  •  Arin And Orin  •  Party Battle Preview"
    End If

    Draw Text Subtitle At 18, 42 Size 13 Color LIGHT_GRAY
    Draw Text "Character" At 18, 68 Size 13 Color WHITE

    Call DrawButton(104, 62, 72, 26, "Arin", SelectedCharacterTab = 0)
    Call DrawButton(182, 62, 72, 26, "Orin", SelectedCharacterTab = 1)
    Call DrawButton(260, 62, 72, 26, "Party", SelectedCharacterTab = 2)

    If CharacterSwitchBlocked Then
        Draw Text "Save Or Cancel The Pose Before Switching" At 348, 68 Size 12 Color YELLOW
    End If

    If PartyMode Then
        Call DrawPartyOverlay()

        Return
    End If

    If UiVisibility = 0 Then

        Call DrawButton(PanelLeft, 18, 44, 34, "LIGHT", False)
        Call DrawButton(PanelLeft + 48, 18, 56, 34, "CHANNEL", False)
        Call DrawButton(PanelLeft + 108, 18, 50, 34, "SOCKET", SocketGizmosVisible)
        Call DrawButton(PanelLeft + 162, 18, 50, 34, "PROFILE", False)
        Call DrawButton(PanelLeft + 216, 18, 36, 34, "GLOW", EpicGlowVisible)
        Call DrawButton(PanelLeft, 56, 72, 22, DragonLabel(), DragonVisible)
        Call DrawButton(PanelLeft + 76, 56, 48, 22, BackgroundLabel(), BackgroundIndex > 0)
        Call DrawButton(PanelLeft + 128, 56, 36, 22, "Pose", CalibrationVisible)
        Call DrawButton(PanelLeft + 168, 56, 40, 22, "Weapon", SwordVisible)
        Call DrawButton(PanelLeft + 212, 56, 40, 22, "Shield", ShieldVisible)

        Call UI.DrawPanel(PanelLeft, 82, 252, Max(446, Window_Height() - 94))

        Call DrawCharacterStatusSummary(PanelLeft)

        Draw Text "ANIMATIONS" At PanelText, 334 Size 13 Color WHITE

        Call DrawButton(PanelLeft + 178, 330, 74, 18, DemoLabel(), DemoEnabled)

        Call DrawAnimationButtons()
        Call DrawButton(PanelLeft + 12, 444, 78, 22, "Floor/Grid", FloorVisible Or GridVisible)

        If ProfileIndex = ViewerProfiles.PROFILE_ARIN Then

            Call DrawButton(PanelLeft + 94, 444, 76, 22, "Sword Fire", SwordFireVisible)
            Call DrawButton(PanelLeft + 174, 444, 78, 22, "Shield Fire", ShieldFireVisible)

        Else If ProfileIndex = ViewerProfiles.PROFILE_ORIN Then

            Call DrawButton(PanelLeft + 94, 444, 158, 22, OrinStorm.StyleName(), True)
            Call DrawButton(PanelLeft + 12, 470, 128, 20, OrinStorm.ComfortName(), True)

            Draw Text "Charge" At PanelLeft + 146, 474 Size 11 Color CYAN
            Draw Number OrinStorm.StoredCharge() At PanelLeft + 200, 474 Size 11 Color WHITE

        End If

        If SwordFireReady Then

            Call DrawButton(PanelLeft + 12, 470, 128, 20, FlamePlaybackLabel(), Not FlameAnimationPaused)

            Draw Text "Backend / Error" At PanelLeft + 150, 469 Size 9 Color LIGHT_GRAY
            Draw Number Fire.Value(3, SwordFire) At PanelLeft + 160, 480 Size 10 Color CYAN
            Draw Number EquipmentFireFirstError At PanelLeft + 216, 480 Size 10 Color YELLOW

        End If

        If Window_Height() >= ANIMATION_DETAILS_MINIMUM_HEIGHT Then

            Draw Text "Clip ms / Rate / Samples / Events" At PanelText, ANIMATION_DETAILS_Y Size 11 Color LIGHT_GRAY
            Draw Number Character3D.ClipDuration(Character, SelectedClip) At PanelText, ANIMATION_DETAILS_Y + 20 Size 11 Color WHITE
            Draw Number Character3D.ClipSampleRate(Character, SelectedClip) At PanelText + 58, ANIMATION_DETAILS_Y + 20 Size 11 Color CYAN
            Draw Number Character3D.ClipSampleCount(Character, SelectedClip) At PanelText + 104, ANIMATION_DETAILS_Y + 20 Size 11 Color WHITE
            Draw Number Character3D.ClipEventCount(Character, SelectedClip) At PanelText + 166, ANIMATION_DETAILS_Y + 20 Size 11 Color YELLOW
            Draw Text "Model clips / sockets / events" At PanelText, ANIMATION_DETAILS_Y + 42 Size 11 Color LIGHT_GRAY
            Draw Number Character3D.ClipCount(Character) At PanelText, ANIMATION_DETAILS_Y + 62 Size 11 Color WHITE
            Draw Number Character3D.SocketCount(Character) At PanelText + 58, ANIMATION_DETAILS_Y + 62 Size 11 Color CYAN
            Draw Number Character3D.EventCount(Character) At PanelText + 116, ANIMATION_DETAILS_Y + 62 Size 11 Color YELLOW

        End If

        Call DrawCameraControls()

        Call DrawButton(PanelLeft + 12, Window_Height() - 64, 52, 24, "VIEW", False)
        Call DrawButton(PanelLeft + 68, Window_Height() - 64, 74, 24, "PRESENT", False)
        Call DrawButton(PanelLeft + 146, Window_Height() - 64, 40, 24, "ALL", False)
        Call DrawButton(PanelLeft + 190, Window_Height() - 64, 50, 24, "FIT", FitLocked)

    End If

    Call DrawTimeline()

    If (UiVisibility = 0 And
        CalibrationAvailable And
        CalibrationVisible) Then
        Call DrawCalibrationPanel()
    End If

    Draw Text "LMB pan  •  MMB orbit  •  Wheel zoom  •  Space pause  •  RMB reset  •  D dragon  •  W sword  •  S shield" At 16, Window_Height() - 22 Size 11 Color LIGHT_GRAY

    If CalibrationEditing Then

        If ScenePaused Then
            Draw Text "POSE EDIT ACTIVE — SPACE TO RESUME" At 348, 68 Size 12 Color YELLOW
        Else
            Draw Text "POSE EDIT ACTIVE — SPACE TO PAUSE MOVEMENT" At 348, 68 Size 12 Color YELLOW
        End If

    Else If ScenePaused Then

        Draw Text "MOVEMENT PAUSED — SPACE TO RESUME; CAMERA CONTROLS REMAIN ACTIVE" At 348, 68 Size 12 Color YELLOW

    End If

    If UiVisibility = 0 And ViewerError Then

        Fill Rectangle 120, 142, 580, 210, Rgb(56, 8, 18) Opacity 80
        Draw Text "CHARACTER VIEWER RECOVERY" At 148, 166 Size 22 Color WHITE
        Draw Text "The 3D renderer or character resource became unavailable." At 148, 204 Size 14 Color LIGHT_GRAY
        Draw Text "Viewer error" At 148, 238 Size 13 Color LIGHT_GRAY
        Draw Number FirstViewerError At 270, 238 Size 13 Color YELLOW
        Draw Text "Renderer error" At 348, 238 Size 13 Color LIGHT_GRAY
        Draw Number FirstRendererError At 486, 238 Size 13 Color YELLOW
        Draw Text "Failure stage" At 148, 270 Size 13 Color LIGHT_GRAY
        Draw Number FirstFailureStage At 270, 270 Size 13 Color YELLOW
        Draw Text "Press Enter or click Reset to reload the profile safely." At 148, 310 Size 14 Color CYAN

    End If

End Sub

Sub DrawCharacterStatusSummary(PanelLeft As Number)

    Dim PanelText As Number

    PanelText = PanelLeft + 16

        Draw Text "CHARACTER STATUS" At PanelText, 96 Size 16 Color WHITE
        Draw Text "Name" At PanelText, 124 Size 12 Color LIGHT_GRAY
        Draw Text ActiveProfile.DisplayName At PanelLeft + 116, 124 Size 12 Color CYAN
        Draw Text "Party Role" At PanelText, 146 Size 12 Color LIGHT_GRAY
        Draw Text PartyRoleLabel() At PanelLeft + 116, 146 Size 12 Color CYAN
        Draw Text "Animation" At PanelText, 168 Size 12 Color LIGHT_GRAY
        Draw Text SelectedClipLabel() At PanelLeft + 116, 168 Size 12 Color GREEN
        Draw Text "Candidate" At PanelText, 190 Size 12 Color LIGHT_GRAY
        Draw Text ActiveProfile.CandidateVersion At PanelLeft + 116, 190 Size 11 Color YELLOW
        Draw Text "Speed" At PanelText, 216 Size 12 Color LIGHT_GRAY
        Draw Number PlaybackSpeed At PanelLeft + 116, 216 Size 12 Color WHITE

        Call DrawButton(PanelLeft + 172, 204, 30, 24, "-", False)
        Call DrawButton(PanelLeft + 208, 204, 30, 24, "+", False)

        Draw Text "Material" At PanelText, 240 Size 12 Color LIGHT_GRAY
        Draw Text MaterialInspectionLabel() At PanelLeft + 116, 240 Size 12 Color YELLOW
        Draw Text "Draws / Triangles" At PanelText, 262 Size 12 Color LIGHT_GRAY
        Draw Number Graphics3D.DrawCallCount3D() At PanelLeft + 148, 262 Size 12 Color WHITE
        Draw Number Graphics3D.SubmittedTriangleCount3D() At PanelLeft + 192, 262 Size 12 Color WHITE
        Draw Text "Demo / Next" At PanelText, 284 Size 12 Color LIGHT_GRAY
        Draw Text DemoStatusLabel() At PanelLeft + 116, 284 Size 12 Color CYAN
        Draw Number AnimationSecondsRemaining() At PanelLeft + 172, 284 Size 12 Color WHITE
        Draw Text "seconds" At PanelLeft + 192, 284 Size 11 Color LIGHT_GRAY
        Draw Text "Zoom / FPS" At PanelText, 306 Size 12 Color LIGHT_GRAY
        Draw Number CharacterViewer.ZoomDegrees(SmoothZoom) At PanelLeft + 116, 306 Size 12 Color CYAN
        Draw Text "level" At PanelLeft + 146, 306 Size 11 Color LIGHT_GRAY
        Draw Number CurrentFramesPerSecond At PanelLeft + 190, 306 Size 12 Color GREEN
        Draw Text "fps" At PanelLeft + 216, 306 Size 11 Color LIGHT_GRAY

End Sub

Sub DrawPartyStatusPanel()

    Dim SavedCharacter As Character3D.Actor
    Dim SavedProfile As CharacterViewer.Profile
    Dim SavedProfileIndex As Number
    Dim SavedClip As Number
    Dim PanelLeft As Number
    Dim Index As Number

    SavedCharacter = Character
    SavedProfile = ActiveProfile
    SavedProfileIndex = ProfileIndex
    SavedClip = SelectedClip
    PanelLeft = StatusPanelX()

    If PartyTurn = 1 Then

        Character = PartyCompanion.Actor
        ProfileIndex = ViewerProfiles.PROFILE_ORIN
        SelectedClip = PartyCompanion.Clip

    Else If PartyTurn = 2 Then

        Character = Dragon
        ProfileIndex = ViewerProfiles.PROFILE_DRAGON

        For Index = 0 To Character3D.ClipCount(Dragon) - 1

            If Character3D.ClipName(Dragon, Index) = DragonClip Then
                SelectedClip = Index
            End If

        End For

    End If

    ActiveProfile = ViewerProfiles.ProfileAt(ProfileIndex)

    Call UI.DrawPanel(PanelLeft, 82, 252, Max(446, Window_Height() - 94))
    Call DrawCharacterStatusSummary(PanelLeft)

    Draw Text "Following Active Attacker" At PanelLeft + 16, 62 Size 13 Color CYAN
    Draw Text "Animations" At PanelLeft + 16, 334 Size 13 Color WHITE

    Call DrawAnimationButtons()

    If PartyTurn = 1 Then
        Draw Text OrinStorm.StyleName() At PanelLeft + 16, 434 Size 13 Color CYAN
        Draw Text OrinStorm.Caption() At PanelLeft + 16, 456 Size 12 Color LIGHT_GRAY
    Else If PartyTurn = 2 Then
        Draw Text "Mouth Fire / Charged Fireball" At PanelLeft + 16, 434 Size 12 Color CYAN
    Else
        Draw Text "Sword And Shield Fire" At PanelLeft + 16, 434 Size 13 Color CYAN
    End If

    If Window_Height() >= 720 Then

    Draw Text "Frame / Clip Frames" At PanelLeft + 16, 484 Size 11 Color LIGHT_GRAY
    Draw Number Character3D.AnimationTime(Character) * 30 / 1000 At PanelLeft + 16, 502 Size 11 Color WHITE
    Draw Number Character3D.ClipSampleCount(Character, SelectedClip) At PanelLeft + 108, 502 Size 11 Color CYAN

    End If

    If PartyTurn <> 2 Then
        Call DrawButton(PanelLeft + 12, Window_Height() - 64, 228, 24, "Inspect Character", False)
    End If

    Character = SavedCharacter
    ActiveProfile = SavedProfile
    ProfileIndex = SavedProfileIndex
    SelectedClip = SavedClip

End Sub

Sub DrawCameraControls()

    Call DrawCameraSlider(
        "H Orbit",
        Window_Height() - 142,
        CameraControls.OrbitYaw,
        -180,
        180
    )
    Call DrawCameraSlider(
        "V Orbit",
        Window_Height() - 116,
        CameraControls.OrbitPitch,
        -180,
        180
    )
    Call DrawCameraSlider(
        "Zoom",
        Window_Height() - 90,
        CharacterViewer.ZoomDegrees(SmoothZoom),
        ZOOM_IN_LIMIT,
        ZOOM_OUT_LIMIT
    )

End Sub

Sub DrawCameraSlider(
    Label As Text,
    Y As Number,
    Value As Number,
    MinimumValue As Number,
    MaximumValue As Number
)

    Dim KnobX As Number
    Dim PanelLeft As Number
    Dim ProgressWidth As Number

    PanelLeft = StatusPanelX()
    ProgressWidth = (Value - MinimumValue) * CAMERA_SLIDER_WIDTH / Max(1, MaximumValue - MinimumValue)
    ProgressWidth = Min(CAMERA_SLIDER_WIDTH, Max(0, ProgressWidth))
    KnobX = PanelLeft + 76 + ProgressWidth

    Draw Text Label At PanelLeft + 12, Y + 2 Size 11 Color LIGHT_GRAY

    Call UI.DrawSlider(PanelLeft + 76, Y, CAMERA_SLIDER_WIDTH, CAMERA_SLIDER_HEIGHT,
        Value, MinimumValue, MaximumValue)

    Draw Number Value At PanelLeft + 226, Y + 2 Size 10 Color CYAN

End Sub

Sub DrawCalibrationPanel()

    Dim CurrentFrame As Number
    Dim CurrentKeyframe As Number
    Dim KnobX As Number
    Dim MaximumValue As Number
    Dim MinimumValue As Number
    Dim ProgressWidth As Number
    Dim SliderRange As Number
    Dim Value As Number

    CurrentFrame = CurrentAnimationFrame()
    CurrentKeyframe = CalibrationKeyframeIndex(SelectedClip, CurrentFrame)
    Value = CurrentCalibrationValue()
    MinimumValue = CalibrationMinimumValue()
    MaximumValue = CalibrationMaximumValue()
    SliderRange = MaximumValue - MinimumValue
    ProgressWidth = (Value - MinimumValue) * CALIBRATION_SLIDER_WIDTH / SliderRange
    KnobX = CALIBRATION_SLIDER_X + ProgressWidth

    Call UI.DrawPanel(CALIBRATION_PANEL_X, CALIBRATION_PANEL_Y, CALIBRATION_PANEL_WIDTH, CALIBRATION_PANEL_HEIGHT, 90)

    Draw Text "Pose Calibration" At 32, 102 Size 16 Color WHITE
    Draw Text SelectedClipLabel() At 174, 104 Size 12 Color CYAN

    Call DrawButton(292, 96, 68, 22, "Prev Key", False)
    Call DrawButton(364, 96, 68, 22, "Next Key", False)

    Call DrawButton(34, 128, 92, 24, "Weapon Wrist", CalibrationTarget = CALIBRATION_TARGET_SWORD_WRIST)
    Call DrawButton(130, 128, 96, 24, "Shield Wrist", CalibrationTarget = CALIBRATION_TARGET_SHIELD_WRIST)
    Call DrawButton(230, 128, 76, 24, "Weapon", CalibrationTarget = CALIBRATION_TARGET_SWORD)
    Call DrawButton(310, 128, 76, 24, "Shield", CalibrationTarget = CALIBRATION_TARGET_SHIELD)
    Call DrawButton(34, 158, 48, 24, "X", CalibrationAxis = CALIBRATION_AXIS_X)
    Call DrawButton(86, 158, 48, 24, "Y", CalibrationAxis = CALIBRATION_AXIS_Y)
    Call DrawButton(138, 158, 48, 24, "Z", CalibrationAxis = CALIBRATION_AXIS_Z)
    Call DrawButton(202, 158, 72, 24, "Rotate", CalibrationTransform = CALIBRATION_TRANSFORM_ROTATE)
    Call DrawButton(278, 158, 72, 24, "Move", CalibrationTransform = CALIBRATION_TRANSFORM_MOVE)
    Call DrawButton(354, 158, 78, 24, "Reset", False)

    Draw Text CalibrationTargetLabel() At 34, 187 Size 12 Color LIGHT_GRAY
    Draw Text CalibrationTransformLabel() At 142, 187 Size 12 Color CYAN
    Draw Text CalibrationAxisLabel() At 208, 187 Size 12 Color CYAN
    Draw Number Value At 230, 187 Size 12 Color WHITE
    Draw Text CalibrationUnitLabel() At 274, 187 Size 11 Color LIGHT_GRAY

    Call UI.DrawSlider(CALIBRATION_SLIDER_X, CALIBRATION_SLIDER_Y,
        CALIBRATION_SLIDER_WIDTH, CALIBRATION_SLIDER_HEIGHT, Value, MinimumValue, MaximumValue, 6)

    Draw Text "G Move  •  R/E Rotate  •  X/Y/Z Constrain" At 34, 232 Size 11 Color WHITE
    Draw Text "Enter Confirm/Save  •  Esc Cancel  •  Drag Colored Handles" At 34, 248 Size 10 Color LIGHT_GRAY

    Call DrawButton(34, 268, 80, 24, "Copy Key", CurrentKeyframe >= 0 And Not CalibrationEditing)
    Call DrawButton(118, 268, 80, 24, "Paste Key", CalibrationClipboardAvailable And Not CalibrationEditing)
    Call DrawButton(202, 268, 90, 24, "Delete Key", CurrentKeyframe >= 0 And Not CalibrationEditing)
    Call DrawButton(34, 298, 100, 24, "Reload Key", CurrentKeyframe >= 0)
    Call DrawButton(140, 298, 100, 24, "In Place", CalibrationHoldGrip)
    Call DrawButton(246, 298, 186, 24, "Undo Last Change", CalibrationUndoCount > 0)
    Call DrawButton(34, 374, 194, 24, "Decouple Weapon", SwordDecoupled[CalibrationClipBase + SelectedClip] <> 0)
    Call DrawButton(236, 374, 196, 24, "Decouple Shield", ShieldDecoupled[CalibrationClipBase + SelectedClip] <> 0)

    Call DrawButton(34, 412, 196, 24, CalibrationResetClipLabel(), CalibrationClearConfirm)
    Call DrawButton(332, 412, 100, 24, "Save Frame", CurrentKeyframe >= 0 And Not CalibrationEditing)
    Call DrawButton(244, 412, 84, 24, "Cancel", CalibrationEditing)

    Fill Rectangle 34, 412, 196, 2, Rgb(210, 70, 76) Opacity 90
    Fill Rectangle 34, 434, 196, 2, Rgb(210, 70, 76) Opacity 90
    Fill Rectangle 34, 412, 2, 24, Rgb(210, 70, 76) Opacity 90
    Fill Rectangle 228, 412, 2, 24, Rgb(210, 70, 76) Opacity 90

    If CalibrationStorageRejected Then

        Draw Text "Save blocked: invalid calibration; restore a backup" At 34, 330 Size 10 Color YELLOW

    Else If CalibrationClearConfirm Then

        Draw Text "Delete saved keys for:" At 34, 330 Size 10 Color YELLOW
        Draw Text SelectedClipName() At 188, 330 Size 10 Color WHITE
        Draw Number CalibrationKeyframeCounts[CalibrationClipBase + SelectedClip] At 350, 330 Size 10 Color YELLOW

    Else If CalibrationGripLimit Then

        Draw Text "In Place reached the saved position limit" At 34, 330 Size 10 Color YELLOW

    Else If CalibrationEditing Then

        If ScenePaused Then
            Draw Text "Editing — movement paused by Space" At 34, 330 Size 11 Color YELLOW
        Else
            Draw Text "Editing live — Space pauses movement" At 34, 330 Size 11 Color YELLOW
        End If

    Else
        Draw Text "In Place: rotate equipment without shifting its grip" At 34, 330 Size 10 Color LIGHT_GRAY

    End If

    If CalibrationSaveLimitReached Then

        Draw Text "Keyframe limit reached" At 34, 350 Size 11 Color YELLOW

    Else
        Draw Text "Keys" At 34, 350 Size 11 Color LIGHT_GRAY
        Draw Number CalibrationKeyframeCounts[CalibrationClipBase + SelectedClip] At 68, 350 Size 11 Color CYAN

        If CalibrationEditing Then
            Draw Text "Editing frame" At 104, 350 Size 11 Color YELLOW
            Draw Number CalibrationEditingFrame At 200, 350 Size 11 Color WHITE
        Else
            Draw Text "Current frame" At 104, 350 Size 11 Color LIGHT_GRAY
            Draw Number CurrentFrame At 200, 350 Size 11 Color WHITE
        End If

        If CurrentKeyframe >= 0 Then
            Draw Text "KEYED" At 230, 350 Size 11 Color GREEN
        End If

    End If

End Sub

Function FlamePlaybackLabel() As Text

    Dim Result As Text

    If FlameAnimationPaused Then
        Result = "Play Flames"
    Else
        Result = "Pause Flames"
    End If

    Return Result

End Function

Function CalibrationTargetLabel() As Text

    Dim Result As Text

    If CalibrationTarget = CALIBRATION_TARGET_SWORD_WRIST Then
        Result = "Weapon Wrist"
    Else If CalibrationTarget = CALIBRATION_TARGET_SHIELD_WRIST Then
        Result = "Shield Wrist"
    Else If CalibrationTarget = CALIBRATION_TARGET_SWORD Then
        Result = "Weapon"
    Else
        Result = "Shield"
    End If

    Return Result

End Function

Function CalibrationAxisLabel() As Text

    Dim Result As Text

    If CalibrationAxis = CALIBRATION_AXIS_X Then
        Result = "X"
    Else If CalibrationAxis = CALIBRATION_AXIS_Y Then
        Result = "Y"
    Else
        Result = "Z"
    End If

    Return Result

End Function

Function TimelineWidth() As Number

    Dim Result As Number

    Result = Max(120, StatusPanelX() - TIMELINE_LEFT - 20)
    Return Result

End Function

Sub DrawTimeline()

    Dim Duration As Number
    Dim EventIndex As Number
    Dim EventTime As Number
    Dim Keyframe As Number
    Dim KeyframeFrame As Number
    Dim KeyframeTime As Number
    Dim MarkerX As Number
    Dim ProgressWidth As Number
    Dim TimelineY As Number
    Dim Width As Number

    Duration = Max(1, Character3D.ClipDuration(Character, SelectedClip))
    TimelineY = Window_Height() - 64
    Width = TimelineWidth()
    ProgressWidth = Character3D.AnimationTime(Character) * Width / Duration

    Call DrawButton(TIMELINE_LEFT, Window_Height() - 96, 62, 24, "0-Frame", False)
    Call DrawButton(TIMELINE_LEFT + 68, Window_Height() - 96, 62, 24, "< Key", False)
    Call DrawButton(TIMELINE_LEFT + 136, Window_Height() - 96, 62, 24, "Key >", False)
    Call DrawButton(TIMELINE_LEFT + 204, Window_Height() - 96, 62, 24, "< Frame", FrameButtonRepeatDirection < 0)
    Call DrawButton(TIMELINE_LEFT + 272, Window_Height() - 96, 62, 24, "Frame >", FrameButtonRepeatDirection > 0)

    Draw Text SelectedClipName() At TIMELINE_LEFT + 348, Window_Height() - 88 Size 11 Color CYAN

    If SelectedTimelineEvent > 0 Then

        Draw Text Character3D.EventName(Character, SelectedTimelineEvent) At TIMELINE_LEFT + 518, Window_Height() - 88 Size 11 Color YELLOW
        Draw Number Character3D.EventTime(Character, SelectedTimelineEvent) At TIMELINE_LEFT + 616, Window_Height() - 88 Size 11 Color WHITE
        Draw Number Character3D.EventValue(Character, SelectedTimelineEvent) At TIMELINE_LEFT + 672, Window_Height() - 88 Size 11 Color CYAN

    Else
        Draw Text "No authored event" At TIMELINE_LEFT + 518, Window_Height() - 88 Size 11 Color LIGHT_GRAY

    End If

    Fill Rectangle TIMELINE_LEFT, TimelineY, Width, TIMELINE_HEIGHT, Rgb(18, 35, 58) Opacity 88
    Fill Rectangle TIMELINE_LEFT, TimelineY, ProgressWidth, TIMELINE_HEIGHT, Rgb(16, 102, 136) Opacity 90

    For EventIndex = 1 To Character3D.EventCount(Character)

        If Character3D.EventClipIndex(Character, EventIndex) = SelectedClip Then

            EventTime = Character3D.EventTime(Character, EventIndex)
            MarkerX = TIMELINE_LEFT + EventTime * Width / Duration

            Fill Rectangle MarkerX, TimelineY - 3, 2, TIMELINE_HEIGHT + 6, YELLOW Opacity 100

        End If

    End For

    If CalibrationAvailable Then

        For Keyframe = 0 To CalibrationKeyframeCounts[CalibrationClipBase + SelectedClip] - 1

            KeyframeFrame = CalibrationKeyframeFrames[CalibrationClipBase + SelectedClip, Keyframe]

            If TimelineKeyframeDragging And Keyframe = TimelineDraggedKeyframe Then
                KeyframeFrame = TimelineDraggedTargetFrame
            End If

            KeyframeTime = CalibrationFrameTimeMilliseconds(
                SelectedClip,
                KeyframeFrame
            )
            MarkerX = TIMELINE_LEFT + KeyframeTime * Width / Duration

            Fill Rectangle MarkerX - 1, TimelineY - 5, 3, TIMELINE_HEIGHT + 10, GREEN Opacity 100
        End For

    End If

    Draw Number Character3D.AnimationTime(Character) At TIMELINE_LEFT + 6, TimelineY + 3 Size 10 Color WHITE
    Draw Number Duration At TIMELINE_LEFT + Width - 48, TimelineY + 3 Size 10 Color WHITE

    If CalibrationAvailable Then
        Draw Text CalibrationFilePath At TIMELINE_LEFT, Window_Height() - 39 Size 9 Color LIGHT_GRAY
    End If

End Sub

Function BackgroundLabel() As Text

    Dim Result As Text

    If BackgroundIndex = 1 Then
        Result = "BG GREEN"
    Else If BackgroundIndex = 2 Then
        Result = "BG PURPLE"
    Else If BackgroundIndex = 3 Then
        Result = "BG SCENE"
    Else If BackgroundIndex = 4 Then
        Result = "BG LOGO"
    Else
        Result = "BG BLACK"
    End If

    Return Result

End Function

Function DragonLabel() As Text

    Dim Result As Text

    If Not DragonAvailable Then
        Result = "NO DRAGON"
    Else If DragonVisible Then
        Result = "DRAGON ON"
    Else
        Result = "DRAGON OFF"
    End If

    Return Result

End Function

Function ViewerTitle() As Text

    Dim Result As Text

    Result = "SMILE 2.0 - 3D Viewer, Animation Editor - " + ViewerProfiles.ModelFileName(ProfileIndex)

    Return Result

End Function

Function ViewerLayoutTooSmall() As Boolean

    Dim Result As Boolean

    Result = Window_Width() < MINIMUM_VIEWER_WIDTH Or Window_Height() < MINIMUM_VIEWER_HEIGHT

    Return Result

End Function

Sub DrawAnimationButtons()

    Dim ClipCount As Number
    Dim Index As Number
    Dim Column As Number
    Dim Row As Number
    Dim ButtonX As Number
    Dim ButtonY As Number

    ClipCount = ViewerProfiles.ClipCount(ProfileIndex)

    For Index = 0 To ClipCount - 1

        Column = Index Mod ANIMATION_BUTTON_COLUMN_COUNT
        Row = Index / ANIMATION_BUTTON_COLUMN_COUNT
        ButtonX = AnimationButtonX() + Column * (ANIMATION_BUTTON_WIDTH + ANIMATION_BUTTON_COLUMN_GAP)
        ButtonY = ANIMATION_BUTTON_Y + Row * (ANIMATION_BUTTON_HEIGHT + ANIMATION_BUTTON_ROW_GAP)

        Call DrawButton(
            ButtonX,
            ButtonY,
            ANIMATION_BUTTON_WIDTH,
            ANIMATION_BUTTON_HEIGHT,
            ViewerProfiles.ClipLabel(ProfileIndex, Index),
            SelectedClip = RuntimeClipForPresentationIndex(Index)
        )
    End For

End Sub

Function AnimationSecondsRemaining() As Number

    Dim RequiredMilliseconds As Number
    Dim RemainingMilliseconds As Number
    Dim Result As Number

    If PartyMode Then

        RequiredMilliseconds = PartyAttackDuration() + 4000

        If PartyTurn = 2 Then
            RequiredMilliseconds = DragonTurnDuration()
        End If

        RemainingMilliseconds = Max(0, RequiredMilliseconds - PartyElapsed)
        Result = (RemainingMilliseconds + 999) / 1000

    Else If DemoEnabled Then

        RequiredMilliseconds = DemoRequiredLoops() * DemoLoopDurationMilliseconds()

        If SelectedClipMode() = Graphics3D.ANIMATION_ONCE Then
            RequiredMilliseconds = Max(DemoSequenceTargetMilliseconds(), DemoLoopDurationMilliseconds())
        End If

        RemainingMilliseconds = Max(0, RequiredMilliseconds - AnimationCycleElapsed)
        Result = (RemainingMilliseconds + 999) / 1000

    Else
        Result = 0

    End If

    Return Result

End Function

Function DemoLoopDurationMilliseconds() As Number

    Dim Result As Number

    Result = Character3D.ClipDuration(Character, SelectedClip) * 100 / Max(1, PlaybackSpeed)
    Result = Max(1, Result)

    Return Result

End Function

Function DemoRequiredLoops() As Number

    Dim LoopDuration As Number
    Dim Result As Number

    LoopDuration = DemoLoopDurationMilliseconds()
    Result = (DemoSequenceTargetMilliseconds() + LoopDuration - 1) / LoopDuration
    Result = Max(1, Result)

    Return Result

End Function

Function DemoSequenceTargetMilliseconds() As Number

    If ViewerProfiles.IsPartyCharacter(ProfileIndex) Then
        Return 3000
    End If

    Return ANIMATION_CYCLE_MILLISECONDS

End Function

Function DemoLabel() As Text

    Dim Result As Text

    If DemoEnabled Then
        Result = "DEMO ON"
    Else
        Result = "DEMO OFF"
    End If

    Return Result

End Function

Function DemoStatusLabel() As Text

    Dim Result As Text

    If DemoEnabled Then
        Result = "On"
    Else
        Result = "Off"
    End If

    Return Result

End Function

Function ProductionClipStatusLabel() As Text

    Dim Result As Text

    If ProfileIndex = ViewerProfiles.PROFILE_ORIN Then
        Result = "9-animation viewer candidate"
    Else If ViewerProfiles.IsPartyCharacter(ProfileIndex) Then
        Result = "8-clip viewer candidate"
    Else If ProfileIndex = ViewerProfiles.PROFILE_ARIN_V56 Then
        Result = "v5.6 diagnostic candidate"
    Else If ProfileIndex = ViewerProfiles.PROFILE_ARIN_ORIGINAL Then
        Result = "Original 3 clips"
    Else
        Result = "Technical fixture"
    End If

    Return Result

End Function

Function SocketStatusLabel() As Text

    Dim Result As Text

    If SocketGizmosVisible And ShowAllSocketOrigins Then
        Result = "All origins"
    Else If SocketGizmosVisible Then
        Result = Character3D.SocketName(Character, SelectedSocket)
    Else
        Result = "Hidden"
    End If

    Return Result

End Function

Function PartyRoleLabel() As Text

    Dim Result As Text

    Result = ActiveProfile.PartyRole

    If Result = "" Then
        Result = "Technical"
    End If

    Return Result

End Function

Function MaterialInspectionLabel() As Text

    Dim Result As Text

    If MaterialInspection = Graphics3D.MATERIAL_INSPECTION_LIT Then
        Result = "Lit"
    Else If MaterialInspection = Graphics3D.MATERIAL_INSPECTION_BASE_COLOR Then
        Result = "Base Color"
    Else If MaterialInspection = Graphics3D.MATERIAL_INSPECTION_NORMAL Then
        Result = "Normal"
    Else If MaterialInspection = Graphics3D.MATERIAL_INSPECTION_ROUGHNESS Then
        Result = "Roughness"
    Else If MaterialInspection = Graphics3D.MATERIAL_INSPECTION_METALLIC Then
        Result = "Metallic"
    Else If MaterialInspection = Graphics3D.MATERIAL_INSPECTION_OCCLUSION Then
        Result = "Occlusion"
    Else
        Result = "Emissive"
    End If

    Return Result

End Function

Function AutoOrbitLabel() As Text

    Dim Result As Text

    If AutoOrbit Then
        Result = "On"
    Else
        Result = "Off"
    End If

    Return Result

End Function

Sub DrawButton(X As Number, Y As Number, Width As Number, Height As Number,
    Label As Text, Selected As Boolean)

    Call UI.DrawButton(X, Y, Width, Height, Label, Selected)

End Sub

Sub DestroyViewer()

    Call DestroyViewerResources()
    Call Character3D.Shutdown()
    Call Scene3D.Shutdown()
    Call Graphics3D.ResetRenderer3D()

End Sub

Sub DestroyViewerResources()

    Dim Index As Number

    Call DestroyPartyCompanion()
    Call DestroyDragon()
    Call DragonPresence.Shutdown()
    Call Fire.Shutdown()
    Call OrinStorm.Shutdown()

    SwordFire.Slot = 0
    SwordFireReady = False

    For Index = 0 To 2
        ShieldFire[Index].Slot = 0
    End For

    Call DestroyBackdrop()
    Call DestroyEpicGlow()
    Call DestroySocketGizmos()
    Call DestroyStudioGrid()

    Call Character3D.Destroy(Character)

End Sub

Sub SelectCharacterTab(Index As Number)

    If (Index = SelectedCharacterTab And
        Not ViewerError And
        (PartyMode Or ViewerProfiles.IsPartyCharacter(ProfileIndex))) Then
        Return
    End If

    If CalibrationEditing Then
        CharacterSwitchBlocked = True
        Return
    End If

    Call DestroyViewerResources()

    SelectedCharacterTab = Index
    PartyMode = Index = 2
    ProfileIndex = ViewerProfiles.PROFILE_ARIN

    If Index = 1 Then
        ProfileIndex = ViewerProfiles.PROFILE_ORIN
    End If

    Ready = True
    ViewerError = False
    FirstViewerError = 0
    FirstRendererError = 0
    FirstFailureStage = 0
    DemoEnabled = True
    ScenePaused = False
    SliderDragOwner = 0
    TimelineScrubbing = False
    TimelineKeyframeDragging = False
    FrameButtonRepeatDirection = 0

    Call LoadViewer()

End Sub

Function CaptureActorContext() As ViewerActorContext

    Dim Result As ViewerActorContext

    Result.Actor = Character
    Result.Frame = ViewerFrame
    Result.Profile = ProfileIndex
    Result.Clip = SelectedClip
    Result.KeyBase = CalibrationClipBase
    Result.WeaponWrist = SwordWristNode
    Result.ShieldWrist = ShieldWristNode
    Result.WeaponGlow = SwordGlow
    Result.ShieldGlow = ShieldGlow
    Result.CalibrationAvailable = CalibrationAvailable
    Result.GlowAvailable = EpicGlowAvailable
    Result.GlowVisible = EpicGlowVisible

    Return Result

End Function

Sub UseActorContext(Context As ViewerActorContext)

    Character = Context.Actor
    ViewerFrame = Context.Frame
    ProfileIndex = Context.Profile
    SelectedClip = Context.Clip
    CalibrationClipBase = Context.KeyBase
    SwordWristNode = Context.WeaponWrist
    ShieldWristNode = Context.ShieldWrist
    SwordGlow = Context.WeaponGlow
    ShieldGlow = Context.ShieldGlow
    CalibrationAvailable = Context.CalibrationAvailable
    EpicGlowAvailable = Context.GlowAvailable
    EpicGlowVisible = Context.GlowVisible

End Sub

Sub CreatePartyCompanion()

    Dim Primary As ViewerActorContext
    Dim CompanionProfile As CharacterViewer.Profile
    Dim CompanionBounds As Character3D.Bounds3D
    Dim CompanionModel As Core.Model3D
    Dim CompanionAnimator As Core.Animator3D

    Primary = CaptureActorContext()
    ProfileIndex = ViewerProfiles.PROFILE_ORIN
    CompanionProfile = ViewerProfiles.ProfileAt(ProfileIndex)
    Character = Character3D.LoadWithPolicy(
        CompanionProfile.AssetPath, Character3D.CHARACTER_LOAD_REQUIRE_PBR
    )
    PartyReady = Character3D.IsValid(Character)

    If PartyReady Then

        CompanionBounds = Character3D.LocalBounds(Character)
        ViewerFrame = CharacterViewer.AutoFit(CompanionProfile, CompanionBounds)
        PartyReady = ViewerFrame.Valid
        Ready = Character3D.SetScale(Character, ViewerFrame.ScalePercent) And Ready
        Ready = Character3D.SetShadows(Character, True, True) And Ready
        CalibrationClipBase = CALIBRATION_MAX_CLIPS
        CalibrationProfileFingerprint = ViewerProfiles.CalibrationFingerprint(ProfileIndex)
        CalibrationDataKey = ViewerProfiles.CalibrationKey(ProfileIndex)

        Call ConfigureCalibration()

        PartyReady = CalibrationAvailable And Not CalibrationStorageRejected And PartyReady
        CompanionModel.Handle = Character3D.ModelHandle(Character)
        CompanionAnimator.Handle = Character3D.AnimatorHandle(Character)
        SwordGlow = Graphics3D.CreateModelPart3D(CompanionModel, WEAPON_PART_INDEX)
        ShieldGlow = Graphics3D.CreateModelPart3D(CompanionModel, SHIELD_PART_INDEX)
        EpicGlowAvailable = SwordGlow.Handle <> 0 And ShieldGlow.Handle <> 0
        EpicGlowVisible = EpicGlowAvailable

        If EpicGlowAvailable Then

            Ready = Graphics3D.SetObjectMaterial3D(SwordGlow, EpicGlowMaterial) And Ready
            Ready = Graphics3D.SetObjectMaterial3D(ShieldGlow, EpicGlowMaterial) And Ready
            Ready = Graphics3D.SetObjectAnimator3D(SwordGlow, CompanionAnimator) And Ready
            Ready = Graphics3D.SetObjectAnimator3D(ShieldGlow, CompanionAnimator) And Ready
            Ready = Graphics3D.SetObjectCullMode3D(ShieldGlow, Graphics3D.OBJECT_CULL_FRONT) And Ready

            Call Graphics3D.SetObjectColor(SwordGlow, 255, 255, 255)
            Call Graphics3D.SetObjectColor(ShieldGlow, 255, 255, 255)
            Call Graphics3D.SetObjectOpacity(SwordGlow, 95)
            Call Graphics3D.SetObjectOpacity(ShieldGlow, 90)
            Call Graphics3D.SetObjectShadows3D(SwordGlow, False, False)
            Call Graphics3D.SetObjectShadows3D(ShieldGlow, False, False)

        End If

        PartyCompanion = CaptureActorContext()

    End If

    Call UseActorContext(Primary)

    CalibrationProfileFingerprint = ViewerProfiles.CalibrationFingerprint(ProfileIndex)
    CalibrationDataKey = ViewerProfiles.CalibrationKey(ProfileIndex)

    Call ConfigureCalibration()
    Call ResetPartyDemo()

    Ready = PartyReady And Ready

End Sub

Sub ResetPartyDemo()

    PartyElapsed = 0
    PartyTurn = 0
    DragonCounter = 0
    PartyStage = -1
    DragonReactionPending = False
    DemoEnabled = True
    CalibrationVisible = False

    If PartyReady Then
        Ready = Character3D.SetPartVisible(PartyCompanion.Actor, WEAPON_PART_INDEX, SwordVisible) And Ready
        Ready = Character3D.SetPartVisible(PartyCompanion.Actor, SHIELD_PART_INDEX, ShieldVisible) And Ready
    End If

End Sub

Function PartyAttackDuration() As Number

    Dim Actor As Character3D.Actor
    Dim Index As Number
    Dim Name As Text
    Dim Result As Number

    Actor = Character
    Name = "SwordAttack"

    If PartyTurn = 1 Then
        Actor = PartyCompanion.Actor
        Name = "ThorAttack"
    End If

    Result = 1200

    For Index = 0 To Character3D.ClipCount(Actor) - 1

        If Character3D.ClipName(Actor, Index) = Name Then
            Result = Character3D.ClipDuration(Actor, Index) * 100 / Max(25, PlaybackSpeed)
            Exit For
        End If

    End For

    Return Result

End Function

Sub PlayPartyClip(ByRef Actor As Character3D.Actor, Name As Text, ByRef Clip As Number)

    Dim Index As Number
    Dim Mode As Number
    Dim HoldGuard As Boolean

    Mode = Graphics3D.ANIMATION_LOOP
    HoldGuard = (Actor.Handle = PartyCompanion.Actor.Handle And
        ViewerProfiles.HoldsFinalPose(PartyCompanion.Profile, Name))

    If (Name = "SwordAttack" Or
        Name = "ThorAttack" Or
        Name = "Hit" Or
        HoldGuard) Then
        Mode = Graphics3D.ANIMATION_ONCE
    End If

    For Index = 0 To Character3D.ClipCount(Actor) - 1

        If Character3D.ClipName(Actor, Index) = Name Then

            If HoldGuard And Clip = Index Then
                Return
            End If

            Clip = Index
            Ready = Character3D.PlayMode(Actor, Name, Mode, PlaybackSpeed) And Ready
            Exit For

        End If

    End For

End Sub

Sub AdvancePartyDemo()

    Dim AttackDuration As Number
    Dim Stage As Number
    Dim Travel1000 As Number
    Dim Name As Text

    If Not PartyReady Then
        Return
    End If

    If DemoEnabled Then
        PartyElapsed = PartyElapsed + AnimationUpdateElapsed
    End If

    If PartyTurn = 2 Then
        Call AdvanceDragonTurn()

        Return
    End If

    AttackDuration = PartyAttackDuration()

    If PartyElapsed >= AttackDuration + 4000 Then

        PartyElapsed = 0
        PartyTurn = (PartyTurn + 1) Mod 3
        PartyStage = -1

    End If

    If PartyTurn = 2 Then
        Call AdvanceDragonTurn()

        Return
    End If

    Stage = 0
    Travel1000 = Min(1000, Max(0, PartyElapsed - 650) * 1000 / 650)
    Name = "Walk"

    If PartyTurn = 1 Then
        Name = "Run"
    End If

    If PartyElapsed >= AttackDuration + 2000 Then

        Stage = 3
        Travel1000 = 0
        Name = "Idle"

    Else If PartyElapsed >= AttackDuration + 1300 Then

        Stage = 2
        Travel1000 = Max(0, 1000 - (PartyElapsed - AttackDuration - 1300) * 1000 / 700)
        Name = "Walk"

        If PartyTurn = 1 Then
            Name = "Run"
        End If

    Else If PartyElapsed >= 1300 Then

        Stage = 1
        Travel1000 = 1000
        Name = "SwordAttack"

        If PartyTurn = 1 Then
            Name = "ThorAttack"
        End If

    End If

    If PartyElapsed < 650 Then
        Stage = -2
        Name = "Idle"
    End If

    If Stage <> PartyStage Then

        DragonReactionPending = Stage = 1

        If PartyTurn = 0 Then
            Call PlayPartyClip(Character, Name, SelectedClip)
            Call PlayPartyClip(PartyCompanion.Actor, "Defend", PartyCompanion.Clip)
        Else

            Call PlayPartyClip(Character, "Defend", SelectedClip)
            Call PlayPartyClip(PartyCompanion.Actor, Name, PartyCompanion.Clip)
        End If

        PartyStage = Stage

    End If

    ViewerFrame.PositionX = 58
    ViewerFrame.PositionZ = -19
    PartyCompanion.Frame.PositionX = 13
    PartyCompanion.Frame.PositionZ = 59

    If PartyTurn = 0 Then
        ViewerFrame.PositionX = ViewerFrame.PositionX - 79 * Travel1000 / 1000
        ViewerFrame.PositionZ = ViewerFrame.PositionZ - 25 * Travel1000 / 1000
    Else
        PartyCompanion.Frame.PositionX = PartyCompanion.Frame.PositionX - 62 * Travel1000 / 1000
        PartyCompanion.Frame.PositionZ = PartyCompanion.Frame.PositionZ - 55 * Travel1000 / 1000
    End If

    Ready = Character3D.Place(Character, ViewerFrame.PositionX, ViewerFrame.PositionY, ViewerFrame.PositionZ) And Ready
    Ready = Character3D.Place(PartyCompanion.Actor,
        PartyCompanion.Frame.PositionX, PartyCompanion.Frame.PositionY, PartyCompanion.Frame.PositionZ) And Ready
    Ready = FaceDragon(Character, 0) And Ready
    Ready = FaceDragon(PartyCompanion.Actor, ORIN_ARENA_YAW_ADJUSTMENT) And Ready

End Sub

Sub AdvanceDragonTurn()

    Dim Stage As Number
    Dim Duration As Number
    Dim ActionTime As Number

    Duration = DragonTurnDuration()
    ActionTime = PartyElapsed * PlaybackSpeed / 100

    If PartyElapsed >= Duration Then

        PartyTurn = 0
        PartyElapsed = 0
        PartyStage = -1
        DragonCounter = DragonCounter + 1
        Return

    End If

    Stage = 0

    If ActionTime >= 1200 And ActionTime < 1750 Then
        Stage = 1
    Else If (ActionTime >= 2200 And
        ActionTime < 2700 And
        DragonCounter Mod 3 = 0) Then
        Stage = 2
    End If

    If Stage <> PartyStage Then

        If Stage = 1 Then
            Call PlayPartyClip(Character, "Hit", SelectedClip)
            Call PlayPartyClip(PartyCompanion.Actor, "Defend", PartyCompanion.Clip)
        Else If Stage = 2 Then
            Call PlayPartyClip(Character, "Defend", SelectedClip)
            Call PlayPartyClip(PartyCompanion.Actor, "Hit", PartyCompanion.Clip)
        Else

            Call PlayPartyClip(Character, "Defend", SelectedClip)
            Call PlayPartyClip(PartyCompanion.Actor, "Defend", PartyCompanion.Clip)
        End If

        PartyStage = Stage

    End If

    ViewerFrame.PositionX = 58
    ViewerFrame.PositionZ = -19
    PartyCompanion.Frame.PositionX = 13
    PartyCompanion.Frame.PositionZ = 59
    Ready = Character3D.Place(Character, ViewerFrame.PositionX, ViewerFrame.PositionY, ViewerFrame.PositionZ) And Ready
    Ready = Character3D.Place(PartyCompanion.Actor,
        PartyCompanion.Frame.PositionX, PartyCompanion.Frame.PositionY, PartyCompanion.Frame.PositionZ) And Ready
    Ready = FaceDragon(Character, 0) And Ready
    Ready = FaceDragon(PartyCompanion.Actor, ORIN_ARENA_YAW_ADJUSTMENT) And Ready

End Sub

Function DragonTurnDuration() As Number

    Dim Result As Number

    Result = 4500

    If DragonCounter Mod 3 = 1 Then
        Result = 2800
    Else If DragonCounter Mod 3 = 2 Then
        Result = 5400
    End If

    Result = Result * 100 / Max(25, PlaybackSpeed)

    Return Result

End Function

Sub UpdatePartyCompanion()

    Dim Primary As ViewerActorContext
    Dim Center As Core.Vector3
    Dim Tip As Core.Vector3

    If Not PartyReady Then
        Return
    End If

    Primary = CaptureActorContext()

    Call UseActorContext(PartyCompanion)

    Ready = Character3D.Update(Character, AnimationUpdateElapsed) And Ready

    Call ApplyCharacterPresentationOffset()
    Call UpdateCalibrationForCurrentFrame()
    Call ApplyWristCalibration()
    Call ApplyEquipmentCoupling()

    If EpicGlowAvailable Then

        Center = Character3D.SocketPosition(Character, "SwordBase", BODY_PART_INDEX, SwordDecoupled[CalibrationClipBase + SelectedClip] <> 0)
        Tip = Character3D.SocketPosition(Character, "SwordTip", BODY_PART_INDEX, SwordDecoupled[CalibrationClipBase + SelectedClip] <> 0)
        Center.X = (Center.X + Tip.X) / 2
        Center.Y = (Center.Y + Tip.Y) / 2
        Center.Z = (Center.Z + Tip.Z) / 2
        Ready = UpdateEquipmentGlow(SwordGlow, Center) And Ready
        Center = Character3D.SocketPosition(Character, "ShieldCenter", BODY_PART_INDEX, ShieldDecoupled[CalibrationClipBase + SelectedClip] <> 0)
        Ready = UpdateEquipmentGlow(ShieldGlow, Center) And Ready

    End If

    Call ApplyEquipmentCalibration()

    PartyCompanion = CaptureActorContext()

    Call UseActorContext(Primary)

End Sub

Function DrawPartyCompanion() As Boolean

    Dim Result As Boolean

    Result = Character3D.Draw(PartyCompanion.Actor)

    If EpicGlowVisible And PartyCompanion.GlowAvailable Then

        If SwordVisible Then
            Result = Graphics3D.DrawObject3D(PartyCompanion.WeaponGlow) And Result
        End If

    End If

    Return Result

End Function

Sub DestroyPartyCompanion()

    Call Graphics3D.DestroyObject3D(PartyCompanion.WeaponGlow)
    Call Graphics3D.DestroyObject3D(PartyCompanion.ShieldGlow)
    Call Character3D.Destroy(PartyCompanion.Actor)

    PartyReady = False

End Sub

Function HandlePartyPointer() As Boolean

    Dim Left As Number
    Dim Result As Boolean

    Left = 12
    Result = (Pointer_Y() < 96 Or Pointer_X() < Left + 252 Or
        Pointer_X() >= StatusPanelX() Or Pointer_Y() >= Window_Height() - 25)

    If HandleSharedSliders() Then
        Return True
    End If

    If Pointer_Pressed(POINTER_SECONDARY) Then
        Call ResetAll()

        Return True
    End If

    If Not Pointer_Pressed(POINTER_PRIMARY) Then
        Return Result
    End If

    If (PointerInRectangle(StatusPanelX() + 12, Window_Height() - 64, 228, 24) And
        PartyTurn <> 2) Then
        Call SelectCharacterTab(PartyTurn)

        Return True
    End If

    If PointerInRectangle(StatusPanelX() + 172, 204, 30, 24) Then
        Call AdjustPlaybackSpeed(-25)
    Else If PointerInRectangle(StatusPanelX() + 208, 204, 30, 24) Then
        Call AdjustPlaybackSpeed(25)
    Else If PointerInRectangle(Left, 104, 76, 30) Then
        Call ToggleDragon()
    Else If PointerInRectangle(Left + 82, 104, 76, 30) Then
        Call ToggleSword()
    Else If PointerInRectangle(Left + 164, 104, 76, 30) Then
        Call ToggleShield()
    Else If PointerInRectangle(Left, 140, 76, 22) Then
        Call ToggleFloorAndGrid()
    Else If PointerInRectangle(Left + 82, 140, 76, 22) Then
        Call CycleBackground()
    Else If PointerInRectangle(Left + 164, 140, 76, 22) Then
        Call ToggleEpicGlow()
    Else If PointerInRectangle(Left + 12, 324, 108, 28) Then
        Call ToggleScenePause()
    Else If PointerInRectangle(Left + 128, 324, 108, 28) Then
        Call ToggleAutoOrbit()
    Else If PointerInRectangle(Left + 12, 360, 224, 28) Then
        Call ResetAll()
    End If

    Return Result

End Function

Sub DrawPartyOverlay()

    Dim Left As Number
    Dim Acting As Text
    Dim AttackSequence As Text

    Left = 12
    Acting = "Arin"

    If PartyTurn = 1 Then
        Acting = "Orin"
    Else If PartyTurn = 2 Then
        Acting = "Dragon"
    End If

    AttackSequence = "Sword Attack"

    If PartyTurn = 1 Then

        AttackSequence = "Thor Attack"

    Else If PartyTurn = 2 Then

        If DragonCounter Mod 3 = 0 Then
            AttackSequence = "Fire Breath"
        Else If DragonCounter Mod 3 = 1 Then
            AttackSequence = "Claw Strike"
        Else
            AttackSequence = "Fireball"
        End If

    End If

    If UiVisibility = 0 Then

        Call UI.DrawPanel(Left, 96, 252, Max(374, Window_Height() - 114))
        Call DrawButton(Left, 104, 76, 30, "Dragon", DragonVisible)
        Call DrawButton(Left + 82, 104, 76, 30, "Weapon", SwordVisible)
        Call DrawButton(Left + 164, 104, 76, 30, "Shield", ShieldVisible)
        Call DrawButton(Left, 140, 76, 22, "Floor/Grid", FloorVisible Or GridVisible)
        Call DrawButton(Left + 82, 140, 76, 22, "Backdrop", BackgroundIndex > 0)
        Call DrawButton(Left + 164, 140, 76, 22, "Glow", EpicGlowVisible)

        Draw Text "Party" At Left + 16, 178 Size 20 Color WHITE
        Draw Text "Arin  •  Paladin" At Left + 16, 212 Size 15 Color CYAN
        Draw Text "Orin  •  Tank" At Left + 16, 238 Size 15 Color WHITE
        Draw Text Acting + "'s Turn" At Left + 16, 272 Size 16 Color YELLOW

        If PartyStage = 1 Or PartyTurn = 2 Then
            Draw Text "Attack: " + AttackSequence At Left + 16, 296 Size 13 Color CYAN
        End If

        Call DrawButton(Left + 12, 324, 108, 28, "Pause", ScenePaused)
        Call DrawButton(Left + 128, 324, 108, 28, "Orbit", AutoOrbit)
        Call DrawButton(Left + 12, 360, 224, 28, "Restart Battle Demo", False)

        If Window_Height() >= 620 Then

            Draw Text "Edit Each Character In Its Tab" At Left + 16, 408 Size 12 Color LIGHT_GRAY
            Draw Text "Equipment Toggles Apply To Both" At Left + 16, 430 Size 12 Color LIGHT_GRAY
            Draw Text OrinStorm.Caption() At Left + 16, 446 Size 12 Color CYAN
            Draw Text "Camera" At Left + 16, 486 Size 12 Color LIGHT_GRAY
            Draw Number PartyActiveCamera At Left + 80, 486 Size 12 Color CYAN
            Draw Text "FPS" At Left + 16, 462 Size 13 Color LIGHT_GRAY
            Draw Number CurrentFramesPerSecond At Left + 62, 462 Size 13 Color GREEN

        End If

        Call DrawPartyStatusPanel()
        Call DrawCameraControls()

    End If

    Draw Text "LMB pan  •  MMB orbit  •  Wheel zoom  •  Space pause  •  RMB reset" At 18, Window_Height() - 28 Size 12 Color LIGHT_GRAY

    If ViewerError Then
        Draw Text "Party Could Not Load — Select A Character Or Press Enter To Retry" At 18, 112 Size 16 Color YELLOW
        Draw Number FirstFailureStage At 18, 140 Size 14 Color YELLOW
    End If

End Sub
