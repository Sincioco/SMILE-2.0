Sub DrawAnimationButtons()

    Dim ClipCount As Number
    Dim Index As Number
    Dim Column As Number
    Dim Row As Number
    Dim ButtonX As Number
    Dim ButtonY As Number

    ClipCount = ViewerProfiles.ClipCount(Session.ProfileIndex)

    For Index = 0 To ClipCount - 1

        Column = Index Mod ANIMATION_BUTTON_COLUMN_COUNT
        Row = Index / ANIMATION_BUTTON_COLUMN_COUNT
        ButtonX = AnimationButtonX() + Column * (ANIMATION_BUTTON_WIDTH + ANIMATION_BUTTON_COLUMN_GAP)
        ButtonY = ANIMATION_BUTTON_Y + Row * (ANIMATION_BUTTON_HEIGHT + ANIMATION_BUTTON_ROW_GAP)

        Call DrawButton(
            ButtonX,
            ButtonY,
            ANIMATION_BUTTON_WIDTH,
            ANIMATION_BUTTON_HEIGHT,
            ViewerProfiles.ClipLabel(Session.ProfileIndex, Index),
            Playback.SelectedClip = RuntimeClipForPresentationIndex(Index)
        )
    End For

End Sub

Function AnimationSecondsRemaining() As Number

    Dim RequiredMilliseconds As Number
    Dim RemainingMilliseconds As Number
    Dim Result As Number

    If PartyMode Then

        RequiredMilliseconds = PartyAttackDuration() + 4000

        If PartyTurn = 2 Then
            RequiredMilliseconds = DragonTurnDuration()
        End If

        RemainingMilliseconds = Max(0, RequiredMilliseconds - PartyElapsed)
        Result = (RemainingMilliseconds + 999) / 1000

    Else If Playback.DemoEnabled Then

        RequiredMilliseconds = ViewerPlayback.DemoRequiredLoops(
            Character, Playback.SelectedClip, Playback.PlaybackSpeed,
            Session.ProfileIndex, ANIMATION_CYCLE_MILLISECONDS
        ) * ViewerPlayback.DemoLoopDuration(
            Character, Playback.SelectedClip, Playback.PlaybackSpeed
        )

        If (ViewerPlayback.ClipMode(Session.ProfileIndex, SelectedClipName()) =
            Graphics3D.ANIMATION_ONCE) Then
            RequiredMilliseconds = Max(
                ViewerPlayback.DemoTarget(Session.ProfileIndex, ANIMATION_CYCLE_MILLISECONDS),
                ViewerPlayback.DemoLoopDuration(
                    Character, Playback.SelectedClip, Playback.PlaybackSpeed
                )
            )
        End If

        RemainingMilliseconds = Max(0, RequiredMilliseconds - Playback.AnimationCycleElapsed)
        Result = (RemainingMilliseconds + 999) / 1000

    Else
        Result = 0

    End If

    Return Result

End Function

