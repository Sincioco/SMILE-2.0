Const ANIMATION_BUTTON_HEIGHT = 18
Const ANIMATION_BUTTON_COLUMN_GAP = 8
Const ANIMATION_BUTTON_COLUMN_COUNT = 3
Const ANIMATION_BUTTON_ROW_GAP = 4
Const MINIMUM_VIEWER_WIDTH = 800
Const MINIMUM_VIEWER_HEIGHT = 540
Const ORBIT_POINTER_DIVISOR = 1
Const PAN_POINTER_DIVISOR = 3
Const DEFAULT_ZOOM_DEGREES = -16
Const ZOOM_IN_LIMIT = -144
Const CLOSE_UP_ZOOM_START = -48
Const CLOSE_UP_MINIMUM_DISTANCE_1000 = 100
Const ZOOM_OUT_LIMIT = 36
Const MAX_RAW_FRAME_MILLISECONDS = 60000
Const MAX_ANIMATION_ELAPSED = 250
Const MAX_CAMERA_ELAPSED = 250
Const TIMELINE_LEFT = 18
Const TIMELINE_HEIGHT = 18
Const TIMELINE_KEYFRAME_HIT_RADIUS = 7
Const CALIBRATION_IMPORT_WIDTH = 152
Const CALIBRATION_DOWNLOAD_OFFSET = 158
Const CALIBRATION_DOWNLOAD_WIDTH = 172
Const CALIBRATION_FILENAME_OFFSET = 336
Const CALIBRATION_TRANSFER_TEXT_OFFSET = 510
Const FRAME_BUTTON_REPEAT_MILLISECONDS = 300
Const EQUIPMENT_TRAIL_POINT_COUNT = 5
Const EQUIPMENT_TRAIL_SAMPLE_MILLISECONDS = 24
Const SWORD_TRAIL_START_MILLISECONDS = 300
Const SWORD_TRAIL_END_MILLISECONDS = 967
Const SHIELD_TRAIL_START_MILLISECONDS = 350
Const SHIELD_TRAIL_END_MILLISECONDS = 650
Const SHIELD_PART_INDEX = 0
Const WEAPON_PART_INDEX = 1
Const BODY_PART_INDEX = 2
Const EQUIPMENT_GLOW_SCALE_DIVISOR = 60
Const SWORD_TRAIL_PARTICLE_SIZE = 3
Const SHIELD_TRAIL_PARTICLE_SIZE = 5
Const DRAGON_ASSET_PATH = "Assets\Generation2\RedDragon\RedDragon.sm3d"
Const DRAGON_SCALE_PERCENT = 25000
Const DRAGON_POSITION_X = -208
Const DRAGON_POSITION_Z = -120
Const DRAGON_ROTATION_Y = 240
Const CHARACTER_MODEL_FORWARD_YAW_OFFSET = 180
Const ORIN_ARENA_YAW_ADJUSTMENT = -55
Const ARENA_INITIAL_ORBIT_YAW = 0
Const ARENA_ORBIT_DEGREES_PER_SECOND = 12
Const ARENA_CAMERA_DISTANCE = 480
Const ARENA_CAMERA_HEIGHT = 180
Const ARENA_CAMERA_CENTER_X = -70
Const ARENA_CAMERA_CENTER_Z = -45
Const ARENA_DEFAULT_ZOOM_DEGREES = -15
Const ARENA_FLOOR_WIDTH = 1000
Const ARENA_FLOOR_DEPTH = 1000
Const DRAGON_CAMERA_CHEST_HEIGHT = 70
Const DRAGON_CAMERA_HEAD_HEIGHT = 115
Const DRAGON_CAMERA_MOUTH_HEIGHT = 100
Const DRAGON_CAMERA_ANCHOR_MAXIMUM_DELTA = 500
Const CALIBRATION_MAX_CLIPS = ViewerCalibration.MAX_CLIPS
Const CALIBRATION_CHANNEL_COUNT = ViewerCalibration.CHANNEL_COUNT
Const CALIBRATION_TARGET_SWORD_WRIST = 0
Const CALIBRATION_TARGET_SHIELD_WRIST = 1
Const CALIBRATION_TARGET_SWORD = 2
Const CALIBRATION_TARGET_SHIELD = 3
Const CALIBRATION_AXIS_X = 0
Const CALIBRATION_AXIS_Y = 1
Const CALIBRATION_AXIS_Z = 2
Const CALIBRATION_AXIS_COUNT = ViewerCalibration.AXIS_COUNT
Const CALIBRATION_TRANSFORM_ROTATE = 0
Const CALIBRATION_TRANSFORM_MOVE = 1
Const TRANSFORM_GIZMO_RING_SEGMENTS = 128
Const TRANSFORM_GIZMO_HIT_RADIUS = 12
Const TRANSFORM_GIZMO_MOVE_DIVISOR = 3
Const TRANSFORM_GIZMO_ROTATE_DIVISOR = 1000
Const CALIBRATION_MINIMUM_DEGREES = -180
Const CALIBRATION_MAXIMUM_DEGREES = 180
Const CALIBRATION_MINIMUM_POSITION = -100
Const CALIBRATION_MAXIMUM_POSITION = 100
Const CALIBRATION_PANEL_X = 18
Const CALIBRATION_PANEL_Y = 92
Const CALIBRATION_PANEL_WIDTH = 430
Const CALIBRATION_PANEL_HEIGHT = 354
Const CALIBRATION_SLIDER_X = 34
Const CALIBRATION_SLIDER_Y = 204
Const CALIBRATION_SLIDER_WIDTH = 360
Const CALIBRATION_SLIDER_HEIGHT = 20
Const CAMERA_SLIDER_WIDTH = 146
Const CAMERA_SLIDER_HEIGHT = 16
Const CAMERA_SLIDER_NONE = 0
Const CAMERA_SLIDER_HORIZONTAL_ORBIT = 1
Const CAMERA_SLIDER_VERTICAL_ORBIT = 2
Const CAMERA_SLIDER_ZOOM = 3
Const BACKGROUND_COUNT = 5
Const BACKDROP_LANDSCAPE_PATH = "Assets\Backgrounds\SinStarLandscape.png"
Const BACKDROP_TITLE_PATH = "Assets\Backgrounds\SinStarTitleWithLogo.png"
Const PARTY_STATE_ALIVE = 0
Const PARTY_STATE_ACTING = 1
Const PARTY_STATE_GUARDING = 2
Const PARTY_STATE_HIT = 3
Const PARTY_STATE_KO = 4
Const PARTY_STATE_REVIVING = 5
Const PARTY_FORMATION_MEMBER_CAPACITY = 3
Const PARTY_FORMATION_RADIUS = 300
Const PARTY_FORMATION_START_ANGLE = 10
Const PARTY_FORMATION_END_ANGLE = 50

Type ViewerActorContext
    Actor As Character3D.Actor
    Frame As CharacterViewer.Framing
    Profile As Number
    Clip As Number
    KeyBase As Number
    WeaponWrist As Number
    ShieldWrist As Number
    WeaponGlow As Core.Object3D
    ShieldGlow As Core.Object3D
    CalibrationAvailable As Boolean
    GlowAvailable As Boolean
    GlowVisible As Boolean
    PresentationState As Number
End Type

Type PartyParticipantLayout
    Home As Core.Vector3
    Approach As Core.Vector3
    FacingAdjustment As Number
End Type

Dim DragonOpponent As ViewerActorContext
Dim PartyMode As Boolean
Dim PartyCompanion As ViewerActorContext
Dim PartyElapsed As Number
Dim PartyTurn As Number
Dim PartyAttackCycle As Number
Dim PartyDragonOnlyTurn As Boolean
Dim PartyPreviousShotStage As Number
Dim PartyFatalTarget As Number
Dim PartyFatalStarted As Boolean
Dim PartyHitTarget As Number
Dim PartyHitResolved As Boolean
Dim PartyParticipants[PARTY_FORMATION_MEMBER_CAPACITY] As PartyParticipantLayout
Dim PartyParticipantCount As Number
Dim PartyStage As Number
Dim PartyReady As Boolean
Dim PartyUiBound As Boolean
Dim PartyUiPrimary As ViewerActorContext
Dim PartyUiTurn As Number
Dim PartyPreviewActive As Boolean
Dim PartyPreviewClip As Number
Dim PartyPreviewTime As Number
Dim PartyPreviewMode As Number
Dim PresentationState As Number
Dim Character As Character3D.Actor
Dim CharacterBounds As Character3D.Bounds3D
Dim LocalCharacterBounds As Character3D.Bounds3D
Dim ActiveProfile As CharacterViewer.Profile
Dim Arena As Arena3D.ArenaFloor
Dim FloorVisible As Boolean
Dim GridVisible As Boolean
Dim SocketGizmos[4] As Core.Object3D
Dim SocketGizmoCount As Number
Dim SocketGizmosVisible As Boolean
Dim SocketMarkers As Core.ParticleBatch3D
Dim SocketMarkerMaterial As Core.Material3D
Dim SelectedSocket As Number
Dim ShowAllSocketOrigins As Boolean
Dim EpicGlowAvailable As Boolean
Dim EpicGlowVisible As Boolean
Dim EpicGlowTexture As Core.Texture3D
Dim EpicGlowMaterial As Core.Material3D
Dim EpicGlowParticleMaterial As Core.Material3D
Dim SwordGlow As Core.Object3D
Dim ShieldGlow As Core.Object3D
Dim SwordFire As Fire.FireEmitter
Dim SwordFireReady As Boolean
Dim SwordFireVisible As Boolean
Dim SwordFireFailed As Boolean
Dim SwordFireClip As Number
Dim SwordFireTime As Number
Dim SwordFireBase As Core.Vector3
Dim SwordFireTip As Core.Vector3
Dim ShieldFire[3] As Fire.FireEmitter
Dim ShieldFirePoints[3] As Core.Vector3
Dim ShieldFireVisible As Boolean
Dim ShieldFlameStyle As Boolean
Dim ShieldFireFailed As Boolean
Dim ShieldFireClip As Number
Dim ShieldFireTime As Number
Dim FlameAnimationPaused As Boolean
Dim LightningAnimationPaused As Boolean
Dim FlamesWerePaused As Boolean
Dim VisualContinuityEpoch As Number
Dim EquipmentFireEpoch As Number
Dim DragonFireEpoch As Number
Dim DragonFireClip As Text
Dim DragonFireTime As Number
Dim DragonFireWasPaused As Boolean
Dim VisualHistoryDirty As Boolean
Dim EquipmentFireFirstSample As Boolean
Dim EquipmentFireFirstError As Number
Dim SwordTrail As Core.ParticleBatch3D
Dim ShieldTrail As Core.ParticleBatch3D
Dim SwordTrailPoints[EQUIPMENT_TRAIL_POINT_COUNT] As Core.Vector3
Dim ShieldTrailPoints[EQUIPMENT_TRAIL_POINT_COUNT] As Core.Vector3
Dim EquipmentTrailElapsed As Number
Dim EquipmentTrailAnimationTime As Number
Dim SwordTrailActive As Boolean
Dim ShieldTrailActive As Boolean
Dim LightingIndex As Number
Dim MaterialInspection As Number
Dim Key As Number
Dim FrameRate As ViewerTiming.FrameRateState
Dim Timing As ViewerTiming.ClockState
Dim Session As ViewerSession.State
Dim Playback As ViewerPlayback.State
Dim ViewerCameraState As ViewerCamera.State
Dim Calibration As ViewerCalibration.State
Dim ViewerInputState As ViewerInput.State
Dim ViewerUiState As ViewerUi.State
Dim ViewerGizmoState As ViewerGizmo.State
Dim PartyOrbitCamera As Core.Camera3D
Dim PartyHeroCamera As Core.Camera3D
Dim PartyDragonCamera As Core.Camera3D
Dim PartyOrbitPhase1000 As Number
Dim PartyActiveCamera As Number
Dim PartyPreviousCamera As Number
Dim PartyPreviousCameraTurn As Number
Dim PartyShotPosition1000 As Core.Vector3
Dim PartyShotTarget1000 As Core.Vector3
Dim PartyShotBoss As Core.Vector3
Dim PartyShotBossHead As Core.Vector3
Dim PartyShotMouth As Core.Vector3
Dim ArinAudio As BattleAudio.CueState
Dim DragonAudio As BattleAudio.CueState
Dim BackgroundIndex As Number
Dim BackdropLandscapeTexture As StaticBackdrop3D.Backdrop
Dim BackdropTitleTexture As StaticBackdrop3D.Backdrop
Dim BackdropAvailable As Boolean
Dim BackdropTextureIndex As Number
Dim Dragon As Character3D.Actor
Dim DragonHeadAim As NodeAim3D.Constraint
Dim DragonHeadTracking As Boolean
Dim DragonClip As Text
Dim DragonCounter As Number
Dim DragonBreath As Fire.FireEmitter
Dim FireInitialized As Boolean
Dim LightningInitialized As Boolean
Dim SceneVfxClock As SceneVfx3D.Clock
Dim OrinStormContext As OrinStorm.Context
Dim OrinLight As LightPool3D.Lease
Dim DragonLight As LightPool3D.Lease
Dim DragonFireFailed As Boolean
Dim DragonReactionPending As Boolean
Dim DragonAvailable As Boolean
Dim DragonVisible As Boolean
Dim SwordVisible As Boolean
Dim ShieldVisible As Boolean
Dim CalibrationAvailable As Boolean
Dim SwordWristNode As Number
Dim ShieldWristNode As Number

Game Window "SMILE 2.0 - 3D Viewer, Animation Editor" Size 1600 By 640

Call Graphics3D.ResetRenderer3D()

Session.SelectedCharacterTab = 3
PartyMode = True
Session.ProfileIndex = ViewerProfiles.PROFILE_ARIN
BackgroundIndex = 3

Call ViewerPlayback.Reset(Playback, 100)
Call ViewerInput.Reset(ViewerInputState, Window_Activate())
Call ViewerUi.Reset(ViewerUiState)
Call ViewerGizmo.Reset(ViewerGizmoState)

Call LoadViewer()
Call ViewerSession.CaptureFailure(Session, 20)

Session.WindowActivated = ViewerInputState.WindowActivated

Session.Running = True

Call ViewerTiming.Start(Timing, Timer())

Do

    If ViewerInput.UpdateActivation(ViewerInputState, Window_Activate()) Then
        Call CancelInteractionCaptures()
    End If

    Session.WindowActivated = ViewerInputState.WindowActivated

    Get Key Key

    Call HandleKeyboard(Key)

    Call ViewerSession.CaptureFailure(Session, 21)

    ViewerInputState.InterfaceBlocked = HandleInterfacePointer()

    Call ViewerSession.CaptureFailure(Session, 22)

    Call UpdateCameraPointer(ViewerInputState.InterfaceBlocked)

    Call ViewerSession.CaptureFailure(Session, 23)

    Session.Ready = ViewerTiming.AdvanceClock(
        Timing,
        Timer(),
        MAX_ANIMATION_ELAPSED,
        MAX_CAMERA_ELAPSED,
        MAX_RAW_FRAME_MILLISECONDS
    ) And Session.Ready

    Call ViewerSession.CaptureFailure(Session, 24)

    Call ViewerTiming.Advance(FrameRate, Timing.RawFrameMilliseconds)

    If Not Session.ViewerError Then

        If Not Playback.ScenePaused Then
            Call AdvanceAnimationSequence()

            Call ViewerSession.CaptureFailure(Session, 2)
        End If

        Call ViewerPlayback.ResolveAnimationElapsed(Playback, Timing.AnimationElapsed)

        If PartyMode Then
            Call AdvancePartyDemo()
        End If

        Session.Ready = Character3D.Update(Character, Playback.AnimationUpdateElapsed) And Session.Ready

        Call ViewerSession.CaptureFailure(Session, 3)
        Call ApplyCharacterPresentationOffset()

        If CalibrationAvailable Then

            Call UpdateCalibrationForCurrentFrame()
            Call ApplyWristCalibration()
            Call ApplyEquipmentCoupling()
            Call ViewerSession.CaptureFailure(Session, 4)

        End If

        Session.Ready = ViewerCamera.AdvanceZoom(
            ViewerCameraState, Timing.CameraElapsed) And Session.Ready

        Call ViewerSession.CaptureFailure(Session, 5)

        If Not Playback.ScenePaused Then
            Session.Ready = ViewerCamera.AdvanceAutoOrbit(
                ViewerCameraState,
                PartyOrbitPhase1000,
                Timing.CameraElapsed,
                ARENA_ORBIT_DEGREES_PER_SECOND,
                PartyMode
            ) And Session.Ready

            Call ViewerSession.CaptureFailure(Session, 6)
        End If

        Call ViewerCamera.UpdateResponsiveFit(
            ViewerCameraState,
            ActiveProfile,
            LocalCharacterBounds,
            Window_Width(),
            Window_Height(),
            Max(1, Window_Width() - 284),
            DragonAvailable,
            ARENA_CAMERA_CENTER_X,
            ARENA_CAMERA_CENTER_Z,
            ARENA_CAMERA_DISTANCE,
            ARENA_CAMERA_HEIGHT
        )

        Call ViewerCamera.Compose(
            ViewerCameraState, PartyMode And ViewerCameraState.AutoOrbit)

        Call ViewerCamera.ApplyCloseUp(ViewerCameraState, CLOSE_UP_ZOOM_START,
            ZOOM_IN_LIMIT, CLOSE_UP_MINIMUM_DISTANCE_1000)
        Call ViewerCamera.ApplyCalibrationOrbitAnchor(
            ViewerCameraState, Window_Width(), Window_Height())

        If EpicGlowVisible Then

            If Not UpdateEpicGlow() Then
                EpicGlowVisible = False
            End If

        End If

        If CalibrationAvailable Then
            Call ApplyEquipmentCalibration()

            Call ViewerSession.CaptureFailure(Session, 7)
        End If

        Call UpdateEquipmentFire()

        If PartyMode Or Session.DragonInspection Then
            Call UpdatePartyCompanion()
        End If

        If Session.DragonInspection Then
            Call UpdateDragonOpponent()
        End If

        Call UpdateDragon()
        Call ApplyPartyAttackCamera()

        If FloorVisible Then
            Call ViewerCamera.KeepAboveGround(ViewerCameraState, 0)
        End If

        Call UpdateBattleAudio()
        Call UpdateOrinStorm()
        Call AdvanceSceneVfx()

        If SocketGizmosVisible Then
            Call UpdateSocketGizmos()
        End If

        If Character3D.IsValid(Character) Then
            CharacterBounds = Character3D.WorldBounds(Character, ActiveProfile.AnimationMargin)
        End If

        Session.Ready = BeginViewerScene() And Session.Ready

        Call ViewerSession.CaptureFailure(Session, 8)

        If Session.Ready Then

            If FloorVisible Then
                Session.Ready = Arena3D.Draw(Arena, True, False)

                Call ViewerSession.CaptureFailure(Session, 9)
            End If

            If GridVisible Then
                Session.Ready = DrawStudioGrid() And Session.Ready

                Call ViewerSession.CaptureFailure(Session, 10)
            End If

            If DragonVisible And Not Session.DragonInspection Then
                Session.Ready = DrawDragon() And Session.Ready

                Call ViewerSession.CaptureFailure(Session, 11)
            End If

            If EpicGlowVisible Then

                If ((Not PartyMode Or PartyPresentationState(0) <> PARTY_STATE_KO) And
                    Not DrawEquipmentGlow()) Then
                    EpicGlowVisible = False
                End If

            End If

            Session.Ready = Character3D.Draw(Character) And Session.Ready

            If (PartyMode Or Session.DragonInspection) And PartyReady Then
                Session.Ready = DrawPartyCompanion() And Session.Ready
            End If

            If Session.DragonInspection Then
                Session.Ready = DrawDragonOpponent() And Session.Ready
            End If

            Call ViewerSession.CaptureFailure(Session, 12)

            If (SwordVisible And
                SwordFireVisible And
                SwordFire.Slot <> 0 And
                Not SwordFireFailed) Then
                SwordFireFailed = Not Fire.Draw(SwordFire)
            End If

            Call DrawShieldFire()
            Call OrinStorm.Draw(OrinStormContext)

            Session.Ready = SceneVfx3D.DrawLightning(LightningInitialized) And Session.Ready

            Call DragonPresence.Draw()

            If DragonVisible And DragonBreath.Slot <> 0 Then
                DragonFireFailed = Not Fire.Draw(DragonBreath)
            End If

            If EpicGlowVisible Then

                If Not DrawEpicGlow() Then
                    EpicGlowVisible = False
                End If

            End If

            If SocketGizmosVisible Then
                Session.Ready = DrawSocketGizmos() And Session.Ready
            End If

            Session.Ready = Scene3D.EndScene() And Session.Ready

            Call ViewerSession.CaptureFailure(Session, 13)

        End If

        If Not Session.Ready Then
            Call ViewerSession.RecordError(Session)
        End If

    End If

    Call OrinStorm.DrawFlash(OrinStormContext)
    Call DrawViewerOverlay()

    Show Screen

    Session.Running = Session.Running And Not Game_Closed()

Loop Until Not Session.Running

Call DestroyViewer()

Sub LoadViewer()

    Session.Ready = Scene3D.SetQuality(Scene3D.QUALITY_HIGH)
    Session.Ready = Character3D.SetUnusedAssetCacheLimit(3) And Session.Ready

    PartyUiBound = False
    PartyPreviewActive = False

    ActiveProfile = ViewerProfiles.ProfileAt(Session.ProfileIndex)
    Calibration.KeyBase = 0

    If Session.ProfileIndex = ViewerProfiles.PROFILE_ORIN Then
        Calibration.KeyBase = CALIBRATION_MAX_CLIPS
    End If

    DragonAvailable = ViewerProfiles.IsPartyCharacter(Session.ProfileIndex) Or Session.DragonInspection
    DragonVisible = DragonAvailable
    SwordVisible = True
    ShieldVisible = True
    Session.Ready = CharacterViewer.ValidateProfile(ActiveProfile) And Session.Ready
    Session.Ready = Window_Title(ViewerTitle()) And Session.Ready

    Call ViewerSession.CaptureFailure(Session, 30)

    Character = Character3D.LoadWithPolicy(
        ActiveProfile.AssetPath,
        Character3D.CHARACTER_LOAD_REQUIRE_PBR
    )
    Session.Ready = Character3D.IsValid(Character) And Session.Ready

    Call ViewerSession.CaptureFailure(Session, 31)

    Session.Ready = ValidateLoadedProfile() And Session.Ready

    Call ViewerSession.CaptureFailure(Session, 32)

    LocalCharacterBounds = Character3D.LocalBounds(Character)
    ViewerCameraState.Base = Graphics3D.DefaultCamera()
    ViewerCameraState.Frame = CharacterViewer.AutoFit(
        ActiveProfile,
        LocalCharacterBounds,
        Max(1, Window_Width() - 284),
        Max(1, Window_Height()),
        ViewerCameraState.Base.FovDegrees
    )
    Session.Ready = ViewerCameraState.Frame.Valid And Session.Ready

    If Session.DragonInspection Then

        ViewerCameraState.Frame.ScalePercent = DRAGON_SCALE_PERCENT
        ViewerCameraState.Frame.PositionX = DRAGON_POSITION_X
        ViewerCameraState.Frame.PositionY = 0
        ViewerCameraState.Frame.PositionZ = DRAGON_POSITION_Z

    End If

    Call ViewerSession.CaptureFailure(Session, 33)

    Call ViewerCamera.SetBaseFromFrame(
        ViewerCameraState,
        DragonAvailable,
        ARENA_CAMERA_CENTER_X,
        ARENA_CAMERA_CENTER_Z,
        ARENA_CAMERA_DISTANCE,
        ARENA_CAMERA_HEIGHT
    )

    Call CreateBackdrop()
    Call CreateStudioGrid()

    Call ViewerSession.CaptureFailure(Session, 34)

    FloorVisible = True
    GridVisible = True
    ViewerCameraState.FitLocked = True
    ViewerCameraState.LastFitWidth = Window_Width()
    ViewerCameraState.LastFitHeight = Window_Height()

    Call ViewerCamera.Reset(ViewerCameraState, 0, DefaultZoomDegrees(),
        ZOOM_IN_LIMIT, ZOOM_OUT_LIMIT, 96000)

    Session.Ready = Scene3D.SetQuality(Scene3D.QUALITY_HIGH)

    If DragonAvailable Then
        Session.Ready = Scene3D.SetShadowArea(
            DRAGON_POSITION_X / 2,
            ViewerCameraState.Frame.TargetY,
            DRAGON_POSITION_Z / 2,
            ARENA_FLOOR_WIDTH,
            ARENA_FLOOR_DEPTH,
            ViewerCameraState.Frame.ShadowNear,
            ARENA_FLOOR_DEPTH
        ) And Session.Ready
    Else
        Session.Ready = Scene3D.SetShadowArea(
            0,
            ViewerCameraState.Frame.TargetY,
            0,
            ViewerCameraState.Frame.ShadowWidth,
            ViewerCameraState.Frame.ShadowDepth,
            ViewerCameraState.Frame.ShadowNear,
            ViewerCameraState.Frame.ShadowFar
        ) And Session.Ready
    End If

    Call ViewerSession.CaptureFailure(Session, 35)

    Call ApplyLighting()

    Session.Ready = Character3D.SetScale(Character, ViewerCameraState.Frame.ScalePercent) And Session.Ready
    Session.Ready = Character3D.Place(
        Character,
        ViewerCameraState.Frame.PositionX,
        ViewerCameraState.Frame.PositionY,
        ViewerCameraState.Frame.PositionZ
    ) And Session.Ready

    Call ApplyArenaFacing()

    Session.Ready = Character3D.SetShadows(Character, True, True) And Session.Ready

    Call ViewerSession.CaptureFailure(Session, 36)

    SocketGizmosVisible = False

    Call CreateDragon()

    Call ViewerSession.CaptureFailure(Session, 37)

    Call CreateSocketGizmos()

    Call ViewerSession.CaptureFailure(Session, 38)

    Call CreateEpicGlow()

    Call ViewerSession.CaptureFailure(Session, 39)

    Call ConfigureCalibration()

    Call ViewerSession.CaptureFailure(Session, 40)

    Playback.PlaybackSpeed = ActiveProfile.DefaultPlaybackSpeed
    MaterialInspection = Graphics3D.MATERIAL_INSPECTION_LIT
    Session.Ready = Graphics3D.SetMaterialInspection3D(MaterialInspection) And Session.Ready

    Call ViewerSession.CaptureFailure(Session, 41)

    Call RestartPresentation()

    Call ViewerSession.CaptureFailure(Session, 42)

    SwordFireVisible = True
    ShieldFireVisible = True
    FlameAnimationPaused = False
    LightningAnimationPaused = False
    ShieldFireFailed = False
    SwordFireFailed = False
    SwordFireReady = False

    FireInitialized = False
    LightningInitialized = False

    Call SceneVfx3D.Initialize(SceneVfxClock)

    Session.Ready = LightPool3D.Initialize(2, 2) And Session.Ready
    OrinLight = LightPool3D.Acquire()
    DragonLight = LightPool3D.Acquire()
    Session.Ready = LightPool3D.IsValid(OrinLight) And LightPool3D.IsValid(DragonLight) And Session.Ready

    If DragonAvailable Then
        FireInitialized = Fire.Initialize("Assets/Fire")

        Call DragonPresence.Initialize()
    End If

    If CalibrationAvailable And Session.ProfileIndex = ViewerProfiles.PROFILE_ARIN Then
        SwordFireReady = FireInitialized
        SwordFireFailed = Not SwordFireReady
    End If

    If SwordFireReady Then
        SwordFireReady = Graphics3D.ConfigureSoftDepth3D(1)
        SwordFireReady = Graphics3D.ConfigureDistortion3D(1, 2) And SwordFireReady
    End If

    If PartyMode Then
        Call CreatePartyCompanion()
    End If

    If Session.DragonInspection Then

        Call CreatePartyCompanion(ViewerProfiles.PROFILE_ARIN)

        DragonOpponent = PartyCompanion

        Call CreatePartyCompanion()
        Call PositionDragonOpponents()

        SwordFireReady = FireInitialized

    End If

    If (PartyMode Or
        Session.DragonInspection Or
        Session.ProfileIndex = ViewerProfiles.PROFILE_ORIN) Then

        LightningInitialized = Lightning.Initialize("Assets/Lightning", 8192,
            Graphics3D.GPU_PARTICLE_SIMULATION_AUTO, 4096)

        Call OrinStorm.Prepare(LightningInitialized)

        OrinStormContext = OrinStorm.Create()
        Session.Ready = LightningInitialized And OrinStorm.IsValid(OrinStormContext) And Session.Ready

    End If

    Session.ViewerEpoch = Graphics3D.ResourceEpoch3D()

    If Not Session.Ready Then
        Call ViewerSession.RecordError(Session)
    End If

End Sub

Function ValidateLoadedProfile() As Boolean

    Dim Result As Boolean
    Dim Index As Number

    Result = Character3D.IsValid(Character)
    Result = Character3D.ClipCount(Character) = ActiveProfile.ExpectedClipCount And Result
    Result = Character3D.SocketCount(Character) = ActiveProfile.ExpectedSocketCount And Result

    For Index = 0 To ViewerProfiles.ClipCount(Session.ProfileIndex) - 1
        Result = Character3D.HasClip(
            Character,
            ViewerProfiles.ClipName(Session.ProfileIndex, Index)
        ) And Result
    End For

    For Index = 0 To ViewerProfiles.SocketCount(Session.ProfileIndex) - 1
        Result = Character3D.HasSocket(
            Character,
            ViewerProfiles.SocketName(Session.ProfileIndex, Index)
        ) And Result
    End For

    Return Result

End Function

Function ViewerFloorWidth() As Number

    Dim Result As Number

    Result = ViewerCameraState.Frame.FloorWidth

    If DragonAvailable Then
        Result = Max(Result, ARENA_FLOOR_WIDTH)
    End If

    Return Result

End Function

Function ViewerFloorDepth() As Number

    Dim Result As Number

    Result = ViewerCameraState.Frame.FloorDepth

    If DragonAvailable Then
        Result = Max(Result, ARENA_FLOOR_DEPTH)
    End If

    Return Result

End Function

Function InitialViewerOrbitYaw() As Number

    Dim Result As Number

    If DragonAvailable Then
        Result = ARENA_INITIAL_ORBIT_YAW
    Else
        Result = ViewerProfiles.InitialOrbitYaw(Session.ProfileIndex)
    End If

    Return Result

End Function

Function DefaultZoomDegrees() As Number

    Dim Result As Number

    If DragonAvailable Then
        Result = ARENA_DEFAULT_ZOOM_DEGREES
    Else
        Result = DEFAULT_ZOOM_DEGREES
    End If

    Return Result

End Function

Sub ApplyArenaFacing()

    If Session.DragonInspection Then
        Session.Ready = Character3D.Rotate(Character, 0, DRAGON_ROTATION_Y, 0) And Session.Ready
    Else If DragonAvailable Then
        Session.Ready = FaceDragon(Character, CharacterArenaYawAdjustment()) And Session.Ready
    Else
        Session.Ready = Character3D.Rotate(Character, 0, 0, 0) And Session.Ready
    End If

End Sub

Function CharacterArenaYawAdjustment() As Number

    Dim Result As Number

    If Session.ProfileIndex = ViewerProfiles.PROFILE_ORIN Then
        Result = ORIN_ARENA_YAW_ADJUSTMENT
    End If

    Return Result

End Function

Function FaceDragon(
    ByRef Value As Character3D.Actor,
    YawAdjustment As Number
) As Boolean

    Dim DragonYaw As Number
    Dim Result As Boolean

    Result = Character3D.LookAt(Value, DRAGON_POSITION_X, 0, DRAGON_POSITION_Z)

    If Result Then

        DragonYaw = Character3D.RotationY(Value) + CHARACTER_MODEL_FORWARD_YAW_OFFSET
        DragonYaw = DragonYaw + YawAdjustment
        Result = Character3D.Rotate(Value, 0, DragonYaw, 0)

    End If

    Return Result

End Function

Sub ApplyCharacterPresentationOffset()

    Dim Offset1000 As Number
    Dim OffsetY As Number

    If Not Character3D.IsValid(Character) Then
        Return
    End If

    If Session.ProfileIndex = ViewerProfiles.PROFILE_DRAGON Then
        Return
    End If

    Offset1000 = ViewerProfiles.ClipVerticalOffset1000(
        Session.ProfileIndex,
        SelectedClipName(),
        CurrentAnimationFrame()
    )
    OffsetY = Offset1000 * ViewerCameraState.Frame.ScalePercent / 100000
    Session.Ready = Character3D.Place(
        Character,
        ViewerCameraState.Frame.PositionX,
        ViewerCameraState.Frame.PositionY + OffsetY,
        ViewerCameraState.Frame.PositionZ
    ) And Session.Ready

End Sub

Sub CreateDragon()

    Dim DragonReady As Boolean

    If Not DragonAvailable Then
        Return
    End If

    If Session.DragonInspection Then
        Dragon = Character
    Else
        Dragon = Character3D.LoadWithPolicy(DRAGON_ASSET_PATH, Character3D.CHARACTER_LOAD_REQUIRE_PBR)
    End If

    DragonReady = Character3D.IsValid(Dragon)
    DragonFireFailed = False
    DragonClip = "Idle"
    DragonHeadTracking = True

    If DragonReady Then

        DragonReady = Character3D.SetScale(Dragon, DRAGON_SCALE_PERCENT) And DragonReady
        DragonReady = Character3D.Place(Dragon, DRAGON_POSITION_X, 0, DRAGON_POSITION_Z) And DragonReady
        DragonReady = Character3D.Rotate(Dragon, 0, DRAGON_ROTATION_Y, 0) And DragonReady
        DragonReady = Character3D.PlayAnimation(Dragon, DragonClip, True) And DragonReady
        DragonReady = NodeAim3D.Configure(DragonHeadAim, Dragon, "Head",
            Math3D.Vector(0, 1, 0), Math3D.Vector(35, 0, 45)) And DragonReady

    End If

    If Not DragonReady Then
        Session.Ready = False

        Call DestroyDragon()
    End If

End Sub

Function DrawDragon() As Boolean

    Dim Result As Boolean

    Result = DragonAvailable And Character3D.IsValid(Dragon)

    If Result Then
        Result = Character3D.Draw(Dragon)
    End If

    Return Result

End Function

Sub DestroyDragon()

    Call ClearDragonOwnedEffects()

    If Session.DragonInspection Then
        Dragon.Handle = 0
    Else

        Call Character3D.Destroy(Dragon)
    End If

End Sub

Sub ClearDragonOwnedEffects()

    Dim Ok As Boolean

    If DragonBreath.Slot <> 0 Then
        Ok = Fire.Destroy(DragonBreath)
    End If

    Call DragonPresence.Cancel(DragonLight)

End Sub

Sub UpdateDragon()

    Dim Name As Text
    Dim Mouth As Core.Vector3
    Dim Target As Core.Vector3
    Dim Direction As Core.Vector3
    Dim Time As Number
    Dim Travel1000 As Number
    Dim Breathe As Boolean
    Dim Ok As Boolean

    If Not DragonAvailable Or Not Character3D.IsValid(Dragon) Then
        Call ClearDragonOwnedEffects()

        Return
    End If

    If Not DragonVisible Then
        Call ClearDragonOwnedEffects()

        Return
    End If

    Name = "Idle"

    If PartyMode And Playback.ScenePaused Then

        Name = DragonClip

    Else If Session.DragonInspection Then

        Name = SelectedClipName()

    Else If PartyMode And PartyTurn = 2 Then

        If DragonCounter Mod 3 = 0 Then
            Name = "FireBreath"
        Else If DragonCounter Mod 3 = 1 Then
            Name = "ClawStrike"
        Else
            Name = "Fireball"
        End If

    Else If (PartyMode And
        DragonReactionPending And
        PartyStage = 1 And
        PartyElapsed >= 1300 + PartyAttackDuration() * 64 / 100) Then

        Name = "Hit"
        DragonReactionPending = False

    Else If DragonClip = "Hit" And Character3D.AnimationTime(Dragon) < 800 Then

        Name = "Hit"

    End If

    If Name <> DragonClip Then

        DragonClip = Name

        If Session.DragonInspection Then

            ''' The shared inspector already selected playback mode and timeline time.

        Else If Name = "Idle" Then

            Session.Ready = Character3D.PlayMode(Dragon, Name, Graphics3D.ANIMATION_LOOP, Playback.PlaybackSpeed) And Session.Ready

        Else
            Session.Ready = Character3D.PlayMode(Dragon, Name, Graphics3D.ANIMATION_ONCE, Playback.PlaybackSpeed) And Session.Ready

        End If

    End If

    If Not Session.DragonInspection Then
        Session.Ready = Character3D.Update(Dragon, Playback.AnimationUpdateElapsed) And Session.Ready
    End If

    Time = Character3D.AnimationTime(Dragon)
    Travel1000 = 0

    If Name = "ClawStrike" Then

        Travel1000 = Min(1000, Time * 1000 / 1100)

        If Time > 1100 Then
            Travel1000 = Max(0, (2200 - Time) * 1000 / 1100)
        End If

        Travel1000 = Travel1000 * Travel1000 / 1000 * (3000 - 2 * Travel1000) / 1000

    End If

    Session.Ready = Character3D.Place(Dragon,
        DRAGON_POSITION_X + 79 * Travel1000 / 1000, 0,
        DRAGON_POSITION_Z + 30 * Travel1000 / 1000) And Session.Ready

    If Session.DragonInspection Then

        Target = Character3D.SocketPosition(DragonOpponent.Actor, "Chest", BODY_PART_INDEX)

        If PartyReady And DragonCounter Mod 2 = 1 Then
            Target = Character3D.SocketPosition(PartyCompanion.Actor, "Chest", BODY_PART_INDEX)
        End If

    Else If (PartyMode And
        PartyReady And
        PartyHitTarget = 1) Then

        Target = Character3D.SocketPosition(PartyCompanion.Actor, "Chest", BODY_PART_INDEX)

    Else
        Target = Character3D.SocketPosition(Character, "Chest", BODY_PART_INDEX)

    End If

    ''' Head and child mouth/eyes follow the same target before attack VFX starts.
    Session.Ready = NodeAim3D.Update(DragonHeadAim, Dragon, Target, Playback.AnimationUpdateElapsed,
        DragonHeadTracking And (Name = "FireBreath" Or Name = "Fireball" Or Name = "ClawStrike")) And Session.Ready

    ''' Explicit seeks/cuts outrank freeze; normal frozen playback retains its snapshot.
    ''' Resume from a different action/time rebases impact cues instead of replaying them.

    If (DragonFireEpoch <> VisualContinuityEpoch Or
        (FlameAnimationPaused And Name <> DragonFireClip) Or
        (DragonFireWasPaused And Not FlameAnimationPaused And
            (Name <> DragonFireClip Or Time <> DragonFireTime))) Then
        Call ClearDragonOwnedEffects()
    End If

    DragonFireEpoch = VisualContinuityEpoch
    DragonFireClip = Name

    If FlameAnimationPaused Then
        DragonFireWasPaused = True
        Return
    End If

    DragonFireWasPaused = False
    DragonFireTime = Time
    Breathe = (DragonVisible And Name = "FireBreath" And Time >= 850 And Time < 3100)

    If (Breathe And
        FireInitialized And
        Not DragonFireFailed) Then

        Mouth = Character3D.SocketPosition(Dragon, "Mouth")

        If DragonBreath.Slot = 0 Then
            DragonBreath = Fire.StartAt("DragonFireBreathPreview", Mouth, 3117,
                Fire.QUALITY_HIGH, Fire.SIMULATION_AUTO, 6)
            DragonFireFailed = DragonBreath.Slot = 0
        End If

        If DragonBreath.Slot <> 0 Then

            Direction = Math3D.Subtract(Target, Mouth)
            Direction.X = Direction.X * 2
            Direction.Y = Direction.Y * 2
            Direction.Z = Direction.Z * 2
            Ok = Fire.SetPosition(DragonBreath, Mouth)
            Ok = Fire.SetDirection(DragonBreath, Direction) And Ok
            DragonFireFailed = Not Ok

            Call Fire.SetIntensity(DragonBreath, 160)
            Call Fire.SetSourceVelocityInheritance(DragonBreath, 0)

        End If

    Else If DragonBreath.Slot <> 0 Then

        Ok = Fire.Destroy(DragonBreath)

    End If

    Call DragonPresence.Update(Dragon, Name, Time, Target,
        DragonVisible And FireInitialized, DragonLight)

End Sub

Sub UpdateBattleAudio()

    Dim Name As Text
    Dim CueTime As Number
    Dim Audible As Boolean

    Name = SelectedClipName()
    CueTime = -1

    If Session.ProfileIndex = ViewerProfiles.PROFILE_ARIN Then

        If Name = "SwordAttack" Then
            CueTime = 280
        Else If Name = "SwordAttack2" Then
            CueTime = 160
        End If

    End If

    Audible = Not Playback.ScenePaused And Not ViewerUiState.CalibrationEditing

    If BattleAudio.CrossedCue(ArinAudio, Name,
        Character3D.AnimationTime(Character), CueTime, Audible) Then

        If Name = "SwordAttack" Then

            Play Sound "Assets/Audio/arin-flame-slash.wav"

        Else

            Play Sound "Assets/Audio/arin-flame-crosscut.wav"

        End If

    End If

    If Not DragonAvailable Or Not Character3D.IsValid(Dragon) Then
        Return
    End If

    CueTime = -1

    If DragonClip = "FireBreath" Then
        CueTime = 100
    Else If DragonClip = "ClawStrike" Then
        CueTime = 200
    End If

    If BattleAudio.CrossedCue(DragonAudio, DragonClip,
        Character3D.AnimationTime(Dragon), CueTime, Audible And DragonVisible) Then

        If DragonClip = "FireBreath" Then

            Play Sound "Assets/Audio/dragon-fire-breath.wav"

        Else

            Play Sound "Assets/Audio/dragon-claw-strike.wav"

        End If

    End If

End Sub

Sub CreateStudioGrid()

    Arena = Arena3D.Create(ViewerFloorWidth(), ViewerFloorDepth(), 24, 150, 255)
    Session.Ready = Arena.Ready And Session.Ready

End Sub

Function DrawStudioGrid() As Boolean

    Dim Result As Boolean

    Result = Arena3D.Draw(Arena, False, True)
    Return Result

End Function

Sub DestroyStudioGrid()

    Call Arena3D.Destroy(Arena)

End Sub

Sub CancelInteractionCaptures()

    If ViewerGizmoState.Dragging Then
        Call FinishTransformGizmoDrag()
    End If

    If ViewerInputState.TimelineKeyframeDragging Then
        Session.Ready = Character3D.SetAnimationTime(
            Character,
            CalibrationFrameTimeMilliseconds(
                Playback.SelectedClip,
                ViewerInputState.TimelineDraggedOriginalFrame
            )
        ) And Session.Ready
    End If

    If (ViewerInputState.TimelineScrubbing Or
        ViewerInputState.TimelineKeyframeDragging) Then
        Call RestorePartyPreview()
    End If

    Call ViewerInput.CancelCaptures(ViewerInputState)
    Call ViewerCamera.CancelPointerControls(ViewerCameraState)

End Sub

Sub HandleKeyboard(PressedKey As Number)

    If (PartyMode And
        (PressedKey = KEY_4 Or
        (PressedKey = KEY_ENTER And Not ViewerUiState.CalibrationEditing And Not ViewerGizmoState.Dragging))) Then

        If PressedKey = KEY_ENTER Then
            Call ResetPartyInspector()
        End If

        Return

    End If

    Call BeginPartyInspector()
    Call HandleInspectorKeyboard(PressedKey)
    Call EndPartyInspector()

End Sub

Sub HandleInspectorKeyboard(PressedKey As Number)

    Dim ArrowCommand As Number

    If PressedKey = KEY_BACKTICK Then

        Call ViewerUi.CycleVisibility(ViewerUiState)
        Call CancelInteractionCaptures()

        Return

    End If

    If HandleTransformGizmoKeyboard(PressedKey) Then
        Return
    End If

    If PressedKey = KEY_SPACE Then
        Call ToggleScenePause()

        Return
    End If

    If PressedKey = KEY_F Then
        Call ToggleFloorAndGrid()

        Return
    End If

    If PressedKey = KEY_D Then
        Call ToggleDragon()

        Return
    End If

    If PressedKey = KEY_W Then
        Call ToggleSword()

        Return
    End If

    If PressedKey = KEY_S Then
        Call ToggleShield()

        Return
    End If

    If ViewerUiState.CalibrationEditing Then
        Return
    End If

    If PartyMode Then

        If (PressedKey = KEY_1 Or
            PressedKey = KEY_2 Or
            PressedKey = KEY_3 Or
            PressedKey = KEY_TAB Or
            PressedKey = KEY_R) Then
            Return
        End If

    End If

    ArrowCommand = ViewerInput.ClassifyArrow(
        PressedKey,
        KEY_LEFT,
        KEY_RIGHT,
        KEY_UP,
        KEY_DOWN,
        Key_Event_Held(KEY_CONTROL)
    )

    If PressedKey = KEY_B Then

        Call CycleBackground()

    Else If ArrowCommand = ViewerInput.ARROW_FRAME_PREVIOUS Then

        Call StepAnimationFrame(-1)

    Else If ArrowCommand = ViewerInput.ARROW_FRAME_NEXT Then

        Call StepAnimationFrame(1)

    Else If ArrowCommand = ViewerInput.ARROW_PLAIN_LEFT And SocketGizmosVisible Then

        Call SelectPreviousSocket()

    Else If ArrowCommand = ViewerInput.ARROW_PLAIN_RIGHT And SocketGizmosVisible Then

        Call SelectNextSocket()

    Else If ArrowCommand = ViewerInput.ARROW_PLAIN_LEFT Then

        Session.Ready = ViewerCamera.NudgeOrbit(
            ViewerCameraState, -5, 0) And Session.Ready

    Else If ArrowCommand = ViewerInput.ARROW_PLAIN_RIGHT Then

        Session.Ready = ViewerCamera.NudgeOrbit(
            ViewerCameraState, 5, 0) And Session.Ready

    Else If ArrowCommand = ViewerInput.ARROW_PLAIN_UP Then

        Session.Ready = ViewerCamera.NudgeOrbit(
            ViewerCameraState, 0, -5) And Session.Ready

    Else If ArrowCommand = ViewerInput.ARROW_PLAIN_DOWN Then

        Session.Ready = ViewerCamera.NudgeOrbit(
            ViewerCameraState, 0, 5) And Session.Ready

    Else If PressedKey = KEY_A Then

        Session.Ready = ViewerCamera.NudgePan(
            ViewerCameraState, 5, 0) And Session.Ready

    Else If PressedKey = KEY_1 And Character3D.ClipCount(Character) > 0 Then

        Call SelectPresentationClip(0)

    Else If PressedKey = KEY_2 And Character3D.ClipCount(Character) > 1 Then

        Call SelectPresentationClip(1)

    Else If PressedKey = KEY_3 And Character3D.ClipCount(Character) > 2 Then

        Call SelectPresentationClip(2)

    Else If PressedKey = KEY_ENTER Then

        If Session.ViewerError Then
            Call RetryViewer()
        Else

            Call ResetAll()
        End If

    Else If PressedKey = KEY_O Then

        Call ViewerCamera.ToggleAutoOrbit(ViewerCameraState)

    Else If PressedKey = KEY_G Then

        GridVisible = Not GridVisible

    Else If PressedKey = KEY_4 Then

        Call CycleProfile()

    Else If PressedKey = KEY_TAB Then

        Call SelectPresentationClip(
            (PresentationIndexForRuntimeClip(Playback.SelectedClip) + 1) Mod
                ViewerProfiles.ClipCount(Session.ProfileIndex)
        )

    Else If PressedKey = KEY_R Then

        Call PlaySelectedClip()

    End If

End Sub

Function HandleTransformGizmoKeyboard(PressedKey As Number) As Boolean

    If (Not CalibrationAvailable Or
        Not ViewerUiState.CalibrationVisible Or
        ViewerUiState.Visibility <> 0) Then
        Return False
    End If

    If PressedKey = KEY_ESCAPE Then

        If ViewerGizmoState.Dragging Then
            Call CancelTransformGizmoDrag()
        Else If ViewerUiState.CalibrationEditing Then
            Call CancelCalibrationEdit()
        End If

        Return True

    Else If PressedKey = KEY_X Then

        Call SelectTransformGizmoAxis(CALIBRATION_AXIS_X)

        Return True

    Else If PressedKey = KEY_Y Then

        Call SelectTransformGizmoAxis(CALIBRATION_AXIS_Y)

        Return True

    Else If PressedKey = KEY_Z Then

        Call SelectTransformGizmoAxis(CALIBRATION_AXIS_Z)

        Return True

    Else If (PressedKey = KEY_G And
        ViewerUiState.CalibrationTarget >= CALIBRATION_TARGET_SWORD) Then

        ViewerUiState.CalibrationTransform = CALIBRATION_TRANSFORM_MOVE

        Call BeginTransformGizmoDrag(False)

        Return True

    Else If PressedKey = KEY_R Or PressedKey = KEY_E Then

        ViewerUiState.CalibrationTransform = CALIBRATION_TRANSFORM_ROTATE

        Call BeginTransformGizmoDrag(False)

        Return True

    Else If PressedKey = KEY_ENTER Then

        If ViewerGizmoState.Dragging Then
            Call FinishTransformGizmoDrag()
        Else If ViewerUiState.CalibrationEditing Then
            Call SaveCalibrationFrame()
        Else
            Return False
        End If

        Return True

    End If

    Return False

End Function

Sub SelectTransformGizmoAxis(Axis As Number)

    If Axis < CALIBRATION_AXIS_X Or Axis > CALIBRATION_AXIS_Z Then
        Return
    End If

    If ViewerGizmoState.Dragging Then

        Call SetCurrentCalibrationValue(ViewerGizmoState.DragStartValue)

        ViewerUiState.CalibrationAxis = Axis

        Call ViewerGizmo.SelectAxis(ViewerGizmoState, CurrentCalibrationValue())

    Else
        ViewerUiState.CalibrationAxis = Axis

    End If

End Sub

Sub BeginTransformGizmoDrag(PointerOwned As Boolean)

    Dim OpenedEdit As Boolean

    If Not ViewerGizmoState.Visible Then
        Return
    End If

    OpenedEdit = Not ViewerUiState.CalibrationEditing

    Call BeginCalibrationEdit()
    Call ViewerGizmo.BeginDrag(
        ViewerGizmoState,
        PointerOwned,
        OpenedEdit,
        CurrentCalibrationValue()
    )

End Sub

Sub ToggleTransformGizmo()

    ' Hiding the handles keeps the current unsaved numeric preview, without saving it.

    Call ViewerGizmo.Toggle(ViewerGizmoState)

End Sub

Sub FinishTransformGizmoDrag()

    Call ViewerGizmo.FinishDrag(ViewerGizmoState)

End Sub

Sub CancelTransformGizmoDrag()

    Dim OpenedEdit As Boolean

    If Not ViewerGizmoState.Dragging Then
        Return
    End If

    OpenedEdit = ViewerGizmoState.OpenedEdit

    If OpenedEdit Then
        Call CancelCalibrationEdit()
    Else

        Call SetCurrentCalibrationValue(ViewerGizmoState.DragStartValue)
    End If

    Call FinishTransformGizmoDrag()

End Sub

Function HandleTransformGizmoPointer() As Boolean

    Dim Axis As Number

    If (Not CalibrationAvailable Or
        Not ViewerUiState.CalibrationVisible Or
        ViewerUiState.Visibility <> 0 Or
        Session.ViewerError) Then
        Return False
    End If

    If PointerInRectangle(300, 268, 132, 24) Then

        If Pointer_Pressed(POINTER_PRIMARY) Then
            Call ToggleTransformGizmo()
        End If

        Return True

    End If

    If Not ViewerGizmoState.Visible Then
        Return False
    End If

    Call UpdateTransformGizmo()

    If ViewerGizmoState.Dragging Then

        If Pointer_Pressed(POINTER_SECONDARY) Then
            Call CancelTransformGizmoDrag()

            Return True
        End If

        If ViewerGizmoState.PointerOwned Then

            If Pointer_Released(POINTER_PRIMARY) Then

                Call UpdateTransformGizmoFromPointer()
                Call FinishTransformGizmoDrag()

                Return True

            End If

            If Pointer_Held(POINTER_PRIMARY) Or Pointer_Pressed(POINTER_PRIMARY) Then
                Call UpdateTransformGizmoFromPointer()
            End If

        Else

            If Pointer_Pressed(POINTER_PRIMARY) Then
                Call FinishTransformGizmoDrag()

                Return True
            End If

            Call UpdateTransformGizmoFromPointer()

        End If

        Return True

    End If

    If Not Pointer_Pressed(POINTER_PRIMARY) Then
        Return False
    End If

    Axis = TransformGizmoAxisAtPointer()

    If Axis < 0 Then
        Return False
    End If

    ViewerUiState.CalibrationAxis = Axis

    Call BeginTransformGizmoDrag(True)

    ' A quick click can deliver press and release in one rendered frame.
    ' End its pointer capture now; do not leave a phantom drag for the next frame.

    If Pointer_Released(POINTER_PRIMARY) Then
        Call FinishTransformGizmoDrag()
    End If

    Return True

End Function

Function TransformGizmoAxisAtPointer() As Number

    Dim Axis As Number

    Axis = -1

    If (Not ViewerGizmoState.Visible Or
        Not Pointer_Inside() Or
        Pointer_Y() < 90 Or
        Pointer_Y() >= Window_Height() - 100 Or
        Pointer_X() >= StatusPanelX() Or
        PointerInRectangle(CALIBRATION_PANEL_X, CALIBRATION_PANEL_Y,
            CALIBRATION_PANEL_WIDTH, CALIBRATION_PANEL_HEIGHT)) Then
        Return Axis
    End If

    If ViewerUiState.CalibrationTransform = CALIBRATION_TRANSFORM_MOVE Then
        Axis = CharacterViewer.TransformGizmoMoveAxisAtPointer(
            ViewerGizmoState.Projection,
            Pointer_X(),
            Pointer_Y(),
            ViewerUiState.CalibrationAxis,
            TRANSFORM_GIZMO_HIT_RADIUS
        )
    Else
        Axis = CharacterViewer.TransformGizmoRotationAxisAtPointer(
            ViewerGizmoState.Origin,
            Pointer_X(),
            Pointer_Y(),
            ViewerUiState.CalibrationAxis,
            ViewerGizmoState.WorldSize,
            ViewerCameraState.Live,
            Window_Width(),
            Window_Height(),
            TRANSFORM_GIZMO_RING_SEGMENTS,
            TRANSFORM_GIZMO_HIT_RADIUS
        )
    End If

    Return Axis

End Function

Sub UpdateTransformGizmoFromPointer()

    Dim PointerAmount As Number
    Dim ValueAmount As Number

    If ViewerUiState.CalibrationTransform = CALIBRATION_TRANSFORM_MOVE Then
        PointerAmount = CharacterViewer.TransformGizmoAxisPointerDelta(
            ViewerGizmoState.Projection,
            ViewerUiState.CalibrationAxis,
            Pointer_Delta_X(),
            Pointer_Delta_Y()
        )
        ValueAmount = CharacterViewer.RetainedPointerDelta(
            ViewerGizmoState.DragRemainder,
            PointerAmount,
            TRANSFORM_GIZMO_MOVE_DIVISOR
        )
    Else

        PointerAmount = TransformGizmoRingPointerDelta(Pointer_X(), Pointer_Y(),
            Pointer_Delta_X(), Pointer_Delta_Y())

        ValueAmount = CharacterViewer.RetainedPointerDelta(
            ViewerGizmoState.DragRemainder,
            PointerAmount,
            TRANSFORM_GIZMO_ROTATE_DIVISOR
        )
    End If

    If ValueAmount <> 0 Then
        Call AdjustCalibrationValue(ValueAmount)
        Call UpdateTransformGizmo()
    End If

End Sub

''' Project pointer travel onto the nearest visible ring segment. Keep thousandths
''' of a degree so slow drags accumulate without snapping; edge-on collapsed
''' segments are skipped instead of amplifying tiny motions.
Function TransformGizmoRingPointerDelta(PointerX As Number, PointerY As Number,
    DeltaX As Number, DeltaY As Number) As Number

    Dim Segment As Number
    Dim StartPoint As Core.ProjectedPoint3D
    Dim EndPoint As Core.ProjectedPoint3D
    Dim AxisX As Number
    Dim AxisY As Number
    Dim LengthSquared As Number
    Dim Along1000 As Number
    Dim DistanceX As Number
    Dim DistanceY As Number
    Dim DistanceSquared As Number
    Dim BestDistance As Number
    Dim AngleSpan As Number
    Dim Result As Number

    BestDistance = -1

    For Segment = 0 To TRANSFORM_GIZMO_RING_SEGMENTS - 1

        StartPoint = CharacterViewer.ProjectTransformRingPoint(ViewerGizmoState.Origin,
            ViewerUiState.CalibrationAxis, Segment, TRANSFORM_GIZMO_RING_SEGMENTS,
            ViewerGizmoState.WorldSize, ViewerCameraState.Live, Window_Width(), Window_Height())
        EndPoint = CharacterViewer.ProjectTransformRingPoint(ViewerGizmoState.Origin,
            ViewerUiState.CalibrationAxis, Segment + 1, TRANSFORM_GIZMO_RING_SEGMENTS,
            ViewerGizmoState.WorldSize, ViewerCameraState.Live, Window_Width(), Window_Height())
        AxisX = EndPoint.X - StartPoint.X
        AxisY = EndPoint.Y - StartPoint.Y
        LengthSquared = AxisX * AxisX + AxisY * AxisY

        If (StartPoint.Visible And
            EndPoint.Visible And
            LengthSquared >= 9) Then

            Along1000 = ((PointerX - StartPoint.X) * AxisX +
                (PointerY - StartPoint.Y) * AxisY) * 1000 / LengthSquared
            Along1000 = Min(1000, Max(0, Along1000))
            DistanceX = PointerX - StartPoint.X - AxisX * Along1000 / 1000
            DistanceY = PointerY - StartPoint.Y - AxisY * Along1000 / 1000
            DistanceSquared = DistanceX * DistanceX + DistanceY * DistanceY

            If BestDistance < 0 Or DistanceSquared < BestDistance Then

                BestDistance = DistanceSquared
                AngleSpan = ((Segment + 1) * 360 / TRANSFORM_GIZMO_RING_SEGMENTS -
                    Segment * 360 / TRANSFORM_GIZMO_RING_SEGMENTS)
                Result = (DeltaX * AxisX + DeltaY * AxisY) * AngleSpan * 1000 / LengthSquared

            End If

        End If

    End For

    If ViewerUiState.CalibrationAxis = CALIBRATION_AXIS_Y Then
        Result = 0 - Result
    End If

    Return Result

End Function

Sub UpdateTransformGizmo()

    Call ViewerGizmo.UpdateProjection(
        ViewerGizmoState,
        CurrentTransformGizmoOrigin(),
        ViewerCameraState.Live,
        Window_Width(),
        Window_Height()
    )

End Sub

Function CurrentTransformGizmoOrigin() As Core.Vector3

    Dim Result As Core.Vector3
    Dim SocketName As Text
    Dim PartIndex As Number

    PartIndex = BODY_PART_INDEX
    SocketName = "HandRight"

    If ViewerUiState.CalibrationTarget = CALIBRATION_TARGET_SHIELD_WRIST Then
        SocketName = "HandLeft"
    Else If ViewerUiState.CalibrationTarget = CALIBRATION_TARGET_SWORD Then
        PartIndex = WEAPON_PART_INDEX
        SocketName = "SwordBase"
    Else If ViewerUiState.CalibrationTarget = CALIBRATION_TARGET_SHIELD Then
        PartIndex = SHIELD_PART_INDEX
        SocketName = "ShieldCenter"
    End If

    Result.X = Character3D.SocketValueThousandths(Character, SocketName,
        Graphics3D.ANIMATOR_SOCKET_POSITION_X, PartIndex) / 1000
    Result.Y = Character3D.SocketValueThousandths(Character, SocketName,
        Graphics3D.ANIMATOR_SOCKET_POSITION_Y, PartIndex) / 1000
    Result.Z = Character3D.SocketValueThousandths(Character, SocketName,
        Graphics3D.ANIMATOR_SOCKET_POSITION_Z, PartIndex) / 1000

    Return Result

End Function

Sub ToggleScenePause()

    If PartyMode And Playback.ScenePaused Then

        If ViewerUiState.CalibrationEditing Then
            Session.CharacterSwitchBlocked = True
            Return
        End If

        Call RestorePartyPreview()

    End If

    Playback.ScenePaused = Not Playback.ScenePaused

End Sub

Sub ToggleDemo()

    If PartyMode Then
        Call ToggleScenePause()

        Return
    End If

    Playback.DemoEnabled = Not Playback.DemoEnabled
    Playback.AnimationCycleElapsed = 0

    Call PlaySelectedClip()

End Sub

Sub CycleBackground()

    BackgroundIndex = (BackgroundIndex + 1) Mod BACKGROUND_COUNT

End Sub

Sub ToggleDragon()

    If DragonAvailable Then

        DragonVisible = Not DragonVisible

        If Not DragonVisible Then
            Call ClearDragonOwnedEffects()
        End If

    End If

End Sub

Sub ToggleSword()

    If PartyUiBound Then

        Call EndPartyInspector()
        Call ToggleSword()
        Call BeginPartyInspector()

        Return

    End If

    If Session.DragonInspection Then

        SwordVisible = Not SwordVisible
        Session.Ready = Character3D.SetPartVisible(DragonOpponent.Actor, WEAPON_PART_INDEX, SwordVisible) And Session.Ready
        Session.Ready = Character3D.SetPartVisible(PartyCompanion.Actor, WEAPON_PART_INDEX, SwordVisible) And Session.Ready

        If Not SwordVisible Then
            Call HideSwordEffects()
        End If

        Return

    End If

    If CalibrationAvailable Then

        SwordVisible = Not SwordVisible
        Session.Ready = Character3D.SetPartVisible(
            Character,
            WEAPON_PART_INDEX,
            SwordVisible
        ) And Session.Ready

        If PartyMode And PartyReady Then
            Session.Ready = Character3D.SetPartVisible(PartyCompanion.Actor, WEAPON_PART_INDEX, SwordVisible) And Session.Ready
        End If

        If Not SwordVisible Then
            Call HideSwordEffects()
        End If

    End If

End Sub

Sub ToggleShield()

    If PartyUiBound Then

        Call EndPartyInspector()
        Call ToggleShield()
        Call BeginPartyInspector()

        Return

    End If

    If Session.DragonInspection Then

        ShieldVisible = Not ShieldVisible
        Session.Ready = Character3D.SetPartVisible(DragonOpponent.Actor, SHIELD_PART_INDEX, ShieldVisible) And Session.Ready
        Session.Ready = Character3D.SetPartVisible(PartyCompanion.Actor, SHIELD_PART_INDEX, ShieldVisible) And Session.Ready

        If Not ShieldVisible Then
            Call HideShieldEffects()
        End If

        Return

    End If

    If CalibrationAvailable Then

        ShieldVisible = Not ShieldVisible
        Session.Ready = Character3D.SetPartVisible(
            Character,
            SHIELD_PART_INDEX,
            ShieldVisible
        ) And Session.Ready

        If PartyMode And PartyReady Then
            Session.Ready = Character3D.SetPartVisible(PartyCompanion.Actor, SHIELD_PART_INDEX, ShieldVisible) And Session.Ready
        End If

        If Not ShieldVisible Then
            Call HideShieldEffects()
        End If

    End If

End Sub

Function BeginViewerScene() As Boolean

    Dim Result As Boolean

    Result = ApplyBackdrop()

    If Not Result Then
        Return False
    End If

    If BackgroundIndex = 1 Then
        Result = Scene3D.Begin(ViewerCameraState.Live, 0, 96, 32)
    Else If BackgroundIndex = 2 Then
        Result = Scene3D.Begin(ViewerCameraState.Live, 62, 20, 96)
    Else
        Result = Scene3D.Begin(ViewerCameraState.Live, 0, 0, 0)
    End If

    Return Result

End Function

Sub CreateBackdrop()

    Dim BackdropReady As Boolean

    BackdropAvailable = False
    BackdropTextureIndex = -1
    BackdropLandscapeTexture = StaticBackdrop3D.Create(BACKDROP_LANDSCAPE_PATH)
    BackdropTitleTexture = StaticBackdrop3D.Create(BACKDROP_TITLE_PATH)
    BackdropReady = BackdropLandscapeTexture.Ready
    BackdropReady = BackdropTitleTexture.Ready And BackdropReady

    If Not BackdropReady Then
        Call DestroyBackdrop()

        Return
    End If

    BackdropAvailable = BackdropReady

End Sub

Function ApplyBackdrop() As Boolean

    Dim Result As Boolean

    Result = True

    If BackdropTextureIndex = BackgroundIndex Then
        Return True
    End If

    If BackdropAvailable And BackgroundIndex = 3 Then
        Result = StaticBackdrop3D.SetActive(BackdropLandscapeTexture)
    Else If BackdropAvailable And BackgroundIndex = 4 Then
        Result = StaticBackdrop3D.SetActive(BackdropTitleTexture)
    Else
        Result = StaticBackdrop3D.ClearActive()
    End If

    If Result Then
        BackdropTextureIndex = BackgroundIndex
    End If

    Return Result

End Function

Sub DestroyBackdrop()

    Dim BackdropCleared As Boolean

    BackdropCleared = StaticBackdrop3D.ClearActive()

    Call StaticBackdrop3D.Destroy(BackdropLandscapeTexture)
    Call StaticBackdrop3D.Destroy(BackdropTitleTexture)

    BackdropAvailable = False
    BackdropTextureIndex = -1

End Sub

Sub ToggleFloorAndGrid()

    If FloorVisible Or GridVisible Then
        FloorVisible = False
        GridVisible = False
    Else
        FloorVisible = True
        GridVisible = True
    End If

End Sub

Sub ToggleEpicGlow()

    If Session.DragonInspection Then

        DragonOpponent.GlowVisible = Not DragonOpponent.GlowVisible
        PartyCompanion.GlowVisible = DragonOpponent.GlowVisible
        Return

    End If

    If EpicGlowAvailable Then

        EpicGlowVisible = Not EpicGlowVisible

        If EpicGlowVisible Then
            Call ResetEpicGlowTrails()
        Else

            Call ClearEquipmentGlowTrails()
        End If

    End If

End Sub

Sub RetryViewer()

    Call DestroyViewerResources()
    Call Character3D.Shutdown()
    Call Scene3D.Shutdown()
    Call Graphics3D.ResetRenderer3D()

    Call ViewerSession.ResetFailure(Session)

    Call LoadViewer()

End Sub

Sub CycleProfile()

    If Not ViewerProfiles.INCLUDE_DIAGNOSTIC_PROFILES Or PartyMode Then
        Return
    End If

    If ViewerUiState.CalibrationEditing Then
        Session.CharacterSwitchBlocked = True
        Return
    End If

    Call DestroyViewerResources()

    PartyMode = False
    Session.DragonInspection = False
    Session.SelectedCharacterTab = 0
    Session.ProfileIndex = ViewerProfiles.NextProfile(Session.ProfileIndex)

    If Session.ProfileIndex = ViewerProfiles.PROFILE_ORIN Then
        Session.SelectedCharacterTab = 1
    Else If Session.ProfileIndex = ViewerProfiles.PROFILE_DRAGON Then
        Session.SelectedCharacterTab = 2
        Session.DragonInspection = True
    End If

    Call ViewerSession.ResetFailure(Session)

    Call LoadViewer()

End Sub

Sub CycleMaterialInspection()

    MaterialInspection = (MaterialInspection + 1) Mod 7
    Session.Ready = Graphics3D.SetMaterialInspection3D(MaterialInspection) And Session.Ready

End Sub

Sub ApplyPartyAttackCamera()

    Dim Hero As Core.Vector3
    Dim OtherHero As Core.Vector3
    Dim WaistHeight As Number
    Dim Boss As Core.Vector3
    Dim BossHead As Core.Vector3
    Dim Mouth As Core.Vector3
    Dim Desired As Core.Camera3D
    Dim Distance As Number
    Dim DeltaX As Number
    Dim DeltaZ As Number
    Dim Along As Number
    Dim Across As Number
    Dim Height As Number
    Dim Impact1000 As Number
    Dim BattleShot As Boolean
    Dim BossChargeShot As Boolean
    Dim ShotSide As Number
    Dim StableAnchor As Core.Vector3

    PartyOrbitCamera = ViewerCameraState.Live
    PartyActiveCamera = 1

    If (Not PartyMode Or
        Not PartyReady Or
        Not DragonAvailable Or
        Not ViewerCameraState.AutoOrbit Or
        Not DragonVisible) Then
        PartyPreviousCamera = 1
        Return
    End If

    BattleShot = PartyStage <= 1

    If PartyTurn = 2 Then
        BattleShot = PartyElapsed < 3000
    End If

    If Not BattleShot Then
        PartyPreviousCamera = 1
        Return
    End If

    ''' Actor homes/travel are stable. Bone bobbing and KO must not drive the camera.
    Hero = Math3D.Vector(ViewerCameraState.Frame.PositionX, ViewerCameraState.Frame.PositionY + 68, ViewerCameraState.Frame.PositionZ)

    If PartyTurn = 1 Then
        Hero = Math3D.Vector(PartyCompanion.Frame.PositionX,
            PartyCompanion.Frame.PositionY + 80, PartyCompanion.Frame.PositionZ)
    End If

    WaistHeight = Hero.Y - 32

    If PartyTurn = 2 Then

        OtherHero = Math3D.Vector(PartyCompanion.Frame.PositionX,
            PartyCompanion.Frame.PositionY + 80, PartyCompanion.Frame.PositionZ)
        WaistHeight = Min(Hero.Y, OtherHero.Y) - 32
        Hero.X = (Hero.X + OtherHero.X) / 2
        Hero.Y = (Hero.Y + OtherHero.Y) / 2
        Hero.Z = (Hero.Z + OtherHero.Z) / 2

    End If

    ''' Frame the boss at the cut; breathing, recoil and head aim do not shake the lens.

    If PartyPreviousCamera = 1 Or PartyTurn <> PartyPreviousCameraTurn Then

        StableAnchor = Math3D.Vector(
            DRAGON_POSITION_X, DRAGON_CAMERA_CHEST_HEIGHT, DRAGON_POSITION_Z)
        PartyShotBoss = BattleCamera.BoundedAnchor(
            Character3D.SocketPosition(Dragon, "Chest"), StableAnchor,
            DRAGON_CAMERA_ANCHOR_MAXIMUM_DELTA)
        StableAnchor.Y = DRAGON_CAMERA_HEAD_HEIGHT
        PartyShotBossHead = BattleCamera.BoundedAnchor(
            Character3D.SocketPosition(Dragon, "Head"), StableAnchor,
            DRAGON_CAMERA_ANCHOR_MAXIMUM_DELTA)
        StableAnchor.Y = DRAGON_CAMERA_MOUTH_HEIGHT
        PartyShotMouth = BattleCamera.BoundedAnchor(
            Character3D.SocketPosition(Dragon, "Mouth"), StableAnchor,
            DRAGON_CAMERA_ANCHOR_MAXIMUM_DELTA)

    End If

    Boss = PartyShotBoss
    BossHead = PartyShotBossHead
    BossChargeShot = (PartyTurn = 2 And
        (PartyElapsed * Playback.PlaybackSpeed / 100 < 650 Or
        (DragonCounter Mod 3 = 2 And PartyElapsed * Playback.PlaybackSpeed / 100 < 1750)))
    DeltaX = Hero.X - Boss.X
    DeltaZ = Hero.Z - Boss.Z
    Distance = Max(1, Math3D.Distance(Hero, Boss))
    Along = 150
    Across = 120
    Height = 55
    ShotSide = -1

    If PartyTurn = 1 Then
        ShotSide = 1
    End If

    If PartyElapsed < 650 Then

        Along = -45
        Across = 190
        Height = 10

    Else If PartyStage = 0 And PartyTurn <> 2 Then

        Along = 160
        Across = 85
        Height = 65

    Else
        Impact1000 = Min(1000, Max(0, PartyElapsed - 1300) * 1000 / Max(1, PartyAttackDuration()))
        Along = 150 - Impact1000 * 35 / 1000
        Across = 120

    End If

    If PartyElapsed >= 650 Then
        Height = WaistHeight - Hero.Y
    End If

    If PartyTurn = 2 And PartyElapsed >= 650 Then
        Along = 170
        Across = 65
    End If

    Across = Across * ShotSide

    Desired = PartyOrbitCamera
    Desired.UpDirection.X = 0
    Desired.UpDirection.Y = Core.FIXED_ONE
    Desired.UpDirection.Z = 0
    Desired.Target.X = (Hero.X + Boss.X) / 2
    Desired.Target.Y = Max(Hero.Y + 12, BossHead.Y - 35)

    If PartyElapsed >= 650 Then
        Desired.Target.Y = (WaistHeight + BossHead.Y) / 2
    End If

    Desired.Target.Z = (Hero.Z + Boss.Z) / 2
    Desired.Position.X = Hero.X + DeltaX * Along / Distance - DeltaZ * Across / Distance
    Desired.Position.Y = Hero.Y + Height
    Desired.Position.Z = Hero.Z + DeltaZ * Along / Distance + DeltaX * Across / Distance

    If PartyTurn = 2 Then

        Desired.Position.X = Desired.Position.X + (Desired.Position.X - Desired.Target.X) * 15 / 100
        Desired.Position.Y = Desired.Position.Y + (Desired.Position.Y - Desired.Target.Y) * 15 / 100
        Desired.Position.Z = Desired.Position.Z + (Desired.Position.Z - Desired.Target.Z) * 15 / 100

    End If

    ''' The orbit stays live. The two battle cameras have independent poses and cut directly.

    Mouth = PartyShotMouth
    PartyDragonCamera = Desired
    PartyDragonCamera.Position.X = BossHead.X - DeltaX * 120 / Distance - DeltaZ * 90 / Distance
    PartyDragonCamera.Position.Y = BossHead.Y + 20
    PartyDragonCamera.Position.Z = BossHead.Z - DeltaZ * 120 / Distance + DeltaX * 90 / Distance
    PartyDragonCamera.Target.X = (Mouth.X * 3 + Hero.X) / 4
    PartyDragonCamera.Target.Y = (Mouth.Y * 3 + Hero.Y) / 4
    PartyDragonCamera.Target.Z = (Mouth.Z * 3 + Hero.Z) / 4

    If (PartyPreviousCamera <> 2 Or
        PartyTurn <> PartyPreviousCameraTurn Or
        PartyStage <> PartyPreviousShotStage) Then

        PartyShotPosition1000.X = Desired.Position.X * 1000
        PartyShotPosition1000.Y = Desired.Position.Y * 1000
        PartyShotPosition1000.Z = Desired.Position.Z * 1000
        PartyShotTarget1000.X = Desired.Target.X * 1000
        PartyShotTarget1000.Y = Desired.Target.Y * 1000
        PartyShotTarget1000.Z = Desired.Target.Z * 1000

    End If

    PartyShotPosition1000.X = PartyShotPosition1000.X + (Desired.Position.X * 1000 - PartyShotPosition1000.X) * Timing.CameraElapsed / (320 + Timing.CameraElapsed)
    PartyShotPosition1000.Y = PartyShotPosition1000.Y + (Desired.Position.Y * 1000 - PartyShotPosition1000.Y) * Timing.CameraElapsed / (320 + Timing.CameraElapsed)
    PartyShotPosition1000.Z = PartyShotPosition1000.Z + (Desired.Position.Z * 1000 - PartyShotPosition1000.Z) * Timing.CameraElapsed / (320 + Timing.CameraElapsed)
    PartyShotTarget1000.X = PartyShotTarget1000.X + (Desired.Target.X * 1000 - PartyShotTarget1000.X) * Timing.CameraElapsed / (180 + Timing.CameraElapsed)
    PartyShotTarget1000.Y = PartyShotTarget1000.Y + (Desired.Target.Y * 1000 - PartyShotTarget1000.Y) * Timing.CameraElapsed / (180 + Timing.CameraElapsed)
    PartyShotTarget1000.Z = PartyShotTarget1000.Z + (Desired.Target.Z * 1000 - PartyShotTarget1000.Z) * Timing.CameraElapsed / (180 + Timing.CameraElapsed)
    PartyHeroCamera = Desired
    PartyHeroCamera.Position.X = PartyShotPosition1000.X / 1000
    PartyHeroCamera.Position.Y = PartyShotPosition1000.Y / 1000
    PartyHeroCamera.Position.Z = PartyShotPosition1000.Z / 1000
    PartyHeroCamera.Target.X = PartyShotTarget1000.X / 1000
    PartyHeroCamera.Target.Y = PartyShotTarget1000.Y / 1000
    PartyHeroCamera.Target.Z = PartyShotTarget1000.Z / 1000

    ''' Clear both armored silhouettes after smoothing, including a shield held out in front.
    Hero = Math3D.Vector(ViewerCameraState.Frame.PositionX, ViewerCameraState.Frame.PositionY, ViewerCameraState.Frame.PositionZ)
    OtherHero = Math3D.Vector(PartyCompanion.Frame.PositionX, PartyCompanion.Frame.PositionY, PartyCompanion.Frame.PositionZ)

    Call BattleCamera.KeepOutsideActor(PartyHeroCamera, Hero, 100)
    Call BattleCamera.KeepOutsideActor(PartyHeroCamera, OtherHero, 115)

    PartyHeroCamera.Position.Y = Max(24, PartyHeroCamera.Position.Y)
    PartyDragonCamera.Position.Y = Max(24, PartyDragonCamera.Position.Y)

    ViewerCameraState.Live = PartyHeroCamera
    PartyActiveCamera = 2

    If BossChargeShot Then
        ViewerCameraState.Live = PartyDragonCamera
        PartyActiveCamera = 3
    End If

    PartyPreviousCamera = PartyActiveCamera
    PartyPreviousCameraTurn = PartyTurn
    PartyPreviousShotStage = PartyStage

End Sub

Sub AdvanceAnimationSequence()

    Dim ClipCount As Number
    Dim CurrentAnimationTime As Number

    If Not Playback.DemoEnabled Or PartyMode Then
        Return
    End If

    ClipCount = Character3D.ClipCount(Character)
    CurrentAnimationTime = Character3D.AnimationTime(Character)
    Playback.AnimationCycleElapsed = Playback.AnimationCycleElapsed + Timing.PresentationElapsed

    If CurrentAnimationTime < Playback.DemoPreviousAnimationTime Then
        Playback.DemoCompletedLoops = Playback.DemoCompletedLoops + 1
    End If

    Playback.DemoPreviousAnimationTime = CurrentAnimationTime

    If (Playback.DemoCompletedLoops >= ViewerPlayback.DemoRequiredLoops(
        Character, Playback.SelectedClip, Playback.PlaybackSpeed,
        Session.ProfileIndex, ANIMATION_CYCLE_MILLISECONDS) Or
        (ViewerPlayback.ClipMode(Session.ProfileIndex, SelectedClipName()) =
        Graphics3D.ANIMATION_ONCE And
        Playback.AnimationCycleElapsed >= ViewerPlayback.DemoTarget(
        Session.ProfileIndex, ANIMATION_CYCLE_MILLISECONDS) And
        CurrentAnimationTime >= Character3D.ClipDuration(Character, Playback.SelectedClip))) Then
        Playback.SelectedClip = RuntimeClipForPresentationIndex(
            (PresentationIndexForRuntimeClip(Playback.SelectedClip) + 1) Mod ClipCount
        )

        Call PlaySelectedClip(True)
    End If

End Sub

Function HandleInterfacePointer() As Boolean

    Dim Blocked As Boolean
    Dim ClipCount As Number
    Dim Index As Number
    Dim KeyframeIndex As Number
    Dim Column As Number
    Dim Row As Number
    Dim PanelLeft As Number
    Dim WheelDelta As Number

    If (ViewerInputState.TimelineScrubbing Or
        ViewerInputState.TimelineKeyframeDragging Or
        ViewerInputState.FrameButtonRepeatDirection <> 0 Or
        ViewerInputState.SliderDragOwner <> 0 Or
        ViewerGizmoState.Dragging) Then

        Call BeginPartyInspector()

        Blocked = HandleInspectorPointer()

        Call EndPartyInspector()

        Return Blocked

    End If

    If ViewerUiState.Visibility = 2 Then

        If Pointer_Pressed(POINTER_SECONDARY) Then

            If PartyMode Then
                Call ResetPartyInspector()
            Else If Session.ViewerError Then
                Call RetryViewer()
            Else

                Call ResetAll()
            End If

            Return True

        End If

        Return False

    End If

    PanelLeft = StatusPanelX()

    If PointerInRectangle(18, 62, 404, 26) Then

        If Pointer_Pressed(POINTER_PRIMARY) Then

            If PointerInRectangle(104, 62, 72, 26) Then
                Call SelectCharacterTab(0)
            Else If PointerInRectangle(182, 62, 72, 26) Then
                Call SelectCharacterTab(1)
            Else If PointerInRectangle(260, 62, 72, 26) Then
                Call SelectCharacterTab(2)
            Else If PointerInRectangle(338, 62, 72, 26) Then
                Call SelectCharacterTab(3)
            End If

        End If

        Return True

    End If

    If PartyMode Then

        If HandlePartyPointer() Then
            Return True
        End If

        Call BeginPartyInspector()

        Blocked = HandleInspectorPointer()

        Call EndPartyInspector()

        Return Blocked

    End If

    Blocked = HandleInspectorPointer()

    Return Blocked

End Function

Function HandleInspectorPointer() As Boolean

    Dim PanelLeft As Number
    Dim Blocked As Boolean
    Dim WheelDelta As Number
    Dim KeyframeIndex As Number
    Dim ClipCount As Number
    Dim Index As Number
    Dim Column As Number
    Dim Row As Number

    PanelLeft = StatusPanelX()

    If HandleTransformGizmoPointer() Then
        Return True
    End If

    If ViewerInputState.FrameButtonRepeatDirection <> 0 Then

        If (Pointer_Pressed(POINTER_SECONDARY) Or
            (Not Pointer_Held(POINTER_PRIMARY) And Not Pointer_Pressed(POINTER_PRIMARY))) Then

            ViewerInputState.FrameButtonRepeatDirection = 0

        Else

            If Timer() >= ViewerInputState.FrameButtonRepeatAt Then
                Call StepAnimationFrame(ViewerInputState.FrameButtonRepeatDirection)

                ''' No catch-up burst if rendering or input stalls.
                ViewerInputState.FrameButtonRepeatAt = Timer() + FRAME_BUTTON_REPEAT_MILLISECONDS
            End If

            Return True

        End If

    End If

    If ViewerInputState.TimelineKeyframeDragging Then

        If Pointer_Pressed(POINTER_PRIMARY) Or Pointer_Held(POINTER_PRIMARY) Then
            Call UpdateTimelineKeyframeDrag()
        Else

            Call FinishTimelineKeyframeDrag()
        End If

        Return True

    End If

    If HandleSharedSliders() Then
        Return True
    End If

    If ViewerInputState.TimelineScrubbing Then

        If Pointer_Pressed(POINTER_PRIMARY) Or Pointer_Held(POINTER_PRIMARY) Then
            Call SeekFromPointer()
        Else

            Call ViewerInput.FinishTimelineGesture(ViewerInputState)
        End If

        If Pointer_Released(POINTER_PRIMARY) Then
            Call ViewerInput.FinishTimelineGesture(ViewerInputState)
        End If

        Return True

    End If

    If Not Pointer_Inside() Then
        Return False
    End If

    If Pointer_Pressed(POINTER_SECONDARY) Then

        If Session.ViewerError Then
            Call RetryViewer()
        Else

            Call ResetAll()
        End If

        Return True

    End If

    If PointerInRectangle(
            TIMELINE_LEFT,
            Window_Height() - 64,
            TimelineWidth(),
            TIMELINE_HEIGHT
        ) Then

        WheelDelta = Pointer_Wheel_Delta()

        If WheelDelta > 0 Then
            Call StepAnimationFrame(1)
        Else If WheelDelta < 0 Then
            Call StepAnimationFrame(-1)
        End If

        If WheelDelta <> 0 Then
            Return True
        End If

    End If

    If ViewerLayoutTooSmall() Then
        Return True
    End If

    If (CalibrationAvailable And
        PointerInRectangle(TIMELINE_LEFT + CALIBRATION_DOWNLOAD_OFFSET,
            Window_Height() - 43, CALIBRATION_DOWNLOAD_WIDTH, 18)) Then

        If Pointer_Pressed(POINTER_PRIMARY) Then
            Call DownloadSavedCalibrationJson()
        End If

        Return True

    End If

    If (CalibrationAvailable And
        PointerInRectangle(TIMELINE_LEFT, Window_Height() - 43,
            CALIBRATION_IMPORT_WIDTH, 18)) Then

        If Pointer_Pressed(POINTER_PRIMARY) Then
            Call HandleCalibrationImport()
        End If

        Return True

    End If

    If (CalibrationAvailable And
        PointerInRectangle(TIMELINE_LEFT + CALIBRATION_FILENAME_OFFSET, Window_Height() - 40,
            Text_Width(Calibration.FileLabel, 9), 14)) Then

        If Pointer_Pressed(POINTER_PRIMARY) Then
            Call OpenSavedCalibrationJson()
        End If

        Return True

    End If

    If (ViewerUiState.Visibility = 0 And
        CalibrationAvailable And
        ViewerUiState.CalibrationVisible And
        PointerInRectangle(
            CALIBRATION_PANEL_X,
            CALIBRATION_PANEL_Y,
            CALIBRATION_PANEL_WIDTH,
            CALIBRATION_PANEL_HEIGHT
        )) Then
        Call HandleCalibrationPanelPointer()

        Return True
    End If

    Blocked = (Pointer_Y() < 90 Or
        Pointer_Y() >= Window_Height() - 100 Or
        (ViewerUiState.Visibility = 0 And Pointer_X() >= PanelLeft And Pointer_Y() >= 82))

    If Not Pointer_Pressed(POINTER_PRIMARY) Then
        Return Blocked
    End If

    KeyframeIndex = TimelineKeyframeAtPointer()

    If PointerInRectangle(TIMELINE_LEFT, Window_Height() - 96, 62, 24) Then

        Call SeekFirstAnimationFrame()

    Else If PointerInRectangle(TIMELINE_LEFT + 68, Window_Height() - 96, 62, 24) Then

        Call SeekCalibrationKeyframe(-1)

    Else If PointerInRectangle(TIMELINE_LEFT + 136, Window_Height() - 96, 62, 24) Then

        Call SeekCalibrationKeyframe(1)

    Else If PointerInRectangle(TIMELINE_LEFT + 204, Window_Height() - 96, 62, 24) Then

        Call StepAnimationFrame(-1)

        ViewerInputState.FrameButtonRepeatDirection = -1
        ViewerInputState.FrameButtonRepeatAt = Timer() + FRAME_BUTTON_REPEAT_MILLISECONDS

    Else If PointerInRectangle(TIMELINE_LEFT + 272, Window_Height() - 96, 62, 24) Then

        Call StepAnimationFrame(1)

        ViewerInputState.FrameButtonRepeatDirection = 1
        ViewerInputState.FrameButtonRepeatAt = Timer() + FRAME_BUTTON_REPEAT_MILLISECONDS

    Else If KeyframeIndex >= 0 Then

        Call BeginTimelineKeyframeDrag(KeyframeIndex)

    Else If PointerInRectangle(
        TIMELINE_LEFT,
        Window_Height() - 64,
        TimelineWidth(),
        TIMELINE_HEIGHT
    ) Then

        Call ViewerInput.BeginTimelineScrub(ViewerInputState)

        Call SeekFromPointer()

    Else If ViewerUiState.Visibility <> 0 Then

        Return Blocked

    Else If PointerInRectangle(PanelLeft, 18, 44, 34) Then

        Call CycleLighting()

    Else If PointerInRectangle(PanelLeft + 48, 18, 56, 34) Then

        Call CycleMaterialInspection()

    Else If PointerInRectangle(PanelLeft + 108, 18, 50, 34) Then

        Call CycleSocketDisplay()

    Else If (ViewerProfiles.INCLUDE_DIAGNOSTIC_PROFILES And
        Not PartyMode And
        PointerInRectangle(PanelLeft + 162, 18, 50, 34)) Then

        Call CycleProfile()

    Else If PointerInRectangle(GlowButtonX(), 18, GlowButtonWidth(), 34) Then

        Call ToggleEpicGlow()

    Else If PointerInRectangle(PanelLeft, 56, 72, 22) Then

        Call ToggleDragon()

    Else If PointerInRectangle(PanelLeft + 76, 56, 48, 22) Then

        Call CycleBackground()

    Else If PointerInRectangle(PanelLeft + 128, 56, 36, 22) Then

        ViewerUiState.CalibrationVisible = CalibrationAvailable And Not ViewerUiState.CalibrationVisible

        If ViewerUiState.CalibrationVisible Then
            Call BeginPartyPreview()
        Else

            Call ViewerGizmo.Hide(ViewerGizmoState)
            Call ViewerInput.CancelCaptures(ViewerInputState)
        End If

    Else If PointerInRectangle(PanelLeft + 168, 56, 40, 22) Then

        Call ToggleSword()

    Else If PointerInRectangle(PanelLeft + 212, 56, 40, 22) Then

        Call ToggleShield()

    Else If PointerInRectangle(PanelLeft + 178, 330, 74, 18) Then

        Call ToggleDemo()

    Else If PointerInRectangle(PanelLeft + 12, 444, 78, 22) Then

        Call ToggleFloorAndGrid()

    Else If PointerInRectangle(PanelLeft + 94, 444, 76, 22) Then

        If Session.ProfileIndex = ViewerProfiles.PROFILE_DRAGON Then

            DragonHeadTracking = Not DragonHeadTracking

        Else If Session.ProfileIndex = ViewerProfiles.PROFILE_ORIN Then

            Call OrinStorm.CycleStyle(OrinStormContext)

        Else
            SwordFireVisible = Not SwordFireVisible

            If Not SwordFireVisible Then
                Call ClearSwordFire()
            End If

        End If

    Else If PointerInRectangle(PanelLeft + 174, 444, 78, 22) Then

        If Session.ProfileIndex = ViewerProfiles.PROFILE_DRAGON Then

            If Not PartyMode Then
                DragonCounter = (DragonCounter + 1) Mod 2
            End If

        Else If Session.ProfileIndex = ViewerProfiles.PROFILE_ORIN Then

            Call OrinStorm.CycleStyle(OrinStormContext)

        Else
            ShieldFireVisible = Not ShieldFireVisible

            If Not ShieldFireVisible Then
                Call ClearShieldFire()
            End If

        End If

    Else If (Session.ProfileIndex = ViewerProfiles.PROFILE_ORIN And
        PointerInRectangle(PanelLeft + 12, 470, 128, 20)) Then

        Call OrinStorm.CycleSceneComfort()

    Else If (Session.ProfileIndex = ViewerProfiles.PROFILE_ORIN And
        PointerInRectangle(PanelLeft + 144, 470, 108, 20)) Then

        LightningAnimationPaused = Not LightningAnimationPaused

    Else If (SwordFireReady And
        PointerInRectangle(PanelLeft + 12, 470, 128, 20)) Then

        FlameAnimationPaused = Not FlameAnimationPaused

    Else If (Session.ProfileIndex = ViewerProfiles.PROFILE_ARIN And
        PointerInRectangle(PanelLeft + 144, 470, 108, 20)) Then

        Call ToggleShieldFireStyle()

    Else If PointerInRectangle(PanelLeft + 172, 204, 30, 24) Then

        Call AdjustPlaybackSpeed(-25)

    Else If PointerInRectangle(PanelLeft + 208, 204, 30, 24) Then

        Call AdjustPlaybackSpeed(25)

    Else If PointerInRectangle(PanelLeft + 12, Window_Height() - 64, 52, 24) Then

        Call ResetView()

    Else If PointerInRectangle(PanelLeft + 68, Window_Height() - 64, 74, 24) Then

        Call RestartPresentation()

    Else If PointerInRectangle(PanelLeft + 146, Window_Height() - 64, 40, 24) Then

        Call ResetAll()

    Else If PointerInRectangle(PanelLeft + 190, Window_Height() - 64, 50, 24) Then

        ViewerCameraState.FitLocked = Not ViewerCameraState.FitLocked

        If ViewerCameraState.FitLocked Then

            ViewerCameraState.LastFitWidth = -1
            ViewerCameraState.LastFitHeight = -1

            Call ViewerCamera.UpdateResponsiveFit(
                ViewerCameraState,
                ActiveProfile,
                LocalCharacterBounds,
                Window_Width(),
                Window_Height(),
                Max(1, Window_Width() - 284),
                DragonAvailable,
                ARENA_CAMERA_CENTER_X,
                ARENA_CAMERA_CENTER_Z,
                ARENA_CAMERA_DISTANCE,
                ARENA_CAMERA_HEIGHT
            )

        End If

    End If

    If ViewerUiState.Visibility <> 0 Then
        Return Blocked
    End If

    ClipCount = ViewerProfiles.ClipCount(Session.ProfileIndex)

    For Index = 0 To ClipCount - 1

        Column = Index Mod ANIMATION_BUTTON_COLUMN_COUNT
        Row = Index / ANIMATION_BUTTON_COLUMN_COUNT

        If PointerInRectangle(
            AnimationButtonX() + Column * (ANIMATION_BUTTON_WIDTH + ANIMATION_BUTTON_COLUMN_GAP),
            ANIMATION_BUTTON_Y + Row * (ANIMATION_BUTTON_HEIGHT + ANIMATION_BUTTON_ROW_GAP),
            ANIMATION_BUTTON_WIDTH,
            ANIMATION_BUTTON_HEIGHT
        ) Then
            Call SelectPresentationClip(Index)
        End If

    End For

    Return Blocked

End Function

Function HandleSharedSliders() As Boolean

    Dim Value As Number
    Dim PanelLeft As Number
    Dim PreviousValue As Number

    If ViewerUiState.Visibility <> 0 Then
        Return False
    End If

    PanelLeft = StatusPanelX()
    Value = ViewerCameraState.Controls.OrbitYaw

    If UI.UpdateSlider(ViewerInputState.SliderDragOwner, 1, PanelLeft + 76, Window_Height() - 142,
        CAMERA_SLIDER_WIDTH, CAMERA_SLIDER_HEIGHT, -180, 180, 1, Value) Then
        Call ViewerCamera.SetHorizontalOrbit(ViewerCameraState, Value)

        Return True
    End If

    Value = ViewerCameraState.Controls.OrbitPitch

    If UI.UpdateSlider(ViewerInputState.SliderDragOwner, 2, PanelLeft + 76, Window_Height() - 116,
        CAMERA_SLIDER_WIDTH, CAMERA_SLIDER_HEIGHT, -180, 180, 1, Value) Then
        Call ViewerCamera.SetVerticalOrbit(ViewerCameraState, Value)

        Return True
    End If

    Value = CharacterViewer.ZoomTargetDegrees(ViewerCameraState.Zoom)

    If UI.UpdateSlider(ViewerInputState.SliderDragOwner, 3, PanelLeft + 76, Window_Height() - 90,
        CAMERA_SLIDER_WIDTH, CAMERA_SLIDER_HEIGHT, ZOOM_IN_LIMIT, ZOOM_OUT_LIMIT, -1, Value) Then
        Call ViewerCamera.SetZoomTarget(ViewerCameraState, Value)

        Return True
    End If

    If ViewerUiState.CalibrationVisible Or ViewerInputState.SliderDragOwner = 4 Then

        Value = CurrentCalibrationValue()
        PreviousValue = Value

        If UI.UpdateSlider(ViewerInputState.SliderDragOwner, 4, CALIBRATION_SLIDER_X, CALIBRATION_SLIDER_Y,
            CALIBRATION_SLIDER_WIDTH, CALIBRATION_SLIDER_HEIGHT,
            CalibrationMinimumValue(), CalibrationMaximumValue(), 1, Value) Then

            If Value <> PreviousValue Then
                Call SetCurrentCalibrationValue(Value)
            End If

            Return True

        End If

    End If

    Return False

End Function

Sub HandleCalibrationPanelPointer()

    If Not Pointer_Pressed(POINTER_PRIMARY) Then
        Return
    End If

    If PointerInRectangle(292, 96, 68, 22) Then

        Call SeekCalibrationKeyframe(-1)

    Else If PointerInRectangle(364, 96, 68, 22) Then

        Call SeekCalibrationKeyframe(1)

    Else If PointerInRectangle(34, 128, 92, 24) Then

        ViewerUiState.CalibrationTarget = CALIBRATION_TARGET_SWORD_WRIST
        ViewerUiState.CalibrationTransform = CALIBRATION_TRANSFORM_ROTATE

    Else If PointerInRectangle(130, 128, 96, 24) Then

        ViewerUiState.CalibrationTarget = CALIBRATION_TARGET_SHIELD_WRIST
        ViewerUiState.CalibrationTransform = CALIBRATION_TRANSFORM_ROTATE

    Else If PointerInRectangle(230, 128, 76, 24) Then

        ViewerUiState.CalibrationTarget = CALIBRATION_TARGET_SWORD
        ViewerGizmoState.GripAnchorActive = False

    Else If PointerInRectangle(310, 128, 76, 24) Then

        ViewerUiState.CalibrationTarget = CALIBRATION_TARGET_SHIELD
        ViewerGizmoState.GripAnchorActive = False

    Else If PointerInRectangle(34, 158, 48, 24) Then

        ViewerUiState.CalibrationAxis = CALIBRATION_AXIS_X

    Else If PointerInRectangle(86, 158, 48, 24) Then

        ViewerUiState.CalibrationAxis = CALIBRATION_AXIS_Y

    Else If PointerInRectangle(138, 158, 48, 24) Then

        ViewerUiState.CalibrationAxis = CALIBRATION_AXIS_Z

    Else If PointerInRectangle(202, 158, 72, 24) Then

        ViewerUiState.CalibrationTransform = CALIBRATION_TRANSFORM_ROTATE

    Else If (PointerInRectangle(278, 158, 72, 24) And
        ViewerUiState.CalibrationTarget >= CALIBRATION_TARGET_SWORD) Then

        ViewerUiState.CalibrationTransform = CALIBRATION_TRANSFORM_MOVE

    Else If PointerInRectangle(354, 158, 78, 24) Then

        Call ResetCalibrationTarget()

    Else If PointerInRectangle(332, 412, 100, 24) Then

        Call SaveCalibrationFrame()

    Else If PointerInRectangle(244, 412, 84, 24) Then

        Call CancelCalibrationEdit()

    Else If PointerInRectangle(34, 412, 196, 24) Then

        If ViewerUiState.CalibrationClearConfirm Then
            Call ClearSelectedClipCalibration()
        Else

            Call ViewerUi.BeginClearConfirmation(ViewerUiState)
        End If

    Else If PointerInRectangle(34, 268, 80, 24) Then

        If Not ViewerUiState.CalibrationEditing Then
            Call CopyCurrentCalibrationKeyframe()
        End If

    Else If PointerInRectangle(118, 268, 80, 24) Then

        If Not ViewerUiState.CalibrationEditing Then
            Call PasteCalibrationKeyframe()
        End If

    Else If PointerInRectangle(202, 268, 90, 24) Then

        If Not ViewerUiState.CalibrationEditing Then
            Call DeleteCurrentCalibrationKeyframe()
        End If

    Else If PointerInRectangle(34, 298, 100, 24) Then

        Call ReloadCurrentCalibrationKeyframe()

    Else If PointerInRectangle(140, 298, 100, 24) Then

        ViewerGizmoState.HoldGrip = Not ViewerGizmoState.HoldGrip

        Call InvalidateVisualHistory()

        ViewerGizmoState.GripAnchorActive = False

    Else If PointerInRectangle(246, 298, 186, 24) Then

        Call UndoLastCalibrationChange()

    Else If PointerInRectangle(34, 374, 194, 24) Then

        Call BeginCalibrationEdit()

        Call SetCalibrationChannelValue(Playback.SelectedClip, 18, 1 - CalibrationChannelValue(Playback.SelectedClip, 18))

    Else If PointerInRectangle(236, 374, 196, 24) Then

        Call BeginCalibrationEdit()

        Call SetCalibrationChannelValue(Playback.SelectedClip, 19, 1 - CalibrationChannelValue(Playback.SelectedClip, 19))

    End If

End Sub

Sub UpdateCameraPointer(Blocked As Boolean)

    Dim OrbitPressed As Boolean
    Dim OrbitHeld As Boolean
    Dim OrbitReleased As Boolean
    Dim OrbitActive As Boolean
    Dim PanPressed As Boolean
    Dim PanHeld As Boolean
    Dim PanReleased As Boolean
    Dim PanActive As Boolean
    Dim WheelDelta As Number
    Dim PointerDeltaX As Number
    Dim PointerDeltaY As Number

    OrbitPressed = (Not Blocked And
        (Pointer_Pressed(POINTER_MIDDLE) Or
        (Pointer_Held(POINTER_MIDDLE) And Not ViewerCameraState.Controls.Orbiting)))
    OrbitHeld = Pointer_Held(POINTER_MIDDLE)
    OrbitReleased = Pointer_Released(POINTER_MIDDLE)
    OrbitActive = (OrbitPressed Or
        (ViewerCameraState.Controls.Orbiting And (OrbitHeld Or OrbitReleased)))
    PanPressed = (Not Blocked And
        (Pointer_Pressed(POINTER_PRIMARY) Or
        (Pointer_Held(POINTER_PRIMARY) And Not ViewerCameraState.Controls.Panning)))
    PanHeld = Pointer_Held(POINTER_PRIMARY)
    PanReleased = Pointer_Released(POINTER_PRIMARY)
    PanActive = (PanPressed Or
        (ViewerCameraState.Controls.Panning And (PanHeld Or PanReleased)))
    PointerDeltaX = Pointer_Delta_X()
    PointerDeltaY = Pointer_Delta_Y()

    ViewerCameraState.CalibrationOrbitActive = OrbitActive And ViewerUiState.CalibrationVisible And Not PartyMode

    If OrbitPressed And ViewerCameraState.CalibrationOrbitActive Then
        Call ViewerCamera.BeginCalibrationOrbitAnchor(
            ViewerCameraState,
            CurrentTransformGizmoOrigin(),
            Pointer_X(),
            Pointer_Y(),
            Window_Width(),
            Window_Height()
        )
    End If

    If Not Blocked Then
        WheelDelta = Pointer_Wheel_Delta()
    End If

    If WheelDelta <> 0 Then
        Call ViewerCamera.AdjustZoomTarget(ViewerCameraState, WheelDelta, 8)
    End If

    Session.Ready = ViewerCamera.UpdatePointerControls(
        ViewerCameraState,
        OrbitPressed,
        OrbitHeld,
        OrbitReleased,
        OrbitActive,
        PanPressed,
        PanHeld,
        PanReleased,
        PanActive,
        PointerDeltaX,
        PointerDeltaY,
        ORBIT_POINTER_DIVISOR,
        PAN_POINTER_DIVISOR
    ) And Session.Ready

End Sub

Sub CreateSocketGizmos()

    Dim EmptyTexture As Core.Texture3D
    Dim Index As Number
    Dim GizmosReady As Boolean

    GizmosReady = True
    SocketGizmoCount = 4
    SelectedSocket = 0
    ShowAllSocketOrigins = False
    SocketMarkerMaterial = Graphics3D.CreateMaterial3D(
        EmptyTexture,
        Graphics3D.MATERIAL_ALPHA_ADDITIVE,
        120,
        220,
        255,
        75,
        True,
        100,
        50
    )
    GizmosReady = SocketMarkerMaterial.Handle <> 0 And GizmosReady

    If SocketMarkerMaterial.Handle <> 0 Then
        SocketMarkers = Graphics3D.CreateParticleBatch3D(
            64,
            SocketMarkerMaterial,
            Graphics3D.VFX_BILLBOARD_CAMERA,
            1,
            1
        )
        GizmosReady = SocketMarkers.Handle <> 0 And GizmosReady
    End If

    For Index = 0 To SocketGizmoCount - 1

        SocketGizmos[Index] = Graphics3D.CreateCube3D(3)
        GizmosReady = SocketGizmos[Index].Handle <> 0 And GizmosReady
        GizmosReady = Graphics3D.SetObjectShadowsChecked3D(
            SocketGizmos[Index],
            False,
            False
        ) And GizmosReady

        If Index = 0 Then
            Call Graphics3D.SetObjectColor(SocketGizmos[Index], 255, 255, 255)
        Else If Index = 1 Then
            Call Graphics3D.SetObjectColor(SocketGizmos[Index], 255, 60, 60)
        Else If Index = 2 Then
            Call Graphics3D.SetObjectColor(SocketGizmos[Index], 70, 255, 90)
        Else

            Call Graphics3D.SetObjectColor(SocketGizmos[Index], 80, 140, 255)
        End If

    End For

    If Not GizmosReady Then
        Session.Ready = False

        Call DestroySocketGizmos()
    End If

End Sub

Sub DestroySocketGizmos()

    Dim Index As Number

    Call Graphics3D.DestroyParticleBatch3D(SocketMarkers)
    Call Graphics3D.DestroyMaterial3D(SocketMarkerMaterial)

    For Index = 0 To SocketGizmoCount - 1
        Call Graphics3D.DestroyObject3D(SocketGizmos[Index])
    End For

    SocketGizmoCount = 0
    SocketGizmosVisible = False
    ShowAllSocketOrigins = False

End Sub

Function SocketReferencePart(Name As Text) As Number

    Dim Result As Number

    Result = 0

    If ViewerProfiles.IsPartyCharacter(Session.ProfileIndex) Then

        Result = BODY_PART_INDEX

        If Name = "SwordBase" Or Name = "SwordTip" Then
            Result = WEAPON_PART_INDEX
        Else If (Name = "ShieldCenter" Or
            Name = "ShieldFireLeft" Or
            Name = "ShieldFireRight" Or
            Name = "ShieldFireTip") Then
            Result = SHIELD_PART_INDEX
        End If

    End If

    Return Result

End Function

Sub UpdateSocketGizmos()

    Dim SocketIndex As Number
    Dim Name As Text
    Dim PositionX1000 As Number
    Dim PositionY1000 As Number
    Dim PositionZ1000 As Number
    Dim AxisX1000 As Number
    Dim AxisY1000 As Number
    Dim AxisZ1000 As Number
    Dim AxisLength As Number
    Dim MatrixProperty As Number
    Dim Axis As Number
    Dim SocketCount As Number

    SocketCount = Character3D.SocketCount(Character)
    Name = Character3D.SocketName(Character, SelectedSocket)
    PositionX1000 = Character3D.SocketValueThousandths(
        Character,
        Name,
        Graphics3D.ANIMATOR_SOCKET_POSITION_X,
        SocketReferencePart(Name)
    )
    PositionY1000 = Character3D.SocketValueThousandths(
        Character,
        Name,
        Graphics3D.ANIMATOR_SOCKET_POSITION_Y,
        SocketReferencePart(Name)
    )
    PositionZ1000 = Character3D.SocketValueThousandths(
        Character,
        Name,
        Graphics3D.ANIMATOR_SOCKET_POSITION_Z,
        SocketReferencePart(Name)
    )

    For Axis = 0 To 3

        AxisX1000 = 0
        AxisY1000 = 0
        AxisZ1000 = 0

        If Axis > 0 Then

            MatrixProperty = Graphics3D.ANIMATOR_SOCKET_MATRIX_M11 + (Axis - 1) * 3
            AxisX1000 = Character3D.SocketValueThousandths(
                Character,
                Name,
                MatrixProperty,
                SocketReferencePart(Name)
            )
            AxisY1000 = Character3D.SocketValueThousandths(
                Character,
                Name,
                MatrixProperty + 1,
                SocketReferencePart(Name)
            )
            AxisZ1000 = Character3D.SocketValueThousandths(
                Character,
                Name,
                MatrixProperty + 2,
                SocketReferencePart(Name)
            )
            AxisLength = Max(1, Max(Abs(AxisX1000), Max(Abs(AxisY1000), Abs(AxisZ1000))))
            AxisX1000 = AxisX1000 * 8000 / AxisLength
            AxisY1000 = AxisY1000 * 8000 / AxisLength
            AxisZ1000 = AxisZ1000 * 8000 / AxisLength

        End If

        Call Graphics3D.SetObjectPosition(
            SocketGizmos[Axis],
            (PositionX1000 + AxisX1000) / 1000,
            (PositionY1000 + AxisY1000) / 1000,
            (PositionZ1000 + AxisZ1000) / 1000
        )
    End For

    If ShowAllSocketOrigins Then

        For SocketIndex = 0 To SocketCount - 1

            Name = Character3D.SocketName(Character, SocketIndex)
            PositionX1000 = Character3D.SocketValueThousandths(
                Character,
                Name,
                Graphics3D.ANIMATOR_SOCKET_POSITION_X,
                SocketReferencePart(Name)
            )
            PositionY1000 = Character3D.SocketValueThousandths(
                Character,
                Name,
                Graphics3D.ANIMATOR_SOCKET_POSITION_Y,
                SocketReferencePart(Name)
            )
            PositionZ1000 = Character3D.SocketValueThousandths(
                Character,
                Name,
                Graphics3D.ANIMATOR_SOCKET_POSITION_Z,
                SocketReferencePart(Name)
            )
            Session.Ready = Graphics3D.SetParticle3D(
                SocketMarkers,
                SocketIndex,
                PositionX1000 / 1000,
                PositionY1000 / 1000,
                PositionZ1000 / 1000,
                4,
                0
            ) And Session.Ready
            Session.Ready = Graphics3D.SetParticleColor3D(
                SocketMarkers,
                SocketIndex,
                120,
                220,
                255,
                75
            ) And Session.Ready
        End For

        Session.Ready = Graphics3D.CommitParticleBatch3D(SocketMarkers, SocketCount) And Session.Ready

    End If

End Sub

Function DrawSocketGizmos() As Boolean

    Dim Result As Boolean
    Dim Index As Number

    Result = True

    For Index = 0 To SocketGizmoCount - 1
        Result = Graphics3D.DrawObject3D(SocketGizmos[Index]) And Result
    End For

    If ShowAllSocketOrigins Then
        Result = Graphics3D.DrawParticleBatch3D(SocketMarkers) And Result
    End If

    Return Result

End Function

Sub CreateEpicGlow()

    Dim EmptyTexture As Core.Texture3D
    Dim CharacterModel As Core.Model3D
    Dim CharacterAnimator As Core.Animator3D
    Dim GlowReady As Boolean

    EpicGlowAvailable = ViewerProfiles.EpicGlowAvailable(Session.ProfileIndex)
    EpicGlowAvailable = Character3D.HasSocket(Character, "SwordBase") And EpicGlowAvailable
    EpicGlowAvailable = Character3D.HasSocket(Character, "SwordTip") And EpicGlowAvailable
    EpicGlowAvailable = Character3D.HasSocket(Character, "ShieldCenter") And EpicGlowAvailable
    EpicGlowVisible = ViewerProfiles.EpicGlowVisibleByDefault(Session.ProfileIndex) And EpicGlowAvailable

    If Not EpicGlowAvailable Then
        Return
    End If

    EpicGlowTexture = Graphics3D.LoadTexture3D(
        "TechnicalAssets\Generation2\VfxAtlas.png",
        Graphics3D.TEXTURE_FILTER_LINEAR,
        Graphics3D.TEXTURE_WRAP_CLAMP
    )
    GlowReady = EpicGlowTexture.Handle <> 0

    If GlowReady Then
        EpicGlowMaterial = Graphics3D.CreateEffectMaterial3D(
            EmptyTexture,
            Graphics3D.MATERIAL_ALPHA_ADDITIVE,
            220
        )
        GlowReady = EpicGlowMaterial.Handle <> 0
    End If

    If GlowReady Then
        EpicGlowParticleMaterial = Graphics3D.CreateEffectMaterial3D(
            EpicGlowTexture,
            Graphics3D.MATERIAL_ALPHA_ADDITIVE,
            220
        )
        GlowReady = EpicGlowParticleMaterial.Handle <> 0
    End If

    If GlowReady Then

        CharacterModel.Handle = Character3D.ModelHandle(Character)
        CharacterAnimator.Handle = Character3D.AnimatorHandle(Character)
        SwordGlow = Graphics3D.CreateModelPart3D(CharacterModel, WEAPON_PART_INDEX)
        ShieldGlow = Graphics3D.CreateModelPart3D(CharacterModel, SHIELD_PART_INDEX)
        GlowReady = SwordGlow.Handle <> 0 And ShieldGlow.Handle <> 0

    End If

    If GlowReady Then

        GlowReady = Graphics3D.SetObjectMaterial3D(SwordGlow, EpicGlowMaterial)
        GlowReady = Graphics3D.SetObjectAnimator3D(SwordGlow, CharacterAnimator) And GlowReady
        GlowReady = Graphics3D.SetObjectMaterial3D(ShieldGlow, EpicGlowMaterial)
        GlowReady = Graphics3D.SetObjectAnimator3D(ShieldGlow, CharacterAnimator) And GlowReady
        GlowReady = Graphics3D.SetObjectCullMode3D(
            ShieldGlow,
            Graphics3D.OBJECT_CULL_FRONT
        ) And GlowReady

        Call Graphics3D.SetObjectColor(SwordGlow, 255, 182, 48)
        Call Graphics3D.SetObjectOpacity(SwordGlow, 95)
        Call Graphics3D.SetObjectShadows3D(SwordGlow, False, False)
        Call Graphics3D.SetObjectColor(ShieldGlow, 255, 196, 64)

        If Session.ProfileIndex = ViewerProfiles.PROFILE_ORIN Then
            Call Graphics3D.SetObjectColor(SwordGlow, 255, 255, 255)
            Call Graphics3D.SetObjectColor(ShieldGlow, 255, 255, 255)
        End If

        Call Graphics3D.SetObjectOpacity(ShieldGlow, 90)
        Call Graphics3D.SetObjectShadows3D(ShieldGlow, False, False)

    End If

    If GlowReady Then
        SwordTrail = Graphics3D.CreateParticleBatch3D(
            EQUIPMENT_TRAIL_POINT_COUNT,
            EpicGlowParticleMaterial,
            Graphics3D.VFX_BILLBOARD_CAMERA,
            4,
            4
        )
        GlowReady = SwordTrail.Handle <> 0
    End If

    If GlowReady Then
        ShieldTrail = Graphics3D.CreateParticleBatch3D(
            EQUIPMENT_TRAIL_POINT_COUNT,
            EpicGlowParticleMaterial,
            Graphics3D.VFX_BILLBOARD_CAMERA,
            4,
            4
        )
        GlowReady = ShieldTrail.Handle <> 0
    End If

    If Not GlowReady Then
        Call DestroyEpicGlow()
    Else

        Call ResetEpicGlowTrails()
    End If

End Sub

Sub DestroyEpicGlow()

    Call Graphics3D.DestroyObject3D(SwordGlow)
    Call Graphics3D.DestroyParticleBatch3D(SwordTrail)
    Call Graphics3D.DestroyParticleBatch3D(ShieldTrail)
    Call Graphics3D.DestroyObject3D(ShieldGlow)
    Call Graphics3D.DestroyEffectMaterial3D(EpicGlowParticleMaterial)
    Call Graphics3D.DestroyEffectMaterial3D(EpicGlowMaterial)
    Call Graphics3D.DestroyTexture3D(EpicGlowTexture)

    EpicGlowAvailable = False
    EpicGlowVisible = False

End Sub

''' Resolve sockets through the actual equipment object AFTER pose calibration.
''' Its object matrix includes move/pivot edits and its wrist-decoupling policy.
Sub InvalidateVisualHistory()

    ''' Saturating serial plus a dirty bit stays safe even at the serial limit.
    VisualContinuityEpoch = Min(2147483647, VisualContinuityEpoch + 1)
    VisualHistoryDirty = True

End Sub

Sub UpdateEquipmentFire()

    If Session.ProfileIndex = ViewerProfiles.PROFILE_DRAGON Then
        Return
    End If

    If PartyMode And PartyPresentationState(0) = PARTY_STATE_KO Then
        Call ClearEquipmentFire()

        Return
    End If

    If Not SwordVisible Then
        Call HideSwordEffects()
    Else If Not SwordFireVisible Then
        Call ClearSwordFire()
    End If

    If Not ShieldVisible Then
        Call HideShieldEffects()
    Else If Not ShieldFireVisible Then
        Call ClearShieldFire()
    End If

    EquipmentFireFirstSample = VisualHistoryDirty Or EquipmentFireEpoch <> VisualContinuityEpoch

    If EquipmentFireFirstSample Then

        Call ClearEquipmentFire()

        If EpicGlowAvailable Then
            Call ResetEpicGlowTrails()
        End If

        EquipmentFireEpoch = VisualContinuityEpoch
        VisualHistoryDirty = False

    End If

    If FlameAnimationPaused Then
        FlamesWerePaused = True
        Return
    End If

    If Not SwordFireReady Then
        Return
    End If

    Call RecordOptionalFireFailure()

    Call UpdateSwordFire()
    Call UpdateShieldFire()

    FlamesWerePaused = FlameAnimationPaused

    Call RecordOptionalFireFailure()

End Sub

Sub UpdateOrinStorm()

    Dim Target As Core.Vector3
    Dim Clip As Text

    If Not DragonAvailable Or Not Character3D.IsValid(Dragon) Then
        Return
    End If

    Target = Character3D.SocketPosition(Dragon, "Chest")

    If (PartyMode Or Session.DragonInspection) And PartyReady Then
        Clip = Character3D.ClipName(PartyCompanion.Actor, PartyCompanion.Clip)

        Call OrinStorm.Update(OrinStormContext, PartyCompanion.Actor, Clip, Target,
            ViewerCameraState.Live, Timing.CameraElapsed,
            PartyCompanion.GlowVisible And (EpicGlowVisible Or Session.DragonInspection) And
                PartyPresentationState(1) <> PARTY_STATE_KO,
            SwordVisible, ShieldVisible, LightningAnimationPaused, Playback.ScenePaused, OrinLight)
    Else If Session.ProfileIndex = ViewerProfiles.PROFILE_ORIN Then
        Clip = Character3D.ClipName(Character, Playback.SelectedClip)

        Call OrinStorm.Update(OrinStormContext, Character, Clip, Target, ViewerCameraState.Live,
            Timing.CameraElapsed, EpicGlowVisible, SwordVisible, ShieldVisible,
            LightningAnimationPaused, Playback.ScenePaused, OrinLight)
    End If

End Sub

Sub AdvanceSceneVfx()

    Session.Ready = SceneVfx3D.BeginFrame(SceneVfxClock, Timing.CameraElapsed,
        FlameAnimationPaused, LightningAnimationPaused) And Session.Ready
    Session.Ready = SceneVfx3D.Advance(SceneVfxClock, ViewerCameraState.Live,
        FireInitialized, LightningInitialized) And Session.Ready

End Sub

Sub RecordOptionalFireFailure()

    If EquipmentFireFirstError = 0 And (SwordFireFailed Or ShieldFireFailed) Then

        EquipmentFireFirstError = Fire.Value(12, SwordFire)

        If EquipmentFireFirstError = 0 Then
            EquipmentFireFirstError = Fire.ERROR_RENDERER
        End If

    End If

End Sub

Sub UpdateSwordFire()

    Dim Base As Core.Vector3
    Dim Tip As Core.Vector3
    Dim Delta As Core.Vector3
    Dim Length As Number
    Dim Time As Number
    Dim Restart As Boolean
    Dim Ok As Boolean
    Dim Inheritance As Number

    If SwordFireFailed And SwordFire.Slot <> 0 Then
        Ok = Fire.Destroy(SwordFire)
    End If

    If Not SwordFireReady Or SwordFireFailed Then
        Return
    End If

    If Not SwordFireVisible Or Not SwordVisible Then

        If SwordFire.Slot <> 0 Then
            Ok = Fire.Destroy(SwordFire)
        End If

        Return

    End If

    Base = Character3D.SocketPosition(Character, "SwordBase", WEAPON_PART_INDEX)
    Tip = Character3D.SocketPosition(Character, "SwordTip", WEAPON_PART_INDEX)
    Delta.X = Tip.X - Base.X
    Delta.Y = Tip.Y - Base.Y
    Delta.Z = Tip.Z - Base.Z
    Length = Math3D.Length(Delta)
    Time = Character3D.AnimationTime(Character)

    If Length < 4 Or Length > 10000 Then
        SwordFireFailed = True
        Return
    End If

    ''' Loops and clip changes retain world-space particles; paused pose edits clear stale fire.
    Restart = False

    If Playback.ScenePaused And ViewerUiState.CalibrationEditing Then
        Restart = (Restart Or Base.X <> SwordFireBase.X Or Base.Y <> SwordFireBase.Y Or
            Base.Z <> SwordFireBase.Z Or Tip.X <> SwordFireTip.X Or
            Tip.Y <> SwordFireTip.Y Or Tip.Z <> SwordFireTip.Z)
    End If

    If Restart And SwordFire.Slot <> 0 Then
        Ok = Fire.Destroy(SwordFire)
    End If

    If SwordFire.Slot = 0 Then

        SwordFire = Fire.StartAt("PaladinFlameBlade", Base, 5701,
            Fire.QUALITY_HIGH, Fire.SIMULATION_AUTO, Max(2, Length / 12))
        SwordFireFailed = SwordFire.Slot = 0

        If SwordFireFailed Then
            Return
        End If

        Ok = Fire.SetSegment(SwordFire, Base, Tip)

    Else
        Ok = Fire.SetSegment(SwordFire, Base, Tip)

    End If

    ''' Low inheritance leaves the fuller flame behind the moving blade instead of throwing it ahead.
    Inheritance = 10

    If SelectedClipLabel() = "Walk" Then
        Inheritance = 15
    Else If SelectedClipLabel() = "Run" Then
        Inheritance = 20
    Else If SelectedClipLabel() = "Attack" Or SelectedClipLabel() = "Attack 2" Then
        Inheritance = 10
    End If

    If (Time < SwordFireTime Or
        Playback.SelectedClip <> SwordFireClip Or
        Playback.ScenePaused Or
        FlameAnimationPaused Or
        FlamesWerePaused Or
        EquipmentFireFirstSample) Then
        Inheritance = 0
    End If

    Call Fire.SetIntensity(SwordFire, 200)
    Call Fire.SetSourceVelocityInheritance(SwordFire, Inheritance)

    SwordFireFailed = Not Ok
    SwordFireBase = Base
    SwordFireTip = Tip
    SwordFireClip = Playback.SelectedClip
    SwordFireTime = Time

End Sub

Sub UpdateShieldFire()

    Dim Points[3] As Core.Vector3
    Dim Index As Number
    Dim NextIndex As Number
    Dim Time As Number
    Dim Restart As Boolean
    Dim Ok As Boolean

    If Not ShieldFlameStyle Then

        If Not ShieldVisible Or Not ShieldFireVisible Then
            Call ArinShieldRim.Shutdown()

            Return
        End If

        For Index = 0 To 2

            If ShieldFire[Index].Slot <> 0 Then
                Ok = Fire.Destroy(ShieldFire[Index])
            End If

        End For

        If (ShieldFireVisible And
            ShieldVisible And
            EpicGlowVisible) Then
            Call ArinShieldRim.Update(Character, ViewerCameraState.Live, Timing.CameraElapsed)
        Else

            Call ArinShieldRim.Shutdown()
        End If

        Return

    End If

    If ShieldFireFailed Then

        For Index = 0 To 2

            If ShieldFire[Index].Slot <> 0 Then
                Ok = Fire.Destroy(ShieldFire[Index])
            End If

        End For

        Return

    End If

    If Not ShieldFireVisible Or Not ShieldVisible Then

        For Index = 0 To 2

            If ShieldFire[Index].Slot <> 0 Then
                Ok = Fire.Destroy(ShieldFire[Index])
            End If

        End For

        Return

    End If

    Points[0] = Character3D.SocketPosition(Character, "ShieldFireLeft", SHIELD_PART_INDEX)
    Points[1] = Character3D.SocketPosition(Character, "ShieldFireRight", SHIELD_PART_INDEX)
    Points[2] = Character3D.SocketPosition(Character, "ShieldFireTip", SHIELD_PART_INDEX)
    Time = Character3D.AnimationTime(Character)
    Restart = False

    For Index = 0 To 2

        If Playback.ScenePaused And ViewerUiState.CalibrationEditing Then
            Restart = (Restart Or Points[Index].X <> ShieldFirePoints[Index].X Or
                Points[Index].Y <> ShieldFirePoints[Index].Y Or
                Points[Index].Z <> ShieldFirePoints[Index].Z)
        End If

    End For

    Ok = True

    For Index = 0 To 2

        If Restart And ShieldFire[Index].Slot <> 0 Then
            Ok = Fire.Destroy(ShieldFire[Index]) And Ok
        End If

        If ShieldFire[Index].Slot = 0 Then
            ShieldFire[Index] = Fire.StartAt("LineFire", Points[Index], 5710 + Index,
                Fire.QUALITY_HIGH, Fire.SIMULATION_AUTO, 3)
            Ok = ShieldFire[Index].Slot <> 0 And Ok
        End If

        NextIndex = (Index + 1) Mod 3
        Ok = Fire.SetSegment(ShieldFire[Index], Points[Index], Points[NextIndex]) And Ok

        Call Fire.SetIntensity(ShieldFire[Index], 75)
        Call Fire.SetSourceVelocityInheritance(ShieldFire[Index], 10)

        If (Time < ShieldFireTime Or
            Playback.SelectedClip <> ShieldFireClip Or
            Playback.ScenePaused Or
            FlameAnimationPaused Or
            FlamesWerePaused Or
            EquipmentFireFirstSample) Then
            Call Fire.SetSourceVelocityInheritance(ShieldFire[Index], 0)
        End If

        ShieldFirePoints[Index] = Points[Index]
    End For

    ShieldFireFailed = Not Ok
    ShieldFireClip = Playback.SelectedClip
    ShieldFireTime = Time

End Sub

Sub DrawShieldFire()

    Dim Index As Number
    Dim Ok As Boolean

    If Not ShieldVisible Or Not ShieldFireVisible Then
        Return
    End If

    If Not ShieldFlameStyle Then
        Call ArinShieldRim.Draw()

        Return
    End If

    If ShieldFireFailed Then
        Return
    End If

    Ok = True

    For Index = 0 To 2

        If ShieldFire[Index].Slot <> 0 Then
            Ok = Fire.Draw(ShieldFire[Index]) And Ok
        End If

    End For

    ShieldFireFailed = Not Ok

End Sub

Function UpdateEpicGlow() As Boolean

    Dim SwordBase As Core.Vector3
    Dim SwordCenter As Core.Vector3
    Dim SwordTip As Core.Vector3
    Dim ShieldCenter As Core.Vector3
    Dim Result As Boolean

    SwordBase = Character3D.SocketPosition(Character, "SwordBase", BODY_PART_INDEX, CalibrationChannelValue(Playback.SelectedClip, 18) <> 0)
    SwordTip = Character3D.SocketPosition(Character, "SwordTip", BODY_PART_INDEX, CalibrationChannelValue(Playback.SelectedClip, 18) <> 0)
    ShieldCenter = Character3D.SocketPosition(Character, "ShieldCenter", BODY_PART_INDEX, CalibrationChannelValue(Playback.SelectedClip, 19) <> 0)
    SwordCenter.X = (SwordBase.X + SwordTip.X) / 2
    SwordCenter.Y = (SwordBase.Y + SwordTip.Y) / 2
    SwordCenter.Z = (SwordBase.Z + SwordTip.Z) / 2

    If Session.ProfileIndex = ViewerProfiles.PROFILE_ARIN Then
        Call UpdateEpicGlowTrailState(SwordTip, ShieldCenter)
        Call AdvanceEpicGlowTrails(SwordTip, ShieldCenter)
    End If

    Result = UpdateEquipmentGlow(SwordGlow, SwordCenter)
    Result = UpdateEquipmentGlow(ShieldGlow, ShieldCenter) And Result
    Result = UpdateEpicGlowTrailBatches() And Result

    Return Result

End Function

Function UpdateEquipmentGlow(
    ByRef GlowObject As Core.Object3D,
    Center As Core.Vector3
) As Boolean

    Dim OutlineScale As Number
    Dim RotationY As Number
    Dim ScaleDelta As Number
    Dim PositionX As Number
    Dim PositionY As Number
    Dim PositionZ As Number
    Dim ActorPosition As Core.Vector3
    Dim Result As Boolean

    ActorPosition.X = Character3D.PositionX(Character)
    ActorPosition.Y = Character3D.PositionY(Character)
    ActorPosition.Z = Character3D.PositionZ(Character)
    ScaleDelta = Max(2, ViewerCameraState.Frame.ScalePercent / EQUIPMENT_GLOW_SCALE_DIVISOR)
    OutlineScale = ViewerCameraState.Frame.ScalePercent + ScaleDelta
    PositionX = (Center.X - ActorPosition.X) * ScaleDelta / ViewerCameraState.Frame.ScalePercent
    PositionY = (Center.Y - ActorPosition.Y) * ScaleDelta / ViewerCameraState.Frame.ScalePercent
    PositionZ = (Center.Z - ActorPosition.Z) * ScaleDelta / ViewerCameraState.Frame.ScalePercent
    PositionX = ActorPosition.X - PositionX
    PositionY = ActorPosition.Y - PositionY
    PositionZ = ActorPosition.Z - PositionZ

    RotationY = Character3D.RotationY(Character)

    Result = Graphics3D.SetObjectPositionChecked3D(GlowObject, PositionX, PositionY, PositionZ)
    Result = Graphics3D.SetObjectRotationChecked3D(GlowObject, 0, RotationY, 0) And Result
    Result = Graphics3D.SetObjectScaleChecked3D(
        GlowObject,
        OutlineScale,
        OutlineScale,
        OutlineScale
    ) And Result

    Return Result

End Function

Function DrawEquipmentGlow() As Boolean

    Dim Result As Boolean

    Result = True

    If SwordVisible Then
        Result = Graphics3D.DrawObject3D(SwordGlow)
    End If

    If (ShieldVisible And
        Not SwordFireReady And
        Session.ProfileIndex <> ViewerProfiles.PROFILE_ORIN) Then
        Result = Graphics3D.DrawObject3D(ShieldGlow) And Result
    End If

    Return Result

End Function

Sub ResetEpicGlowTrails()

    Dim SwordTip As Core.Vector3
    Dim ShieldCenter As Core.Vector3

    SwordTip = Character3D.SocketPosition(Character, "SwordTip", BODY_PART_INDEX)
    ShieldCenter = Character3D.SocketPosition(Character, "ShieldCenter", BODY_PART_INDEX)

    Call SeedEpicGlowTrails(SwordTip, ShieldCenter)

    EquipmentTrailAnimationTime = Character3D.AnimationTime(Character)
    SwordTrailActive = False
    ShieldTrailActive = False

End Sub

Sub SeedEpicGlowTrails(SwordTip As Core.Vector3, ShieldCenter As Core.Vector3)

    Dim Index As Number

    For Index = 0 To EQUIPMENT_TRAIL_POINT_COUNT - 1
        SwordTrailPoints[Index] = SwordTip
        ShieldTrailPoints[Index] = ShieldCenter
    End For

    EquipmentTrailElapsed = 0

End Sub

Sub UpdateEpicGlowTrailState(SwordTip As Core.Vector3, ShieldCenter As Core.Vector3)

    Dim AnimationTime As Number
    Dim NextSwordTrailActive As Boolean
    Dim NextShieldTrailActive As Boolean

    AnimationTime = Character3D.AnimationTime(Character)
    NextSwordTrailActive = (SwordVisible And
        (SelectedClipName() = "SwordAttack" Or SelectedClipName() = "SwordAttack2") And
        AnimationTime >= SWORD_TRAIL_START_MILLISECONDS And
        AnimationTime <= SWORD_TRAIL_END_MILLISECONDS)
    NextShieldTrailActive = (ShieldVisible And
        SelectedClipName() = "BlockImpact" And
        AnimationTime >= SHIELD_TRAIL_START_MILLISECONDS And
        AnimationTime <= SHIELD_TRAIL_END_MILLISECONDS)

    If ((NextSwordTrailActive And Not SwordTrailActive) Or
        (NextShieldTrailActive And Not ShieldTrailActive) Or
        AnimationTime < EquipmentTrailAnimationTime) Then
        Call SeedEpicGlowTrails(SwordTip, ShieldCenter)
    End If

    SwordTrailActive = NextSwordTrailActive
    ShieldTrailActive = NextShieldTrailActive
    EquipmentTrailAnimationTime = AnimationTime

End Sub

Sub AdvanceEpicGlowTrails(SwordTip As Core.Vector3, ShieldCenter As Core.Vector3)

    Dim Index As Number

    If Not SwordTrailActive And Not ShieldTrailActive Then
        Return
    End If

    EquipmentTrailElapsed = EquipmentTrailElapsed + Playback.AnimationUpdateElapsed

    If EquipmentTrailElapsed < EQUIPMENT_TRAIL_SAMPLE_MILLISECONDS Then
        Return
    End If

    For Index = 0 To EQUIPMENT_TRAIL_POINT_COUNT - 2
        SwordTrailPoints[Index] = SwordTrailPoints[Index + 1]
        ShieldTrailPoints[Index] = ShieldTrailPoints[Index + 1]
    End For

    SwordTrailPoints[EQUIPMENT_TRAIL_POINT_COUNT - 1] = SwordTip
    ShieldTrailPoints[EQUIPMENT_TRAIL_POINT_COUNT - 1] = ShieldCenter
    EquipmentTrailElapsed = EquipmentTrailElapsed Mod EQUIPMENT_TRAIL_SAMPLE_MILLISECONDS

End Sub

Function UpdateEpicGlowTrailBatches() As Boolean

    Dim ParticleSize As Number
    Dim Opacity As Number
    Dim Index As Number
    Dim Result As Boolean

    Result = True

    For Index = 0 To EQUIPMENT_TRAIL_POINT_COUNT - 1

        Opacity = Index * 7
        ParticleSize = Max(1, SWORD_TRAIL_PARTICLE_SIZE - 1 + Index / 2)
        Result = Graphics3D.SetParticle3D(
            SwordTrail,
            Index,
            SwordTrailPoints[Index].X,
            SwordTrailPoints[Index].Y,
            SwordTrailPoints[Index].Z,
            ParticleSize,
            0,
            4 + Index Mod 4
        ) And Result
        Result = Graphics3D.SetParticleColor3D(
            SwordTrail,
            Index,
            72,
            196,
            255,
            Opacity
        ) And Result
        ParticleSize = Max(1, SHIELD_TRAIL_PARTICLE_SIZE - 1 + Index / 2)
        Result = Graphics3D.SetParticle3D(
            ShieldTrail,
            Index,
            ShieldTrailPoints[Index].X,
            ShieldTrailPoints[Index].Y,
            ShieldTrailPoints[Index].Z,
            ParticleSize,
            0,
            Index Mod 4
        ) And Result
        Result = Graphics3D.SetParticleColor3D(
            ShieldTrail,
            Index,
            255,
            196,
            64,
            Opacity * 3 / 4
        ) And Result
    End For

    If SwordTrailActive Then
        Result = Graphics3D.CommitParticleBatch3D(
            SwordTrail,
            EQUIPMENT_TRAIL_POINT_COUNT
        ) And Result
    Else
        Result = Graphics3D.CommitParticleBatch3D(SwordTrail, 0) And Result
    End If

    If ShieldTrailActive Then
        Result = Graphics3D.CommitParticleBatch3D(
            ShieldTrail,
            EQUIPMENT_TRAIL_POINT_COUNT
        ) And Result
    Else
        Result = Graphics3D.CommitParticleBatch3D(ShieldTrail, 0) And Result
    End If

    Return Result

End Function

Function DrawEpicGlow() As Boolean

    Dim Result As Boolean

    Result = True

    If Session.ProfileIndex <> ViewerProfiles.PROFILE_ARIN Then
        Return True
    End If

    If SwordVisible Then
        Result = Graphics3D.DrawParticleBatch3D(SwordTrail)
    End If

    If ShieldVisible And Not SwordFireReady Then
        Result = Graphics3D.DrawParticleBatch3D(ShieldTrail) And Result
    End If

    Return Result

End Function

Sub CycleSocketDisplay()

    If Not SocketGizmosVisible Then
        SocketGizmosVisible = True
        ShowAllSocketOrigins = False
    Else If Not ShowAllSocketOrigins Then
        ShowAllSocketOrigins = True
    Else
        SocketGizmosVisible = False
        ShowAllSocketOrigins = False
    End If

End Sub

Sub SelectPreviousSocket()

    Dim SocketCount As Number

    SocketCount = Character3D.SocketCount(Character)
    SelectedSocket = (SelectedSocket + SocketCount - 1) Mod SocketCount

End Sub

Sub SelectNextSocket()

    SelectedSocket = (SelectedSocket + 1) Mod Character3D.SocketCount(Character)

End Sub

Sub AdjustPlaybackSpeed(Amount As Number)

    If PartyMode And PartyPreviewActive Then
        Call ViewerCalibration.SetTransferMessage(
            Calibration, "Resume Or Reset Before Changing Demo Speed")

        Return
    End If

    Call ViewerPlayback.AdjustSpeed(Playback, ActiveProfile.MinimumPlaybackSpeed,
        ActiveProfile.MaximumPlaybackSpeed, Amount)

    If PartyMode Then
        Call ResetPartyDemo()
    Else

        Call PlaySelectedClip()
    End If

End Sub

Sub RestartPresentation()

    If PartyMode And PartyReady Then
        Call ResetPartyInspector()

        Return
    End If

    Call ResetView()

    Call ViewerCamera.StartAutoOrbit(ViewerCameraState)

    Playback.AnimationCycleElapsed = 0
    Playback.SelectedClip = RuntimeClipForPresentationIndex(0)

    Call PlaySelectedClip()

End Sub

Sub ResetView()

    PartyPreviousCamera = 0
    PartyOrbitPhase1000 = 0

    Call ViewerCamera.Reset(
        ViewerCameraState,
        InitialViewerOrbitYaw(),
        DefaultZoomDegrees(),
        ZOOM_IN_LIMIT,
        ZOOM_OUT_LIMIT,
        96000
    )

End Sub

Sub ResetAll()

    If PartyUiBound Then

        Call CancelCalibrationEdit()
        Call RestorePartyPreview()
        Call EndPartyInspector()

    End If

    PartyPreviewActive = False

    If ViewerUiState.CalibrationEditing Then
        Call CancelCalibrationEdit()
    End If

    Playback.PlaybackSpeed = ActiveProfile.DefaultPlaybackSpeed
    Playback.ScenePaused = False
    FlameAnimationPaused = False
    LightningAnimationPaused = False
    SwordFireFailed = False
    ShieldFireFailed = False
    EquipmentFireFirstError = 0
    Playback.DemoEnabled = True
    ViewerCameraState.FitLocked = True
    LightingIndex = 0
    MaterialInspection = Graphics3D.MATERIAL_INSPECTION_LIT
    BackgroundIndex = 3
    SocketGizmosVisible = False
    ShowAllSocketOrigins = False
    FloorVisible = True
    GridVisible = True
    EpicGlowVisible = ViewerProfiles.EpicGlowVisibleByDefault(Session.ProfileIndex) And EpicGlowAvailable
    DragonVisible = DragonAvailable
    SwordVisible = True
    ShieldVisible = True
    SwordFireVisible = True
    ShieldFireVisible = True

    Call ViewerUi.Reset(ViewerUiState)
    Call ViewerInput.CancelCaptures(ViewerInputState)
    Call ViewerGizmo.Hide(ViewerGizmoState)
    Call ViewerCamera.CancelPointerControls(ViewerCameraState)

    Call ClearEquipmentFire()
    Call ApplyLighting()
    Call ApplyArenaFacing()

    If CalibrationAvailable Then
        Session.Ready = Character3D.SetPartVisible(Character, WEAPON_PART_INDEX, True) And Session.Ready
        Session.Ready = Character3D.SetPartVisible(Character, SHIELD_PART_INDEX, True) And Session.Ready
    End If

    Session.Ready = Graphics3D.SetMaterialInspection3D(MaterialInspection) And Session.Ready

    If PartyMode And PartyReady Then

        Call ResetPartyDemo()
        Call ResetView()

        Call ViewerCamera.SetAutoOrbit(ViewerCameraState, True)

    Else

        Call RestartPresentation()

    End If

End Sub

Sub ClearEquipmentFire()

    Call ClearSwordFire()
    Call ClearShieldFire()

End Sub

Sub ClearSwordFire()

    Dim Ok As Boolean

    If SwordFire.Slot <> 0 Then
        Ok = Fire.Destroy(SwordFire)
    End If

End Sub

Sub ClearShieldFire()

    Dim Index As Number
    Dim Ok As Boolean

    Call ArinShieldRim.Shutdown()

    For Index = 0 To 2

        If ShieldFire[Index].Slot <> 0 Then
            Ok = Fire.Destroy(ShieldFire[Index])
        End If

    End For

End Sub

Sub ClearEquipmentGlowTrails()

    Dim Ok As Boolean

    SwordTrailActive = False
    ShieldTrailActive = False

    If SwordTrail.Handle <> 0 Then
        Ok = Graphics3D.CommitParticleBatch3D(SwordTrail, 0)
    End If

    If ShieldTrail.Handle <> 0 Then
        Ok = Graphics3D.CommitParticleBatch3D(ShieldTrail, 0)
    End If

End Sub

Sub HideSwordEffects()

    Dim Ok As Boolean

    Call ClearSwordFire()

    SwordTrailActive = False

    If SwordTrail.Handle <> 0 Then
        Ok = Graphics3D.CommitParticleBatch3D(SwordTrail, 0)
    End If

End Sub

Sub HideShieldEffects()

    Dim Ok As Boolean

    Call ClearShieldFire()

    ShieldTrailActive = False

    If ShieldTrail.Handle <> 0 Then
        Ok = Graphics3D.CommitParticleBatch3D(ShieldTrail, 0)
    End If

End Sub

Sub SelectClip(Index As Number)

    Call BeginPartyPreview()
    Call CancelCalibrationEdit()

    Playback.SelectedClip = Index
    Playback.AnimationCycleElapsed = 0

    If Not PartyMode Then
        Playback.DemoEnabled = False
    End If

    ViewerUiState.CalibrationClearConfirm = False
    ViewerUiState.CalibrationClearAllStage = 0

    Call PlaySelectedClip()

End Sub

Sub SelectPresentationClip(Index As Number)

    Dim RuntimeClip As Number

    RuntimeClip = RuntimeClipForPresentationIndex(Index)

    If RuntimeClip >= 0 Then
        Call SelectClip(RuntimeClip)
    End If

End Sub

Function RuntimeClipForPresentationIndex(Index As Number) As Number

    Dim ClipIndex As Number
    Dim DesiredName As Text
    Dim Result As Number

    Result = -1

    If Index < 0 Or Index >= ViewerProfiles.ClipCount(Session.ProfileIndex) Then
        Return Result
    End If

    DesiredName = ViewerProfiles.ClipName(Session.ProfileIndex, Index)

    For ClipIndex = 0 To Character3D.ClipCount(Character) - 1

        If Character3D.ClipName(Character, ClipIndex) = DesiredName Then
            Return ClipIndex
        End If

    End For

    Return Result

End Function

Function PresentationIndexForRuntimeClip(RuntimeClip As Number) As Number

    Dim Index As Number
    Dim RuntimeName As Text
    Dim Result As Number

    Result = 0
    RuntimeName = Character3D.ClipName(Character, RuntimeClip)

    For Index = 0 To ViewerProfiles.ClipCount(Session.ProfileIndex) - 1

        If ViewerProfiles.ClipName(Session.ProfileIndex, Index) = RuntimeName Then
            Return Index
        End If

    End For

    Return Result

End Function

Sub StepAnimationFrame(Direction As Number)

    Dim SampleRate As Number
    Dim StepMilliseconds As Number
    Dim TargetTime As Number

    Call BeginPartyPreview()
    Call CancelCalibrationEdit()

    Playback.ScenePaused = True
    SampleRate = Character3D.ClipSampleRate(Character, Playback.SelectedClip)
    StepMilliseconds = Max(1, 1000 / Max(1, SampleRate))
    TargetTime = Character3D.AnimationTime(Character) + Direction * StepMilliseconds
    TargetTime = Max(0, Min(Character3D.ClipDuration(Character, Playback.SelectedClip), TargetTime))
    Session.Ready = Character3D.SetAnimationTime(Character, TargetTime) And Session.Ready

    Call InvalidateVisualHistory()

End Sub

Sub SeekFirstAnimationFrame()

    Call BeginPartyPreview()
    Call CancelCalibrationEdit()

    Playback.ScenePaused = True
    Playback.SelectedTimelineEvent = FirstClipEvent()
    Session.Ready = Character3D.SetAnimationTime(Character, 0) And Session.Ready

    Call InvalidateVisualHistory()

End Sub

Sub SeekCalibrationKeyframe(Direction As Number)

    Dim CandidateIndex As Number
    Dim CurrentFrame As Number
    Dim Index As Number
    Dim KeyCount As Number
    Dim TargetFrame As Number
    Dim TargetTime As Number

    ''' Navigation pauses even when this clip has no saved keys to visit.

    Call BeginPartyPreview()

    Playback.ScenePaused = True

    If Not CalibrationAvailable Then
        Return
    End If

    If ViewerUiState.CalibrationEditing Then
        Call CancelCalibrationEdit()
    End If

    KeyCount = ViewerCalibration.KeyCount(Calibration, Playback.SelectedClip)

    If KeyCount <= 0 Then
        Return
    End If

    CurrentFrame = CurrentAnimationFrame()

    If Direction < 0 Then

        CandidateIndex = KeyCount - 1

        For Index = 0 To KeyCount - 1

            If ViewerCalibration.KeyFrame(Calibration, Playback.SelectedClip, Index) < CurrentFrame Then
                CandidateIndex = Index
            End If

        End For

    Else
        CandidateIndex = 0

        For Index = 0 To KeyCount - 1

            If ViewerCalibration.KeyFrame(Calibration, Playback.SelectedClip, Index) > CurrentFrame Then
                CandidateIndex = Index
                Exit For
            End If

        End For

    End If

    TargetFrame = ViewerCalibration.KeyFrame(Calibration, Playback.SelectedClip, CandidateIndex)
    TargetTime = CalibrationFrameTimeMilliseconds(Playback.SelectedClip, TargetFrame)
    Session.Ready = Character3D.SetAnimationTime(Character, TargetTime) And Session.Ready

    Call InvalidateVisualHistory()

    Call UpdateCalibrationForCurrentFrame()
    Call ApplyWristCalibration()

End Sub

Sub SeekAuthoredEvent(Direction As Number)

    Dim CandidateIndex As Number
    Dim CandidateTime As Number
    Dim CurrentAnimationTime As Number
    Dim Duration As Number
    Dim EventIndex As Number
    Dim EventTime As Number

    CurrentAnimationTime = Character3D.AnimationTime(Character)
    Duration = Character3D.ClipDuration(Character, Playback.SelectedClip)

    If Direction < 0 Then
        CandidateTime = -1
    Else
        CandidateTime = Duration + 1
    End If

    CandidateIndex = 0

    For EventIndex = 1 To Character3D.EventCount(Character)

        If Character3D.EventClipIndex(Character, EventIndex) = Playback.SelectedClip Then

            EventTime = Character3D.EventTime(Character, EventIndex)

            If Direction < 0 And EventTime < CurrentAnimationTime Then

                If EventTime > CandidateTime Then
                    CandidateTime = EventTime
                    CandidateIndex = EventIndex
                End If

            Else If Direction > 0 And EventTime > CurrentAnimationTime Then

                If EventTime < CandidateTime Then
                    CandidateTime = EventTime
                    CandidateIndex = EventIndex
                End If

            End If

        End If

    End For

    If CandidateTime < 0 Then
        CandidateTime = 0
        CandidateIndex = 0
    Else If CandidateTime > Duration Then
        CandidateTime = Duration
        CandidateIndex = 0
    End If

    Playback.SelectedTimelineEvent = CandidateIndex
    Session.Ready = Character3D.SetAnimationTime(Character, CandidateTime) And Session.Ready

    Call InvalidateVisualHistory()

End Sub

Sub SeekFromPointer()

    Dim Duration As Number
    Dim TargetTime As Number

    Call BeginPartyPreview()
    Call CancelCalibrationEdit()

    Playback.ScenePaused = True

    Duration = Character3D.ClipDuration(Character, Playback.SelectedClip)
    TargetTime = (Pointer_X() - TIMELINE_LEFT) * Duration / Max(1, TimelineWidth())
    TargetTime = Max(0, Min(Duration, TargetTime))
    Playback.SelectedTimelineEvent = NearestClipEvent(TargetTime)
    Session.Ready = Character3D.SetAnimationTime(Character, TargetTime) And Session.Ready

    Call InvalidateVisualHistory()

End Sub

Function TimelineFrameFromPointer() As Number

    Dim Duration As Number
    Dim Result As Number
    Dim SampleRate As Number
    Dim TargetTime As Number

    Duration = Character3D.ClipDuration(Character, Playback.SelectedClip)
    TargetTime = (Pointer_X() - TIMELINE_LEFT) * Duration / Max(1, TimelineWidth())
    TargetTime = Max(0, Min(Duration, TargetTime))
    SampleRate = Max(1, Character3D.ClipSampleRate(Character, Playback.SelectedClip))
    Result = (TargetTime * SampleRate + 500) / 1000
    Result = Min(Character3D.ClipSampleCount(Character, Playback.SelectedClip) - 1, Max(0, Result))

    Return Result

End Function

Function TimelineKeyframeAtPointer() As Number

    Dim Duration As Number
    Dim Index As Number
    Dim KeyframeTime As Number
    Dim MarkerX As Number
    Dim Result As Number
    Dim TimelineY As Number
    Dim Width As Number

    Result = -1

    If Not CalibrationAvailable Then
        Return Result
    End If

    TimelineY = Window_Height() - 64

    If Not PointerInRectangle(
        TIMELINE_LEFT,
        TimelineY - TIMELINE_KEYFRAME_HIT_RADIUS,
        TimelineWidth(),
        TIMELINE_HEIGHT + TIMELINE_KEYFRAME_HIT_RADIUS * 2
    ) Then
        Return Result
    End If

    Duration = Max(1, Character3D.ClipDuration(Character, Playback.SelectedClip))
    Width = TimelineWidth()

    For Index = 0 To ViewerCalibration.KeyCount(Calibration, Playback.SelectedClip) - 1

        KeyframeTime = CalibrationFrameTimeMilliseconds(
            Playback.SelectedClip,
            ViewerCalibration.KeyFrame(Calibration, Playback.SelectedClip, Index)
        )
        MarkerX = TIMELINE_LEFT + KeyframeTime * Width / Duration

        If Abs(Pointer_X() - MarkerX) <= TIMELINE_KEYFRAME_HIT_RADIUS Then
            Result = Index
            Exit For
        End If

    End For

    Return Result

End Function

Sub BeginTimelineKeyframeDrag(KeyframeIndex As Number)

    Call BeginPartyPreview()
    Call ViewerInput.BeginTimelineKeyframeDrag(
        ViewerInputState,
        KeyframeIndex,
        ViewerCalibration.KeyFrame(Calibration, Playback.SelectedClip, KeyframeIndex)
    )

    Call UpdateTimelineKeyframeDrag()

End Sub

Sub UpdateTimelineKeyframeDrag()

    Dim ExistingKeyframe As Number
    Dim TargetFrame As Number
    Dim TargetTime As Number

    TargetFrame = TimelineFrameFromPointer()
    ExistingKeyframe = CalibrationKeyframeIndex(Playback.SelectedClip, TargetFrame)

    If ExistingKeyframe < 0 Or ExistingKeyframe = ViewerInputState.TimelineDraggedKeyframe Then
        ViewerInputState.TimelineDraggedTargetFrame = TargetFrame
    End If

    TargetTime = CalibrationFrameTimeMilliseconds(Playback.SelectedClip, ViewerInputState.TimelineDraggedTargetFrame)
    Session.Ready = Character3D.SetAnimationTime(Character, TargetTime) And Session.Ready

    Call InvalidateVisualHistory()

End Sub

Sub FinishTimelineKeyframeDrag()

    Call ViewerInput.FinishTimelineGesture(ViewerInputState)

    If ViewerInputState.TimelineDraggedTargetFrame = ViewerInputState.TimelineDraggedOriginalFrame Then
        Return
    End If

    If Not ViewerCalibration.MoveKey(
        Calibration,
        Playback.SelectedClip,
        ViewerInputState.TimelineDraggedKeyframe,
        ViewerInputState.TimelineDraggedTargetFrame
    ) Then
        Return
    End If

    Call RefreshCalibrationSavedStatus()
    Call SaveCalibrationKeyframes()
    Call UpdateCalibrationForCurrentFrame()
    Call ApplyWristCalibration()

End Sub

Sub CycleLighting()

    LightingIndex = (LightingIndex + 1) Mod 4

    Call ApplyLighting()

End Sub

Sub ApplyLighting()

    If LightingIndex = 0 Then

        Session.Ready = Graphics3D.ClearAdditionalLights3DChecked() And Session.Ready
        Session.Ready = Graphics3D.SetAmbientLight3D(255, 255, 255, 68) And Session.Ready
        Session.Ready = Graphics3D.SetDirectionalLight3D(-35, -80, 25, 255, 248, 235, 220) And Session.Ready
        Session.Ready = Graphics3D.SetPointLight3D(0, -80, 120, -30, 170, 205, 255, 260, 360) And Session.Ready
        Session.Ready = Graphics3D.SetPointLight3D(1, 80, 80, 0, 255, 205, 145, 180, 300) And Session.Ready

        Call Scene3D.UseCustomLighting()

    Else If LightingIndex = 1 Then

        Session.Ready = Scene3D.UseLighting("CharacterStudio") And Session.Ready

    Else If LightingIndex = 2 Then

        Session.Ready = Scene3D.UseLighting("Daylight") And Session.Ready

    Else
        Session.Ready = Scene3D.UseLighting("Moonlight") And Session.Ready

    End If

End Sub

Sub ConfigureCalibration()

    Dim Index As Number
    Dim Name As Text

    SwordWristNode = -1
    ShieldWristNode = -1

    For Index = 0 To Character3D.SocketCount(Character) - 1

        Name = Character3D.SocketName(Character, Index)

        If Name = "HandRight" Then
            SwordWristNode = Character3D.SocketNodeIndex(Character, Index)
        Else If Name = "HandLeft" Then
            ShieldWristNode = Character3D.SocketNodeIndex(Character, Index)
        End If

    End For

    CalibrationAvailable = (ViewerProfiles.IsPartyCharacter(Session.ProfileIndex) And
        Character3D.PartCount(Character) > WEAPON_PART_INDEX And
        SwordWristNode >= 0 And
        ShieldWristNode >= 0)
    Session.CharacterSwitchBlocked = False

    Call ViewerUi.ResetCalibration(
        ViewerUiState,
        CALIBRATION_TARGET_SWORD_WRIST,
        CALIBRATION_AXIS_X,
        CALIBRATION_TRANSFORM_ROTATE
    )
    Call ViewerGizmo.Reset(ViewerGizmoState)

    Call ViewerCalibration.Configure(
        Calibration,
        Session.ProfileIndex,
        Calibration.KeyBase,
        CalibrationAvailable,
        Character
    )

End Sub

Sub OpenSavedCalibrationJson()

    Call ViewerCalibration.OpenOrDownload(Calibration, Character)

End Sub

Sub DownloadSavedCalibrationJson()

    Call ViewerCalibration.Download(Calibration, Character)

End Sub

Sub HandleCalibrationImport()

    Dim Accepted As Boolean
    Dim WasPending As Boolean

    Call BeginPartyPreview()

    Playback.ScenePaused = True

    If Not PartyMode Then
        Playback.DemoEnabled = False
    End If

    WasPending = Calibration.ImportPending
    Accepted = ViewerCalibration.ImportOrCommit(
        Calibration, Character, Playback.SelectedClip, ViewerUiState.CalibrationEditing)

    If Accepted And WasPending Then

        Call UpdateCalibrationForCurrentFrame()
        Call ApplyWristCalibration()
        Call ApplyEquipmentCalibration()
        Call InvalidateVisualHistory()

    End If

End Sub

Function PrepareCalibrationImport(Contents As Text) As Boolean

    Dim Result As Boolean

    Result = ViewerCalibration.PrepareImport(
        Calibration, Character, Contents, ViewerUiState.CalibrationEditing)

    Return Result

End Function

Function CommitCalibrationImport() As Boolean

    Dim Result As Boolean

    Result = ViewerCalibration.CommitImport(
        Calibration, Character, Playback.SelectedClip, ViewerUiState.CalibrationEditing)

    If Result Then

        Call UpdateCalibrationForCurrentFrame()
        Call ApplyWristCalibration()
        Call ApplyEquipmentCalibration()
        Call InvalidateVisualHistory()

    End If

    Return Result

End Function

Function SavedCalibrationJson() As Text

    Dim Result As Text

    Result = ViewerCalibration.SavedJson(Calibration, Character)

    Return Result

End Function

Sub ClearCalibrationMemory()

    Call ViewerCalibration.ResetBank(Calibration)

End Sub

Sub SaveCalibrationKeyframes(Optional Persist As Boolean = True)

    Dim SavedSuccessfully As Boolean

    SavedSuccessfully = ViewerCalibration.Persist(
        Calibration, Character, Playback.SelectedClip, ViewerUiState.CalibrationEditing, Persist)

    If SavedSuccessfully And Persist Then
        Call InvalidateVisualHistory()
    End If

End Sub

Function CalibrationKeyframeIndex(Clip As Number, FrameValue As Number) As Number

    Dim Result As Number

    Result = ViewerCalibration.KeyIndex(Calibration, Clip, FrameValue)

    Return Result

End Function

Function StoreCalibrationKeyframe(Clip As Number, FrameValue As Number) As Boolean

    Dim Result As Boolean

    Result = ViewerCalibration.StoreKey(Calibration, Clip, FrameValue)

    Return Result

End Function

Sub RefreshCalibrationSavedStatus()

    Call ViewerCalibration.RefreshSaved(Calibration, Character)

End Sub

Function CalibrationChannelValue(Clip As Number, Channel As Number) As Number

    Dim Result As Number

    Result = ViewerCalibration.ChannelValue(Calibration, Clip, Channel)

    Return Result

End Function

Sub SetCalibrationChannelValue(Clip As Number, Channel As Number, Value As Number)

    Call ViewerCalibration.SetChannelValue(Calibration, Clip, Channel, Value)

End Sub

Function CurrentAnimationFrame() As Number

    Dim Result As Number

    Result = ViewerCalibration.CurrentAnimationFrame(Character, Playback.SelectedClip)

    Return Result

End Function

Function CalibrationFrameTimeMilliseconds(Clip As Number, FrameValue As Number) As Number

    Dim Result As Number

    Result = ViewerCalibration.FrameTimeMilliseconds(Character, Clip, FrameValue)

    Return Result

End Function

Sub UpdateCalibrationForCurrentFrame()

    If Not CalibrationAvailable Then
        Return
    End If

    Call ViewerCalibration.Evaluate(
        Calibration,
        Character,
        Playback.SelectedClip,
        CurrentAnimationFrame(),
        ViewerUiState.CalibrationEditing And Calibration.OwnerProfile = Session.ProfileIndex
    )

End Sub

Sub DeleteCurrentCalibrationKeyframe()

    Dim CurrentFrame As Number

    CurrentFrame = CurrentAnimationFrame()

    If Not ViewerCalibration.DeleteKey(
        Calibration, Playback.SelectedClip, CurrentFrame) Then
        Return
    End If

    Calibration.SaveLimitReached = False
    ViewerUiState.CalibrationClearConfirm = False
    ViewerUiState.CalibrationClearAllStage = 0

    Call RefreshCalibrationSavedStatus()
    Call SaveCalibrationKeyframes()
    Call UpdateCalibrationForCurrentFrame()
    Call ApplyWristCalibration()

End Sub

Sub CopyCurrentCalibrationKeyframe()

    Call ViewerCalibration.CopyKey(
        Calibration, Playback.SelectedClip, CurrentAnimationFrame())

End Sub

Sub ReloadCurrentCalibrationKeyframe()

    Dim Channel As Number
    Dim CurrentFrame As Number
    Dim CurrentKeyframe As Number

    CurrentFrame = CurrentAnimationFrame()
    CurrentKeyframe = CalibrationKeyframeIndex(Playback.SelectedClip, CurrentFrame)

    If CurrentKeyframe < 0 Then
        Return
    End If

    For Channel = 0 To CALIBRATION_CHANNEL_COUNT - 1

        Call SetCalibrationChannelValue(
            Playback.SelectedClip,
            Channel,
            ViewerCalibration.KeyValue(
                Calibration, Playback.SelectedClip, CurrentKeyframe, Channel)
        )
    End For

    Calibration.SaveLimitReached = False
    ViewerUiState.CalibrationClearConfirm = False
    ViewerUiState.CalibrationClearAllStage = 0

    Call ApplyWristCalibration()
    Call ApplyEquipmentCalibration()
    Call FinishCalibrationEdit()

    Call InvalidateVisualHistory()

End Sub

Sub PasteCalibrationKeyframe()

    Dim CurrentFrame As Number
    Dim SavedSuccessfully As Boolean

    If Not ViewerCalibration.PasteClipboard(Calibration, Playback.SelectedClip) Then
        Return
    End If

    CurrentFrame = CurrentAnimationFrame()
    SavedSuccessfully = ViewerCalibration.CommitCurrentKey(
        Calibration, Character, Playback.SelectedClip, CurrentFrame, ViewerUiState.CalibrationEditing)

    If SavedSuccessfully Then

        Call UpdateCalibrationForCurrentFrame()
        Call ApplyWristCalibration()
        Call InvalidateVisualHistory()

    End If

End Sub

Sub ApplyWristCalibration()

    If Not CalibrationAvailable Then
        Return
    End If

    Session.Ready = Character3D.SetNodeRotationOffset(
        Character,
        SwordWristNode,
        CalibrationChannelValue(Playback.SelectedClip, CALIBRATION_AXIS_X),
        CalibrationChannelValue(Playback.SelectedClip, CALIBRATION_AXIS_Y),
        CalibrationChannelValue(Playback.SelectedClip, CALIBRATION_AXIS_Z)
    ) And Session.Ready
    Session.Ready = Character3D.SetNodeRotationOffset(
        Character,
        ShieldWristNode,
        CalibrationChannelValue(Playback.SelectedClip, 3 + CALIBRATION_AXIS_X),
        CalibrationChannelValue(Playback.SelectedClip, 3 + CALIBRATION_AXIS_Y),
        CalibrationChannelValue(Playback.SelectedClip, 3 + CALIBRATION_AXIS_Z)
    ) And Session.Ready

End Sub

Sub ApplyEquipmentCoupling()

    Session.Ready = Character3D.SetPartNodeOffsetsEnabled(
        Character, WEAPON_PART_INDEX, CalibrationChannelValue(Playback.SelectedClip, 18) = 0
    ) And Session.Ready
    Session.Ready = Character3D.SetPartNodeOffsetsEnabled(
        Character, SHIELD_PART_INDEX, CalibrationChannelValue(Playback.SelectedClip, 19) = 0
    ) And Session.Ready

    If EpicGlowAvailable Then
        Session.Ready = Graphics3D.SetObjectNodeOffsetsEnabled3D(SwordGlow, CalibrationChannelValue(Playback.SelectedClip, 18) = 0) And Session.Ready
        Session.Ready = Graphics3D.SetObjectNodeOffsetsEnabled3D(ShieldGlow, CalibrationChannelValue(Playback.SelectedClip, 19) = 0) And Session.Ready
    End If

End Sub

Sub ApplyEquipmentCalibration()

    Dim GlowReady As Boolean
    Dim ShieldPivotX1000 As Number
    Dim ShieldPivotY1000 As Number
    Dim ShieldPivotZ1000 As Number
    Dim SwordPivotX1000 As Number
    Dim SwordPivotY1000 As Number
    Dim SwordPivotZ1000 As Number

    Call ApplyEquipmentCoupling()

    SwordPivotX1000 = Character3D.SocketValueThousandths(
        Character,
        "HandRight",
        Graphics3D.ANIMATOR_SOCKET_POSITION_X,
        BODY_PART_INDEX
    )
    SwordPivotY1000 = Character3D.SocketValueThousandths(
        Character,
        "HandRight",
        Graphics3D.ANIMATOR_SOCKET_POSITION_Y,
        BODY_PART_INDEX
    )
    SwordPivotZ1000 = Character3D.SocketValueThousandths(
        Character,
        "HandRight",
        Graphics3D.ANIMATOR_SOCKET_POSITION_Z,
        BODY_PART_INDEX
    )
    ShieldPivotX1000 = Character3D.SocketValueThousandths(
        Character,
        "HandLeft",
        Graphics3D.ANIMATOR_SOCKET_POSITION_X,
        BODY_PART_INDEX
    )
    ShieldPivotY1000 = Character3D.SocketValueThousandths(
        Character,
        "HandLeft",
        Graphics3D.ANIMATOR_SOCKET_POSITION_Y,
        BODY_PART_INDEX
    )
    ShieldPivotZ1000 = Character3D.SocketValueThousandths(
        Character,
        "HandLeft",
        Graphics3D.ANIMATOR_SOCKET_POSITION_Z,
        BODY_PART_INDEX
    )
    Session.Ready = Character3D.SetPartPositionOffset(
        Character,
        WEAPON_PART_INDEX,
        CalibrationChannelValue(Playback.SelectedClip, 12 + CALIBRATION_AXIS_X),
        CalibrationChannelValue(Playback.SelectedClip, 12 + CALIBRATION_AXIS_Y),
        CalibrationChannelValue(Playback.SelectedClip, 12 + CALIBRATION_AXIS_Z)
    ) And Session.Ready

    Call ViewerSession.CaptureFailure(Session, 71)

    Session.Ready = Character3D.SetPartPositionOffset(
        Character,
        SHIELD_PART_INDEX,
        CalibrationChannelValue(Playback.SelectedClip, 15 + CALIBRATION_AXIS_X),
        CalibrationChannelValue(Playback.SelectedClip, 15 + CALIBRATION_AXIS_Y),
        CalibrationChannelValue(Playback.SelectedClip, 15 + CALIBRATION_AXIS_Z)
    ) And Session.Ready

    Call ViewerSession.CaptureFailure(Session, 72)

    Session.Ready = Character3D.SetPartPivotRotationThousandths(
        Character,
        WEAPON_PART_INDEX,
        SwordPivotX1000,
        SwordPivotY1000,
        SwordPivotZ1000,
        CalibrationChannelValue(Playback.SelectedClip, 6 + CALIBRATION_AXIS_X),
        CalibrationChannelValue(Playback.SelectedClip, 6 + CALIBRATION_AXIS_Y),
        CalibrationChannelValue(Playback.SelectedClip, 6 + CALIBRATION_AXIS_Z)
    ) And Session.Ready

    Call ViewerSession.CaptureFailure(Session, 73)

    Session.Ready = Character3D.SetPartPivotRotationThousandths(
        Character,
        SHIELD_PART_INDEX,
        ShieldPivotX1000,
        ShieldPivotY1000,
        ShieldPivotZ1000,
        CalibrationChannelValue(Playback.SelectedClip, 9 + CALIBRATION_AXIS_X),
        CalibrationChannelValue(Playback.SelectedClip, 9 + CALIBRATION_AXIS_Y),
        CalibrationChannelValue(Playback.SelectedClip, 9 + CALIBRATION_AXIS_Z)
    ) And Session.Ready

    Call ViewerSession.CaptureFailure(Session, 74)

    If EpicGlowVisible Then

        GlowReady = Graphics3D.SetObjectPositionChecked3D(
            SwordGlow,
            SwordGlow.Position.X + CalibrationChannelValue(Playback.SelectedClip, 12 + CALIBRATION_AXIS_X),
            SwordGlow.Position.Y + CalibrationChannelValue(Playback.SelectedClip, 12 + CALIBRATION_AXIS_Y),
            SwordGlow.Position.Z + CalibrationChannelValue(Playback.SelectedClip, 12 + CALIBRATION_AXIS_Z)
        )
        GlowReady = Graphics3D.SetObjectPositionChecked3D(
            ShieldGlow,
            ShieldGlow.Position.X + CalibrationChannelValue(Playback.SelectedClip, 15 + CALIBRATION_AXIS_X),
            ShieldGlow.Position.Y + CalibrationChannelValue(Playback.SelectedClip, 15 + CALIBRATION_AXIS_Y),
            ShieldGlow.Position.Z + CalibrationChannelValue(Playback.SelectedClip, 15 + CALIBRATION_AXIS_Z)
        ) And GlowReady

        GlowReady = Graphics3D.SetObjectPivotRotationThousandths3D(
            SwordGlow,
            SwordPivotX1000,
            SwordPivotY1000,
            SwordPivotZ1000,
            CalibrationChannelValue(Playback.SelectedClip, 6 + CALIBRATION_AXIS_X),
            CalibrationChannelValue(Playback.SelectedClip, 6 + CALIBRATION_AXIS_Y),
            CalibrationChannelValue(Playback.SelectedClip, 6 + CALIBRATION_AXIS_Z)
        ) And GlowReady
        GlowReady = Graphics3D.SetObjectPivotRotationThousandths3D(
            ShieldGlow,
            ShieldPivotX1000,
            ShieldPivotY1000,
            ShieldPivotZ1000,
            CalibrationChannelValue(Playback.SelectedClip, 9 + CALIBRATION_AXIS_X),
            CalibrationChannelValue(Playback.SelectedClip, 9 + CALIBRATION_AXIS_Y),
            CalibrationChannelValue(Playback.SelectedClip, 9 + CALIBRATION_AXIS_Z)
        ) And GlowReady

        If Not GlowReady Then
            EpicGlowVisible = False
        End If

    End If

End Sub

Function CurrentCalibrationValue() As Number

    Dim Result As Number

    If (ViewerUiState.CalibrationTransform = CALIBRATION_TRANSFORM_MOVE And
        ViewerUiState.CalibrationTarget = CALIBRATION_TARGET_SWORD) Then
        Result = CalibrationChannelValue(Playback.SelectedClip, 12 + ViewerUiState.CalibrationAxis)
    Else If (ViewerUiState.CalibrationTransform = CALIBRATION_TRANSFORM_MOVE And
        ViewerUiState.CalibrationTarget = CALIBRATION_TARGET_SHIELD) Then
        Result = CalibrationChannelValue(Playback.SelectedClip, 15 + ViewerUiState.CalibrationAxis)
    Else If ViewerUiState.CalibrationTarget = CALIBRATION_TARGET_SWORD_WRIST Then
        Result = CalibrationChannelValue(Playback.SelectedClip, ViewerUiState.CalibrationAxis)
    Else If ViewerUiState.CalibrationTarget = CALIBRATION_TARGET_SHIELD_WRIST Then
        Result = CalibrationChannelValue(Playback.SelectedClip, 3 + ViewerUiState.CalibrationAxis)
    Else If ViewerUiState.CalibrationTarget = CALIBRATION_TARGET_SWORD Then
        Result = CalibrationChannelValue(Playback.SelectedClip, 6 + ViewerUiState.CalibrationAxis)
    Else
        Result = CalibrationChannelValue(Playback.SelectedClip, 9 + ViewerUiState.CalibrationAxis)
    End If

    Return Result

End Function

Function CalibrationMinimumValue() As Number

    Dim Result As Number

    If ViewerUiState.CalibrationTransform = CALIBRATION_TRANSFORM_MOVE Then
        Result = CALIBRATION_MINIMUM_POSITION
    Else
        Result = CALIBRATION_MINIMUM_DEGREES
    End If

    Return Result

End Function

Function CalibrationMaximumValue() As Number

    Dim Result As Number

    If ViewerUiState.CalibrationTransform = CALIBRATION_TRANSFORM_MOVE Then
        Result = CALIBRATION_MAXIMUM_POSITION
    Else
        Result = CALIBRATION_MAXIMUM_DEGREES
    End If

    Return Result

End Function

Function CalibrationTransformLabel() As Text

    Dim Result As Text

    If ViewerUiState.CalibrationTransform = CALIBRATION_TRANSFORM_MOVE Then
        Result = "Move"
    Else
        Result = "Rotate"
    End If

    Return Result

End Function

Function CalibrationUnitLabel() As Text

    Dim Result As Text

    If ViewerUiState.CalibrationTransform = CALIBRATION_TRANSFORM_MOVE Then
        Result = "units"
    Else
        Result = "degrees"
    End If

    Return Result

End Function

Sub BeginCalibrationEdit()

    If ViewerUiState.CalibrationEditing Then
        Return
    End If

    Call BeginPartyPreview()

    Call ViewerUi.BeginCalibrationEdit(
        ViewerUiState,
        Playback.SelectedClip,
        CurrentAnimationFrame(),
        ViewerCameraState.AutoOrbit
    )

    Call ViewerCalibration.CaptureEdit(Calibration, Playback.SelectedClip)
    Call ViewerCamera.SetAutoOrbit(ViewerCameraState, False)
    Call InvalidateVisualHistory()

End Sub

Sub FinishCalibrationEdit()

    ViewerGizmoState.GripAnchorActive = False

    If Not ViewerUiState.CalibrationEditing Then
        Return
    End If

    Session.CharacterSwitchBlocked = False

    Call ViewerUi.FinishCalibrationEdit(ViewerUiState)
    Call ViewerGizmo.FinishDrag(ViewerGizmoState)
    Call ViewerCamera.SetAutoOrbit(ViewerCameraState, ViewerUiState.CalibrationAutoOrbitWasEnabled)

    Call InvalidateVisualHistory()

End Sub

Sub CancelCalibrationEdit()

    If Not ViewerUiState.CalibrationEditing Then
        Return
    End If

    Call ViewerCalibration.RestoreEdit(Calibration, ViewerUiState.CalibrationEditingClip)
    Call ApplyWristCalibration()
    Call ApplyEquipmentCalibration()
    Call FinishCalibrationEdit()

End Sub

Sub SetCurrentCalibrationValue(Value As Number)

    Dim ClampedValue As Number
    Dim HoldGrip As Boolean
    Dim PartIndex As Number
    Dim SocketName As Text
    Dim PreviousValue As Number

    PreviousValue = CurrentCalibrationValue()
    ViewerGizmoState.GripLimit = False

    HoldGrip = (ViewerGizmoState.HoldGrip And ViewerUiState.CalibrationTransform = CALIBRATION_TRANSFORM_ROTATE And
        ViewerUiState.CalibrationTarget >= CALIBRATION_TARGET_SWORD)

    If HoldGrip Then

        PartIndex = WEAPON_PART_INDEX
        SocketName = "HandRight"

        If ViewerUiState.CalibrationTarget = CALIBRATION_TARGET_SHIELD Then
            PartIndex = SHIELD_PART_INDEX
            SocketName = "HandLeft"
        End If

        If (Not ViewerGizmoState.GripAnchorActive Or
            ViewerGizmoState.GripAnchorTarget <> ViewerUiState.CalibrationTarget Or
            ViewerGizmoState.GripAnchorFrame <> CurrentAnimationFrame()) Then

            ViewerGizmoState.GripAnchor = EquipmentGripThousandths(PartIndex, SocketName)
            ViewerGizmoState.GripAnchorActive = True
            ViewerGizmoState.GripAnchorTarget = ViewerUiState.CalibrationTarget
            ViewerGizmoState.GripAnchorFrame = CurrentAnimationFrame()
            ViewerGizmoState.GripBasePosition.X = CalibrationChannelValue(Playback.SelectedClip, 12 + 0)
            ViewerGizmoState.GripBasePosition.Y = CalibrationChannelValue(Playback.SelectedClip, 12 + 1)
            ViewerGizmoState.GripBasePosition.Z = CalibrationChannelValue(Playback.SelectedClip, 12 + 2)

            If PartIndex = SHIELD_PART_INDEX Then

                ViewerGizmoState.GripBasePosition.X = CalibrationChannelValue(Playback.SelectedClip, 15 + 0)
                ViewerGizmoState.GripBasePosition.Y = CalibrationChannelValue(Playback.SelectedClip, 15 + 1)
                ViewerGizmoState.GripBasePosition.Z = CalibrationChannelValue(Playback.SelectedClip, 15 + 2)

            End If

        End If

    Else
        ViewerGizmoState.GripAnchorActive = False

    End If

    Call BeginCalibrationEdit()

    If ViewerUiState.CalibrationTransform = CALIBRATION_TRANSFORM_MOVE Then
        ClampedValue = Min(CALIBRATION_MAXIMUM_POSITION,
            Max(CALIBRATION_MINIMUM_POSITION, Value))
    Else
        ClampedValue = Min(CALIBRATION_MAXIMUM_DEGREES,
            Max(CALIBRATION_MINIMUM_DEGREES, Value))
    End If

    If (ViewerUiState.CalibrationTransform = CALIBRATION_TRANSFORM_MOVE And
        ViewerUiState.CalibrationTarget = CALIBRATION_TARGET_SWORD) Then
        Call SetCalibrationChannelValue(Playback.SelectedClip, 12 + ViewerUiState.CalibrationAxis, ClampedValue)
    Else If (ViewerUiState.CalibrationTransform = CALIBRATION_TRANSFORM_MOVE And
        ViewerUiState.CalibrationTarget = CALIBRATION_TARGET_SHIELD) Then
        Call SetCalibrationChannelValue(Playback.SelectedClip, 15 + ViewerUiState.CalibrationAxis, ClampedValue)
    Else If ViewerUiState.CalibrationTarget = CALIBRATION_TARGET_SWORD_WRIST Then
        Call SetCalibrationChannelValue(Playback.SelectedClip, ViewerUiState.CalibrationAxis, ClampedValue)
    Else If ViewerUiState.CalibrationTarget = CALIBRATION_TARGET_SHIELD_WRIST Then
        Call SetCalibrationChannelValue(Playback.SelectedClip, 3 + ViewerUiState.CalibrationAxis, ClampedValue)
    Else If ViewerUiState.CalibrationTarget = CALIBRATION_TARGET_SWORD Then
        Call SetCalibrationChannelValue(Playback.SelectedClip, 6 + ViewerUiState.CalibrationAxis, ClampedValue)
    Else

        Call SetCalibrationChannelValue(Playback.SelectedClip, 9 + ViewerUiState.CalibrationAxis, ClampedValue)
    End If

    Calibration.SaveLimitReached = False
    ViewerUiState.CalibrationClearConfirm = False

    Call ViewerCamera.SetAutoOrbit(ViewerCameraState, False)

    Call ApplyWristCalibration()
    Call ApplyEquipmentCalibration()

    If HoldGrip Then

        If Not RestoreEquipmentGrip(PartIndex, SocketName) Then

            ViewerGizmoState.GripLimit = True

            If PartIndex = WEAPON_PART_INDEX Then
                Call SetCalibrationChannelValue(Playback.SelectedClip, 6 + ViewerUiState.CalibrationAxis, PreviousValue)
            Else

                Call SetCalibrationChannelValue(Playback.SelectedClip, 9 + ViewerUiState.CalibrationAxis, PreviousValue)
            End If

            Call ApplyEquipmentCalibration()

        End If

    End If

    Call InvalidateVisualHistory()

End Sub

Function EquipmentGripThousandths(PartIndex As Number, SocketName As Text) As Core.Vector3

    Dim Result As Core.Vector3

    Result.X = Character3D.SocketValueThousandths(Character, SocketName,
        Graphics3D.ANIMATOR_SOCKET_POSITION_X, PartIndex)
    Result.Y = Character3D.SocketValueThousandths(Character, SocketName,
        Graphics3D.ANIMATOR_SOCKET_POSITION_Y, PartIndex)
    Result.Z = Character3D.SocketValueThousandths(Character, SocketName,
        Graphics3D.ANIMATOR_SOCKET_POSITION_Z, PartIndex)

    Return Result

End Function

Function RestoreEquipmentGrip(PartIndex As Number, SocketName As Text) As Boolean

    Dim Position As Core.Vector3
    Dim Correction As Core.Vector3
    Dim Angles As Core.Vector3
    Dim Inverse As Core.Matrix4
    Dim NextPosition As Core.Vector3

    ''' Recalculate from the captured base, never from an already rounded drag sample.

    If PartIndex = WEAPON_PART_INDEX Then

        Call SetCalibrationChannelValue(Playback.SelectedClip, 12 + 0, ViewerGizmoState.GripBasePosition.X)
        Call SetCalibrationChannelValue(Playback.SelectedClip, 12 + 1, ViewerGizmoState.GripBasePosition.Y)
        Call SetCalibrationChannelValue(Playback.SelectedClip, 12 + 2, ViewerGizmoState.GripBasePosition.Z)

    Else

        Call SetCalibrationChannelValue(Playback.SelectedClip, 15 + 0, ViewerGizmoState.GripBasePosition.X)
        Call SetCalibrationChannelValue(Playback.SelectedClip, 15 + 1, ViewerGizmoState.GripBasePosition.Y)
        Call SetCalibrationChannelValue(Playback.SelectedClip, 15 + 2, ViewerGizmoState.GripBasePosition.Z)

    End If

    Call ApplyEquipmentCalibration()

    Position = EquipmentGripThousandths(PartIndex, SocketName)
    Correction.X = ViewerGizmoState.GripAnchor.X - Position.X
    Correction.Y = ViewerGizmoState.GripAnchor.Y - Position.Y
    Correction.Z = ViewerGizmoState.GripAnchor.Z - Position.Z
    Angles.X = CalibrationChannelValue(Playback.SelectedClip, 6 + CALIBRATION_AXIS_X)
    Angles.Y = CalibrationChannelValue(Playback.SelectedClip, 6 + CALIBRATION_AXIS_Y)
    Angles.Z = CalibrationChannelValue(Playback.SelectedClip, 6 + CALIBRATION_AXIS_Z)

    If PartIndex = SHIELD_PART_INDEX Then

        Angles.X = CalibrationChannelValue(Playback.SelectedClip, 9 + CALIBRATION_AXIS_X)
        Angles.Y = CalibrationChannelValue(Playback.SelectedClip, 9 + CALIBRATION_AXIS_Y)
        Angles.Z = CalibrationChannelValue(Playback.SelectedClip, 9 + CALIBRATION_AXIS_Z)

    End If

    ''' Part translation precedes the XYZ pivot rotation; undo Z, Y, X for compensation.
    Inverse = Math3D.Multiply(Math3D.RotationZ(-Angles.Z), Math3D.RotationY(-Angles.Y))
    Inverse = Math3D.Multiply(Inverse, Math3D.RotationX(-Angles.X))
    Correction = Math3D.TransformPoint(Correction, Inverse)

    If PartIndex = WEAPON_PART_INDEX Then

        NextPosition.X = CalibrationChannelValue(Playback.SelectedClip, 12 + 0) + RoundedGripOffset(Correction.X)
        NextPosition.Y = CalibrationChannelValue(Playback.SelectedClip, 12 + 1) + RoundedGripOffset(Correction.Y)
        NextPosition.Z = CalibrationChannelValue(Playback.SelectedClip, 12 + 2) + RoundedGripOffset(Correction.Z)

    Else

        NextPosition.X = CalibrationChannelValue(Playback.SelectedClip, 15 + 0) + RoundedGripOffset(Correction.X)
        NextPosition.Y = CalibrationChannelValue(Playback.SelectedClip, 15 + 1) + RoundedGripOffset(Correction.Y)
        NextPosition.Z = CalibrationChannelValue(Playback.SelectedClip, 15 + 2) + RoundedGripOffset(Correction.Z)

    End If

    If (Abs(NextPosition.X) > CALIBRATION_MAXIMUM_POSITION Or
        Abs(NextPosition.Y) > CALIBRATION_MAXIMUM_POSITION Or
        Abs(NextPosition.Z) > CALIBRATION_MAXIMUM_POSITION) Then
        Return False
    End If

    If PartIndex = WEAPON_PART_INDEX Then

        Call SetCalibrationChannelValue(Playback.SelectedClip, 12 + 0, NextPosition.X)
        Call SetCalibrationChannelValue(Playback.SelectedClip, 12 + 1, NextPosition.Y)
        Call SetCalibrationChannelValue(Playback.SelectedClip, 12 + 2, NextPosition.Z)

    Else

        Call SetCalibrationChannelValue(Playback.SelectedClip, 15 + 0, NextPosition.X)
        Call SetCalibrationChannelValue(Playback.SelectedClip, 15 + 1, NextPosition.Y)
        Call SetCalibrationChannelValue(Playback.SelectedClip, 15 + 2, NextPosition.Z)

    End If

    Call ApplyEquipmentCalibration()

    Return True

End Function

Function RoundedGripOffset(Value As Number) As Number

    Dim Result As Number

    If Value < 0 Then
        Result = (Value - 500) / 1000
    Else
        Result = (Value + 500) / 1000
    End If

    Return Result

End Function

Sub AdjustCalibrationValue(Amount As Number)

    Call SetCurrentCalibrationValue(CurrentCalibrationValue() + Amount)

End Sub

Sub SetCalibrationFromPointer()

    Dim MaximumValue As Number
    Dim MinimumValue As Number
    Dim Value As Number

    MinimumValue = CalibrationMinimumValue()
    MaximumValue = CalibrationMaximumValue()
    Value = ((Pointer_X() - CALIBRATION_SLIDER_X) *
        (MaximumValue - MinimumValue) /
        CALIBRATION_SLIDER_WIDTH) + MinimumValue

    Call SetCurrentCalibrationValue(Value)

End Sub

Sub ResetCalibrationTarget()

    Dim Axis As Number

    ViewerGizmoState.GripAnchorActive = False

    Call BeginCalibrationEdit()

    For Axis = 0 To CALIBRATION_AXIS_COUNT - 1

        If (ViewerUiState.CalibrationTransform = CALIBRATION_TRANSFORM_MOVE And
            ViewerUiState.CalibrationTarget = CALIBRATION_TARGET_SWORD) Then
            Call SetCalibrationChannelValue(Playback.SelectedClip, 12 + Axis, 0)
        Else If (ViewerUiState.CalibrationTransform = CALIBRATION_TRANSFORM_MOVE And
            ViewerUiState.CalibrationTarget = CALIBRATION_TARGET_SHIELD) Then
            Call SetCalibrationChannelValue(Playback.SelectedClip, 15 + Axis, 0)
        Else If ViewerUiState.CalibrationTarget = CALIBRATION_TARGET_SWORD_WRIST Then
            Call SetCalibrationChannelValue(Playback.SelectedClip, Axis, 0)
        Else If ViewerUiState.CalibrationTarget = CALIBRATION_TARGET_SHIELD_WRIST Then
            Call SetCalibrationChannelValue(Playback.SelectedClip, 3 + Axis, 0)
        Else If ViewerUiState.CalibrationTarget = CALIBRATION_TARGET_SWORD Then
            Call SetCalibrationChannelValue(Playback.SelectedClip, 6 + Axis, 0)
        Else

            Call SetCalibrationChannelValue(Playback.SelectedClip, 9 + Axis, 0)
        End If

    End For

    Calibration.SaveLimitReached = False
    ViewerUiState.CalibrationClearConfirm = False

    Call ViewerCamera.SetAutoOrbit(ViewerCameraState, False)

    Call ApplyWristCalibration()
    Call ApplyEquipmentCalibration()

    Call InvalidateVisualHistory()

End Sub

Sub ClearSelectedClipCalibration()

    Call ViewerCalibration.ClearClip(Calibration, Playback.SelectedClip)

    ViewerUiState.CalibrationClearConfirm = False
    Calibration.SaveLimitReached = False

    Call RefreshCalibrationSavedStatus()
    Call SaveCalibrationKeyframes()

    Call ApplyWristCalibration()
    Call ApplyEquipmentCalibration()
    Call FinishCalibrationEdit()

End Sub

Sub ClearAllCalibration()

    Call ClearCalibrationMemory()

    ViewerUiState.CalibrationClearConfirm = False
    ViewerUiState.CalibrationClearAllStage = 0
    Calibration.SaveLimitReached = False

    Call SaveCalibrationKeyframes()

    Call ApplyWristCalibration()
    Call ApplyEquipmentCalibration()
    Call FinishCalibrationEdit()

End Sub

Function CalibrationResetClipLabel() As Text

    Dim Result As Text

    If ViewerUiState.CalibrationClearConfirm Then
        Result = "Confirm Current Clip?"
    Else
        Result = "Delete All Key Frames"
    End If

    Return Result

End Function

Function CalibrationResetAllLabel() As Text

    Dim Result As Text

    If ViewerUiState.CalibrationClearAllStage = 1 Then
        Result = "Confirm All?"
    Else If ViewerUiState.CalibrationClearAllStage >= 2 Then
        Result = "Really Clear?"
    Else
        Result = "Reset All"
    End If

    Return Result

End Function

Sub SaveCalibrationFrame()

    Dim SavedSuccessfully As Boolean

    If Calibration.StorageRejected Then
        Return
    End If

    Call BeginCalibrationEdit()

    ViewerUiState.CalibrationClearConfirm = False
    SavedSuccessfully = ViewerCalibration.CommitCurrentKey(
        Calibration,
        Character,
        Playback.SelectedClip,
        ViewerUiState.CalibrationEditingFrame,
        ViewerUiState.CalibrationEditing
    )

    If SavedSuccessfully Then
        Call InvalidateVisualHistory()
    End If

    If Not Calibration.WriteFailed Then
        Call FinishCalibrationEdit()
    End If

End Sub

Sub UndoLastCalibrationChange()

    Call FinishCalibrationEdit()

    If Not ViewerCalibration.Undo(
        Calibration, Character, Playback.SelectedClip) Then
        Return
    End If

    Call UpdateCalibrationForCurrentFrame()
    Call ApplyWristCalibration()
    Call ApplyEquipmentCalibration()
    Call InvalidateVisualHistory()

End Sub

Sub PlaySelectedClip(Optional RetainFireTails As Boolean = False)

    ''' Explicit editor navigation is a cut, not a corrected-pose cross-fade.
    ''' Automatic demo changes keep existing fire but never inherit across the cut.

    If Not RetainFireTails Then
        Call InvalidateVisualHistory()
    End If

    Playback.SelectedTimelineEvent = FirstClipEvent()
    Session.Ready = Character3D.PlayMode(
        Character,
        SelectedClipName(),
        ViewerPlayback.ClipMode(Session.ProfileIndex, SelectedClipName()),
        Playback.PlaybackSpeed
    ) And Session.Ready
    ArinAudio.Clip = ""
    Playback.AnimationCycleElapsed = 0
    Playback.DemoCompletedLoops = 0
    Playback.DemoPreviousAnimationTime = Character3D.AnimationTime(Character)

    Call UpdateCalibrationForCurrentFrame()
    Call ApplyWristCalibration()

    If EpicGlowAvailable Then
        Call ResetEpicGlowTrails()
    End If

End Sub

Function FirstClipEvent() As Number

    Dim EventIndex As Number
    Dim Result As Number

    Result = 0

    For EventIndex = 1 To Character3D.EventCount(Character)

        If (Character3D.EventClipIndex(Character, EventIndex) = Playback.SelectedClip And
            Result = 0) Then
            Result = EventIndex
        End If

    End For

    Return Result

End Function

Function NearestClipEvent(TimeValue As Number) As Number

    Dim BestDistance As Number
    Dim Distance As Number
    Dim EventIndex As Number
    Dim Result As Number

    BestDistance = 2147483647
    Result = 0

    For EventIndex = 1 To Character3D.EventCount(Character)

        If Character3D.EventClipIndex(Character, EventIndex) = Playback.SelectedClip Then

            Distance = Abs(Character3D.EventTime(Character, EventIndex) - TimeValue)

            If Distance < BestDistance Then
                BestDistance = Distance
                Result = EventIndex
            End If

        End If

    End For

    Return Result

End Function

Function SelectedClipName() As Text

    Dim Result As Text

    Result = Character3D.ClipName(Character, Playback.SelectedClip)

    Return Result

End Function

Function SelectedClipLabel() As Text

    Dim Result As Text

    Result = ViewerProfiles.ClipLabel(
        Session.ProfileIndex,
        PresentationIndexForRuntimeClip(Playback.SelectedClip)
    )

    Return Result

End Function

Function LightingLabel() As Text

    Dim Result As Text

    If LightingIndex = 0 Then
        Result = "Viewer Studio"
    Else If LightingIndex = 1 Then
        Result = "Character Studio"
    Else If LightingIndex = 2 Then
        Result = "Daylight"
    Else
        Result = "Moonlight"
    End If

    Return Result

End Function

Function PointerInRectangle(X As Number, Y As Number, Width As Number, Height As Number) As Boolean

    Dim Result As Boolean

    Result = UI.Contains(X, Y, Width, Height)
    Return Result

End Function

Function StatusPanelX() As Number

    Dim Result As Number

    Result = Max(492, Window_Width() - 268)

    Return Result

End Function

Function AnimationButtonX() As Number

    Dim Result As Number

    Result = StatusPanelX() + 12

    Return Result

End Function

Function GlowButtonX() As Number

    Dim Result As Number

    Result = StatusPanelX() + 162

    If ViewerProfiles.INCLUDE_DIAGNOSTIC_PROFILES And Not PartyMode Then
        Result = StatusPanelX() + 216
    End If

    Return Result

End Function

Function GlowButtonWidth() As Number

    Dim Result As Number

    Result = 90

    If ViewerProfiles.INCLUDE_DIAGNOSTIC_PROFILES And Not PartyMode Then
        Result = 36
    End If

    Return Result

End Function

Sub DrawGizmoStroke(X1 As Number, Y1 As Number, X2 As Number, Y2 As Number,
    ColorValue As Number, Selected As Boolean)

    Dim Offset As Number
    Dim Radius As Number

    Radius = 1

    If Selected Then
        Radius = 2
    End If

    For Offset = 0 - Radius To Radius

        If Abs(X2 - X1) >= Abs(Y2 - Y1) Then
            Draw Line X1, Y1 + Offset, X2, Y2 + Offset, ColorValue
        Else
            Draw Line X1 + Offset, Y1, X2 + Offset, Y2, ColorValue
        End If

    End For

    Fill Circle X1, Y1, Radius, ColorValue
    Fill Circle X2, Y2, Radius, ColorValue

End Sub

Function TransformGizmoAxisPoint(Axis As Number) As Core.ProjectedPoint3D

    Dim Result As Core.ProjectedPoint3D

    Result = ViewerGizmoState.Projection.XAxis

    If Axis = CALIBRATION_AXIS_Y Then
        Result = ViewerGizmoState.Projection.YAxis
    Else If Axis = CALIBRATION_AXIS_Z Then
        Result = ViewerGizmoState.Projection.ZAxis
    End If

    Return Result

End Function

Function TransformGizmoAxisColor(Axis As Number, Selected As Boolean) As Number

    Dim Result As Number

    If Axis = ViewerGizmoState.HoverAxis Then
        Result = Rgb(255, 255, 255)

        Return Result
    End If

    If Axis = CALIBRATION_AXIS_X Then

        If Selected Then
            Result = Rgb(255, 112, 137)
        Else
            Result = Rgb(232, 84, 112)
        End If

    Else If Axis = CALIBRATION_AXIS_Y Then

        If Selected Then
            Result = Rgb(156, 225, 94)
        Else
            Result = Rgb(131, 196, 70)
        End If

    Else

        If Selected Then
            Result = Rgb(126, 173, 255)
        Else
            Result = Rgb(83, 136, 235)
        End If

    End If

    Return Result

End Function

Sub DrawTransformGizmo()

    If Not ViewerGizmoState.Visible Or Not ViewerGizmoState.Projection.Visible Then
        Return
    End If

    ViewerGizmoState.HoverAxis = TransformGizmoAxisAtPointer()

    If ViewerGizmoState.Dragging Then
        ViewerGizmoState.HoverAxis = ViewerUiState.CalibrationAxis
    End If

    If ViewerUiState.CalibrationTransform = CALIBRATION_TRANSFORM_MOVE Then
        Call DrawTransformGizmoMove()
    Else

        Call DrawTransformGizmoRotate()
    End If

    Draw Circle ViewerGizmoState.Projection.Origin.X, ViewerGizmoState.Projection.Origin.Y, 7, Rgb(242, 242, 242)

End Sub

Sub DrawTransformGizmoMove()

    Dim Axis As Number
    Dim AxisPoint As Core.ProjectedPoint3D
    Dim ColorValue As Number
    Dim Selected As Boolean
    Dim Label As Text

    For Axis = CALIBRATION_AXIS_X To CALIBRATION_AXIS_Z

        AxisPoint = TransformGizmoAxisPoint(Axis)
        Selected = Axis = ViewerUiState.CalibrationAxis Or Axis = ViewerGizmoState.HoverAxis
        ColorValue = TransformGizmoAxisColor(Axis, Selected)

        Call DrawGizmoStroke(ViewerGizmoState.Projection.Origin.X, ViewerGizmoState.Projection.Origin.Y,
            AxisPoint.X, AxisPoint.Y, ColorValue, Selected)

        Call DrawGizmoArrow(ViewerGizmoState.Projection.Origin, AxisPoint, ColorValue)

        Label = "X"

        If Axis = CALIBRATION_AXIS_Y Then
            Label = "Y"
        Else If Axis = CALIBRATION_AXIS_Z Then
            Label = "Z"
        End If

        Draw Text Label At AxisPoint.X + 7, AxisPoint.Y - 7 Size 12 Color ColorValue
    End For

End Sub

Sub DrawGizmoArrow(Origin As Core.ProjectedPoint3D, Tip As Core.ProjectedPoint3D,
    ColorValue As Number)

    Dim Direction As Core.Vector3
    Dim Length As Number
    Dim StepIndex As Number
    Dim CenterX As Number
    Dim CenterY As Number
    Dim SideX As Number
    Dim SideY As Number

    Direction.X = Tip.X - Origin.X
    Direction.Y = Tip.Y - Origin.Y
    Length = Math3D.Length(Direction)

    If Length < 1 Then
        Return
    End If

    For StepIndex = 0 To 14

        CenterX = Tip.X - Direction.X * StepIndex / Length
        CenterY = Tip.Y - Direction.Y * StepIndex / Length
        SideX = Direction.Y * StepIndex / (Length * 2)
        SideY = Direction.X * StepIndex / (Length * 2)
        Draw Line CenterX - SideX, CenterY + SideY, CenterX + SideX, CenterY - SideY, ColorValue
    End For

End Sub

Sub DrawTransformGizmoRotate()

    Dim Axis As Number
    Dim Segment As Number
    Dim ColorValue As Number
    Dim Selected As Boolean
    Dim StartPoint As Core.ProjectedPoint3D
    Dim EndPoint As Core.ProjectedPoint3D
    Dim RearSegment As Boolean

    For Axis = CALIBRATION_AXIS_X To CALIBRATION_AXIS_Z

        Selected = Axis = ViewerUiState.CalibrationAxis Or Axis = ViewerGizmoState.HoverAxis
        ColorValue = TransformGizmoAxisColor(Axis, Selected)
        StartPoint = CharacterViewer.ProjectTransformRingPoint(
            ViewerGizmoState.Origin,
            Axis,
            0,
            TRANSFORM_GIZMO_RING_SEGMENTS,
            ViewerGizmoState.WorldSize,
            ViewerCameraState.Live,
            Window_Width(),
            Window_Height()
        )

        For Segment = 1 To TRANSFORM_GIZMO_RING_SEGMENTS

            EndPoint = CharacterViewer.ProjectTransformRingPoint(
                ViewerGizmoState.Origin,
                Axis,
                Segment,
                TRANSFORM_GIZMO_RING_SEGMENTS,
                ViewerGizmoState.WorldSize,
                ViewerCameraState.Live,
                Window_Width(),
                Window_Height()
            )

            If StartPoint.Visible And EndPoint.Visible Then

                RearSegment = (StartPoint.Depth + EndPoint.Depth) / 2 > ViewerGizmoState.Projection.Origin.Depth

                If RearSegment And Not ViewerGizmoState.Dragging Then
                    ColorValue = Rgb(78, 83, 93)
                Else
                    ColorValue = TransformGizmoAxisColor(Axis, Selected)
                End If

                Call DrawGizmoStroke(StartPoint.X, StartPoint.Y,
                    EndPoint.X, EndPoint.Y, ColorValue, Selected And Not RearSegment)

            End If

            StartPoint = EndPoint
        End For
    End For

    ''' Camera-facing silhouette guide, not an extra editable rotation channel.
    Draw Circle ViewerGizmoState.Projection.Origin.X, ViewerGizmoState.Projection.Origin.Y, 90, Rgb(220, 220, 220)

End Sub

Sub DrawViewerOverlay()

    Call BeginPartyInspector()

    If (ViewerUiState.Visibility = 0 And
        CalibrationAvailable And
        ViewerUiState.CalibrationVisible And
        ViewerGizmoState.Visible) Then
        Call UpdateTransformGizmo()
        Call DrawTransformGizmo()
    End If

    Call DrawInspectorOverlay()
    Call EndPartyInspector()

End Sub

Sub DrawInspectorOverlay()

    Dim PanelLeft As Number
    Dim PanelText As Number
    Dim Subtitle As Text

    If ViewerUiState.Visibility = 2 Then
        Return
    End If

    PanelLeft = StatusPanelX()
    PanelText = PanelLeft + 16

    If ViewerLayoutTooSmall() Then

        Fill Rectangle 0, 0, Window_Width(), Window_Height(), Rgb(4, 9, 24) Opacity 92
        Draw Text "CHARACTER VIEWER NEEDS MORE ROOM" At 28, 40 Size 22 Color YELLOW
        Draw Text "Resize to at least 800 by 540 logical units." At 28, 78 Size 15 Color WHITE
        Draw Text "Right-click still resets the scene." At 28, 108 Size 13 Color LIGHT_GRAY
        Return

    End If

    If Window_Width() < 1100 Then
        Subtitle = ActiveProfile.DisplayName + "  •  " + PartyRoleLabel() + "  •  PBR"
    Else
        Subtitle = ActiveProfile.DisplayName + "  •  Party role: " + PartyRoleLabel() + "  •  Renderer3D PBR"
    End If

    Draw Text "SMILE 2.0 - 3D Viewer, Animation Editor" At 18, 10 Size 22 Color WHITE

    If PartyMode Then
        Subtitle = "Sin Star I  •  Arin And Orin  •  Party Battle Preview"
    End If

    Draw Text Subtitle At 18, 42 Size 13 Color LIGHT_GRAY
    Draw Text "Character" At 18, 68 Size 13 Color WHITE

    Call DrawButton(104, 62, 72, 26, "Arin", Session.SelectedCharacterTab = 0)
    Call DrawButton(182, 62, 72, 26, "Orin", Session.SelectedCharacterTab = 1)
    Call DrawButton(260, 62, 72, 26, "Dragon", Session.SelectedCharacterTab = 2)
    Call DrawButton(338, 62, 72, 26, "Party", Session.SelectedCharacterTab = 3)

    If PartyMode And Not ViewerUiState.CalibrationVisible Then
        Call DrawPartyOverlay()
    End If

    If ViewerUiState.Visibility = 0 Then

        Call DrawButton(PanelLeft, 18, 44, 34, "LIGHT", False)
        Call DrawButton(PanelLeft + 48, 18, 56, 34, "CHANNEL", False)
        Call DrawButton(PanelLeft + 108, 18, 50, 34, "SOCKET", SocketGizmosVisible)

        If ViewerProfiles.INCLUDE_DIAGNOSTIC_PROFILES And Not PartyMode Then
            Call DrawButton(PanelLeft + 162, 18, 50, 34, "PROFILE", False)
        End If

        Call DrawButton(GlowButtonX(), 18, GlowButtonWidth(), 34, "GLOW", EpicGlowVisible)
        Call DrawButton(PanelLeft, 56, 72, 22, DragonLabel(), DragonVisible)
        Call DrawButton(PanelLeft + 76, 56, 48, 22, BackgroundLabel(), BackgroundIndex > 0)

        If CalibrationAvailable Then
            Call DrawButton(PanelLeft + 128, 56, 36, 22, "Pose", ViewerUiState.CalibrationVisible)
        Else
            Draw Text "Pose" At PanelLeft + 132, 62 Size 10 Color GRAY
        End If

        Call DrawButton(PanelLeft + 168, 56, 40, 22, "Weapon", SwordVisible)
        Call DrawButton(PanelLeft + 212, 56, 40, 22, "Shield", ShieldVisible)

        Call UI.DrawPanel(PanelLeft, 82, 252, Max(446, Window_Height() - 94))

        Call DrawCharacterStatusSummary(PanelLeft)

        Draw Text "ANIMATIONS" At PanelText, 334 Size 13 Color WHITE

        Call DrawButton(PanelLeft + 178, 330, 74, 18, DemoLabel(), Playback.DemoEnabled)

        Call DrawAnimationButtons()
        Call DrawButton(PanelLeft + 12, 444, 78, 22, "Floor/Grid", FloorVisible Or GridVisible)

        If Session.ProfileIndex = ViewerProfiles.PROFILE_ARIN Then

            Call DrawButton(PanelLeft + 94, 444, 76, 22, "Sword Fire", SwordFireVisible)
            Call DrawButton(PanelLeft + 174, 444, 78, 22, "Shield Fire", ShieldFireVisible)

        Else If Session.ProfileIndex = ViewerProfiles.PROFILE_ORIN Then

            Call DrawButton(PanelLeft + 94, 444, 158, 22,
                OrinStorm.StyleName(OrinStormContext), True)
            Call DrawButton(PanelLeft + 12, 470, 128, 20,
                OrinStorm.SceneComfortName(), True)
            Call DrawButton(PanelLeft + 144, 470, 108, 20,
                VfxPlaybackLabel("Lightning", LightningAnimationPaused), LightningAnimationPaused)

        Else If Session.ProfileIndex = ViewerProfiles.PROFILE_DRAGON Then

            Call DrawButton(PanelLeft + 94, 444, 76, 22, "Head Aim", DragonHeadTracking)

            If ((PartyMode And PartyHitTarget = 0) Or
                (Not PartyMode And DragonCounter Mod 2 = 0)) Then
                Call DrawButton(PanelLeft + 174, 444, 78, 22, "At Arin", True)
            Else

                Call DrawButton(PanelLeft + 174, 444, 78, 22, "At Orin", True)
            End If

        End If

        If SwordFireReady And Session.ProfileIndex = ViewerProfiles.PROFILE_ARIN Then
            Call DrawButton(PanelLeft + 12, 470, 128, 20, FlamePlaybackLabel(), Not FlameAnimationPaused)

            Call DrawButton(PanelLeft + 144, 470, 108, 20, ShieldFireStyleLabel(), Not ShieldFlameStyle)
        End If

        If Window_Height() >= ANIMATION_DETAILS_MINIMUM_HEIGHT Then

            Draw Text "Clip ms / Rate / Samples / Events" At PanelText, ANIMATION_DETAILS_Y Size 11 Color LIGHT_GRAY
            Draw Number Character3D.ClipDuration(Character, Playback.SelectedClip) At PanelText, ANIMATION_DETAILS_Y + 20 Size 11 Color WHITE
            Draw Number Character3D.ClipSampleRate(Character, Playback.SelectedClip) At PanelText + 58, ANIMATION_DETAILS_Y + 20 Size 11 Color CYAN
            Draw Number Character3D.ClipSampleCount(Character, Playback.SelectedClip) At PanelText + 104, ANIMATION_DETAILS_Y + 20 Size 11 Color WHITE
            Draw Number Character3D.ClipEventCount(Character, Playback.SelectedClip) At PanelText + 166, ANIMATION_DETAILS_Y + 20 Size 11 Color YELLOW
            Draw Text "Model clips / sockets / events" At PanelText, ANIMATION_DETAILS_Y + 42 Size 11 Color LIGHT_GRAY
            Draw Number Character3D.ClipCount(Character) At PanelText, ANIMATION_DETAILS_Y + 62 Size 11 Color WHITE
            Draw Number Character3D.SocketCount(Character) At PanelText + 58, ANIMATION_DETAILS_Y + 62 Size 11 Color CYAN
            Draw Number Character3D.EventCount(Character) At PanelText + 116, ANIMATION_DETAILS_Y + 62 Size 11 Color YELLOW

        End If

        Call DrawCameraControls()

        Call DrawButton(PanelLeft + 12, Window_Height() - 64, 52, 24, "VIEW", False)
        Call DrawButton(PanelLeft + 68, Window_Height() - 64, 74, 24, "PRESENT", False)
        Call DrawButton(PanelLeft + 146, Window_Height() - 64, 40, 24, "ALL", False)
        Call DrawButton(PanelLeft + 190, Window_Height() - 64, 50, 24, "FIT", ViewerCameraState.FitLocked)

    End If

    Call DrawTimeline()

    If (ViewerUiState.Visibility = 0 And
        CalibrationAvailable And
        ViewerUiState.CalibrationVisible) Then
        Call DrawCalibrationPanel()
    End If

    If (CalibrationAvailable And
        Text_Width(Calibration.TransferMessage, 9) >
            TimelineWidth() - CALIBRATION_TRANSFER_TEXT_OFFSET) Then
        Draw Text Calibration.TransferMessage At TIMELINE_LEFT, Window_Height() - 22 Size 9 Color CYAN
    Else
        Draw Text "LMB pan  •  MMB orbit  •  Wheel zoom  •  Space pause  •  RMB reset  •  D dragon  •  W sword  •  S shield" At 16, Window_Height() - 22 Size 11 Color LIGHT_GRAY
    End If

    If (ViewerUiState.CalibrationEditing Or
        Playback.ScenePaused Or
        Session.CharacterSwitchBlocked) Then
        Fill Rectangle 18, 40, Max(0, PanelLeft - 24), 18, Rgb(4, 9, 24)
    End If

    If Session.CharacterSwitchBlocked Then

        Draw Text "Save Or Cancel The Pose Before Switching" At 18, 42 Size 12 Color YELLOW

    Else If ViewerUiState.CalibrationEditing Then

        If PartyMode Then
            Draw Text "Pose Edit Active - Save Or Cancel Before Resuming" At 18, 42 Size 12 Color YELLOW
        Else If Playback.ScenePaused Then
            Draw Text "Pose Edit Active - Space To Resume" At 18, 42 Size 12 Color YELLOW
        Else
            Draw Text "Pose Edit Active - Space To Pause Movement" At 18, 42 Size 12 Color YELLOW
        End If

    Else If Playback.ScenePaused Then

        Draw Text "Paused - Space To Resume; Camera Controls Remain Active" At 18, 42 Size 12 Color YELLOW

    End If

    If ViewerUiState.Visibility = 0 And Session.ViewerError Then

        Fill Rectangle 120, 142, 580, 210, Rgb(56, 8, 18) Opacity 80
        Draw Text "CHARACTER VIEWER RECOVERY" At 148, 166 Size 22 Color WHITE
        Draw Text "The 3D renderer or character resource became unavailable." At 148, 204 Size 14 Color LIGHT_GRAY
        Draw Text "Viewer error" At 148, 238 Size 13 Color LIGHT_GRAY
        Draw Number Session.FirstViewerError At 270, 238 Size 13 Color YELLOW
        Draw Text "Renderer error" At 348, 238 Size 13 Color LIGHT_GRAY
        Draw Number Session.FirstRendererError At 486, 238 Size 13 Color YELLOW
        Draw Text "Failure stage" At 148, 270 Size 13 Color LIGHT_GRAY
        Draw Number Session.FirstFailureStage At 270, 270 Size 13 Color YELLOW
        Draw Text "Press Enter or click Reset to reload the profile safely." At 148, 310 Size 14 Color CYAN

    End If

End Sub

