    If Rendering.BackgroundIndex = 1 Then
        Result = "BG GREEN"
    Else If Rendering.BackgroundIndex = 2 Then
        Result = "BG PURPLE"
    Else If Rendering.BackgroundIndex = 3 Then
        Result = "BG SCENE"
    Else If Rendering.BackgroundIndex = 4 Then
        Result = "BG LOGO"
    Else
        Result = "BG BLACK"
    End If

    Return Result

End Function

