    End If

    Return Result

End Function

Function ViewerTitle() As Text

    Dim Result As Text

    Result = "SMILE 2.0 - 3D Viewer, Animation Editor - " + ViewerProfiles.ModelFileName(Session.ProfileIndex)

    Return Result

End Function

Function ViewerLayoutTooSmall() As Boolean

    Dim Result As Boolean

    Result = Window_Width() < MINIMUM_VIEWER_WIDTH Or Window_Height() < MINIMUM_VIEWER_HEIGHT

    Return Result

End Function

Sub DrawAnimationButtons()

    Dim ClipCount As Number
    Dim Index As Number
    Dim Column As Number
    Dim Row As Number
    Dim ButtonX As Number
    Dim ButtonY As Number

    ClipCount = ViewerProfiles.ClipCount(Session.ProfileIndex)

    For Index = 0 To ClipCount - 1

        Column = Index Mod ANIMATION_BUTTON_COLUMN_COUNT
        Row = Index / ANIMATION_BUTTON_COLUMN_COUNT
        ButtonX = AnimationButtonX() + Column * (ANIMATION_BUTTON_WIDTH + ANIMATION_BUTTON_COLUMN_GAP)
        ButtonY = ANIMATION_BUTTON_Y + Row * (ANIMATION_BUTTON_HEIGHT + ANIMATION_BUTTON_ROW_GAP)

        Call DrawButton(
            ButtonX,
            ButtonY,
            ANIMATION_BUTTON_WIDTH,
            ANIMATION_BUTTON_HEIGHT,
            ViewerProfiles.ClipLabel(Session.ProfileIndex, Index),
            Playback.SelectedClip = RuntimeClipForPresentationIndex(Index)
        )
    End For

End Sub

Function AnimationSecondsRemaining() As Number

    Dim RequiredMilliseconds As Number
    Dim RemainingMilliseconds As Number
    Dim Result As Number

    If Party.Enabled Then

        RequiredMilliseconds = ViewerParty.AttackDuration(
            Party,
            Character,
            Party.Companion.Actor,
            Playback.PlaybackSpeed
        ) + 4000

        If Party.Turn = 2 Then
            RequiredMilliseconds = ViewerParty.DragonTurnDuration(
                Party, Playback.PlaybackSpeed)
        End If

        RemainingMilliseconds = Max(0, RequiredMilliseconds - Party.Elapsed)
        Result = (RemainingMilliseconds + 999) / 1000

    Else If Playback.DemoEnabled Then

        RequiredMilliseconds = ViewerPlayback.DemoRequiredLoops(
            Character, Playback.SelectedClip, Playback.PlaybackSpeed,
            Session.ProfileIndex, ANIMATION_CYCLE_MILLISECONDS
        ) * ViewerPlayback.DemoLoopDuration(
            Character, Playback.SelectedClip, Playback.PlaybackSpeed
        )

        If (ViewerPlayback.ClipMode(Session.ProfileIndex, SelectedClipName()) =
            Graphics3D.ANIMATION_ONCE) Then
            RequiredMilliseconds = Max(
                ViewerPlayback.DemoTarget(Session.ProfileIndex, ANIMATION_CYCLE_MILLISECONDS),
                ViewerPlayback.DemoLoopDuration(
                    Character, Playback.SelectedClip, Playback.PlaybackSpeed
                )
            )
        End If

        RemainingMilliseconds = Max(0, RequiredMilliseconds - Playback.AnimationCycleElapsed)
        Result = (RemainingMilliseconds + 999) / 1000

    Else
        Result = 0

    End If

    Return Result

End Function

Function DemoLabel() As Text

    Dim Result As Text

    If Party.Enabled And Playback.ScenePaused Then
        Result = "RESUME"
    Else If Party.Enabled Then
        Result = "PAUSE"
    Else If Playback.DemoEnabled Then
        Result = "DEMO ON"
    Else
        Result = "DEMO OFF"
    End If

    Return Result

End Function

Function DemoStatusLabel() As Text

    Dim Result As Text

    If Party.Enabled And Playback.ScenePaused Then
        Result = "Paused"
    Else If Playback.DemoEnabled Then
        Result = "On"
    Else
        Result = "Off"
    End If

    Return Result

End Function

Function ProductionClipStatusLabel() As Text

    Dim Result As Text

    If Session.ProfileIndex = ViewerProfiles.PROFILE_ORIN Then
        Result = "9-animation viewer candidate"
    Else If ViewerProfiles.IsPartyCharacter(Session.ProfileIndex) Then
        Result = "9-animation viewer candidate"
    Else If Session.ProfileIndex = ViewerProfiles.PROFILE_ARIN_V56 Then
        Result = "v5.6 diagnostic candidate"
    Else If Session.ProfileIndex = ViewerProfiles.PROFILE_ARIN_ORIGINAL Then
        Result = "Original 3 clips"
    Else
        Result = "Technical fixture"
    End If

    Return Result

End Function

Function PartyRoleLabel() As Text

    Dim Result As Text

    Result = ActiveProfile.PartyRole

    If Result = "" Then
        Result = "Technical"
    End If

    Return Result

End Function

Function MaterialInspectionLabel() As Text

    Dim Result As Text

    If MaterialInspection = Graphics3D.MATERIAL_INSPECTION_LIT Then
        Result = "Lit"
    Else If MaterialInspection = Graphics3D.MATERIAL_INSPECTION_BASE_COLOR Then
        Result = "Base Color"
    Else If MaterialInspection = Graphics3D.MATERIAL_INSPECTION_NORMAL Then
        Result = "Normal"
    Else If MaterialInspection = Graphics3D.MATERIAL_INSPECTION_ROUGHNESS Then
        Result = "Roughness"
    Else If MaterialInspection = Graphics3D.MATERIAL_INSPECTION_METALLIC Then
        Result = "Metallic"
    Else If MaterialInspection = Graphics3D.MATERIAL_INSPECTION_OCCLUSION Then
        Result = "Occlusion"
    Else
        Result = "Emissive"
    End If

    Return Result

End Function

Function AutoOrbitLabel() As Text

    Dim Result As Text

    If ViewerCameraState.AutoOrbit Then
        Result = "On"
    Else
        Result = "Off"
    End If

    Return Result

End Function

Sub DrawButton(X As Number, Y As Number, Width As Number, Height As Number,
    Label As Text, Selected As Boolean)

    Call UI.DrawButton(X, Y, Width, Height, Label, Selected)

End Sub

Sub DestroyViewer()

    Call DestroyViewerResources()
    Call Character3D.Shutdown()
    Call Scene3D.Shutdown()
    Call Graphics3D.ResetRenderer3D()

End Sub

Sub DestroyViewerResources()

    Call ViewerParty.DestroyParticipants(Party)
    Call ViewerDragon.Shutdown(DragonState, Effects.DragonLight)

    Session.Ready = ViewerEffects.ShutdownShared(Effects) And Session.Ready

    Call DestroyBackdrop()
    Call ViewerEffects.DestroyEpicGlow(Effects)
    Call ViewerRendering.DestroySocketGizmos(Rendering)
    Call ViewerRendering.DestroyArena(Rendering)

    Call Character3D.Destroy(Character)

End Sub

Sub SelectCharacterTab(Index As Number)

    If (Index = Session.SelectedCharacterTab And
        Not Session.ViewerError And
        (Party.Enabled Or Session.DragonInspection Or ViewerProfiles.IsPartyCharacter(Session.ProfileIndex))) Then
        Return
    End If

    If (ViewerUiState.CalibrationEditing Or
        Calibration.ImportPending) Then
        Session.CharacterSwitchBlocked = True
        Return
    End If

    Call CancelInteractionCaptures()

    Fill Rectangle 300, 120, Max(240, Window_Width() - 600), 44, Rgb(8, 16, 30)
    Draw Text "Loading Selected Character..." At 312, 132 Size 16 Color WHITE
    Show Screen

    Call DestroyViewerResources()

    Session.SelectedCharacterTab = Index
    Party.Enabled = Index = 3
    Session.DragonInspection = Index = 2
    Session.ProfileIndex = ViewerProfiles.PROFILE_ARIN

    If Index = 1 Then
        Session.ProfileIndex = ViewerProfiles.PROFILE_ORIN
    Else If Index = 2 Then
        Session.ProfileIndex = ViewerProfiles.PROFILE_DRAGON
    End If

    Call ViewerSession.ResetFailure(Session)

    Playback.DemoEnabled = True
    Playback.ScenePaused = False

    Call LoadViewer()

End Sub

Function CaptureActorContext() As ViewerActors.Context

    Dim Result As ViewerActors.Context

    Result = ViewerActors.Capture(
        Character,
        ViewerCameraState.Frame,
        Session.ProfileIndex,
        Playback.SelectedClip,
        Calibration.KeyBase,
        SwordWristNode,
        ShieldWristNode,
        Effects.SwordGlow,
        Effects.ShieldGlow,
        CalibrationAvailable,
        Effects.EpicGlowAvailable,
        Effects.EpicGlowVisible,
        Party.PrimaryPresentationState
    )

    Return Result

End Function

Sub UseActorContext(Context As ViewerActors.Context)

    Call ViewerActors.Apply(
        Context,
        Character,
        ViewerCameraState.Frame,
        Session.ProfileIndex,
        Playback.SelectedClip,
        Calibration.KeyBase,
        SwordWristNode,
        ShieldWristNode,
        Effects.SwordGlow,
        Effects.ShieldGlow,
        CalibrationAvailable,
        Effects.EpicGlowAvailable,
        Effects.EpicGlowVisible,
        Party.PrimaryPresentationState
    )

    ActiveProfile = ViewerProfiles.ProfileAt(Session.ProfileIndex)

End Sub

Sub BeginPartyInspector()

    Dim Index As Number
    Dim WasVisible As Boolean

    If (Not Party.Enabled Or
        Not Party.Ready Or
        Session.ViewerError Or
        Party.UiBound) Then
        Return
    End If

    If Not ViewerParty.BeginInspectorBinding(
        Party,
        CaptureActorContext(),
        Party.Turn
    ) Then
        Return
    End If

    If Party.UiTurn = 1 Then

        Call UseActorContext(Party.Companion)

    Else If Party.UiTurn = 2 Then

        Character = DragonState.Actor
        Session.ProfileIndex = ViewerProfiles.PROFILE_DRAGON
        ActiveProfile = ViewerProfiles.ProfileAt(Session.ProfileIndex)
        CalibrationAvailable = False
        Effects.EpicGlowAvailable = False
        SwordWristNode = -1
        ShieldWristNode = -1
        Playback.SelectedClip = 0

        For Index = 0 To Character3D.ClipCount(Character) - 1

            If Character3D.ClipName(Character, Index) = DragonState.Clip Then
                Playback.SelectedClip = Index
            End If

        End For

    End If

    If Calibration.OwnerProfile <> Session.ProfileIndex Then

        ''' One editing owner at a time. Never carry a pending import, Undo, or
        ''' clipboard into another character's independent storage identity.
        WasVisible = ViewerUiState.CalibrationVisible

        Call ConfigureCalibration()

        ViewerUiState.CalibrationVisible = WasVisible And CalibrationAvailable
        Playback.SelectedTimelineEvent = FirstClipEvent()

    End If

End Sub

Sub EndPartyInspector()

    If Not Party.UiBound Then
        Return
    End If

    If Party.UiTurn = 1 Then
        Party.Companion = CaptureActorContext()

        Call UseActorContext(Party.UiPrimary)
    Else If Party.UiTurn = 2 Then
        Call ViewerDragon.CaptureInspectedActor(
            DragonState,
            Character,
            SelectedClipName()
        )

        Call UseActorContext(Party.UiPrimary)
    End If

    Call ViewerParty.EndInspectorBinding(Party)

End Sub

Sub BeginPartyPreview()

    If Not Party.UiBound Then
        Return
    End If

    Call ViewerParty.BeginPreview(
        Party,
        Character,
        Playback.SelectedClip,
        Session.ProfileIndex
    )

    Playback.ScenePaused = True

End Sub

Sub RestorePartyPreview()

    If Not Party.PreviewActive Or Not Party.UiBound Then
        Return
    End If

    Session.Ready = ViewerParty.RestorePreview(
        Party,
        Character,
        Playback.SelectedClip,
        Playback.PlaybackSpeed
    ) And Session.Ready

    ViewerUiState.CalibrationVisible = False

    Call ViewerInput.CancelCaptures(ViewerInputState)

    Call UpdateCalibrationForCurrentFrame()
    Call ViewerEffects.InvalidateVisualHistory(Effects)

End Sub

Sub ResetPartyInspector()

    Call BeginPartyInspector()
    Call CancelCalibrationEdit()
    Call RestorePartyPreview()
    Call EndPartyInspector()

    If Session.ViewerError Then
        Call RetryViewer()
    Else

        Call ResetAll()
    End If

End Sub

Sub CreatePartyCompanion(Optional CompanionIndex As Number = ViewerProfiles.PROFILE_ORIN)

    Dim Companion As ViewerActors.Context
    Dim CompanionKeyBase As Number
    Dim Primary As ViewerActors.Context

    Primary = CaptureActorContext()
    CompanionKeyBase = 0

    If CompanionIndex = ViewerProfiles.PROFILE_ORIN Then
        CompanionKeyBase = CALIBRATION_MAX_CLIPS
    End If

    Companion = ViewerActors.LoadContext(CompanionIndex, CompanionKeyBase)
    Party.Ready = Companion.Ready

    Call UseActorContext(Companion)

    If Party.Ready Then

        Call ConfigureCalibration()

        Party.Ready = CalibrationAvailable And Not Calibration.StorageRejected And Party.Ready

        If Effects.EpicGlowMaterial.Handle = 0 Then
            Call ViewerEffects.CreateEpicGlow(Effects, Session.ProfileIndex, Character)
        Else

            Effects.EpicGlowAvailable = ViewerEffects.CreateBorrowedEpicGlow(
                Character,
                Effects.EpicGlowMaterial,
                Effects.SwordGlow,
                Effects.ShieldGlow
            )
            Effects.EpicGlowVisible = Effects.EpicGlowAvailable
        End If

        Session.Ready = ViewerParty.PlayClip(
            Character,
            "Idle",
            Playback.SelectedClip,
            Character.Handle,
            Session.ProfileIndex,
            Playback.PlaybackSpeed
        ) And Session.Ready

        Party.Companion = CaptureActorContext()
        Party.Companion.Ready = Party.Ready

    End If

    Call UseActorContext(Primary)

    If Not Session.DragonInspection Then
        Call ConfigureCalibration()
    End If

    If Party.Enabled Then
        Call ResetPartyDemo()
    End If

    Session.Ready = Companion.Ready And Party.Ready And Session.Ready

End Sub

Sub PositionDragonOpponents()

    Dim Home As Core.Vector3

    Home = PartyHomePosition(0, 2)
    Party.DragonOpponent.Frame.PositionX = Home.X
    Party.DragonOpponent.Frame.PositionZ = Home.Z
    Home = PartyHomePosition(1, 2)
    Party.Companion.Frame.PositionX = Home.X
    Party.Companion.Frame.PositionZ = Home.Z
    Session.Ready = Character3D.Place(Party.DragonOpponent.Actor, Party.DragonOpponent.Frame.PositionX,
        Party.DragonOpponent.Frame.PositionY, Party.DragonOpponent.Frame.PositionZ) And Session.Ready
    Session.Ready = Character3D.Place(Party.Companion.Actor, Party.Companion.Frame.PositionX,
        Party.Companion.Frame.PositionY, Party.Companion.Frame.PositionZ) And Session.Ready
    Session.Ready = ViewerActors.FaceToward(
        Party.DragonOpponent.Actor,
        ViewerDragon.PositionX(),
        0,
        ViewerDragon.PositionZ(),
        CHARACTER_MODEL_FORWARD_YAW_OFFSET,
        0
    ) And Session.Ready
    Session.Ready = ViewerActors.FaceToward(
        Party.Companion.Actor,
        ViewerDragon.PositionX(),
        0,
        ViewerDragon.PositionZ(),
        CHARACTER_MODEL_FORWARD_YAW_OFFSET,
        ORIN_ARENA_YAW_ADJUSTMENT
    ) And Session.Ready

End Sub

Sub UpdateDragonOpponent()

    Dim SavedCompanion As ViewerActors.Context
    Dim Primary As ViewerActors.Context

    SavedCompanion = Party.Companion
    Party.Companion = Party.DragonOpponent

    Call UpdatePartyCompanion()

    Party.DragonOpponent = Party.Companion
    Party.Companion = SavedCompanion
    Primary = CaptureActorContext()

    Call UseActorContext(Party.DragonOpponent)
    Call ViewerEffects.UpdateEquipmentFire(
        Effects,
        Character,
        Session.ProfileIndex,
        False,
        SwordVisible,
        ShieldVisible,
        ViewerUiState.CalibrationEditing,
        Playback.ScenePaused,
        Playback.SelectedClip,
        SelectedClipLabel(),
        ViewerCameraState.Live,
        Timing.CameraElapsed
    )
    Call UseActorContext(Primary)

End Sub

Function DrawDragonOpponent() As Boolean

    Dim SavedCompanion As ViewerActors.Context
    Dim Result As Boolean

    SavedCompanion = Party.Companion
    Party.Companion = Party.DragonOpponent
    Result = ViewerParty.DrawCompanion(
        Party,
        Party.Enabled,
        Session.DragonInspection,
        Effects.EpicGlowVisible,
        SwordVisible
    )
    Party.Companion = SavedCompanion

    Return Result

End Function

Function PartyHomePosition(MemberIndex As Number, MemberCount As Number) As Core.Vector3

    Dim Center As Core.Vector3
    Dim Result As Core.Vector3

    Center.X = ViewerDragon.PositionX()
    Center.Z = ViewerDragon.PositionZ()
    Result = ViewerParty.FormationPosition(Center, PARTY_FORMATION_RADIUS,
        PARTY_FORMATION_START_ANGLE, PARTY_FORMATION_END_ANGLE,
        MemberIndex, MemberCount)

    Return Result

End Function

Sub InitializePartyFormation()

    Dim Center As Core.Vector3
    Dim FirstApproach As Core.Vector3
    Dim SecondApproach As Core.Vector3

    Center.X = ViewerDragon.PositionX()
    Center.Z = ViewerDragon.PositionZ()
    FirstApproach.X = -21
    FirstApproach.Z = -44
    SecondApproach.X = -49
    SecondApproach.Z = 4

    Call ViewerParty.InitializeFormation(
        Party,
        Center,
        PARTY_FORMATION_RADIUS,
        PARTY_FORMATION_START_ANGLE,
        PARTY_FORMATION_END_ANGLE,
        FirstApproach,
        SecondApproach,
        ORIN_ARENA_YAW_ADJUSTMENT
    )

    ''' Only one hero approaches at a time; animated full-model bounds must not move these shots.

End Sub

Sub ResetPartyDemo()

    Playback.DemoEnabled = True
    ViewerUiState.CalibrationVisible = False

    Call ViewerParty.ResetChoreography(Party)
    Call InitializePartyFormation()
    Call PreparePartyDragonTurn()

    If Party.Ready Then
        Session.Ready = Character3D.SetPartVisible(Party.Companion.Actor,
            WEAPON_PART_INDEX, SwordVisible) And Session.Ready
        Session.Ready = Character3D.SetPartVisible(Party.Companion.Actor,
            SHIELD_PART_INDEX, ShieldVisible) And Session.Ready
    End If

End Sub

Sub PreparePartyDragonTurn()

    Dim RolledTarget As Number

    Random RolledTarget From -1 To 1

    Call ViewerParty.PrepareDragonTurn(Party, RolledTarget)

End Sub

Sub AdvancePartyDemo()

    Dim Actions As ViewerParty.FrameActions
    Dim AttackMilliseconds As Number
    Dim RolledTarget As Number

    AttackMilliseconds = ViewerParty.AttackDuration(
        Party,
        Character,
        Party.Companion.Actor,
        Playback.PlaybackSpeed
    )
    RolledTarget = -1

    If ViewerParty.WillPrepareDragonTurn(
        Party,
        Playback.AnimationUpdateElapsed,
        Playback.DemoEnabled,
        Playback.ScenePaused,
        AttackMilliseconds,
        Playback.PlaybackSpeed
    ) Then
        Random RolledTarget From -1 To 1
    End If

    Actions = ViewerParty.AdvanceChoreography(
        Party,
        Playback.AnimationUpdateElapsed,
        Playback.DemoEnabled,
        Playback.ScenePaused,
        AttackMilliseconds,
        Playback.PlaybackSpeed,
        RolledTarget
    )

    Session.Ready = ViewerParty.ApplyFrame(
        Party,
        Actions,
        Character,
        ViewerCameraState.Frame,
        Playback.SelectedClip,
        Playback.PlaybackSpeed,
        ViewerDragon.PositionX(),
        0,
        ViewerDragon.PositionZ(),
        CHARACTER_MODEL_FORWARD_YAW_OFFSET
    ) And Session.Ready

End Sub

Sub UpdatePartyCompanion()

    Dim CompanionReady As Boolean
    Dim Primary As ViewerActors.Context

    If Not Party.Ready Then
        Return
    End If

    CompanionReady = ViewerActors.Update(
        Party.Companion, Playback.AnimationUpdateElapsed)
    Session.Ready = CompanionReady And Session.Ready
    Primary = CaptureActorContext()

    Call UseActorContext(Party.Companion)

    Call ApplyCharacterPresentationOffset()
    Call UpdateCalibrationForCurrentFrame()
    Call ApplyWristCalibration()
    Call ApplyEquipmentCoupling()

    If Effects.EpicGlowAvailable Then
        Session.Ready = ViewerEffects.UpdateBorrowedEpicGlow(
            Character,
            Effects.SwordGlow,
            Effects.ShieldGlow,
            ViewerCameraState.Frame.ScalePercent,
            CalibrationChannelValue(Playback.SelectedClip, 18) <> 0,
            CalibrationChannelValue(Playback.SelectedClip, 19) <> 0
        ) And Session.Ready
    End If

    Call ApplyEquipmentCalibration()

    Party.Companion = CaptureActorContext()
    Party.Companion.Ready = CompanionReady
    Party.Ready = CompanionReady

    Call UseActorContext(Primary)

End Sub

Function HandlePartyPointer() As Boolean

    Dim ReturnValue As Boolean

    Dim CapturesActive As Boolean
    Dim Decision As ViewerParty.PointerDecision

    CapturesActive = (ViewerInputState.TimelineScrubbing Or
        ViewerInputState.TimelineKeyframeDragging Or
        ViewerInputState.FrameButtonRepeatDirection <> 0 Or
        ViewerInputState.SliderDragOwner <> 0 Or
        ViewerGizmoState.Dragging)
    Decision = ViewerParty.ClassifyPointer(
        Pointer_X(),
        Pointer_Y(),
        Pointer_Pressed(POINTER_PRIMARY),
        Pointer_Pressed(POINTER_SECONDARY),
        ViewerUiState.Visibility,
        ViewerUiState.CalibrationVisible,
        CapturesActive,
        Window_Height(),
        StatusPanelX(),
        GlowButtonX(),
        GlowButtonWidth()
    )

    If Decision.Action = ViewerParty.POINTER_ACTION_RESET_VIEW Then

        Call ResetView()

    Else If Decision.Action = ViewerParty.POINTER_ACTION_RESET_INSPECTOR Then

        Call ResetPartyInspector()

    Else If Decision.Action = ViewerParty.POINTER_ACTION_TOGGLE_GLOW Then

        Call ToggleEpicGlow()

    Else If Decision.Action = ViewerParty.POINTER_ACTION_CYCLE_SOCKET Then

        Call ViewerRendering.CycleSocketDisplay(Rendering)

    Else If Decision.Action = ViewerParty.POINTER_ACTION_SPEED_DOWN Then

        Call AdjustPlaybackSpeed(-25)

    Else If Decision.Action = ViewerParty.POINTER_ACTION_SPEED_UP Then

        Call AdjustPlaybackSpeed(25)

    Else If Decision.Action = ViewerParty.POINTER_ACTION_TOGGLE_DRAGON Then

        Call ToggleDragon()

    Else If Decision.Action = ViewerParty.POINTER_ACTION_TOGGLE_SWORD Then

        Call ToggleSword()

    Else If Decision.Action = ViewerParty.POINTER_ACTION_TOGGLE_SHIELD Then

        Call ToggleShield()

    Else If Decision.Action = ViewerParty.POINTER_ACTION_TOGGLE_FLOOR Then

        Call ToggleFloorAndGrid()

    Else If Decision.Action = ViewerParty.POINTER_ACTION_CYCLE_BACKGROUND Then

        Call CycleBackground()

    Else If Decision.Action = ViewerParty.POINTER_ACTION_TOGGLE_PAUSE Then

        Call BeginPartyInspector()
        Call ToggleScenePause()
        Call EndPartyInspector()

    Else If Decision.Action = ViewerParty.POINTER_ACTION_TOGGLE_ORBIT Then

        Call ViewerCamera.ToggleAutoOrbit(ViewerCameraState)

    Else If Decision.Action = ViewerParty.POINTER_ACTION_RESTART Then

        Call ResetPartyInspector()

    Else If Decision.Action = ViewerParty.POINTER_ACTION_TOGGLE_FIRE Then

        Call ViewerEffects.ToggleFlamePause(Effects)

    Else If Decision.Action = ViewerParty.POINTER_ACTION_TOGGLE_LIGHTNING Then

        Call ViewerEffects.ToggleLightningPause(Effects)

    Else If Decision.Action = ViewerParty.POINTER_ACTION_TOGGLE_SHIELD_STYLE Then

        Call ViewerEffects.ToggleShieldFireStyle(Effects)

    End If

    ReturnValue = Decision.Consumed

    Return ReturnValue

End Function
