Dim FrameButtonRepeatAt As Number
Dim FlameAnimationPaused As Boolean
Dim FlamesWerePaused As Boolean
Dim VisualContinuityEpoch As Number
Dim EquipmentFireEpoch As Number
Dim VisualHistoryDirty As Boolean
Dim EquipmentFireFirstSample As Boolean
Dim EquipmentFireFirstError As Number
Dim SwordTrail As Core.ParticleBatch3D
Dim ShieldTrail As Core.ParticleBatch3D
Dim SwordTrailPoints[EQUIPMENT_TRAIL_POINT_COUNT] As Core.Vector3
Dim ShieldTrailPoints[EQUIPMENT_TRAIL_POINT_COUNT] As Core.Vector3
Dim EquipmentTrailElapsed As Number
Dim EquipmentTrailAnimationTime As Number
Dim SwordTrailActive As Boolean
Dim ShieldTrailActive As Boolean
Dim Ready As Boolean
Dim Running As Boolean
Dim ViewerError As Boolean
Dim WindowActivated As Boolean
Dim FirstViewerError As Number
Dim FirstRendererError As Number
Dim FirstFailureStage As Number
Dim ViewerEpoch As Number
Dim InterfacePointerBlocked As Boolean
Dim UiVisibility As Number
Dim SelectedClip As Number
Dim LightingIndex As Number
Dim ProfileIndex As Number
Dim PlaybackSpeed As Number
Dim MaterialInspection As Number
Dim SelectedTimelineEvent As Number
Dim Key As Number
Dim CurrentTime As Number
Dim PreviousTime As Number
Dim RawFrameMilliseconds As Number
Dim AnimationElapsed As Number
Dim CameraElapsed As Number
Dim PresentationElapsed As Number
Dim DroppedAnimationMilliseconds As Number
Dim DroppedCameraMilliseconds As Number
Dim LongPauseCount As Number
Dim ViewerClock As CharacterViewer.ClockState
Dim FitLocked As Boolean
Dim LastFitWidth As Number
Dim LastFitHeight As Number
Dim FrameRateElapsed As Number
Dim FrameRateFrames As Number
Dim CurrentFramesPerSecond As Number
Dim PanPointerRemainderX As Number
Dim PanPointerRemainderY As Number
Dim OrbitPointerRemainderX As Number
Dim OrbitPointerRemainderY As Number
Dim AutoOrbit As Boolean
Dim AutoOrbitYaw1000 As Number
Dim PartyOrbitCamera As Core.Camera3D
Dim PartyHeroCamera As Core.Camera3D
Dim PartyDragonCamera As Core.Camera3D
Dim PartyOrbitPhase1000 As Number
Dim PartyActiveCamera As Number
Dim PartyPreviousCamera As Number
Dim PartyPreviousCameraTurn As Number
Dim PartyShotPosition1000 As Core.Vector3
Dim PartyShotTarget1000 As Core.Vector3
