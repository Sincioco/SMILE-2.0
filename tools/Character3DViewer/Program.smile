''' Reusable SM3D character inspection project. Arin and Orin share the editor and party arena.

Option Explicit

Import Smile.Simple3D.Character3D As Character3D
Import Smile.Simple3D.CharacterViewer As CharacterViewer
Import Smile.UI.Controls As UI
Import Smile.Simple3D.Core As Core
Import Smile.Simple3D.Graphics3D As Graphics3D
Import Smile.Simple3D.Scene3D As Scene3D
Import Smile.Tools.Character3DViewerProfiles As ViewerProfiles
Import Smile.Tools.BattleAudio As BattleAudio
Import Smile.Tools.BattleCamera As BattleCamera
Import Smile.Tools.Character3DViewerTiming As ViewerTiming
Import Smile.Tools.Character3DViewerSession As ViewerSession
Import Smile.Tools.Character3DViewerPlayback As ViewerPlayback
Import Smile.Tools.Character3DViewerActors As ViewerActors
Import Smile.Tools.Character3DViewerCamera As ViewerCamera
Import Smile.Tools.Character3DViewerCalibration As ViewerCalibration
Import Smile.Tools.Character3DViewerCalibrationEditing As ViewerCalibrationEditing
Import Smile.Tools.Character3DViewerInput As ViewerInput
Import Smile.Tools.Character3DViewerUi As ViewerUi
Import Smile.Tools.Character3DViewerGizmo As ViewerGizmo
Import Smile.Tools.Character3DViewerParty As ViewerParty
Import Smile.Tools.Character3DViewerEffects As ViewerEffects
Import Smile.Tools.Character3DViewerDragon As ViewerDragon
Import Smile.Tools.Character3DViewerRendering As ViewerRendering

Const ANIMATION_CYCLE_MILLISECONDS = 5000
Const ORBIT_POINTER_DIVISOR = 1
Const PAN_POINTER_DIVISOR = 3
Const DEFAULT_ZOOM_DEGREES = -16
Const ZOOM_IN_LIMIT = -144
Const CLOSE_UP_ZOOM_START = -48
Const CLOSE_UP_MINIMUM_DISTANCE_1000 = 100
Const ZOOM_OUT_LIMIT = 36
Const MAX_RAW_FRAME_MILLISECONDS = 60000
Const MAX_ANIMATION_ELAPSED = 250
Const MAX_CAMERA_ELAPSED = 250
Const FRAME_BUTTON_REPEAT_MILLISECONDS = 300
Const SHIELD_PART_INDEX = 0
Const WEAPON_PART_INDEX = 1
Const BODY_PART_INDEX = 2
Const CHARACTER_MODEL_FORWARD_YAW_OFFSET = 180
Const ORIN_ARENA_YAW_ADJUSTMENT = -55
Const ARENA_INITIAL_ORBIT_YAW = 0
Const ARENA_ORBIT_DEGREES_PER_SECOND = 12
Const ARENA_CAMERA_DISTANCE = 480
Const ARENA_CAMERA_HEIGHT = 180
Const ARENA_CAMERA_CENTER_X = -70
Const ARENA_CAMERA_CENTER_Z = -45
Const ARENA_DEFAULT_ZOOM_DEGREES = -15
Const ARENA_FLOOR_WIDTH = 1000
Const ARENA_FLOOR_DEPTH = 1000
Const CALIBRATION_MAX_CLIPS = ViewerCalibration.MAX_CLIPS
Const TRANSFORM_GIZMO_MOVE_DIVISOR = 3
Const TRANSFORM_GIZMO_ROTATE_DIVISOR = 1000
Const BACKGROUND_COUNT = 5
Const BACKDROP_LANDSCAPE_PATH = "Assets\Backgrounds\SinStarLandscape.png"
Const BACKDROP_TITLE_PATH = "Assets\Backgrounds\SinStarTitleWithLogo.png"
Const PARTY_FORMATION_RADIUS = 300
Const PARTY_FORMATION_START_ANGLE = 10
Const PARTY_FORMATION_END_ANGLE = 50
Dim Party As ViewerParty.State
Dim Character As Character3D.Actor
Dim CharacterBounds As Character3D.Bounds3D
Dim LocalCharacterBounds As Character3D.Bounds3D
Dim ActiveProfile As CharacterViewer.Profile
Dim Rendering As ViewerRendering.State
Dim Effects As ViewerEffects.State
Dim DragonState As ViewerDragon.State
Dim LightingIndex As Number
Dim MaterialInspection As Number
Dim Key As Number
Dim FrameRate As ViewerTiming.FrameRateState
Dim Timing As ViewerTiming.ClockState
Dim Session As ViewerSession.State
Dim Playback As ViewerPlayback.State
Dim ViewerCameraState As ViewerCamera.State
Dim Calibration As ViewerCalibration.State
Dim ViewerInputState As ViewerInput.State
Dim ViewerUiState As ViewerUi.State
Dim ViewerGizmoState As ViewerGizmo.State
Dim SwordVisible As Boolean
Dim ShieldVisible As Boolean
Dim CalibrationAvailable As Boolean
Dim SwordWristNode As Number
Dim ShieldWristNode As Number

Game Window "SMILE 2.0 - 3D Viewer, Animation Editor" Size 1600 By 640

Call Graphics3D.ResetRenderer3D()

Session.SelectedCharacterTab = 3
Party.Enabled = True
Session.ProfileIndex = ViewerProfiles.PROFILE_ARIN

Call ViewerPlayback.Reset(Playback, 100)
Call ViewerInput.Reset(ViewerInputState)
Call ViewerUi.Reset(ViewerUiState)
Call ViewerGizmo.Reset(ViewerGizmoState)
Call ViewerRendering.Reset(Rendering, 3)

Call LoadViewer()
Call ViewerSession.CaptureFailure(Session, 20)

Session.Running = True

Call ViewerTiming.Start(Timing, Timer())

Do

    Get Key Key

    Call HandleKeyboard(Key)

    Call ViewerSession.CaptureFailure(Session, 21)

    ViewerInputState.InterfaceBlocked = HandleInterfacePointer()

    Call ViewerSession.CaptureFailure(Session, 22)

    Call UpdateCameraPointer(ViewerInputState.InterfaceBlocked)

    Call ViewerSession.CaptureFailure(Session, 23)

    Session.Ready = ViewerTiming.AdvanceClock(
        Timing,
        Timer(),
        MAX_ANIMATION_ELAPSED,
        MAX_CAMERA_ELAPSED,
        MAX_RAW_FRAME_MILLISECONDS
    ) And Session.Ready

    Call ViewerSession.CaptureFailure(Session, 24)

    Call ViewerTiming.Advance(FrameRate, Timing.RawFrameMilliseconds)

    If Not Session.ViewerError Then

        If Not Playback.ScenePaused Then
            Call AdvanceAnimationSequence()

            Call ViewerSession.CaptureFailure(Session, 2)
        End If

        Call ViewerPlayback.ResolveAnimationElapsed(Playback, Timing.AnimationElapsed)

        If Party.Enabled Then
            Call AdvancePartyDemo()
        End If

        Session.Ready = Character3D.Update(Character, Playback.AnimationUpdateElapsed) And Session.Ready

        Call ViewerSession.CaptureFailure(Session, 3)

        Session.Ready = ViewerActors.ApplyPresentationOffset(
            Character,
            Session.ProfileIndex,
            Playback.SelectedClip,
            ViewerCameraState.Frame
        ) And Session.Ready

        If CalibrationAvailable Then

            Call UpdateCalibrationForCurrentFrame()
            Call ApplyWristCalibration()
            Call ApplyEquipmentCoupling()
            Call ViewerSession.CaptureFailure(Session, 4)

        End If

        Session.Ready = ViewerCamera.AdvanceZoom(
            ViewerCameraState, Timing.CameraElapsed) And Session.Ready

        Call ViewerSession.CaptureFailure(Session, 5)

        If Not Playback.ScenePaused Then
            Session.Ready = ViewerCamera.AdvanceAutoOrbit(
                ViewerCameraState,
                Party.OrbitPhase1000,
                Timing.CameraElapsed,
                ARENA_ORBIT_DEGREES_PER_SECOND,
                Party.Enabled
            ) And Session.Ready

            Call ViewerSession.CaptureFailure(Session, 6)
        End If

        Call ViewerCamera.UpdateResponsiveFit(
            ViewerCameraState,
            ActiveProfile,
            LocalCharacterBounds,
            Window_Width(),
            Window_Height(),
            Max(1, Window_Width() - 284),
            DragonState.Available,
            ARENA_CAMERA_CENTER_X,
            ARENA_CAMERA_CENTER_Z,
            ARENA_CAMERA_DISTANCE,
            ARENA_CAMERA_HEIGHT
        )

        Call ViewerCamera.Compose(
            ViewerCameraState, Party.Enabled And ViewerCameraState.AutoOrbit)

        Call ViewerCamera.ApplyCloseUp(ViewerCameraState, CLOSE_UP_ZOOM_START,
            ZOOM_IN_LIMIT, CLOSE_UP_MINIMUM_DISTANCE_1000)
        Call ViewerCamera.ApplyCalibrationOrbitAnchor(
            ViewerCameraState, Window_Width(), Window_Height())

        If Effects.EpicGlowVisible Then

            If Not ViewerEffects.UpdateEpicGlow(
                Effects,
                Character,
                Session.ProfileIndex,
                ViewerCameraState.Frame.ScalePercent,
                Playback.AnimationUpdateElapsed,
                ViewerPlayback.SelectedClipName(Character, Playback),
                SwordVisible,
                ShieldVisible,
                ViewerCalibration.ChannelValue(
                    Calibration, Playback.SelectedClip, 18) <> 0,
                ViewerCalibration.ChannelValue(
                    Calibration, Playback.SelectedClip, 19) <> 0
            ) Then
                Effects.EpicGlowVisible = False
            End If

        End If

        If CalibrationAvailable Then
            Call ApplyEquipmentCalibration()

            Call ViewerSession.CaptureFailure(Session, 7)
        End If

        Call ViewerEffects.UpdateEquipmentFire(
            Effects,
            Character,
            Session.ProfileIndex,
            Party.Enabled And
                ViewerParty.PresentationState(Party, 0) = ViewerParty.STATE_KO,
            SwordVisible,
            ShieldVisible,
            ViewerUiState.CalibrationEditing,
            Playback.ScenePaused,
            Playback.SelectedClip,
            ViewerPlayback.SelectedClipLabel(
                Character, Playback, Session.ProfileIndex),
            ViewerCameraState.Live,
            Timing.CameraElapsed
        )

        If Party.Enabled Or Session.DragonInspection Then
            Call UpdatePartyCompanion()
        End If

        If Session.DragonInspection Then
            Call UpdateDragonOpponent()
        End If

        Call UpdateDragon()
        Call ViewerParty.ApplyAttackCamera(
            Party,
            ViewerCameraState.Live,
            ViewerCameraState.Frame,
            DragonState.Actor,
            DragonState.Available,
            DragonState.Visible,
            ViewerCameraState.AutoOrbit,
            Playback.PlaybackSpeed,
            Timing.CameraElapsed,
            ViewerParty.AttackDuration(
                Party,
                Character,
                Party.Companion.Actor,
                Playback.PlaybackSpeed
            ),
            ViewerDragon.PositionX(),
            ViewerDragon.PositionZ()
        )

        If Rendering.FloorVisible Then
            Call ViewerCamera.KeepAboveGround(ViewerCameraState, 0)
        End If

        Call UpdateBattleAudio()
        Call UpdateOrinStorm()

        Session.Ready = ViewerEffects.AdvanceScene(
            Effects,
            Timing.CameraElapsed,
            Playback.ScenePaused,
            ViewerCameraState.Live
        ) And Session.Ready

        If Rendering.SocketGizmosVisible Then
            Session.Ready = ViewerRendering.UpdateSocketGizmos(
                Rendering,
                Character,
                ViewerProfiles.IsPartyCharacter(Session.ProfileIndex),
                BODY_PART_INDEX,
                WEAPON_PART_INDEX,
                SHIELD_PART_INDEX
            ) And Session.Ready
        End If

        If Character3D.IsValid(Character) Then
            CharacterBounds = Character3D.WorldBounds(Character, ActiveProfile.AnimationMargin)
        End If

        Session.Ready = BeginViewerScene() And Session.Ready

        Call ViewerSession.CaptureFailure(Session, 8)

        If Session.Ready Then

            If Rendering.FloorVisible Then
                Session.Ready = ViewerRendering.DrawFloor(Rendering)

                Call ViewerSession.CaptureFailure(Session, 9)
            End If

            If Rendering.GridVisible Then
                Session.Ready = ViewerRendering.DrawGrid(Rendering) And Session.Ready

                Call ViewerSession.CaptureFailure(Session, 10)
            End If

            If DragonState.Visible And Not Session.DragonInspection Then
                Session.Ready = ViewerDragon.Draw(DragonState) And Session.Ready

                Call ViewerSession.CaptureFailure(Session, 11)
            End If

            If Effects.EpicGlowVisible Then

                If ((Not Party.Enabled Or
                    ViewerParty.PresentationState(Party, 0) <> ViewerParty.STATE_KO) And
                    Not ViewerEffects.DrawEquipmentGlow(
                        Effects,
                        Session.ProfileIndex,
                        SwordVisible,
                        ShieldVisible
                    )) Then
                    Effects.EpicGlowVisible = False
                End If

            End If

            Session.Ready = Character3D.Draw(Character) And Session.Ready

            If (Party.Enabled Or Session.DragonInspection) And Party.Ready Then
                Session.Ready = ViewerParty.DrawCompanion(
                    Party,
                    Party.Enabled,
                    Session.DragonInspection,
                    Effects.EpicGlowVisible,
                    SwordVisible
                ) And Session.Ready
            End If

            If Session.DragonInspection Then
                Session.Ready = ViewerParty.DrawDragonOpponent(
                    Party,
                    Party.Enabled,
                    Session.DragonInspection,
                    Effects.EpicGlowVisible,
                    SwordVisible
                ) And Session.Ready
            End If

            Call ViewerSession.CaptureFailure(Session, 12)

            Call ViewerEffects.DrawEquipmentFire(Effects, SwordVisible, ShieldVisible)

            Session.Ready = ViewerEffects.DrawScene(Effects) And Session.Ready

            Call ViewerDragon.DrawEffects(DragonState)

            If Effects.EpicGlowVisible Then

                If Not ViewerEffects.DrawEpicGlow(
                    Effects,
                    Session.ProfileIndex,
                    SwordVisible,
                    ShieldVisible
                ) Then
                    Effects.EpicGlowVisible = False
                End If

            End If

            If Rendering.SocketGizmosVisible Then
                Session.Ready = ViewerRendering.DrawSocketGizmos(Rendering) And Session.Ready
            End If

            Session.Ready = Scene3D.EndScene() And Session.Ready

            Call ViewerSession.CaptureFailure(Session, 13)

        End If

        If Not Session.Ready Then
            Call ViewerSession.RecordError(Session)
        End If

    End If

    Call ViewerEffects.DrawStormFlash(Effects)
    Call DrawViewerOverlay()

    Show Screen

    Session.Running = Session.Running And Not Game_Closed()

Loop Until Not Session.Running

Call DestroyViewer()

Sub LoadViewer()

    Session.Ready = Scene3D.SetQuality(Scene3D.QUALITY_HIGH)
    Session.Ready = Character3D.SetUnusedAssetCacheLimit(3) And Session.Ready

    Call ViewerParty.EndInspectorBinding(Party)
    Call ViewerParty.ClearPreview(Party)

    ActiveProfile = ViewerProfiles.ProfileAt(Session.ProfileIndex)
    Calibration.KeyBase = 0

    If Session.ProfileIndex = ViewerProfiles.PROFILE_ORIN Then
        Calibration.KeyBase = CALIBRATION_MAX_CLIPS
    End If

    Call ViewerDragon.SetAvailable(
        DragonState,
        ViewerProfiles.IsPartyCharacter(Session.ProfileIndex) Or Session.DragonInspection
    )

    SwordVisible = True
    ShieldVisible = True
    Session.Ready = CharacterViewer.ValidateProfile(ActiveProfile) And Session.Ready
    Session.Ready = Window_Title(ViewerTitle()) And Session.Ready

    Call ViewerSession.CaptureFailure(Session, 30)

    Character = Character3D.LoadWithPolicy(
        ActiveProfile.AssetPath,
        Character3D.CHARACTER_LOAD_REQUIRE_PBR
    )
    Session.Ready = Character3D.IsValid(Character) And Session.Ready

    Call ViewerSession.CaptureFailure(Session, 31)

    Session.Ready = ValidateLoadedProfile() And Session.Ready

    Call ViewerSession.CaptureFailure(Session, 32)

    LocalCharacterBounds = Character3D.LocalBounds(Character)
    ViewerCameraState.Base = Graphics3D.DefaultCamera()
    ViewerCameraState.Frame = CharacterViewer.AutoFit(
        ActiveProfile,
        LocalCharacterBounds,
        Max(1, Window_Width() - 284),
        Max(1, Window_Height()),
        ViewerCameraState.Base.FovDegrees
    )
    Session.Ready = ViewerCameraState.Frame.Valid And Session.Ready

    If Session.DragonInspection Then

        ViewerCameraState.Frame.ScalePercent = ViewerDragon.ScalePercent()
        ViewerCameraState.Frame.PositionX = ViewerDragon.PositionX()
        ViewerCameraState.Frame.PositionY = 0
        ViewerCameraState.Frame.PositionZ = ViewerDragon.PositionZ()

    End If

    Call ViewerSession.CaptureFailure(Session, 33)

    Call ViewerCamera.SetBaseFromFrame(
        ViewerCameraState,
        DragonState.Available,
        ARENA_CAMERA_CENTER_X,
        ARENA_CAMERA_CENTER_Z,
        ARENA_CAMERA_DISTANCE,
        ARENA_CAMERA_HEIGHT
    )

    Call CreateBackdrop()
    Call ViewerRendering.CreateArena(Rendering, ViewerFloorWidth(), ViewerFloorDepth())

    Session.Ready = ViewerRendering.ArenaReady(Rendering) And Session.Ready

    Call ViewerSession.CaptureFailure(Session, 34)

    Rendering.FloorVisible = True
    Rendering.GridVisible = True
    ViewerCameraState.FitLocked = True
    ViewerCameraState.LastFitWidth = Window_Width()
    ViewerCameraState.LastFitHeight = Window_Height()

    Call ViewerCamera.Reset(ViewerCameraState, 0, DefaultZoomDegrees(),
        ZOOM_IN_LIMIT, ZOOM_OUT_LIMIT, 96000)

    Session.Ready = Scene3D.SetQuality(Scene3D.QUALITY_HIGH)

    If DragonState.Available Then
        Session.Ready = Scene3D.SetShadowArea(
            ViewerDragon.PositionX() / 2,
            ViewerCameraState.Frame.TargetY,
            ViewerDragon.PositionZ() / 2,
            ARENA_FLOOR_WIDTH,
            ARENA_FLOOR_DEPTH,
            ViewerCameraState.Frame.ShadowNear,
            ARENA_FLOOR_DEPTH
        ) And Session.Ready
    Else
        Session.Ready = Scene3D.SetShadowArea(
            0,
            ViewerCameraState.Frame.TargetY,
            0,
            ViewerCameraState.Frame.ShadowWidth,
            ViewerCameraState.Frame.ShadowDepth,
            ViewerCameraState.Frame.ShadowNear,
            ViewerCameraState.Frame.ShadowFar
        ) And Session.Ready
    End If

    Call ViewerSession.CaptureFailure(Session, 35)

    Call ApplyLighting()

    Session.Ready = Character3D.SetScale(Character, ViewerCameraState.Frame.ScalePercent) And Session.Ready
    Session.Ready = Character3D.Place(
        Character,
        ViewerCameraState.Frame.PositionX,
        ViewerCameraState.Frame.PositionY,
        ViewerCameraState.Frame.PositionZ
    ) And Session.Ready

    Call ApplyArenaFacing()

    Session.Ready = Character3D.SetShadows(Character, True, True) And Session.Ready

    Call ViewerSession.CaptureFailure(Session, 36)

    Session.Ready = ViewerDragon.Create(
        DragonState,
        Character,
        Session.DragonInspection
    ) And Session.Ready

    Call ViewerSession.CaptureFailure(Session, 37)

    Session.Ready = ViewerRendering.CreateSocketGizmos(Rendering) And Session.Ready

    Call ViewerSession.CaptureFailure(Session, 38)

    Call ViewerEffects.CreateEpicGlow(Effects, Session.ProfileIndex, Character)

    Call ViewerSession.CaptureFailure(Session, 39)

    Call ConfigureCalibration()

    Call ViewerSession.CaptureFailure(Session, 40)

    Playback.PlaybackSpeed = ActiveProfile.DefaultPlaybackSpeed
    MaterialInspection = Graphics3D.MATERIAL_INSPECTION_LIT
    Session.Ready = Graphics3D.SetMaterialInspection3D(MaterialInspection) And Session.Ready

    Call ViewerSession.CaptureFailure(Session, 41)

    Call RestartPresentation()

    Call ViewerSession.CaptureFailure(Session, 42)

    Call ViewerEffects.ResetEquipmentDefaults(Effects)

    Session.Ready = ViewerEffects.PrepareShared(Effects) And Session.Ready

    Call ViewerEffects.PrepareFire(
        Effects,
        DragonState.Available,
        CalibrationAvailable And Session.ProfileIndex = ViewerProfiles.PROFILE_ARIN
    )

    If DragonState.Available Then
        Call ViewerDragon.InitializeEffects()
    End If

    If Party.Enabled Then
        Call CreatePartyCompanion()
    End If

    If Session.DragonInspection Then

        Call CreatePartyCompanion(ViewerProfiles.PROFILE_ARIN)

        Party.DragonOpponent = Party.Companion

        Call CreatePartyCompanion()
        Call PositionDragonOpponents()

        Call ViewerEffects.EnableSwordFire(Effects)

    End If

    If (Party.Enabled Or
        Session.DragonInspection Or
        Session.ProfileIndex = ViewerProfiles.PROFILE_ORIN) Then
        Session.Ready = ViewerEffects.PrepareLightning(Effects) And Session.Ready
    End If

    Session.ViewerEpoch = Graphics3D.ResourceEpoch3D()

    If Not Session.Ready Then
        Call ViewerSession.RecordError(Session)
    End If

End Sub

Function ValidateLoadedProfile() As Boolean

    Dim Result As Boolean
    Dim Index As Number

    Result = Character3D.IsValid(Character)
    Result = Character3D.ClipCount(Character) = ActiveProfile.ExpectedClipCount And Result
    Result = Character3D.SocketCount(Character) = ActiveProfile.ExpectedSocketCount And Result

    For Index = 0 To ViewerProfiles.ClipCount(Session.ProfileIndex) - 1
        Result = Character3D.HasClip(
            Character,
            ViewerProfiles.ClipName(Session.ProfileIndex, Index)
        ) And Result
    End For

    For Index = 0 To ViewerProfiles.SocketCount(Session.ProfileIndex) - 1
        Result = Character3D.HasSocket(
            Character,
            ViewerProfiles.SocketName(Session.ProfileIndex, Index)
        ) And Result
    End For

    Return Result

End Function

Function ViewerFloorWidth() As Number

    Dim Result As Number

    Result = ViewerCameraState.Frame.FloorWidth

    If DragonState.Available Then
        Result = Max(Result, ARENA_FLOOR_WIDTH)
    End If

    Return Result

End Function

Function ViewerFloorDepth() As Number

    Dim Result As Number

    Result = ViewerCameraState.Frame.FloorDepth

    If DragonState.Available Then
        Result = Max(Result, ARENA_FLOOR_DEPTH)
    End If

    Return Result

End Function

Function InitialViewerOrbitYaw() As Number

    Dim Result As Number

    If DragonState.Available Then
        Result = ARENA_INITIAL_ORBIT_YAW
    Else
        Result = ViewerProfiles.InitialOrbitYaw(Session.ProfileIndex)
    End If

    Return Result

End Function

Function DefaultZoomDegrees() As Number

    Dim Result As Number

    If DragonState.Available Then
        Result = ARENA_DEFAULT_ZOOM_DEGREES
    Else
        Result = DEFAULT_ZOOM_DEGREES
    End If

    Return Result

End Function

Sub ApplyArenaFacing()

    If Session.DragonInspection Then
        Session.Ready = Character3D.Rotate(
            Character,
            0,
            ViewerDragon.RotationY(),
            0
        ) And Session.Ready
    Else If DragonState.Available Then
        Session.Ready = ViewerActors.FaceToward(
            Character,
            ViewerDragon.PositionX(),
            0,
            ViewerDragon.PositionZ(),
            CHARACTER_MODEL_FORWARD_YAW_OFFSET,
            CharacterArenaYawAdjustment()
        ) And Session.Ready
    Else
        Session.Ready = Character3D.Rotate(Character, 0, 0, 0) And Session.Ready
    End If

End Sub

Function CharacterArenaYawAdjustment() As Number

    Dim Result As Number

    If Session.ProfileIndex = ViewerProfiles.PROFILE_ORIN Then
        Result = ORIN_ARENA_YAW_ADJUSTMENT
    End If

    Return Result

End Function

Sub UpdateDragon()

    Dim Name As Text
    Dim Target As Core.Vector3
    Dim ReactionRequested As Boolean

    If Not ViewerDragon.IsValid(DragonState) Then
        Call ViewerDragon.ClearOwnedEffects(DragonState, Effects.DragonLight)

        Return
    End If

    If Not DragonState.Visible Then
        Call ViewerDragon.ClearOwnedEffects(DragonState, Effects.DragonLight)

        Return
    End If

    ReactionRequested = (Party.Enabled And
        Party.DragonReactionPending And
        Party.Stage = 1 And
        Party.Elapsed >= 1300 + ViewerParty.AttackDuration(
            Party,
            Character,
            Party.Companion.Actor,
            Playback.PlaybackSpeed
        ) * 64 / 100)
    Name = ViewerDragon.DesiredClip(
        DragonState,
        Session.DragonInspection,
        ViewerPlayback.SelectedClipName(Character, Playback),
        Party.Enabled,
        Playback.ScenePaused,
        Party.Turn,
        Party.DragonCounter,
        ReactionRequested
    )

    If ReactionRequested And Name = "Hit" Then
        Party.DragonReactionPending = False
    End If

    If Session.DragonInspection Then

        Target = Character3D.SocketPosition(
            Party.DragonOpponent.Actor,
            "Chest",
            BODY_PART_INDEX
        )

        If Party.Ready And Party.DragonCounter Mod 2 = 1 Then
            Target = Character3D.SocketPosition(
                Party.Companion.Actor,
                "Chest",
                BODY_PART_INDEX
            )
        End If

    Else If (Party.Enabled And
        Party.Ready And
        Party.HitTarget = 1) Then

        Target = Character3D.SocketPosition(
            Party.Companion.Actor,
            "Chest",
            BODY_PART_INDEX
        )

    Else
        Target = Character3D.SocketPosition(Character, "Chest", BODY_PART_INDEX)

    End If

    Session.Ready = ViewerDragon.Update(
        DragonState,
        Name,
        Session.DragonInspection,
        Playback.PlaybackSpeed,
        Playback.AnimationUpdateElapsed,
        Target,
        Effects.VisualContinuityEpoch,
        Effects.FlamePaused,
        Effects.FireInitialized,
        Effects.DragonLight
    ) And Session.Ready

End Sub

Sub UpdateBattleAudio()

    Dim Name As Text
    Dim CueTime As Number
    Dim Audible As Boolean

    Name = ViewerPlayback.SelectedClipName(Character, Playback)
    CueTime = -1

    If Session.ProfileIndex = ViewerProfiles.PROFILE_ARIN Then

        If Name = "SwordAttack" Then
            CueTime = 280
        Else If Name = "SwordAttack2" Then
            CueTime = 160
        End If

    End If

    Audible = Not Playback.ScenePaused And Not ViewerUiState.CalibrationEditing

    If BattleAudio.CrossedCue(Effects.ArinAudio, Name,
        Character3D.AnimationTime(Character), CueTime, Audible) Then

        If Name = "SwordAttack" Then

            Play Sound "Assets/Audio/arin-flame-slash.wav"

        Else

            Play Sound "Assets/Audio/arin-flame-crosscut.wav"

        End If

    End If

    Call ViewerDragon.UpdateAudio(DragonState, Audible)

End Sub

Sub CancelInteractionCaptures()

    If ViewerGizmoState.Dragging Then
        Call FinishTransformGizmoDrag()
    End If

    If ViewerInputState.TimelineKeyframeDragging Then
        Session.Ready = Character3D.SetAnimationTime(
            Character,
            ViewerCalibration.FrameTimeMilliseconds(
                Character,
                Playback.SelectedClip,
                ViewerInputState.TimelineDraggedOriginalFrame
            )
        ) And Session.Ready
    End If

    If (ViewerInputState.TimelineScrubbing Or
        ViewerInputState.TimelineKeyframeDragging) Then
        Call RestorePartyPreview()
    End If

    Call ViewerInput.CancelCaptures(ViewerInputState)
    Call ViewerCamera.CancelPointerControls(ViewerCameraState)

End Sub

Sub HandleKeyboard(PressedKey As Number)

    If (Party.Enabled And
        (PressedKey = KEY_4 Or
        (PressedKey = KEY_ENTER And Not ViewerUiState.CalibrationEditing And Not ViewerGizmoState.Dragging))) Then

        If PressedKey = KEY_ENTER Then
            Call ResetPartyInspector()
        End If

        Return

    End If

    Call BeginPartyInspector()
    Call HandleInspectorKeyboard(PressedKey)
    Call EndPartyInspector()

End Sub

Sub HandleInspectorKeyboard(PressedKey As Number)

    Dim ArrowCommand As Number

    If PressedKey = KEY_BACKTICK Then

        Call ViewerUi.CycleVisibility(ViewerUiState)
        Call CancelInteractionCaptures()

        Return

    End If

    If HandleTransformGizmoKeyboard(PressedKey) Then
        Return
    End If

    If PressedKey = KEY_SPACE Then
        Call ToggleScenePause()

        Return
    End If

    If PressedKey = KEY_F Then
        Call ToggleFloorAndGrid()

        Return
    End If

    If PressedKey = KEY_D Then
        Call ToggleDragon()

        Return
    End If

    If PressedKey = KEY_W Then
        Call ToggleSword()

        Return
    End If

    If PressedKey = KEY_S Then
        Call ToggleShield()

        Return
    End If

    If ViewerUiState.CalibrationEditing Then
        Return
    End If

    If Party.Enabled Then

        If (PressedKey = KEY_1 Or
            PressedKey = KEY_2 Or
            PressedKey = KEY_3 Or
            PressedKey = KEY_TAB Or
            PressedKey = KEY_R) Then
            Return
        End If

    End If

    ArrowCommand = ViewerInput.ClassifyArrow(
        PressedKey,
        KEY_LEFT,
        KEY_RIGHT,
        KEY_UP,
        KEY_DOWN,
        Key_Event_Held(KEY_CONTROL)
    )

    If PressedKey = KEY_B Then

        Call CycleBackground()

    Else If ArrowCommand = ViewerInput.ARROW_FRAME_PREVIOUS Then

        Call StepAnimationFrame(-1)

    Else If ArrowCommand = ViewerInput.ARROW_FRAME_NEXT Then

        Call StepAnimationFrame(1)

    Else If (ArrowCommand = ViewerInput.ARROW_PLAIN_LEFT And
        Rendering.SocketGizmosVisible) Then

        Call ViewerRendering.SelectPreviousSocket(
            Rendering, Character3D.SocketCount(Character))

    Else If (ArrowCommand = ViewerInput.ARROW_PLAIN_RIGHT And
        Rendering.SocketGizmosVisible) Then

        Call ViewerRendering.SelectNextSocket(
            Rendering, Character3D.SocketCount(Character))

    Else If ArrowCommand = ViewerInput.ARROW_PLAIN_LEFT Then

        Session.Ready = ViewerCamera.NudgeOrbit(
            ViewerCameraState, -5, 0) And Session.Ready

    Else If ArrowCommand = ViewerInput.ARROW_PLAIN_RIGHT Then

        Session.Ready = ViewerCamera.NudgeOrbit(
            ViewerCameraState, 5, 0) And Session.Ready

    Else If ArrowCommand = ViewerInput.ARROW_PLAIN_UP Then

        Session.Ready = ViewerCamera.NudgeOrbit(
            ViewerCameraState, 0, -5) And Session.Ready

    Else If ArrowCommand = ViewerInput.ARROW_PLAIN_DOWN Then

        Session.Ready = ViewerCamera.NudgeOrbit(
            ViewerCameraState, 0, 5) And Session.Ready

    Else If PressedKey = KEY_A Then

        Session.Ready = ViewerCamera.NudgePan(
            ViewerCameraState, 5, 0) And Session.Ready

    Else If PressedKey = KEY_1 And Character3D.ClipCount(Character) > 0 Then

        Call SelectPresentationClip(0)

    Else If PressedKey = KEY_2 And Character3D.ClipCount(Character) > 1 Then

        Call SelectPresentationClip(1)

    Else If PressedKey = KEY_3 And Character3D.ClipCount(Character) > 2 Then

        Call SelectPresentationClip(2)

    Else If PressedKey = KEY_ENTER Then

        If Session.ViewerError Then
            Call RetryViewer()
        Else

            Call ResetAll()
        End If

    Else If PressedKey = KEY_O Then

        Call ViewerCamera.ToggleAutoOrbit(ViewerCameraState)

    Else If PressedKey = KEY_G Then

        Rendering.GridVisible = Not Rendering.GridVisible

    Else If PressedKey = KEY_4 Then

        Call CycleProfile()

    Else If PressedKey = KEY_TAB Then

        Call SelectPresentationClip(
            (ViewerPlayback.PresentationIndexForRuntimeClip(
                Character, Session.ProfileIndex, Playback.SelectedClip) + 1) Mod
                ViewerProfiles.ClipCount(Session.ProfileIndex)
        )

    Else If PressedKey = KEY_R Then

        Call PlaySelectedClip()

    End If

End Sub

Function HandleTransformGizmoKeyboard(PressedKey As Number) As Boolean

    If (Not CalibrationAvailable Or
        Not ViewerUiState.CalibrationVisible Or
        ViewerUiState.Visibility <> 0) Then
        Return False
    End If

    If PressedKey = KEY_ESCAPE Then

        If ViewerGizmoState.Dragging Then
            Call CancelTransformGizmoDrag()
        Else If ViewerUiState.CalibrationEditing Then
            Call CancelCalibrationEdit()
        End If

        Return True

    Else If PressedKey = KEY_X Then

        Call SelectTransformGizmoAxis(ViewerUi.CALIBRATION_AXIS_X)

        Return True

    Else If PressedKey = KEY_Y Then

        Call SelectTransformGizmoAxis(ViewerUi.CALIBRATION_AXIS_Y)

        Return True

    Else If PressedKey = KEY_Z Then

        Call SelectTransformGizmoAxis(ViewerUi.CALIBRATION_AXIS_Z)

        Return True

    Else If (PressedKey = KEY_G And
        ViewerUiState.CalibrationTarget >= ViewerUi.CALIBRATION_TARGET_SWORD) Then

        ViewerUiState.CalibrationTransform = ViewerUi.CALIBRATION_TRANSFORM_MOVE

        Call BeginTransformGizmoDrag(False)

        Return True

    Else If PressedKey = KEY_R Or PressedKey = KEY_E Then

        ViewerUiState.CalibrationTransform = ViewerUi.CALIBRATION_TRANSFORM_ROTATE

        Call BeginTransformGizmoDrag(False)

        Return True

    Else If PressedKey = KEY_ENTER Then

        If ViewerGizmoState.Dragging Then
            Call FinishTransformGizmoDrag()
        Else If ViewerUiState.CalibrationEditing Then
            Call SaveCalibrationFrame()
        Else
            Return False
        End If

        Return True

    End If

    Return False

End Function

Sub SelectTransformGizmoAxis(Axis As Number)

    If Axis < ViewerUi.CALIBRATION_AXIS_X Or Axis > ViewerUi.CALIBRATION_AXIS_Z Then
        Return
    End If

    If ViewerGizmoState.Dragging Then

        Call SetCurrentCalibrationValue(ViewerGizmoState.DragStartValue)

        ViewerUiState.CalibrationAxis = Axis

        Call ViewerGizmo.SelectAxis(
            ViewerGizmoState,
            ViewerCalibrationEditing.CurrentValue(
                Calibration, Playback.SelectedClip, ViewerUiState)
        )

    Else
        ViewerUiState.CalibrationAxis = Axis

    End If

End Sub

Sub BeginTransformGizmoDrag(PointerOwned As Boolean)

    Dim OpenedEdit As Boolean

    If Not ViewerGizmoState.Visible Then
        Return
    End If

    OpenedEdit = Not ViewerUiState.CalibrationEditing

    Call BeginCalibrationEdit()
    Call ViewerGizmo.BeginDrag(
        ViewerGizmoState,
        PointerOwned,
        OpenedEdit,
        ViewerCalibrationEditing.CurrentValue(
            Calibration, Playback.SelectedClip, ViewerUiState)
    )

End Sub

Sub ToggleTransformGizmo()

    ' Hiding the handles keeps the current unsaved numeric preview, without saving it.

    Call ViewerGizmo.Toggle(ViewerGizmoState)

End Sub

Sub FinishTransformGizmoDrag()

    Call ViewerGizmo.FinishDrag(ViewerGizmoState)

End Sub

Sub CancelTransformGizmoDrag()

    Dim OpenedEdit As Boolean

    If Not ViewerGizmoState.Dragging Then
        Return
    End If

    OpenedEdit = ViewerGizmoState.OpenedEdit

    If OpenedEdit Then
        Call CancelCalibrationEdit()
    Else

        Call SetCurrentCalibrationValue(ViewerGizmoState.DragStartValue)
    End If

    Call FinishTransformGizmoDrag()

End Sub

Function HandleTransformGizmoPointer() As Boolean

    Dim Axis As Number

    If (Not CalibrationAvailable Or
        Not ViewerUiState.CalibrationVisible Or
        ViewerUiState.Visibility <> 0 Or
        Session.ViewerError) Then
        Return False
    End If

    If ViewerUi.CalibrationGizmoButtonContains(Pointer_X(), Pointer_Y()) Then

        If Pointer_Pressed(POINTER_PRIMARY) Then
            Call ToggleTransformGizmo()
        End If

        Return True

    End If

    If Not ViewerGizmoState.Visible Then
        Return False
    End If

    Call UpdateTransformGizmo()

    If ViewerGizmoState.Dragging Then

        If Pointer_Pressed(POINTER_SECONDARY) Then
            Call CancelTransformGizmoDrag()

            Return True
        End If

        If ViewerGizmoState.PointerOwned Then

            If Pointer_Released(POINTER_PRIMARY) Then

                Call UpdateTransformGizmoFromPointer()
                Call FinishTransformGizmoDrag()

                Return True

            End If

            If Pointer_Held(POINTER_PRIMARY) Or Pointer_Pressed(POINTER_PRIMARY) Then
                Call UpdateTransformGizmoFromPointer()
            End If

        Else

            If Pointer_Pressed(POINTER_PRIMARY) Then
                Call FinishTransformGizmoDrag()

                Return True
            End If

            Call UpdateTransformGizmoFromPointer()

        End If

        Return True

    End If

    If Not Pointer_Pressed(POINTER_PRIMARY) Then
        Return False
    End If

    Axis = ViewerGizmo.AxisAtPointer(
        ViewerGizmoState,
        Pointer_X(),
        Pointer_Y(),
        Pointer_Inside(),
        90,
        Window_Height() - 100,
        ViewerUi.StatusPanelX(Window_Width()),
        ViewerUi.CALIBRATION_PANEL_X,
        ViewerUi.CALIBRATION_PANEL_Y,
        ViewerUi.CALIBRATION_PANEL_WIDTH,
        ViewerUi.CALIBRATION_PANEL_HEIGHT,
        ViewerUiState.CalibrationTransform,
        ViewerUiState.CalibrationAxis,
        ViewerCameraState.Live,
        Window_Width(),
        Window_Height()
    )

    If Axis < 0 Then
        Return False
    End If

    ViewerUiState.CalibrationAxis = Axis

    Call BeginTransformGizmoDrag(True)

    ' A quick click can deliver press and release in one rendered frame.
    ' End its pointer capture now; do not leave a phantom drag for the next frame.

    If Pointer_Released(POINTER_PRIMARY) Then
        Call FinishTransformGizmoDrag()
    End If

    Return True

End Function

Sub UpdateTransformGizmoFromPointer()

    Dim PointerAmount As Number
    Dim ValueAmount As Number

    If ViewerUiState.CalibrationTransform = ViewerUi.CALIBRATION_TRANSFORM_MOVE Then
        PointerAmount = CharacterViewer.TransformGizmoAxisPointerDelta(
            ViewerGizmoState.Projection,
            ViewerUiState.CalibrationAxis,
            Pointer_Delta_X(),
            Pointer_Delta_Y()
        )
        ValueAmount = CharacterViewer.RetainedPointerDelta(
            ViewerGizmoState.DragRemainder,
            PointerAmount,
            TRANSFORM_GIZMO_MOVE_DIVISOR
        )
    Else

        PointerAmount = ViewerGizmo.RingPointerDelta(
            ViewerGizmoState,
            ViewerUiState.CalibrationAxis,
            Pointer_X(),
            Pointer_Y(),
            Pointer_Delta_X(),
            Pointer_Delta_Y(),
            ViewerCameraState.Live,
            Window_Width(),
            Window_Height()
        )

        ValueAmount = CharacterViewer.RetainedPointerDelta(
            ViewerGizmoState.DragRemainder,
            PointerAmount,
            TRANSFORM_GIZMO_ROTATE_DIVISOR
        )
    End If

    If ValueAmount <> 0 Then
        Call AdjustCalibrationValue(ValueAmount)
        Call UpdateTransformGizmo()
    End If

End Sub

Sub UpdateTransformGizmo()

    Call ViewerGizmo.UpdateProjection(
        ViewerGizmoState,
        CurrentTransformGizmoOrigin(),
        ViewerCameraState.Live,
        Window_Width(),
        Window_Height()
    )

End Sub

Function CurrentTransformGizmoOrigin() As Core.Vector3

    Dim Result As Core.Vector3
    Dim SocketName As Text
    Dim PartIndex As Number

    PartIndex = BODY_PART_INDEX
    SocketName = "HandRight"

    If ViewerUiState.CalibrationTarget = ViewerUi.CALIBRATION_TARGET_SHIELD_WRIST Then
        SocketName = "HandLeft"
    Else If ViewerUiState.CalibrationTarget = ViewerUi.CALIBRATION_TARGET_SWORD Then
        PartIndex = WEAPON_PART_INDEX
        SocketName = "SwordBase"
    Else If ViewerUiState.CalibrationTarget = ViewerUi.CALIBRATION_TARGET_SHIELD Then
        PartIndex = SHIELD_PART_INDEX
        SocketName = "ShieldCenter"
    End If

    Result.X = Character3D.SocketValueThousandths(Character, SocketName,
        Graphics3D.ANIMATOR_SOCKET_POSITION_X, PartIndex) / 1000
    Result.Y = Character3D.SocketValueThousandths(Character, SocketName,
        Graphics3D.ANIMATOR_SOCKET_POSITION_Y, PartIndex) / 1000
    Result.Z = Character3D.SocketValueThousandths(Character, SocketName,
        Graphics3D.ANIMATOR_SOCKET_POSITION_Z, PartIndex) / 1000

    Return Result

End Function

Sub ToggleScenePause()

    If Party.Enabled And Playback.ScenePaused Then

        If ViewerUiState.CalibrationEditing Then
            Session.CharacterSwitchBlocked = True
            Return
        End If

        Call RestorePartyPreview()

    End If

    Playback.ScenePaused = Not Playback.ScenePaused

End Sub

Sub ToggleDemo()

    If Party.Enabled Then
        Call ToggleScenePause()

        Return
    End If

    Playback.DemoEnabled = Not Playback.DemoEnabled
    Playback.AnimationCycleElapsed = 0

    Call PlaySelectedClip()

End Sub

Sub CycleBackground()

    Call ViewerRendering.CycleBackground(Rendering, BACKGROUND_COUNT)

End Sub

Sub ToggleDragon()

    Call ViewerDragon.ToggleVisible(DragonState, Effects.DragonLight)

End Sub

Sub ToggleSword()

    If Party.UiBound Then

        Call EndPartyInspector()
        Call ToggleSword()
        Call BeginPartyInspector()

        Return

    End If

    If Session.DragonInspection Then

        SwordVisible = Not SwordVisible
        Session.Ready = Character3D.SetPartVisible(Party.DragonOpponent.Actor, WEAPON_PART_INDEX, SwordVisible) And Session.Ready
        Session.Ready = Character3D.SetPartVisible(Party.Companion.Actor, WEAPON_PART_INDEX, SwordVisible) And Session.Ready

        If Not SwordVisible Then
            Call ViewerEffects.HideSwordEffects(Effects)
        End If

        Return

    End If

    If CalibrationAvailable Then

        SwordVisible = Not SwordVisible
        Session.Ready = Character3D.SetPartVisible(
            Character,
            WEAPON_PART_INDEX,
            SwordVisible
        ) And Session.Ready

        If Party.Enabled And Party.Ready Then
            Session.Ready = Character3D.SetPartVisible(Party.Companion.Actor, WEAPON_PART_INDEX, SwordVisible) And Session.Ready
        End If

        If Not SwordVisible Then
            Call ViewerEffects.HideSwordEffects(Effects)
        End If

    End If

End Sub

Sub ToggleShield()

    If Party.UiBound Then

        Call EndPartyInspector()
        Call ToggleShield()
        Call BeginPartyInspector()

        Return

    End If

    If Session.DragonInspection Then

        ShieldVisible = Not ShieldVisible
        Session.Ready = Character3D.SetPartVisible(Party.DragonOpponent.Actor, SHIELD_PART_INDEX, ShieldVisible) And Session.Ready
        Session.Ready = Character3D.SetPartVisible(Party.Companion.Actor, SHIELD_PART_INDEX, ShieldVisible) And Session.Ready

        If Not ShieldVisible Then
            Call ViewerEffects.HideShieldEffects(Effects)
        End If

        Return

    End If

    If CalibrationAvailable Then

        ShieldVisible = Not ShieldVisible
        Session.Ready = Character3D.SetPartVisible(
            Character,
            SHIELD_PART_INDEX,
            ShieldVisible
        ) And Session.Ready

        If Party.Enabled And Party.Ready Then
            Session.Ready = Character3D.SetPartVisible(Party.Companion.Actor, SHIELD_PART_INDEX, ShieldVisible) And Session.Ready
        End If

        If Not ShieldVisible Then
            Call ViewerEffects.HideShieldEffects(Effects)
        End If

    End If

End Sub

Function BeginViewerScene() As Boolean

    Dim Result As Boolean

    Result = ViewerRendering.BeginScene(Rendering, ViewerCameraState.Live)

    Return Result

End Function

Sub CreateBackdrop()

    Call ViewerRendering.CreateBackdrops(
        Rendering,
        BACKDROP_LANDSCAPE_PATH,
        BACKDROP_TITLE_PATH
    )

End Sub

Function ApplyBackdrop() As Boolean

    Dim Result As Boolean

    Result = ViewerRendering.ApplyBackdrop(Rendering)

    Return Result

End Function

Sub DestroyBackdrop()

    Call ViewerRendering.DestroyBackdrops(Rendering)

End Sub

Sub ToggleFloorAndGrid()

    Call ViewerRendering.ToggleFloorAndGrid(Rendering)

End Sub

Sub ToggleEpicGlow()

    If Session.DragonInspection Then

        Party.DragonOpponent.GlowVisible = Not Party.DragonOpponent.GlowVisible
        Party.Companion.GlowVisible = Party.DragonOpponent.GlowVisible
        Return

    End If

    If Effects.EpicGlowAvailable Then
        Call ViewerEffects.ToggleEpicGlow(Effects, Character)
    End If

End Sub

Sub RetryViewer()

    Call DestroyViewerResources()
    Call Character3D.Shutdown()
    Call Scene3D.Shutdown()
    Call Graphics3D.ResetRenderer3D()

    Call ViewerSession.ResetFailure(Session)

    Call LoadViewer()

End Sub

Sub CycleProfile()

    If Not ViewerProfiles.INCLUDE_DIAGNOSTIC_PROFILES Or Party.Enabled Then
        Return
    End If

    If ViewerUiState.CalibrationEditing Then
        Session.CharacterSwitchBlocked = True
        Return
    End If

    Call DestroyViewerResources()

    Party.Enabled = False
    Session.DragonInspection = False
    Session.SelectedCharacterTab = 0
    Session.ProfileIndex = ViewerProfiles.NextProfile(Session.ProfileIndex)

    If Session.ProfileIndex = ViewerProfiles.PROFILE_ORIN Then
        Session.SelectedCharacterTab = 1
    Else If Session.ProfileIndex = ViewerProfiles.PROFILE_DRAGON Then
        Session.SelectedCharacterTab = 2
        Session.DragonInspection = True
    End If

    Call ViewerSession.ResetFailure(Session)

    Call LoadViewer()

End Sub

Sub CycleMaterialInspection()

    MaterialInspection = (MaterialInspection + 1) Mod 7
    Session.Ready = Graphics3D.SetMaterialInspection3D(MaterialInspection) And Session.Ready

End Sub

Sub AdvanceAnimationSequence()

    If Party.Enabled Then
        Return
    End If

    If ViewerPlayback.AdvanceDemo(
        Playback, Character, Session.ProfileIndex,
        ANIMATION_CYCLE_MILLISECONDS, Timing.PresentationElapsed) Then
        Call PlaySelectedClip(True)
    End If

End Sub

Function HandleInterfacePointer() As Boolean

    Dim Blocked As Boolean
    Dim Index As Number

    If (ViewerInputState.TimelineScrubbing Or
        ViewerInputState.TimelineKeyframeDragging Or
        ViewerInputState.FrameButtonRepeatDirection <> 0 Or
        ViewerInputState.SliderDragOwner <> 0 Or
        ViewerGizmoState.Dragging) Then

        Call BeginPartyInspector()

        Blocked = HandleInspectorPointer()

        Call EndPartyInspector()

        Return Blocked

    End If

    If ViewerUiState.Visibility = 2 Then

        If Pointer_Pressed(POINTER_SECONDARY) Then

            If Party.Enabled Then
                Call ResetPartyInspector()
            Else If Session.ViewerError Then
                Call RetryViewer()
            Else

                Call ResetAll()
            End If

            Return True

        End If

        Return False

    End If

    If ViewerUi.CharacterTabsContain(Pointer_X(), Pointer_Y()) Then

        If Pointer_Pressed(POINTER_PRIMARY) Then

            Index = ViewerUi.CharacterTabAtPointer(Pointer_X(), Pointer_Y())

            If Index >= 0 Then
                Call SelectCharacterTab(Index)
            End If

        End If

        Return True

    End If

    If Party.Enabled Then

        If HandlePartyPointer() Then
            Return True
        End If

        Call BeginPartyInspector()

        Blocked = HandleInspectorPointer()

        Call EndPartyInspector()

        Return Blocked

    End If

    Blocked = HandleInspectorPointer()

    Return Blocked

End Function

Function HandleInspectorPointer() As Boolean

    Dim Action As Number
    Dim Blocked As Boolean
    Dim KeyframeIndex As Number
    Dim TransferAction As Number
    Dim WheelDelta As Number

    If HandleTransformGizmoPointer() Then
        Return True
    End If

    If ViewerInputState.FrameButtonRepeatDirection <> 0 Then

        If (Pointer_Pressed(POINTER_SECONDARY) Or
            (Not Pointer_Held(POINTER_PRIMARY) And Not Pointer_Pressed(POINTER_PRIMARY))) Then

            ViewerInputState.FrameButtonRepeatDirection = 0

        Else

            If Timer() >= ViewerInputState.FrameButtonRepeatAt Then
                Call StepAnimationFrame(ViewerInputState.FrameButtonRepeatDirection)

                ''' No catch-up burst if rendering or input stalls.
                ViewerInputState.FrameButtonRepeatAt = Timer() + FRAME_BUTTON_REPEAT_MILLISECONDS
            End If

            Return True

        End If

    End If

    If ViewerInputState.TimelineKeyframeDragging Then

        If Pointer_Pressed(POINTER_PRIMARY) Or Pointer_Held(POINTER_PRIMARY) Then
            Call UpdateTimelineKeyframeDrag()
        Else

            Call FinishTimelineKeyframeDrag()
        End If

        Return True

    End If

    If HandleSharedSliders() Then
        Return True
    End If

    If ViewerInputState.TimelineScrubbing Then

        If Pointer_Pressed(POINTER_PRIMARY) Or Pointer_Held(POINTER_PRIMARY) Then
            Call SeekFromPointer()
        Else

            Call ViewerInput.FinishTimelineGesture(ViewerInputState)
        End If

        If Pointer_Released(POINTER_PRIMARY) Then
            Call ViewerInput.FinishTimelineGesture(ViewerInputState)
        End If

        Return True

    End If

    If Not Pointer_Inside() Then
        Return False
    End If

    If Pointer_Pressed(POINTER_SECONDARY) Then

        If Session.ViewerError Then
            Call RetryViewer()
        Else

            Call ResetAll()
        End If

        Return True

    End If

    If ViewerUi.TimelineContains(
        Pointer_X(), Pointer_Y(), Window_Width(), Window_Height()) Then

        WheelDelta = Pointer_Wheel_Delta()

        If WheelDelta > 0 Then
            Call StepAnimationFrame(1)
        Else If WheelDelta < 0 Then
            Call StepAnimationFrame(-1)
        End If

        If WheelDelta <> 0 Then
            Return True
        End If

    End If

    If ViewerUi.LayoutTooSmall(Window_Width(), Window_Height()) Then
        Return True
    End If

    TransferAction = ViewerUi.TransferActionAtPointer(
        Pointer_X(),
        Pointer_Y(),
        Window_Height(),
        CalibrationAvailable,
        Text_Width(Calibration.FileLabel, 9)
    )

    If TransferAction <> ViewerUi.TRANSFER_ACTION_NONE Then

        If Pointer_Pressed(POINTER_PRIMARY) Then

            If TransferAction = ViewerUi.TRANSFER_ACTION_DOWNLOAD Then
                Call ViewerCalibration.Download(Calibration, Character)
            Else If TransferAction = ViewerUi.TRANSFER_ACTION_IMPORT Then
                Call HandleCalibrationImport()
            Else If TransferAction = ViewerUi.TRANSFER_ACTION_OPEN Then
                Call ViewerCalibration.OpenOrDownload(Calibration, Character)
            End If

        End If

        Return True

    End If

    If ViewerUi.CalibrationPanelContains(
        Pointer_X(), Pointer_Y(), ViewerUiState.Visibility,
        CalibrationAvailable, ViewerUiState.CalibrationVisible) Then
        Call HandleCalibrationPanelPointer()

        Return True
    End If

    Blocked = ViewerUi.InspectorBlocksScene(
        Pointer_X(), Pointer_Y(), Window_Width(), Window_Height(),
        ViewerUiState.Visibility)

    If Not Pointer_Pressed(POINTER_PRIMARY) Then
        Return Blocked
    End If

    KeyframeIndex = ViewerUi.TimelineKeyframeAtPointer(
        Character,
        Calibration,
        CalibrationAvailable,
        Playback.SelectedClip,
        Pointer_X(),
        Pointer_Y(),
        Window_Width(),
        Window_Height()
    )

    Action = ViewerUi.InspectorActionAtPointer(
        Pointer_X(),
        Pointer_Y(),
        Window_Width(),
        Window_Height(),
        ViewerUiState.Visibility,
        ViewerProfiles.INCLUDE_DIAGNOSTIC_PROFILES,
        Party.Enabled,
        Session.ProfileIndex,
        Effects.SwordFireReady,
        KeyframeIndex
    )

    If Action = ViewerUi.INSPECTOR_ACTION_FIRST_FRAME Then

        Call SeekFirstAnimationFrame()

    Else If Action = ViewerUi.INSPECTOR_ACTION_PREVIOUS_KEY Then

        Call SeekCalibrationKeyframe(-1)

    Else If Action = ViewerUi.INSPECTOR_ACTION_NEXT_KEY Then

        Call SeekCalibrationKeyframe(1)

    Else If Action = ViewerUi.INSPECTOR_ACTION_PREVIOUS_FRAME Then

        Call StepAnimationFrame(-1)

        ViewerInputState.FrameButtonRepeatDirection = -1
        ViewerInputState.FrameButtonRepeatAt = Timer() + FRAME_BUTTON_REPEAT_MILLISECONDS

    Else If Action = ViewerUi.INSPECTOR_ACTION_NEXT_FRAME Then

        Call StepAnimationFrame(1)

        ViewerInputState.FrameButtonRepeatDirection = 1
        ViewerInputState.FrameButtonRepeatAt = Timer() + FRAME_BUTTON_REPEAT_MILLISECONDS

    Else If Action = ViewerUi.INSPECTOR_ACTION_KEYFRAME Then

        Call BeginTimelineKeyframeDrag(KeyframeIndex)

    Else If Action = ViewerUi.INSPECTOR_ACTION_TIMELINE Then

        Call ViewerInput.BeginTimelineScrub(ViewerInputState)

        Call SeekFromPointer()

    Else If Action = ViewerUi.INSPECTOR_ACTION_LIGHTING Then

        Call CycleLighting()

    Else If Action = ViewerUi.INSPECTOR_ACTION_MATERIAL Then

        Call CycleMaterialInspection()

    Else If Action = ViewerUi.INSPECTOR_ACTION_SOCKET Then

        Call ViewerRendering.CycleSocketDisplay(Rendering)

    Else If Action = ViewerUi.INSPECTOR_ACTION_PROFILE Then

        Call CycleProfile()

    Else If Action = ViewerUi.INSPECTOR_ACTION_GLOW Then

        Call ToggleEpicGlow()

    Else If Action = ViewerUi.INSPECTOR_ACTION_DRAGON Then

        Call ToggleDragon()

    Else If Action = ViewerUi.INSPECTOR_ACTION_BACKGROUND Then

        Call CycleBackground()

    Else If Action = ViewerUi.INSPECTOR_ACTION_CALIBRATION Then

        ViewerUiState.CalibrationVisible = CalibrationAvailable And Not ViewerUiState.CalibrationVisible

        If ViewerUiState.CalibrationVisible Then
            Call BeginPartyPreview()
        Else

            Call ViewerGizmo.Hide(ViewerGizmoState)
            Call ViewerInput.CancelCaptures(ViewerInputState)
        End If

    Else If Action = ViewerUi.INSPECTOR_ACTION_SWORD Then

        Call ToggleSword()

    Else If Action = ViewerUi.INSPECTOR_ACTION_SHIELD Then

        Call ToggleShield()

    Else If Action = ViewerUi.INSPECTOR_ACTION_DEMO Then

        Call ToggleDemo()

    Else If Action = ViewerUi.INSPECTOR_ACTION_FLOOR Then

        Call ToggleFloorAndGrid()

    Else If Action = ViewerUi.INSPECTOR_ACTION_DRAGON_HEAD Then

        Call ViewerDragon.ToggleHeadTracking(DragonState)

    Else If Action = ViewerUi.INSPECTOR_ACTION_DRAGON_TARGET Then

        If Not Party.Enabled Then
            Party.DragonCounter = (Party.DragonCounter + 1) Mod 2
        End If

    Else If Action = ViewerUi.INSPECTOR_ACTION_STORM_STYLE Then

        Call ViewerEffects.CycleStormStyle(Effects)

    Else If Action = ViewerUi.INSPECTOR_ACTION_SWORD_FIRE Then

        Call ViewerEffects.ToggleSwordFire(Effects)

    Else If Action = ViewerUi.INSPECTOR_ACTION_SHIELD_FIRE Then

        Call ViewerEffects.ToggleShieldFire(Effects)

    Else If Action = ViewerUi.INSPECTOR_ACTION_STORM_COMFORT Then

        Call ViewerEffects.CycleStormSceneComfort()

    Else If Action = ViewerUi.INSPECTOR_ACTION_LIGHTNING_PAUSE Then

        Call ViewerEffects.ToggleLightningPause(Effects)

    Else If Action = ViewerUi.INSPECTOR_ACTION_FLAME_PAUSE Then

        Call ViewerEffects.ToggleFlamePause(Effects)

    Else If Action = ViewerUi.INSPECTOR_ACTION_SHIELD_FIRE_STYLE Then

        Call ViewerEffects.ToggleShieldFireStyle(Effects)

    Else If Action = ViewerUi.INSPECTOR_ACTION_SPEED_DOWN Then

        Call AdjustPlaybackSpeed(-25)

    Else If Action = ViewerUi.INSPECTOR_ACTION_SPEED_UP Then

        Call AdjustPlaybackSpeed(25)

    Else If Action = ViewerUi.INSPECTOR_ACTION_RESET_VIEW Then

        Call ResetView()

    Else If Action = ViewerUi.INSPECTOR_ACTION_RESTART_PRESENTATION Then

        Call RestartPresentation()

    Else If Action = ViewerUi.INSPECTOR_ACTION_RESET_ALL Then

        Call ResetAll()

    Else If Action = ViewerUi.INSPECTOR_ACTION_FIT Then

        ViewerCameraState.FitLocked = Not ViewerCameraState.FitLocked

        If ViewerCameraState.FitLocked Then

            ViewerCameraState.LastFitWidth = -1
            ViewerCameraState.LastFitHeight = -1

            Call ViewerCamera.UpdateResponsiveFit(
                ViewerCameraState,
                ActiveProfile,
                LocalCharacterBounds,
                Window_Width(),
                Window_Height(),
                Max(1, Window_Width() - 284),
                DragonState.Available,
                ARENA_CAMERA_CENTER_X,
                ARENA_CAMERA_CENTER_Z,
                ARENA_CAMERA_DISTANCE,
                ARENA_CAMERA_HEIGHT
            )

        End If

    Else If Action >= ViewerUi.INSPECTOR_ACTION_CLIP_BASE Then

        Call SelectPresentationClip(Action - ViewerUi.INSPECTOR_ACTION_CLIP_BASE)

    End If

    Return Blocked

End Function

Function HandleSharedSliders() As Boolean

    Dim Value As Number
    Dim PanelLeft As Number
    Dim PreviousValue As Number

    If ViewerUiState.Visibility <> 0 Then
        Return False
    End If

    PanelLeft = ViewerUi.StatusPanelX(Window_Width())
    Value = ViewerCameraState.Controls.OrbitYaw

    If UI.UpdateSlider(ViewerInputState.SliderDragOwner, 1, PanelLeft + 76, Window_Height() - 142,
        ViewerUi.CAMERA_SLIDER_WIDTH, ViewerUi.CAMERA_SLIDER_HEIGHT,
        -180, 180, 1, Value) Then
        Call ViewerCamera.SetHorizontalOrbit(ViewerCameraState, Value)

        Return True
    End If

    Value = ViewerCameraState.Controls.OrbitPitch

    If UI.UpdateSlider(ViewerInputState.SliderDragOwner, 2, PanelLeft + 76, Window_Height() - 116,
        ViewerUi.CAMERA_SLIDER_WIDTH, ViewerUi.CAMERA_SLIDER_HEIGHT,
        -180, 180, 1, Value) Then
        Call ViewerCamera.SetVerticalOrbit(ViewerCameraState, Value)

        Return True
    End If

    Value = CharacterViewer.ZoomTargetDegrees(ViewerCameraState.Zoom)

    If UI.UpdateSlider(ViewerInputState.SliderDragOwner, 3, PanelLeft + 76, Window_Height() - 90,
        ViewerUi.CAMERA_SLIDER_WIDTH, ViewerUi.CAMERA_SLIDER_HEIGHT,
        ZOOM_IN_LIMIT, ZOOM_OUT_LIMIT, -1, Value) Then
        Call ViewerCamera.SetZoomTarget(ViewerCameraState, Value)

        Return True
    End If

    If ViewerUiState.CalibrationVisible Or ViewerInputState.SliderDragOwner = 4 Then

        Value = ViewerCalibrationEditing.CurrentValue(
            Calibration, Playback.SelectedClip, ViewerUiState)
        PreviousValue = Value

        If UI.UpdateSlider(ViewerInputState.SliderDragOwner, 4, ViewerUi.CALIBRATION_SLIDER_X, ViewerUi.CALIBRATION_SLIDER_Y,
            ViewerUi.CALIBRATION_SLIDER_WIDTH, ViewerUi.CALIBRATION_SLIDER_HEIGHT,
            ViewerCalibration.MinimumValue(ViewerUiState.CalibrationTransform),
            ViewerCalibration.MaximumValue(ViewerUiState.CalibrationTransform), 1, Value) Then

            If Value <> PreviousValue Then
                Call SetCurrentCalibrationValue(Value)
            End If

            Return True

        End If

    End If

    Return False

End Function

Sub HandleCalibrationPanelPointer()

    Dim Action As Number

    Action = ViewerUi.CalibrationPointerAction(
        Pointer_X(),
        Pointer_Y(),
        Pointer_Pressed(POINTER_PRIMARY),
        ViewerUiState.CalibrationTarget
    )

    If ViewerUi.ApplyCalibrationSelection(ViewerUiState, Action) Then

        If (Action = ViewerUi.CALIBRATION_ACTION_WEAPON Or
            Action = ViewerUi.CALIBRATION_ACTION_SHIELD) Then
            ViewerGizmoState.GripAnchorActive = False
        End If

        Return

    End If

    If Action = ViewerUi.CALIBRATION_ACTION_PREVIOUS_KEY Then

        Call SeekCalibrationKeyframe(-1)

    Else If Action = ViewerUi.CALIBRATION_ACTION_NEXT_KEY Then

        Call SeekCalibrationKeyframe(1)

    Else If Action = ViewerUi.CALIBRATION_ACTION_RESET Then

        Call ResetCalibrationTarget()

    Else If Action = ViewerUi.CALIBRATION_ACTION_SAVE Then

        Call SaveCalibrationFrame()

    Else If Action = ViewerUi.CALIBRATION_ACTION_CANCEL Then

        Call CancelCalibrationEdit()

    Else If Action = ViewerUi.CALIBRATION_ACTION_CLEAR Then

        If ViewerUiState.CalibrationClearConfirm Then
            Call ClearSelectedClipCalibration()
        Else

            Call ViewerUi.BeginClearConfirmation(ViewerUiState)
        End If

    Else If Action = ViewerUi.CALIBRATION_ACTION_COPY Then

        If Not ViewerUiState.CalibrationEditing Then
            Call CopyCurrentCalibrationKeyframe()
        End If

    Else If Action = ViewerUi.CALIBRATION_ACTION_PASTE Then

        If Not ViewerUiState.CalibrationEditing Then
            Call PasteCalibrationKeyframe()
        End If

    Else If Action = ViewerUi.CALIBRATION_ACTION_DELETE Then

        If Not ViewerUiState.CalibrationEditing Then
            Call DeleteCurrentCalibrationKeyframe()
        End If

    Else If Action = ViewerUi.CALIBRATION_ACTION_RELOAD Then

        Call ReloadCurrentCalibrationKeyframe()

    Else If Action = ViewerUi.CALIBRATION_ACTION_HOLD_GRIP Then

        ViewerGizmoState.HoldGrip = Not ViewerGizmoState.HoldGrip

        Call ViewerEffects.InvalidateVisualHistory(Effects)

        ViewerGizmoState.GripAnchorActive = False

    Else If Action = ViewerUi.CALIBRATION_ACTION_UNDO Then

        Call UndoLastCalibrationChange()

    Else If Action = ViewerUi.CALIBRATION_ACTION_DECOUPLE_WEAPON Then

        Call BeginCalibrationEdit()
        Call ViewerCalibration.SetChannelValue(
            Calibration,
            Playback.SelectedClip,
            18,
            1 - ViewerCalibration.ChannelValue(
                Calibration, Playback.SelectedClip, 18)
        )

    Else If Action = ViewerUi.CALIBRATION_ACTION_DECOUPLE_SHIELD Then

        Call BeginCalibrationEdit()
        Call ViewerCalibration.SetChannelValue(
            Calibration,
            Playback.SelectedClip,
            19,
            1 - ViewerCalibration.ChannelValue(
                Calibration, Playback.SelectedClip, 19)
        )

    End If

End Sub

Sub UpdateCameraPointer(Blocked As Boolean)

    Dim OrbitPressed As Boolean
    Dim OrbitHeld As Boolean
    Dim OrbitReleased As Boolean
    Dim OrbitActive As Boolean
    Dim PanPressed As Boolean
    Dim PanHeld As Boolean
    Dim PanReleased As Boolean
    Dim PanActive As Boolean
    Dim WheelDelta As Number
    Dim PointerDeltaX As Number
    Dim PointerDeltaY As Number

    OrbitPressed = (Not Blocked And
        (Pointer_Pressed(POINTER_MIDDLE) Or
        (Pointer_Held(POINTER_MIDDLE) And Not ViewerCameraState.Controls.Orbiting)))
    OrbitHeld = Pointer_Held(POINTER_MIDDLE)
    OrbitReleased = Pointer_Released(POINTER_MIDDLE)
    OrbitActive = (OrbitPressed Or
        (ViewerCameraState.Controls.Orbiting And (OrbitHeld Or OrbitReleased)))
    PanPressed = (Not Blocked And
        (Pointer_Pressed(POINTER_PRIMARY) Or
        (Pointer_Held(POINTER_PRIMARY) And Not ViewerCameraState.Controls.Panning)))
    PanHeld = Pointer_Held(POINTER_PRIMARY)
    PanReleased = Pointer_Released(POINTER_PRIMARY)
    PanActive = (PanPressed Or
        (ViewerCameraState.Controls.Panning And (PanHeld Or PanReleased)))
    PointerDeltaX = Pointer_Delta_X()
    PointerDeltaY = Pointer_Delta_Y()

    ViewerCameraState.CalibrationOrbitActive = OrbitActive And ViewerUiState.CalibrationVisible And Not Party.Enabled

    If OrbitPressed And ViewerCameraState.CalibrationOrbitActive Then
        Call ViewerCamera.BeginCalibrationOrbitAnchor(
            ViewerCameraState,
            CurrentTransformGizmoOrigin(),
            Pointer_X(),
            Pointer_Y(),
            Window_Width(),
            Window_Height()
        )
    End If

    If Not Blocked Then
        WheelDelta = Pointer_Wheel_Delta()
    End If

    If WheelDelta <> 0 Then
        Call ViewerCamera.AdjustZoomTarget(ViewerCameraState, WheelDelta, 8)
    End If

    Session.Ready = ViewerCamera.UpdatePointerControls(
        ViewerCameraState,
        OrbitPressed,
        OrbitHeld,
        OrbitReleased,
        OrbitActive,
        PanPressed,
        PanHeld,
        PanReleased,
        PanActive,
        PointerDeltaX,
        PointerDeltaY,
        ORBIT_POINTER_DIVISOR,
        PAN_POINTER_DIVISOR
    ) And Session.Ready

End Sub

Sub UpdateOrinStorm()

    Dim Target As Core.Vector3
    Dim Clip As Text

    If Not ViewerDragon.IsValid(DragonState) Then
        Return
    End If

    Target = Character3D.SocketPosition(DragonState.Actor, "Chest")

    If (Party.Enabled Or Session.DragonInspection) And Party.Ready Then
        Clip = Character3D.ClipName(Party.Companion.Actor, Party.Companion.Clip)

        Call ViewerEffects.UpdateStorm(Effects, Party.Companion.Actor, Clip, Target,
            ViewerCameraState.Live, Timing.CameraElapsed,
            Party.Companion.GlowVisible And (Effects.EpicGlowVisible Or Session.DragonInspection) And
                ViewerParty.PresentationState(Party, 1) <> ViewerParty.STATE_KO,
            SwordVisible, ShieldVisible, Playback.ScenePaused)
    Else If Session.ProfileIndex = ViewerProfiles.PROFILE_ORIN Then
        Clip = Character3D.ClipName(Character, Playback.SelectedClip)

        Call ViewerEffects.UpdateStorm(Effects, Character, Clip, Target, ViewerCameraState.Live,
            Timing.CameraElapsed, Effects.EpicGlowVisible, SwordVisible, ShieldVisible,
            Playback.ScenePaused)
    End If

End Sub

Sub AdjustPlaybackSpeed(Amount As Number)

    If Party.Enabled And Party.PreviewActive Then
        Call ViewerCalibration.SetTransferMessage(
            Calibration, "Resume Or Reset Before Changing Demo Speed")

        Return
    End If

    Call ViewerPlayback.AdjustSpeed(Playback, ActiveProfile.MinimumPlaybackSpeed,
        ActiveProfile.MaximumPlaybackSpeed, Amount)

    If Party.Enabled Then
        Call ResetPartyDemo()
    Else

        Call PlaySelectedClip()
    End If

End Sub

Sub RestartPresentation()

    If Party.Enabled And Party.Ready Then
        Call ResetPartyInspector()

        Return
    End If

    Call ResetView()

    Call ViewerCamera.StartAutoOrbit(ViewerCameraState)

    Playback.AnimationCycleElapsed = 0
    Playback.SelectedClip = ViewerPlayback.RuntimeClipForPresentationIndex(
        Character, Session.ProfileIndex, 0)

    Call PlaySelectedClip()

End Sub

Sub ResetView()

    Party.PreviousCamera = 0
    Party.OrbitPhase1000 = 0

    Call ViewerCamera.Reset(
        ViewerCameraState,
        InitialViewerOrbitYaw(),
        DefaultZoomDegrees(),
        ZOOM_IN_LIMIT,
        ZOOM_OUT_LIMIT,
        96000
    )

End Sub

Sub ResetAll()

    If Party.UiBound Then

        Call CancelCalibrationEdit()
        Call RestorePartyPreview()
        Call EndPartyInspector()

    End If

    Call ViewerParty.ClearPreview(Party)

    If ViewerUiState.CalibrationEditing Then
        Call CancelCalibrationEdit()
    End If

    Playback.PlaybackSpeed = ActiveProfile.DefaultPlaybackSpeed
    Playback.ScenePaused = False
    Playback.DemoEnabled = True
    ViewerCameraState.FitLocked = True
    LightingIndex = 0
    MaterialInspection = Graphics3D.MATERIAL_INSPECTION_LIT
    Rendering.BackgroundIndex = 3
    Rendering.SocketGizmosVisible = False
    Rendering.ShowAllSocketOrigins = False
    Rendering.FloorVisible = True
    Rendering.GridVisible = True
    Effects.EpicGlowVisible = ViewerProfiles.EpicGlowVisibleByDefault(Session.ProfileIndex) And Effects.EpicGlowAvailable

    Call ViewerDragon.ResetVisibility(DragonState)

    SwordVisible = True
    ShieldVisible = True

    Call ViewerEffects.ResetPlaybackControls(Effects)

    Call ViewerUi.Reset(ViewerUiState)
    Call ViewerInput.CancelCaptures(ViewerInputState)
    Call ViewerGizmo.Hide(ViewerGizmoState)
    Call ViewerCamera.CancelPointerControls(ViewerCameraState)

    Call ApplyLighting()
    Call ApplyArenaFacing()

    If CalibrationAvailable Then
        Session.Ready = Character3D.SetPartVisible(Character, WEAPON_PART_INDEX, True) And Session.Ready
        Session.Ready = Character3D.SetPartVisible(Character, SHIELD_PART_INDEX, True) And Session.Ready
    End If

    Session.Ready = Graphics3D.SetMaterialInspection3D(MaterialInspection) And Session.Ready

    If Party.Enabled And Party.Ready Then

        Call ResetPartyDemo()
        Call ResetView()

        Call ViewerCamera.SetAutoOrbit(ViewerCameraState, True)

    Else

        Call RestartPresentation()

    End If

End Sub

Sub SelectClip(Index As Number)

    Call BeginPartyPreview()
    Call CancelCalibrationEdit()

    Call ViewerPlayback.SelectClip(Playback, Index, Party.Enabled)

    ViewerUiState.CalibrationClearConfirm = False
    ViewerUiState.CalibrationClearAllStage = 0

    Call PlaySelectedClip()

End Sub

Sub SelectPresentationClip(Index As Number)

    Dim RuntimeClip As Number

    RuntimeClip = ViewerPlayback.RuntimeClipForPresentationIndex(
        Character, Session.ProfileIndex, Index)

    If RuntimeClip >= 0 Then
        Call SelectClip(RuntimeClip)
    End If

End Sub

Sub StepAnimationFrame(Direction As Number)

    Call BeginPartyPreview()
    Call CancelCalibrationEdit()

    Session.Ready = ViewerPlayback.StepFrame(
        Playback, Character, Direction) And Session.Ready

    Call ViewerEffects.InvalidateVisualHistory(Effects)

End Sub

Sub SeekFirstAnimationFrame()

    Call BeginPartyPreview()
    Call CancelCalibrationEdit()

    Session.Ready = ViewerPlayback.SeekFirstFrame(
        Playback, Character) And Session.Ready

    Call ViewerEffects.InvalidateVisualHistory(Effects)

End Sub

Sub SeekCalibrationKeyframe(Direction As Number)

    Dim CurrentFrame As Number
    Dim TargetFrame As Number
    Dim TargetTime As Number

    ''' Navigation pauses even when this clip has no saved keys to visit.

    Call BeginPartyPreview()

    Playback.ScenePaused = True

    If Not CalibrationAvailable Then
        Return
    End If

    If ViewerUiState.CalibrationEditing Then
        Call CancelCalibrationEdit()
    End If

    CurrentFrame = ViewerCalibration.CurrentAnimationFrame(
        Character, Playback.SelectedClip)
    TargetFrame = ViewerCalibration.AdjacentKeyFrame(
        Calibration, Playback.SelectedClip, CurrentFrame, Direction)

    If TargetFrame < 0 Then
        Return
    End If

    TargetTime = ViewerCalibration.FrameTimeMilliseconds(
        Character, Playback.SelectedClip, TargetFrame)
    Session.Ready = Character3D.SetAnimationTime(Character, TargetTime) And Session.Ready

    Call ViewerEffects.InvalidateVisualHistory(Effects)

    Call UpdateCalibrationForCurrentFrame()
    Call ApplyWristCalibration()

End Sub

Sub SeekFromPointer()

    Dim Duration As Number
    Dim TargetTime As Number

    Call BeginPartyPreview()
    Call CancelCalibrationEdit()

    Duration = Character3D.ClipDuration(Character, Playback.SelectedClip)
    TargetTime = (Pointer_X() - ViewerUi.TIMELINE_LEFT) * Duration / Max(1, ViewerUi.TimelineWidth(Window_Width(), ViewerUi.TIMELINE_LEFT))
    Session.Ready = ViewerPlayback.SeekTime(
        Playback, Character, TargetTime) And Session.Ready

    Call ViewerEffects.InvalidateVisualHistory(Effects)

End Sub

Sub BeginTimelineKeyframeDrag(KeyframeIndex As Number)

    Call BeginPartyPreview()
    Call ViewerInput.BeginTimelineKeyframeDrag(
        ViewerInputState,
        KeyframeIndex,
        ViewerCalibration.KeyFrame(Calibration, Playback.SelectedClip, KeyframeIndex)
    )

    Call UpdateTimelineKeyframeDrag()

End Sub

Sub UpdateTimelineKeyframeDrag()

    Dim ExistingKeyframe As Number
    Dim TargetFrame As Number
    Dim TargetTime As Number

    TargetFrame = ViewerUi.TimelineFrameAtPointer(
        Pointer_X(),
        Window_Width(),
        Character3D.ClipDuration(Character, Playback.SelectedClip),
        Character3D.ClipSampleRate(Character, Playback.SelectedClip),
        Character3D.ClipSampleCount(Character, Playback.SelectedClip)
    )
    ExistingKeyframe = ViewerCalibration.KeyIndex(
        Calibration, Playback.SelectedClip, TargetFrame)

    If ExistingKeyframe < 0 Or ExistingKeyframe = ViewerInputState.TimelineDraggedKeyframe Then
        ViewerInputState.TimelineDraggedTargetFrame = TargetFrame
    End If

    TargetTime = ViewerCalibration.FrameTimeMilliseconds(
        Character, Playback.SelectedClip, ViewerInputState.TimelineDraggedTargetFrame)
    Session.Ready = Character3D.SetAnimationTime(Character, TargetTime) And Session.Ready

    Call ViewerEffects.InvalidateVisualHistory(Effects)

End Sub

Sub FinishTimelineKeyframeDrag()

    Dim Transaction As ViewerCalibration.TransactionResult

    Call ViewerInput.FinishTimelineGesture(ViewerInputState)

    If ViewerInputState.TimelineDraggedTargetFrame = ViewerInputState.TimelineDraggedOriginalFrame Then
        Return
    End If

    Transaction = ViewerCalibration.MoveKeyAndPersist(
        Calibration,
        Character,
        Playback.SelectedClip,
        ViewerInputState.TimelineDraggedKeyframe,
        ViewerInputState.TimelineDraggedTargetFrame,
        ViewerUiState.CalibrationEditing
    )

    If Not Transaction.Applied Then
        Return
    End If

    If Transaction.Persisted Then
        Call ViewerEffects.InvalidateVisualHistory(Effects)
    End If

    Call UpdateCalibrationForCurrentFrame()
    Call ApplyWristCalibration()

End Sub

Sub CycleLighting()

    LightingIndex = (LightingIndex + 1) Mod 4

    Call ApplyLighting()

End Sub

Sub ApplyLighting()

    If LightingIndex = 0 Then

        Session.Ready = Graphics3D.ClearAdditionalLights3DChecked() And Session.Ready
        Session.Ready = Graphics3D.SetAmbientLight3D(255, 255, 255, 68) And Session.Ready
        Session.Ready = Graphics3D.SetDirectionalLight3D(-35, -80, 25, 255, 248, 235, 220) And Session.Ready
        Session.Ready = Graphics3D.SetPointLight3D(0, -80, 120, -30, 170, 205, 255, 260, 360) And Session.Ready
        Session.Ready = Graphics3D.SetPointLight3D(1, 80, 80, 0, 255, 205, 145, 180, 300) And Session.Ready

        Call Scene3D.UseCustomLighting()

    Else If LightingIndex = 1 Then

        Session.Ready = Scene3D.UseLighting("CharacterStudio") And Session.Ready

    Else If LightingIndex = 2 Then

        Session.Ready = Scene3D.UseLighting("Daylight") And Session.Ready

    Else
        Session.Ready = Scene3D.UseLighting("Moonlight") And Session.Ready

    End If

End Sub

Sub ConfigureCalibration()

    Dim Configuration As ViewerCalibration.ConfigurationResult

    Session.CharacterSwitchBlocked = False

    Call ViewerUi.ResetCalibration(
        ViewerUiState,
        ViewerUi.CALIBRATION_TARGET_SWORD_WRIST,
        ViewerUi.CALIBRATION_AXIS_X,
        ViewerUi.CALIBRATION_TRANSFORM_ROTATE
    )
    Call ViewerGizmo.Reset(ViewerGizmoState)

    Configuration = ViewerCalibration.ConfigureForActor(
        Calibration,
        Session.ProfileIndex,
        Calibration.KeyBase,
        Character
    )
    CalibrationAvailable = Configuration.Available
    SwordWristNode = Configuration.SwordWristNode
    ShieldWristNode = Configuration.ShieldWristNode

End Sub

Sub HandleCalibrationImport()

    Dim Accepted As Boolean
    Dim WasPending As Boolean

    Call BeginPartyPreview()

    Playback.ScenePaused = True

    If Not Party.Enabled Then
        Playback.DemoEnabled = False
    End If

    WasPending = Calibration.ImportPending
    Accepted = ViewerCalibration.ImportOrCommit(
        Calibration, Character, Playback.SelectedClip, ViewerUiState.CalibrationEditing)

    If Accepted And WasPending Then

        Call UpdateCalibrationForCurrentFrame()
        Call ApplyWristCalibration()
        Call ApplyEquipmentCalibration()
    Call ViewerEffects.InvalidateVisualHistory(Effects)

    End If

End Sub

Sub UpdateCalibrationForCurrentFrame()

    Call ViewerCalibrationEditing.EvaluateCurrent(
        Calibration,
        Character,
        Playback.SelectedClip,
        Session.ProfileIndex,
        ViewerUiState.CalibrationEditing,
        CalibrationAvailable
    )

End Sub

Sub DeleteCurrentCalibrationKeyframe()

    Dim Transaction As ViewerCalibration.TransactionResult

    Transaction = ViewerCalibration.DeleteCurrentKeyAndPersist(
        Calibration, Character, Playback.SelectedClip,
        ViewerUiState.CalibrationEditing)

    If Not Transaction.Applied Then
        Return
    End If

    ViewerUiState.CalibrationClearConfirm = False
    ViewerUiState.CalibrationClearAllStage = 0

    If Transaction.Persisted Then
        Call ViewerEffects.InvalidateVisualHistory(Effects)
    End If

    Call UpdateCalibrationForCurrentFrame()
    Call ApplyWristCalibration()

End Sub

Sub CopyCurrentCalibrationKeyframe()

    Call ViewerCalibration.CopyKey(
        Calibration, Playback.SelectedClip,
        ViewerCalibration.CurrentAnimationFrame(
            Character, Playback.SelectedClip))

End Sub

Sub ReloadCurrentCalibrationKeyframe()

    If Not ViewerCalibration.ReloadCurrentKey(
        Calibration, Character, Playback.SelectedClip) Then
        Return
    End If

    ViewerUiState.CalibrationClearConfirm = False
    ViewerUiState.CalibrationClearAllStage = 0

    Call ApplyWristCalibration()
    Call ApplyEquipmentCalibration()
    Call FinishCalibrationEdit()

    Call ViewerEffects.InvalidateVisualHistory(Effects)

End Sub

Sub PasteCalibrationKeyframe()

    Dim SavedSuccessfully As Boolean

    SavedSuccessfully = ViewerCalibration.PasteClipboardAndPersist(
        Calibration, Character, Playback.SelectedClip,
        ViewerUiState.CalibrationEditing)

    If SavedSuccessfully Then

        Call UpdateCalibrationForCurrentFrame()
        Call ApplyWristCalibration()
    Call ViewerEffects.InvalidateVisualHistory(Effects)

    End If

End Sub

Sub ApplyWristCalibration()

    Session.Ready = ViewerCalibration.ApplyWristOffsets(
        Calibration,
        Character,
        Playback.SelectedClip,
        SwordWristNode,
        ShieldWristNode,
        CalibrationAvailable
    ) And Session.Ready

End Sub

Sub ApplyEquipmentCoupling()

    Session.Ready = ViewerCalibration.ApplyEquipmentCoupling(
        Calibration,
        Character,
        Playback.SelectedClip,
        Effects.SwordGlow,
        Effects.ShieldGlow,
        Effects.EpicGlowAvailable
    ) And Session.Ready

End Sub

Sub ApplyEquipmentCalibration()

    Dim Application As ViewerCalibration.ApplicationResult
    Dim FailureStage As Number

    Application = ViewerCalibration.ApplyEquipmentTransforms(
        Calibration,
        Character,
        Playback.SelectedClip,
        Effects.SwordGlow,
        Effects.ShieldGlow,
        Effects.EpicGlowAvailable,
        Effects.EpicGlowVisible
    )
    Session.Ready = Application.Ready And Session.Ready

    If Not Session.Ready Then

        FailureStage = Application.FailureStage

        If FailureStage = 0 Then
            FailureStage = 71
        End If

        Call ViewerSession.CaptureFailure(Session, FailureStage)

    End If

End Sub

Sub ApplyCalibrationEditingResult(
    Result As ViewerCalibrationEditing.OperationResult)

    Session.Ready = Result.Ready And Session.Ready

    If Result.Applied And Not Session.Ready Then

        If Result.FailureStage = 0 Then
            Result.FailureStage = 71
        End If

        Call ViewerSession.CaptureFailure(Session, Result.FailureStage)

    End If

End Sub

Sub BeginCalibrationEdit()

    If ViewerUiState.CalibrationEditing Then
        Return
    End If

    Call BeginPartyPreview()
    Call ViewerCalibrationEditing.BeginEdit(
        Calibration, Character, Playback.SelectedClip,
        ViewerUiState, ViewerCameraState, Effects)

End Sub

Sub FinishCalibrationEdit()

    Dim Finished As Boolean

    Finished = ViewerCalibrationEditing.FinishEdit(
        ViewerUiState, ViewerGizmoState, ViewerCameraState, Effects)

    If Finished Then
        Session.CharacterSwitchBlocked = False
    End If

End Sub

Sub CancelCalibrationEdit()

    Dim Result As ViewerCalibrationEditing.OperationResult

    Result = ViewerCalibrationEditing.CancelEdit(
        Calibration, Character, Playback.SelectedClip,
        SwordWristNode, ShieldWristNode, CalibrationAvailable,
        ViewerUiState, ViewerGizmoState, ViewerCameraState, Effects)

    Call ApplyCalibrationEditingResult(Result)

    If Result.Applied Then
        Session.CharacterSwitchBlocked = False
    End If

End Sub

Sub SetCurrentCalibrationValue(Value As Number)

    Dim Result As ViewerCalibrationEditing.OperationResult

    If Not ViewerUiState.CalibrationEditing Then
        Call BeginPartyPreview()
    End If

    Result = ViewerCalibrationEditing.SetCurrentValue(
        Calibration, Character, Playback.SelectedClip,
        SwordWristNode, ShieldWristNode, CalibrationAvailable,
        ViewerUiState, ViewerGizmoState, ViewerCameraState, Effects, Value)

    Call ApplyCalibrationEditingResult(Result)

End Sub

Sub AdjustCalibrationValue(Amount As Number)

    Call SetCurrentCalibrationValue(
        ViewerCalibrationEditing.CurrentValue(
            Calibration, Playback.SelectedClip, ViewerUiState) + Amount)

End Sub

Sub SetCalibrationFromPointer()

    Dim MaximumValue As Number
    Dim MinimumValue As Number
    Dim Value As Number

    MaximumValue = ViewerCalibration.MaximumValue(ViewerUiState.CalibrationTransform)
    MinimumValue = ViewerCalibration.MinimumValue(ViewerUiState.CalibrationTransform)
    Value = ViewerUi.CalibrationValueAtPointer(
        Pointer_X(), MinimumValue, MaximumValue)

    Call SetCurrentCalibrationValue(Value)

End Sub

Sub ResetCalibrationTarget()

    Dim Result As ViewerCalibrationEditing.OperationResult

    If Not ViewerUiState.CalibrationEditing Then
        Call BeginPartyPreview()
    End If

    Result = ViewerCalibrationEditing.ResetTarget(
        Calibration, Character, Playback.SelectedClip,
        SwordWristNode, ShieldWristNode, CalibrationAvailable,
        ViewerUiState, ViewerGizmoState, ViewerCameraState, Effects)

    Call ApplyCalibrationEditingResult(Result)

End Sub

Sub ClearSelectedClipCalibration()

    Dim Transaction As ViewerCalibration.TransactionResult

    Transaction = ViewerCalibration.ClearClipAndPersist(
        Calibration, Character, Playback.SelectedClip,
        ViewerUiState.CalibrationEditing)

    ViewerUiState.CalibrationClearConfirm = False

    If Transaction.Persisted Then
        Call ViewerEffects.InvalidateVisualHistory(Effects)
    End If

    Call ApplyWristCalibration()
    Call ApplyEquipmentCalibration()
    Call FinishCalibrationEdit()

End Sub

Sub ClearAllCalibration()

    Dim Transaction As ViewerCalibration.TransactionResult

    Transaction = ViewerCalibration.ClearAllAndPersist(
        Calibration, Character, Playback.SelectedClip,
        ViewerUiState.CalibrationEditing)

    ViewerUiState.CalibrationClearConfirm = False
    ViewerUiState.CalibrationClearAllStage = 0

    If Transaction.Persisted Then
        Call ViewerEffects.InvalidateVisualHistory(Effects)
    End If

    Call ApplyWristCalibration()
    Call ApplyEquipmentCalibration()
    Call FinishCalibrationEdit()

End Sub

Sub SaveCalibrationFrame()

    Dim SavedSuccessfully As Boolean

    If Calibration.StorageRejected Then
        Return
    End If

    Call BeginCalibrationEdit()

    ViewerUiState.CalibrationClearConfirm = False
    SavedSuccessfully = ViewerCalibration.CommitCurrentKey(
        Calibration,
        Character,
        Playback.SelectedClip,
        ViewerUiState.CalibrationEditingFrame,
        ViewerUiState.CalibrationEditing
    )

    If SavedSuccessfully Then
    Call ViewerEffects.InvalidateVisualHistory(Effects)
    End If

    If Not Calibration.WriteFailed Then
        Call FinishCalibrationEdit()
    End If

End Sub

Sub UndoLastCalibrationChange()

    Call FinishCalibrationEdit()

    If Not ViewerCalibration.Undo(
        Calibration, Character, Playback.SelectedClip) Then
        Return
    End If

    Call UpdateCalibrationForCurrentFrame()
    Call ApplyWristCalibration()
    Call ApplyEquipmentCalibration()
    Call ViewerEffects.InvalidateVisualHistory(Effects)

End Sub

Sub PlaySelectedClip(Optional RetainFireTails As Boolean = False)

    ''' Explicit editor navigation is a cut, not a corrected-pose cross-fade.
    ''' Automatic demo changes keep existing fire but never inherit across the cut.

    If Not RetainFireTails Then
    Call ViewerEffects.InvalidateVisualHistory(Effects)
    End If

    Session.Ready = ViewerPlayback.StartSelectedClip(
        Playback, Character, Session.ProfileIndex) And Session.Ready
    Effects.ArinAudio.Clip = ""

    Call UpdateCalibrationForCurrentFrame()
    Call ApplyWristCalibration()

    If Effects.EpicGlowAvailable Then
        Call ViewerEffects.ResetEpicGlowTrails(Effects, Character)
    End If

End Sub

Sub DrawViewerOverlay()

    Call BeginPartyInspector()

    If (ViewerUiState.Visibility = 0 And
        CalibrationAvailable And
        ViewerUiState.CalibrationVisible And
        ViewerGizmoState.Visible) Then

        Call UpdateTransformGizmo()

        ViewerGizmoState.HoverAxis = ViewerGizmo.AxisAtPointer(
            ViewerGizmoState,
            Pointer_X(),
            Pointer_Y(),
            Pointer_Inside(),
            90,
            Window_Height() - 100,
            ViewerUi.StatusPanelX(Window_Width()),
            ViewerUi.CALIBRATION_PANEL_X,
            ViewerUi.CALIBRATION_PANEL_Y,
            ViewerUi.CALIBRATION_PANEL_WIDTH,
            ViewerUi.CALIBRATION_PANEL_HEIGHT,
            ViewerUiState.CalibrationTransform,
            ViewerUiState.CalibrationAxis,
            ViewerCameraState.Live,
            Window_Width(),
            Window_Height()
        )

        Call ViewerGizmo.Draw(
            ViewerGizmoState,
            ViewerUiState.CalibrationTransform,
            ViewerUiState.CalibrationAxis,
            ViewerCameraState.Live,
            Window_Width(),
            Window_Height()
        )

    End If

    Call DrawInspectorOverlay()
    Call EndPartyInspector()

End Sub

Sub DrawInspectorOverlay()

    Dim DragonTargetsArin As Boolean
    Dim PanelLeft As Number

    If ViewerUiState.Visibility = 2 Then
        Return
    End If

    PanelLeft = ViewerUi.StatusPanelX(Window_Width())

    If ViewerUi.LayoutTooSmall(Window_Width(), Window_Height()) Then
        Call ViewerUi.DrawMinimumSizeNotice(Window_Width(), Window_Height())

        Return
    End If

    Call ViewerUi.DrawHeader(
        ActiveProfile.DisplayName,
        ActiveProfile.PartyRole,
        Party.Enabled,
        Session.SelectedCharacterTab,
        Window_Width()
    )

    If Party.Enabled And Not ViewerUiState.CalibrationVisible Then
        Call ViewerParty.DrawOverlay(
            Party,
            ViewerUiState.Visibility,
            Window_Height(),
            DragonState.Visible,
            SwordVisible,
            ShieldVisible,
            Rendering.FloorVisible Or Rendering.GridVisible,
            Rendering.BackgroundIndex > 0,
            Effects.EpicGlowVisible,
            Playback.ScenePaused,
            ViewerCameraState.AutoOrbit,
            Effects.FlamePaused,
            Effects.LightningPaused,
            ViewerUi.PlaybackLabel("Fire", Effects.FlamePaused, "Freeze"),
            ViewerUi.PlaybackLabel("Lightning", Effects.LightningPaused, "Freeze"),
            ViewerEffects.ShieldFireStyleLabel(Effects),
            Effects.ShieldFlameStyle,
            ViewerEffects.StormCaption(Effects),
            ViewerTiming.FramesPerSecond(FrameRate),
            Session.ViewerError,
            Session.FirstFailureStage,
            ViewerCameraState.Live
        )
    End If

    If ViewerUiState.Visibility = 0 Then

        Call ViewerUi.DrawInspectorToolbar(
            Window_Width(),
            Window_Height(),
            ViewerProfiles.INCLUDE_DIAGNOSTIC_PROFILES,
            Party.Enabled,
            Rendering.SocketGizmosVisible,
            Effects.EpicGlowVisible,
            ViewerUi.DragonLabel(Session.DragonInspection,
                DragonState.Available, DragonState.Visible),
            DragonState.Visible,
            ViewerUi.BackgroundLabel(Rendering.BackgroundIndex),
            Rendering.BackgroundIndex > 0,
            CalibrationAvailable,
            ViewerUiState.CalibrationVisible,
            SwordVisible,
            ShieldVisible
        )

        Call ViewerUi.DrawCharacterStatusSummary(
            PanelLeft,
            ActiveProfile.DisplayName,
            ActiveProfile.PartyRole,
            ViewerPlayback.SelectedClipLabel(
                Character, Playback, Session.ProfileIndex),
            ActiveProfile.CandidateVersion,
            Playback.PlaybackSpeed,
            MaterialInspection,
            Graphics3D.DrawCallCount3D(),
            Graphics3D.SubmittedTriangleCount3D(),
            ViewerUi.DemoStatusLabel(
                Party.Enabled, Playback.ScenePaused, Playback.DemoEnabled),
            AnimationSecondsRemaining(),
            CharacterViewer.ZoomDegrees(ViewerCameraState.Zoom),
            ViewerTiming.FramesPerSecond(FrameRate)
        )

        Call ViewerUi.DrawDemoControl(
            PanelLeft, Party.Enabled, Playback.ScenePaused, Playback.DemoEnabled)

        Call ViewerUi.DrawAnimationButtons(
            Session.ProfileIndex,
            ViewerPlayback.PresentationIndexForRuntimeClip(
                Character, Session.ProfileIndex, Playback.SelectedClip),
            Window_Width()
        )

        DragonTargetsArin = Not Party.Enabled And Party.DragonCounter Mod 2 = 0

        If Party.Enabled Then
            DragonTargetsArin = Party.HitTarget = 0
        End If

        Call ViewerUi.DrawProfileEffectControls(
            Window_Width(),
            Session.ProfileIndex,
            Rendering.FloorVisible Or Rendering.GridVisible,
            Effects.SwordFireVisible,
            Effects.ShieldFireVisible,
            ViewerEffects.StormStyleName(Effects),
            ViewerEffects.StormSceneComfortName(),
            ViewerUi.PlaybackLabel("Lightning", Effects.LightningPaused, "Freeze"),
            Effects.LightningPaused,
            DragonState.HeadTracking,
            DragonTargetsArin,
            Effects.SwordFireReady,
            ViewerUi.PlaybackLabel("Flames", Effects.FlamePaused, "Pause"),
            Not Effects.FlamePaused,
            ViewerEffects.ShieldFireStyleLabel(Effects),
            Effects.ShieldFlameStyle
        )

        Call ViewerUi.DrawAnimationDetails(
            PanelLeft,
            Window_Height(),
            Character3D.ClipDuration(Character, Playback.SelectedClip),
            Character3D.ClipSampleRate(Character, Playback.SelectedClip),
            Character3D.ClipSampleCount(Character, Playback.SelectedClip),
            Character3D.ClipEventCount(Character, Playback.SelectedClip),
            Character3D.ClipCount(Character),
            Character3D.SocketCount(Character),
            Character3D.EventCount(Character)
        )

        Call ViewerUi.DrawCameraControls(
            PanelLeft,
            Window_Height(),
            ViewerCameraState.Controls.OrbitYaw,
            ViewerCameraState.Controls.OrbitPitch,
            CharacterViewer.ZoomDegrees(ViewerCameraState.Zoom),
            ZOOM_IN_LIMIT,
            ZOOM_OUT_LIMIT
        )

        Call ViewerUi.DrawViewControls(
            Window_Width(), Window_Height(), ViewerCameraState.FitLocked)

    End If

    Call ViewerUi.DrawTimeline(
        Character,
        Calibration,
        ViewerInputState,
        Playback.SelectedClip,
        ViewerPlayback.SelectedClipName(Character, Playback),
        Playback.SelectedTimelineEvent,
        CalibrationAvailable,
        Window_Width(),
        Window_Height()
    )

    If (ViewerUiState.Visibility = 0 And
        CalibrationAvailable And
        ViewerUiState.CalibrationVisible) Then
        Call ViewerUi.DrawCalibrationPanel(
            ViewerUiState,
            Calibration,
            Playback.SelectedClip,
            ViewerPlayback.SelectedClipLabel(
                Character, Playback, Session.ProfileIndex),
            ViewerPlayback.SelectedClipName(Character, Playback),
            ViewerCalibration.CurrentAnimationFrame(
                Character, Playback.SelectedClip),
            ViewerCalibration.KeyIndex(
                Calibration,
                Playback.SelectedClip,
                ViewerCalibration.CurrentAnimationFrame(
                    Character, Playback.SelectedClip)
            ),
            ViewerCalibrationEditing.CurrentValue(
                Calibration, Playback.SelectedClip, ViewerUiState),
            ViewerCalibration.MinimumValue(ViewerUiState.CalibrationTransform),
            ViewerCalibration.MaximumValue(ViewerUiState.CalibrationTransform),
            ViewerGizmoState.Visible,
            ViewerGizmoState.HoldGrip,
            ViewerGizmoState.GripLimit,
            Playback.ScenePaused,
            ViewerCalibration.ChannelValue(
                Calibration, Playback.SelectedClip, 18) <> 0,
            ViewerCalibration.ChannelValue(
                Calibration, Playback.SelectedClip, 19) <> 0
        )
    End If

    Call ViewerUi.DrawFooterMessage(
        Window_Width(), Window_Height(), CalibrationAvailable,
        Calibration.TransferMessage)
    Call ViewerUi.DrawPauseStatus(
        PanelLeft,
        ViewerUiState.CalibrationEditing,
        Playback.ScenePaused,
        Session.CharacterSwitchBlocked,
        Party.Enabled
    )
    Call ViewerUi.DrawRecoveryOverlay(
        ViewerUiState.Visibility,
        Session.ViewerError,
        Session.FirstViewerError,
        Session.FirstRendererError,
        Session.FirstFailureStage
    )

End Sub

Function ViewerTitle() As Text

    Dim Result As Text

    Result = "SMILE 2.0 - 3D Viewer, Animation Editor - " + ViewerProfiles.ModelFileName(Session.ProfileIndex)

    Return Result

End Function

Function AnimationSecondsRemaining() As Number

    Dim RequiredMilliseconds As Number
    Dim RemainingMilliseconds As Number
    Dim Result As Number

    If Party.Enabled Then

        RequiredMilliseconds = ViewerParty.AttackDuration(
            Party,
            Character,
            Party.Companion.Actor,
            Playback.PlaybackSpeed
        ) + 4000

        If Party.Turn = 2 Then
            RequiredMilliseconds = ViewerParty.DragonTurnDuration(
                Party, Playback.PlaybackSpeed)
        End If

        RemainingMilliseconds = Max(0, RequiredMilliseconds - Party.Elapsed)
        Result = (RemainingMilliseconds + 999) / 1000

    Else
        Result = ViewerPlayback.DemoSecondsRemaining(
            Playback, Character, Session.ProfileIndex,
            ANIMATION_CYCLE_MILLISECONDS)

    End If

    Return Result

End Function

Sub DestroyViewer()

    Call DestroyViewerResources()
    Call Character3D.Shutdown()
    Call Scene3D.Shutdown()
    Call Graphics3D.ResetRenderer3D()

End Sub

Sub DestroyViewerResources()

    Call ViewerParty.DestroyParticipants(Party)
    Call ViewerDragon.Shutdown(DragonState, Effects.DragonLight)

    Session.Ready = ViewerEffects.ShutdownShared(Effects) And Session.Ready

    Call DestroyBackdrop()
    Call ViewerEffects.DestroyEpicGlow(Effects)
    Call ViewerRendering.DestroySocketGizmos(Rendering)
    Call ViewerRendering.DestroyArena(Rendering)

    Call Character3D.Destroy(Character)

End Sub

Sub SelectCharacterTab(Index As Number)

    If (Index = Session.SelectedCharacterTab And
        Not Session.ViewerError And
        (Party.Enabled Or Session.DragonInspection Or ViewerProfiles.IsPartyCharacter(Session.ProfileIndex))) Then
        Return
    End If

    If (ViewerUiState.CalibrationEditing Or
        Calibration.ImportPending) Then
        Session.CharacterSwitchBlocked = True
        Return
    End If

    Call CancelInteractionCaptures()

    Fill Rectangle 300, 120, Max(240, Window_Width() - 600), 44, Rgb(8, 16, 30)
    Draw Text "Loading Selected Character..." At 312, 132 Size 16 Color WHITE
    Show Screen

    Call DestroyViewerResources()

    Session.SelectedCharacterTab = Index
    Party.Enabled = Index = 3
    Session.DragonInspection = Index = 2
    Session.ProfileIndex = ViewerProfiles.PROFILE_ARIN

    If Index = 1 Then
        Session.ProfileIndex = ViewerProfiles.PROFILE_ORIN
    Else If Index = 2 Then
        Session.ProfileIndex = ViewerProfiles.PROFILE_DRAGON
    End If

    Call ViewerSession.ResetFailure(Session)

    Playback.DemoEnabled = True
    Playback.ScenePaused = False

    Call LoadViewer()

End Sub

Function CaptureActorContext() As ViewerActors.Context

    Dim Result As ViewerActors.Context

    Result = ViewerActors.Capture(
        Character,
        ViewerCameraState.Frame,
        Session.ProfileIndex,
        Playback.SelectedClip,
        Calibration.KeyBase,
        SwordWristNode,
        ShieldWristNode,
        Effects.SwordGlow,
        Effects.ShieldGlow,
        CalibrationAvailable,
        Effects.EpicGlowAvailable,
        Effects.EpicGlowVisible,
        Party.PrimaryPresentationState
    )

    Return Result

End Function

Sub UseActorContext(Context As ViewerActors.Context)

    Call ViewerActors.Apply(
        Context,
        Character,
        ViewerCameraState.Frame,
        Session.ProfileIndex,
        Playback.SelectedClip,
        Calibration.KeyBase,
        SwordWristNode,
        ShieldWristNode,
        Effects.SwordGlow,
        Effects.ShieldGlow,
        CalibrationAvailable,
        Effects.EpicGlowAvailable,
        Effects.EpicGlowVisible,
        Party.PrimaryPresentationState
    )

    ActiveProfile = ViewerProfiles.ProfileAt(Session.ProfileIndex)

End Sub

Sub BeginPartyInspector()

    Dim Index As Number
    Dim WasVisible As Boolean

    If (Not Party.Enabled Or
        Not Party.Ready Or
        Session.ViewerError Or
        Party.UiBound) Then
        Return
    End If

    If Not ViewerParty.BeginInspectorBinding(
        Party,
        CaptureActorContext(),
        Party.Turn
    ) Then
        Return
    End If

    If Party.UiTurn = 1 Then

        Call UseActorContext(Party.Companion)

    Else If Party.UiTurn = 2 Then

        Character = DragonState.Actor
        Session.ProfileIndex = ViewerProfiles.PROFILE_DRAGON
        ActiveProfile = ViewerProfiles.ProfileAt(Session.ProfileIndex)
        CalibrationAvailable = False
        Effects.EpicGlowAvailable = False
        SwordWristNode = -1
        ShieldWristNode = -1
        Playback.SelectedClip = 0

        For Index = 0 To Character3D.ClipCount(Character) - 1

            If Character3D.ClipName(Character, Index) = DragonState.Clip Then
                Playback.SelectedClip = Index
            End If

        End For

    End If

    If Calibration.OwnerProfile <> Session.ProfileIndex Then

        ''' One editing owner at a time. Never carry a pending import, Undo, or
        ''' clipboard into another character's independent storage identity.
        WasVisible = ViewerUiState.CalibrationVisible

        Call ConfigureCalibration()

        ViewerUiState.CalibrationVisible = WasVisible And CalibrationAvailable
        Playback.SelectedTimelineEvent = ViewerPlayback.FirstClipEvent(
            Character, Playback.SelectedClip)

    End If

End Sub

Sub EndPartyInspector()

    If Not Party.UiBound Then
        Return
    End If

    If Party.UiTurn = 1 Then
        Party.Companion = CaptureActorContext()

        Call UseActorContext(Party.UiPrimary)
    Else If Party.UiTurn = 2 Then
        Call ViewerDragon.CaptureInspectedActor(
            DragonState,
            Character,
            ViewerPlayback.SelectedClipName(Character, Playback)
        )

        Call UseActorContext(Party.UiPrimary)
    End If

    Call ViewerParty.EndInspectorBinding(Party)

End Sub

Sub BeginPartyPreview()

    If Not Party.UiBound Then
        Return
    End If

    Call ViewerParty.BeginPreview(
        Party,
        Character,
        Playback.SelectedClip,
        Session.ProfileIndex
    )

    Playback.ScenePaused = True

End Sub

Sub RestorePartyPreview()

    If Not Party.PreviewActive Or Not Party.UiBound Then
        Return
    End If

    Session.Ready = ViewerParty.RestorePreview(
        Party,
        Character,
        Playback.SelectedClip,
        Playback.PlaybackSpeed
    ) And Session.Ready

    ViewerUiState.CalibrationVisible = False

    Call ViewerInput.CancelCaptures(ViewerInputState)

    Call UpdateCalibrationForCurrentFrame()
    Call ViewerEffects.InvalidateVisualHistory(Effects)

End Sub

Sub ResetPartyInspector()

    Call BeginPartyInspector()
    Call CancelCalibrationEdit()
    Call RestorePartyPreview()
    Call EndPartyInspector()

    If Session.ViewerError Then
        Call RetryViewer()
    Else

        Call ResetAll()
    End If

End Sub

Sub CreatePartyCompanion(Optional CompanionIndex As Number = ViewerProfiles.PROFILE_ORIN)

    Dim Companion As ViewerActors.Context
    Dim CompanionKeyBase As Number
    Dim Primary As ViewerActors.Context

    Primary = CaptureActorContext()
    CompanionKeyBase = 0

    If CompanionIndex = ViewerProfiles.PROFILE_ORIN Then
        CompanionKeyBase = CALIBRATION_MAX_CLIPS
    End If

    Companion = ViewerActors.LoadContext(CompanionIndex, CompanionKeyBase)
    Party.Ready = Companion.Ready

    Call UseActorContext(Companion)

    If Party.Ready Then

        Call ConfigureCalibration()

        Party.Ready = CalibrationAvailable And Not Calibration.StorageRejected And Party.Ready

        If Effects.EpicGlowMaterial.Handle = 0 Then
            Call ViewerEffects.CreateEpicGlow(Effects, Session.ProfileIndex, Character)
        Else

            Effects.EpicGlowAvailable = ViewerEffects.CreateBorrowedEpicGlow(
                Character,
                Effects.EpicGlowMaterial,
                Effects.SwordGlow,
                Effects.ShieldGlow
            )
            Effects.EpicGlowVisible = Effects.EpicGlowAvailable
        End If

        Session.Ready = ViewerParty.PlayClip(
            Character,
            "Idle",
            Playback.SelectedClip,
            Character.Handle,
            Session.ProfileIndex,
            Playback.PlaybackSpeed
        ) And Session.Ready

        Party.Companion = CaptureActorContext()
        Party.Companion.Ready = Party.Ready

    End If

    Call UseActorContext(Primary)

    If Not Session.DragonInspection Then
        Call ConfigureCalibration()
    End If

    If Party.Enabled Then
        Call ResetPartyDemo()
    End If

    Session.Ready = Companion.Ready And Party.Ready And Session.Ready

End Sub

Sub PositionDragonOpponents()

    Dim Center As Core.Vector3

    Center.X = ViewerDragon.PositionX()
    Center.Z = ViewerDragon.PositionZ()
    Session.Ready = ViewerParty.PlaceDragonInspectionParticipants(
        Party,
        Center,
        PARTY_FORMATION_RADIUS,
        PARTY_FORMATION_START_ANGLE,
        PARTY_FORMATION_END_ANGLE,
        CHARACTER_MODEL_FORWARD_YAW_OFFSET,
        ORIN_ARENA_YAW_ADJUSTMENT
    ) And Session.Ready

End Sub

Sub UpdateDragonOpponent()

    Dim Update As ViewerParty.ParticipantUpdateResult

    Update = ViewerParty.UpdateDragonOpponent(
        Party,
        Calibration,
        Effects,
        Playback.AnimationUpdateElapsed,
        ViewerUiState.CalibrationEditing,
        SwordVisible,
        ShieldVisible,
        Playback.ScenePaused,
        ViewerPlayback.ClipLabel(
            Party.DragonOpponent.Actor,
            Party.DragonOpponent.Profile,
            Party.DragonOpponent.Clip
        ),
        ViewerCameraState.Live,
        Timing.CameraElapsed
    )

    Session.Ready = Update.Ready And Session.Ready

    If Update.Updated And Not Session.Ready Then
        Call CapturePartyParticipantFailure(Update.FailureStage)
    End If

End Sub

Sub InitializePartyFormation()

    Dim Center As Core.Vector3
    Dim FirstApproach As Core.Vector3
    Dim SecondApproach As Core.Vector3

    Center.X = ViewerDragon.PositionX()
    Center.Z = ViewerDragon.PositionZ()
    FirstApproach.X = -21
    FirstApproach.Z = -44
    SecondApproach.X = -49
    SecondApproach.Z = 4

    Call ViewerParty.InitializeFormation(
        Party,
        Center,
        PARTY_FORMATION_RADIUS,
        PARTY_FORMATION_START_ANGLE,
        PARTY_FORMATION_END_ANGLE,
        FirstApproach,
        SecondApproach,
        ORIN_ARENA_YAW_ADJUSTMENT
    )

    ''' Only one hero approaches at a time; animated full-model bounds must not move these shots.

End Sub

Sub ResetPartyDemo()

    Playback.DemoEnabled = True
    ViewerUiState.CalibrationVisible = False

    Call ViewerParty.ResetChoreography(Party)
    Call InitializePartyFormation()
    Call PreparePartyDragonTurn()

    If Party.Ready Then
        Session.Ready = Character3D.SetPartVisible(Party.Companion.Actor,
            WEAPON_PART_INDEX, SwordVisible) And Session.Ready
        Session.Ready = Character3D.SetPartVisible(Party.Companion.Actor,
            SHIELD_PART_INDEX, ShieldVisible) And Session.Ready
    End If

End Sub

Sub PreparePartyDragonTurn()

    Dim RolledTarget As Number

    Random RolledTarget From -1 To 1

    Call ViewerParty.PrepareDragonTurn(Party, RolledTarget)

End Sub

Sub AdvancePartyDemo()

    Dim Actions As ViewerParty.FrameActions
    Dim AttackMilliseconds As Number
    Dim RolledTarget As Number

    AttackMilliseconds = ViewerParty.AttackDuration(
        Party,
        Character,
        Party.Companion.Actor,
        Playback.PlaybackSpeed
    )
    RolledTarget = -1

    If ViewerParty.WillPrepareDragonTurn(
        Party,
        Playback.AnimationUpdateElapsed,
        Playback.DemoEnabled,
        Playback.ScenePaused,
        AttackMilliseconds,
        Playback.PlaybackSpeed
    ) Then
        Random RolledTarget From -1 To 1
    End If

    Actions = ViewerParty.AdvanceChoreography(
        Party,
        Playback.AnimationUpdateElapsed,
        Playback.DemoEnabled,
        Playback.ScenePaused,
        AttackMilliseconds,
        Playback.PlaybackSpeed,
        RolledTarget
    )

    Session.Ready = ViewerParty.ApplyFrame(
        Party,
        Actions,
        Character,
        ViewerCameraState.Frame,
        Playback.SelectedClip,
        Playback.PlaybackSpeed,
        ViewerDragon.PositionX(),
        0,
        ViewerDragon.PositionZ(),
        CHARACTER_MODEL_FORWARD_YAW_OFFSET
    ) And Session.Ready

End Sub

Sub UpdatePartyCompanion()

    Dim Update As ViewerParty.ParticipantUpdateResult

    If Not Party.Ready Then
        Return
    End If

    Update = ViewerParty.UpdateCompanion(
        Party,
        Calibration,
        Effects,
        Playback.AnimationUpdateElapsed,
        ViewerUiState.CalibrationEditing
    )
    Session.Ready = Update.Ready And Session.Ready

    If Update.Updated And Not Session.Ready Then
        Call CapturePartyParticipantFailure(Update.FailureStage)
    End If

End Sub

Sub CapturePartyParticipantFailure(FailureStage As Number)

    If FailureStage = 0 Then
        FailureStage = 71
    End If

    Call ViewerSession.CaptureFailure(Session, FailureStage)

End Sub

Function HandlePartyPointer() As Boolean

    Dim ReturnValue As Boolean

    Dim CapturesActive As Boolean
    Dim Decision As ViewerParty.PointerDecision

    CapturesActive = (ViewerInputState.TimelineScrubbing Or
        ViewerInputState.TimelineKeyframeDragging Or
        ViewerInputState.FrameButtonRepeatDirection <> 0 Or
        ViewerInputState.SliderDragOwner <> 0 Or
        ViewerGizmoState.Dragging)
    Decision = ViewerParty.ClassifyPointer(
        Pointer_X(),
        Pointer_Y(),
        Pointer_Pressed(POINTER_PRIMARY),
        Pointer_Pressed(POINTER_SECONDARY),
        ViewerUiState.Visibility,
        ViewerUiState.CalibrationVisible,
        CapturesActive,
        Window_Height(),
        ViewerUi.StatusPanelX(Window_Width()),
        ViewerUi.GlowButtonX(Window_Width(),
            ViewerProfiles.INCLUDE_DIAGNOSTIC_PROFILES, Party.Enabled),
        ViewerUi.GlowButtonWidth(
            ViewerProfiles.INCLUDE_DIAGNOSTIC_PROFILES, Party.Enabled)
    )

    If Decision.Action = ViewerParty.POINTER_ACTION_RESET_VIEW Then

        Call ResetView()

    Else If Decision.Action = ViewerParty.POINTER_ACTION_RESET_INSPECTOR Then

        Call ResetPartyInspector()

    Else If Decision.Action = ViewerParty.POINTER_ACTION_TOGGLE_GLOW Then

        Call ToggleEpicGlow()

    Else If Decision.Action = ViewerParty.POINTER_ACTION_CYCLE_SOCKET Then

        Call ViewerRendering.CycleSocketDisplay(Rendering)

    Else If Decision.Action = ViewerParty.POINTER_ACTION_SPEED_DOWN Then

        Call AdjustPlaybackSpeed(-25)

    Else If Decision.Action = ViewerParty.POINTER_ACTION_SPEED_UP Then

        Call AdjustPlaybackSpeed(25)

    Else If Decision.Action = ViewerParty.POINTER_ACTION_TOGGLE_DRAGON Then

        Call ToggleDragon()

    Else If Decision.Action = ViewerParty.POINTER_ACTION_TOGGLE_SWORD Then

        Call ToggleSword()

    Else If Decision.Action = ViewerParty.POINTER_ACTION_TOGGLE_SHIELD Then

        Call ToggleShield()

    Else If Decision.Action = ViewerParty.POINTER_ACTION_TOGGLE_FLOOR Then

        Call ToggleFloorAndGrid()

    Else If Decision.Action = ViewerParty.POINTER_ACTION_CYCLE_BACKGROUND Then

        Call CycleBackground()

    Else If Decision.Action = ViewerParty.POINTER_ACTION_TOGGLE_PAUSE Then

        Call BeginPartyInspector()
        Call ToggleScenePause()
        Call EndPartyInspector()

    Else If Decision.Action = ViewerParty.POINTER_ACTION_TOGGLE_ORBIT Then

        Call ViewerCamera.ToggleAutoOrbit(ViewerCameraState)

    Else If Decision.Action = ViewerParty.POINTER_ACTION_RESTART Then

        Call ResetPartyInspector()

    Else If Decision.Action = ViewerParty.POINTER_ACTION_TOGGLE_FIRE Then

        Call ViewerEffects.ToggleFlamePause(Effects)

    Else If Decision.Action = ViewerParty.POINTER_ACTION_TOGGLE_LIGHTNING Then

        Call ViewerEffects.ToggleLightningPause(Effects)

    Else If Decision.Action = ViewerParty.POINTER_ACTION_TOGGLE_SHIELD_STYLE Then

        Call ViewerEffects.ToggleShieldFireStyle(Effects)

    End If

    ReturnValue = Decision.Consumed

    Return ReturnValue

End Function
