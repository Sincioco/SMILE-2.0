''' Reusable SM3D character inspection project. Arin is the included sample asset.

Option Explicit

Import Smile.Simple3D.Character3D As Character3D
Import Smile.Simple3D.CharacterViewer As CharacterViewer
Import Smile.Simple3D.Core As Core
Import Smile.Simple3D.Graphics3D As Graphics3D
Import Smile.Simple3D.Interaction As Interaction
Import Smile.Simple3D.Math3D As Math3D
Import Smile.Simple3D.Scene3D As Scene3D
Import Smile.Tools.Character3DViewerProfiles As ViewerProfiles

Const ANIMATION_CYCLE_MILLISECONDS = 5000
Const IDLE_RESET_MILLISECONDS = 10000
Const ANIMATION_BUTTON_Y = 352
Const ANIMATION_DETAILS_Y = 494
Const ANIMATION_DETAILS_MINIMUM_HEIGHT = 650
Const ANIMATION_BUTTON_WIDTH = 110
Const ANIMATION_BUTTON_HEIGHT = 18
Const ANIMATION_BUTTON_COLUMN_GAP = 8
Const ANIMATION_BUTTON_ROW_GAP = 4
Const MINIMUM_VIEWER_WIDTH = 800
Const MINIMUM_VIEWER_HEIGHT = 540
Const ORBIT_POINTER_DIVISOR = 1
Const PAN_POINTER_DIVISOR = 3
Const DEFAULT_ZOOM_DEGREES = -16
Const ZOOM_IN_LIMIT = -48
Const ZOOM_OUT_LIMIT = 36
Const MAX_RAW_FRAME_MILLISECONDS = 60000
Const MAX_ANIMATION_ELAPSED = 250
Const MAX_CAMERA_ELAPSED = 250
Const TIMELINE_LEFT = 18
Const TIMELINE_HEIGHT = 18
Const EQUIPMENT_TRAIL_POINT_COUNT = 5
Const EQUIPMENT_TRAIL_SAMPLE_MILLISECONDS = 24
Const SWORD_TRAIL_START_MILLISECONDS = 300
Const SWORD_TRAIL_END_MILLISECONDS = 967
Const SHIELD_TRAIL_START_MILLISECONDS = 350
Const SHIELD_TRAIL_END_MILLISECONDS = 650
Const ARIN_SHIELD_PART_INDEX = 0
Const ARIN_SWORD_PART_INDEX = 1
Const EQUIPMENT_GLOW_SCALE_DIVISOR = 60
Const SWORD_TRAIL_PARTICLE_SIZE = 3
Const SHIELD_TRAIL_PARTICLE_SIZE = 5
Const DRAGON_ASSET_PATH = "Assets\Generation2\RedDragon\RedDragon.sm3d"
Const DRAGON_SCALE_PERCENT = 50000
Const DRAGON_POSITION_X = -208
Const DRAGON_POSITION_Z = -120
Const DRAGON_ROTATION_Y = 240
Const ARIN_ARENA_ROTATION_Y = 60
Const ARENA_INITIAL_ORBIT_YAW = -60
Const ARENA_DEFAULT_ZOOM_DEGREES = 20
Const ARENA_FLOOR_WIDTH = 1000
Const ARENA_FLOOR_DEPTH = 1000
Const CALIBRATION_MAX_CLIPS = 64
Const CALIBRATION_MAX_KEYFRAMES = 256
Const CALIBRATION_CHANNEL_COUNT = 18
Const CALIBRATION_KEYFRAME_VALUES_PER_CLIP = 4608
Const CALIBRATION_STORAGE_CAPACITY = 700000
Const CALIBRATION_STORAGE_VERSION = 1
Const CALIBRATION_TARGET_SWORD_WRIST = 0
Const CALIBRATION_TARGET_SHIELD_WRIST = 1
Const CALIBRATION_TARGET_SWORD = 2
Const CALIBRATION_TARGET_SHIELD = 3
Const CALIBRATION_AXIS_X = 0
Const CALIBRATION_AXIS_Y = 1
Const CALIBRATION_AXIS_Z = 2
Const CALIBRATION_AXIS_COUNT = 3
Const CALIBRATION_TRANSFORM_ROTATE = 0
Const CALIBRATION_TRANSFORM_MOVE = 1
Const CALIBRATION_MINIMUM_DEGREES = -180
Const CALIBRATION_MAXIMUM_DEGREES = 180
Const CALIBRATION_MINIMUM_POSITION = -100
Const CALIBRATION_MAXIMUM_POSITION = 100
Const CALIBRATION_PANEL_X = 18
Const CALIBRATION_PANEL_Y = 92
Const CALIBRATION_PANEL_WIDTH = 430
Const CALIBRATION_PANEL_HEIGHT = 220
Const CALIBRATION_SLIDER_X = 34
Const CALIBRATION_SLIDER_Y = 204
Const CALIBRATION_SLIDER_WIDTH = 360
Const CALIBRATION_SLIDER_HEIGHT = 20
Const CAMERA_SLIDER_WIDTH = 146
Const CAMERA_SLIDER_HEIGHT = 16

Dim BaseCamera As Core.Camera3D
Dim Camera As Core.Camera3D
Dim CameraControls As Core.CameraControl3D
Dim Character As Character3D.Actor
Dim CharacterBounds As Character3D.Bounds3D
Dim LocalCharacterBounds As Character3D.Bounds3D
Dim ActiveProfile As CharacterViewer.Profile
Dim ViewerFrame As CharacterViewer.Framing
Dim SmoothZoom As CharacterViewer.ZoomState
Dim Floor As Core.Object3D
Dim FloorVisible As Boolean
Dim Grid As Core.Object3D
Dim GridLineCount As Number
Dim GridMaterial As Core.Material3D
Dim GridVisible As Boolean
Dim SocketGizmos[4] As Core.Object3D
Dim SocketGizmoCount As Number
Dim SocketGizmosVisible As Boolean
Dim SocketMarkers As Core.ParticleBatch3D
Dim SocketMarkerMaterial As Core.Material3D
Dim SelectedSocket As Number
Dim ShowAllSocketOrigins As Boolean
Dim EpicGlowAvailable As Boolean
Dim EpicGlowVisible As Boolean
Dim EpicGlowTexture As Core.Texture3D
Dim EpicGlowMaterial As Core.Material3D
Dim EpicGlowParticleMaterial As Core.Material3D
Dim SwordGlow As Core.Object3D
Dim ShieldGlow As Core.Object3D
Dim SwordTrail As Core.ParticleBatch3D
Dim ShieldTrail As Core.ParticleBatch3D
Dim SwordTrailPoints[EQUIPMENT_TRAIL_POINT_COUNT] As Core.Vector3
Dim ShieldTrailPoints[EQUIPMENT_TRAIL_POINT_COUNT] As Core.Vector3
Dim EquipmentTrailElapsed As Number
Dim EquipmentTrailAnimationTime As Number
Dim SwordTrailActive As Boolean
Dim ShieldTrailActive As Boolean
Dim Ready As Boolean
Dim Running As Boolean
Dim ViewerError As Boolean
Dim FirstViewerError As Number
Dim FirstRendererError As Number
Dim ViewerEpoch As Number
Dim InterfacePointerBlocked As Boolean
Dim SelectedClip As Number
Dim LightingIndex As Number
Dim ProfileIndex As Number
Dim PlaybackSpeed As Number
Dim MaterialInspection As Number
Dim SelectedTimelineEvent As Number
Dim Key As Number
Dim CurrentTime As Number
Dim PreviousTime As Number
Dim RawFrameMilliseconds As Number
Dim AnimationElapsed As Number
Dim CameraElapsed As Number
Dim PresentationElapsed As Number
Dim DroppedAnimationMilliseconds As Number
Dim DroppedCameraMilliseconds As Number
Dim LongPauseCount As Number
Dim ViewerClock As CharacterViewer.ClockState
Dim FitLocked As Boolean
Dim LastFitWidth As Number
Dim LastFitHeight As Number
Dim FrameRateElapsed As Number
Dim FrameRateFrames As Number
Dim CurrentFramesPerSecond As Number
Dim PanPointerRemainderX As Number
Dim PanPointerRemainderY As Number
Dim OrbitPointerRemainderX As Number
Dim OrbitPointerRemainderY As Number
Dim AutoOrbit As Boolean
Dim AutoOrbitYaw1000 As Number
Dim AnimationCycleElapsed As Number
Dim DemoEnabled As Boolean
Dim DemoCompletedLoops As Number
Dim DemoPreviousAnimationTime As Number
Dim IdleResetElapsed As Number
Dim IdleResetPending As Boolean
Dim ScenePaused As Boolean
Dim AnimationUpdateElapsed As Number
Dim BackgroundIndex As Number
Dim DragonModel As Core.Model3D
Dim Dragon As Core.Object3D
Dim DragonAvailable As Boolean
Dim DragonVisible As Boolean
Dim SwordVisible As Boolean
Dim ShieldVisible As Boolean
Dim CalibrationAvailable As Boolean
Dim CalibrationVisible As Boolean
Dim CalibrationTarget As Number
Dim CalibrationAxis As Number
Dim CalibrationTransform As Number
Dim SwordWristCalibration[CALIBRATION_MAX_CLIPS, CALIBRATION_AXIS_COUNT] As Number
Dim ShieldWristCalibration[CALIBRATION_MAX_CLIPS, CALIBRATION_AXIS_COUNT] As Number
Dim SwordCalibration[CALIBRATION_MAX_CLIPS, CALIBRATION_AXIS_COUNT] As Number
Dim ShieldCalibration[CALIBRATION_MAX_CLIPS, CALIBRATION_AXIS_COUNT] As Number
Dim SwordPositionCalibration[CALIBRATION_MAX_CLIPS, CALIBRATION_AXIS_COUNT] As Number
Dim ShieldPositionCalibration[CALIBRATION_MAX_CLIPS, CALIBRATION_AXIS_COUNT] As Number
Dim CalibrationKeyframeCounts[CALIBRATION_MAX_CLIPS] As Number
Dim CalibrationKeyframeFrames[CALIBRATION_MAX_CLIPS, CALIBRATION_MAX_KEYFRAMES] As Number
Dim CalibrationKeyframeValues[CALIBRATION_MAX_CLIPS, CALIBRATION_KEYFRAME_VALUES_PER_CLIP] As Number
Dim CalibrationStorage[CALIBRATION_STORAGE_CAPACITY] As Number
Dim CalibrationSaved As Boolean
Dim CalibrationSavedClip As Number
Dim CalibrationSavedTime As Number
Dim CalibrationSavedFrame As Number
Dim CalibrationSaveLimitReached As Boolean
Dim SwordWristNode As Number
Dim ShieldWristNode As Number
Dim CalibrationEditing As Boolean
Dim CalibrationEditingClip As Number
Dim CalibrationAutoOrbitWasEnabled As Boolean
Dim CalibrationSavedBeforeEdit As Boolean
Dim CalibrationClearConfirm As Boolean
Dim CalibrationClearAllStage As Number
Dim SwordWristCalibrationBeforeEdit[CALIBRATION_AXIS_COUNT] As Number
Dim ShieldWristCalibrationBeforeEdit[CALIBRATION_AXIS_COUNT] As Number
Dim SwordCalibrationBeforeEdit[CALIBRATION_AXIS_COUNT] As Number
Dim ShieldCalibrationBeforeEdit[CALIBRATION_AXIS_COUNT] As Number
Dim SwordPositionCalibrationBeforeEdit[CALIBRATION_AXIS_COUNT] As Number
Dim ShieldPositionCalibrationBeforeEdit[CALIBRATION_AXIS_COUNT] As Number
Dim TimelineScrubbing As Boolean

Game Window "SMILE 2.0 - 3D Viewer, Animation Editor" Size 1600 By 640

Call Graphics3D.ResetRenderer3D()
Call LoadViewer()

Running = True
PreviousTime = Timer()

Do

    Get Key Key

    Call HandleKeyboard(Key)

    InterfacePointerBlocked = HandleInterfacePointer()

    Call UpdateCameraPointer(InterfacePointerBlocked)

    CurrentTime = Timer()
    RawFrameMilliseconds = Max(0, CurrentTime - PreviousTime)
    PreviousTime = CurrentTime

    Ready = CharacterViewer.AdvanceClock(
        ViewerClock,
        RawFrameMilliseconds,
        MAX_ANIMATION_ELAPSED,
        MAX_CAMERA_ELAPSED,
        MAX_RAW_FRAME_MILLISECONDS
    ) And Ready
    RawFrameMilliseconds = ViewerClock.RawFrameMilliseconds
    AnimationElapsed = ViewerClock.AnimationElapsed
    CameraElapsed = ViewerClock.CameraElapsed
    PresentationElapsed = ViewerClock.PresentationElapsed
    DroppedAnimationMilliseconds = ViewerClock.DroppedAnimationMilliseconds
    DroppedCameraMilliseconds = ViewerClock.DroppedCameraMilliseconds
    LongPauseCount = ViewerClock.LongPauseCount

    Call AdvanceFrameRate()
    If Not ViewerError Then

        If Not ScenePaused Then
            Call AdvanceAnimationSequence()
        End If

        If ScenePaused Then
            AnimationUpdateElapsed = 0
        Else
            AnimationUpdateElapsed = AnimationElapsed
        End If

        Ready = Character3D.Update(Character, AnimationUpdateElapsed) And Ready

        If CalibrationAvailable Then
            Call UpdateCalibrationForCurrentFrame()
            Call ApplyWristCalibration()
        End If

        If SocketGizmosVisible Then
            Call UpdateSocketGizmos()
        End If

        Call AdvanceSmoothZoom()

        If Not ScenePaused Then
            Call AdvanceIdleReset()
            Call AdvanceAutoOrbit()
        End If

        Call UpdateResponsiveFit()

        Camera = Interaction.ApplyScreenSpaceCameraControls(BaseCamera, CameraControls)

        If EpicGlowVisible Then

            If Not UpdateEpicGlow() Then
                EpicGlowVisible = False
            End If

        End If

        If CalibrationAvailable Then
            Call ApplyEquipmentCalibration()
        End If

        If Character3D.IsValid(Character) Then
            CharacterBounds = Character3D.WorldBounds(Character, ActiveProfile.AnimationMargin)
        End If

        Ready = BeginViewerScene() And Ready

        If Ready Then

            If FloorVisible Then
                Ready = Graphics3D.DrawObject3D(Floor)
            End If

            If GridVisible Then
                Ready = DrawStudioGrid() And Ready
            End If

            If DragonVisible Then
                Ready = DrawDragon() And Ready
            End If

            If EpicGlowVisible Then

                If Not DrawEquipmentGlow() Then
                    EpicGlowVisible = False
                End If

            End If

            Ready = Character3D.Draw(Character) And Ready

            If EpicGlowVisible Then

                If Not DrawEpicGlow() Then
                    EpicGlowVisible = False
                End If

            End If

            If SocketGizmosVisible Then
                Ready = DrawSocketGizmos() And Ready
            End If

            Ready = Scene3D.EndScene() And Ready

        End If

        If Not Ready Then
            Call RecordViewerError()
        End If

    End If

    Call DrawViewerOverlay()

    Show Screen

    Running = Running And Not Game_Closed()

Loop Until Not Running

Call DestroyViewer()

Sub LoadViewer()

    ActiveProfile = ViewerProfiles.ProfileAt(ProfileIndex)
    DragonAvailable = ProfileIndex = ViewerProfiles.PROFILE_ARIN
    DragonVisible = DragonAvailable
    SwordVisible = True
    ShieldVisible = True
    Ready = CharacterViewer.ValidateProfile(ActiveProfile)
    Ready = Window_Title(ViewerTitle()) And Ready
    Character = Character3D.LoadWithPolicy(
        ActiveProfile.AssetPath,
        Character3D.CHARACTER_LOAD_REQUIRE_PBR
    )
    Ready = Character3D.IsValid(Character) And Ready
    Ready = ValidateLoadedProfile() And Ready
    LocalCharacterBounds = Character3D.LocalBounds(Character)
    BaseCamera = Graphics3D.DefaultCamera()
    ViewerFrame = CharacterViewer.AutoFit(
        ActiveProfile,
        LocalCharacterBounds,
        Max(1, Window_Width() - 284),
        Max(1, Window_Height()),
        BaseCamera.FovDegrees
    )
    Ready = ViewerFrame.Valid And Ready
    BaseCamera.Position.X = 0
    BaseCamera.Position.Y = ViewerFrame.CameraY
    BaseCamera.Position.Z = ViewerFrame.CameraZ
    BaseCamera.Target.X = 0
    BaseCamera.Target.Y = ViewerFrame.TargetY
    BaseCamera.Target.Z = 0
    Floor = Graphics3D.CreatePlane3D(ViewerFloorWidth(), ViewerFloorDepth())

    Call Graphics3D.SetObjectPosition(Floor, 0, -1, 0)
    Call Graphics3D.SetObjectColor(Floor, 28, 35, 54)

    Call CreateStudioGrid()

    FloorVisible = True
    GridVisible = True
    FitLocked = True
    LastFitWidth = Window_Width()
    LastFitHeight = Window_Height()

    Call Interaction.ResetCameraControls(CameraControls)
    Call CharacterViewer.InitializeZoom(
        SmoothZoom,
        DefaultZoomDegrees(),
        ZOOM_IN_LIMIT,
        ZOOM_OUT_LIMIT,
        96000
    )

    Ready = Scene3D.SetQuality(Scene3D.QUALITY_HIGH)

    If DragonAvailable Then
        Ready = Scene3D.SetShadowArea(
            DRAGON_POSITION_X / 2,
            ViewerFrame.TargetY,
            DRAGON_POSITION_Z / 2,
            ARENA_FLOOR_WIDTH,
            ARENA_FLOOR_DEPTH,
            ViewerFrame.ShadowNear,
            ARENA_FLOOR_DEPTH
        ) And Ready
    Else
        Ready = Scene3D.SetShadowArea(
            0,
            ViewerFrame.TargetY,
            0,
            ViewerFrame.ShadowWidth,
            ViewerFrame.ShadowDepth,
            ViewerFrame.ShadowNear,
            ViewerFrame.ShadowFar
        ) And Ready
    End If

    Call ApplyLighting()

    Ready = Character3D.SetScale(Character, ViewerFrame.ScalePercent) And Ready
    Ready = Character3D.Place(
        Character,
        ViewerFrame.PositionX,
        ViewerFrame.PositionY,
        ViewerFrame.PositionZ
    ) And Ready

    Call ApplyArenaFacing()

    Ready = Character3D.SetShadows(Character, True, True) And Ready
    SocketGizmosVisible = False

    Call CreateDragon()
    Call CreateSocketGizmos()
    Call CreateEpicGlow()
    Call ConfigureCalibration()

    PlaybackSpeed = ActiveProfile.DefaultPlaybackSpeed
    MaterialInspection = Graphics3D.MATERIAL_INSPECTION_LIT
    Ready = Graphics3D.SetMaterialInspection3D(MaterialInspection) And Ready

    Call RestartPresentation()

    ViewerEpoch = Graphics3D.ResourceEpoch3D()

    If Not Ready Then
        Call RecordViewerError()
    End If

End Sub

Function ValidateLoadedProfile() As Boolean

    Dim Result As Boolean
    Dim Index As Number

    Result = Character3D.IsValid(Character)
    Result = Character3D.ClipCount(Character) = ActiveProfile.ExpectedClipCount And Result
    Result = Character3D.SocketCount(Character) = ActiveProfile.ExpectedSocketCount And Result

    For Index = 0 To ViewerProfiles.ClipCount(ProfileIndex) - 1
        Result = Character3D.HasClip(
            Character,
            ViewerProfiles.ClipName(ProfileIndex, Index)
        ) And Result
    End For

    For Index = 0 To ViewerProfiles.SocketCount(ProfileIndex) - 1
        Result = Character3D.HasSocket(
            Character,
            ViewerProfiles.SocketName(ProfileIndex, Index)
        ) And Result
    End For

    Return Result

End Function

Function ViewerFloorWidth() As Number

    Dim Result As Number

    Result = ViewerFrame.FloorWidth

    If DragonAvailable Then
        Result = Max(Result, ARENA_FLOOR_WIDTH)
    End If

    Return Result

End Function

Function ViewerFloorDepth() As Number

    Dim Result As Number

    Result = ViewerFrame.FloorDepth

    If DragonAvailable Then
        Result = Max(Result, ARENA_FLOOR_DEPTH)
    End If

    Return Result

End Function

Function InitialViewerOrbitYaw() As Number

    Dim Result As Number

    If DragonVisible Then
        Result = ARENA_INITIAL_ORBIT_YAW
    Else
        Result = ViewerProfiles.InitialOrbitYaw(ProfileIndex)
    End If

    Return Result

End Function

Function DefaultZoomDegrees() As Number

    Dim Result As Number

    If DragonVisible Then
        Result = ARENA_DEFAULT_ZOOM_DEGREES
    Else
        Result = DEFAULT_ZOOM_DEGREES
    End If

    Return Result

End Function

Sub ApplyArenaFacing()

    If DragonVisible Then
        Ready = Character3D.Rotate(Character, 0, ARIN_ARENA_ROTATION_Y, 0) And Ready
    Else
        Ready = Character3D.Rotate(Character, 0, 0, 0) And Ready
    End If

End Sub

Sub CreateDragon()

    Dim DragonReady As Boolean

    If Not DragonAvailable Then
        Return
    End If

    DragonModel = Graphics3D.LoadModel3D(DRAGON_ASSET_PATH)
    DragonReady = DragonModel.Handle <> 0
    DragonReady = DragonModel.PartCount = 1 And DragonReady

    If DragonReady Then
        Dragon = Graphics3D.CreateModelPart3D(DragonModel, 0)
        DragonReady = Dragon.Handle <> 0
    End If

    If DragonReady Then

        DragonReady = Graphics3D.SetObjectScaleChecked3D(
            Dragon,
            DRAGON_SCALE_PERCENT,
            DRAGON_SCALE_PERCENT,
            DRAGON_SCALE_PERCENT
        ) And DragonReady
        DragonReady = Graphics3D.SetObjectPositionChecked3D(
            Dragon,
            DRAGON_POSITION_X,
            0,
            DRAGON_POSITION_Z
        ) And DragonReady
        DragonReady = Graphics3D.SetObjectRotationChecked3D(
            Dragon,
            0,
            DRAGON_ROTATION_Y,
            0
        ) And DragonReady
        DragonReady = Graphics3D.SetObjectShadowsChecked3D(Dragon, True, True) And DragonReady

    End If

    If Not DragonReady Then
        Ready = False

        Call DestroyDragon()
    End If

End Sub

Function DrawDragon() As Boolean

    Dim Result As Boolean

    Result = DragonAvailable And Dragon.Handle <> 0

    If Result Then
        Result = Graphics3D.DrawObject3D(Dragon)
    End If

    Return Result

End Function

Sub DestroyDragon()

    Call Graphics3D.DestroyObject3D(Dragon)
    Call Graphics3D.DestroyModel3D(DragonModel)

End Sub

Sub CreateStudioGrid()

    Dim EmptyTexture As Core.Texture3D
    Dim HorizontalHalfCount As Number
    Dim VerticalHalfCount As Number
    Dim Index As Number
    Dim Position As Number
    Dim MeshHandle As Number
    Dim LineIndex As Number
    Dim VertexIndex As Number
    Dim TriangleIndex As Number
    Dim Width As Number
    Dim Depth As Number
    Dim GridReady As Boolean

    GridReady = True
    HorizontalHalfCount = Min(24, ViewerFloorDepth() / 40)
    VerticalHalfCount = Min(24, ViewerFloorWidth() / 40)
    GridLineCount = (HorizontalHalfCount * 2 + 1) + (VerticalHalfCount * 2 + 1)
    GridMaterial = Graphics3D.CreateMaterial3D(
        EmptyTexture,
        Graphics3D.MATERIAL_ALPHA_ADDITIVE,
        24,
        150,
        255,
        70,
        True,
        100,
        50
    )
    GridReady = GridMaterial.Handle <> 0 And GridReady

    If GridMaterial.Handle = 0 Then
        Ready = False
        Return
    End If

    MeshHandle = Graphics3D.CreateMesh3D(GridLineCount * 4, GridLineCount * 6)
    Grid.MeshHandle = MeshHandle

    If MeshHandle = 0 Then

        Ready = False

        Call DestroyStudioGrid()

        Return

    End If

    Width = ViewerFloorWidth() / 2
    Depth = ViewerFloorDepth() / 2
    LineIndex = 0

    For Index = 0 To HorizontalHalfCount * 2

        Position = (Index - HorizontalHalfCount) * 20
        VertexIndex = LineIndex * 4
        TriangleIndex = LineIndex * 2
        GridReady = SetGridQuad(MeshHandle, VertexIndex, TriangleIndex,
            0 - Width, Position, Width, Position + 1) And GridReady
        LineIndex = LineIndex + 1
    End For

    For Index = 0 To VerticalHalfCount * 2

        Position = (Index - VerticalHalfCount) * 20
        VertexIndex = LineIndex * 4
        TriangleIndex = LineIndex * 2
        GridReady = SetGridQuad(MeshHandle, VertexIndex, TriangleIndex,
            Position, 0 - Depth, Position + 1, Depth) And GridReady
        LineIndex = LineIndex + 1
    End For

    GridReady = Graphics3D.CommitMesh3D(MeshHandle) And GridReady

    If Not GridReady Then

        Ready = False

        Call DestroyStudioGrid()

        Return

    End If

    Grid = Graphics3D.CreateObjectFromMesh3D(MeshHandle)
    GridReady = Grid.Handle <> 0 And GridReady

    If Grid.Handle = 0 Then
        Call DestroyStudioGrid()

        Return
    End If

    GridReady = Graphics3D.SetObjectMaterial3D(Grid, GridMaterial) And GridReady
    GridReady = Graphics3D.SetObjectShadowsChecked3D(Grid, False, False) And GridReady

    If Not GridReady Then
        Ready = False

        Call DestroyStudioGrid()
    End If

End Sub

Function SetGridQuad(
    MeshHandle As Number,
    VertexIndex As Number,
    TriangleIndex As Number,
    MinimumX As Number,
    MinimumZ As Number,
    MaximumX As Number,
    MaximumZ As Number
) As Boolean

    Dim Result As Boolean

    Result = Graphics3D.SetMeshVertex3D(MeshHandle, VertexIndex, MinimumX, 0, MinimumZ)
    Result = Graphics3D.SetMeshVertex3D(MeshHandle, VertexIndex + 1, MaximumX, 0, MinimumZ) And Result
    Result = Graphics3D.SetMeshVertex3D(MeshHandle, VertexIndex + 2, MaximumX, 0, MaximumZ) And Result
    Result = Graphics3D.SetMeshVertex3D(MeshHandle, VertexIndex + 3, MinimumX, 0, MaximumZ) And Result
    Result = Graphics3D.SetMeshTriangle3D(
        MeshHandle,
        TriangleIndex,
        VertexIndex,
        VertexIndex + 1,
        VertexIndex + 2
    ) And Result
    Result = Graphics3D.SetMeshTriangle3D(
        MeshHandle,
        TriangleIndex + 1,
        VertexIndex,
        VertexIndex + 2,
        VertexIndex + 3
    ) And Result

    Return Result

End Function

Function DrawStudioGrid() As Boolean

    Dim Result As Boolean

    Result = Graphics3D.DrawObject3D(Grid)
    Return Result

End Function

Sub DestroyStudioGrid()

    Call Graphics3D.DestroyObject3D(Grid)
    Call Graphics3D.DestroyMaterial3D(GridMaterial)

    GridLineCount = 0

End Sub

Sub AdvanceFrameRate()

    FrameRateElapsed = FrameRateElapsed + RawFrameMilliseconds
    FrameRateFrames = FrameRateFrames + 1

    If FrameRateElapsed >= 500 Then

        CurrentFramesPerSecond = FrameRateFrames * 1000 / FrameRateElapsed
        FrameRateElapsed = 0
        FrameRateFrames = 0

    End If

End Sub

Sub HandleKeyboard(PressedKey As Number)

    If CalibrationEditing Then
        Return
    End If

    If PressedKey = KEY_B Then

        Call CycleBackground()

    Else If PressedKey = KEY_LEFT And Key_Held(KEY_CONTROL) Then

        Call StepAnimationFrame(-1)

    Else If PressedKey = KEY_RIGHT And Key_Held(KEY_CONTROL) Then

        Call StepAnimationFrame(1)

    Else If PressedKey = KEY_LEFT And SocketGizmosVisible Then

        Call SelectPreviousSocket()

    Else If PressedKey = KEY_RIGHT And SocketGizmosVisible Then

        Call SelectNextSocket()

    Else If PressedKey = KEY_LEFT Then

        Call NudgeOrbit(-5, 0)

    Else If PressedKey = KEY_RIGHT Then

        Call NudgeOrbit(5, 0)

    Else If PressedKey = KEY_UP Then

        Call NudgeOrbit(0, -5)

    Else If PressedKey = KEY_DOWN Then

        Call NudgeOrbit(0, 5)

    Else If PressedKey = KEY_A Then

        Call NudgePan(5, 0)

    Else If PressedKey = KEY_D Then

        Call NudgePan(-5, 0)

    Else If PressedKey = KEY_W Then

        Call NudgePan(0, -5)

    Else If PressedKey = KEY_S Then

        Call NudgePan(0, 5)

    Else If PressedKey = KEY_1 And Character3D.ClipCount(Character) > 0 Then

        Call SelectClip(0)

    Else If PressedKey = KEY_2 And Character3D.ClipCount(Character) > 1 Then

        Call SelectClip(1)

    Else If PressedKey = KEY_3 And Character3D.ClipCount(Character) > 2 Then

        Call SelectClip(2)

    Else If PressedKey = KEY_ENTER Then

        If ViewerError Then
            Call RetryViewer()
        Else

            Call ResetAll()
        End If

    Else If PressedKey = KEY_O Then

        Call ToggleAutoOrbit()

    Else If PressedKey = KEY_F Then

        Call ToggleFloorAndGrid()

    Else If PressedKey = KEY_G Then

        GridVisible = Not GridVisible

    Else If PressedKey = KEY_4 Then

        Call CycleProfile()

    Else If PressedKey = KEY_TAB Then

        Call SelectClip((SelectedClip + 1) Mod Character3D.ClipCount(Character))

    Else If PressedKey = KEY_R Then

        Call PlaySelectedClip()

    End If

End Sub

Sub ToggleScenePause()

    ScenePaused = Not ScenePaused

End Sub

Sub ToggleDemo()

    DemoEnabled = Not DemoEnabled
    AnimationCycleElapsed = 0

    Call PlaySelectedClip()

End Sub

Sub CycleBackground()

    BackgroundIndex = (BackgroundIndex + 1) Mod 3

End Sub

Sub ToggleDragon()

    If DragonAvailable Then

        DragonVisible = Not DragonVisible

        Call ApplyArenaFacing()
        Call ResetView()

    End If

End Sub

Sub ToggleSword()

    If CalibrationAvailable Then
        SwordVisible = Not SwordVisible
        Ready = Character3D.SetPartVisible(
            Character,
            ARIN_SWORD_PART_INDEX,
            SwordVisible
        ) And Ready
    End If

End Sub

Sub ToggleShield()

    If CalibrationAvailable Then
        ShieldVisible = Not ShieldVisible
        Ready = Character3D.SetPartVisible(
            Character,
            ARIN_SHIELD_PART_INDEX,
            ShieldVisible
        ) And Ready
    End If

End Sub

Function BeginViewerScene() As Boolean

    Dim Result As Boolean

    If BackgroundIndex = 1 Then
        Result = Scene3D.Begin(Camera, 0, 96, 32)
    Else If BackgroundIndex = 2 Then
        Result = Scene3D.Begin(Camera, 62, 20, 96)
    Else
        Result = Scene3D.Begin(Camera, 0, 0, 0)
    End If

    Return Result

End Function

Sub ToggleFloorAndGrid()

    If FloorVisible Or GridVisible Then
        FloorVisible = False
        GridVisible = False
    Else
        FloorVisible = True
        GridVisible = True
    End If

End Sub

Sub ToggleEpicGlow()

    If EpicGlowAvailable Then

        EpicGlowVisible = Not EpicGlowVisible

        If EpicGlowVisible Then
            Call ResetEpicGlowTrails()
        End If

    End If

End Sub

Sub RecordViewerError()

    ViewerError = True

    If FirstViewerError = 0 Then

        FirstViewerError = Character3D.LastError()

        If FirstViewerError = 0 Then
            FirstViewerError = Scene3D.LastError()
        End If

    End If

    If FirstRendererError = 0 Then

        FirstRendererError = Character3D.LastRendererError()

        If FirstRendererError = 0 Then
            FirstRendererError = Scene3D.LastRendererError()
        End If

        If FirstRendererError = 0 Then
            FirstRendererError = Graphics3D.LastError()
        End If

    End If

End Sub

Sub RetryViewer()

    Call DestroyViewerResources()
    Call Character3D.Shutdown()
    Call Scene3D.Shutdown()
    Call Graphics3D.ResetRenderer3D()

    Ready = True
    ViewerError = False
    FirstViewerError = 0
    FirstRendererError = 0

    Call LoadViewer()

End Sub

Sub CycleProfile()

    Call DestroyViewerResources()

    ProfileIndex = (ProfileIndex + 1) Mod ViewerProfiles.ProfileCount()
    Ready = True
    ViewerError = False
    FirstViewerError = 0
    FirstRendererError = 0

    Call LoadViewer()

End Sub

Sub CycleMaterialInspection()

    MaterialInspection = (MaterialInspection + 1) Mod 7
    Ready = Graphics3D.SetMaterialInspection3D(MaterialInspection) And Ready

End Sub

Sub ToggleAutoOrbit()

    AutoOrbit = Not AutoOrbit
    AutoOrbitYaw1000 = CameraControls.OrbitYaw * 1000

    If AutoOrbit Then
        IdleResetElapsed = 0
        IdleResetPending = False
    Else

        Call RecordCameraInteraction()
    End If

End Sub

Sub AdvanceIdleReset()

    If IdleResetPending Then

        IdleResetElapsed = IdleResetElapsed + PresentationElapsed

        If IdleResetElapsed >= IDLE_RESET_MILLISECONDS Then
            Call RestartPresentation()
        End If

    End If

End Sub

Sub AdvanceAutoOrbit()

    If AutoOrbit Then
        Ready = CharacterViewer.AdvanceOrbitYaw1000(
            AutoOrbitYaw1000,
            CameraElapsed,
            30
        ) And Ready
        CameraControls.OrbitYaw = AutoOrbitYaw1000 / 1000
    End If

End Sub

Sub AdvanceAnimationSequence()

    Dim ClipCount As Number
    Dim CurrentAnimationTime As Number

    If Not DemoEnabled Then
        Return
    End If

    ClipCount = Character3D.ClipCount(Character)
    CurrentAnimationTime = Character3D.AnimationTime(Character)
    AnimationCycleElapsed = AnimationCycleElapsed + PresentationElapsed

    If CurrentAnimationTime < DemoPreviousAnimationTime Then
        DemoCompletedLoops = DemoCompletedLoops + 1
    End If

    DemoPreviousAnimationTime = CurrentAnimationTime

    If DemoCompletedLoops >= DemoRequiredLoops() Then
        SelectedClip = (SelectedClip + 1) Mod ClipCount

        Call PlaySelectedClip()
    End If

End Sub

Function HandleInterfacePointer() As Boolean

    Dim Blocked As Boolean
    Dim ClipCount As Number
    Dim Index As Number
    Dim Column As Number
    Dim Row As Number
    Dim PanelLeft As Number
    Dim WheelDelta As Number

    PanelLeft = StatusPanelX()

    If (TimelineScrubbing And
        Not Pointer_Held(POINTER_PRIMARY) And
        Not Pointer_Pressed(POINTER_PRIMARY)) Then
        TimelineScrubbing = False
    End If

    If Not Pointer_Inside() Then
        Return False
    End If

    If Pointer_Pressed(POINTER_SECONDARY) Then

        Call ToggleScenePause()

        Return True

    End If

    WheelDelta = Pointer_Wheel_Delta()

    If WheelDelta <> 0 Then

        If PointerInRectangle(
            PanelLeft + 76,
            Window_Height() - 142,
            CAMERA_SLIDER_WIDTH,
            CAMERA_SLIDER_HEIGHT
        ) Then

            Call AdjustHorizontalOrbit(WheelDelta)

            Return True

        Else If PointerInRectangle(
            PanelLeft + 76,
            Window_Height() - 116,
            CAMERA_SLIDER_WIDTH,
            CAMERA_SLIDER_HEIGHT
        ) Then

            Call AdjustVerticalOrbit(WheelDelta)

            Return True

        Else If PointerInRectangle(
            PanelLeft + 76,
            Window_Height() - 90,
            CAMERA_SLIDER_WIDTH,
            CAMERA_SLIDER_HEIGHT
        ) Then

            Call AdjustPreciseZoom(WheelDelta)

            Return True
        End If

    End If

    If ((Pointer_Pressed(POINTER_PRIMARY) Or Pointer_Held(POINTER_PRIMARY)) And
        PointerInRectangle(
            PanelLeft + 76,
            Window_Height() - 142,
            CAMERA_SLIDER_WIDTH,
            CAMERA_SLIDER_HEIGHT
        )) Then

        Call SetHorizontalOrbitFromPointer()

        Return True
    End If

    If ((Pointer_Pressed(POINTER_PRIMARY) Or Pointer_Held(POINTER_PRIMARY)) And
        PointerInRectangle(
            PanelLeft + 76,
            Window_Height() - 116,
            CAMERA_SLIDER_WIDTH,
            CAMERA_SLIDER_HEIGHT
        )) Then

        Call SetVerticalOrbitFromPointer()

        Return True
    End If

    If ((Pointer_Pressed(POINTER_PRIMARY) Or Pointer_Held(POINTER_PRIMARY)) And
        PointerInRectangle(
            PanelLeft + 76,
            Window_Height() - 90,
            CAMERA_SLIDER_WIDTH,
            CAMERA_SLIDER_HEIGHT
        )) Then

        Call SetZoomFromPointer()

        Return True
    End If

    If CalibrationEditing Then

        If (Pointer_Pressed(POINTER_PRIMARY) And
            PointerInRectangle(PanelLeft, 56, 108, 22)) Then

            Call ToggleDragon()

            Return True
        End If

        If PointerInRectangle(
            CALIBRATION_PANEL_X,
            CALIBRATION_PANEL_Y,
            CALIBRATION_PANEL_WIDTH,
            CALIBRATION_PANEL_HEIGHT
        ) Then

            Call HandleCalibrationPanelPointer()

            Return True
        End If

        Blocked = (Pointer_Y() < 72 Or
            Pointer_Y() >= Window_Height() - 100 Or
            (Pointer_X() >= PanelLeft And Pointer_Y() >= 82))

        Return Blocked
    End If

    If TimelineScrubbing Then

        If Pointer_Pressed(POINTER_PRIMARY) Or Pointer_Held(POINTER_PRIMARY) Then
            Call SeekFromPointer()
        End If

        If Pointer_Released(POINTER_PRIMARY) Then
            TimelineScrubbing = False
        End If

        Return True
    End If

    If PointerInRectangle(
            TIMELINE_LEFT,
            Window_Height() - 64,
            TimelineWidth(),
            TIMELINE_HEIGHT
        ) Then

        WheelDelta = Pointer_Wheel_Delta()

        If WheelDelta > 0 Then
            Call StepAnimationFrame(1)
        Else If WheelDelta < 0 Then
            Call StepAnimationFrame(-1)
        End If

        If WheelDelta <> 0 Then
            Return True
        End If

    End If

    If ViewerLayoutTooSmall() Then
        Return True
    End If

    If (CalibrationAvailable And CalibrationVisible And
        PointerInRectangle(
            CALIBRATION_PANEL_X,
            CALIBRATION_PANEL_Y,
            CALIBRATION_PANEL_WIDTH,
            CALIBRATION_PANEL_HEIGHT
        )) Then

        Call HandleCalibrationPanelPointer()

        Return True
    End If

    Blocked = (Pointer_Y() < 72 Or
        Pointer_Y() >= Window_Height() - 100 Or
        (Pointer_X() >= PanelLeft And Pointer_Y() >= 82))

    If Not Pointer_Pressed(POINTER_PRIMARY) Then
        Return Blocked
    End If

    If PointerInRectangle(TIMELINE_LEFT, Window_Height() - 96, 58, 24) Then

        If ViewerError Then
            Call RetryViewer()
        Else

            Call RestartPresentation()
        End If

    Else If PointerInRectangle(TIMELINE_LEFT + 64, Window_Height() - 96, 62, 24) Then

        Call SeekFirstAnimationFrame()

    Else If PointerInRectangle(TIMELINE_LEFT + 132, Window_Height() - 96, 54, 24) Then

        Call StepAnimationFrame(-1)

    Else If PointerInRectangle(TIMELINE_LEFT + 192, Window_Height() - 96, 54, 24) Then

        Call StepAnimationFrame(1)

    Else If PointerInRectangle(TIMELINE_LEFT + 252, Window_Height() - 96, 72, 24) Then

        Call SeekAuthoredEvent(-1)

    Else If PointerInRectangle(TIMELINE_LEFT + 330, Window_Height() - 96, 72, 24) Then

        Call SeekAuthoredEvent(1)

    Else If PointerInRectangle(
        TIMELINE_LEFT,
        Window_Height() - 64,
        TimelineWidth(),
        TIMELINE_HEIGHT
    ) Then

        TimelineScrubbing = True

        Call SeekFromPointer()

    Else If PointerInRectangle(PanelLeft, 18, 44, 34) Then

        Call CycleLighting()

    Else If PointerInRectangle(PanelLeft + 48, 18, 56, 34) Then

        Call CycleMaterialInspection()

    Else If PointerInRectangle(PanelLeft + 108, 18, 50, 34) Then

        Call CycleSocketDisplay()

    Else If PointerInRectangle(PanelLeft + 162, 18, 50, 34) Then

        Call CycleProfile()

    Else If PointerInRectangle(PanelLeft + 216, 18, 36, 34) Then

        Call ToggleEpicGlow()

    Else If PointerInRectangle(PanelLeft, 56, 72, 22) Then

        Call ToggleDragon()

    Else If PointerInRectangle(PanelLeft + 76, 56, 48, 22) Then

        Call CycleBackground()

    Else If PointerInRectangle(PanelLeft + 128, 56, 36, 22) Then

        CalibrationVisible = CalibrationAvailable And Not CalibrationVisible

    Else If PointerInRectangle(PanelLeft + 168, 56, 40, 22) Then

        Call ToggleSword()

    Else If PointerInRectangle(PanelLeft + 212, 56, 40, 22) Then

        Call ToggleShield()

    Else If PointerInRectangle(PanelLeft + 178, 330, 74, 18) Then

        Call ToggleDemo()

    Else If PointerInRectangle(PanelLeft + 172, 204, 30, 24) Then

        Call AdjustPlaybackSpeed(-25)

    Else If PointerInRectangle(PanelLeft + 208, 204, 30, 24) Then

        Call AdjustPlaybackSpeed(25)

    Else If PointerInRectangle(PanelLeft + 12, Window_Height() - 64, 52, 24) Then

        Call ResetView()

    Else If PointerInRectangle(PanelLeft + 68, Window_Height() - 64, 74, 24) Then

        Call RestartPresentation()

    Else If PointerInRectangle(PanelLeft + 146, Window_Height() - 64, 40, 24) Then

        Call ResetAll()

    Else If PointerInRectangle(PanelLeft + 190, Window_Height() - 64, 50, 24) Then

        FitLocked = Not FitLocked

        If FitLocked Then

            LastFitWidth = -1
            LastFitHeight = -1

            Call UpdateResponsiveFit()

        End If

    End If

    ClipCount = Character3D.ClipCount(Character)

    For Index = 0 To ClipCount - 1

        Column = Index Mod 2
        Row = Index / 2

        If PointerInRectangle(
            AnimationButtonX() + Column * (ANIMATION_BUTTON_WIDTH + ANIMATION_BUTTON_COLUMN_GAP),
            ANIMATION_BUTTON_Y + Row * (ANIMATION_BUTTON_HEIGHT + ANIMATION_BUTTON_ROW_GAP),
            ANIMATION_BUTTON_WIDTH,
            ANIMATION_BUTTON_HEIGHT
        ) Then
            Call SelectClip(Index)
        End If

    End For

    Return Blocked

End Function

Sub HandleCalibrationPanelPointer()

    Dim WheelDelta As Number

    WheelDelta = Pointer_Wheel_Delta()

    If WheelDelta > 0 Then
        Call AdjustCalibrationValue(1)
    Else If WheelDelta < 0 Then
        Call AdjustCalibrationValue(-1)
    End If

    If ((Pointer_Pressed(POINTER_PRIMARY) Or Pointer_Held(POINTER_PRIMARY)) And
        PointerInRectangle(
            CALIBRATION_SLIDER_X,
            CALIBRATION_SLIDER_Y,
            CALIBRATION_SLIDER_WIDTH,
            CALIBRATION_SLIDER_HEIGHT
        )) Then

        Call SetCalibrationFromPointer()
    End If

    If Not Pointer_Pressed(POINTER_PRIMARY) Then
        Return
    End If

    If PointerInRectangle(34, 128, 92, 24) Then
        CalibrationTarget = CALIBRATION_TARGET_SWORD_WRIST
        CalibrationTransform = CALIBRATION_TRANSFORM_ROTATE
    Else If PointerInRectangle(130, 128, 96, 24) Then
        CalibrationTarget = CALIBRATION_TARGET_SHIELD_WRIST
        CalibrationTransform = CALIBRATION_TRANSFORM_ROTATE
    Else If PointerInRectangle(230, 128, 76, 24) Then
        CalibrationTarget = CALIBRATION_TARGET_SWORD
    Else If PointerInRectangle(310, 128, 76, 24) Then
        CalibrationTarget = CALIBRATION_TARGET_SHIELD
    Else If PointerInRectangle(34, 158, 48, 24) Then
        CalibrationAxis = CALIBRATION_AXIS_X
    Else If PointerInRectangle(86, 158, 48, 24) Then
        CalibrationAxis = CALIBRATION_AXIS_Y
    Else If PointerInRectangle(138, 158, 48, 24) Then
        CalibrationAxis = CALIBRATION_AXIS_Z
    Else If PointerInRectangle(202, 158, 72, 24) Then
        CalibrationTransform = CALIBRATION_TRANSFORM_ROTATE
    Else If (PointerInRectangle(278, 158, 72, 24) And
        CalibrationTarget >= CALIBRATION_TARGET_SWORD) Then
        CalibrationTransform = CALIBRATION_TRANSFORM_MOVE
    Else If PointerInRectangle(354, 158, 78, 24) Then
        Call ResetCalibrationTarget()
    Else If PointerInRectangle(34, 238, 52, 24) Then
        Call AdjustCalibrationValue(-5)
    Else If PointerInRectangle(90, 238, 52, 24) Then
        Call AdjustCalibrationValue(5)
    Else If PointerInRectangle(148, 238, 100, 24) Then
        Call SaveCalibrationFrame()
    Else If PointerInRectangle(252, 238, 84, 24) Then
        Call CancelCalibrationEdit()
    Else If PointerInRectangle(340, 238, 92, 24) Then

        If CalibrationClearConfirm Then
            Call ClearSelectedClipCalibration()
        Else
            CalibrationClearConfirm = True
            CalibrationClearAllStage = 0
        End If

    Else If PointerInRectangle(340, 268, 92, 24) Then

        CalibrationClearConfirm = False

        If CalibrationClearAllStage >= 2 Then
            Call ClearAllCalibration()
        Else
            CalibrationClearAllStage = CalibrationClearAllStage + 1
        End If

    End If

End Sub

Sub UpdateCameraPointer(Blocked As Boolean)

    Dim OrbitPressed As Boolean
    Dim OrbitHeld As Boolean
    Dim OrbitReleased As Boolean
    Dim OrbitActive As Boolean
    Dim PanPressed As Boolean
    Dim PanHeld As Boolean
    Dim PanReleased As Boolean
    Dim PanActive As Boolean
    Dim WheelDelta As Number
    Dim PointerDeltaX As Number
    Dim PointerDeltaY As Number
    Dim OrbitDeltaX As Number
    Dim OrbitDeltaY As Number
    Dim PanDeltaX As Number
    Dim PanDeltaY As Number

    OrbitPressed = (Not Blocked And
        (Pointer_Pressed(POINTER_MIDDLE) Or
        (Pointer_Held(POINTER_MIDDLE) And Not CameraControls.Orbiting)))
    OrbitHeld = Pointer_Held(POINTER_MIDDLE)
    OrbitReleased = Pointer_Released(POINTER_MIDDLE)
    OrbitActive = (OrbitPressed Or
        (CameraControls.Orbiting And (OrbitHeld Or OrbitReleased)))
    PanPressed = (Not Blocked And
        (Pointer_Pressed(POINTER_PRIMARY) Or
        (Pointer_Held(POINTER_PRIMARY) And Not CameraControls.Panning)))
    PanHeld = Pointer_Held(POINTER_PRIMARY)
    PanReleased = Pointer_Released(POINTER_PRIMARY)
    PanActive = (PanPressed Or
        (CameraControls.Panning And (PanHeld Or PanReleased)))
    PointerDeltaX = Pointer_Delta_X()
    PointerDeltaY = Pointer_Delta_Y()

    If OrbitPressed Then
        OrbitPointerRemainderX = 0
        OrbitPointerRemainderY = 0
    End If

    If OrbitActive Then
        OrbitDeltaX = CharacterViewer.RetainedPointerDelta(
            OrbitPointerRemainderX,
            PointerDeltaX,
            ORBIT_POINTER_DIVISOR
        )
        OrbitDeltaY = CharacterViewer.RetainedPointerDelta(
            OrbitPointerRemainderY,
            PointerDeltaY,
            ORBIT_POINTER_DIVISOR
        )
    End If

    If PanPressed Then
        PanPointerRemainderX = 0
        PanPointerRemainderY = 0
    End If

    If PanActive Then
        PanDeltaX = CharacterViewer.RetainedPointerDelta(
            PanPointerRemainderX,
            PointerDeltaX,
            PAN_POINTER_DIVISOR
        )
        PanDeltaY = CharacterViewer.RetainedPointerDelta(
            PanPointerRemainderY,
            PointerDeltaY,
            PAN_POINTER_DIVISOR
        )
    End If

    If Not Blocked Then
        WheelDelta = Pointer_Wheel_Delta()
    End If

    If WheelDelta <> 0 Then
        Call AdjustZoomTarget(WheelDelta)
    End If

    Ready = Interaction.UpdateOrbitControls(
        CameraControls,
        OrbitPressed,
        OrbitHeld,
        OrbitReleased,
        0,
        0
    ) And Ready
    Ready = Interaction.UpdatePanZoomControls(
        CameraControls,
        PanPressed,
        PanHeld,
        PanReleased,
        0,
        0,
        0
    ) And Ready

    If OrbitActive Then

        Call RecordCameraInteraction()

        CameraControls.OrbitYaw = CameraControls.OrbitYaw + OrbitDeltaX
        CameraControls.OrbitPitch = CameraControls.OrbitPitch + OrbitDeltaY

    End If

    If PanActive Then

        Call RecordCameraInteraction()

        CameraControls.PanX = CameraControls.PanX - PanDeltaX
        CameraControls.PanY = CameraControls.PanY + PanDeltaY

    End If

    Call ClampCameraControls()

    If PanReleased Then
        PanPointerRemainderX = 0
        PanPointerRemainderY = 0
    End If

    If OrbitReleased Then
        OrbitPointerRemainderX = 0
        OrbitPointerRemainderY = 0
    End If

End Sub

Sub CreateSocketGizmos()

    Dim EmptyTexture As Core.Texture3D
    Dim Index As Number
    Dim GizmosReady As Boolean

    GizmosReady = True
    SocketGizmoCount = 4
    SelectedSocket = 0
    ShowAllSocketOrigins = False
    SocketMarkerMaterial = Graphics3D.CreateMaterial3D(
        EmptyTexture,
        Graphics3D.MATERIAL_ALPHA_ADDITIVE,
        120,
        220,
        255,
        75,
        True,
        100,
        50
    )
    GizmosReady = SocketMarkerMaterial.Handle <> 0 And GizmosReady

    If SocketMarkerMaterial.Handle <> 0 Then
        SocketMarkers = Graphics3D.CreateParticleBatch3D(
            64,
            SocketMarkerMaterial,
            Graphics3D.VFX_BILLBOARD_CAMERA,
            1,
            1
        )
        GizmosReady = SocketMarkers.Handle <> 0 And GizmosReady
    End If

    For Index = 0 To SocketGizmoCount - 1

        SocketGizmos[Index] = Graphics3D.CreateCube3D(3)
        GizmosReady = SocketGizmos[Index].Handle <> 0 And GizmosReady
        GizmosReady = Graphics3D.SetObjectShadowsChecked3D(
            SocketGizmos[Index],
            False,
            False
        ) And GizmosReady

        If Index = 0 Then
            Call Graphics3D.SetObjectColor(SocketGizmos[Index], 255, 255, 255)
        Else If Index = 1 Then
            Call Graphics3D.SetObjectColor(SocketGizmos[Index], 255, 60, 60)
        Else If Index = 2 Then
            Call Graphics3D.SetObjectColor(SocketGizmos[Index], 70, 255, 90)
        Else

            Call Graphics3D.SetObjectColor(SocketGizmos[Index], 80, 140, 255)
        End If

    End For

    If Not GizmosReady Then
        Ready = False

        Call DestroySocketGizmos()
    End If

End Sub

Sub DestroySocketGizmos()

    Dim Index As Number

    Call Graphics3D.DestroyParticleBatch3D(SocketMarkers)
    Call Graphics3D.DestroyMaterial3D(SocketMarkerMaterial)

    For Index = 0 To SocketGizmoCount - 1
        Call Graphics3D.DestroyObject3D(SocketGizmos[Index])
    End For

    SocketGizmoCount = 0
    SocketGizmosVisible = False
    ShowAllSocketOrigins = False

End Sub

Sub UpdateSocketGizmos()

    Dim SocketIndex As Number
    Dim Name As Text
    Dim PositionX1000 As Number
    Dim PositionY1000 As Number
    Dim PositionZ1000 As Number
    Dim AxisX1000 As Number
    Dim AxisY1000 As Number
    Dim AxisZ1000 As Number
    Dim AxisLength As Number
    Dim MatrixProperty As Number
    Dim Axis As Number
    Dim SocketCount As Number

    SocketCount = Character3D.SocketCount(Character)
    Name = Character3D.SocketName(Character, SelectedSocket)
    PositionX1000 = Character3D.SocketValueThousandths(
        Character,
        Name,
        Graphics3D.ANIMATOR_SOCKET_POSITION_X
    )
    PositionY1000 = Character3D.SocketValueThousandths(
        Character,
        Name,
        Graphics3D.ANIMATOR_SOCKET_POSITION_Y
    )
    PositionZ1000 = Character3D.SocketValueThousandths(
        Character,
        Name,
        Graphics3D.ANIMATOR_SOCKET_POSITION_Z
    )

    For Axis = 0 To 3

        AxisX1000 = 0
        AxisY1000 = 0
        AxisZ1000 = 0

        If Axis > 0 Then

            MatrixProperty = Graphics3D.ANIMATOR_SOCKET_MATRIX_M11 + (Axis - 1) * 3
            AxisX1000 = Character3D.SocketValueThousandths(Character, Name, MatrixProperty)
            AxisY1000 = Character3D.SocketValueThousandths(Character, Name, MatrixProperty + 1)
            AxisZ1000 = Character3D.SocketValueThousandths(Character, Name, MatrixProperty + 2)
            AxisLength = Max(1, Max(Abs(AxisX1000), Max(Abs(AxisY1000), Abs(AxisZ1000))))
            AxisX1000 = AxisX1000 * 8000 / AxisLength
            AxisY1000 = AxisY1000 * 8000 / AxisLength
            AxisZ1000 = AxisZ1000 * 8000 / AxisLength

        End If

        Call Graphics3D.SetObjectPosition(
            SocketGizmos[Axis],
            (PositionX1000 + AxisX1000) / 1000,
            (PositionY1000 + AxisY1000) / 1000,
            (PositionZ1000 + AxisZ1000) / 1000
        )
    End For

    If ShowAllSocketOrigins Then

        For SocketIndex = 0 To SocketCount - 1

            Name = Character3D.SocketName(Character, SocketIndex)
            PositionX1000 = Character3D.SocketValueThousandths(
                Character,
                Name,
                Graphics3D.ANIMATOR_SOCKET_POSITION_X
            )
            PositionY1000 = Character3D.SocketValueThousandths(
                Character,
                Name,
                Graphics3D.ANIMATOR_SOCKET_POSITION_Y
            )
            PositionZ1000 = Character3D.SocketValueThousandths(
                Character,
                Name,
                Graphics3D.ANIMATOR_SOCKET_POSITION_Z
            )
            Ready = Graphics3D.SetParticle3D(
                SocketMarkers,
                SocketIndex,
                PositionX1000 / 1000,
                PositionY1000 / 1000,
                PositionZ1000 / 1000,
                4,
                0
            ) And Ready
            Ready = Graphics3D.SetParticleColor3D(
                SocketMarkers,
                SocketIndex,
                120,
                220,
                255,
                75
            ) And Ready
        End For

        Ready = Graphics3D.CommitParticleBatch3D(SocketMarkers, SocketCount) And Ready

    End If

End Sub

Function DrawSocketGizmos() As Boolean

    Dim Result As Boolean
    Dim Index As Number

    Result = True

    For Index = 0 To SocketGizmoCount - 1
        Result = Graphics3D.DrawObject3D(SocketGizmos[Index]) And Result
    End For

    If ShowAllSocketOrigins Then
        Result = Graphics3D.DrawParticleBatch3D(SocketMarkers) And Result
    End If

    Return Result

End Function

Sub CreateEpicGlow()

    Dim EmptyTexture As Core.Texture3D
    Dim CharacterModel As Core.Model3D
    Dim CharacterAnimator As Core.Animator3D
    Dim GlowReady As Boolean

    EpicGlowAvailable = ViewerProfiles.EpicGlowAvailable(ProfileIndex)
    EpicGlowAvailable = Character3D.HasSocket(Character, "SwordBase") And EpicGlowAvailable
    EpicGlowAvailable = Character3D.HasSocket(Character, "SwordTip") And EpicGlowAvailable
    EpicGlowAvailable = Character3D.HasSocket(Character, "ShieldCenter") And EpicGlowAvailable
    EpicGlowVisible = ViewerProfiles.EpicGlowVisibleByDefault(ProfileIndex) And EpicGlowAvailable

    If Not EpicGlowAvailable Then
        Return
    End If

    EpicGlowTexture = Graphics3D.LoadTexture3D(
        "TechnicalAssets\Generation2\VfxAtlas.png",
        Graphics3D.TEXTURE_FILTER_LINEAR,
        Graphics3D.TEXTURE_WRAP_CLAMP
    )
    GlowReady = EpicGlowTexture.Handle <> 0

    If GlowReady Then
        EpicGlowMaterial = Graphics3D.CreateEffectMaterial3D(
            EmptyTexture,
            Graphics3D.MATERIAL_ALPHA_ADDITIVE,
            220
        )
        GlowReady = EpicGlowMaterial.Handle <> 0
    End If

    If GlowReady Then
        EpicGlowParticleMaterial = Graphics3D.CreateEffectMaterial3D(
            EpicGlowTexture,
            Graphics3D.MATERIAL_ALPHA_ADDITIVE,
            220
        )
        GlowReady = EpicGlowParticleMaterial.Handle <> 0
    End If

    If GlowReady Then

        CharacterModel.Handle = Character3D.ModelHandle(Character)
        CharacterAnimator.Handle = Character3D.AnimatorHandle(Character)
        SwordGlow = Graphics3D.CreateModelPart3D(CharacterModel, ARIN_SWORD_PART_INDEX)
        ShieldGlow = Graphics3D.CreateModelPart3D(CharacterModel, ARIN_SHIELD_PART_INDEX)
        GlowReady = SwordGlow.Handle <> 0 And ShieldGlow.Handle <> 0

    End If

    If GlowReady Then

        GlowReady = Graphics3D.SetObjectMaterial3D(SwordGlow, EpicGlowMaterial)
        GlowReady = Graphics3D.SetObjectAnimator3D(SwordGlow, CharacterAnimator) And GlowReady
        GlowReady = Graphics3D.SetObjectMaterial3D(ShieldGlow, EpicGlowMaterial)
        GlowReady = Graphics3D.SetObjectAnimator3D(ShieldGlow, CharacterAnimator) And GlowReady

        Call Graphics3D.SetObjectColor(SwordGlow, 210, 244, 255)
        Call Graphics3D.SetObjectOpacity(SwordGlow, 95)
        Call Graphics3D.SetObjectShadows3D(SwordGlow, False, False)
        Call Graphics3D.SetObjectColor(ShieldGlow, 255, 196, 64)
        Call Graphics3D.SetObjectOpacity(ShieldGlow, 90)
        Call Graphics3D.SetObjectShadows3D(ShieldGlow, False, False)

    End If

    If GlowReady Then
        SwordTrail = Graphics3D.CreateParticleBatch3D(
            EQUIPMENT_TRAIL_POINT_COUNT,
            EpicGlowParticleMaterial,
            Graphics3D.VFX_BILLBOARD_CAMERA,
            4,
            4
        )
        GlowReady = SwordTrail.Handle <> 0
    End If

    If GlowReady Then
        ShieldTrail = Graphics3D.CreateParticleBatch3D(
            EQUIPMENT_TRAIL_POINT_COUNT,
            EpicGlowParticleMaterial,
            Graphics3D.VFX_BILLBOARD_CAMERA,
            4,
            4
        )
        GlowReady = ShieldTrail.Handle <> 0
    End If

    If Not GlowReady Then
        Call DestroyEpicGlow()
    Else

        Call ResetEpicGlowTrails()
    End If

End Sub

Sub DestroyEpicGlow()

    Call Graphics3D.DestroyObject3D(SwordGlow)
    Call Graphics3D.DestroyParticleBatch3D(SwordTrail)
    Call Graphics3D.DestroyParticleBatch3D(ShieldTrail)
    Call Graphics3D.DestroyObject3D(ShieldGlow)
    Call Graphics3D.DestroyEffectMaterial3D(EpicGlowParticleMaterial)
    Call Graphics3D.DestroyEffectMaterial3D(EpicGlowMaterial)
    Call Graphics3D.DestroyTexture3D(EpicGlowTexture)

    EpicGlowAvailable = False
    EpicGlowVisible = False

End Sub

Function UpdateEpicGlow() As Boolean

    Dim SwordBase As Core.Vector3
    Dim SwordCenter As Core.Vector3
    Dim SwordTip As Core.Vector3
    Dim ShieldCenter As Core.Vector3
    Dim Result As Boolean

    SwordBase = Character3D.SocketPosition(Character, "SwordBase")
    SwordTip = Character3D.SocketPosition(Character, "SwordTip")
    ShieldCenter = Character3D.SocketPosition(Character, "ShieldCenter")
    SwordCenter.X = (SwordBase.X + SwordTip.X) / 2
    SwordCenter.Y = (SwordBase.Y + SwordTip.Y) / 2
    SwordCenter.Z = (SwordBase.Z + SwordTip.Z) / 2

    Call UpdateEpicGlowTrailState(SwordTip, ShieldCenter)
    Call AdvanceEpicGlowTrails(SwordTip, ShieldCenter)

    Result = UpdateEquipmentGlow(SwordGlow, SwordCenter)
    Result = UpdateEquipmentGlow(ShieldGlow, ShieldCenter) And Result
    Result = UpdateEpicGlowTrailBatches() And Result

    Return Result

End Function

Function UpdateEquipmentGlow(
    ByRef GlowObject As Core.Object3D,
    Center As Core.Vector3
) As Boolean

    Dim OutlineScale As Number
    Dim RotationY As Number
    Dim ScaleDelta As Number
    Dim PositionX As Number
    Dim PositionY As Number
    Dim PositionZ As Number
    Dim Result As Boolean

    ScaleDelta = Max(2, ViewerFrame.ScalePercent / EQUIPMENT_GLOW_SCALE_DIVISOR)
    OutlineScale = ViewerFrame.ScalePercent + ScaleDelta
    PositionX = (Center.X - ViewerFrame.PositionX) * ScaleDelta / ViewerFrame.ScalePercent
    PositionY = (Center.Y - ViewerFrame.PositionY) * ScaleDelta / ViewerFrame.ScalePercent
    PositionZ = (Center.Z - ViewerFrame.PositionZ) * ScaleDelta / ViewerFrame.ScalePercent
    PositionX = ViewerFrame.PositionX - PositionX
    PositionY = ViewerFrame.PositionY - PositionY
    PositionZ = ViewerFrame.PositionZ - PositionZ

    If DragonVisible Then
        RotationY = ARIN_ARENA_ROTATION_Y
    End If

    Result = Graphics3D.SetObjectPositionChecked3D(GlowObject, PositionX, PositionY, PositionZ)
    Result = Graphics3D.SetObjectRotationChecked3D(GlowObject, 0, RotationY, 0) And Result
    Result = Graphics3D.SetObjectScaleChecked3D(
        GlowObject,
        OutlineScale,
        OutlineScale,
        OutlineScale
    ) And Result

    Return Result

End Function

Function DrawEquipmentGlow() As Boolean

    Dim Result As Boolean

    Result = True

    If SwordVisible Then
        Result = Graphics3D.DrawObject3D(SwordGlow)
    End If

    If ShieldVisible Then
        Result = Graphics3D.DrawObject3D(ShieldGlow) And Result
    End If

    Return Result

End Function

Sub ResetEpicGlowTrails()

    Dim SwordTip As Core.Vector3
    Dim ShieldCenter As Core.Vector3

    SwordTip = Character3D.SocketPosition(Character, "SwordTip")
    ShieldCenter = Character3D.SocketPosition(Character, "ShieldCenter")

    Call SeedEpicGlowTrails(SwordTip, ShieldCenter)

    EquipmentTrailAnimationTime = Character3D.AnimationTime(Character)
    SwordTrailActive = False
    ShieldTrailActive = False

End Sub

Sub SeedEpicGlowTrails(SwordTip As Core.Vector3, ShieldCenter As Core.Vector3)

    Dim Index As Number

    For Index = 0 To EQUIPMENT_TRAIL_POINT_COUNT - 1
        SwordTrailPoints[Index] = SwordTip
        ShieldTrailPoints[Index] = ShieldCenter
    End For

    EquipmentTrailElapsed = 0

End Sub

Sub UpdateEpicGlowTrailState(SwordTip As Core.Vector3, ShieldCenter As Core.Vector3)

    Dim AnimationTime As Number
    Dim NextSwordTrailActive As Boolean
    Dim NextShieldTrailActive As Boolean

    AnimationTime = Character3D.AnimationTime(Character)
    NextSwordTrailActive = (SwordVisible And
        SelectedClipName() = "SwordAttack" And
        AnimationTime >= SWORD_TRAIL_START_MILLISECONDS And
        AnimationTime <= SWORD_TRAIL_END_MILLISECONDS)
    NextShieldTrailActive = (ShieldVisible And
        SelectedClipName() = "BlockImpact" And
        AnimationTime >= SHIELD_TRAIL_START_MILLISECONDS And
        AnimationTime <= SHIELD_TRAIL_END_MILLISECONDS)

    If ((NextSwordTrailActive And Not SwordTrailActive) Or
        (NextShieldTrailActive And Not ShieldTrailActive) Or
        AnimationTime < EquipmentTrailAnimationTime) Then
        Call SeedEpicGlowTrails(SwordTip, ShieldCenter)
    End If

    SwordTrailActive = NextSwordTrailActive
    ShieldTrailActive = NextShieldTrailActive
    EquipmentTrailAnimationTime = AnimationTime

End Sub

Sub AdvanceEpicGlowTrails(SwordTip As Core.Vector3, ShieldCenter As Core.Vector3)

    Dim Index As Number

    If Not SwordTrailActive And Not ShieldTrailActive Then
        Return
    End If

    EquipmentTrailElapsed = EquipmentTrailElapsed + AnimationUpdateElapsed

    If EquipmentTrailElapsed < EQUIPMENT_TRAIL_SAMPLE_MILLISECONDS Then
        Return
    End If

    For Index = 0 To EQUIPMENT_TRAIL_POINT_COUNT - 2
        SwordTrailPoints[Index] = SwordTrailPoints[Index + 1]
        ShieldTrailPoints[Index] = ShieldTrailPoints[Index + 1]
    End For

    SwordTrailPoints[EQUIPMENT_TRAIL_POINT_COUNT - 1] = SwordTip
    ShieldTrailPoints[EQUIPMENT_TRAIL_POINT_COUNT - 1] = ShieldCenter
    EquipmentTrailElapsed = EquipmentTrailElapsed Mod EQUIPMENT_TRAIL_SAMPLE_MILLISECONDS

End Sub

Function UpdateEpicGlowTrailBatches() As Boolean

    Dim ParticleSize As Number
    Dim Opacity As Number
    Dim Index As Number
    Dim Result As Boolean

    Result = True

    For Index = 0 To EQUIPMENT_TRAIL_POINT_COUNT - 1

        Opacity = Index * 7
        ParticleSize = Max(1, SWORD_TRAIL_PARTICLE_SIZE - 1 + Index / 2)
        Result = Graphics3D.SetParticle3D(
            SwordTrail,
            Index,
            SwordTrailPoints[Index].X,
            SwordTrailPoints[Index].Y,
            SwordTrailPoints[Index].Z,
            ParticleSize,
            0,
            4 + Index Mod 4
        ) And Result
        Result = Graphics3D.SetParticleColor3D(
            SwordTrail,
            Index,
            72,
            196,
            255,
            Opacity
        ) And Result
        ParticleSize = Max(1, SHIELD_TRAIL_PARTICLE_SIZE - 1 + Index / 2)
        Result = Graphics3D.SetParticle3D(
            ShieldTrail,
            Index,
            ShieldTrailPoints[Index].X,
            ShieldTrailPoints[Index].Y,
            ShieldTrailPoints[Index].Z,
            ParticleSize,
            0,
            Index Mod 4
        ) And Result
        Result = Graphics3D.SetParticleColor3D(
            ShieldTrail,
            Index,
            255,
            196,
            64,
            Opacity * 3 / 4
        ) And Result
    End For

    If SwordTrailActive Then
        Result = Graphics3D.CommitParticleBatch3D(
            SwordTrail,
            EQUIPMENT_TRAIL_POINT_COUNT
        ) And Result
    Else
        Result = Graphics3D.CommitParticleBatch3D(SwordTrail, 0) And Result
    End If

    If ShieldTrailActive Then
        Result = Graphics3D.CommitParticleBatch3D(
            ShieldTrail,
            EQUIPMENT_TRAIL_POINT_COUNT
        ) And Result
    Else
        Result = Graphics3D.CommitParticleBatch3D(ShieldTrail, 0) And Result
    End If

    Return Result

End Function

Function DrawEpicGlow() As Boolean

    Dim Result As Boolean

    Result = True

    If SwordVisible Then
        Result = Graphics3D.DrawParticleBatch3D(SwordTrail)
    End If

    If ShieldVisible Then
        Result = Graphics3D.DrawParticleBatch3D(ShieldTrail) And Result
    End If

    Return Result

End Function

Sub CycleSocketDisplay()

    If Not SocketGizmosVisible Then
        SocketGizmosVisible = True
        ShowAllSocketOrigins = False
    Else If Not ShowAllSocketOrigins Then
        ShowAllSocketOrigins = True
    Else
        SocketGizmosVisible = False
        ShowAllSocketOrigins = False
    End If

End Sub

Sub SelectPreviousSocket()

    Dim SocketCount As Number

    SocketCount = Character3D.SocketCount(Character)
    SelectedSocket = (SelectedSocket + SocketCount - 1) Mod SocketCount

End Sub

Sub SelectNextSocket()

    SelectedSocket = (SelectedSocket + 1) Mod Character3D.SocketCount(Character)

End Sub

Sub AdjustPlaybackSpeed(Amount As Number)

    PlaybackSpeed = Min(ActiveProfile.MaximumPlaybackSpeed,
        Max(ActiveProfile.MinimumPlaybackSpeed, PlaybackSpeed + Amount))

    Call PlaySelectedClip()

End Sub

Sub ClampCameraControls()

    CameraControls.PanX = Min(ViewerFrame.PanXLimit,
        Max(0 - ViewerFrame.PanXLimit, CameraControls.PanX))
    CameraControls.PanY = Min(ViewerFrame.PanYLimit,
        Max(0 - ViewerFrame.PanYLimit, CameraControls.PanY))

End Sub

Sub NudgeOrbit(DeltaX As Number, DeltaY As Number)

    Call RecordCameraInteraction()

    Ready = Interaction.UpdateOrbitControls(
        CameraControls,
        True,
        True,
        True,
        DeltaX,
        DeltaY
    ) And Ready

    Call ClampCameraControls()

End Sub

Sub NudgePan(DeltaX As Number, DeltaY As Number)

    Call RecordCameraInteraction()

    Ready = Interaction.UpdatePanZoomControls(
        CameraControls,
        True,
        True,
        True,
        DeltaX,
        DeltaY,
        0
    ) And Ready

    Call ClampCameraControls()

End Sub

Sub NudgeZoom(WheelDelta As Number)

    Call AdjustZoomTarget(WheelDelta)

End Sub

Sub AdjustZoomTarget(WheelDelta As Number)

    Call RecordZoomInteraction()

    Call CharacterViewer.AdjustZoomTarget(SmoothZoom, WheelDelta, 8)

End Sub

Sub AdvanceSmoothZoom()

    Ready = CharacterViewer.AdvanceZoom(SmoothZoom, CameraElapsed) And Ready
    CameraControls.Zoom = CharacterViewer.ZoomDegrees(SmoothZoom)

End Sub

Sub UpdateResponsiveFit()

    If Not FitLocked Then
        Return
    End If

    If Window_Width() = LastFitWidth And Window_Height() = LastFitHeight Then
        Return
    End If

    LastFitWidth = Window_Width()
    LastFitHeight = Window_Height()
    ViewerFrame = CharacterViewer.AutoFit(
        ActiveProfile,
        LocalCharacterBounds,
        Max(1, Window_Width() - 284),
        Max(1, Window_Height()),
        BaseCamera.FovDegrees + CharacterViewer.ZoomDegrees(SmoothZoom)
    )
    BaseCamera.Position.Y = ViewerFrame.CameraY
    BaseCamera.Position.Z = ViewerFrame.CameraZ
    BaseCamera.Target.Y = ViewerFrame.TargetY

End Sub

Sub RestartPresentation()

    Call ResetView()

    AutoOrbit = True
    AutoOrbitYaw1000 = CameraControls.OrbitYaw * 1000
    IdleResetElapsed = 0
    IdleResetPending = False
    AnimationCycleElapsed = 0
    DemoEnabled = True
    SelectedClip = 0

    Call PlaySelectedClip()

End Sub

Sub ResetView()

    Call Interaction.ResetCameraControls(CameraControls)

    CameraControls.OrbitYaw = InitialViewerOrbitYaw()
    PanPointerRemainderX = 0
    PanPointerRemainderY = 0
    OrbitPointerRemainderX = 0
    OrbitPointerRemainderY = 0

    Call CharacterViewer.InitializeZoom(
        SmoothZoom,
        DefaultZoomDegrees(),
        ZOOM_IN_LIMIT,
        ZOOM_OUT_LIMIT,
        96000
    )

End Sub

Sub ResetAll()

    PlaybackSpeed = ActiveProfile.DefaultPlaybackSpeed
    LightingIndex = 0
    MaterialInspection = Graphics3D.MATERIAL_INSPECTION_LIT
    SocketGizmosVisible = False
    ShowAllSocketOrigins = False
    FloorVisible = True
    GridVisible = True
    EpicGlowVisible = ViewerProfiles.EpicGlowVisibleByDefault(ProfileIndex) And EpicGlowAvailable
    DragonVisible = DragonAvailable
    SwordVisible = True
    ShieldVisible = True

    Call ApplyLighting()
    Call ApplyArenaFacing()

    If CalibrationAvailable Then
        Ready = Character3D.SetPartVisible(Character, ARIN_SWORD_PART_INDEX, True) And Ready
        Ready = Character3D.SetPartVisible(Character, ARIN_SHIELD_PART_INDEX, True) And Ready
    End If

    Ready = Graphics3D.SetMaterialInspection3D(MaterialInspection) And Ready

    Call RestartPresentation()

End Sub

Sub RecordCameraInteraction()

    AutoOrbit = False
    IdleResetElapsed = 0
    IdleResetPending = True

End Sub

Sub RecordZoomInteraction()

    If IdleResetPending Then
        IdleResetElapsed = 0
    End If

End Sub

Sub SelectClip(Index As Number)

    SelectedClip = Index
    AnimationCycleElapsed = 0
    DemoEnabled = False
    CalibrationClearConfirm = False
    CalibrationClearAllStage = 0

    Call PlaySelectedClip()

End Sub

Sub StepAnimationFrame(Direction As Number)

    Dim SampleRate As Number
    Dim StepMilliseconds As Number
    Dim TargetTime As Number

    SampleRate = Character3D.ClipSampleRate(Character, SelectedClip)
    StepMilliseconds = Max(1, 1000 / Max(1, SampleRate))
    TargetTime = Character3D.AnimationTime(Character) + Direction * StepMilliseconds
    TargetTime = Max(0, Min(Character3D.ClipDuration(Character, SelectedClip), TargetTime))
    Ready = Character3D.SetAnimationTime(Character, TargetTime) And Ready

End Sub

Sub SeekFirstAnimationFrame()

    SelectedTimelineEvent = FirstClipEvent()
    Ready = Character3D.SetAnimationTime(Character, 0) And Ready

End Sub

Sub SeekAuthoredEvent(Direction As Number)

    Dim CandidateIndex As Number
    Dim CandidateTime As Number
    Dim CurrentAnimationTime As Number
    Dim Duration As Number
    Dim EventIndex As Number
    Dim EventTime As Number

    CurrentAnimationTime = Character3D.AnimationTime(Character)
    Duration = Character3D.ClipDuration(Character, SelectedClip)

    If Direction < 0 Then
        CandidateTime = -1
    Else
        CandidateTime = Duration + 1
    End If

    CandidateIndex = 0

    For EventIndex = 1 To Character3D.EventCount(Character)

        If Character3D.EventClipIndex(Character, EventIndex) = SelectedClip Then

            EventTime = Character3D.EventTime(Character, EventIndex)

            If Direction < 0 And EventTime < CurrentAnimationTime Then

                If EventTime > CandidateTime Then
                    CandidateTime = EventTime
                    CandidateIndex = EventIndex
                End If

            Else If Direction > 0 And EventTime > CurrentAnimationTime Then

                If EventTime < CandidateTime Then
                    CandidateTime = EventTime
                    CandidateIndex = EventIndex
                End If

            End If

        End If

    End For

    If CandidateTime < 0 Then
        CandidateTime = 0
        CandidateIndex = 0
    Else If CandidateTime > Duration Then
        CandidateTime = Duration
        CandidateIndex = 0
    End If

    SelectedTimelineEvent = CandidateIndex
    Ready = Character3D.SetAnimationTime(Character, CandidateTime) And Ready

End Sub

Sub SeekFromPointer()

    Dim Duration As Number
    Dim TargetTime As Number

    Duration = Character3D.ClipDuration(Character, SelectedClip)
    TargetTime = (Pointer_X() - TIMELINE_LEFT) * Duration / Max(1, TimelineWidth())
    TargetTime = Max(0, Min(Duration, TargetTime))
    SelectedTimelineEvent = NearestClipEvent(TargetTime)
    Ready = Character3D.SetAnimationTime(Character, TargetTime) And Ready

End Sub

Sub SetHorizontalOrbitFromPointer()

    Dim Value As Number

    Value = ((Pointer_X() - StatusPanelX() - 76) * 360 / CAMERA_SLIDER_WIDTH) - 180
    CameraControls.OrbitYaw = Min(180, Max(-180, Value))
    AutoOrbit = False
    IdleResetPending = False

End Sub

Sub AdjustHorizontalOrbit(Amount As Number)

    CameraControls.OrbitYaw = Min(180, Max(-180, CameraControls.OrbitYaw + Amount))
    AutoOrbit = False
    IdleResetPending = False

End Sub

Sub SetVerticalOrbitFromPointer()

    Dim Value As Number

    Value = ((Pointer_X() - StatusPanelX() - 76) * 360 / CAMERA_SLIDER_WIDTH) - 180
    CameraControls.OrbitPitch = Min(180, Max(-180, Value))
    AutoOrbit = False
    IdleResetPending = False

End Sub

Sub AdjustVerticalOrbit(Amount As Number)

    CameraControls.OrbitPitch = Min(180, Max(-180, CameraControls.OrbitPitch + Amount))
    AutoOrbit = False
    IdleResetPending = False

End Sub

Sub SetZoomFromPointer()

    Dim Value As Number

    Value = ((Pointer_X() - StatusPanelX() - 76) *
        (ZOOM_OUT_LIMIT - ZOOM_IN_LIMIT) /
        CAMERA_SLIDER_WIDTH) + ZOOM_IN_LIMIT
    Value = Min(ZOOM_OUT_LIMIT, Max(ZOOM_IN_LIMIT, Value))
    SmoothZoom.Current1000 = Value * 1000
    SmoothZoom.Target1000 = SmoothZoom.Current1000
    SmoothZoom.AdvanceRemainder = 0
    CameraControls.Zoom = Value

End Sub

Sub AdjustPreciseZoom(WheelDelta As Number)

    Dim Value As Number

    Value = CharacterViewer.ZoomTargetDegrees(SmoothZoom) - WheelDelta
    Value = Min(ZOOM_OUT_LIMIT, Max(ZOOM_IN_LIMIT, Value))
    SmoothZoom.Current1000 = Value * 1000
    SmoothZoom.Target1000 = SmoothZoom.Current1000
    SmoothZoom.AdvanceRemainder = 0
    CameraControls.Zoom = Value

End Sub

Sub CycleLighting()

    LightingIndex = (LightingIndex + 1) Mod 4

    Call ApplyLighting()

End Sub

Sub ApplyLighting()

    If LightingIndex = 0 Then

        Ready = Graphics3D.ClearAdditionalLights3DChecked() And Ready
        Ready = Graphics3D.SetAmbientLight3D(255, 255, 255, 68) And Ready
        Ready = Graphics3D.SetDirectionalLight3D(-35, -80, 25, 255, 248, 235, 220) And Ready
        Ready = Graphics3D.SetPointLight3D(0, -80, 120, -30, 170, 205, 255, 260, 360) And Ready
        Ready = Graphics3D.SetPointLight3D(1, 80, 80, 0, 255, 205, 145, 180, 300) And Ready

        Call Scene3D.UseCustomLighting()

    Else If LightingIndex = 1 Then

        Ready = Scene3D.UseLighting("CharacterStudio") And Ready

    Else If LightingIndex = 2 Then

        Ready = Scene3D.UseLighting("Daylight") And Ready

    Else
        Ready = Scene3D.UseLighting("Moonlight") And Ready

    End If

End Sub

Sub ConfigureCalibration()

    Dim Index As Number
    Dim Name As Text

    SwordWristNode = -1
    ShieldWristNode = -1

    For Index = 0 To Character3D.SocketCount(Character) - 1

        Name = Character3D.SocketName(Character, Index)

        If Name = "HandRight" Then
            SwordWristNode = Character3D.SocketNodeIndex(Character, Index)
        Else If Name = "HandLeft" Then
            ShieldWristNode = Character3D.SocketNodeIndex(Character, Index)
        End If

    End For

    CalibrationAvailable = (ProfileIndex = ViewerProfiles.PROFILE_ARIN And
        Character3D.PartCount(Character) > ARIN_SWORD_PART_INDEX And
        SwordWristNode >= 0 And
        ShieldWristNode >= 0)
    CalibrationVisible = CalibrationAvailable
    CalibrationTarget = CALIBRATION_TARGET_SWORD_WRIST
    CalibrationAxis = CALIBRATION_AXIS_X
    CalibrationTransform = CALIBRATION_TRANSFORM_ROTATE
    CalibrationSaved = False
    CalibrationEditing = False
    CalibrationClearConfirm = False
    CalibrationClearAllStage = 0
    CalibrationSaveLimitReached = False

    Call ClearCalibrationMemory()

    If CalibrationAvailable Then
        Call LoadSavedCalibration()
    End If

End Sub

Sub LoadSavedCalibration()

    Dim LoadedCount As Number
    Dim SavedValue As Number
    Dim StorageVersion As Number

    Load Data "CharacterViewerCalibrationKeyframes" Into CalibrationStorage Count LoadedCount

    If LoadedCount > 0 Then

        If DecodeCalibrationStorage(LoadedCount) Then
            Return
        End If

        Call ClearCalibrationMemory()

        Return
    End If

    Load StorageVersion From "CharacterViewerCalibrationVersion" Default 0

    If StorageVersion <> 2 Then
        Return
    End If

    Load CalibrationSavedClip From "CharacterViewerCalibrationClip" Default 0
    Load CalibrationSavedTime From "CharacterViewerCalibrationTime" Default 0
    Load CalibrationSavedFrame From "CharacterViewerCalibrationFrame" Default 0

    If CalibrationSavedClip < 0 Or CalibrationSavedClip >= Character3D.ClipCount(Character) Then
        Return
    End If

    Load SavedValue From "CharacterViewerSwordWristX" Default 0
    SwordWristCalibration[CalibrationSavedClip, CALIBRATION_AXIS_X] = SavedValue
    Load SavedValue From "CharacterViewerSwordWristY" Default 0
    SwordWristCalibration[CalibrationSavedClip, CALIBRATION_AXIS_Y] = SavedValue
    Load SavedValue From "CharacterViewerSwordWristZ" Default 0
    SwordWristCalibration[CalibrationSavedClip, CALIBRATION_AXIS_Z] = SavedValue
    Load SavedValue From "CharacterViewerShieldWristX" Default 0
    ShieldWristCalibration[CalibrationSavedClip, CALIBRATION_AXIS_X] = SavedValue
    Load SavedValue From "CharacterViewerShieldWristY" Default 0
    ShieldWristCalibration[CalibrationSavedClip, CALIBRATION_AXIS_Y] = SavedValue
    Load SavedValue From "CharacterViewerShieldWristZ" Default 0
    ShieldWristCalibration[CalibrationSavedClip, CALIBRATION_AXIS_Z] = SavedValue
    Load SavedValue From "CharacterViewerSwordX" Default 0
    SwordCalibration[CalibrationSavedClip, CALIBRATION_AXIS_X] = SavedValue
    Load SavedValue From "CharacterViewerSwordY" Default 0
    SwordCalibration[CalibrationSavedClip, CALIBRATION_AXIS_Y] = SavedValue
    Load SavedValue From "CharacterViewerSwordZ" Default 0
    SwordCalibration[CalibrationSavedClip, CALIBRATION_AXIS_Z] = SavedValue
    Load SavedValue From "CharacterViewerShieldX" Default 0
    ShieldCalibration[CalibrationSavedClip, CALIBRATION_AXIS_X] = SavedValue
    Load SavedValue From "CharacterViewerShieldY" Default 0
    ShieldCalibration[CalibrationSavedClip, CALIBRATION_AXIS_Y] = SavedValue
    Load SavedValue From "CharacterViewerShieldZ" Default 0
    ShieldCalibration[CalibrationSavedClip, CALIBRATION_AXIS_Z] = SavedValue
    Load SavedValue From "CharacterViewerSwordPositionX" Default 0
    SwordPositionCalibration[CalibrationSavedClip, CALIBRATION_AXIS_X] = SavedValue
    Load SavedValue From "CharacterViewerSwordPositionY" Default 0
    SwordPositionCalibration[CalibrationSavedClip, CALIBRATION_AXIS_Y] = SavedValue
    Load SavedValue From "CharacterViewerSwordPositionZ" Default 0
    SwordPositionCalibration[CalibrationSavedClip, CALIBRATION_AXIS_Z] = SavedValue
    Load SavedValue From "CharacterViewerShieldPositionX" Default 0
    ShieldPositionCalibration[CalibrationSavedClip, CALIBRATION_AXIS_X] = SavedValue
    Load SavedValue From "CharacterViewerShieldPositionY" Default 0
    ShieldPositionCalibration[CalibrationSavedClip, CALIBRATION_AXIS_Y] = SavedValue
    Load SavedValue From "CharacterViewerShieldPositionZ" Default 0
    ShieldPositionCalibration[CalibrationSavedClip, CALIBRATION_AXIS_Z] = SavedValue
    CalibrationSaved = True

    If Not StoreCalibrationKeyframe(CalibrationSavedClip, CalibrationSavedFrame) Then
        Return
    End If

    Call SaveCalibrationKeyframes()

End Sub

Sub ClearCalibrationMemory()

    Dim Axis As Number
    Dim Clip As Number

    For Clip = 0 To CALIBRATION_MAX_CLIPS - 1

        CalibrationKeyframeCounts[Clip] = 0

        For Axis = 0 To CALIBRATION_AXIS_COUNT - 1
            SwordWristCalibration[Clip, Axis] = 0
            ShieldWristCalibration[Clip, Axis] = 0
            SwordCalibration[Clip, Axis] = 0
            ShieldCalibration[Clip, Axis] = 0
            SwordPositionCalibration[Clip, Axis] = 0
            ShieldPositionCalibration[Clip, Axis] = 0
        End For

    End For

    CalibrationSaved = False
    CalibrationSavedClip = 0
    CalibrationSavedTime = 0
    CalibrationSavedFrame = 0

End Sub

Function DecodeCalibrationStorage(LoadedCount As Number) As Boolean

    Dim Channel As Number
    Dim Clip As Number
    Dim EncodedValue As Number
    Dim FrameValue As Number
    Dim Index As Number
    Dim Keyframe As Number
    Dim KeyframeCount As Number
    Dim Result As Boolean
    Dim StoredClipCount As Number

    Result = False

    If LoadedCount < 10 Then
        Return False
    End If

    If (CalibrationStorage[0] <> 83 Or
        CalibrationStorage[1] <> 77 Or
        CalibrationStorage[2] <> 75 Or
        CalibrationStorage[3] <> 70 Or
        CalibrationStorage[4] <> CALIBRATION_STORAGE_VERSION) Then
        Return False
    End If

    StoredClipCount = CalibrationStorage[5]

    If (StoredClipCount < 0 Or
        StoredClipCount > CALIBRATION_MAX_CLIPS Or
        StoredClipCount > Character3D.ClipCount(Character)) Then
        Return False
    End If

    CalibrationSaved = CalibrationStorage[6] <> 0
    CalibrationSavedClip = CalibrationStorage[7]
    CalibrationSavedFrame = CalibrationStorage[8] + CalibrationStorage[9] * 256
    Index = 10

    For Clip = 0 To StoredClipCount - 1

        If Index + 1 >= LoadedCount Then
            Return False
        End If

        KeyframeCount = CalibrationStorage[Index] + CalibrationStorage[Index + 1] * 256
        Index = Index + 2

        If (KeyframeCount < 0 Or
            KeyframeCount > CALIBRATION_MAX_KEYFRAMES Or
            Index + KeyframeCount * (2 + CALIBRATION_CHANNEL_COUNT * 2) > LoadedCount) Then
            Return False
        End If

        CalibrationKeyframeCounts[Clip] = KeyframeCount

        For Keyframe = 0 To KeyframeCount - 1

            FrameValue = CalibrationStorage[Index] + CalibrationStorage[Index + 1] * 256
            Index = Index + 2

            If (Keyframe > 0 And
                FrameValue <= CalibrationKeyframeFrames[Clip, Keyframe - 1]) Then
                Return False
            End If

            CalibrationKeyframeFrames[Clip, Keyframe] = FrameValue

            For Channel = 0 To CALIBRATION_CHANNEL_COUNT - 1
                EncodedValue = CalibrationStorage[Index] + CalibrationStorage[Index + 1] * 256
                Index = Index + 2

                If EncodedValue < 0 Or EncodedValue > 360 Then
                    Return False
                End If

                CalibrationKeyframeValues[Clip, Keyframe * CALIBRATION_CHANNEL_COUNT + Channel] = EncodedValue - 180
            End For

        End For

    End For

    If Index <> LoadedCount Then
        Return False
    End If

    If (Not CalibrationSaved Or
        CalibrationSavedClip < 0 Or
        CalibrationSavedClip >= StoredClipCount Or
        CalibrationKeyframeIndex(CalibrationSavedClip, CalibrationSavedFrame) < 0) Then
        Call RefreshCalibrationSavedStatus()
    Else
        CalibrationSavedTime = CalibrationFrameTimeMilliseconds(
            CalibrationSavedClip,
            CalibrationSavedFrame
        )
    End If

    Result = True

    Return Result

End Function

Sub SaveCalibrationKeyframes()

    Dim Channel As Number
    Dim Clip As Number
    Dim EncodedValue As Number
    Dim FrameValue As Number
    Dim Keyframe As Number
    Dim KeyframeCount As Number
    Dim StorageCount As Number
    Dim StorageVersion As Number

    CalibrationStorage[0] = 83
    CalibrationStorage[1] = 77
    CalibrationStorage[2] = 75
    CalibrationStorage[3] = 70
    CalibrationStorage[4] = CALIBRATION_STORAGE_VERSION
    CalibrationStorage[5] = Character3D.ClipCount(Character)

    If CalibrationSaved Then
        CalibrationStorage[6] = 1
    Else
        CalibrationStorage[6] = 0
    End If

    CalibrationStorage[7] = CalibrationSavedClip
    CalibrationStorage[8] = CalibrationSavedFrame Mod 256
    CalibrationStorage[9] = CalibrationSavedFrame / 256
    StorageCount = 10

    For Clip = 0 To Character3D.ClipCount(Character) - 1

        KeyframeCount = CalibrationKeyframeCounts[Clip]
        CalibrationStorage[StorageCount] = KeyframeCount Mod 256
        CalibrationStorage[StorageCount + 1] = KeyframeCount / 256
        StorageCount = StorageCount + 2

        For Keyframe = 0 To KeyframeCount - 1

            FrameValue = CalibrationKeyframeFrames[Clip, Keyframe]
            CalibrationStorage[StorageCount] = FrameValue Mod 256
            CalibrationStorage[StorageCount + 1] = FrameValue / 256
            StorageCount = StorageCount + 2

            For Channel = 0 To CALIBRATION_CHANNEL_COUNT - 1
                EncodedValue = CalibrationKeyframeValues[Clip, Keyframe * CALIBRATION_CHANNEL_COUNT + Channel] + 180
                CalibrationStorage[StorageCount] = EncodedValue Mod 256
                CalibrationStorage[StorageCount + 1] = EncodedValue / 256
                StorageCount = StorageCount + 2
            End For

        End For

    End For

    Save Data CalibrationStorage Count StorageCount To "CharacterViewerCalibrationKeyframes"

    StorageVersion = 3

    Save StorageVersion To "CharacterViewerCalibrationVersion"

End Sub

Function CalibrationKeyframeIndex(Clip As Number, FrameValue As Number) As Number

    Dim Index As Number
    Dim Result As Number

    Result = -1

    For Index = 0 To CalibrationKeyframeCounts[Clip] - 1

        If CalibrationKeyframeFrames[Clip, Index] = FrameValue Then
            Result = Index
            Exit For
        End If

    End For

    Return Result

End Function

Function StoreCalibrationKeyframe(Clip As Number, FrameValue As Number) As Boolean

    Dim Channel As Number
    Dim Index As Number
    Dim KeyCount As Number
    Dim Position As Number
    Dim Result As Boolean
    Dim Shift As Number

    KeyCount = CalibrationKeyframeCounts[Clip]
    Position = KeyCount

    For Index = 0 To KeyCount - 1

        If CalibrationKeyframeFrames[Clip, Index] >= FrameValue Then
            Position = Index
            Exit For
        End If

    End For

    If (Position < KeyCount And
        CalibrationKeyframeFrames[Clip, Position] = FrameValue) Then
        Result = True
    Else If KeyCount >= CALIBRATION_MAX_KEYFRAMES Then
        Return False
    Else

        For Shift = KeyCount Down To Position + 1

            CalibrationKeyframeFrames[Clip, Shift] = CalibrationKeyframeFrames[Clip, Shift - 1]

            For Channel = 0 To CALIBRATION_CHANNEL_COUNT - 1
                CalibrationKeyframeValues[Clip, Shift * CALIBRATION_CHANNEL_COUNT + Channel] = CalibrationKeyframeValues[Clip, (Shift - 1) * CALIBRATION_CHANNEL_COUNT + Channel]
            End For

        End For

        CalibrationKeyframeFrames[Clip, Position] = FrameValue
        CalibrationKeyframeCounts[Clip] = KeyCount + 1
        Result = True
    End If

    For Channel = 0 To CALIBRATION_CHANNEL_COUNT - 1
        CalibrationKeyframeValues[Clip, Position * CALIBRATION_CHANNEL_COUNT + Channel] = CalibrationChannelValue(Clip, Channel)
    End For

    Return Result

End Function

Sub RefreshCalibrationSavedStatus()

    Dim Clip As Number

    CalibrationSaved = False
    CalibrationSavedClip = 0
    CalibrationSavedFrame = 0
    CalibrationSavedTime = 0

    For Clip = 0 To Character3D.ClipCount(Character) - 1

        If CalibrationKeyframeCounts[Clip] > 0 And Not CalibrationSaved Then
            CalibrationSaved = True
            CalibrationSavedClip = Clip
            CalibrationSavedFrame = CalibrationKeyframeFrames[Clip, CalibrationKeyframeCounts[Clip] - 1]
            CalibrationSavedTime = CalibrationFrameTimeMilliseconds(
                CalibrationSavedClip,
                CalibrationSavedFrame
            )
        End If

    End For

End Sub

Function CalibrationChannelValue(Clip As Number, Channel As Number) As Number

    Dim Axis As Number
    Dim Result As Number

    Axis = Channel Mod CALIBRATION_AXIS_COUNT

    If Channel < 3 Then
        Result = SwordWristCalibration[Clip, Axis]
    Else If Channel < 6 Then
        Result = ShieldWristCalibration[Clip, Axis]
    Else If Channel < 9 Then
        Result = SwordCalibration[Clip, Axis]
    Else If Channel < 12 Then
        Result = ShieldCalibration[Clip, Axis]
    Else If Channel < 15 Then
        Result = SwordPositionCalibration[Clip, Axis]
    Else
        Result = ShieldPositionCalibration[Clip, Axis]
    End If

    Return Result

End Function

Sub SetCalibrationChannelValue(Clip As Number, Channel As Number, Value As Number)

    Dim Axis As Number

    Axis = Channel Mod CALIBRATION_AXIS_COUNT

    If Channel < 3 Then
        SwordWristCalibration[Clip, Axis] = Value
    Else If Channel < 6 Then
        ShieldWristCalibration[Clip, Axis] = Value
    Else If Channel < 9 Then
        SwordCalibration[Clip, Axis] = Value
    Else If Channel < 12 Then
        ShieldCalibration[Clip, Axis] = Value
    Else If Channel < 15 Then
        SwordPositionCalibration[Clip, Axis] = Value
    Else
        ShieldPositionCalibration[Clip, Axis] = Value
    End If

End Sub

Function CurrentAnimationFrame() As Number

    Dim Result As Number
    Dim SampleRate As Number

    SampleRate = Max(1, Character3D.ClipSampleRate(Character, SelectedClip))
    Result = (Character3D.AnimationTime(Character) * SampleRate + 500) / 1000
    Result = Min(Character3D.ClipSampleCount(Character, SelectedClip) - 1, Max(0, Result))

    Return Result

End Function

Function CalibrationFrameTimeMilliseconds(Clip As Number, FrameValue As Number) As Number

    Dim Result As Number
    Dim SampleRate As Number

    SampleRate = Max(1, Character3D.ClipSampleRate(Character, Clip))
    Result = (FrameValue * 1000 + SampleRate / 2) / SampleRate

    Return Result

End Function

Function InterpolateCalibrationChannel(
    Channel As Number,
    StartValue As Number,
    EndValue As Number,
    CurrentFrame As Number,
    StartFrame As Number,
    EndFrame As Number
) As Number

    Dim Delta As Number
    Dim Result As Number

    If StartFrame = EndFrame Then
        Return StartValue
    End If

    Delta = EndValue - StartValue

    If Channel < 12 Then

        If Delta > 180 Then
            Delta = Delta - 360
        Else If Delta < -180 Then
            Delta = Delta + 360
        End If

    End If

    Result = StartValue + Delta * (CurrentFrame - StartFrame) / (EndFrame - StartFrame)

    If Channel < 12 Then

        If Result > 180 Then
            Result = Result - 360
        Else If Result < -180 Then
            Result = Result + 360
        End If

    End If

    Return Result

End Function

Sub UpdateCalibrationForCurrentFrame()

    Dim Channel As Number
    Dim CurrentFrame As Number
    Dim EndFrame As Number
    Dim EndKeyframe As Number
    Dim EndValue As Number
    Dim FrameCount As Number
    Dim Index As Number
    Dim KeyCount As Number
    Dim ResultValue As Number
    Dim StartFrame As Number
    Dim StartKeyframe As Number
    Dim StartValue As Number

    If Not CalibrationAvailable Or CalibrationEditing Then
        Return
    End If

    KeyCount = CalibrationKeyframeCounts[SelectedClip]

    If KeyCount = 0 Then

        For Channel = 0 To CALIBRATION_CHANNEL_COUNT - 1
            Call SetCalibrationChannelValue(SelectedClip, Channel, 0)
        End For

        Return
    End If

    CurrentFrame = CurrentAnimationFrame()
    FrameCount = Max(1, Character3D.ClipSampleCount(Character, SelectedClip))
    StartKeyframe = 0
    EndKeyframe = 0

    If KeyCount = 1 Then
        StartKeyframe = 0
        EndKeyframe = 0
    Else If CurrentFrame < CalibrationKeyframeFrames[SelectedClip, 0] Then
        StartKeyframe = KeyCount - 1
        EndKeyframe = 0
        CurrentFrame = CurrentFrame + FrameCount
    Else If CurrentFrame > CalibrationKeyframeFrames[SelectedClip, KeyCount - 1] Then
        StartKeyframe = KeyCount - 1
        EndKeyframe = 0
    Else If CurrentFrame = CalibrationKeyframeFrames[SelectedClip, KeyCount - 1] Then
        StartKeyframe = KeyCount - 1
        EndKeyframe = KeyCount - 1
    Else If CurrentFrame > CalibrationKeyframeFrames[SelectedClip, 0] Then

        For Index = 1 To KeyCount - 1

            If CurrentFrame <= CalibrationKeyframeFrames[SelectedClip, Index] Then
                StartKeyframe = Index - 1
                EndKeyframe = Index
                Exit For
            End If

        End For

    End If

    StartFrame = CalibrationKeyframeFrames[SelectedClip, StartKeyframe]
    EndFrame = CalibrationKeyframeFrames[SelectedClip, EndKeyframe]

    If StartKeyframe = KeyCount - 1 And EndKeyframe = 0 And KeyCount > 1 Then
        EndFrame = EndFrame + FrameCount
    End If

    For Channel = 0 To CALIBRATION_CHANNEL_COUNT - 1

        StartValue = CalibrationKeyframeValues[SelectedClip, StartKeyframe * CALIBRATION_CHANNEL_COUNT + Channel]
        EndValue = CalibrationKeyframeValues[SelectedClip, EndKeyframe * CALIBRATION_CHANNEL_COUNT + Channel]
        ResultValue = InterpolateCalibrationChannel(
            Channel,
            StartValue,
            EndValue,
            CurrentFrame,
            StartFrame,
            EndFrame
        )

        Call SetCalibrationChannelValue(SelectedClip, Channel, ResultValue)

    End For

End Sub

Sub ApplyWristCalibration()

    If Not CalibrationAvailable Then
        Return
    End If

    Ready = Character3D.SetNodeRotationOffset(
        Character,
        SwordWristNode,
        SwordWristCalibration[SelectedClip, CALIBRATION_AXIS_X],
        SwordWristCalibration[SelectedClip, CALIBRATION_AXIS_Y],
        SwordWristCalibration[SelectedClip, CALIBRATION_AXIS_Z]
    ) And Ready
    Ready = Character3D.SetNodeRotationOffset(
        Character,
        ShieldWristNode,
        ShieldWristCalibration[SelectedClip, CALIBRATION_AXIS_X],
        ShieldWristCalibration[SelectedClip, CALIBRATION_AXIS_Y],
        ShieldWristCalibration[SelectedClip, CALIBRATION_AXIS_Z]
    ) And Ready

End Sub

Sub ApplyEquipmentCalibration()

    Dim GlowReady As Boolean
    Dim ShieldPivot As Core.Vector3
    Dim SwordPivot As Core.Vector3

    SwordPivot = Character3D.SocketPosition(Character, "HandRight")
    ShieldPivot = Character3D.SocketPosition(Character, "HandLeft")
    Ready = Character3D.SetPartPositionOffset(
        Character,
        ARIN_SWORD_PART_INDEX,
        SwordPositionCalibration[SelectedClip, CALIBRATION_AXIS_X],
        SwordPositionCalibration[SelectedClip, CALIBRATION_AXIS_Y],
        SwordPositionCalibration[SelectedClip, CALIBRATION_AXIS_Z]
    ) And Ready
    Ready = Character3D.SetPartPositionOffset(
        Character,
        ARIN_SHIELD_PART_INDEX,
        ShieldPositionCalibration[SelectedClip, CALIBRATION_AXIS_X],
        ShieldPositionCalibration[SelectedClip, CALIBRATION_AXIS_Y],
        ShieldPositionCalibration[SelectedClip, CALIBRATION_AXIS_Z]
    ) And Ready
    Ready = Character3D.SetPartPivotRotation(
        Character,
        ARIN_SWORD_PART_INDEX,
        SwordPivot,
        SwordCalibration[SelectedClip, CALIBRATION_AXIS_X],
        SwordCalibration[SelectedClip, CALIBRATION_AXIS_Y],
        SwordCalibration[SelectedClip, CALIBRATION_AXIS_Z]
    ) And Ready
    Ready = Character3D.SetPartPivotRotation(
        Character,
        ARIN_SHIELD_PART_INDEX,
        ShieldPivot,
        ShieldCalibration[SelectedClip, CALIBRATION_AXIS_X],
        ShieldCalibration[SelectedClip, CALIBRATION_AXIS_Y],
        ShieldCalibration[SelectedClip, CALIBRATION_AXIS_Z]
    ) And Ready

    If EpicGlowVisible Then

        GlowReady = Graphics3D.SetObjectPositionChecked3D(
            SwordGlow,
            SwordGlow.Position.X + SwordPositionCalibration[SelectedClip, CALIBRATION_AXIS_X],
            SwordGlow.Position.Y + SwordPositionCalibration[SelectedClip, CALIBRATION_AXIS_Y],
            SwordGlow.Position.Z + SwordPositionCalibration[SelectedClip, CALIBRATION_AXIS_Z]
        )
        GlowReady = Graphics3D.SetObjectPositionChecked3D(
            ShieldGlow,
            ShieldGlow.Position.X + ShieldPositionCalibration[SelectedClip, CALIBRATION_AXIS_X],
            ShieldGlow.Position.Y + ShieldPositionCalibration[SelectedClip, CALIBRATION_AXIS_Y],
            ShieldGlow.Position.Z + ShieldPositionCalibration[SelectedClip, CALIBRATION_AXIS_Z]
        ) And GlowReady

        GlowReady = Graphics3D.SetObjectPivotRotation3D(
            SwordGlow,
            SwordPivot.X,
            SwordPivot.Y,
            SwordPivot.Z,
            SwordCalibration[SelectedClip, CALIBRATION_AXIS_X],
            SwordCalibration[SelectedClip, CALIBRATION_AXIS_Y],
            SwordCalibration[SelectedClip, CALIBRATION_AXIS_Z]
        ) And GlowReady
        GlowReady = Graphics3D.SetObjectPivotRotation3D(
            ShieldGlow,
            ShieldPivot.X,
            ShieldPivot.Y,
            ShieldPivot.Z,
            ShieldCalibration[SelectedClip, CALIBRATION_AXIS_X],
            ShieldCalibration[SelectedClip, CALIBRATION_AXIS_Y],
            ShieldCalibration[SelectedClip, CALIBRATION_AXIS_Z]
        ) And GlowReady

        If Not GlowReady Then
            EpicGlowVisible = False
        End If

    End If

End Sub

Function CurrentCalibrationValue() As Number

    Dim Result As Number

    If (CalibrationTransform = CALIBRATION_TRANSFORM_MOVE And
        CalibrationTarget = CALIBRATION_TARGET_SWORD) Then
        Result = SwordPositionCalibration[SelectedClip, CalibrationAxis]
    Else If (CalibrationTransform = CALIBRATION_TRANSFORM_MOVE And
        CalibrationTarget = CALIBRATION_TARGET_SHIELD) Then
        Result = ShieldPositionCalibration[SelectedClip, CalibrationAxis]
    Else If CalibrationTarget = CALIBRATION_TARGET_SWORD_WRIST Then
        Result = SwordWristCalibration[SelectedClip, CalibrationAxis]
    Else If CalibrationTarget = CALIBRATION_TARGET_SHIELD_WRIST Then
        Result = ShieldWristCalibration[SelectedClip, CalibrationAxis]
    Else If CalibrationTarget = CALIBRATION_TARGET_SWORD Then
        Result = SwordCalibration[SelectedClip, CalibrationAxis]
    Else
        Result = ShieldCalibration[SelectedClip, CalibrationAxis]
    End If

    Return Result

End Function

Function CalibrationMinimumValue() As Number

    Dim Result As Number

    If CalibrationTransform = CALIBRATION_TRANSFORM_MOVE Then
        Result = CALIBRATION_MINIMUM_POSITION
    Else
        Result = CALIBRATION_MINIMUM_DEGREES
    End If

    Return Result

End Function

Function CalibrationMaximumValue() As Number

    Dim Result As Number

    If CalibrationTransform = CALIBRATION_TRANSFORM_MOVE Then
        Result = CALIBRATION_MAXIMUM_POSITION
    Else
        Result = CALIBRATION_MAXIMUM_DEGREES
    End If

    Return Result

End Function

Function CalibrationTransformLabel() As Text

    Dim Result As Text

    If CalibrationTransform = CALIBRATION_TRANSFORM_MOVE Then
        Result = "Move"
    Else
        Result = "Rotate"
    End If

    Return Result

End Function

Function CalibrationUnitLabel() As Text

    Dim Result As Text

    If CalibrationTransform = CALIBRATION_TRANSFORM_MOVE Then
        Result = "units"
    Else
        Result = "degrees"
    End If

    Return Result

End Function

Sub BeginCalibrationEdit()

    Dim Axis As Number

    If CalibrationEditing Then
        Return
    End If

    CalibrationEditing = True
    CalibrationClearConfirm = False
    CalibrationEditingClip = SelectedClip
    CalibrationAutoOrbitWasEnabled = AutoOrbit
    CalibrationSavedBeforeEdit = CalibrationSaved

    For Axis = 0 To CALIBRATION_AXIS_COUNT - 1
        SwordWristCalibrationBeforeEdit[Axis] = SwordWristCalibration[SelectedClip, Axis]
        ShieldWristCalibrationBeforeEdit[Axis] = ShieldWristCalibration[SelectedClip, Axis]
        SwordCalibrationBeforeEdit[Axis] = SwordCalibration[SelectedClip, Axis]
        ShieldCalibrationBeforeEdit[Axis] = ShieldCalibration[SelectedClip, Axis]
        SwordPositionCalibrationBeforeEdit[Axis] = SwordPositionCalibration[SelectedClip, Axis]
        ShieldPositionCalibrationBeforeEdit[Axis] = ShieldPositionCalibration[SelectedClip, Axis]
    End For

    AutoOrbit = False

End Sub

Sub FinishCalibrationEdit()

    If Not CalibrationEditing Then
        Return
    End If

    CalibrationEditing = False
    AutoOrbit = CalibrationAutoOrbitWasEnabled

End Sub

Sub CancelCalibrationEdit()

    Dim Axis As Number

    If Not CalibrationEditing Then
        Return
    End If

    For Axis = 0 To CALIBRATION_AXIS_COUNT - 1
        SwordWristCalibration[CalibrationEditingClip, Axis] = SwordWristCalibrationBeforeEdit[Axis]
        ShieldWristCalibration[CalibrationEditingClip, Axis] = ShieldWristCalibrationBeforeEdit[Axis]
        SwordCalibration[CalibrationEditingClip, Axis] = SwordCalibrationBeforeEdit[Axis]
        ShieldCalibration[CalibrationEditingClip, Axis] = ShieldCalibrationBeforeEdit[Axis]
        SwordPositionCalibration[CalibrationEditingClip, Axis] = SwordPositionCalibrationBeforeEdit[Axis]
        ShieldPositionCalibration[CalibrationEditingClip, Axis] = ShieldPositionCalibrationBeforeEdit[Axis]
    End For

    CalibrationSaved = CalibrationSavedBeforeEdit
    CalibrationClearConfirm = False

    Call ApplyWristCalibration()
    Call ApplyEquipmentCalibration()
    Call FinishCalibrationEdit()

End Sub

Sub SetCurrentCalibrationValue(Value As Number)

    Dim ClampedValue As Number

    Call BeginCalibrationEdit()

    If CalibrationTransform = CALIBRATION_TRANSFORM_MOVE Then

        ClampedValue = Min(CALIBRATION_MAXIMUM_POSITION,
            Max(CALIBRATION_MINIMUM_POSITION, Value))

    Else
        ClampedValue = Min(CALIBRATION_MAXIMUM_DEGREES,
            Max(CALIBRATION_MINIMUM_DEGREES, Value))
    End If

    If (CalibrationTransform = CALIBRATION_TRANSFORM_MOVE And
        CalibrationTarget = CALIBRATION_TARGET_SWORD) Then
        SwordPositionCalibration[SelectedClip, CalibrationAxis] = ClampedValue
    Else If (CalibrationTransform = CALIBRATION_TRANSFORM_MOVE And
        CalibrationTarget = CALIBRATION_TARGET_SHIELD) Then
        ShieldPositionCalibration[SelectedClip, CalibrationAxis] = ClampedValue
    Else If CalibrationTarget = CALIBRATION_TARGET_SWORD_WRIST Then
        SwordWristCalibration[SelectedClip, CalibrationAxis] = ClampedValue
    Else If CalibrationTarget = CALIBRATION_TARGET_SHIELD_WRIST Then
        ShieldWristCalibration[SelectedClip, CalibrationAxis] = ClampedValue
    Else If CalibrationTarget = CALIBRATION_TARGET_SWORD Then
        SwordCalibration[SelectedClip, CalibrationAxis] = ClampedValue
    Else
        ShieldCalibration[SelectedClip, CalibrationAxis] = ClampedValue
    End If
    CalibrationSaveLimitReached = False
    CalibrationClearConfirm = False
    AutoOrbit = False

    Call ApplyWristCalibration()
    Call ApplyEquipmentCalibration()

End Sub

Sub AdjustCalibrationValue(Amount As Number)

    Call SetCurrentCalibrationValue(CurrentCalibrationValue() + Amount)

End Sub

Sub SetCalibrationFromPointer()

    Dim MaximumValue As Number
    Dim MinimumValue As Number
    Dim Value As Number

    MinimumValue = CalibrationMinimumValue()
    MaximumValue = CalibrationMaximumValue()
    Value = ((Pointer_X() - CALIBRATION_SLIDER_X) *
        (MaximumValue - MinimumValue) /
        CALIBRATION_SLIDER_WIDTH) + MinimumValue

    Call SetCurrentCalibrationValue(Value)

End Sub

Sub ResetCalibrationTarget()

    Dim Axis As Number

    Call BeginCalibrationEdit()

    For Axis = 0 To CALIBRATION_AXIS_COUNT - 1

        If (CalibrationTransform = CALIBRATION_TRANSFORM_MOVE And
            CalibrationTarget = CALIBRATION_TARGET_SWORD) Then
            SwordPositionCalibration[SelectedClip, Axis] = 0
        Else If (CalibrationTransform = CALIBRATION_TRANSFORM_MOVE And
            CalibrationTarget = CALIBRATION_TARGET_SHIELD) Then
            ShieldPositionCalibration[SelectedClip, Axis] = 0
        Else If CalibrationTarget = CALIBRATION_TARGET_SWORD_WRIST Then
            SwordWristCalibration[SelectedClip, Axis] = 0
        Else If CalibrationTarget = CALIBRATION_TARGET_SHIELD_WRIST Then
            ShieldWristCalibration[SelectedClip, Axis] = 0
        Else If CalibrationTarget = CALIBRATION_TARGET_SWORD Then
            SwordCalibration[SelectedClip, Axis] = 0
        Else
            ShieldCalibration[SelectedClip, Axis] = 0
        End If

    End For

    CalibrationSaveLimitReached = False
    CalibrationClearConfirm = False
    AutoOrbit = False

    Call ApplyWristCalibration()
    Call ApplyEquipmentCalibration()

End Sub

Sub ClearSelectedClipCalibration()

    Dim Axis As Number

    For Axis = 0 To CALIBRATION_AXIS_COUNT - 1
        SwordWristCalibration[SelectedClip, Axis] = 0
        ShieldWristCalibration[SelectedClip, Axis] = 0
        SwordCalibration[SelectedClip, Axis] = 0
        ShieldCalibration[SelectedClip, Axis] = 0
        SwordPositionCalibration[SelectedClip, Axis] = 0
        ShieldPositionCalibration[SelectedClip, Axis] = 0
    End For

    CalibrationKeyframeCounts[SelectedClip] = 0
    CalibrationClearConfirm = False
    CalibrationSaveLimitReached = False

    Call RefreshCalibrationSavedStatus()
    Call SaveCalibrationKeyframes()

    Call ApplyWristCalibration()
    Call ApplyEquipmentCalibration()
    Call FinishCalibrationEdit()

End Sub

Sub ClearAllCalibration()

    Call ClearCalibrationMemory()

    CalibrationClearConfirm = False
    CalibrationClearAllStage = 0
    CalibrationSaveLimitReached = False

    Call SaveCalibrationKeyframes()

    Call ApplyWristCalibration()
    Call ApplyEquipmentCalibration()
    Call FinishCalibrationEdit()

End Sub

Function CalibrationResetClipLabel() As Text

    Dim Result As Text

    If CalibrationClearConfirm Then
        Result = "Confirm Clip?"
    Else
        Result = "Reset Clip"
    End If

    Return Result

End Function

Function CalibrationResetAllLabel() As Text

    Dim Result As Text

    If CalibrationClearAllStage = 1 Then
        Result = "Confirm All?"
    Else If CalibrationClearAllStage >= 2 Then
        Result = "Really Clear?"
    Else
        Result = "Reset All"
    End If

    Return Result

End Function

Sub SaveCalibrationFrame()

    Call BeginCalibrationEdit()

    CalibrationSavedClip = SelectedClip
    CalibrationSavedFrame = CurrentAnimationFrame()
    CalibrationSavedTime = CalibrationFrameTimeMilliseconds(
        CalibrationSavedClip,
        CalibrationSavedFrame
    )
    CalibrationClearConfirm = False
    CalibrationSaveLimitReached = Not StoreCalibrationKeyframe(
        CalibrationSavedClip,
        CalibrationSavedFrame
    )

    If Not CalibrationSaveLimitReached Then
        CalibrationSaved = True

        Call SaveCalibrationKeyframes()
    End If

    Call FinishCalibrationEdit()

End Sub

Sub PlaySelectedClip()

    SelectedTimelineEvent = FirstClipEvent()
    Ready = Character3D.PlayMode(
        Character,
        SelectedClipName(),
        Graphics3D.ANIMATION_LOOP,
        PlaybackSpeed
    ) And Ready
    AnimationCycleElapsed = 0
    DemoCompletedLoops = 0
    DemoPreviousAnimationTime = Character3D.AnimationTime(Character)

    Call UpdateCalibrationForCurrentFrame()
    Call ApplyWristCalibration()

    If EpicGlowAvailable Then
        Call ResetEpicGlowTrails()
    End If

End Sub

Function FirstClipEvent() As Number

    Dim EventIndex As Number
    Dim Result As Number

    Result = 0

    For EventIndex = 1 To Character3D.EventCount(Character)

        If Character3D.EventClipIndex(Character, EventIndex) = SelectedClip And Result = 0 Then
            Result = EventIndex
        End If

    End For

    Return Result

End Function

Function NearestClipEvent(TimeValue As Number) As Number

    Dim BestDistance As Number
    Dim Distance As Number
    Dim EventIndex As Number
    Dim Result As Number

    BestDistance = 2147483647
    Result = 0

    For EventIndex = 1 To Character3D.EventCount(Character)

        If Character3D.EventClipIndex(Character, EventIndex) = SelectedClip Then

            Distance = Abs(Character3D.EventTime(Character, EventIndex) - TimeValue)

            If Distance < BestDistance Then
                BestDistance = Distance
                Result = EventIndex
            End If

        End If

    End For

    Return Result

End Function

Function SelectedClipName() As Text

    Dim Result As Text

    Result = Character3D.ClipName(Character, SelectedClip)

    Return Result

End Function

Function SelectedClipLabel() As Text

    Dim Result As Text

    Result = Character3D.ClipName(Character, SelectedClip)

    Return Result

End Function

Function SelectedClipMode() As Number

    Dim Result As Number

    Result = Graphics3D.ANIMATION_LOOP

    Return Result

End Function

Function LightingLabel() As Text

    Dim Result As Text

    If LightingIndex = 0 Then
        Result = "Viewer Studio"
    Else If LightingIndex = 1 Then
        Result = "Character Studio"
    Else If LightingIndex = 2 Then
        Result = "Daylight"
    Else
        Result = "Moonlight"
    End If

    Return Result

End Function

Function PointerInRectangle(X As Number, Y As Number, Width As Number, Height As Number) As Boolean

    Dim ReturnValue As Boolean

    ReturnValue = (Pointer_X() >= X And
        Pointer_X() < X + Width And
        Pointer_Y() >= Y And
        Pointer_Y() < Y + Height)

    Return ReturnValue

End Function

Function StatusPanelX() As Number

    Dim Result As Number

    Result = Max(492, Window_Width() - 268)

    Return Result

End Function

Function AnimationButtonX() As Number

    Dim Result As Number

    Result = StatusPanelX() + 12

    Return Result

End Function

Sub DrawViewerOverlay()

    Dim PanelLeft As Number
    Dim PanelText As Number
    Dim Subtitle As Text

    PanelLeft = StatusPanelX()
    PanelText = PanelLeft + 16

    If ViewerLayoutTooSmall() Then

        Fill Rectangle 0, 0, Window_Width(), Window_Height(), Rgb(4, 9, 24) Opacity 92
        Draw Text "CHARACTER VIEWER NEEDS MORE ROOM" At 28, 40 Size 22 Color YELLOW
        Draw Text "Resize to at least 800 by 540 logical units." At 28, 78 Size 15 Color WHITE
        Draw Text "Right-click still pauses or resumes movement." At 28, 108 Size 13 Color LIGHT_GRAY
        Return

    End If

    If Window_Width() < 1100 Then
        Subtitle = ActiveProfile.DisplayName + "  •  " + PartyRoleLabel() + "  •  PBR"
    Else
        Subtitle = ActiveProfile.DisplayName + "  •  Party role: " + PartyRoleLabel() + "  •  Renderer3D PBR"
    End If

    Draw Text "SMILE 2.0 - 3D VIEWER, ANIMATION EDITOR" At 18, 10 Size 22 Color CYAN
    Draw Text Subtitle At 18, 42 Size 13 Color LIGHT_GRAY

    Call DrawButton(PanelLeft, 18, 44, 34, "LIGHT", False)
    Call DrawButton(PanelLeft + 48, 18, 56, 34, "CHANNEL", False)
    Call DrawButton(PanelLeft + 108, 18, 50, 34, "SOCKET", SocketGizmosVisible)
    Call DrawButton(PanelLeft + 162, 18, 50, 34, "PROFILE", False)
    Call DrawButton(PanelLeft + 216, 18, 36, 34, "GLOW", EpicGlowVisible)
    Call DrawButton(PanelLeft, 56, 72, 22, DragonLabel(), DragonVisible)
    Call DrawButton(PanelLeft + 76, 56, 48, 22, BackgroundLabel(), BackgroundIndex > 0)
    Call DrawButton(PanelLeft + 128, 56, 36, 22, "Pose", CalibrationVisible)
    Call DrawButton(PanelLeft + 168, 56, 40, 22, "Sword", SwordVisible)
    Call DrawButton(PanelLeft + 212, 56, 40, 22, "Shield", ShieldVisible)

    Fill Rectangle PanelLeft, 82, 252, Max(446, Window_Height() - 94), Rgb(4, 9, 24) Opacity 80
    Draw Text "CHARACTER STATUS" At PanelText, 96 Size 16 Color WHITE
    Draw Text "Name" At PanelText, 124 Size 12 Color LIGHT_GRAY
    Draw Text ActiveProfile.DisplayName At PanelLeft + 116, 124 Size 12 Color CYAN
    Draw Text "Party Role" At PanelText, 146 Size 12 Color LIGHT_GRAY
    Draw Text PartyRoleLabel() At PanelLeft + 116, 146 Size 12 Color CYAN
    Draw Text "Animation" At PanelText, 168 Size 12 Color LIGHT_GRAY
    Draw Text SelectedClipLabel() At PanelLeft + 116, 168 Size 12 Color GREEN
    Draw Text "Candidate" At PanelText, 190 Size 12 Color LIGHT_GRAY
    Draw Text ActiveProfile.CandidateVersion At PanelLeft + 116, 190 Size 11 Color YELLOW
    Draw Text "Speed" At PanelText, 216 Size 12 Color LIGHT_GRAY
    Draw Number PlaybackSpeed At PanelLeft + 116, 216 Size 12 Color WHITE

    Call DrawButton(PanelLeft + 172, 204, 30, 24, "-", False)
    Call DrawButton(PanelLeft + 208, 204, 30, 24, "+", False)

    Draw Text "Material" At PanelText, 240 Size 12 Color LIGHT_GRAY
    Draw Text MaterialInspectionLabel() At PanelLeft + 116, 240 Size 12 Color YELLOW
    Draw Text "Draws / Triangles" At PanelText, 262 Size 12 Color LIGHT_GRAY
    Draw Number Graphics3D.DrawCallCount3D() At PanelLeft + 148, 262 Size 12 Color WHITE
    Draw Number Graphics3D.SubmittedTriangleCount3D() At PanelLeft + 192, 262 Size 12 Color WHITE
    Draw Text "Demo / Next" At PanelText, 284 Size 12 Color LIGHT_GRAY
    Draw Text DemoStatusLabel() At PanelLeft + 116, 284 Size 12 Color CYAN
    Draw Number AnimationSecondsRemaining() At PanelLeft + 172, 284 Size 12 Color WHITE
    Draw Text "seconds" At PanelLeft + 192, 284 Size 11 Color LIGHT_GRAY
    Draw Text "Zoom / FPS" At PanelText, 306 Size 12 Color LIGHT_GRAY
    Draw Number CharacterViewer.ZoomDegrees(SmoothZoom) At PanelLeft + 116, 306 Size 12 Color CYAN
    Draw Text "deg" At PanelLeft + 146, 306 Size 11 Color LIGHT_GRAY
    Draw Number CurrentFramesPerSecond At PanelLeft + 190, 306 Size 12 Color GREEN
    Draw Text "fps" At PanelLeft + 216, 306 Size 11 Color LIGHT_GRAY
    Draw Text "ANIMATIONS" At PanelText, 334 Size 13 Color WHITE

    Call DrawButton(PanelLeft + 178, 330, 74, 18, DemoLabel(), DemoEnabled)

    Call DrawAnimationButtons()

    If Window_Height() >= ANIMATION_DETAILS_MINIMUM_HEIGHT Then

        Draw Text "Clip ms / Rate / Samples / Events" At PanelText, ANIMATION_DETAILS_Y Size 11 Color LIGHT_GRAY
        Draw Number Character3D.ClipDuration(Character, SelectedClip) At PanelText, ANIMATION_DETAILS_Y + 20 Size 11 Color WHITE
        Draw Number Character3D.ClipSampleRate(Character, SelectedClip) At PanelText + 58, ANIMATION_DETAILS_Y + 20 Size 11 Color CYAN
        Draw Number Character3D.ClipSampleCount(Character, SelectedClip) At PanelText + 104, ANIMATION_DETAILS_Y + 20 Size 11 Color WHITE
        Draw Number Character3D.ClipEventCount(Character, SelectedClip) At PanelText + 166, ANIMATION_DETAILS_Y + 20 Size 11 Color YELLOW
        Draw Text "Model clips / sockets / events" At PanelText, ANIMATION_DETAILS_Y + 42 Size 11 Color LIGHT_GRAY
        Draw Number Character3D.ClipCount(Character) At PanelText, ANIMATION_DETAILS_Y + 62 Size 11 Color WHITE
        Draw Number Character3D.SocketCount(Character) At PanelText + 58, ANIMATION_DETAILS_Y + 62 Size 11 Color CYAN
        Draw Number Character3D.EventCount(Character) At PanelText + 116, ANIMATION_DETAILS_Y + 62 Size 11 Color YELLOW

    End If

    Call DrawCameraControls()

    Call DrawButton(PanelLeft + 12, Window_Height() - 64, 52, 24, "VIEW", False)
    Call DrawButton(PanelLeft + 68, Window_Height() - 64, 74, 24, "PRESENT", False)
    Call DrawButton(PanelLeft + 146, Window_Height() - 64, 40, 24, "ALL", False)
    Call DrawButton(PanelLeft + 190, Window_Height() - 64, 50, 24, "FIT", FitLocked)

    Call DrawTimeline()

    If CalibrationAvailable And CalibrationVisible Then
        Call DrawCalibrationPanel()
    End If

    Draw Text "LMB pan  •  MMB orbit  •  Wheel zoom  •  RMB pause/resume  •  RESET restarts  •  DEMO cycles clips" At 16, Window_Height() - 22 Size 11 Color LIGHT_GRAY

    If CalibrationEditing Then

        If ScenePaused Then
            Draw Text "POSE EDIT ACTIVE — MOVEMENT PAUSED BY RIGHT-CLICK" At 18, 68 Size 14 Color YELLOW
        Else
            Draw Text "POSE EDIT ACTIVE — RIGHT-CLICK TO PAUSE MOVEMENT" At 18, 68 Size 14 Color YELLOW
        End If

    Else If ScenePaused Then
        Draw Text "MOVEMENT PAUSED — RIGHT-CLICK TO RESUME; CAMERA CONTROLS REMAIN ACTIVE" At 18, 68 Size 14 Color YELLOW
    End If

    If ViewerError Then

        Fill Rectangle 120, 142, 580, 190, Rgb(56, 8, 18) Opacity 80
        Draw Text "CHARACTER VIEWER RECOVERY" At 148, 166 Size 22 Color WHITE
        Draw Text "The 3D renderer or character resource became unavailable." At 148, 204 Size 14 Color LIGHT_GRAY
        Draw Text "Viewer error" At 148, 238 Size 13 Color LIGHT_GRAY
        Draw Number FirstViewerError At 270, 238 Size 13 Color YELLOW
        Draw Text "Renderer error" At 348, 238 Size 13 Color LIGHT_GRAY
        Draw Number FirstRendererError At 486, 238 Size 13 Color YELLOW
        Draw Text "Press Enter or click Reset to reload the profile safely." At 148, 280 Size 14 Color CYAN

    End If

End Sub

Sub DrawCameraControls()

    Call DrawCameraSlider(
        "H Orbit",
        Window_Height() - 142,
        CameraControls.OrbitYaw,
        -180,
        180
    )
    Call DrawCameraSlider(
        "V Orbit",
        Window_Height() - 116,
        CameraControls.OrbitPitch,
        -180,
        180
    )
    Call DrawCameraSlider(
        "Zoom",
        Window_Height() - 90,
        CharacterViewer.ZoomDegrees(SmoothZoom),
        ZOOM_IN_LIMIT,
        ZOOM_OUT_LIMIT
    )

End Sub

Sub DrawCameraSlider(
    Label As Text,
    Y As Number,
    Value As Number,
    MinimumValue As Number,
    MaximumValue As Number
)

    Dim KnobX As Number
    Dim PanelLeft As Number
    Dim ProgressWidth As Number

    PanelLeft = StatusPanelX()
    ProgressWidth = (Value - MinimumValue) * CAMERA_SLIDER_WIDTH / Max(1, MaximumValue - MinimumValue)
    ProgressWidth = Min(CAMERA_SLIDER_WIDTH, Max(0, ProgressWidth))
    KnobX = PanelLeft + 76 + ProgressWidth

    Draw Text Label At PanelLeft + 12, Y + 2 Size 11 Color LIGHT_GRAY
    Fill Rectangle PanelLeft + 76, Y, CAMERA_SLIDER_WIDTH, CAMERA_SLIDER_HEIGHT, Rgb(18, 35, 58) Opacity 95
    Fill Rectangle PanelLeft + 76, Y, ProgressWidth, CAMERA_SLIDER_HEIGHT, Rgb(16, 102, 136) Opacity 95
    Fill Rectangle KnobX - 2, Y - 2, 4, CAMERA_SLIDER_HEIGHT + 4, WHITE Opacity 100
    Draw Number Value At PanelLeft + 226, Y + 2 Size 10 Color CYAN

End Sub

Sub DrawCalibrationPanel()

    Dim CurrentFrame As Number
    Dim CurrentKeyframe As Number
    Dim KnobX As Number
    Dim MaximumValue As Number
    Dim MinimumValue As Number
    Dim ProgressWidth As Number
    Dim SliderRange As Number
    Dim Value As Number

    CurrentFrame = CurrentAnimationFrame()
    CurrentKeyframe = CalibrationKeyframeIndex(SelectedClip, CurrentFrame)
    Value = CurrentCalibrationValue()
    MinimumValue = CalibrationMinimumValue()
    MaximumValue = CalibrationMaximumValue()
    SliderRange = MaximumValue - MinimumValue
    ProgressWidth = (Value - MinimumValue) * CALIBRATION_SLIDER_WIDTH / SliderRange
    KnobX = CALIBRATION_SLIDER_X + ProgressWidth

    Fill Rectangle CALIBRATION_PANEL_X, CALIBRATION_PANEL_Y, CALIBRATION_PANEL_WIDTH, CALIBRATION_PANEL_HEIGHT, Rgb(4, 9, 24) Opacity 90
    Draw Text "Pose Calibration" At 32, 102 Size 16 Color WHITE
    Draw Text SelectedClipLabel() At 174, 104 Size 12 Color CYAN

    Call DrawButton(34, 128, 92, 24, "Sword Wrist", CalibrationTarget = CALIBRATION_TARGET_SWORD_WRIST)
    Call DrawButton(130, 128, 96, 24, "Shield Wrist", CalibrationTarget = CALIBRATION_TARGET_SHIELD_WRIST)
    Call DrawButton(230, 128, 76, 24, "Sword", CalibrationTarget = CALIBRATION_TARGET_SWORD)
    Call DrawButton(310, 128, 76, 24, "Shield", CalibrationTarget = CALIBRATION_TARGET_SHIELD)
    Call DrawButton(34, 158, 48, 24, "X", CalibrationAxis = CALIBRATION_AXIS_X)
    Call DrawButton(86, 158, 48, 24, "Y", CalibrationAxis = CALIBRATION_AXIS_Y)
    Call DrawButton(138, 158, 48, 24, "Z", CalibrationAxis = CALIBRATION_AXIS_Z)
    Call DrawButton(202, 158, 72, 24, "Rotate", CalibrationTransform = CALIBRATION_TRANSFORM_ROTATE)
    Call DrawButton(278, 158, 72, 24, "Move", CalibrationTransform = CALIBRATION_TRANSFORM_MOVE)
    Call DrawButton(354, 158, 78, 24, "Reset", False)

    Draw Text CalibrationTargetLabel() At 34, 187 Size 12 Color LIGHT_GRAY
    Draw Text CalibrationTransformLabel() At 142, 187 Size 12 Color CYAN
    Draw Text CalibrationAxisLabel() At 208, 187 Size 12 Color CYAN
    Draw Number Value At 230, 187 Size 12 Color WHITE
    Draw Text CalibrationUnitLabel() At 274, 187 Size 11 Color LIGHT_GRAY
    Fill Rectangle CALIBRATION_SLIDER_X, CALIBRATION_SLIDER_Y, CALIBRATION_SLIDER_WIDTH, CALIBRATION_SLIDER_HEIGHT, Rgb(18, 35, 58) Opacity 95
    Fill Rectangle CALIBRATION_SLIDER_X, CALIBRATION_SLIDER_Y, ProgressWidth, CALIBRATION_SLIDER_HEIGHT, Rgb(16, 102, 136) Opacity 95
    Fill Rectangle KnobX - 3, CALIBRATION_SLIDER_Y - 2, 6, CALIBRATION_SLIDER_HEIGHT + 4, WHITE Opacity 100

    Call DrawButton(34, 238, 52, 24, "-5", False)
    Call DrawButton(90, 238, 52, 24, "+5", False)
    Call DrawButton(148, 238, 100, 24, "Save Frame", CurrentKeyframe >= 0 And Not CalibrationEditing)
    Call DrawButton(252, 238, 84, 24, "Cancel", CalibrationEditing)
    Call DrawButton(340, 238, 92, 24, CalibrationResetClipLabel(), CalibrationClearConfirm)
    Call DrawButton(340, 268, 92, 24, CalibrationResetAllLabel(), CalibrationClearAllStage > 0)

    If CalibrationEditing Then

        If ScenePaused Then
            Draw Text "Editing — movement paused by RMB" At 34, 272 Size 11 Color YELLOW
        Else
            Draw Text "Editing live — RMB pauses movement" At 34, 272 Size 11 Color YELLOW
        End If

    Else
        Draw Text "Drag slider or use wheel" At 34, 272 Size 11 Color LIGHT_GRAY
    End If

    If CalibrationSaveLimitReached Then
        Draw Text "Keyframe limit reached" At 34, 290 Size 11 Color YELLOW
    Else
        Draw Text "Keys" At 34, 290 Size 11 Color LIGHT_GRAY
        Draw Number CalibrationKeyframeCounts[SelectedClip] At 68, 290 Size 11 Color CYAN
        Draw Text "Current frame" At 104, 290 Size 11 Color LIGHT_GRAY
        Draw Number CurrentFrame At 190, 290 Size 11 Color WHITE

        If CurrentKeyframe >= 0 Then
            Draw Text "KEYED" At 230, 290 Size 11 Color GREEN
        End If
    End If

End Sub

Function CalibrationTargetLabel() As Text

    Dim Result As Text

    If CalibrationTarget = CALIBRATION_TARGET_SWORD_WRIST Then
        Result = "Sword Wrist"
    Else If CalibrationTarget = CALIBRATION_TARGET_SHIELD_WRIST Then
        Result = "Shield Wrist"
    Else If CalibrationTarget = CALIBRATION_TARGET_SWORD Then
        Result = "Sword"
    Else
        Result = "Shield"
    End If

    Return Result

End Function

Function CalibrationAxisLabel() As Text

    Dim Result As Text

    If CalibrationAxis = CALIBRATION_AXIS_X Then
        Result = "X"
    Else If CalibrationAxis = CALIBRATION_AXIS_Y Then
        Result = "Y"
    Else
        Result = "Z"
    End If

    Return Result

End Function

Function TimelineWidth() As Number

    Dim Result As Number

    Result = Max(120, StatusPanelX() - TIMELINE_LEFT - 20)
    Return Result

End Function

Sub DrawTimeline()

    Dim Duration As Number
    Dim EventIndex As Number
    Dim EventTime As Number
    Dim Keyframe As Number
    Dim KeyframeTime As Number
    Dim MarkerX As Number
    Dim ProgressWidth As Number
    Dim TimelineY As Number
    Dim Width As Number

    Duration = Max(1, Character3D.ClipDuration(Character, SelectedClip))
    TimelineY = Window_Height() - 64
    Width = TimelineWidth()
    ProgressWidth = Character3D.AnimationTime(Character) * Width / Duration

    Call DrawButton(TIMELINE_LEFT, Window_Height() - 96, 58, 24, "RESET", False)
    Call DrawButton(TIMELINE_LEFT + 64, Window_Height() - 96, 62, 24, "0-FRAME", False)
    Call DrawButton(TIMELINE_LEFT + 132, Window_Height() - 96, 54, 24, "-FRAME", False)
    Call DrawButton(TIMELINE_LEFT + 192, Window_Height() - 96, 54, 24, "+FRAME", False)
    Call DrawButton(TIMELINE_LEFT + 252, Window_Height() - 96, 72, 24, "< EVENT", False)
    Call DrawButton(TIMELINE_LEFT + 330, Window_Height() - 96, 72, 24, "EVENT >", False)

    Draw Text SelectedClipName() At TIMELINE_LEFT + 412, Window_Height() - 88 Size 11 Color CYAN

    If SelectedTimelineEvent > 0 Then

        Draw Text Character3D.EventName(Character, SelectedTimelineEvent) At TIMELINE_LEFT + 518, Window_Height() - 88 Size 11 Color YELLOW
        Draw Number Character3D.EventTime(Character, SelectedTimelineEvent) At TIMELINE_LEFT + 616, Window_Height() - 88 Size 11 Color WHITE
        Draw Number Character3D.EventValue(Character, SelectedTimelineEvent) At TIMELINE_LEFT + 672, Window_Height() - 88 Size 11 Color CYAN

    Else
        Draw Text "No authored event" At TIMELINE_LEFT + 518, Window_Height() - 88 Size 11 Color LIGHT_GRAY

    End If

    Fill Rectangle TIMELINE_LEFT, TimelineY, Width, TIMELINE_HEIGHT, Rgb(18, 35, 58) Opacity 88
    Fill Rectangle TIMELINE_LEFT, TimelineY, ProgressWidth, TIMELINE_HEIGHT, Rgb(16, 102, 136) Opacity 90

    For EventIndex = 1 To Character3D.EventCount(Character)

        If Character3D.EventClipIndex(Character, EventIndex) = SelectedClip Then

            EventTime = Character3D.EventTime(Character, EventIndex)
            MarkerX = TIMELINE_LEFT + EventTime * Width / Duration

            Fill Rectangle MarkerX, TimelineY - 3, 2, TIMELINE_HEIGHT + 6, YELLOW Opacity 100

        End If

    End For

    If CalibrationAvailable Then

        For Keyframe = 0 To CalibrationKeyframeCounts[SelectedClip] - 1

            KeyframeTime = CalibrationFrameTimeMilliseconds(
                SelectedClip,
                CalibrationKeyframeFrames[SelectedClip, Keyframe]
            )
            MarkerX = TIMELINE_LEFT + KeyframeTime * Width / Duration

            Fill Rectangle MarkerX - 1, TimelineY - 5, 3, TIMELINE_HEIGHT + 10, GREEN Opacity 100

        End For

    End If

    Draw Number Character3D.AnimationTime(Character) At TIMELINE_LEFT + 6, TimelineY + 3 Size 10 Color WHITE
    Draw Number Duration At TIMELINE_LEFT + Width - 48, TimelineY + 3 Size 10 Color WHITE

End Sub

Function BackgroundLabel() As Text

    Dim Result As Text

    If BackgroundIndex = 1 Then
        Result = "BG GREEN"
    Else If BackgroundIndex = 2 Then
        Result = "BG PURPLE"
    Else
        Result = "BG BLACK"
    End If

    Return Result

End Function

Function DragonLabel() As Text

    Dim Result As Text

    If Not DragonAvailable Then
        Result = "NO DRAGON"
    Else If DragonVisible Then
        Result = "DRAGON ON"
    Else
        Result = "DRAGON OFF"
    End If

    Return Result

End Function

Function ViewerTitle() As Text

    Dim Result As Text

    Result = "SMILE 2.0 - 3D Viewer, Animation Editor - " + ViewerProfiles.ModelFileName(ProfileIndex)

    Return Result

End Function

Function ViewerLayoutTooSmall() As Boolean

    Dim Result As Boolean

    Result = Window_Width() < MINIMUM_VIEWER_WIDTH Or Window_Height() < MINIMUM_VIEWER_HEIGHT

    Return Result

End Function

Sub DrawAnimationButtons()

    Dim ClipCount As Number
    Dim Index As Number
    Dim Column As Number
    Dim Row As Number
    Dim ButtonX As Number
    Dim ButtonY As Number

    ClipCount = Character3D.ClipCount(Character)

    For Index = 0 To ClipCount - 1

        Column = Index Mod 2
        Row = Index / 2
        ButtonX = AnimationButtonX() + Column * (ANIMATION_BUTTON_WIDTH + ANIMATION_BUTTON_COLUMN_GAP)
        ButtonY = ANIMATION_BUTTON_Y + Row * (ANIMATION_BUTTON_HEIGHT + ANIMATION_BUTTON_ROW_GAP)

        Call DrawButton(
            ButtonX,
            ButtonY,
            ANIMATION_BUTTON_WIDTH,
            ANIMATION_BUTTON_HEIGHT,
            Character3D.ClipName(Character, Index),
            SelectedClip = Index
        )
    End For

End Sub

Function AnimationSecondsRemaining() As Number

    Dim RequiredMilliseconds As Number
    Dim RemainingMilliseconds As Number
    Dim Result As Number

    If DemoEnabled Then
        RequiredMilliseconds = DemoRequiredLoops() * DemoLoopDurationMilliseconds()
        RemainingMilliseconds = Max(0, RequiredMilliseconds - AnimationCycleElapsed)
        Result = (RemainingMilliseconds + 999) / 1000
    Else
        Result = 0
    End If

    Return Result

End Function

Function DemoLoopDurationMilliseconds() As Number

    Dim Result As Number

    Result = Character3D.ClipDuration(Character, SelectedClip) * 100 / Max(1, PlaybackSpeed)
    Result = Max(1, Result)

    Return Result

End Function

Function DemoRequiredLoops() As Number

    Dim LoopDuration As Number
    Dim Result As Number

    LoopDuration = DemoLoopDurationMilliseconds()
    Result = (ANIMATION_CYCLE_MILLISECONDS + LoopDuration - 1) / LoopDuration
    Result = Max(3, Result)

    Return Result

End Function

Function DemoLabel() As Text

    Dim Result As Text

    If DemoEnabled Then
        Result = "DEMO ON"
    Else
        Result = "DEMO OFF"
    End If

    Return Result

End Function

Function DemoStatusLabel() As Text

    Dim Result As Text

    If DemoEnabled Then
        Result = "On"
    Else
        Result = "Off"
    End If

    Return Result

End Function

Function ProductionClipStatusLabel() As Text

    Dim Result As Text

    If ProfileIndex = ViewerProfiles.PROFILE_ARIN Then
        Result = "7-clip validated candidate"
    Else If ProfileIndex = ViewerProfiles.PROFILE_ARIN_ORIGINAL Then
        Result = "Original 3 clips"
    Else
        Result = "Technical fixture"
    End If

    Return Result

End Function

Function SocketStatusLabel() As Text

    Dim Result As Text

    If SocketGizmosVisible And ShowAllSocketOrigins Then
        Result = "All origins"
    Else If SocketGizmosVisible Then
        Result = Character3D.SocketName(Character, SelectedSocket)
    Else
        Result = "Hidden"
    End If

    Return Result

End Function

Function PartyRoleLabel() As Text

    Dim Result As Text

    Result = ActiveProfile.PartyRole

    If Result = "" Then
        Result = "Technical"
    End If

    Return Result

End Function

Function MaterialInspectionLabel() As Text

    Dim Result As Text

    If MaterialInspection = Graphics3D.MATERIAL_INSPECTION_LIT Then
        Result = "Lit"
    Else If MaterialInspection = Graphics3D.MATERIAL_INSPECTION_BASE_COLOR Then
        Result = "Base Color"
    Else If MaterialInspection = Graphics3D.MATERIAL_INSPECTION_NORMAL Then
        Result = "Normal"
    Else If MaterialInspection = Graphics3D.MATERIAL_INSPECTION_ROUGHNESS Then
        Result = "Roughness"
    Else If MaterialInspection = Graphics3D.MATERIAL_INSPECTION_METALLIC Then
        Result = "Metallic"
    Else If MaterialInspection = Graphics3D.MATERIAL_INSPECTION_OCCLUSION Then
        Result = "Occlusion"
    Else
        Result = "Emissive"
    End If

    Return Result

End Function

Function AutoOrbitLabel() As Text

    Dim Result As Text

    If AutoOrbit Then
        Result = "On"
    Else
        Result = "Off"
    End If

    Return Result

End Function

Sub DrawButton(
    X As Number,
    Y As Number,
    Width As Number,
    Height As Number,
    Label As Text,
    Selected As Boolean
)

    Dim LabelHeight As Number
    Dim LabelSize As Number
    Dim LabelWidth As Number
    Dim LabelX As Number
    Dim LabelY As Number

    If Selected Then
        Fill Rectangle X, Y, Width, Height, Rgb(16, 102, 136) Opacity 80
    Else
        Fill Rectangle X, Y, Width, Height, Rgb(18, 35, 58) Opacity 80
    End If

    LabelSize = 11

    If Text_Width(Label, LabelSize) > Width - 10 Then
        LabelSize = 9
    End If

    If Text_Width(Label, LabelSize) > Width - 8 Then
        LabelSize = 8
    End If

    LabelWidth = Text_Width(Label, LabelSize)
    LabelHeight = Text_Height(Label, LabelSize)
    LabelX = X + Max(4, (Width - LabelWidth) / 2)
    LabelY = Y + Max(1, (Height - LabelHeight) / 2)

    Draw Text Label At LabelX, LabelY Size LabelSize Color WHITE

End Sub

Sub DestroyViewer()

    Call DestroyViewerResources()
    Call Character3D.Shutdown()
    Call Scene3D.Shutdown()
    Call Graphics3D.ResetRenderer3D()

End Sub

Sub DestroyViewerResources()

    Call DestroyDragon()
    Call Character3D.Destroy(Character)
    Call Graphics3D.DestroyObject3D(Floor)

    Call DestroyStudioGrid()
    Call DestroySocketGizmos()
    Call DestroyEpicGlow()

End Sub
