''' North-up expanded map; caller-owned images and a movement-driven fade.
Module Smile.Tools.NerisTownMap

Option Explicit

Import Smile.Simple3D.Precision3D As P

Public Type State
    Backing As Image
    Marker As Image
    Opacity As Double
End Type

Public Function Create(ByRef Value As State) As Boolean

    Dim Ok As Boolean

    Load Image Value.Backing From "Assets/Neris/Neris-Minimap.png"
    Load Image Value.Marker From "Assets/Neris/Neris-Minimap-Arin.png"
    Ok = Image_Loaded(Value.Backing) And Image_Loaded(Value.Marker)

    Return Ok

End Function

Public Sub Update(ByRef Value As State, Moving As Boolean, Elapsed As Number)

    If Moving Then
        Value.Opacity = Min(100.0, Value.Opacity + ToDouble(Elapsed) * 0.5)
    Else
        Value.Opacity = Max(0.0, Value.Opacity - ToDouble(Elapsed) * 0.125)
    End If

End Sub

Public Function MapX(WorldX As Double, Origin As Number, Size As Number) As Number

    Dim Result As Number

    Result = Origin + ToNumber(Round((Clamp(WorldX, -1350.0, 1350.0) + 1350.0) * ToDouble(Size) / 2700.0))

    Return Result

End Function

Public Function MapY(WorldZ As Double, Origin As Number, Size As Number) As Number

    Dim Result As Number

    Result = Origin + ToNumber(Round((1820.0 - Clamp(WorldZ, -1200.0, 1820.0)) * ToDouble(Size) / 3020.0))

    Return Result

End Function

Public Sub Draw(ByRef Value As State, Position As P.Vector3)

    Dim X As Number
    Dim Y As Number
    Dim Width As Number
    Dim Height As Number
    Dim Opacity As Number
    Dim MarkerX As Number
    Dim MarkerY As Number

    Opacity = ToNumber(Value.Opacity)

    If Opacity <= 0 Then
        Return
    End If

    Width = Min(300, Max(225, Window_Width() / 5))
    Height = Width * 1080 / 900
    X = Window_Width() - Width - 20
    Y = 104
    MarkerX = MapX(Position.X, X + Width * 30 / 900, Width * 840 / 900)
    MarkerY = MapY(Position.Z, Y + Height * 90 / 1080, Height * 940 / 1080)

    Draw Image Value.Backing At X, Y Size Width By Height Opacity Opacity Filter Smooth
    Draw Image Value.Marker At MarkerX - 5, MarkerY - 5 Size 10 By 10 Opacity Opacity Filter Smooth

End Sub

Public Sub Destroy(ByRef Value As State)

    Unload Image Value.Backing
    Unload Image Value.Marker

    Value.Opacity = 0.0

End Sub

End Module
