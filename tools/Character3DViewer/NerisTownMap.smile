''' North-up expanded map; caller-owned images and a movement-driven fade.
Module Smile.Tools.NerisTownMap

Option Explicit

Import Smile.Simple3D.Precision3D As P
Import Smile.Tools.Character3DViewerCalibration As Numbers

Public Type State
    Backing As Image
    Marker As Image
    Headlight As Image
    Opacity As Double
    HoldRemaining As Number
    Disabled As Boolean
    ManualVisible As Boolean
End Type

Public Function Create(ByRef Value As State) As Boolean

    Dim Ok As Boolean

    Load Image Value.Backing From "Assets/Neris/Neris-Minimap.png"
    Load Image Value.Marker From "Assets/Neris/Neris-Minimap-Arin.png"
    Load Image Value.Headlight From "Assets/Neris/Neris-Minimap-Heading.png"
    Ok = Image_Loaded(Value.Backing) And Image_Loaded(Value.Marker) And Image_Loaded(Value.Headlight)

    Return Ok

End Function

''' Manual on/off overrides automatic fading until this town session ends.
Public Sub Toggle(ByRef Value As State)

    Value.Disabled = Value.Opacity > 0.0
    Value.ManualVisible = Not Value.Disabled

    If Value.Disabled Then
        Value.Opacity = 0.0
        Value.HoldRemaining = 0
    Else
        Value.Opacity = 80.0
        Value.HoldRemaining = 10000
    End If

End Sub

Public Sub Update(ByRef Value As State, Moving As Boolean, Elapsed As Number)

    Dim FadeElapsed As Number

    If Value.Disabled Or Value.ManualVisible Then
        Return
    End If

    If Moving Then

        Value.HoldRemaining = 10000
        Value.Opacity = Min(80.0, Value.Opacity + ToDouble(Elapsed) * 0.4)

    Else

        FadeElapsed = Max(0, Elapsed - Value.HoldRemaining)
        Value.HoldRemaining = Max(0, Value.HoldRemaining - Elapsed)
        Value.Opacity = Max(0.0, Value.Opacity - ToDouble(FadeElapsed) * 0.1)

    End If

End Sub

Public Function MapX(WorldX As Double, Origin As Number, Size As Number) As Number

    Dim Result As Number

    Result = Origin + ToNumber(Round((Clamp(WorldX, -4900.0, 2750.0) + 4900.0) * ToDouble(Size) / 7650.0))

    Return Result

End Function

Public Function MapY(WorldZ As Double, Origin As Number, Size As Number) As Number

    Dim Result As Number

    Result = Origin + ToNumber(Round((3550.0 - Clamp(WorldZ, -3550.0, 3550.0)) * ToDouble(Size) / 7100.0))

    Return Result

End Function

Public Function HeadingFrame(Yaw As Double) As Number

    Dim Result As Number

    ' Actors face -Z at zero yaw; the north-up sheet starts at +Z.
    Result = ToNumber(Round((Yaw + 540.0) / 5.0)) Mod 72

    Return Result

End Function

Public Sub Draw(ByRef Value As State, Position As P.Vector3, Yaw As Double,
    Orbiting As Boolean, Optional LeaderName As Text = "Arin")

    Dim X As Number
    Dim Y As Number
    Dim Width As Number
    Dim Height As Number
    Dim Opacity As Number
    Dim MarkerX As Number
    Dim MarkerY As Number
    Dim Frame As Number
    Dim SourceX As Number
    Dim SourceY As Number
    Dim Coordinates As Text

    Opacity = ToNumber(Value.Opacity)

    If Opacity <= 0 Or Orbiting Then
        Return
    End If

    Width = Min(300, Max(225, Window_Width() / 5))
    Height = Width * 1080 / 1140
    X = Window_Width() - Width - 20
    Y = 104
    MarkerX = MapX(Position.X, X + Width * 30 / 1140, Width * 1080 / 1140)
    MarkerY = MapY(Position.Z, Y + Height * 90 / 1080, Height * 940 / 1080)
    Coordinates = LeaderName + " X: " + Numbers.NumberText(ToNumber(Round(Position.X))) + "  Y: " + Numbers.NumberText(ToNumber(Round(Position.Y))) + "  Z: " + Numbers.NumberText(ToNumber(Round(Position.Z)))
    Frame = HeadingFrame(Yaw)
    SourceX = (Frame Mod 12) * 96
    SourceY = (Frame / 12) * 96

    Draw Image Value.Backing At X, Y Size Width By Height Opacity Opacity Filter Smooth
    Draw Image Value.Headlight From SourceX, SourceY Size 96 By 96 At MarkerX - 28, MarkerY - 28 Size 56 By 56 Opacity Opacity Filter Smooth
    Draw Image Value.Marker At MarkerX - 5, MarkerY - 5 Size 10 By 10 Opacity Opacity Filter Smooth

    Draw Text Coordinates At X + 6, Y + Height - 13 Size 11 Color RGB(236, 229, 196)

End Sub

Public Sub Destroy(ByRef Value As State)

    Unload Image Value.Backing
    Unload Image Value.Marker
    Unload Image Value.Headlight

    Value.Opacity = 0.0
    Value.HoldRemaining = 0

End Sub

End Module
