''' Shared draw/hit layout for the right-aligned town viewport toolbar.
Module Smile.Tools.TownViewportLayout

Option Explicit

Import Smile.UI.Controls As UI

Public Function Label(Index As Number) As Text

    Select Case Index
        Case 0
            Return "?"
        Case 2
            Return "Edit Town"
        Case 3
            Return "Orbit"
        Case 4
            Return "Fit"
        Case 5
            Return "Fly Inspect"
        Case 6
            Return "Demo"
        Case 7
            Return "World Map"
    End Select

    Return ""

End Function

Public Function Width(Index As Number) As Number

    Dim Result As Number

    Result = Max(30, Text_Width(Label(Index), 11) + 20)

    If Index = 1 Then
        Result = 38
    Else If Index = 6 Then
        Result = Text_Width("Demo Off", 11) + 20
    End If

    Return Result

End Function

Public Function ButtonLeft(Index As Number) As Number

    Dim Offset As Number
    Dim Item As Number
    Dim Result As Number
    Dim Total As Number

    For Item = 0 To 7

        Total = Total + Width(Item) + 8
        ' Preserve action IDs while placing Edit Town at the right end.

        If (Item <> 2 And (Item < Index Or Index = 2)) Then
            Offset = Offset + Width(Item) + 8
        End If

    End For

    Result = Max(18, Window_Width() - 18 - (Total - 8)) + Offset

    Return Result

End Function

Public Function Hovered(Index As Number) As Boolean

    Dim Result As Boolean

    Result = UI.Contains(ButtonLeft(Index), Window_Height() - 38, Width(Index), 26)

    Return Result

End Function

Public Function Clicked(Index As Number) As Boolean

    Dim Result As Boolean

    Result = Hovered(Index) And Pointer_Pressed(POINTER_PRIMARY)

    Return Result

End Function

Public Sub DrawButton(Index As Number, Selected As Boolean)

    Dim Caption As Text

    Caption = Label(Index)

    If Index = 6 Then

        Caption = "Demo Off"

        If Selected Then
            Caption = "Demo On"
        End If

    End If

    Call UI.DrawButton(ButtonLeft(Index), Window_Height() - 38, Width(Index), 26, Caption, Selected)

End Sub

End Module
