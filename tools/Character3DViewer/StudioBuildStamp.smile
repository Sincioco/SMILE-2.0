''' Immutable artifact identification shared by every native Studio tab.
Module Smile.Tools.StudioBuildStamp

Option Explicit

Public Sub Draw()

    Dim Caption As Text
    Dim Width As Number
    Dim X As Number
    Dim Y As Number

    Caption = Build_Info()
    Width = Text_Width(Caption, 11) + 16
    X = (Window_Width() - Width) / 2
    Y = Window_Height() - 18
    Fill Rectangle X, Y, Width, 18, RGB(12, 23, 36) Opacity 88
    Draw Text Caption At Window_Width() / 2, Y + 2 Size 11 Color LIGHT_GRAY Centered

End Sub

End Module
