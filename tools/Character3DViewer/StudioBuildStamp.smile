''' Immutable artifact identification shared by every native Studio tab.
Module Smile.Tools.StudioBuildStamp

Option Explicit

Public Sub Draw()

    Dim Caption As Text
    Dim X As Number
    Dim Y As Number

    Caption = Build_Info()
    X = Max(8, Window_Width() - Text_Width(Caption, 11) - 18)
    Y = Window_Height() - 18
    Draw Text Caption At X, Y + 2 Size 11 Color LIGHT_GRAY

End Sub

End Module
