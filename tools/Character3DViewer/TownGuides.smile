''' Temporary construction guides and placement snapping. Never part of a town save.
Module Smile.Tools.TownGuides

Option Explicit

Import Smile.Tools.TownSurfaceLayers As Layers
Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.PrecisionMath3D As M
Import Smile.Simple3D.PrecisionCamera3D As Camera
Import Smile.Simple3D.SurfaceGrid3D As Grid
Import Smile.Tools.TownPicking As Picking

Public Const MAX_MARKERS = 128

Public Type Marker
    Name As Text
    First As P.Vector3
    Last As P.Vector3
    IsRectangle As Boolean
End Type

Public Type Drawing
    Markers[128] As Marker
    EntryCount As Number
    Revision As Number
End Type

Public Type State
    Ink As Drawing
    Selected[128] As Boolean
    ShowGrid As Boolean
    ShowTileGrid As Boolean
    TileTarget As Number
    SnapTiles As Boolean
    SnapMode As Number
    Spacing As Double
    VisibleSpacing As Double
End Type

Public Sub Start(ByRef Value As State)

    If Value.Spacing <= 0.0 Then
        Value.Spacing = 2.0
    End If

End Sub

''' Accept bounded decimal meters without passing invalid user input to a checked conversion.
Public Function SetSpacing(ByRef Value As State, InputText As Text) As Boolean

    Dim Index As Number
    Dim Code As Number
    Dim Digits As Number
    Dim FractionDigits As Number
    Dim DecimalSeen As Boolean
    Dim Parsed As Double
    Dim Divisor As Double

    Divisor = 1.0

    For Index = 0 To Text_Length(InputText) - 1

        Code = Text_Code_At(InputText, Index)

        If Code = 46 And Not DecimalSeen Then

            DecimalSeen = True

        Else If Code >= 48 And Code <= 57 Then

            Digits = Digits + 1
            Parsed = Parsed * 10.0 + ToDouble(Code - 48)

            If DecimalSeen Then
                FractionDigits = FractionDigits + 1
                Divisor = Divisor * 10.0
            End If

            If Digits > 11 Or FractionDigits > 6 Then
                Return False
            End If

        Else
            Return False

        End If

    End For

    Parsed = Parsed / Divisor

    If (Digits = 0 Or
        Parsed < 0.001 Or
        Parsed > 10000.0) Then
        Return False
    End If

    Value.Spacing = Parsed

    Return True

End Function

Private Function DigitsText(Units As Number) As Text

    Dim Result As Text

    Do
        Result = Text_From_Code(48 + Units Mod 10) + Result
        Units = Units / 10

    Loop Until Units = 0

    Return Result

End Function

Public Function SpacingLabel(Spacing As Double) As Text

    Dim Result As Text
    Dim Part As Text
    Dim Units As Number
    Dim Fraction As Number

    Units = ToNumber(Round(Spacing * 1000000.0))
    Fraction = Units Mod 1000000
    Result = DigitsText(Units / 1000000)

    If Fraction > 0 Then

        Part = DigitsText(1000000 + Fraction)
        Part = Text_Slice(Part, 1, 6)

        Do

            If Text_Code_At(Part, Text_Length(Part) - 1) <> 48 Then
                Exit Do
            End If

            Part = Text_Slice(Part, 0, Text_Length(Part) - 1)

        Loop Until Text_Length(Part) = 0

        Result = Result + "." + Part

    End If

    Return Result

End Function

Public Function SnapTile(ByRef Surface As Grid.State, Point As P.Vector3) As P.Vector3

    Dim X As Number
    Dim Z As Number

    X = Max(0, Min(Surface.Columns - 1, Grid.CellX(Surface, Point.X)))
    Z = Max(0, Min(Surface.Rows - 1, Grid.CellZ(Surface, Point.Z)))

    If Abs(Point.X - Surface.XEdges[X + 1]) < Abs(Point.X - Surface.XEdges[X]) Then
        X = X + 1
    End If

    If Abs(Point.Z - Surface.ZEdges[Z + 1]) < Abs(Point.Z - Surface.ZEdges[Z]) Then
        Z = Z + 1
    End If

    Point.X = Surface.XEdges[X]
    Point.Z = Surface.ZEdges[Z]

    Return Point

End Function

Public Function Add(ByRef Value As Drawing, First As P.Vector3,
    Last As P.Vector3, IsRectangle As Boolean) As Boolean

    If Value.EntryCount >= MAX_MARKERS Then
        Return False
    End If

    If Abs(First.X - Last.X) < 0.001 And Abs(First.Z - Last.Z) < 0.001 Then
        Return False
    End If

    First.Y = Layers.ROAD_Y
    Last.Y = First.Y
    Value.Markers[Value.EntryCount].Name = ""
    Value.Markers[Value.EntryCount].First = First
    Value.Markers[Value.EntryCount].Last = Last
    Value.Markers[Value.EntryCount].IsRectangle = IsRectangle
    Value.EntryCount = Value.EntryCount + 1
    Value.Revision = Value.Revision + 1

    Return True

End Function

Public Sub ClearMarkers(ByRef Value As Drawing)

    If Value.EntryCount > 0 Then
        Value.EntryCount = 0
        Value.Revision = Value.Revision + 1
    End If

End Sub

Public Function Corner(Value As Marker, Index As Number) As P.Vector3

    Dim Result As P.Vector3

    Result = Value.First

    If Index = 1 Then
        Result.X = Value.Last.X
    Else If Index = 2 Then
        Result = Value.Last
    Else If Index = 3 Then
        Result.Z = Value.Last.Z
    End If

    Return Result

End Function

Public Function Closest(Point As P.Vector3, First As P.Vector3, Last As P.Vector3) As P.Vector3

    Dim Result As P.Vector3
    Dim X As Double
    Dim Z As Double
    Dim Length As Double
    Dim Amount As Double

    X = Last.X - First.X
    Z = Last.Z - First.Z
    Length = X * X + Z * Z

    If Length > 0.000001 Then
        Amount = Clamp(((Point.X - First.X) * X + (Point.Z - First.Z) * Z) / Length, 0.0, 1.0)
    End If

    Result = P.Vector(First.X + X * Amount, Point.Y, First.Z + Z * Amount)

    Return Result

End Function

Private Sub Consider(Point As P.Vector3, Candidate As P.Vector3,
    ByRef Best As Double, ByRef Result As P.Vector3, ByRef Found As Boolean)

    Dim Distance As Double

    Distance = ((Point.X - Candidate.X) * (Point.X - Candidate.X) +
        (Point.Z - Candidate.Z) * (Point.Z - Candidate.Z))

    If Distance <= Best Then

        Best = Distance
        Result = P.Vector(Candidate.X, Point.Y, Candidate.Z)
        Found = True

    End If

End Sub

Public Function Snap(ByRef Value As State, Point As P.Vector3, Radius As Double) As P.Vector3

    Dim Index As Number
    Dim Part As Number
    Dim EntryCount As Number
    Dim Pass As Number
    Dim Mark As Marker
    Dim First As P.Vector3
    Dim Last As P.Vector3
    Dim Candidate As P.Vector3
    Dim Result As P.Vector3
    Dim Best As Double
    Dim StepSize As Double
    Dim Found As Boolean

    Result = Point
    StepSize = Max(0.001, Value.Spacing) * 10.0

    If Value.SnapMode = 1 Or Value.SnapMode = 3 Then
        Result.X = Round(Point.X / StepSize) * StepSize
        Result.Z = Round(Point.Z / StepSize) * StepSize
    End If

    If Value.SnapMode < 2 Then
        Return Result
    End If

    ' Endpoints/corners take precedence, then the nearest segment within the radius.

    For Pass = 0 To 1

        Best = Max(0.0, Radius) * Max(0.0, Radius)

        For Index = 0 To Value.Ink.EntryCount - 1

            Mark = Value.Ink.Markers[Index]
            EntryCount = 1

            If Mark.IsRectangle Then
                EntryCount = 4
            End If

            For Part = 0 To EntryCount - 1

                First = Mark.First
                Last = Mark.Last

                If Mark.IsRectangle Then
                    First = Corner(Mark, Part)
                    Last = Corner(Mark, (Part + 1) Mod 4)
                End If

                If Pass = 0 Then
                    Call Consider(Point, First, Best, Result, Found)
                    Call Consider(Point, Last, Best, Result, Found)
                Else
                    Candidate = Closest(Point, First, Last)

                    Call Consider(Point, Candidate, Best, Result, Found)
                End If

            End For
        End For

        If Found Then
            Exit For
        End If

    End For

    Return Result

End Function

Public Sub Segment(First As P.Vector3, Last As P.Vector3, View As P.Camera3D, ColorValue As Number)

    Dim FirstPoint As Camera.ProjectedPoint
    Dim LastPoint As Camera.ProjectedPoint
    Dim Amount As Double

    FirstPoint = Camera.ProjectViewerPoint(First, View, Window_Width(), Window_Height())
    LastPoint = Camera.ProjectViewerPoint(Last, View, Window_Width(), Window_Height())

    If Not FirstPoint.Visible And Not LastPoint.Visible Then
        Return
    End If

    If Not FirstPoint.Visible Then

        Amount = (View.NearPlane + 0.001 - FirstPoint.Depth) / (LastPoint.Depth - FirstPoint.Depth)
        First = M.Add(First, M.Scale(M.Subtract(Last, First), Amount))
        FirstPoint = Camera.ProjectViewerPoint(First, View, Window_Width(), Window_Height())

    Else If Not LastPoint.Visible Then

        Amount = (View.NearPlane + 0.001 - LastPoint.Depth) / (FirstPoint.Depth - LastPoint.Depth)
        Last = M.Add(Last, M.Scale(M.Subtract(First, Last), Amount))
        LastPoint = Camera.ProjectViewerPoint(Last, View, Window_Width(), Window_Height())

    End If

    If FirstPoint.Visible And LastPoint.Visible Then
        Draw Line ToNumber(FirstPoint.X), ToNumber(FirstPoint.Y), ToNumber(LastPoint.X), ToNumber(LastPoint.Y), ColorValue
    End If

End Sub

Public Sub DrawMarker(Value As Marker, View As P.Camera3D, ColorValue As Number)

    Dim Part As Number

    If Value.IsRectangle Then

        For Part = 0 To 3
            Call Segment(Corner(Value, Part), Corner(Value, (Part + 1) Mod 4), View, ColorValue)
        End For

    Else

        Call Segment(Value.First, Value.Last, View, ColorValue)

    End If

End Sub

Public Sub Draw(ByRef Value As State, ByRef Surface As Grid.State, View As P.Camera3D, RightEdge As Number)

    Dim Index As Number
    Dim StepSize As Double
    Dim PixelStep As Double
    Dim Extent As Double
    Dim AtValue As Double
    Dim Point As Camera.ProjectedPoint
    Dim Low As P.Vector3
    Dim High As P.Vector3
    Dim ViewLow As P.Vector3
    Dim ViewHigh As P.Vector3

    Clip Rectangle 0, 128, Max(0, RightEdge), Max(0, Window_Height() - 128)

    If Value.ShowGrid Then

        StepSize = Max(0.001, Value.Spacing) * 10.0
        Point = Camera.ProjectViewerPoint(View.Target, View, Window_Width(), Window_Height())
        PixelStep = Camera.WorldSizeForPixels(3, Max(View.NearPlane, Point.Depth), View.FovDegrees, Window_Height())

        If View.OrthographicHeight > 0.0 Then
            PixelStep = View.OrthographicHeight * 3.0 / ToDouble(Window_Height())
        End If

        Low = P.Vector(Surface.XEdges[0], Layers.ROAD_Y, Surface.ZEdges[0])
        High = P.Vector(Surface.XEdges[Surface.Columns], Layers.ROAD_Y, Surface.ZEdges[Surface.Rows])

        If Picking.GroundBounds(View, Window_Width(), Window_Height(), RightEdge, 128, ViewLow, ViewHigh) Then

            Low.X = Max(Low.X, ViewLow.X)
            Low.Z = Max(Low.Z, ViewLow.Z)
            High.X = Min(High.X, ViewHigh.X)
            High.Z = Min(High.Z, ViewHigh.Z)

        End If

        Extent = Max(High.X - Low.X, High.Z - Low.Z)
        ' Retain the chosen snap spacing; omit intermediate lines when zoomed far out.
        StepSize = StepSize * Max(1.0, Ceiling(Max(PixelStep, Extent / 1024.0) / StepSize))
        Value.VisibleSpacing = StepSize / 10.0

        For Index = ToNumber(Ceiling(Low.X / StepSize)) To ToNumber(Floor(High.X / StepSize))
            AtValue = ToDouble(Index) * StepSize

            Call Segment(P.Vector(AtValue, Layers.ROAD_Y, Low.Z),
                P.Vector(AtValue, Layers.ROAD_Y, High.Z), View, RGB(73, 120, 138))
        End For

        For Index = ToNumber(Ceiling(Low.Z / StepSize)) To ToNumber(Floor(High.Z / StepSize))
            AtValue = ToDouble(Index) * StepSize

            Call Segment(P.Vector(Low.X, Layers.ROAD_Y, AtValue),
                P.Vector(High.X, Layers.ROAD_Y, AtValue), View, RGB(73, 120, 138))
        End For

    End If

    For Index = 0 To Value.Ink.EntryCount - 1

        If Value.Selected[Index] Then
            Call DrawMarker(Value.Ink.Markers[Index], View, RGB(70, 230, 215))
        Else

            Call DrawMarker(Value.Ink.Markers[Index], View, RGB(255, 209, 94))
        End If

    End For

    End Clip

End Sub

End Module
