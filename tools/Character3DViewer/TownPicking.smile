''' Precise ground/ray picking and projected assembly bounds; no document mutations.
Module Smile.Tools.TownPicking

Option Explicit

Import Smile.Tools.TownSurfaceLayers As Layers
Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.PrecisionMath3D As M
Import Smile.Simple3D.PrecisionCamera3D As Camera
Import Smile.Tools.TownDocument As Document
Import Smile.Tools.TownCatalogData As Catalog
Import Smile.Tools.TownGeometry As Geometry
Import Smile.Simple3D.TerrainRay3D As TerrainRay

Public Function TerrainPoint(ByRef Town As Document.State, View As P.Camera3D,
    X As Number, Y As Number, Width As Number, Height As Number,
    ByRef Point As P.Vector3) As Boolean

    Dim Origin As P.Vector3
    Dim Ray As P.Vector3
    Dim Ok As Boolean

    Origin = Camera.CursorPointAtDepth(View, X, Y, View.NearPlane, Width, Height)
    Ray = M.Subtract(Camera.CursorPointAtDepth(View, X, Y,
        Max(1000.0, View.NearPlane + 1.0), Width, Height), Origin)
    Ok = TerrainRay.Pick(Town.Surface, Origin, Ray, Layers.GROUND_Y, View.FarPlane, Point)
    Return Ok

End Function

Public Type ScreenBox
    X0 As Number
    Y0 As Number
    X1 As Number
    Y1 As Number
    Visible As Boolean
End Type

Public Function GroundBounds(View As P.Camera3D, Width As Number, Height As Number,
    RightEdge As Number, TopEdge As Number, ByRef Low As P.Vector3, ByRef High As P.Vector3) As Boolean

    Dim Index As Number
    Dim Point As P.Vector3

    For Index = 0 To 3

        If Not Ground(View, (Index Mod 2) * RightEdge, TopEdge + (Index / 2) * (Height - TopEdge),
            Width, Height, Point) Then
            Return False
        End If

        If Index = 0 Then

            Low = Point
            High = Point

        Else
            Low.X = Min(Low.X, Point.X)
            Low.Z = Min(Low.Z, Point.Z)
            High.X = Max(High.X, Point.X)
            High.Z = Max(High.Z, Point.Z)

        End If

    End For

    Return True

End Function

''' The exact optical center stays on the viewing ray, including odd viewport sizes.
Public Function OrbitCenter(View As P.Camera3D, Width As Number, Height As Number) As P.Vector3

    Dim Forward As P.Vector3
    Dim Point As P.Vector3
    Dim Depth As Double
    Dim GroundDepth As Double

    Point = View.Target

    If Not M.TryNormalize(M.Subtract(View.Target, View.Position), Forward) Then
        Return Point
    End If

    If Not P.TryCursorDepth(Width / 2, Height / 2, Width, Height, Depth) Then

        Depth = M.Distance(View.Position, View.Target)

        If Forward.Y < -0.00001 Then

            GroundDepth = (Layers.ROAD_Y - View.Position.Y) / Forward.Y

            If GroundDepth > View.NearPlane And GroundDepth <= View.FarPlane Then
                Depth = GroundDepth
            End If

        End If

    End If

    Point = M.Add(View.Position, M.Scale(Forward, Depth))

    Return Point

End Function

''' Use the visible opaque surface; transparent water and sky fall back to the town floor.
Public Function OrbitPoint(View As P.Camera3D, X As Number, Y As Number,
    Width As Number, Height As Number, ByRef Point As P.Vector3) As Boolean

    Dim Depth As Double
    Dim Result As Boolean

    If P.TryCursorDepth(X, Y, Width, Height, Depth) Then
        Point = Camera.CursorPointAtDepth(View, X, Y, Depth, Width, Height)

        Return True
    End If

    Result = Ground(View, X, Y, Width, Height, Point)

    Return Result

End Function

Public Function Ground(View As P.Camera3D, X As Number, Y As Number,
    Width As Number, Height As Number, ByRef Point As P.Vector3) As Boolean

    Dim Ray As P.Vector3
    Dim RayOrigin As P.Vector3
    Dim Distance As Double

    RayOrigin = Camera.CursorPointAtDepth(View, X, Y, View.NearPlane, Width, Height)
    Ray = M.Subtract(Camera.CursorPointAtDepth(View, X, Y,
        Max(1000.0, View.NearPlane + 1.0), Width, Height), RayOrigin)

    If Abs(Ray.Y) < 0.00001 Then
        Return False
    End If

    Distance = (Layers.ROAD_Y - RayOrigin.Y) / Ray.Y

    If Distance <= 0.0 Or Distance > 100.0 Then
        Return False
    End If

    Point = M.Add(RayOrigin, M.Scale(Ray, Distance))

    Return True

End Function

Private Function ClipAxis(Origin As Double, Direction As Double, Low As Double,
    High As Double, ByRef NearValue As Double, ByRef FarValue As Double) As Boolean

    Dim First As Double
    Dim Second As Double
    Dim Result As Boolean

    If Abs(Direction) < 0.00001 Then
        Result = Origin >= Low And Origin <= High

        Return Result
    End If

    First = (Low - Origin) / Direction
    Second = (High - Origin) / Direction
    NearValue = Max(NearValue, Min(First, Second))
    FarValue = Min(FarValue, Max(First, Second))
    Result = FarValue >= NearValue

    Return Result

End Function

Public Function RayBounds(Origin As P.Vector3, Ray As P.Vector3,
    Low As P.Vector3, High As P.Vector3, ByRef Distance As Double) As Boolean

    Dim NearValue As Double
    Dim FarValue As Double
    Dim Ok As Boolean

    FarValue = Distance
    Ok = ClipAxis(Origin.X, Ray.X, Low.X, High.X, NearValue, FarValue)
    Ok = ClipAxis(Origin.Y, Ray.Y, Low.Y, High.Y, NearValue, FarValue) And Ok
    Ok = ClipAxis(Origin.Z, Ray.Z, Low.Z, High.Z, NearValue, FarValue) And Ok

    If Ok Then
        Distance = NearValue
    End If

    Return Ok

End Function

Public Function ItemAt(ByRef Town As Document.State, Category As Number, View As P.Camera3D,
    X As Number, Y As Number, Width As Number, Height As Number) As Number

    Dim Index As Number
    Dim Result As Number
    Dim Nearest As Double
    Dim NearValue As Double
    Dim Point As P.Vector3
    Dim Origin As P.Vector3
    Dim Ray As P.Vector3
    Dim Shape As Catalog.Template
    Dim Ok As Boolean

    Result = -1
    Nearest = 1000000.0
    Point = Camera.CursorPointAtDepth(View, X, Y, Max(1000.0, View.NearPlane + 1.0), Width, Height)

    For Index = 0 To Town.ItemCount - 1

        If Town.Items[Index].Active And Town.Items[Index].Category = Category Then

            Shape = Catalog.TemplateAt(Town.Items[Index].Template)
            Origin = Geometry.ToLocal(Town.Items[Index], Camera.CursorPointAtDepth(View, X, Y, View.NearPlane, Width, Height))
            Ray = M.Subtract(Geometry.ToLocal(Town.Items[Index], Point), Origin)
            NearValue = Nearest
            Ok = RayBounds(Origin, Ray, Shape.Low, Shape.High, NearValue)

            If Ok And NearValue < Nearest Then
                Nearest = NearValue
                Result = Index
            End If

        End If

    End For

    Return Result

End Function

Public Function Project(Item As Document.Item, View As P.Camera3D,
    Width As Number, Height As Number) As ScreenBox

    Dim Shape As Catalog.Template
    Dim Point As P.Vector3
    Dim Pixel As Camera.ProjectedPoint
    Dim Corner As Number
    Dim Result As ScreenBox

    Shape = Catalog.TemplateAt(Item.Template)
    Result.X0 = Width
    Result.Y0 = Height

    For Corner = 0 To 7

        Point = Shape.Low

        If Corner Mod 2 = 1 Then
            Point.X = Shape.High.X
        End If

        If (Corner / 2) Mod 2 = 1 Then
            Point.Y = Shape.High.Y
        End If

        If Corner >= 4 Then
            Point.Z = Shape.High.Z
        End If

        Pixel = Camera.ProjectViewerPoint(Geometry.ToWorld(Item, Point), View, Width, Height)

        If Pixel.Visible Then

            Result.X0 = Min(Result.X0, ToNumber(Pixel.X))
            Result.Y0 = Min(Result.Y0, ToNumber(Pixel.Y))
            Result.X1 = Max(Result.X1, ToNumber(Pixel.X))
            Result.Y1 = Max(Result.Y1, ToNumber(Pixel.Y))
            Result.Visible = True

        End If

    End For

    Return Result

End Function

End Module
