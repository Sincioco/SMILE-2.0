''' Showcase timing and saved per-map participation, independent of tab documents.
Module Smile.Tools.TownDemo

Option Explicit

Public Const INTERVAL = 30000
Public Const IDLE_INTERVAL = 120000

Private Dim PreferenceByte[1] As Number

Public Type Selection
    Names[16] As Text
    Enabled[16] As Boolean
    EntryCount As Number
End Type

Public Type State
    TownName As Text
    Enabled As Boolean
    Elapsed As Number
    IdleElapsed As Number
End Type

Public Function Duration(Name As Text) As Number

    If (Name = "Verdant Reach" Or
        Name = "Greyglass Pass" Or
        Name = "Sunglass Expanse" Or
        Name = "Ancient Relay" Or
        Name = "Neris Relief Quarter" Or
        Name = "Willowstep Highlands" Or
        Name = "Silverfall Basin") Then
        Return 15000
    End If

    Return INTERVAL

End Function

Public Function DefaultIncluded(Name As Text) As Boolean

    Dim Result As Boolean

    Result = (Name = "Neris Town" Or Name = "Neris Spaceport" Or
        Name = "Horizon Airport" Or Name = "Neris Star Lake")

    Return Result

End Function

Private Function Find(ByRef Value As Selection, Name As Text) As Number

    Dim Index As Number
    Dim Length As Number
    Dim Status As Number

    For Index = 0 To Value.EntryCount - 1

        If Value.Names[Index] = Name Then
            Return Index
        End If

    End For

    Index = Value.EntryCount Mod 16
    Value.EntryCount = Min(16, Value.EntryCount + 1)
    Value.Names[Index] = Name
    Value.Enabled[Index] = DefaultIncluded(Name)

    Load Data "TownDemo.Include." + Name Into PreferenceByte Count Length Status Status

    If (Status = DATA_STATUS_OK And
        Length = 1 And
        PreferenceByte[0] <= 1) Then
        Value.Enabled[Index] = PreferenceByte[0] = 1
    End If

    Return Index

End Function

Public Function Included(ByRef Value As Selection, Name As Text) As Boolean

    Dim Index As Number
    Dim Result As Boolean

    Index = Find(Value, Name)
    Result = Value.Enabled[Index]

    Return Result

End Function

Public Function SetIncluded(ByRef Value As Selection, Name As Text, Enabled As Boolean) As Boolean

    Dim Index As Number
    Dim Status As Number

    Index = Find(Value, Name)
    PreferenceByte[0] = 0

    If Enabled Then
        PreferenceByte[0] = 1
    End If

    Save Data PreferenceByte Count 1 To "TownDemo.Include." + Name Status Status

    If Status <> DATA_STATUS_OK Then
        Return False
    End If

    Value.Enabled[Index] = Enabled
    Return True

End Function

Public Sub Start(ByRef Value As State)

    Value.Enabled = True
    Value.Elapsed = 0
    Value.IdleElapsed = 0

End Sub

''' Demo and day/night controls preserve the showcase; other deliberate input ends it.
Public Function StopOnInput(ByRef Value As State, Active As Boolean, PreserveDemo As Boolean) As Boolean

    If (Not Value.Enabled Or
        Not Active Or
        PreserveDemo) Then
        Return False
    End If

    Value.Enabled = False
    Value.Elapsed = 0
    Value.IdleElapsed = 0
    Return True

End Function

Public Sub Toggle(ByRef Value As State)

    Value.Enabled = Not Value.Enabled
    Value.Elapsed = 0
    Value.IdleElapsed = 0

End Sub

Public Function AdvanceIdle(ByRef Value As State, Elapsed As Number,
    Active As Boolean, Ready As Boolean) As Boolean

    If (Value.Enabled Or
        Active Or
        Not Ready) Then
        Value.IdleElapsed = 0
        Return False
    End If

    Value.IdleElapsed = Min(IDLE_INTERVAL, Value.IdleElapsed + Max(0, Min(Elapsed, 1000)))

    If Value.IdleElapsed < IDLE_INTERVAL Then
        Return False
    End If

    Value.IdleElapsed = 0

    Return True

End Function

Public Function StatisticsVisible(Value As State) As Boolean

    Dim Result As Boolean

    Result = Not Value.Enabled Or Value.Elapsed < 15000

    Return Result

End Function

''' Use the opposite lighting only during the middle third of each map visit.
Public Function AlternateLighting(Value As State) As Boolean

    Dim Result As Boolean

    Result = (Value.Enabled And Value.Elapsed >= Duration(Value.TownName) / 3 And
        Value.Elapsed < Duration(Value.TownName) * 2 / 3)

    Return Result

End Function

Public Function SecondsRemaining(Value As State) As Number

    Dim Result As Number

    If Value.Enabled Then
        Result = Max(0, Duration(Value.TownName) - Value.Elapsed + 999) / 1000
    End If

    Return Result

End Function

Public Function Advance(ByRef Value As State, Elapsed As Number, Ready As Boolean) As Boolean

    If Not Value.Enabled Or Not Ready Then
        Return False
    End If

    Value.Elapsed = Value.Elapsed + Max(0, Min(Elapsed, 1000))

    If Value.Elapsed < Duration(Value.TownName) Then
        Return False
    End If

    Value.Elapsed = 0

    Return True

End Function

End Module
