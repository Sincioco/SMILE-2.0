''' Editable town with the actual party, camera, overlay and shared native resource pools.

Option Explicit

Import Smile.Tools.NerisTown As Town
Import Smile.Tools.TownResidents As Residents
Import Smile.Tools.TownDemo As Demo
Import Smile.Tools.TownMapPicker As MapPicker
Import Smile.Tools.TownViewportLayout As Toolbar
Import Smile.Tools.TownResidentInteraction As Conversation
Import Smile.Tools.NerisTownKeyboard As Keyboard
Import Smile.Simple3D.Character3D As Character
Import Smile.Tools.TownEditorSession As Editor
Import Smile.Tools.Character3DViewerCalibration As Calibration
Import Smile.Tools.NerisTownInspectionTests As Inspection
Import Smile.Tools.TownEditor As Commands
Import Smile.Tools.TownDocument As Document
Import Smile.Tools.TownTabs As Tabs
Import Smile.Tools.TownLibrary As Library
Import Smile.Tools.TownDocumentStore As Storage
Import Smile.Tools.TownMapLoadTools As MapLoadTools
Import Smile.Tools.TownMapLoads As MapLoads
Import Smile.Tools.TownDocumentMap As DocumentMap
Import Smile.Tools.TownCatalogData As Catalog
Import Smile.Tools.TownEditorPanel As Panel
Import Smile.Tools.TownSunControls As Sun
Import Smile.Tools.TownHistory As History
Import Smile.Simple3D.Graphics3D As G
Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.PrecisionMath3D As M
Import Smile.Simple3D.PrecisionCamera3D As Camera
Import Smile.Simple3D.ArenaCamera3D As Motion
Import Smile.Simple3D.ArenaViewport3D As Arena
Import Smile.Tools.NerisCastleRoute As Castle
Import Smile.Tools.NerisCastlePreview As CourtPreview
Import Smile.Tools.NerisCastleFountain As CourtWater
Import Smile.Tools.NerisSpaceportRoute As Spaceport
Import Smile.Tools.NerisSpaceportPreview As Harbor
Import Smile.Tools.NerisAlienFleet As Visitors
Import Smile.Tools.NerisHorizonRoute As Airport
Import Smile.Tools.NerisRunwayTraffic As Runway
Import Smile.Tools.NerisHorizonGlow As AirportGlow
Import Smile.Tools.NerisHorizonDownwash As Downwash
Import Smile.Tools.NerisTownConnections As Connections
Import Smile.Tools.NerisTownLandmarks As Landmarks
Import Smile.Tools.NerisTownParty As Party
Import Smile.Tools.NerisTownNavigation As Navigation
Import Smile.Tools.NerisSpaceportTraffic As Traffic
Import Smile.Tools.TownDocumentNavigation As DocumentNavigation
Import Smile.Tools.NerisTownCameraPanel As CameraPanel
Import Smile.Tools.NerisTownCamera As Drone
Import Smile.Simple3D.Core As Core

Dim Value As Town.State
Dim Index As Number
Dim Failures As Number
Dim Ok As Boolean
Dim KeyTotal As Number
Dim Draft As Document.State
Dim Controls As Commands.State
Dim Action As Number
Dim Shape As Catalog.Template
Dim OpenTabs As Tabs.State
Dim DemoOptions As Tabs.State
Dim SecondTown As Document.State
Dim AirportMapPoint As P.Vector3
Dim DustFlights As Traffic.State
Dim MapGesture As MapLoadTools.State
Dim BeforeSaveCamera As P.Camera3D
Dim BeforeSaveLeader As P.Vector3

Game Window "Town Editor Session Check" Size 1100 By 720

Call Commands.Start(Controls)

Action = Commands.Command(Controls, Draft, 3)
Shape = Catalog.TemplateAt(Controls.Ui.Template)

Call Check(Shape.Category = 3, "Changing Category Selects A Matching Placement Template")
Call CheckDecorPalette()
Call CheckDemoChoices()

Action = Commands.Command(Controls, Draft, 3)

Call Check(Controls.Ui.Category = 0 And Not Commands.CapturesMap(Controls),
    "Clicking Active Decor Category Releases Map For Panning")

Action = Commands.Command(Controls, Draft, 1)
Action = Commands.Command(Controls, Draft, 1)

Call Check(Controls.Ui.Category = 0 And Controls.Selected.SelectedCount = 0,
    "Buildings Toggle Off And Clear Selection")

Action = Commands.Command(Controls, Draft, 2)
Action = Commands.Command(Controls, Draft, 2)

Call Check(Controls.Ui.Category = 0 And Controls.Ui.Tool = 0,
    "Surfaces Toggle Off And Cancel The Paint Tool")
Call CheckSunGesture()
Call CheckSpecialToolSwitch()

Ok = Editor.Available()
Ok = Editor.StopDemoOnInput(KEY_E)

Call Editor.BeginEditing()
Call Town.Start(Value)

For Index = 0 To 180

    Call Town.LoadNext(Value)

    If Value.Ready Or Value.Failed Then
        Exit For
    End If

End For

Call Check(Value.Ready And Value.Edited And Not Value.Failed, "Editable Town And Party Load Together")

If Value.Ready And Editor.TownName() = "Neris Town" Then

    For Index = 0 To 8
        Call Residents.Update(Value.Residents, "Neris Town", False,
            Value.People.Path.Positions[0], 16)
    End For

    Call Check(Value.Residents.Loaded = 9 And Not Value.Residents.Failed,
        "Nine Residents Fit The Full Town Material Budget")

    For Index = 0 To 8
        Call Check(M.Distance(Value.Residents.People[Index].Motion.Position,
            P.Vector(0.0, 23.12, -2780.0)) > 300.0,
            "Every Resident Starts Away From Arin Spawn")
    End For

    Call CheckResidentConversation(Value)
    Call Residents.Destroy(Value.Residents)

End If

If Value.Horizon.Failed Then

    Print "Airport Load Stage " + Calibration.NumberText(Value.Horizon.Loaded)
    Print "Airport Objects " + Calibration.NumberText(Value.Horizon.ObjectCount)
    Print "Airport Parts " + Calibration.NumberText(Value.Horizon.Models[0].PartCount)
    Print "Airport Lights " + Calibration.NumberText(Value.Horizon.Lights.Particles.Handle)

End If

If Value.Horizon.Ready Then

    Call Check(Value.Horizon.Loaded = 4 And Value.Horizon.ObjectCount = 85 And
        Not Value.Harbor.Ready, "Gentle Wave Loads In Town Without Original Spaceport")
    Call Check(Value.Comparison.Ready, "Royal Court Is Preserved Beside Horizon")

    AirportMapPoint = Landmarks.AirportMapPosition()

    Call Check(Landmarks.AirportMapLabel() = "Horizon Airport" And
        AirportMapPoint.X = 8150.0 And AirportMapPoint.Z = 1250.0,
        "Minimap Includes Horizon At Its Actual Terminal Position")
    Call CheckFleetFrames(Value)
    Call CheckAirportEntry(Value)
    Call Check(Value.Horizon.Lights.Ready,
        "Tower Beacon And Both Runways And Fifty Six Floor Lights Load")
    Call CheckBeaconPattern()

    Call Check(AirportGlow.PARTICLE_COUNT = 201 And Value.Horizon.Dust.Ready,
        "Airport Lighting And Downwash Resources Are Ready")

    DustFlights.TransportTime = 60500

    Call Check(Downwash.Strength(DustFlights, False) > 0.8, "Ground Thrust Appears At Lift Off")

    DustFlights.TransportTime = 70000

    Call Check(Downwash.Strength(DustFlights, False) = 0.0, "Ground Thrust Stops Aloft")
    Call Town.Update(Value, 16)
    Call Town.ResetOverview(Value, True)
    Call Town.Update(Value, 16)
    Call Town.Draw(Value)
    Call Check(Not Value.Failed And Value.BaseCamera.Target.Z = 1250.0,
        "Horizon Draws At Its Western Town Placement")

Else

    Call Check(G.LiveModelCount3D() + 14 <= G.MaximumModelCount3D(),
        "Earlier Town Revisions Retain Fourteen Optional Tripo Model Slots")

End If

Print "Meshes " + Calibration.NumberText(G.LiveMeshCount3D())
Print "Materials " + Calibration.NumberText(G.LiveMaterialCount3D())
Print "Models " + Calibration.NumberText(G.LiveModelCount3D()) + "/" + Calibration.NumberText(G.MaximumModelCount3D())
Print "Castle Parts " + Calibration.NumberText(Value.Comparison.ObjectCount)

For Index = 0 To 14

    If Not Value.Comparison.Models[Index].GeometryReady Then
        Print "Missing Castle Model " + Calibration.NumberText(Index)
    End If

End For

If Value.Ready Then

    Call Town.Update(Value, 16)
    Call Town.Draw(Value)
    Call Town.Overlay(Value)
    Call Check(Not Value.Failed, "Editor Scene With Actors And Overlay Draws")
    Call Check(Value.Panel.MapTriangles > 100000 And Value.Panel.MapVertices > 100000,
        "Map Geometry Statistics Include The Loaded Town")
    Call CheckGeometryStatistics()
    Call CheckCourtPlacement()

    BeforeSaveCamera = Value.View.LiveCamera
    BeforeSaveLeader = Value.People.Path.Positions[0]
    Ok = Editor.UpdatePermanent("Neris Town")

    Call Town.Update(Value, 0)
    Call Check(Ok And M.Distance(BeforeSaveCamera.Position, Value.View.LiveCamera.Position) < 0.001 And
        M.Distance(BeforeSaveCamera.Target, Value.View.LiveCamera.Target) < 0.001 And
        BeforeSaveCamera.FovDegrees = Value.View.LiveCamera.FovDegrees And
        M.Distance(BeforeSaveLeader, Value.People.Path.Positions[0]) < 0.001,
        "Updating Permanent Map Preserves Camera Pose Zoom And Party Position")

    Call CheckRoadArrival(Value)

    Show Screen
    Value.People.Keys.KeyBase = 0

    For Index = 0 To 10
        KeyTotal = KeyTotal + Calibration.KeyCount(Value.People.Keys, Index)
    End For

    Print "Arin Pose Keys " + Calibration.NumberText(KeyTotal)

    Call Check(KeyTotal > 0, "Accepted Arin Calibration Is Retained")
    Call Town.Input(Value, KEY_1, False, True)
    Call Town.Update(Value, 16)

    Call Check(Not Value.PartyCamera And Not Value.Cinematic And
        Value.View.LiveCamera.Position.Y > Value.View.LiveCamera.Target.Y And
        Abs(Value.View.LiveCamera.Position.Z - Value.View.LiveCamera.Target.Z) <
            Abs(Value.View.LiveCamera.Position.Y - Value.View.LiveCamera.Target.Y) * 0.0003 And
        Abs(Value.View.LiveCamera.Position.X - Value.View.LiveCamera.Target.X) < 0.001,
        "One Key Selects A North Up Overhead Editor View Even Over The Header")

    Value.IdleOrbit = True
    Value.IdleTime = 10000

    Call Town.ResetOverview(Value)
    Call Check(Value.Cinematic And Value.OverviewOrbit And Not Value.IdleOrbit And
        Value.IdleTime = 0 And Not Value.OrbitPaused,
        "Demo Overview Immediately Orbits After An Idle Party Camera")
    Call Town.Input(Value, KEY_TAB, False)
    Call Check(Value.PartyCamera And Not Editor.Editing(), "Tab Leaves Editing And Follows The Party")
    Call Town.Input(Value, KEY_1, False)
    Call Town.Update(Value, 16)
    Call Check(Not Editor.Editing() And Not Value.Follow And
        Value.View.LiveCamera.Position.Y > Value.View.LiveCamera.Target.Y And
        Abs(Value.View.LiveCamera.Position.Z - Value.View.LiveCamera.Target.Z) <
            Abs(Value.View.LiveCamera.Position.Y - Value.View.LiveCamera.Target.Y) * 0.0003,
        "One Key Selects Top Down Outside Edit Town")
    Call Inspection.Run(Value, Failures)
    Call CheckVisibleDepth()

    If Editor.HasTown("Horizon Airport") Then
        Call CheckWalkingConnection(Value)
    End If

End If

Call Town.Destroy(Value)

Call Town.Start(Value)

For Index = 0 To 180

    Call Town.LoadNext(Value)

    If Value.Ready Or Value.Failed Then
        Exit For
    End If

End For

Call Town.Update(Value, 16)

AirportMapPoint = Editor.MapCenter()

Call Check(Value.Ready And Value.Cinematic And Not Value.PartyCamera And
    Value.People.Path.Positions[0].Z = -2780.0 And
    Abs(Value.View.LiveCamera.Target.X - AirportMapPoint.X) < 0.001 And
    Abs(Value.View.LiveCamera.Target.Z - AirportMapPoint.Z) < 0.001,
    "Reentering The Edited Town Starts Its Centered Overview Without Moving The Party")
Call Town.Destroy(Value)
Call Check(G.LiveMeshCount3D() = 0 And G.LiveMaterialCount3D() = 0 And G.LiveObjectCount3D() = 0,
    "Editable Town And Actor Resources Release")

Ok = Document.Blank(Draft, "Tab One", 12, 12, 20.0)
Ok = Document.Blank(SecondTown, "Tab Two", 12, 12, 20.0)
Draft.Light.Ambient = 37
Draft.Revision = Draft.Revision + 1
Ok = Tabs.Add(OpenTabs, Draft, SecondTown)

Call Check(Ok And OpenTabs.TabCount = 2 And Draft.Name = "Tab Two", "Open Creates A New Town Tab")

Ok = Tabs.SelectTab(OpenTabs, Draft, 0, False)

Call Check(Ok And Draft.Light.Ambient = 37 And Document.Dirty(Draft), "Switching Tabs Preserves Unsaved Edits")

Ok = Tabs.SelectTab(OpenTabs, Draft, 1, True)

Call Check(OpenTabs.TabCount = 1 And Draft.Name = "Tab One", "Closing Other Tab Preserves Current Document")

Ok = Tabs.SelectTab(OpenTabs, Draft, 0, True)

Call Check(Not Ok And OpenTabs.TabCount = 1, "Permanent Neris Tab Cannot Close")
Call CheckPermanentUpdates()
Call CheckGuideAndMapControls()

If Failures = 0 Then
    Print "PASS Town Editor Session"
Else
    Print "FAIL Town Editor Session"
End If

Sub Check(Condition As Boolean, Label As Text)

    If Not Condition Then
        Print "FAIL " + Label
        Failures = Failures + 1
    End If

End Sub

Sub CheckPermanentUpdates()

    Dim Destination As Text
    Dim MapIndex As Number
    Dim Saved As Boolean

    ' Seed all startup maps without changing the real Studio application identity.

    For MapIndex = 0 To 2

        Destination = "Neris Town"

        If MapIndex = 1 Then
            Destination = "Neris Spaceport"
        Else If MapIndex = 2 Then
            Destination = "Horizon Airport"
        End If

        Saved = Document.Blank(Draft, Destination, 12, 12, 20.0)
        Draft.Light.Ambient = 31 + MapIndex
        Saved = Library.Remember(Draft) And Saved

        Call Check(Saved, "Permanent Fixture Saves " + Destination)
    End For

    Saved = Library.Recover(Draft)
    OpenTabs.TabCount = 0

    Call Tabs.Ensure(OpenTabs, Draft)
    Call Check(Saved And OpenTabs.TabCount = 3, "Startup Restores All Three Permanent Maps")

    For MapIndex = 0 To 2

        Destination = OpenTabs.Documents[MapIndex].Name
        SecondTown = OpenTabs.Documents[MapIndex]
        Saved = Tabs.Add(OpenTabs, Draft, SecondTown)
        Draft.Light.Ambient = 61 + MapIndex
        Draft.CourtOffsetX = 125.5 + ToDouble(MapIndex)
        Draft.Revision = Draft.Revision + 1
        Saved = Tabs.UpdatePermanent(OpenTabs, Draft, Destination) And Saved

        Call Check(Saved And OpenTabs.Active = MapIndex And
            Draft.Name = Destination And Not Document.Dirty(Draft),
            "Reopened Copy Updates Its Permanent Tab: " + Destination)

        Saved = Library.RecoverNamed(SecondTown, Destination)

        Call Check(Saved And SecondTown.Light.Ambient = 61 + MapIndex And
            SecondTown.CourtOffsetX = 125.5 + ToDouble(MapIndex),
            "Permanent Contents Survive A Fresh Load: " + Destination)

        Saved = Storage.LoadDocument(SecondTown,
            "TownEditor.Recovery." + Destination + " Before Permanent Update")

        Call Check(Saved And SecondTown.Light.Ambient = 31 + MapIndex,
            "Previous Map Is Recoverable: " + Destination)
    End For

    Saved = Library.Recover(Draft)
    OpenTabs.TabCount = 0

    Call Tabs.Ensure(OpenTabs, Draft)
    Call Check(Saved And OpenTabs.TabCount = 3 And
        OpenTabs.Documents[0].Light.Ambient = 61 And
        OpenTabs.Documents[1].Light.Ambient = 62 And
        OpenTabs.Documents[2].Light.Ambient = 63,
        "Fresh Startup Retains All Three Independent Permanent Updates")

    Saved = Tabs.UpdatePermanent(OpenTabs, Draft, "Unknown Map")

    Call Check(Not Saved And OpenTabs.Active = 0 And Draft.Name = "Neris Town",
        "Invalid Permanent Destination Leaves Current Edits And Tabs Intact")

    Draft.CourtOffsetX = 1000000001.0
    Saved = Tabs.UpdatePermanent(OpenTabs, Draft, "Neris Spaceport")

    Call Check(Not Saved And OpenTabs.Active = 0 And
        Draft.CourtOffsetX = 1000000001.0 And OpenTabs.Documents[1].Light.Ambient = 62,
        "Failed Permanent Serialization Retains Current Edits And Destination")

    Saved = Library.RecoverNamed(SecondTown, "Neris Spaceport")

    Call Check(Saved And SecondTown.CourtOffsetX = 126.5,
        "Failed Update Does Not Replace Startup Data")

End Sub

Sub CheckGuideAndMapControls()

    Dim Chosen As Boolean
    Dim Point As P.Vector3
    Dim Other As P.Vector3
    Dim InkCount As Number
    Dim Ignored As Number

    Chosen = Document.Blank(Draft, "Map Choice Fixture", 12, 12, 20.0)
    InkCount = Controls.Guide.Ink.EntryCount
    Controls.Ui.HideGuides = False
    Ignored = Commands.Command(Controls, Draft, 96)

    Call Check(Controls.Ui.HideGuides And Controls.Guide.Ink.EntryCount = InkCount,
        "Hide Guides Retains Every Guide And Its Settings")

    Ignored = Commands.Command(Controls, Draft, 96)

    Call Check(Not Controls.Ui.HideGuides, "Show Guides Restores Visibility")
    Call MapLoadTools.Gesture(MapGesture, Draft, P.Vector(-110.0, 23.12, -110.0),
        True, True, True, 17)
    Call Check(MapGesture.Drawing And Not MapGesture.Pending And Draft.MapTileCount = 0,
        "Map Load Starts A Rectangle Without Asking For A Destination")
    Call MapLoadTools.Gesture(MapGesture, Draft, P.Vector(-90.0, 23.12, -90.0),
        True, False, False, 17)
    Call Check(MapGesture.Pending And Draft.MapTileCount = 0,
        "Released Rectangle Waits For A Destination Choice Without Painting")

    Chosen = MapLoadTools.Apply(MapGesture, Draft, "Neris Spaceport")

    Call Check(Chosen And Draft.MapTileCount = 4 And Not MapGesture.Pending,
        "Choosing An Available Map Commits The Complete Rectangle")
    Call MapLoadTools.Gesture(MapGesture, Draft, P.Vector(-110.0, 23.12, -110.0),
        True, True, True, 18)

    Chosen = MapLoadTools.Apply(MapGesture, Draft, "Horizon Airport")

    Call Check(Chosen And MapLoads.DestinationAt(Draft, -90.0, -90.0) = "Horizon Airport",
        "Map Choice Reassigns The Existing Connected Area")
    Call MapLoadTools.Gesture(MapGesture, Draft, P.Vector(-90.0, 23.12, -90.0),
        True, True, True, 19)
    Call Check(Draft.MapTileCount = 0 And Not MapGesture.Pending,
        "One Delete Gesture Removes The Whole Four Cell Map Load Rectangle")
    Call DocumentMap.SetZoom(Draft, P.Vector(0.0, 0.0, 0.0), 1)

    Point = DocumentMap.Pick(Draft, Window_Width() - 148, 387)
    Other = DocumentMap.Pick(Draft, Window_Width() - 20, 387)

    Call Check(Abs(Point.X) < 0.01 And Abs(Point.Z) < 0.01 And Other.X = 120.0,
        "Minimap Picks Match The Relocated Map At Full Extent")
    Call DocumentMap.SetZoom(Draft, P.Vector(0.0, 0.0, 0.0), 4)

    Other = DocumentMap.Pick(Draft, Window_Width() - 20, 387)

    Call Check(Other.X = 30.0, "Zoomed Minimap Picks Use The Visible World Extent")

    Point = DocumentMap.Pick(Draft, Window_Width() - 116, 419)

    Call DocumentMap.ZoomAt(Draft, Window_Width() - 116, 419, 8)

    Other = DocumentMap.Pick(Draft, Window_Width() - 116, 419)

    Call Check(M.Distance(Point, Other) < 0.001,
        "Minimap Zoom In Keeps The World Point Under The Pointer")
    Call DocumentMap.ZoomAt(Draft, Window_Width() - 116, 419, 4)

    Other = DocumentMap.Pick(Draft, Window_Width() - 116, 419)

    Call Check(M.Distance(Point, Other) < 0.001,
        "Minimap Zoom Out Keeps The World Point Under The Pointer")
    Call DocumentMap.ZoomAt(Draft, Window_Width() - 20, 259, 1)

    Other = DocumentMap.Pick(Draft, Window_Width() - 20, 259)

    Call Check(Other.X = 120.0 And Other.Z = 120.0,
        "Minimap Full Zoom Stays Within The Map Edges")
    Call DocumentMap.Pan(Draft, 32, 16)

    Other = DocumentMap.Pick(Draft, Window_Width() - 116, 403)

    Call Check(Abs(Other.X) < 0.01 And Abs(Other.Z) < 0.01,
        "Panning Moves The Same World Point With The Pointer")
    Call DocumentMap.Pan(Draft, 10000, -10000)

    Other = DocumentMap.Pick(Draft, Window_Width() - 148, 387)

    Call Check(Other.X = -120.0 And Other.Z = -120.0,
        "Minimap Pan Remains Bounded At The Map Edges")

End Sub

Sub CheckFleetFrames(ByRef Value As Town.State)

    Dim Step As Number
    Dim Frame As Number
    Dim Pose As P.Transform3D
    Dim Ok As Boolean
    Dim Expected As P.Vector3

    For Step = 0 To 6

        Select Case Step
            Case 0
                Frame = 0
            Case 1
                Frame = 37500
            Case 2
                Frame = 65000
            Case 3
                Frame = 115000
            Case 4
                Frame = 125000
            Case 5
                Frame = 142500
            Case 6
                Frame = 150000
        End Select

        Value.Horizon.Flights.TransportTime = Frame Mod 120000
        Value.Horizon.Flights.RoyalTime = Frame

        Call Town.Draw(Value)

        Ok = P.TryTransform(Value.Horizon.Objects[Value.Horizon.FirstPart[2]], Pose)

        Call Check(Not Value.Failed And Ok, "Fleet Key Phases Draw With The Complete Town")

        Expected = Airport.ToWorld(Traffic.Position(Value.Horizon.Flights, True))

        If Traffic.Visible(Value.Horizon.Flights, True) Then
            Call Check(Abs(Pose.Position.X - Expected.X) < 0.001 And
                Abs(Pose.Position.Y - Expected.Y) < 0.001 And Abs(Pose.Position.Z - Expected.Z) < 0.001,
                "Royal Hull Uses The Rotated West Airport Placement")
            Call Check(Abs(Pose.Rotation.Y - Airport.YAW) < 0.01,
                "Hangar Spacecraft Nose Faces Outward Toward The Front Apron")
        End If

    End For

    Value.Horizon.Flights.TransportTime = 0
    Value.Horizon.Flights.RoyalTime = 0

End Sub

Sub CheckBeaconPattern()

    Dim Time As Number
    Dim Beacon As Number
    Dim Active As Number
    Dim Seen[3] As Boolean

    For Time = 0 To 576

        Active = 0

        For Beacon = 0 To 2

            If AirportGlow.BeaconOn(Time * 100, Beacon) Then
                Active = Active + 1
                Seen[Beacon] = True
            End If

        End For

        Call Check(Active <= 1, "Antenna Beacons Never Flash Together")
    End For

    Call Check(Seen[0] And Seen[1] And Seen[2], "All Three Antenna Tips Flash In The Irregular Sequence")

End Sub

Sub CheckAirportEntry(ByRef Value As Town.State)

    Dim Before As P.Vector3
    Dim Point As P.Vector3
    Dim Step As Number
    Dim Running As Boolean
    Dim Speed As Number
    Dim Pose As P.Transform3D
    Dim Expected As P.Vector3
    Dim Ok As Boolean

    Before = Value.People.Path.Positions[0]
    Running = Value.People.Running
    Speed = Value.People.SpeedPercent
    Value.People.Running = True
    Value.People.SpeedPercent = 200

    Call Town.VisitAirport(Value)

    Point = Value.People.Path.Positions[0]

    Call Check(Abs(Point.X - 6950.0) < 0.01 And Abs(Point.Z - 1250.0) < 0.01 And
        Value.Follow And Value.PartyCamera And Not Value.Cinematic,
        "Visit Horizon Airport Places Arin At The Entrance In Party Follow Mode")
    Call Check(Value.BaseCamera.Position.X < Point.X And Value.BaseCamera.Target.X > Point.X,
        "Airport Arrival Camera Looks From Arins Back Toward The Entrance")

    For Step = 1 To 37
        Call Town.MoveParty(Value, P.Vector(1.0, 0.0, 0.0), 200)
        Call Airport.Update(Value.People.Path, 4, 200)
    End For

    For Step = 0 To 3
        Point = Value.People.Path.Positions[Step]

        Call Check(Point.X > 7800.0 And Abs(Point.Y - 31.12) < 0.01 And
            Navigation.CanStand(Point.X, Point.Z), "Arin And Each Follower Enter The Terminal From The Town Road")
    End For

    Call Town.Draw(Value)
    Call Check(Not Value.Failed, "Terminal Entry Draws With The Complete Party And Airport")

    For Step = 0 To 7

        Select Case Step
            Case 0
                Value.Horizon.RunwayFlight.Time = 0
            Case 1
                Value.Horizon.RunwayFlight.Time = 65000
            Case 2
                Value.Horizon.RunwayFlight.Time = 10000
            Case 3
                Value.Horizon.RunwayFlight.Time = 20000
            Case 4
                Value.Horizon.RunwayFlight.Time = 32000
            Case 5
                Value.Horizon.RunwayFlight.Time = 37000
            Case 6
                Value.Horizon.RunwayFlight.Time = 53000
            Case 7
                Value.Horizon.RunwayFlight.Time = 71000
        End Select

        Call Town.Draw(Value)

        Ok = P.TryTransform(Value.Horizon.Objects[Value.Horizon.RunwayFirst], Pose)
        Expected = Airport.ToWorld(Runway.Position(Value.Horizon.RunwayFlight))

        Call Check(Ok And Not Value.Failed And Abs(Pose.Position.X - Expected.X) < 0.01 And
            Abs(Pose.Position.Y - Expected.Y) < 0.01 And Abs(Pose.Position.Z - Expected.Z) < 0.01,
            "Third Aircraft Actually Draws At Its Runway Flight And Taxi Positions")
        Call Check(Abs(Pose.Rotation.Y - Runway.Heading(Value.Horizon.RunwayFlight)) < 0.01 And
            Abs(Pose.Rotation.X - Runway.Pitch(Value.Horizon.RunwayFlight)) < 0.01,
            "Actual Runway Draw Uses The Corrected Nose-First Orientation")
    End For

    Value.Horizon.RunwayFlight.Time = 0
    Value.People.Running = Running
    Value.People.SpeedPercent = Speed

    Call Party.Teleport(Value.People, Before)

    Print "Airport: Visit Button And Four Party Members Enter; Runway Fleet Draws Nose First; Three Alternating Beacons Ready"

End Sub

Sub CheckWalkingConnection(ByRef Value As Town.State)

    Dim Step As Number
    Dim BeforeModels As Number
    Dim BeforeMeshes As Number
    Dim RoadPoint As P.Vector3
    Dim FoundRoad As Boolean

    Call LoadResidents(Value)

    BeforeModels = G.LiveModelCount3D()
    BeforeMeshes = G.LiveMeshCount3D()

    Call Check(Not Value.Horizon.Ready And Value.Comparison.Ready,
        "Compact Town Has Royal Court Without Airport")
    Call CheckNightToggle(Value)
    Call Party.Teleport(Value.People, P.Vector(-5120.0, 23.12, 900.0))
    Call Town.MoveParty(Value, P.Vector(-1.0, 0.0, 0.0), 200)
    Call Check(Editor.TownName() = "Neris Spaceport", "West Road Travels To Neris Spaceport")

    ' A failed previous scene must not lock the newly selected destination out.
    Value.Ready = False
    Value.Failed = True

    Call LoadArrival(Value)
    Call Check(Not Value.Residents.Enabled And Value.Residents.Loaded = 0,
        "Leaving Neris Releases Its Nine Residents Before Loading The Airport")
    Call Check(Value.Harbor.Ready And Not Value.Horizon.Ready And Not Value.Comparison.Ready,
        "West Map Loads Only The Original Spaceport")
    Call Check(Value.Harbor.Doors.Ready And Value.Harbor.Light.Ready, "Original Doors And Crystals Remain Ready")
    Call CheckAlienVisitors(Value)
    Call Inspection.MapOrbit(Value, Failures)
    Call Inspection.RightClickOrbit(Value, Failures)
    Call CheckNightToggle(Value)
    Call Check(Connections.Destination(Editor.TownName(), Value.People.Path.Positions[0], True) = "",
        "Spaceport Arrival Does Not Bounce Back")
    Call Party.Teleport(Value.People, P.Vector(-1380.0, 23.12, -3500.0))
    Call Town.MoveParty(Value, P.Vector(1.0, 0.0, 0.0), 200)
    Call Check(Editor.TownName() = "Neris Town", "Spaceport East Road Returns To Town")
    Call LoadArrival(Value)
    Call Check(Value.People.Path.Positions[0].X = -4950.0, "Party Returns At The West Town Gate")
    Call Party.Teleport(Value.People, P.Vector(2670.0, 23.12, -1000.0))
    Call Town.MoveParty(Value, P.Vector(1.0, 0.0, 0.0), 200)
    Call Check(Editor.TownName() = "Horizon Airport", "East Road Travels To Horizon Airport")
    Call LoadArrival(Value)
    Call Check(Value.Horizon.Ready And Value.Horizon.Doors.Ready And
        Not Value.Harbor.Ready And Not Value.Comparison.Ready, "East Map Loads Horizon And Operable Doors")
    Call Check(Landmarks.AirportMapLabel() = "Horizon Airport", "Airport Has Its Minimap Marker")

    FoundRoad = DocumentNavigation.NearestRoad(P.Vector(5340.0, 0.0, 1250.0), RoadPoint)

    Call Check(FoundRoad And RoadPoint.X < 5400.0,
        "Ctrl Click Finds The Connecting Road Outside The Airport")
    Call Party.Teleport(Value.People, RoadPoint)

    For Step = 1 To 14
        Call Town.MoveParty(Value, P.Vector(1.0, 0.0, 0.0), 100)
    End For

    For Step = 0 To Value.People.MemberCount - 1
        Call Check(Value.People.Path.Positions[Step].X > 5450.0,
            "Teleported Party Crosses The Road Divider Into The Airport")
    End For

    Call CheckNightToggle(Value)
    Call CheckFleetFrames(Value)
    Call Inspection.MapOrbit(Value, Failures)
    Call Inspection.RightClickOrbit(Value, Failures)
    Call CheckBeaconPattern()
    Call CheckAirportEntry(Value)
    Call Check(Airport.ConsumeEntry(), "Terminal Crossing Emits A Cutscene Entry Event")
    Call Check(Not Airport.ConsumeEntry(), "Terminal Entry Event Is Consumed Only Once")
    Call Party.Teleport(Value.People, Connections.Arrival("Horizon Airport"))

    For Step = 1 To 16

        Call Town.MoveParty(Value, P.Vector(-1.0, 0.0, 0.0), 100)

        If Editor.TownName() <> "Horizon Airport" Then
            Exit For
        End If

    End For

    Call Check(Editor.TownName() = "Neris Town", "Airport West Road Returns To Town")
    Call LoadArrival(Value)
    Call Check(Value.People.MemberCount = 4 And Value.People.Path.Positions[0].X = 2500.0,
        "All Four Party Members Return At The East Town Gate")
    Call LoadResidents(Value)
    Call Check(G.LiveModelCount3D() = BeforeModels And G.LiveMeshCount3D() = BeforeMeshes,
        "Three Map Round Trip Releases All Airport Resources")

    Print "Walking: West Spaceport And East Horizon Round Trips, Four Members, Door Entry, Day Night, No Resource Growth"

End Sub

Sub CheckResidentConversation(ByRef Value As Town.State)

    Dim Saved As P.Vector3
    Dim SavedView As Arena.State
    Dim SavedBase As P.Camera3D
    Dim SavedFlight As Drone.State
    Dim SavedFollow As Boolean
    Dim SavedParty As Boolean
    Dim SavedCinematic As Boolean
    Dim WasEditing As Boolean
    Dim Npc As P.Vector3
    Dim LeaderRotation As P.Vector3
    Dim NpcRotation As P.Vector3
    Dim LeaderForward As P.Vector3
    Dim NpcForward As P.Vector3
    Dim Shot As P.Camera3D
    Dim Pixel As Camera.ProjectedPoint
    Dim Bounds As Character.PreciseBounds3D
    Dim Held As Keyboard.HeldKeys
    Dim MemberIndex As Number
    Dim SavedOpacity[8] As Double
    Dim Ok As Boolean

    Saved = Value.People.Path.Positions[0]
    SavedView = Value.View
    SavedBase = Value.BaseCamera
    SavedFlight = Value.Flight
    SavedFollow = Value.Follow
    SavedParty = Value.PartyCamera
    SavedCinematic = Value.Cinematic
    WasEditing = Editor.Editing()

    Call Editor.Input(Value.View.LiveCamera, KEY_TAB, False)

    Npc = Value.Residents.People[0].Motion.Position

    Call Party.Teleport(Value.People, M.Add(Npc, P.Vector(24.0, 0.0, 0.0)))

    Value.Residents.Speaking = 0

    For MemberIndex = 1 To Value.People.MemberCount - 1
        SavedOpacity[MemberIndex] = Value.People.Members[MemberIndex].Opacity
        Value.People.Members[MemberIndex].Opacity = 35.0
    End For

    Call Town.AdvanceKeyboard(Value, Held, 16)
    Call Residents.Update(Value.Residents, "Neris Town", False, Value.People.Path.Positions[0], 16)

    Call Check(Value.ConversationFramed And Value.Follow And Value.PartyCamera And
        Value.View.TransitionDuration = 1000 And Value.Flight.Focusing,
        "Conversation Uses The Same Eased Party Focus As Tab")

    Value.View.TransitionElapsed = 400

    Call Town.Input(Value, KEY_NONE, False)
    Call Town.AdvanceKeyboard(Value, Held, 16)
    Call Check(Value.View.TransitionElapsed = 400 And Value.Flight.Focusing,
        "Ongoing Conversation Does Not Restart The Camera Transition")
    Call Check(Value.People.Members[0].Visible, "Conversation Keeps The Party Leader Visible")

    For MemberIndex = 1 To Value.People.MemberCount - 1
        Call Check(Not Value.People.Members[MemberIndex].Visible,
            "Conversation Hides Partially Faded Companions Completely")
    End For

    Ok = Character.TryRotation(Value.People.Members[0].Body.Actor, LeaderRotation)
    Ok = Character.TryRotation(Value.Residents.People[0].Actor, NpcRotation) And Ok
    LeaderForward = M.Rotate(P.Vector(0.0, 0.0, -1.0), LeaderRotation)
    NpcForward = M.Rotate(P.Vector(0.0, 0.0, -1.0), NpcRotation)

    Call Check(Ok And M.Dot(LeaderForward, NpcForward) < -0.99 And LeaderForward.X < -0.99,
        "Presented Party Leader And Resident Face Each Other During Dialogue")

    Bounds = Character.WorldBoundsPrecise(Value.Residents.People[0].Actor)
    Shot = Value.View.LiveCamera
    Shot.Target = Bounds.Center
    Shot.Position = M.Add(Bounds.Center, P.Vector(0.0, 10.0, 70.0))
    Pixel = Camera.ProjectViewerPoint(Bounds.Center, Shot, 1100, 720)

    Call Check(Conversation.Pick(Value.Residents, Shot, ToNumber(Pixel.X), ToNumber(Pixel.Y), 1100, 720) = 0,
        "Click Picking Finds The Displayed Resident Body")

    Value.View.LiveCamera = Shot
    Value.Follow = True
    Value.PartyCamera = True
    Value.IdleOrbit = True
    Value.Cinematic = True

    Call Town.UpdateIdle(Value, True, 0)

    Value.BaseCamera = Drone.Frame(Value.Flight, Value.BaseCamera,
        Value.People.Path.Positions[0], Value.People.Members[0].Yaw, False, 16)

    Call Drone.Compose(Value.Flight, Value.View, Value.BaseCamera, True, 16, True)
    Call Check(Not Value.Cinematic And Not Value.IdleOrbit And
        M.Distance(Shot.Position, Value.View.LiveCamera.Position) < 0.01 And
        M.Distance(Shot.Target, Value.View.LiveCamera.Target) < 0.01,
        "Waking Idle Orbit For Conversation Keeps The Displayed Shot")

    Value.Residents.Speaking = -1
    Value.ConversationFramed = False

    Call Party.Stand(Value.People, 16)

    For MemberIndex = 1 To Value.People.MemberCount - 1
        Call Check(Value.People.Members[MemberIndex].Visible And
            Value.People.Members[MemberIndex].Opacity = 35.0,
            "Ending Conversation Restores Normal Companion Presentation")

        Value.People.Members[MemberIndex].Opacity = SavedOpacity[MemberIndex]
    End For

    Value.View = SavedView
    Value.BaseCamera = SavedBase
    Value.Flight = SavedFlight
    Value.Follow = SavedFollow
    Value.PartyCamera = SavedParty
    Value.Cinematic = SavedCinematic

    If WasEditing Then
        Call Editor.BeginEditing()
    End If

    Call Party.Teleport(Value.People, Saved)

End Sub

Sub CheckDemoChoices()

    Dim Ok As Boolean

    DemoOptions.TabCount = 3
    DemoOptions.Documents[0].Name = "Demo Fixture A"
    DemoOptions.Documents[1].Name = "Demo Fixture B"
    DemoOptions.Documents[2].Name = "Demo Fixture C"
    Ok = Demo.SetIncluded(DemoOptions.Menu.Showcase, DemoOptions.Documents[0].Name, True)
    Ok = Demo.SetIncluded(DemoOptions.Menu.Showcase, DemoOptions.Documents[1].Name, False) And Ok
    Ok = Demo.SetIncluded(DemoOptions.Menu.Showcase, DemoOptions.Documents[2].Name, True) And Ok

    Call Check(Ok And Tabs.NextDemo(DemoOptions) = 2, "Demo Skips Excluded Maps")

    DemoOptions.Active = 2

    Call Check(Tabs.NextDemo(DemoOptions) = 0, "Demo Wraps To The Next Included Map")

    Ok = Demo.SetIncluded(DemoOptions.Menu.Showcase, DemoOptions.Documents[0].Name, False)

    Call Check(Ok And Tabs.NextDemo(DemoOptions) = -1, "One Included Map Keeps Orbiting Without Reloading")

    Ok = Demo.SetIncluded(DemoOptions.Menu.Showcase, DemoOptions.Documents[2].Name, False)

    Call Check(Ok And Tabs.NextDemo(DemoOptions) = -1, "No Included Maps Starts No Map Load")
    Call Check(MapPicker.DemoHit(110, 345, 0, 14) = 0 And
        MapPicker.DemoHit(110, 260, 0, 14) = -1,
        "Demo Button Hit Is Separate From The Thumbnail")
    Call Check(Toolbar.ButtonLeft(2) + Toolbar.Width(2) = Window_Width() - 18,
        "Edit Town Ends The Toolbar At The Right Margin")

End Sub

Sub LoadResidents(ByRef Value As Town.State)

    Dim Step As Number

    For Step = 0 To 8
        Call Residents.Update(Value.Residents, "Neris Town", False,
            Value.People.Path.Positions[0], 16)
    End For

    Call Check(Value.Residents.Loaded = 9 And Not Value.Residents.Failed,
        "Resident Loading Completes Before Comparing Town Resource Counts")

End Sub

Sub CheckAlienVisitors(ByRef Value As Town.State)

    Dim Ship As Number
    Dim Stage As Number
    Dim Point As P.Vector3
    Dim Ground As P.Vector3
    Dim Pose As P.Transform3D
    Dim Ok As Boolean

    Call Check(Value.Harbor.Visitors.Ready And Value.Harbor.Visitors.Loaded = 4,
        "Four Distinct Alien Models Load With The Original Spaceport")

    For Ship = 0 To 3

        Value.Harbor.Visitors.Stage[Ship] = 2
        Value.Harbor.Visitors.Clock[Ship] = 0

        Call Visitors.Schedule(Value.Harbor.Visitors, Ship)
        Call Check(Value.Harbor.Visitors.Duration[Ship] >= 10000 And
            Value.Harbor.Visitors.Duration[Ship] <= 15000,
            "Each Pad Has Ten To Fifteen Seconds Completely Clear Before Approach")
    End For

    Call Visitors.Update(Value.Harbor.Visitors, 9999)

    For Ship = 0 To 3
        Call Check(Not Visitors.Visible(Value.Harbor.Visitors, Ship),
            "No Craft Appears During The Minimum Clear Interval")
    End For

    For Ship = 0 To 3

        For Stage = 0 To 3

            Value.Harbor.Visitors.Stage[Ship] = Stage
            Value.Harbor.Visitors.Duration[Ship] = 6000
            Value.Harbor.Visitors.Clock[Ship] = 3000
            Point = Visitors.Position(Value.Harbor.Visitors, Ship)

            If Stage = 0 Then
                Ground = Point
            Else If Stage = 1 Or Stage = 3 Then
                Call Check(Abs(Point.Y - Ground.Y - 3500.0) < 0.01,
                    "Visitor Ascends And Descends Vertically Above Its Own Pad")
            End If

            Call Town.Draw(Value)

            Ok = P.TryTransform(Value.Harbor.Visitors.Objects[Ship * 3], Pose)

            If Stage <> 2 Then
                Call Check(Ok And Abs(Pose.Position.Y - Point.Y) < 0.01,
                    "Alien Model Draws At Its Current Flight Position")
            End If

        End For

        Value.Harbor.Visitors.Stage[Ship] = 0
        Value.Harbor.Visitors.Clock[Ship] = 0

        Call Visitors.Schedule(Value.Harbor.Visitors, Ship)
    End For

    Print "Alien Visitors: Four Models, Four Pads, Independent Random Schedules, Guaranteed Clear Interval"

End Sub

Sub LoadArrival(ByRef Value As Town.State)

    Dim Step As Number
    Dim Center As P.Vector3
    Dim Depth As Double
    Dim Picked As Boolean
    Dim Background As Number

    Background = Value.View.BackgroundIndex

    ' The selection has changed but the previous scene is still fully resident.

    Call Town.Draw(Value)

    Show Screen

    Picked = P.TryCursorDepth(Window_Width() / 2, Window_Height() / 2,
        Window_Width(), Window_Height(), Depth)

    Call Check(Not Value.Ready And Not Picked And Value.View.BackgroundIndex = Background,
        "Changing Town Hides Every Old Object And Keeps The Static Background")

    For Step = 0 To 180

        Call Town.Update(Value, 16)

        If Value.Ready Then
            Exit For
        End If

    End For

    Call Town.Draw(Value)
    Call Check(Value.Ready And Not Value.Failed, "Destination And Party Draw After Travel")
    Call Check(Value.Follow And Value.PartyCamera,
        "First Complete Destination Frame Already Uses Its Arrival Camera")

    Center = Editor.MapCenter()

    Call Check(Abs(ToDouble(Value.View.Floor.Floor.Position.X) - Center.X) < 0.01 And
        Abs(ToDouble(Value.View.Floor.Grid.Position.Z) - Center.Z) < 0.01,
        "Floor And Grid Follow The Selected Map Center")

    If Editor.TownName() = "Horizon Airport" Then
        Call Check(Value.View.Floor.Width = 6400 And Value.View.Floor.Depth = 10000,
            "Horizon Floor Exactly Matches Its Map Dimensions")
    Else If Editor.TownName() = "Neris Spaceport" Then
        Call Check(Value.View.Floor.Width = 8000 And Value.View.Floor.Depth = 6800,
            "Spaceport Floor Exactly Matches Its Map Dimensions")
    Else

        Call Check(Value.View.Floor.Width = 7950 And Value.View.Floor.Depth = 7650,
            "Neris Floor Exactly Matches Its Compact Map Dimensions")
    End If

End Sub

Sub CheckRoadArrival(ByRef Value As Town.State)

    Dim Point As P.Vector3
    Dim Arrival As P.Vector3
    Dim Found As Boolean

    Point = P.Vector(-4000.0, 23.12, -1000.0)
    Found = DocumentNavigation.NearestRoad(Point, Arrival)

    Call Check(Found And DocumentNavigation.CanStand(Arrival.X, Arrival.Z),
        "Click In Empty Western Field Finds A Walkable Road")
    Call Town.MoveToRoad(Value, Point)
    Call Check(Value.People.Path.Positions[0].X = Arrival.X And
        Value.People.Path.Positions[0].Z = Arrival.Z And Value.People.MemberCount = 4,
        "Road Click Relocates Arin And The Party")

End Sub

Sub CheckGeometryStatistics()

    Dim Plane As Core.Object3D
    Dim Stats As CameraPanel.State
    Dim Ok As Boolean

    Plane = G.CreatePlane3D(100, 100)
    Ok = G.BeginAcceptedCamera3D(0, 0, 0)

    Call G.SetObjectPosition(Plane, 0, 0, 0)

    Ok = G.DrawObject3D(Plane) And Ok

    Call G.SetObjectPosition(Plane, 50000, 0, 0)

    Ok = G.DrawObject3D(Plane) And Ok

    Call CameraPanel.CaptureGeometry(Stats)
    Call Check(Ok And Stats.MapTriangles = 4 And Stats.MapVertices = 8,
        "Geometry Counts Both Mesh Instances Including Offscreen Without Extra Passes")

    Ok = G.End3DChecked() And Ok

    Call G.DestroyObject3D(Plane)

End Sub

Sub CheckNightToggle(ByRef Value As Town.State)

    Dim Before As Boolean
    Dim Position As P.Vector3

    Before = Editor.IsNight()
    Position = Value.People.Path.Positions[0]

    Call Editor.ToggleDayNight()
    Call Town.Update(Value, 16)
    Call Town.Draw(Value)
    Call Check(Editor.IsNight() <> Before And Not Value.Failed, "Header Toggle Changes Day And Night")
    Call Editor.ToggleDayNight()
    Call Town.Update(Value, 16)
    Call Check(Editor.IsNight() = Before And Value.People.Path.Positions[0].X = Position.X,
        "Day Night Toggle Restores Lighting Without Moving The Party")

End Sub

Sub CheckVisibleDepth()

    Dim Depth As Double
    Dim Hit As P.Vector3
    Dim Ok As Boolean
    Dim BeforeMeshes As Number

    BeforeMeshes = G.LiveMeshCount3D()
    Value.Cinematic = False
    Value.Follow = False
    Value.Flight.CursorOrbit = False
    Value.BaseCamera.Position = P.Vector(Castle.ORIGIN_X, 1400.0, Castle.ORIGIN_Z - 0.1)
    Value.BaseCamera.Target = P.Vector(Castle.ORIGIN_X, Castle.DECK_Y, Castle.ORIGIN_Z)
    Value.View.MaximumPitch = 1.57072

    Call Motion.Reset(Value.View.Controls, Value.View.Zoom)
    Call Town.Update(Value, 0)
    Call Town.Draw(Value)

    Call Check(Not Value.Failed, "Top Down Depth Frame Draws")

    Ok = P.TryCursorDepth(Window_Width() / 2, Window_Height() / 2,
        Window_Width(), Window_Height(), Depth)
    Hit = Camera.CursorPointAtDepth(Value.View.LiveCamera, Window_Width() / 2,
        Window_Height() / 2, Depth, Window_Width(), Window_Height())

    Call Check(Ok And Abs(Hit.Y - Castle.DECK_Y) < 2.0,
        "Native Cursor Depth Hits The Rendered Courtyard Floor")
    Call Check(G.LiveMeshCount3D() = BeforeMeshes, "Cursor Picking Allocates No Meshes")

End Sub

Sub CheckDecorPalette()

    Dim Seen[Catalog.TEMPLATE_COUNT] As Number
    Dim Page As Number
    Dim Slot As Number
    Dim VisibleCount As Number
    Dim Item As Number
    Dim Entry As Catalog.Template
    Dim Command As Number

    For Page = 0 To 14 / Panel.PaletteRows()

        Call Panel.Draw(Controls.Ui, Draft, Controls.Guide, 0)

        For Slot = 0 To Controls.Ui.ControlCount - 1

            Item = Controls.Ui.Controls[Slot].Action - 100

            If Item >= 0 And Item < Catalog.TEMPLATE_COUNT Then
                Seen[Item] = Seen[Item] + 1
                VisibleCount = VisibleCount + 1
            End If

        End For

        Command = Commands.Command(Controls, Draft, 21)
    End For

    Call Check(VisibleCount = 15 And Seen[20] = 1 And Seen[27] = 1,
        "Decor Pages Include Four Landforms And One Of Each Consolidated Ornament")
    Call Check(Controls.Ui.Page = 14 / Panel.PaletteRows(),
        "Next Stops At The Last Consolidated Decor Page")

    For Item = 14 To Catalog.TEMPLATE_COUNT - 1
        Entry = Catalog.TemplateAt(Item)

        Call Check((Entry.PaletteVisible And Seen[Item] = 1) Or
            (Not Entry.PaletteVisible And Seen[Item] = 0), "Palette Visibility Matches Clickable Entries")
        Call Check(Entry.PartCount > 0, "Hidden Copies Retain Existing Town Geometry")
    End For

    Entry = Catalog.TemplateAt(33)

    Call Check(Entry.Label = "Civic Plaza Sign" And Seen[33] = 1, "Civic Sign Keeps Its Own Lettering")

    Entry = Catalog.TemplateAt(34)

    Call Check(Entry.Label = "Market Walk Sign" And Seen[34] = 1, "Market Sign Keeps Its Own Lettering")

    For Item = 20 To 25
        Entry = Catalog.TemplateAt(Item)

        Call Check(Entry.PreviewIndex = 20, "Repeated Fountains Share One Thumbnail")
    End For

    For Item = 27 To 32
        Entry = Catalog.TemplateAt(Item)

        Call Check(Entry.PreviewIndex = 22, "Repeated Crystal Circles Share One Thumbnail")
    End For

    For Item = 35 To 38
        Entry = Catalog.TemplateAt(Item)

        Call Check(Entry.PreviewIndex = Item - 10, "Each Landform Has Its Own Thumbnail")
    End For

    Call Panel.Release(Controls.Ui)

End Sub

Sub CheckSunGesture()

    Dim Step As Number
    Dim Before As Number
    Dim Command As Number

    Call Document.DefaultSun(Draft.Light)
    Call Check(Draft.Light.Azimuth = 207.0, "Day Preset Defaults To Sun Azimuth 207")
    Call Commands.ResetHistory(Controls, Draft)

    Controls.Ui.SunSlider.Original = Draft.Light
    Controls.Ui.SunSlider.Revision = Draft.Revision
    Controls.Ui.SunSlider.DragOwner = 5

    For Step = 40 To 65
        Call Sun.SetValue(Draft, 4, Step)
    End For

    Call Check(Draft.Light.Ambient = 65 And History.UndoCount(Controls.HistoryState) = 0,
        "Sun Drag Previews Without Filling Undo History")
    Call Commands.Cancel(Controls, Draft)
    Call Check(Draft.Light.Ambient = 38 And Controls.Ui.SunSlider.DragOwner = 0,
        "Cancel Restores The Original Sun Settings")
    Call Sun.SetValue(Draft, 4, 65)
    Call History.Record(Controls.HistoryState, Draft, Controls.Guide.Ink)

    Command = Commands.Command(Controls, Draft, 32)

    Call Check(Draft.Light.Ambient = 38, "One Undo Restores Sun Before Drag")

    Command = Commands.Command(Controls, Draft, 33)

    Call Check(Draft.Light.Ambient = 65, "Redo Restores The Final Sun Value")
    Call Sun.SetValue(Draft, 5, 360)

    Before = Draft.Revision

    Call Sun.SetValue(Draft, 5, 360)
    Call Check(Sun.Reading(Draft.Light, 5) = 360 And Draft.Revision = Before,
        "Holding Azimuth Endpoint Does Not Continuously Revise The Town")
    Call Sun.SetValue(Draft, 6, -100)
    Call Sun.SetValue(Draft, 3, 2000)
    Call Check(Draft.Light.Elevation = -85.0 And Draft.Light.Intensity = 1000,
        "Sun Sliders Clamp To Supported Settings")

    Draft.Light.ShadowOpacity = -1

    Call Sun.SetValue(Draft, 7, 65)
    Call Check(Draft.Light.ShadowOpacity = 65,
        "Choosing The Legacy Shadow Slider Position Commits Explicit Opacity")

    Command = Commands.Command(Controls, Draft, 222)

    Call Check(Draft.Light.RedValue = 140 And Draft.Light.GreenValue = 174 And
        Draft.Light.BlueValue = 255 And Draft.Light.Intensity = 8 And Draft.Light.Ambient = 8 And
        Draft.Light.Azimuth = 207.0 And Draft.Light.Elevation = 25.0 And
        Draft.Light.ShadowOpacity = 65 And Draft.Light.Shadows,
        "Night Button Applies The Accepted Moonlight Preset")

    Command = Commands.Command(Controls, Draft, 221)

    Call Check(Draft.Light.Intensity = 260 And Draft.Light.Azimuth = 207.0,
        "Day Button Restores Daylight At Azimuth 207")

End Sub

Sub CheckSpecialToolSwitch()

    Dim Ignored As Number
    Dim View As P.Camera3D

    View.Position = P.Vector(0.0, 1000.0, -1000.0)
    View.Target = P.Vector(0.0, 0.0, 0.0)
    View.UpDirection = P.Vector(0.0, 1.0, 0.0)
    View.FovDegrees = 45.0
    View.NearPlane = 1.0
    View.FarPlane = 25000.0

    Ignored = Commands.Command(Controls, Draft, 4)
    Ignored = Commands.Command(Controls, Draft, 53)
    Ignored = Commands.Command(Controls, Draft, 86)
    Controls.Ui.Message = "Guide selection active."
    Controls.SectionGesture.Message = "Old section status."
    Ignored = Commands.Input(Controls, Draft, View, 0, True)

    Call Check(Controls.Ui.Tool = 70 And Controls.Ui.Message = "Guide selection active.",
        "Guide Selection Remains Active After Bulk Sections")

    Controls.CourtGesture.Message = "Old placement status."

    Call Commands.Cancel(Controls, Draft)
    Call Check(Controls.CourtGesture.Message = "", "Cancel Clears Stale Court Status Before Undo")

End Sub

Sub CheckCourtPlacement()

    Dim Before As P.Transform3D
    Dim After As P.Transform3D
    Dim HaloBefore As P.Vector3
    Dim HaloAfter As P.Vector3
    Dim OriginalOffset As P.Vector3
    Dim WaterBefore As P.Vector3
    Dim WaterAfter As P.Vector3
    Dim Models As Number
    Dim Ok As Boolean

    If Not Value.Comparison.Ready Then
        Return
    End If

    OriginalOffset = Value.Comparison.Offset
    Models = G.LiveModelCount3D()
    Ok = P.TryTransform(Value.Comparison.Objects[0], Before)
    Ok = P.TryParticlePosition(Value.Comparison.Light.Particles, 0, True, HaloBefore) And Ok
    WaterBefore = CourtWater.StreamPoint(0, 0.0)

    Call CourtPreview.Synchronize(Value.Comparison, True,
        P.Vector(OriginalOffset.X + 375.25, 0.0, OriginalOffset.Z - 140.5))
    Call CourtPreview.Update(Value.Comparison, 16)

    Ok = P.TryTransform(Value.Comparison.Objects[0], After) And Ok
    Ok = P.TryParticlePosition(Value.Comparison.Light.Particles, 0, True, HaloAfter) And Ok
    WaterAfter = CourtWater.StreamPoint(0, 0.0)

    Call Check(Ok And Abs(After.Position.X - Before.Position.X - 375.25) < 0.001 And
        Abs(After.Position.Z - Before.Position.Z + 140.5) < 0.001 And
        Abs(HaloAfter.X - HaloBefore.X - 375.25) < 0.001 And
        Abs(WaterAfter.X - WaterBefore.X - 375.25) < 0.001 And
        Value.Comparison.Water.CenterX = Castle.CenterX(),
        "Royal Court Meshes Halos Fountain And Basins Move Together")

    Ok = P.TryTransform(Value.Comparison.Objects[Value.Comparison.Leaf], After)

    Call Check(Ok And Abs(After.Position.Y + 0.25 * Castle.SCALE - 25.12) < 0.001 And
        Abs(Castle.GroundHeight(Castle.CenterX(), Castle.CenterZ() - 74.0 * Castle.SCALE) - 25.12) < 0.001,
        "Relocated Drawbridge Deck And Walking Height Clear Overlapping Road At 23.12")
    Call Check(Abs(Castle.GroundHeight(Castle.CenterX(), Castle.CenterZ() - 60.0 * Castle.SCALE) - 25.12) < 0.001,
        "Drawbridge Clearance Leaves The Gatehouse Floor Unchanged")
    Call CourtPreview.Synchronize(Value.Comparison, False, OriginalOffset)
    Call Check(Not Castle.Active() And Not Value.Comparison.Visible And G.LiveModelCount3D() = Models,
        "Deleting The Court Disables Collision And Draws Without Destroying Shared Resources")
    Call CourtPreview.Synchronize(Value.Comparison, True, OriginalOffset)
    Call CourtPreview.Update(Value.Comparison, 16)
    Call Check(Castle.Active() And Value.Comparison.Visible,
        "Replacing The Court Reuses One Complete Assembly")

End Sub
