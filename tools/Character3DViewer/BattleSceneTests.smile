''' Regression: the native battle must capture the actual formation before frame one.

Option Explicit

Import Smile.Tools.Character3DViewerWorkflow As Workflow
Import Smile.Tools.NativeViewerHost As NativeHost
Import Smile.Tools.Character3DViewerProfiles As Profiles
Import Smile.Tools.Character3DViewerActors As Actors
Import Smile.Tools.Character3DViewerParty As Party
Import Smile.Tools.Character3DViewerCamera As ViewerCamera
Import Smile.Tools.ViewerBattlePresentation As Presentation
Import Smile.Tools.ViewerBattlePlanning As Planning
Import Smile.Tools.ViewerBattleOutcome As Outcome
Import Smile.Tools.ViewerBattleHud As Hud
Import Smile.Tools.ViewerBattleUi As BattleUi
Import Smile.Tools.ViewerBattleCinematics As Cinematics
Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.PrecisionCamera3D As Camera
Import Smile.Simple3D.Core As Core
Import Smile.Simple3D.Character3D As Character
Import Smile.Simple3D.PrecisionMath3D As Math3D
Import SinStarI.BattleRules As Rules

Dim Viewer As New Workflow.Session()
Dim Host As New NativeHost.Session()
Dim Visual As Presentation.State
Dim Battle As Planning.State
Dim Actor As Actors.Context
Dim Position As P.Vector3
Dim First As Number
Dim Second As Number
Dim Failures As Number
Dim Ending As Outcome.State
Dim FirstView As P.Camera3D
Dim LastView As P.Camera3D
Dim FollowingView As P.Camera3D
Dim CompactLayout As Hud.Layout
Dim ExpandedLayout As Hud.Layout
Dim Shots As Cinematics.State
Dim ManualCamera As ViewerCamera.State
Dim CameraInput As ViewerCamera.PointerInput
Dim CameraOk As Boolean

Game Window "Viewer Battle Formation Check" Size 1420 By 990

Call Check(Outcome.DialogLeft() = 370, "Reward Dialog Centers Without Left Constant Collision")

CompactLayout = Hud.Arrange(1420, 990, 0)
ExpandedLayout = Hud.Arrange(1420, 990, 2)

Call Check(CompactLayout.MenuWidth = ExpandedLayout.MenuWidth And
    CompactLayout.MenuX = ExpandedLayout.MenuX, "Command Panel Remains Fixed And Centered")
Call Check(ExpandedLayout.HeroWidth > CompactLayout.HeroWidth And
    ExpandedLayout.PanelY > CompactLayout.PanelY, "Hidden Panels Expand And Lower Four Hero Cards")
Call Check(ExpandedLayout.AreaX >= 18 And
    ExpandedLayout.AreaX + ExpandedLayout.AreaWidth <= 1402, "Enemy And Party Respect Screen Margins")
Call Check(Hud.HeroX(ExpandedLayout, 3) + ExpandedLayout.HeroWidth =
    ExpandedLayout.AreaX + ExpandedLayout.AreaWidth, "Four Heroes Fill Available Width")

Call Planning.Start(Battle)
Call Planning.BeginRound(Battle)
Call BattleUi.InterruptForInput(Battle, KEY_NONE, False)
Call BattleUi.InterruptForInput(Battle, KEY_RIGHT, False)
Call BattleUi.InterruptForInput(Battle, KEY_UP, False)
Call BattleUi.InterruptForInput(Battle, KEY_A, False)
Call BattleUi.InterruptForInput(Battle, KEY_O, False)
Call BattleUi.InterruptForInput(Battle, KEY_BACKTICK, False)
Call Check(Not Battle.Combat.StopRequested,
    "Camera Input And Showing Panels Leave Auto Battle Running")

For First = 0 To 2

    Call Planning.Start(Battle)
    Call Planning.BeginRound(Battle)

    If First = 0 Then
        Call BattleUi.InterruptForInput(Battle, KEY_NONE, True)
    Else If First = 1 Then
        Call BattleUi.InterruptForInput(Battle, KEY_ENTER, False)
    Else

        Call BattleUi.InterruptForInput(Battle, KEY_SPACE, False)
    End If

    Call Check(Battle.Combat.StopRequested And Not Battle.Planning,
        "Panel Click, Enter Or Space Requests Orders Without Cutting Off An Attack")

    For Second = 0 To 4
        Call Planning.Advance(Battle, 2000, 99, 0)
    End For

    Call Check(Battle.Planning And Battle.Combat.Round = 2,
        "Explicit Auto Stop Waits Until Party And Kael Finish The Round")
End For

Call Host.Start(Viewer, NativeHost.BATTLE_TAB, True, 1420, 990)
Call Check(Viewer.PanelVisibility() = 2, "Battle Startup Hides Legacy Panels")
Call Planning.Start(Battle)
Call Presentation.Create(Visual, Viewer)
Call Presentation.OrdersCamera(Viewer)
Call Check(Viewer.SceneReady(), "Loaded All Actors")
Call Check(Presentation.OrderArrowVisible(Battle.Combat), "Order Selection Shows Arrow")

Shots.Enabled = True

Call Cinematics.Reset(Shots, Viewer)
Call Cinematics.Update(Shots, Viewer, Battle.Combat, 16, 1420, 990)

FirstView = Shots.View

Call Cinematics.Update(Shots, Viewer, Battle.Combat, 16, 1420, 990)
Call Check(Abs(FirstView.Position.X - Shots.View.Position.X) > 0.001,
    "Opening Camera Drifts While Waiting For Orders")

FollowingView = Presentation.OrdersView()
FirstView = Cinematics.Establish(Shots.EstablishView, FollowingView, 0)
LastView = Cinematics.Establish(Shots.EstablishView, FollowingView, 2000)

Call Check(Math3D.Distance(FirstView.Position, LastView.Position) < 0.00001,
    "Opening Completes One Full Revolution")

LastView = Cinematics.Establish(Shots.EstablishView, FollowingView, 1000)
Position = Math3D.Add(FirstView.Position, LastView.Position)
Position = Math3D.Subtract(Position, Math3D.Scale(FirstView.Target, 2.0))

Call Check(Abs(Position.X) + Abs(Position.Z) < 0.00001 And
    Abs(FirstView.Position.Y - LastView.Position.Y) < 0.00001,
    "Opening Passes Opposite Side Without Changing Height")

LastView = Cinematics.Establish(Shots.EstablishView, FollowingView, 2001)

Call Check(Math3D.Distance(FirstView.Position, LastView.Position) < 0.02,
    "Orbit Joins The Eased Transition Without A Cut")

LastView = Cinematics.Establish(Shots.EstablishView, FollowingView, 2999)

Call Check(Math3D.Distance(FollowingView.Position, LastView.Position) < 0.02,
    "Transition Eases Into The Following Shot")

LastView = Cinematics.Establish(Shots.EstablishView, FollowingView, 3000)

Call Check(Math3D.Distance(FollowingView.Position, LastView.Position) = 0.0 And
    FollowingView.FovDegrees = LastView.FovDegrees, "Transition Reaches The Exact Following Camera")
Call Cinematics.Update(Shots, Viewer, Battle.Combat, 3000, 1420, 990)

FirstView = Presentation.OrdersView()

For First = 0 To 3

    Battle.Combat.Turn = First

    Call Cinematics.Update(Shots, Viewer, Battle.Combat, 8000, 1420, 990)
    Call Check(Math3D.Distance(FirstView.Position, Shots.View.Position) = 0.0 And
        Math3D.Distance(FirstView.Target, Shots.View.Target) = 0.0 And
        FirstView.FovDegrees = Shots.View.FovDegrees,
        "Every Hero's Orders Hold The Exact Default Camera Across Shot Timers")
End For

Battle.Combat.Turn = 0
Shots.Enabled = False
FirstView = Shots.View

Call Cinematics.Update(Shots, Viewer, Battle.Combat, 500, 1420, 990)
Call Check(FirstView.Position.X = Shots.View.Position.X, "Disabled Cinematics Preserve Manual View")

Shots.Enabled = True

Call Check(Party.CameraActionTime(400, False) = Party.HERO_ATTACK_START_MILLISECONDS And
    Party.CameraActionTime(400, True) = Party.VRAX_ATTACK_START_MILLISECONDS,
    "Directed Attacks Use Kael Party Camera Beat Boundaries")

For First = 0 To 4

    Call Planning.Start(Battle)

    Battle.Combat.Turn = First

    Call Rules.BeginCommand(Battle.Combat, Rules.ATTACK, 0)
    Call Presentation.BeginAction(Visual, Viewer, Battle.Combat)

    Battle.Combat.Elapsed = 400

    Call Presentation.Apply(Visual, Viewer, Battle.Combat, 16)
    Call Cinematics.Update(Shots, Viewer, Battle.Combat, 16, 1420, 990)
    Call Viewer.UpdateFrame(1420, 990)
    Call Check(Not Presentation.OrderArrowVisible(Battle.Combat), "Executing Attacks Hide Order Arrow")

    FirstView = Shots.View

    If First < 4 Then
        Call Check(FirstView.FovDegrees = 24.0 And
            Math3D.Distance(FirstView.Position, FirstView.Target) > 846.0,
            "Hero Attack Uses Kael Party's Wide Planted Camera")
    Else

        Call Check(FirstView.FovDegrees = 26.0 And
            Math3D.Distance(FirstView.Position, FirstView.Target) > 500.0,
            "Enemy Attack Uses Kael Party's Behind-Defender Camera")
    End If

    Call Cinematics.Update(Shots, Viewer, Battle.Combat, 500, 1420, 990)
    Call Check(Math3D.Distance(FirstView.Position, Shots.View.Position) < 0.001,
        "Attack Camera Holds Like Kael Party Instead Of Continuing To Zoom Or Orbit")

    FirstView = Viewer.CurrentCamera()

    Call Viewer.StandaloneInput(KEY_RIGHT)
    Call Cinematics.Update(Shots, Viewer, Battle.Combat, 16, 1420, 990)
    Call Viewer.UpdateFrame(1420, 990)

    LastView = Viewer.CurrentCamera()

    Call Check(Math3D.Distance(FirstView.Position, LastView.Position) > 1.0,
        "Keyboard Orbit Reaches The Rendered Camera During Every Fighter's Attack")
    Call Cinematics.Update(Shots, Viewer, Battle.Combat, 16, 1420, 990)
    Call Viewer.UpdateFrame(1420, 990)

    FirstView = Viewer.CurrentCamera()

    Call Check(Math3D.Distance(FirstView.Position, LastView.Position) < 0.001,
        "Following Attack Frame Retains Manual Camera Instead Of Resetting It")
    Call Viewer.FollowPartyView(Shots.View, True)
End For

''' Replay small and moderate drag deltas through the actual shared input owner.
ManualCamera.Frame.PanXLimit = 1000.0
ManualCamera.Frame.PanYLimit = 1000.0

Call ViewerCamera.Reset(ManualCamera, 0, 0, -144, 36, 96000)

For First = 0 To 1

    Call ViewerCamera.FollowView(ManualCamera, FirstView, True)

    CameraInput = ViewerCamera.CreatePointerInput(False,
        First = 0, First = 0, False, First = 1, First = 1, False,
        700, 450, 1, 1, 1420, 990, False, True)
    CameraOk = ViewerCamera.UpdatePointerInteraction(ManualCamera, CameraInput, 1, 3, 8)

    Call ViewerCamera.Compose(ManualCamera, False)

    LastView = ManualCamera.Live
    CameraInput.PointerDeltaX = 20
    CameraInput.PointerDeltaY = -15
    CameraOk = ViewerCamera.UpdatePointerInteraction(ManualCamera, CameraInput, 1, 3, 8) And CameraOk

    Call ViewerCamera.FollowView(ManualCamera, FollowingView)
    Call ViewerCamera.Compose(ManualCamera, False)
    Call Check(CameraOk And Math3D.Distance(LastView.Position, ManualCamera.Live.Position) > 0.1 And
        Math3D.Distance(ManualCamera.Base.Position, FirstView.Position) < 0.001,
        "Slow And Moderate Pan/Orbit Take Over The Current Shot And Survive Cinematic Updates")
End For

CameraInput.OrbitHeld = False
CameraInput.PanHeld = False
CameraInput.PanPressed = False
CameraInput.PanReleased = True
CameraInput.WheelDelta = 1
CameraOk = ViewerCamera.UpdatePointerInteraction(ManualCamera, CameraInput, 1, 3, 8)
CameraOk = ViewerCamera.AdvanceZoom(ManualCamera, 50) And CameraOk

Call ViewerCamera.FollowView(ManualCamera, FollowingView)
Call Check(CameraOk And ManualCamera.Zoom.Target < 0.0 And ManualCamera.Zoom.Current < 0.0,
    "Wheel Zoom Eases And Survives Shot Updates")

CameraInput.WheelDelta = -2
CameraOk = ViewerCamera.UpdatePointerInteraction(ManualCamera, CameraInput, 1, 3, 8)
CameraOk = ViewerCamera.AdvanceZoom(ManualCamera, 50) And CameraOk

Call Check(CameraOk And ManualCamera.Zoom.Target > 0.0, "Wheel Zoom Out Uses The Same Controls")
Call ViewerCamera.FollowView(ManualCamera, FollowingView, True)
Call Check(ManualCamera.Controls.OrbitYaw = 0.0 And ManualCamera.Controls.PanX = 0.0 And
    ManualCamera.Zoom.Target = 0.0, "Explicit Camera Reset Clears Manual Offsets")

Battle.Combat.Phase = Rules.WAITING

Call Cinematics.Update(Shots, Viewer, Battle.Combat, 16, 1420, 990)

FirstView = Presentation.OrdersView()

Call Check(Math3D.Distance(FirstView.Position, Shots.View.Position) = 0.0 And
    Math3D.Distance(FirstView.Target, Shots.View.Target) = 0.0,
    "Returning From Combat To Orders Restores The Fixed Default Camera")
Call Planning.Start(Battle)

For First = 0 To 4

    For Second = First + 1 To 4
        Call Check(Abs(Visual.Homes[First].X - Visual.Homes[Second].X) +
            Abs(Visual.Homes[First].Z - Visual.Homes[Second].Z) > 20.0,
            "Distinct Formation Homes Before First Frame")
    End For
End For

Call Presentation.Apply(Visual, Viewer, Battle.Combat, 0)
Call Viewer.UpdateFrame(1420, 990)
Call Viewer.DrawFrame()

Show Screen

Call Check(Viewer.SceneReady(), "First Directed Frame")
Call Check(Battle.Planning And Battle.Combat.ActionSerial = 0, "Initial Orders Wait")
Call Viewer.StandaloneInput(KEY_ENTER)
Call Check(Viewer.PanelVisibility() = 2, "Legacy Reset Preserves Battle Panel Visibility")
Call Planning.BeginRound(Battle)
Call Planning.Interrupt(Battle)

For First = 0 To 4
    Call Presentation.BeginAction(Visual, Viewer, Battle.Combat)
    Call Planning.Advance(Battle, Battle.Combat.Duration, 99, 3)
    Call Presentation.Apply(Visual, Viewer, Battle.Combat, 16)
    Call Viewer.UpdateFrame(1420, 990)
End For

Call Check(Battle.Planning And Battle.Combat.Round = 2, "Complete Round Before New Orders")

For First = 0 To 4
    Actor = Viewer.PartyActor(Presentation.PartyTurn(First))
    Position = Visual.Homes[First]

    Call Check(Abs(Actor.Frame.PositionX - Position.X) < 0.01 And
        Abs(Actor.Frame.PositionZ - Position.Z) < 0.01, "Return To Own Formation Home")
End For

Call Check(Viewer.SceneReady(), "Directed Round Remains Ready")
Call Viewer.PauseDirectedPlayback(True)
Call CheckTravel(0, 4)
Call CheckTravel(1, 4)
Call CheckTravel(2, 4)
Call CheckTravel(4, 0)
Call Viewer.PauseDirectedPlayback(False)
Call Presentation.Restart(Visual)
Call Planning.Start(Battle)

Battle.Combat.Turn = 3
Battle.Combat.Members[3].HP = Battle.Combat.Members[3].Stats.HP
Battle.Combat.Members[3].LB = Battle.Combat.Members[3].Stats.HP

Call Rules.BeginCommand(Battle.Combat, Rules.LIMIT_BREAK, 0)
Call Presentation.BeginAction(Visual, Viewer, Battle.Combat)

Battle.Combat.Elapsed = 400

Call Presentation.Apply(Visual, Viewer, Battle.Combat, 16)
Call Viewer.UpdateFrame(1420, 990)
Call Check(Visual.CastClip = "HealParty" And Visual.Ready And Viewer.SceneReady(), "Mira LB Uses Party Healing")
Call Planning.Start(Battle)

Battle.Combat.Members[4].HP = 1

Call Planning.BeginRound(Battle)
Call Planning.Advance(Battle, 2000, 99, 0)
Call Presentation.Apply(Visual, Viewer, Battle.Combat, 16)
Call Viewer.UpdateFrame(1420, 990)
Call Check(Visual.Clips[1] = "Victory" And Visual.Clips[4] = "Death", "Living Orin Celebrates Defeated Kael")

For First = 0 To 3
    Call Check(Visual.Clips[First] = "Victory", "All Living Heroes Have Victory Clips")
End For

Call Check(Visual.Ready And Viewer.SceneReady(), "Ending Uses Valid Character Clips")
Call Outcome.Start(Ending, True)
Call Outcome.Advance(Ending, 900)
Call Check(Outcome.DisplayAward(Ending, 1200) = 600, "EXP Counts Up")
Call Outcome.Advance(Ending, 8999)
Call Check(Ending.Visible, "Dialog Remains Before Ten Seconds")
Call Outcome.Activity(Ending, True, False)
Call Outcome.Advance(Ending, 9999)
Call Check(Ending.Visible, "Activity Resets Inactivity Countdown")
Call Outcome.Advance(Ending, 1)
Call Check(Not Ending.Visible, "Ten Inactive Seconds Dismiss")
Call Outcome.Start(Ending, True)
Call Outcome.Activity(Ending, True, True)
Call Check(Not Ending.Visible, "Explicit Dismissal")

FirstView = Outcome.OrbitView(0)
LastView = Outcome.OrbitView(Outcome.ORBIT_DURATION)

Call Check(Abs(FirstView.Position.X - LastView.Position.X) < 0.01 And
    Abs(FirstView.Position.Z - LastView.Position.Z) < 0.01, "Orbit Completes Full Circle")

LastView = Outcome.OrbitView(Outcome.ORBIT_DURATION / 2)

Call Check(Abs(FirstView.Position.X + LastView.Position.X) < 0.01 And
    Abs(FirstView.Position.Z + LastView.Position.Z) < 0.01, "Orbit Passes Opposite Side")
Call Presentation.Restart(Visual)
Call Planning.Start(Battle, True)
Call Presentation.Apply(Visual, Viewer, Battle.Combat, 0)
Call Check(Visual.Clips[1] = "Idle" And Visual.Clips[4] = "Idle", "Restart Clears Victory And Death Poses")
Call Host.RestartBattle(Viewer)
Call Viewer.UpdateFrame(1420, 990)
Call Check(Viewer.PanelVisibility() = 2 And Viewer.SceneReady(), "Host Restart Preserves Directed Scene")
Call Outcome.Start(Ending, False)
Call Outcome.Update(Ending, Viewer, 16)
Call Check(Ending.OrbitTime = 16 And Not Ending.Visible, "Defeat Orbits Without EXP Dialog")

For First = 0 To 1

    Call Outcome.Start(Ending, First = 0)
    Call Outcome.Advance(Ending, 14999)
    Call Outcome.Activity(Ending, True, False)
    Call Check(Not Outcome.RestartDue(Ending), "Win Or Loss Does Not Restart Early")
    Call Outcome.Advance(Ending, 1)
    Call Check(Outcome.RestartDue(Ending), "Win Or Loss Restarts At Fifteen Seconds Despite Dialog Activity")
End For

Call Presentation.Destroy(Visual)
Call Viewer.ConfigureExternalHost(False)
Call Viewer.SelectTab(Profiles.CHARACTER_TAB_PARTY_KAEL)
Call Viewer.UpdateFrame(1420, 990)
Call Check(Viewer.SceneReady() And Viewer.PanelVisibility() = 0, "Original Kael Party Still Loads")
Call Host.Release(Viewer)

If Failures = 0 Then
    Print "PASS Viewer Battle Scene"
Else
    Print "FAIL Viewer Battle Scene"
End If

Sub Check(Passed As Boolean, Label As Text)

    If Not Passed Then
        Failures = Failures + 1
        Print "FAIL: " + Label
    End If

End Sub

Sub CheckTravel(Member As Number, Target As Number)

    Dim Subject As Actors.Context
    Dim Rotation As P.Vector3
    Dim CastRotation As P.Vector3
    Dim Forward As P.Vector3
    Dim Direction As P.Vector3
    Dim Origin As P.Vector3
    Dim NewOrigin As P.Vector3
    Dim Sword As P.Vector3
    Dim NewSword As P.Vector3
    Dim Expected As P.Vector3
    Dim Ok As Boolean

    Call Planning.Start(Battle)
    Call Presentation.Restart(Visual)

    Battle.Combat.Turn = Member

    Call Rules.BeginCommand(Battle.Combat, Rules.ATTACK, Target)
    Call Presentation.BeginAction(Visual, Viewer, Battle.Combat)

    Battle.Combat.Elapsed = 200

    Call Presentation.Apply(Visual, Viewer, Battle.Combat, 0)
    Call Viewer.UpdateFrame(1420, 990)

    Subject = Viewer.PartyActor(Presentation.PartyTurn(Member))
    Ok = Character.TryRotation(Subject.Actor, Rotation)
    Ok = Character.TryPosition(Subject.Actor, Origin) And Ok
    Forward = Math3D.Rotate(P.Vector(0.0, 0.0, -1.0), Rotation)
    Direction = Math3D.Subtract(Visual.Homes[Target], P.Vector(Origin.X, 0.0, Origin.Z))
    Direction.Y = 0.0

    Call Check(Ok And Math3D.Dot(Forward, Direction) / Math3D.Length(Direction) > 0.999,
        "Approach Faces The Direction Of Travel")

    If Member = 0 Then
        Ok = Character.TrySocketPositionPrecise(Subject.Actor, "SwordTip", 1, False, Sword) And Ok
    End If

    Battle.Combat.Elapsed = 400 + Visual.CastDuration + 250

    Call Presentation.Apply(Visual, Viewer, Battle.Combat, 0)
    Call Viewer.UpdateFrame(1420, 990)

    Subject = Viewer.PartyActor(Presentation.PartyTurn(Member))
    Ok = Character.TryRotation(Subject.Actor, CastRotation) And Ok
    Ok = Character.TryPosition(Subject.Actor, NewOrigin) And Ok
    Forward = Math3D.Rotate(P.Vector(0.0, 0.0, -1.0), CastRotation)
    Direction = Math3D.Subtract(Visual.Homes[Member], P.Vector(NewOrigin.X, 0.0, NewOrigin.Z))
    Direction.Y = 0.0

    Call Check(Ok And Math3D.Dot(Forward, Direction) / Math3D.Length(Direction) > 0.999,
        "Return Faces Home Instead Of Running Backwards")

    If Member = 0 Then

        Ok = Character.TrySocketPositionPrecise(Subject.Actor, "SwordTip", 1, False, NewSword) And Ok
        Expected = Math3D.Add(NewOrigin, Math3D.Rotate(Math3D.Subtract(Sword, Origin),
            P.Vector(0.0, CastRotation.Y - Rotation.Y, 0.0)))

        Call Check(Ok And Math3D.Distance(Expected, NewSword) < 0.02,
            "Arin Authored Run Sword Correction Turns With The Body")

    End If

    Battle.Combat.Elapsed = 400

    Call Presentation.Apply(Visual, Viewer, Battle.Combat, 0)
    Call Viewer.UpdateFrame(1420, 990)

    Subject = Viewer.PartyActor(Presentation.PartyTurn(Member))
    Ok = Character.TryRotation(Subject.Actor, CastRotation) And Ok

    Battle.Combat.Elapsed = Battle.Combat.Duration

    Call Presentation.Apply(Visual, Viewer, Battle.Combat, 0)
    Call Viewer.UpdateFrame(1420, 990)

    Subject = Viewer.PartyActor(Presentation.PartyTurn(Member))
    Ok = Character.TryRotation(Subject.Actor, Rotation) And Ok

    Call Check(Ok And Abs(Math3D.WrapDegrees(CastRotation.Y - Rotation.Y)) < 0.01 And
        Subject.CalibrationYaw = 0.0 And Visual.Clips[Member] = "Idle",
        "Arriving Home Restores Battle Stance And Idle")
    Call Check(Visual.Ready And Viewer.SceneReady(), "Travel Retains Valid Actors And Equipment")

End Sub
