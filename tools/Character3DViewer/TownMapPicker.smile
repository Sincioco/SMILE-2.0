''' Modal list of open maps. Owns only picker layout and input, never documents.
Module Smile.Tools.TownMapPicker

Option Explicit

Import Smile.UI.Controls As UI
Import Smile.Tools.TownWorldPreviews As Previews
Import Smile.Tools.TownDemo As Demo

Public Type State
    Visible As Boolean
    Consumed As Boolean
    Names[16] As Text
    EntryCount As Number
    Active As Number
    Photos As Previews.State
    Showcase As Demo.Selection
    Message As Text
End Type

Public Function PanelWidth() As Number

    Dim Result As Number

    Result = Min(960, Window_Width() - 20)

    Return Result

End Function

Public Function RowPitch() As Number

    Dim Result As Number

    Result = Min(150, Max(80, (Window_Height() - 270) / 4))

    Return Result

End Function

Public Function LeftEdge() As Number

    Dim Result As Number

    Result = Max(10, (Window_Width() - PanelWidth()) / 2)

    Return Result

End Function

Public Function Pick(Px As Number, Py As Number, PanelX As Number, EntryCount As Number,
    Optional Width As Number = 960, Optional Pitch As Number = 150) As Number

    Dim ReturnValue As Number

    Dim Column As Number
    Dim Row As Number
    Dim Result As Number
    Dim ColumnPitch As Number

    ColumnPitch = (Width - 24) / 4

    If (Px < PanelX + 16 Or
        Px >= PanelX + Width - 16 Or
        Py < 222 Or
        Py >= 222 + Pitch * 4) Then
        ReturnValue = -1

        Return ReturnValue
    End If

    Column = (Px - PanelX - 16) / ColumnPitch
    Row = (Py - 222) / Pitch
    Result = Row * 4 + Column

    If (Px - PanelX - 16 - Column * ColumnPitch >= ColumnPitch - 8 Or
        Py - 222 - Row * Pitch >= Pitch - 8 Or
        Result >= EntryCount) Then
        ReturnValue = -1

        Return ReturnValue
    End If

    Return Result

End Function

Public Function DemoHit(Px As Number, Py As Number, PanelX As Number, EntryCount As Number,
    Optional Width As Number = 960, Optional Pitch As Number = 150,
    Optional RefreshButton As Boolean = False) As Number

    Dim ReturnValue As Number

    Dim Index As Number
    Dim ButtonX As Number
    Dim Top As Number
    Dim PitchX As Number
    Dim ButtonWidth As Number

    Index = Pick(Px, Py, PanelX, EntryCount, Width, Pitch)

    If Index < 0 Then
        ReturnValue = -1

        Return ReturnValue
    End If

    PitchX = (Width - 24) / 4
    ButtonWidth = Min(70, (PitchX - 24) / 2)
    ButtonX = PanelX + 16 + (Index Mod 4) * PitchX + (PitchX - 16) / 2 - ButtonWidth

    If RefreshButton Then
        ButtonX = ButtonX + ButtonWidth + 8
    End If

    Top = 222 + (Index / 4) * Pitch + Pitch - 31

    If (Px >= ButtonX And
        Px < ButtonX + ButtonWidth And
        Py >= Top And
        Py < Top + 20) Then
        Return Index
    End If

    ReturnValue = -1

    Return ReturnValue

End Function

Public Function Input(ByRef Value As State, Key As Number) As Number

    Dim ReturnValue3 As Number

    Dim ReturnValue2 As Number

    Dim ReturnValue As Number

    Dim Result As Number
    Dim Ok As Boolean
    Dim Index As Number

    Value.Consumed = Value.Visible

    If Not Value.Visible Then
        ReturnValue = -1

        Return ReturnValue
    End If

    If Key = KEY_ESCAPE Then

        Value.Visible = False
        ReturnValue = -1

        Return ReturnValue

    End If

    If Not Pointer_Pressed(POINTER_PRIMARY) Then
        ReturnValue = -1

        Return ReturnValue
    End If

    Result = DemoHit(Pointer_X(), Pointer_Y(), LeftEdge(), Value.EntryCount, PanelWidth(), RowPitch(), True)

    If Result >= 0 Then

        Call Previews.Refresh(Value.Names[Result])

        ReturnValue3 = -1

        Return ReturnValue3

    End If

    If UI.Contains(LeftEdge() + PanelWidth() - 126, 228 + RowPitch() * 4, 110, 24) Then

        For Index = 0 To Value.EntryCount - 1
            Call Previews.Refresh(Value.Names[Index])
        End For

        ReturnValue3 = -1

        Return ReturnValue3

    End If

    Result = DemoHit(Pointer_X(), Pointer_Y(), LeftEdge(), Value.EntryCount, PanelWidth(), RowPitch())

    If Result >= 0 Then

        Ok = Demo.SetIncluded(Value.Showcase, Value.Names[Result],
            Not Demo.Included(Value.Showcase, Value.Names[Result]))
        Value.Message = ""

        If Not Ok Then
            Value.Message = "Demo setting could not be saved."
        End If

        ReturnValue2 = -1

        Return ReturnValue2

    End If

    Result = Pick(Pointer_X(), Pointer_Y(), LeftEdge(), Value.EntryCount, PanelWidth(), RowPitch())

    If Result >= 0 Or UI.Contains(LeftEdge() + PanelWidth() - 94, 172, 78, 30) Then
        Value.Visible = False
    End If

    Return Result

End Function

Public Sub Draw(ByRef Value As State)

    Dim Index As Number
    Dim PanelX As Number
    Dim CardX As Number
    Dim CardY As Number
    Dim PitchX As Number
    Dim PitchY As Number
    Dim PictureWidth As Number
    Dim Included As Boolean
    Dim ButtonWidth As Number
    Dim Missing As Number
    Dim Label As Text

    If Not Value.Visible Then
        Return
    End If

    PanelX = LeftEdge()
    PitchX = (PanelWidth() - 24) / 4
    PitchY = RowPitch()
    PictureWidth = Min(PitchX - 18, (PitchY - 65) * 8 / 5)
    ButtonWidth = Min(70, (PitchX - 24) / 2)
    Fill Rectangle 0, 0, Window_Width(), Window_Height(), RGB(6, 12, 18)
    Fill Rectangle PanelX, 158, PanelWidth(), 100 + PitchY * 4, RGB(12, 23, 36)
    Draw Text "Choose A Map" At PanelX + 16, 177 Size 22 Color WHITE

    Call UI.DrawButton(PanelX + PanelWidth() - 94, 172, 78, 30, "Close", False)

    For Index = 0 To Value.EntryCount - 1

        CardX = PanelX + 16 + (Index Mod 4) * PitchX
        CardY = 222 + (Index / 4) * PitchY
        Value.Photos.Names[Index] = Value.Names[Index]

        Call UI.DrawButton(CardX, CardY, PitchX - 8, PitchY - 8, "", Index = Value.Active)
        Call Previews.Draw(Value.Photos, Index, CardX + (PitchX - 8 - PictureWidth) / 2,
            CardY + 5, PictureWidth, PitchY - 65)

        Draw Text Value.Names[Index] At CardX + (PitchX - 8) / 2, CardY + PitchY - 54 Size 14 Color WHITE Centered

        Included = Demo.Included(Value.Showcase, Value.Names[Index])
        Label = "Demo Off"

        If Included Then
            Label = "Demo On"
        End If

        Call UI.DrawButton(CardX + (PitchX - 16) / 2 - ButtonWidth, CardY + PitchY - 31,
            ButtonWidth, 20, Label, Included)
        Call UI.DrawButton(CardX + PitchX / 2, CardY + PitchY - 31,
            ButtonWidth, 20, "Refresh", False)

        If Not Previews.Has(Value.Names[Index]) Then
            Missing = Missing + 1
        End If

    End For

    If Missing > 0 Then
        Draw Text "Generating Maps Thumbnail." At Window_Width() / 2, 124 Size 24 Color CYAN Centered
    End If

    Call UI.DrawButton(PanelX + PanelWidth() - 126, 228 + PitchY * 4, 110, 24, "Refresh All", False)

    Label = "Choose a map. Demo On includes it in the demo cycle."

    If Text_Length(Value.Message) > 0 Then
        Label = Value.Message
    End If

    Draw Text Label At PanelX + 16, 235 + PitchY * 4 Size 13 Color CYAN

End Sub

End Module
