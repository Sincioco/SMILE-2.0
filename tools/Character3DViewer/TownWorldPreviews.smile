''' Cached scene photographs, rendered once per town revision at its starting camera.
Module Smile.Tools.TownWorldPreviews

Option Explicit

Import Smile.Simple3D.Graphics3D As G
Import Smile.Simple3D.Scene3D As Scene
Import Smile.Tools.TownDocument As Town
Import Smile.Tools.TownWorldDocument As World
Import Smile.Tools.TownStartingCamera As Starting

Public Type State
    Names[16] As Text
End Type

Private Type Photograph
    Name As Text
    Revision As Number
    Handle As Number
End Type

Private Dim Photos[16] As Photograph
Private Dim PendingSlot As Number
Private Dim PendingName As Text
Private Dim PendingRevision As Number
Private Dim NextSlot As Number
Private Dim UpdatedAt As Number

Private Function Find(Name As Text) As Number

    Dim ReturnValue As Number

    Dim Index As Number

    For Index = 0 To 15

        If Photos[Index].Name = Name Then
            Return Index
        End If

    End For

    ReturnValue = -1

    Return ReturnValue

End Function

Public Function Has(Name As Text) As Boolean

    Dim Slot As Number
    Dim Result As Boolean

    Slot = Find(Name)

    If Slot >= 0 Then
        Result = Photos[Slot].Handle > 0
    End If

    Return Result

End Function

''' Caller draws its existing scene only when a new photograph is needed.
Public Function Begin(ByRef Map As Town.State) As Boolean

    Dim Slot As Number
    Dim Ok As Boolean

    Slot = Find(Map.Name)

    If Slot >= 0 Then

        If Photos[Slot].Revision = Map.Revision And Photos[Slot].Handle > 0 Then
            Return False
        End If

    Else
        Slot = NextSlot

    End If

    If Timer() - UpdatedAt < 500 Then
        Return False
    End If

    UpdatedAt = Timer()
    NextSlot = (Slot + 1) Mod 16
    PendingSlot = Slot
    PendingName = Map.Name
    PendingRevision = Map.Revision
    Ok = G.SetViewport3D(0, 0, Min(384, Window_Width()), Min(240, Window_Height()), True)

    If Ok Then
        Ok = Scene.BeginPrecise(Starting.Frame(Map), 12, 20, 32)
    End If

    If Not Ok Then
        Call G.ResetViewport3D()
    End If

    Return Ok

End Function

Public Sub Finish()

    Dim Ok As Boolean
    Dim Handle As Number

    Ok = Scene.EndScene()

    If Ok Then

        Call G.ReleaseViewportCapture3D(Photos[PendingSlot].Handle)

        Handle = G.CaptureViewport3D()
        Photos[PendingSlot].Name = PendingName
        Photos[PendingSlot].Revision = PendingRevision
        Photos[PendingSlot].Handle = Handle

    End If

    Call G.ResetViewport3D()

End Sub

Public Sub Update(ByRef Value As State, ByRef Map As World.State)

    Dim Index As Number

    For Index = 0 To Map.NodeCount - 1
        Value.Names[Index] = Map.Nodes[Index].Town
    End For

End Sub

Public Sub Draw(ByRef Value As State, Slot As Number, ScreenX As Number, ScreenY As Number,
    Width As Number, Height As Number)

    Dim Index As Number
    Dim Ok As Boolean

    If Width <= 0 Or Height <= 0 Then
        Return
    End If

    Fill Rectangle ScreenX, ScreenY, Width, Height, RGB(8, 17, 25)
    Index = Find(Value.Names[Slot])

    If Index >= 0 Then

        Ok = G.DrawViewportCapture3D(Photos[Index].Handle, ScreenX, ScreenY, Width, Height)

        If Not Ok Then
            Photos[Index].Handle = 0
        End If

    End If

    If Not Ok Then
        Draw Text "Preparing Preview..." At ScreenX + Width / 2, ScreenY + Height / 2 Size 11 Color LIGHT_GRAY Centered
    End If

End Sub

Public Sub Destroy()

    Dim Index As Number

    For Index = 0 To 15
        Call G.ReleaseViewportCapture3D(Photos[Index].Handle)

        Photos[Index].Handle = 0
    End For

End Sub

End Module
