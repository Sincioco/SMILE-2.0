''' Cached scene photographs, rendered once per town revision at its starting camera.
Module Smile.Tools.TownWorldPreviews

Option Explicit

Import Smile.Simple3D.Graphics3D As G
Import Smile.Simple3D.Scene3D As Scene
Import Smile.Tools.TownDocument As Town
Import Smile.Tools.TownWorldDocument As World
Import Smile.Tools.TownStartingCamera As Starting
Import Smile.Tools.TownDocumentStore As Store
Import Smile.Tools.TownDerivedCache As Cache

Public Type State
    Names[16] As Text
End Type

Private Type Photograph
    Name As Text
    Revision As Number
    Handle As Number
    Refresh As Boolean
End Type

Private Dim Photos[16] As Photograph
Private Dim PendingSlot As Number
Private Dim PendingName As Text
Private Dim PendingRevision As Number
Private Dim PendingMap As Town.State
Private Dim NextSlot As Number
Private Dim UpdatedAt As Number

Private Function Find(Name As Text) As Number

    Dim ReturnValue As Number

    Dim Index As Number

    For Index = 0 To 15

        If Photos[Index].Name = Name Then
            Return Index
        End If

    End For

    ReturnValue = -1

    Return ReturnValue

End Function

Private Function SlotFor(Name As Text) As Number

    Dim Slot As Number
    Dim Empty As Photograph

    Slot = Find(Name)

    If Slot < 0 Then

        Slot = NextSlot
        NextSlot = (NextSlot + 1) Mod 16

        Call G.ReleaseViewportCapture3D(Photos[Slot].Handle)

        Photos[Slot] = Empty
        Photos[Slot].Name = Name
        Photos[Slot].Revision = -1

    End If

    Return Slot

End Function

''' Check content once per live revision; a cache hit never loads the map renderer.
Public Function Check(ByRef Map As Town.State) As Boolean

    Dim Slot As Number
    Dim Generation As Number
    Dim Prefix As Text
    Dim Key As Text
    Dim Result As Boolean

    Slot = SlotFor(Map.Name)

    If Photos[Slot].Revision <> Map.Revision And Not Photos[Slot].Refresh Then

        Call G.ReleaseViewportCapture3D(Photos[Slot].Handle)

        Photos[Slot].Handle = 0
        Photos[Slot].Revision = Map.Revision
        Prefix = "TownThumbnail1." + Map.Name
        Generation = Cache.ReadNumber(Prefix)

        If Generation >= 1 And Generation <= 2 Then

            Key = Prefix + "." + Text_From_Code(48 + Generation)

            If Store.MatchesDocument(Map, Key + ".Input") Then
                Photos[Slot].Handle = G.LoadViewportCapture3D(Key + ".Image")
            End If

        End If

    End If

    Result = Photos[Slot].Handle > 0

    Return Result

End Function

Public Sub Refresh(Name As Text)

    Dim Slot As Number

    Slot = SlotFor(Name)

    Call G.ReleaseViewportCapture3D(Photos[Slot].Handle)

    Photos[Slot].Handle = 0
    Photos[Slot].Refresh = True

End Sub

Public Function Has(Name As Text) As Boolean

    Dim Slot As Number
    Dim Result As Boolean

    Slot = Find(Name)

    If Slot >= 0 Then
        Result = Photos[Slot].Handle > 0
    End If

    Return Result

End Function

''' Caller draws its existing scene only when a new photograph is needed.
Public Function Begin(ByRef Map As Town.State) As Boolean

    Dim Slot As Number
    Dim Ok As Boolean

    If Check(Map) Then
        Return False
    End If

    If Timer() - UpdatedAt < 500 Then
        Return False
    End If

    UpdatedAt = Timer()
    Slot = SlotFor(Map.Name)
    PendingSlot = Slot
    PendingName = Map.Name
    PendingRevision = Map.Revision
    PendingMap = Map
    Ok = G.SetViewport3D(0, 0, Min(384, Window_Width()), Min(240, Window_Height()), True)

    If Ok Then
        Ok = Scene.BeginPrecise(Starting.Frame(Map), 12, 20, 32)
    End If

    If Not Ok Then
        Call G.ResetViewport3D()
    End If

    Return Ok

End Function

Public Sub Finish()

    Dim Ok As Boolean
    Dim Handle As Number
    Dim Prefix As Text
    Dim Key As Text
    Dim Generation As Number

    Ok = Scene.EndScene()

    If Ok Then

        Call G.ReleaseViewportCapture3D(Photos[PendingSlot].Handle)

        Handle = G.CaptureViewport3D()
        Photos[PendingSlot].Name = PendingName
        Photos[PendingSlot].Revision = PendingRevision
        Photos[PendingSlot].Handle = Handle
        Photos[PendingSlot].Refresh = False
        Prefix = "TownThumbnail1." + PendingName
        Generation = 3 - Max(1, Min(2, Cache.ReadNumber(Prefix)))
        Key = Prefix + "." + Text_From_Code(48 + Generation)

        ' Publish the pair only after both checked blocks succeed.

        If Handle > 0 Then

            Ok = Store.SaveDocument(PendingMap, Key + ".Input", False)
            Ok = G.SaveViewportCapture3D(Handle, Key + ".Image") And Ok

            If Ok Then
                Ok = Cache.WriteNumber(Generation, Prefix)
            End If

        End If

    End If

    Call G.ResetViewport3D()

End Sub

Public Sub Update(ByRef Value As State, ByRef Map As World.State)

    Dim Index As Number

    For Index = 0 To Map.NodeCount - 1
        Value.Names[Index] = Map.Nodes[Index].Town
    End For

End Sub

Public Sub Draw(ByRef Value As State, Slot As Number, ScreenX As Number, ScreenY As Number,
    Width As Number, Height As Number)

    Dim Index As Number
    Dim Ok As Boolean

    If Width <= 0 Or Height <= 0 Then
        Return
    End If

    Fill Rectangle ScreenX, ScreenY, Width, Height, RGB(8, 17, 25)
    Index = Find(Value.Names[Slot])

    If Index >= 0 Then

        Ok = G.DrawViewportCapture3D(Photos[Index].Handle, ScreenX, ScreenY, Width, Height)

        If Not Ok Then
            Photos[Index].Handle = 0
            Photos[Index].Revision = -1
        End If

    End If

    If Not Ok Then
        Draw Text "Preparing Preview..." At ScreenX + Width / 2, ScreenY + Height / 2 Size 11 Color LIGHT_GRAY Centered
    End If

End Sub

Public Sub Destroy()

    Dim Index As Number

    For Index = 0 To 15
        Call G.ReleaseViewportCapture3D(Photos[Index].Handle)

        Photos[Index].Handle = 0
        Photos[Index].Revision = -1
    End For

End Sub

End Module
