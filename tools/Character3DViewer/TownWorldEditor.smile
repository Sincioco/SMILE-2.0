''' World editor orchestration; graph gestures, document and file jobs have focused owners.
Module Smile.Tools.TownWorldEditor

Option Explicit

Import Smile.Tools.TownWorldDocument As Document
Import Smile.Tools.TownWorldCanvas As Canvas
Import Smile.Tools.TownWorldView As View
Import Smile.Tools.TownWorldPreviews As Previews
Import Smile.Tools.TownWorldImport As ImportTown
Import Smile.Tools.TownWorldFiles As Files
Import Smile.Tools.TownDocumentStore As Storage
Import Smile.Tools.TownLibrary As Library
Import Smile.Tools.TownTabs As Tabs
Import Smile.Tools.TownEditorPanel As Panel
Import Smile.Tools.TownDocument As TownDocument
Import Smile.Tools.TownWorldTravel As Travel

Private Dim Map As Document.State
Private Dim Ui As Panel.State
Private Dim Graph As Canvas.State
Private Dim Transfer As Files.State
Private Dim Incoming As ImportTown.State
Private Dim Images As Previews.State
Private Dim Enabled As Boolean
Private Dim Dirty As Boolean
Private Dim Choosing As Boolean
Private Dim TownNames[16] As Text
Private Dim TownCount As Number
Private Dim ReturnTown As Text
Private Dim PreviewFailed[16] As Boolean
Private Dim Entering As Boolean
Private Dim Routes As Travel.State

Public Function Active() As Boolean

    Return Enabled

End Function

Public Sub Open(CreateNew As Boolean, Town As Text)

    Dim Name As Text
    Dim Empty As Document.State
    Dim EmptyGraph As Canvas.State
    Dim Ok As Boolean
    Dim Index As Number

    Call Update()

    If Transfer.Job > 0 Or Incoming.Job > 0 Then
        Return
    End If

    If Dirty Then

        Ok = Document.SaveWorld(Map)

        If Not Ok Then
            Ui.Message = "World save failed; changes retained."
            Return
        End If

        Dirty = False

    End If

    If CreateNew Then

        Name = Text_Prompt("New World", "Enter the world name.", "My World")

        If Text_Length(Name) < 1 Or Text_Length(Name) > 80 Then
            Return
        End If

        If Storage.Exists("TownEditor.World." + Name) Then
            Ui.Message = "That world name already exists."
            Return
        End If

        Map = Empty
        Map.Name = Name
        Ok = Document.Add(Map, Town, 500, 500)
        Dirty = True
        Ui.Message = "Connections follow each town's yellow Map Load areas."

    Else

        Ok = Files.Choose(Transfer, Map, False)
        Ui.Message = Transfer.Message

        If Not Ok Then
            Return
        End If

    End If

    Call Travel.Reset(Routes, Map)

    Enabled = True
    Entering = False

    If Town <> "" Then
        ReturnTown = Town
    End If

    For Index = 0 To 15
        PreviewFailed[Index] = False
    End For

    Graph = EmptyGraph
    Graph.Selected = -1
    Choosing = False

End Sub

Public Sub Reopen(Town As Text)

    Dim Restored As Boolean

    If Map.Name = "" Then
        Restored = Document.LoadWorld(Map, "", "TownEditor.World.Last")
    End If

    If Map.Name = "" Then
        Call Open(False, Town)

        Return
    End If

    If Graph.Camera.Zoom = 0 Then
        Call Canvas.Fit(Graph, Map, Panel.LeftEdge(), Window_Height())

        Graph.Selected = -1
    End If

    Call Travel.Reset(Routes, Map)

    Enabled = True
    Entering = False
    ReturnTown = Town
    Graph.DragNode = False
    Graph.ClickNode = 0
    Graph.EnterRequested = False
    Choosing = False

End Sub

Private Function Leave(Action As Number) As Text

    Dim Ok As Boolean
    Dim Result As Text

    If Transfer.Job > 0 Or Incoming.Job > 0 Then
        Ui.Message = "Wait for the file transfer to finish."
        Return ""
    End If

    Ok = Document.SaveWorld(Map)

    If Not Ok Then
        Ui.Message = "Save failed; changes retained."
        Return ""
    End If

    Dirty = False
    Enabled = False
    Result = ReturnTown

    If (Action = 5 And
        Graph.Selected >= 0 And
        Graph.Selected < Map.NodeCount) Then
        Result = Map.Nodes[Graph.Selected].Town
        Entering = True
    End If

    Return Result

End Function

Private Function ContainsTown(Name As Text) As Boolean

    Dim Index As Number

    For Index = 0 To Map.NodeCount - 1

        If Map.Nodes[Index].Town = Name Then
            Return True
        End If

    End For

    Return False

End Function

Public Sub Update()

    Dim Loaded As Boolean
    Dim WasRunning As Boolean

    WasRunning = Transfer.Job > 0
    Loaded = Files.Update(Transfer, Map)

    If WasRunning Then
        Ui.Message = Transfer.Message
    End If

    If Loaded Then

        Call Travel.Reset(Routes, Map)

        Graph.Selected = -1
        Dirty = Not Document.SaveWorld(Map)

        Call Canvas.Fit(Graph, Map, Panel.LeftEdge(), Window_Height())

    End If

    If (WasRunning And
        Transfer.Job = 0 And
        Map.Name = "") Then
        Enabled = False
    End If

End Sub

Public Function Input(Key As Number, ByRef OpenTabs As Tabs.State) As Text

    Dim Action As Number
    Dim Index As Number
    Dim Ok As Boolean
    Dim Result As Text
    Dim ImportRunning As Boolean

    If Not Enabled Then
        Return ""
    End If

    ImportRunning = Incoming.Job > 0
    Ok = ImportTown.Update(Incoming, OpenTabs, Map)
    Dirty = Dirty Or Ok

    If Ok Then
        Call Travel.Reset(Routes, Map)
    End If

    If ImportRunning Then
        Ui.Message = Incoming.Message
    End If

    Call Previews.Update(Images, Map)

    TownCount = OpenTabs.TabCount

    For Index = 0 To TownCount - 1
        TownNames[Index] = OpenTabs.Documents[Index].Name
    End For

    Call Update()

    If Transfer.Job > 0 And Not Transfer.Saving Then
        Return ""
    End If

    Call Travel.Update(Routes, Map, OpenTabs)

    Action = Panel.Input(Ui)

    If Choosing Then

        If Action >= 100 And Action < 100 + TownCount Then

            Index = Action - 100
            Ok = Library.Remember(OpenTabs.Documents[Index])

            If Ok Then
                Ok = Document.Add(Map, TownNames[Index], 250 + (Map.NodeCount Mod 3) * 250,
                    250 + (Map.NodeCount Mod 2) * 500)
            End If

            Call Travel.Reset(Routes, Map)

            Dirty = Dirty Or Ok
            Ui.Message = "Town could not be added; existing world retained."

            If Ok Then
                Ui.Message = "Town added."
                Choosing = False
            End If

        Else If Action = 9 Or Key = KEY_ESCAPE Then

            Choosing = False

        End If

    Else If Action = 1 Then

        Choosing = True

    Else If Action = 8 Then

        Call ImportTown.Choose(Incoming, OpenTabs, Map)

        Ui.Message = Incoming.Message

    Else If Action >= 30 And Action <= 36 Then

        If Action = 30 Or Action = 31 Then
            Call View.ZoomAt(Graph.Camera, (Action * 2 - 61) * 25,
                Panel.LeftEdge() / 2, Window_Height() / 2, Panel.LeftEdge(), Window_Height())
        Else If Action = 32 Then
            Graph.Camera.PanX = Graph.Camera.PanX + 80
        Else If Action = 33 Then
            Graph.Camera.PanX = Graph.Camera.PanX - 80
        Else If Action = 34 Then
            Graph.Camera.PanY = Graph.Camera.PanY + 80
        Else If Action = 35 Then
            Graph.Camera.PanY = Graph.Camera.PanY - 80
        Else

            Call Canvas.Fit(Graph, Map, Panel.LeftEdge(), Window_Height())
        End If

    Else If Action = 3 Or Key = KEY_DELETE Then

        If Graph.Selected >= 0 And Graph.Selected < Map.NodeCount Then

            Call Document.Remove(Map, Graph.Selected)
            Call Travel.Reset(Routes, Map)

            Graph.Selected = -1
            Graph.DragNode = False
                    Dirty = True

        End If

    Else If Action = 4 Then

        Ok = Files.Choose(Transfer, Map, True)
        Ui.Message = Transfer.Message

    Else If Action = 7 Then

        Call Open(False, "")

    Else If (Action = 5 Or
        Action = 6 Or
        Key = KEY_ESCAPE) Then

        Result = Leave(Action)

    Else

        If Pointer_X() < Panel.LeftEdge() And Pointer_Y() >= 180 Then

            If Pointer_Wheel_Delta() <> 0 Then
                Call View.ZoomAt(Graph.Camera, (Pointer_Wheel_Delta() / Abs(Pointer_Wheel_Delta())) * 25,
                    Pointer_X(), Pointer_Y(), Panel.LeftEdge(), Window_Height())
            End If

            Call View.Pan(Graph.Camera, Pointer_X(), Pointer_Y(), Pointer_Held(POINTER_MIDDLE) Or
                (Key_Held(KEY_SPACE) And Pointer_Held(POINTER_PRIMARY)))

        Else
            Graph.Camera.Dragging = False

        End If

        Ok = Canvas.Gesture(Graph, Map, Pointer_X(), Pointer_Y(), Pointer_Pressed(POINTER_PRIMARY),
            Pointer_Held(POINTER_PRIMARY), Not Graph.Camera.Dragging And
            Pointer_X() < Panel.LeftEdge() And Pointer_Y() >= 180,
            Panel.LeftEdge(), Window_Height())
        Dirty = Dirty Or Ok

        If Graph.EnterRequested Then
            Graph.EnterRequested = False
            Result = Leave(5)
        End If

    End If

    If Dirty And Not Graph.DragNode Then

        Ok = Document.SaveWorld(Map)
        Dirty = Not Ok

        If Not Ok Then
            Ui.Message = "Recovery save failed; edits remain in the editor."
        End If

    End If

    Return Result

End Function

Public Sub Draw(Optional LoadingTown As Text = "", Optional Progress As Number = 0)

    Dim Index As Number
    Dim X As Number

    If Not Enabled Then
        Return
    End If

    Fill Rectangle 0, 125, Window_Width(), Window_Height() - 125, RGB(12, 23, 36)
    Draw Text Map.Name At 30, 142 Size 24 Color WHITE

    Clip Rectangle 0, 180, Panel.LeftEdge(), Max(1, Window_Height() - 260)

    Call Canvas.Draw(Graph, Map, Images, Panel.LeftEdge(), Window_Height())

    End Clip

    X = Panel.LeftEdge() + 10
    Ui.ControlCount = 0

    If Choosing Then

        Draw Text "Add An Open Town" At X, 180 Size 17 Color CYAN

        For Index = 0 To TownCount - 1
            Call Panel.Button(Ui, 100 + Index, X, 214 + Index * 34, 283, TownNames[Index], False,
                Not ContainsTown(TownNames[Index]) And Map.NodeCount < Document.MAX_NODES)
        End For

        Call Panel.Button(Ui, 9, X, 222 + TownCount * 34, 283, "Cancel")

    Else

        Call Panel.Button(Ui, 1, X, 180, 283, "Add Open Town...")
        Call Panel.Button(Ui, 8, X, 218, 283, "Open .town File...", False, Transfer.Job = 0 And Incoming.Job = 0)
        Call Panel.Button(Ui, 3, X, 256, 283, "Remove Selected Town")
        Call Panel.Button(Ui, 4, X, 294, 139, "Save World...", False, Transfer.Job = 0 And Incoming.Job = 0)
        Call Panel.Button(Ui, 7, X + 144, 294, 139, "Open World...", False, Transfer.Job = 0 And Incoming.Job = 0)
        Call Panel.Button(Ui, 5, X, 332, 283, "Enter Selected Town", False, Transfer.Job = 0 And Incoming.Job = 0)
        Call Panel.Button(Ui, 6, X, 370, 283, "Back To Town Editor", False, Transfer.Job = 0 And Incoming.Job = 0)

    End If

    If Not Choosing Then

        Call Panel.Button(Ui, 30, X, 430, 66, "-")
        Call Panel.Button(Ui, 31, X + 72, 430, 66, "+")
        Call Panel.Button(Ui, 36, X + 144, 430, 139, "Reset View")
        Call Panel.Button(Ui, 32, X, 466, 66, "Left")
        Call Panel.Button(Ui, 34, X + 72, 466, 66, "Up")
        Call Panel.Button(Ui, 35, X + 144, 466, 66, "Down")
        Call Panel.Button(Ui, 33, X + 216, 466, 67, "Right")

    End If

    If LoadingTown <> "" Then

        Draw Text "Preparing " + LoadingTown At X, Window_Height() - 134 Size 13 Color CYAN
        Fill Rectangle X, Window_Height() - 108, 283, 12, RGB(29, 48, 65)
        Fill Rectangle X, Window_Height() - 108, 283 * Max(0, Min(100, Progress)) / 100, 12, RGB(40, 200, 195)

    Else If Transfer.Job > 0 Then

        Fill Rectangle X, Window_Height() - 108, 283, 12, RGB(29, 48, 65)
        Fill Rectangle X, Window_Height() - 108, 283 * Transfer.Progress / 100, 12, RGB(40, 200, 195)

    End If

    Draw Text "Double-click Town: Enter   Wheel: Zoom   Middle-drag: Pan   Arrows: Yellow Map Load Destinations" At 30, Window_Height() - 65 Size 14 Color WHITE

    For Index = 0 To Map.NodeCount - 1

        If Routes.Missing[Index] Then
            Ui.Message = "Map unavailable: " + Map.Nodes[Index].Town + "; its outgoing connections are unknown."
            Exit For
        End If

    End For

    Draw Text Ui.Message At 30, Window_Height() - 40 Size 14 Color RGB(240, 205, 140)

End Sub

Public Sub Close()

    Dim Ok As Boolean

    If Dirty Then
        Ok = Document.SaveWorld(Map)
        Dirty = Not Ok
    End If

    Enabled = False

End Sub

''' Visits missing photographs behind the world canvas, then restores the opening town.
Public Function PreviewRequest(CurrentTown As Text) As Text

    Dim Index As Number
    Dim Result As Text

    If (Not Enabled Or
        Transfer.Job > 0 Or
        Incoming.Job > 0 Or
        Not Previews.Has(CurrentTown)) Then
        Return ""
    End If

    For Index = 0 To Map.NodeCount - 1

        If Not PreviewFailed[Index] And Not Previews.Has(Map.Nodes[Index].Town) Then
            Result = Map.Nodes[Index].Town
            Return Result
        End If

    End For

    If CurrentTown <> ReturnTown Then
        Result = ReturnTown
    End If

    Return Result

End Function

Public Sub PreviewUnavailable(Name As Text)

    Dim Index As Number

    For Index = 0 To Map.NodeCount - 1

        If Map.Nodes[Index].Town = Name Then
            PreviewFailed[Index] = True
        End If

    End For

    Ui.Message = "Town file unavailable for preview: " + Name

End Sub

Public Function LastMessage() As Text

    Dim Result As Text

    Result = Ui.Message

    Return Result

End Function

Public Function EnteringTown() As Boolean

    Return Entering

End Function

End Module
