''' Caller-owned native town transfers; only Blender conversion uses the external worker.
Module Smile.Tools.TownFileJobs

Option Explicit

Import Smile.Tools.TownDocument As Document
Import Smile.Tools.TownDocumentStore As Storage
Import Smile.Tools.TownLibrary As Library
Import Smile.Tools.TownFileLocations As Locations
Import Smile.Tools.TownSavePreparation As Preparation
Import Smile.Tools.TownDerivedCache As Derived

Public Const SAVE_VIEWER = 1
Public Const OPEN_VIEWER = 2
Public Const SAVE_BLENDER = 3
Public Const OPEN_BLENDER = 4
Public Const LIST_VIEWER = 5
Public Const SAVE_PERMANENT = 6

Public Type State
    Preparation As Preparation.State
    Preparing As Boolean
    SaveAsCopy As Boolean
    RequestId As Number
    Operation As Number
    Clock As Number
    WaitingTime As Number
    NativeJob As Number
    DialogVisible As Boolean
    Failed As Boolean
    OriginRevision As Number
    OriginName As Text
    Path As Text
    LastPath As Text
    Message As Text
    Progress As Number
    RecentPaths[10] As Text
    RecentLabels[10] As Text
    RecentCount As Number
    Pending As Document.State
    SuppressReveal As Boolean
    BatchLabel As Text
End Type

Public Function BlocksEditing(ByRef Value As State) As Boolean

    Dim Result As Boolean

    Result = Value.RequestId > 0 And (Value.Operation = OPEN_VIEWER Or Value.Operation = OPEN_BLENDER)

    Return Result

End Function

Private Dim Bytes[170000] As Number
Private Dim Offset As Number

Public Function IdText(Id As Number) As Text

    Dim Result As Text

    Do
        Result = Text_From_Code(48 + Id Mod 10) + Result
        Id = Id / 10

    Loop Until Id = 0

    Return Result

End Function

Public Function SnapshotKey(Id As Number) As Text

    Dim Result As Text

    Result = "TownEditor.File.Snapshot." + IdText(Id)

    Return Result

End Function

Public Function OpenedKey(Id As Number) As Text

    Dim Result As Text

    Result = "TownEditor.File.Opened." + IdText(Id)

    Return Result

End Function

Private Sub PutInteger(Value As Number)

    Dim Index As Number

    For Index = 0 To 3
        Bytes[Offset] = Value Mod 256
        Offset = Offset + 1
        Value = Value / 256
    End For

End Sub

Public Function Queue(ByRef Value As State, ByRef Town As Document.State,
    Operation As Number, Path As Text, Optional RememberCurrent As Boolean = True) As Boolean

    Dim Id As Number
    Dim Ok As Boolean

    If (Value.RequestId > 0 Or
        Text_Length(Path) = 0 Or
        Text_Length(Path) > 4095) Then
        Return False
    End If

    Value.Operation = Operation
    Value.Path = Path
    Value.DialogVisible = Operation = SAVE_VIEWER Or Operation = SAVE_BLENDER Or Operation = SAVE_PERMANENT
    Value.Failed = False
    Value.Progress = 0
    Value.SuppressReveal = False
    Value.BatchLabel = ""

    If Operation = SAVE_BLENDER And Not Document.SupportsBlender(Town, True) Then

        Value.Failed = True
        Value.Message = "Blender: elevations/directed flow unsupported. Use Save for Viewer."
        Return False

    End If

    Load Id From "TownEditor.File.Sequence" Default 0
    Id = Id + 1
    Save Id To "TownEditor.File.Sequence"
    Ok = True

    If RememberCurrent Then
        Ok = Library.Remember(Town)
    End If

    If (Ok And
        (Operation = SAVE_VIEWER Or Operation = SAVE_BLENDER Or Operation = SAVE_PERMANENT)) Then
        Ok = Storage.SaveDocument(Town, SnapshotKey(Id), False)
    End If

    If Not Ok Then

        Value.Failed = True
        Value.Message = "Could not preserve the current town; edits retained."
        Return False

    End If

    Value.NativeJob = 0
    Value.Preparing = False

    If (Operation = SAVE_VIEWER Or
        Operation = SAVE_BLENDER Or
        Operation = SAVE_PERMANENT) Then

        Value.Preparing = True

    Else If Operation = OPEN_VIEWER Then

        Value.NativeJob = Data_BundleStart(False, OpenedKey(Id), Path, "")

    Else If Operation <> LIST_VIEWER Then

        Ok = SubmitBlender(Operation, Id, Path, Town.Name)

        If Not Ok Then

            Value.Failed = True
            Value.Message = "Could not start Blender conversion; edits retained."
            Return False

        End If

    End If

    If Operation = OPEN_VIEWER And Value.NativeJob = 0 Then

        Value.Failed = True
        Value.Message = "Another native file transfer is still running."
        Return False

    End If

    Value.SaveAsCopy = False
    Value.Pending = Town
    Value.OriginRevision = Town.Revision
    Value.OriginName = Town.Name
    Value.Operation = Operation
    Value.Path = Path
    Value.RequestId = Id
    Value.Clock = 0
    Value.WaitingTime = 0
    Value.Progress = 0
    Value.Message = "Opening town in background..."

    If Operation = SAVE_VIEWER Or Operation = SAVE_BLENDER Then
        Value.Message = "Saving chosen file in background..."
    End If

    If Operation = SAVE_PERMANENT Then

        Value.Pending.Name = Path
        Ok = Storage.SaveDocument(Value.Pending, SnapshotKey(Id), False)

        If Not Ok Then

            Value.RequestId = 0
            Value.Failed = True
            Value.Message = "Could not preserve the permanent snapshot; edits retained."
            Return False

        End If

    End If

    If Value.Preparing Then
        Call Preparation.Begin(Value.Preparation, Value.Pending, SnapshotKey(Id), Id)

        Value.Message = "Preparing the saved map revision..."
    End If

    Return True

End Function

Private Function SubmitBlender(Operation As Number, Id As Number, Path As Text, Name As Text) As Boolean

    Dim Index As Number
    Dim Status As Number
    Dim Ok As Boolean

    Offset = 0

    Call PutInteger(21387092)
    Call PutInteger(Operation)
    Call PutInteger(Id)
    Call PutInteger(Text_Length(Path))

    For Index = 0 To Text_Length(Path) - 1
        Call PutInteger(Text_Code_At(Path, Index))
    End For

    Call PutInteger(Text_Length(Name))

    For Index = 0 To Text_Length(Name) - 1
        Call PutInteger(Text_Code_At(Name, Index))
    End For

    Save Data Bytes Count Offset To "TownEditor.File.Request" Status Status
    Ok = Status = DATA_STATUS_OK

    Return Ok

End Function

Public Sub Choose(ByRef Value As State, ByRef Town As Document.State, Operation As Number)

    Dim Saving As Boolean
    Dim Extension As Text
    Dim Title As Text
    Dim Suggested As Text
    Dim Path As Text
    Dim Ok As Boolean

    If Value.RequestId > 0 Then
        Value.Message = "A file operation is still running."
        Return
    End If

    Saving = Operation = SAVE_VIEWER Or Operation = SAVE_BLENDER
    Extension = "town"
    Title = "Open Town for Viewer"

    If Saving Then
        Title = "Save Town for Viewer"
    End If

    If Operation = SAVE_BLENDER Or Operation = OPEN_BLENDER Then

        Extension = "blend"
        Title = "Open Blender File"

        If Saving Then
            Title = "Save Town for Blender"
        End If

    End If

    If Saving Then
        Suggested = Local_Timestamp() + " - " + SafeName(Town.Name) + "." + Extension
    End If

    Path = File_Pick(Saving, Title, Extension, Suggested)

    If Text_Length(Path) = 0 Then
        Value.Message = "Canceled; current town retained."
        Return
    End If

    Ok = Queue(Value, Town, Operation, Path)

End Sub

''' Returns True when Pending is ready for the caller to open in a new tab.
Public Function Update(ByRef Value As State, ByRef Town As Document.State, Elapsed As Number) As Boolean

    Dim Status As Storage.BridgeStatus
    Dim Ok As Boolean
    Dim Opened As Boolean

    If Value.Preparing Then

        Call Preparation.Update(Value.Preparation, Value.Pending, Value.RequestId)

        Value.Progress = Value.Preparation.Progress * 85 / 100
        Value.Message = "Preparing the saved map revision..."
        Value.Failed = Value.Preparation.Failed

        If Value.Preparation.Stage = 0 And Not Value.Failed Then

            Ok = Derived.BindBundle(Value.Pending, SnapshotKey(Value.RequestId))
            Value.Failed = Not Ok

            If Ok Then

                If Value.Operation = SAVE_PERMANENT Then

                    Value.Preparing = False
                    Value.Progress = 100
                    Value.RequestId = 0
                    Return True

                Else If Value.Operation = SAVE_BLENDER Then

                    Value.Failed = Not SubmitBlender(Value.Operation, Value.RequestId, Value.Path, Value.Pending.Name)

                Else
                    Value.NativeJob = Data_BundleStart(True, SnapshotKey(Value.RequestId),
                        Value.Path, Value.Preparation.Records)
                    Value.Failed = Value.NativeJob = 0

                End If

            End If

            Value.Preparing = False

        End If

        If Value.Failed Then

            Value.Message = "Map preparation could not finish; edits retained."
            Value.Preparing = False
            Value.RequestId = 0

        End If

        Return False

    End If

    Value.WaitingTime = Value.WaitingTime + Elapsed
    Value.Clock = Value.Clock + Elapsed

    ' Keep the initial 0% frame visible before polling a fast local write.

    If Value.Clock < 100 Then
        Return False
    End If

    Value.Clock = 0

    If Value.RequestId = 0 Then
        Return False
    End If

    If Value.NativeJob > 0 Then

        Status.RequestId = Value.RequestId
        Status.Status = Data_FileStatus(Value.NativeJob)
        Status.Progress = Data_FileProgress(Value.NativeJob)
        Status.Message = Data_FileMessage(Value.NativeJob)

    Else If Value.Operation = LIST_VIEWER Then

        Status.RequestId = Value.RequestId
        Status.Status = 1

    Else
        Status = Storage.ReadBridgeStatus("TownEditor.File.Response")

    End If

    If Status.RequestId <> Value.RequestId Then

        Value.Message = "Starting Blender conversion..."

        If Value.WaitingTime > 15000 Then
            Value.Message = "Waiting for Blender to respond. You can continue editing."
        End If

        Return False

    End If

    Value.Message = Status.Message
    Value.Progress = Min(99, Max(0, Status.Progress))

    If Value.Operation = SAVE_VIEWER Or Value.Operation = SAVE_BLENDER Then
        Value.Progress = 85 + Value.Progress * 14 / 100
    End If

    Value.Failed = Status.Status <> 0 And Status.Status <> 1

    If Status.Status = 0 Then
        Return False
    End If

    If Status.Status = 1 Then

        If Value.Operation = OPEN_VIEWER Or Value.Operation = OPEN_BLENDER Then

            Ok = Storage.LoadDocument(Value.Pending, OpenedKey(Value.RequestId))

            If Ok Then
                Ok = Derived.BindBundle(Value.Pending, OpenedKey(Value.RequestId))
                Ok = Library.Remember(Town) And Ok
            End If

            If Ok Then
                Opened = True
                Value.Message = "Town opened in a new tab."
            Else
                Value.Failed = True
                Value.Message = "Invalid town; current edits retained."
            End If

        Else If Value.Operation = LIST_VIEWER Then

            Call ReadRecent(Value, Town.Name)

        Else

            ' Publishing an older snapshot must never overwrite a newer working recovery,
            ' including when the user switched to another map while this save ran.
            Ok = Storage.SaveDocument(Value.Pending, "TownEditor.Town." + Value.Pending.Name)

            If (Ok And
                Not Value.SaveAsCopy And
                Town.Name = Value.OriginName And
                Town.Revision = Value.OriginRevision) Then
                Town.Name = Value.Pending.Name
                Town.SavedRevision = Town.Revision
            End If

            Ok = Library.Remember(Town) And Ok
            Value.Message = "Saved and verified."

            If Town.Name = Value.OriginName And Town.Revision <> Value.OriginRevision Then
                Value.Message = "Snapshot saved. Newer edits are still unsaved."
            End If

            If Value.Operation = SAVE_VIEWER Then
                Ok = RememberFile(Value) And Ok
            End If

            If Not Value.SuppressReveal Then
                Ok = File_Reveal(Value.Path) And Ok
            End If

            Ok = Locations.Remember(Value.Path, Value.Operation = SAVE_BLENDER) And Ok
            Opened = Value.SaveAsCopy

            If Not Ok Then

                Value.Failed = True
                Value.Progress = 99
                Value.Message = "File saved and verified; recovery, recent files or Explorer could not finish."

            Else
                Value.Progress = 100

            End If

        End If

        If Value.Operation <> LIST_VIEWER Then
            Value.LastPath = Value.Path
        End If

    End If

    Value.RequestId = 0
    Value.NativeJob = 0

    Return Opened

End Function

Public Function FileLabel(Path As Text) As Text

    Dim Index As Number
    Dim Start As Number
    Dim Letter As Number
    Dim Ending As Number
    Dim Result As Text

    Ending = Text_Length(Path)

    For Index = 0 To Text_Length(Path) - 1

        Letter = Text_Code_At(Path, Index)

        If Letter = 47 Or Letter = 92 Then
            Start = Index + 1
            Ending = Text_Length(Path)
        Else If Letter = 46 Then
            Ending = Index
        End If

    End For

    Result = Text_Slice(Path, Start, Ending - Start)

    Return Result

End Function

Public Function SafeName(Name As Text) As Text

    Dim Index As Number
    Dim Letter As Number
    Dim Result As Text

    For Index = 0 To Text_Length(Name) - 1

        Letter = Text_Code_At(Name, Index)

        If (Letter < 32 Or
            Letter = 34 Or
            Letter = 42 Or
            Letter = 47 Or
            Letter = 58 Or
            Letter = 60 Or
            Letter = 62 Or
            Letter = 63 Or
            Letter = 92 Or
            Letter = 124) Then
            Letter = 95
        End If

        Result = Result + Text_From_Code(Letter)
    End For

    Return Result

End Function

Private Function GetInteger() As Number

    Dim Result As Number
    Dim Factor As Number
    Dim Index As Number

    Factor = 1

    For Index = 0 To 3
        Result = Result + Bytes[Offset] * Factor
        Factor = Factor * 256
        Offset = Offset + 1
    End For

    Return Result

End Function

Private Sub ReadRecent(ByRef Value As State, TownName As Text)

    Dim ByteCount As Number
    Dim Status As Number
    Dim Index As Number
    Dim Letter As Number
    Dim Length As Number
    Dim Id As Number
    Dim Path As Text

    Value.RecentCount = 0
    Load Data "TownEditor.File.History." + TownName Into Bytes Count ByteCount Status Status

    If Status <> DATA_STATUS_OK Or ByteCount < 12 Then
        Return
    End If

    Offset = 0
    Id = GetInteger()

    If Id <> 21780308 Then
        Return
    End If

    Id = GetInteger()
    Length = GetInteger()

    If (Length < 0 Or
        Length > 10) Then
        Return
    End If

    For Index = 0 To Length - 1

        If Offset + 4 > ByteCount Then
            Return
        End If

        Id = GetInteger()
        Path = ""

        If (Id < 1 Or
            Id > 4095 Or
            Offset + Id * 4 > ByteCount) Then
            Return
        End If

        For Letter = 0 To Id - 1
            Path = Path + Text_From_Code(GetInteger())
        End For

        Value.RecentPaths[Index] = Path
        Value.RecentLabels[Index] = FileLabel(Path)
    End For

    Value.RecentCount = Length

End Sub

Private Function RememberFile(ByRef Value As State) As Boolean

    Dim Index As Number
    Dim Letter As Number
    Dim Status As Number
    Dim PathCount As Number
    Dim Path As Text

    Call ReadRecent(Value, Value.Pending.Name)

    ' Keep ten selectable versions; older user-owned files remain on disk.
    Offset = 0

    Call PutInteger(21780308)
    Call PutInteger(0)
    Call PutInteger(0)

    For Index = -1 To Value.RecentCount - 1

        Path = Value.Path

        If Index >= 0 Then
            Path = Value.RecentPaths[Index]
        End If

        If Index = -1 Or Path <> Value.Path Then

            Call PutInteger(Text_Length(Path))

            For Letter = 0 To Text_Length(Path) - 1
                Call PutInteger(Text_Code_At(Path, Letter))
            End For

            PathCount = PathCount + 1

            If PathCount = 10 Then
                Exit For
            End If

        End If

    End For

    Bytes[8] = PathCount
    Save Data Bytes Count Offset To "TownEditor.File.History." + Value.Pending.Name Status Status

    If Status <> DATA_STATUS_OK Then
        Return False
    End If

    Return True

End Function

End Module
