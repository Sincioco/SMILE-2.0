''' Standalone native tab host. Kael Party remains the unchanged Viewer workflow.
Module Smile.Tools.NativeViewerHost

Option Explicit

Import Smile.Tools.Character3DViewerWorkflow As Workflow
Import Smile.Tools.Character3DViewerProfiles As Profiles
Import Smile.Tools.ViewerBattlePlanning As Planning
Import Smile.Tools.ViewerBattlePresentation As Presentation
Import Smile.Tools.ViewerBattleUi As BattleUi
Import Smile.Tools.ViewerBattleOutcome As Outcome
Import Smile.Tools.ViewerBattleHud As Hud
Import Smile.Tools.ViewerBattleCinematics As Cinematics
Import Smile.Tools.NerisTown As Town
Import Smile.UI.Controls As UI
Import SinStarI.BattleRules As Rules

Public Const BATTLE_TAB = 15
Public Const TOWN_TAB = 16

Public Function TabAt(Position As Number) As Number

    Select Case Position
        Case 0
            Return 0
        Case 1
            Return 1
        Case 2
            Return 4
        Case 3
            Return 5
        Case 4
            Return Profiles.CHARACTER_TAB_MIRA
        Case 5
            Return 2
        Case 6
            Return 6
        Case 7
            Return Profiles.CHARACTER_TAB_PARTY_DRAGON
        Case 8
            Return Profiles.CHARACTER_TAB_PARTY_VRAX
        Case 9
            Return Profiles.CHARACTER_TAB_KAEL
        Case 10
            Return Profiles.CHARACTER_TAB_PARTY_KAEL
        Case 12
            Return TOWN_TAB
    End Select

    Return BATTLE_TAB

End Function

Public Function TabLabel(Position As Number) As Text

    Select Case Position
        Case 0
            Return "Arin"
        Case 1
            Return "Orin"
        Case 2
            Return "Valor"
        Case 3
            Return "Zara"
        Case 4
            Return "Mira"
        Case 5
            Return "Dragon"
        Case 6
            Return "Vrax"
        Case 7
            Return "Party Dragon"
        Case 8
            Return "Party Vrax"
        Case 9
            Return "Kael"
        Case 10
            Return "Kael Party"
        Case 12
            Return "Neris Town"
    End Select

    Return "Battle System"

End Function

Public Function TabWidth(Position As Number) As Number

    If Position = 11 Or Position = 12 Then
        Return 106
    Else If (Position = 7 Or
        Position = 8 Or
        Position = 10) Then
        Return 84
    End If

    Return 52

End Function

Public Class Session

    Private Encounter As Planning.State
    Private Visual As Presentation.State
    Private Menus As BattleUi.State
    Private Ending As Outcome.State
    Private Camera As Cinematics.State
    Private BattlePanel As Boolean
    Private SelectedTab As Number
    Private PreviousTime As Number
    Private Elapsed As Number
    Private Inspecting As Boolean
    Private BattleActive As Boolean
    Private HeaderHidden As Boolean
    Private Paused As Boolean
    Private TownScene As Town.State

    Public Sub Start(Viewer As Workflow.Session, InitialTab As Number, Hosted As Boolean, Width As Number, Height As Number)

        Dim ViewerTab As Number

        Me.Camera.Enabled = True
        Me.BattlePanel = True
        Me.SelectedTab = InitialTab
        ViewerTab = InitialTab

        If InitialTab = TOWN_TAB Then

            Call Town.Start(Me.TownScene)

            Me.PreviousTime = Timer()

            Return

        End If

        If InitialTab = BATTLE_TAB Then
            ViewerTab = Profiles.CHARACTER_TAB_PARTY_KAEL
        End If

        Call Viewer.Start(ViewerTab, Hosted, Width, Height)
        Call Viewer.ConfigureExternalHost(False)

        If InitialTab = BATTLE_TAB Then
            Call Me.BeginBattle(Viewer)
        End If

        Me.PreviousTime = Timer()

    End Sub

    Public Sub SelectTab(Viewer As Workflow.Session, Index As Number)

        Dim ViewerTab As Number

        If Not Viewer.CanSwitchTab() Then
            Return
        End If

        ViewerTab = Index

        If Index = BATTLE_TAB Then
            ViewerTab = Profiles.CHARACTER_TAB_PARTY_KAEL
        End If

        If Me.BattleActive Then
            Call Presentation.Destroy(Me.Visual)
        End If

        If Index = TOWN_TAB Then

            If Me.SelectedTab <> TOWN_TAB Then
                Call Viewer.Release()
                Call Town.Start(Me.TownScene)
            End If

            Me.SelectedTab = TOWN_TAB
            Me.BattleActive = False
            Me.HeaderHidden = False
            Me.PreviousTime = Timer()

            Return

        End If

        If Me.SelectedTab = TOWN_TAB Then
            Call Town.Destroy(Me.TownScene)
            Call Viewer.Start(ViewerTab, False, Window_Width(), Window_Height())
        End If

        Call Viewer.ConfigureExternalHost(False)
        Call Viewer.SelectTab(ViewerTab)

        If Viewer.TabIndex() <> ViewerTab Then
            Return
        End If

        Me.SelectedTab = Index
        Me.BattleActive = Index = BATTLE_TAB
        Me.HeaderHidden = False

        If Me.BattleActive Then
            Call Me.BeginBattle(Viewer)
        End If

        Me.PreviousTime = Timer()

    End Sub

    Private Sub BeginBattle(Viewer As Workflow.Session)

        Dim EmptyMenus As BattleUi.State
        Dim EmptyEnding As Outcome.State

        Me.BattleActive = True
        Me.Paused = False
        Me.HeaderHidden = False
        Me.Menus = EmptyMenus
        Me.Ending = EmptyEnding

        Call Viewer.ConfigureExternalHost(True)
        Call Planning.Start(Me.Encounter, True)
        Call Presentation.Create(Me.Visual, Viewer)
        Call Presentation.Apply(Me.Visual, Viewer, Me.Encounter.Combat, 0)
        Call Presentation.OrdersCamera(Viewer)
        Call Cinematics.Reset(Me.Camera, Viewer)

    End Sub

    Public Sub RestartBattle(Viewer As Workflow.Session)

        Dim EmptyMenus As BattleUi.State
        Dim EmptyEnding As Outcome.State

        If Not Me.BattleActive Or Not Viewer.CanSwitchTab() Then
            Return
        End If

        Me.Menus = EmptyMenus
        Me.Ending = EmptyEnding
        Me.Paused = False

        Call Viewer.ResumeDirectedScene()
        Call Viewer.ConfigureExternalHost(True)
        Call Planning.Start(Me.Encounter, True)
        Call Presentation.Restart(Me.Visual)
        Call Presentation.Apply(Me.Visual, Viewer, Me.Encounter.Combat, 0)
        Call Presentation.OrdersCamera(Viewer)
        Call Cinematics.Reset(Me.Camera, Viewer)

    End Sub

    Public Sub StandaloneInput(Viewer As Workflow.Session, Key As Number)

        Dim Index As Number
        Dim X As Number
        Dim Blocked As Boolean
        Dim OptionsPanel As Boolean
        Dim ViewerKey As Number
        Dim WasPlanning As Boolean
        Dim Layout As Hud.Layout

        X = 18
        Blocked = Not Me.HeaderHidden And UI.Contains(18, 62, 980, 26)

        Call BattleUi.ObserveActivity(Me.Menus, Key)

        If (Me.BattleActive And
            Key = KEY_SPACE And
            Viewer.CanSwitchTab() And
            Not Me.Menus.Stats.Visible) Then
            Me.Paused = Not Me.Paused
            Return
        End If

        If (Me.BattleActive And
            Key = KEY_C And
            Viewer.SceneReady() And
            Viewer.CanSwitchTab() And
            Not Me.Menus.Stats.Visible) Then

            Call Cinematics.ReturnToOrders(Me.Camera, Viewer)

            If Me.Ending.Started Then
                Me.Ending.OrbitTime = Outcome.ORBIT_DURATION
            End If

            Return

        End If

        If Me.BattleActive And Pointer_Pressed(POINTER_SECONDARY) Then
            Call Me.RestartBattle(Viewer)

            Return
        End If

        If Me.BattleActive And Me.Ending.Visible Then
            Call Outcome.Input(Me.Ending, Key)

            Return
        End If

        If (Me.BattleActive And
            Key = KEY_BACKTICK And
            Viewer.PanelVisibility() = 2 And
            Not Me.Menus.Stats.Visible) Then

            Me.HeaderHidden = Not Me.HeaderHidden

            If Me.HeaderHidden Then
                Return
            End If

        End If

        If Not Me.Menus.Stats.Visible And Not Me.HeaderHidden Then

            For Index = 0 To 12

                If UI.Clicked(X, 62, TabWidth(Index) - 4, 26) Then
                    Call Me.SelectTab(Viewer, TabAt(Index))

                    Return
                End If

                X = X + TabWidth(Index)
            End For

        End If

        ViewerKey = Key

        If Me.SelectedTab = TOWN_TAB Then
            Call Town.Input(Me.TownScene, Key, Pointer_Y() < 94 Or Blocked)

            Return
        End If

        If Me.BattleActive Then

            Layout = Hud.Arrange(Window_Width(), Window_Height(), Viewer.PanelVisibility(),
                Me.HeaderHidden)
            WasPlanning = Me.Encounter.Planning

            If Not Me.Menus.Stats.Visible Then
                OptionsPanel = Hud.OptionsInput(Me.BattlePanel, Me.Camera.Enabled,
                    Viewer.PanelVisibility(), Viewer.CanSwitchTab())
                Blocked = OptionsPanel Or Blocked
            End If

            If Viewer.CanSwitchTab() Then
                Call BattleUi.Update(Me.Menus, Me.Encounter, Key, Layout, OptionsPanel)
            End If

            If WasPlanning And Not Me.Encounter.Planning Then
                Call Viewer.ResumeDirectedScene()
            End If

            Blocked = Blocked Or BattleUi.Blocked(Me.Menus, Layout)

            ''' Inspectors may open during a round, but editing waits for its boundary.

            If Not Me.Encounter.Planning And Viewer.PanelVisibility() <> 2 Then
                Blocked = Blocked Or Pointer_X() < 278 Or Pointer_X() >= Window_Width() - 278 Or Pointer_Y() >= Window_Height() - 100
            End If

            If (Me.Menus.Stats.Visible Or
                Key = KEY_ENTER Or
                Key = KEY_SPACE Or
                Key = KEY_ESCAPE Or
                (Me.Encounter.Planning And (Key = KEY_UP Or Key = KEY_DOWN Or
                Key = KEY_LEFT Or Key = KEY_RIGHT))) Then
                ViewerKey = KEY_NONE
            End If

        End If

        Call Viewer.StandaloneInput(ViewerKey, Blocked)

    End Sub

    Public Sub UpdateFrame(Viewer As Workflow.Session, Width As Number, Height As Number)

        Dim Now As Number
        Dim FrameElapsed As Number
        Dim StartedAutomatically As Boolean
        Dim EscapeRoll As Number
        Dim TargetRoll As Number
        Dim WasPlanning As Boolean
        Dim CameraElapsed As Number

        Now = Timer()
        FrameElapsed = Max(0, Now - Me.PreviousTime)
        Me.Elapsed = Min(100, FrameElapsed)
        CameraElapsed = Me.Elapsed
        Me.PreviousTime = Now

        If Me.SelectedTab = TOWN_TAB Then
            Call Town.Update(Me.TownScene, Me.Elapsed)

            Return
        End If

        If Me.Paused And Not Me.Camera.DefaultRequested Then
            CameraElapsed = 0
        End If

        If Me.BattleActive Then

            Me.Inspecting = (Me.Encounter.Planning And Viewer.PanelVisibility() <> 2) Or Viewer.HasEdits()

            StartedAutomatically = Planning.AdvanceInitialIdle(
                Me.Encounter,
                FrameElapsed,
                Me.Menus.InputActive,
                Viewer.SceneReady() And Viewer.CanSwitchTab() And
                    Not Me.Inspecting And Not Me.Menus.Stats.Visible And Not Me.Paused
            )

            If StartedAutomatically Then

                Me.Menus.Page = 0
                Me.Menus.Selection = 0

                Call Viewer.ResumeDirectedScene()

            End If

            Call Viewer.PauseDirectedPlayback(Me.Paused Or Me.Inspecting Or
                (Me.Menus.Stats.Visible And Me.Encounter.Planning))

            If (Not Me.Paused And
                Not Me.Inspecting And
                Viewer.SceneReady()) Then

                Random EscapeRoll From 0 To 99
                Random TargetRoll From 0 To 3

                WasPlanning = Me.Encounter.Planning

                Call Presentation.BeginAction(Me.Visual, Viewer, Me.Encounter.Combat)
                Call Planning.Advance(Me.Encounter, Me.Elapsed, EscapeRoll, TargetRoll)
                Call Presentation.BeginAction(Me.Visual, Viewer, Me.Encounter.Combat)
                Call Presentation.Apply(Me.Visual, Viewer, Me.Encounter.Combat, Me.Elapsed)

                If Me.Encounter.Combat.Phase >= Rules.VICTORY And Not Me.Ending.Started Then
                    Me.Menus.Stats.Visible = False

                    Call Outcome.Start(Me.Ending, Me.Encounter.Combat.Phase = Rules.VICTORY)
                End If

                If Me.Ending.Started Then
                    Call Outcome.Update(Me.Ending, Viewer, FrameElapsed)
                End If

                If Outcome.RestartDue(Me.Ending) Then
                    Call Me.RestartBattle(Viewer)
                End If

                If (Me.Encounter.Planning And
                    Not WasPlanning And
                    Not Me.Camera.Enabled) Then
                    Call Presentation.OrdersCamera(Viewer)
                End If

            End If

        End If

        If (Me.BattleActive And
            Viewer.SceneReady() And
            Viewer.CanSwitchTab() And
            (Not Me.Ending.Started Or Me.Ending.OrbitTime >= Outcome.ORBIT_DURATION)) Then
            Call Cinematics.Update(Me.Camera, Viewer, Me.Encounter.Combat,
                CameraElapsed, Width, Height)
        End If

        Call Viewer.UpdateFrame(Width, Height)

    End Sub

    Public Sub DrawFrame(Viewer As Workflow.Session)

        If Me.SelectedTab = TOWN_TAB Then
            Call Town.Draw(Me.TownScene)
        Else

            Call Viewer.DrawFrame()
        End If

    End Sub

    Public Sub DrawStandaloneOverlay(Viewer As Workflow.Session)

        Dim Index As Number
        Dim X As Number

        If Me.SelectedTab = TOWN_TAB Then
            Call Town.Overlay(Me.TownScene)
        Else

            Call Viewer.DrawStandaloneOverlay()
        End If

        X = 18

        If Not Me.HeaderHidden Then

            For Index = 0 To 12
                Call UI.DrawButton(X, 62, TabWidth(Index) - 4, 26,
                    TabLabel(Index), Me.SelectedTab = TabAt(Index))

                X = X + TabWidth(Index)
            End For

        End If

        If Me.BattleActive Then

            If Viewer.PanelVisibility() = 2 And Not Me.HeaderHidden Then
                Draw Text "SMILE 2.0 - Battle System" At 18, 12 Size 22 Color WHITE
            End If

            Call Presentation.Draw(Me.Visual, Viewer, Me.Encounter.Combat)
            Call Hud.DrawOptions(Me.BattlePanel, Me.Camera.Enabled, Viewer.PanelVisibility())
            Call BattleUi.Draw(Me.Menus, Me.Encounter, Me.Inspecting,
                Hud.Arrange(Window_Width(), Window_Height(), Viewer.PanelVisibility(),
                    Me.HeaderHidden), Me.Paused)
            Call Outcome.Draw(Me.Ending, Me.Encounter)

        End If

    End Sub

    Public Sub Release(Viewer As Workflow.Session)

        If Me.SelectedTab = TOWN_TAB Then
            Call Town.Destroy(Me.TownScene)

            Return
        End If

        If Me.BattleActive Then
            Call Presentation.Destroy(Me.Visual)
        End If

        Call Viewer.Release()

    End Sub

End Class

End Module
