Call Check(CalibrationOperation.Ready)
Call Check(UiState.CalibrationTarget = ViewerUi.CALIBRATION_TARGET_SWORD)
Call Check(Not GizmoState.GripAnchorActive)

Call ViewerUi.ClearConfirmation(UiState)

CalibrationOperation = ViewerCalibrationControls.ApplyPointerAction(
