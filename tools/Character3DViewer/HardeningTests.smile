    ViewerUi.CALIBRATION_TRANSFORM_ROTATE,
    ViewerUi.CALIBRATION_AXIS_X,
    GizmoState.Origin, DirectCamera, 800, 640)

Call Check(Not GizmoPointer.Consumed And
    GizmoPointer.Action = ViewerGizmo.POINTER_ACTION_NONE)

GizmoPointer = ViewerGizmo.ClassifyPointer(
    GizmoState, True, True, 0, False,
    True, False, False, False, False,
    0, 0, 0, 0, True, 90, 540, 700,
    18, 92, 430, 354,
    ViewerUi.CALIBRATION_TRANSFORM_ROTATE,
    ViewerUi.CALIBRATION_AXIS_X,
    GizmoState.Origin, DirectCamera, 800, 640)

Call Check(GizmoPointer.Consumed And
    GizmoPointer.Action = ViewerGizmo.POINTER_ACTION_NONE)

GizmoPointer = ViewerGizmo.ClassifyPointer(
    GizmoState, True, True, 0, False,
    True, True, False, False, False,
    0, 0, 0, 0, True, 90, 540, 700,
    18, 92, 430, 354,
    ViewerUi.CALIBRATION_TRANSFORM_ROTATE,
    ViewerUi.CALIBRATION_AXIS_X,
