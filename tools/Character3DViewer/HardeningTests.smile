Dim SecondApproach As Core.Vector3

Game Window "Character 3D Viewer Hardening Tests" Size 320 By 240

Call ViewerTiming.Advance(FrameRate, 250)
Call ViewerTiming.Advance(FrameRate, 250)
Call Check(ViewerTiming.FramesPerSecond(FrameRate) = 4)
Call ViewerTiming.Reset(FrameRate)
Call Check(ViewerTiming.FramesPerSecond(FrameRate) = 0)

Call ViewerTiming.Start(RuntimeClock, 1000)
Call Check(ViewerTiming.AdvanceClock(RuntimeClock, 1100, 250, 250, 60000))
Call Check(RuntimeClock.RawFrameMilliseconds = 100)
Call Check(RuntimeClock.AnimationElapsed = 100)
Call Check(RuntimeClock.CameraElapsed = 100)
Call Check(RuntimeClock.PresentationElapsed = 100)
Call Check(ViewerTiming.AdvanceClock(RuntimeClock, 101100, 250, 250, 60000))
Call Check(RuntimeClock.RawFrameMilliseconds = 60000)
Call Check(RuntimeClock.AnimationElapsed = 250)
Call Check(RuntimeClock.CameraElapsed = 250)
Call Check(RuntimeClock.DroppedAnimationMilliseconds = 59750)
Call Check(RuntimeClock.DroppedCameraMilliseconds = 59750)
Call Check(RuntimeClock.LongPauseCount = 1)

Call ViewerPlayback.Reset(PlaybackState, 100)
Call Check(PlaybackState.SelectedClip = 0)
Call Check(PlaybackState.PlaybackSpeed = 100)
Call Check(PlaybackState.DemoEnabled)
Call Check(Not PlaybackState.ScenePaused)

PlaybackState.ScenePaused = True

Call ViewerPlayback.ResolveAnimationElapsed(PlaybackState, 16)
Call Check(PlaybackState.AnimationUpdateElapsed = 0)

PlaybackState.ScenePaused = False

Call ViewerPlayback.ResolveAnimationElapsed(PlaybackState, 16)
Call Check(PlaybackState.AnimationUpdateElapsed = 16)
Call ViewerPlayback.AdjustSpeed(PlaybackState, 25, 200, 150)
Call Check(PlaybackState.PlaybackSpeed = 200)
Call ViewerPlayback.AdjustSpeed(PlaybackState, 25, 200, -500)
Call Check(PlaybackState.PlaybackSpeed = 25)
Call Check(ViewerPlayback.ClipMode(ViewerProfiles.PROFILE_ARIN, "Idle") =
    Graphics3D.ANIMATION_LOOP)
Call Check(ViewerPlayback.DemoTarget(ViewerProfiles.PROFILE_DRAGON, 7000) = 7000)
Call Check(ViewerPlayback.DemoTarget(ViewerProfiles.PROFILE_ORIN, 7000) = 3000)

PlaybackState.AnimationCycleElapsed = 90

Call ViewerPlayback.SelectClip(PlaybackState, 2, True)
Call Check(PlaybackState.SelectedClip = 2 And
    PlaybackState.AnimationCycleElapsed = 0 And PlaybackState.DemoEnabled)
Call ViewerPlayback.SelectClip(PlaybackState, 1, False)
Call Check(PlaybackState.SelectedClip = 1 And Not PlaybackState.DemoEnabled)

PartyParticipantUpdate = ViewerParty.UpdateCompanion(
    PartyState, CalibrationState, EffectsState, 16, False)

Call Check(Not PartyParticipantUpdate.Updated And
    PartyParticipantUpdate.Ready)
Call Check(ViewerCalibrationEditing.CurrentValue(
    CalibrationState, 0, UiState) = 0)
Call Check(Not ViewerCalibrationEditing.FinishEdit(
    UiState, GizmoState, CameraState, EffectsState))

Call ViewerSession.ResetFailure(SessionState)
Call Check(SessionState.Ready)
Call Check(Not SessionState.ViewerError)

SessionState.Ready = False

Call ViewerSession.CaptureFailure(SessionState, 77)
Call ViewerSession.CaptureFailure(SessionState, 78)
Call Check(SessionState.FirstFailureStage = 77)
Call ViewerSession.RecordError(SessionState)
Call Check(SessionState.ViewerError)

Call ViewerCamera.Reset(CameraState, 0, -16, -144, 36, 96000)
Call Interaction.ResetCameraControls(DirectControls)
Call CharacterViewer.InitializeZoom(DirectZoom, -16, -144, 36, 96000)
Call Check(CameraState.Controls.OrbitYaw = DirectControls.OrbitYaw)
Call Check(CameraState.Zoom.Current1000 = DirectZoom.Current1000)

CameraState.Frame.PanXLimit = 10
CameraState.Frame.PanYLimit = 8
CameraState.AutoOrbit = True
TestResult = Interaction.UpdateOrbitControls(DirectControls, True, True, True, -5, 2)

Call Check(ViewerCamera.NudgeOrbit(CameraState, -5, 2))
Call Check(CameraState.Controls.OrbitYaw = DirectControls.OrbitYaw)
Call Check(CameraState.Controls.OrbitPitch = DirectControls.OrbitPitch)
Call Check(Not CameraState.AutoOrbit)

TestResult = Interaction.UpdatePanZoomControls(
    DirectControls, True, True, True, -20, 20, 0)
DirectControls.PanX = Min(10, Max(-10, DirectControls.PanX))
DirectControls.PanY = Min(8, Max(-8, DirectControls.PanY))

Call Check(ViewerCamera.NudgePan(CameraState, -20, 20))
Call Check(CameraState.Controls.PanX = DirectControls.PanX)
Call Check(CameraState.Controls.PanY = DirectControls.PanY)

Call CharacterViewer.AdjustZoomTarget(DirectZoom, -2, 8)
Call ViewerCamera.AdjustZoomTarget(CameraState, -2, 8)
Call Check(CharacterViewer.AdvanceZoom(DirectZoom, 33))
Call Check(ViewerCamera.AdvanceZoom(CameraState, 33))
Call Check(CameraState.Zoom.Current1000 = DirectZoom.Current1000)
Call Check(CameraState.Zoom.Target1000 = DirectZoom.Target1000)
Call Check(CameraState.Controls.Zoom = CharacterViewer.ZoomDegrees(DirectZoom))

CameraState.Base = Graphics3D.DefaultCamera()
DirectCamera = Interaction.ApplyScreenSpaceCameraControls(
    CameraState.Base, CameraState.Controls)

Call ViewerCamera.Compose(CameraState, False)
Call Check(CameraState.Live.Position.X = DirectCamera.Position.X)
Call Check(CameraState.Live.Position.Y = DirectCamera.Position.Y)
Call Check(CameraState.Live.Position.Z = DirectCamera.Position.Z)
Call Check(CameraState.Live.Target.X = DirectCamera.Target.X)
Call Check(CameraState.Live.Target.Y = DirectCamera.Target.Y)
Call Check(CameraState.Live.Target.Z = DirectCamera.Target.Z)

Call ViewerCamera.SetHorizontalOrbit(CameraState, 500)
Call ViewerCamera.SetVerticalOrbit(CameraState, -500)
Call Check(CameraState.Controls.OrbitYaw = 180)
Call Check(CameraState.Controls.OrbitPitch = -180)
Call ViewerCamera.SetZoom(CameraState, -200, -144, 36)
Call Check(CharacterViewer.ZoomDegrees(CameraState.Zoom) = -144)
Call ViewerCamera.StartAutoOrbit(CameraState)
Call Check(ViewerCamera.AdvanceAutoOrbit(CameraState, CameraPhase1000, 250, 12, False))
Call Check(CameraState.AutoOrbitYaw1000 = 183000)
Call Check(CameraState.Controls.OrbitYaw = 183)

CameraState.Live.Position.Y = -40
CameraState.Live.Target.Y = 65

Call ViewerCamera.KeepAboveGround(CameraState, 0)
Call Check(CameraState.Live.Position.Y = 0 And CameraState.Live.Target.Y = 65)

CameraState.Controls.Orbiting = True
CameraState.Controls.Panning = True
CameraState.PanPointerRemainderX = 2
CameraState.OrbitPointerRemainderY = -2

Call ViewerCamera.CancelPointerControls(CameraState)
Call Check(Not CameraState.Controls.Orbiting And Not CameraState.Controls.Panning)
Call Check(CameraState.PanPointerRemainderX = 0 And CameraState.OrbitPointerRemainderY = 0)

CalibrationState.KeyBase = 0

Call ViewerCalibration.ResetBank(CalibrationState)
Call ViewerCalibration.SetChannelValue(CalibrationState, 3, 12, 2)
Call Check(ViewerCalibration.StoreKey(CalibrationState, 3, 0))
Call Check(ViewerCalibration.KeyCount(CalibrationState, 3) = 1)
Call Check(ViewerCalibration.KeyValue(CalibrationState, 3, 0, 12) = 2)
Call ViewerCalibration.SetChannelValue(CalibrationState, 3, 12, 7)
Call Check(ViewerCalibration.StoreKey(CalibrationState, 3, 10))
Call Check(ViewerCalibration.MoveKey(CalibrationState, 3, 1, 12))
Call Check(ViewerCalibration.KeyFrame(CalibrationState, 3, 1) = 12)
Call Check(ViewerCalibration.KeyValue(CalibrationState, 3, 1, 12) = 7)

Call ViewerCalibration.CaptureEdit(CalibrationState, 3)
Call ViewerCalibration.SetChannelValue(CalibrationState, 3, 12, 9)
Call ViewerCalibration.RestoreEdit(CalibrationState, 3)
Call Check(ViewerCalibration.ChannelValue(CalibrationState, 3, 12) = 7)

CalibrationState.KeyBase = ViewerCalibration.MAX_CLIPS

Call ViewerCalibration.ResetBank(CalibrationState)
Call ViewerCalibration.SetChannelValue(CalibrationState, 3, 12, 19)
Call Check(ViewerCalibration.StoreKey(CalibrationState, 3, 0))
Call Check(ViewerCalibration.KeyValue(CalibrationState, 3, 0, 12) = 19)

CalibrationState.KeyBase = 0

Call Check(ViewerCalibration.KeyValue(CalibrationState, 3, 0, 12) = 2)
Call Check(ViewerCalibration.InterpolateChannel(6, 170, -170, 5, 0, 10) = 180)
Call Check(ViewerCalibration.InterpolateChannel(18, 0, 1, 5, 0, 10) = 0)

Call ViewerInput.Reset(InputState)
Call Check(ViewerInput.ClassifyArrow(37, 37, 39, 38, 40, True) =
    ViewerInput.ARROW_FRAME_PREVIOUS)
Call Check(ViewerInput.ClassifyArrow(39, 37, 39, 38, 40, True) =
    ViewerInput.ARROW_FRAME_NEXT)
Call Check(ViewerInput.ClassifyInspectorKey(
