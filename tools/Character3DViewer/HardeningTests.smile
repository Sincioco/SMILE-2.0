Call Check(Not UiState.MinimumSizeNoticeDismissed)
Call Check(ViewerUi.HandleMinimumSizeNotice(UiState, 390, 300, 195, 145, True))
Call Check(UiState.MinimumSizeNoticeDismissed)
Call Check(Not ViewerUi.HandleMinimumSizeNotice(UiState, 390, 300, 195, 145, True))

Call ViewerUi.Reset(UiState)

Call Check(UiState.MinimumSizeNoticeDismissed)
Call Check(Not ViewerUi.HandleMinimumSizeNotice(UiState, 844, 390, 422, 145, True))
Call Check(Not ViewerUi.HandleMinimumSizeNotice(UiState, 800, 540, 400, 145, True))

UiState.MinimumSizeNoticeDismissed = False

Call Check(ViewerUi.CalibrationPointerAction(293, 97, True, 0) =
