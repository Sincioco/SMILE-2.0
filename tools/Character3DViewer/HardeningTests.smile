Option Explicit

Import Smile.Tools.Character3DViewerProfiles As ViewerProfiles
Import Smile.Simple3D.Character3D As Character3D
Import Smile.Simple3D.CharacterViewer As CharacterViewer
Import Smile.Tools.OrinStorm As OrinStorm
Import Smile.Tools.BattleAudio As BattleAudio
Import Smile.Tools.BattleCamera As BattleCamera
Import Smile.Simple3D.Core As Core

Dim Alternating As CharacterViewer.ZoomState
Dim Bounds As Character3D.Bounds3D
Dim Frame As CharacterViewer.Framing
Dim Profile As CharacterViewer.Profile
Dim Remainder As Number
Dim Step30 As CharacterViewer.ZoomState
Dim Step10 As CharacterViewer.ZoomState
Dim Step60 As CharacterViewer.ZoomState
Dim Step120 As CharacterViewer.ZoomState
Dim Step240 As CharacterViewer.ZoomState
Dim Failures As Number
Dim Index As Number
Dim Clock As CharacterViewer.ClockState
Dim CycleElapsed As Number
Dim OrbitYaw1000 As Number
Dim Charge As OrinStorm.ChargeState
Dim Events As Number
Dim AudioCue As BattleAudio.CueState
Dim OrbitBase As Core.Camera3D
Dim OrbitControls As Core.CameraControl3D
Dim OrbitFirst As Core.Camera3D
Dim OrbitNext As Core.Camera3D

Game Window "Character 3D Viewer Hardening Tests" Size 320 By 240

OrbitBase.Position.Z = -1000
OrbitBase.Position.Y = 400
OrbitBase.FovDegrees = 55
OrbitFirst = BattleCamera.Orbit(OrbitBase, OrbitControls, 100000)
OrbitNext = BattleCamera.Orbit(OrbitBase, OrbitControls, 100500)

Call Check(OrbitFirst.Position.X <> OrbitNext.Position.X Or OrbitFirst.Position.Z <> OrbitNext.Position.Z)

OrbitFirst = BattleCamera.Orbit(OrbitBase, OrbitControls, 359900)
OrbitNext = BattleCamera.Orbit(OrbitBase, OrbitControls, 100)

Call Check(Abs(OrbitFirst.Position.X - OrbitNext.Position.X) <= 5)
Call Check(Abs(OrbitFirst.Position.Z - OrbitNext.Position.Z) <= 2)

Call Check(BattleCamera.FrontArcYaw1000(0) = 120000)
Call Check(BattleCamera.FrontArcYaw1000(90000) = 175000)
Call Check(BattleCamera.FrontArcYaw1000(270000) = 65000)
Call Check(BattleCamera.FrontArcYaw1000(360000) = BattleCamera.FrontArcYaw1000(0))
Call Check(BattleCamera.FrontArcYaw1000(500) > BattleCamera.FrontArcYaw1000(0))
Call Check(BattleCamera.FrontArcYaw1000(89900) = BattleCamera.FrontArcYaw1000(90100))

Call Check(ViewerProfiles.HoldsFinalPose(ViewerProfiles.PROFILE_ORIN, "Defend"))
Call Check(Not ViewerProfiles.HoldsFinalPose(ViewerProfiles.PROFILE_ARIN, "Defend"))
Call Check(Not ViewerProfiles.HoldsFinalPose(ViewerProfiles.PROFILE_ORIN, "Idle"))
Call Check(Not BattleAudio.CrossedCue(AudioCue, "SwordAttack", 100, 280, True))
Call Check(BattleAudio.CrossedCue(AudioCue, "SwordAttack", 300, 280, True))
Call Check(Not BattleAudio.CrossedCue(AudioCue, "SwordAttack", 300, 280, True))
Call Check(Not BattleAudio.CrossedCue(AudioCue, "SwordAttack", 900, 280, True))
Call Check(Not BattleAudio.CrossedCue(AudioCue, "SwordAttack", 0, 280, True))
Call Check(BattleAudio.CrossedCue(AudioCue, "SwordAttack", 500, 280, True))
Call Check(Not BattleAudio.CrossedCue(AudioCue, "FireBreath", 200, 100, False))
Call Check(Not BattleAudio.CrossedCue(AudioCue, "FireBreath", 300, 100, True))
Call Check(BattleAudio.CrossedCue(AudioCue, "ClawStrike", 900, 200, True))
Call Check(Not BattleAudio.CrossedCue(AudioCue, "Idle", 900, -1, True))

Charge.Energy = 120

Call OrinStorm.BeginAction(Charge)

Events = OrinStorm.AdvanceCharge(Charge, 200, True, True)

Call Check(Events = 0 And Charge.Energy = 120)

Events = OrinStorm.AdvanceCharge(Charge, 400, True, True)

Call Check(Events = 1 And Charge.Energy = 1000)

Events = OrinStorm.AdvanceCharge(Charge, 450, True, True)

Call Check(Events = 0 And Charge.Energy = 1000)

Events = OrinStorm.AdvanceCharge(Charge, 700, True, True)

Call Check(Events = 2 And Charge.Energy = 650)

Events = OrinStorm.AdvanceCharge(Charge, 800, True, True)

Call Check(Events = 0 And Charge.Energy = 650)
Call OrinStorm.BeginAction(Charge)

Events = OrinStorm.AdvanceCharge(Charge, 700, True, True)

Call Check(Events = 3 And Charge.Energy = 650)
Call OrinStorm.BeginAction(Charge)

Charge.Energy = 10
Events = OrinStorm.AdvanceCharge(Charge, 700, False, True)

Call Check(Events = 2 And Charge.Energy = 0)

Profile = ViewerProfiles.ProfileAt(ViewerProfiles.PROFILE_ARIN)

Call Check(CharacterViewer.ValidateProfile(Profile))
Call Check(Profile.AssetId = "sin-star-i.character-1.paladin")
Call Check(Profile.CandidateVersion = "v5.7")
Call Check(Profile.DisplayName = "Arin")
Call Check(Profile.PartyRole = "Paladin")
Call Check(Profile.PrototypeAlias = "dragonfall.arin-v5-7")
Call Check(Profile.GroundOffset = 0)
Call Check(Profile.DefaultPlaybackSpeed = 200)
Call Check(ViewerProfiles.ClipCount(ViewerProfiles.PROFILE_ARIN) = 8)
Call Check(ViewerProfiles.ClipName(ViewerProfiles.PROFILE_ARIN, 0) = "Idle")
Call Check(ViewerProfiles.ClipName(ViewerProfiles.PROFILE_ARIN, 1) = "SwordAttack")
Call Check(ViewerProfiles.ClipName(ViewerProfiles.PROFILE_ARIN, 2) = "SwordAttack2")
Call Check(ViewerProfiles.ClipName(ViewerProfiles.PROFILE_ARIN, 3) = "Defend")
Call Check(ViewerProfiles.ClipName(ViewerProfiles.PROFILE_ARIN, 7) = "Run")
Call Check(ViewerProfiles.EpicGlowAvailable(ViewerProfiles.PROFILE_ARIN))
Call Check(ViewerProfiles.EpicGlowVisibleByDefault(ViewerProfiles.PROFILE_ARIN))
Call Check(ViewerProfiles.ProfileCount() = 5)

Profile = ViewerProfiles.ProfileAt(ViewerProfiles.PROFILE_ORIN)

Call Check(CharacterViewer.ValidateProfile(Profile))
Call Check(Profile.AssetId = "sin-star-i.character-2.tank")
Call Check(Profile.CandidateVersion = "v1.3")
Call Check(Profile.DisplayName = "Orin")
Call Check(Profile.PartyRole = "Tank")
Call Check(Profile.ExpectedClipCount = 9)
Call Check(Profile.ExpectedSocketCount = 21)
Call Check(Profile.DefaultPlaybackSpeed = 200)
Call Check(ViewerProfiles.ClipCount(ViewerProfiles.PROFILE_ORIN) = 9)
Call Check(ViewerProfiles.ClipName(ViewerProfiles.PROFILE_ORIN, 0) = "Idle")
Call Check(ViewerProfiles.ClipName(ViewerProfiles.PROFILE_ORIN, 1) = "SwordAttack")
Call Check(ViewerProfiles.ClipName(ViewerProfiles.PROFILE_ORIN, 2) = "JumpAttack")
Call Check(ViewerProfiles.ClipName(ViewerProfiles.PROFILE_ORIN, 3) = "ThorAttack")
Call Check(ViewerProfiles.ClipName(ViewerProfiles.PROFILE_ORIN, 4) = "Defend")
Call Check(ViewerProfiles.ClipName(ViewerProfiles.PROFILE_ORIN, 5) = "Hit")
Call Check(ViewerProfiles.ClipName(ViewerProfiles.PROFILE_ORIN, 6) = "Death")
Call Check(ViewerProfiles.ClipName(ViewerProfiles.PROFILE_ORIN, 7) = "Victory")
Call Check(ViewerProfiles.ClipName(ViewerProfiles.PROFILE_ORIN, 8) = "Run")
Call Check(ViewerProfiles.ClipLoops(ViewerProfiles.PROFILE_ORIN, 0))
Call Check(Not ViewerProfiles.ClipLoops(ViewerProfiles.PROFILE_ORIN, 4))
Call Check(ViewerProfiles.ClipLoops(ViewerProfiles.PROFILE_ORIN, 8))
Call Check(Not ViewerProfiles.ClipLoops(ViewerProfiles.PROFILE_ORIN, 3))
Call Check(ViewerProfiles.ClipVerticalOffset1000(ViewerProfiles.PROFILE_ORIN, "Defend", 0) = -119)
Call Check(ViewerProfiles.ClipVerticalOffset1000(ViewerProfiles.PROFILE_ORIN, "Defend", 18) = -174)
Call Check(ViewerProfiles.ClipVerticalOffset1000(ViewerProfiles.PROFILE_ORIN, "Defend", 100) = -174)
Call Check(ViewerProfiles.ClipVerticalOffset1000(ViewerProfiles.PROFILE_ORIN, "Death", 118) = 59)
Call Check(ViewerProfiles.ClipVerticalOffset1000(ViewerProfiles.PROFILE_ORIN, "JumpAttack", 54) = -119)
Call Check(ViewerProfiles.ClipVerticalOffset1000(ViewerProfiles.PROFILE_ARIN, "Death", 118) = 0)
Call Check(ViewerProfiles.EpicGlowAvailable(ViewerProfiles.PROFILE_ORIN))
Call Check(ViewerProfiles.EpicGlowVisibleByDefault(ViewerProfiles.PROFILE_ORIN))
Call Check(ViewerProfiles.CalibrationKey(ViewerProfiles.PROFILE_ORIN) <> ViewerProfiles.CalibrationKey(ViewerProfiles.PROFILE_ARIN))
Call Check(ViewerProfiles.CalibrationFile(ViewerProfiles.PROFILE_ORIN) <> ViewerProfiles.CalibrationFile(ViewerProfiles.PROFILE_ARIN))
Call Check(ViewerProfiles.ProfileAt(ViewerProfiles.PROFILE_ARIN_V56).CandidateVersion = "v5.6")
Call Check(ViewerProfiles.ClipCount(ViewerProfiles.PROFILE_ARIN_V56) = 11)
Call Check(ViewerProfiles.ClipName(ViewerProfiles.PROFILE_ARIN_V56, 0) = "Idle")
Call Check(ViewerProfiles.ClipName(ViewerProfiles.PROFILE_ARIN_V56, 1) = "SwordAttack")
Call Check(Not ViewerProfiles.EpicGlowAvailable(ViewerProfiles.PROFILE_ARIN_ORIGINAL))
Call Check(Not ViewerProfiles.EpicGlowVisibleByDefault(ViewerProfiles.PROFILE_TECHNICAL_ARTICULATED))

Bounds.Valid = True
Bounds.Minimum.Y = 0
Bounds.Center.Y = 500
Bounds.Size.X = 500
Bounds.Size.Y = 1000
Bounds.Size.Z = 300
Frame = CharacterViewer.AutoFit(Profile, Bounds)

Call Check(Frame.Valid)
Call Check(Frame.ScalePercent = 10000)
Call Check(Frame.PositionY = 0)
Call Check(Frame.TargetY > 0)
Call Check(Frame.CameraZ < 0)
Call Check(Frame.FloorWidth >= 400)
Call Check(Frame.FloorDepth >= 320)
Call Check(Frame.PanXLimit >= 40)
Call Check(Frame.ShadowFar >= 400)

Bounds.Size.Y = 20000000
Frame = CharacterViewer.AutoFit(Profile, Bounds)

Call Check(Frame.Valid)
Call Check(Frame.ScalePercent = 1)

Bounds.Size.Y = 0
Frame = CharacterViewer.AutoFit(Profile, Bounds)

Call Check(Not Frame.Valid)

Call InitializeZoomTest(Step30)
Call InitializeZoomTest(Step10)
Call InitializeZoomTest(Step60)
Call InitializeZoomTest(Step120)
Call InitializeZoomTest(Step240)
Call InitializeZoomTest(Alternating)

For Index = 1 To 10
    Call Check(CharacterViewer.AdvanceZoom(Step10, 100))
End For

For Index = 1 To 29
    Call Check(CharacterViewer.AdvanceZoom(Step30, 33))
End For

Call Check(CharacterViewer.AdvanceZoom(Step30, 43))

For Index = 1 To 59
    Call Check(CharacterViewer.AdvanceZoom(Step60, 16))
End For

Call Check(CharacterViewer.AdvanceZoom(Step60, 56))

For Index = 1 To 119
    Call Check(CharacterViewer.AdvanceZoom(Step120, 8))
End For

Call Check(CharacterViewer.AdvanceZoom(Step120, 48))

For Index = 1 To 239
    Call Check(CharacterViewer.AdvanceZoom(Step240, 4))
End For

Call Check(CharacterViewer.AdvanceZoom(Step240, 44))

For Index = 1 To 20
    Call Check(CharacterViewer.AdvanceZoom(Alternating, 17))
    Call Check(CharacterViewer.AdvanceZoom(Alternating, 33))
End For

Call Check(Step30.Current1000 = 24000)
Call Check(Step30.Current1000 = Step10.Current1000)
Call Check(Step30.Current1000 = Step60.Current1000)
Call Check(Step30.Current1000 = Step120.Current1000)
Call Check(Step30.Current1000 = Step240.Current1000)
Call Check(Step30.Current1000 = Alternating.Current1000)
Call Check(CharacterViewer.AdvanceZoom(Step30, -1) = False)
Call Check(CharacterViewer.AdvanceZoom(Step30, 1001) = False)

Call Check(CharacterViewer.AdvanceClock(Clock, 100))
Call Check(Clock.RawFrameMilliseconds = 100)
Call Check(Clock.AnimationElapsed = 100)
Call Check(Clock.CameraElapsed = 100)
Call Check(Clock.PresentationElapsed = 100)
Call Check(CharacterViewer.AdvanceClock(Clock, 100000))
Call Check(Clock.RawFrameMilliseconds = 60000)
Call Check(Clock.AnimationElapsed = 250)
Call Check(Clock.CameraElapsed = 250)
Call Check(Clock.DroppedAnimationMilliseconds = 59750)
Call Check(Clock.LongPauseCount = 1)
Call Check(Not CharacterViewer.AdvanceClock(Clock, -1))

CycleElapsed = 4900

Call Check(CharacterViewer.AdvanceCycle(CycleElapsed, 250, 5000, 11) = 1)
Call Check(CycleElapsed = 150)
Call Check(CharacterViewer.AdvanceCycle(CycleElapsed, 14900, 5000, 11) = 3)
Call Check(CycleElapsed = 50)

For Index = 1 To 1440
    Call Check(CharacterViewer.AdvanceOrbitYaw1000(OrbitYaw1000, 60000, 30))
End For

Call Check(OrbitYaw1000 = 0)

Call Check(CharacterViewer.RetainedPointerDelta(Remainder, 1, 3) = 0)
Call Check(Remainder = 1)
Call Check(CharacterViewer.RetainedPointerDelta(Remainder, 1, 3) = 0)
Call Check(Remainder = 2)
Call Check(CharacterViewer.RetainedPointerDelta(Remainder, 1, 3) = 1)
Call Check(Remainder = 0)
Call Check(CharacterViewer.RetainedPointerDelta(Remainder, -2, 3) = 0)
Call Check(Remainder = -2)
Call Check(CharacterViewer.RetainedPointerDelta(Remainder, -1, 3) = -1)
Call Check(Remainder = 0)

If Failures = 0 Then
    Print "Character 3D Viewer hardening tests passed."
Else
    Print "Character 3D Viewer hardening tests failed: "; Failures
End If

Sub InitializeZoomTest(ByRef Value As CharacterViewer.ZoomState)

    Call CharacterViewer.InitializeZoom(Value, 0, -24, 36, 24000)
    Call CharacterViewer.AdjustZoomTarget(Value, -1, 36)

End Sub

Sub Check(Condition As Boolean)

    If Not Condition Then
        Failures = Failures + 1
    End If

End Sub
