Sub CheckDragonCreation()

    Dim Value As ViewerDragon.State
    Dim Borrowed As Character3D.Actor
    Dim Light As LightPool3D.Lease
    Dim Ok As Boolean
    Dim Baseline As Number
    Dim Index As Number

    Baseline = Character3D.LiveActorCount()
    Value.Available = True
    Value.UseVrax = True

    For Index = 1 To 3

        Ok = ViewerDragon.Create(Value, Borrowed, False)

        Call CheckNamed(Not Ok And Not Value.HeadAim.Ready,
            "Missing Vrax mouth remains a setup failure")
        Call CheckNamed(Not Character3D.IsValid(Value.Actor) And Not Value.OwnsActor,
            "Failed owned creation releases its actor")
        Call ViewerDragon.Destroy(Value, Light)
        Call ViewerDragon.Destroy(Value, Light)
        Call Check(Character3D.LiveActorCount() = Baseline)
    End For

    Borrowed = Character3D.LoadWithPolicy("Assets\Generation2\VraxV1\Vrax.sm3d",
        Character3D.CHARACTER_LOAD_REQUIRE_PBR)

    Call CheckNamed(Character3D.IsValid(Borrowed), "Missing-socket fixture is a valid actor")

    Ok = ViewerDragon.Create(Value, Borrowed, True)

    Call Check(Not Ok And Not Value.HeadAim.Ready)
    Call Check(Character3D.IsValid(Borrowed))
    Call Check(Character3D.SetScale(Borrowed, 100))
    Call Check(Character3D.Place(Borrowed, 0, 0, 0))
    Call Check(Not ViewerDragon.IsValid(Value))
    Call ViewerDragon.Destroy(Value, Light)
    Call Check(Character3D.IsValid(Borrowed))
    Call Character3D.Destroy(Borrowed)

    Value.UseVrax = False
    Ok = ViewerDragon.Create(Value, Borrowed, False)

    Call CheckNamed(Ok And Value.HeadAim.Ready And Value.OwnsActor,
        "Owner retries successfully with valid aim metadata")
    Call ViewerDragon.Destroy(Value, Light)
    Call Check(Character3D.LiveActorCount() = Baseline)

    Borrowed = Character3D.LoadWithPolicy("Assets\Generation2\RedDragon\RedDragon.sm3d",
        Character3D.CHARACTER_LOAD_REQUIRE_PBR)
    Value.UseVrax = True
    Ok = ViewerDragon.Create(Value, Borrowed, True)

    Call CheckNamed(Ok And Value.HeadAim.Ready, "Valid Vrax aim configuration succeeds")
    Call ViewerDragon.Destroy(Value, Light)
    Call Check(Character3D.IsValid(Borrowed))
    Call Character3D.Destroy(Borrowed)
    Call Check(Character3D.LiveActorCount() = Baseline)

End Sub

Sub InitializeZoomTest(ByRef Value As CharacterViewer.ZoomState)

    Call CharacterViewer.InitializeZoom(Value, 0, -24, 36, 24000)
    Call CharacterViewer.AdjustZoomTarget(Value, -1, 36)

End Sub

Sub CheckRingProjection()

    Dim RingCamera As Core.Camera3D
    Dim Origin As Core.Vector3
    Dim Point As Core.ProjectedPoint3D
    Dim Segment As Number
    Dim Angle As Number
    Dim FocalLength As Number
    Dim ExpectedX As Number
    Dim ExpectedY As Number

    RingCamera.Position = Math3D.Vector(0, 0, -200)
    RingCamera.Target = Origin
    RingCamera.UpDirection = Math3D.Vector(0, Core.FIXED_ONE, 0)
    RingCamera.NearPlane = 1
    RingCamera.FovDegrees = 40
    FocalLength = 1000 * Fixed.CosFixed(20) / (2 * Fixed.SinFixed(20))

    For Segment = 0 To 127

        Point = CharacterViewer.ProjectTransformRingPoint(Origin, 2, Segment, 128,
            10, RingCamera, 1000, 1000)
        Angle = Segment * 360 / 128
        ExpectedX = 500 + 10 * Fixed.CosFixed(Angle) * FocalLength / (200 * Core.FIXED_ONE)
        ExpectedY = 500 - 10 * Fixed.SinFixed(Angle) * FocalLength / (200 * Core.FIXED_ONE)

        Call Check(Point.Visible And Point.Depth = 200)
        Call Check(Abs(Point.X - ExpectedX) <= 1 And Abs(Point.Y - ExpectedY) <= 1)
    End For

End Sub

Sub TestEquipmentIntensityBounds()

    Dim Value As ViewerEffects.State
    Dim Index As Number
    Dim Target As Number

    Call ViewerEffects.ResetEquipmentDefaults(Value)

    For Target = 0 To 7

        For Index = 0 To 24
            Call ViewerEffects.AdjustIntensity(Value, Target, False)
        End For

        Call Check(Value.EquipmentIntensity[Target] = 0)

        For Index = 0 To 24
            Call ViewerEffects.AdjustIntensity(Value, Target, True)
        End For

        Call Check(Value.EquipmentIntensity[Target] = 200)
    End For

    Call ViewerEffects.ResetEquipmentDefaults(Value)
    Call Check(Value.EquipmentIntensity[0] = 200 And Value.EquipmentIntensity[7] = 200)

    Call ViewerEffects.SetIntensity(Value, ViewerProfiles.PROFILE_ARIN, False, 25)
    Call ViewerEffects.SetIntensity(Value, ViewerProfiles.PROFILE_ORIN, True, 50)
    Call ViewerEffects.SetIntensity(Value, ViewerProfiles.PROFILE_VALOR, False, 75)
    Call ViewerEffects.SetIntensity(Value, ViewerProfiles.PROFILE_ZARA, True, 125)
    Call Check(ViewerEffects.Intensity(Value, ViewerProfiles.PROFILE_ARIN, False) = 25)
    Call Check(ViewerEffects.Intensity(Value, ViewerProfiles.PROFILE_ORIN, True) = 50)
    Call Check(ViewerEffects.Intensity(Value, ViewerProfiles.PROFILE_VALOR, False) = 75)
    Call Check(ViewerEffects.Intensity(Value, ViewerProfiles.PROFILE_ZARA, True) = 125)

End Sub

Sub Check(Condition As Boolean)

    If Not Condition Then
        Failures = Failures + 1
    End If

End Sub

Sub CheckNamed(Condition As Boolean, Label As Text)

    If Not Condition Then
        Print "FAIL: "; Label
    End If

    Call Check(Condition)

End Sub
