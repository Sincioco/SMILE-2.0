CursorProjection = CharacterViewer.ProjectViewerPoint(CursorAnchor, OrbitNext, 1440, 900)

Call Check(CursorProjection.Visible)
Call Check(Abs(CursorProjection.X - 850) <= 2 And Abs(CursorProjection.Y - 370) <= 2)

OrbitControls.OrbitPitch = -20
