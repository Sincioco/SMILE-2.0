Call Check(BattleArenaPreview.ReflectionLabel(True,
    Graphics3D.REFLECTION_FALLBACK_RENDER_FAILED) = "Battle Floor: Unavailable")
Call Check(BattleArenaPreview.ReflectionLabel(True,
    Graphics3D.REFLECTION_FALLBACK_NONE) = "Battle Floor: Reflective")

Call Check(ViewerUi.StatusPanelX(1600) = 1332)
