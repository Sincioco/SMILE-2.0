Call Check(CalibrationOperation.Ready And PlaybackState.ScenePaused)

Call ViewerUi.Reset(UiState)
Call ViewerGizmo.Reset(GizmoState)
Call ViewerPlayback.Reset(PlaybackState, 100)

PlaybackState.ScenePaused = False
CalibrationOperation = ViewerTimelineEditing.ApplyCommand(
