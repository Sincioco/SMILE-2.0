Call Check(Not ViewerCalibrationControls.GizmoPointerRequiresPartyPreview(
    ViewerGizmo.POINTER_ACTION_BEGIN_AXIS, False, False))
Call Check(ViewerCalibrationControls.GizmoKeyRequiresPartyPreview(
    ViewerInput.GIZMO_KEY_MOVE, True, False, False, False))
Call Check(Not ViewerCalibrationControls.GizmoKeyRequiresPartyPreview(
