Call Check(CalibrationOperation.Ready And UiState.CalibrationClearConfirm)

GizmoState.HoldGrip = False
GizmoState.GripAnchorActive = True
CalibrationOperation = ViewerCalibrationControls.ApplyPointerAction(
    ViewerUi.CALIBRATION_ACTION_HOLD_GRIP,
    CalibrationState, PartyPrimary.Actor, PlaybackState, 0,
    -1, -1, False, UiState, GizmoState, CameraState, EffectsState)

Call Check(CalibrationOperation.Ready And GizmoState.HoldGrip)
Call Check(Not GizmoState.GripAnchorActive And EffectsState.VisualHistoryDirty)

PlaybackState.ScenePaused = False
CalibrationOperation = ViewerCalibrationControls.ApplyPointerAction(
