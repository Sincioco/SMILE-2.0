Option Explicit

Import Smile.Tools.Character3DViewerProfiles As ViewerProfiles
Import Smile.UI.Controls As UI
Import Smile.Simple3D.Character3D As Character3D
Import Smile.Simple3D.CharacterViewer As CharacterViewer
Import Smile.Simple3D.PrecisionCamera3D As PrecisionCamera
Import Smile.Simple3D.Graphics3D As Graphics3D
Import Smile.Simple3D.Interaction As Interaction
Import Smile.Tools.OrinStorm As OrinStorm
Import Smile.Tools.BattleAudio As BattleAudio
Import Smile.Tools.BattleCamera As BattleCamera
Import Smile.Tools.Character3DViewerTiming As ViewerTiming
Import Smile.Tools.Character3DViewerSession As ViewerSession
Import Smile.Tools.Character3DViewerLifecycle As ViewerLifecycle
Import Smile.Tools.Character3DViewerPlayback As ViewerPlayback
Import Smile.Tools.Character3DViewerActors As ViewerActors
Import Smile.Tools.Character3DViewerCamera As ViewerCamera
Import Smile.Tools.Character3DViewerCalibration As ViewerCalibration
Import Smile.Tools.Character3DViewerCalibrationEditing As ViewerCalibrationEditing
Import Smile.Tools.Character3DViewerCalibrationControls As ViewerCalibrationControls
Import Smile.Tools.Character3DViewerInput As ViewerInput
Import Smile.Tools.Character3DViewerInspectorCommands As ViewerInspectorCommands
Import Smile.Tools.Character3DViewerInspectorPresentation As ViewerInspectorPresentation
Import Smile.Tools.Character3DViewerTimelineEditing As ViewerTimelineEditing
Import Smile.Tools.ViewerBeatTimeline As ViewerBeatTimeline
Import Smile.Tools.Character3DViewerUi As ViewerUi
Import Smile.Tools.Character3DViewerGizmo As ViewerGizmo
Import Smile.Tools.Character3DViewerParty As ViewerParty
Import Smile.Tools.Character3DViewerEffects As ViewerEffects
Import Smile.Tools.Character3DViewerDragon As ViewerDragon
Import Smile.Tools.Character3DViewerRendering As ViewerRendering
Import Smile.Simple3D.Core As Core
Import Smile.Simple3D.Precision3D As Precision3D
Import Smile.Simple3D.PrecisionMath3D As PreciseMath
Import Smile.Simple3D.NodeAim3D As NodeAim3D
Import Smile.Simple3D.Math3D As Math3D
Import Smile.Simple3D.FixedMath As Fixed
Import Smile.Simple3D.LightPool3D As LightPool3D
Import Smile.Simple3D.SceneVfx3D As SceneVfx3D
Import SinStarI.BattleArenaPreview As BattleArenaPreview
Import Smile.Tools.BeatCameraTests As BeatCameraTests

Dim Alternating As CharacterViewer.ZoomState
Dim Bounds As Character3D.Bounds3D
Dim Frame As PrecisionCamera.Framing
Dim Profile As CharacterViewer.Profile
Dim Remainder As Number
Dim Step30 As CharacterViewer.ZoomState
Dim Step10 As CharacterViewer.ZoomState
Dim Step60 As CharacterViewer.ZoomState
Dim Step120 As CharacterViewer.ZoomState
Dim Step240 As CharacterViewer.ZoomState
Dim Failures As Number
Dim Index As Number
Dim Clock As CharacterViewer.ClockState
Dim CycleElapsed As Number
Dim OrbitYaw1000 As Number
Dim Charge As OrinStorm.ChargeState
Dim Events As Number
Dim AudioCue As BattleAudio.CueState
Dim OrbitBase As Core.Camera3D
Dim PreciseOrbitBase As Precision3D.Camera3D
Dim VraxTestPosition As Precision3D.Vector3
Dim VraxCameraAnchor As Precision3D.Vector3
Dim HeroCameraAim As Precision3D.Vector3
Dim OrbitControls As Core.CameraControl3D
Dim OrbitFirst As Core.Camera3D
Dim OrbitNext As Core.Camera3D
Dim CursorAnchor As Core.Vector3
Dim CursorProjection As Core.ProjectedPoint3D
Dim AimForward As Core.Vector3
Dim AimTarget As Core.Vector3
Dim AimAngles As Core.Vector3
Dim AimLimits As Core.Vector3
Dim FirstStorm As OrinStorm.Context
Dim SecondStorm As OrinStorm.Context
Dim ReplacementStorm As OrinStorm.Context
Dim FirstLight As LightPool3D.Lease
Dim SecondLight As LightPool3D.Lease
Dim ExtraLight As LightPool3D.Lease
Dim StaleLight As LightPool3D.Lease
Dim VfxClock As SceneVfx3D.Clock
Dim TestResult As Boolean
Dim FormationCenter As Core.Vector3
Dim FormationFirst As Core.Vector3
Dim FormationMiddle As Core.Vector3
Dim FormationLast As Core.Vector3
Dim LargeVector As Core.Vector3
Dim NormalizedVector As Core.Vector3
Dim StableAnchor As Core.Vector3
Dim GroundCamera As Core.Camera3D
Dim FrameRate As ViewerTiming.FrameRateState
Dim RuntimeClock As ViewerTiming.ClockState
Dim SessionState As ViewerSession.State
Dim LifecycleConfiguration As ViewerLifecycle.Configuration
Dim LifecycleSession As ViewerSession.State
Dim LifecycleParty As ViewerParty.State
Dim LifecycleCharacter As Character3D.Actor
Dim LifecycleRendering As ViewerRendering.State
Dim LifecycleEffects As ViewerEffects.State
Dim LifecycleDragon As ViewerDragon.State
Dim LifecyclePlayback As ViewerPlayback.State
Dim PlaybackState As ViewerPlayback.State
Dim SpeedAdjustment As ViewerPlayback.SpeedAdjustmentResult
Dim CameraState As ViewerCamera.State
Dim CameraPointer As ViewerCamera.PointerInput
Dim DirectControls As PrecisionCamera.Controls
Dim DirectZoom As PrecisionCamera.ZoomState
Dim DirectCamera As Precision3D.Camera3D
Dim CameraZoomTarget As Double
Dim CameraPhase1000 As Double
Dim CalibrationState As ViewerCalibration.State
Dim CalibrationConfigurationState As ViewerCalibration.State
Dim CalibrationConfiguration As ViewerCalibration.ConfigurationResult
Dim CalibrationApplication As ViewerCalibration.ApplicationResult
Dim CalibrationOperation As ViewerCalibrationEditing.OperationResult
Dim InputState As ViewerInput.State
Dim PointerGesture As ViewerInput.PointerGestureUpdate
Dim TimelineRequest As ViewerTimelineEditing.CommandRequest
Dim UiState As ViewerUi.State
Dim SliderUpdate As ViewerUi.SliderUpdate
Dim GizmoState As ViewerGizmo.State
Dim GizmoPointer As ViewerGizmo.PointerDecision
Dim PartyState As ViewerParty.State
Dim PartyParticipantUpdate As ViewerParty.ParticipantUpdateResult
Dim PartyInspectorBinding As ViewerParty.InspectorBindingResult
Dim PartyPrimary As ViewerActors.Context
Dim EquipmentVisibility As ViewerActors.EquipmentVisibility
Dim PartyActions As ViewerParty.FrameActions
Dim EmptyPartyActions As ViewerParty.FrameActions
Dim PartyPointer As ViewerParty.PointerDecision
Dim PartyResponse As ViewerParty.PointerResponse
Dim EffectsState As ViewerEffects.State
Dim DragonState As ViewerDragon.State
Dim RenderingState As ViewerRendering.State
Dim RenderingFrameResult As ViewerRendering.FrameResult
Dim InspectorOperation As ViewerInspectorCommands.OperationResult
Dim InspectorApplicationCommand As ViewerInspectorCommands.ApplicationCommandResult
Dim InspectorIdentityView As ViewerInspectorPresentation.IdentityView
Dim InspectorStatusView As ViewerInspectorPresentation.StatusView
Dim InspectorEffectsView As ViewerInspectorPresentation.EffectsView
Dim InspectorWorkspaceView As ViewerInspectorPresentation.WorkspaceView
Dim FirstApproach As Core.Vector3
Dim SecondApproach As Core.Vector3

Game Window "Character 3D Viewer Hardening Tests" Size 320 By 240

Call ViewerTiming.Advance(FrameRate, 250)
Call ViewerTiming.Advance(FrameRate, 250)
Call Check(ViewerTiming.FramesPerSecond(FrameRate) = 4)
Call ViewerTiming.Reset(FrameRate)
Call Check(ViewerTiming.FramesPerSecond(FrameRate) = 0)

Call ViewerTiming.Start(RuntimeClock, 1000)
Call Check(ViewerTiming.AdvanceClock(RuntimeClock, 1100, 250, 250, 60000))
Call Check(RuntimeClock.RawFrameMilliseconds = 100)
Call Check(RuntimeClock.AnimationElapsed = 100)
Call Check(RuntimeClock.CameraElapsed = 100)
Call Check(RuntimeClock.PresentationElapsed = 100)
Call Check(ViewerTiming.AdvanceClock(RuntimeClock, 101100, 250, 250, 60000))
Call Check(RuntimeClock.RawFrameMilliseconds = 60000)
Call Check(RuntimeClock.AnimationElapsed = 250)
Call Check(RuntimeClock.CameraElapsed = 250)
Call Check(RuntimeClock.DroppedAnimationMilliseconds = 59750)
Call Check(RuntimeClock.DroppedCameraMilliseconds = 59750)
Call Check(RuntimeClock.LongPauseCount = 1)

Call ViewerPlayback.Reset(PlaybackState, 100)
Call Check(PlaybackState.SelectedClip = 0)
Call Check(PlaybackState.PlaybackSpeed = 100)
Call Check(PlaybackState.DemoEnabled)
Call Check(Not PlaybackState.ScenePaused)

Call ViewerPlayback.UseDefaultSpeed(PlaybackState, 125)
Call Check(PlaybackState.PlaybackSpeed = 125)
Call ViewerPlayback.TogglePause(PlaybackState)
Call Check(PlaybackState.ScenePaused)
Call ViewerPlayback.TogglePause(PlaybackState)
Call Check(Not PlaybackState.ScenePaused)

PlaybackState.AnimationCycleElapsed = 90

Call Check(Not ViewerPlayback.ApplyDemoToggle(PlaybackState, False))
Call Check(Not PlaybackState.DemoEnabled And
    PlaybackState.AnimationCycleElapsed = 0)

PlaybackState.AnimationCycleElapsed = 90

Call Check(ViewerPlayback.ApplyDemoToggle(PlaybackState, True))
Call Check(Not PlaybackState.DemoEnabled And
    PlaybackState.AnimationCycleElapsed = 90)

Call ViewerPlayback.Reset(PlaybackState, 100)

SpeedAdjustment = ViewerPlayback.AdjustSpeedForContext(
    PlaybackState, 25, 200, 50, True, True)

Call Check(SpeedAdjustment.Blocked And
    Not SpeedAdjustment.ResetPartyDemo And PlaybackState.PlaybackSpeed = 100)

SpeedAdjustment = ViewerPlayback.AdjustSpeedForContext(
    PlaybackState, 25, 200, 50, True, False)

Call Check(Not SpeedAdjustment.Blocked And
    SpeedAdjustment.ResetPartyDemo And PlaybackState.PlaybackSpeed = 150)

Call ViewerPlayback.PauseForCalibration(PlaybackState, False)
Call Check(PlaybackState.ScenePaused And Not PlaybackState.DemoEnabled)
Call ViewerPlayback.PrepareCharacterSwitch(PlaybackState)
Call Check(Not PlaybackState.ScenePaused And PlaybackState.DemoEnabled)
Call ViewerPlayback.PauseForCalibration(PlaybackState, True)
Call Check(PlaybackState.ScenePaused And PlaybackState.DemoEnabled)
Call ViewerPlayback.ResetControls(PlaybackState, 75)
Call Check(PlaybackState.PlaybackSpeed = 75 And
    Not PlaybackState.ScenePaused And PlaybackState.DemoEnabled)
Call ViewerPlayback.PauseForPartyPreview(PlaybackState)
Call Check(PlaybackState.ScenePaused)

PlaybackState.DemoEnabled = False

Call ViewerPlayback.EnablePartyDemo(PlaybackState)
Call Check(PlaybackState.DemoEnabled)

Call ViewerPlayback.ResolveAnimationElapsed(PlaybackState, 16)
Call Check(PlaybackState.AnimationUpdateElapsed = 0)

PlaybackState.ScenePaused = False

Call ViewerPlayback.ResolveAnimationElapsed(PlaybackState, 16)
Call Check(PlaybackState.AnimationUpdateElapsed = 16)
Call ViewerPlayback.AdjustSpeed(PlaybackState, 25, 200, 150)
Call Check(PlaybackState.PlaybackSpeed = 200)
Call ViewerPlayback.AdjustSpeed(PlaybackState, 25, 200, -500)
Call Check(PlaybackState.PlaybackSpeed = 25)
Call Check(ViewerPlayback.ClipMode(ViewerProfiles.PROFILE_ARIN, "Idle") =
    Graphics3D.ANIMATION_LOOP)
Call Check(ViewerPlayback.DemoTarget(ViewerProfiles.PROFILE_DRAGON, 7000) = 7000)
Call Check(ViewerPlayback.DemoTarget(ViewerProfiles.PROFILE_ORIN, 7000) = 3000)

PlaybackState.AnimationCycleElapsed = 90

Call ViewerPlayback.SelectClip(PlaybackState, 2, True)
Call Check(PlaybackState.SelectedClip = 2 And
    PlaybackState.AnimationCycleElapsed = 0 And PlaybackState.DemoEnabled)
Call ViewerPlayback.SelectClip(PlaybackState, 1, False)
Call Check(PlaybackState.SelectedClip = 1 And Not PlaybackState.DemoEnabled)

PartyParticipantUpdate = ViewerParty.UpdateCompanion(
    PartyState, CalibrationState, EffectsState, 16, False)

Call Check(Not PartyParticipantUpdate.Updated And
    PartyParticipantUpdate.Ready)
Call Check(ViewerCalibrationEditing.CurrentValue(
    CalibrationState, 0, UiState) = 0)
Call Check(Not ViewerCalibrationEditing.FinishEdit(
    UiState, GizmoState, CameraState, EffectsState))

Call ViewerSession.SelectCharacterTab(SessionState, 3)
Call CheckNamed(SessionState.SelectedCharacterTab = 3 And
    SessionState.ProfileIndex = ViewerProfiles.PROFILE_ARIN And
    Not SessionState.DragonInspection, "Session selects Party tab identity")
Call CheckNamed(ViewerProfiles.IsPartyTab(
    ViewerProfiles.CHARACTER_TAB_PARTY_DRAGON) And
    ViewerProfiles.IsPartyTab(ViewerProfiles.CHARACTER_TAB_PARTY_VRAX) And
    Not ViewerProfiles.UsesUnityPartyRoster(
        ViewerProfiles.CHARACTER_TAB_PARTY_DRAGON) And
    ViewerProfiles.UsesUnityPartyRoster(
        ViewerProfiles.CHARACTER_TAB_PARTY_VRAX),
    "Profile owner distinguishes Dragon and Vrax Party tabs")
Call ViewerSession.SelectCharacterTab(
    SessionState, ViewerProfiles.CHARACTER_TAB_PARTY_DRAGON)
Call CheckNamed(
    SessionState.SelectedCharacterTab = ViewerProfiles.CHARACTER_TAB_PARTY_DRAGON And
    SessionState.ProfileIndex = ViewerProfiles.PROFILE_ARIN And
    Not SessionState.DragonInspection,
    "Session selects the Party Dragon tab identity")
Call ViewerSession.SelectCharacterTab(
    SessionState, ViewerProfiles.CHARACTER_TAB_PARTY_VRAX)
Call CheckNamed(ViewerSession.ShouldSelectCharacterTab(
    SessionState, 3, True), "Session restarts the selected Party tab")
Call CheckNamed(ViewerSession.ShouldSelectCharacterTab(
    SessionState, 1, True), "Session accepts changed tab")
Call ViewerSession.Start(SessionState)
Call ViewerSession.ContinueRunning(SessionState, False)
Call CheckNamed(SessionState.Running, "Session continues while window is open")
Call ViewerSession.ContinueRunning(SessionState, True)
Call CheckNamed(Not SessionState.Running, "Session stops when window closes")
Call ViewerSession.BlockCharacterSwitch(SessionState)
Call CheckNamed(SessionState.CharacterSwitchBlocked, "Session blocks character switch")
Call ViewerSession.ClearCharacterSwitchBlock(SessionState)
Call CheckNamed(Not SessionState.CharacterSwitchBlocked, "Session clears character switch block")
Call ViewerSession.SelectCharacterTab(SessionState, 1)
Call CheckNamed(SessionState.SelectedCharacterTab = 1 And
    SessionState.ProfileIndex = ViewerProfiles.PROFILE_ORIN And
    Not SessionState.DragonInspection, "Session selects Orin identity")
Call ViewerSession.CycleProfile(SessionState)
Call CheckNamed(SessionState.SelectedCharacterTab = 2 And
    SessionState.ProfileIndex = ViewerProfiles.PROFILE_DRAGON And
    SessionState.DragonInspection, "Session cycles to Dragon identity")
Call ViewerSession.CaptureResourceEpoch(SessionState)
Call CheckNamed(SessionState.ViewerEpoch = Graphics3D.ResourceEpoch3D(),
    "Session captures resource epoch")

CalibrationOperation.Ready = False
CalibrationOperation.Applied = True
CalibrationOperation.FailureStage = 73

Call ViewerSession.ResetFailure(SessionState)
Call ViewerSession.ApplyCalibrationOperation(SessionState, CalibrationOperation)
Call CheckNamed(Not SessionState.Ready And SessionState.FirstFailureStage = 73,
    "Session adapts calibration operation failure")

Call ViewerSession.ResetFailure(SessionState)
Call ViewerSession.BlockCharacterSwitch(SessionState)

CalibrationOperation.Ready = True
CalibrationOperation.Applied = False
CalibrationOperation.FailureStage = 0
CalibrationOperation.Finished = True

Call ViewerSession.ApplyCalibrationOperation(SessionState, CalibrationOperation)
Call CheckNamed(SessionState.Ready And Not SessionState.CharacterSwitchBlocked,
    "Session applies completed calibration lifecycle")

Call ViewerSession.ResetFailure(SessionState)

PartyParticipantUpdate.Updated = True
PartyParticipantUpdate.Ready = False
PartyParticipantUpdate.FailureStage = 0

Call ViewerSession.ApplyParticipantUpdate(SessionState, PartyParticipantUpdate)
Call CheckNamed(Not SessionState.Ready And SessionState.FirstFailureStage = 71,
    "Session applies default participant failure stage")

CalibrationApplication.Ready = False
CalibrationApplication.FailureStage = 74

Call ViewerSession.ResetFailure(SessionState)
Call ViewerSession.ApplyCalibrationResult(SessionState, CalibrationApplication)
Call CheckNamed(Not SessionState.Ready And SessionState.FirstFailureStage = 74,
    "Session adapts calibration application failure")
Call ViewerParty.SetEnabled(PartyState, True)
Call CheckNamed(PartyState.Enabled, "Party owner enables Party")
Call ViewerParty.SelectUnityRoster(PartyState, True)
Call CheckNamed(PartyState.UnityRoster And PartyState.UnityRosterRequested,
    "Party owner selects the Vrax roster")
Call ViewerParty.SelectUnityRoster(PartyState, False)
Call CheckNamed(Not PartyState.UnityRoster And Not PartyState.UnityRosterRequested,
    "Party owner selects the Dragon roster")
Call ViewerParty.SetEnabled(PartyState, False)
Call CheckNamed(Not PartyState.Enabled, "Party owner disables Party")

PartyState.PreviousCamera = 4
PartyState.OrbitPhase = 0.7

Call ViewerParty.ResetCameraTracking(PartyState)

Call CheckNamed(PartyState.PreviousCamera = 0 And PartyState.OrbitPhase = 0.0,
    "Party owner resets camera tracking")

PartyState.DragonCounter = 0

Call ViewerParty.CycleDragonInspectionTarget(PartyState)
Call CheckNamed(PartyState.DragonCounter = 1,
    "Party owner cycles inspection target")
Call ViewerParty.SetEnabled(PartyState, True)
Call ViewerParty.CycleDragonInspectionTarget(PartyState)
Call CheckNamed(PartyState.DragonCounter = 1,
    "Party owner preserves live choreography target")
Call ViewerParty.SetEnabled(PartyState, False)

PartyState.Companion.Profile = 17

Call ViewerParty.PromoteCompanionToDragonOpponent(PartyState)
Call CheckNamed(PartyState.DragonOpponent.Profile = 17,
    "Party owner promotes companion context")
Call ViewerCalibration.SelectProfileBank(
    CalibrationState, ViewerProfiles.PROFILE_ORIN)
Call CheckNamed(CalibrationState.KeyBase = ViewerCalibration.MAX_CLIPS,
    "Calibration owner selects Orin bank")
Call ViewerCalibration.SelectProfileBank(
    CalibrationState, ViewerProfiles.PROFILE_ARIN)
Call CheckNamed(CalibrationState.KeyBase = 0,
    "Calibration owner selects Arin bank")

Call ViewerSession.ResetFailure(SessionState)
Call Check(SessionState.Ready)
Call Check(Not SessionState.ViewerError)

Call ViewerLifecycle.Configure(
    LifecycleConfiguration, 3, "landscape", "title",
    -16, -144, 36, 0, -15, 1000, 1000,
    -70, -45, 480, 180, 180, -55,
    ViewerCalibration.MAX_CLIPS, 300, 10, 50)
Call CheckNamed(
    LifecycleConfiguration.UnusedAssetCacheLimit = 3 And
    LifecycleConfiguration.CharacterModelForwardYawOffset = 180 And
    LifecycleConfiguration.PartyFormationEndAngle = 50,
    "Lifecycle owner captures immutable Viewer configuration")

Call ViewerPlayback.Reset(LifecyclePlayback, 100)
Call ViewerParty.SetEnabled(LifecycleParty, False)

TestResult = ViewerLifecycle.ToggleScenePause(
    LifecycleSession, LifecycleParty, LifecycleCharacter,
    LifecyclePlayback, ViewerProfiles.PROFILE_ARIN,
    UiState, InputState, CalibrationState, False, LifecycleEffects)

Call CheckNamed(TestResult And LifecyclePlayback.ScenePaused,
    "Lifecycle owner toggles single-character scene pause")

Call ViewerParty.SetEnabled(LifecycleParty, True)
Call ViewerSession.ClearCharacterSwitchBlock(LifecycleSession)

UiState.CalibrationEditing = True

TestResult = ViewerLifecycle.ToggleScenePause(
    LifecycleSession, LifecycleParty, LifecycleCharacter,
    LifecyclePlayback, ViewerProfiles.PROFILE_ARIN,
    UiState, InputState, CalibrationState, False, LifecycleEffects)

Call CheckNamed(TestResult And LifecyclePlayback.ScenePaused And
    LifecycleSession.CharacterSwitchBlocked,
    "Lifecycle owner blocks Party resume during calibration editing")

UiState.CalibrationEditing = False
UiState.CalibrationVisible = True
LifecycleParty.PreviewActive = False
LifecycleParty.UiBound = False

TestResult = ViewerLifecycle.RestorePartyPreview(
    LifecycleParty, LifecycleCharacter, LifecyclePlayback,
    ViewerProfiles.PROFILE_ARIN, UiState, InputState,
    CalibrationState, False, LifecycleEffects)

Call CheckNamed(TestResult And UiState.CalibrationVisible,
    "Lifecycle owner leaves inactive Party preview state unchanged")

GizmoState.Dragging = True
InputState.TimelineScrubbing = False
InputState.TimelineKeyframeDragging = False
CameraState.Controls.Orbiting = True
CameraState.Controls.Panning = True

TestResult = ViewerLifecycle.CancelInteractionCaptures(
    LifecycleParty, LifecycleCharacter, LifecyclePlayback,
    ViewerProfiles.PROFILE_ARIN, UiState, InputState, GizmoState,
    CameraState, CalibrationState, False, LifecycleEffects)

Call CheckNamed(TestResult And Not GizmoState.Dragging And
    Not CameraState.Controls.Orbiting And Not CameraState.Controls.Panning,
    "Lifecycle owner cancels gizmo and camera interaction captures")

Call ViewerSession.ResetFailure(LifecycleSession)
Call ViewerParty.SetEnabled(LifecycleParty, False)

LifecycleParty.PreviewActive = True
LifecyclePlayback.PlaybackSpeed = 175
LifecyclePlayback.ScenePaused = True
LifecyclePlayback.DemoEnabled = False
CameraState.FitLocked = False
CameraState.AutoOrbit = False
CameraState.Controls.Orbiting = True
CameraState.Controls.Panning = True
LifecycleRendering.FloorVisible = False
LifecycleRendering.GridVisible = False
LifecycleRendering.BackgroundIndex = 1
LifecycleEffects.FlamePaused = True
LifecycleEffects.LightningPaused = True
UiState.CalibrationVisible = True
InputState.TimelineScrubbing = True
GizmoState.Visible = True
EquipmentVisibility.SwordVisible = False
EquipmentVisibility.ShieldVisible = False

Call ViewerLifecycle.ResetAll(
    LifecycleSession, LifecycleParty, LifecycleCharacter,
    LifecycleRendering, LifecycleEffects, LifecycleDragon,
    LifecyclePlayback, CameraState, CalibrationState, UiState,
    InputState, GizmoState, EquipmentVisibility,
    False, -1, -1, 125, LifecycleConfiguration)
Call CheckNamed(Not LifecycleParty.PreviewActive And
    LifecyclePlayback.PlaybackSpeed = 125 And
    Not LifecyclePlayback.ScenePaused And LifecyclePlayback.DemoEnabled,
    "Lifecycle reset restores Party preview and playback controls")
Call CheckNamed(CameraState.FitLocked And CameraState.AutoOrbit And
    Not CameraState.Controls.Orbiting And Not CameraState.Controls.Panning,
    "Lifecycle reset restores responsive camera controls")
Call CheckNamed(LifecycleRendering.FloorVisible And
    LifecycleRendering.GridVisible And LifecycleRendering.BackgroundIndex = 3 And
    Not LifecycleEffects.FlamePaused And Not LifecycleEffects.LightningPaused,
    "Lifecycle reset restores rendering and independent VFX defaults")
Call CheckNamed(Not UiState.CalibrationVisible And
    Not InputState.TimelineScrubbing And Not GizmoState.Visible And
    EquipmentVisibility.SwordVisible And EquipmentVisibility.ShieldVisible,
    "Lifecycle reset restores UI, input, gizmo and equipment owners")

Call ViewerSession.ResetFailure(LifecycleSession)
Call ViewerSession.SelectCharacterTab(LifecycleSession, 3)
Call ViewerParty.SetEnabled(LifecycleParty, True)
Call ViewerPlayback.Reset(LifecyclePlayback, 100)
Call ViewerPlayback.TogglePause(LifecyclePlayback)
Call ViewerLifecycle.PrepareCharacterSwitch(
    LifecycleSession, LifecycleParty, LifecycleCharacter,
    LifecycleRendering, LifecycleEffects, LifecycleDragon,
    LifecyclePlayback, 1)
Call CheckNamed(
    LifecycleSession.SelectedCharacterTab = 1 And
    LifecycleSession.ProfileIndex = ViewerProfiles.PROFILE_ORIN And
    Not LifecycleSession.DragonInspection And
    Not LifecycleParty.Enabled And
    LifecycleSession.Ready And
    Not LifecycleSession.ViewerError And
    LifecyclePlayback.DemoEnabled And
    Not LifecyclePlayback.ScenePaused,
    "Lifecycle owner prepares a clean character switch")

Call ViewerLifecycle.PrepareProfileCycle(
    LifecycleSession, LifecycleParty, LifecycleCharacter,
    LifecycleRendering, LifecycleEffects, LifecycleDragon)
Call CheckNamed(
    LifecycleSession.SelectedCharacterTab = 2 And
    LifecycleSession.ProfileIndex = ViewerProfiles.PROFILE_DRAGON And
    LifecycleSession.DragonInspection And
    LifecycleSession.Ready And Not LifecycleParty.Enabled,
    "Lifecycle owner prepares a diagnostic profile cycle")

SessionState.Ready = False

Call ViewerSession.CaptureFailure(SessionState, 77)
Call ViewerSession.CaptureFailure(SessionState, 78)
Call Check(SessionState.FirstFailureStage = 77)
Call ViewerSession.RecordError(SessionState)
Call Check(SessionState.ViewerError)

Call ViewerCamera.Reset(CameraState, 0, -16, -144, 36, 96000)
Call ViewerCamera.BeginLoadedLayout(CameraState, 800, 640)
Call CheckNamed(CameraState.FitLocked And
    CameraState.LastFitWidth = 800 And CameraState.LastFitHeight = 640,
    "Camera owner captures loaded layout")

CameraState.FitLocked = False

Call ViewerCamera.LockResponsiveFit(CameraState)
Call CheckNamed(CameraState.FitLocked, "Camera owner locks responsive fit")
Call PrecisionCamera.ResetCameraControls(DirectControls)
Call PrecisionCamera.InitializeZoom(DirectZoom, -16, -144, 36, 96000)
Call Check(CameraState.Controls.OrbitYaw = DirectControls.OrbitYaw)
Call Check(CameraState.Zoom.Current = DirectZoom.Current)

CameraState.Frame.PanXLimit = 10.0
CameraState.Frame.PanYLimit = 8.0
CameraState.AutoOrbit = True
TestResult = PrecisionCamera.UpdateOrbitControls(DirectControls, True, True, True, -5, 2)

Call Check(ViewerCamera.NudgeOrbit(CameraState, -5, 2))
Call Check(CameraState.Controls.OrbitYaw = DirectControls.OrbitYaw)
Call Check(CameraState.Controls.OrbitPitch = DirectControls.OrbitPitch)
Call Check(Not CameraState.AutoOrbit)

TestResult = PrecisionCamera.UpdatePanZoomControls(
    DirectControls, True, True, True, -20, 20, 0)
DirectControls.PanX = Min(10.0, Max(-10.0, DirectControls.PanX))
DirectControls.PanY = Min(8.0, Max(-8.0, DirectControls.PanY))

Call Check(ViewerCamera.NudgePan(CameraState, -20, 20))
Call Check(CameraState.Controls.PanX = DirectControls.PanX)
Call Check(CameraState.Controls.PanY = DirectControls.PanY)

Call PrecisionCamera.AdjustZoomTarget(DirectZoom, -2, 8)
Call ViewerCamera.AdjustZoomTarget(CameraState, -2, 8)
Call Check(PrecisionCamera.AdvanceZoom(DirectZoom, 33))
Call Check(ViewerCamera.AdvanceZoom(CameraState, 33))
Call Check(CameraState.Zoom.Current = DirectZoom.Current)
Call Check(CameraState.Zoom.Target = DirectZoom.Target)
Call Check(CameraState.Controls.Zoom = DirectZoom.Current)

CameraState.Base = Precision3D.FromCamera(Graphics3D.DefaultCamera())
DirectCamera = PrecisionCamera.ApplyScreenSpaceCameraControls(
    CameraState.Base, CameraState.Controls)

Call ViewerCamera.Compose(CameraState, False)
Call Check(CameraState.Live.Position.X = DirectCamera.Position.X)
Call Check(CameraState.Live.Position.Y = DirectCamera.Position.Y)
Call Check(CameraState.Live.Position.Z = DirectCamera.Position.Z)
Call Check(CameraState.Live.Target.X = DirectCamera.Target.X)
Call Check(CameraState.Live.Target.Y = DirectCamera.Target.Y)
Call Check(CameraState.Live.Target.Z = DirectCamera.Target.Z)

Call ViewerCamera.SetHorizontalOrbit(CameraState, 500)
Call ViewerCamera.SetVerticalOrbit(CameraState, -500)
Call Check(CameraState.Controls.OrbitYaw = 180.0)
Call Check(CameraState.Controls.OrbitPitch = -180.0)
Call ViewerCamera.SetZoom(CameraState, -200, -144, 36)
Call Check(CameraState.Zoom.Current = -144.0)
Call ViewerCamera.StartAutoOrbit(CameraState)
Call Check(ViewerCamera.AdvanceAutoOrbit(CameraState, CameraPhase1000, 250, 12, False))
Call Check(CameraState.AutoOrbitYaw = 183.0)
Call Check(CameraState.Controls.OrbitYaw = 183.0)

CameraPhase1000 = 179.0

Call Check(ViewerCamera.AdvanceAutoOrbit(CameraState, CameraPhase1000, 250, 12, True, True))
Call Check(CameraPhase1000 = 182.0 And CameraState.AutoOrbitYaw = 302.0)

CameraPhase1000 = 359.0

Call Check(ViewerCamera.AdvanceAutoOrbit(CameraState, CameraPhase1000, 250, 12, True, True))
Call Check(CameraPhase1000 = 2.0 And CameraState.AutoOrbitYaw = 122.0)

CameraState.Live.Position.Y = -40.0
CameraState.Live.Target.Y = 65.0

Call ViewerCamera.KeepAboveGround(CameraState, 0)
Call Check(CameraState.Live.Position.Y = 0.0 And CameraState.Live.Target.Y = 65.0)

CameraState.Controls.Orbiting = True
CameraState.Controls.Panning = True

Call ViewerCamera.CancelPointerControls(CameraState)
Call Check(Not CameraState.Controls.Orbiting And Not CameraState.Controls.Panning)
Call Check(Not CameraState.CalibrationOrbitActive)

Call ViewerCamera.Reset(CameraState, 0, -16, -144, 36, 96000)

CameraState.Live = Precision3D.FromCamera(Graphics3D.DefaultCamera())
CameraState.Frame.PanXLimit = 10.0
CameraState.Frame.PanYLimit = 8.0
CameraState.AutoOrbit = True
CameraPointer = ViewerCamera.CreatePointerInput(
    False, True, True, False, False, False, False,
    400, 300, 6, -3, 800, 640, True, False)
CameraPointer.CalibrationOrigin.X = 1.0
CameraPointer.CalibrationOrigin.Y = 2.0
CameraPointer.CalibrationOrigin.Z = 3.0

Call CheckNamed(
    ViewerCamera.PointerRequiresCalibrationOrigin(CameraState, CameraPointer),
    "Camera pointer owner requests a calibration orbit origin")
Call CheckNamed(
    ViewerCamera.UpdatePointerInteraction(CameraState, CameraPointer, 3, 3, 8),
    "Camera pointer owner applies an active calibration orbit")
Call CheckNamed(CameraState.CalibrationOrbitActive And
    CameraState.Controls.Orbiting And Not CameraState.AutoOrbit,
    "Camera pointer owner retains orbit lifecycle with camera state")

Call ViewerCamera.CancelPointerControls(CameraState)

CameraZoomTarget = CameraState.Zoom.Target
CameraPointer = ViewerCamera.CreatePointerInput(
    True, True, True, False, True, True, False,
    400, 300, 6, -3, 800, 640, True, False)
CameraPointer.WheelDelta = -1

Call CheckNamed(
    Not ViewerCamera.PointerRequiresCalibrationOrigin(CameraState, CameraPointer),
    "Blocked camera input does not request a calibration orbit origin")
Call CheckNamed(
    ViewerCamera.UpdatePointerInteraction(CameraState, CameraPointer, 3, 3, 8),
    "Camera pointer owner accepts a blocked input snapshot")
Call CheckNamed(Not CameraState.Controls.Orbiting And
    Not CameraState.Controls.Panning And
    Not CameraState.CalibrationOrbitActive And
    CameraState.Zoom.Target = CameraZoomTarget,
    "Blocked camera input cannot begin controls or change zoom")

CameraState.Controls.OrbitYaw = 0.0
InspectorOperation = ViewerInspectorCommands.ApplyKeyboardNavigationAction(
    ViewerInput.INSPECTOR_KEY_ORBIT_LEFT,
    RenderingState, 5, 4, CameraState, EffectsState, DragonState)

Call CheckNamed(InspectorOperation.Handled And InspectorOperation.Ready,
    "Keyboard camera command handled")
Call CheckNamed(CameraState.Controls.OrbitYaw = -15.0,
    "Keyboard camera command applies left orbit")

InspectorOperation = ViewerInspectorCommands.ApplyKeyboardNavigationAction(
    ViewerInput.INSPECTOR_KEY_TOGGLE_GRID,
    RenderingState, 5, 4, CameraState, EffectsState, DragonState)

Call CheckNamed(InspectorOperation.Handled And RenderingState.GridVisible,
    "Keyboard rendering command toggles grid")

InspectorOperation = ViewerInspectorCommands.ApplyKeyboardNavigationAction(
    ViewerInput.INSPECTOR_KEY_NONE,
    RenderingState, 5, 4, CameraState, EffectsState, DragonState)

Call CheckNamed(Not InspectorOperation.Handled And InspectorOperation.Ready,
    "Unknown keyboard command remains ready no-op")

CalibrationState.KeyBase = 0

Call ViewerCalibration.ResetBank(CalibrationState)
Call ViewerCalibration.SetChannelValue(CalibrationState, 3, 12, 2)
Call Check(ViewerCalibration.StoreKey(CalibrationState, 3, 0))
Call Check(ViewerCalibration.KeyCount(CalibrationState, 3) = 1)
Call Check(ViewerCalibration.KeyValue(CalibrationState, 3, 0, 12) = 2)
Call ViewerCalibration.SetChannelValue(CalibrationState, 3, 12, 7)
Call Check(ViewerCalibration.StoreKey(CalibrationState, 3, 10))
Call Check(ViewerCalibration.MoveKey(CalibrationState, 3, 1, 12))
Call Check(ViewerCalibration.KeyFrame(CalibrationState, 3, 1) = 12)
Call Check(ViewerCalibration.KeyValue(CalibrationState, 3, 1, 12) = 7)

Call ViewerCalibration.CaptureEdit(CalibrationState, 3)
Call ViewerCalibration.SetChannelValue(CalibrationState, 3, 12, 9)
Call ViewerCalibration.RestoreEdit(CalibrationState, 3)
Call Check(ViewerCalibration.ChannelValue(CalibrationState, 3, 12) = 7)

CalibrationState.KeyBase = ViewerCalibration.MAX_CLIPS

Call ViewerCalibration.ResetBank(CalibrationState)
Call ViewerCalibration.SetChannelValue(CalibrationState, 3, 12, 19)
Call Check(ViewerCalibration.StoreKey(CalibrationState, 3, 0))
Call Check(ViewerCalibration.KeyValue(CalibrationState, 3, 0, 12) = 19)

CalibrationState.KeyBase = 0

Call Check(ViewerCalibration.KeyValue(CalibrationState, 3, 0, 12) = 2)
Call Check(ViewerCalibration.InterpolateChannel(6, 170, -170, 5, 0, 10) = 180)
Call Check(ViewerCalibration.InterpolateChannel(18, 0, 1, 5, 0, 10) = 0)

Call ViewerInput.Reset(InputState)
Call CheckNamed(ViewerInput.HostedCommand(0, True, False) =
    ViewerInput.INSPECTOR_KEY_RESET, "Hosted right-click resets the view")
Call CheckNamed(ViewerInput.HostedCommand(KEY_R, False, True) =
    ViewerInput.INSPECTOR_KEY_RESET, "Hosted keyboard reset remains available during pose editing")
Call CheckNamed(ViewerInput.HostedCommand(KEY_SPACE, True, True) =
    ViewerInput.INSPECTOR_KEY_RESET, "Right-click reset takes priority over playback")
Call CheckNamed(ViewerInput.HostedCommand(KEY_SPACE, False, True) =
    ViewerInput.INSPECTOR_KEY_NONE, "Hosted playback stays guarded during pose editing")
Call CheckNamed(ViewerInput.HostedCommand(KEY_SPACE, False, False) =
    ViewerInput.INSPECTOR_KEY_TOGGLE_PAUSE, "Hosted pause remains available without an edit")
Call CheckNamed(ViewerInput.HostedCommand(0, False, False) =
    ViewerInput.INSPECTOR_KEY_NONE, "No hosted input leaves the view unchanged")
Call Check(ViewerInput.ClassifyArrow(37, 37, 39, 38, 40, True) =
    ViewerInput.ARROW_FRAME_PREVIOUS)
Call Check(ViewerInput.ClassifyArrow(39, 37, 39, 38, 40, True) =
    ViewerInput.ARROW_FRAME_NEXT)
Call Check(ViewerInput.ClassifyInspectorKey(
    KEY_SPACE, False, True, True, False, 0) =
    ViewerInput.INSPECTOR_KEY_TOGGLE_PAUSE)
Call Check(ViewerInput.ClassifyInspectorKey(
    KEY_R, False, False, True, False, 3) =
    ViewerInput.INSPECTOR_KEY_NONE)
Call Check(ViewerInput.ClassifyInspectorKey(
    KEY_LEFT, True, False, False, False, 3) =
    ViewerInput.INSPECTOR_KEY_FRAME_PREVIOUS)
Call Check(ViewerInput.ClassifyInspectorKey(
    KEY_LEFT, False, False, False, True, 3) =
    ViewerInput.INSPECTOR_KEY_SOCKET_PREVIOUS)
Call Check(ViewerInput.ClassifyInspectorKey(
    KEY_3, False, False, False, False, 2) =
    ViewerInput.INSPECTOR_KEY_NONE)
Call Check(ViewerInput.ClassifyInspectorKey(
    KEY_3, False, False, False, False, 3) =
    ViewerInput.INSPECTOR_KEY_CLIP_3)

InspectorApplicationCommand = ViewerInspectorCommands.ApplicationCommandForKeyboardAction(
        ViewerInput.INSPECTOR_KEY_TOGGLE_PAUSE,
        LifecycleCharacter, ViewerProfiles.PROFILE_ARIN, 0, False)

Call CheckNamed(InspectorApplicationCommand.Handled And
    InspectorApplicationCommand.Command =
        ViewerInspectorCommands.APPLICATION_COMMAND_TOGGLE_SCENE_PAUSE,
    "Keyboard application owner maps pause")

InspectorApplicationCommand = ViewerInspectorCommands.ApplicationCommandForKeyboardAction(
        ViewerInput.INSPECTOR_KEY_FRAME_PREVIOUS,
        LifecycleCharacter, ViewerProfiles.PROFILE_ARIN, 0, False)

Call CheckNamed(InspectorApplicationCommand.Handled And
    InspectorApplicationCommand.Command =
        ViewerInspectorCommands.APPLICATION_COMMAND_STEP_FRAME And
    InspectorApplicationCommand.Value = -1,
    "Keyboard application owner preserves previous-frame direction")

InspectorApplicationCommand = ViewerInspectorCommands.ApplicationCommandForKeyboardAction(
        ViewerInput.INSPECTOR_KEY_CLIP_3,
        LifecycleCharacter, ViewerProfiles.PROFILE_ARIN, 0, False)

Call CheckNamed(InspectorApplicationCommand.Handled And
    InspectorApplicationCommand.Command =
        ViewerInspectorCommands.APPLICATION_COMMAND_SELECT_CLIP And
    InspectorApplicationCommand.Value = 2,
    "Keyboard application owner maps the third presentation clip")

InspectorApplicationCommand = ViewerInspectorCommands.ApplicationCommandForKeyboardAction(
        ViewerInput.INSPECTOR_KEY_RESET,
        LifecycleCharacter, ViewerProfiles.PROFILE_ARIN, 0, True)

Call CheckNamed(InspectorApplicationCommand.Handled And
    InspectorApplicationCommand.Command =
        ViewerInspectorCommands.APPLICATION_COMMAND_RETRY_VIEWER,
    "Keyboard application owner preserves error recovery")

InspectorApplicationCommand = ViewerInspectorCommands.ApplicationCommandForKeyboardAction(
        ViewerInput.INSPECTOR_KEY_NONE,
        LifecycleCharacter, ViewerProfiles.PROFILE_ARIN, 0, False)

Call CheckNamed(Not InspectorApplicationCommand.Handled,
    "Keyboard application owner leaves unrelated actions unhandled")

Call Check(ViewerInput.ClassifyGizmoKey(
    KEY_X, False, True, 0, True, False, False) =
    ViewerInput.GIZMO_KEY_NONE)
Call Check(ViewerInput.ClassifyGizmoKey(
    KEY_X, True, True, 0, False, False, False) =
    ViewerInput.GIZMO_KEY_AXIS_X)
Call Check(ViewerInput.ClassifyGizmoKey(
    KEY_G, True, True, 0, False, False, False) =
    ViewerInput.GIZMO_KEY_NONE)
Call Check(ViewerInput.ClassifyGizmoKey(
    KEY_G, True, True, 0, True, False, False) =
    ViewerInput.GIZMO_KEY_MOVE)
Call Check(ViewerInput.ClassifyGizmoKey(
    KEY_ENTER, True, True, 0, True, False, False) =
    ViewerInput.GIZMO_KEY_NONE)
Call Check(ViewerInput.ClassifyGizmoKey(
    KEY_ENTER, True, True, 0, True, True, False) =
    ViewerInput.GIZMO_KEY_COMMIT)
Call Check(ViewerInput.ClassifyArrow(37, 37, 39, 38, 40, False) =
    ViewerInput.ARROW_PLAIN_LEFT)
Call Check(ViewerInput.ClassifyArrow(38, 37, 39, 38, 40, False) =
    ViewerInput.ARROW_PLAIN_UP)

Call ViewerInput.BeginTimelineScrub(InputState)
Call Check(ViewerInput.HasPointerCapture(InputState))

PointerGesture = ViewerInput.UpdateTimelineScrub(
    InputState, False, False, True)

Call Check(PointerGesture.Consumed)
Call Check(PointerGesture.Action = ViewerInput.POINTER_GESTURE_NONE)
Call Check(Not InputState.TimelineScrubbing)

Call ViewerInput.CancelCaptures(InputState)
Call Check(Not ViewerInput.HasPointerCapture(InputState))

Call ViewerInput.BeginFrameRepeat(InputState, -1, 100)

PointerGesture = ViewerInput.UpdateBeforeSliders(
    InputState, 99, 300, False, True, False)

Call Check(PointerGesture.Consumed)
Call Check(PointerGesture.Action = ViewerInput.POINTER_GESTURE_NONE)

PointerGesture = ViewerInput.UpdateBeforeSliders(
    InputState, 100, 300, False, True, False)

Call Check(PointerGesture.Action = ViewerInput.POINTER_GESTURE_STEP_FRAME)
Call Check(PointerGesture.Value = -1 And InputState.FrameButtonRepeatAt = 400)

PointerGesture = ViewerInput.UpdateBeforeSliders(
    InputState, 101, 300, False, False, False)

Call Check(Not PointerGesture.Consumed And InputState.FrameButtonRepeatDirection = 0)

Call ViewerInput.BeginTimelineKeyframeDrag(InputState, 4, 18)
Call Check(InputState.TimelineKeyframeDragging)
Call Check(InputState.TimelineDraggedKeyframe = 4)
Call Check(InputState.TimelineDraggedOriginalFrame = 18)

PointerGesture = ViewerInput.UpdateBeforeSliders(
    InputState, 0, 300, True, False, False)

Call Check(PointerGesture.Consumed And
    PointerGesture.Action = ViewerInput.POINTER_GESTURE_UPDATE_KEYFRAME)
Call Check(ViewerTimelineEditing.AcceptDragTarget(InputState, 20, -1))
Call Check(InputState.TimelineDraggedTargetFrame = 20)
Call Check(Not ViewerTimelineEditing.AcceptDragTarget(InputState, 21, 3))
Call Check(InputState.TimelineDraggedTargetFrame = 20)
Call Check(ViewerTimelineEditing.AcceptDragTarget(InputState, 21, 4))

TimelineRequest = ViewerTimelineEditing.InspectorCommand(
    ViewerUi.INSPECTOR_ACTION_NEXT_FRAME, 0)

Call CheckNamed(TimelineRequest.Handled And
    TimelineRequest.Command = ViewerTimelineEditing.COMMAND_STEP_FRAME And
    TimelineRequest.Value = 1 And TimelineRequest.RepeatDirection = 1,
    "Timeline owner maps repeating frame command")

TimelineRequest = ViewerTimelineEditing.InspectorCommand(
    ViewerUi.INSPECTOR_ACTION_KEYFRAME, 7)

Call CheckNamed(TimelineRequest.Handled And
    TimelineRequest.Command = ViewerTimelineEditing.COMMAND_BEGIN_KEYFRAME_DRAG And
    TimelineRequest.Value = 7 And TimelineRequest.RepeatDirection = 0,
    "Timeline owner maps keyframe drag command")

TimelineRequest = ViewerTimelineEditing.InspectorCommand(999, 7)

Call CheckNamed(Not TimelineRequest.Handled,
    "Timeline owner ignores unrelated inspector command")

PointerGesture = ViewerInput.UpdateBeforeSliders(
    InputState, 0, 300, False, False, False)

Call Check(PointerGesture.Consumed And
    PointerGesture.Action = ViewerInput.POINTER_GESTURE_FINISH_KEYFRAME)
Call Check(Not ViewerInput.HasPointerCapture(InputState))

Call ViewerInput.BeginTimelineKeyframeDrag(InputState, 4, 18)

CalibrationOperation = ViewerTimelineEditing.FinishKeyframeDrag(
    InputState, CalibrationState, PartyPrimary.Actor, 0, 0,
    -1, -1, False, False, EffectsState)

Call Check(CalibrationOperation.Ready And Not CalibrationOperation.Applied)
Call Check(ViewerTimelineEditing.SeekAdjacentKey(
    CalibrationState, PartyPrimary.Actor, 0, 1, 0,
    -1, -1, False, False, EffectsState))

Call ViewerUi.Reset(UiState)

SliderUpdate = ViewerUi.UpdateCameraSliders(
    InputState.SliderDragOwner, UiState.Visibility,
    100, 640, 0, 0, 0, -144, 36)

Call Check(Not SliderUpdate.Consumed)
Call Check(SliderUpdate.Action = ViewerUi.SLIDER_ACTION_NONE)
Call Check(InputState.SliderDragOwner = 0)

SliderUpdate = ViewerUi.UpdateCalibrationSlider(
    InputState.SliderDragOwner, 17, -180, 180)

Call Check(Not SliderUpdate.Consumed)
Call Check(SliderUpdate.Action = ViewerUi.SLIDER_ACTION_NONE)

Call ViewerUi.ResetCalibration(UiState, 0, 1, 0)
Call CheckNamed(ViewerUi.ToggleCalibrationPanel(UiState, True) And
    UiState.CalibrationVisible, "UI owner opens available calibration")
Call CheckNamed(Not ViewerUi.ToggleCalibrationPanel(UiState, True) And
    Not UiState.CalibrationVisible, "UI owner closes calibration")
Call ViewerUi.SetCalibrationVisible(UiState, True, False)
Call CheckNamed(Not UiState.CalibrationVisible,
    "UI owner blocks unavailable calibration")
Call ViewerUi.SetCalibrationVisible(UiState, True, True)
Call ViewerUi.HideCalibration(UiState)
Call CheckNamed(Not UiState.CalibrationVisible,
    "UI owner hides calibration")
Call ViewerUi.CycleVisibility(UiState)
Call Check(UiState.Visibility = 1)
Call ViewerUi.BeginCalibrationEdit(UiState, 3, 14, True)
Call Check(UiState.CalibrationEditing And UiState.CalibrationEditingClip = 3)
Call Check(UiState.CalibrationEditingFrame = 14 And UiState.CalibrationAutoOrbitWasEnabled)
Call ViewerUi.BeginClearConfirmation(UiState)
Call Check(UiState.CalibrationClearConfirm)
Call ViewerUi.FinishCalibrationEdit(UiState)
Call ViewerUi.ClearConfirmation(UiState)
Call Check(Not UiState.CalibrationEditing And Not UiState.CalibrationClearConfirm)
Call Check(ViewerUi.PlaybackLabel("Fire", False, "Freeze") = "Freeze Fire")
Call Check(ViewerUi.PlaybackLabel("Lightning", True, "Freeze") = "Play Lightning")
Call Check(ViewerUi.CalibrationTargetLabel(2) = "Weapon")
Call Check(ViewerUi.CalibrationAxisLabel(1) = "Y")
Call Check(ViewerUi.CalibrationTransformLabel(1) = "Move")
Call Check(ViewerUi.CalibrationUnitLabel(0) = "degrees")
Call Check(ViewerUi.CalibrationResetClipLabel(True) = "Confirm Current Clip?")

Call Check(ViewerUi.CalibrationResetAllLabel(2) = "Really Clear?")
Call Check(ViewerUi.BackgroundLabel(4) = "BG LOGO")
Call Check(ViewerUi.DragonLabel(False, True, False) = "DRAGON OFF")
Call Check(ViewerUi.MaterialInspectionLabel(Graphics3D.MATERIAL_INSPECTION_NORMAL) = "Normal")
Call Check(ViewerUi.DemoLabel(True, True, False) = "RESUME")
Call Check(ViewerUi.DemoStatusLabel(False, False, True) = "On")
