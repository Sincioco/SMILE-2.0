SecondLight = LightPool3D.Acquire()
ExtraLight = LightPool3D.Acquire()

Call Check(LightPool3D.IsValid(FirstLight) And LightPool3D.IsValid(SecondLight))
Call Check(Not LightPool3D.IsValid(ExtraLight) And
    LightPool3D.LastError() = LightPool3D.ERROR_CAPACITY)
Call Check(LightPool3D.RendererSlot(FirstLight) <> LightPool3D.RendererSlot(SecondLight))

StaleLight = FirstLight
TestResult = LightPool3D.Release(FirstLight)

Call Check(TestResult And Not LightPool3D.IsValid(StaleLight))
Call Check(LightPool3D.IsValid(SecondLight) And LightPool3D.LiveLeaseCount() = 1)

Call LightPool3D.Shutdown()

Call SceneVfx3D.Initialize(VfxClock)
Call Check(SceneVfx3D.BeginFrame(VfxClock, 16, False, False))

TestResult = SceneVfx3D.Advance(VfxClock, OrbitBase, False, False)

Call Check(TestResult And VfxClock.LastAdvancedFrame = VfxClock.FrameIdentity)
Call Check(Not SceneVfx3D.Advance(VfxClock, OrbitBase, False, False))
Call Check(VfxClock.DuplicateAdvanceCount = 1)

