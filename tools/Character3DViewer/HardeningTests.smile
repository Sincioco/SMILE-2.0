Call Check(ViewerUi.FloorReflectionLabel(False,
    Graphics3D.REFLECTION_FALLBACK_UNSUPPORTED_RECEIVER) = "Battle Floor: Original")
Call Check(BattleArenaPreview.ReflectionLabel(True,
