Call Check(BattleCamera.FrontArcYaw1000(360000) = BattleCamera.FrontArcYaw1000(0))
Call Check(BattleCamera.FrontArcYaw1000(500) > BattleCamera.FrontArcYaw1000(0))
Call Check(BattleCamera.FrontArcYaw1000(89900) = BattleCamera.FrontArcYaw1000(90100))

