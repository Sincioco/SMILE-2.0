Call ViewerGizmo.Hide(GizmoState)
Call Check(Not GizmoState.Visible And Not GizmoState.Dragging)
Call Check(ViewerGizmo.AxisAtPointer(
    GizmoState, 120, 120, True, 90, 540, 700,
    18, 92, 430, 354, 0, 0, DirectCamera, 800, 640) = -1)

Call ViewerGizmo.Draw(GizmoState, 0, 0, DirectCamera, 800, 640)

Call ViewerParty.ResetChoreography(PartyState)
Call Check(PartyState.Turn = 2 And PartyState.DragonOnlyTurn)
Call Check(PartyState.Stage = -1 And PartyState.FatalTarget = -1)
Call Check(ViewerParty.ActingName(PartyState) = "Dragon")

PartyState.DragonCounter = 1

Call Check(ViewerParty.AttackSequenceName(PartyState) = "Claw Strike")
Call Check(Not ViewerParty.DragonTargetsPrimary(PartyState))

PartyState.Enabled = True
PartyState.HitTarget = 0

Call Check(ViewerParty.DragonTargetsPrimary(PartyState))

PartyState.HitTarget = 1

Call Check(Not ViewerParty.DragonTargetsPrimary(PartyState))

PartyState.Turn = 0
PartyState.Elapsed = 0

Call CheckNamed(ViewerParty.PresentationSecondsRemaining(
    PartyState, PartyPrimary.Actor, PartyState.Companion.Actor, 100) = 6,
    "Restored Dragon hero turn reports its remaining seconds")

PartyState.Turn = 2
PartyState.DragonCounter = 0

Call CheckNamed(ViewerParty.PresentationSecondsRemaining(
    PartyState, PartyPrimary.Actor, PartyState.Companion.Actor, 100) = 5,
    "Dragon turn reports its remaining seconds")

PartyState.UnityRoster = True
PartyState.BossAttackDuration = 2000

Call CheckNamed(ViewerParty.PresentationSecondsRemaining(
    PartyState, PartyPrimary.Actor, PartyState.Companion.Actor, 100) = 6,
    "Vrax countdown includes preparation, approach, actual attack and recovery")

PartyState.UnityRoster = False

PartyState.Enabled = False
PartyState.Turn = 0
PartyState.AttackCycle = 1

Call Check(ViewerParty.ActingName(PartyState) = "Arin")
Call Check(ViewerParty.AttackSequenceName(PartyState) = "Sword Attack 2")

PartyState.Turn = 1
PartyState.AttackCycle = 2

Call Check(ViewerParty.ActingName(PartyState) = "Orin")
Call Check(ViewerParty.AttackSequenceName(PartyState) = "Thor Attack")

PartyPointer = ViewerParty.ClassifyPointer(
    20, 110, True, False, 0, False, False, 640, 1000, 1200, 40)

Call Check(PartyPointer.Consumed And
    PartyPointer.Action = ViewerParty.POINTER_ACTION_TOGGLE_DRAGON)

PartyPointer = ViewerParty.ClassifyPointer(
    20, 110, True, False, 0, False, True, 640, 1000, 1200, 40)

Call Check(Not PartyPointer.Consumed And
    PartyPointer.Action = ViewerParty.POINTER_ACTION_NONE)

PartyPointer = ViewerParty.ClassifyPointer(
    500, 500, False, True, 1, True, False, 640, 1000, 1200, 40)

Call Check(PartyPointer.Consumed And
    PartyPointer.Action = ViewerParty.POINTER_ACTION_RESET_INSPECTOR)

PartyPointer = ViewerParty.ClassifyPointer(
    30, 415, True, False, 0, False, False, 640, 1000, 1200, 40)

Call Check(PartyPointer.Consumed And
    PartyPointer.Action = ViewerParty.POINTER_ACTION_TOGGLE_FIRE)

PartyPointer = ViewerParty.ClassifyPointer(
    30, 415, True, False, 0, False, False, 579, 1000, 1200, 40)

Call Check(PartyPointer.Consumed And
    PartyPointer.Action = ViewerParty.POINTER_ACTION_NONE)

PartyPointer = ViewerParty.ClassifyPointer(
    1100, 500, True, False, 0, False, False, 640, 1000, 1200, 40)

Call Check(Not PartyPointer.Consumed And
    PartyPointer.Action = ViewerParty.POINTER_ACTION_NONE)

PartyPointer = ViewerParty.ClassifyPointer(
    1100, 500, True, False, 1, False, False, 640, 1000, 1200, 40)

Call Check(Not PartyPointer.Consumed And
    PartyPointer.Action = ViewerParty.POINTER_ACTION_NONE)

PartyResponse = ViewerParty.PointerResponseForAction(
    ViewerParty.POINTER_ACTION_SPEED_DOWN)

Call CheckNamed(PartyResponse.SpeedDelta = -25 And
    Not PartyResponse.ResetView And Not PartyResponse.ResetInspector And
    Not PartyResponse.TogglePause, "Party owner maps speed response")

PartyResponse = ViewerParty.PointerResponseForAction(
    ViewerParty.POINTER_ACTION_RESTART)

Call CheckNamed(PartyResponse.ResetInspector And PartyResponse.SpeedDelta = 0,
    "Party owner maps restart response")

PartyResponse = ViewerParty.PointerResponseForAction(
    ViewerParty.POINTER_ACTION_TOGGLE_PAUSE)

Call CheckNamed(PartyResponse.TogglePause,
    "Party owner maps pause response")

Call ViewerRendering.Reset(RenderingState, 3)
Call ViewerEffects.ResetPlaybackControls(EffectsState)
Call ViewerCamera.SetAutoOrbit(CameraState, False)

If EffectsState.ShieldFlameStyle Then
    Call ViewerEffects.ToggleShieldFireStyle(EffectsState)
End If

InspectorOperation = ViewerInspectorCommands.ApplyPartyPresentationAction(
    ViewerParty.POINTER_ACTION_CYCLE_SOCKET,
    RenderingState, 5, EffectsState, CameraState, DragonState)

Call CheckNamed(InspectorOperation.Handled And InspectorOperation.Ready,
    "Party socket action handled")
Call CheckNamed(RenderingState.SocketGizmosVisible,
    "Party socket action changes rendering state")

InspectorOperation = ViewerInspectorCommands.ApplyPartyPresentationAction(
    ViewerParty.POINTER_ACTION_TOGGLE_FLOOR,
    RenderingState, 5, EffectsState, CameraState, DragonState)

Call CheckNamed(Not RenderingState.FloorVisible And Not RenderingState.GridVisible,
    "Party floor action changes rendering state")

InspectorOperation = ViewerInspectorCommands.ApplyPartyPresentationAction(
    ViewerParty.POINTER_ACTION_CYCLE_BACKGROUND,
    RenderingState, 5, EffectsState, CameraState, DragonState)

Call CheckNamed(RenderingState.BackgroundIndex = 4,
    "Party background action changes rendering state")

InspectorOperation = ViewerInspectorCommands.ApplyPartyPresentationAction(
    ViewerParty.POINTER_ACTION_TOGGLE_ORBIT,
    RenderingState, 5, EffectsState, CameraState, DragonState)

Call CheckNamed(CameraState.AutoOrbit,
    "Party orbit action changes camera state")

InspectorOperation = ViewerInspectorCommands.ApplyPartyPresentationAction(
    ViewerParty.POINTER_ACTION_TOGGLE_FIRE,
    RenderingState, 5, EffectsState, CameraState, DragonState)

Call CheckNamed(EffectsState.FlamePaused,
    "Party Fire action changes independent VFX state")

InspectorOperation = ViewerInspectorCommands.ApplyPartyPresentationAction(
    ViewerParty.POINTER_ACTION_TOGGLE_LIGHTNING,
    RenderingState, 5, EffectsState, CameraState, DragonState)

Call CheckNamed(EffectsState.LightningPaused,
    "Party Lightning action changes independent VFX state")

InspectorOperation = ViewerInspectorCommands.ApplyPartyPresentationAction(
    ViewerParty.POINTER_ACTION_TOGGLE_SHIELD_STYLE,
    RenderingState, 5, EffectsState, CameraState, DragonState)

Call CheckNamed(EffectsState.ShieldFlameStyle,
    "Party shield style action changes VFX state")

InspectorOperation = ViewerInspectorCommands.ApplyPartyPresentationAction(
    ViewerParty.POINTER_ACTION_SPEED_UP,
    RenderingState, 5, EffectsState, CameraState, DragonState)

Call CheckNamed(Not InspectorOperation.Handled And InspectorOperation.Ready,
    "Cross-owner Party action remains unhandled")

Call ViewerActors.ResetEquipmentVisibility(EquipmentVisibility)
Call Check(ViewerInspectorCommands.ActorPresentationRequiresPrimaryActor(
    ViewerUi.INSPECTOR_ACTION_SWORD,
    ViewerInspectorCommands.ACTOR_ACTION_SOURCE_INSPECTOR_POINTER))
Call Check(ViewerInspectorCommands.ActorPresentationRequiresPrimaryActor(
    ViewerParty.POINTER_ACTION_TOGGLE_SHIELD,
    ViewerInspectorCommands.ACTOR_ACTION_SOURCE_PARTY_POINTER))
Call Check(ViewerInspectorCommands.ActorPresentationRequiresPrimaryActor(
    ViewerInput.INSPECTOR_KEY_TOGGLE_SWORD,
    ViewerInspectorCommands.ACTOR_ACTION_SOURCE_INSPECTOR_KEYBOARD))
Call Check(Not ViewerInspectorCommands.ActorPresentationRequiresPrimaryActor(
    ViewerUi.INSPECTOR_ACTION_GLOW,
    ViewerInspectorCommands.ACTOR_ACTION_SOURCE_INSPECTOR_POINTER))

InspectorOperation = ViewerInspectorCommands.ApplyActorPresentationAction(
    ViewerUi.INSPECTOR_ACTION_SWORD,
    ViewerInspectorCommands.ACTOR_ACTION_SOURCE_INSPECTOR_POINTER,
    EquipmentVisibility, PartyState, PartyPrimary.Actor,
    False, False, 1, 0, EffectsState)

Call CheckNamed(InspectorOperation.Handled And InspectorOperation.Ready And
    EquipmentVisibility.SwordVisible,
    "Unavailable equipment command is a handled no-op")

PartyState.DragonOpponent.GlowVisible = False
PartyState.Companion.GlowVisible = False
InspectorOperation = ViewerInspectorCommands.ApplyActorPresentationAction(
    ViewerUi.INSPECTOR_ACTION_GLOW,
    ViewerInspectorCommands.ACTOR_ACTION_SOURCE_INSPECTOR_POINTER,
    EquipmentVisibility, PartyState, PartyPrimary.Actor,
    False, True, 1, 0, EffectsState)

Call CheckNamed(InspectorOperation.Handled And InspectorOperation.Ready And
    PartyState.DragonOpponent.GlowVisible And PartyState.Companion.GlowVisible,
    "Dragon inspection glow command updates both opponents")

InspectorOperation = ViewerInspectorCommands.ApplyActorPresentationAction(
    ViewerParty.POINTER_ACTION_TOGGLE_GLOW,
    ViewerInspectorCommands.ACTOR_ACTION_SOURCE_PARTY_POINTER,
    EquipmentVisibility, PartyState, PartyPrimary.Actor,
    False, True, 1, 0, EffectsState)

Call CheckNamed(InspectorOperation.Handled And
    Not PartyState.DragonOpponent.GlowVisible And Not PartyState.Companion.GlowVisible,
    "Party glow command uses the same actor presentation owner")

InspectorOperation = ViewerInspectorCommands.ApplyActorPresentationAction(
    ViewerParty.POINTER_ACTION_SPEED_UP,
    ViewerInspectorCommands.ACTOR_ACTION_SOURCE_PARTY_POINTER,
    EquipmentVisibility, PartyState, PartyPrimary.Actor,
    False, False, 1, 0, EffectsState)

Call CheckNamed(Not InspectorOperation.Handled And InspectorOperation.Ready,
    "Unknown actor presentation command remains ready no-op")

Call ViewerRendering.Reset(RenderingState, 3)
Call ViewerEffects.ResetPlaybackControls(EffectsState)
Call ViewerCamera.SetAutoOrbit(CameraState, False)

If EffectsState.ShieldFlameStyle Then
    Call ViewerEffects.ToggleShieldFireStyle(EffectsState)
End If

FormationCenter = Math3D.Vector(-208, 0, -120)
FirstApproach = Math3D.Vector(-21, 0, -44)
