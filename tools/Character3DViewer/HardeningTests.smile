GizmoState.Visible = True
GizmoState.Projection.Origin.X = 0
GizmoState.Projection.Origin.Y = 0
GizmoState.Projection.XAxis.X = 30
GizmoState.Projection.XAxis.Y = 0

Call Check(ViewerGizmo.DragValueAmount(
