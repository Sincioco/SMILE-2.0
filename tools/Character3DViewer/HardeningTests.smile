''' A pitched camera must carry its up vector around the same horizontal arc.
PreciseOrbitBase.Position = Precision3D.Vector(0.0, 200.0, -400.0)
PreciseOrbitBase.Target = Precision3D.Vector(0.0, 0.0, 0.0)
PreciseOrbitBase.UpDirection = Precision3D.Vector(0.0, 0.894427191, 0.4472135955)
