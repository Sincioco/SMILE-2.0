Call Check(Abs(OrbitNext.UpDirection.X) <= Core.FIXED_ONE)
Call Check(Abs(OrbitNext.UpDirection.Y) <= Core.FIXED_ONE)
Call Check(Abs(OrbitNext.UpDirection.Z) <= Core.FIXED_ONE)

OrbitControls.PanX = 130
OrbitControls.PanY = -85
