    800, 640)

Call Check(CalibrationOperation.Ready And GizmoState.Visible)

GizmoPointer.Action = ViewerGizmo.POINTER_ACTION_TOGGLE
CalibrationOperation = ViewerCalibrationControls.ApplyGizmoPointerAction(
    GizmoPointer, False, CalibrationState, PartyPrimary.Actor, 0,
    -1, -1, False, UiState, GizmoState, CameraState, EffectsState,
    800, 640)

Call Check(CalibrationOperation.Ready And Not GizmoState.Visible)

CalibrationOperation = ViewerCalibrationControls.ApplyGizmoKeyboardAction(
    ViewerInput.GIZMO_KEY_AXIS_Z,
    CalibrationState, PartyPrimary.Actor, 0,
    -1, -1, False, UiState, GizmoState, CameraState, EffectsState)

Call Check(CalibrationOperation.Ready And
