Dim PartyParticipantUpdate As ViewerParty.ParticipantUpdateResult
Dim PartyInspectorBinding As ViewerParty.InspectorBindingResult
Dim PartyPrimary As ViewerActors.Context
Dim EquipmentVisibility As ViewerActors.EquipmentVisibility
Dim PartyActions As ViewerParty.FrameActions
Dim EmptyPartyActions As ViewerParty.FrameActions
Dim PartyPointer As ViewerParty.PointerDecision
