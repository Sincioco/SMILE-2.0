Call Check(GizmoState.DragRemainder = 0)

Call ViewerGizmo.BeginDrag(GizmoState, True, True, 27)
Call Check(GizmoState.Dragging And GizmoState.PointerOwned)
Call Check(GizmoState.OpenedEdit And GizmoState.DragStartValue = 27)

GizmoPointer = ViewerGizmo.ClassifyPointer(
