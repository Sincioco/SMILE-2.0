Call Check(OrinStorm.SceneComfortValue() = OrinStorm.SCENE_COMFORT_OFF)
Call Check(OrinStorm.SceneComfortName() = "Flash/Shake Off")
Call Check(OrinStorm.StyleName(FirstStorm) = "Thunder Smash")
Call Check(OrinStorm.StyleName(SecondStorm) = "Chain Arcs")

Call OrinStorm.SetStyle(FirstStorm, 1)
Call OrinStorm.SetStyle(SecondStorm, 3)
Call OrinStorm.SetSceneComfort(OrinStorm.SCENE_COMFORT_REDUCED)

