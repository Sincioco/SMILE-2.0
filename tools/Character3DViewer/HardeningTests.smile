Call ViewerUi.BeginClearConfirmation(UiState)
Call Check(UiState.CalibrationClearConfirm)
Call ViewerUi.FinishCalibrationEdit(UiState)
Call ViewerUi.ClearConfirmation(UiState)
Call Check(Not UiState.CalibrationEditing And Not UiState.CalibrationClearConfirm)
Call Check(ViewerUi.PlaybackLabel("Fire", False, "Freeze") = "Freeze Fire")
Call Check(ViewerUi.PlaybackLabel("Lightning", True, "Freeze") = "Play Lightning")
Call Check(ViewerUi.CalibrationTargetLabel(2) = "Weapon")
