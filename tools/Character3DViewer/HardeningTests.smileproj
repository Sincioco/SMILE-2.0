    <SmileSource Include="ArinShieldRim.smile" />
    <SmileSource Include="DragonPresence.smile" />
    <SmileSource Include="BattleAudio.smile" />
    <SmileSource Include="MiraBattle.smile" />
    <SmileSource Include="MiraWater.smile" />
    <SmileSource Include="BattleCamera.smile" />
    <SmileSource Include="BattleCameraShots.smile" />
    <SmileSource Include="BattleCameraTimeline.smile" />
    <SmileSource Include="ViewerBeatTimeline.smile" />
    <SmileSource Include="ViewerBeatSequence.smile" />
    <SmileSource Include="ViewerBeatHeadPersistence.smile" />
    <SmileSource Include="ViewerBeatEditor.smile" />
    <SmileSource Include="BeatCameraTests.smile" />
    <SmileSource Include="ViewerTiming.smile" />
    <SmileSource Include="ViewerSession.smile" />
    <SmileSource Include="ViewerLifecycle.smile" />
    <SmileSource Include="ViewerPlayback.smile" />
    <SmileSource Include="ViewerActors.smile" />
    <SmileSource Include="ViewerCamera.smile" />
    <SmileSource Include="CalibrationJson.smile" />
    <SmileSource Include="ViewerCalibration.smile" />
    <SmileSource Include="ViewerCalibrationEditing.smile" />
    <SmileSource Include="ViewerCalibrationControls.smile" />
    <SmileSource Include="ViewerInput.smile" />
    <SmileSource Include="ViewerInspectorCommands.smile" />
    <SmileSource Include="ViewerInspectorPresentation.smile" />
    <SmileSource Include="ViewerTimelineEditing.smile" />
    <SmileSource Include="ViewerUi.smile" />
    <SmileSource Include="..\..\games\SinStarI\BattleArenaPreview.smile" />
    <SmileSource Include="ViewerGizmo.smile" />
    <SmileSource Include="ViewerParty.smile" />
    <SmileSource Include="ViewerEffects.smile" />
    <SmileSource Include="ViewerDragon.smile" />
    <SmileSource Include="ViewerRendering.smile" />
    <Model3DAsset Include="BuildAssets\Hardening\AnimationArticulated.glb"
                  Descriptor="BuildAssets\Hardening\AnimationArticulated.sm3d.json"
                  LogicalPath="Assets\Generation2\VraxV1\Vrax.sm3d"
                  TextureOutputDirectory="Assets\FixtureTextures" Profile="Character" />
    <Model3DAsset Include="BuildAssets\Hardening\AnimationArticulated.glb"
                  Descriptor="HardeningAim.sm3d.json"
                  LogicalPath="Assets\Generation2\RedDragon\RedDragon.sm3d"
                  TextureOutputDirectory="Assets\FixtureTextures" Profile="Character" />
    <SmileProjectReference Include="..\..\libraries\Smile.Simple3D\Smile.Simple3D.smilelibproj" />
    <SmileProjectReference Include="..\..\libraries\Smile.UI\Smile.UI.smilelibproj" />
  </ItemGroup>
</SmileProject>
