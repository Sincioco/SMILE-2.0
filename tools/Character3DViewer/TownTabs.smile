''' Open town documents. Only the selected document owns live renderer resources.
Module Smile.Tools.TownTabs

Option Explicit

Import Smile.Tools.TownDocument As Document
Import Smile.Tools.TownLibrary As Library
Import Smile.Tools.TownDocumentStore As Storage
Import Smile.UI.Controls As UI
Import Smile.Tools.TownMapPicker As Picker
Import Smile.Tools.TownWorldPreviews As Previews

Public Const CAPACITY = 16

Public Type State
    Documents[16] As Document.State
    TabCount As Number
    Active As Number
    Message As Text
    First As Number
    DisplayedActive As Number
    Menu As Picker.State
    ReturnIndex As Number
End Type

Public Sub Ensure(ByRef Value As State, ByRef Town As Document.State)

    Dim Ok As Boolean
    Dim Index As Number

    If Value.TabCount = 0 Then

        Value.TabCount = 1
        Value.Active = 0
        Value.Documents[0] = Town

        If Town.Name <> "Neris Town" Then
            Return
        End If

        For Index = 1 To Library.PERMANENT_COUNT - 1

            Ok = Library.RecoverNamed(Value.Documents[Value.TabCount], Library.PermanentName(Index))

            If Ok Then
                Value.TabCount = Value.TabCount + 1
            End If

        End For

    End If

End Sub

''' Promote the current edits to one named startup tab without discarding the copy.
Public Function UpdatePermanent(ByRef Value As State, ByRef Town As Document.State,
    Name As Text) As Boolean

    Dim Candidate As Document.State
    Dim Previous As Document.State
    Dim Index As Number
    Dim Target As Number
    Dim Ok As Boolean

    If Text_Length(Library.PermanentKey(Name)) = 0 Then
        Value.Message = "Choose a permanent Luma map."
        Return False
    End If

    Call Ensure(Value, Town)

    Target = -1

    For Index = 0 To Value.TabCount - 1

        If Value.Documents[Index].Name = Name Then
            Target = Index
        End If

    End For

    If Target < 0 And Value.TabCount >= CAPACITY Then
        Value.Message = "Close a copy tab before updating this map."
        Return False
    End If

    If Target >= 0 Then

        Previous = Value.Documents[Target]

        If Target = Value.Active Then
            Previous = Town
        End If

    Else

        Ok = Library.RecoverNamed(Previous, Name)

        If Not Ok Then
            Value.Message = "Original map not found; edits retained."
            Return False
        End If

    End If

    Candidate = Town
    Candidate.Name = Name
    Candidate.Revision = Max(Town.Revision, Previous.Revision) + 1
    Candidate.Surface.Revision = Candidate.Revision
    Candidate.SavedRevision = Candidate.Revision
    Ok = Library.UpdatePermanent(Candidate, Previous, Name)

    If Not Ok Then
        Value.Message = "Permanent save failed; edits retained."
        Return False
    End If

    Value.Documents[Value.Active] = Town

    If Target < 0 Then
        Target = Value.TabCount
        Value.TabCount = Value.TabCount + 1
    End If

    Value.Active = Target
    Town = Candidate
    Value.Documents[Target] = Town
    Value.Message = "Permanent map saved for next launch."

    Return True

End Function

Public Function OpenNamed(ByRef Value As State, ByRef Town As Document.State, Name As Text) As Boolean

    Dim Index As Number
    Dim Incoming As Document.State
    Dim Ok As Boolean

    Call Ensure(Value, Town)

    For Index = 0 To Value.TabCount - 1

        If Value.Documents[Index].Name = Name Then
            Ok = SelectTab(Value, Town, Index, False)
            Return Ok
        End If

    End For

    Incoming = Town
    Ok = Library.OpenNamed(Incoming, Name)

    If Ok Then
        Ok = Add(Value, Town, Incoming)
    End If

    Return Ok

End Function

Public Function Add(ByRef Value As State, ByRef Town As Document.State,
    ByRef Incoming As Document.State) As Boolean

    Dim Index As Number
    Dim Suffix As Number
    Dim Label As Text
    Dim Exists As Boolean
    Dim Dirty As Boolean

    Call Ensure(Value, Town)

    If Value.TabCount >= CAPACITY Then
        Value.Message = "Close a town tab first (limit 16)."
        Return False
    End If

    Value.Documents[Value.Active] = Town
    Label = Incoming.Name
    Suffix = 1

    Do

        Exists = False

        For Index = 0 To Value.TabCount - 1

            If Value.Documents[Index].Name = Incoming.Name Then
                Exists = True
            End If

        End For

        If Exists Then

            Suffix = Suffix + 1
            Incoming.Name = Text_Slice(Label, 0, 70) + " "

            If Suffix >= 10 Then
                Incoming.Name = Incoming.Name + Text_From_Code(48 + Suffix / 10)
            End If

            Incoming.Name = Incoming.Name + Text_From_Code(48 + Suffix Mod 10)

        End If

    Loop Until Not Exists

    Value.Documents[Value.Active] = Town
    Value.Active = Value.TabCount
    Value.TabCount = Value.TabCount + 1
    Dirty = Document.Dirty(Incoming)
    Incoming.Revision = Max(Town.Revision, Town.Surface.Revision) + 1
    Incoming.SavedRevision = Incoming.Revision

    If Dirty Then
        Incoming.SavedRevision = -1
    End If

    Incoming.Surface.Revision = Incoming.Revision
    Town = Incoming
    Value.Documents[Value.Active] = Town

    Return True

End Function

Public Function SelectTab(ByRef Value As State, ByRef Town As Document.State,
    Index As Number, Close As Boolean) As Boolean

    Dim Ok As Boolean
    Dim Slot As Number
    Dim Revision As Number
    Dim Dirty As Boolean

    If Index < 0 Or Index >= Value.TabCount Then
        Return False
    End If

    Value.Documents[Value.Active] = Town
    Ok = Library.Remember(Town)

    If Not Ok Then
        Value.Message = "Recovery failed; current town retained."
        Return False
    End If

    If Close Then

        If Index = 0 Then
            Value.Message = "Neris Town is the permanent tab."
            Return False
        End If

        Ok = Library.Remember(Value.Documents[Index])

        If Not Ok Then
            Value.Message = "Recovery failed; tab was kept open."
            Return False
        End If

        For Slot = Index To Value.TabCount - 2
            Value.Documents[Slot] = Value.Documents[Slot + 1]
        End For

        Value.TabCount = Value.TabCount - 1

        If Index < Value.Active Then
            Value.Active = Value.Active - 1
            Return False
        Else If Index > Value.Active Then
            Return False
        End If

        Index = Min(Index, Value.TabCount - 1)

    Else If Index = Value.Active Then

        Return False

    End If

    Revision = Max(Town.Revision, Town.Surface.Revision) + 1
    Town = Value.Documents[Index]
    Dirty = Document.Dirty(Town)
    Town.Revision = Revision
    Town.Surface.Revision = Revision
    Town.SavedRevision = Revision

    If Dirty Then
        Town.SavedRevision = -1
    End If

    Value.Active = Index

    Return True

End Function

Private Function VisibleCount(ByRef Value As State) As Number

    Dim Result As Number

    Result = Min(Value.TabCount, Max(1, (Window_Width() - 630) / 150))

    Return Result

End Function

Public Function Input(ByRef Value As State, ByRef Town As Document.State, Optional Key As Number = 0) As Boolean

    Dim Index As Number
    Dim Width As Number
    Dim Changed As Boolean
    Dim Visible As Number

    Index = Picker.Input(Value.Menu, Key)

    If Index >= 0 Then

        Changed = SelectTab(Value, Town, Index, False)
        Changed = Changed Or Index = Value.Active
        Return Changed

    End If

    If Value.Menu.Consumed Then

        If Not Value.Menu.Visible Then
            Changed = SelectTab(Value, Town, Value.ReturnIndex, False)
        End If

        Return Changed

    End If

    If (Pointer_Y() < 96 Or
        Pointer_Y() >= 123 Or
        Value.TabCount = 0) Then
        Return False
    End If

    Visible = VisibleCount(Value)
    Width = Min(180, Max(1, Window_Width() - 630) / Visible)

    If Pointer_X() >= 10 And Pointer_X() < 62 + Visible * Width Then
        Value.First = Max(0, Min(Value.TabCount - Visible,
            Value.First - Pointer_Wheel_Delta()))
    End If

    If Pointer_Pressed(POINTER_PRIMARY) Then

        If Pointer_X() >= 10 + Visible * Width And Pointer_X() < 62 + Visible * Width Then

            Value.Menu.Visible = True
            Value.Menu.Consumed = True
            Value.ReturnIndex = Value.Active
            Return False

        End If

    End If

    Index = Value.First + (Pointer_X() - 10) / Width

    If (Pointer_X() >= 10 And
        Pointer_X() < 10 + Visible * Width And
        (Pointer_Pressed(POINTER_PRIMARY) Or Pointer_Pressed(POINTER_SECONDARY))) Then
        Changed = SelectTab(Value, Town, Index, Pointer_Pressed(POINTER_SECONDARY))
    End If

    Return Changed

End Function

''' Prepare missing photographs behind the modal without advancing the party.
Public Function PreparePicker(ByRef Value As State, ByRef Town As Document.State) As Boolean

    Dim Index As Number
    Dim Changed As Boolean

    If Not Value.Menu.Visible Or Not Previews.Has(Town.Name) Then
        Return False
    End If

    For Index = 0 To Value.TabCount - 1

        If Not Previews.Has(Value.Documents[Index].Name) Then
            Changed = SelectTab(Value, Town, Index, False)
            Return Changed
        End If

    End For

    If Value.Active = Value.ReturnIndex Then
        Return False
    End If

    Changed = SelectTab(Value, Town, Value.ReturnIndex, False)

    Return Changed

End Function

Public Sub Draw(ByRef Value As State, ByRef Town As Document.State)

    Dim Index As Number
    Dim Width As Number
    Dim Label As Text
    Dim Visible As Number

    If Value.TabCount = 0 Then
        Return
    End If

    Visible = VisibleCount(Value)
    Width = Min(180, Max(1, Window_Width() - 630) / Visible)

    If Value.Active <> Value.DisplayedActive Then
        Value.First = Min(Value.Active, Max(0, Value.TabCount - Visible))
        Value.DisplayedActive = Value.Active
    End If

    Value.First = Min(Value.First, Max(0, Value.TabCount - Visible))
    Fill Rectangle 0, 94, Window_Width(), 32, RGB(12, 23, 36) Opacity 80

    For Index = Value.First To Value.First + Visible - 1

        Label = Value.Documents[Index].Name

        If Index = Value.Active Then
            Label = Town.Name
        End If

        Call UI.DrawButton(10 + (Index - Value.First) * Width, 96, Width - 4, 27,
            Text_Slice(Label, 0, Max(8, Width / 8)), Index = Value.Active)
    End For

    If Value.TabCount > Visible Then
        Call UI.DrawButton(10 + Visible * Width, 96, 50, 27, "Maps", Value.Menu.Visible)
    End If

End Sub

Public Sub DrawPicker(ByRef Value As State)

    Dim Index As Number

    Value.Menu.EntryCount = Value.TabCount
    Value.Menu.Active = Value.ReturnIndex

    For Index = 0 To Value.TabCount - 1
        Value.Menu.Names[Index] = Value.Documents[Index].Name
    End For

    Call Picker.Draw(Value.Menu)

End Sub

End Module
