''' Versioned, bounded town persistence. Decoding commits only a complete valid document.
Module Smile.Tools.TownDocumentStore

Option Explicit

Import Smile.Simple3D.SurfaceGrid3D As Grid
Import Smile.Simple3D.SurfacePaint3D As Paint
Import Smile.Simple3D.TerrainHeights3D As Heights
Import Smile.Simple3D.TerrainSurface3D As Terrain
Import Smile.Simple3D.TerrainWater3D As Water
Import Smile.Tools.TownDocument As Document
Import Smile.Tools.TownSurfaceStyles As Styles
Import Smile.Tools.TownCatalogData As Catalog

Private Const CAPACITY = 524288
Private Dim Bytes[524288] As Number
Private Dim Comparison[524288] As Number
Private Dim Offset As Number
Private Dim ByteCount As Number
Private Dim Valid As Boolean
Private Dim Candidate As Document.State

Public Type BridgeStatus
    RequestId As Number
    Status As Number
    Progress As Number
    Message As Text
End Type

Private Sub WriteByte(Value As Number)

    If Offset >= CAPACITY Then
        Valid = False
        Return
    End If

    Bytes[Offset] = Value
    Offset = Offset + 1

End Sub

Private Function ReadByte() As Number

    Dim Result As Number

    If Offset >= ByteCount Then
        Valid = False
        Return 0
    End If

    Result = Bytes[Offset]
    Offset = Offset + 1

    Return Result

End Function

''' Zigzag/base-128 integers. Eight bytes cover every admitted document value.
Private Sub WriteInteger(Value As Number)

    Dim Encoded As Number
    Dim Digit As Number

    If Abs(Value) > 1000000000000000 Then
        Valid = False
        Return
    End If

    Encoded = Value * 2

    If Value < 0 Then
        Encoded = -Value * 2 - 1
    End If

    Do

        Digit = Encoded Mod 128
        Encoded = Encoded / 128

        If Encoded > 0 Then
            Digit = Digit + 128
        End If

        Call WriteByte(Digit)

    Loop Until Encoded = 0

End Sub

Private Function ReadInteger() As Number

    Dim Result As Number
    Dim Encoded As Number
    Dim Factor As Number
    Dim Digit As Number
    Dim Index As Number

    Factor = 1

    For Index = 0 To 7

        Digit = ReadByte()
        Encoded = Encoded + (Digit Mod 128) * Factor

        If Digit < 128 Then

            Result = Encoded / 2

            If Encoded Mod 2 <> 0 Then
                Result = -Result - 1
            End If

            Return Result

        End If

        Factor = Factor * 128
    End For

    Valid = False

    Return 0

End Function

Private Sub WritePrecise(Value As Double)

    If Abs(Value) > 1000000000.0 Then
        Valid = False
        Return
    End If

    Call WriteInteger(ToNumber(Round(Value * 1000000.0)))

End Sub

Private Function ReadPrecise() As Double

    Dim Result As Double

    Result = ToDouble(ReadInteger()) / 1000000.0

    If Abs(Result) > 1000000000.0 Then
        Valid = False
    End If

    Return Result

End Function

Private Sub WriteName(Value As Text)

    Dim Index As Number

    If Not Document.ValidName(Value) Then
        Valid = False
        Return
    End If

    Call WriteInteger(Text_Length(Value))

    For Index = 0 To Text_Length(Value) - 1
        Call WriteInteger(Text_Code_At(Value, Index))
    End For

End Sub

Private Function ReadName() As Text

    Dim Result As Text
    Dim Length As Number
    Dim Index As Number
    Dim Code As Number

    Length = ReadInteger()

    If Length < 1 Or Length > 80 Then
        Valid = False
        Return ""
    End If

    For Index = 0 To Length - 1

        Code = ReadInteger()

        If (Code < 32 Or
            Code > 1114111 Or
            (Code >= 55296 And Code <= 57343)) Then
            Valid = False
            Return ""
        End If

        Result = Result + Text_From_Code(Code)
    End For

    Return Result

End Function

Private Sub WriteItem(Value As Document.Item)

    Call WriteInteger(Value.Identity)
    Call WriteInteger(Value.Template)
    Call WriteInteger(Value.SourceIndex)
    Call WritePrecise(Value.Position.X)
    Call WritePrecise(Value.Position.Y)
    Call WritePrecise(Value.Position.Z)
    Call WritePrecise(Value.Scale.X)
    Call WritePrecise(Value.Scale.Y)
    Call WritePrecise(Value.Scale.Z)
    Call WritePrecise(Value.Yaw)

End Sub

Private Function ReadItem() As Document.Item

    Dim Result As Document.Item
    Dim Template As Catalog.Template

    Result.Identity = ReadInteger()
    Result.Template = ReadInteger()
    Result.SourceIndex = ReadInteger()
    Result.Position.X = ReadPrecise()
    Result.Position.Y = ReadPrecise()
    Result.Position.Z = ReadPrecise()
    Result.Scale.X = ReadPrecise()
    Result.Scale.Y = ReadPrecise()
    Result.Scale.Z = ReadPrecise()
    Result.Yaw = ReadPrecise()
    Result.Active = True

    If (Result.Identity < 1 Or
        Result.Identity > 1000000000 Or
        Result.Template < 0 Or
        Result.Template >= Catalog.TEMPLATE_COUNT Or
        Result.SourceIndex < -1 Or
        Result.SourceIndex >= Catalog.INITIAL_ITEMS Or
        Result.Scale.X <= 0.0 Or
        Result.Scale.Y <= 0.0 Or
        Result.Scale.Z <= 0.0) Then
        Valid = False
        Return Result
    End If

    Template = Catalog.TemplateAt(Result.Template)
    Result.Category = Template.Category

    Return Result

End Function

Private Sub WriteSun(Light As Document.Sun)

    Call WriteInteger(Light.RedValue)
    Call WriteInteger(Light.GreenValue)
    Call WriteInteger(Light.BlueValue)
    Call WriteInteger(Light.Intensity)
    Call WriteInteger(Light.Ambient)
    Call WritePrecise(Light.Azimuth)
    Call WritePrecise(Light.Elevation)

    If Light.Shadows Then
        Call WriteByte(1)
    Else

        Call WriteByte(0)
    End If

    Call WriteByte(Light.ShadowOpacity + 1)

End Sub

Private Function ReadSun(Version As Number) As Document.Sun

    Dim Light As Document.Sun
    Dim Shadows As Number

    Light.RedValue = ReadInteger()
    Light.GreenValue = ReadInteger()
    Light.BlueValue = ReadInteger()
    Light.Intensity = ReadInteger()
    Light.Ambient = ReadInteger()
    Light.Azimuth = ReadPrecise()
    Light.Elevation = ReadPrecise()
    Shadows = ReadByte()
    Light.Shadows = Shadows = 1
    Light.ShadowOpacity = -1

    If Version >= 2 Then
        Light.ShadowOpacity = ReadByte() - 1
    End If

    If (Light.RedValue < 0 Or
        Light.RedValue > 255 Or
        Light.GreenValue < 0 Or
        Light.GreenValue > 255 Or
        Light.BlueValue < 0 Or
        Light.BlueValue > 255 Or
        Light.Intensity < 0 Or
        Light.Intensity > 1000 Or
        Light.Ambient < 0 Or
        Light.Ambient > 100 Or
        Light.ShadowOpacity < -1 Or
        Light.ShadowOpacity > 100 Or
        Shadows < 0 Or
        Shadows > 1) Then
        Valid = False
    End If

    Return Light

End Function

Private Function DocumentVersion(ByRef Value As Document.State) As Number

    Dim Index As Number
    Dim Version As Number

    Version = 7

    If Value.Appearance.Nonzero > 0 Then
        Return 12
    End If

    If Value.Surface.Heights.Nonzero > 0 Then
        Return 11
    End If

    For Index = 0 To Value.Surface.Curves.BrushCount - 1

        If Value.Surface.Curves.Brushes[Index].WaterMode <> 0 Then
            Return 11
        End If

    End For

    If Value.Landmark <> Document.LegacyLandmark(Value.Name) Then
        Return 10
    End If

    For Index = 0 To Value.Surface.Curves.BrushCount - 1

        If Value.Surface.Curves.Brushes[Index].Form >= Paint.FORM_TRIANGLE Then
            Return 9
        Else If Value.Surface.Curves.Brushes[Index].Form >= Paint.FORM_FILLET Then
            Version = 8
        End If

    End For

    Return Version

End Function

''' TWN11: signed millimetre offsets, run-length encoded in canonical corner order.
Private Sub WriteTerrain(ByRef Surface As Grid.State)

    Dim Index As Number
    Dim Finish As Number
    Dim Height As Number
    Dim Total As Number

    Total = (Surface.Columns + 1) * (Surface.Rows + 1)

    Call WriteInteger(Total)

    Do
        Height = ToNumber(Round(Heights.Read(Surface.Heights, Index) * 100.0))
        Finish = Index + 1

        Do

            If Finish >= Total Then
                Exit Do
            End If

            If ToNumber(Round(Heights.Read(Surface.Heights, Finish) * 100.0)) <> Height Then
                Exit Do
            End If

            Finish = Finish + 1

        Loop

        Call WriteInteger(Finish - Index)
        Call WriteInteger(Height)

        Index = Finish

    Loop Until Index >= Total Or Not Valid

    For Index = 0 To Surface.Curves.BrushCount - 1
        Call WriteInteger(Surface.Curves.Brushes[Index].WaterMode)
        Call WriteInteger(Surface.Curves.Brushes[Index].FlowSign)
        Call WriteInteger(Surface.Curves.Brushes[Index].FlowSpeed)
    End For

End Sub

Private Function ReadTerrain(ByRef Surface As Grid.State) As Boolean

    Dim Total As Number
    Dim Index As Number
    Dim RunLength As Number
    Dim Height As Number
    Dim Corner As Number
    Dim Groups As Water.Groups

    Total = ReadInteger()

    If Total <> (Surface.Columns + 1) * (Surface.Rows + 1) Then
        Return False
    End If

    Do
        RunLength = ReadInteger()
        Height = ReadInteger()

        If (Not Valid Or
            RunLength < 1 Or
            RunLength > Total - Index Or
            Abs(Height) > 1000000) Then
            Return False
        End If

        If Height <> 0 Then

            For Corner = Index To Index + RunLength - 1
                Valid = Heights.Write(Surface.Heights, Corner, ToDouble(Height) * 0.01) And Valid
            End For

        End If

        Index = Index + RunLength

    Loop Until Index = Total

    For Index = 0 To Surface.Curves.BrushCount - 1
        Surface.Curves.Brushes[Index].WaterMode = ReadInteger()
        Surface.Curves.Brushes[Index].FlowSign = ReadInteger()
        Surface.Curves.Brushes[Index].FlowSpeed = ReadInteger()
    End For

    Valid = Water.Collect(Surface.Curves, Groups) And Valid
    Return Valid

End Function

Private Sub WriteAppearance(ByRef Value As Styles.State, Total As Number)

    Dim Index As Number
    Dim Finish As Number
    Dim Style As Number

    Call WriteInteger(Total)

    Do
        Style = Styles.Read(Value, Index)
        Finish = Index + 1

        Do

            If Finish >= Total Or Styles.Read(Value, Finish) <> Style Then
                Exit Do
            End If

            Finish = Finish + 1

        Loop

        Call WriteInteger(Finish - Index)
        Call WriteInteger(Style)

        Index = Finish

    Loop Until Index = Total Or Not Valid

End Sub

Private Function ReadAppearance(ByRef Value As Styles.State, Expected As Number) As Boolean

    Dim Total As Number
    Dim Index As Number
    Dim Length As Number
    Dim Style As Number
    Dim Cell As Number
    Dim Changed As Boolean

    Total = ReadInteger()

    If Total <> Expected Then
        Return False
    End If

    Do
        Length = ReadInteger()
        Style = ReadInteger()

        If (Not Valid Or
            Length < 1 Or
            Length > Total - Index Or
            Style < 0 Or
            Style > 4) Then
            Return False
        End If

        If Style > 0 Then

            For Cell = Index To Index + Length - 1
                Changed = Styles.Write(Value, Cell, Style)
            End For

        End If

        Index = Index + Length

    Loop Until Index = Total

    Return Valid

End Function

Private Sub Encode(ByRef Value As Document.State, MarkSaved As Boolean)

    Dim Index As Number
    Dim ActiveCount As Number
    Dim Brush As Paint.Brush
    Dim Groups As Water.Groups

    Offset = 0
    Valid = True

    If (Not Styles.Valid(Value.Appearance, Value.Surface.Columns * Value.Surface.Rows) Or
        Not Terrain.Valid(Value.Surface) Or
        Not Heights.Valid(Value.Surface.Heights, (Value.Surface.Columns + 1) * (Value.Surface.Rows + 1)) Or
        Not Water.Collect(Value.Surface.Curves, Groups)) Then
        Valid = False
        Return
    End If

    Call WriteByte(84)
    Call WriteByte(87)
    Call WriteByte(78)
    Call WriteByte(DocumentVersion(Value))
    Call WriteName(Catalog.FINGERPRINT)
    Call WriteName(Value.Name)

    If Document.Dirty(Value) And Not MarkSaved Then
        Call WriteByte(1)
    Else

        Call WriteByte(0)
    End If

    Call WriteInteger(Value.Surface.Columns)
    Call WriteInteger(Value.Surface.Rows)
    Call WritePrecise(Value.Surface.CellSize)

    For Index = 0 To Value.Surface.Columns
        Call WritePrecise(Value.Surface.XEdges[Index])
    End For

    For Index = 0 To Value.Surface.Rows
        Call WritePrecise(Value.Surface.ZEdges[Index])
    End For

    For Index = 0 To (Value.Surface.Columns * Value.Surface.Rows + 15) / 16 - 1
        Call WriteInteger(Value.Surface.Cells[Index])
    End For

    For Index = 0 To Value.ItemCount - 1

        If Value.Items[Index].Active Then
            ActiveCount = ActiveCount + 1
        End If

    End For

    Call WriteInteger(ActiveCount)

    For Index = 0 To Value.ItemCount - 1

        If Value.Items[Index].Active Then
            Call WriteItem(Value.Items[Index])
        End If

    End For

    Call WriteSun(Value.Light)
    Call WriteInteger(Value.MapTileCount)

    For Index = 0 To Value.MapTileCount - 1
        Call WriteInteger(Value.MapTiles[Index].X)
        Call WriteInteger(Value.MapTiles[Index].Z)
        Call WriteName(Value.MapTiles[Index].Destination)
    End For

    If Value.Presets.NightActive Then
        Call WriteByte(1)
    Else

        Call WriteByte(0)
    End If

    If Value.Presets.HasDay Then
        Call WriteByte(1)
        Call WriteSun(Value.Presets.Day)
    Else

        Call WriteByte(0)
    End If

    If Value.Presets.HasNight Then
        Call WriteByte(1)
        Call WriteSun(Value.Presets.Night)
    Else

        Call WriteByte(0)
    End If

    Call WritePrecise(Value.CourtOffsetX)
    Call WritePrecise(Value.CourtOffsetZ)

    If Value.CourtPlaced Then
        Call WriteByte(1)
    Else

        Call WriteByte(0)
    End If

    Call WriteInteger(Value.Surface.Curves.BrushCount)

    If Value.Surface.Curves.BrushCount > 0 Then

        For Index = 0 To Value.Surface.Curves.BrushCount - 1

            Brush = Value.Surface.Curves.Brushes[Index]

            Call WriteInteger(Brush.Form)
            Call WriteInteger(Brush.Surface)
            Call WritePrecise(Brush.X0)
            Call WritePrecise(Brush.Z0)
            Call WritePrecise(Brush.X1)
            Call WritePrecise(Brush.Z1)
            Call WritePrecise(Brush.Width)

            If Brush.Form >= Paint.FORM_TRIANGLE Then
                Call WritePrecise(Brush.X2)
                Call WritePrecise(Brush.Z2)
            End If

        End For

    End If

    Valid = Valid And Value.TerrainStyle >= 0 And Value.TerrainStyle <= 3

    Call WriteByte(Value.TerrainStyle)

    Valid = Valid And Value.Landmark >= 0 And Value.Landmark <= Document.LANDMARK_HORIZON

    If DocumentVersion(Value) >= 10 Then
        Call WriteByte(Value.Landmark)
    End If

    If DocumentVersion(Value) >= 11 Then
        Call WriteTerrain(Value.Surface)
    End If

    If DocumentVersion(Value) >= 12 Then
        Call WriteAppearance(Value.Appearance, Value.Surface.Columns * Value.Surface.Rows)
    End If

    ByteCount = Offset

End Sub

Private Function Decode() As Boolean

    Dim Index As Number
    Dim Other As Number
    Dim Packed As Number
    Dim Digit As Number
    Dim Flag As Number
    Dim Version As Number
    Dim EmptyPresets As Document.SunPresets

    Offset = 0
    Valid = True

    If (ReadByte() <> 84 Or
        ReadByte() <> 87 Or
        ReadByte() <> 78) Then
        Return False
    End If

    Version = ReadByte()

    If Version < 1 Or Version > 12 Then
        Return False
    End If

    If ReadName() <> Catalog.FINGERPRINT Then
        Return False
    End If

    Call Styles.Reset(Candidate.Appearance)

    Candidate.Name = ReadName()
    Candidate.Landmark = Document.LegacyLandmark(Candidate.Name)
    Candidate.SavedRevision = ReadByte()

    If Candidate.SavedRevision < 0 Or Candidate.SavedRevision > 1 Then
        Return False
    End If

    Candidate.Surface.Columns = ReadInteger()
    Candidate.Surface.Rows = ReadInteger()
    Candidate.Surface.CellSize = ReadPrecise()

    If (Not Valid Or
        Candidate.Surface.Columns < 1 Or
        Candidate.Surface.Columns > Grid.MAX_COLUMNS Or
        Candidate.Surface.Rows < 1 Or
        Candidate.Surface.Rows > Grid.MAX_ROWS Or
        Candidate.Surface.CellSize <= 0.0) Then
        Return False
    End If

    For Index = 0 To Candidate.Surface.Columns

        Candidate.Surface.XEdges[Index] = ReadPrecise()

        If Index > 0 And Candidate.Surface.XEdges[Index] <= Candidate.Surface.XEdges[Index - 1] Then
            Return False
        End If

    End For

    For Index = 0 To Candidate.Surface.Rows

        Candidate.Surface.ZEdges[Index] = ReadPrecise()

        If Index > 0 And Candidate.Surface.ZEdges[Index] <= Candidate.Surface.ZEdges[Index - 1] Then
            Return False
        End If

    End For

    Candidate.Surface.OriginX = Candidate.Surface.XEdges[0]
    Candidate.Surface.OriginZ = Candidate.Surface.ZEdges[0]

    Call Heights.Reset(Candidate.Surface.Heights, (Candidate.Surface.Columns + 1) * (Candidate.Surface.Rows + 1))

    For Index = 0 To (Candidate.Surface.Columns * Candidate.Surface.Rows + 15) / 16 - 1

        Packed = ReadInteger()
        Candidate.Surface.Cells[Index] = Packed

        If Packed < 0 Or Packed > 281474976710655 Then
            Return False
        End If

        For Digit = 0 To 15

            If Packed Mod 8 > Grid.SURFACE_BRIDGE Then
                Return False
            End If

            Packed = Packed / 8
        End For
    End For

    Candidate.ItemCount = ReadInteger()
    Candidate.NextIdentity = 1

    If Candidate.ItemCount < 0 Or Candidate.ItemCount > Document.MAX_ITEMS Then
        Return False
    End If

    For Index = 0 To Candidate.ItemCount - 1

        Candidate.Items[Index] = ReadItem()
        Candidate.NextIdentity = Max(Candidate.NextIdentity, Candidate.Items[Index].Identity + 1)

        For Other = 0 To Index - 1

            If Candidate.Items[Index].Identity = Candidate.Items[Other].Identity Then
                Return False
            End If

        End For
    End For

    Candidate.Light = ReadSun(Version)
    Candidate.Presets = EmptyPresets
    Candidate.Presets.NightActive = Candidate.Light.Intensity < 100
    Candidate.MapTileCount = 0

    If Version >= 3 Then

        Candidate.MapTileCount = ReadInteger()

        If Candidate.MapTileCount < 0 Or Candidate.MapTileCount > Document.MAX_MAP_TILES Then
            Return False
        End If

        For Index = 0 To Candidate.MapTileCount - 1

            Candidate.MapTiles[Index].X = ReadInteger()
            Candidate.MapTiles[Index].Z = ReadInteger()
            Candidate.MapTiles[Index].Destination = ReadName()

            If (Candidate.MapTiles[Index].X < 0 Or
                Candidate.MapTiles[Index].X >= Candidate.Surface.Columns Or
                Candidate.MapTiles[Index].Z < 0 Or
                Candidate.MapTiles[Index].Z >= Candidate.Surface.Rows) Then
                Return False
            End If

            For Other = 0 To Index - 1

                If (Candidate.MapTiles[Other].X = Candidate.MapTiles[Index].X And
                    Candidate.MapTiles[Other].Z = Candidate.MapTiles[Index].Z) Then
                    Return False
                End If

            End For
        End For

    End If

    If Version >= 4 Then

        Flag = ReadByte()
        Candidate.Presets.NightActive = Flag = 1
        Valid = Valid And Flag <= 1
        Flag = ReadByte()
        Candidate.Presets.HasDay = Flag = 1
        Valid = Valid And Flag <= 1

        If Candidate.Presets.HasDay Then
            Candidate.Presets.Day = ReadSun(4)
        End If

        Flag = ReadByte()
        Candidate.Presets.HasNight = Flag = 1
        Valid = Valid And Flag <= 1

        If Candidate.Presets.HasNight Then
            Candidate.Presets.Night = ReadSun(4)
        End If

    End If

    Candidate.CourtOffsetX = 0.0
    Candidate.CourtOffsetZ = 0.0
    Candidate.CourtPlaced = Text_Slice(Candidate.Name, 0, 10) = "Neris Town"

    If Version >= 5 Then

        Candidate.CourtOffsetX = ReadPrecise()
        Candidate.CourtOffsetZ = ReadPrecise()
        Flag = ReadByte()
        Candidate.CourtPlaced = Flag = 1
        Valid = Valid And Flag <= 1

    End If

    Candidate.Surface.Curves.BrushCount = 0

    If Version >= 6 Then

        Candidate.Surface.Curves.BrushCount = ReadInteger()

        If (Candidate.Surface.Curves.BrushCount < 0 Or
            Candidate.Surface.Curves.BrushCount > Paint.MAX_BRUSHES) Then
            Return False
        End If

        If Candidate.Surface.Curves.BrushCount > 0 Then

            For Index = 0 To Candidate.Surface.Curves.BrushCount - 1

                Candidate.Surface.Curves.Brushes[Index].Form = ReadInteger()
                Candidate.Surface.Curves.Brushes[Index].Surface = ReadInteger()
                Candidate.Surface.Curves.Brushes[Index].X0 = ReadPrecise()
                Candidate.Surface.Curves.Brushes[Index].Z0 = ReadPrecise()
                Candidate.Surface.Curves.Brushes[Index].X1 = ReadPrecise()
                Candidate.Surface.Curves.Brushes[Index].Z1 = ReadPrecise()
                Candidate.Surface.Curves.Brushes[Index].Width = ReadPrecise()
                Candidate.Surface.Curves.Brushes[Index].X2 = 0.0
                Candidate.Surface.Curves.Brushes[Index].Z2 = 0.0
                Candidate.Surface.Curves.Brushes[Index].WaterMode = 0
                Candidate.Surface.Curves.Brushes[Index].FlowSign = 0
                Candidate.Surface.Curves.Brushes[Index].FlowSpeed = 0

                If (Version >= 9 And
                    Candidate.Surface.Curves.Brushes[Index].Form >= Paint.FORM_TRIANGLE) Then
                    Candidate.Surface.Curves.Brushes[Index].X2 = ReadPrecise()
                    Candidate.Surface.Curves.Brushes[Index].Z2 = ReadPrecise()
                End If

                If (Not Paint.Valid(Candidate.Surface.Curves.Brushes[Index]) Or
                    (Version < 9 And Candidate.Surface.Curves.Brushes[Index].Form >= Paint.FORM_TRIANGLE) Or
                    (Version < 8 And Candidate.Surface.Curves.Brushes[Index].Form >= Paint.FORM_FILLET)) Then
                    Return False
                End If

            End For

        End If

    End If

    Candidate.TerrainStyle = 0

    If Version >= 7 Then
        Candidate.TerrainStyle = ReadByte()
        Valid = Valid And Candidate.TerrainStyle <= 3
    End If

    If Version >= 10 Then
        Candidate.Landmark = ReadByte()
        Valid = Valid And Candidate.Landmark <= Document.LANDMARK_HORIZON
    End If

    If Version >= 11 Then
        Valid = ReadTerrain(Candidate.Surface) And Valid
    End If

    If Version >= 12 Then
        Valid = ReadAppearance(Candidate.Appearance, Candidate.Surface.Columns * Candidate.Surface.Rows) And Valid
    End If

    If Offset <> ByteCount Then
        Return False
    End If

    Return Valid

End Function

Public Function SaveDocument(ByRef Value As Document.State, Key As Text,
    Optional MarkSaved As Boolean = True) As Boolean

    Dim Status As Number

    Call Encode(Value, MarkSaved)

    If Not Valid Then
        Return False
    End If

    Save Data Bytes Count ByteCount To Key Status Status

    If Status <> DATA_STATUS_OK Then
        Return False
    End If

    If MarkSaved Then
        Value.SavedRevision = Value.Revision
    End If

    Return True

End Function

''' Exact serialized content check for disposable caches; revisions are not persisted.
Public Function MatchesDocument(ByRef Value As Document.State, Key As Text) As Boolean

    Dim Status As Number
    Dim Length As Number
    Dim Index As Number

    Call Encode(Value, False)

    If Not Valid Then
        Return False
    End If

    Load Data Key Into Comparison Count Length Status Status

    If Status <> DATA_STATUS_OK Or Length <> ByteCount Then
        Return False
    End If

    For Index = 0 To ByteCount - 1

        If Bytes[Index] <> Comparison[Index] Then
            Return False
        End If

    End For

    Return True

End Function

Public Function LoadDocument(ByRef Value As Document.State, Key As Text,
    Optional PreserveDirty As Boolean = False) As Boolean

    Dim Status As Number
    Dim Revision As Number
    Dim WasDirty As Boolean

    Load Data Key Into Bytes Count ByteCount Status Status

    If Status <> DATA_STATUS_OK Or Not Decode() Then
        Return False
    End If

    Revision = Value.Revision + 1
    WasDirty = Candidate.SavedRevision = 1
    Value = Candidate
    Value.Revision = Revision
    Value.SavedRevision = Revision
    Value.Surface.Revision = Revision

    If PreserveDirty And WasDirty Then
        Value.SavedRevision = -1
    End If

    Return True

End Function

Public Function Exists(Key As Text) As Boolean

    Dim Status As Number
    Dim Result As Boolean

    Load Data Key Into Bytes Count ByteCount Status Status
    Result = Status = DATA_STATUS_OK

    Return Result

End Function

''' One atomic request contains the complete document and an integral operation/id trailer.
Public Function QueueBlender(ByRef Value As Document.State, Mode As Number) As Number

    Dim RequestId As Number
    Dim Status As Number
    Dim Ok As Boolean

    If Not Document.SupportsBlender(Value) Then
        Return 0
    End If

    Ok = SaveDocument(Value, "TownEditor.PendingBlender", False)

    If Not Ok Then
        Return 0
    End If

    Load RequestId From "TownEditor.BlenderSequence" Default 0
    RequestId = RequestId + 1
    Save RequestId To "TownEditor.BlenderSequence"

    Call Encode(Value, True)
    Call WriteInteger(Mode)
    Call WriteInteger(RequestId)

    ByteCount = Offset

    If Not Valid Then
        Return 0
    End If

    Save Data Bytes Count ByteCount To "TownEditor.Blender.Request" Status Status

    If Status <> DATA_STATUS_OK Then
        Return 0
    End If

    Return RequestId

End Function

Public Function ReadBridgeStatus(Optional Key As Text = "TownEditor.Blender.Response") As BridgeStatus

    Dim Result As BridgeStatus
    Dim Status As Number

    Load Data Key Into Bytes Count ByteCount Status Status

    If Status <> DATA_STATUS_OK Then
        Return Result
    End If

    Offset = 0
    Valid = True

    If (ReadByte() <> 84 Or
        ReadByte() <> 87 Or
        ReadByte() <> 82 Or
        ReadByte() <> 1) Then
        Return Result
    End If

    Result.RequestId = ReadInteger()
    Result.Status = ReadInteger()
    Result.Progress = ReadInteger()
    Result.Message = ReadName()

    If Not Valid Or Offset <> ByteCount Then
        Result.RequestId = 0
    End If

    Return Result

End Function

End Module
