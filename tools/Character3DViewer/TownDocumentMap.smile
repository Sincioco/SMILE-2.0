''' Small committed document map. Rebuilt on edits, independently of the 3D renderer.
Module Smile.Tools.TownDocumentMap

Option Explicit

Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.SurfaceGrid3D As Grid
Import Smile.Tools.TownDocument As Document
Import Smile.Tools.TownCatalogData As Catalog
Import Smile.Tools.TownEditorPanel As Panel
Import Smile.Tools.NerisTownMap As Heading

Private Dim Cells[64, 64] As Number
Private Dim Revision As Number

Public Function Hovered() As Boolean

    Dim Result As Boolean

    Result = (Pointer_X() >= Window_Width() - 276 And Pointer_X() < Window_Width() - 20 And
        Pointer_Y() >= 155 And Pointer_Y() < 411)

    Return Result

End Function

Public Function Pick(ByRef Town As Document.State, X As Number, Y As Number) As P.Vector3

    Dim Result As P.Vector3

    Result = P.Vector(Town.Surface.OriginX + ToDouble(X - Window_Width() + 276) / 256.0 *
        (Town.Surface.XEdges[Town.Surface.Columns] - Town.Surface.OriginX), 23.12,
        Town.Surface.OriginZ + ToDouble(411 - Y) / 256.0 *
        (Town.Surface.ZEdges[Town.Surface.Rows] - Town.Surface.OriginZ))

    Return Result

End Function

Public Sub DrawDestination(ByRef Town As Document.State, Destination As P.Vector3,
    Active As Boolean, Message As Text)

    Dim X As Number
    Dim Y As Number

    If Active Then

        X = Window_Width() - 276 + Coordinate(Destination.X, Town.Surface.OriginX,
            Town.Surface.XEdges[Town.Surface.Columns]) * 4
        Y = 155 + (63 - Coordinate(Destination.Z, Town.Surface.OriginZ,
            Town.Surface.ZEdges[Town.Surface.Rows])) * 4

        Draw Rectangle X - 5, Y - 5, 11, 11, YELLOW
        Draw Line X - 8, Y, X + 8, Y, YELLOW
        Draw Line X, Y - 8, X, Y + 8, YELLOW

    End If

    If Message <> "" Then

        Fill Rectangle Window_Width() - 282, 429, 268, 38, RGB(10, 22, 35)
        Draw Text Text_Slice(Message, 0, 38) At Window_Width() - 276, 433 Size 11 Color YELLOW
        Draw Text Text_Slice(Message, 38, 38) At Window_Width() - 276, 449 Size 11 Color YELLOW

    End If

End Sub

Private Function Coordinate(Value As Double, Low As Double, High As Double) As Number

    Dim Result As Number

    Result = ToNumber(Clamp((Value - Low) * 64.0 / Max(1.0, High - Low), 0.0, 63.0))

    Return Result

End Function

Private Sub Rebuild(ByRef Town As Document.State)

    Dim X As Number
    Dim Z As Number
    Dim MX As Number
    Dim MZ As Number
    Dim SX As Number
    Dim SZ As Number
    Dim EX As Number
    Dim EZ As Number
    Dim Surface As Number

    For Z = 0 To 63

        For X = 0 To 63
            Cells[X, Z] = 0
        End For
    End For

    For Z = 0 To Town.Surface.Rows - 1

        SZ = Coordinate(Town.Surface.ZEdges[Z], Town.Surface.OriginZ, Town.Surface.ZEdges[Town.Surface.Rows])
        EZ = Coordinate(Town.Surface.ZEdges[Z + 1], Town.Surface.OriginZ, Town.Surface.ZEdges[Town.Surface.Rows])

        For X = 0 To Town.Surface.Columns - 1

            Surface = Grid.ReadCell(Town.Surface, X, Z)
            SX = Coordinate(Town.Surface.XEdges[X], Town.Surface.OriginX, Town.Surface.XEdges[Town.Surface.Columns])
            EX = Coordinate(Town.Surface.XEdges[X + 1], Town.Surface.OriginX, Town.Surface.XEdges[Town.Surface.Columns])

            For MZ = SZ To EZ

                For MX = SX To EX
                    Cells[MX, MZ] = Max(Cells[MX, MZ], Surface)
                End For
            End For
        End For
    End For

    Revision = Town.Revision

End Sub

Public Sub Draw(ByRef Town As Document.State, Position As P.Vector3,
    Opacity As Number, LeaderName As Text, LandmarkName As Text, LandmarkPosition As P.Vector3,
    AirportName As Text, AirportPosition As P.Vector3, Headlight As Image, Yaw As Double)

    Dim X As Number
    Dim Z As Number
    Dim StartX As Number
    Dim Kind As Number
    Dim ColorValue As Number
    Dim MapLeft As Number
    Dim Index As Number
    Dim Shape As Catalog.Template

    If Opacity <= 0 Then
        Return
    End If

    If Revision <> Town.Revision Then
        Call Rebuild(Town)
    End If

    MapLeft = Window_Width() - 276
    Fill Rectangle MapLeft - 6, 133, 268, 294, RGB(10, 22, 35) Opacity Opacity
    Draw Text Text_Slice(Town.Name, 0, 28) At MapLeft, 139 Size 12 Color WHITE

    For Z = 0 To 63

        X = 0

        Do
            StartX = X
            Kind = Cells[X, Z]

            Do
                X = X + 1

            Loop Until X >= 64 Or Cells[X, Z] <> Kind

            ColorValue = RGB(35, 77, 37)

            If Kind = 2 Then
                ColorValue = RGB(12, 54, 103)
            Else If Kind >= 3 Then
                ColorValue = RGB(123, 147, 158)
            End If

            Fill Rectangle MapLeft + StartX * 4, 155 + (63 - Z) * 4, (X - StartX) * 4, 4, ColorValue Opacity Opacity

        Loop Until X >= 64

    End For

    For Index = 0 To Town.ItemCount - 1

        If (Town.Items[Index].Active And
            Town.Items[Index].Category = Document.CATEGORY_BUILDINGS) Then

            X = Coordinate(Town.Items[Index].Position.X, Town.Surface.OriginX, Town.Surface.XEdges[Town.Surface.Columns])
            Z = Coordinate(Town.Items[Index].Position.Z, Town.Surface.OriginZ, Town.Surface.ZEdges[Town.Surface.Rows])
            Fill Rectangle MapLeft + X * 4 - 3, 155 + (63 - Z) * 4 - 3, 7, 7, RGB(226, 200, 133) Opacity Opacity
            Shape = Catalog.TemplateAt(Town.Items[Index].Template)

            If (Shape.Label = "City Hall" Or
                Shape.Label = "Comm Tower" Or
                Shape.Label = "Old Castle" Or
                Shape.Label = "Royal Castle" Or
                Shape.Label = "Military HQ") Then
                Draw Text Shape.Label At MapLeft + X * 4 - 24, 155 + (63 - Z) * 4 Size 9 Color WHITE
            End If

        End If

    End For

    Call DrawLandmark(Town, MapLeft, Opacity, LandmarkName, LandmarkPosition)
    Call DrawLandmark(Town, MapLeft, Opacity, AirportName, AirportPosition)

    X = Coordinate(Position.X, Town.Surface.OriginX, Town.Surface.XEdges[Town.Surface.Columns])
    Z = Coordinate(Position.Z, Town.Surface.OriginZ, Town.Surface.ZEdges[Town.Surface.Rows])

    Call Heading.DrawHeading(Headlight, MapLeft + X * 4, 155 + (63 - Z) * 4, Yaw, Opacity)

    Fill Rectangle MapLeft + X * 4 - 2, 155 + (63 - Z) * 4 - 2, 5, 5, CYAN
    Draw Text LeaderName + " X:" + Panel.NumberLabel(ToNumber(Position.X)) + " Y:" + Panel.NumberLabel(ToNumber(Position.Y)) + " Z:" + Panel.NumberLabel(ToNumber(Position.Z)) At MapLeft, 414 Size 11 Color WHITE

End Sub

Private Sub DrawLandmark(ByRef Town As Document.State, MapLeft As Number,
    Opacity As Number, Name As Text, Position As P.Vector3)

    Dim X As Number
    Dim Z As Number
    Dim LabelX As Number

    If Name = "" Then
        Return
    End If

    X = Coordinate(Position.X, Town.Surface.OriginX, Town.Surface.XEdges[Town.Surface.Columns])
    Z = Coordinate(Position.Z, Town.Surface.OriginZ, Town.Surface.ZEdges[Town.Surface.Rows])
    LabelX = ToNumber(Clamp(ToDouble(X * 4 - 24), 0.0, ToDouble(256 - Text_Length(Name) * 6)))
    Fill Rectangle MapLeft + X * 4 - 4, 155 + (63 - Z) * 4 - 4, 9, 9, RGB(226, 200, 133) Opacity Opacity
    Draw Text Name At MapLeft + LabelX, 155 + (63 - Z) * 4 + 7 Size 9 Color WHITE

End Sub

End Module
