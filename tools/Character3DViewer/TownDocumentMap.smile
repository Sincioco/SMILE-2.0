''' Small committed document map. Rebuilt on edits, independently of the 3D renderer.
Module Smile.Tools.TownDocumentMap

Option Explicit

Import Smile.Tools.TownSurfaceLayers As Layers
Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.SurfaceGrid3D As Grid
Import Smile.Simple3D.SurfacePaint3D As Paint
Import Smile.Tools.TownDocument As Document
Import Smile.Tools.TownCatalogData As Catalog
Import Smile.Tools.TownEditorPanel As Panel
Import Smile.Tools.NerisTownMap As Heading
Import Smile.Tools.TownRoadTravel As Travel
Import Smile.Tools.TownRoadStops As Stops
Import Smile.Tools.TownResidents As Residents
Import Smile.Tools.TownResidentDialogue As Dialogue

Private Dim Cells[256, 256] As Number
Private Dim PendingCells[256, 256] As Number
Private Dim BuildRow As Number
Private Dim BuildRevision As Number
Private Dim Building As Boolean
Private Dim Revision As Number
Private Dim ZoomLevel As Number
Private Dim MapName As Text
Private Dim LowX As Double
Private Dim HighX As Double
Private Dim LowZ As Double
Private Dim HighZ As Double

Public Sub SetZoom(ByRef Town As Document.State, Focus As P.Vector3, Level As Number)

    Dim Width As Double
    Dim Depth As Double

    ZoomLevel = Max(1, Min(8, Level))
    Width = (Town.Surface.XEdges[Town.Surface.Columns] - Town.Surface.OriginX) / ToDouble(ZoomLevel)
    Depth = (Town.Surface.ZEdges[Town.Surface.Rows] - Town.Surface.OriginZ) / ToDouble(ZoomLevel)
    LowX = Clamp(Focus.X - Width * 0.5, Town.Surface.OriginX, Town.Surface.XEdges[Town.Surface.Columns] - Width)
    LowZ = Clamp(Focus.Z - Depth * 0.5, Town.Surface.OriginZ, Town.Surface.ZEdges[Town.Surface.Rows] - Depth)
    HighX = LowX + Width
    HighZ = LowZ + Depth
    MapName = Town.Name
    Revision = -1
    Building = False

End Sub

''' Keep the world point beneath the cursor fixed while changing map scale.
Public Sub ZoomAt(ByRef Town As Document.State, X As Number, Y As Number, Level As Number)

    Dim Anchor As P.Vector3
    Dim Focus As P.Vector3
    Dim FractionX As Double
    Dim FractionZ As Double
    Dim Width As Double
    Dim Depth As Double

    X = Max(Window_Width() - 276, Min(Window_Width() - 20, X))
    Y = Max(259, Min(515, Y))
    Anchor = Pick(Town, X, Y)
    FractionX = ToDouble(X - Window_Width() + 276) / 256.0
    FractionZ = ToDouble(515 - Y) / 256.0
    Level = Max(1, Min(8, Level))
    Width = (Town.Surface.XEdges[Town.Surface.Columns] - Town.Surface.OriginX) / ToDouble(Level)
    Depth = (Town.Surface.ZEdges[Town.Surface.Rows] - Town.Surface.OriginZ) / ToDouble(Level)
    Focus = P.Vector(Anchor.X + Width * (0.5 - FractionX), 0.0, Anchor.Z + Depth * (0.5 - FractionZ))

    Call SetZoom(Town, Focus, Level)

End Sub

Public Function ZoomInput(ByRef Town As Document.State) As Boolean

    Dim Change As Number

    Change = Pointer_Wheel_Delta()

    If Pointer_Y() < 259 And Pointer_Pressed(POINTER_PRIMARY) Then

        If Pointer_X() >= Window_Width() - 52 Then
            Change = 1
        Else If Pointer_X() >= Window_Width() - 84 Then
            Change = -1
        End If

        If Change = 0 Then
            Return True
        End If

    End If

    If Change <> 0 Then

        If Change > 0 Then
            Call ZoomAt(Town, Pointer_X(), Pointer_Y(), Max(1, ZoomLevel) * 2)
        Else

            Call ZoomAt(Town, Pointer_X(), Pointer_Y(), Max(1, ZoomLevel / 2))
        End If

        Return True

    End If

    Return False

End Function

Public Sub Pan(ByRef Town As Document.State, DeltaX As Number, DeltaY As Number)

    Dim Width As Double
    Dim Depth As Double
    Dim FocusX As Double
    Dim FocusZ As Double

    Width = HighX - LowX
    Depth = HighZ - LowZ
    FocusX = Clamp((LowX + HighX) * 0.5 - ToDouble(DeltaX) * Width / 256.0,
        Town.Surface.OriginX, Town.Surface.XEdges[Town.Surface.Columns])
    FocusZ = Clamp((LowZ + HighZ) * 0.5 + ToDouble(DeltaY) * Depth / 256.0,
        Town.Surface.OriginZ, Town.Surface.ZEdges[Town.Surface.Rows])
    LowX = FocusX - Width * 0.5
    HighX = FocusX + Width * 0.5
    LowZ = FocusZ - Depth * 0.5
    HighZ = FocusZ + Depth * 0.5
    Revision = -1
    Building = False

End Sub

Private Function Inside(Point As P.Vector3) As Boolean

    Dim Result As Boolean

    Result = Point.X >= LowX And Point.X <= HighX And Point.Z >= LowZ And Point.Z <= HighZ

    Return Result

End Function

Public Function Hovered() As Boolean

    Dim Result As Boolean

    Result = (Pointer_X() >= Window_Width() - 276 And Pointer_X() < Window_Width() - 20 And
        Pointer_Y() >= 237 And Pointer_Y() < 515)

    Return Result

End Function

Public Function Pick(ByRef Town As Document.State, X As Number, Y As Number) As P.Vector3

    Dim Result As P.Vector3

    Result = P.Vector(LowX + ToDouble(X - Window_Width() + 276) / 256.0 *
        (HighX - LowX), Layers.ROAD_Y,
        LowZ + ToDouble(515 - Y) / 256.0 *
        (HighZ - LowZ))

    Return Result

End Function

Public Sub DrawResidents(ByRef Value As Residents.State, Opacity As Number)

    Dim Index As Number
    Dim ColorValue As Number

    If Not Value.Enabled Or Opacity <= 0 Then
        Return
    End If

    Draw Text "NPCs" At Window_Width() - 156, 243 Size 11 Color RGB(110, 255, 155)

    For Index = 0 To Value.Loaded - 1

        If Value.People[Index].Ready Then

            ColorValue = RGB(110, 255, 155)

            If Index = 8 Then
                ColorValue = RGB(255, 181, 80)
            End If

            Call DrawResident(Value.People[Index].Motion.Position, Dialogue.NameAt(Index), ColorValue, Opacity)

        End If

    End For

End Sub

Private Sub DrawResident(Position As P.Vector3, Name As Text, ColorValue As Number, Opacity As Number)

    Dim X As Number
    Dim Y As Number
    Dim LabelX As Number

    If Not Inside(Position) Or Opacity <= 0 Then
        Return
    End If

    X = Window_Width() - 276 + ToNumber((Position.X - LowX) * 255.0 / (HighX - LowX))
    Y = 514 - ToNumber((Position.Z - LowZ) * 255.0 / (HighZ - LowZ))

    Clip Rectangle Window_Width() - 276, 259, 256, 256
    Fill Circle X, Y, 4, BLACK
    Fill Circle X, Y, 3, ColorValue

    If Abs(Pointer_X() - X) <= 6 And Abs(Pointer_Y() - Y) <= 6 Then

        LabelX = Min(X + 8, Window_Width() - 80)
        Fill Rectangle LabelX - 2, Y - 17, 60, 16, RGB(10, 22, 35)
        Draw Text Name At LabelX, Y - 16 Size 12 Color WHITE

    End If

    End Clip

End Sub

Public Sub DrawDestination(ByRef Town As Document.State, Destination As P.Vector3,
    Active As Boolean, Message As Text, Optional StatusY As Number = 533)

    Dim X As Number
    Dim Y As Number
    Dim Index As Number
    Dim Point As P.Vector3
    Dim SplitAt As Number

    If Active And Inside(Destination) Then

        X = Window_Width() - 276 + Coordinate(Destination.X, LowX,
            HighX) * 4
        Y = 259 + (63 - Coordinate(Destination.Z, LowZ,
            HighZ)) * 4

        Draw Rectangle X - 5, Y - 5, 11, 11, YELLOW
        Draw Line X - 8, Y, X + 8, Y, YELLOW
        Draw Line X, Y - 8, X, Y + 8, YELLOW
        Draw Text "1" At X + 8, Y - 12 Size 11 Color YELLOW

    End If

    If Active Then

        For Index = 0 To Stops.Size() - 1

            Point = Stops.Point(Index)

            If Inside(Point) Then

                X = Window_Width() - 276 + Coordinate(Point.X, LowX, HighX) * 4
                Y = 259 + (63 - Coordinate(Point.Z, LowZ, HighZ)) * 4
                Fill Rectangle X - 3, Y - 3, 7, 7, WHITE
                Draw Text Panel.NumberLabel(Index + 2) At X + 6, Y - 12 Size 11 Color WHITE

            End If

        End For

    End If

    If Message <> "" Then

        SplitAt = Min(38, Text_Length(Message))

        If Text_Length(Message) > 38 Then

            For Index = 0 To 37

                If Text_Slice(Message, Index, 1) = " " Then
                    SplitAt = Index
                End If

            End For

        End If

        Fill Rectangle Window_Width() - 282, StatusY, 268, 38, RGB(10, 22, 35)
        Draw Text Text_Slice(Message, 0, SplitAt) At Window_Width() - 276, StatusY + 4 Size 11 Color YELLOW
        Draw Text Text_Slice(Message, SplitAt + 1, 38) At Window_Width() - 276, StatusY + 20 Size 11 Color YELLOW

    End If

End Sub

Private Function Coordinate(Value As Double, Low As Double, High As Double) As Number

    Dim Result As Number

    Result = ToNumber(Clamp((Value - Low) * 64.0 / Max(1.0, High - Low), 0.0, 63.0))

    Return Result

End Function

Private Sub DrawRoute(Leader As P.Vector3, MapLeft As Number)

    Dim Index As Number
    Dim Point As P.Vector3
    Dim X As Number
    Dim Y As Number
    Dim NextX As Number
    Dim NextY As Number
    Dim ColorValue As Number

    ColorValue = RGB(40, 225, 255)
    X = MapLeft + ToNumber((Leader.X - LowX) * 256.0 / Max(1.0, HighX - LowX))
    Y = 515 - ToNumber((Leader.Z - LowZ) * 256.0 / Max(1.0, HighZ - LowZ))

    For Index = 0 To Travel.RouteCount() - 1

        Point = Travel.RoutePoint(Index)
        NextX = MapLeft + ToNumber((Point.X - LowX) * 256.0 / Max(1.0, HighX - LowX))
        NextY = 515 - ToNumber((Point.Z - LowZ) * 256.0 / Max(1.0, HighZ - LowZ))

        If NextX <> X Or NextY <> Y Then

            Draw Line X - 1, Y, NextX - 1, NextY, ColorValue
            Draw Line X + 1, Y, NextX + 1, NextY, ColorValue
            Draw Line X, Y - 1, NextX, NextY - 1, ColorValue
            Draw Line X, Y + 1, NextX, NextY + 1, ColorValue
            Draw Line X, Y, NextX, NextY, ColorValue

        End If

        X = NextX
        Y = NextY
    End For

End Sub

''' Four analytic samples per display pixel. Publish only the finished cache.
Private Sub Rebuild(ByRef Town As Document.State)

    Dim X As Number
    Dim Z As Number
    Dim Sample As Number
    Dim Kind As Number
    Dim RedValue As Number
    Dim GreenValue As Number
    Dim BlueValue As Number
    Dim WX As Double
    Dim WZ As Double
    Dim Region As Paint.State

    If Not Building Or BuildRevision <> Town.Revision Then

        BuildRow = 0
        BuildRevision = Town.Revision
        Building = True

    End If

    For Z = BuildRow To Min(255, BuildRow + 7)

        Call Paint.SelectRegion(Town.Surface.Curves, Region, LowX,
            LowZ + ToDouble(Z) * (HighZ - LowZ) / 256.0, HighX,
            LowZ + ToDouble(Z + 1) * (HighZ - LowZ) / 256.0)

        For X = 0 To 255

            RedValue = 0
            GreenValue = 0
            BlueValue = 0

            For Sample = 0 To 3

                WX = LowX + (ToDouble(X) + 0.25 + ToDouble(Sample Mod 2) * 0.5) * (HighX - LowX) / 256.0
                WZ = LowZ + (ToDouble(Z) + 0.25 + ToDouble(Sample / 2) * 0.5) * (HighZ - LowZ) / 256.0
                Kind = Grid.ReadBase(Town.Surface, Grid.CellX(Town.Surface, WX), Grid.CellZ(Town.Surface, WZ))
                Kind = Paint.Resolve(Region, WX, WZ, Kind)
                ' Accumulate channels directly; packed-color byte order is runtime-owned.

                If Kind = 0 Then

                    RedValue = RedValue + 10
                    GreenValue = GreenValue + 22
                    BlueValue = BlueValue + 35

                Else If Kind = 2 Then

                    RedValue = RedValue + 12
                    GreenValue = GreenValue + 54
                    BlueValue = BlueValue + 103

                Else If Kind >= 3 Then

                    RedValue = RedValue + 123
                    GreenValue = GreenValue + 147
                    BlueValue = BlueValue + 158

                Else

                    RedValue = RedValue + 35
                    GreenValue = GreenValue + 77
                    BlueValue = BlueValue + 37

                End If

            End For

            PendingCells[X, Z] = RGB(RedValue / 4, GreenValue / 4, BlueValue / 4)
        End For
    End For

    BuildRow = BuildRow + 8

    If BuildRow >= 256 Then

        For Z = 0 To 255

            For X = 0 To 255
                Cells[X, Z] = PendingCells[X, Z]
            End For
        End For

        Revision = Town.Revision
        Building = False

    End If

End Sub

Public Sub Draw(ByRef Town As Document.State, Position As P.Vector3,
    Opacity As Number, LeaderName As Text, LandmarkName As Text, LandmarkPosition As P.Vector3,
    AirportName As Text, AirportPosition As P.Vector3, Headlight As Image, Yaw As Double)

    Dim X As Number
    Dim Z As Number
    Dim StartX As Number
    Dim Kind As Number
    Dim MapLeft As Number
    Dim Index As Number
    Dim Shape As Catalog.Template

    If Opacity <= 0 Then
        Return
    End If

    If MapName <> Town.Name Or ZoomLevel = 0 Then
        Call SetZoom(Town, Position, 1)
    End If

    If Revision <> Town.Revision Then

        If Revision >= 0 And Not Building Then
            Call SetZoom(Town, P.Vector((LowX + HighX) * 0.5, 0.0, (LowZ + HighZ) * 0.5), Max(1, ZoomLevel))
        End If

        Call Rebuild(Town)

    End If

    MapLeft = Window_Width() - 276
    Fill Rectangle MapLeft - 6, 237, 268, 294, RGB(10, 22, 35) Opacity Opacity
    Draw Text Text_Slice(Town.Name, 0, 21) At MapLeft, 243 Size 12 Color WHITE

    Fill Rectangle MapLeft + 192, 239, 28, 18, RGB(25, 70, 85)
    Fill Rectangle MapLeft + 224, 239, 28, 18, RGB(25, 70, 85)
    Draw Text "-" At MapLeft + 201, 240 Size 14 Color WHITE
    Draw Text "+" At MapLeft + 233, 240 Size 14 Color WHITE

    Clip Rectangle MapLeft, 259, 256, 256

    For Z = 0 To 255

        X = 0

        Do
            StartX = X
            Kind = Cells[X, Z]

            Do
                X = X + 1

            Loop Until X >= 256 Or Cells[X, Z] <> Kind

            Fill Rectangle MapLeft + StartX, 259 + (255 - Z), X - StartX, 1, Kind Opacity Opacity

        Loop Until X >= 256

    End For

    For Index = 0 To Town.ItemCount - 1

        If (Town.Items[Index].Active And
            Town.Items[Index].Category = Document.CATEGORY_BUILDINGS And
            Inside(Town.Items[Index].Position)) Then

            X = Coordinate(Town.Items[Index].Position.X, LowX, HighX)
            Z = Coordinate(Town.Items[Index].Position.Z, LowZ, HighZ)
            Fill Rectangle MapLeft + X * 4 - 3, 259 + (63 - Z) * 4 - 3, 7, 7, RGB(226, 200, 237) Opacity Opacity
            Shape = Catalog.TemplateAt(Town.Items[Index].Template)

            If (Shape.Label = "City Hall" Or
                Shape.Label = "Comm Tower" Or
                Shape.Label = "Old Castle" Or
                Shape.Label = "Royal Castle" Or
                Shape.Label = "Military HQ") Then
                Draw Text Shape.Label At MapLeft + X * 4 - 24, 259 + (63 - Z) * 4 Size 9 Color WHITE
            End If

        End If

    End For

    Call DrawLandmark(Town, MapLeft, Opacity, LandmarkName, LandmarkPosition)
    Call DrawLandmark(Town, MapLeft, Opacity, AirportName, AirportPosition)
    Call DrawRoute(Position, MapLeft)

    If Inside(Position) Then

        X = Coordinate(Position.X, LowX, HighX)
        Z = Coordinate(Position.Z, LowZ, HighZ)

        Call Heading.DrawHeading(Headlight, MapLeft + X * 4, 259 + (63 - Z) * 4, Yaw, Opacity)

        Fill Rectangle MapLeft + X * 4 - 2, 259 + (63 - Z) * 4 - 2, 5, 5, CYAN

    End If

    End Clip

    Draw Text LeaderName + " X:" + Panel.NumberLabel(ToNumber(Position.X)) + " Y:" + Panel.NumberLabel(ToNumber(Position.Y)) + " Z:" + Panel.NumberLabel(ToNumber(Position.Z)) At MapLeft, 518 Size 11 Color WHITE

End Sub

Private Sub DrawLandmark(ByRef Town As Document.State, MapLeft As Number,
    Opacity As Number, Name As Text, Position As P.Vector3)

    Dim X As Number
    Dim Z As Number
    Dim LabelX As Number

    If Name = "" Or Not Inside(Position) Then
        Return
    End If

    X = Coordinate(Position.X, LowX, HighX)
    Z = Coordinate(Position.Z, LowZ, HighZ)
    LabelX = ToNumber(Clamp(ToDouble(X * 4 - 24), 0.0, ToDouble(256 - Text_Length(Name) * 6)))
    Fill Rectangle MapLeft + X * 4 - 4, 259 + (63 - Z) * 4 - 4, 9, 9, RGB(226, 200, 237) Opacity Opacity
    Draw Text Name At MapLeft + LabelX, 259 + (63 - Z) * 4 + 7 Size 9 Color WHITE

End Sub

End Module
