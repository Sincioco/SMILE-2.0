''' Document-owned sun settings applied through the shared renderer.
Module Smile.Tools.TownLighting

Option Explicit

Import Smile.Simple3D.Graphics3D As G
Import Smile.Simple3D.Scene3D As Scene
Import Smile.Simple3D.PrecisionMath3D As M
Import Smile.Simple3D.Precision3D As P
Import Smile.Tools.TownDocument As Document
Import Smile.Tools.TownCatalogData As Catalog
Import Smile.Tools.TownGeometry As Geometry
Import Smile.Tools.NerisHorizonLighting As Horizon
Import Smile.Tools.NerisSpaceportGlow As Spaceport

''' Demo lighting is presentation only; retain the authored document and thumbnail inputs.
Public Function DisplayedSun(ByRef Town As Document.State, Alternate As Boolean) As Document.Sun

    Dim Light As Document.Sun

    Light = Town.Light

    If Alternate Then

        If Town.Presets.NightActive Then

            Call Document.DefaultSun(Light)

            If Town.Presets.HasDay Then
                Light = Town.Presets.Day
            End If

        Else

            Call Document.NightSun(Light)

            If Town.Presets.HasNight Then
                Light = Town.Presets.Night
            End If

        End If

    End If

    Return Light

End Function

Public Function Apply(Light As Document.Sun) As Boolean

    Dim Azimuth As Double
    Dim Elevation As Double
    Dim Ok As Boolean

    Azimuth = M.Radians(Light.Azimuth)
    Elevation = M.Radians(Light.Elevation)
    Ok = G.ClearAdditionalLights3DChecked()
    Ok = G.SetAmbientLight3D(200, 215, 235, Light.Ambient) And Ok
    ' The native light/shadow vector points from the ground toward the sun.
    Ok = G.SetDirectionalLight3D(ToNumber(Sin(Azimuth) * Cos(Elevation) * 1000.0),
        ToNumber(Sin(Elevation) * 1000.0), ToNumber(Cos(Azimuth) * Cos(Elevation) * 1000.0),
        Light.RedValue, Light.GreenValue, Light.BlueValue, Light.Intensity) And Ok
    Ok = Scene.SetShadows(Light.Shadows And Light.ShadowOpacity <> 0) And Ok
    Ok = Scene.SetShadowOpacity(Light.ShadowOpacity) And Ok
    Ok = Scene.SetShadowBias(25, 60) And Ok

    Call Scene.UseCustomLighting()

    Return Ok

End Function

''' Slots 0-3 remain Royal Court's washes. Placed lights use the reported native capacity.
''' Recompute from the document so moved/deleted lamps cannot leave phantom lights.
Public Function ApplyLocal(ByRef Town As Document.State, Optional Intensity As Number = -1) As Boolean

    Dim Index As Number
    Dim Side As Number
    Dim Slot As Number
    Dim Capacity As Number
    Dim Item As Document.Item
    Dim Shape As Catalog.Template
    Dim Point As P.Vector3
    Dim Night As Double
    Dim Width As Double
    Dim Height As Double
    Dim Range As Double
    Dim Ok As Boolean

    If Intensity < 0 Then
        Intensity = Town.Light.Intensity
    End If

    Night = Clamp((180.0 - ToDouble(Intensity)) / 180.0, 0.0, 1.0)
    Slot = 4
    Capacity = G.MaximumLocalLightCount3D()
    Ok = True

    Ok = Horizon.Apply(Slot, Night) And Ok
    Ok = Spaceport.Apply(Slot, Night) And Ok

    For Index = 0 To Town.ItemCount - 1

        Item = Town.Items[Index]

        If Item.Active And (Night > 0.0 Or Item.Template = 39) Then

            Shape = Catalog.TemplateAt(Item.Template)
            Height = (Shape.High.Y - Shape.Low.Y) * Item.Scale.Y / 1000.0

            If Shape.Label = "Campfire" Then

                If Slot < Capacity Then
                    Point = Geometry.ToWorld(Item, P.Vector(0.0, 12.0, 0.0))
                    Ok = G.SetPointLight3D(Slot, ToNumber(Point.X), ToNumber(Point.Y), ToNumber(Point.Z),
                        255, 136, 48, ToNumber((95.0 + Night * 265.0) *
                        (0.96 + 0.04 * Sin(ToDouble(Timer() Mod 10000) * 0.009 + ToDouble(Item.Identity)))),
                        ToNumber(Max(60.0, Height * 5.0))) And Ok
                Else
                    Ok = False
                End If

                Slot = Slot + 1

            Else If Shape.Label = "Crystal Lamp" Then

                If Slot < Capacity Then
                    Point = Geometry.ToWorld(Item, P.Vector(0.0, Shape.High.Y * 0.82, 0.0))
                    Ok = G.SetPointLight3D(Slot, ToNumber(Point.X), ToNumber(Point.Y), ToNumber(Point.Z),
                        255, 211, 150, ToNumber(Night * 280.0), ToNumber(Max(100.0, Height * 3.5))) And Ok
                Else
                    Ok = False
                End If

                Slot = Slot + 1

            Else If (Shape.Label = "Royal Castle" Or
                Shape.Label = "Military HQ" Or
                Shape.Label = "Comm Tower" Or
                Shape.Label = "City Hall") Then

                Width = Shape.High.X - Shape.Low.X
                Range = Max(Height * 1.8, Width * Item.Scale.X / 1000.0 * 1.5)

                For Side = 0 To 1

                    If Slot < Capacity Then
                        Point = Geometry.ToWorld(Item, P.Vector((ToDouble(Side) * 2.0 - 1.0) * Width * 0.32,
                            Shape.Low.Y + (Shape.High.Y - Shape.Low.Y) * 0.28, Shape.Low.Z - Width * 0.08))
                        Ok = G.SetPointLight3D(Slot, ToNumber(Point.X), ToNumber(Point.Y), ToNumber(Point.Z),
                            255, 210, 157, ToNumber(Night * 380.0), ToNumber(Range)) And Ok
                    Else
                        Ok = False
                    End If

                    Slot = Slot + 1
                End For

            End If

        End If

    End For

    For Index = Slot To Capacity - 1
        Ok = G.DisableLight3D(Index) And Ok
    End For

    Return Ok

End Function

End Module
