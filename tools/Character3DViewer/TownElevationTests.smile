''' Terrain acceptance: shared immutable corners, canonical planes and clipped material geometry.
Module Smile.Tools.TownElevationTests

Option Explicit

Import Smile.Simple3D.SurfaceGrid3D As Grid
Import Smile.Simple3D.SurfacePaint3D As Paint
Import Smile.Simple3D.TerrainHeights3D As Heights
Import Smile.Simple3D.TerrainSurface3D As Terrain
Import Smile.Tools.TownSurfaceLayers As Layers
Import Smile.Tools.TownDocument As Document
Import Smile.Tools.TownTerrainBuilder As Builder
Import Smile.Tools.TownTerrainCache As Cache
Import Smile.Tools.TownDerivedCache As Derived
Import Smile.Tools.TownDocumentStore As Store

Private Dim Town As Document.State
Private Dim Snapshot As Grid.State
Private Dim Recipe As Builder.State
Private Dim Capacity As Heights.State
Private Dim Reopened As Document.State
Private Dim ReopenedRecipe As Cache.Batch

Private Sub Check(Condition As Boolean, Label As Text, ByRef Failures As Number)

    If Not Condition Then
        Print "FAIL Terrain " + Label
        Failures = Failures + 1
    End If

End Sub

Public Function Run() As Number

    Dim Failures As Number
    Dim Ok As Boolean
    Dim Sample As Terrain.Sample
    Dim Index As Number
    Dim Part As Cache.Patch
    Dim Brush As Paint.Brush
    Dim BaseY As Double
    Dim RoadCount As Number
    Dim GroundCount As Number
    Dim CurbArea As Double

    Call CheckCurvedWetSides(Failures)
    Call CheckFlatRoadSides(Failures)

    Ok = Grid.Initialize(Town.Surface, 1, 1, 0.0, 0.0, 1.0, Grid.SURFACE_GROUND)
    Snapshot = Town.Surface
    Sample = Terrain.SamplePoint(Town.Surface, 0.25, 0.75)

    Call Check(Ok And Sample.Supported And Sample.Offset = 0.0 And Sample.Normal.Y = 1.0,
        "Flat Legacy Displacement Is Zero", Failures)

    Ok = Terrain.SetCorner(Town.Surface, 1, 1, 2.0)
    Sample = Terrain.SamplePoint(Town.Surface, 0.25, 0.75)

    Call Check(Ok And Abs(Sample.Offset - 0.5) < 0.000001,
        "Canonical Triangle Returns 0.5 Not Bilinear 0.375", Failures)
    Call Check(Terrain.Corner(Snapshot, 1, 1) = 0.0 And
        Not Derived.SameSurface(Town.Surface, Snapshot), "Snapshot And Cache Identity", Failures)

    Sample = Terrain.SamplePoint(Town.Surface, 1.0, 1.0)

    Call Check(Sample.Supported And Sample.Offset = 2.0, "Far Boundary Shares Last Corner", Failures)

    Sample = Terrain.SamplePoint(Town.Surface, -0.001, 0.0)

    Call Check(Not Sample.Supported, "Outside Rejected", Failures)

    Snapshot = Town.Surface
    Ok = Terrain.SetCorner(Town.Surface, 0, 0, -1.23)

    Call Check(Ok And Abs(Terrain.Corner(Town.Surface, 0, 0) + 1.23) < 0.000001 And
        Terrain.Corner(Snapshot, 0, 0) = 0.0, "Negative Millimetre Height And Immutable Page", Failures)
    Call Check(Not Terrain.SetCorner(Town.Surface, 2, 0, 10.0) And
        Not Terrain.SetCorner(Town.Surface, 0, 0, 10000.01), "Bounds Rejected", Failures)

    Town.Surface = Snapshot
    Town.Surface.XEdges[1] = 10.0
    Town.Surface.ZEdges[1] = 30.0
    Sample = Terrain.SamplePoint(Town.Surface, 2.5, 22.5)

    Call Check(Terrain.Valid(Town.Surface) And Abs(Sample.Offset - 0.5) < 0.000001,
        "Nonuniform Physical Edges", Failures)

    Town.Surface.XEdges[1] = 0.0

    Call Check(Not Terrain.Valid(Town.Surface), "Non-Increasing Edge Rejected", Failures)

    Town.Surface = Snapshot
    Brush.Form = Paint.FORM_LINE
    Brush.Surface = Grid.SURFACE_ROAD
    Brush.X0 = 1.0
    Brush.Z0 = -1.0
    Brush.X1 = 1.0
    Brush.Z1 = 2.0
    Brush.Width = 1.0
    Ok = Grid.PaintBrush(Town.Surface, Brush)

    Call Builder.Begin(Recipe, Town)
    Call Builder.ScanRow(Recipe)
    Call Check(Ok And Not Recipe.Failed And Recipe.Buffer.PatchCount > 0,
        "Curved Material Recipe Generated", Failures)

    For Index = 0 To Recipe.Buffer.PatchCount - 1

        Part = Recipe.Buffer.Patches[Index]
        ' The clipped road is raised above grass. Its interior boundary
        ' must contain vertical faces, otherwise a low camera sees the backdrop.

        If (Part.Kind = Grid.SURFACE_ROAD And
            Part.Plane = 5 And
            Part.X0 > 0.001 And
            Part.X0 < 0.999 And
            Abs(Part.X0 - Part.X1) < 0.001 And
            Abs(Part.X0 - Part.X2) < 0.001 And
            Abs((Part.X1 - Part.X0) * (Part.Z2 - Part.Z0) -
                (Part.X2 - Part.X0) * (Part.Z1 - Part.Z0)) < 0.000000000001) Then
            CurbArea = CurbArea + Abs((Part.Z1 - Part.Z0) * (Part.Y2 - Part.Y0) -
                (Part.Z2 - Part.Z0) * (Part.Y1 - Part.Y0)) * 0.5
        End If

        If (Part.Kind = Grid.SURFACE_ROAD And
            Part.Plane = 4 And
            Part.X0 > 0.001 And
            Part.X0 < 0.999 And
            Abs(Part.X0 - Part.X1) < 0.001) Then
            CurbArea = CurbArea + Abs((Part.Z1 - Part.Z0) * (Part.Y1 - Part.Y0))
        End If

        BaseY = Layers.GROUND_Y

        If Part.Kind = Grid.SURFACE_ROAD Then
            BaseY = Layers.ROAD_Y
            RoadCount = RoadCount + 1
        Else If Part.Kind = Grid.SURFACE_GROUND Then
            GroundCount = GroundCount + 1
        End If

        If ((Part.Kind = Grid.SURFACE_GROUND Or Part.Kind = Grid.SURFACE_ROAD) And
            Part.Plane = 5 And
            Abs((Part.X1 - Part.X0) * (Part.Z2 - Part.Z0) -
                (Part.X2 - Part.X0) * (Part.Z1 - Part.Z0)) > 0.000001) Then
            Sample = Terrain.SamplePoint(Town.Surface, (Part.X0 + Part.X1 + Part.X2) / 3.0,
                (Part.Z0 + Part.Z1 + Part.Z2) / 3.0)

            Call Check(Part.Plane = 5 And Sample.Supported And
                Abs((Part.Y0 + Part.Y1 + Part.Y2) / 3.0 - BaseY - Sample.Offset) < 0.000001,
                "Every Clipped Face Agrees With The Canonical Surface", Failures)
        End If

    End For

    Call Check(RoadCount > 0 And GroundCount > 0, "Road And Ground Both Conform", Failures)
    Call Check(Abs(CurbArea - (Layers.ROAD_Y - Layers.GROUND_Y)) < 0.000001,
        "Raised Road Boundaries Are Sealed To Ground", Failures)

    Town.Name = "Terrain Round Trip"
    Town.Revision = 4
    Ok = Store.SaveDocument(Town, "Terrain.Phase5.Document")
    Ok = Store.LoadDocument(Reopened, "Terrain.Phase5.Document") And Ok

    Call Check(Ok And Derived.SameSurface(Town.Surface, Reopened.Surface),
        "TWN11 Preserves Heights And Curves", Failures)

    Ok = Cache.SaveBatch(Recipe.Buffer, "Terrain.Phase5.Cache", 0)
    Ok = Cache.LoadBatch(ReopenedRecipe, "Terrain.Phase5.Cache", 0) And Ok

    Call Check(Ok And ReopenedRecipe.PatchCount = Recipe.Buffer.PatchCount,
        "Terrain4 Preserves Triangle Recipes", Failures)

    For Index = 0 To Recipe.Buffer.PatchCount - 1
        Call Check(Abs(ReopenedRecipe.Patches[Index].Y2 - Recipe.Buffer.Patches[Index].Y2) < 0.000001,
            "Third Vertex Height Round Trips", Failures)
    End For

    Call Heights.Reset(Capacity, Heights.MAX_CORNERS)

    Ok = Heights.Write(Capacity, Heights.MAX_CORNERS - 1, -9999.99)

    Call Check(Ok And Abs(Heights.Read(Capacity, Heights.MAX_CORNERS - 1) + 9999.99) < 0.000001,
        "Last Bounded Corner Supported", Failures)
    Call Check(Not Heights.Write(Capacity, Heights.MAX_CORNERS, 1.0),
        "One Past Capacity Rejected", Failures)

    Ok = Heights.Write(Capacity, Heights.MAX_CORNERS - 1, 0.0)

    Call Check(Ok And Capacity.Nonzero = 0 And Text_Length(Capacity.Pages[1028]) = 0,
        "Returning To Zero Releases Its Page", Failures)

    Return Failures

End Function

Private Sub CheckCurvedWetSides(ByRef Failures As Number)

    Dim X As Number
    Dim Z As Number
    Dim Index As Number
    Dim Brush As Paint.Brush
    Dim Part As Cache.Patch
    Dim Walls As Number
    Dim Ok As Boolean
    Dim Area As Double

    Ok = Document.Blank(Town, "Curved Raised Road Over Water", 8, 8, 10.0)

    Call Grid.PaintRectangle(Town.Surface, 0, 0, 7, 7, Grid.SURFACE_WATER)

    For Z = 0 To 8

        For X = 0 To 8
            Ok = Terrain.SetCorner(Town.Surface, X, Z, 100.0) And Ok
        End For
    End For

    Brush.Form = Paint.FORM_CIRCLE
    Brush.Surface = Grid.SURFACE_ROAD
    Brush.X1 = 25.0
    Ok = Grid.PaintBrush(Town.Surface, Brush) And Ok

    Call Builder.Begin(Recipe, Town)

    For Z = 0 To 7
        Recipe.Row = Z

        Call Builder.ScanRow(Recipe)
    End For

    For Index = 0 To Recipe.Buffer.PatchCount - 1

        Part = Recipe.Buffer.Patches[Index]
        Area = Abs((Part.X1 - Part.X0) * (Part.Z2 - Part.Z0) -
            (Part.X2 - Part.X0) * (Part.Z1 - Part.Z0))

        If (Part.Kind = Grid.SURFACE_ROAD And
            (Part.Plane = 4 Or (Part.Plane = 5 And Area < 0.000001)) And
            Max(Part.Y0, Max(Part.Y1, Part.Y2)) >= 123.119 And
            Min(Part.Y0, Min(Part.Y1, Part.Y2)) < Layers.GROUND_Y) Then
            Walls = Walls + 1
        End If

    End For

    Call Check(Ok And Not Recipe.Failed And Walls >= 16,
        "Curved Raised Road Closes Wet Sides Even When Chord Midpoints Remain On Road", Failures)

End Sub

Private Sub CheckFlatRoadSides(ByRef Failures As Number)

    Dim Shape As Number
    Dim Z As Number
    Dim Index As Number
    Dim Walls As Number
    Dim Brush As Paint.Brush
    Dim Part As Cache.Patch
    Dim Ok As Boolean

    For Shape = 1 To 2

        Ok = Document.Blank(Town, "Flat Road Curbs", 8, 8, 10.0)
        Brush.Form = Paint.FORM_RECTANGLE
        Brush.Surface = Grid.SURFACE_ROAD
        Brush.X0 = -10.0
        Brush.Z0 = -40.0
        Brush.X1 = 10.0
        Brush.Z1 = 40.0

        If Shape = 2 Then

            Brush.Form = Paint.FORM_CIRCLE
            Brush.X0 = 0.0
            Brush.Z0 = 0.0
            Brush.X1 = 25.0
            Brush.Z1 = 0.0

        End If

        Ok = Grid.PaintBrush(Town.Surface, Brush) And Ok
        Walls = 0

        Call Builder.Begin(Recipe, Town)

        For Z = 0 To 7
            Recipe.Row = Z

            Call Builder.ScanRow(Recipe)
        End For

        For Index = 0 To Recipe.Buffer.PatchCount - 1

            Part = Recipe.Buffer.Patches[Index]

            If (Part.Kind = Grid.SURFACE_ROAD And
                Part.Plane = 4 And
                Abs(Part.Y0 - Layers.GROUND_Y) < 0.000001 And
                Abs(Part.Y1 - Layers.ROAD_Y) < 0.000001) Then
                Walls = Walls + 1
            End If

        End For

        Call Check(Ok And Not Recipe.Failed And Walls >= 8,
            "Flat Curved And Cell-Aligned Roads Seal Blue Underlay At Ground Edges", Failures)
    End For

End Sub

End Module
