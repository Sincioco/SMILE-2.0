''' Single active town document, retained across Viewer tabs; delegates editing and rendering.
Module Smile.Tools.TownEditorSession

Option Explicit

Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.Graphics3D As G
Import Smile.Tools.TownDocument As Document
Import Smile.Tools.TownCatalogData As Catalog
Import Smile.Tools.TownInitialSurface As Initial
Import Smile.Tools.TownEditor As Editor
Import Smile.Tools.TownSectionTools As SectionTools
Import Smile.Tools.TownHistory As History
Import Smile.Tools.TownEditorPanel As Panel
Import Smile.Tools.TownCatalogRenderer As Renderer
Import Smile.Tools.TownSurfaceRenderer As Terrain
Import Smile.Tools.TownAttachments As Attachments
Import Smile.Tools.TownLighting As Lighting
Import Smile.Tools.TownDocumentNavigation As Navigation
Import Smile.Tools.TownDocumentStore As Storage
Import Smile.Tools.TownLibrary As Library
Import Smile.Tools.TownFileJobs As Files
Import Smile.Tools.TownFileDialog As FileDialog
Import Smile.Tools.TownFileLocations As FileLocations
Import Smile.Tools.TownGuideFiles As GuideFiles
Import Smile.Tools.TownMapLoads As MapLoads
Import Smile.Tools.TownTabs As Tabs
Import Smile.Tools.TownDocumentMap As Map
Import Smile.Tools.TownRoadTravel As RoadTravel
Import Smile.Simple3D.PrecisionMath3D As Math3D
Import Smile.Tools.TownWorldEditor As World
Import Smile.Tools.TownSelection As Selection
Import Smile.Simple3D.SurfaceGrid3D As Grid
Import Smile.Tools.NerisTownTour As Tour
Import Smile.Tools.NerisTownConnections As Connections
Import Smile.Simple3D.Arena3D As Arena

Private Dim Town As Document.State
Private Dim Transfers As Files.State
Private Dim MapLoadOccupied As Boolean
Private Dim MapLoadCooldown As Number
Private Dim OpenTabs As Tabs.State
Private Dim Incoming As Document.State
Private Dim Controls As Editor.State
Private Dim Assets As Renderer.State
Private Dim Ground As Terrain.State
Private Dim Details As Attachments.State
Private Dim AttemptedRecovery As Boolean
Private Dim HaveDocument As Boolean
Private Dim Ready As Boolean
Private Dim Prepared As Boolean
Private Dim AppliedRevision As Number
Private Dim RecoveryRevision As Number
Private Dim RecoveryClock As Number
Private Dim TeleportPending As Boolean
Private Dim TravelPending As Boolean
Private Dim TravelArrival As P.Vector3
Private Dim TabOverviewPending As Boolean
Private Dim LiveSurface As Grid.State

Public Function Available() As Boolean

    If Not AttemptedRecovery Then

        AttemptedRecovery = True
        HaveDocument = Library.Recover(Town)
        TeleportPending = HaveDocument
        TabOverviewPending = HaveDocument

        If HaveDocument Then
            Call Tabs.Ensure(OpenTabs, Town)
        End If

    End If

    Return HaveDocument

End Function

Public Sub BeginEditing()

    Dim Index As Number

    If Not HaveDocument Then

        Town.Name = "Neris Town"
        Town.CourtPlaced = True

        Call Initial.Populate(Town.Surface)
        Call Document.DefaultSun(Town.Light)

        Town.ItemCount = Catalog.INITIAL_ITEMS
        Town.NextIdentity = Town.ItemCount + 1

        For Index = 0 To Town.ItemCount - 1
            Town.Items[Index] = Catalog.InitialItem(Index)
        End For

        Town.Revision = 1
        Town.SavedRevision = 1
        HaveDocument = True

    End If

    Call Tabs.Ensure(OpenTabs, Town)
    Call Editor.Start(Controls)

End Sub

Public Function Editing() As Boolean

    Dim ReturnValue As Boolean

    ReturnValue = Controls.Enabled

    Return ReturnValue

End Function

Public Function MapHovered() As Boolean

    Dim Result As Boolean

    Result = Map.Hovered()

    Return Result

End Function

Public Function BeginRoadTrip(Leader As P.Vector3) As Boolean

    Dim Result As Boolean
    Dim Point As P.Vector3

    If Ground.Stage <> 0 Then
        Return False
    End If

    Point = Map.Pick(Town, Pointer_X(), Pointer_Y())
    Result = RoadTravel.Begin(Town, Leader, Point)

    Return Result

End Function

Public Function ZoomMinimap(Leader As P.Vector3) As Boolean

    Dim Result As Boolean

    Result = Map.ZoomInput(Town, Leader)

    Return Result

End Function

Public Function RoadDirection(Leader As P.Vector3, Distance As Double, Elapsed As Number) As P.Vector3

    Dim Result As P.Vector3

    If Controls.Enabled Then
        Call RoadTravel.Cancel()
    End If

    Result = RoadTravel.Direction(Town, Leader, Distance, Elapsed)

    Return Result

End Function

Public Function GestureActive() As Boolean

    Dim Result As Boolean

    Result = (Controls.Selected.Dragging Or Controls.MarkerGesture.Dragging Or
        Controls.CourtGesture.Dragging Or Controls.SectionGesture.Selecting Or
        Controls.SectionGesture.Dragging Or Controls.SectionGesture.Pending Or Controls.Rubber Or Controls.Anchored Or
        Controls.Ui.SunSlider.DragOwner > 0 Or World.Active())

    Return Result

End Function

Public Function CameraBlocked(Optional CameraControl As Boolean = False) As Boolean

    Dim Result As Boolean

    Result = (Files.BlocksEditing(Transfers) Or World.Active() Or Controls.Ui.SunSlider.DragOwner > 0 Or
        (Controls.Enabled And (Panel.Hovered() Or Pointer_Y() < 126 Or
        (Not CameraControl And ((Editor.CapturesMap(Controls) And Not Key_Held(KEY_SHIFT) And
        Pointer_Held(POINTER_PRIMARY)) Or GestureActive())))))

    Return Result

End Function

Public Function LoadNext() As Boolean

    Dim Ok As Boolean

    ' A previous document being ready must not publish this document's unfinished terrain.
    Ready = False

    Call Renderer.SyncDocument(Assets, Town)

    If Assets.Loaded < Assets.Required Then
        Call Renderer.LoadNext(Assets)

        Return False
    End If

    If Not Prepared Then

        Ok = Terrain.Create(Ground)
        Ok = Attachments.Create(Details) And Ok
        Ok = Lighting.Apply(Town.Light) And Ok
        Assets.Failed = Assets.Failed Or Not Ok
        Prepared = True

        Call Terrain.BeginBuild(Ground, Town.Surface)

    End If

    If Ground.PendingRevision <> Town.Surface.Revision Then
        Ready = False

        Call Terrain.BeginBuild(Ground, Town.Surface)
    End If

    Call Terrain.Update(Ground, 16)

    If (Ground.Stage = 0 And
        Not Ground.Failed And
        Not Assets.Failed) Then

        Ready = True
        AppliedRevision = Town.Revision
        RecoveryRevision = Town.Revision
        LiveSurface = Town.Surface

        Call Navigation.Rebuild(Town)

    End If

    Return Ready

End Function

Public Function HasTown(Name As Text) As Boolean

    Dim Index As Number

    For Index = 0 To OpenTabs.TabCount - 1

        If OpenTabs.Documents[Index].Name = Name Then
            Return True
        End If

    End For

    Return False

End Function

Public Function IsNight() As Boolean

    Dim Result As Boolean

    Result = Town.Presets.NightActive

    Return Result

End Function

Public Sub ToggleDayNight()

    Dim Action As Number
    Dim Ignored As Number

    Action = 222

    If IsNight() Then
        Action = 221
    End If

    Ignored = Editor.Command(Controls, Town, Action)

End Sub

Public Function TravelOnTile(Position As P.Vector3, Moving As Boolean) As Boolean

    Dim Name As Text
    Dim Ok As Boolean

    Name = MapLoads.DestinationAt(Town, Position.X, Position.Z)

    If Text_Length(Name) = 0 Then
        MapLoadOccupied = False
        Return False
    End If

    If (MapLoadOccupied Or
        Not Moving Or
        MapLoadCooldown > 0) Then
        Return False
    End If

    MapLoadOccupied = True
    Ok = Tabs.OpenNamed(OpenTabs, Town, Name)

    If Ok Then

        TeleportPending = True
        TravelPending = False
        TabOverviewPending = False
        MapLoadCooldown = 1500

        Call Editor.ResetDocument(Controls, Town)

    Else
        Controls.Ui.Message = "Could not load " + Name + "; current town retained."

    End If

    Return Ok

End Function

Public Function TravelTo(Name As Text, Arrival As P.Vector3) As Boolean

    Dim Ok As Boolean

    Ok = Tabs.OpenNamed(OpenTabs, Town, Name)

    If Ok Then

        TeleportPending = True
        TravelPending = True
        TravelArrival = Arrival

        Call Editor.ResetDocument(Controls, Town)

    End If

    Return Ok

End Function

Public Function Failed() As Boolean

    Dim Result As Boolean

    Result = Assets.Failed Or Ground.Failed

    Return Result

End Function

Public Function Progress() As Number

    Dim Result As Number

    Result = Assets.Loaded * 70 / Max(1, Assets.Required)

    If Prepared Then
        Result = 70 + Ground.Row * 20 / Max(1, Town.Surface.Rows)
    End If

    If Ground.Stage = 2 Then
        Result = 90 + Ground.Kind * 2
    End If

    If Ready Then
        Result = 100
    End If

    Return Result

End Function

Private Sub FileCommand(Action As Number)

    Dim Name As Text
    Dim Ok As Boolean
    Dim Mode As Number
    Dim OldName As Text

    If ((Transfers.RequestId > 0 Or Controls.GuideTransfer.Job > 0) And
        Action <> 309 And
        Action <> 311) Then
        Controls.Ui.Message = "A file operation is still running."
        Return
    End If

    If (Ground.Stage <> 0 And
        Action <> 309 And
        Action <> 311) Then
        Controls.Ui.Message = "Finishing terrain; try saving when ready."
        Return
    End If

    If (Action = 300 Or
        Action = 301 Or
        Action = 302 Or
        Action = 307 Or
        Action = 305) Then

        If ((Action = 305 Or Action = 307 Or Action = 302) And
            OpenTabs.TabCount >= Tabs.CAPACITY) Then
            Controls.Ui.Message = "Close a town tab first (limit 8)."
            Return
        End If

        Mode = Files.SAVE_VIEWER
        OldName = Town.Name

        If Action = 301 Then

            Mode = Files.SAVE_BLENDER

        Else If Action = 305 Then

            Mode = Files.OPEN_VIEWER

        Else If Action = 307 Then

            Mode = Files.OPEN_BLENDER

        Else If Action = 302 Then

            Name = Text_Prompt("Save For Viewer As", "Name the new town.", Town.Name + " Copy")

            If Not Document.ValidName(Name) Then
                Return
            End If

            If Name = "Neris Town" Or Storage.Exists("TownEditor.Town." + Name) Then
                Controls.Ui.Message = "Choose a new, unused town name."
                Return
            End If

            Town.Name = Name

        End If

        Call Files.Choose(Transfers, Town, Mode)

        Town.Name = OldName
        Transfers.OriginName = OldName
        Transfers.SaveAsCopy = Action = 302 And Transfers.RequestId > 0
        Controls.Ui.Message = Transfers.Message

    Else If Action = 312 Then

        Controls.Ui.Section = 5

    Else If Action >= 313 And Action <= 315 Then

        Name = "Neris Town"

        If Action = 314 Then
            Name = "Neris Spaceport"
        Else If Action = 315 Then
            Name = "Horizon Airport"
        End If

        Ok = Tabs.UpdatePermanent(OpenTabs, Town, Name)
        Controls.Ui.Message = OpenTabs.Message
        OpenTabs.Message = ""

        If Ok Then

            Call Editor.ResetHistory(Controls, Town)

            TeleportPending = True
            TabOverviewPending = True
            Controls.Ui.Section = 2

        End If

        Return

    Else If Action = 310 Then

        Controls.Ui.Section = 4
        Controls.Ui.RecentCount = 0
        Ok = Files.Queue(Transfers, Town, Files.LIST_VIEWER, Town.Name)
        Controls.Ui.Message = Transfers.Message

    Else If Action >= 500 And Action < 510 Then

        If Action - 500 < Transfers.RecentCount And OpenTabs.TabCount < Tabs.CAPACITY Then
            Ok = Files.Queue(Transfers, Town, Files.OPEN_VIEWER, Transfers.RecentPaths[Action - 500])
            Controls.Ui.Message = Transfers.Message
        End If

    Else If Action = 309 Or Action = 311 Then

        Name = FileLocations.Recall(Action = 309)
        Ok = False

        If Text_Length(Name) > 0 Then
            Ok = File_Reveal(Name)
        End If

        If Not Ok Then
            Controls.Ui.Message = "No saved file found for that format yet."
        End If

    Else If Action = 303 Then

        If OpenTabs.TabCount >= Tabs.CAPACITY Then
            Controls.Ui.Message = "Close a town tab first (limit 8)."
            Return
        End If

        Name = Text_Prompt("New Town / Environment", "Name the new blank environment.", "New Town")

        If Not Document.ValidName(Name) Then
            Return
        End If

        If (Storage.Exists("TownEditor.Town." + Name) Or
            Storage.Exists("TownEditor.Recovery." + Name)) Then
            Controls.Ui.Message = "That name already exists. Choose another."
            Return
        End If

        Ok = Library.Remember(Town)

        If Ok Then

            Ok = Document.Blank(Incoming, Name, 128, 128, 20.0)

            If Ok Then
                Ok = Tabs.Add(OpenTabs, Town, Incoming)
            End If

            TeleportPending = Ok

        End If

    Else If Action = 304 Or Action = 306 Then

        Ok = Library.Remember(Town)

        If Ok Then
            Call World.Open(Action = 304, Town.Name)

            Controls.Ui.Message = World.LastMessage()
        End If

    Else If Action = 308 Then

        Name = Text_Prompt("Open Recovery By Name", "Enter a previous town recovery name.", Town.Name)

        If Text_Length(Name) = 0 Then
            Return
        End If

        Incoming = Town
        Ok = Library.OpenNamed(Incoming, Name)

        If Ok Then
            Ok = Tabs.Add(OpenTabs, Town, Incoming)
        End If

        TeleportPending = Ok
        Controls.Ui.Message = "Town opened."

        If Not Ok Then
            Controls.Ui.Message = "Town not found; current edits retained."
        End If

    End If

    If TeleportPending Then
        Call Editor.ResetDocument(Controls, Town)
    End If

End Sub

Public Sub Input(View As P.Camera3D, Key As Number, Blocked As Boolean)

    Dim Action As Number
    Dim Index As Number
    Dim Name As Text
    Dim Ok As Boolean

    If Controls.SectionGesture.Pending Then
        Return
    End If

    If Controls.GuideTransfer.Job > 0 And Not Controls.GuideTransfer.Saving Then
        Return
    End If

    If FileDialog.Input(Transfers, Controls.Enabled And Controls.Ui.Section = 2) Then
        Return
    End If

    If World.Active() Then

        Name = World.Input(Key)

        If Text_Length(Name) > 0 Then

            Incoming = Town
            Ok = Library.OpenNamed(Incoming, Name)

            If Ok Then
                Ok = Tabs.Add(OpenTabs, Town, Incoming)
            End If

            TeleportPending = Ok

            If Ok Then
                Call Editor.ResetDocument(Controls, Town)
            End If

        End If

        Return

    End If

    If Controls.Ui.SunSlider.DragOwner > 0 Then

        If Key = KEY_TAB Then

            Call Editor.Cancel(Controls, Town)

            Controls.Enabled = False

            Return

        End If

        Action = Editor.Input(Controls, Town, View, Key, Blocked)

        Return

    End If

    If Tabs.Input(OpenTabs, Town) Then

        TeleportPending = True
        TabOverviewPending = True
        Controls.Ui.Message = "Town tab opened. Right-click to close."

        Call Editor.ResetDocument(Controls, Town)

    End If

    If Text_Length(OpenTabs.Message) > 0 Then
        Controls.Ui.Message = OpenTabs.Message
        OpenTabs.Message = ""
    End If

    If Pointer_Y() >= 94 And Pointer_Y() < 126 Then
        Return
    End If

    Action = Editor.Input(Controls, Town, View, Key,
        Blocked Or (Controls.Ui.Category = 4 And Ground.Stage <> 0))

    If Controls.MapGesture.Pending And Controls.Ui.Section <> 6 Then

        Controls.Ui.MapCount = 0

        For Index = 0 To OpenTabs.TabCount - 1

            If OpenTabs.Documents[Index].Name <> Town.Name Then
                Controls.Ui.MapNames[Controls.Ui.MapCount] = OpenTabs.Documents[Index].Name
                Controls.Ui.MapCount = Controls.Ui.MapCount + 1
            End If

        End For

        Controls.Ui.Section = 6

    End If

    If Action >= 600 And Action < 600 + Controls.Ui.MapCount Then

        Name = Controls.Ui.MapNames[Action - 600]

        For Index = 0 To OpenTabs.TabCount - 1

            If OpenTabs.Documents[Index].Name = Name Then
                Ok = Library.Remember(OpenTabs.Documents[Index])
            End If

        End For

        If Ok Then
            Call Editor.ApplyMapDestination(Controls, Town, Name)
        Else
            Controls.Ui.Message = "Destination save failed; map tiles retained."
        End If

    Else If Action = 89 Or Action = 90 Then

        If Transfers.RequestId = 0 Then
            Call GuideFiles.Choose(Controls.GuideTransfer, Controls.Guide, Action = 89)

            Controls.Ui.Message = Controls.GuideTransfer.Message
        Else
            Controls.Ui.Message = "Finish the current file operation first."
        End If

    Else If Action = 400 Or Key = KEY_TAB Then

        Call Editor.Cancel(Controls, Town)

        Controls.Enabled = False

    Else If (Action >= 300 And
        Action <= 315 Or
        (Action >= 500 And Action < 510)) Then

        Call FileCommand(Action)

    End If

End Sub

Public Sub Update(Leader As P.Vector3, Elapsed As Number)

    Dim Ok As Boolean
    Dim Index As Number

    If Not Ready Then
        Return
    End If

    MapLoadCooldown = Max(0, MapLoadCooldown - Elapsed)

    If Controls.SectionGesture.Pending Then

        If Ground.PendingRevision <> Town.Surface.Revision Then
            Call Terrain.BeginBuild(Ground, Town.Surface)
        End If

        Call Terrain.Update(Ground, Elapsed)

        Controls.Ui.Busy = True
        Controls.Ui.ProgressPercent = Ground.Row * 90 / Max(1, Town.Surface.Rows)

        If Ground.Failed Then

            Call SectionTools.Finish(Controls.SectionGesture, Town, False)
            Call Editor.ResetHistory(Controls, Town)
            Call Terrain.BeginBuild(Ground, Town.Surface)

        Else If Ground.LiveRevision = Town.Surface.Revision Then

            Call SectionTools.Finish(Controls.SectionGesture, Town, True)
            Call History.Record(Controls.HistoryState, Town, Controls.Guide.Ink)

        Else
            Return

        End If

        Controls.Ui.Message = Controls.SectionGesture.Message

    End If

    If AppliedRevision <> Town.Revision Then

        Call Renderer.SyncDocument(Assets, Town)

        Ok = Lighting.Apply(Town.Light)

        If Ground.LiveRevision = Town.Surface.Revision And Controls.Ui.SunSlider.DragOwner = 0 Then
            Call Navigation.Rebuild(Town)
        End If

        AppliedRevision = Town.Revision
        RecoveryClock = 0

    End If

    If Ground.PendingRevision <> Town.Surface.Revision Then
        Call Terrain.BeginBuild(Ground, Town.Surface)
    End If

    Call Terrain.Update(Ground, Elapsed)

    If Assets.Loaded < Assets.Required Then
        Call Renderer.LoadNext(Assets)
    End If

    Controls.Ui.Busy = Ground.Stage <> 0 Or Transfers.RequestId > 0 Or Assets.Loaded < Assets.Required

    If Assets.Loaded < Assets.Required Then
        Controls.Ui.ProgressPercent = (Assets.Loaded - Catalog.CHUNK_COUNT) * 100 / 14
        Controls.Ui.Message = "Loading Old Castle..."
    End If

    If Ground.Stage <> 0 Then
        Controls.Ui.ProgressPercent = Ground.Row * 90 / Max(1, Town.Surface.Rows)
    End If

    If Ground.Failed Then

        Town.Surface = LiveSurface
        Town.Revision = Town.Revision + 1
        Controls.Ui.Message = "Terrain limit reached; edit reverted."

        Call Editor.ResetHistory(Controls, Town)

        Call Terrain.BeginBuild(Ground, Town.Surface)

    Else If (Ground.LiveRevision = Town.Surface.Revision And
        LiveSurface.Revision <> Town.Surface.Revision) Then

        LiveSurface = Town.Surface

        Call Navigation.Rebuild(Town)

    End If

    Call Attachments.Update(Details, Town, Leader, Elapsed)
    Call Editor.UpdateGuideFiles(Controls, Town)

    RecoveryClock = RecoveryClock + Elapsed

    If RecoveryRevision <> Town.Revision And RecoveryClock >= 1500 Then

        Ok = Library.Remember(Town)

        If Ok Then
            RecoveryRevision = Town.Revision
        End If

    End If

    If Transfers.RequestId > 0 Then

        Ok = Files.Update(Transfers, Town, Elapsed)

        If Transfers.RequestId = 0 Or Files.BlocksEditing(Transfers) Then
            Controls.Ui.Message = Transfers.Message
        End If

        Controls.Ui.ProgressPercent = Transfers.Progress
        Controls.Ui.RecentCount = Transfers.RecentCount

        For Index = 0 To Transfers.RecentCount - 1
            Controls.Ui.RecentLabels[Index] = Transfers.RecentLabels[Index]
        End For

        If Ok Then

            Ok = Tabs.Add(OpenTabs, Town, Transfers.Pending)
            TeleportPending = Ok

            If Ok Then
                Call Editor.ResetDocument(Controls, Town)
            End If

        End If

    End If

End Sub

Public Function Draw() As Boolean

    Dim Ok As Boolean

    If Controls.SectionGesture.Pending Then

        Ok = Renderer.Draw(Assets, Controls.SectionGesture.Before)
        Ok = Terrain.Draw(Ground) And Ok
        Ok = Attachments.Draw(Details, Controls.SectionGesture.Before) And Ok

        Return Ok

    End If

    Ok = Renderer.Draw(Assets, Town)
    Ok = Terrain.Draw(Ground) And Ok
    Ok = Attachments.Draw(Details, Town) And Ok

    Return Ok

End Function

Public Function ApplyLocalLighting() As Boolean

    Dim Ok As Boolean

    Ok = Lighting.ApplyLocal(Town)

    If Not Ok Then
        Controls.Ui.Message = "Night-light capacity reached; some lights are unavailable."
    End If

    Return Ok

End Function

Public Sub Overlay(View As P.Camera3D, Optional Loading As Boolean = False)

    Call Tabs.Draw(OpenTabs, Town)

    If Loading Then
        Return
    End If

    Call Editor.Draw(Controls, Town, View)
    Call World.Draw()
    Call FileDialog.Draw(Transfers, Controls.Enabled And Controls.Ui.Section = 2)

End Sub

Public Function TakeSpawn(ByRef Position As P.Vector3, ByRef Overview As Boolean) As Boolean

    Dim X As Number
    Dim Z As Number
    Dim Found As Boolean

    If Not TeleportPending Or Ground.LiveRevision <> Town.Surface.Revision Then
        Return False
    End If

    TeleportPending = False
    Overview = TabOverviewPending
    TabOverviewPending = False

    If TravelPending Then

        Position = TravelArrival
        TravelPending = False
        Position.Y = Navigation.GroundHeight(Position.X, Position.Z)
        Return True

    End If

    If Town.Name = "Neris Spaceport" Or Town.Name = "Horizon Airport" Then
        Position = Connections.Arrival(Town.Name)
        Return True
    End If

    Position = P.Vector(0.0, 23.12, 0.0)

    If Navigation.CanStand(0.0, -2780.0) Then
        Position.Z = -2780.0
    End If

    Found = Navigation.CanStand(Position.X, Position.Z)

    If Not Found Then

        For Z = 0 To Town.Surface.Rows - 1

            For X = 0 To Town.Surface.Columns - 1

                If (Grid.ReadCell(Town.Surface, X, Z) = Grid.SURFACE_ROAD Or
                    Grid.ReadCell(Town.Surface, X, Z) = Grid.SURFACE_GROUND) Then

                    Position.X = (Town.Surface.XEdges[X] + Town.Surface.XEdges[X + 1]) * 0.5
                    Position.Z = (Town.Surface.ZEdges[Z] + Town.Surface.ZEdges[Z + 1]) * 0.5
                    Found = Navigation.CanStand(Position.X, Position.Z)

                    If Found Then
                        Exit For
                    End If

                End If

            End For

            If Found Then
                Exit For
            End If

        End For

    End If

    Position.Y = Navigation.GroundHeight(Position.X, Position.Z)

    Return True

End Function

''' The active saved surface owns both the floor extent and the map orbit center.
Public Function MapCenter(Optional Height As Double = 150.0) As P.Vector3

    Dim Result As P.Vector3

    Result = P.Vector((Town.Surface.OriginX + Town.Surface.XEdges[Town.Surface.Columns]) * 0.5,
        Height, (Town.Surface.OriginZ + Town.Surface.ZEdges[Town.Surface.Rows]) * 0.5)

    Return Result

End Function

Public Sub SizeArena(ByRef Floor As Arena.ArenaFloor)

    Dim Center As P.Vector3
    Dim Width As Number
    Dim Depth As Number

    If Ground.LiveRevision <> Town.Surface.Revision Then
        Return
    End If

    Center = MapCenter()
    Width = ToNumber(Town.Surface.XEdges[Town.Surface.Columns] - Town.Surface.OriginX)
    Depth = ToNumber(Town.Surface.ZEdges[Town.Surface.Rows] - Town.Surface.OriginZ)

    If (Floor.Ready And
        Floor.Width = Width And
        Floor.Depth = Depth And
        Floor.Floor.Position.X = ToNumber(Center.X) And
        Floor.Floor.Position.Z = ToNumber(Center.Z)) Then
        Return
    End If

    Call Arena.Destroy(Floor)

    Floor = Arena.Create(Width, Depth, 24, 150, 255, 200, 2)

    Call Arena.Place(Floor, ToNumber(Center.X), -1, ToNumber(Center.Z))

End Sub

Public Sub Release()

    Dim Ok As Boolean

    Call RoadTravel.Cancel()

    If HaveDocument Then
        Call Editor.Cancel(Controls, Town)

        Ok = Library.Remember(Town)
    End If

    Call Panel.Release(Controls.Ui)
    Call World.Close()
    Call Attachments.Destroy(Details)
    Call Terrain.Destroy(Ground)
    Call Renderer.Destroy(Assets)
    Call Navigation.Disable()

    Ok = G.ClearAdditionalLights3DChecked() And Ok
    Ready = False
    Prepared = False
    TeleportPending = HaveDocument
    TabOverviewPending = HaveDocument

End Sub

Public Function CourtExists() As Boolean

    Dim Result As Boolean

    Result = Town.CourtPlaced

    If Controls.SectionGesture.Pending Then
        Result = Controls.SectionGesture.Before.CourtPlaced
    End If

    Return Result

End Function

Public Function CourtOffset() As P.Vector3

    Dim Result As P.Vector3

    Result = P.Vector(Town.CourtOffsetX, 0.0, Town.CourtOffsetZ)

    If Controls.SectionGesture.Pending Then
        Result = P.Vector(Controls.SectionGesture.Before.CourtOffsetX,
            0.0, Controls.SectionGesture.Before.CourtOffsetZ)
    End If

    Return Result

End Function

Public Function TownName() As Text

    Dim ReturnValue As Text

    If HaveDocument Then
        ReturnValue = Town.Name

        Return ReturnValue
    End If

    Return "Neris Town"

End Function

''' Read-only coverage query for optional landmarks in expanded town revisions.
Public Function CoversArea(MinX As Double, MinZ As Double, MaxX As Double, MaxZ As Double) As Boolean

    Dim Result As Boolean

    Result = (HaveDocument And Town.Surface.OriginX <= MinX And Town.Surface.OriginZ <= MinZ And
        Town.Surface.XEdges[Town.Surface.Columns] >= MaxX And Town.Surface.ZEdges[Town.Surface.Rows] >= MaxZ)

    Return Result

End Function

Public Sub DrawMap(Position As P.Vector3, Opacity As Number, LeaderName As Text,
    LandmarkName As Text, LandmarkPosition As P.Vector3, AirportName As Text,
    AirportPosition As P.Vector3, Headlight As Image, Yaw As Double)

    Call Map.Draw(Town, Position, Opacity, LeaderName, LandmarkName, LandmarkPosition,
        AirportName, AirportPosition, Headlight, Yaw)

    If Opacity > 0 Then
        Call Map.DrawDestination(Town, RoadTravel.Target(), RoadTravel.Active(), RoadTravel.Message())
    End If

End Sub

Public Sub FrameDocument(ByRef Camera As P.Camera3D, Optional Overview As Boolean = False)

    Dim Direction As P.Vector3
    Dim Radius As Double
    Dim Angle As Double
    Dim Ok As Boolean

    Direction = Math3D.Subtract(Camera.Position, Camera.Target)

    Ok = Math3D.TryNormalize(Direction, Direction)
    Camera.Target = P.Vector((Town.Surface.OriginX + Town.Surface.XEdges[Town.Surface.Columns]) * 0.5,
        150.0, (Town.Surface.OriginZ + Town.Surface.ZEdges[Town.Surface.Rows]) * 0.5)

    If Overview Then
        Call Tour.Frame(Camera, Camera.Target)

        Return
    End If

    Radius = Sqrt((Town.Surface.XEdges[Town.Surface.Columns] - Town.Surface.OriginX) *
        (Town.Surface.XEdges[Town.Surface.Columns] - Town.Surface.OriginX) +
        (Town.Surface.ZEdges[Town.Surface.Rows] - Town.Surface.OriginZ) *
        (Town.Surface.ZEdges[Town.Surface.Rows] - Town.Surface.OriginZ)) * 0.5
    Angle = Math3D.Radians(Camera.FovDegrees * 0.5)
    Angle = Atan2(Sin(Angle) * Min(1.0, ToDouble(Window_Width()) / ToDouble(Max(1, Window_Height()))), Cos(Angle))
    Camera.Position = Math3D.Add(Camera.Target, Math3D.Scale(Direction, Radius / Sin(Angle)))

End Sub

End Module
