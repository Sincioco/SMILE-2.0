''' Single active town document, retained across Viewer tabs; delegates editing and rendering.
Module Smile.Tools.TownEditorSession

Option Explicit

Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.Graphics3D As G
Import Smile.Tools.TownDocument As Document
Import Smile.Tools.TownNpcLayout As NpcLayout
Import Smile.Tools.TownSurfaceStyles As SurfaceStyles
Import Smile.Tools.TownCatalogData As Catalog
Import Smile.Tools.TownInitialSurface As Initial
Import Smile.Tools.TownGuideList As GuideList
Import Smile.Tools.TownEditor As Editor
Import Smile.Tools.TownSectionTools As SectionTools
Import Smile.Tools.TownHistory As History
Import Smile.Tools.TownEditorPanel As Panel
Import Smile.Tools.TownCatalogRenderer As Renderer
Import Smile.Tools.TownSurfaceRenderer As Terrain
Import Smile.Tools.TownDecks As Decks
Import Smile.Tools.TownAttachments As Attachments
Import Smile.Tools.TownCampfires As Campfires
Import Smile.Tools.TownFountains As Fountains
Import Smile.Tools.TownLighting As Lighting
Import Smile.Tools.TownWaterAppearance As WaterAppearance
Import Smile.Tools.TownDocumentNavigation As Navigation
Import Smile.Tools.TownDocumentStore As Storage
Import Smile.Tools.TownLibrary As Library
Import Smile.Tools.TownFileJobs As Files
Import Smile.Tools.TownSaveQueue As SaveQueue
Import Smile.Tools.TownFileDialog As FileDialog
Import Smile.Tools.TownFileLocations As FileLocations
Import Smile.Tools.TownGuideFiles As GuideFiles
Import Smile.Tools.TownMapLoads As MapLoads
Import Smile.Tools.TownGatewayJourney As Journey
Import Smile.Tools.TownDemo As Demo
Import Smile.Tools.TownStartingCamera As StartingCamera
Import Smile.Tools.TownViewportLayout As Toolbar
Import Smile.Tools.TownTabs As Tabs
Import Smile.Tools.TownDocumentMap As Map
Import Smile.Tools.TownMinimapInput As MinimapInput
Import Smile.Tools.TownRoadTravel As RoadTravel
Import Smile.Simple3D.PrecisionMath3D As Math3D
Import Smile.Tools.TownWorldEditor As World
Import Smile.Tools.TownWorldPreviews As Previews
Import Smile.Tools.TownSelection As Selection
Import Smile.Simple3D.SurfaceGrid3D As Grid
Import Smile.Tools.NerisTownTour As Tour
Import Smile.Tools.NerisTownConnections As Connections
Import Smile.Simple3D.Arena3D As Arena
Import Smile.Simple3D.ArenaCamera3D As Motion

Private Dim Town As Document.State
Private Dim MinimapGesture As MinimapInput.State
Private Dim Transfers As Files.State
Private Dim QueuedSaves As SaveQueue.State
Private Dim MapLoadOccupied As Boolean
Private Dim MapLoadCooldown As Number
Private Dim GatewayJourney As Journey.State
Private Dim Showcase As Demo.State
Private Dim DemoLightingAlternate As Boolean
Private Dim DemoCameraPending As Boolean
Private Dim OpenTabs As Tabs.State
Private Dim Incoming As Document.State
Private Dim Controls As Editor.State
Private Dim Assets As Renderer.State
Private Dim Ground As Terrain.State
Private Dim Details As Attachments.State
Private Dim Fires As Campfires.State
Private Dim AttemptedRecovery As Boolean
Private Dim HaveDocument As Boolean
Private Dim Ready As Boolean
Private Dim Prepared As Boolean
Private Dim AppliedRevision As Number
Private Dim RecoveryRevision As Number
Private Dim RecoveryClock As Number
Private Dim TeleportPending As Boolean
Private Dim TravelPending As Boolean
Private Dim TravelArrival As P.Vector3
Private Dim TabOverviewPending As Boolean
Private Dim LiveAppearance As SurfaceStyles.State
Private Dim LiveStyle As Number
Private Dim LiveSurface As Grid.State
Private Dim LiveTown As Text

Public Function Available() As Boolean

    If Not AttemptedRecovery Then

        AttemptedRecovery = True

        Call Demo.Start(Showcase)

        HaveDocument = Library.Recover(Town)
        TeleportPending = HaveDocument
        TabOverviewPending = HaveDocument

        If HaveDocument Then
            Call Tabs.Ensure(OpenTabs, Town)
        End If

    End If

    Return HaveDocument

End Function

Public Sub BeginEditing()

    Dim Index As Number

    If Not HaveDocument Then

        Town.Name = "Neris Town"
        Town.CourtPlaced = True
        Town.HasTeleportSpawn = True
        Town.TeleportSpawn = P.Vector(0.0, 0.0, -2780.0)

        Call Initial.Populate(Town.Surface)
        Call Document.DefaultSun(Town.Light)

        Town.ItemCount = Catalog.INITIAL_ITEMS
        Town.NextIdentity = Town.ItemCount + 1

        For Index = 0 To Town.ItemCount - 1
            Town.Items[Index] = Catalog.InitialItem(Index)
        End For

        Town.Revision = 1
        Town.SavedRevision = 1
        HaveDocument = True

    End If

    Call Tabs.Ensure(OpenTabs, Town)
    Call Editor.Start(Controls)

End Sub

Public Function Editing() As Boolean

    Dim ReturnValue As Boolean

    ReturnValue = Controls.Enabled

    Return ReturnValue

End Function

Public Function MapHovered() As Boolean

    Dim Result As Boolean

    Result = Map.Hovered() Or MinimapGesture.Button <> 0

    Return Result

End Function

Public Function MinimapCaptured() As Boolean

    Dim Result As Boolean

    Result = MinimapGesture.Button <> 0

    Return Result

End Function

Public Function HandleMinimap(Leader As P.Vector3) As Number

    Dim Action As Number
    Dim Started As Boolean

    If MinimapGesture.Button = 0 And Map.ZoomInput(Town) Then
        Return 1
    End If

    Action = MinimapInput.Update(MinimapGesture, Motion.ReadPointer(False),
        Pointer_X(), Pointer_Y(), Map.Hovered() And Pointer_Y() >= 259)

    If MinimapGesture.DeltaX <> 0 Or MinimapGesture.DeltaY <> 0 Then
        Call Map.Pan(Town, MinimapGesture.DeltaX, MinimapGesture.DeltaY)
    End If

    If Action = 2 Then

        Started = BeginRoadTrip(Leader)

        If Not Started Then
            Action = 1
        End If

    End If

    Return Action

End Function

Public Function BeginRoadTrip(Leader As P.Vector3) As Boolean

    Dim Result As Boolean
    Dim Point As P.Vector3

    If Ground.Stage <> 0 Then
        Return False
    End If

    Point = Map.Pick(Town, Pointer_X(), Pointer_Y())

    If Key_Held(KEY_SHIFT) And RoadTravel.Active() Then
        Result = RoadTravel.Append(Town, Point)
        ' Appending does not restart the active camera-follow transition.
        Return False
    End If

    Result = RoadTravel.Begin(Town, Leader, Point)

    Return Result

End Function

Public Function BeginRoadTripTo(Leader As P.Vector3, Target As P.Vector3) As Boolean

    Dim Result As Boolean

    If Ground.Stage <> 0 Then
        Return False
    End If

    Result = RoadTravel.Begin(Town, Leader, Target, False, True)

    Return Result

End Function

Public Function RoadDirection(Leader As P.Vector3, Distance As Double, Elapsed As Number) As P.Vector3

    Dim Result As P.Vector3

    If Controls.Enabled Then
        Call RoadTravel.Cancel()
    End If

    Result = RoadTravel.Direction(Town, Leader, Distance, Elapsed)

    Return Result

End Function

Public Function GestureActive() As Boolean

    Dim Result As Boolean

    Result = (Controls.Selected.Dragging Or Controls.MarkerGesture.Dragging Or
        Controls.MapGesture.Moving Or Controls.MapGesture.Drawing Or
        Controls.CourtGesture.Dragging Or Controls.SectionGesture.Selecting Or
        Controls.SectionGesture.Dragging Or Controls.SectionGesture.Pending Or Controls.Rubber Or Controls.Anchored Or
        Controls.Ui.SunSlider.DragOwner > 0 Or World.Active())

    Return Result

End Function

Public Function ViewRightEdge() As Number

    Dim Result As Number

    Result = Panel.LeftEdge() - Controls.GuideBrowser.Width

    Return Result

End Function

Public Function TakeViewRequest(ByRef Point As P.Vector3) As Number

    Dim Result As Number

    Result = Controls.ViewRequest
    Point = Controls.FocusPoint
    Controls.ViewRequest = 0

    Return Result

End Function

Public Function CameraBlocked(Optional CameraControl As Boolean = False) As Boolean

    Dim Result As Boolean

    Result = (OpenTabs.Menu.Visible Or OpenTabs.Menu.Consumed Or Files.BlocksEditing(Transfers) Or World.Active() Or Controls.Ui.SunSlider.DragOwner > 0 Or
        (Pointer_Y() < 126 And Not CameraControl) Or
        (Controls.Enabled And (Panel.Hovered() Or GuideList.Hovered(Controls.GuideBrowser) Or
        (Not CameraControl And ((Editor.CapturesMap(Controls) And Not Key_Held(KEY_SHIFT) And
        Pointer_Held(POINTER_PRIMARY)) Or GestureActive())))))

    Return Result

End Function

Public Function LoadNext() As Boolean

    Dim Ok As Boolean
    Dim Deadline As Number
    Dim Step As Number

    Call Map.Update(Town)

    If (Ready And
        LiveTown = Town.Name And
        AppliedRevision = Town.Revision And
        Ground.LiveRevision = Town.Surface.Revision And
        Not Assets.Failed) Then
        Return True
    End If

    ' A previous document being ready must not publish this document's unfinished terrain.
    Ready = False

    If Details.Streams.Town <> Town.Name Then
        Call Fountains.Destroy(Details.Streams)
    End If

    Call Renderer.SyncDocument(Assets, Town)

    If Assets.Loaded < Assets.Required Then

        Deadline = Timer() + 4

        For Step = 1 To 8

            Call Renderer.LoadNext(Assets)

            If (Assets.Failed Or
                Assets.Loaded >= Assets.Required Or
                Timer() >= Deadline) Then
                Exit For
            End If

        End For

        Return False

    End If

    If Not Prepared Then

        Ok = Terrain.Create(Ground)
        Ok = Attachments.Create(Details) And Ok
        Ok = ApplyDisplayedLighting() And Ok
        Assets.Failed = Assets.Failed Or Not Ok
        Prepared = True

        Call Terrain.BeginBuild(Ground, Town)

    End If

    If Ground.PendingRevision <> Town.Surface.Revision Then
        Ready = False

        Call Terrain.BeginBuild(Ground, Town)
    End If

    ' Fill spare loading-frame time without increasing a terrain upload's size.
    Deadline = Timer() + 3

    Call Terrain.Update(Ground, 16)

    For Step = 1 To 7

        If (Ground.Stage = 0 Or
            Ground.Failed Or
            Timer() >= Deadline) Then
            Exit For
        End If

        Call Terrain.Update(Ground, 0)
    End For

    If (Ground.Stage = 0 And
        Not Ground.Failed And
        Not Assets.Failed) Then

        Ready = True
        AppliedRevision = Town.Revision
        RecoveryRevision = Town.Revision
        LiveAppearance = Town.Appearance
        LiveStyle = Town.TerrainStyle
        LiveSurface = Town.Surface
        LiveTown = Town.Name

        Call Navigation.Rebuild(Town)

    End If

    Return Ready

End Function

Public Function HasTown(Name As Text) As Boolean

    Dim Index As Number

    For Index = 0 To OpenTabs.TabCount - 1

        If OpenTabs.Documents[Index].Name = Name Then
            Return True
        End If

    End For

    Return False

End Function

Public Function IsNight() As Boolean

    Dim Result As Boolean

    Result = Town.Presets.NightActive <> Demo.AlternateLighting(Showcase)

    Return Result

End Function

Public Sub ToggleDayNight()

    Dim Action As Number
    Dim Ignored As Number

    Action = 222

    If Town.Presets.NightActive Then
        Action = 221
    End If

    Ignored = Editor.Command(Controls, Town, Action)

End Sub

Public Function TravelOnTile(Position As P.Vector3, Moving As Boolean) As Boolean

    Dim Name As Text
    Dim Ok As Boolean
    Dim Origin As Text
    Dim Returning As Boolean

    Name = MapLoads.DestinationAt(Town, Position.X, Position.Z)

    If Text_Length(Name) = 0 Then
        MapLoadOccupied = False
        Return False
    End If

    If (MapLoadOccupied Or
        Not Moving Or
        MapLoadCooldown > 0) Then
        Return False
    End If

    MapLoadOccupied = True
    Origin = Town.Name
    Returning = Journey.ResolveTile(GatewayJourney, Town, Name, Position)
    Ok = Tabs.OpenNamed(OpenTabs, Town, Name)

    If Ok Then

        Call Journey.Remember(GatewayJourney, Origin, Name, Position)

        TeleportPending = True
        TravelPending = Returning
        TravelArrival = Position
        TabOverviewPending = False
        MapLoadCooldown = 1500

        Call Editor.ResetDocument(Controls, Town)

    Else
        Controls.Ui.Message = "Could not load " + Name + "; current town retained."

    End If

    Return Ok

End Function

Public Function TravelTo(Name As Text, Arrival As P.Vector3) As Boolean

    Dim Ok As Boolean
    Dim Returning As Boolean
    Dim Origin As Text

    Origin = Town.Name
    Returning = Journey.Resolve(GatewayJourney, Town.Name, Name, Arrival)
    Ok = Tabs.OpenNamed(OpenTabs, Town, Name)

    If Ok Then

        ' Legacy travel supplies a destination point, not a remembered origin point.
        GatewayJourney.ArrivalOrigin = Origin
        GatewayJourney.ArrivalTown = Name
        TeleportPending = True
        TravelPending = True
        TravelArrival = Arrival
        MapLoadOccupied = Returning
        MapLoadCooldown = 1500

        Call Editor.ResetDocument(Controls, Town)

    End If

    Return Ok

End Function

Public Function Failed() As Boolean

    Dim Result As Boolean

    Result = Assets.Failed Or Ground.Failed

    Return Result

End Function

Public Function Progress() As Number

    Dim Result As Number

    Result = Assets.Loaded * 70 / Max(1, Assets.Required)

    If Prepared Then
        Result = 70 + Ground.Recipe.Row * 20 / Max(1, Town.Surface.Rows)
    End If

    If Ground.Stage = 2 Then
        Result = 90 + Ground.Kind * 2
    End If

    If Ready Then
        Result = 100
    End If

    Return Result

End Function

Private Sub FileCommand(Action As Number)

    Dim Name As Text
    Dim Ok As Boolean
    Dim Mode As Number
    Dim OldName As Text

    If ((Transfers.RequestId > 0 Or QueuedSaves.Active Or Controls.GuideTransfer.Job > 0) And
        Action <> 309 And
        Action <> 311) Then
        Controls.Ui.Message = "A file operation is still running."
        Return
    End If

    If (Ground.Stage <> 0 And
        Action <> 300 And
        Action <> 301 And
        Action <> 302 And
        (Action < 700 Or Action >= 700 + Library.PERMANENT_COUNT) And
        Action <> 309 And
        Action <> 311) Then
        Controls.Ui.Message = "Finishing terrain; try saving when ready."
        Return
    End If

    If Action = 313 Or Action = 314 Then

        Mode = Files.SAVE_VIEWER

        If Action = 314 Then
            Mode = Files.SAVE_BLENDER
        End If

        Call SaveQueue.Choose(QueuedSaves, OpenTabs, Town, Mode)

        Return

    End If

    If (Action = 300 Or
        Action = 301 Or
        Action = 302 Or
        Action = 307 Or
        Action = 305) Then

        If ((Action = 305 Or Action = 307 Or Action = 302) And
            OpenTabs.TabCount >= Tabs.CAPACITY) Then
            Controls.Ui.Message = "Close a town tab first (limit 16)."
            Return
        End If

        Mode = Files.SAVE_VIEWER
        OldName = Town.Name

        If Action = 301 Then

            Mode = Files.SAVE_BLENDER

        Else If Action = 305 Then

            Mode = Files.OPEN_VIEWER

        Else If Action = 307 Then

            Mode = Files.OPEN_BLENDER

        Else If Action = 302 Then

            Name = Text_Prompt("Save for Viewer As", "Name the new town.", Town.Name + " Copy")

            If Not Document.ValidName(Name) Then
                Return
            End If

            If Name = "Neris Town" Or Storage.Exists("TownEditor.Town." + Name) Then
                Controls.Ui.Message = "Choose a new, unused town name."
                Return
            End If

            Town.Name = Name

        End If

        Call Files.Choose(Transfers, Town, Mode, OldName)

        Town.Name = OldName
        Transfers.OriginName = OldName
        Transfers.SaveAsCopy = Action = 302 And Transfers.RequestId > 0
        Controls.Ui.Message = Transfers.Message

    Else If Action = 312 Then

        Controls.Ui.PermanentPage = 0

        Controls.Ui.Section = 5

    Else If Action >= 700 And Action < 700 + Library.PERMANENT_COUNT Then

        Name = Library.PermanentName(Action - 700)

        If Not Panel.ConfirmPermanent(Town.Name, Name) Then
            Controls.Ui.Message = "Permanent update canceled; both maps retained."
            Return
        End If

        Ok = Files.Queue(Transfers, Town, Files.SAVE_PERMANENT, Name)
        Controls.Ui.Message = Transfers.Message

        Return

    Else If Action = 310 Then

        Controls.Ui.Section = 4
        Controls.Ui.RecentCount = 0
        Ok = Files.Queue(Transfers, Town, Files.LIST_VIEWER, Town.Name)
        Controls.Ui.Message = Transfers.Message

    Else If Action >= 500 And Action < 510 Then

        If Action - 500 < Transfers.RecentCount And OpenTabs.TabCount < Tabs.CAPACITY Then
            Ok = Files.Queue(Transfers, Town, Files.OPEN_VIEWER, Transfers.RecentPaths[Action - 500])
            Controls.Ui.Message = Transfers.Message
        End If

    Else If Action = 309 Or Action = 311 Then

        Name = FileLocations.Recall(Action = 309)
        Ok = False

        If Text_Length(Name) > 0 Then
            Ok = File_Reveal(Name)
        End If

        If Not Ok Then
            Controls.Ui.Message = "No saved file found for that format yet."
        End If

    Else If Action = 303 Then

        If OpenTabs.TabCount >= Tabs.CAPACITY Then
            Controls.Ui.Message = "Close a town tab first (limit 16)."
            Return
        End If

        Name = Text_Prompt("New Town / Environment", "Name the new blank environment.", "New Town")

        If Not Document.ValidName(Name) Then
            Return
        End If

        If (Storage.Exists("TownEditor.Town." + Name) Or
            Storage.Exists("TownEditor.Recovery." + Name)) Then
            Controls.Ui.Message = "That name already exists. Choose another."
            Return
        End If

        Ok = Library.Remember(Town)

        If Ok Then

            Ok = Document.Blank(Incoming, Name, 128, 128, 20.0)

            If Ok Then
                Ok = Tabs.Add(OpenTabs, Town, Incoming)
            End If

            TeleportPending = Ok
            TabOverviewPending = Ok

        End If

    Else If Action = 304 Or Action = 306 Then

        Ok = Library.Remember(Town)

        If Ok Then

            OpenTabs.Documents[OpenTabs.Active] = Town

            Call World.Open(Action = 304, Town.Name)

            Controls.Ui.Message = World.LastMessage()

        End If

    Else If Action = 308 Then

        Name = Text_Prompt("Open Recovery By Name", "Enter a previous town recovery name.", Town.Name)

        If Text_Length(Name) = 0 Then
            Return
        End If

        Incoming = Town
        Ok = Library.OpenNamed(Incoming, Name)

        If Ok Then
            Ok = Tabs.Add(OpenTabs, Town, Incoming)
        End If

        TeleportPending = Ok
        Controls.Ui.Message = "Town opened."

        If Not Ok Then
            Controls.Ui.Message = "Town not found; current edits retained."
        End If

    End If

    If TeleportPending Then
        Call Editor.ResetDocument(Controls, Town)
    End If

End Sub

Public Function DemoActive() As Boolean

    Dim ReturnValue As Boolean

    ReturnValue = Showcase.Enabled

    Return ReturnValue

End Function

Public Function MapStatisticsVisible() As Boolean

    Dim Result As Boolean

    Result = Demo.StatisticsVisible(Showcase)

    Return Result

End Function

Public Function StopDemoOnInput(Key As Number) As Boolean

    Dim Active As Boolean
    Dim PreserveDemo As Boolean
    Dim Result As Boolean

    Active = (Key <> KEY_NONE Or Pointer_Pressed(POINTER_PRIMARY) Or
        Pointer_Pressed(POINTER_SECONDARY) Or Pointer_Pressed(POINTER_MIDDLE))
    PreserveDemo = (Pointer_Pressed(POINTER_PRIMARY) And
        (Toolbar.Hovered(1) Or Toolbar.Hovered(6)) And
        Not World.Active() And Not OpenTabs.Menu.Visible)
    Result = Demo.StopOnInput(Showcase, Active, PreserveDemo)

    If Result Then
        DemoCameraPending = False
    End If

    Return Result

End Function

Public Sub UpdateDemoIdle(View As P.Camera3D, Elapsed As Number, Active As Boolean)

    Dim Available As Boolean

    Available = (Ready And Not Editing() And Not World.Active() And
        Not OpenTabs.Menu.Visible And Not Files.BlocksEditing(Transfers) And
        Not GestureActive())

    If Demo.AdvanceIdle(Showcase, Elapsed, Active, Available) Then
        Call ToggleDemo(View)
    End If

End Sub

Public Sub ToggleDemo(View As P.Camera3D)

    Showcase.TownName = Town.Name

    Call Demo.Toggle(Showcase)

    DemoCameraPending = Showcase.Enabled

End Sub

Public Function TakeDemoOrbit() As Boolean

    Dim Result As Boolean

    Result = DemoCameraPending
    DemoCameraPending = False
    Return Result

End Function

Public Sub Input(View As P.Camera3D, Key As Number, Blocked As Boolean)

    Dim Action As Number
    Dim Index As Number
    Dim Name As Text
    Dim Ok As Boolean

    If Controls.SectionGesture.Pending Then
        Return
    End If

    If Controls.GuideTransfer.Job > 0 And Not Controls.GuideTransfer.Saving Then
        Return
    End If

    If FileDialog.Input(Transfers, Controls.Enabled And Controls.Ui.Section = 2) Then
        Return
    End If

    If World.Active() Then

        Name = World.Input(Key, OpenTabs)
        Controls.Ui.Message = World.LastMessage()

        If (Name = "" And
            Ready And
            Ground.LiveRevision = Town.Surface.Revision) Then
            Name = World.PreviewRequest(Town.Name)
        End If

        If Text_Length(Name) > 0 Then

            Ok = Tabs.OpenNamed(OpenTabs, Town, Name)

            TeleportPending = Not World.Active() And World.EnteringTown() And Town.Name = Name
            TabOverviewPending = TeleportPending

            If TeleportPending Then
                Controls.Enabled = False
            End If

            If Ok Then
                Call Editor.ResetDocument(Controls, Town)
            Else If Name <> Town.Name Then
                Call World.PreviewUnavailable(Name)
            End If

        End If

        Return

    End If

    If Toolbar.Clicked(7) Then

        Ok = Library.Remember(Town)

        If Ok Then
            OpenTabs.Documents[OpenTabs.Active] = Town

            Call World.Reopen(Town.Name)
        End If

        Return

    End If

    If Toolbar.Clicked(6) Then
        Call ToggleDemo(View)
    End If

    If Controls.Ui.SunSlider.DragOwner > 0 Then

        If Key = KEY_TAB Then

            Call Editor.Cancel(Controls, Town)

            Controls.Enabled = False

            Return

        End If

        Action = Editor.Input(Controls, Town, View, Key, Blocked)

        Return

    End If

    If ((Controls.TerrainGesture.Active Or Controls.TerrainGesture.Pending) And
        ((Pointer_Y() >= 94 And Pointer_Y() < 126 And Pointer_Pressed(POINTER_PRIMARY)) Or Key = KEY_TAB)) Then
        Call Editor.Cancel(Controls, Town)
    End If

    If Tabs.Input(OpenTabs, Town, Key) Then

        Showcase.Elapsed = 0
        TeleportPending = True
        TabOverviewPending = True
        Controls.Ui.Message = "Town tab opened. Right-click to close."

        Call Editor.ResetDocument(Controls, Town)

    End If

    If Text_Length(OpenTabs.Message) > 0 Then
        Controls.Ui.Message = OpenTabs.Message
        OpenTabs.Message = ""
    End If

    If OpenTabs.Menu.Consumed Or (Pointer_Y() >= 94 And Pointer_Y() < 126) Then
        Return
    End If

    Action = Editor.Input(Controls, Town, View, Key,
        Blocked Or (Controls.Ui.Category = 4 And Ground.Stage <> 0))

    If Controls.MapGesture.Pending And Controls.Ui.Section <> 6 Then

        Controls.Ui.MapCount = 0

        For Index = 0 To OpenTabs.TabCount - 1

            If OpenTabs.Documents[Index].Name <> Town.Name Then
                Controls.Ui.MapNames[Controls.Ui.MapCount] = OpenTabs.Documents[Index].Name
                Controls.Ui.MapCount = Controls.Ui.MapCount + 1
            End If

        End For

        Controls.Ui.Section = 6

    End If

    If Action >= 600 And Action < 600 + Controls.Ui.MapCount Then

        Name = Controls.Ui.MapNames[Action - 600]

        For Index = 0 To OpenTabs.TabCount - 1

            If OpenTabs.Documents[Index].Name = Name Then
                Ok = Library.Remember(OpenTabs.Documents[Index])
            End If

        End For

        If Ok Then
            Call Editor.ApplyMapDestination(Controls, Town, Name)
        Else
            Controls.Ui.Message = "Destination save failed; map tiles retained."
        End If

    Else If Action = 89 Or Action = 90 Then

        If Transfers.RequestId = 0 Then
            Call GuideFiles.Choose(Controls.GuideTransfer, Controls.Guide, Action = 89)

            Controls.Ui.Message = Controls.GuideTransfer.Message
        Else
            Controls.Ui.Message = "Finish the current file operation first."
        End If

    Else If Action = 400 Or Key = KEY_TAB Then

        Call Editor.Cancel(Controls, Town)

        Controls.Enabled = False

    Else If (Action >= 300 And
        Action <= 315 Or
        (Action >= 700 And Action < 700 + Library.PERMANENT_COUNT) Or
        (Action >= 500 And Action < 510)) Then

        Call FileCommand(Action)

    End If

End Sub

''' Persistence adopts the document without requesting a spawn or overview camera.
''' The Files UI obtains cross-name confirmation before calling this operation.
Public Function UpdatePermanent(Name As Text) As Boolean

    Dim Ok As Boolean

    Ok = Tabs.UpdatePermanent(OpenTabs, Town, Name)
    Controls.Ui.Message = OpenTabs.Message
    OpenTabs.Message = ""

    If Ok Then
        Call Editor.ResetHistory(Controls, Town)

        Controls.Ui.Section = 2
    End If

    Return Ok

End Function

Public Sub Update(Leader As P.Vector3, Elapsed As Number)

    Dim Ok As Boolean
    Dim Index As Number

    Call World.Update()

    If HaveDocument Then
        Call Map.Update(Town)
    End If

    If LiveTown <> Town.Name Then
        Ready = False
    End If

    If Not Ready Then
        Return
    End If

    MapLoadCooldown = Max(0, MapLoadCooldown - Elapsed)

    If Controls.SectionGesture.Pending Then

        If Ground.PendingRevision <> Town.Surface.Revision Then
            Call Terrain.BeginBuild(Ground, Town)
        End If

        Call Terrain.Update(Ground, Elapsed)

        Controls.Ui.Busy = True
        Controls.Ui.ProgressPercent = Ground.Recipe.Row * 90 / Max(1, Town.Surface.Rows)

        If Ground.Failed Then

            Call SectionTools.Finish(Controls.SectionGesture, Town, False)
            Call Editor.ResetHistory(Controls, Town)
            Call Terrain.BeginBuild(Ground, Town)

        Else If Ground.LiveRevision = Town.Surface.Revision Then

            Call SectionTools.Finish(Controls.SectionGesture, Town, True)
            Call History.Record(Controls.HistoryState, Town, Controls.Guide.Ink)

        Else
            Return

        End If

        Controls.Ui.Message = Controls.SectionGesture.Message

    End If

    If AppliedRevision <> Town.Revision Then

        If Not Decks.Matches(Ground.Recipe.Openings, Town) Then
            Town.Surface.Revision = Town.Surface.Revision + 1
        End If

        Call Renderer.SyncDocument(Assets, Town)

        Ok = ApplyDisplayedLighting()

        If Ground.LiveRevision = Town.Surface.Revision And Controls.Ui.SunSlider.DragOwner = 0 Then
            Call Navigation.Rebuild(Town)
        End If

        AppliedRevision = Town.Revision
        RecoveryClock = 0

    End If

    If (Ground.PendingRevision <> Town.Surface.Revision And
        (Not Controls.TerrainGesture.Active Or Ground.Stage = 0)) Then
        Call Terrain.BeginBuild(Ground, Town)
    End If

    Call Terrain.Update(Ground, Elapsed)

    If Assets.Loaded < Assets.Required Then
        Call Renderer.LoadNext(Assets)
    End If

    Controls.Ui.Busy = Ground.Stage <> 0 Or Transfers.RequestId > 0 Or QueuedSaves.Active Or Assets.Loaded < Assets.Required

    If Assets.Loaded < Assets.Required Then
        Controls.Ui.ProgressPercent = Assets.Loaded * 100 / Max(1, Assets.Required)
        Controls.Ui.Message = "Loading Old Castle..."
    End If

    If Ground.Stage <> 0 Then
        Controls.Ui.ProgressPercent = Ground.Recipe.Row * 90 / Max(1, Town.Surface.Rows)
    End If

    If Ground.Failed Then

        If (Controls.TerrainGesture.Active Or
            Controls.TerrainGesture.Pending Or
            Controls.StyleGesture.Pending) Then

            Call Editor.Cancel(Controls, Town)

            Controls.Ui.Message = "Terrain limit reached; stroke restored."

        Else
            Town.Appearance = LiveAppearance
            Town.TerrainStyle = LiveStyle
            Town.Surface = LiveSurface
            Town.Revision = Town.Revision + 1
            Controls.Ui.Message = "Terrain limit reached; edit reverted."

            Call Editor.ResetHistory(Controls, Town)

        End If

        Call Terrain.BeginBuild(Ground, Town)

    Else If (Ground.LiveRevision = Town.Surface.Revision And
        LiveSurface.Revision <> Town.Surface.Revision) Then

        LiveAppearance = Town.Appearance
        LiveStyle = Town.TerrainStyle
        LiveSurface = Town.Surface

        Call Navigation.Rebuild(Town)

    End If

    Call Editor.AcceptTerrain(Controls, Town, Ground.LiveRevision = Town.Surface.Revision)
    Call Renderer.Update(Assets, Elapsed)
    Call Attachments.Update(Details, Town, Leader, Elapsed)
    Call Editor.UpdateGuideFiles(Controls, Town)

    If Ready And Ground.LiveRevision = Town.Surface.Revision Then

        If Tabs.PreparePicker(OpenTabs, Town) Then
            Call Editor.ResetDocument(Controls, Town)
        End If

    End If

    If Ground.LiveRevision = Town.Surface.Revision Then
        Call RoadTravel.Prepare(Town)
    End If

    Controls.Ui.RoadPreparation = RoadTravel.Preparation()

    RecoveryClock = RecoveryClock + Elapsed

    Showcase.TownName = Town.Name

    If Demo.Advance(Showcase, Elapsed, Ready And Not Editing() And
        Not World.Active() And Not OpenTabs.Menu.Visible And
        Not Files.BlocksEditing(Transfers) And OpenTabs.TabCount > 1) Then

        Ok = Tabs.SelectTab(OpenTabs, Town, Tabs.NextDemo(OpenTabs), False)

        If Ok Then

            TeleportPending = True
            TabOverviewPending = True

            Call Editor.ResetDocument(Controls, Town)

        End If

    End If

    If DemoLightingAlternate <> Demo.AlternateLighting(Showcase) Then
        Ok = ApplyDisplayedLighting()
    End If

    If RecoveryRevision <> Town.Revision And RecoveryClock >= 1500 Then

        Ok = Library.Remember(Town)

        If Ok Then
            RecoveryRevision = Town.Revision
        End If

    End If

    If Transfers.RequestId > 0 Then

        Ok = Files.Update(Transfers, Town, Elapsed)

        If Transfers.RequestId = 0 Or Files.BlocksEditing(Transfers) Then
            Controls.Ui.Message = Transfers.Message
        End If

        Controls.Ui.ProgressPercent = Transfers.Progress
        Controls.Ui.RecentCount = Transfers.RecentCount

        For Index = 0 To Transfers.RecentCount - 1
            Controls.Ui.RecentLabels[Index] = Transfers.RecentLabels[Index]
        End For

        If Ok And Transfers.Operation = Files.SAVE_PERMANENT Then

            Call FinishPermanent()

        Else If Ok Then

            Ok = Tabs.Add(OpenTabs, Town, Transfers.Pending)
            TeleportPending = Ok
            TabOverviewPending = Ok

            If Ok Then
                Call Editor.ResetDocument(Controls, Town)
            End If

        End If

    End If

    If QueuedSaves.Active Then
        Call SaveQueue.Update(QueuedSaves, Transfers, OpenTabs)

        Controls.Ui.Message = Transfers.BatchLabel + " " + Transfers.Message
    End If

End Sub

Private Sub FinishPermanent()

    Dim Active As Number
    Dim Unchanged As Boolean
    Dim Ok As Boolean

    Active = OpenTabs.Active
    Unchanged = Town.Name = Transfers.OriginName And Town.Revision = Transfers.OriginRevision
    Ok = Tabs.UpdatePermanent(OpenTabs, Transfers.Pending, Transfers.Path)
    Transfers.Failed = Not Ok

    If Not Ok Then
        Transfers.Progress = 99
    End If

    Transfers.Message = OpenTabs.Message
    Controls.Ui.Message = Transfers.Message

    If Ok And Unchanged Then

        Town = Transfers.Pending

        Call Editor.ResetHistory(Controls, Town)

    Else

        OpenTabs.Active = Active
        OpenTabs.Documents[Active] = Town

        If Ok Then
            Transfers.Message = "Prepared permanent snapshot saved. Newer edits retained."
        End If

    End If

End Sub

Public Function Draw() As Boolean

    Dim Ok As Boolean
    Dim Light As Document.Sun
    Dim CityIntensity As Number

    Light = Lighting.DisplayedSun(Town, DemoLightingAlternate)
    CityIntensity = -1

    If Town.Name = "Neris Metropolis" Then
        CityIntensity = Light.Intensity
    End If

    If Controls.SectionGesture.Pending Then

        Ok = Terrain.Draw(Ground, CityIntensity)
        Ok = Renderer.Draw(Assets, Controls.SectionGesture.Before, Light.Intensity) And Ok
        Ok = Attachments.Draw(Details, Controls.SectionGesture.Before) And Ok

        Return Ok

    End If

    Ok = Terrain.Draw(Ground, CityIntensity)
    Ok = Renderer.Draw(Assets, Town, Light.Intensity) And Ok
    Ok = Attachments.Draw(Details, Town) And Ok
    Ok = Campfires.Draw(Fires) And Ok

    Return Ok

End Function

Private Function ApplyDisplayedLighting() As Boolean

    Dim Ok As Boolean

    DemoLightingAlternate = Demo.AlternateLighting(Showcase)
    Ok = Lighting.Apply(Lighting.DisplayedSun(Town, DemoLightingAlternate))

    Return Ok

End Function

Public Sub UpdateEffects(View As P.Camera3D, Elapsed As Number)

    If Ready Then
        Call Campfires.Update(Fires, Town, View, Elapsed)
    End If

End Sub

Public Function ApplyLocalLighting() As Boolean

    Dim Ok As Boolean
    Dim Light As Document.Sun

    Light = Lighting.DisplayedSun(Town, Demo.AlternateLighting(Showcase))
    Ok = Lighting.ApplyLocal(Town, Light.Intensity)
    Ok = WaterAppearance.Configure(Town, Light.Intensity) And Ok
    Ok = Lighting.ConfigureBounds(Town) And Ok

    If Not Ok Then
        Controls.Ui.Message = "Night-light capacity reached; some lights are unavailable."
    End If

    Return Ok

End Function

Public Sub Overlay(View As P.Camera3D, Optional Loading As Boolean = False)

    Call Tabs.Draw(OpenTabs, Town)
    Call Toolbar.DrawButton(6, Showcase.Enabled)
    Call Toolbar.DrawButton(7, World.Active())

    If Showcase.Enabled Then
        Call Toolbar.DrawCountdown(Demo.SecondsRemaining(Showcase))
    End If

    If Loading Then

        Call World.Draw(Town.Name, Progress())
        Call Tabs.DrawPicker(OpenTabs)

        Return

    End If

    Call Editor.Draw(Controls, Town, View)
    Call World.Draw()
    Call FileDialog.Draw(Transfers, Controls.Enabled And Controls.Ui.Section = 2)
    Call Tabs.DrawPicker(OpenTabs)

End Sub

Public Function TakeSpawn(ByRef Position As P.Vector3, ByRef Overview As Boolean,
    ByRef Heading As Double) As Boolean

    Dim X As Number
    Dim Z As Number
    Dim Found As Boolean

    If Not TeleportPending Or Ground.LiveRevision <> Town.Surface.Revision Then
        Return False
    End If

    TeleportPending = False
    Overview = TabOverviewPending
    TabOverviewPending = False

    Found = Journey.TakeArrival(GatewayJourney, Town, Position, Heading)

    If Found Then
        TravelPending = False
        Return True
    End If

    If TravelPending And Town.MapTileCount = 0 Then

        TravelPending = False
        Position = TravelArrival
        Position.Y = Navigation.GroundHeight(Position.X, Position.Z)
        Heading = Connections.ArrivalHeading(Town.Name, Position)
        Return True

    End If

    TravelPending = False

    If Journey.Teleport(Town, Position, Heading) Then
        Return True
    End If

    If Town.Landmark > 0 Then

        Position = Connections.Arrival(Document.LandmarkName(Town))
        Heading = Connections.ArrivalHeading(Document.LandmarkName(Town), Position)
        Return True

    End If

    Position = P.Vector(0.0, 23.12, 0.0)

    If Navigation.CanStand(0.0, -2780.0) Then
        Position.Z = -2780.0
    End If

    Found = Navigation.CanStand(Position.X, Position.Z)

    If Not Found Then

        For Z = 0 To Town.Surface.Rows - 1

            For X = 0 To Town.Surface.Columns - 1

                If (Grid.ReadCell(Town.Surface, X, Z) = Grid.SURFACE_ROAD Or
                    Grid.ReadCell(Town.Surface, X, Z) = Grid.SURFACE_GROUND) Then

                    Position.X = (Town.Surface.XEdges[X] + Town.Surface.XEdges[X + 1]) * 0.5
                    Position.Z = (Town.Surface.ZEdges[Z] + Town.Surface.ZEdges[Z + 1]) * 0.5
                    Found = Navigation.CanStand(Position.X, Position.Z)

                    If Found Then
                        Exit For
                    End If

                End If

            End For

            If Found Then
                Exit For
            End If

        End For

    End If

    Position.Y = Navigation.GroundHeight(Position.X, Position.Z)
    Heading = Connections.ArrivalHeading(Town.Name, Position)

    Return True

End Function

''' The active saved surface owns both the floor extent and the map orbit center.
Public Function MapCenter(Optional Height As Double = 150.0) As P.Vector3

    Dim Result As P.Vector3

    Result = P.Vector((Town.Surface.OriginX + Town.Surface.XEdges[Town.Surface.Columns]) * 0.5,
        Height, (Town.Surface.OriginZ + Town.Surface.ZEdges[Town.Surface.Rows]) * 0.5)

    Return Result

End Function

Public Sub ProtectTerrainActor(Index As Number, Position As P.Vector3, MemberCount As Number)

    If Index >= 0 And Index < 8 Then

        Controls.TerrainGesture.ProtectedActors.MemberCount = Min(8, MemberCount)
        Controls.TerrainGesture.ProtectedActors.Positions[Index] = Position
        Controls.RampGesture.ProtectedActors = Controls.TerrainGesture.ProtectedActors

    End If

End Sub

Public Function TerrainGestureActive() As Boolean

    Dim Result As Boolean

    Result = (Controls.TerrainGesture.Active Or Controls.TerrainGesture.Pending Or
        Controls.RampGesture.Stage > 0 Or Controls.WaterGesture.Stage > 0)
    Return Result

End Function

Public Sub SizeArena(ByRef Floor As Arena.ArenaFloor)

    Dim Center As P.Vector3
    Dim Width As Number
    Dim Depth As Number
    Dim Low As P.Vector3
    Dim High As P.Vector3
    Dim FloorY As Number

    If Ground.LiveRevision <> Town.Surface.Revision Then
        Return
    End If

    Center = MapCenter()
    Width = ToNumber(Town.Surface.XEdges[Town.Surface.Columns] - Town.Surface.OriginX)
    Depth = ToNumber(Town.Surface.ZEdges[Town.Surface.Rows] - Town.Surface.OriginZ)

    Call Navigation.SurfaceBounds(Low, High)

    FloorY = ToNumber(Min(-1.0, Low.Y - 2.0))

    If (Floor.Ready And
        Floor.Width = Width And
        Floor.Depth = Depth And
        Floor.Floor.Position.X = ToNumber(Center.X) And
        Floor.Floor.Position.Y = FloorY And
        Floor.Floor.Position.Z = ToNumber(Center.Z)) Then
        Return
    End If

    Call Arena.Destroy(Floor)

    Floor = Arena.Create(Width, Depth, 24, 150, 255, 200, 2)

    Call Arena.Place(Floor, ToNumber(Center.X), FloorY, ToNumber(Center.Z))

End Sub

Public Sub Release()

    Dim Ok As Boolean

    Call RoadTravel.Cancel()

    If HaveDocument Then
        Call Editor.Cancel(Controls, Town)

        Ok = Library.Remember(Town)
    End If

    Call Panel.Release(Controls.Ui)
    Call World.Close()
    Call SaveQueue.Release(QueuedSaves)
    Call Previews.ReleaseFrozen(Transfers.PhotoKey)
    Call Previews.Destroy()
    Call Attachments.Destroy(Details)
    Call Campfires.Destroy(Fires)
    Call Terrain.Destroy(Ground)
    Call Renderer.Destroy(Assets)
    Call Navigation.Disable()

    Ok = G.ClearAdditionalLights3DChecked() And Ok
    Ready = False
    Prepared = False
    DemoCameraPending = False
    TeleportPending = HaveDocument
    TabOverviewPending = HaveDocument

End Sub

Public Function CourtExists() As Boolean

    Dim Result As Boolean

    Result = Town.CourtPlaced

    If Controls.SectionGesture.Pending Then
        Result = Controls.SectionGesture.Before.CourtPlaced
    End If

    Return Result

End Function

Public Function CourtOffset() As P.Vector3

    Dim Result As P.Vector3

    Result = P.Vector(Town.CourtOffsetX, 0.0, Town.CourtOffsetZ)

    If Controls.SectionGesture.Pending Then
        Result = P.Vector(Controls.SectionGesture.Before.CourtOffsetX,
            0.0, Controls.SectionGesture.Before.CourtOffsetZ)
    End If

    Return Result

End Function

Public Function ResidentPlacement() As NpcLayout.State

    Dim Result As NpcLayout.State

    Result = Town.Npcs

    Return Result

End Function

Public Function TownName() As Text

    Dim ReturnValue As Text

    If HaveDocument Then
        ReturnValue = Town.Name

        Return ReturnValue
    End If

    Return "Neris Town"

End Function

Public Function LandmarkKind() As Number

    Dim Result As Number

    Result = Town.Landmark

    Return Result

End Function

Public Function LandmarkRotation() As Double

    Dim ReturnValue As Double

    ReturnValue = Town.LandmarkRotation

    Return ReturnValue

End Function

Public Function BeginWorldPhotograph() As Boolean

    Dim Result As Boolean

    If (Ready And
        AppliedRevision = Town.Revision And
        Ground.LiveRevision = Town.Surface.Revision And
        Not Demo.AlternateLighting(Showcase)) Then
        Result = Previews.Begin(Town)
    End If

    Return Result

End Function

Public Function PreviewActive() As Boolean

    Dim Result As Boolean

    Result = World.Active() Or OpenTabs.Menu.Visible

    Return Result

End Function

''' Read-only coverage query for optional landmarks in expanded town revisions.
Public Function CoversArea(MinX As Double, MinZ As Double, MaxX As Double, MaxZ As Double) As Boolean

    Dim Result As Boolean

    Result = (HaveDocument And Town.Surface.OriginX <= MinX And Town.Surface.OriginZ <= MinZ And
        Town.Surface.XEdges[Town.Surface.Columns] >= MaxX And Town.Surface.ZEdges[Town.Surface.Rows] >= MaxZ)

    Return Result

End Function

Public Sub DrawMap(Position As P.Vector3, Opacity As Number, LeaderName As Text,
    LandmarkName As Text, LandmarkPosition As P.Vector3, AirportName As Text,
    AirportPosition As P.Vector3, Headlight As Image, Yaw As Double,
    Optional StatusY As Number = 533)

    Call Map.Draw(Town, Position, Opacity, LeaderName, LandmarkName, LandmarkPosition,
        AirportName, AirportPosition, Headlight, Yaw)

    If Opacity > 0 Then
        Call Map.DrawDestination(Town, RoadTravel.Target(), RoadTravel.Active(), RoadTravel.Message(), StatusY)
    End If

End Sub

Public Function HasInitialCamera() As Boolean

    Dim ReturnValue As Boolean

    ReturnValue = Town.HasInitialCamera

    Return ReturnValue

End Function

Public Sub FrameDocument(ByRef Camera As P.Camera3D, Optional Overview As Boolean = False)

    Dim Direction As P.Vector3
    Dim Radius As Double
    Dim Angle As Double
    Dim Ok As Boolean

    Direction = Math3D.Subtract(Camera.Position, Camera.Target)

    Ok = Math3D.TryNormalize(Direction, Direction)
    Camera.Target = P.Vector((Town.Surface.OriginX + Town.Surface.XEdges[Town.Surface.Columns]) * 0.5,
        150.0, (Town.Surface.OriginZ + Town.Surface.ZEdges[Town.Surface.Rows]) * 0.5)

    If Overview Then
        Camera = StartingCamera.Frame(Town)

        Return
    End If

    Radius = Sqrt((Town.Surface.XEdges[Town.Surface.Columns] - Town.Surface.OriginX) *
        (Town.Surface.XEdges[Town.Surface.Columns] - Town.Surface.OriginX) +
        (Town.Surface.ZEdges[Town.Surface.Rows] - Town.Surface.OriginZ) *
        (Town.Surface.ZEdges[Town.Surface.Rows] - Town.Surface.OriginZ)) * 0.5
    Angle = Math3D.Radians(Camera.FovDegrees * 0.5)
    Angle = Atan2(Sin(Angle) * Min(1.0, ToDouble(Window_Width()) / ToDouble(Max(1, Window_Height()))), Cos(Angle))
    Camera.Position = Math3D.Add(Camera.Target, Math3D.Scale(Direction, Radius / Sin(Angle)))

End Sub

End Module
