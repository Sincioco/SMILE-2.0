''' World connection gestures and versioned portable document regressions.
Module Smile.Tools.TownWorldTests

Option Explicit

Import Smile.Tools.TownWorldDocument As World
Import Smile.Tools.TownWorldCanvas As Canvas
Import Smile.Tools.TownTabs As Tabs
Import Smile.Tools.TownMapPicker As Picker
Import Smile.Tools.TownDocument As Document
Import Smile.Simple3D.SurfaceGrid3D As Grid
Import Smile.Tools.TownWorldTravel As Travel
Import Smile.Tools.TownDocumentNavigation As Navigation
Import Smile.Tools.TownMapLoads As Tiles

Private Dim Failures As Number
Private Dim Opened As Tabs.State
Private Dim Current As Document.State
Private Dim Incoming As Document.State

Private Sub Check(Ok As Boolean, Label As Text)

    If Not Ok Then
        Failures = Failures + 1
        Print "FAIL " + Label
    End If

End Sub

Public Function Run() As Number

    Dim Map As World.State
    Dim Loaded As World.State
    Dim Gesture As Canvas.State
    Dim Ok As Boolean
    Dim StartX As Number
    Dim StartY As Number
    Dim EndX As Number
    Dim EndY As Number
    Dim Index As Number
    Dim Component As Number
    Dim Bytes[8192] As Number
    Dim Length As Number
    Dim Routes As Travel.State
    Dim Revision As Number
    Dim Status As Number

    Failures = 0

    Ok = Document.Blank(Current, "Preview First", 4, 4, 20.0)
    Current.Revision = 4
    Current.Surface.Revision = 5
    Incoming = Current
    Incoming.Name = "Preview Second"
    Ok = Tabs.Add(Opened, Current, Incoming)

    Call Check(Ok And Current.Surface.Revision > 5,
        "A New Tab Cannot Reuse The Previous Town Terrain Revision")

    Call Check(Picker.Pick(16, 222, 0, 16) = 0 And Picker.Pick(730, 700, 0, 16) = 15,
        "Map Picker Exposes First And Sixteenth Maps At Once")
    Call Check(Picker.Pick(245, 222, 0, 16) = -1 And Picker.Pick(730, 700, 0, 14) = -1,
        "Map Picker Gaps And Empty Rows Cannot Select A Map")
    Call Check(Picker.Pick(450, 470, 0, 16, 600, 80) = 15,
        "Map Picker Hit Targets Follow The Compact Thumbnail Layout")

    Map.Name = "World Ports Fixture"
    Ok = World.Add(Map, "Neris Town", 100, 500)
    Ok = World.Add(Map, "Horizon Airport", 900, 500) And Ok
    StartX = Canvas.X(Gesture, Map, 0, 1000, 2)
    StartY = Canvas.Y(Gesture, Map, 0, 900, 2)
    EndX = Canvas.X(Gesture, Map, 1, 1000, 0)
    EndY = Canvas.Y(Gesture, Map, 1, 900, 0)

    Call Check(Ok And StartX = 300 And EndX = 700 And StartY = 450 And EndY = 450,
        "World Ports Sit At The Centers Of Town Edges")

    Ok = Canvas.Gesture(Gesture, Map, 180, 450, True, True, True, 1000, 900, 1000)
    Ok = Canvas.Gesture(Gesture, Map, 180, 450, False, False, True, 1000, 900, 1050)
    Ok = Canvas.Gesture(Gesture, Map, 182, 450, True, True, True, 1000, 900, 1200)

    Call Check(Gesture.EnterRequested And Gesture.Selected = 0 And Not Gesture.DragNode,
        "Double Click Enters The Town Without Moving Its Card")

    Gesture.EnterRequested = False
    Ok = Canvas.Gesture(Gesture, Map, 180, 450, True, True, True, 1000, 900, 2000)
    Ok = Canvas.Gesture(Gesture, Map, 190, 450, False, True, True, 1000, 900, 2100)
    Ok = Canvas.Gesture(Gesture, Map, 190, 450, False, False, True, 1000, 900, 2120)
    Ok = Canvas.Gesture(Gesture, Map, 190, 450, True, True, True, 1000, 900, 2200)

    Call Check(Not Gesture.EnterRequested, "Dragging A Town Does Not Become A Double Click")

    Ok = Canvas.Gesture(Gesture, Map, 190, 450, False, False, True, 1000, 900, 2230)
    Map.Nodes[0].X = 100
    Gesture.ClickNode = 0

    Ok = Canvas.Gesture(Gesture, Map, StartX, StartY, True, True, True, 1000, 900)

    Ok = Canvas.Gesture(Gesture, Map, EndX, EndY, False, False, True, 1000, 900)

    Call Check(Not Map.Links[0, 1] And Not Map.Links[1, 0],
        "Dragging Between Former Yellow Handles Cannot Create A Route")

    Map.Links[0, 1] = True
    Map.Links[1, 0] = True
    Map.Ports[0, 1] = 1
    Map.Ports[1, 0] = 3
    Ok = Canvas.Gesture(Gesture, Map, 500, 450, True, True, True, 1000, 900)

    Call Check(Not Ok And Map.Links[0, 1] And Map.Links[1, 0],
        "Clicking A Displayed Route Cannot Delete It")

    Ok = True
    Ok = World.SaveWorld(Map, "TownEditor.World.PortFixture") And Ok
    Ok = World.LoadWorld(Loaded, "", "TownEditor.World.PortFixture") And Ok

    Call Check(Ok And Loaded.Name = Map.Name And Not Loaded.Links[0, 1] And
        Not Loaded.Links[1, 0], "Portable World Keeps Layout And Discards Cached Connections")

    Load Data "TownEditor.World.PortFixture" Into Bytes Count Length Status Status
    Bytes[0] = 1

    For Index = 0 To 3

        For Component = 0 To 2
            Bytes[Length - 24 + Index * 3 + Component] = Bytes[Length - 24 + Index * 6 + Component]
        End For
    End For

    Save Data Bytes Count Length - 12 To "TownEditor.World.LegacyFixture" Status Status
    Ok = World.LoadWorld(Loaded, "", "TownEditor.World.LegacyFixture")

    Call Check(Ok And Not Loaded.Links[0, 1] And Not Loaded.Links[1, 0],
        "Old Manual World Links Cannot Become Travel Authority")

    Bytes[0] = 99
    Save Data Bytes Count Length - 12 To "TownEditor.World.BadFixture" Status Status
    Ok = World.LoadWorld(Loaded, "", "TownEditor.World.BadFixture")

    Call Check(Not Ok And Loaded.Name = Map.Name And Loaded.NodeCount = 2,
        "Invalid World File Does Not Replace The Current World")

    Ok = World.Add(Map, "Neris Spaceport", 500, 100)
    Map.Links[0, 2] = True
    Map.Links[2, 0] = True
    Map.Ports[0, 2] = 3
    Map.Ports[2, 0] = 1

    Call World.Remove(Map, 1)
    Call Check(Ok And Map.NodeCount = 2 And Map.Nodes[1].Town = "Neris Spaceport" And
        Map.Links[0, 1] And Map.Ports[0, 1] = 3 And Map.Ports[1, 0] = 1,
        "Removing A Town Preserves The Other Towns And Their Connection Endpoints")

    Ok = Canvas.Gesture(Gesture, Map, Canvas.X(Gesture, Map, 1, 1000) + 10,
        Canvas.Y(Gesture, Map, 1, 900), True, True, True, 1000, 900)
    Ok = Canvas.Gesture(Gesture, Map, 670, 350, False, True, True, 1000, 900)

    Call Check(Ok And Map.Nodes[1].X = 700 And Map.Nodes[1].Y = 300,
        "Dragging A Town Preserves The Pointer Offset")

    Ok = Canvas.Gesture(Gesture, Map, 670, 350, False, False, True, 1000, 900)

    Call Check(Not Gesture.DragNode, "Releasing A Town Ends The Move")

    Ok = World.Add(Map, "Far Journey", 1900, 1290)
    Ok = World.SaveWorld(Map, "TownEditor.World.LargeFixture") And Ok
    Ok = World.LoadWorld(Loaded, "", "TownEditor.World.LargeFixture") And Ok

    Call Check(Ok And Loaded.Nodes[2].X = 1900 And Loaded.Nodes[2].Y = 1290,
        "Expanded Atlas Coordinates Survive Save And Reopen")
    Call Canvas.Fit(Gesture, Loaded, 1132, 994)

    Call Check(Canvas.X(Gesture, Loaded, 2, 1132, 2) <= 1132 And
        Canvas.Y(Gesture, Loaded, 2, 994, 3) < 930,
        "Reset View Frames The Distant Journey Card")

    Ok = World.SaveWorld(Map)
    Ok = World.LoadWorld(Loaded, "", "TownEditor.World.Last") And Ok

    Call Check(Ok And Loaded.Name = Map.Name And Loaded.NodeCount = Map.NodeCount,
        "Last World Snapshot Reopens Without A File Picker")

    Ok = Document.Blank(Current, "Neris Town", 20, 20, 30.0)

    Call Grid.PaintRectangle(Current.Surface, 0, 0, 19, 19, Grid.SURFACE_ROAD)

    Ok = Tiles.PlaceRectangle(Current, 0, 8, 1, 9, "Obsolete Destination")
    Ok = Tiles.PlaceRectangle(Current, 18, 8, 19, 9, "Neris Spaceport") And Ok

    Revision = Current.Revision

    Call Travel.ReadTown(Map, 0, Current)
    Call Check(Map.Links[0, 1] And Map.Ports[0, 1] = 2 And Not Map.Links[0, 2],
        "Yellow Destinations Define Routes And Actual Map Sides")
    Call Check(Current.MapTileCount = 8 And Current.Revision = Revision And
        Current.MapTiles[0].Destination = "Obsolete Destination",
        "Atlas Never Deletes Yellow Areas Whose Destination Is Outside The Atlas")

    Current.MapTileCount = 0

    Call Travel.ReadTown(Map, 0, Current)
    Call Check(Not Map.Links[0, 1] And Current.MapTileCount = 0,
        "Deleting The Last Yellow Area Removes Only Its Outgoing Route")

    Ok = Tiles.PlaceRectangle(Current, 0, 8, 1, 9, "Far Journey")

    Call Travel.ReadTown(Map, 0, Current)
    Call Check(Ok And Map.Links[0, 2] And Not Map.Links[0, 1] And Map.Ports[0, 2] = 0,
        "Reassigned Yellow Areas Change Destination And Connection Side")

    Opened.TabCount = 1
    Opened.Documents[0] = Current

    Call Travel.Reset(Routes, Map)
    Call Travel.Update(Routes, Map, Opened)
    Call Check(Map.Links[0, 2] And Not Map.Links[2, 0],
        "A One Way Yellow Area Does Not Invent A Return Route")

    Opened.Documents[0].MapTileCount = 0
    Opened.Documents[0].Revision = Opened.Documents[0].Revision + 1

    Call Travel.Update(Routes, Map, Opened)
    Call Check(Not Map.Links[0, 2], "Unsaved Open Town Edits Refresh The Atlas")

    Return Failures

End Function

End Module
