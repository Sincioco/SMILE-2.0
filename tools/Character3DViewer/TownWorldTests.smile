''' World connection gestures and versioned portable document regressions.
Module Smile.Tools.TownWorldTests

Option Explicit

Import Smile.Tools.TownWorldDocument As World
Import Smile.Tools.TownWorldCanvas As Canvas

Private Dim Failures As Number

Private Sub Check(Ok As Boolean, Label As Text)

    If Not Ok Then
        Failures = Failures + 1
        Print "FAIL " + Label
    End If

End Sub

Public Function Run() As Number

    Dim Map As World.State
    Dim Loaded As World.State
    Dim Gesture As Canvas.State
    Dim Ok As Boolean
    Dim StartX As Number
    Dim StartY As Number
    Dim EndX As Number
    Dim EndY As Number
    Dim Index As Number
    Dim Component As Number
    Dim Bytes[8192] As Number
    Dim Length As Number
    Dim Status As Number

    Failures = 0
    Map.Name = "World Ports Fixture"
    Ok = World.Add(Map, "Neris Town", 100, 500)
    Ok = World.Add(Map, "Horizon Airport", 900, 500) And Ok
    StartX = Canvas.X(Gesture, Map, 0, 1000, 2)
    StartY = Canvas.Y(Gesture, Map, 0, 900, 2)
    EndX = Canvas.X(Gesture, Map, 1, 1000, 0)
    EndY = Canvas.Y(Gesture, Map, 1, 900, 0)

    Call Check(Ok And StartX = 300 And EndX = 700 And StartY = 450 And EndY = 450,
        "World Ports Sit At The Centers Of Town Edges")

    Ok = Canvas.Gesture(Gesture, Map, StartX, StartY, True, True, True, 1000, 900)

    Call Check(Gesture.DragPort And Not Ok And Not Map.Links[0, 1],
        "World Connection Starts As A Preview")

    Ok = Canvas.Gesture(Gesture, Map, EndX, EndY, False, False, True, 1000, 900)

    Call Check(Ok And Map.Links[0, 1] And Map.Links[1, 0] And
        Map.Ports[0, 1] = 2 And Map.Ports[1, 0] = 0,
        "Dropping A Port Creates A Bidirectional Connection At The Chosen Edges")

    Ok = Canvas.Gesture(Gesture, Map, 500, 450, True, True, True, 1000, 900)

    Call Check(Gesture.PendingDelete And Not Ok And Map.Links[0, 1],
        "Clicking A Connection Prompts Before Deleting")

    Ok = Canvas.ConfirmDelete(Gesture, Map, False)

    Call Check(Not Ok And Map.Links[0, 1], "Cancel Keeps The World Connection")

    Ok = Canvas.Gesture(Gesture, Map, 500, 450, True, True, True, 1000, 900)
    Ok = Canvas.ConfirmDelete(Gesture, Map, True)

    Call Check(Ok And Not Map.Links[0, 1] And Not Map.Links[1, 0],
        "Confirmed Connection Delete Removes Both Directions")

    Ok = Canvas.Gesture(Gesture, Map, StartX, StartY, True, True, True, 1000, 900)
    Ok = Canvas.Gesture(Gesture, Map, 500, 700, False, False, True, 1000, 900)

    Call Check(Not Ok And Not Map.Links[0, 1], "Dropping On Empty Canvas Cancels The Connection")

    Ok = World.Connect(Map, 0, 1, 0, 3)

    Call Check(Not Ok And Not Map.Links[0, 0], "A World Node Cannot Connect To Itself")

    Ok = World.Connect(Map, 0, 1, 1, 3)
    Ok = World.SaveWorld(Map, "TownEditor.World.PortFixture") And Ok
    Ok = World.LoadWorld(Loaded, "", "TownEditor.World.PortFixture") And Ok

    Call Check(Ok And Loaded.Name = Map.Name And Loaded.Ports[0, 1] = 1 And
        Loaded.Ports[1, 0] = 3, "Portable World Opens Without Typing A Name And Preserves Ports")

    Load Data "TownEditor.World.PortFixture" Into Bytes Count Length Status Status
    Bytes[0] = 1

    For Index = 0 To 3

        For Component = 0 To 2
            Bytes[Length - 24 + Index * 3 + Component] = Bytes[Length - 24 + Index * 6 + Component]
        End For
    End For

    Save Data Bytes Count Length - 12 To "TownEditor.World.LegacyFixture" Status Status
    Ok = World.LoadWorld(Loaded, "", "TownEditor.World.LegacyFixture")

    Call Check(Ok And Loaded.Links[0, 1] And Loaded.Ports[0, 1] = 2 And
        Loaded.Ports[1, 0] = 0, "Old Worlds Retain Connections With Default Facing Ports")

    Bytes[0] = 99
    Save Data Bytes Count Length - 12 To "TownEditor.World.BadFixture" Status Status
    Ok = World.LoadWorld(Loaded, "", "TownEditor.World.BadFixture")

    Call Check(Not Ok And Loaded.Name = Map.Name And Loaded.NodeCount = 2,
        "Invalid World File Does Not Replace The Current World")

    Ok = World.Add(Map, "Neris Spaceport", 500, 100)
    Ok = World.Connect(Map, 0, 3, 2, 1) And Ok

    Call World.Remove(Map, 1)
    Call Check(Ok And Map.NodeCount = 2 And Map.Nodes[1].Town = "Neris Spaceport" And
        Map.Links[0, 1] And Map.Ports[0, 1] = 3 And Map.Ports[1, 0] = 1,
        "Removing A Town Preserves The Other Towns And Their Connection Endpoints")

    Ok = Canvas.Gesture(Gesture, Map, Canvas.X(Gesture, Map, 1, 1000) + 10,
        Canvas.Y(Gesture, Map, 1, 900), True, True, True, 1000, 900)
    Ok = Canvas.Gesture(Gesture, Map, 670, 350, False, True, True, 1000, 900)

    Call Check(Ok And Map.Nodes[1].X = 700 And Map.Nodes[1].Y = 300,
        "Dragging A Town Preserves The Pointer Offset")

    Ok = Canvas.Gesture(Gesture, Map, 670, 350, False, False, True, 1000, 900)

    Call Check(Not Gesture.DragNode, "Releasing A Town Ends The Move")

    Return Failures

End Function

End Module
