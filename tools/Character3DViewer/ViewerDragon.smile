''' Red Dragon actor, animation, presentation effects and lifecycle ownership.
Module Smile.Tools.Character3DViewerDragon

Option Explicit

Import Smile.Simple3D.Character3D As Character3D
Import Smile.Simple3D.Core As Core
Import Smile.Simple3D.FireEmitter3D As Fire
Import Smile.Simple3D.Graphics3D As Graphics3D
Import Smile.Simple3D.LightPool3D As LightPool3D
Import Smile.Simple3D.Math3D As Math3D
Import Smile.Simple3D.Precision3D As Precision3D
Import Smile.Simple3D.PrecisionMath3D As PreciseMath
Import Smile.Simple3D.LightningVfx3D As Lightning
Import Smile.Simple3D.NodeAim3D As NodeAim3D
Import Smile.Tools.BattleAudio As BattleAudio
Import Smile.Tools.Character3DViewerProfiles As ViewerProfiles
Import Smile.Tools.Character3DViewerActors As ViewerActors
Import Smile.Simple3D.PrecisionCamera3D As PrecisionCamera
Import Smile.Simple3D.CharacterViewer As CharacterViewer
Import Smile.Tools.DragonPresence As DragonPresence

Private Const ASSET_PATH = "Assets\Generation2\RedDragon\RedDragon.sm3d"
Private Const SCALE_PERCENT = 25000
Private Const POSITION_X = -208
Private Const POSITION_Z = -120
Private Const ROTATION_Y = 240
Private Const BODY_PART_INDEX = 2

Public Const DRAGON_BREATH_RADIUS = 16
Public Const DRAGON_BREATH_INTENSITY = 300
Public Const VRAX_BREATH_RADIUS = 24
Public Const VRAX_BREATH_INTENSITY = 320
Private Const VRAX_BREATH_REACH = 420
Private Const VRAX_BREATH_SPEED = 900

Public Type AttackEffects
    MouthFire As Fire.FireEmitter
    LeftArc As Lightning.LightningEffect
    RightArc As Lightning.LightningEffect
    Clip As Text
    Time As Number
    FireTime As Number
    LightningTime As Number
    Epoch As Number
    FireWasPaused As Boolean
    LightningWasPaused As Boolean
End Type

Public Type State
    Actor As Character3D.Actor
    UseVrax As Boolean
    Attacks As AttackEffects
    Frame As PrecisionCamera.Framing
    HeadAim As NodeAim3D.Constraint
    Clip As Text
    HeadTracking As Boolean
    Breath As Fire.FireEmitter
    FireFailed As Boolean
    Available As Boolean
    Visible As Boolean
    OwnsActor As Boolean
    FireClip As Text
    FireTime As Number
    FireEpoch As Number
    FireWasPaused As Boolean
    Audio As BattleAudio.CueState
End Type

Public Sub SetAvailable(ByRef Value As State, Available As Boolean)

    Value.Available = Available
    Value.Visible = Available

End Sub

Public Sub ResetVisibility(ByRef Value As State)

    Value.Visible = Value.Available

End Sub

Public Sub CaptureInspectedActor(ByRef Value As State,
    ByRef Actor As Character3D.Actor, Clip As Text)

    Value.Actor = Actor
    Value.Clip = Clip

End Sub

Public Function ScalePercent() As Number

    Return SCALE_PERCENT

End Function

Public Function PositionX() As Number

    Return POSITION_X

End Function

Public Function PositionZ() As Number

    Return POSITION_Z

End Function

Public Function RotationY() As Number

    Return ROTATION_Y

End Function

Public Sub InitializeEffects()

    Call DragonPresence.Initialize()

End Sub

Public Function Create(ByRef Value As State, ByRef BorrowedActor As Character3D.Actor,
    Inspection As Boolean) As Boolean

    Dim Profile As CharacterViewer.Profile
    Dim Bounds As Character3D.Bounds3D
    Dim Path As Text
    Dim EmptyLight As LightPool3D.Lease
    Dim Result As Boolean

    If Not Value.Available Then
        Return True
    End If

    Path = ASSET_PATH

    If Value.UseVrax Then
        Profile = ViewerProfiles.ProfileAt(ViewerProfiles.PROFILE_VRAX)
        Path = Profile.AssetPath
    End If

    Value.OwnsActor = Not Inspection

    If Inspection Then
        Value.Actor = BorrowedActor
    Else
        Value.Actor = Character3D.LoadWithPolicy(
            Path,
            Character3D.CHARACTER_LOAD_REQUIRE_PBR
        )
    End If

    Result = Character3D.IsValid(Value.Actor)
    Value.FireFailed = False
    Value.Clip = "Idle"
    Value.HeadTracking = True

    If Value.UseVrax And Result Then

        Bounds = Character3D.LocalBounds(Value.Actor)
        Value.Frame = PrecisionCamera.AutoFit(Profile, Bounds, 0, 0, 55.0,
            ViewerProfiles.MaximumFitScale(Profile))
        Value.Frame.PositionX = ToDouble(POSITION_X)
        Value.Frame.PositionZ = ToDouble(POSITION_Z)
        Value.HeadTracking = False
        Result = Character3D.SetScale(Value.Actor, Value.Frame.ScalePercent)
        Result = Character3D.PlacePrecise(Value.Actor, Value.Frame.PositionX,
            Value.Frame.PositionY, Value.Frame.PositionZ) And Result
        Result = Character3D.Rotate(Value.Actor, 0, ROTATION_Y, 0) And Result
        Result = Character3D.PlayAnimation(Value.Actor, "Idle", True) And Result
        Result = Character3D.SetShadows(Value.Actor, True, True) And Result

        Return Result

    End If

    If Result Then

        Result = Character3D.SetScale(Value.Actor, SCALE_PERCENT) And Result
        Result = Character3D.Place(Value.Actor, POSITION_X, 0, POSITION_Z) And Result
        Result = Character3D.Rotate(Value.Actor, 0, ROTATION_Y, 0) And Result
        Result = Character3D.PlayAnimation(Value.Actor, Value.Clip, True) And Result
        Result = NodeAim3D.Configure(
            Value.HeadAim,
            Value.Actor,
            "Head",
            Math3D.Vector(0, 1, 0),
            Math3D.Vector(35, 0, 45)
        ) And Result

    End If

    If Not Result Then
        Call Destroy(Value, EmptyLight)
    End If

    Return Result

End Function

Public Function IsValid(ByRef Value As State) As Boolean

    Dim Result As Boolean

    Result = Value.Available And Character3D.IsValid(Value.Actor)

    Return Result

End Function

Public Function Draw(ByRef Value As State) As Boolean

    Dim Result As Boolean

    Result = IsValid(Value)

    If Result Then
        Result = Character3D.Draw(Value.Actor)
    End If

    Return Result

End Function

Public Sub DrawEffects(ByRef Value As State)

    If Value.UseVrax Then
        Call DrawVraxAttacks(Value.Attacks)

        Return
    End If

    Call DragonPresence.Draw()

    If Value.Visible And Value.Breath.Slot <> 0 Then
        Value.FireFailed = Not Fire.Draw(Value.Breath)
    End If

End Sub

Public Sub ClearOwnedEffects(ByRef Value As State, Light As LightPool3D.Lease)

    Dim Ok As Boolean

    Call ClearVraxAttacks(Value.Attacks)

    If Value.Breath.Slot <> 0 Then
        Ok = Fire.Destroy(Value.Breath)
    End If

    If Value.Breath.Slot = 0 Then
        Value.FireFailed = False
    End If

    Call DragonPresence.Cancel(Light)

End Sub

Public Sub Destroy(ByRef Value As State, Light As LightPool3D.Lease)

    Call ClearOwnedEffects(Value, Light)

    If Value.OwnsActor Then
        Call Character3D.Destroy(Value.Actor)
    Else
        Value.Actor.Handle = 0
    End If

    Value.OwnsActor = False

End Sub

Public Sub Shutdown(ByRef Value As State, Light As LightPool3D.Lease)

    Call Destroy(Value, Light)
    Call DragonPresence.Shutdown()

End Sub

Public Sub ToggleVisible(ByRef Value As State, Light As LightPool3D.Lease)

    If Not Value.Available Then
        Return
    End If

    Value.Visible = Not Value.Visible

    If Not Value.Visible Then
        Call ClearOwnedEffects(Value, Light)
    End If

End Sub

Public Sub ToggleHeadTracking(ByRef Value As State)

    Value.HeadTracking = Not Value.HeadTracking

End Sub

Public Function DesiredClip(
    ByRef Value As State,
    Inspection As Boolean,
    SelectedClipName As Text,
    PartyEnabled As Boolean,
    ScenePaused As Boolean,
    PartyTurn As Number,
    DragonCounter As Number,
    ReactionRequested As Boolean
) As Text

    Dim Result As Text

    Result = "Idle"

    If PartyEnabled And ScenePaused Then

        Result = Value.Clip

    Else If Inspection Then

        Result = SelectedClipName

    Else If PartyEnabled And PartyTurn = 2 Then

        If DragonCounter Mod 3 = 0 Then
            Result = "FireBreath"
        Else If DragonCounter Mod 3 = 1 Then
            Result = "ClawStrike"
        Else
            Result = "Fireball"
        End If

    Else If ReactionRequested Then

        Result = "Hit"

    Else If Value.Clip = "Hit" And Character3D.AnimationTime(Value.Actor) < 800 Then

        Result = "Hit"

    End If

    Return Result

End Function

Public Function Update(
    ByRef Value As State,
    Name As Text,
    Inspection As Boolean,
    PlaybackSpeed As Number,
    AnimationElapsed As Number,
    Target As Core.Vector3,
    VisualContinuityEpoch As Number,
    FlamePaused As Boolean,
    FireInitialized As Boolean,
    Light As LightPool3D.Lease
) As Boolean

    Dim Mouth As Core.Vector3
    Dim Direction As Core.Vector3
    Dim Time As Number
    Dim Travel1000 As Number
    Dim Breathe As Boolean
    Dim Ok As Boolean
    Dim Result As Boolean

    Result = True

    If Value.UseVrax Then
        Result = UpdateVraxPreview(Value, Name, PlaybackSpeed, AnimationElapsed)

        Return Result
    End If

    If Not IsValid(Value) Then
        Call ClearOwnedEffects(Value, Light)

        Return True
    End If

    If Not Value.Visible Then
        Call ClearOwnedEffects(Value, Light)

        Return True
    End If

    If Name <> Value.Clip Then

        Value.Clip = Name

        If Inspection Then

            ''' The shared inspector already selected playback mode and timeline time.

        Else If Name = "Idle" Then

            Result = Character3D.PlayMode(
                Value.Actor,
                Name,
                Graphics3D.ANIMATION_LOOP,
                PlaybackSpeed
            ) And Result

        Else
            Result = Character3D.PlayMode(
                Value.Actor,
                Name,
                Graphics3D.ANIMATION_ONCE,
                PlaybackSpeed
            ) And Result

        End If

    End If

    If Not Inspection Then
        Result = Character3D.Update(Value.Actor, AnimationElapsed) And Result
    End If

    Time = Character3D.AnimationTime(Value.Actor)
    Travel1000 = ClawTravel1000(Name, Time)
    Result = Character3D.Place(
        Value.Actor,
        POSITION_X + 79 * Travel1000 / 1000,
        0,
        POSITION_Z + 30 * Travel1000 / 1000
    ) And Result
    Result = NodeAim3D.Update(
        Value.HeadAim,
        Value.Actor,
        Target,
        AnimationElapsed,
        Value.HeadTracking And
            (Name = "FireBreath" Or Name = "Fireball" Or Name = "ClawStrike")
    ) And Result

    ''' Explicit seeks/cuts outrank freeze; normal frozen playback retains its snapshot.
    ''' Resume from a different action/time rebases impact cues instead of replaying them.

    If (Value.FireEpoch <> VisualContinuityEpoch Or
        (FlamePaused And Name <> Value.FireClip) Or
        (Value.FireWasPaused And Not FlamePaused And
            (Name <> Value.FireClip Or Time <> Value.FireTime))) Then
        Call ClearOwnedEffects(Value, Light)
    End If

    Value.FireEpoch = VisualContinuityEpoch
    Value.FireClip = Name

    If FlamePaused Then
        Value.FireWasPaused = True
        Return Result
    End If

    Value.FireWasPaused = False
    Value.FireTime = Time
    Breathe = Value.Visible And Name = "FireBreath" And Time >= 850 And Time < 3100

    If (Breathe And
        FireInitialized And
        Not Value.FireFailed) Then

        Mouth = Character3D.SocketPosition(Value.Actor, "Mouth")

        If Value.Breath.Slot = 0 Then
            Value.Breath = Fire.StartAt(
                "DragonFireBreathPreview",
                Mouth,
                3117,
                Fire.QUALITY_HIGH,
                Fire.SIMULATION_AUTO,
                DRAGON_BREATH_RADIUS
            )
            ''' Temporary scene pressure can recover without reloading the actor.
            Value.FireFailed = (Value.Breath.Slot = 0 And
                Fire.Value(12, Value.Breath) <> Fire.ERROR_CAPACITY)
        End If

        If Value.Breath.Slot <> 0 Then

            Direction = Math3D.Subtract(Target, Mouth)
            Direction.X = Direction.X * 2
            Direction.Y = Direction.Y * 2
            Direction.Z = Direction.Z * 2
            Ok = Fire.SetPosition(Value.Breath, Mouth)
            Ok = Fire.SetDirection(Value.Breath, Direction) And Ok
            Value.FireFailed = Not Ok

            Call Fire.SetIntensity(Value.Breath, DRAGON_BREATH_INTENSITY)
            Call Fire.SetSourceVelocityInheritance(Value.Breath, 0)

        End If

    Else If Value.Breath.Slot <> 0 Then

        Ok = Fire.Destroy(Value.Breath)

    End If

    Call DragonPresence.Update(
        Value.Actor,
        Name,
        Time,
        Target,
        Value.Visible And FireInitialized,
        Light
    )

    Return Result

End Function

Public Function ClawTravel1000(Name As Text, Time As Number) As Number

    Dim Result As Number

    Result = 0

    If Name = "ClawStrike" Then

        Result = Min(1000, Time * 1000 / 1100)

        If Time > 1100 Then
            Result = Max(0, (2200 - Time) * 1000 / 1100)
        End If

        Result = Result * Result / 1000 * (3000 - 2 * Result) / 1000

    End If

    Return Result

End Function

Public Sub UpdateAudio(ByRef Value As State, Audible As Boolean)

    Dim CueTime As Number

    If Not IsValid(Value) Then
        Return
    End If

    CueTime = -1

    If Value.Clip = "FireBreath" Then
        CueTime = 100
    Else If Value.Clip = "ClawStrike" Then
        CueTime = 200
    End If

    If BattleAudio.CrossedCue(
        Value.Audio,
        Value.Clip,
        Character3D.AnimationTime(Value.Actor),
        CueTime,
        Audible And Value.Visible
    ) Then

        If Value.Clip = "FireBreath" Then

            Play Sound "Assets/Audio/dragon-fire-breath.wav"

        Else

            Play Sound "Assets/Audio/dragon-claw-strike.wav"

        End If

    End If

End Sub

Public Function UpdateVraxPreview(ByRef Value As State, Name As Text,
    PlaybackSpeed As Number, Elapsed As Number) As Boolean

    Dim Clip As Number
    Dim Index As Number
    Dim Mode As Number
    Dim Result As Boolean

    Result = True

    If Not IsValid(Value) Or Not Value.Visible Then
        Return Result
    End If

    If Name <> Value.Clip Then

        Mode = Graphics3D.ANIMATION_ONCE

        If Name = "Idle" Then
            Mode = Graphics3D.ANIMATION_LOOP
        End If

        Result = Character3D.PlayMode(Value.Actor, Name, Mode, PlaybackSpeed)
        Value.Clip = Name

    End If

    Result = Character3D.Update(Value.Actor, Elapsed) And Result

    For Index = 0 To Character3D.ClipCount(Value.Actor) - 1

        If Character3D.ClipName(Value.Actor, Index) = Value.Clip Then
            Clip = Index
        End If

    End For

    Result = ViewerActors.ApplyPresentationOffset(Value.Actor,
        ViewerProfiles.PROFILE_VRAX, Clip, Value.Frame) And Result

    Return Result

End Function

''' Attack windows follow clip time, so speed changes and inspector seeks stay aligned.
Public Function VraxAttackActive(Name As Text, Time As Number, Duration As Number) As Boolean

    Dim Result As Boolean

    Result = (Name = "Attack" Or Name = "Attack2" Or Name = "Attack3" Or
        Name = "Attack4" Or Name = "Attack5" Or Name = "Attack6")
    Result = (Result And Duration > 0 And Time >= Duration / 6 And
        Time < Duration * 4 / 5)

    Return Result

End Function

Public Sub ClearVraxAttacks(ByRef Value As AttackEffects)

    Dim Ok As Boolean

    If Value.MouthFire.Slot <> 0 Then
        Ok = Fire.Destroy(Value.MouthFire)
    End If

    Call ClearVraxLightning(Value)

End Sub

Private Sub ClearVraxLightning(ByRef Value As AttackEffects)

    Dim Ok As Boolean

    If Value.LeftArc.Slot <> 0 Then
        Ok = Lightning.Destroy(Value.LeftArc)
    End If

    If Value.RightArc.Slot <> 0 Then
        Ok = Lightning.Destroy(Value.RightArc)
    End If

End Sub

Public Sub DrawVraxAttacks(ByRef Value As AttackEffects)

    Dim Ok As Boolean

    If Value.MouthFire.Slot <> 0 Then
        Ok = Fire.Draw(Value.MouthFire)
    End If

    ''' Lightning is submitted once by the existing scene-wide draw owner.

End Sub

Public Sub UpdateVraxAttacks(ByRef Value As AttackEffects, Actor As Character3D.Actor,
    Name As Text, Enabled As Boolean, FireReady As Boolean, LightningReady As Boolean,
    FirePaused As Boolean, LightningPaused As Boolean, Epoch As Number)

    Dim Mouth As Precision3D.Vector3
    Dim Aim As Precision3D.Vector3
    Dim LeftArm As Precision3D.Vector3
    Dim RightArm As Precision3D.Vector3
    Dim Forward As Precision3D.Vector3
    Dim Target As Precision3D.Vector3
    Dim Duration As Number
    Dim Index As Number
    Dim Ok As Boolean

    If Not Enabled Or Not Character3D.IsValid(Actor) Then
        Call ClearVraxAttacks(Value)

        Return
    End If

    For Index = 0 To Character3D.ClipCount(Actor) - 1

        If Character3D.ClipName(Actor, Index) = Name Then
            Duration = Character3D.ClipDuration(Actor, Index)
        End If

    End For

    If (Not Character3D.HasSocket(Actor, "VraxMouth") Or
        Not Character3D.HasSocket(Actor, "VraxMouthAim") Or
        Not Character3D.HasSocket(Actor, "VraxLeftArm") Or
        Not Character3D.HasSocket(Actor, "VraxRightArm")) Then
        Call ClearVraxAttacks(Value)

        Return
    End If

    Ok = Character3D.TrySocketPositionPrecise(Actor, "VraxMouth", 0, False, Mouth)
    Ok = Character3D.TrySocketPositionPrecise(Actor, "VraxMouthAim", 0, False, Aim) And Ok
    Ok = Character3D.TrySocketPositionPrecise(Actor, "VraxLeftArm", 0, False, LeftArm) And Ok
    Ok = Character3D.TrySocketPositionPrecise(Actor, "VraxRightArm", 0, False, RightArm) And Ok
    Ok = PreciseMath.TryNormalize(PreciseMath.Subtract(Aim, Mouth), Forward) And Ok
    Target = PreciseMath.Add(Mouth,
        PreciseMath.Scale(Forward, ToDouble(VRAX_BREATH_REACH)))
    Target.Y = Max(12.0, Target.Y)

    Call UpdateVraxAttackPoints(Value, Name, Character3D.AnimationTime(Actor), Duration,
        Mouth, LeftArm, RightArm, Target, Ok, FireReady, LightningReady,
        FirePaused, LightningPaused, Epoch)

End Sub

''' Caller-owned admission; neither caller advances or resets the shared VFX pools.
Public Sub UpdateVraxAttackPoints(ByRef Value As AttackEffects, Name As Text,
    Time As Number, Duration As Number, Mouth As Precision3D.Vector3,
    LeftArm As Precision3D.Vector3, RightArm As Precision3D.Vector3,
    Target As Precision3D.Vector3, Enabled As Boolean,
    FireReady As Boolean, LightningReady As Boolean,
    FirePaused As Boolean, LightningPaused As Boolean, Epoch As Number)

    Dim Forward As Precision3D.Vector3
    Dim Direction As Core.Vector3
    Dim Ok As Boolean
    Dim Active As Boolean

    If (Value.Epoch <> Epoch Or
        Value.Clip <> Name Or
        Time < Value.Time) Then
        Call ClearVraxAttacks(Value)
    End If

    Active = Enabled And VraxAttackActive(Name, Time, Duration)

    If Not Active Then

        Call ClearVraxAttacks(Value)

    Else

        If (Value.FireWasPaused And
            Not FirePaused And
            Time <> Value.FireTime) Then
            Ok = Fire.Destroy(Value.MouthFire)
        End If

        If (Value.LightningWasPaused And
            Not LightningPaused And
            Time <> Value.LightningTime) Then
            Call ClearVraxLightning(Value)
        End If

        If FireReady And Not FirePaused Then

            If Value.MouthFire.Slot = 0 Then
                Value.MouthFire = Fire.StartAtPrecise("DragonFireBreathPreview",
                    Mouth, 6117, Fire.QUALITY_HIGH, Fire.SIMULATION_AUTO,
                    VRAX_BREATH_RADIUS)
            End If

            If Value.MouthFire.Slot <> 0 Then

                Ok = PreciseMath.TryNormalize(PreciseMath.Subtract(Target, Mouth), Forward)
                Direction.X = ToNumber(Forward.X * ToDouble(VRAX_BREATH_SPEED))
                Direction.Y = ToNumber(Forward.Y * ToDouble(VRAX_BREATH_SPEED))
                Direction.Z = ToNumber(Forward.Z * ToDouble(VRAX_BREATH_SPEED))
                Ok = Fire.SetPositionPrecise(Value.MouthFire, Mouth) And Ok
                Ok = Fire.SetDirection(Value.MouthFire, Direction) And Ok

                Call Fire.SetIntensity(Value.MouthFire, VRAX_BREATH_INTENSITY)
                Call Fire.SetSourceVelocityInheritance(Value.MouthFire, 0)

                If Not Ok Then
                    Ok = Fire.Destroy(Value.MouthFire)
                End If

            End If

        End If

        If LightningReady And Not LightningPaused Then

            If Value.LeftArc.Slot = 0 Or Value.RightArc.Slot = 0 Then

                Call ClearVraxLightning(Value)

                Value.LeftArc = Lightning.StartAtPrecise("WeaponCorona",
                    LeftArm, Target, 6217, Lightning.QUALITY_HIGH)
                Value.RightArc = Lightning.StartAtPrecise("WeaponCorona",
                    RightArm, Target, 6317, Lightning.QUALITY_HIGH)

                If Value.LeftArc.Slot = 0 Or Value.RightArc.Slot = 0 Then
                    Call ClearVraxLightning(Value)
                End If

            End If

            If Value.LeftArc.Slot <> 0 And Value.RightArc.Slot <> 0 Then

                Ok = Lightning.SetEndpointsPrecise(Value.LeftArc, LeftArm, Target)
                Ok = Lightning.SetEndpointsPrecise(Value.RightArc, RightArm, Target) And Ok
                Ok = Lightning.SetStyle(Value.LeftArc, 5, 1000) And Ok
                Ok = Lightning.SetStyle(Value.RightArc, 5, 1000) And Ok
                Ok = Lightning.SetBranchBudget(Value.LeftArc, 4) And Ok
                Ok = Lightning.SetBranchBudget(Value.RightArc, 4) And Ok
                Ok = Lightning.SetSparkIntensity(Value.LeftArc, 25) And Ok
                Ok = Lightning.SetSparkIntensity(Value.RightArc, 25) And Ok

                If Not Ok Then
                    Call ClearVraxLightning(Value)
                End If

            End If

        End If

    End If

    Value.Clip = Name
    Value.Epoch = Epoch
    Value.Time = Time

    If Not FirePaused Then
        Value.FireTime = Time
    End If

    If Not LightningPaused Then
        Value.LightningTime = Time
    End If

    Value.FireWasPaused = FirePaused
    Value.LightningWasPaused = LightningPaused

End Sub

End Module
