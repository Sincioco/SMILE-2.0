''' Full-screen armory visit; shared party actors, stationary keeper and conversation purchases.
Module Smile.Tools.TownArmory

Option Explicit

Import Smile.Simple3D.Character3D As Character
Import Smile.Simple3D.Graphics3D As G
Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.PrecisionMath3D As M
Import Smile.Simple3D.Scene3D As Scene
Import Smile.Simple3D.StaticBackdrop3D As Backdrop
Import Smile.Simple3D.PartyTrail3D As Trail
Import Smile.Tools.NerisTownParty As Party
Import Smile.Tools.NerisTownKeyboard As Keyboard
Import Smile.Tools.TownArmoryRoom As Room
Import Smile.Tools.TownArmoryCatalog As Catalog
Import Smile.Tools.TownArmoryPanel As Panel
Import Smile.Tools.TownDocumentNavigation As Navigation
Import Smile.Tools.NerisTownEntranceNavigation As LegacyDoors
Import Smile.Tools.Character3DViewerCalibration As Formatting

Public Type State
    Actor As Character.Actor
    Room As Room.State
    OutdoorPath As Trail.State
    OutdoorYaw[5] As Double
    OutdoorOpacity[5] As Double
    OutdoorRunning As Boolean
    OutdoorSpeed As Number
    Active As Boolean
    Ready As Boolean
    Failed As Boolean
    Occupied As Boolean
    Transferred As Boolean
    Menu As Boolean
    Stage As Number
    Selected As Number
    Purchases As Number
    Quantity[6] As Number
    Message As Text
    Heading As Double
    Zoom As Double
End Type

Public Sub Open(ByRef Value As State, ByRef People As Party.State)

    Dim Index As Number

    Value.OutdoorPath = People.Path
    Value.OutdoorRunning = People.Running
    Value.OutdoorSpeed = People.SpeedPercent

    For Index = 0 To People.MemberCount - 1
        Value.OutdoorYaw[Index] = People.Members[Index].Yaw
        Value.OutdoorOpacity[Index] = People.Members[Index].Opacity
    End For

    Value.Active = True
    Value.Occupied = True
    Value.Menu = False
    Value.Zoom = 1.0
    Value.Heading = 0.0
    Value.Message = "Gold is not required for demonstration purchases."

End Sub

Public Sub Observe(ByRef Value As State, ByRef People As Party.State, Enabled As Boolean)

    Dim Door As Number
    Dim Position As P.Vector3

    If Not Enabled Or Value.Active Then
        Return
    End If

    Position = People.Path.Positions[0]

    If Navigation.Active() Then

        Door = Navigation.EnteredTemplate(Position, 12)

    Else

        Door = LegacyDoors.DoorwayAt(Position.X, Position.Z)

        If Door < 62 Or Door > 65 Then
            Door = -1
        End If

    End If

    If Door < 0 Then
        Value.Occupied = False
    Else If Not Value.Occupied Then
        Call Open(Value, People)
    End If

End Sub

Private Sub LoadNext(ByRef Value As State, ByRef People As Party.State)

    Dim Bounds As Character.Bounds3D
    Dim Ok As Boolean
    Dim Index As Number

    Ok = True

    If Value.Stage = 0 Then

        Value.Actor = Character.LoadActor("Assets/Neris/Armory/Garran.sm3d")
        Ok = Character.IsValid(Value.Actor)
        Bounds = Character.LocalBounds(Value.Actor)
        Ok = Character.SetScale(Value.Actor, ToNumber(Round(21.0 * 100000.0 / ToDouble(Max(1, Bounds.Size.Y))))) And Ok
        Ok = Character.PlayAnimation(Value.Actor, "Idle", True) And Ok
        Ok = Character.PlacePrecise(Value.Actor, 0.0, 0.0, 52.0) And Ok

    Else

        Ok = Room.LoadRoom(Value.Room)

        If Ok Then

            People.Interior = True
            People.SpeedPercent = 100

            Call Party.SetRunning(People, False)
            Call Trail.Reset(People.Path, P.Vector(0.0, 0.0, -60.0), People.MemberCount, 12.0)
            Call Trail.Advance(People.Path, P.Vector(0.0, 0.0, -20.0), 1000, 100.0, 0.0)

            For Index = 0 To People.MemberCount - 1
                People.Members[Index].Previous = People.Path.Positions[Index]
                People.Members[Index].Yaw = 180.0
                People.Members[Index].Opacity = 100.0
            End For

            Value.Transferred = True
            Value.Ready = True

            Call Party.Stand(People, 16)

        End If

    End If

    Value.Failed = Not Ok
    Value.Stage = Value.Stage + 1

End Sub

Public Sub MoveParty(ByRef Value As State, ByRef People As Party.State, Direction As P.Vector3, Elapsed As Number)

    Dim Leader As P.Vector3
    Dim Delta As P.Vector3

    If Not Value.Ready Or Value.Menu Then
        Return
    End If

    Leader = People.Path.Positions[0]
    Delta = M.Scale(Direction, 31.0 * ToDouble(Min(50, Max(0, Elapsed))) / 1000.0)
    Leader = Room.Move(Leader, Delta)

    Call Party.Update(People, Leader, Elapsed)

    If Room.AtExit(Leader) Then
        Call Close(Value, People)
    End If

End Sub

Public Sub Update(ByRef Value As State, ByRef People As Party.State, Elapsed As Number)

    Dim Ok As Boolean
    Dim Keys As Keyboard.HeldKeys
    Dim Direction As P.Vector3
    Dim Target As Double
    Dim Difference As Double

    If Not Value.Active Or Value.Failed Then
        Return
    End If

    If Not Value.Ready Then
        Call LoadNext(Value, People)

        Return
    End If

    If Value.Menu Then

        Call Party.FaceLeader(People, P.Vector(0.0, 0.0, 52.0))
        Call Party.Stand(People, Elapsed)

        Direction = M.Subtract(People.Path.Positions[0], P.Vector(0.0, 0.0, 52.0))
        Target = M.Degrees(Atan2(Direction.X, Direction.Z)) + 180.0
        Difference = M.WrapDegrees(Target - Value.Heading + 180.0) - 180.0
        Value.Heading = Value.Heading + Clamp(Difference, -ToDouble(Elapsed) * 0.15, ToDouble(Elapsed) * 0.15)

    Else

        Keys = Keyboard.ReadKeys(False)
        Direction = Keyboard.PartyDirection(Room.Camera(People.Path.Positions[0], Value.Zoom, False), Keys)

        Call MoveParty(Value, People, Direction, Elapsed)

    End If

    If Value.Active Then

        Ok = Character.RotatePrecise(Value.Actor, 0.0, Value.Heading, 0.0)
        Ok = Character.Update(Value.Actor, Max(0, Elapsed)) And Ok
        Value.Failed = Not Ok Or Not People.Ready

    End If

End Sub

Public Function Talk(ByRef Value As State, ByRef People As Party.State) As Boolean

    If (Not Value.Ready Or
        Not Room.CanTalk(People.Path.Positions[0]) Or
        Value.Failed) Then
        Return False
    End If

    Value.Menu = True
    Value.Message = "Gold is not required for demonstration purchases."

    Return True

End Function

Public Sub Buy(ByRef Value As State)

    Dim Item As Catalog.Weapon

    If (Not Value.Ready Or
        Not Value.Menu Or
        Value.Failed) Then
        Return
    End If

    Item = Catalog.ItemAt(Value.Selected)
    Value.Quantity[Value.Selected] = Value.Quantity[Value.Selected] + 1
    Value.Purchases = Value.Purchases + 1
    Value.Message = "Purchased " + Item.Name + " for " + Formatting.NumberText(Item.Price) + " gold. Thank you!"
    Value.Message = Value.Message + "  (Demo quantity: " + Formatting.NumberText(Value.Quantity[Value.Selected]) + ")"

End Sub

Public Function Input(ByRef Value As State, ByRef People As Party.State, Key As Number) As Boolean

    Dim Action As Number
    Dim Ok As Boolean
    Dim B As Panel.Bounds

    If Not Value.Active Then
        Return False
    End If

    If Value.Menu Then

        B = Panel.Layout()
        Action = -1

        If Pointer_Pressed(POINTER_PRIMARY) Then
            Action = Panel.Hit(B, Pointer_X(), Pointer_Y())
        End If

        If (Key = KEY_ESCAPE Or
            Key = KEY_E Or
            Action = 7) Then
            Value.Menu = False
            Return True
        End If

        If Key = KEY_DOWN Or Key = KEY_S Then
            Value.Selected = (Value.Selected + 1) Mod Catalog.ITEM_COUNT
        Else If Key = KEY_UP Or Key = KEY_W Then
            Value.Selected = (Value.Selected + Catalog.ITEM_COUNT - 1) Mod Catalog.ITEM_COUNT
        End If

        If Action >= 0 And Action < Catalog.ITEM_COUNT Then
            Value.Selected = Action
        End If

        If Key = KEY_ENTER Or Action = 6 Then
            Call Buy(Value)
        End If

    Else If Key = KEY_ESCAPE Then

        Call Close(Value, People)

    Else If Key = KEY_E Or Key = KEY_ENTER Then

        Ok = Talk(Value, People)

    Else
        Value.Zoom = Clamp(Value.Zoom - ToDouble(Pointer_Wheel_Delta()) * 0.06, 0.6, 1.15)

    End If

    Return True

End Function

Public Sub Draw(ByRef Value As State, ByRef People As Party.State)

    Dim Saved As Backdrop.Selection
    Dim Ok As Boolean
    Dim Started As Boolean
    Dim SavedShadows As Boolean
    Dim SavedExposure As Number

    If Not Value.Ready Or Value.Failed Then
        Clear RGB(17, 23, 29)
        Return
    End If

    SavedShadows = Scene.ShadowsRequested()
    SavedExposure = Scene.Exposure()
    Ok = Backdrop.ExchangeActive(Saved)
    Ok = G.ClearAdditionalLights3DChecked() And Ok
    Ok = G.SetAmbientLight3D(225, 215, 200, 65) And Ok
    Ok = G.SetDirectionalLight3D(-2, 4, -5, 255, 236, 211, 110) And Ok
    Ok = G.SetPointLight3D(0, -65, 34, 15, 255, 173, 74, 110, 120) And Ok
    Ok = Scene.SetShadows(False) And Ok
    Ok = Scene.SetExposure(100) And Ok

    Call G.ResetViewport3D()
    Call Scene.UseCustomLighting()

    Started = Scene.BeginPrecise(Room.Camera(People.Path.Positions[0], Value.Zoom, Value.Menu), 17, 23, 29)
    Ok = Started And Ok

    If Started Then

        Ok = Room.Draw(Value.Room) And Ok
        Ok = Character.Draw(Value.Actor) And Ok
        Ok = Party.Draw(People) And Ok
        Ok = Scene.EndScene() And Ok

    End If

    Ok = Backdrop.ExchangeActive(Saved) And Ok
    Ok = Scene.SetShadows(SavedShadows) And Ok
    Ok = Scene.SetExposure(SavedExposure) And Ok
    Value.Failed = Not Ok

End Sub

Public Sub Overlay(ByRef Value As State, ByRef People As Party.State)

    If Value.Menu Then
        Call Panel.Draw(Panel.Layout(), Value.Selected, Value.Message, Value.Purchases)

        Return
    End If

    Fill Rectangle 0, 0, Window_Width(), 64, RGB(12, 22, 31) Opacity 88
    Draw Text "GARRAN'S ARMORY  /  NERIS TOWN" At 24, 18 Size 23 Color RGB(239, 206, 145)
    Fill Rectangle 0, Window_Height() - 56, Window_Width(), 56, RGB(12, 22, 31) Opacity 90
    Draw Text "WASD: Walk   Mouse Wheel: Zoom   E: Talk   Esc: Leave Shop" At 24, Window_Height() - 36 Size 16 Color WHITE

    If Value.Failed Then
        Draw Text "The armory could not load. Press Esc to return to town." At 24, 92 Size 18 Color WHITE
    Else If Not Value.Ready Then
        Draw Text "Entering Garran's armory..." At 24, 92 Size 18 Color WHITE
    Else If Room.CanTalk(People.Path.Positions[0]) Then
        Fill Rectangle 24, Window_Height() - 108, 340, 40, RGB(16, 38, 48) Opacity 95
        Draw Text "E / Enter: Speak To Garran" At 40, Window_Height() - 98 Size 18 Color RGB(239, 206, 145)
    Else If People.Path.Positions[0].Z < -45.0 Then
        Draw Text "Walk through the doorway to return to Neris Town." At 24, Window_Height() - 90 Size 16 Color WHITE
    End If

End Sub

Public Sub Close(ByRef Value As State, ByRef People As Party.State)

    Dim Index As Number

    If Value.Transferred Then

        People.Interior = False
        People.Path = Value.OutdoorPath
        People.SpeedPercent = Value.OutdoorSpeed

        Call Party.SetRunning(People, Value.OutdoorRunning)

        For Index = 0 To People.MemberCount - 1
            People.Members[Index].Previous = People.Path.Positions[Index]
            People.Members[Index].Yaw = Value.OutdoorYaw[Index]
            People.Members[Index].Opacity = Value.OutdoorOpacity[Index]
        End For

        Call Party.Stand(People, 16)

    End If

    Call Destroy(Value)

    Value.Occupied = True

End Sub

Public Sub Destroy(ByRef Value As State)

    Call Character.Destroy(Value.Actor)
    Call Room.Destroy(Value.Room)

    Value.Ready = False
    Value.Active = False
    Value.Menu = False
    Value.Transferred = False
    Value.Stage = 0
    Value.Failed = False

End Sub

End Module
