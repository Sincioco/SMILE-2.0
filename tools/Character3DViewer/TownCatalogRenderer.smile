''' Shared immutable template models; each scene owns its objects, animation and overrides.
Module Smile.Tools.TownCatalogRenderer

Option Explicit

Import Smile.Simple3D.Core As Core
Import Smile.Simple3D.Graphics3D As G
Import Smile.Simple3D.Precision3D As P
Import Smile.Tools.TownDocument As Document
Import Smile.Tools.TownCatalogData As Catalog
Import Smile.Tools.TownCityData As CityData
Import Smile.Tools.TownCityLighting As City

Private Const MODEL_CAPACITY = Catalog.CHUNK_COUNT + 14
Private Const OBJECT_CAPACITY = MODEL_CAPACITY * 16

Private Dim SharedModels[MODEL_CAPACITY] As Core.Model3D
Private Dim ModelOwners[MODEL_CAPACITY] As Number

Public Type State
    Lawn As Core.Material3D
    Grass As Core.Texture3D
    Models[MODEL_CAPACITY] As Core.Model3D
    Wind[MODEL_CAPACITY] As Core.Animator3D
    Objects[OBJECT_CAPACITY] As Core.Object3D
    Needed[MODEL_CAPACITY] As Boolean
    CityMaterials As City.State
    CityActive As Boolean
    Loaded As Number
    Required As Number
    ObjectCount As Number
    Failed As Boolean
    ErrorCode As Number
End Type

''' Acquire immutable geometry and imported PBR once for each published catalog chunk.
Private Function AcquireModel(ByRef Model As Core.Model3D, Index As Number,
    ByRef ErrorCode As Number) As Boolean

    Dim Chunk As Number
    Dim Path As Text
    Dim Name As Text
    Dim Candidate As Core.Model3D
    Dim Ok As Boolean

    If SharedModels[Index].Handle = 0 Then

        Chunk = Index
        Path = "Assets/Neris/Catalog/Catalog-"

        If Chunk >= Catalog.CHUNK_COUNT Then
            Chunk = Chunk - Catalog.CHUNK_COUNT
            Path = "Assets/Neris/Castle-"
        End If

        Name = Text_From_Code(48 + Chunk / 10) + Text_From_Code(48 + Chunk Mod 10)
        Candidate = G.LoadModelGeometry3D(Path + Name + ".sm3d")
        Ok = Candidate.GeometryReady

        If Ok Then
            Ok = G.PrepareModelPbr3D(Candidate, G.TEXTURE_FILTER_ANISOTROPIC, 1, 16)
        End If

        If Not Ok Then

            ErrorCode = G.LastError()

            Call G.DestroyModel3D(Candidate)

            Return False

        End If

        SharedModels[Index] = Candidate

    End If

    Model = SharedModels[Index]
    ModelOwners[Index] = ModelOwners[Index] + 1

    Return True

End Function

''' Objects and animators must be released before their scene gives up its model lease.
Private Sub ReleaseModel(ByRef Model As Core.Model3D, Index As Number)

    Dim Empty As Core.Model3D

    If Model.Handle = 0 Then
        Return
    End If

    ModelOwners[Index] = ModelOwners[Index] - 1
    Model = Empty

    If ModelOwners[Index] = 0 Then
        Call G.DestroyModel3D(SharedModels[Index])
    End If

End Sub

''' Catalog membership does not allocate GPU resources for absent city templates.
Public Sub SyncDocument(ByRef Value As State, ByRef Town As Document.State)

    Dim Index As Number
    Dim Part As Number
    Dim Slot As Number
    Dim Chunk As Number
    Dim Shape As Catalog.Template
    Dim HasCity As Boolean

    For Index = 0 To MODEL_CAPACITY - 1
        Value.Needed[Index] = False
    End For

    Value.Required = Catalog.CHUNK_COUNT
    HasCity = City.HasCity(Town)

    For Index = 0 To Town.ItemCount - 1

        If Town.Items[Index].Active Then

            Shape = Catalog.TemplateAt(Town.Items[Index].Template)

            For Part = 0 To Shape.PartCount - 1
                Chunk = Shape.Parts[Part] / 16
                Value.Needed[Chunk] = True
            End For

            If Town.Items[Index].Template = 6 Then
                Value.Required = MODEL_CAPACITY
            End If

        End If

    End For

    Value.Loaded = Value.Required

    For Index = 0 To MODEL_CAPACITY - 1

        If Not Value.Needed[Index] And Value.Models[Index].GeometryReady Then

            For Part = 0 To Value.Models[Index].PartCount - 1
                Slot = Index * 16 + Part

                Call G.DestroyObjectInstance3D(Value.Objects[Slot])

                Value.ObjectCount = Value.ObjectCount - 1
            End For

            Call G.DestroyAnimator3D(Value.Wind[Index])
            Call ReleaseModel(Value.Models[Index], Index)

        Else If Value.Needed[Index] And Not Value.Models[Index].GeometryReady Then

            Value.Loaded = Min(Value.Loaded, Index)

        End If

    End For

    If Value.CityActive And Not HasCity Then
        Call City.Destroy(Value.CityMaterials)
    End If

    Value.CityActive = HasCity

End Sub

Public Sub LoadNext(ByRef Value As State)

    Dim Part As Number
    Dim Ok As Boolean
    Dim EmptyTexture As Core.Texture3D

    If Value.Failed Or Value.Loaded >= Value.Required Then
        Return
    End If

    If Not Value.Needed[Value.Loaded] Or Value.Models[Value.Loaded].GeometryReady Then
        Value.Loaded = Value.Loaded + 1
        Return
    End If

    If Value.Grass.Handle = 0 Then

        ' Courtyard grass follows the same editable sun as terrain and paving.
        Value.Grass = G.LoadTexture3DEx("Assets/Neris/Neris-Grass-Color.png",
            G.TEXTURE_USAGE_COLOR, G.TEXTURE_FILTER_ANISOTROPIC, G.TEXTURE_WRAP_REPEAT, 16)
        Value.Lawn = G.CreatePbrMaterial3D(Value.Grass, EmptyTexture,
            EmptyTexture, EmptyTexture, G.MATERIAL_ALPHA_OPAQUE, True)
        Ok = G.SetPbrMaterialFactors3D(Value.Lawn, 255, 255, 255, 100, 0, 100, 0, 100)

    End If

    Ok = AcquireModel(Value.Models[Value.Loaded], Value.Loaded, Value.ErrorCode)

    If Not Ok Then
        Value.Failed = True
        Return
    End If

    If Ok And Value.Models[Value.Loaded].ClipCount > 0 Then
        Value.Wind[Value.Loaded] = G.CreateModelAnimator3D(Value.Models[Value.Loaded])
        Ok = G.PlayModelAnimatorNamed3D(Value.Wind[Value.Loaded], "Gentle Wind", G.ANIMATION_LOOP, 100)
    End If

    If Ok Then

        For Part = 0 To Value.Models[Value.Loaded].PartCount - 1

            Value.Objects[Value.Loaded * 16 + Part] = G.CreateModelPart3D(Value.Models[Value.Loaded], Part)
            Ok = Value.Objects[Value.Loaded * 16 + Part].Handle <> 0 And Ok
            Ok = City.Bind(Value.CityMaterials, Value.Objects[Value.Loaded * 16 + Part],
                CityData.Kind(Value.Loaded * 16 + Part)) And Ok

            If Catalog.IsLawnPart(Value.Loaded * 16 + Part) Then
                Ok = G.SetObjectMaterial3D(Value.Objects[Value.Loaded * 16 + Part], Value.Lawn) And Ok
                Ok = G.SetObjectShadowsChecked3D(Value.Objects[Value.Loaded * 16 + Part], False, True) And Ok
            End If

            If Value.Wind[Value.Loaded].Handle <> 0 Then
                Ok = G.SetObjectAnimator3D(Value.Objects[Value.Loaded * 16 + Part], Value.Wind[Value.Loaded]) And Ok
            End If

            Value.ObjectCount = Value.ObjectCount + 1
        End For

    End If

    Value.ErrorCode = G.LastError()
    Value.Failed = Not Ok
    Value.Loaded = Value.Loaded + 1

End Sub

Public Sub Update(ByRef Value As State, Elapsed As Number)

    Dim Index As Number
    Dim Ok As Boolean

    For Index = 0 To Value.Loaded - 1

        If Value.Wind[Index].Handle <> 0 Then
            Ok = G.UpdateAnimator3D(Value.Wind[Index], Elapsed)
        End If

    End For

End Sub

Public Function Draw(ByRef Value As State, ByRef Town As Document.State,
    Optional Intensity As Number = -1) As Boolean

    Dim Index As Number
    Dim Part As Number
    Dim FirstPart As Number
    Dim Slot As Number
    Dim Item As Document.Item
    Dim Shape As Catalog.Template
    Dim Ok As Boolean

    Ok = Not Value.Failed

    If Intensity < 0 Then
        Intensity = Town.Light.Intensity
    End If

    Ok = City.Update(Value.CityMaterials, Intensity) And Ok

    For Index = 0 To Town.ItemCount - 1

        Item = Town.Items[Index]

        If Item.Active And (Item.Template <> 6 Or Value.Loaded = Catalog.CHUNK_COUNT + 14) Then

            Shape = Catalog.TemplateAt(Item.Template)

            If Item.Template = 39 Then
                ' Only stones and logs: animated fire belongs to TownCampfires.
                Shape.PartCount = 2
            End If

            FirstPart = 0

            If Item.Template >= 20 And Item.Template <= 25 Then
                FirstPart = 1
            End If

            For Part = FirstPart To Shape.PartCount - 1

                Slot = Shape.Parts[Part]

                If CityData.Kind(Slot) <> 9 Or City.BeaconOn(Timer(), Item.Identity) Then

                    Ok = P.SetPosition(Value.Objects[Slot], Item.Position.X, Item.Position.Y, Item.Position.Z) And Ok
                    Ok = P.SetScale(Value.Objects[Slot], Item.Scale.X, Item.Scale.Y, Item.Scale.Z) And Ok
                    Ok = P.SetRotation(Value.Objects[Slot], 0.0, Item.Yaw, 0.0) And Ok
                    Ok = G.DrawObject3D(Value.Objects[Slot]) And Ok

                End If

            End For

        End If

    End For

    Ok = City.Draw(Value.CityMaterials, Town, Intensity) And Ok

    Return Ok

End Function

Public Sub Destroy(ByRef Value As State)

    Dim Index As Number

    For Index = 0 To OBJECT_CAPACITY - 1
        Call G.DestroyObjectInstance3D(Value.Objects[Index])
    End For

    For Index = 0 To MODEL_CAPACITY - 1
        Call G.DestroyAnimator3D(Value.Wind[Index])
        Call ReleaseModel(Value.Models[Index], Index)
    End For

    Call G.DestroyMaterial3D(Value.Lawn)
    Call G.DestroyTexture3D(Value.Grass)
    Call City.Destroy(Value.CityMaterials)

    Value.Loaded = 0
    Value.Required = 0
    Value.ObjectCount = 0
    Value.CityActive = False
    Value.Failed = False

End Sub

End Module
