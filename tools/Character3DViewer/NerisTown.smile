''' Native town scene lifecycle. Static assets, party and navigation have separate owners.
Module Smile.Tools.NerisTown

Option Explicit

Import Smile.Simple3D.Precision3D As P
Import Smile.Simple3D.PrecisionMath3D As M
Import Smile.Simple3D.PrecisionCamera3D As Camera
Import Smile.Simple3D.ArenaViewport3D As Arena
Import Smile.Simple3D.ArenaCamera3D As Motion
Import Smile.Simple3D.Scene3D As Scene
Import Smile.Simple3D.Character3D As Character
Import Smile.Tools.NerisTownKeyboard As Keyboard
Import Smile.Tools.Character3DViewerRendering As Rendering
Import Smile.Tools.NerisTownAssets As Assets
Import Smile.Tools.NerisTownParty As Party
Import Smile.Tools.NerisTownNavigation As Navigation
Import Smile.Tools.Character3DViewerCalibration As Numbers
Import Smile.Tools.NerisTownAppearance As Appearance
Import Smile.Tools.NerisTownMap As TownMap
Import Smile.Tools.NerisTownCamera As Drone
Import Smile.Tools.NerisTownInspectionLimits As Limits
Import Smile.Tools.NerisTownCameraPanel As CameraPanel
Import Smile.Tools.NerisTownEntrances As Entrances
Import Smile.Tools.TownEditorSession As Authoring
Import Smile.Tools.NerisCastlePreview As Castle
Import Smile.Tools.NerisCastleRoute As CastleRoute
Import Smile.Tools.TownPicking As Picking
Import Smile.Tools.NerisTownTour As Tour
Import Smile.Tools.NerisSpaceportPreview As Spaceport
Import Smile.Tools.NerisSpaceportRoute As SpaceportRoute
Import Smile.Tools.NerisHorizonPreview As Horizon
Import Smile.Tools.NerisHorizonRoute As HorizonRoute
Import Smile.Tools.NerisTownLandmarks As Landmarks
Import Smile.Tools.NerisTownConnections As Connections
Import Smile.Tools.TownSunControls As SunControls
Import Smile.Tools.TownViewportLayout As Layout
Import Smile.Tools.TownPartyInset As Inset
Import Smile.Tools.TownWorldPreviews As WorldPreviews
Import Smile.Tools.TownDocumentNavigation As DocumentNavigation
Import Smile.Tools.TownRoadTravel As RoadTravel
Import Smile.Tools.TownResidents As Residents
Import Smile.Tools.TownResidentInteraction As Conversation
Import Smile.Tools.TownDocumentMap As DocumentMap

Public Type State
    Residents As Residents.State
    ConversationFramed As Boolean
    PointOfView As Inset.State
    Town As Assets.State
    Comparison As Castle.State
    Harbor As Spaceport.State
    Horizon As Horizon.State
    Landmarks As Landmarks.State
    People As Party.State
    View As Arena.State
    Look As Appearance.State
    Map As TownMap.State
    BaseCamera As P.Camera3D
    Cinematic As Boolean
    OverviewOrbit As Boolean
    OrbitPaused As Boolean
    Follow As Boolean
    PartyCamera As Boolean
    InputActive As Boolean
    IdleTime As Number
    IdleOrbit As Boolean
    Flight As Drone.State
    Panel As CameraPanel.State
    Keys As Keyboard.State
    Doors As Entrances.State
    Ready As Boolean
    Failed As Boolean
    LoadingTown As Text
    Edited As Boolean
End Type

Public Sub Start(ByRef Value As State)

    Dim Ok As Boolean

    Dim Empty As State

    Value = Empty
    Value.Panel.LoadStarted = Timer()
    Value.Panel.Loading = True
    Value.Follow = True
    Value.PartyCamera = True
    Value.Edited = Authoring.Available()
    Value.LoadingTown = Authoring.TownName()
    Value.BaseCamera.UpDirection = P.Vector(0.0, 1.0, 0.0)
    ' Town-scale depth precision keeps thin paving layers separated during orbit.
    Value.BaseCamera.NearPlane = 25.0
    Value.BaseCamera.FarPlane = 25000.0
    ' A narrower lens avoids wide-angle stretching; distance retains the town framing.
    Value.BaseCamera.FovDegrees = 32.0
    Value.BaseCamera.Target = P.Vector(0.0, 65.12, -2725.0)
    Value.BaseCamera.Position = P.Vector(0.0, 49.12, -3080.0)
    Ok = Rendering.PrepareAssetLoading(0)
    Value.Failed = Not Ok

    Call Party.Start(Value.People)
    Call Drone.Start(Value.Flight)

End Sub

Public Sub LoadNext(ByRef Value As State)

    Dim Ok As Boolean
    Dim AuthoringReady As Boolean

    If Value.Edited And Value.LoadingTown <> Authoring.TownName() Then

        Value.LoadingTown = Authoring.TownName()
        Value.Failed = False
        Value.Ready = False

    End If

    If Value.Residents.Enabled And Authoring.TownName() <> "Neris Town" Then
        Call Residents.Destroy(Value.Residents)
    End If

    If Value.Ready Or Value.Failed Then
        Return
    End If

    If Not Value.Panel.Loading Then
        Value.Panel.LoadStarted = Timer()
        Value.Panel.Loading = True
    End If

    If Value.Edited Then

        AuthoringReady = Authoring.LoadNext()
        Value.Failed = Authoring.Failed()

        If Not AuthoringReady Then
            Return
        End If

    Else If Value.Town.Loaded < Assets.CHUNK_COUNT Then

        Call Assets.LoadNext(Value.Town)

        Value.Failed = Value.Town.Failed

        Return

    End If

    If Value.People.Loaded < Value.People.MemberCount Then

        Call Party.LoadNext(Value.People)

        Value.Failed = Value.People.Failed

        Return

    End If

    Ok = True

    If Value.Edited Then

        Ok = Landmarks.LoadNext(Value.Landmarks, Authoring.TownName(), Authoring.LandmarkKind(),
            Authoring.CourtExists(),
            Value.Comparison, Value.Harbor, Value.Horizon)
        Value.Failed = Value.Landmarks.Failed

        If Not Ok Or Value.Failed Then
            Return
        End If

    End If

    If Not Value.View.Ready Then
        Value.View = Arena.Create(11000, 10000, 6.0)
        Ok = TownMap.Create(Value.Map) And Ok
    End If

    If Value.Edited Then
        Call Authoring.SizeArena(Value.View.Floor)
    End If

    Value.Panel.GeometryTime = 0

    Value.View.MinimumDistance = 80.0
    Value.View.MaximumDistance = 18000.0
    Value.View.FloorVisible = False
    Value.View.GridVisible = False

    If Not Value.Edited Then
        Ok = Appearance.Create(Value.Look)
        Ok = Entrances.Create(Value.Doors) And Ok
    End If

    If Value.Harbor.Ready Or Value.Horizon.Ready Then

        Value.View.MaximumDistance = 40000.0
        Value.BaseCamera.FarPlane = 55000.0
        Ok = Scene.SetShadowArea(-2650, 1500, -3200, 15200, 15500, 1, 22000) And Ok

        If Value.Horizon.Ready Then
            Ok = Scene.SetShadowArea(8100, 1500, 1250, 11000, 11000, 1, 22000) And Ok
        End If

    Else
        Ok = Scene.SetShadowArea(-1000, 650, 0, 8000, 7600, 1, 11000) And Ok

    End If

    Ok = Scene.SetShadowBias(25, 60) And Ok
    Value.Ready = Value.View.Ready And Value.View.Floor.Ready And Value.People.Ready And Ok
    Value.Failed = Not Value.Ready

    If Value.Ready Then
        Value.Panel.LoadMilliseconds = Max(0, Timer() - Value.Panel.LoadStarted)
        Value.Panel.Loading = False
    End If

    If Authoring.PreviewActive() Then
        Return
    End If

    Call Party.Update(Value.People, Value.People.Path.Positions[0], 0)

    Call Arena.ComposeCamera(Value.View, Value.BaseCamera)
    Call Drone.Focus(Value.Flight, Value.People.Members[0].Yaw, Value.View.LiveCamera)

    Value.Flight.Arrival = True

    If Value.Ready And Authoring.DemoActive() Then
        Call ResetOverview(Value)
    End If

End Sub

Public Sub Input(ByRef Value As State, Key As Number, Blocked As Boolean,
    Optional HeaderHovered As Boolean = False)

    Dim Pointer As Motion.PointerInput
    Dim ArenaKey As Number
    Dim PanelAction As Number
    Dim MovingGesture As Boolean
    Dim OrbitPoint As P.Vector3
    Dim RequestedView As Number
    Dim ResidentIndex As Number
    Dim Started As Boolean

    If Not Value.Ready Then

        If Authoring.PreviewActive() Or Value.Failed Then
            Call Authoring.Input(Value.View.LiveCamera, Key, True)
        End If

        Return

    End If

    Value.InputActive = (Key <> KEY_NONE Or Pointer_Delta_X() <> 0 Or
        Pointer_Delta_Y() <> 0 Or Pointer_Wheel_Delta() <> 0 Or
        Pointer_Held(POINTER_PRIMARY) Or Pointer_Held(POINTER_MIDDLE) Or
        Pointer_Held(POINTER_SECONDARY))

    If (Not Blocked And
        Not Authoring.Editing() And
        Not Authoring.PreviewActive()) Then

        If Residents.Input(Value.Residents, Key) Then

            Call RoadTravel.Cancel()

            If Not Residents.Talking(Value.Residents) Then
                Call HoldDisplayedView(Value)
            End If

            Value.IdleTime = 0

            Call Arena.Update(Value.View, KEY_NONE, True, 24)

            Return

        End If

    End If

    ' Wake idle orbit before deciding which visible control owns this event.

    Call UpdateIdle(Value, Value.InputActive, 0,
        Pointer_Wheel_Delta() <> 0 And Key = KEY_NONE And
        Not Pointer_Held(POINTER_PRIMARY) And Not Pointer_Held(POINTER_MIDDLE) And
        Not Pointer_Held(POINTER_SECONDARY), Authoring.MapHovered())

    ' Header hover blocks pointer gestures, not independent keyboard framing.

    If (Key = KEY_R And
        (Authoring.Editing() Or Value.View.MaximumPitch > 1.56) And
        Not Blocked And
        Not Authoring.GestureActive()) Then

        Call Keyboard.StopTravel(Value.Keys)
        Call Drone.TurnClockwise(Value.Flight, Value.View, Value.BaseCamera)

        Value.PartyCamera = False
        Value.Follow = False
        Value.Cinematic = False
        Value.IdleOrbit = False
        Value.IdleTime = 0
        Value.InputActive = True

        Return

    End If

    If (Key = KEY_1 And
        Not Blocked And
        Not Authoring.GestureActive()) Then
        Call TopDown(Value, Authoring.Editing())

        Return
    End If

    If (Key = KEY_2 And
        Not Blocked And
        Not Authoring.GestureActive()) Then
        Call SetEditingView(Value, 3)

        Return
    End If

    If (Key = KEY_SPACE And
        Not Blocked And
        Value.Cinematic And
        Not Value.Keys.FlyInspect) Then

        Value.OrbitPaused = Not Value.OrbitPaused
        Value.IdleOrbit = False
        Value.InputActive = True

        Return

    End If

    If Value.Edited And Layout.Clicked(1) Then
        Call Authoring.ToggleDayNight()

        Return
    End If

    Blocked = Blocked Or (HeaderHovered And Not CameraPanel.Hovered(Value.Panel.HelpOpen))

    If Inset.Hovered(Value.PointOfView, Authoring.Editing()) Then
        Call Inset.Input(Value.PointOfView)

        Blocked = True
    End If

    If (Value.Edited And
        (Not Blocked Or Authoring.MinimapCaptured()) And
        Not Authoring.Editing() And
        Not Authoring.CameraBlocked() And
        Not Value.Cinematic And
        Value.Map.Opacity > 0.0 And
        Authoring.MapHovered()) Then

        If Authoring.HandleMinimap(Value.People.Path.Positions[0]) = 2 Then

            Value.Residents.ApproachActive = False

            Call Keyboard.StopTravel(Value.Keys)
            Call Drone.Focus(Value.Flight, Value.People.Members[0].Yaw, Value.View.LiveCamera)
            Call Motion.Reset(Value.View.Controls, Value.View.Zoom)
            Call Arena.BeginTransition(Value.View, 1000)

            Value.Follow = True
            Value.PartyCamera = True
            Value.Flight.Enabled = True
            Value.Flight.Focusing = True
            Value.Keys.FlyInspect = False
            Value.Cinematic = False
            Value.People.Running = True

        End If

        ' The minimap owns pointer input, but camera easing must continue.

        Call Arena.Update(Value.View, KEY_NONE, True, 24)

        Return

    End If

    If (Not Blocked And
        Not Authoring.Editing() And
        Not Authoring.CameraBlocked() And
        Not CameraPanel.Hovered(Value.Panel.HelpOpen) And
        Pointer_Y() >= 126 And
        Pointer_Pressed(POINTER_PRIMARY) And
        Key_Held(KEY_CONTROL)) Then

        If Picking.Ground(Value.View.LiveCamera, Pointer_X(), Pointer_Y(),
            Window_Width(), Window_Height(), OrbitPoint) Then
            Value.Residents.ApproachActive = False

            Call MoveToRoad(Value, OrbitPoint)
        End If

        Return

    End If

    If Layout.Clicked(2) Then

        Call Authoring.BeginEditing()

        If Not Value.Edited Then

            Call Entrances.Destroy(Value.Doors)
            Call Appearance.Destroy(Value.Look)
            Call Assets.Destroy(Value.Town)

            Value.Edited = True
            Value.Ready = False

        End If

        Value.BaseCamera = Value.View.LiveCamera
        Value.Follow = False
        Value.PartyCamera = False
        Value.Cinematic = False
        Value.Flight.Suspended = True

        Call Motion.Reset(Value.View.Controls, Value.View.Zoom)

        Return

    End If

    If Value.Edited Then

        Call Authoring.Input(Value.View.LiveCamera, Key,
            Blocked Or CameraPanel.Hovered(Value.Panel.HelpOpen) Or Value.Panel.DragRow > 0)

        If Authoring.PreviewActive() Then
            Return
        End If

        RequestedView = Authoring.TakeViewRequest(OrbitPoint)

        If RequestedView = 1 Or RequestedView = 2 Then

            Call SetEditingView(Value, RequestedView)

        Else If RequestedView = 4 Then

            Value.BaseCamera = Value.View.LiveCamera
            Value.BaseCamera.Position = M.Add(Value.BaseCamera.Position, M.Subtract(OrbitPoint, Value.BaseCamera.Target))
            Value.BaseCamera.Target = OrbitPoint
            Value.BaseCamera = Camera.KeepCursorAnchor(Value.BaseCamera, OrbitPoint,
                Authoring.ViewRightEdge() / 2, (Window_Height() + 76) / 2,
                M.Distance(Value.BaseCamera.Position, Value.BaseCamera.Target), Window_Width(), Window_Height())

            Call Motion.Reset(Value.View.Controls, Value.View.Zoom)
            Call Arena.BeginTransition(Value.View, 0)
            Call Arena.ComposeCamera(Value.View, Value.BaseCamera)

        End If

        Blocked = Blocked Or Authoring.CameraBlocked(CameraPanel.Hovered(Value.Panel.HelpOpen) Or Value.Panel.DragRow > 0)

    End If

    PanelAction = CameraPanel.Input(Value.Panel, Value.View, Value.BaseCamera, Blocked,
        Drone.GroundShot(Value.Flight, Value.PartyCamera))
    Blocked = Blocked Or CameraPanel.Hovered(Value.Panel.HelpOpen) Or Value.Panel.DragRow > 0

    If PanelAction = 1 Then

        If Value.Cinematic Then
            Value.Cinematic = False
        Else

            Call StartOrbit(Value)
        End If

    Else If PanelAction = 2 Then

        Call FitTown(Value)

    Else If PanelAction = 3 Then

        Value.Cinematic = False
        Value.Flight.Suspended = True
        Value.PartyCamera = False

    Else If PanelAction = 4 Then

        Call ToggleInspection(Value)

    End If

    If (Not Blocked And
        Not Authoring.Editing() And
        Not Authoring.CameraBlocked() And
        Pointer_Y() >= 126 And
        Pointer_Y() < Window_Height() - 52 And
        Not Key_Held(KEY_CONTROL) And
        Not Key_Held(KEY_SHIFT) And
        Pointer_Pressed(POINTER_PRIMARY)) Then

        ResidentIndex = Conversation.Pick(Value.Residents, Value.View.LiveCamera,
            Pointer_X(), Pointer_Y(), Window_Width(), Window_Height())

        If ResidentIndex >= 0 Then

            Call RoadTravel.Cancel()
            Call Keyboard.StopTravel(Value.Keys)

            Started = Conversation.Request(Value.Residents, ResidentIndex,
                Value.People.Path.Positions[0], OrbitPoint)

            If Started And Value.Residents.ApproachActive Then
                Started = Authoring.BeginRoadTripTo(Value.People.Path.Positions[0], OrbitPoint)
                Value.Residents.ApproachActive = Started
            End If

            Value.Keys.FlyInspect = False

            Call HoldDisplayedView(Value)

            Return

        End If

    End If

    Pointer = Motion.ReadPointer(Blocked)

    If (Not Blocked And
        Pointer.Wheel <> 0 And
        Not Value.Flight.CursorOrbit) Then
        Call BeginPointerZoom(Value)
    Else If (Pointer.OrbitPressed Or
        Pointer.PanPressed Or
        Pointer_Pressed(POINTER_PRIMARY) Or
        Key <> 0) Then
        Value.Flight.CursorZoom = False
    End If

    Call Motion.ResolveGesture(Value.View.Controls, Pointer)

    If Value.Flight.CursorOrbit And Not Pointer.OrbitHeld Then
        Call Drone.FinishCursorOrbit(Value.Flight, Value.View, Value.BaseCamera)
    End If

    MovingGesture = Drone.MovingGesture(Value.Flight, Value.View, Pointer,
        Value.PartyCamera And Not Value.Keys.FlyInspect, MovementHeld())
    ArenaKey = Key

    If Not Blocked And Pointer.OrbitPressed Then
        Value.View.MaximumPitch = M.Radians(80.0)
    End If

    If Key = KEY_F And Key_Event_Held(KEY_CONTROL) Then

        ArenaKey = 0
        Value.PointOfView.Hidden = Not Value.PointOfView.Hidden
        Value.PointOfView.UpdatedAt = 0

    End If

    If Key = KEY_M And Key_Event_Held(KEY_CONTROL) Then
        Value.Panel.StatisticsHidden = Not Value.Panel.StatisticsHidden
    Else If Key = KEY_M Then
        Call TownMap.Toggle(Value.Map)
    End If

    If Key = KEY_R And Not Authoring.Editing() Then
        Call Party.SetRunning(Value.People, Not Value.People.Running)
    End If

    If Key = KEY_PLUS Then
        Value.People.SpeedPercent = Min(400, Value.People.SpeedPercent + 25)
    Else If Key = KEY_MINUS Then
        Value.People.SpeedPercent = Max(25, Value.People.SpeedPercent - 25)
    End If

    If (Not Blocked And
        Not MovingGesture And
        Not (Value.Follow And Pointer.OrbitPressed And Not Pointer.PanModifier) And
        (Pointer.OrbitPressed Or Pointer.PanPressed)) Then
        Call Keyboard.Capture(Value.Keys, Value.View, Value.BaseCamera)
        Call ManualCamera(Value)
    End If

    If (Not Blocked And
        (Not MovingGesture Or Value.Follow) And
        Pointer.OrbitPressed) Then

        Call BeginPointerOrbit(Value, Pointer.PanModifier)

        If (Not Value.Follow And
            Picking.OrbitPoint(Value.View.LiveCamera, Pointer_X(), Pointer_Y(),
            Window_Width(), Window_Height(), OrbitPoint)) Then
            Call Drone.BeginCursorOrbit(Value.Flight, Value.View.LiveCamera, OrbitPoint,
                Pointer_X(), Pointer_Y())
        End If

    End If

    If Not Blocked And Pointer_Pressed(POINTER_SECONDARY) Then
        Call StartOverviewOrbit(Value)
    Else If Key = KEY_C Or Key = KEY_O Then
        Call StartOrbit(Value)
    Else If Key = KEY_TAB And Key_Event_Held(KEY_CONTROL) Then
        Call Party.CycleLeader(Value.People)
    Else If Key = KEY_TAB Then
        Call FocusParty(Value)
    End If

    Call Arena.Update(Value.View, ArenaKey, Blocked, 24)

End Sub

''' Tab and conversation entry share the same eased return to the leader.
Public Sub FocusParty(ByRef Value As State)

    Value.View.MaximumPitch = M.Radians(80.0)

    Call Keyboard.StopTravel(Value.Keys)

    Value.Flight.Focusing = True
    Value.Flight.Enabled = True

    Call Arena.BeginTransition(Value.View, 1000)

    Value.Follow = True
    Value.PartyCamera = True
    Value.Keys.FlyInspect = False
    Value.Cinematic = False

    Call Drone.Focus(Value.Flight, Value.People.Members[0].Yaw, Value.View.LiveCamera)
    Call Motion.Reset(Value.View.Controls, Value.View.Zoom)

End Sub

Public Sub ObserveDemoInput(ByRef Value As State, Key As Number)

    If Not Value.Ready Then
        Return
    End If

    If Authoring.StopDemoOnInput(Key) Then
        Call HoldDisplayedView(Value)
    End If

End Sub

''' Keep the displayed shot while the actors turn, rather than swinging behind the new heading.
Public Sub HoldDisplayedView(ByRef Value As State)

    If Value.Follow Then
        Call Drone.AnchorParty(Value.Flight, Value.View, Value.BaseCamera, Value.People.Path.Positions[0])
    Else

        Call Drone.AnchorPoint(Value.Flight, Value.View, Value.BaseCamera, Value.View.LiveCamera.Target)
    End If

    Value.Cinematic = False
    Value.IdleOrbit = False
    Value.IdleTime = 0

End Sub

''' Zoom follows the picked map point while retaining the current orbit state.
Public Sub BeginPointerZoom(ByRef Value As State, Optional X As Number = -1, Optional Y As Number = -1)

    Dim Point As P.Vector3

    If X < 0 Or Y < 0 Then
        X = Pointer_X()
        Y = Pointer_Y()
    End If

    If Picking.OrbitPoint(Value.View.LiveCamera, X, Y,
        Window_Width(), Window_Height(), Point) Then

        Call Drone.BeginCursorZoom(Value.Flight, Value.View, Value.BaseCamera, Point, X, Y)

        Value.Follow = False
        Value.PartyCamera = False
        Value.OverviewOrbit = False
        Value.IdleOrbit = False
        Value.IdleTime = 0

    End If

End Sub

Public Sub ToggleDrone(ByRef Value As State)

    Call Keyboard.StopTravel(Value.Keys)

    Value.Flight.Enabled = Not Value.Flight.Enabled
    Value.Cinematic = False

    If Value.Flight.Enabled Then

        Call Arena.BeginTransition(Value.View)
        Call Drone.Focus(Value.Flight, Value.People.Members[0].Yaw, Value.View.LiveCamera)

        Value.Follow = True

    Else
        Value.BaseCamera = Value.View.LiveCamera
        Value.Follow = False

    End If

    Call Motion.Reset(Value.View.Controls, Value.View.Zoom)

End Sub

''' Start orbit from the displayed shot, absorbing existing pan and zoom exactly once.
Public Sub StartOrbit(ByRef Value As State, Optional CurrentView As Boolean = True)

    Call Keyboard.Capture(Value.Keys, Value.View, Value.BaseCamera)

    If CurrentView Then

        Value.Follow = False
        Value.PartyCamera = False

        Call Drone.AnchorPoint(Value.Flight, Value.View, Value.BaseCamera,
            Picking.OrbitCenter(Value.View.LiveCamera, Window_Width(), Window_Height()))

        Value.View.MaximumDistance = Max(Value.View.MaximumDistance,
            M.Distance(Value.BaseCamera.Position, Value.BaseCamera.Target))

    Else If (Value.Follow And
        (Value.PartyCamera Or Value.Cinematic) And
        Not Value.Keys.FlyInspect) Then

        Call Drone.AnchorParty(Value.Flight, Value.View, Value.BaseCamera, Value.People.Path.Positions[0])

    Else
        Value.Follow = False
        Value.PartyCamera = False

        If Value.Edited Then
            Call Drone.AnchorPoint(Value.Flight, Value.View, Value.BaseCamera,
                Authoring.MapCenter(Value.BaseCamera.Target.Y))
        End If

    End If

    Value.Flight.CursorOrbit = False
    Value.Flight.Suspended = True
    Value.Flight.Focusing = False
    Value.Flight.Arrival = False
    Value.Flight.Peeking = False
    Value.Cinematic = True
    Value.OverviewOrbit = Not CurrentView And Not Value.Follow
    Value.OrbitPaused = False
    Value.IdleOrbit = False
    Value.IdleTime = 0

End Sub

Public Sub MoveToRoad(ByRef Value As State, Point As P.Vector3)

    Dim Destination As P.Vector3

    If DocumentNavigation.NearestRoad(Point, Destination) Then
        Call RoadTravel.Cancel()
        Call Party.Teleport(Value.People, Destination, Value.People.Members[0].Yaw)
    End If

End Sub

''' Right-click always restores the same overview as opening this map tab.
Public Sub StartOverviewOrbit(ByRef Value As State)

    Call ResetOverview(Value)

    Value.IdleOrbit = False
    Value.IdleTime = 0

End Sub

Public Sub VisitAirport(ByRef Value As State)

    Dim Ok As Boolean

    If HorizonRoute.Active() Then
        Call VisitLandmark(Value, HorizonRoute.ToWorld(P.Vector(0.0, 0.0, -45.0)), 270.0)
    Else
        Ok = Authoring.TravelTo("Horizon Airport", HorizonRoute.ToWorld(P.Vector(0.0, 0.0, -45.0)))
    End If

End Sub

Private Sub VisitLandmark(ByRef Value As State, Position As P.Vector3, Heading As Double)

    Call Keyboard.StopTravel(Value.Keys)
    Call RoadTravel.Cancel()
    Call Party.Teleport(Value.People, Position, Heading)
    Call Drone.ArrivalFrame(Value.Flight, Value.View, Value.BaseCamera,
        Value.People.Path.Positions[0], Heading)

    Value.Follow = True
    Value.Cinematic = False
    Value.PartyCamera = True
    Value.InputActive = True
    Value.IdleTime = 0
    Value.IdleOrbit = False

End Sub

''' Mouse and automatic orbit share party anchoring; free inspection keeps cursor picking.
Public Sub BeginPointerOrbit(ByRef Value As State, Optional PanModifier As Boolean = False)

    Call Keyboard.Capture(Value.Keys, Value.View, Value.BaseCamera)

    If (Value.Follow And
        Not Value.Keys.FlyInspect And
        Not PanModifier) Then
        Call Drone.AnchorParty(Value.Flight, Value.View, Value.BaseCamera, Value.People.Path.Positions[0])
    Else

        Call ManualCamera(Value)
    End If

    Value.Cinematic = False

End Sub

''' Fit a sphere enclosing all town geometry, preserving an active orbit and bearing.
Public Sub FitTown(ByRef Value As State)

    Dim Direction As P.Vector3
    Dim Angle As Double
    Dim Distance As Double
    Dim Ok As Boolean

    Value.View.MaximumPitch = M.Radians(80.0)
    Value.Flight.CursorOrbit = False

    Call Keyboard.StopTravel(Value.Keys)

    Value.PartyCamera = False

    Direction = M.Subtract(Value.View.LiveCamera.Position, Value.View.LiveCamera.Target)
    Ok = M.TryNormalize(Direction, Direction)
    Angle = M.Radians(Value.BaseCamera.FovDegrees / 2.0)
    Angle = Atan2(Sin(Angle) * Min(1.0, ToDouble(Window_Width()) / ToDouble(Max(1, Window_Height()))), Cos(Angle))
    Distance = 5200.0 / Sin(Angle)

    Call Arena.BeginTransition(Value.View)

    Value.Follow = False
    Value.OverviewOrbit = True
    Value.Flight.Suspended = True
    Value.BaseCamera.Target = P.Vector(-1075.0, 650.0, 0.0)
    Value.BaseCamera.Position = M.Add(Value.BaseCamera.Target, M.Scale(Direction, Distance))

    If Value.Edited Then
        Call Authoring.FrameDocument(Value.BaseCamera)
    End If

    Call Motion.Reset(Value.View.Controls, Value.View.Zoom)

End Sub

Public Sub ResetOverview(ByRef Value As State, Optional Harbor As Boolean = False,
    Optional TransitionMilliseconds As Number = 0)

    Value.View.MaximumPitch = M.Radians(80.0)
    Value.View.MinimumDistance = 80.0
    Value.View.MaximumDistance = 18000.0
    Value.Flight.CursorOrbit = False
    Value.Flight.OrbitAtParty = False
    Value.Flight.CursorZoom = False
    Value.Keys.FlyInspect = False

    If Value.Harbor.Ready Or Value.Horizon.Ready Then
        Value.View.MaximumDistance = 40000.0
    End If

    Call Keyboard.StopTravel(Value.Keys)

    Value.PartyCamera = False

    Value.Cinematic = True
    Value.OverviewOrbit = True
    Value.OrbitPaused = False
    Value.IdleOrbit = False
    Value.IdleTime = 0
    Value.Follow = False
    Value.Flight.Suspended = True

    Call Tour.Frame(Value.BaseCamera, P.Vector(-1075.0, 150.0, 0.0))

    If Value.Edited Then
        Call Authoring.FrameDocument(Value.BaseCamera, True)
    Else If Value.Horizon.Ready Then
        Call Tour.Frame(Value.BaseCamera, Authoring.MapCenter(0.0), 14682.0, -98.0)
    Else If Value.Harbor.Ready Then
        Call Tour.Frame(Value.BaseCamera, Authoring.MapCenter(1044.0), 11438.0, -21.0, 17.0)
    End If

    If Value.Edited And Authoring.TownName() = "Neris Town" Then
        Call Tour.TownOverview(Value.BaseCamera, Authoring.MapCenter())
    End If

    If TransitionMilliseconds > 0 Then
        Call Tour.ContinueOrbit(Value.BaseCamera, Value.View.LiveCamera)
    End If

    Call Arena.BeginTransition(Value.View, TransitionMilliseconds)
    Call Motion.Reset(Value.View.Controls, Value.View.Zoom)
    Call Arena.ComposeCamera(Value.View, Value.BaseCamera)

End Sub

''' North stays at the top; the tiny pole offset keeps the world-up camera basis stable.
Public Sub TopDown(ByRef Value As State, Optional Orthographic As Boolean = False)

    Dim Distance As Double

    Value.Flight.CursorOrbit = False
    Value.Flight.CursorZoom = False

    Call Keyboard.StopTravel(Value.Keys)

    Distance = Max(200.0, M.Distance(Value.View.LiveCamera.Position, Value.View.LiveCamera.Target))
    Value.BaseCamera = Value.View.LiveCamera
    Value.BaseCamera.Position = M.Add(Value.BaseCamera.Target, P.Vector(0.0, Distance, -Distance * 0.0002))

    If Orthographic Then
        Value.BaseCamera = Drone.EditingView(Value.View.LiveCamera, 1)
    Else
        Value.BaseCamera.OrthographicHeight = 0.0
        Value.BaseCamera.UpDirection = P.Vector(0.0, 1.0, 0.0)
    End If

    Value.View.MaximumPitch = 1.57062
    Value.PartyCamera = False
    Value.Follow = False
    Value.Cinematic = False
    Value.IdleOrbit = False
    Value.IdleTime = 0
    Value.Flight.Suspended = True
    Value.Flight.Focusing = False
    Value.Flight.Arrival = False
    Value.InputActive = True

    Call Motion.Reset(Value.View.Controls, Value.View.Zoom)
    Call Arena.BeginTransition(Value.View, 0)
    Call Drone.Compose(Value.Flight, Value.View, Value.BaseCamera, False, 0)

End Sub

Private Sub SetEditingView(ByRef Value As State, Mode As Number)

    Dim Requested As P.Camera3D

    Requested = Drone.EditingView(Value.View.LiveCamera, Mode)

    Call TopDown(Value, Mode = 1)

    Value.BaseCamera = Requested

    Call Arena.ComposeCamera(Value.View, Value.BaseCamera)

End Sub

''' Fly mode is an explicit toggle; mouse gestures never select keyboard ownership.
Public Sub ToggleInspection(ByRef Value As State)

    Value.Keys.FlyInspect = Not Value.Keys.FlyInspect

    Call Keyboard.Capture(Value.Keys, Value.View, Value.BaseCamera)
    Call ManualCamera(Value)

End Sub

Private Sub ManualCamera(ByRef Value As State)

    Value.View.MaximumPitch = M.Radians(80.0)
    Value.Follow = False
    Value.PartyCamera = False
    Value.Cinematic = False
    Value.IdleOrbit = False
    Value.IdleTime = 0
    Value.Flight.Suspended = True
    Value.Flight.Arrival = False
    Value.Flight.Focusing = False
    Value.Flight.Peeking = False

End Sub

''' Route one held-key snapshot. WASD never depends on camera framing or mouse gestures.
Public Sub AdvanceKeyboard(ByRef Value As State, Keys As Keyboard.HeldKeys, Elapsed As Number)

    Dim Direction As P.Vector3
    Dim Translating As Boolean
    Dim Walking As Boolean

    Call Conversation.Advance(Value.Residents, Value.People.Path.Positions[0],
        Keys.Sideways <> 0.0 Or Keys.ForwardAmount <> 0.0 Or Value.Keys.FlyInspect)

    If Residents.Talking(Value.Residents) Then

        Call Party.FaceLeader(Value.People, Value.Residents.People[Value.Residents.Speaking].Motion.Position)
        Call Party.Stand(Value.People, Elapsed, True)

        If Not Value.ConversationFramed Then
            Call FocusParty(Value)

            Value.ConversationFramed = True
        End If

        Return

    End If

    Value.ConversationFramed = False
    Direction = Keyboard.CameraDirection(Value.View.LiveCamera, Keys, Value.Keys.FlyInspect)
    Translating = Keyboard.Translate(Value.Keys, Value.View, Value.BaseCamera, Direction, Elapsed)

    If Translating Then
        Call ManualCamera(Value)
    End If

    If Value.Keys.FlyInspect Then

        Call RoadTravel.Cancel()
        Call Party.Stand(Value.People, Elapsed)

    Else

        If Keys.ArrowSide <> 0.0 Or Keys.ArrowForward <> 0.0 Then

            If Value.Follow And Not Value.Flight.OrbitAtParty Then
                Call Keyboard.Capture(Value.Keys, Value.View, Value.BaseCamera)
                Call Drone.AnchorParty(Value.Flight, Value.View, Value.BaseCamera, Value.People.Path.Positions[0])
            Else If Not Value.Follow Then
                Call ManualCamera(Value)
            End If

            If (Keys.ArrowForward <> 0.0 And
                Not Value.Keys.Zooming And
                Not Value.Follow) Then
                Call Limits.BeginZoom(Value.View, Value.BaseCamera)
            End If

            Call Keyboard.OrbitZoom(Value.View, Keys, Elapsed)

        End If

        Walking = Keys.Sideways <> 0.0 Or Keys.ForwardAmount <> 0.0
        Direction = Keyboard.PartyDirection(Drone.MovementCamera(Value.Flight,
            Value.View.LiveCamera, Walking), Keys)

        If Walking Then
            Call RoadTravel.Cancel()
        Else If Value.Edited And RoadTravel.Active() Then
            Direction = Authoring.RoadDirection(Value.People.Path.Positions[0],
                Party.WalkingSpeed(Value.People) * ToDouble(Elapsed) / 1000.0, Elapsed)
        End If

        Call MoveParty(Value, Direction, Elapsed)

    End If

    Value.Keys.Zooming = Keys.ArrowForward <> 0.0 And Not Value.Keys.FlyInspect

End Sub

''' Party movement retains navigation, collision and follower ownership.
Public Sub MoveParty(ByRef Value As State, Direction As P.Vector3, Elapsed As Number)

    Dim Leader As P.Vector3
    Dim Distance As Double
    Dim Destination As Text
    Dim Ok As Boolean

    Leader = Value.People.Path.Positions[0]

    Call OnMovement(Value, M.Length(Direction) > 0.001)

    If M.Length(Direction) > 0.001 Then
        Distance = Party.WalkingSpeed(Value.People) * ToDouble(Elapsed) / 1000.0
        Leader = Navigation.Move(Leader, Direction.X * Distance, Direction.Z * Distance)
    End If

    Call Party.Update(Value.People, Leader, Elapsed)

    If Value.Edited And Not Authoring.Editing() Then

        If Authoring.TravelOnTile(Leader, M.Length(Direction) > 0.001) Then
            Return
        End If

        Destination = Connections.Destination(Authoring.TownName(), Leader, M.Length(Direction) > 0.001)

        If Text_Length(Destination) > 0 Then
            Ok = Authoring.TravelTo(Destination, Connections.Arrival(Destination, Authoring.TownName()))
        End If

    End If

End Sub

Public Sub Update(ByRef Value As State, Elapsed As Number)

    Dim Held As Keyboard.HeldKeys
    Dim Leader As P.Vector3
    Dim ArrivalHeading As Double
    Dim TabOverview As Boolean
    Dim OverviewTransition As Number
    Dim MapCenter As P.Vector3
    Dim CenterOffset As P.Vector3

    If (Value.Edited And
        (Value.Landmarks.Town <> Authoring.TownName() Or
        (Authoring.CourtExists() And Not Value.Comparison.Ready))) Then
        Call Authoring.Update(Value.People.Path.Positions[0], Elapsed)

        Value.Ready = False
    End If

    If Not Value.Ready Then

        Call LoadNext(Value)

        If Not Value.Ready Then
            Return
        End If

    End If

    If Authoring.PreviewActive() Then
        Call Authoring.Update(Value.People.Path.Positions[0], Elapsed)

        Return
    End If

    Held = Keyboard.ReadKeys(Authoring.CameraBlocked() Or
        (Authoring.Editing() And Key_Held(KEY_CONTROL)))

    Call Authoring.UpdateDemoIdle(Value.View.LiveCamera, Elapsed,
        Value.InputActive Or Keyboard.Active(Held) Or Residents.Talking(Value.Residents))
    Call UpdateIdle(Value, Value.InputActive Or Keyboard.Active(Held) Or RoadTravel.Active() Or
        Authoring.GestureActive() Or Residents.Talking(Value.Residents), Elapsed,
        False, Authoring.MapHovered())

    If CastleRoute.Active() Then
        Call CastleRoute.Update(Value.People.Path, Value.People.MemberCount, Elapsed)
    End If

    If SpaceportRoute.Active() Then
        Call SpaceportRoute.Update(Value.People.Path, Value.People.MemberCount, Elapsed)
    End If

    Call HorizonRoute.Update(Value.People.Path, Value.People.MemberCount, Elapsed)
    Call Horizon.Update(Value.Horizon, Elapsed)
    Call Spaceport.Update(Value.Harbor, Elapsed)
    Call AdvanceKeyboard(Value, Held, Elapsed)

    Leader = Value.People.Path.Positions[0]

    If Value.Edited Then

        Call Authoring.Update(Leader, Elapsed)
        Call Authoring.SizeArena(Value.View.Floor)

        If (Value.Cinematic And
            Value.OverviewOrbit And
            Not Value.Follow) Then

            MapCenter = Authoring.MapCenter(Value.BaseCamera.Target.Y)
            CenterOffset = M.Subtract(MapCenter, Value.BaseCamera.Target)
            Value.BaseCamera.Position = M.Add(Value.BaseCamera.Position, CenterOffset)
            Value.BaseCamera.Target = MapCenter

        End If

        If Authoring.TakeSpawn(Leader, TabOverview, ArrivalHeading) Then

            Call RoadTravel.Cancel()
            Call Party.Teleport(Value.People, Leader, ArrivalHeading)

            If TabOverview Then

                If Authoring.TakeDemoCamera(Value.View.LiveCamera) Then
                    OverviewTransition = 1000
                End If

                Call ResetOverview(Value, False, OverviewTransition)

            Else If Authoring.Editing() Then

                Call FitTown(Value)

            Else

                Call Drone.ArrivalFrame(Value.Flight, Value.View, Value.BaseCamera, Leader, ArrivalHeading)

                Value.Follow = True
                Value.Cinematic = False
                Value.PartyCamera = True

            End If

        End If

    Else

        Call Appearance.Update(Value.Look, Elapsed)
        Call Entrances.Update(Value.Doors, Leader, Elapsed)

    End If

    Call Castle.Synchronize(Value.Comparison, Authoring.CourtExists(), Authoring.CourtOffset())
    Call Castle.Update(Value.Comparison, Elapsed)
    Call TownMap.Update(Value.Map, Party.IsMoving(Value.People) Or
        (Value.Map.Opacity > 0.0 And Authoring.MapHovered()), Elapsed)
    Call Inset.Update(Value.PointOfView, Party.IsMoving(Value.People), Elapsed)
    Call Residents.Update(Value.Residents, Authoring.TownName(), Authoring.Editing(), Leader, Elapsed)

    If Value.Cinematic And Not Value.OrbitPaused Then
        Value.View.Controls.OrbitYaw = Camera.NormalizeAngle(Value.View.Controls.OrbitYaw + ToDouble(Elapsed) * 0.0025)
    End If

    If Value.Follow And Not Value.Keys.FlyInspect Then
        Value.BaseCamera = Drone.Frame(Value.Flight, Value.BaseCamera, Leader,
            Value.People.Members[0].Yaw, Party.IsMoving(Value.People), Elapsed)
    End If

    Call Drone.Compose(Value.Flight, Value.View, Value.BaseCamera, Value.Follow And Not Value.Keys.FlyInspect, Elapsed,
        Drone.GroundShot(Value.Flight, Value.PartyCamera) Or Value.Cinematic,
        Value.Keys.FlyInspect)

End Sub

Private Function MovementHeld() As Boolean

    Dim Result As Boolean

    Result = Key_Held(KEY_W) Or Key_Held(KEY_S) Or Key_Held(KEY_A) Or Key_Held(KEY_D)

    Return Result

End Function

Public Sub UpdateIdle(ByRef Value As State, Active As Boolean, Elapsed As Number,
    Optional WheelOnly As Boolean = False, Optional HoveringMap As Boolean = False)

    If (Not Value.Cinematic And
        Value.Map.Opacity > 0.0 And
        HoveringMap) Then
        Active = True
    End If

    If (Active Or
        Authoring.Editing() Or
        Value.Keys.FlyInspect) Then

        Value.IdleTime = 0

        If Value.IdleOrbit And Not (WheelOnly And Value.Cinematic) Then
            Call HoldDisplayedView(Value)
        End If

    Else

        Value.IdleTime = Min(20000, Value.IdleTime + Max(0, Elapsed))

        If Value.IdleTime = 20000 And Not Value.Cinematic Then
            Call StartOrbit(Value, False)

            Value.IdleOrbit = True
        End If

    End If

End Sub

''' Walking stops the showcase orbit but leaves the user's framing intact.
Public Sub OnMovement(ByRef Value As State, Moving As Boolean)

    If Moving Then
        Value.Flight.Arrival = False
        Value.Cinematic = False
    End If

End Sub

Public Sub Draw(ByRef Value As State)

    Dim Ok As Boolean
    Dim FrameStarted As Boolean

    If (Value.Edited And
        (Value.Landmarks.Town <> Authoring.TownName() Or
        (Authoring.CourtExists() And Not Value.Comparison.Ready))) Then
        Value.Ready = False
    End If

    If Not Value.Ready Then

        If Authoring.PreviewActive() Then
            Clear RGB(12, 23, 36)
            Return
        End If

        If Value.View.Ready Then

            Ok = Arena.BeginFrame(Value.View, Value.BaseCamera, True, False)

            If Ok Then
                Ok = Scene.EndScene()
            End If

        Else
            Clear RGB(12, 20, 32)

        End If

        Draw Text Authoring.TownName() At 38, 132 Size 32 Color WHITE

        If Value.Failed Then

            Draw Text "The Town Could Not Be Loaded. Select Another Tab To Retry." At 38, 185 Size 18 Color WHITE

        Else
            Draw Text "Loading Buildings And Party..." At 38, 185 Size 18 Color WHITE
            Fill Rectangle 38, 226, 520, 10, RGB(40, 52, 65)

            If Value.Edited Then
                Fill Rectangle 38, 226, 520 * Authoring.Progress() / 100, 10, RGB(70, 210, 205)
            Else
                Fill Rectangle 38, 226, 520 * (Value.Town.Loaded + Value.People.Loaded) / (Assets.CHUNK_COUNT + Value.People.MemberCount), 10, RGB(70, 210, 205)
            End If

        End If

        Return

    End If

    Ok = True

    If Value.Edited Then
        Ok = Castle.ApplyLighting(Value.Comparison)
        Ok = Authoring.ApplyLocalLighting() And Ok
    End If

    If Value.Edited And Authoring.BeginWorldPhotograph() Then

        Ok = DrawContents(Value) And Ok

        Call WorldPreviews.Finish()

        Value.PointOfView.UpdatedAt = 0

    End If

    If Authoring.PreviewActive() Then
        Clear RGB(12, 23, 36)

        Return
    End If

    FrameStarted = Arena.BeginFrame(Value.View, Value.BaseCamera, True, False)
    Ok = FrameStarted And Ok

    If FrameStarted Then

        Ok = Arena.Draw(Value.View) And Ok
        Ok = DrawContents(Value) And Ok

        Call CameraPanel.CaptureGeometry(Value.Panel)

        Ok = Scene.EndScene() And Ok

    End If

    If Inset.Visible(Value.PointOfView, Authoring.Editing()) Then

        If Inset.Begin(Value.PointOfView, Value.People.Path.Positions[0], Value.People.Members[0].Yaw) Then
            Ok = DrawContents(Value) And Ok

            Call Inset.Finish(Value.PointOfView)
        End If

    Else
        Value.PointOfView.UpdatedAt = 0

    End If

    Value.Failed = Value.Failed Or Not Ok Or Not Value.People.Ready

End Sub

Private Function DrawContents(ByRef Value As State) As Boolean

    Dim Ok As Boolean

    Ok = Party.Draw(Value.People)
    Ok = Residents.Draw(Value.Residents, Authoring.TownName()) And Ok

    If Value.Edited Then

        Ok = Authoring.Draw() And Ok

    Else

        Ok = Assets.Draw(Value.Town) And Ok
        Ok = Appearance.Draw(Value.Look) And Ok
        Ok = Entrances.Draw(Value.Doors) And Ok

    End If

    Ok = Castle.Draw(Value.Comparison) And Ok
    Ok = Spaceport.Draw(Value.Harbor) And Ok
    Ok = Horizon.Draw(Value.Horizon) And Ok

    Return Ok

End Function

Public Sub Overlay(ByRef Value As State)

    Dim MapStatusY As Number

    MapStatusY = 533

    If Inset.Visible(Value.PointOfView, Authoring.Editing()) Then
        MapStatusY = Inset.Bottom()
    End If

    Fill Rectangle 0, 0, Window_Width(), 94, RGB(12, 20, 32) Opacity 80
    Draw Text Text_Slice(Authoring.TownName(), 0, 20) At 18, 12 Size 18 Color WHITE
    Draw Text "Speed: " + Numbers.NumberText(Value.People.SpeedPercent) + "%  (+ / -)" At 405, 18 Size 16 Color WHITE

    Call SunControls.DrawDayNight(Authoring.IsNight(), Layout.ButtonLeft(1), Window_Height() - 38)
    Call Layout.DrawButton(2, Authoring.Editing())

    If Not Value.Ready Then
        Call Authoring.Overlay(Value.View.LiveCamera, True)

        Return
    End If

    If Value.Ready Then

        If Not Authoring.Editing() Then

            If Value.Edited Then

                If Not Value.Cinematic Or Inset.Visible(Value.PointOfView, False) Then
                    Call Authoring.DrawMap(Value.People.Path.Positions[0], ToNumber(Value.Map.Opacity), Party.LeaderName(Value.People),
                        CastleRoute.MapLabel(), P.Vector(CastleRoute.CenterX(), CastleRoute.DECK_Y, CastleRoute.CenterZ()),
                        Landmarks.AirportMapLabel(), Landmarks.AirportMapPosition(),
                        Value.Map.Headlight, Value.People.Members[0].Yaw, MapStatusY)
                    Call DocumentMap.DrawResidents(Value.Residents, ToNumber(Value.Map.Opacity))
                End If

            Else

                Call TownMap.Draw(Value.Map, Value.People.Path.Positions[0], Value.People.Members[0].Yaw,
                    Value.Cinematic, Party.LeaderName(Value.People))

            End If

        End If

        If Value.People.Running Then
            Draw Text "Run" At 345, 18 Size 16 Color RGB(70, 210, 205)
        Else
            Draw Text "Walk" At 345, 18 Size 16 Color RGB(70, 210, 205)
        End If

        If Value.Keys.FlyInspect Then
            Draw Text "Fly Inspect" At 180, 42 Size 14 Color RGB(70, 210, 205)
        Else If Value.Cinematic And Value.Follow Then
            Draw Text "Party Orbit" At 180, 42 Size 14 Color RGB(70, 210, 205)
        Else If Value.Cinematic Then
            Draw Text "Map Orbit" At 180, 42 Size 14 Color RGB(70, 210, 205)
        Else If Value.PartyCamera Then
            Draw Text "Follow Party" At 180, 42 Size 14 Color RGB(70, 210, 205)
        Else
            Draw Text "Free Camera" At 180, 42 Size 14 Color RGB(70, 210, 205)
        End If

    End If

    If Value.Edited And Value.Ready Then
        Call Authoring.Overlay(Value.View.LiveCamera)
    End If

    If Authoring.PreviewActive() Then
        Return
    End If

    Call CameraPanel.Draw(Value.Panel, Value.View, Value.Cinematic,
        Value.PartyCamera, Value.Flight.Enabled And Not Value.Flight.Suspended,
        Drone.GroundShot(Value.Flight, Value.PartyCamera), Value.Keys.FlyInspect, Authoring.Editing())

    If Inset.Visible(Value.PointOfView, Authoring.Editing()) Then
        Call Inset.Label(Value.PointOfView, Party.LeaderName(Value.People))
    End If

    If Authoring.MapStatisticsVisible() Then
        Call CameraPanel.MapStatistics(Value.Panel, Value.View, Residents.Talking(Value.Residents))
    End If

    If Not Authoring.Editing() And Not Authoring.PreviewActive() Then
        Call Residents.Overlay(Value.Residents)
    End If

End Sub

Public Sub Destroy(ByRef Value As State)

    Call Residents.Destroy(Value.Residents)

    Call Landmarks.Destroy(Value.Landmarks, Value.Comparison, Value.Harbor, Value.Horizon)

    If Value.Edited Then
        Call Authoring.Release()
    End If

    Call Entrances.Destroy(Value.Doors)
    Call Appearance.Destroy(Value.Look)
    Call TownMap.Destroy(Value.Map)
    Call Party.Destroy(Value.People)
    Call Assets.Destroy(Value.Town)
    Call Arena.Destroy(Value.View)
    Call Character.Shutdown()
    Call Scene.Shutdown()

    Value.Ready = False

End Sub

End Module
