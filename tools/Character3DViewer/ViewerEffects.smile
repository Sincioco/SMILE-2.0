''' Scene VFX clock ownership, independent family freeze controls and shared effect lifecycle.
Module Smile.Tools.Character3DViewerEffects

Option Explicit

Import Smile.Simple3D.Character3D As Character3D
Import Smile.Simple3D.Core As Core
Import Smile.Simple3D.Precision3D As Precision3D
Import Smile.Simple3D.PrecisionMath3D As PreciseMath
Import Smile.Simple3D.FireEmitter3D As Fire
Import Smile.Simple3D.Graphics3D As Graphics3D
Import Smile.Simple3D.LightningVfx3D As Lightning
Import Smile.Simple3D.LightPool3D As LightPool3D
Import Smile.Simple3D.FixedMath As Fixed
Import Smile.Simple3D.Math3D As Math3D
Import Smile.Simple3D.SceneVfx3D As SceneVfx3D
Import Smile.Tools.ArinShieldRim As ArinShieldRim
Import Smile.Tools.OrinStorm As OrinStorm
Import Smile.Tools.BattleAudio As BattleAudio
Import Smile.Tools.Character3DViewerProfiles As ViewerProfiles
Import Smile.Tools.Character3DViewerDragon As ViewerDragon

Private Const TRAIL_POINT_COUNT = 5
Private Const TRAIL_SAMPLE_MILLISECONDS = 24
Private Const SWORD_TRAIL_START_MILLISECONDS = 300
Private Const SWORD_TRAIL_END_MILLISECONDS = 967
Private Const SHIELD_TRAIL_START_MILLISECONDS = 350
Private Const SHIELD_TRAIL_END_MILLISECONDS = 650
Private Const GLOW_SCALE_DIVISOR = 60
Private Const SWORD_TRAIL_PARTICLE_SIZE = 3
Private Const SHIELD_TRAIL_PARTICLE_SIZE = 5
Private Const SHIELD_PART_INDEX = 0
Private Const WEAPON_PART_INDEX = 1
Private Const BODY_PART_INDEX = 2

Public Type ZaraAttackEffects
    BladeArc As Lightning.LightningEffect
    Storm[4] As Lightning.LightningEffect
    Clip As Text
    Time As Number
    Epoch As Number
    LiveTime As Number
    WasPaused As Boolean
End Type

Public Type State
    ZaraAttacks As ZaraAttackEffects
    ProfileIndex As Number
    VraxAttacks As ViewerDragon.AttackEffects
    VraxAudio As ViewerDragon.VraxAudioState
    ShieldRim As ArinShieldRim.Context
    WeaponRim As ArinShieldRim.Context
    IntensityInitialized As Boolean
    EquipmentIntensity[8] As Number
    StormStyleSelected As Boolean
    StormEquipmentStyle As Number
    Clock As SceneVfx3D.Clock
    FireInitialized As Boolean
    LightningInitialized As Boolean
    FlamePaused As Boolean
    LightningPaused As Boolean
    FlamesWerePaused As Boolean
    VisualContinuityEpoch As Number
    EquipmentFireEpoch As Number
    VisualHistoryDirty As Boolean
    EquipmentFireFirstSample As Boolean
    EquipmentFireFirstError As Number
    OrinStorm As OrinStorm.Context
    OrinLight As LightPool3D.Lease
    DragonLight As LightPool3D.Lease
    ArinAudio As BattleAudio.CueState
    ZaraAudio As BattleAudio.CueState
    ZaraImpactAudio As BattleAudio.CueState
    ZaraThunderAudio As BattleAudio.CueState
    EpicGlowAvailable As Boolean
    EpicGlowVisible As Boolean
    EpicGlowTexture As Core.Texture3D
    EpicGlowMaterial As Core.Material3D
    EpicGlowParticleMaterial As Core.Material3D
    SwordGlow As Core.Object3D
    ShieldGlow As Core.Object3D
    SwordFire As Fire.FireEmitter
    SwordFireReady As Boolean
    SwordFireVisible As Boolean
    SwordFireFailed As Boolean
    SwordFireClip As Number
    SwordFireTime As Number
    SwordFireBase As Precision3D.Vector3
    SwordFireTip As Precision3D.Vector3
    ShieldFire[3] As Fire.FireEmitter
    ShieldFirePoints[3] As Precision3D.Vector3
    ShieldFireVisible As Boolean
    ShieldFlameStyle As Boolean
    ShieldFireFailed As Boolean
    ShieldFireClip As Number
    ShieldFireTime As Number
    SwordTrail As Core.ParticleBatch3D
    ShieldTrail As Core.ParticleBatch3D
    SwordTrailPoints[TRAIL_POINT_COUNT] As Precision3D.Vector3
    ShieldTrailPoints[TRAIL_POINT_COUNT] As Precision3D.Vector3
    EquipmentTrailElapsed As Number
    EquipmentTrailAnimationTime As Number
    SwordTrailActive As Boolean
    ShieldTrailActive As Boolean
End Type

Public Function PrepareShared(ByRef Value As State) As Boolean

    Dim Result As Boolean

    Value.FireInitialized = False
    Value.LightningInitialized = False
    Value.FlamePaused = False
    Value.LightningPaused = False

    Call SceneVfx3D.Initialize(Value.Clock)

    Result = LightPool3D.Initialize(2, 2)
    Value.OrinLight = LightPool3D.Acquire()
    Value.DragonLight = LightPool3D.Acquire()
    Result = LightPool3D.IsValid(Value.OrinLight) And Result
    Result = LightPool3D.IsValid(Value.DragonLight) And Result

    Return Result

End Function

Public Sub ResetEquipmentDefaults(ByRef Value As State)

    Dim Index As Number

    If Not Value.IntensityInitialized Then

        For Index = 0 To 7
            Value.EquipmentIntensity[Index] = 100
        End For

        Value.IntensityInitialized = True

    End If

    Value.SwordFireVisible = True
    Value.ShieldFireVisible = True
    Value.ShieldFlameStyle = True
    Value.ShieldFireFailed = False
    Value.SwordFireFailed = False
    Value.SwordFireReady = False

End Sub

Public Sub PrepareFire(ByRef Value As State, FireRequired As Boolean,
    SwordFireEligible As Boolean)

    If FireRequired Then
        Value.FireInitialized = Fire.Initialize("Assets/Fire")
    End If

    Value.SwordFireReady = SwordFireEligible And Value.FireInitialized
    Value.SwordFireFailed = SwordFireEligible And Not Value.SwordFireReady

    If Value.SwordFireReady Then
        Value.SwordFireReady = Graphics3D.ConfigureSoftDepth3D(1)
        Value.SwordFireReady = Graphics3D.ConfigureDistortion3D(1, 2) And Value.SwordFireReady
    End If

End Sub

Public Sub EnableSwordFire(ByRef Value As State)

    Value.SwordFireReady = Value.FireInitialized

End Sub

Public Function PrepareLightning(ByRef Value As State) As Boolean

    Dim Result As Boolean

    Value.LightningInitialized = Lightning.Initialize(
        "Assets/Lightning",
        8192,
        Graphics3D.GPU_PARTICLE_SIMULATION_AUTO,
        4096
    )

    Call OrinStorm.Prepare(Value.LightningInitialized)

    Value.OrinStorm = OrinStorm.Create()

    If Not Value.StormStyleSelected Then
        Value.StormEquipmentStyle = OrinStorm.EQUIPMENT_BLUE_FLAME
    End If

    Call OrinStorm.SetEquipmentStyle(Value.OrinStorm, Value.StormEquipmentStyle)

    Result = Value.LightningInitialized And OrinStorm.IsValid(Value.OrinStorm)

    Return Result

End Function

Public Sub CycleStormEquipment(ByRef Value As State)

    Dim NextStyle As Number

    NextStyle = (OrinStorm.EquipmentStyle(Value.OrinStorm) + 1) Mod 3
    Value.StormEquipmentStyle = NextStyle
    Value.StormStyleSelected = True

    Call OrinStorm.SetEquipmentStyle(Value.OrinStorm, NextStyle)

End Sub

Public Function Intensity(ByRef Value As State, Profile As Number, Shield As Boolean) As Number

    Dim Index As Number
    Dim Result As Number

    If Not Value.IntensityInitialized Then
        Return 100
    End If

    Index = IntensityTarget(Profile, Shield)

    If Index < 0 Then
        Return 100
    End If

    Result = Value.EquipmentIntensity[Index]

    Return Result

End Function

Public Function IntensityTarget(Profile As Number, Shield As Boolean) As Number

    Dim Result As Number

    Result = -1

    If Profile = ViewerProfiles.PROFILE_ARIN Then
        Result = 0
    Else If Profile = ViewerProfiles.PROFILE_ORIN Then
        Result = 2
    Else If Profile = ViewerProfiles.PROFILE_VALOR Then
        Result = 4
    Else If Profile = ViewerProfiles.PROFILE_ZARA Then
        Result = 6
    End If

    If Result >= 0 And Shield Then
        Result = Result + 1
    End If

    Return Result

End Function

Public Sub SetIntensity(ByRef Value As State, Profile As Number,
    Shield As Boolean, IntensityValue As Number)

    Dim Target As Number

    Target = IntensityTarget(Profile, Shield)

    If Target < 0 Then
        Return
    End If

    If Not Value.IntensityInitialized Then
        Call ResetEquipmentDefaults(Value)
    End If

    Value.EquipmentIntensity[Target] = Max(0, Min(200, IntensityValue))

End Sub

''' UI target order: Arin, Orin, Valor and Zara weapon/shield pairs. Session preferences only.
Public Sub AdjustIntensity(ByRef Value As State, Target As Number, Increase As Boolean)

    Dim Step As Number

    If Target < 0 Or Target > 7 Then
        Return
    End If

    If Not Value.IntensityInitialized Then
        Call ResetEquipmentDefaults(Value)
    End If

    Step = -10

    If Increase Then
        Step = 10
    End If

    Value.EquipmentIntensity[Target] = Max(0, Min(200, Value.EquipmentIntensity[Target] + Step))

End Sub

Public Function StormEquipmentName(ByRef Value As State) As Text

    Dim Style As Number

    Style = OrinStorm.EquipmentStyle(Value.OrinStorm)

    If Style = OrinStorm.EQUIPMENT_BLUE_FLAME Then
        Return "VFX: Blue Flame"
    Else If Style = OrinStorm.EQUIPMENT_NEON_ARCS Then
        Return "VFX: Neon Arcs"
    End If

    Return "VFX: Lightning"

End Function

Public Function StormUsesFire(ByRef Value As State) As Boolean

    Dim Result As Boolean

    Result = OrinStorm.EquipmentStyle(Value.OrinStorm) = OrinStorm.EQUIPMENT_BLUE_FLAME

    Return Result

End Function

Public Sub ToggleStormPause(ByRef Value As State)

    If StormUsesFire(Value) Then
        Call ToggleFlamePause(Value)
    Else

        Call ToggleLightningPause(Value)
    End If

End Sub

Public Function ShouldFreeze(ScenePaused As Boolean, ExplicitlyPaused As Boolean) As Boolean

    Dim Result As Boolean

    ''' Scene pause freezes actors and choreography, not VFX. Each existing VFX
    ''' toggle remains the only control that freezes its Fire or Lightning family.
    Result = ExplicitlyPaused

    Return Result

End Function

Public Function AdvanceScene(ByRef Value As State, CameraElapsed As Number,
    ScenePaused As Boolean, Camera As Precision3D.Camera3D) As Boolean

    Dim FlameFrozen As Boolean
    Dim LightningFrozen As Boolean
    Dim Result As Boolean

    FlameFrozen = ShouldFreeze(ScenePaused, Value.FlamePaused)
    LightningFrozen = ShouldFreeze(ScenePaused, Value.LightningPaused)
    Result = SceneVfx3D.BeginFrame(Value.Clock, CameraElapsed,
        FlameFrozen, LightningFrozen)
    Result = SceneVfx3D.AdvancePrecise(Value.Clock, Camera,
        Value.FireInitialized, Value.LightningInitialized) And Result

    Return Result

End Function

Public Sub ToggleFlamePause(ByRef Value As State)

    Value.FlamePaused = Not Value.FlamePaused

End Sub

Public Sub ToggleLightningPause(ByRef Value As State)

    Value.LightningPaused = Not Value.LightningPaused

End Sub

Public Sub ToggleSwordFire(ByRef Value As State)

    Value.SwordFireVisible = Not Value.SwordFireVisible

    If Not Value.SwordFireVisible Then
        Call ClearSwordFire(Value)
    End If

End Sub

Public Sub ToggleShieldFire(ByRef Value As State)

    Value.ShieldFireVisible = Not Value.ShieldFireVisible

    If Not Value.ShieldFireVisible Then
        Call ClearShieldFire(Value)
    End If

End Sub

Public Sub ResetPlaybackControls(ByRef Value As State)

    Value.FlamePaused = False
    Value.LightningPaused = False
    Value.SwordFireFailed = False
    Value.ShieldFireFailed = False
    Value.EquipmentFireFirstError = 0
    Value.SwordFireVisible = True
    Value.ShieldFireVisible = True

    Call ClearEquipmentFire(Value)

End Sub

Public Sub ResetEpicGlowVisibility(ByRef Value As State,
    VisibleByDefault As Boolean)

    Value.EpicGlowVisible = VisibleByDefault And Value.EpicGlowAvailable

End Sub

Public Sub HideEpicGlow(ByRef Value As State)

    Value.EpicGlowVisible = False

End Sub

Public Sub ResetAudio(ByRef Value As State)

    Value.ArinAudio.Clip = ""
    Value.VraxAudio.Voice.Clip = ""
    Value.VraxAudio.Swoosh.Clip = ""

End Sub

Public Sub UpdateArinAudio(ByRef Value As State, ProfileIndex As Number,
    ClipName As Text, AnimationTime As Number, Audible As Boolean)

    Dim CueTime As Number

    CueTime = -1

    If ProfileIndex = ViewerProfiles.PROFILE_ARIN Then

        If ClipName = "SwordAttack" Then
            CueTime = 280
        Else If ClipName = "SwordAttack2" Then
            CueTime = 160
        End If

    End If

    If BattleAudio.CrossedCue(
        Value.ArinAudio, ClipName, AnimationTime, CueTime, Audible) Then

        If ClipName = "SwordAttack" Then

            Play Sound "Assets/Audio/arin-flame-slash.wav"

        Else

            Play Sound "Assets/Audio/arin-flame-crosscut.wav"

        End If

    End If

End Sub

Public Sub CycleStormStyle(ByRef Value As State)

    Call OrinStorm.CycleStyle(Value.OrinStorm)

End Sub

Public Sub CycleStormSceneComfort()

    Call OrinStorm.CycleSceneComfort()

End Sub

Public Function StormStyleName(ByRef Value As State) As Text

    Dim Result As Text

    Result = OrinStorm.StyleName(Value.OrinStorm)

    Return Result

End Function

Public Function StormSceneComfortName() As Text

    Dim Result As Text

    Result = OrinStorm.SceneComfortName()

    Return Result

End Function

Public Function StormCaption(ByRef Value As State) As Text

    Dim Result As Text

    Result = OrinStorm.Caption(Value.OrinStorm)

    Return Result

End Function

Public Sub InvalidateVisualHistory(ByRef Value As State)

    Value.VisualContinuityEpoch = Min(2147483647, Value.VisualContinuityEpoch + 1)
    Value.VisualHistoryDirty = True

End Sub

Public Sub CreateEpicGlow(ByRef Value As State, ProfileIndex As Number,
    ByRef Actor As Character3D.Actor)

    Dim EmptyTexture As Core.Texture3D
    Dim GlowReady As Boolean

    Value.ProfileIndex = ProfileIndex
    Value.EpicGlowAvailable = ViewerProfiles.EpicGlowAvailable(ProfileIndex)
    Value.EpicGlowAvailable = Character3D.HasSocket(Actor, "SwordBase") And Value.EpicGlowAvailable
    Value.EpicGlowAvailable = Character3D.HasSocket(Actor, "SwordTip") And Value.EpicGlowAvailable

    If ViewerProfiles.ShieldPart(ProfileIndex) >= 0 Then
        Value.EpicGlowAvailable = Character3D.HasSocket(Actor, "ShieldCenter") And Value.EpicGlowAvailable
    End If

    Value.EpicGlowVisible = ViewerProfiles.EpicGlowVisibleByDefault(ProfileIndex) And Value.EpicGlowAvailable

    If Not Value.EpicGlowAvailable Then
        Return
    End If

    Value.EpicGlowTexture = Graphics3D.LoadTexture3D(
        "TechnicalAssets\Generation2\VfxAtlas.png",
        Graphics3D.TEXTURE_FILTER_LINEAR,
        Graphics3D.TEXTURE_WRAP_CLAMP
    )
    GlowReady = Value.EpicGlowTexture.Handle <> 0

    If GlowReady Then
        Value.EpicGlowMaterial = Graphics3D.CreateEffectMaterial3D(
            EmptyTexture,
            Graphics3D.MATERIAL_ALPHA_ADDITIVE,
            220
        )
        GlowReady = Value.EpicGlowMaterial.Handle <> 0
    End If

    If GlowReady Then
        Value.EpicGlowParticleMaterial = Graphics3D.CreateEffectMaterial3D(
            Value.EpicGlowTexture,
            Graphics3D.MATERIAL_ALPHA_ADDITIVE,
            220
        )
        GlowReady = Value.EpicGlowParticleMaterial.Handle <> 0
    End If

    If GlowReady Then
        GlowReady = CreateBorrowedEpicGlow(Actor, Value.EpicGlowMaterial,
            Value.SwordGlow, Value.ShieldGlow, ViewerProfiles.EquipmentGlowStyle(ProfileIndex),
            ViewerProfiles.WeaponPart(ProfileIndex), ViewerProfiles.ShieldPart(ProfileIndex))
    End If

    If GlowReady And ProfileIndex = ViewerProfiles.PROFILE_ZARA Then
        Call Graphics3D.SetObjectColor(Value.SwordGlow, 255, 238, 240)
    End If

    If GlowReady Then
        Value.SwordTrail = Graphics3D.CreateParticleBatch3D(
            TRAIL_POINT_COUNT,
            Value.EpicGlowParticleMaterial,
            Graphics3D.VFX_BILLBOARD_CAMERA,
            4,
            4
        )
        GlowReady = Value.SwordTrail.Handle <> 0
    End If

    If GlowReady Then
        Value.ShieldTrail = Graphics3D.CreateParticleBatch3D(
            TRAIL_POINT_COUNT,
            Value.EpicGlowParticleMaterial,
            Graphics3D.VFX_BILLBOARD_CAMERA,
            4,
            4
        )
        GlowReady = Value.ShieldTrail.Handle <> 0
    End If

    If Not GlowReady Then
        Call DestroyEpicGlow(Value)
    Else

        Call ResetEpicGlowTrails(Value, Actor)
    End If

End Sub

Public Sub DestroyEpicGlow(ByRef Value As State)

    Call ViewerDragon.ClearVraxAudio(Value.VraxAudio)
    Call ViewerDragon.ClearVraxAttacks(Value.VraxAttacks)
    Call ClearEquipmentFire(Value)

    Call Graphics3D.DestroyObject3D(Value.SwordGlow)
    Call Graphics3D.DestroyParticleBatch3D(Value.SwordTrail)
    Call Graphics3D.DestroyParticleBatch3D(Value.ShieldTrail)
    Call Graphics3D.DestroyObject3D(Value.ShieldGlow)
    Call Graphics3D.DestroyEffectMaterial3D(Value.EpicGlowParticleMaterial)
    Call Graphics3D.DestroyEffectMaterial3D(Value.EpicGlowMaterial)
    Call Graphics3D.DestroyTexture3D(Value.EpicGlowTexture)

    Value.EpicGlowAvailable = False
    Value.EpicGlowVisible = False

End Sub

Public Function CreateBorrowedEpicGlow(ByRef Actor As Character3D.Actor,
    Material As Core.Material3D, ByRef SwordGlow As Core.Object3D,
    ByRef ShieldGlow As Core.Object3D, GlowStyle As Number,
    Optional WeaponPart As Number = 1, Optional ShieldPart As Number = 0) As Boolean

    Dim Animator As Core.Animator3D
    Dim Model As Core.Model3D
    Dim Result As Boolean

    Model.Handle = Character3D.ModelHandle(Actor)
    Animator.Handle = Character3D.AnimatorHandle(Actor)
    SwordGlow = Graphics3D.CreateModelPart3D(Model, WeaponPart)
    Result = SwordGlow.Handle <> 0

    If ShieldPart >= 0 Then
        ShieldGlow = Graphics3D.CreateModelPart3D(Model, ShieldPart)
        Result = ShieldGlow.Handle <> 0 And Result
    End If

    If Result Then

        Result = Graphics3D.SetObjectMaterial3D(SwordGlow, Material)
        Result = Graphics3D.SetObjectAnimator3D(SwordGlow, Animator) And Result

        If ShieldPart >= 0 Then
            Result = Graphics3D.SetObjectMaterial3D(ShieldGlow, Material) And Result
            Result = Graphics3D.SetObjectAnimator3D(ShieldGlow, Animator) And Result
        End If

        Result = ConfigureEquipmentGlow(SwordGlow, ShieldGlow, GlowStyle) And Result

    End If

    Return Result

End Function

Public Function ConfigureEquipmentGlow(ByRef WeaponGlow As Core.Object3D,
    ByRef ShieldGlow As Core.Object3D, GlowStyle As Number) As Boolean

    Dim WeaponCull As Number
    Dim Result As Boolean

    WeaponCull = Graphics3D.OBJECT_CULL_DEFAULT

    Call Graphics3D.SetObjectColor(WeaponGlow, 255, 182, 48)

    If ShieldGlow.Handle <> 0 Then
        Call Graphics3D.SetObjectColor(ShieldGlow, 255, 196, 64)
    End If

    If GlowStyle = ViewerProfiles.EQUIPMENT_GLOW_LIGHTNING Then

        WeaponCull = Graphics3D.OBJECT_CULL_FRONT

        Call Graphics3D.SetObjectColor(WeaponGlow, 255, 255, 255)

        If ShieldGlow.Handle <> 0 Then
            Call Graphics3D.SetObjectColor(ShieldGlow, 255, 255, 255)
        End If

    End If

    Call Graphics3D.SetObjectOpacity(WeaponGlow, 95)

    If ShieldGlow.Handle <> 0 Then
        Call Graphics3D.SetObjectOpacity(ShieldGlow, 90)
    End If

    Call Graphics3D.SetObjectShadows3D(WeaponGlow, False, False)

    If ShieldGlow.Handle <> 0 Then
        Call Graphics3D.SetObjectShadows3D(ShieldGlow, False, False)
    End If

    Result = Graphics3D.SetObjectCullMode3D(WeaponGlow, WeaponCull)

    If ShieldGlow.Handle <> 0 Then
        Result = Graphics3D.SetObjectCullMode3D(ShieldGlow,
            Graphics3D.OBJECT_CULL_FRONT) And Result
    End If

    Return Result

End Function

Public Sub ToggleEpicGlow(ByRef Value As State, ByRef Actor As Character3D.Actor)

    If Value.EpicGlowAvailable Then

        Value.EpicGlowVisible = Not Value.EpicGlowVisible

        If Value.EpicGlowVisible Then
            Call ResetEpicGlowTrails(Value, Actor)
        Else

            Call ClearEquipmentGlowTrails(Value)
        End If

    End If

End Sub

Public Sub UpdateEquipmentFire(
    ByRef Value As State,
    ByRef Actor As Character3D.Actor,
    ProfileIndex As Number,
    PrimaryKnockedOut As Boolean,
    SwordVisible As Boolean,
    ShieldVisible As Boolean,
    CalibrationEditing As Boolean,
    ScenePaused As Boolean,
    SelectedClip As Number,
    SelectedClipLabel As Text,
    Camera As Precision3D.Camera3D,
    CameraElapsed As Number
)

    If ProfileIndex = ViewerProfiles.PROFILE_VRAX Then
        Call ViewerDragon.UpdateVraxAttacks(Value.VraxAttacks, Actor,
            SelectedClipLabel, Not PrimaryKnockedOut,
            Value.FireInitialized, Value.LightningInitialized,
            Value.FlamePaused, Value.LightningPaused, Value.VisualContinuityEpoch)

        Return
    End If

    If ProfileIndex = ViewerProfiles.PROFILE_DRAGON Then
        Return
    End If

    Value.ProfileIndex = ProfileIndex

    If PrimaryKnockedOut Then
        Call ClearEquipmentFire(Value)

        Return
    End If

    If Not SwordVisible Then
        Call HideSwordEffects(Value)
    Else If Not Value.SwordFireVisible Then
        Call ClearSwordFire(Value)
    End If

    If Not ShieldVisible Then
        Call HideShieldEffects(Value)
    Else If Not Value.ShieldFireVisible Then
        Call ClearShieldFire(Value)
    End If

    Value.EquipmentFireFirstSample = Value.VisualHistoryDirty Or Value.EquipmentFireEpoch <> Value.VisualContinuityEpoch

    If Value.EquipmentFireFirstSample Then

        Call ClearEquipmentFire(Value)

        If Value.EpicGlowAvailable Then
            Call ResetEpicGlowTrails(Value, Actor)
        End If

        Value.EquipmentFireEpoch = Value.VisualContinuityEpoch
        Value.VisualHistoryDirty = False

    End If

    If ProfileIndex = ViewerProfiles.PROFILE_ZARA Then

        If Value.EpicGlowVisible And SwordVisible Then
            Call ArinShieldRim.Update(Value.WeaponRim, Actor, Camera, CameraElapsed,
                100, ViewerProfiles.WeaponPart(ProfileIndex), 3, "WeaponRim")
        Else

            Call ArinShieldRim.Shutdown(Value.WeaponRim)
        End If

        Call UpdateZaraAttacks(Value, Actor, SelectedClipLabel,
            Value.EpicGlowVisible And SwordVisible And Not PrimaryKnockedOut,
            Not ScenePaused And Not CalibrationEditing)

        Return

    End If

    If Value.FlamePaused Then
        Value.FlamesWerePaused = True
        Return
    End If

    If Not Value.SwordFireReady Then
        Return
    End If

    Call RecordOptionalFireFailure(Value)

    Call UpdateSwordFire(Value, Actor, SwordVisible, CalibrationEditing,
        ScenePaused, SelectedClip, SelectedClipLabel)
    Call UpdateShieldFire(Value, Actor, ShieldVisible, CalibrationEditing,
        ScenePaused, SelectedClip, Camera, CameraElapsed)

    Value.FlamesWerePaused = Value.FlamePaused

    Call RecordOptionalFireFailure(Value)

End Sub

Public Sub UpdateStorm(
    ByRef Value As State,
    ByRef Actor As Character3D.Actor,
    Clip As Text,
    Target As Precision3D.Vector3,
    Camera As Precision3D.Camera3D,
    CameraElapsed As Number,
    GlowVisible As Boolean,
    SwordVisible As Boolean,
    ShieldVisible As Boolean,
    ScenePaused As Boolean
)

    Call OrinStorm.UpdateEquipmentFire(Value.OrinStorm, Actor, Clip, GlowVisible,
        SwordVisible, ShieldVisible, Value.FlamePaused, ScenePaused,
        Intensity(Value, ViewerProfiles.PROFILE_ORIN, False), Intensity(Value, ViewerProfiles.PROFILE_ORIN, True))
    Call OrinStorm.Update(Value.OrinStorm, Actor, Clip, Target, Camera,
        CameraElapsed, GlowVisible, SwordVisible, ShieldVisible,
        Value.LightningPaused, ScenePaused, Value.OrinLight,
        Intensity(Value, ViewerProfiles.PROFILE_ORIN, False), Intensity(Value, ViewerProfiles.PROFILE_ORIN, True))

End Sub

Public Sub DrawEquipmentFire(ByRef Value As State, SwordVisible As Boolean,
    ShieldVisible As Boolean)

    Call ViewerDragon.DrawVraxAttacks(Value.VraxAttacks)

    If SwordVisible And Value.EpicGlowVisible Then
        Call ArinShieldRim.Draw(Value.WeaponRim)
    End If

    If (SwordVisible And
        Value.SwordFireVisible And
        Value.SwordFire.Slot <> 0 And
        Not Value.SwordFireFailed) Then
        Value.SwordFireFailed = Not Fire.Draw(Value.SwordFire)
    End If

    Call DrawShieldFire(Value, ShieldVisible)

End Sub

Public Function DrawScene(ByRef Value As State) As Boolean

    Dim Result As Boolean

    Call OrinStorm.Draw(Value.OrinStorm)

    Result = SceneVfx3D.DrawLightning(Value.LightningInitialized)

    Return Result

End Function

Public Sub DrawStormFlash(ByRef Value As State,
    Optional X As Number = 0, Optional Y As Number = 0,
    Optional Width As Number = 0, Optional Height As Number = 0)

    Call OrinStorm.DrawFlash(Value.OrinStorm, X, Y, Width, Height)

End Sub

Private Sub RecordOptionalFireFailure(ByRef Value As State)

    If (Value.EquipmentFireFirstError = 0 And
        (Value.SwordFireFailed Or Value.ShieldFireFailed)) Then

        Value.EquipmentFireFirstError = Fire.Value(12, Value.SwordFire)

        If Value.EquipmentFireFirstError = 0 Then
            Value.EquipmentFireFirstError = Fire.ERROR_RENDERER
        End If

    End If

End Sub

Private Sub UpdateSwordFire(
    ByRef Value As State,
    ByRef Actor As Character3D.Actor,
    SwordVisible As Boolean,
    CalibrationEditing As Boolean,
    ScenePaused As Boolean,
    SelectedClip As Number,
    SelectedClipLabel As Text
)

    Dim Base As Precision3D.Vector3
    Dim Tip As Precision3D.Vector3
    Dim Delta As Precision3D.Vector3
    Dim Length As Double
    Dim Time As Number
    Dim Restart As Boolean
    Dim Ok As Boolean
    Dim Inheritance As Number

    If Value.SwordFireFailed And Value.SwordFire.Slot <> 0 Then
        Ok = Fire.Destroy(Value.SwordFire)
    End If

    If Not Value.SwordFireReady Or Value.SwordFireFailed Then
        Return
    End If

    If Not Value.SwordFireVisible Or Not SwordVisible Then

        If Value.SwordFire.Slot <> 0 Then
            Ok = Fire.Destroy(Value.SwordFire)
        End If

        Return

    End If

    Ok = Character3D.TrySocketPositionPrecise(Actor, "SwordBase", ViewerProfiles.WeaponPart(Value.ProfileIndex), False, Base)
    Ok = Character3D.TrySocketPositionPrecise(Actor, "SwordTip", ViewerProfiles.WeaponPart(Value.ProfileIndex), False, Tip) And Ok

    If Not Ok Then
        Value.SwordFireFailed = True
        Return
    End If

    Delta.X = Tip.X - Base.X
    Delta.Y = Tip.Y - Base.Y
    Delta.Z = Tip.Z - Base.Z
    Length = PreciseMath.Length(Delta)
    Time = Character3D.AnimationTime(Actor)

    If Length < 4.0 Or Length > 10000.0 Then
        Value.SwordFireFailed = True
        Return
    End If

    ''' Loops and clip changes retain world-space particles; paused pose edits clear stale fire.
    Restart = False

    If ScenePaused And CalibrationEditing Then
        Restart = (Restart Or Base.X <> Value.SwordFireBase.X Or Base.Y <> Value.SwordFireBase.Y Or
            Base.Z <> Value.SwordFireBase.Z Or Tip.X <> Value.SwordFireTip.X Or
            Tip.Y <> Value.SwordFireTip.Y Or Tip.Z <> Value.SwordFireTip.Z)
    End If

    If Restart And Value.SwordFire.Slot <> 0 Then
        Ok = Fire.Destroy(Value.SwordFire)
    End If

    If Value.SwordFire.Slot = 0 Then

        Value.SwordFire = Fire.StartAtPrecise("PaladinFlameBlade", Base, 5701,
            Fire.QUALITY_HIGH, Fire.SIMULATION_AUTO, Max(2, ToNumber(Ceiling(Length / 12.0))))
        Value.SwordFireFailed = Value.SwordFire.Slot = 0

        If Value.SwordFireFailed Then
            Return
        End If

        Ok = Fire.SetSegmentPrecise(Value.SwordFire, Base, Tip)

    Else
        Ok = Fire.SetSegmentPrecise(Value.SwordFire, Base, Tip)

    End If

    ''' Low inheritance leaves the fuller flame behind the moving blade instead of throwing it ahead.
    Inheritance = 10

    If SelectedClipLabel = "Walk" Then
        Inheritance = 15
    Else If SelectedClipLabel = "Run" Then
        Inheritance = 20
    Else If SelectedClipLabel = "Attack" Or SelectedClipLabel = "Attack 2" Then
        Inheritance = 10
    End If

    If (Time < Value.SwordFireTime Or
        SelectedClip <> Value.SwordFireClip Or
        ScenePaused Or
        Value.FlamePaused Or
        Value.FlamesWerePaused Or
        Value.EquipmentFireFirstSample) Then
        Inheritance = 0
    End If

    Call Fire.SetIntensity(Value.SwordFire, 2 * Intensity(Value, Value.ProfileIndex, False))
    Call Fire.SetSourceVelocityInheritance(Value.SwordFire, Inheritance)

    If Value.ProfileIndex = ViewerProfiles.PROFILE_VALOR Then
        Ok = Fire.SetPalette(Value.SwordFire, Fire.PALETTE_BLUE_WHITE) And Ok
    End If

    Value.SwordFireFailed = Not Ok
    Value.SwordFireBase = Base
    Value.SwordFireTip = Tip
    Value.SwordFireClip = SelectedClip
    Value.SwordFireTime = Time

End Sub

Private Sub UpdateShieldFire(
    ByRef Value As State,
    ByRef Actor As Character3D.Actor,
    ShieldVisible As Boolean,
    CalibrationEditing As Boolean,
    ScenePaused As Boolean,
    SelectedClip As Number,
    Camera As Precision3D.Camera3D,
    CameraElapsed As Number
)

    Dim Points[3] As Precision3D.Vector3
    Dim Index As Number
    Dim NextIndex As Number
    Dim Time As Number
    Dim Restart As Boolean
    Dim Ok As Boolean

    If Not Value.ShieldFlameStyle Then

        For Index = 0 To 2

            If Value.ShieldFire[Index].Slot <> 0 Then
                Ok = Fire.Destroy(Value.ShieldFire[Index])
            End If

        End For

        If (Value.ShieldFireVisible And
            ShieldVisible And
            Value.EpicGlowVisible) Then
            Call ArinShieldRim.Update(Value.ShieldRim, Actor, Camera, CameraElapsed,
                Intensity(Value, Value.ProfileIndex, True), ViewerProfiles.ShieldPart(Value.ProfileIndex),
                ViewerProfiles.EquipmentGlowStyle(Value.ProfileIndex))
        Else

            Call ArinShieldRim.Shutdown(Value.ShieldRim)
        End If

        Return

    End If

    If (Value.ShieldFireVisible And
        ShieldVisible And
        Value.EpicGlowVisible) Then
        Call ArinShieldRim.Update(Value.ShieldRim, Actor, Camera, CameraElapsed,
            Intensity(Value, Value.ProfileIndex, True), ViewerProfiles.ShieldPart(Value.ProfileIndex),
            ViewerProfiles.EquipmentGlowStyle(Value.ProfileIndex))
    Else

        Call ArinShieldRim.Shutdown(Value.ShieldRim)
    End If

    If Value.ShieldFireFailed Then

        For Index = 0 To 2

            If Value.ShieldFire[Index].Slot <> 0 Then
                Ok = Fire.Destroy(Value.ShieldFire[Index])
            End If

        End For

        Return

    End If

    If Not Value.ShieldFireVisible Or Not ShieldVisible Then

        For Index = 0 To 2

            If Value.ShieldFire[Index].Slot <> 0 Then
                Ok = Fire.Destroy(Value.ShieldFire[Index])
            End If

        End For

        Return

    End If

    Ok = Character3D.TrySocketPositionPrecise(Actor, "ShieldFireLeft", ViewerProfiles.ShieldPart(Value.ProfileIndex), False, Points[0])
    Ok = Character3D.TrySocketPositionPrecise(Actor, "ShieldFireRight", ViewerProfiles.ShieldPart(Value.ProfileIndex), False, Points[1]) And Ok
    Ok = Character3D.TrySocketPositionPrecise(Actor, "ShieldFireTip", ViewerProfiles.ShieldPart(Value.ProfileIndex), False, Points[2]) And Ok

    If Not Ok Then
        Value.ShieldFireFailed = True
        Return
    End If

    Time = Character3D.AnimationTime(Actor)
    Restart = False

    For Index = 0 To 2

        If ScenePaused And CalibrationEditing Then
            Restart = (Restart Or Points[Index].X <> Value.ShieldFirePoints[Index].X Or
                Points[Index].Y <> Value.ShieldFirePoints[Index].Y Or
                Points[Index].Z <> Value.ShieldFirePoints[Index].Z)
        End If

    End For

    Ok = True

    For Index = 0 To 2

        If Restart And Value.ShieldFire[Index].Slot <> 0 Then
            Ok = Fire.Destroy(Value.ShieldFire[Index]) And Ok
        End If

        If Value.ShieldFire[Index].Slot = 0 Then
            Value.ShieldFire[Index] = Fire.StartAtPrecise("LineFire", Points[Index], 5710 + Index,
                Fire.QUALITY_HIGH, Fire.SIMULATION_AUTO, 3)
            Ok = Value.ShieldFire[Index].Slot <> 0 And Ok
        End If

        NextIndex = (Index + 1) Mod 3
        Ok = Fire.SetSegmentPrecise(Value.ShieldFire[Index], Points[Index], Points[NextIndex]) And Ok

        If Value.ProfileIndex = ViewerProfiles.PROFILE_VALOR Then
            Ok = Fire.SetPalette(Value.ShieldFire[Index], Fire.PALETTE_BLUE_WHITE) And Ok
        End If

        ''' Three quiet edge emitters together use about one tenth of the sword's rate.

        Call Fire.SetIntensity(Value.ShieldFire[Index], 7 * Intensity(Value, Value.ProfileIndex, True) / 100)
        Call Fire.SetSourceVelocityInheritance(Value.ShieldFire[Index], 0)

        If (Time < Value.ShieldFireTime Or
            SelectedClip <> Value.ShieldFireClip Or
            ScenePaused Or
            Value.FlamePaused Or
            Value.FlamesWerePaused Or
            Value.EquipmentFireFirstSample) Then
            Call Fire.SetSourceVelocityInheritance(Value.ShieldFire[Index], 0)
        End If

        Value.ShieldFirePoints[Index] = Points[Index]
    End For

    Value.ShieldFireFailed = Not Ok
    Value.ShieldFireClip = SelectedClip
    Value.ShieldFireTime = Time

End Sub

Public Sub DrawShieldFire(ByRef Value As State, ShieldVisible As Boolean)

    Dim Index As Number
    Dim Ok As Boolean

    If Not ShieldVisible Or Not Value.ShieldFireVisible Then
        Return
    End If

    Call ArinShieldRim.Draw(Value.ShieldRim)

    If Not Value.ShieldFlameStyle Then
        Return
    End If

    If Value.ShieldFireFailed Then
        Return
    End If

    Ok = True

    For Index = 0 To 2

        If Value.ShieldFire[Index].Slot <> 0 Then
            Ok = Fire.Draw(Value.ShieldFire[Index]) And Ok
        End If

    End For

    Value.ShieldFireFailed = Not Ok

End Sub

Public Function UpdateEpicGlow(
    ByRef Value As State,
    ByRef Actor As Character3D.Actor,
    ProfileIndex As Number,
    ScalePercent As Number,
    AnimationElapsed As Number,
    SelectedClipName As Text,
    SwordVisible As Boolean,
    ShieldVisible As Boolean,
    SwordCoupled As Boolean,
    ShieldCoupled As Boolean
) As Boolean

    Dim SwordBase As Precision3D.Vector3
    Dim SwordCenter As Precision3D.Vector3
    Dim SwordTip As Precision3D.Vector3
    Dim ShieldCenter As Precision3D.Vector3
    Dim Result As Boolean

    If Not Character3D.TrySocketPositionPrecise(Actor, "SwordBase", ViewerProfiles.EquipmentSocketPart(ProfileIndex, False), SwordCoupled, SwordBase) Then
        Return False
    End If

    If Not Character3D.TrySocketPositionPrecise(Actor, "SwordTip", ViewerProfiles.EquipmentSocketPart(ProfileIndex, False), SwordCoupled, SwordTip) Then
        Return False
    End If

    If Value.ShieldGlow.Handle <> 0 Then

        If Not Character3D.TrySocketPositionPrecise(Actor, "ShieldCenter",
            ViewerProfiles.EquipmentSocketPart(ProfileIndex, True), ShieldCoupled, ShieldCenter) Then
            Return False
        End If

    End If

    SwordCenter.X = (SwordBase.X + SwordTip.X) / 2.0
    SwordCenter.Y = (SwordBase.Y + SwordTip.Y) / 2.0
    SwordCenter.Z = (SwordBase.Z + SwordTip.Z) / 2.0

    If (ProfileIndex = ViewerProfiles.PROFILE_ARIN Or
        ProfileIndex = ViewerProfiles.PROFILE_VALOR) Then
        Call UpdateEpicGlowTrailState(Value, Actor, SwordTip, ShieldCenter,
            SelectedClipName, SwordVisible, ShieldVisible)
        Call AdvanceEpicGlowTrails(Value, SwordTip, ShieldCenter, AnimationElapsed)
    End If

    Call Graphics3D.SetObjectOpacity(Value.SwordGlow, 95 * Intensity(Value, ProfileIndex, False) / 100)

    If Value.ShieldGlow.Handle <> 0 Then
        Call Graphics3D.SetObjectOpacity(Value.ShieldGlow, 90 * Intensity(Value, ProfileIndex, True) / 100)
    End If

    Result = UpdateEquipmentGlow(Actor, Value.SwordGlow, SwordCenter, ScalePercent,
        ViewerProfiles.EquipmentGlowStyle(ProfileIndex) = ViewerProfiles.EQUIPMENT_GLOW_LIGHTNING)

    If Value.ShieldGlow.Handle <> 0 Then
        Result = UpdateEquipmentGlow(Actor, Value.ShieldGlow, ShieldCenter, ScalePercent, True) And Result
    End If

    Result = UpdateEpicGlowTrailBatches(Value) And Result

    Return Result

End Function

Public Function UpdateEquipmentGlow(
    ByRef Actor As Character3D.Actor,
    ByRef GlowObject As Core.Object3D,
    Center As Precision3D.Vector3,
    ScalePercent As Number,
    Optional ExpandOutline As Boolean = False
) As Boolean

    Dim OutlineScale As Number
    Dim ScaleDelta As Number
    Dim ActorPosition As Precision3D.Vector3
    Dim Transform As Precision3D.Transform3D
    Dim Result As Boolean

    If Not Character3D.TryPosition(Actor, ActorPosition) Then
        Return False
    End If

    If Not Character3D.TryRotation(Actor, Transform.Rotation) Then
        Return False
    End If

    ''' Surface coatings match equipment geometry; only a culled outline shell expands.

    If ExpandOutline Then
        ScaleDelta = Max(2, ScalePercent / GLOW_SCALE_DIVISOR)
    End If

    OutlineScale = ScalePercent + ScaleDelta
    Transform.Position = PreciseMath.Subtract(ActorPosition,
        PreciseMath.Scale(PreciseMath.Subtract(Center, ActorPosition),
            ToDouble(ScaleDelta) / ToDouble(ScalePercent)))
    Transform.ScalePercent = Precision3D.Vector(ToDouble(OutlineScale),
        ToDouble(OutlineScale), ToDouble(OutlineScale))
    Result = Precision3D.SetTransform(GlowObject, Transform)

    Return Result

End Function

Public Function UpdateBorrowedEpicGlow(ByRef Actor As Character3D.Actor,
    ByRef SwordGlow As Core.Object3D, ByRef ShieldGlow As Core.Object3D,
    ScalePercent As Number, SwordCoupled As Boolean,
    ShieldCoupled As Boolean, GlowStyle As Number,
    Optional WeaponIntensity As Number = 100, Optional ShieldIntensity As Number = 100) As Boolean

    Dim SwordBase As Precision3D.Vector3
    Dim SwordCenter As Precision3D.Vector3
    Dim SwordTip As Precision3D.Vector3
    Dim ShieldCenter As Precision3D.Vector3
    Dim Result As Boolean

    If Not Character3D.TrySocketPositionPrecise(Actor, "SwordBase", BODY_PART_INDEX, SwordCoupled, SwordBase) Then
        Return False
    End If

    If Not Character3D.TrySocketPositionPrecise(Actor, "SwordTip", BODY_PART_INDEX, SwordCoupled, SwordTip) Then
        Return False
    End If

    If Not Character3D.TrySocketPositionPrecise(Actor, "ShieldCenter", BODY_PART_INDEX, ShieldCoupled, ShieldCenter) Then
        Return False
    End If

    SwordCenter.X = (SwordBase.X + SwordTip.X) / 2.0
    SwordCenter.Y = (SwordBase.Y + SwordTip.Y) / 2.0
    SwordCenter.Z = (SwordBase.Z + SwordTip.Z) / 2.0

    Call Graphics3D.SetObjectOpacity(SwordGlow, 95 * WeaponIntensity / 100)

    If ShieldGlow.Handle <> 0 Then
        Call Graphics3D.SetObjectOpacity(ShieldGlow, 90 * ShieldIntensity / 100)
    End If

    Result = UpdateEquipmentGlow(Actor, SwordGlow, SwordCenter, ScalePercent,
        GlowStyle = ViewerProfiles.EQUIPMENT_GLOW_LIGHTNING)
    Result = UpdateEquipmentGlow(
        Actor, ShieldGlow, ShieldCenter, ScalePercent, True) And Result

    Return Result

End Function

Public Function DrawEquipmentGlow(ByRef Value As State, ProfileIndex As Number,
    SwordVisible As Boolean, ShieldVisible As Boolean) As Boolean

    Dim Result As Boolean

    Result = True

    If SwordVisible Then
        Result = Graphics3D.DrawObject3D(Value.SwordGlow)
    End If

    If (ShieldVisible And
        Value.ShieldGlow.Handle <> 0 And
        Not Value.SwordFireReady And
        ProfileIndex <> ViewerProfiles.PROFILE_ORIN) Then
        Result = Graphics3D.DrawObject3D(Value.ShieldGlow) And Result
    End If

    Return Result

End Function

Public Sub ResetEpicGlowTrails(ByRef Value As State, ByRef Actor As Character3D.Actor)

    Dim SwordTip As Precision3D.Vector3
    Dim ShieldCenter As Precision3D.Vector3

    If Not Character3D.TrySocketPositionPrecise(Actor, "SwordTip", ViewerProfiles.WeaponPart(Value.ProfileIndex), False, SwordTip) Then
        Return
    End If

    If Not Character3D.TrySocketPositionPrecise(Actor, "ShieldCenter", ViewerProfiles.ShieldPart(Value.ProfileIndex), False, ShieldCenter) Then
        Return
    End If

    Call SeedEpicGlowTrails(Value, SwordTip, ShieldCenter)

    Value.EquipmentTrailAnimationTime = Character3D.AnimationTime(Actor)
    Value.SwordTrailActive = False
    Value.ShieldTrailActive = False

End Sub

Private Sub SeedEpicGlowTrails(ByRef Value As State, SwordTip As Precision3D.Vector3,
    ShieldCenter As Precision3D.Vector3)

    Dim Index As Number

    For Index = 0 To TRAIL_POINT_COUNT - 1
        Value.SwordTrailPoints[Index] = SwordTip
        Value.ShieldTrailPoints[Index] = ShieldCenter
    End For

    Value.EquipmentTrailElapsed = 0

End Sub

Private Sub UpdateEpicGlowTrailState(
    ByRef Value As State,
    ByRef Actor As Character3D.Actor,
    SwordTip As Precision3D.Vector3,
    ShieldCenter As Precision3D.Vector3,
    SelectedClipName As Text,
    SwordVisible As Boolean,
    ShieldVisible As Boolean
)

    Dim AnimationTime As Number
    Dim NextSwordTrailActive As Boolean
    Dim NextShieldTrailActive As Boolean

    AnimationTime = Character3D.AnimationTime(Actor)
    NextSwordTrailActive = (SwordVisible And
        (SelectedClipName = "SwordAttack" Or SelectedClipName = "SwordAttack2") And
        AnimationTime >= SWORD_TRAIL_START_MILLISECONDS And
        AnimationTime <= SWORD_TRAIL_END_MILLISECONDS)
    NextShieldTrailActive = (ShieldVisible And
        SelectedClipName = "BlockImpact" And
        AnimationTime >= SHIELD_TRAIL_START_MILLISECONDS And
        AnimationTime <= SHIELD_TRAIL_END_MILLISECONDS)

    If ((NextSwordTrailActive And Not Value.SwordTrailActive) Or
        (NextShieldTrailActive And Not Value.ShieldTrailActive) Or
        AnimationTime < Value.EquipmentTrailAnimationTime) Then
        Call SeedEpicGlowTrails(Value, SwordTip, ShieldCenter)
    End If

    Value.SwordTrailActive = NextSwordTrailActive
    Value.ShieldTrailActive = NextShieldTrailActive
    Value.EquipmentTrailAnimationTime = AnimationTime

End Sub

Private Sub AdvanceEpicGlowTrails(ByRef Value As State, SwordTip As Precision3D.Vector3,
    ShieldCenter As Precision3D.Vector3, AnimationElapsed As Number)

    Dim Index As Number

    If Not Value.SwordTrailActive And Not Value.ShieldTrailActive Then
        Return
    End If

    Value.EquipmentTrailElapsed = Value.EquipmentTrailElapsed + AnimationElapsed

    If Value.EquipmentTrailElapsed < TRAIL_SAMPLE_MILLISECONDS Then
        Return
    End If

    For Index = 0 To TRAIL_POINT_COUNT - 2
        Value.SwordTrailPoints[Index] = Value.SwordTrailPoints[Index + 1]
        Value.ShieldTrailPoints[Index] = Value.ShieldTrailPoints[Index + 1]
    End For

    Value.SwordTrailPoints[TRAIL_POINT_COUNT - 1] = SwordTip
    Value.ShieldTrailPoints[TRAIL_POINT_COUNT - 1] = ShieldCenter
    Value.EquipmentTrailElapsed = Value.EquipmentTrailElapsed Mod TRAIL_SAMPLE_MILLISECONDS

End Sub

Private Function UpdateEpicGlowTrailBatches(ByRef Value As State) As Boolean

    Dim ParticleSize As Number
    Dim Opacity As Number
    Dim Index As Number
    Dim Result As Boolean

    Result = True

    For Index = 0 To TRAIL_POINT_COUNT - 1

        Opacity = Index * 7
        ParticleSize = Max(1, SWORD_TRAIL_PARTICLE_SIZE - 1 + Index / 2)
        Result = Precision3D.SetParticle(Value.SwordTrail, Index,
            Value.SwordTrailPoints[Index], ToDouble(ParticleSize), 0.0, 4 + Index Mod 4) And Result
        Result = Graphics3D.SetParticleColor3D(
            Value.SwordTrail,
            Index,
            72,
            196,
            255,
            Min(100, Opacity * Intensity(Value, Value.ProfileIndex, False) / 100)
        ) And Result
        ParticleSize = Max(1, SHIELD_TRAIL_PARTICLE_SIZE - 1 + Index / 2)
        Result = Precision3D.SetParticle(Value.ShieldTrail, Index,
            Value.ShieldTrailPoints[Index], ToDouble(ParticleSize), 0.0, Index Mod 4) And Result
        Result = Graphics3D.SetParticleColor3D(
            Value.ShieldTrail,
            Index,
            255,
            196,
            64,
            Min(100, Opacity * 3 * Intensity(Value, Value.ProfileIndex, True) / 400)
        ) And Result

        If Value.ProfileIndex = ViewerProfiles.PROFILE_VALOR Then
            Result = Graphics3D.SetParticleColor3D(Value.ShieldTrail, Index,
                160, 220, 255, Min(100, Opacity * 3 / 4)) And Result
        End If

    End For

    If Value.SwordTrailActive Then
        Result = Graphics3D.CommitParticleBatch3D(
            Value.SwordTrail,
            TRAIL_POINT_COUNT
        ) And Result
    Else
        Result = Graphics3D.CommitParticleBatch3D(Value.SwordTrail, 0) And Result
    End If

    If Value.ShieldTrailActive Then
        Result = Graphics3D.CommitParticleBatch3D(
            Value.ShieldTrail,
            TRAIL_POINT_COUNT
        ) And Result
    Else
        Result = Graphics3D.CommitParticleBatch3D(Value.ShieldTrail, 0) And Result
    End If

    Return Result

End Function

Public Function DrawEpicGlow(ByRef Value As State, ProfileIndex As Number,
    SwordVisible As Boolean, ShieldVisible As Boolean) As Boolean

    Dim Result As Boolean

    Result = True

    If (ProfileIndex <> ViewerProfiles.PROFILE_ARIN And
        ProfileIndex <> ViewerProfiles.PROFILE_VALOR) Then
        Return True
    End If

    If SwordVisible Then
        Result = Graphics3D.DrawParticleBatch3D(Value.SwordTrail)
    End If

    If ShieldVisible And Not Value.SwordFireReady Then
        Result = Graphics3D.DrawParticleBatch3D(Value.ShieldTrail) And Result
    End If

    Return Result

End Function

Public Function ShieldFireStyleLabel(ByRef Value As State) As Text

    If Value.ShieldFlameStyle Then
        Return "Flames"
    End If

    If Value.ProfileIndex = ViewerProfiles.PROFILE_VALOR Then
        Return "Blue Outline"
    End If

    Return "Ember Outline"

End Function

Public Sub ToggleShieldFireStyle(ByRef Value As State)

    Value.ShieldFlameStyle = Not Value.ShieldFlameStyle
    Value.ShieldFireFailed = False

    Call ClearEquipmentFire(Value)

End Sub

Public Sub ClearEquipmentFire(ByRef Value As State)

    Call ClearZaraAttacks(Value.ZaraAttacks)

    Call ClearSwordFire(Value)
    Call ClearShieldFire(Value)

End Sub

Public Sub ClearSwordFire(ByRef Value As State)

    Dim Ok As Boolean

    Call ArinShieldRim.Shutdown(Value.WeaponRim)

    If Value.SwordFire.Slot <> 0 Then
        Ok = Fire.Destroy(Value.SwordFire)
    End If

End Sub

Public Sub ClearShieldFire(ByRef Value As State)

    Dim Index As Number
    Dim Ok As Boolean

    Call ArinShieldRim.Shutdown(Value.ShieldRim)

    For Index = 0 To 2

        If Value.ShieldFire[Index].Slot <> 0 Then
            Ok = Fire.Destroy(Value.ShieldFire[Index])
        End If

    End For

End Sub

Public Sub ClearEquipmentGlowTrails(ByRef Value As State)

    Dim Ok As Boolean

    Value.SwordTrailActive = False
    Value.ShieldTrailActive = False

    If Value.SwordTrail.Handle <> 0 Then
        Ok = Graphics3D.CommitParticleBatch3D(Value.SwordTrail, 0)
    End If

    If Value.ShieldTrail.Handle <> 0 Then
        Ok = Graphics3D.CommitParticleBatch3D(Value.ShieldTrail, 0)
    End If

End Sub

Public Sub HideSwordEffects(ByRef Value As State)

    Dim Ok As Boolean

    Call ClearZaraAttacks(Value.ZaraAttacks)
    Call ClearSwordFire(Value)

    Value.SwordTrailActive = False

    If Value.SwordTrail.Handle <> 0 Then
        Ok = Graphics3D.CommitParticleBatch3D(Value.SwordTrail, 0)
    End If

End Sub

Public Sub HideShieldEffects(ByRef Value As State)

    Dim Ok As Boolean

    Call ClearShieldFire(Value)

    Value.ShieldTrailActive = False

    If Value.ShieldTrail.Handle <> 0 Then
        Ok = Graphics3D.CommitParticleBatch3D(Value.ShieldTrail, 0)
    End If

End Sub

Public Function ShutdownShared(ByRef Value As State) As Boolean

    Dim Index As Number
    Dim Result As Boolean

    Result = True

    Call OrinStorm.Shutdown()
    Call Lightning.Shutdown()
    Call Fire.Shutdown()

    If LightPool3D.IsValid(Value.OrinLight) Then
        Result = LightPool3D.Release(Value.OrinLight) And Result
    End If

    If LightPool3D.IsValid(Value.DragonLight) Then
        Result = LightPool3D.Release(Value.DragonLight) And Result
    End If

    Call LightPool3D.Shutdown()

    Value.FireInitialized = False
    Value.LightningInitialized = False
    Value.SwordFire.Slot = 0
    Value.SwordFireReady = False

    For Index = 0 To 2
        Value.ShieldFire[Index].Slot = 0
    End For

    Return Result

End Function

Public Function ZaraAttackActive(Name As Text, Time As Number, Duration As Number) As Boolean

    Dim Result As Boolean

    Result = (Name = "SwordAttack" Or Name = "SwordAttack2" Or
        Name = "attack3" Or Name = "attack4" Or Name = "attack5" Or Name = "attack6")
    Result = Result And Duration > 0 And Time >= Duration / 20 And Time < Duration

    Return Result

End Function

Public Sub ClearZaraAttacks(ByRef Value As ZaraAttackEffects)

    Dim Index As Number
    Dim Ok As Boolean

    If Value.BladeArc.Slot <> 0 Then
        Ok = Lightning.Destroy(Value.BladeArc)
    End If

    For Index = 0 To 3

        If Value.Storm[Index].Slot <> 0 Then
            Ok = Lightning.Destroy(Value.Storm[Index])
        End If

    End For

End Sub

Private Sub UpdateZaraAttacks(ByRef Value As State, Actor As Character3D.Actor,
    Name As Text, Enabled As Boolean, Audible As Boolean)

    Dim Base As Precision3D.Vector3
    Dim Tip As Precision3D.Vector3
    Dim Target As Precision3D.Vector3
    Dim Duration As Number
    Dim Index As Number
    Dim Ok As Boolean
    Dim CueTime As Number

    For Index = 0 To Character3D.ClipCount(Actor) - 1

        If Character3D.ClipName(Actor, Index) = Name Then
            Duration = Character3D.ClipDuration(Actor, Index)
        End If

    End For

    Ok = Character3D.TrySocketPositionPrecise(Actor, "SwordBase", 3, False, Base)
    Ok = Character3D.TrySocketPositionPrecise(Actor, "SwordTip", 3, False, Tip) And Ok
    Target = Precision3D.Vector(ToDouble(ViewerDragon.PositionX()), 0.0,
        ToDouble(ViewerDragon.PositionZ()))

    Call UpdateZaraAttackPoints(Value.ZaraAttacks, Name, Character3D.AnimationTime(Actor),
        Duration, Base, Tip, Target, Enabled And Ok, Value.LightningInitialized,
        Value.LightningPaused, Value.VisualContinuityEpoch)

    CueTime = -1

    If ZaraAttackActive(Name, Duration / 2, Duration) Then
        CueTime = Duration * ViewerProfiles.ZARA_ATTACK_HIT_PERCENT / 100
    End If

    If BattleAudio.CrossedCue(Value.ZaraAudio, Name,
        Character3D.AnimationTime(Actor), CueTime, Enabled And Audible) Then

        If Name = "attack4" Then

            Play Sound "Assets/Audio/zara-impact.wav" On Channel 1

        Else

            Play Sound "Assets/Audio/zara-attack.wav" On Channel 1

        End If

    End If

    If BattleAudio.CrossedCue(Value.ZaraThunderAudio, Name,
        Character3D.AnimationTime(Actor), CueTime, Enabled And Audible And
        Not Value.LightningPaused) Then

        Play Sound "Assets/Lightning/thunder.wav" On Channel 2

    End If

    CueTime = -1

    If Name = "attack3" Then
        CueTime = Duration * 40 / 100
    Else If Name = "attack4" Or Name = "attack6" Then
        CueTime = Duration / 2
    Else If Name = "attack5" Then
        CueTime = Duration * ViewerProfiles.ZARA_ATTACK_HIT_PERCENT / 100
    End If

    If BattleAudio.CrossedCue(Value.ZaraImpactAudio, Name,
        Character3D.AnimationTime(Actor), CueTime, Enabled And Audible) Then

        If Name = "attack4" Then

            Play Sound "Assets/Audio/zara-burst.wav" On Channel 3

        Else If Name = "attack6" Then

            Play Sound "Assets/Audio/zara-heavy.wav" On Channel 3

        Else

            Play Sound "Assets/Audio/zara-impact.wav" On Channel 3

        End If

    End If

End Sub

''' Lightning Lab Godstorm Ultra and Forked Judgment layouts, with Zara's red palette.
''' Four Ultra strikes preserve capacity for other Party actors; no global reset.
Public Sub UpdateZaraAttackPoints(ByRef Value As ZaraAttackEffects, Name As Text,
    Time As Number, Duration As Number, Base As Precision3D.Vector3,
    Tip As Precision3D.Vector3, Target As Precision3D.Vector3,
    Enabled As Boolean, LightningReady As Boolean, Paused As Boolean, Epoch As Number)

    Dim Active As Boolean
    Dim Ok As Boolean
    Dim Impact As Boolean

    If (Value.Clip <> Name Or
        Value.Epoch <> Epoch Or
        Time < Value.Time Or
        (Value.WasPaused And Not Paused And Time <> Value.LiveTime)) Then
        Call ClearZaraAttacks(Value)
    End If

    Active = Enabled And ZaraAttackActive(Name, Time, Duration)
    Impact = Active And Time >= Duration * ViewerProfiles.ZARA_ATTACK_HIT_PERCENT / 100

    If Not Active Then

        Call ClearZaraAttacks(Value)

    Else If LightningReady And Not Paused Then

        If Impact Then

            If Value.BladeArc.Slot <> 0 Then
                Ok = Lightning.Destroy(Value.BladeArc)
            End If

            Call StartZaraStorm(Value, Name, Tip, Target)

        Else

            If Value.BladeArc.Slot = 0 Then
                Value.BladeArc = Lightning.StartAtPrecise("WeaponCorona", Base,
                    Tip, 7351, Lightning.QUALITY_HIGH)
            End If

            If Value.BladeArc.Slot <> 0 Then

                Ok = Lightning.SetEndpointsPrecise(Value.BladeArc, Base, Tip)
                Ok = Lightning.SetPalette(Value.BladeArc, Lightning.PALETTE_RED_WHITE) And Ok
                Ok = Lightning.SetStyle(Value.BladeArc, 3, 650) And Ok
                Ok = Lightning.SetBranchBudget(Value.BladeArc, 2) And Ok
                Ok = Lightning.SetSparkIntensity(Value.BladeArc, 10) And Ok

            End If

        End If

    End If

    Value.Clip = Name
    Value.Time = Time
    Value.Epoch = Epoch
    Value.WasPaused = Paused

    If Not Paused Then
        Value.LiveTime = Time
    End If

End Sub

Private Sub StartZaraStorm(ByRef Value As ZaraAttackEffects, Name As Text,
    Tip As Precision3D.Vector3, Target As Precision3D.Vector3)

    Dim Index As Number
    Dim Angle As Number
    Dim ArcStorm As Boolean
    Dim ForkedJudgment As Boolean
    Dim Preset As Text
    Dim Source As Precision3D.Vector3
    Dim Destination As Precision3D.Vector3
    Dim Ok As Boolean

    ArcStorm = Name = "attack4" Or Name = "attack6"
    ForkedJudgment = Name = "SwordAttack2"
    Preset = "StormCrown"

    If ForkedJudgment Then
        Preset = "SkyStrike"
    End If

    For Index = 0 To 3

        If Value.Storm[Index].Slot = 0 Then

            Angle = Index * 90
            Source = Target
            Source.X = Source.X + ToDouble(Fixed.SinFixed(Angle) * 290 / Core.FIXED_ONE)
            Source.Y = Source.Y + 540.0
            Source.Z = Source.Z + ToDouble(Fixed.CosFixed(Angle) * 290 / Core.FIXED_ONE)
            Destination = Target
            Destination.X = Destination.X + ToDouble(Fixed.SinFixed(Angle + 30) * 220 / Core.FIXED_ONE)
            Destination.Y = Destination.Y + 12.0
            Destination.Z = Destination.Z + ToDouble(Fixed.CosFixed(Angle + 30) * 220 / Core.FIXED_ONE)

            If ArcStorm Then

                Source = Tip
                Destination = Target
                Destination.X = Destination.X + ToDouble(Fixed.SinFixed(Angle) * 300 / Core.FIXED_ONE)
                Destination.Y = Destination.Y + 20.0
                Destination.Z = Destination.Z + ToDouble(Fixed.CosFixed(Angle) * 300 / Core.FIXED_ONE)

            End If

            Value.Storm[Index] = Lightning.StartAtPrecise(Preset, Source,
                Destination, 7187 + Index * 197, Lightning.QUALITY_ULTRA)

            If Value.Storm[Index].Slot <> 0 Then

                Ok = Lightning.SetPalette(Value.Storm[Index], Lightning.PALETTE_RED_WHITE)
                Ok = Lightning.SetSparkIntensity(Value.Storm[Index], 15) And Ok

                If Not ArcStorm And Not ForkedJudgment Then
                    Ok = Lightning.SetStyle(Value.Storm[Index], 2, 920) And Ok
                End If

            End If

        End If

    End For

End Sub

End Module
