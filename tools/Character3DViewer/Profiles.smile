Public Function CalibrationMetadataAsset(ProfileIndex As Number) As Text

    Dim Result As Text

    Result = "Assets/Calibration/arin-v5.7.metadata.json"

    If ProfileIndex = PROFILE_ORIN Then
        Result = "Assets/Calibration/orin-v1.3.metadata.json"
    End If

    Return Result

End Function

Public Function IsUnityCharacter(ProfileIndex As Number) As Boolean

    Dim Result As Boolean

    Result = ProfileIndex >= PROFILE_VALOR And ProfileIndex <= PROFILE_VRAX

    Return Result

End Function

Public Function UnityName(ProfileIndex As Number) As Text

    Dim Result As Text

    If ProfileIndex = PROFILE_VALOR Then
        Result = "Valor"
    Else If ProfileIndex = PROFILE_ZARA Then
        Result = "Zara"
    Else If ProfileIndex = PROFILE_VRAX Then
        Result = "Vrax"
    End If

    Return Result

End Function

Public Function UnityClipLoops(ClipName As Text) As Boolean

    Dim Result As Boolean

    Result = (Text_Slice(ClipName, 0, 4) = "Idle" Or
        Text_Slice(ClipName, 0, 4) = "Walk" Or
        Text_Slice(ClipName, 0, 3) = "Run" Or
        Text_Slice(ClipName, 0, 8) = "BackWalk" Or
        ClipName = "LeftStrafe" Or ClipName = "RightStrafe" Or
        ClipName = "Jump3Loop")

    Return Result

End Function

