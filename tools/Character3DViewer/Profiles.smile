''' Repository-owned profiles for the generic Character 3D Viewer.
Module Smile.Tools.Character3DViewerProfiles

Option Explicit

Import Smile.Simple3D.CharacterViewer As CharacterViewer

Public Const PROFILE_ARIN = 0
Public Const PROFILE_ARIN_V56 = 1
Public Const PROFILE_ARIN_ORIGINAL = 2
Public Const PROFILE_TECHNICAL_ARTICULATED = 3
Public Const PROFILE_ORIN = 4
Public Const PROFILE_DRAGON = 5

Public Function HoldsFinalPose(ProfileIndex As Number, ClipName As Text) As Boolean

    Dim Result As Boolean

    Result = ProfileIndex = PROFILE_ORIN And ClipName = "Defend"

    Return Result

End Function

Public Function ProfileCount() As Number

    Return 6

End Function

Public Function ProfileAt(Index As Number) As CharacterViewer.Profile

    Dim Result As CharacterViewer.Profile

    Result.Version = 1
    Result.MinimumPlaybackSpeed = 25
    Result.MaximumPlaybackSpeed = 200
    Result.DefaultPlaybackSpeed = 100
    Result.MarginPercent = 18
    Result.AnimationMargin = 2

    If Index = PROFILE_ARIN Then

        Result.AssetId = "sin-star-i.character-1.paladin"
        Result.CandidateVersion = "v5.7"
        Result.DisplayName = "Arin"
        Result.PartyRole = "Paladin"
        Result.PrototypeAlias = "dragonfall.arin-v5-7"
        Result.ProductionStatus = "Candidate"
        Result.AssetPath = "Assets\Generation2\ArinV57\ArinV57.sm3d"
        Result.ExpectedClipCount = 8
        Result.ExpectedSocketCount = 13
        Result.DesiredWorldHeight = 100
        Result.DefaultPlaybackSpeed = 200

    Else If Index = PROFILE_ORIN Then

        Result.AssetId = "sin-star-i.character-2.tank"
        Result.CandidateVersion = "v1.3"
        Result.DisplayName = "Orin"
        Result.PartyRole = "Tank"
        Result.PrototypeAlias = ""
        Result.ProductionStatus = "Candidate"
        Result.AssetPath = "Assets\Generation2\OrinV13\OrinV13.sm3d"
        Result.ExpectedClipCount = 9
        Result.ExpectedSocketCount = 21
        Result.DesiredWorldHeight = 125
        Result.DefaultPlaybackSpeed = 200

    Else If Index = PROFILE_DRAGON Then

        Result.AssetId = "sin-star-i.boss.red-dragon"
        Result.CandidateVersion = "v1.1"
        Result.DisplayName = "Dragon"
        Result.PartyRole = "Boss"
        Result.ProductionStatus = "Preview"
        Result.AssetPath = "Assets\Generation2\RedDragon\RedDragon.sm3d"
        Result.ExpectedClipCount = 6
        Result.ExpectedSocketCount = 6
        Result.DesiredWorldHeight = 250

    Else If Index = PROFILE_ARIN_V56 Then

        Result.AssetId = "sin-star-i.character-1.paladin"
        Result.CandidateVersion = "v5.6"
        Result.DisplayName = "Arin"
        Result.PartyRole = "Paladin"
        Result.PrototypeAlias = "dragonfall.arin-v5-6"
        Result.ProductionStatus = "Diagnostic"
        Result.AssetPath = "Assets\Generation2\ArinV56\ArinV56.sm3d"
        Result.ExpectedClipCount = 11
        Result.ExpectedSocketCount = 10
        Result.DesiredWorldHeight = 100

    Else If Index = PROFILE_ARIN_ORIGINAL Then

        Result.AssetId = "sin-star-i.character-1.paladin"
        Result.CandidateVersion = "prototype-original"
        Result.DisplayName = "Arin (Original)"
        Result.PartyRole = "Paladin"
        Result.PrototypeAlias = "dragonfall.arin-prototype"
        Result.ProductionStatus = "Prototype"
        Result.AssetPath = "Assets\Generation2\Arin\ArinPrototype.sm3d"
        Result.ExpectedClipCount = 3
        Result.ExpectedSocketCount = 6
        Result.DesiredWorldHeight = 100

    Else If Index = PROFILE_TECHNICAL_ARTICULATED Then

        Result.AssetId = "smile.technical.animation-articulated"
        Result.CandidateVersion = "fixture-v1"
        Result.DisplayName = "Articulated Fixture"
        Result.PartyRole = ""
        Result.PrototypeAlias = ""
        Result.ProductionStatus = "Technical"
        Result.AssetPath = "TechnicalAssets\Generation2\AnimationArticulated.sm3d"
        Result.ExpectedClipCount = 5
        Result.ExpectedSocketCount = 1
        Result.DesiredWorldHeight = 180

    End If

    Return Result

End Function

Public Function ModelFileName(ProfileIndex As Number) As Text

    Dim Result As Text

    If ProfileIndex = PROFILE_ARIN Then
        Result = "arin-v5.7-idle-equipment-checkpoint.glb"
    Else If ProfileIndex = PROFILE_ORIN Then
        Result = "orin-v1.3-animation-checkpoint.glb"
    Else If ProfileIndex = PROFILE_DRAGON Then
        Result = "red-dragon-v1.1-animated.glb"
    Else If ProfileIndex = PROFILE_ARIN_V56 Then
        Result = "arin-integrated-candidate-v5.6.glb"
    Else If ProfileIndex = PROFILE_ARIN_ORIGINAL Then
        Result = "sin-star-i-character-1-paladin-tripo-v01.original.glb"
    Else If ProfileIndex = PROFILE_TECHNICAL_ARTICULATED Then
        Result = "AnimationArticulated.sm3d"
    End If

    Return Result

End Function

Public Function ClipCount(ProfileIndex As Number) As Number

    Dim Result As Number

    If ProfileIndex = PROFILE_DRAGON Then
        Result = 6
    Else If ProfileIndex = PROFILE_ORIN Then
        Result = 9
    Else If IsPartyCharacter(ProfileIndex) Then
        Result = 8
    Else If ProfileIndex = PROFILE_ARIN_V56 Then
        Result = 11
    Else If ProfileIndex = PROFILE_ARIN_ORIGINAL Then
        Result = 3
    Else If ProfileIndex = PROFILE_TECHNICAL_ARTICULATED Then
        Result = 5
    End If

    Return Result

End Function

Public Function InitialOrbitYaw(ProfileIndex As Number) As Number

    Dim Result As Number

    If IsPartyCharacter(ProfileIndex) Or ProfileIndex = PROFILE_ARIN_V56 Then
        Result = -90
    End If

    Return Result

End Function

Public Function EpicGlowAvailable(ProfileIndex As Number) As Boolean

    Dim Result As Boolean

    Result = IsPartyCharacter(ProfileIndex)

    Return Result

End Function

Public Function EpicGlowVisibleByDefault(ProfileIndex As Number) As Boolean

    Dim Result As Boolean

    Result = IsPartyCharacter(ProfileIndex)

    Return Result

End Function

Public Function ClipName(ProfileIndex As Number, ClipIndex As Number) As Text

    Dim Result As Text

    If ProfileIndex = PROFILE_DRAGON Then

        If ClipIndex = 0 Then
            Result = "Idle"
        Else If ClipIndex = 1 Then
            Result = "FireBreath"
        Else If ClipIndex = 2 Then
            Result = "ClawStrike"
        Else If ClipIndex = 3 Then
            Result = "Fireball"
        Else If ClipIndex = 4 Then
            Result = "Hit"
        Else If ClipIndex = 5 Then
            Result = "Roar"
        End If

    Else If ProfileIndex = PROFILE_ORIN Then

        If ClipIndex = 0 Then
            Result = "Idle"
        Else If ClipIndex = 1 Then
            Result = "SwordAttack"
        Else If ClipIndex = 2 Then
            Result = "JumpAttack"
        Else If ClipIndex = 3 Then
            Result = "ThorAttack"
        Else If ClipIndex = 4 Then
            Result = "Defend"
        Else If ClipIndex = 5 Then
            Result = "Hit"
        Else If ClipIndex = 6 Then
            Result = "Death"
        Else If ClipIndex = 7 Then
            Result = "Victory"
        Else If ClipIndex = 8 Then
            Result = "Run"
        End If

    Else If IsPartyCharacter(ProfileIndex) Then

        If ClipIndex = 0 Then
            Result = "Idle"
        Else If ClipIndex = 1 Then
            Result = "SwordAttack"
        Else If ClipIndex = 2 Then
            Result = "SwordAttack2"
        Else If ClipIndex = 3 Then
            Result = "Defend"
        Else If ClipIndex = 4 Then
            Result = "BlockImpact"
        Else If ClipIndex = 5 Then
            Result = "Hit"
        Else If ClipIndex = 6 Then
            Result = "Walk"
        Else If ClipIndex = 7 Then
            Result = "Run"
        End If

    Else If ProfileIndex = PROFILE_ARIN_V56 Then

        If ClipIndex = 0 Then
            Result = "Idle"
        Else If ClipIndex = 1 Then
            Result = "SwordAttack"
        Else If ClipIndex = 2 Then
            Result = "ShieldBashCandidate"
        Else If ClipIndex = 3 Then
            Result = "Defend"
        Else If ClipIndex = 4 Then
            Result = "BlockImpact"
        Else If ClipIndex = 5 Then
            Result = "Hit"
        Else If ClipIndex = 6 Then
            Result = "Walk"
        Else If ClipIndex = 7 Then
            Result = "Run"
        Else If ClipIndex = 8 Then
            Result = "Ready"
        Else If ClipIndex = 9 Then
            Result = "KO"
        Else If ClipIndex = 10 Then
            Result = "Victory"
        End If

    Else If ProfileIndex = PROFILE_ARIN_ORIGINAL Then

        If ClipIndex = 0 Then
            Result = "preset:biped:idle"
        Else If ClipIndex = 1 Then
            Result = "preset:biped:walk"
        Else If ClipIndex = 2 Then
            Result = "preset:biped:run"
        End If

    Else If ProfileIndex = PROFILE_TECHNICAL_ARTICULATED Then

        If ClipIndex = 0 Then
            Result = "Idle"
        Else If ClipIndex = 1 Then
            Result = "AttackLike"
        Else If ClipIndex = 2 Then
            Result = "Bend"
        Else If ClipIndex = 3 Then
            Result = "WalkLike"
        Else If ClipIndex = 4 Then
            Result = "RootMove"
        End If

    End If

    Return Result

End Function

Public Function ClipLabel(ProfileIndex As Number, ClipIndex As Number) As Text

    Dim Result As Text

    If ProfileIndex = PROFILE_DRAGON And ClipIndex = 1 Then

        Result = "Fire Breath"

    Else If ProfileIndex = PROFILE_DRAGON And ClipIndex = 2 Then

        Result = "Claw Strike"

    Else If ProfileIndex = PROFILE_ORIN Then

        If ClipIndex = 1 Then
            Result = "Attack"
        Else If ClipIndex = 2 Then
            Result = "Jump Attack"
        Else If ClipIndex = 3 Then
            Result = "Thor Attack"
        Else If ClipIndex = 4 Then
            Result = "Block"
        Else
            Result = ClipName(ProfileIndex, ClipIndex)
        End If

    Else If IsPartyCharacter(ProfileIndex) Then

        If ClipIndex = 1 Then
            Result = "Attack"
        Else If ClipIndex = 2 Then
            Result = "Attack 2"
        Else If ClipIndex = 4 Then
            Result = "Block Impact"
        Else
            Result = ClipName(ProfileIndex, ClipIndex)
        End If

    Else If ProfileIndex = PROFILE_ARIN_V56 Then

        If ClipIndex = 1 Then
            Result = "Attack"
        Else If ClipIndex = 2 Then
            Result = "Shield Bash"
        Else If ClipIndex = 4 Then
            Result = "Block Impact"
        Else
            Result = ClipName(ProfileIndex, ClipIndex)
        End If

    Else If ProfileIndex = PROFILE_ARIN_ORIGINAL Then

        If ClipIndex = 0 Then
            Result = "Idle"
        Else If ClipIndex = 1 Then
            Result = "Walk"
        Else If ClipIndex = 2 Then
            Result = "Run"
        End If

    Else If ProfileIndex = PROFILE_TECHNICAL_ARTICULATED And ClipIndex = 1 Then

        Result = "Attack"

    Else
        Result = ClipName(ProfileIndex, ClipIndex)

    End If

    Return Result

End Function

Public Function ClipLoops(ProfileIndex As Number, ClipIndex As Number) As Boolean

    Dim Result As Boolean

    Result = True

    If ProfileIndex = PROFILE_DRAGON Then
        Result = ClipIndex = 0
    Else If ProfileIndex = PROFILE_ORIN Then
        Result = ClipIndex = 0 Or ClipIndex = 8
    Else If IsPartyCharacter(ProfileIndex) Then
        Result = (ClipIndex = 0 Or
            ClipIndex = 3 Or
            ClipIndex = 6 Or
            ClipIndex = 7)
    Else If ProfileIndex = PROFILE_ARIN_V56 Then
        Result = (ClipIndex = 0 Or
            ClipIndex = 3 Or
            ClipIndex = 6 Or
            ClipIndex = 7 Or
            ClipIndex = 8)
    Else If ProfileIndex = PROFILE_TECHNICAL_ARTICULATED Then
        Result = ClipIndex <> 1 And ClipIndex <> 2
    End If

    Return Result

End Function

Public Function ClipVerticalOffset1000(
    ProfileIndex As Number,
    ClipName As Text,
    Frame As Number
) As Number

    Dim Result As Number

    If ProfileIndex <> PROFILE_ORIN Then
        Return 0
    End If

    ''' Curves remove the per-clip sole drift; the bind-to-Idle offset also applies at frame zero.

    If ClipName = "Defend" Then

        Frame = Max(0, Min(18, Frame))

        If Frame < 4 Then
            Result = 0 + (Frame - 0) * (-15) / 4
        Else If Frame < 6 Then
            Result = -15 + (Frame - 4) * (13) / 2
        Else If Frame < 8 Then
            Result = -2 + (Frame - 6) * (-16) / 2
        Else If Frame < 10 Then
            Result = -18 + (Frame - 8) * (-1) / 2
        Else If Frame < 14 Then
            Result = -19 + (Frame - 10) * (-23) / 4
        Else If Frame < 18 Then
            Result = -42 + (Frame - 14) * (-13) / 4
        Else
            Result = -55
        End If

    Else If ClipName = "Hit" Then

        Frame = Max(0, Min(22, Frame))

        If Frame < 2 Then
            Result = 0 + (Frame - 0) * (1) / 2
        Else If Frame < 4 Then
            Result = 1 + (Frame - 2) * (41) / 2
        Else If Frame < 5 Then
            Result = 42 + (Frame - 4) * (11) / 1
        Else If Frame < 9 Then
            Result = 53 + (Frame - 5) * (40) / 4
        Else If Frame < 12 Then
            Result = 93 + (Frame - 9) * (14) / 3
        Else If Frame < 14 Then
            Result = 107 + (Frame - 12) * (-15) / 2
        Else If Frame < 16 Then
            Result = 92 + (Frame - 14) * (-42) / 2
        Else If Frame < 18 Then
            Result = 50 + (Frame - 16) * (-29) / 2
        Else If Frame < 22 Then
            Result = 21 + (Frame - 18) * (-21) / 4
        Else
            Result = 0
        End If

    Else If ClipName = "Death" Then

        Frame = Max(0, Min(118, Frame))

        If Frame < 2 Then
            Result = 0 + (Frame - 0) * (2) / 2
        Else If Frame < 4 Then
            Result = 2 + (Frame - 2) * (22) / 2
        Else If Frame < 5 Then
            Result = 24 + (Frame - 4) * (4) / 1
        Else If Frame < 9 Then
            Result = 28 + (Frame - 5) * (7) / 4
        Else If Frame < 12 Then
            Result = 35 + (Frame - 9) * (44) / 3
        Else If Frame < 13 Then
            Result = 79 + (Frame - 12) * (9) / 1
        Else If Frame < 25 Then
            Result = 88 + (Frame - 13) * (-15) / 12
        Else If Frame < 34 Then
            Result = 73 + (Frame - 25) * (-24) / 9
        Else If Frame < 38 Then
            Result = 49 + (Frame - 34) * (-23) / 4
        Else If Frame < 41 Then
            Result = 26 + (Frame - 38) * (-10) / 3
        Else If Frame < 44 Then
            Result = 16 + (Frame - 41) * (-23) / 3
        Else If Frame < 47 Then
            Result = -7 + (Frame - 44) * (-48) / 3
        Else If Frame < 49 Then
            Result = -55 + (Frame - 47) * (-62) / 2
        Else If Frame < 50 Then
            Result = -117 + (Frame - 49) * (-54) / 1
        Else If Frame < 51 Then
            Result = -171 + (Frame - 50) * (-19) / 1
        Else If Frame < 55 Then
            Result = -190 + (Frame - 51) * (-9) / 4
        Else If Frame < 59 Then
            Result = -199 + (Frame - 55) * (11) / 4
        Else If Frame < 79 Then
            Result = -188 + (Frame - 59) * (-3) / 20
        Else If Frame < 85 Then
            Result = -191 + (Frame - 79) * (47) / 6
        Else If Frame < 87 Then
            Result = -144 + (Frame - 85) * (36) / 2
        Else If Frame < 89 Then
            Result = -108 + (Frame - 87) * (60) / 2
        Else If Frame < 91 Then
            Result = -48 + (Frame - 89) * (76) / 2
        Else If Frame < 93 Then
            Result = 28 + (Frame - 91) * (94) / 2
        Else If Frame < 94 Then
            Result = 122 + (Frame - 93) * (26) / 1
        Else If Frame < 95 Then
            Result = 148 + (Frame - 94) * (1) / 1
        Else If Frame < 96 Then
            Result = 149 + (Frame - 95) * (-12) / 1
        Else If Frame < 97 Then
            Result = 137 + (Frame - 96) * (-3) / 1
        Else If Frame < 100 Then
            Result = 134 + (Frame - 97) * (7) / 3
        Else If Frame < 103 Then
            Result = 141 + (Frame - 100) * (-17) / 3
        Else If Frame < 104 Then
            Result = 124 + (Frame - 103) * (1) / 1
        Else If Frame < 106 Then
            Result = 125 + (Frame - 104) * (16) / 2
        Else If Frame < 108 Then
            Result = 141 + (Frame - 106) * (33) / 2
        Else If Frame < 110 Then
            Result = 174 + (Frame - 108) * (13) / 2
        Else If Frame < 112 Then
            Result = 187 + (Frame - 110) * (1) / 2
        Else If Frame < 115 Then
            Result = 188 + (Frame - 112) * (-17) / 3
        Else If Frame < 118 Then
            Result = 171 + (Frame - 115) * (7) / 3
        Else
            Result = 178
        End If

    End If

    Result = Result - 119

    Return Result

End Function

Public Function SocketCount(ProfileIndex As Number) As Number

    Dim Result As Number

    If ProfileIndex = PROFILE_DRAGON Then
        Result = 6
    Else If IsPartyCharacter(ProfileIndex) Then
        Result = 10
    Else If ProfileIndex = PROFILE_ARIN_V56 Then
        Result = 10
    Else If ProfileIndex = PROFILE_ARIN_ORIGINAL Then
        Result = 6
    Else If ProfileIndex = PROFILE_TECHNICAL_ARTICULATED Then
        Result = 1
    End If

    Return Result

End Function

Public Function SocketName(ProfileIndex As Number, SocketIndex As Number) As Text

    Dim Result As Text

    If ProfileIndex = PROFILE_DRAGON Then

        If SocketIndex = 0 Then
            Result = "Root"
        Else If SocketIndex = 1 Then
            Result = "Head"
        Else If SocketIndex = 2 Then
            Result = "Chest"
        Else If SocketIndex = 3 Then
            Result = "Mouth"
        Else If SocketIndex = 4 Then
            Result = "EyeLeft"
        Else If SocketIndex = 5 Then
            Result = "EyeRight"
        End If

    Else If (IsPartyCharacter(ProfileIndex) Or
        ProfileIndex = PROFILE_ARIN_V56 Or
        ProfileIndex = PROFILE_ARIN_ORIGINAL) Then

        If SocketIndex = 0 Then
            Result = "Root"
        Else If SocketIndex = 1 Then
            Result = "Head"
        Else If SocketIndex = 2 Then
            Result = "Chest"
        Else If SocketIndex = 3 Then
            Result = "SwordBase"
        Else If SocketIndex = 4 Then
            Result = "SwordTip"
        Else If SocketIndex = 5 Then
            Result = "ShieldCenter"
        Else If ((IsPartyCharacter(ProfileIndex) Or
            ProfileIndex = PROFILE_ARIN_V56) And
            SocketIndex = 6) Then
            Result = "HandRight"
        Else If ((IsPartyCharacter(ProfileIndex) Or
            ProfileIndex = PROFILE_ARIN_V56) And
            SocketIndex = 7) Then
            Result = "HandLeft"
        Else If ((IsPartyCharacter(ProfileIndex) Or
            ProfileIndex = PROFILE_ARIN_V56) And
            SocketIndex = 8) Then
            Result = "FootLeft"
        Else If ((IsPartyCharacter(ProfileIndex) Or
            ProfileIndex = PROFILE_ARIN_V56) And
            SocketIndex = 9) Then
            Result = "FootRight"
        End If

    Else If ProfileIndex = PROFILE_TECHNICAL_ARTICULATED And SocketIndex = 0 Then

        Result = "Grip"

    End If

    Return Result

End Function

Public Function IsPartyCharacter(ProfileIndex As Number) As Boolean

    Dim Result As Boolean

    Result = ProfileIndex = PROFILE_ARIN Or ProfileIndex = PROFILE_ORIN

    Return Result

End Function

Public Function CalibrationKey(ProfileIndex As Number) As Text

    Dim Result As Text

    Result = "CharacterViewerCalibrationKeyframes"

    If ProfileIndex = PROFILE_ORIN Then
        Result = "CharacterViewer.Orin.v1.3.CalibrationKeyframes"
    End If

    Return Result

End Function

Public Function CalibrationFile(ProfileIndex As Number) As Text

    Dim Result As Text

    Result = "D:\SMILE 2.0\games\SinStarI\SourceAssets\Characters\Paladin\ArinV57\Calibration\arin-v5.7-pose-calibration.json"

    If ProfileIndex = PROFILE_ORIN Then
        Result = "D:\SMILE 2.0\games\SinStarI\SourceAssets\Characters\Tank\OrinV13\Calibration\orin-v1.3-pose-calibration.json"
    End If

    Return Result

End Function

Public Function CalibrationFingerprint(ProfileIndex As Number) As Text

    Dim Result As Text

    Result = "f554574e00ec4a9f9c59eac1b3d4adaec9649c90972cc5f0dc6c92859568ba5d"

    If ProfileIndex = PROFILE_ORIN Then
        Result = "bfb3b7d79acec5dbde993703f737f515196826ddc3c89dba91079f8580d6e002"
    End If

    Return Result

End Function

End Module
