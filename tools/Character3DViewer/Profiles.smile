''' Repository-owned profiles for the generic Character 3D Viewer.
Module Smile.Tools.Character3DViewerProfiles

Option Explicit

Import Smile.Simple3D.CharacterViewer As CharacterViewer

Public Const PROFILE_ARIN = 0
Public Const ZARA_ATTACK_HIT_PERCENT = 25
Public Const PROFILE_ARIN_V56 = 1
Public Const PROFILE_ARIN_ORIGINAL = 2
Public Const PROFILE_TECHNICAL_ARTICULATED = 3
Public Const PROFILE_ORIN = 4
Public Const PROFILE_DRAGON = 5
Public Const PROFILE_VALOR = 6
Public Const PROFILE_ZARA = 7
Public Const PROFILE_VRAX = 8
Public Const CHARACTER_TAB_PARTY_VRAX = 3
Public Const CHARACTER_TAB_PARTY_DRAGON = 7
Public Const INCLUDE_UNITY_CHARACTERS = True
Public Const INCLUDE_DIAGNOSTIC_PROFILES = True
Public Const EQUIPMENT_GLOW_FIRE = 0
Public Const EQUIPMENT_GLOW_LIGHTNING = 1

Public Function IsPartyTab(Index As Number) As Boolean

    Dim Result As Boolean

    Result = (Index = CHARACTER_TAB_PARTY_VRAX Or
        Index = CHARACTER_TAB_PARTY_DRAGON)

    Return Result

End Function

Public Function UsesUnityPartyRoster(Index As Number) As Boolean

    Dim Result As Boolean

    Result = (INCLUDE_UNITY_CHARACTERS And
        Index = CHARACTER_TAB_PARTY_VRAX)

    Return Result

End Function

Public Function NextProfile(Current As Number) As Number

    Dim Result As Number

    If INCLUDE_DIAGNOSTIC_PROFILES Then
        Result = (Current + 1) Mod ProfileCount()
    Else If Current = PROFILE_ARIN Then
        Result = PROFILE_ORIN
    Else If Current = PROFILE_ORIN And INCLUDE_UNITY_CHARACTERS Then
        Result = PROFILE_VALOR
    Else If Current = PROFILE_VALOR Then
        Result = PROFILE_ZARA
    Else If Current = PROFILE_ZARA Or Current = PROFILE_ORIN Then
        Result = PROFILE_DRAGON
    Else If Current = PROFILE_DRAGON And INCLUDE_UNITY_CHARACTERS Then
        Result = PROFILE_VRAX
    Else
        Result = PROFILE_ARIN
    End If

    Return Result

End Function

Public Function HoldsFinalPose(ProfileIndex As Number, ClipName As Text) As Boolean

    Dim Result As Boolean

    Result = ((ProfileIndex = PROFILE_ORIN And ClipName = "Defend") Or
        (IsPartyCharacter(ProfileIndex) And ClipName = "Death") Or
        (IsUnityCharacter(ProfileIndex) And Not UnityClipLoops(ClipName)))

    Return Result

End Function

Public Function ProfileCount() As Number

    If INCLUDE_UNITY_CHARACTERS Then
        Return 9
    End If

    Return 6

End Function

Public Function ProfileAt(Index As Number) As CharacterViewer.Profile

    Dim Result As CharacterViewer.Profile

    Result.Version = 1
    Result.MinimumPlaybackSpeed = 25
    Result.MaximumPlaybackSpeed = 200
    Result.DefaultPlaybackSpeed = 100
    Result.MarginPercent = 18
    Result.AnimationMargin = 2

    If Index = PROFILE_ARIN Then

        Result.AssetId = "sin-star-i.character-1.paladin"
        Result.CandidateVersion = "v5.7"
        Result.DisplayName = "Arin"
        Result.PartyRole = "Paladin"
        Result.PrototypeAlias = "dragonfall.arin-v5-7"
        Result.ProductionStatus = "Candidate"
        Result.AssetPath = "Assets\Generation2\ArinV57\ArinV57.sm3d"
        Result.ExpectedClipCount = 9
        Result.ExpectedSocketCount = 21
        Result.DesiredWorldHeight = 100
        Result.DefaultPlaybackSpeed = 200

    Else If Index = PROFILE_ORIN Then

        Result.AssetId = "sin-star-i.character-2.tank"
        Result.CandidateVersion = "v1.3"
        Result.DisplayName = "Orin"
        Result.PartyRole = "Tank"
        Result.PrototypeAlias = ""
        Result.ProductionStatus = "Candidate"
        Result.AssetPath = "Assets\Generation2\OrinV13\OrinV13.sm3d"
        Result.ExpectedClipCount = 9
        Result.ExpectedSocketCount = 21
        Result.DesiredWorldHeight = 125
        Result.DefaultPlaybackSpeed = 200

    Else If Index = PROFILE_DRAGON Then

        Result.AssetId = "sin-star-i.boss.red-dragon"
        Result.CandidateVersion = "v1.1"
        Result.DisplayName = "Dragon"
        Result.PartyRole = "Boss"
        Result.ProductionStatus = "Preview"
        Result.AssetPath = "Assets\Generation2\RedDragon\RedDragon.sm3d"
        Result.ExpectedClipCount = 6
        Result.ExpectedSocketCount = 6
        Result.DesiredWorldHeight = 250

    Else If Index = PROFILE_VALOR Then

        Result.AssetId = "sin-star-i.character.valor"
        Result.CandidateVersion = "v1"
        Result.DisplayName = "Valor"
        Result.PartyRole = "Knight"
        Result.ProductionStatus = "Preview"
        Result.AssetPath = "Assets\Generation2\ValorV1\Valor.sm3d"
        Result.ExpectedClipCount = 31
        Result.ExpectedSocketCount = 14
        Result.DesiredWorldHeight = 100
        Result.DefaultPlaybackSpeed = 200

    Else If Index = PROFILE_ZARA Then

        Result.AssetId = "sin-star-i.character.zara"
        Result.CandidateVersion = "v1"
        Result.DisplayName = "Zara"
        Result.PartyRole = "Warrior"
        Result.ProductionStatus = "Preview"
        Result.AssetPath = "Assets\Generation2\ZaraV1\Zara.sm3d"
        Result.ExpectedClipCount = 26
        Result.ExpectedSocketCount = 10
        Result.DesiredWorldHeight = 100
        Result.DefaultPlaybackSpeed = 200

    Else If Index = PROFILE_VRAX Then

        Result.AssetId = "sin-star-i.boss.vrax"
        Result.CandidateVersion = "v1"
        Result.DisplayName = "Vrax"
        Result.PartyRole = "Boss"
        Result.ProductionStatus = "Preview"
        Result.AssetPath = "Assets\Generation2\VraxV1\Vrax.sm3d"
        Result.ExpectedClipCount = 24
        Result.ExpectedSocketCount = 4
        Result.DesiredWorldHeight = 460

    Else If Index = PROFILE_ARIN_V56 Then

        Result.AssetId = "sin-star-i.character-1.paladin"
        Result.CandidateVersion = "v5.6"
        Result.DisplayName = "Arin"
        Result.PartyRole = "Paladin"
        Result.PrototypeAlias = "dragonfall.arin-v5-6"
        Result.ProductionStatus = "Diagnostic"
        Result.AssetPath = "Assets\Generation2\ArinV56\ArinV56.sm3d"
        Result.ExpectedClipCount = 11
        Result.ExpectedSocketCount = 10
        Result.DesiredWorldHeight = 100

    Else If Index = PROFILE_ARIN_ORIGINAL Then

        Result.AssetId = "sin-star-i.character-1.paladin"
        Result.CandidateVersion = "prototype-original"
        Result.DisplayName = "Arin (Original)"
        Result.PartyRole = "Paladin"
        Result.PrototypeAlias = "dragonfall.arin-prototype"
        Result.ProductionStatus = "Prototype"
        Result.AssetPath = "Assets\Generation2\Arin\ArinPrototype.sm3d"
        Result.ExpectedClipCount = 3
        Result.ExpectedSocketCount = 6
        Result.DesiredWorldHeight = 100

    Else If Index = PROFILE_TECHNICAL_ARTICULATED Then

        Result.AssetId = "smile.technical.animation-articulated"
        Result.CandidateVersion = "fixture-v1"
        Result.DisplayName = "Articulated Fixture"
        Result.PartyRole = ""
        Result.PrototypeAlias = ""
        Result.ProductionStatus = "Technical"
        Result.AssetPath = "TechnicalAssets\Generation2\AnimationArticulated.sm3d"
        Result.ExpectedClipCount = 5
        Result.ExpectedSocketCount = 1
        Result.DesiredWorldHeight = 180

    End If

    Return Result

End Function

Public Function ModelFileName(ProfileIndex As Number) As Text

    Dim Result As Text

    If IsUnityCharacter(ProfileIndex) Then
        Result = UnityName(ProfileIndex) + "-v1-animation-set.glb"
    Else If ProfileIndex = PROFILE_ARIN Then
        Result = "arin-v5.7-idle-equipment-checkpoint.glb"
    Else If ProfileIndex = PROFILE_ORIN Then
        Result = "orin-v1.3-animation-checkpoint.glb"
    Else If ProfileIndex = PROFILE_DRAGON Then
        Result = "red-dragon-v1.1-animated.glb"
    Else If ProfileIndex = PROFILE_ARIN_V56 Then
        Result = "arin-integrated-candidate-v5.6.glb"
    Else If ProfileIndex = PROFILE_ARIN_ORIGINAL Then
        Result = "sin-star-i-character-1-paladin-tripo-v01.original.glb"
    Else If ProfileIndex = PROFILE_TECHNICAL_ARTICULATED Then
        Result = "AnimationArticulated.sm3d"
    End If

    Return Result

End Function

Public Function ClipCount(ProfileIndex As Number) As Number

    Dim Result As Number

    If ProfileIndex = PROFILE_VALOR Then
        Result = 31
    Else If ProfileIndex = PROFILE_ZARA Then
        Result = 26
    Else If ProfileIndex = PROFILE_VRAX Then
        Result = 24
    Else If ProfileIndex = PROFILE_DRAGON Then
        Result = 6
    Else If ProfileIndex = PROFILE_ORIN Then
        Result = 9
    Else If IsPartyCharacter(ProfileIndex) Then
        Result = 9
    Else If ProfileIndex = PROFILE_ARIN_V56 Then
        Result = 11
    Else If ProfileIndex = PROFILE_ARIN_ORIGINAL Then
        Result = 3
    Else If ProfileIndex = PROFILE_TECHNICAL_ARTICULATED Then
        Result = 5
    End If

    Return Result

End Function

Public Function InitialOrbitYaw(ProfileIndex As Number) As Number

    Dim Result As Number

    If IsPartyCharacter(ProfileIndex) Or ProfileIndex = PROFILE_ARIN_V56 Then
        Result = -90
    End If

    Return Result

End Function

Public Function EpicGlowAvailable(ProfileIndex As Number) As Boolean

    Dim Result As Boolean

    Result = IsEquipmentCharacter(ProfileIndex)

    Return Result

End Function

Public Function EpicGlowVisibleByDefault(ProfileIndex As Number) As Boolean

    Dim Result As Boolean

    Result = IsEquipmentCharacter(ProfileIndex)

    Return Result

End Function

Public Function ClipName(ProfileIndex As Number, ClipIndex As Number) As Text

    Dim Result As Text

    If IsUnityCharacter(ProfileIndex) Then

        Result = UnityClipName(ProfileIndex, ClipIndex)

    Else If ProfileIndex = PROFILE_DRAGON Then

        If ClipIndex = 0 Then
            Result = "Idle"
        Else If ClipIndex = 1 Then
            Result = "FireBreath"
        Else If ClipIndex = 2 Then
            Result = "ClawStrike"
        Else If ClipIndex = 3 Then
            Result = "Fireball"
        Else If ClipIndex = 4 Then
            Result = "Hit"
        Else If ClipIndex = 5 Then
            Result = "Roar"
        End If

    Else If ProfileIndex = PROFILE_ORIN Then

        If ClipIndex = 0 Then
            Result = "Idle"
        Else If ClipIndex = 1 Then
            Result = "SwordAttack"
        Else If ClipIndex = 2 Then
            Result = "JumpAttack"
        Else If ClipIndex = 3 Then
            Result = "ThorAttack"
        Else If ClipIndex = 4 Then
            Result = "Defend"
        Else If ClipIndex = 5 Then
            Result = "Hit"
        Else If ClipIndex = 6 Then
            Result = "Death"
        Else If ClipIndex = 7 Then
            Result = "Victory"
        Else If ClipIndex = 8 Then
            Result = "Run"
        End If

    Else If IsPartyCharacter(ProfileIndex) Then

        If ClipIndex = 0 Then
            Result = "Idle"
        Else If ClipIndex = 1 Then
            Result = "SwordAttack"
        Else If ClipIndex = 2 Then
            Result = "SwordAttack2"
        Else If ClipIndex = 3 Then
            Result = "Defend"
        Else If ClipIndex = 4 Then
            Result = "BlockImpact"
        Else If ClipIndex = 5 Then
            Result = "Hit"
        Else If ClipIndex = 6 Then
            Result = "Walk"
        Else If ClipIndex = 7 Then
            Result = "Run"
        Else If ClipIndex = 8 Then
            Result = "Death"
        End If

    Else If ProfileIndex = PROFILE_ARIN_V56 Then

        If ClipIndex = 0 Then
            Result = "Idle"
        Else If ClipIndex = 1 Then
            Result = "SwordAttack"
        Else If ClipIndex = 2 Then
            Result = "ShieldBashCandidate"
        Else If ClipIndex = 3 Then
            Result = "Defend"
        Else If ClipIndex = 4 Then
            Result = "BlockImpact"
        Else If ClipIndex = 5 Then
            Result = "Hit"
        Else If ClipIndex = 6 Then
            Result = "Walk"
        Else If ClipIndex = 7 Then
            Result = "Run"
        Else If ClipIndex = 8 Then
            Result = "Ready"
        Else If ClipIndex = 9 Then
            Result = "KO"
        Else If ClipIndex = 10 Then
            Result = "Victory"
        End If

    Else If ProfileIndex = PROFILE_ARIN_ORIGINAL Then

        If ClipIndex = 0 Then
            Result = "preset:biped:idle"
        Else If ClipIndex = 1 Then
            Result = "preset:biped:walk"
        Else If ClipIndex = 2 Then
            Result = "preset:biped:run"
        End If

    Else If ProfileIndex = PROFILE_TECHNICAL_ARTICULATED Then

        If ClipIndex = 0 Then
            Result = "Idle"
        Else If ClipIndex = 1 Then
            Result = "AttackLike"
        Else If ClipIndex = 2 Then
            Result = "Bend"
        Else If ClipIndex = 3 Then
            Result = "WalkLike"
        Else If ClipIndex = 4 Then
            Result = "RootMove"
        End If

    End If

    Return Result

End Function

Public Function EquipmentGlowStyle(ProfileIndex As Number) As Number

    Dim Result As Number

    Result = EQUIPMENT_GLOW_FIRE

    If (ProfileIndex = PROFILE_ORIN Or
        ProfileIndex = PROFILE_ZARA Or
        ProfileIndex = PROFILE_VALOR) Then
        Result = EQUIPMENT_GLOW_LIGHTNING
    End If

    Return Result

End Function

Public Function IsEquipmentCharacter(ProfileIndex As Number) As Boolean

    Dim Result As Boolean

    Result = IsPartyCharacter(ProfileIndex) Or ProfileIndex = PROFILE_VALOR Or ProfileIndex = PROFILE_ZARA

    Return Result

End Function

Public Function WeaponPart(ProfileIndex As Number) As Number

    If ProfileIndex = PROFILE_VALOR Then
        Return 10
    Else If ProfileIndex = PROFILE_ZARA Then
        Return 3
    End If

    Return 1

End Function

Public Function ShieldPart(ProfileIndex As Number) As Number

    Dim ReturnValue As Number

    If ProfileIndex = PROFILE_VALOR Then
        Return 9
    Else If ProfileIndex = PROFILE_ZARA Then
        ReturnValue = -1

        Return ReturnValue
    End If

    Return 0

End Function

Public Function EquipmentSocketPart(ProfileIndex As Number, Shield As Boolean) As Number

    Dim Result As Number

    Result = 2

    If ProfileIndex = PROFILE_VALOR Or ProfileIndex = PROFILE_ZARA Then

        Result = WeaponPart(ProfileIndex)

        If Shield Then
            Result = ShieldPart(ProfileIndex)
        End If

    End If

    Return Result

End Function

Public Function CalibrationAsset(ProfileIndex As Number) As Text

    Dim Result As Text

    If ProfileIndex = PROFILE_ARIN Then
        Result = "Assets\Calibration\arin-v5.7.smkf"
    Else If ProfileIndex = PROFILE_ORIN Then
        Result = "Assets\Calibration\orin-v1.3.smkf"
    End If

    Return Result

End Function

''' Rotates every authored Party attack without rerolling during one turn.
Public Function PartyAttackName(ProfileIndex As Number, AttackCycle As Number) As Text

    Dim Result As Text

    AttackCycle = Max(0, AttackCycle)

    If ProfileIndex = PROFILE_ARIN Then

        If AttackCycle Mod 2 = 0 Then
            Result = "SwordAttack"
        Else
            Result = "SwordAttack2"
        End If

    Else If ProfileIndex = PROFILE_VRAX Then

        If AttackCycle Mod 6 = 0 Then
            Result = "Attack"
        Else If AttackCycle Mod 6 = 1 Then
            Result = "Attack2"
        Else If AttackCycle Mod 6 = 2 Then
            Result = "Attack3"
        Else If AttackCycle Mod 6 = 3 Then
            Result = "Attack4"
        Else If AttackCycle Mod 6 = 4 Then
            Result = "Attack5"
        Else
            Result = "Attack6"
        End If

    Else If ProfileIndex = PROFILE_ORIN Then

        If AttackCycle Mod 3 = 0 Then
            Result = "SwordAttack"
        Else If AttackCycle Mod 3 = 1 Then
            Result = "JumpAttack"
        Else
            Result = "ThorAttack"
        End If

    End If

    Return Result

End Function

Public Function ClipLabel(ProfileIndex As Number, ClipIndex As Number) As Text

    Dim Result As Text

    If ProfileIndex = PROFILE_DRAGON And ClipIndex = 1 Then

        Result = "Fire Breath"

    Else If ProfileIndex = PROFILE_DRAGON And ClipIndex = 2 Then

        Result = "Claw Strike"

    Else If ProfileIndex = PROFILE_ORIN Then

        If ClipIndex = 1 Then
            Result = "Attack"
        Else If ClipIndex = 2 Then
            Result = "Jump Attack"
        Else If ClipIndex = 3 Then
            Result = "Thor Attack"
        Else If ClipIndex = 4 Then
            Result = "Block"
        Else
            Result = ClipName(ProfileIndex, ClipIndex)
        End If

    Else If IsPartyCharacter(ProfileIndex) Then

        If ClipIndex = 1 Then
            Result = "Attack"
        Else If ClipIndex = 2 Then
            Result = "Attack 2"
        Else If ClipIndex = 4 Then
            Result = "Block Impact"
        Else
            Result = ClipName(ProfileIndex, ClipIndex)
        End If

    Else If ProfileIndex = PROFILE_ARIN_V56 Then

        If ClipIndex = 1 Then
            Result = "Attack"
        Else If ClipIndex = 2 Then
            Result = "Shield Bash"
        Else If ClipIndex = 4 Then
            Result = "Block Impact"
        Else
            Result = ClipName(ProfileIndex, ClipIndex)
        End If

    Else If ProfileIndex = PROFILE_ARIN_ORIGINAL Then

        If ClipIndex = 0 Then
            Result = "Idle"
        Else If ClipIndex = 1 Then
            Result = "Walk"
        Else If ClipIndex = 2 Then
            Result = "Run"
        End If

    Else If ProfileIndex = PROFILE_TECHNICAL_ARTICULATED And ClipIndex = 1 Then

        Result = "Attack"

    Else
        Result = ClipName(ProfileIndex, ClipIndex)

    End If

    Return Result

End Function

Public Function MaximumFitScale(Profile As CharacterViewer.Profile) As Number

    If Profile.AssetId = "sin-star-i.boss.vrax" Then
        Return 20000
    End If

    Return 10000

End Function

Public Function ClipLoops(ProfileIndex As Number, ClipIndex As Number) As Boolean

    Dim Result As Boolean

    Result = True

    If IsUnityCharacter(ProfileIndex) Then
        Result = UnityClipLoops(UnityClipName(ProfileIndex, ClipIndex))
    Else If ProfileIndex = PROFILE_DRAGON Then
        Result = ClipIndex = 0
    Else If ProfileIndex = PROFILE_ORIN Then
        Result = ClipIndex = 0 Or ClipIndex = 8
    Else If IsPartyCharacter(ProfileIndex) Then
        Result = (ClipIndex = 0 Or
            ClipIndex = 3 Or
            ClipIndex = 6 Or
            ClipIndex = 7)
    Else If ProfileIndex = PROFILE_ARIN_V56 Then
        Result = (ClipIndex = 0 Or
            ClipIndex = 3 Or
            ClipIndex = 6 Or
            ClipIndex = 7 Or
            ClipIndex = 8)
    Else If ProfileIndex = PROFILE_TECHNICAL_ARTICULATED Then
        Result = ClipIndex <> 1 And ClipIndex <> 2
    End If

    Return Result

End Function

Public Function ClipVerticalOffset1000(
    ProfileIndex As Number,
    ClipName As Text,
    Frame As Number
) As Number

    Dim Result As Number

    If ProfileIndex = PROFILE_ARIN And ClipName = "Death" Then

        Frame = Max(0, Min(118, Frame))

        If Frame < 7 Then
            Result = 19 + (Frame - 0) * (1) / 7
        Else If Frame < 9 Then
            Result = 20 + (Frame - 7) * (-18) / 2
        Else If Frame < 13 Then
            Result = 2 + (Frame - 9) * (17) / 4
        Else If Frame < 38 Then
            Result = 19 + (Frame - 13) * (-2) / 25
        Else If Frame < 44 Then
            Result = 17 + (Frame - 38) * (8) / 6
        Else If Frame < 48 Then
            Result = 25 + (Frame - 44) * (-4) / 4
        Else If Frame < 52 Then
            Result = 21 + (Frame - 48) * (6) / 4
        Else If Frame < 53 Then
            Result = 27 + (Frame - 52) * (10) / 1
        Else If Frame < 56 Then
            Result = 37 + (Frame - 53) * (-21) / 3
        Else If Frame < 57 Then
            Result = 16 + (Frame - 56) * (14) / 1
        Else If Frame < 58 Then
            Result = 30 + (Frame - 57) * (4) / 1
        Else If Frame < 67 Then
            Result = 34 + (Frame - 58) * (6) / 9
        Else If Frame < 81 Then
            Result = 40 + (Frame - 67) * (-12) / 14
        Else If Frame < 91 Then
            Result = 28 + (Frame - 81) * (12) / 10
        Else If Frame < 93 Then
            Result = 40 + (Frame - 91) * (-12) / 2
        Else If Frame < 94 Then
            Result = 28 + (Frame - 93) * (8) / 1
        Else If Frame < 95 Then
            Result = 36 + (Frame - 94) * (-12) / 1
        Else If Frame < 96 Then
            Result = 24 + (Frame - 95) * (19) / 1
        Else If Frame < 98 Then
            Result = 43 + (Frame - 96) * (-15) / 2
        Else If Frame < 100 Then
            Result = 28 + (Frame - 98) * (2) / 2
        Else If Frame < 102 Then
            Result = 30 + (Frame - 100) * (-7) / 2
        Else If Frame < 104 Then
            Result = 23 + (Frame - 102) * (0) / 2
        Else If Frame < 107 Then
            Result = 23 + (Frame - 104) * (19) / 3
        Else If Frame < 109 Then
            Result = 42 + (Frame - 107) * (-1) / 2
        Else If Frame < 111 Then
            Result = 41 + (Frame - 109) * (8) / 2
        Else If Frame < 118 Then
            Result = 49 + (Frame - 111) * (-7) / 7
        Else
            Result = 42
        End If

        Return Result

    End If

    If ProfileIndex <> PROFILE_ORIN Then
        Return 0
    End If

    ''' Curves remove the per-clip sole drift; the bind-to-Idle offset also applies at frame zero.

    If ClipName = "Defend" Then

        Frame = Max(0, Min(18, Frame))

        If Frame < 4 Then
            Result = 0 + (Frame - 0) * (-15) / 4
        Else If Frame < 6 Then
            Result = -15 + (Frame - 4) * (13) / 2
        Else If Frame < 8 Then
            Result = -2 + (Frame - 6) * (-16) / 2
        Else If Frame < 10 Then
            Result = -18 + (Frame - 8) * (-1) / 2
        Else If Frame < 14 Then
            Result = -19 + (Frame - 10) * (-23) / 4
        Else If Frame < 18 Then
            Result = -42 + (Frame - 14) * (-13) / 4
        Else
            Result = -55
        End If

    Else If ClipName = "Hit" Then

        Frame = Max(0, Min(22, Frame))

        If Frame < 2 Then
            Result = 0 + (Frame - 0) * (1) / 2
        Else If Frame < 4 Then
            Result = 1 + (Frame - 2) * (41) / 2
        Else If Frame < 5 Then
            Result = 42 + (Frame - 4) * (11) / 1
        Else If Frame < 9 Then
            Result = 53 + (Frame - 5) * (40) / 4
        Else If Frame < 12 Then
            Result = 93 + (Frame - 9) * (14) / 3
        Else If Frame < 14 Then
            Result = 107 + (Frame - 12) * (-15) / 2
        Else If Frame < 16 Then
            Result = 92 + (Frame - 14) * (-42) / 2
        Else If Frame < 18 Then
            Result = 50 + (Frame - 16) * (-29) / 2
        Else If Frame < 22 Then
            Result = 21 + (Frame - 18) * (-21) / 4
        Else
            Result = 0
        End If

    Else If ClipName = "Death" Then

        Frame = Max(0, Min(118, Frame))

        If Frame < 2 Then
            Result = 0 + (Frame - 0) * (6) / 2
        Else If Frame < 3 Then
            Result = 6 + (Frame - 2) * (-3) / 1
        Else If Frame < 4 Then
            Result = 3 + (Frame - 3) * (-10) / 1
        Else If Frame < 6 Then
            Result = -7 + (Frame - 4) * (1) / 2
        Else If Frame < 9 Then
            Result = -6 + (Frame - 6) * (-24) / 3
        Else If Frame < 12 Then
            Result = -30 + (Frame - 9) * (26) / 3
        Else If Frame < 25 Then
            Result = -4 + (Frame - 12) * (2) / 13
        Else If Frame < 27 Then
            Result = -2 + (Frame - 25) * (4) / 2
        Else If Frame < 29 Then
            Result = 2 + (Frame - 27) * (-6) / 2
        Else If Frame < 31 Then
            Result = -4 + (Frame - 29) * (1) / 2
        Else If Frame < 40 Then
            Result = -3 + (Frame - 31) * (27) / 9
        Else If Frame < 42 Then
            Result = 24 + (Frame - 40) * (12) / 2
        Else If Frame < 44 Then
            Result = 36 + (Frame - 42) * (-4) / 2
        Else If Frame < 45 Then
            Result = 32 + (Frame - 44) * (-8) / 1
        Else If Frame < 47 Then
            Result = 24 + (Frame - 45) * (10) / 2
        Else If Frame < 48 Then
            Result = 34 + (Frame - 47) * (9) / 1
        Else If Frame < 49 Then
            Result = 43 + (Frame - 48) * (20) / 1
        Else If Frame < 50 Then
            Result = 63 + (Frame - 49) * (2) / 1
        Else If Frame < 52 Then
            Result = 65 + (Frame - 50) * (-57) / 2
        Else If Frame < 54 Then
            Result = 8 + (Frame - 52) * (-23) / 2
        Else If Frame < 59 Then
            Result = -15 + (Frame - 54) * (11) / 5
        Else If Frame < 78 Then
            Result = -4 + (Frame - 59) * (-1) / 19
        Else If Frame < 89 Then
            Result = -5 + (Frame - 78) * (22) / 11
        Else If Frame < 92 Then
            Result = 17 + (Frame - 89) * (-2) / 3
        Else If Frame < 93 Then
            Result = 15 + (Frame - 92) * (7) / 1
        Else If Frame < 95 Then
            Result = 22 + (Frame - 93) * (27) / 2
        Else If Frame < 96 Then
            Result = 49 + (Frame - 95) * (-2) / 1
        Else If Frame < 97 Then
            Result = 47 + (Frame - 96) * (7) / 1
        Else If Frame < 98 Then
            Result = 54 + (Frame - 97) * (-43) / 1
        Else If Frame < 99 Then
            Result = 11 + (Frame - 98) * (-17) / 1
        Else If Frame < 102 Then
            Result = -6 + (Frame - 99) * (-2) / 3
        Else If Frame < 104 Then
            Result = -8 + (Frame - 102) * (15) / 2
        Else If Frame < 107 Then
            Result = 7 + (Frame - 104) * (3) / 3
        Else If Frame < 109 Then
            Result = 10 + (Frame - 107) * (14) / 2
        Else If Frame < 115 Then
            Result = 24 + (Frame - 109) * (6) / 6
        Else If Frame < 118 Then
            Result = 30 + (Frame - 115) * (-8) / 3
        Else
            Result = 22
        End If

    End If

    Result = Result - 119

    Return Result

End Function

Public Function SocketCount(ProfileIndex As Number) As Number

    Dim Result As Number

    If ProfileIndex = PROFILE_DRAGON Then
        Result = 6
    Else If IsPartyCharacter(ProfileIndex) Then
        Result = 10
    Else If ProfileIndex = PROFILE_ARIN_V56 Then
        Result = 10
    Else If ProfileIndex = PROFILE_ARIN_ORIGINAL Then
        Result = 6
    Else If ProfileIndex = PROFILE_TECHNICAL_ARTICULATED Then
        Result = 1
    End If

    Return Result

End Function

Public Function SocketName(ProfileIndex As Number, SocketIndex As Number) As Text

    Dim Result As Text

    If ProfileIndex = PROFILE_DRAGON Then

        If SocketIndex = 0 Then
            Result = "Root"
        Else If SocketIndex = 1 Then
            Result = "Head"
        Else If SocketIndex = 2 Then
            Result = "Chest"
        Else If SocketIndex = 3 Then
            Result = "Mouth"
        Else If SocketIndex = 4 Then
            Result = "EyeLeft"
        Else If SocketIndex = 5 Then
            Result = "EyeRight"
        End If

    Else If (IsPartyCharacter(ProfileIndex) Or
        ProfileIndex = PROFILE_ARIN_V56 Or
        ProfileIndex = PROFILE_ARIN_ORIGINAL) Then

        If SocketIndex = 0 Then
            Result = "Root"
        Else If SocketIndex = 1 Then
            Result = "Head"
        Else If SocketIndex = 2 Then
            Result = "Chest"
        Else If SocketIndex = 3 Then
            Result = "SwordBase"
        Else If SocketIndex = 4 Then
            Result = "SwordTip"
        Else If SocketIndex = 5 Then
            Result = "ShieldCenter"
        Else If ((IsPartyCharacter(ProfileIndex) Or
            ProfileIndex = PROFILE_ARIN_V56) And
            SocketIndex = 6) Then
            Result = "HandRight"
        Else If ((IsPartyCharacter(ProfileIndex) Or
            ProfileIndex = PROFILE_ARIN_V56) And
            SocketIndex = 7) Then
            Result = "HandLeft"
        Else If ((IsPartyCharacter(ProfileIndex) Or
            ProfileIndex = PROFILE_ARIN_V56) And
            SocketIndex = 8) Then
            Result = "FootLeft"
        Else If ((IsPartyCharacter(ProfileIndex) Or
            ProfileIndex = PROFILE_ARIN_V56) And
            SocketIndex = 9) Then
            Result = "FootRight"
        End If

    Else If ProfileIndex = PROFILE_TECHNICAL_ARTICULATED And SocketIndex = 0 Then

        Result = "Grip"

    End If

    Return Result

End Function

Public Function IsPartyCharacter(ProfileIndex As Number) As Boolean

    Dim Result As Boolean

    Result = ProfileIndex = PROFILE_ARIN Or ProfileIndex = PROFILE_ORIN

    Return Result

End Function

Public Function HasBattleOpponent(ProfileIndex As Number) As Boolean

    Dim Result As Boolean

    Result = IsPartyCharacter(ProfileIndex) Or ProfileIndex = PROFILE_VALOR Or ProfileIndex = PROFILE_ZARA

    Return Result

End Function

Public Function UsesVraxOpponent(ProfileIndex As Number) As Boolean

    Dim Result As Boolean

    Result = (INCLUDE_UNITY_CHARACTERS And
        (ProfileIndex = PROFILE_VALOR Or ProfileIndex = PROFILE_ZARA))

    Return Result

End Function

Public Function ArenaCameraDistance(ProfileIndex As Number, DefaultDistance As Number) As Number

    Dim Result As Number

    Result = DefaultDistance

    If UsesVraxOpponent(ProfileIndex) Then
        Result = DefaultDistance * 2
    End If

    Return Result

End Function

Public Function CalibrationKey(ProfileIndex As Number) As Text

    Dim Result As Text

    Result = "CharacterViewerCalibrationKeyframes"

    If ProfileIndex = PROFILE_ORIN Then
        Result = "CharacterViewer.Orin.v1.3.CalibrationKeyframes"
    End If

    Return Result

End Function

Public Function CalibrationFile(ProfileIndex As Number) As Text

    Dim Result As Text

    Result = "D:\SMILE 2.0\games\SinStarI\SourceAssets\Characters\Paladin\ArinV57\Calibration\arin-v5.7-pose-calibration.json"

