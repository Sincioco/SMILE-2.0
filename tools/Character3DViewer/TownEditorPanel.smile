''' Right-side editing controls. Reports commands; document mutations belong to the editor.
Module Smile.Tools.TownEditorPanel

Option Explicit

Import Smile.Tools.TownDocument As Document
Import Smile.Tools.TownLibrary As SavedMaps
Import Smile.Tools.TownCatalogData As Catalog
Import Smile.Tools.TownGuides As Guides
Import Smile.Tools.TownSunControls As Sun
Import Smile.Tools.TownTerrainStyles As Styles

Public Type Control
    X As Number
    Y As Number
    Width As Number
    Height As Number
    Action As Number
End Type

Public Type State
    Atlas As Image
    AtlasLoaded As Boolean
    Controls[80] As Control
    ControlCount As Number
    Section As Number
    Category As Number
    Tool As Number
    Template As Number
    Page As Number
    TerrainStyle As Number
    PaintStyle As Number
    Surface As Number
    Width As Number
    Message As Text
    Busy As Boolean
    ProgressPercent As Number
    RoadPreparation As Number
    CanUndo As Boolean
    RecentLabels[10] As Text
    RecentCount As Number
    CanRedo As Boolean
    SunSlider As Sun.State
    Orthographic As Boolean
    GuideListOpen As Boolean
    HideGuides As Boolean
    MapNames[16] As Text
    MapCount As Number
End Type

Public Function NumberLabel(Value As Number) As Text

    Dim Result As Text
    Dim Negative As Boolean

    Negative = Value < 0
    Value = Abs(Value)

    Do
        Result = Text_From_Code(48 + Value Mod 10) + Result
        Value = Value / 10

    Loop Until Value = 0

    If Negative Then
        Result = "-" + Result
    End If

    Return Result

End Function

Public Function LeftEdge() As Number

    Dim Result As Number

    Result = Window_Width() - 306

    Return Result

End Function

Public Function ContainsPoint(X As Number, Y As Number, ViewWidth As Number, ViewHeight As Number) As Boolean

    Dim Result As Boolean

    Result = X >= ViewWidth - 306 And X < ViewWidth And Y >= 128 And Y < ViewHeight - 160

    Return Result

End Function

Public Function Hovered() As Boolean

    Dim Result As Boolean

    Result = ContainsPoint(Pointer_X(), Pointer_Y(), Window_Width(), Window_Height())

    Return Result

End Function

Public Function ConfirmPermanent(CurrentName As Text, TargetName As Text) As Boolean

    Dim Answer As Text
    Dim Accepted As Boolean

    If CurrentName = TargetName Then
        Return True
    End If

    Answer = Text_Prompt("Update Permanent " + TargetName,
        "Replace " + TargetName + " with " + CurrentName + "? Type Yes to confirm.", "")
    Accepted = Answer = "Yes"

    Return Accepted

End Function

Public Function Input(ByRef Value As State) As Number

    Dim ReturnValue As Number

    Dim Index As Number
    Dim Item As Control

    If Not Pointer_Pressed(POINTER_PRIMARY) Then
        Return 0
    End If

    For Index = 0 To Value.ControlCount - 1

        Item = Value.Controls[Index]

        If (Pointer_X() >= Item.X And
            Pointer_X() < Item.X + Item.Width And
            Pointer_Y() >= Item.Y And
            Pointer_Y() < Item.Y + Item.Height) Then
            ReturnValue = Item.Action

            Return ReturnValue
        End If

    End For

    Return 0

End Function

Public Sub Button(ByRef Value As State, Action As Number, X As Number, Y As Number,
    Width As Number, Label As Text, Optional Selected As Boolean = False, Optional Enabled As Boolean = True, Optional Height As Number = 26)

    Dim ColorValue As Number
    Dim Index As Number
    Dim TextColor As Number

    ColorValue = RGB(29, 48, 65)
    TextColor = WHITE

    If Selected Then
        ColorValue = RGB(22, 106, 119)
    End If

    If Not Enabled Then
        TextColor = RGB(106, 122, 137)
        Action = 0
    End If

    Fill Rectangle X, Y, Width, Height, ColorValue
    Draw Text Label At X + 7, Y + 5 Size 14 Color TextColor
    Index = Value.ControlCount
    Value.Controls[Index].X = X
    Value.Controls[Index].Y = Y
    Value.Controls[Index].Width = Width
    Value.Controls[Index].Height = Height
    Value.Controls[Index].Action = Action
    Value.ControlCount = Index + 1

End Sub

''' Put the reusable campfire on the first Decor page; retain all catalog identities.
Public Function PaletteIndex(Index As Number) As Number

    Dim Result As Number

    Result = Index - 1

    If Index = 0 Then
        Result = Catalog.TEMPLATE_COUNT - 1
    End If

    Return Result

End Function

Public Function PaletteRows() As Number

    Dim Result As Number

    Result = 2 * Max(1, Min(3, (Window_Height() - 636) / 93))

    Return Result

End Function

Private Sub Library(ByRef Value As State, X As Number)

    Dim StepY As Number
    Dim Index As Number
    Dim Row As Number
    Dim Matching As Number
    Dim Shape As Catalog.Template
    Dim Rows As Number
    Dim TileX As Number
    Dim TileY As Number
    Dim TemplateIndex As Number
    Dim Total As Number
    Dim PageLabel As Text

    Call Button(Value, 1, X, 206, 83, "Buildings", Value.Category = 1)
    Call Button(Value, 2, X + 87, 206, 78, "Surfaces", Value.Category = 2)
    Call Button(Value, 3, X + 169, 206, 54, "Decor", Value.Category = 3)
    Call Button(Value, 4, X + 227, 206, 56, "Bulk", Value.Category = 4)

    If Value.Category = 0 Then

        Draw Text "Pan Mode" At X, 250 Size 18 Color RGB(70, 225, 220)
        Draw Text "Left-drag to pan the map." At X, 282 Size 14 Color WHITE
        Draw Text "Click a category to resume editing." At X, 310 Size 13 Color WHITE

    Else If Value.Tool = 93 Or Value.Tool = 94 Then

        Call Button(Value, 93, X, 240, 139, "Select / Move", Value.Tool = 93)
        Call Button(Value, 94, X + 144, 240, 139, "Place / Relocate", Value.Tool = 94)
        Call Button(Value, 95, X, 276, 283, "Delete Royal Court")
        Call Button(Value, 10, X, 312, 283, "Back To Building Palette")

        Draw Text "Royal Court - One Per Map" At X, 356 Size 16 Color WHITE
        Draw Text "Move: click and drag its footprint." At X, 386 Size 13 Color WHITE
        Draw Text "Place: click the new center point." At X, 410 Size 13 Color WHITE
        Draw Text "Ground and water remain unchanged." At X, 446 Size 13 Color RGB(240, 205, 140)
        Draw Text "Doors, bridge, fountain and lights" At X, 470 Size 12 Color WHITE
        Draw Text "stay attached. Ctrl+Z undoes edits." At X, 490 Size 12 Color WHITE

    Else If Value.Category = 4 Then

        Call Button(Value, 91, X, 240, 139, "Move Sections", Value.Tool = 91)
        Call Button(Value, 92, X + 144, 240, 139, "Copy Sections", Value.Tool = 92)

        Draw Text "1. Drag a rectangle on the map." At X, 282 Size 13 Color WHITE
        Draw Text "2. Drag inside it to the destination." At X, 306 Size 13 Color WHITE
        Draw Text "Destination contents are replaced." At X, 342 Size 13 Color RGB(240, 205, 140)
        Draw Text "Move fills the source with ground." At X, 366 Size 13 Color WHITE
        Draw Text "Ctrl+Z undoes the entire operation." At X, 390 Size 13 Color WHITE
        Draw Text "Esc cancels. Guides control snapping." At X, 414 Size 12 Color WHITE
        Draw Text "Airport assemblies are protected." At X, 448 Size 12 Color RGB(240, 205, 140)
        Draw Text "Royal Court supports Move only." At X, 470 Size 12 Color RGB(240, 205, 140)

    Else If Value.Category = 2 Then

        StepY = Min(36, Max(20, (Window_Height() - 570) / 7))

        Call Button(Value, 40, X, 240, 91, "Ground", Value.Surface = 1, True, StepY - 3)
        Call Button(Value, 41, X + 96, 240, 91, "Road", Value.Surface = 3, True, StepY - 3)
        Call Button(Value, 42, X + 192, 240, 91, "Water", Value.Surface = 2, True, StepY - 3)

        Call Button(Value, 46, X, 240 + StepY, 283, "Map Load (Yellow Border)", Value.Surface = 5, True, StepY - 3)

        If Value.Surface = 6 Then

            Call Button(Value, 751, X, 240 + StepY * 2, 139, "Meadow", Value.PaintStyle = 1, True, StepY - 3)
            Call Button(Value, 752, X + 144, 240 + StepY * 2, 139, "Forest", Value.PaintStyle = 2, True, StepY - 3)
            Call Button(Value, 753, X, 240 + StepY * 3, 139, "Highland", Value.PaintStyle = 3, True, StepY - 3)
            Call Button(Value, 754, X + 144, 240 + StepY * 3, 139, "Desert", Value.PaintStyle = 4, True, StepY - 3)
            Call Button(Value, 755, X, 240 + StepY * 4, 139, "Paint Tiles", Value.Tool = 750, True, StepY - 3)
            Call Button(Value, 756, X + 144, 240 + StepY * 4, 139, "Paint Rectangle", Value.Tool = 751, True, StepY - 3)
            Call Button(Value, 758, X, 240 + StepY * 5, 139, "Snow", Value.PaintStyle = 5, True, StepY - 3)
            Call Button(Value, 757, X + 144, 240 + StepY * 5, 139, "Erase Local Style", Value.PaintStyle = 0, True, StepY - 3)
            Call Button(Value, 49, X, 240 + StepY * 6, 283, "Whole Map: " + Styles.Label(Value.TerrainStyle), False, True, StepY - 3)

            Draw Text "Click or drag to paint; release to apply." At X, 244 + StepY * 7 Size 11 Color WHITE
            Draw Text "Esc cancels. Ctrl+Z undoes the stroke." At X, 258 + StepY * 7 Size 11 Color WHITE

        Else If Value.Surface = 5 Then

            Call Button(Value, 17, X, 240 + StepY * 2, 91, "Draw Area", Value.Tool = 17, True, StepY - 3)
            Call Button(Value, 18, X + 96, 240 + StepY * 2, 91, "Reassign", Value.Tool = 18, True, StepY - 3)
            Call Button(Value, 19, X + 192, 240 + StepY * 2, 91, "Delete", Value.Tool = 19, True, StepY - 3)

            Call Button(Value, 760, X, 240 + StepY * 3, 139, "Select / Move", Value.Tool = 760, True, StepY - 3)
            Call Button(Value, 761, X + 144, 240 + StepY * 3, 139, "Resize", Value.Tool = 761, True, StepY - 3)
            Call Button(Value, 762, X, 240 + StepY * 7, 283, "Teleport Spawn (Blue)", Value.Tool = 762, True, StepY - 3)

            Draw Text "Move area / resize nearest corner." At X, 244 + StepY * 4 Size 12 Color WHITE
            Draw Text "Drag, or select then click target." At X, 244 + StepY * 5 Size 12 Color WHITE
            Draw Text "Escape clears. Ctrl+Z undoes." At X, 244 + StepY * 6 Size 12 Color WHITE

        Else

            Call Button(Value, 12, X, 240 + StepY * 2, 91, "Line", Value.Tool = 12, True, StepY - 3)
            Call Button(Value, 13, X + 96, 240 + StepY * 2, 91, "Rectangle", Value.Tool = 13, True, StepY - 3)
            Call Button(Value, 14, X + 192, 240 + StepY * 2, 91, "Erase", Value.Tool = 14, True, StepY - 3)
            Call Button(Value, 44, X, 240 + StepY * 3, 34, "-", False, True, StepY - 3)
            Call Button(Value, 45, X + 248, 240 + StepY * 3, 34, "+", False, True, StepY - 3)

            Draw Text "Thickness: " + NumberLabel(Value.Width * 2) + " m" At X + 45, 243 + StepY * 3 Size 12 Color WHITE

            Call Button(Value, 47, X, 240 + StepY * 4, 139, "Circle / Ring", Value.Tool = 47, True, StepY - 3)
            Call Button(Value, 48, X + 144, 240 + StepY * 4, 139, "Filled Circle", Value.Tool = 48, True, StepY - 3)

            Call Button(Value, 410, X, 240 + StepY * 5, 139, "Triangle", Value.Tool = 410, True, StepY - 3)
            Call Button(Value, 411, X + 144, 240 + StepY * 5, 139, "Curve", Value.Tool = 411, True, StepY - 3)
            Call Button(Value, 412, X, 240 + StepY * 6, 139, "Edit Shape Points", Value.Tool = 412, True, StepY - 3)

            Call Button(Value, 750, X, 240 + StepY * 7, 283, "Paint Terrain Styles...", False, True, StepY - 3)

            Call Button(Value, 49, X + 144, 240 + StepY * 6, 139, "Map: " + Styles.Label(Value.TerrainStyle), False, True, StepY - 3)

        End If

    Else

        Call Button(Value, 10, X, 240, 139, "Select / Move", Value.Tool = 10)
        Call Button(Value, 11, X + 144, 240, 139, "Place Copy", Value.Tool = 11)

        For Index = 0 To Catalog.TEMPLATE_COUNT - 1

            Shape = Catalog.TemplateAt(Index)

            If Shape.Category = Value.Category And Shape.PaletteVisible Then
                Total = Total + 1
            End If

        End For

        Call Button(Value, 20, X, 274, 60, "Prev", False, Value.Page > 0)
        Call Button(Value, 21, X + 223, 274, 60, "Next", False,
            (Value.Page + 1) * PaletteRows() < Total)

        If Value.Category = 1 Then
            Call Button(Value, 93, X + 65, 274, 153, "Royal Court...")
        Else
            PageLabel = ("Page " + NumberLabel(Value.Page + 1) + " / " +
                NumberLabel((Total + PaletteRows() - 1) / PaletteRows()))

            Draw Text PageLabel At X + 91, 281 Size 14 Color WHITE
        End If

        Rows = PaletteRows()

        For Index = 0 To Catalog.TEMPLATE_COUNT - 1

            TemplateIndex = PaletteIndex(Index)
            Shape = Catalog.TemplateAt(TemplateIndex)

            If Shape.Category = Value.Category And Shape.PaletteVisible Then

                If Matching >= Value.Page * Rows And Row < Rows Then

                    TileX = X + (Row Mod 2) * 144
                    TileY = 304 + (Row / 2) * 93

                    Call Button(Value, 100 + TemplateIndex, TileX, TileY, 139,
                        "", Value.Template = TemplateIndex, True, 89)

                    Draw Image Value.Atlas From (Shape.PreviewIndex Mod 5) * 128, (Shape.PreviewIndex / 5) * 96 Size 128 By 96 At TileX + 20, TileY + 2 Size 96 By 72 Filter Smooth

                    Draw Text Text_Slice(Shape.Label, 0, 19) At TileX + 5, TileY + 72 Size 11 Color WHITE

                    Row = Row + 1

                End If

                Matching = Matching + 1

            End If

        End For

        Call Button(Value, 22, X, 308 + (Rows / 2) * 93, 48, "-15")
        Call Button(Value, 35, X + 53, 308 + (Rows / 2) * 93, 97, "Angle...")
        Call Button(Value, 23, X + 155, 308 + (Rows / 2) * 93, 48, "+15")
        Call Button(Value, 24, X + 208, 308 + (Rows / 2) * 93, 75, "Delete")
        Call Button(Value, 34, X, 340 + (Rows / 2) * 93, 283, "Duplicate Selected (Ctrl+D)")

    End If

End Sub

Private Sub Construction(ByRef Value As State, ByRef Guide As Guides.State, X As Number)

    Dim Label As Text
    Dim RowY As Number
    Dim StepY As Number
    Dim Height As Number

    StepY = Min(30, Max(18, (Window_Height() - 505) / 11))

    Height = StepY - 3
    Label = "Snap: Off"

    If Guide.SnapMode = 1 Then
        Label = "Snap: Grid"
    Else If Guide.SnapMode = 2 Then
        Label = "Snap: Markers"
    Else If Guide.SnapMode = 3 Then
        Label = "Snap: Grid + Markers"
    End If

    Call Button(Value, 73, X, 212 + StepY, 139, "Guide Grid", Guide.ShowGrid, True, Height)
    Call Button(Value, 77, X + 144, 212 + StepY, 139, "Actual Tile Grid", Guide.ShowTileGrid, True, Height)
    Call Button(Value, 74, X, 212 + StepY * 2, 283, Label, Guide.SnapMode > 0, True, Height)
    Call Button(Value, 75, X, 212 + StepY * 3, 34, "/2", False, True, Height)
    Call Button(Value, 78, X + 39, 212 + StepY * 3, 204,
        "Grid: " + Guides.SpacingLabel(Guide.Spacing) + " m", False, True, Height)
    Call Button(Value, 76, X + 248, 212 + StepY * 3, 34, "x2", False, True, Height)

    Label = "Hide Guides"

    If Value.HideGuides Then
        Label = "Show Guides"
    End If

    Call Button(Value, 96, X, 212, 139, Label, Not Value.HideGuides, True, Height)
    Call Button(Value, 97, X + 144, 212, 139, "Guides List", Value.GuideListOpen, True, Height)

    RowY = 212 + StepY * 4

    If Guide.ShowTileGrid Then

        Call Button(Value, 80, X, RowY, 91, "All Tiles", Guide.TileTarget = 0, True, Height)
        Call Button(Value, 81, X + 96, RowY, 91, "Ground", Guide.TileTarget = 1, True, Height)
        Call Button(Value, 82, X + 192, RowY, 91, "Water", Guide.TileTarget = 2, True, Height)
        Call Button(Value, 83, X, RowY + StepY, 91, "Road", Guide.TileTarget = 3, True, Height)
        Call Button(Value, 84, X + 96, RowY + StepY, 91, "Buildings", Guide.TileTarget = 4, True, Height)
        Call Button(Value, 85, X + 192, RowY + StepY, 91, "Decor", Guide.TileTarget = 5, True, Height)
        Call Button(Value, 79, X, RowY + StepY * 2, 283, "Snap Objects To Tile Corners", Guide.SnapTiles, True, Height)

        RowY = RowY + StepY * 3

    End If

    Call Button(Value, 15, X, RowY, 139, "Marker Line", Value.Tool = 15, True, Height)
    Call Button(Value, 16, X + 144, RowY, 139, "Rectangle", Value.Tool = 16, True, Height)
    Call Button(Value, 86, X, RowY + StepY, 91, "Select/Move", Value.Tool = 70, True, Height)
    Call Button(Value, 87, X + 96, RowY + StepY, 91, "Duplicate", False, True, Height)
    Call Button(Value, 88, X + 192, RowY + StepY, 91, "Delete", False, True, Height)
    Call Button(Value, 72, X, RowY + StepY * 2, 283, "Clear All Markers", False, True, Height)
    Call Button(Value, 89, X, RowY + StepY * 3, 139, "Save Guides...", False, True, Height)
    Call Button(Value, 90, X + 144, RowY + StepY * 3, 139, "Load Guides...", False, True, Height)

    RowY = RowY + StepY * 4 + 4

    If RowY + 32 < Window_Height() - 261 Then
        Draw Text "Click Grid to type fractional meters." At X, RowY Size 12 Color WHITE
        Draw Text "Ctrl-click: Select  Ctrl+D: Duplicate" At X, RowY + 16 Size 12 Color WHITE
    End If

    If RowY + 80 < Window_Height() - 261 Then

        Draw Text "Actual cells may differ in size." At X, RowY + 34 Size 12 Color WHITE
        Draw Text "Buildings / Decor show footprints." At X, RowY + 50 Size 12 Color WHITE
        Draw Text ".guide files are separate from towns." At X, RowY + 66 Size 12 Color RGB(240, 205, 140)

    End If

    If (Guide.ShowGrid And
        Guide.VisibleSpacing > Guide.Spacing * 1.001 And
        RowY + 96 < Window_Height() - 261) Then
        Draw Text "Visible lines: " + Guides.SpacingLabel(Guide.VisibleSpacing) + " m (zoom in)" At X, RowY + 84 Size 11 Color RGB(240, 205, 140)
    End If

End Sub

Public Sub Draw(ByRef Value As State, ByRef Town As Document.State,
    ByRef Guide As Guides.State, SelectedCount As Number)

    Dim X As Number
    Dim LightBottom As Number
    Dim FileStep As Number
    Dim Index As Number

    X = LeftEdge() + 10
    LightBottom = 212 + 8 * Min(32, Max(16, (Window_Height() - 572) / 8))
    FileStep = Min(32, Max(16, (Window_Height() - 530) / 11))

    If Not Value.AtlasLoaded Then
        Load Image Value.Atlas From "Assets/Neris/Town-Palette.png"

        Value.AtlasLoaded = True
    End If

    Value.ControlCount = 0
    Value.TerrainStyle = Town.TerrainStyle
    Fill Rectangle X - 10, 128, 306, Max(0, Window_Height() - 298), RGB(12, 23, 36)
    Draw Text "Town Editor" At X, 138 Size 21 Color WHITE

    Call Button(Value, 400, X + 222, 136, 62, "Done")
    Call Button(Value, 50, X, 174, 49, "Items", Value.Section = 0)
    Call Button(Value, 54, X + 53, 174, 66, "Terrain", Value.Section = 7)
    Call Button(Value, 51, X + 123, 174, 42, "Sun", Value.Section = 1)
    Call Button(Value, 53, X + 169, 174, 58, "Guides", Value.Section = 3)
    Call Button(Value, 52, X + 231, 174, 52, "Files", Value.Section = 2)

    If Value.Section = 0 Then

        Call Library(Value, X)

    Else If Value.Section = 1 Then

        Call Sun.Draw(Town.Light, X)
        Call Button(Value, 220, X, LightBottom, 283, "Shadows", Town.Light.Shadows)
        Call Button(Value, 221, X, LightBottom + 32, 139, "Day")
        Call Button(Value, 222, X + 144, LightBottom + 32, 139, "Night")
        Call Button(Value, 223, X, LightBottom + 64, 139, "Save As Day", Town.Presets.HasDay)
        Call Button(Value, 224, X + 144, LightBottom + 64, 139, "Save As Night", Town.Presets.HasNight)

    Else If Value.Section = 3 Then

        Call Construction(Value, Guide, X)

    Else If Value.Section = 4 Then

        Draw Text "Recent Versions (Newest First)" At X, 210 Size 14 Color WHITE

        If Value.RecentCount = 0 Then
            Draw Text "No Viewer versions saved yet." At X, 246 Size 14 Color WHITE
        End If

        FileStep = Min(29, Max(21, (Window_Height() - 520) / 10))

        For Index = 0 To Value.RecentCount - 1
            Call Button(Value, 500 + Index, X, 236 + Index * FileStep, 283,
                Text_Slice(Value.RecentLabels[Index], 0, 36), False, True, FileStep - 1)
        End For

    Else If Value.Section = 6 Then

        Draw Text "Choose Destination Map" At X, 212 Size 15 Color WHITE
        Draw Text "The yellow area will load this map:" At X, 236 Size 12 Color WHITE

        For Index = 0 To Value.MapCount - 1
            Call Button(Value, 600 + Index, X + (Index Mod 2) * 144,
                264 + (Index / 2) * 32, 139, Text_Slice(Value.MapNames[Index], 0, 18))
        End For

        Call Button(Value, 50, X, 264 + ((Value.MapCount + 1) / 2) * 32, 283, "Cancel")

    Else If Value.Section = 5 Then

        Draw Text "Update Permanent Map" At X, 212 Size 15 Color WHITE
        Draw Text "Use current edits for this startup tab:" At X, 239 Size 12 Color WHITE

        For Index = 0 To SavedMaps.PERMANENT_COUNT - 1
            Call Button(Value, 700 + Index, X, 264 + Index * 29, 283,
                "Update " + SavedMaps.PermanentName(Index), False, True, 26)
        End For

        Draw Text "Previous map kept in Open Recovery." At X, 676 Size 12 Color RGB(240, 205, 140)

    Else If Value.Section <> 7 Then

        Draw Text "Viewer (.town)" At X, 212 Size 15 Color WHITE

        Call Button(Value, 300, X, 237, 139, "Save for Viewer", False, True, FileStep - 3)
        Call Button(Value, 302, X + 144, 237, 139, "Save As...", False, True, FileStep - 3)
        Call Button(Value, 313, X, 237 + FileStep, 283, "Save All for Viewer", False, True, FileStep - 3)
        Call Button(Value, 305, X, 237 + FileStep * 2, 139, "Open for Viewer", False, True, FileStep - 3)
        Call Button(Value, 310, X + 144, 237 + FileStep * 2, 139, "Recent Versions", False, True, FileStep - 3)
        Call Button(Value, 311, X, 237 + FileStep * 3, 283, "Show Last Town File In Explorer", False, True, FileStep - 3)
        Call Button(Value, 312, X, 237 + FileStep * 4, 283, "Update Permanent Map...", False, True, FileStep - 3)

        Draw Text "Blender (.blend)" At X, 241 + FileStep * 5 Size 15 Color WHITE

        Call Button(Value, 301, X, 237 + FileStep * 6, 139, "Save for Blender", False, True, FileStep - 3)
        Call Button(Value, 307, X + 144, 237 + FileStep * 6, 139, "Open Blender...", False, True, FileStep - 3)
        Call Button(Value, 314, X, 237 + FileStep * 7, 283, "Save All for Blender", False, True, FileStep - 3)
        Call Button(Value, 309, X, 237 + FileStep * 8, 283, "Show Last Blender File In Explorer", False, True, FileStep - 3)
        Call Button(Value, 303, X, 237 + FileStep * 9, 139, "New Town", False, True, FileStep - 3)
        Call Button(Value, 308, X + 144, 237 + FileStep * 9, 139, "Open Recovery...", False, True, FileStep - 3)
        Call Button(Value, 304, X, 237 + FileStep * 10, 139, "New World", False, True, FileStep - 3)
        Call Button(Value, 306, X + 144, 237 + FileStep * 10, 139, "Open World", False, True, FileStep - 3)

    End If

    If (Value.Section = 0 Or
        Value.Section = 3 Or
        (Value.Section = 7 And Window_Height() >= 820)) Then
        Call Button(Value, 98, X, Window_Height() - 294, 139, "2D Top View", Value.Orthographic)
        Call Button(Value, 99, X + 144, Window_Height() - 294, 139, "3D View", Not Value.Orthographic)
    End If

    Call Button(Value, 32, X, Window_Height() - 261, 139, "Undo (Ctrl+Z)", False, Value.CanUndo)
    Call Button(Value, 33, X + 144, Window_Height() - 261, 139, "Redo (Ctrl+Y)", False, Value.CanRedo)

    Draw Text Text_Slice(Town.Name, 0, 30) At X, Window_Height() - 227 Size 14 Color WHITE
    Draw Text NumberLabel(SelectedCount) + " selected" At X, Window_Height() - 205 Size 13 Color RGB(70, 225, 220)
    Draw Text Text_Slice(Value.Message, 0, 39) At X, Window_Height() - 183 Size 12 Color RGB(240, 205, 140)

    If Value.Busy Then
        Fill Rectangle X, Window_Height() - 169, 283, 4, RGB(29, 48, 65)
        Fill Rectangle X, Window_Height() - 169, 283 * Max(0, Min(100, Value.ProgressPercent)) / 100, 4, RGB(70, 225, 220)
    End If

    If Value.Section = 2 Then

        Draw Text "Road Preparation: " + NumberLabel(Value.RoadPreparation) + "%" At X, Window_Height() - 294 Size 12 Color RGB(70, 225, 220)
        Fill Rectangle X, Window_Height() - 276, 283, 4, RGB(29, 48, 65)
        Fill Rectangle X, Window_Height() - 276, 283 * Value.RoadPreparation / 100, 4, RGB(70, 225, 220)

    End If

End Sub

Public Sub Release(ByRef Value As State)

    If Value.AtlasLoaded Then
        Unload Image Value.Atlas

        Value.AtlasLoaded = False
    End If

End Sub

End Module
