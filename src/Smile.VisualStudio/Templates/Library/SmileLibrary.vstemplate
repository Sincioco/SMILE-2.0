<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="Project" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>SMILE 2.0 Library</Name>
    <Description>A reusable module library for SMILE 2.0—Simple Modern and Intuitive Language for Everyone—that builds a deterministic .smilelib package.</Description>
    <ProjectType>Smile</ProjectType>
    <LanguageTag>SMILE</LanguageTag>
    <PlatformTag>Windows</PlatformTag>
    <ProjectTypeTag>Library</ProjectTypeTag>
    <SortOrder>120</SortOrder>
    <DefaultName>SmileLibrary</DefaultName>
    <CreateNewFolder>true</CreateNewFolder>
    <ProvideDefaultName>true</ProvideDefaultName>
  </TemplateData>
  <TemplateContent>
    <Project File="SmileLibrary.smilelibproj" ReplaceParameters="true">
      <ProjectItem ReplaceParameters="true" TargetFileName="Module.smile">Module.smile</ProjectItem>
    </Project>
  </TemplateContent>
</VSTemplate>
