<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="Project" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>SMILE 2.0 Console Application</Name>
    <Description>A SMILE 2.0 console program with Windows 64-bit .exe and Web targets.</Description>
    <ProjectType>Smile</ProjectType>
    <LanguageTag>SMILE</LanguageTag>
    <PlatformTag>Windows</PlatformTag>
    <ProjectTypeTag>Console</ProjectTypeTag>
    <SortOrder>100</SortOrder>
    <DefaultName>SmileConsoleApp</DefaultName>
    <CreateNewFolder>true</CreateNewFolder>
    <ProvideDefaultName>true</ProvideDefaultName>
  </TemplateData>
  <TemplateContent>
    <Project File="SmileConsole.smileproj" ReplaceParameters="true">
      <ProjectItem ReplaceParameters="true" TargetFileName="Program.smile">Program.smile</ProjectItem>
    </Project>
  </TemplateContent>
  <WizardExtension>
    <Assembly>Smile.VisualStudio, Version=2.0.39.0, Culture=neutral, PublicKeyToken=null</Assembly>
    <FullClassName>Smile.VisualStudio.SmileProjectTemplateWizard</FullClassName>
  </WizardExtension>
</VSTemplate>
