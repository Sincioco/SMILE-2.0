' MultiFileBasics support source.
' This file owns shared constants, the fixed state array, and update/query routines.

Const STATE_X = 0
Const STATE_Y = 1
Const STATE_PULSE = 2
Const STATE_PULSE_DIRECTION = 3

Const MinimumMarkerX = 90
Const MaximumMarkerX = 870

Dim SharedState[4]

Sub ResetSharedState()
    SharedState[STATE_X] = 480
    SharedState[STATE_Y] = 300
    SharedState[STATE_PULSE] = 0
    SharedState[STATE_PULSE_DIRECTION] = 1
End Sub

Sub MoveMarker(Amount)
    SharedState[STATE_X] = Max(MinimumMarkerX, Min(MaximumMarkerX, SharedState[STATE_X] + Amount))
End Sub

Sub UpdatePulse()
    SharedState[STATE_PULSE] = SharedState[STATE_PULSE] + SharedState[STATE_PULSE_DIRECTION]

    If SharedState[STATE_PULSE] >= 40 Then
        SharedState[STATE_PULSE] = 40
        SharedState[STATE_PULSE_DIRECTION] = -1
    Else If SharedState[STATE_PULSE] <= 0 Then
        SharedState[STATE_PULSE] = 0
        SharedState[STATE_PULSE_DIRECTION] = 1
    End If
End Sub

Function MarkerX()
    Return SharedState[STATE_X]
End Function

Function MarkerY()
    Return SharedState[STATE_Y]
End Function

Function MarkerPulse()
    Return SharedState[STATE_PULSE]
End Function
