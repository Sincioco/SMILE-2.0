''' Game-facing presentation host; the shared Viewer owns actors, arena, choreography and effects.
Module SinStarI.CharacterPresentation

Option Explicit

Import SinStarI.TitleScreen As TitleScreen
Import SinStarI.BackgroundMusic As BackgroundMusic
Import Smile.Tools.Character3DViewerWorkflow As Viewer
Import Smile.Tools.Character3DViewerProfiles As Profiles
Import SinStarI.StatsView As StatsView

Private Dim Preview As Viewer.Session
Private Dim Active As Boolean
Private Dim Heading As Text
Private Dim GrowthView As StatsView.State
Private Dim CharacterId As Number
Private Dim ShowStats As Boolean

Public Function IsPresentation(Action As TitleScreen.TitleAction) As Boolean

    Dim Result As Boolean

    Result = (Action = TitleScreen.TitleAction.Arin Or
        Action = TitleScreen.TitleAction.Orin Or Action = TitleScreen.TitleAction.Mira Or
        Action = TitleScreen.TitleAction.Zara Or Action = TitleScreen.TitleAction.Valor Or
        Action = TitleScreen.TitleAction.Yalis Or
        Action = TitleScreen.TitleAction.Kael Or Action = TitleScreen.TitleAction.KaelBattle Or
        Action = TitleScreen.TitleAction.Dragon Or Action = TitleScreen.TitleAction.Vrax Or
        Action = TitleScreen.TitleAction.DragonBattle Or Action = TitleScreen.TitleAction.VraxBattle)

    Return Result

End Function

Private Function TabFor(Action As TitleScreen.TitleAction) As Number

    Dim ReturnValue As Number

    Select Case Action
        Case TitleScreen.TitleAction.Orin
            Return 1
        Case TitleScreen.TitleAction.Mira
            ReturnValue = Profiles.CHARACTER_TAB_MIRA

            Return ReturnValue
        Case TitleScreen.TitleAction.Zara
            Return 5
        Case TitleScreen.TitleAction.Valor
            Return 4
        Case TitleScreen.TitleAction.Dragon
            Return 2
        Case TitleScreen.TitleAction.Vrax
            Return 6
        Case TitleScreen.TitleAction.Yalis
            ReturnValue = Profiles.CHARACTER_TAB_YALIS

            Return ReturnValue
        Case TitleScreen.TitleAction.Kael
            ReturnValue = Profiles.CHARACTER_TAB_KAEL

            Return ReturnValue
        Case TitleScreen.TitleAction.KaelBattle
            ReturnValue = Profiles.CHARACTER_TAB_PARTY_KAEL

            Return ReturnValue
        Case TitleScreen.TitleAction.DragonBattle
            ReturnValue = Profiles.CHARACTER_TAB_PARTY_DRAGON

            Return ReturnValue
        Case TitleScreen.TitleAction.VraxBattle
            ReturnValue = Profiles.CHARACTER_TAB_PARTY_VRAX

            Return ReturnValue
    End Select

    Return 0

End Function

Public Sub Enter(Action As TitleScreen.TitleAction)

    Dim CycleClips As Boolean

    If Active Then
        Call Shutdown()
    End If

    If Not Window_Loading() Then
        Return
    End If

    Preview = New Viewer.Session()
    Heading = TitleScreen.Label(Action)
    GrowthView.Visible = False
    ShowStats = True

    Select Case Action
        Case TitleScreen.TitleAction.Arin
            CharacterId = 0
        Case TitleScreen.TitleAction.Orin
            CharacterId = 1
        Case TitleScreen.TitleAction.Zara
            CharacterId = 2
        Case TitleScreen.TitleAction.Mira
            CharacterId = 3
        Case TitleScreen.TitleAction.Kael
            CharacterId = 4
        Case TitleScreen.TitleAction.Valor
            CharacterId = 5
        Case TitleScreen.TitleAction.Dragon
            CharacterId = 6
        Case TitleScreen.TitleAction.Vrax
            CharacterId = 7
        Case TitleScreen.TitleAction.Yalis
            CharacterId = 8
        Case Else
            ShowStats = False
    End Select

    CycleClips = (Action <> TitleScreen.TitleAction.DragonBattle And
        Action <> TitleScreen.TitleAction.KaelBattle And
        Action <> TitleScreen.TitleAction.VraxBattle)

    Call Preview.Start(TabFor(Action), True, Window_Width(), Window_Height(), CycleClips)
    Call Preview.UpdateFrame(Window_Width(), Window_Height())

    Active = True

    Select Case Action
        Case TitleScreen.TitleAction.Arin

            Call BackgroundMusic.SelectTrack("Bloom (Arin)")

        Case TitleScreen.TitleAction.Orin

            Call BackgroundMusic.SelectTrack("Starforge March (Orin)")

        Case TitleScreen.TitleAction.Mira

            Call BackgroundMusic.SelectTrack("Golden Hour Ascend (Mira)")

        Case TitleScreen.TitleAction.Kael

            Call BackgroundMusic.SelectTrack("Starforge Ascend (Kael)")

    End Select

End Sub

Public Function BackRequested(Key As Number) As Boolean

    Dim Result As Boolean

    If GrowthView.Visible Then
        Return False
    End If

    Result = (Key = KEY_ESCAPE Or
        (Pointer_Inside() And Pointer_Pressed(POINTER_PRIMARY) And
        Pointer_X() >= 20 And Pointer_X() < 115 And
        Pointer_Y() >= 20 And Pointer_Y() < 56))

    Return Result

End Function

Public Sub Update(Key As Number)

    If Not Active Then
        Return
    End If

    If GrowthView.Visible Then

        Call StatsView.Update(GrowthView, Key)
        Call Preview.UpdateFrame(Window_Width(), Window_Height())

        Return

    End If

    If (ShowStats And
        Pointer_Inside() And
        Pointer_Pressed(POINTER_PRIMARY) And
        Pointer_Y() >= 20 And
        Pointer_Y() < 56 And
        Pointer_X() >= Window_Width() - 260) Then
        Call StatsView.Open(GrowthView, CharacterId, Pointer_X() >= Window_Width() - 130)

        Return
    End If

    Call Preview.PresentationInput(Key)
    Call Preview.UpdateFrame(Window_Width(), Window_Height())

End Sub

Public Sub Draw()

    If Not Active Then
        Return
    End If

    Call Preview.DrawFrame()
    Call Preview.DrawViewportOverlay(0, 0, Window_Width(), Window_Height())
    Call Preview.DrawPresentationStatuses()

    Fill Rectangle 20, 20, 95, 36, Rgb(15, 35, 55)
    Draw Text "< Back" At 33, 28 Size 18 Color WHITE
    Draw Text Heading At 136, 23 Size 26 Color WHITE
    Draw Text Preview.PresentationCaption() At 136, 57 Size 16 Color CYAN
    Fill Rectangle 20, Window_Height() - 47, Window_Width() - 40, 29, Rgb(10, 20, 35)
    Draw Text "Drag: Pan   Middle Drag: Orbit   Wheel: Zoom   O: Auto Orbit   Space: Pause   F: Floor   G: Grid   B: Background   R: Reset   Esc: Back" At 30, Window_Height() - 40 Size 14 Color WHITE

    If ShowStats Then

        Fill Rectangle Window_Width() - 260, 20, 120, 36, Rgb(15, 55, 75) Opacity 80
        Fill Rectangle Window_Width() - 130, 20, 110, 36, Rgb(15, 55, 75) Opacity 80
        Draw Text "Stats Table" At Window_Width() - 251, 29 Size 15 Color WHITE
        Draw Text "Graphs" At Window_Width() - 106, 29 Size 15 Color WHITE

    End If

    If GrowthView.Visible Then
        Call StatsView.Draw(GrowthView)
    End If

End Sub

Public Sub Shutdown()

    If Active Then
        Call Preview.Release()
    End If

    Preview = Nothing
    Active = False

End Sub

End Module
