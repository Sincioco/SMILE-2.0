''' Sin Star I menus, title assets and music; scene resources stay with their owners.
Module SinStarI.TitleScreen

Option Explicit

Public Enum TitleAction
    None = 0
    Character = 1
    Town = 2
    Town2 = 3
    Shop = 4
    Dungeon = 5
    Battle = 6
    Arin = 7
    Orin = 8
    Mira = 9
    Zara = 10
    Valor = 11
    Dragon = 12
    Vrax = 13
    DragonBattle = 14
    VraxBattle = 15
    ExitGame = 16
    Yalis = 17
    Kael = 18
    KaelBattle = 19
End Enum

Private Enum MenuPage
    Main = 0
    Characters = 1
    Battles = 2
    Legacy = 3
End Enum

Private Dim TitleBackground As Image
Private Dim TitleLogo As Image
Private Dim MenuBackground As Image
Private Dim Page As MenuPage
Private Dim Selection As Number

Public Sub Initialize()

    Load Image TitleBackground From "Assets\Backgrounds\SinStarLandscape.png"
    Load Image TitleLogo From "Assets\Backgrounds\Sin Star I - Text.png"
    Load Image MenuBackground From "Assets\MenuBackground.png"

    Page = MenuPage.Main
    Selection = 0

    Call Enter()

End Sub

Public Sub Enter()

    Stop Music
    Play Music "Assets\Music\Starforge Horizon.mp3" Loop

End Sub

Public Sub Leave()

    Stop Music

End Sub

Public Sub Shutdown()

    Stop Music
    Unload Image MenuBackground
    Unload Image TitleLogo
    Unload Image TitleBackground

End Sub

Private Function ChoiceCount() As Number

    If Page = MenuPage.Characters Then
        Return 10
    Else If Page = MenuPage.Legacy Then
        Return 7
    Else If Page = MenuPage.Main Then
        Return 4
    End If

    Return 4

End Function

Private Function MenuTextSize() As Number

    Dim Result As Number

    Result = Max(16, Min(32, Window_Height() * 32 / 941))
    Return Result

End Function

Private Function RowHeight() As Number

    Dim Result As Number

    Result = Max(28, Window_Height() * 46 / 941)
    Return Result

End Function

Private Function MenuWidth() As Number

    Dim Result As Number
    Dim Index As Number

    For Index = 0 To ChoiceCount() - 1
        Result = Max(Result, Text_Width(ChoiceLabel(Index), MenuTextSize()))
    End For

    Result = Result + 42
    Return Result

End Function

Private Function MenuLeft() As Number

    Dim Result As Number

    Result = Window_Width() * 406 / 1672 - MenuWidth() / 2
    Return Result

End Function

Private Function MenuTop() As Number

    Dim Result As Number

    Result = Window_Height() * 545 / 941 - ChoiceCount() * RowHeight() / 2
    Return Result

End Function

Public Function Label(Action As TitleAction) As Text

    Select Case Action
        Case TitleAction.Character
            Return "Character Gallery"
        Case TitleAction.Town
            Return "Town"
        Case TitleAction.Town2
            Return "Town 2"
        Case TitleAction.Shop
            Return "Shop"
        Case TitleAction.Dungeon
            Return "Dungeon"
        Case TitleAction.Battle
            Return "Original Battle Preview"
        Case TitleAction.Arin
            Return "Arin"
        Case TitleAction.Orin
            Return "Orin"
        Case TitleAction.Mira
            Return "Mira"
        Case TitleAction.Zara
            Return "Zara"
        Case TitleAction.Valor
            Return "Valor"
        Case TitleAction.Dragon
            Return "Dragon"
        Case TitleAction.Vrax
            Return "Vrax"
        Case TitleAction.Yalis
            Return "Yalis"
        Case TitleAction.Kael
            Return "Kael"
        Case TitleAction.KaelBattle
            Return "Kael Party"
        Case TitleAction.DragonBattle
            Return "Dragon Battle"
        Case TitleAction.VraxBattle
            Return "Vrax Battle"
        Case TitleAction.ExitGame
            Return "Exit"
    End Select

    Return "Back"

End Function

Private Function ChoiceAction(Index As Number) As TitleAction

    If Page = MenuPage.Characters Then

        Select Case Index
            Case 0
                Return TitleAction.Arin
            Case 1
                Return TitleAction.Orin
            Case 2
                Return TitleAction.Mira
            Case 3
                Return TitleAction.Zara
            Case 4
                Return TitleAction.Valor
            Case 5
                Return TitleAction.Dragon
            Case 6
                Return TitleAction.Vrax
            Case 7
                Return TitleAction.Yalis
            Case 8
                Return TitleAction.Kael
        End Select

    Else If Page = MenuPage.Battles Then

        If Index = 0 Then
            Return TitleAction.DragonBattle
        Else If Index = 1 Then
            Return TitleAction.VraxBattle
        Else If Index = 2 Then
            Return TitleAction.KaelBattle
        End If

    Else If Page = MenuPage.Legacy Then

        Select Case Index
            Case 0
                Return TitleAction.Character
            Case 1
                Return TitleAction.Town
            Case 2
                Return TitleAction.Town2
            Case 3
                Return TitleAction.Shop
            Case 4
                Return TitleAction.Dungeon
            Case 5
                Return TitleAction.Battle
        End Select

    End If

    Return TitleAction.None

End Function

Private Sub BackToMain()

    If Page = MenuPage.Characters Then
        Selection = 0
    Else If Page = MenuPage.Battles Then
        Selection = 1
    Else
        Selection = 2
    End If

    Page = MenuPage.Main

End Sub

Public Function HandleInput(Key As Number) As TitleAction

    Dim Action As TitleAction
    Dim Confirm As Boolean
    Dim Index As Number
    Dim Y As Number

    Action = TitleAction.None
    Confirm = Key = KEY_ENTER Or Key = KEY_SPACE

    If Key = KEY_ESCAPE And Page <> MenuPage.Main Then
        Call BackToMain()

        Return Action
    End If

    If Key = KEY_UP Or Key = KEY_W Then
        Selection = (Selection + ChoiceCount() - 1) Mod ChoiceCount()
    Else If Key = KEY_DOWN Or Key = KEY_S Then
        Selection = (Selection + 1) Mod ChoiceCount()
    End If

    For Index = 0 To ChoiceCount() - 1

        Y = MenuTop() + Index * RowHeight()

        If (Pointer_Inside() And
            Pointer_Pressed(POINTER_PRIMARY) And
            Pointer_X() >= MenuLeft() And
            Pointer_X() < MenuLeft() + MenuWidth() And
            Pointer_Y() >= Y - 5 And
            Pointer_Y() < Y + RowHeight() - 5) Then
            Selection = Index
            Confirm = True
        End If

    End For

    If Confirm Then

        If Page = MenuPage.Main Then

            If Selection = 3 Then
                Return TitleAction.ExitGame
            Else If Selection = 0 Then
                Page = MenuPage.Characters
            Else If Selection = 1 Then
                Page = MenuPage.Battles
            Else
                Page = MenuPage.Legacy
            End If

            Selection = 0

        Else

            Action = ChoiceAction(Selection)

            If Action = TitleAction.None Then
                Call BackToMain()
            End If

        End If

    End If

    Return Action

End Function

Private Function ChoiceLabel(Index As Number) As Text

    Dim Result As Text

    Result = Label(ChoiceAction(Index))

    If Page = MenuPage.Main Then

        Select Case Index
            Case 0
                Result = "Characters"
            Case 1
                Result = "Battle Simulations"
            Case 2
                Result = "Legacy"
            Case 3
                Result = "Exit"
        End Select

    Else If Page = MenuPage.Battles Then

        If Index = 0 Then
            Result = "Dragon"
        Else If Index = 1 Then
            Result = "Vrax"
        End If

    End If

    Return Result

End Function

Public Sub Draw()

    Dim Index As Number
    Dim Heading As Text
    Dim Y As Number
    Dim X As Number
    Dim Top As Number
    Dim LogoWidth As Number
    Dim LogoHeight As Number
    Dim CreditSize As Number
    Dim CreditCenter As Number

    X = MenuLeft()
    Top = MenuTop()
    LogoWidth = Window_Width() * 725 / 1672
    LogoHeight = LogoWidth * Image_Height(TitleLogo) / Max(1, Image_Width(TitleLogo))
    CreditSize = Max(9, Min(12, Window_Height() * 12 / 941))
    CreditCenter = Window_Width() * 406 / 1672

    If Page = MenuPage.Characters Then
        Heading = "Characters"
    Else If Page = MenuPage.Battles Then
        Heading = "Battle Simulations"
    Else If Page = MenuPage.Legacy Then
        Heading = "Legacy"
    End If

    Clear Rgb(4, 8, 20)
    Draw Image TitleBackground At 0, 0 Size Window_Width() By Window_Height() Filter Smooth
    Draw Image TitleLogo At Window_Width() * 40 / 1672, Window_Height() * 125 / 941 - LogoHeight / 2 Size LogoWidth By LogoHeight Filter Smooth

    If Page <> MenuPage.Main Then
        Draw Text Heading At CreditCenter, Window_Height() * 227 / 941 Size MenuTextSize() Color WHITE Centered
    End If

    For Index = 0 To ChoiceCount() - 1

        Y = Top + Index * RowHeight()

        If Selection = Index Then
            Draw Image MenuBackground At X, Y - 4 Size MenuWidth() By RowHeight() Opacity 75 Filter Smooth
            Draw Text ">" At X + 5, Y Size MenuTextSize() Color CYAN
        End If

        Draw Text ChoiceLabel(Index) At X + 32, Y Size MenuTextSize() Color WHITE
    End For

    Draw Image MenuBackground At Window_Width() * 43 / 1672, Window_Height() * 868 / 941 Size Window_Width() * 725 / 1672 By Window_Height() * 59 / 941 Opacity 70 Filter Smooth
    Draw Text "Programmed by: Louiery R. Sincioco - August 16, 2026." At CreditCenter, Window_Height() * 881 / 941 Size CreditSize Color Rgb(160, 174, 193) Centered
    Draw Text "Copyright (c) 2026. All rights reserved." At CreditCenter, Window_Height() * 901 / 941 Size CreditSize Color Rgb(160, 174, 193) Centered

End Sub

End Module
