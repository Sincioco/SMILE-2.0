' SMILE 2.0 Falling Blocks - all puzzle rules live in SMILE.
Const CanvasWidth = 960
Const CanvasHeight = 540
Const BoardWidth = 10
Const BoardHeight = 20
Const CellSize = 22
Const BoardX = 370
Const BoardY = 50
Const TitleDemoDelay = 5000
Const DemoMinimumPlayTime = 30000
Const DemoMaximumPlayTime = 45000
Const TitleInputArmDelay = 250
Const DemoActionInterval = 180
Const DemoPieceStartDelay = 350
Const DemoDropPause = 500
Const DemoFallDelay = 180
Const RowClearFlashDuration = 140
Const TetrisFlashDuration = 220
Const RowCollapseDuration = 140
Const TetrisCollapseDuration = 180

Dim Board[BoardWidth, BoardHeight]
Dim ShapeX[7, 4]
Dim ShapeY[7, 4]
Dim CandidateHeights[BoardWidth]
Dim ClearingRows[BoardHeight]

' Seven four-cell shapes in a 4 by 4 rotation box.
ShapeX[0, 0] = 0
ShapeY[0, 0] = 1
ShapeX[0, 1] = 1
ShapeY[0, 1] = 1
ShapeX[0, 2] = 2
ShapeY[0, 2] = 1
ShapeX[0, 3] = 3
ShapeY[0, 3] = 1

ShapeX[1, 0] = 1
ShapeY[1, 0] = 1
ShapeX[1, 1] = 2
ShapeY[1, 1] = 1
ShapeX[1, 2] = 1
ShapeY[1, 2] = 2
ShapeX[1, 3] = 2
ShapeY[1, 3] = 2

ShapeX[2, 0] = 1
ShapeY[2, 0] = 0
ShapeX[2, 1] = 0
ShapeY[2, 1] = 1
ShapeX[2, 2] = 1
ShapeY[2, 2] = 1
ShapeX[2, 3] = 2
ShapeY[2, 3] = 1

ShapeX[3, 0] = 1
ShapeY[3, 0] = 0
ShapeX[3, 1] = 2
ShapeY[3, 1] = 0
ShapeX[3, 2] = 0
ShapeY[3, 2] = 1
ShapeX[3, 3] = 1
ShapeY[3, 3] = 1

ShapeX[4, 0] = 0
ShapeY[4, 0] = 0
ShapeX[4, 1] = 1
ShapeY[4, 1] = 0
ShapeX[4, 2] = 1
ShapeY[4, 2] = 1
ShapeX[4, 3] = 2
ShapeY[4, 3] = 1

ShapeX[5, 0] = 0
ShapeY[5, 0] = 0
ShapeX[5, 1] = 0
ShapeY[5, 1] = 1
ShapeX[5, 2] = 1
ShapeY[5, 2] = 1
ShapeX[5, 3] = 2
ShapeY[5, 3] = 1

ShapeX[6, 0] = 2
ShapeY[6, 0] = 0
ShapeX[6, 1] = 0
ShapeY[6, 1] = 1
ShapeX[6, 2] = 1
ShapeY[6, 2] = 1
ShapeX[6, 3] = 2
ShapeY[6, 3] = 1

CurrentPiece = 1
NextPiece = 1
PieceX = 3
PieceY = -1
Rotation = 0
Score = 0
Lines = 0
Level = 1
FallDelay = 700
NextFallTime = 0
State = 0
Key = KEY_NONE
Row = 0
Column = 0
Cell = 0
Cleared = 0
FullRow = False
DemoMode = False
TitleStartedAt = 0
TitleAcceptInputAt = 0
DemoStartedAt = 0
NextDemoActionAt = 0
PlannedRotation = 0
PlannedX = 3
CandidateRotation = 0
CandidateXPosition = 0
CandidateDropY = 0
DemoPlanAligned = False
DemoPieceSequence = 0
DemoUseNaturalFall = True
ClearPhase = 0
ClearPhaseStartedAt = 0
ClearFlashDuration = 0
ClearCollapseDuration = 0
PendingClearCount = 0

Load HighScore From "HighScore" Default 0

Function BlockX(PieceValue, RotationValue, CellValue)

    CalcX = ShapeX[PieceValue - 1, CellValue]
    CalcY = ShapeY[PieceValue - 1, CellValue]

    For Turn = 1 To RotationValue
        RotatedX = 3 - CalcY
        CalcY = CalcX
        CalcX = RotatedX

    End For
    Return CalcX

End Function

Function BlockY(PieceValue, RotationValue, CellValue)

    CalcX = ShapeX[PieceValue - 1, CellValue]
    CalcY = ShapeY[PieceValue - 1, CellValue]

    For Turn = 1 To RotationValue
        RotatedX = 3 - CalcY
        CalcY = CalcX
        CalcX = RotatedX

    End For
    Return CalcY

End Function

Function PieceColor(PieceValue)

    Dim ReturnValue As Number

    Select Case PieceValue
        Case 1
            ReturnValue = Rgb(35, 220, 235)
            Return ReturnValue
        Case 2
            ReturnValue = Rgb(245, 215, 45)
            Return ReturnValue
        Case 3
            ReturnValue = Rgb(180, 70, 235)
            Return ReturnValue
        Case 4
            ReturnValue = Rgb(70, 220, 95)
            Return ReturnValue
        Case 5
            ReturnValue = Rgb(240, 65, 70)
            Return ReturnValue
        Case 6
            ReturnValue = Rgb(55, 105, 235)
            Return ReturnValue
        Case Else
            ReturnValue = Rgb(245, 145, 35)
            Return ReturnValue
    End Select
End Function

Function CanMove(OffsetX, OffsetY, TestRotation)

    For TestCell = 0 To 3
        TestX = PieceX + OffsetX + BlockX(CurrentPiece, TestRotation, TestCell)
        TestY = PieceY + OffsetY + BlockY(CurrentPiece, TestRotation, TestCell)

        If TestX < 0 Or TestX >= BoardWidth Or TestY >= BoardHeight Then
            Return False
        End If

        If TestY >= 0 Then

            If Board[TestX, TestY] <> 0 Then
                Return False
            End If

        End If

    End For
    Return True

End Function

Sub ClearBoard()

    For ClearY = 0 To BoardHeight - 1
        ClearingRows[ClearY] = 0

        For ClearX = 0 To BoardWidth - 1
            Board[ClearX, ClearY] = 0

        End For

    End For
    ClearPhase = 0
    PendingClearCount = 0

End Sub

Function CandidateCanFit(PositionX, PositionY)

    For CandidateCell = 0 To 3
        CandidateBlockX = PositionX + BlockX(CurrentPiece, CandidateRotation, CandidateCell)
        CandidateBlockY = PositionY + BlockY(CurrentPiece, CandidateRotation, CandidateCell)

        If CandidateBlockX < 0 Or CandidateBlockX >= BoardWidth Or CandidateBlockY >= BoardHeight Then
            Return False
        End If

        If CandidateBlockY >= 0 And Board[CandidateBlockX, CandidateBlockY] <> 0 Then
            Return False
        End If

    End For
    Return True

End Function

Function FindDropY(PositionX)

    Dim ReturnValue As Number

    DropTestY = -4

    If CandidateCanFit(PositionX, DropTestY) = False Then
        ReturnValue = -99
        Return ReturnValue
    End If

    Do

        If CandidateCanFit(PositionX, DropTestY + 1) = True Then
            DropTestY = DropTestY + 1
        Else
            Exit Do
        End If

    Loop

    Return DropTestY

End Function

Function CandidateCellFilled(TestColumn, TestRow)

    If Board[TestColumn, TestRow] <> 0 Then
        Return True
    End If

    For CandidateCell = 0 To 3
        CandidateBlockX = CandidateXPosition + BlockX(CurrentPiece, CandidateRotation, CandidateCell)
        CandidateBlockY = CandidateDropY + BlockY(CurrentPiece, CandidateRotation, CandidateCell)

        If CandidateBlockX = TestColumn And CandidateBlockY = TestRow Then
            Return True
        End If

    End For
    Return False

End Function

Function EvaluateCandidate()

    Dim ReturnValue As Number

    CompletedCandidateRows = 0
    CandidateHoles = 0
    CandidateMaximumHeight = 0
    CandidateAggregateHeight = 0
    CandidateBumpiness = 0

    For EvaluateRow = 0 To BoardHeight - 1
        CandidateRowFull = True

        For EvaluateColumn = 0 To BoardWidth - 1

            If CandidateCellFilled(EvaluateColumn, EvaluateRow) = False Then
                CandidateRowFull = False
            End If

        End For

        If CandidateRowFull = True Then
            CompletedCandidateRows = CompletedCandidateRows + 1
        End If

    End For

    For EvaluateColumn = 0 To BoardWidth - 1
        CandidateSeenBlock = False
        CandidateHeight = 0

        For EvaluateRow = 0 To BoardHeight - 1

            If CandidateCellFilled(EvaluateColumn, EvaluateRow) = True Then

                If CandidateSeenBlock = False Then
                    CandidateSeenBlock = True
                    CandidateHeight = BoardHeight - EvaluateRow
                End If

            Else If CandidateSeenBlock = True Then
                CandidateHoles = CandidateHoles + 1
            End If

        End For
        CandidateHeights[EvaluateColumn] = CandidateHeight
        CandidateAggregateHeight = CandidateAggregateHeight + CandidateHeight
        CandidateMaximumHeight = Max(CandidateMaximumHeight, CandidateHeight)

    End For

    For EvaluateColumn = 0 To BoardWidth - 2
        CandidateBumpiness = CandidateBumpiness + Abs(CandidateHeights[EvaluateColumn] - CandidateHeights[EvaluateColumn + 1])

    End For

    CandidateCenterPenalty = Abs((CandidateXPosition + 2) * 2 - BoardWidth)
    ReturnValue = CompletedCandidateRows * 10000 - CandidateHoles * 800 - CandidateMaximumHeight * 80 - CandidateAggregateHeight * 10 - CandidateBumpiness * 20 - CandidateCenterPenalty * 2
    Return ReturnValue

End Function

Sub PlanDemoPiece()

    BestCandidateScore = -999999999
    PlannedRotation = 0
    PlannedX = PieceX
    DemoPlanAligned = False

    For PlanRotation = 0 To 3
        CandidateRotation = PlanRotation

        For PlanX = -3 To BoardWidth - 1
            PlanDropY = FindDropY(PlanX)
            CandidateAboveTop = False

            If PlanDropY > -99 Then

                For PlanCell = 0 To 3

                    If PlanDropY + BlockY(CurrentPiece, PlanRotation, PlanCell) < 0 Then
                        CandidateAboveTop = True
                    End If

                End For

                If CandidateAboveTop = False Then
                    CandidateXPosition = PlanX
                    CandidateDropY = PlanDropY
                    CandidateScore = EvaluateCandidate()

                    If CandidateScore > BestCandidateScore Then
                        BestCandidateScore = CandidateScore
                        PlannedRotation = PlanRotation
                        PlannedX = PlanX
                    End If

                End If

            End If

        End For

    End For
    NextDemoActionAt = Timer() + DemoPieceStartDelay

End Sub

Sub ExecuteDemoPlan()

    If Timer() < NextDemoActionAt Or State <> 1 Then
        Return
    End If

    If Rotation <> PlannedRotation Then
        NewRotation = (Rotation + 1) Mod 4

        If CanMove(0, 0, NewRotation) = True Then
            Rotation = NewRotation
            Play Sound "Assets\Rotate.wav"
        Else
            Call PlanDemoPiece()

        End If

    Else If PieceX < PlannedX Then

        If CanMove(1, 0, Rotation) = True Then
            PieceX = PieceX + 1
            Play Sound "Assets\Move.wav"
        Else
            Call PlanDemoPiece()

        End If

    Else If PieceX > PlannedX Then

        If CanMove(-1, 0, Rotation) = True Then
            PieceX = PieceX - 1
            Play Sound "Assets\Move.wav"
        Else
            Call PlanDemoPiece()

        End If

    Else

        If DemoUseNaturalFall = True Then

            If DemoPlanAligned = False Then
                DemoPlanAligned = True
                NextFallTime = Timer() + DemoFallDelay
            End If

        Else

            If DemoPlanAligned = False Then
                DemoPlanAligned = True
                NextDemoActionAt = Timer() + DemoDropPause
                Return
            Else

                Do

                    If CanMove(0, 1, Rotation) = True Then
                        PieceY = PieceY + 1
                    Else
                        Exit Do
                    End If

                Loop

                Call LockPiece()

            End If

        End If

    End If

    NextDemoActionAt = Timer() + DemoActionInterval

End Sub

Sub EndGame()

    If DemoMode = True And Timer() - DemoStartedAt < DemoMinimumPlayTime Then
        Call ClearBoard()

        Lines = 0
        Level = 1
        FallDelay = DemoFallDelay
        State = 1
        Call SpawnPiece()

        Return
    End If

    If DemoMode = True Then
        Call EnterTitle()

        Return
    End If

    State = 2
    Stop Music

    If DemoMode = False And Score > HighScore Then
        HighScore = Score
        Save HighScore To "HighScore"
    End If

    Play Sound "Assets\GameOver.wav"

End Sub

Sub SpawnPiece()

    CurrentPiece = NextPiece
    Random NextPiece From 1 To 7
    PieceX = 3
    PieceY = -1
    Rotation = 0
    NextFallTime = Timer() + FallDelay

    If CanMove(0, 0, Rotation) = False Then
        Call EndGame()

        Return
    End If

    If State = 1 And DemoMode = True Then
        DemoPieceSequence = DemoPieceSequence + 1
        DemoUseNaturalFall = DemoPieceSequence Mod 4 = 0
        Call PlanDemoPiece()

    End If

End Sub

Sub BeginRowClear()

    PendingClearCount = 0

    For Row = 0 To BoardHeight - 1
        ClearingRows[Row] = 0
        FullRow = True

        For Column = 0 To BoardWidth - 1

            If Board[Column, Row] = 0 Then
                FullRow = False
            End If

        End For

        If FullRow = True Then
            ClearingRows[Row] = 1
            PendingClearCount = PendingClearCount + 1
        End If

    End For

    If PendingClearCount > 0 Then
        ClearPhase = 1
        ClearPhaseStartedAt = Timer()

        If PendingClearCount >= 4 Then
            ClearFlashDuration = TetrisFlashDuration
            ClearCollapseDuration = TetrisCollapseDuration
            Play Sound "Assets\Tetris.wav"
        Else
            ClearFlashDuration = RowClearFlashDuration
            ClearCollapseDuration = RowCollapseDuration
            Play Sound "Assets\LineClear.wav"
        End If

    End If

End Sub

Sub CompleteRowClear()

    WriteRow = BoardHeight - 1

    For ReadRow = BoardHeight - 1 Down To 0

        If ClearingRows[ReadRow] = 0 Then

            For Column = 0 To BoardWidth - 1
                Board[Column, WriteRow] = Board[Column, ReadRow]

            End For
            WriteRow = WriteRow - 1
        End If

    End For

    For ClearY = WriteRow Down To 0

        For Column = 0 To BoardWidth - 1
            Board[Column, ClearY] = 0

        End For

    End For

    Select Case PendingClearCount
            Case 1
                Score = Score + 100 * Level
            Case 2
                Score = Score + 300 * Level
            Case 3
                Score = Score + 500 * Level
            Case Else
                Score = Score + 800 * Level
    End Select
    Lines = Lines + PendingClearCount
    Level = Lines / 10 + 1

    If DemoMode = True Then
        FallDelay = DemoFallDelay
    Else
        FallDelay = Max(80, 700 - (Level - 1) * 60)
    End If

    For Row = 0 To BoardHeight - 1
        ClearingRows[Row] = 0

    End For
    ClearPhase = 0
    PendingClearCount = 0
    Call SpawnPiece()

End Sub

Sub UpdateRowClear()

    If ClearPhase = 1 And Timer() - ClearPhaseStartedAt >= ClearFlashDuration Then
        ClearPhase = 2
        ClearPhaseStartedAt = Timer()
    Else If ClearPhase = 2 And Timer() - ClearPhaseStartedAt >= ClearCollapseDuration Then
        Call CompleteRowClear()

    End If

End Sub

Sub LockPiece()

    For Cell = 0 To 3
        LockX = PieceX + BlockX(CurrentPiece, Rotation, Cell)
        LockY = PieceY + BlockY(CurrentPiece, Rotation, Cell)

        If LockY < 0 Then
            Call EndGame()

            Return
        Else
            Board[LockX, LockY] = CurrentPiece
        End If

    End For

    If State = 1 Then
        Call BeginRowClear()

        If ClearPhase = 0 Then
            Call SpawnPiece()

        End If

    End If

End Sub

Sub ResetPlay()

    Call ClearBoard()

    Score = 0
    Lines = 0
    Level = 1
    FallDelay = 700
    Random NextPiece From 1 To 7
    State = 1
    Play Music "Assets\Background.mp3" Loop
    Call SpawnPiece()

End Sub

Sub DrainPendingKeys()

    For DrainIndex = 1 To 64
        Get Key DrainedKey

    End For

End Sub

Sub EnterTitle()

    Stop Music
    DemoMode = False
    State = 0
    Key = KEY_NONE
    Call DrainPendingKeys()

    TitleStartedAt = Timer()
    TitleAcceptInputAt = TitleStartedAt + TitleInputArmDelay

End Sub

Sub ResetGame()

    DemoMode = False
    Call ResetPlay()

End Sub

Sub StartDemo()

    DemoMode = True
    DemoStartedAt = Timer()
    DemoPieceSequence = 0
    DemoUseNaturalFall = True
    Call ResetPlay()

    FallDelay = DemoFallDelay
    NextFallTime = Timer() + FallDelay

End Sub

Sub DrawBlock(PixelX, PixelY, BlockSize, BlockColor)

    Fill Rectangle PixelX + 1, PixelY + 1, BlockSize - 2, BlockSize - 2, BlockColor
    Draw Rectangle PixelX + 1, PixelY + 1, BlockSize - 2, BlockSize - 2, Rgb(245, 245, 255)

End Sub

Sub DrawGame()

    Clear Rgb(8, 12, 22)
    Draw Text "Falling" At 175, 62 Size 36 Color CYAN Centered
    Draw Text "Blocks" At 175, 102 Size 36 Color MAGENTA Centered
    Draw Text "Next" At 175, 175 Size 20 Color LIGHT_GRAY Centered

    For Cell = 0 To 3
        Call DrawBlock(125 + BlockX(NextPiece, 0, Cell) * 18, 205 + BlockY(NextPiece, 0, Cell) * 18, 18, PieceColor(NextPiece))

    End For

    Draw Text "A / D   Move" At 175, 340 Size 15 Color WHITE Centered
    Draw Text "W / Up  Rotate" At 175, 365 Size 15 Color WHITE Centered
    Draw Text "S / Down  Drop" At 175, 390 Size 15 Color WHITE Centered
    Draw Text "Space  Hard Drop" At 175, 415 Size 15 Color WHITE Centered
    Draw Text "Escape  Exit" At 175, 455 Size 15 Color LIGHT_GRAY Centered

    Fill Rectangle BoardX, BoardY, BoardWidth * CellSize, BoardHeight * CellSize, BLACK
    Draw Rectangle BoardX, BoardY, BoardWidth * CellSize, BoardHeight * CellSize, Rgb(80, 90, 115)

    For Row = 0 To BoardHeight - 1

        For Column = 0 To BoardWidth - 1
            Draw Rectangle BoardX + Column * CellSize, BoardY + Row * CellSize, CellSize, CellSize, Rgb(24, 30, 45)

            If Board[Column, Row] <> 0 And ClearPhase <> 2 Then

                If ClearPhase = 1 And ClearingRows[Row] = 1 Then

                    If PendingClearCount >= 4 Then
                        Call DrawBlock(BoardX + Column * CellSize, BoardY + Row * CellSize, CellSize, YELLOW)

                    Else
                        Call DrawBlock(BoardX + Column * CellSize, BoardY + Row * CellSize, CellSize, WHITE)

                    End If

                Else
                    Call DrawBlock(BoardX + Column * CellSize, BoardY + Row * CellSize, CellSize, PieceColor(Board[Column, Row]))

                End If

            End If

        End For

    End For

    If ClearPhase = 2 Then
        CollapseElapsed = Min(ClearCollapseDuration, Timer() - ClearPhaseStartedAt)

        For Row = 0 To BoardHeight - 1

            If ClearingRows[Row] = 0 Then
                DropRows = 0

                For CheckRow = 0 To BoardHeight - 1

                    If CheckRow > Row And ClearingRows[CheckRow] = 1 Then
                        DropRows = DropRows + 1
                    End If

                End For
                AnimatedDrop = DropRows * CellSize * CollapseElapsed / ClearCollapseDuration

                For Column = 0 To BoardWidth - 1

                    If Board[Column, Row] <> 0 Then
                        Call DrawBlock(BoardX + Column * CellSize, BoardY + Row * CellSize + AnimatedDrop, CellSize, PieceColor(Board[Column, Row]))

                    End If

                End For
            End If

        End For
    End If

    If State = 1 And ClearPhase = 0 Then

        For Cell = 0 To 3
            ActiveX = PieceX + BlockX(CurrentPiece, Rotation, Cell)
            ActiveY = PieceY + BlockY(CurrentPiece, Rotation, Cell)

            If ActiveY >= 0 Then
                Call DrawBlock(BoardX + ActiveX * CellSize, BoardY + ActiveY * CellSize, CellSize, PieceColor(CurrentPiece))

            End If

        End For
    End If

    Draw Text "Score" At 610, 75 Size 20 Color LIGHT_GRAY
    Draw Number Score At 610, 102 Size 34 Color YELLOW
    Draw Text "High Score" At 610, 175 Size 20 Color LIGHT_GRAY
    Draw Number HighScore At 610, 202 Size 34 Color CYAN
    Draw Text "Level" At 610, 285 Size 20 Color LIGHT_GRAY
    Draw Number Level At 610, 312 Size 34 Color LIGHT_GREEN
    Draw Text "Lines" At 610, 385 Size 20 Color LIGHT_GRAY
    Draw Number Lines At 610, 412 Size 34 Color WHITE

    If DemoMode = True And State = 1 Then
        Fill Rounded Rectangle 620, 460, 290, 58, 8, Rgb(17, 24, 42)
        Draw Rounded Rectangle 620, 460, 290, 58, 8, CYAN
        Draw Text "Demo" At 765, 468 Size 18 Color YELLOW Centered
        Draw Text "Press Any Key To Return" At 765, 494 Size 11 Color WHITE Centered
    End If

End Sub

Sub DrawTitle()

    Clear Rgb(8, 12, 22)
    Draw Text "Falling Blocks" At 480, 125 Size 54 Color CYAN Centered
    Call DrawBlock(386, 210, 30, Rgb(35, 220, 235))
    Call DrawBlock(416, 210, 30, Rgb(245, 215, 45))
    Call DrawBlock(446, 210, 30, Rgb(180, 70, 235))
    Call DrawBlock(476, 210, 30, Rgb(70, 220, 95))
    Call DrawBlock(506, 210, 30, Rgb(240, 65, 70))
    Call DrawBlock(536, 210, 30, Rgb(55, 105, 235))

    Draw Text "Press Enter To Start" At 480, 315 Size 28 Color YELLOW Centered
    Draw Text "Stack Pieces And Clear Complete Rows" At 480, 365 Size 18 Color WHITE Centered
    Draw Text "Escape To Exit" At 480, 410 Size 18 Color LIGHT_GRAY Centered
    Draw Text "High Score" At 480, 455 Size 18 Color LIGHT_GRAY Centered
    Draw Number HighScore At 455, 480 Size 30 Color CYAN

End Sub

Sub DrawGameOver()

    Fill Rounded Rectangle 245, 145, 470, 270, 22, Rgb(17, 24, 42)
    Draw Rounded Rectangle 245, 145, 470, 270, 22, RED
    Draw Text "Game Over" At 480, 190 Size 48 Color RED Centered
    Draw Text "Score" At 380, 260 Size 20 Color LIGHT_GRAY
    Draw Number Score At 520, 250 Size 36 Color YELLOW
    Draw Text "Enter To Retry" At 480, 335 Size 24 Color WHITE Centered
    Draw Text "Escape To Exit" At 480, 375 Size 18 Color LIGHT_GRAY Centered

End Sub

Game Window "SMILE 2.0 Falling Blocks"

Call EnterTitle()

Do
    Get Key Key

    If DemoMode = True And Key <> KEY_NONE Then
        Call EnterTitle()

        Key = KEY_NONE
    End If

    If State = 0 Then

        If Key <> KEY_NONE And Timer() >= TitleAcceptInputAt Then
            TitleStartedAt = Timer()

            If Key = KEY_ESCAPE Then
                Stop Sound
                End Program
            Else If Key = KEY_ENTER Then
                Call ResetGame()

            End If

        End If

        If State = 0 And Timer() - TitleStartedAt >= TitleDemoDelay Then
            Call StartDemo()

        End If

    Else If DemoMode = False And Key = KEY_ESCAPE Then
        Stop Music
        Stop Sound
        End Program
    End If

    If State = 0 Then
        Call DrawTitle()

    Else If State = 1 Then

        If DemoMode = True And Timer() - DemoStartedAt >= DemoMaximumPlayTime Then
            Call EnterTitle()

        End If

        If State = 1 And ClearPhase > 0 Then
            Call UpdateRowClear()

        Else If State = 1 Then

            If DemoMode = True Then
                Call ExecuteDemoPlan()

            Else

                If Key = KEY_A Or Key = KEY_LEFT Then

                    If CanMove(-1, 0, Rotation) = True Then
                        PieceX = PieceX - 1
                        Play Sound "Assets\Move.wav"
                    End If

                Else If Key = KEY_D Or Key = KEY_RIGHT Then

                    If CanMove(1, 0, Rotation) = True Then
                        PieceX = PieceX + 1
                        Play Sound "Assets\Move.wav"
                    End If

                Else If Key = KEY_W Or Key = KEY_UP Then
                    NewRotation = (Rotation + 1) Mod 4

                    If CanMove(0, 0, NewRotation) = True Then
                        Rotation = NewRotation
                        Play Sound "Assets\Rotate.wav"
                    End If

                Else If Key = KEY_S Or Key = KEY_DOWN Then

                    If CanMove(0, 1, Rotation) = True Then
                        PieceY = PieceY + 1
                    Else
                        Call LockPiece()

                    End If

                    NextFallTime = Timer() + FallDelay
                Else If Key = KEY_SPACE Then

                    Do

                        If CanMove(0, 1, Rotation) = True Then
                            PieceY = PieceY + 1
                        Else
                            Exit Do
                        End If

                    Loop

                    Call LockPiece()

                End If

            End If

            If State = 1 And Timer() >= NextFallTime And (DemoMode = False Or DemoPlanAligned = True) Then

                If CanMove(0, 1, Rotation) = True Then
                    PieceY = PieceY + 1
                Else
                    Call LockPiece()

                End If

                NextFallTime = Timer() + FallDelay
            End If

        End If

        Call DrawGame()

        If State = 2 Then
            Call DrawGameOver()

        End If

    Else

        If Key = KEY_ENTER Then
            Call ResetGame()

        End If

        If State = 0 Then
            Call DrawTitle()

        Else
            Call DrawGame()

            If State = 2 Then
                Call DrawGameOver()

            End If

        End If

    End If

    Show Screen

Loop Until Game_Closed() = True

Stop Music
Stop Sound
End Program
