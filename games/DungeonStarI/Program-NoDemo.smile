' Dungeon Star I - student edition without attract/demo code.

' -----------------------------------------------------------------------------
' Constants
' -----------------------------------------------------------------------------

Const STATE_TITLE = 0
Const STATE_USER_DUNGEON = 1

Const ACTION_IDLE = 0
Const ACTION_MOVE_FORWARD = 1
Const ACTION_MOVE_BACKWARD = 2
Const ACTION_TURN_LEFT = 3
Const ACTION_TURN_RIGHT = 4
Const ACTION_OPEN_DOOR = 5
Const ACTION_STAIRS_OUT = 6
Const ACTION_STAIRS_IN = 7

Const NORTH = 0
Const EAST = 1
Const SOUTH = 2
Const WEST = 3

Const MapWidth = 31
Const MapHeight = 31
Const FloorCount = 3
Const CellsPerFloor = MapWidth * MapHeight
Const TotalCells = CellsPerFloor * FloorCount
Const MaximumGenerationAttempts = 8
Const MapFileCapacity = 16384

Const MAP_DEFAULT = 0
Const MAP_LOOPS = 1
Const MAP_SWITCHBACKS = 2
Const MAP_RANDOM = 3

Const TILE_WALL = 0
Const TILE_FLOOR = 1
Const TILE_DOOR_CLOSED = 2
Const TILE_DOOR_OPEN = 3
Const TILE_STAIRS_UP = 4
Const TILE_STAIRS_DOWN = 5

Const FlashInterval = 500
Const MapFallbackMessageDuration = 3500

Const UserIdleWarningTime = 30000
Const UserIdleExitTime = 40000
Const UserIdleCountdownStart = 9

Const MoveDuration = 260
Const TurnDuration = 240
Const DoorDuration = 320
Const StairOutDuration = 450
Const StairBlackDuration = 120
Const StairInDuration = 450

Const ProjectionDepth = 6

' -----------------------------------------------------------------------------
' Fixed data
' -----------------------------------------------------------------------------

Dim Dungeon[TotalCells]
Dim MapFileBytes[MapFileCapacity]
Dim ParsedRows[FloorCount]
Dim ParsedUpCount[FloorCount]
Dim ParsedDownCount[FloorCount]

Dim FloorStartX[FloorCount]
Dim FloorStartY[FloorCount]
Dim StairUpX[FloorCount]
Dim StairUpY[FloorCount]
Dim StairDownX[FloorCount]
Dim StairDownY[FloorCount]

Dim FloodQueue[CellsPerFloor]
Dim FloodVisited[CellsPerFloor]

Dim DirectionX[4]
Dim DirectionY[4]

Dim BaseHalfWidth[7]
Dim BaseTopY[7]
Dim BaseBottomY[7]
Dim ViewHalfWidth[7]
Dim ViewTopY[7]
Dim ViewBottomY[7]

DirectionX[NORTH] = 0
DirectionY[NORTH] = -1
DirectionX[EAST] = 1
DirectionY[EAST] = 0
DirectionX[SOUTH] = 0
DirectionY[SOUTH] = 1
DirectionX[WEST] = -1
DirectionY[WEST] = 0

BaseHalfWidth[0] = 720
BaseHalfWidth[1] = 360
BaseHalfWidth[2] = 225
BaseHalfWidth[3] = 140
BaseHalfWidth[4] = 86
BaseHalfWidth[5] = 50
BaseHalfWidth[6] = 28

BaseTopY[0] = -120
BaseTopY[1] = 45
BaseTopY[2] = 125
BaseTopY[3] = 180
BaseTopY[4] = 218
BaseTopY[5] = 242
BaseTopY[6] = 256

BaseBottomY[0] = 660
BaseBottomY[1] = 495
BaseBottomY[2] = 415
BaseBottomY[3] = 360
BaseBottomY[4] = 322
BaseBottomY[5] = 298
BaseBottomY[6] = 284

StairUpX[0] = -1
StairUpY[0] = -1
StairDownX[0] = -1
StairDownY[0] = -1
StairUpX[1] = -1
StairUpY[1] = -1
StairDownX[1] = -1
StairDownY[1] = -1
StairUpX[2] = -1
StairUpY[2] = -1
StairDownX[2] = -1
StairDownY[2] = -1

' -----------------------------------------------------------------------------
' Shared game state
' -----------------------------------------------------------------------------

ScreenState = STATE_TITLE
CurrentFloor = 0

PlayerX = 1
PlayerY = 1
PlayerDirection = NORTH
PlayerStartX = 1
PlayerStartY = 1

ActionState = ACTION_IDLE
ActionStartedAt = 0
ActionProgress = 0
TargetX = 1
TargetY = 1
TargetDirection = NORTH
DoorX = -1
DoorY = -1
PendingMoveStep = 0
StairDestinationFloor = 0
StairDestinationX = 1
StairDestinationY = 1
StairStage = 0
StairSuppressed = 0

Now = 0
Key = KEY_NONE
BufferedKey = KEY_NONE
LastUserActivityAt = 0
IdleElapsed = 0
IdleCountdown = 0
SelectedMap = MAP_DEFAULT
MapFileLength = 0
MapLoadValid = False
MapStartCount = 0
CurrentParsedFloor = -1
NextFloorHeader = 0
PlayerStartFloor = 0
PlayerStartDirection = SOUTH
MapFallbackUsed = False
MapFallbackMessageUntil = 0
CurrentGenerationFloor = 0
GenerationValid = False

WallNearColor = Rgb(22, 118, 78)
WallMidColor = Rgb(16, 82, 57)
WallFarColor = Rgb(11, 50, 39)
MortarColor = Rgb(55, 190, 125)
DungeonFloorColor = Rgb(7, 28, 21)
CeilingColor = Rgb(5, 20, 15)
DoorColor = Rgb(22, 75, 52)
HighlightColor = Rgb(100, 225, 160)

RenderDirection = NORTH
RenderScale = 1000
RenderOffset = 0
VisibleSections = 1
FrontBlockTile = TILE_WALL
DoorDrawProgress = 0

'----------------------------------------------------------------------------------------------------

' -----------------------------------------------------------------------------
' Native game entry and continuous VSync-paced loop
' -----------------------------------------------------------------------------

Game Window "SMILE 2.0 Dungeon Star I"

Call EnterTitle()

Do
    Now = Timer()
    Get Key Key

    If ScreenState = STATE_TITLE Then

        Call UpdateTitle()

        If ScreenState = STATE_TITLE Then
            Call DrawTitle()
        Else
            Call DrawDungeonScene()
        End If

    Else

        Call UpdateUserDungeon()

        If ScreenState = STATE_TITLE Then
            Call DrawTitle()
        Else
            Call DrawDungeonScene()
            Call DrawIdleWarning()
        End If

    End If

    Show Screen

Loop Until Game_Closed() = True

Stop Music

'----------------------------------------------------------------------------------------------------

' -----------------------------------------------------------------------------
' Bounds-aware map and coordinate helpers
' -----------------------------------------------------------------------------

Function MapIndex(FloorValue, XValue, YValue)

    Dim ReturnValue As Number

    ReturnValue = FloorValue * CellsPerFloor + YValue * MapWidth + XValue
    Return ReturnValue

End Function

Function GetTile(FloorValue, XValue, YValue)

    Dim ReturnValue As Number

    If FloorValue < 0 Or FloorValue >= FloorCount Then
        ReturnValue = TILE_WALL
        Return ReturnValue
    End If

    If (XValue < 0 Or
        XValue >= MapWidth Or
        YValue < 0 Or
        YValue >= MapHeight) Then
        ReturnValue = TILE_WALL
        Return ReturnValue
    End If

    ReturnValue = Dungeon[MapIndex(FloorValue, XValue, YValue)]
    Return ReturnValue

End Function

Sub SetTile(FloorValue, XValue, YValue, TileValue)

    If (FloorValue >= 0 And
        FloorValue < FloorCount And
        XValue > 0 And
        XValue < MapWidth - 1 And
        YValue > 0 And
        YValue < MapHeight - 1) Then
        Dungeon[MapIndex(FloorValue, XValue, YValue)] = TileValue
    End If

End Sub

Function IsWalkable(TileValue)

    Dim ReturnValue As Boolean

    ReturnValue = TileValue <> TILE_WALL
    Return ReturnValue

End Function

Function BlocksSight(TileValue)

    Dim ReturnValue As Boolean

    ReturnValue = TileValue = TILE_WALL Or TileValue = TILE_DOOR_CLOSED
    Return ReturnValue

End Function

Function WorldX(SideValue, ForwardValue, DirectionValue)

    Dim ReturnValue As Number

    If DirectionValue = NORTH Then
        ReturnValue = PlayerX + SideValue
        Return ReturnValue
    Else If DirectionValue = EAST Then
        ReturnValue = PlayerX + ForwardValue
        Return ReturnValue
    Else If DirectionValue = SOUTH Then
        ReturnValue = PlayerX - SideValue
        Return ReturnValue
    Else
        ReturnValue = PlayerX - ForwardValue
        Return ReturnValue
    End If

End Function

Function WorldY(SideValue, ForwardValue, DirectionValue)

    Dim ReturnValue As Number

    If DirectionValue = NORTH Then
        ReturnValue = PlayerY - ForwardValue
        Return ReturnValue
    Else If DirectionValue = EAST Then
        ReturnValue = PlayerY + SideValue
        Return ReturnValue
    Else If DirectionValue = SOUTH Then
        ReturnValue = PlayerY + ForwardValue
        Return ReturnValue
    Else
        ReturnValue = PlayerY - SideValue
        Return ReturnValue
    End If

End Function

' -----------------------------------------------------------------------------
' Map metadata, pipe generation, and validation
' -----------------------------------------------------------------------------

Sub ResetDungeonMetadata()

    For MetadataFloor = 0 To FloorCount - 1

        FloorStartX[MetadataFloor] = 1
        FloorStartY[MetadataFloor] = 1
        StairUpX[MetadataFloor] = -1
        StairUpY[MetadataFloor] = -1
        StairDownX[MetadataFloor] = -1
        StairDownY[MetadataFloor] = -1
        ParsedRows[MetadataFloor] = 0
        ParsedUpCount[MetadataFloor] = 0
        ParsedDownCount[MetadataFloor] = 0
    End For
    PlayerStartFloor = 0
    PlayerStartX = 1
    PlayerStartY = 1

    PlayerStartDirection = SOUTH
    MapStartCount = 0

End Sub

Sub FillFloorWithWalls(FloorValue)

    For FillY = 0 To MapHeight - 1

        For FillX = 0 To MapWidth - 1
            Dungeon[MapIndex(FloorValue, FillX, FillY)] = TILE_WALL
        End For
    End For

End Sub

Sub CarveHorizontal(YValue, X1, X2)

    StartX = Min(X1, X2)
    EndX = Max(X1, X2)

    For CorridorX = StartX To EndX
        Call SetTile(CurrentGenerationFloor, CorridorX, YValue, TILE_FLOOR)
    End For

End Sub

Sub CarveVertical(XValue, Y1, Y2)

    StartY = Min(Y1, Y2)
    EndY = Max(Y1, Y2)

    For CorridorY = StartY To EndY
        Call SetTile(CurrentGenerationFloor, XValue, CorridorY, TILE_FLOOR)
    End For

End Sub

Sub PlacePipeStairs(FloorValue)

    If FloorValue = 0 Then

        StairDownX[0] = 25
        StairDownY[0] = 25

        Call SetTile(0, 25, 25, TILE_STAIRS_DOWN)

    Else If FloorValue = 1 Then

        StairUpX[1] = 5
        StairUpY[1] = 5
        StairDownX[1] = 25
        StairDownY[1] = 25

        Call SetTile(1, 5, 5, TILE_STAIRS_UP)
        Call SetTile(1, 25, 25, TILE_STAIRS_DOWN)

    Else

        StairUpX[2] = 5
        StairUpY[2] = 5

        Call SetTile(2, 5, 5, TILE_STAIRS_UP)

    End If

End Sub

Sub PlacePipeDoors(FloorValue)

    Call SetTile(FloorValue, 10, 5, TILE_DOOR_CLOSED)
    Call SetTile(FloorValue, 25, 10, TILE_DOOR_CLOSED)
    Call SetTile(FloorValue, 20, 25, TILE_DOOR_CLOSED)
    Call SetTile(FloorValue, 5, 20, TILE_DOOR_CLOSED)

End Sub

Function DoorHasClearRun(FloorValue, DoorTestX, DoorTestY, HorizontalValue)

    For DoorDistance = 1 To 4

        If HorizontalValue = 1 Then

            LeftRunTile = GetTile(FloorValue, DoorTestX - DoorDistance, DoorTestY)
            RightRunTile = GetTile(FloorValue, DoorTestX + DoorDistance, DoorTestY)

            If LeftRunTile <> TILE_FLOOR Or RightRunTile <> TILE_FLOOR Then
                Return False
            End If

            If (GetTile(FloorValue, DoorTestX - DoorDistance, DoorTestY - 1) <> TILE_WALL Or
                GetTile(FloorValue, DoorTestX - DoorDistance, DoorTestY + 1) <> TILE_WALL) Then
                Return False
            End If

            If (GetTile(FloorValue, DoorTestX + DoorDistance, DoorTestY - 1) <> TILE_WALL Or
                GetTile(FloorValue, DoorTestX + DoorDistance, DoorTestY + 1) <> TILE_WALL) Then
                Return False
            End If

        Else

            UpRunTile = GetTile(FloorValue, DoorTestX, DoorTestY - DoorDistance)
            DownRunTile = GetTile(FloorValue, DoorTestX, DoorTestY + DoorDistance)

            If UpRunTile <> TILE_FLOOR Or DownRunTile <> TILE_FLOOR Then
                Return False
            End If

            If (GetTile(FloorValue, DoorTestX - 1, DoorTestY - DoorDistance) <> TILE_WALL Or
                GetTile(FloorValue, DoorTestX + 1, DoorTestY - DoorDistance) <> TILE_WALL) Then
                Return False
            End If

            If (GetTile(FloorValue, DoorTestX - 1, DoorTestY + DoorDistance) <> TILE_WALL Or
                GetTile(FloorValue, DoorTestX + 1, DoorTestY + DoorDistance) <> TILE_WALL) Then
                Return False
            End If

        End If

    End For
    Return True

End Function

Sub ValidateFloor(FloorValue)

    For BorderX = 0 To MapWidth - 1

        If (GetTile(FloorValue, BorderX, 0) <> TILE_WALL Or
            GetTile(FloorValue, BorderX, MapHeight - 1) <> TILE_WALL) Then
            GenerationValid = False

        End If

    End For

    For BorderY = 0 To MapHeight - 1

        If (GetTile(FloorValue, 0, BorderY) <> TILE_WALL Or
            GetTile(FloorValue, MapWidth - 1, BorderY) <> TILE_WALL) Then
            GenerationValid = False

        End If

    End For

    AnchorX = FloorStartX[FloorValue]
    AnchorY = FloorStartY[FloorValue]

    If (AnchorX < 1 Or
        AnchorX >= MapWidth - 1 Or
        AnchorY < 1 Or
        AnchorY >= MapHeight - 1) Then

        GenerationValid = False
        AnchorX = 1
        AnchorY = 1

    End If

    If IsWalkable(GetTile(FloorValue, AnchorX, AnchorY)) = False Then
        GenerationValid = False
    End If

    For ClearIndex = 0 To CellsPerFloor - 1
        FloodVisited[ClearIndex] = 0
    End For

    FloodHead = 0
    FloodTail = 0
    FloodStart = AnchorY * MapWidth + AnchorX
    FloodQueue[FloodTail] = FloodStart
    FloodTail = FloodTail + 1
    FloodVisited[FloodStart] = 1

    Do
        FloodCell = FloodQueue[FloodHead]
        FloodHead = FloodHead + 1
        FloodX = FloodCell Mod MapWidth
        FloodY = FloodCell / MapWidth

        For FloodDirection = 0 To 3

            FloodNextX = FloodX + DirectionX[FloodDirection]
            FloodNextY = FloodY + DirectionY[FloodDirection]

            If (FloodNextX > 0 And
                FloodNextX < MapWidth - 1 And
                FloodNextY > 0 And
                FloodNextY < MapHeight - 1) Then

                FloodNext = FloodNextY * MapWidth + FloodNextX

                If (FloodVisited[FloodNext] = 0 And
                    IsWalkable(GetTile(FloorValue, FloodNextX, FloodNextY)) = True) Then

                    FloodVisited[FloodNext] = 1
                    FloodQueue[FloodTail] = FloodNext
                    FloodTail = FloodTail + 1

                End If
            End If

        End For

    Loop Until FloodHead >= FloodTail

    WalkableCount = 0
    VisitedCount = 0

    For ValidateY = 0 To MapHeight - 1

        For ValidateX = 0 To MapWidth - 1

            ValidateCell = ValidateY * MapWidth + ValidateX

            If IsWalkable(GetTile(FloorValue, ValidateX, ValidateY)) = True Then

                WalkableCount = WalkableCount + 1

                If FloodVisited[ValidateCell] = 1 Then
                    VisitedCount = VisitedCount + 1
                End If

            End If

        End For
    End For

    If WalkableCount = 0 Or VisitedCount <> WalkableCount Then
        GenerationValid = False
    End If

    For SquareY = 0 To MapHeight - 2

        For SquareX = 0 To MapWidth - 2

            OpenSquare = IsWalkable(GetTile(FloorValue, SquareX, SquareY)) And IsWalkable(GetTile(FloorValue, SquareX + 1, SquareY)) And IsWalkable(GetTile(FloorValue, SquareX, SquareY + 1)) And IsWalkable(GetTile(FloorValue, SquareX + 1, SquareY + 1))

            If OpenSquare = True Then
                GenerationValid = False
            End If

        End For
    End For

    For ValidateY = 1 To MapHeight - 2

        For ValidateX = 1 To MapWidth - 2

            ValidateTile = GetTile(FloorValue, ValidateX, ValidateY)

            If ValidateTile = TILE_DOOR_CLOSED Or ValidateTile = TILE_DOOR_OPEN Then

                ValidHorizontal = IsWalkable(GetTile(FloorValue, ValidateX - 1, ValidateY)) And IsWalkable(GetTile(FloorValue, ValidateX + 1, ValidateY)) And GetTile(FloorValue, ValidateX, ValidateY - 1) = TILE_WALL And GetTile(FloorValue, ValidateX, ValidateY + 1) = TILE_WALL
                ValidVertical = IsWalkable(GetTile(FloorValue, ValidateX, ValidateY - 1)) And IsWalkable(GetTile(FloorValue, ValidateX, ValidateY + 1)) And GetTile(FloorValue, ValidateX - 1, ValidateY) = TILE_WALL And GetTile(FloorValue, ValidateX + 1, ValidateY) = TILE_WALL

                If ValidHorizontal = ValidVertical Then

                    GenerationValid = False

                Else If ValidHorizontal = True Then

                    If DoorHasClearRun(FloorValue, ValidateX, ValidateY, 1) = False Then
                        GenerationValid = False
                    End If

                Else If DoorHasClearRun(FloorValue, ValidateX, ValidateY, 0) = False Then

                    GenerationValid = False

                End If

            End If

        End For
    End For

End Sub

Sub ValidateDungeon()

    GenerationValid = True

    For ValidateFloorValue = 0 To FloorCount - 1
        Call ValidateFloor(ValidateFloorValue)
    End For

    For StairFloor = 0 To FloorCount - 1

        CountedUp = 0
        CountedDown = 0

        For StairY = 1 To MapHeight - 2

            For StairX = 1 To MapWidth - 2

                If GetTile(StairFloor, StairX, StairY) = TILE_STAIRS_UP Then
                    CountedUp = CountedUp + 1
                Else If GetTile(StairFloor, StairX, StairY) = TILE_STAIRS_DOWN Then
                    CountedDown = CountedDown + 1
                End If

            End For
        End For

        If StairFloor = 0 And (CountedUp <> 0 Or CountedDown <> 1) Then
            GenerationValid = False
        Else If StairFloor = 1 And (CountedUp <> 1 Or CountedDown <> 1) Then
            GenerationValid = False
        Else If StairFloor = 2 And (CountedUp <> 1 Or CountedDown <> 0) Then
            GenerationValid = False
        End If

    End For

    If (MapStartCount <> 1 Or
        PlayerStartFloor < 0 Or
        PlayerStartFloor >= FloorCount) Then

        GenerationValid = False
    Else
        StartTile = GetTile(PlayerStartFloor, PlayerStartX, PlayerStartY)
        ForwardX = PlayerStartX + DirectionX[PlayerStartDirection]
        ForwardY = PlayerStartY + DirectionY[PlayerStartDirection]
        BackwardDirection = (PlayerStartDirection + 2) Mod 4
        BackwardX = PlayerStartX + DirectionX[BackwardDirection]
        BackwardY = PlayerStartY + DirectionY[BackwardDirection]
        LeftDirection = (PlayerStartDirection + 3) Mod 4
        RightDirection = (PlayerStartDirection + 1) Mod 4

        If (StartTile <> TILE_FLOOR Or
            IsWalkable(GetTile(PlayerStartFloor, ForwardX, ForwardY)) = False Or
            IsWalkable(GetTile(PlayerStartFloor, BackwardX, BackwardY)) = False) Then
            GenerationValid = False
        End If

        If (GetTile(PlayerStartFloor, PlayerStartX + DirectionX[LeftDirection], PlayerStartY + DirectionY[LeftDirection]) <> TILE_WALL Or
            GetTile(PlayerStartFloor, PlayerStartX + DirectionX[RightDirection], PlayerStartY + DirectionY[RightDirection]) <> TILE_WALL) Then
            GenerationValid = False
        End If
    End If

End Sub

Sub PrepareGeneratedFloor(FloorValue)

    FloorStartX[FloorValue] = 5
    FloorStartY[FloorValue] = 5

    If FloorValue = 0 Then

        FloorStartX[0] = 5
        FloorStartY[0] = 10
        PlayerStartFloor = 0
        PlayerStartX = 5
        PlayerStartY = 10
        PlayerStartDirection = SOUTH

    End If

    Call PlacePipeDoors(FloorValue)
    Call PlacePipeStairs(FloorValue)

End Sub

Sub BuildRandomFloor(FloorValue)

    CurrentGenerationFloor = FloorValue

    Call FillFloorWithWalls(FloorValue)

    Call CarveHorizontal(5, 5, 25)
    Call CarveHorizontal(25, 5, 25)
    Call CarveVertical(5, 5, 25)
    Call CarveVertical(25, 5, 25)

    Random PipePattern From 0 To 3

    If PipePattern = 0 Then
        Call CarveHorizontal(15, 5, 25)
        Call CarveVertical(15, 5, 15)
    Else If PipePattern = 1 Then
        Call CarveVertical(15, 5, 25)
        Call CarveHorizontal(15, 5, 15)
    Else If PipePattern = 2 Then
        Call CarveHorizontal(15, 5, 25)
        Call CarveVertical(15, 5, 25)
    Else
        Call CarveHorizontal(15, 5, 25)
        Call CarveVertical(15, 15, 25)
    End If

    Call PrepareGeneratedFloor(FloorValue)

    GenerationValid = True

    Call ValidateFloor(FloorValue)

End Sub

Sub BuildFallbackFloor(FloorValue)

    CurrentGenerationFloor = FloorValue

    Call FillFloorWithWalls(FloorValue)
    Call CarveHorizontal(5, 5, 25)
    Call CarveHorizontal(15, 5, 25)
    Call CarveHorizontal(25, 5, 25)
    Call CarveVertical(5, 5, 25)
    Call CarveVertical(15, 5, 25)
    Call CarveVertical(25, 5, 25)
    Call PrepareGeneratedFloor(FloorValue)

    GenerationValid = True

    Call ValidateFloor(FloorValue)

End Sub

Sub GenerateFloor(FloorValue)

    GenerationValid = False

    For GenerationAttempt = 1 To MaximumGenerationAttempts

        Call BuildRandomFloor(FloorValue)

        If GenerationValid = True Then
            Exit For
        End If

    End For

    If GenerationValid = False Then
        Call BuildFallbackFloor(FloorValue)
    End If

End Sub

Sub GenerateAllFloors()

    Call ResetDungeonMetadata()

    MapStartCount = 1

    For GenerateFloorValue = 0 To FloorCount - 1
        Call GenerateFloor(GenerateFloorValue)
    End For

    Call ValidateDungeon()

    If GenerationValid = False Then

        Call ResetDungeonMetadata()

        MapStartCount = 1

        For GenerateFloorValue = 0 To FloorCount - 1
            Call BuildFallbackFloor(GenerateFloorValue)
        End For

        Call ValidateDungeon()

    End If

End Sub

' -----------------------------------------------------------------------------
' External text-map parsing. All interpretation remains in SMILE source.
' -----------------------------------------------------------------------------

Sub ProcessMapLine(LineStart, LineLength)

    If MapLoadValid = False Then
        Return
    End If

    If LineLength > 0 And MapFileBytes[LineStart + LineLength - 1] = 13 Then
        LineLength = LineLength - 1
    End If

    If LineLength = 0 Then
        Return
    End If

    If MapFileBytes[LineStart] = 59 Then
        Return
    End If

    IsHeader = LineLength = 9 And MapFileBytes[LineStart] = 91 And MapFileBytes[LineStart + 1] = 70 And MapFileBytes[LineStart + 2] = 76 And MapFileBytes[LineStart + 3] = 79 And MapFileBytes[LineStart + 4] = 79 And MapFileBytes[LineStart + 5] = 82 And MapFileBytes[LineStart + 6] = 32 And MapFileBytes[LineStart + 8] = 93

    If IsHeader = True Then

        HeaderFloor = MapFileBytes[LineStart + 7] - 49

        If (HeaderFloor < 0 Or
            HeaderFloor >= FloorCount Or
            HeaderFloor <> NextFloorHeader) Then
            MapLoadValid = False
            Return
        End If

        If CurrentParsedFloor >= 0 And ParsedRows[CurrentParsedFloor] <> MapHeight Then
            MapLoadValid = False
            Return
        End If

        CurrentParsedFloor = HeaderFloor
        NextFloorHeader = NextFloorHeader + 1
        Return

    End If

    If (CurrentParsedFloor < 0 Or
        CurrentParsedFloor >= FloorCount Or
        LineLength <> MapWidth Or
        ParsedRows[CurrentParsedFloor] >= MapHeight) Then
        MapLoadValid = False
        Return

    End If

    ParsedY = ParsedRows[CurrentParsedFloor]

    For ParsedX = 0 To MapWidth - 1

        MapByte = MapFileBytes[LineStart + ParsedX]
        ParsedTile = TILE_WALL

        If MapByte = 35 Then

            ParsedTile = TILE_WALL

        Else If MapByte = 46 Then

            ParsedTile = TILE_FLOOR

        Else If MapByte = 68 Then

            ParsedTile = TILE_DOOR_CLOSED

        Else If MapByte = 79 Then

            ParsedTile = TILE_DOOR_OPEN

        Else If MapByte = 85 Then

            ParsedTile = TILE_STAIRS_UP
            ParsedUpCount[CurrentParsedFloor] = ParsedUpCount[CurrentParsedFloor] + 1
            StairUpX[CurrentParsedFloor] = ParsedX
            StairUpY[CurrentParsedFloor] = ParsedY

        Else If MapByte = 86 Then

            ParsedTile = TILE_STAIRS_DOWN
            ParsedDownCount[CurrentParsedFloor] = ParsedDownCount[CurrentParsedFloor] + 1
            StairDownX[CurrentParsedFloor] = ParsedX
            StairDownY[CurrentParsedFloor] = ParsedY

        Else If (MapByte = 78 Or
            MapByte = 69 Or
            MapByte = 83 Or
            MapByte = 87) Then

            ParsedTile = TILE_FLOOR
            MapStartCount = MapStartCount + 1
            PlayerStartFloor = CurrentParsedFloor
            PlayerStartX = ParsedX
            PlayerStartY = ParsedY

            If MapByte = 78 Then
                PlayerStartDirection = NORTH
            Else If MapByte = 69 Then
                PlayerStartDirection = EAST
            Else If MapByte = 83 Then
                PlayerStartDirection = SOUTH
            Else
                PlayerStartDirection = WEST
            End If

        Else

            MapLoadValid = False

        End If

        Dungeon[MapIndex(CurrentParsedFloor, ParsedX, ParsedY)] = ParsedTile
    End For
    ParsedRows[CurrentParsedFloor] = ParsedRows[CurrentParsedFloor] + 1

End Sub

Sub ParseLoadedMap()

    Call ResetDungeonMetadata()

    For ClearFloor = 0 To FloorCount - 1
        Call FillFloorWithWalls(ClearFloor)
    End For
    MapLoadValid = MapFileLength > 0
    CurrentParsedFloor = -1
    NextFloorHeader = 0

    If MapLoadValid = True Then

        LineStart = 0

        For ByteIndex = 0 To MapFileLength - 1

            If MapFileBytes[ByteIndex] = 10 Then
                Call ProcessMapLine(LineStart, ByteIndex - LineStart)

                LineStart = ByteIndex + 1
            End If

        End For

        If LineStart < MapFileLength Then
            Call ProcessMapLine(LineStart, MapFileLength - LineStart)
        End If

    End If

    If NextFloorHeader <> FloorCount Or CurrentParsedFloor <> FloorCount - 1 Then
        MapLoadValid = False
    End If

    For ParsedFloor = 0 To FloorCount - 1

        If ParsedRows[ParsedFloor] <> MapHeight Then
            MapLoadValid = False
        End If

    End For

    If (MapStartCount <> 1 Or
        ParsedUpCount[0] <> 0 Or
        ParsedDownCount[0] <> 1 Or
        ParsedUpCount[1] <> 1 Or
        ParsedDownCount[1] <> 1 Or
        ParsedUpCount[2] <> 1 Or
        ParsedDownCount[2] <> 0) Then
        MapLoadValid = False
    End If

    If MapLoadValid = True Then

        FloorStartX[0] = StairDownX[0]
        FloorStartY[0] = StairDownY[0]
        FloorStartX[1] = StairUpX[1]
        FloorStartY[1] = StairUpY[1]
        FloorStartX[2] = StairUpX[2]

        FloorStartY[2] = StairUpY[2]
        FloorStartX[PlayerStartFloor] = PlayerStartX
        FloorStartY[PlayerStartFloor] = PlayerStartY

        Call ValidateDungeon()

        MapLoadValid = GenerationValid

    End If

End Sub

Sub LoadDefaultMap()

    Load Text File "Maps\default.map" Into MapFileBytes Count MapFileLength

    Call ParseLoadedMap()

End Sub

Sub LoadLoopsMap()

    Load Text File "Maps\sample-loops.map" Into MapFileBytes Count MapFileLength

    Call ParseLoadedMap()

End Sub

Sub LoadSwitchbacksMap()

    Load Text File "Maps\sample-switchbacks.map" Into MapFileBytes Count MapFileLength

    Call ParseLoadedMap()

End Sub

Sub BuildSelectedDungeon()

    MapFallbackUsed = False

    If SelectedMap = MAP_RANDOM Then
        Call GenerateAllFloors()

        Return
    End If

    If SelectedMap = MAP_DEFAULT Then
        Call LoadDefaultMap()
    Else If SelectedMap = MAP_LOOPS Then
        Call LoadLoopsMap()
    Else
        Call LoadSwitchbacksMap()
    End If

    If MapLoadValid = False Then

        Call GenerateAllFloors()

        MapFallbackUsed = True
        MapFallbackMessageUntil = Timer() + MapFallbackMessageDuration

    End If

End Sub

' -----------------------------------------------------------------------------
' Floor palettes and projection helpers
' -----------------------------------------------------------------------------

Sub SelectPalette()

    If CurrentFloor = 0 Then

        WallNearColor = Rgb(22, 118, 78)
        WallMidColor = Rgb(16, 82, 57)
        WallFarColor = Rgb(11, 50, 39)
        MortarColor = Rgb(55, 190, 125)
        DungeonFloorColor = Rgb(7, 28, 21)
        CeilingColor = Rgb(5, 20, 15)
        DoorColor = Rgb(22, 75, 52)
        HighlightColor = Rgb(100, 225, 160)

    Else If CurrentFloor = 1 Then

        WallNearColor = Rgb(28, 80, 150)
        WallMidColor = Rgb(20, 58, 112)
        WallFarColor = Rgb(12, 36, 72)
        MortarColor = Rgb(90, 155, 225)
        DungeonFloorColor = Rgb(6, 18, 38)
        CeilingColor = Rgb(5, 12, 28)
        DoorColor = Rgb(25, 55, 100)
        HighlightColor = Rgb(135, 190, 255)

    Else

        WallNearColor = Rgb(145, 48, 45)
        WallMidColor = Rgb(102, 32, 35)
        WallFarColor = Rgb(62, 20, 25)
        MortarColor = Rgb(230, 105, 85)
        DungeonFloorColor = Rgb(35, 8, 12)
        CeilingColor = Rgb(24, 5, 8)
        DoorColor = Rgb(95, 32, 28)
        HighlightColor = Rgb(255, 145, 120)

    End If

End Sub

Function WallColorForDepth(DepthValue)

    If DepthValue <= 1 Then
        Return WallNearColor
    Else If DepthValue <= 3 Then
        Return WallMidColor
    Else
        Return WallFarColor
    End If

End Function

Sub PrepareProjection()

    For ProjectionIndex = 0 To ProjectionDepth

        ViewHalfWidth[ProjectionIndex] = BaseHalfWidth[ProjectionIndex]
        ViewTopY[ProjectionIndex] = BaseTopY[ProjectionIndex]
        ViewBottomY[ProjectionIndex] = BaseBottomY[ProjectionIndex]

        If ActionState = ACTION_MOVE_FORWARD Then

            ProjectionTarget = Max(0, ProjectionIndex - 1)
            ViewHalfWidth[ProjectionIndex] = BaseHalfWidth[ProjectionIndex] + (BaseHalfWidth[ProjectionTarget] - BaseHalfWidth[ProjectionIndex]) * ActionProgress / 1000
            ViewTopY[ProjectionIndex] = BaseTopY[ProjectionIndex] + (BaseTopY[ProjectionTarget] - BaseTopY[ProjectionIndex]) * ActionProgress / 1000
            ViewBottomY[ProjectionIndex] = BaseBottomY[ProjectionIndex] + (BaseBottomY[ProjectionTarget] - BaseBottomY[ProjectionIndex]) * ActionProgress / 1000

        Else If ActionState = ACTION_MOVE_BACKWARD Then

            ProjectionTarget = Min(ProjectionDepth, ProjectionIndex + 1)
            ViewHalfWidth[ProjectionIndex] = BaseHalfWidth[ProjectionIndex] + (BaseHalfWidth[ProjectionTarget] - BaseHalfWidth[ProjectionIndex]) * ActionProgress / 1000
            ViewTopY[ProjectionIndex] = BaseTopY[ProjectionIndex] + (BaseTopY[ProjectionTarget] - BaseTopY[ProjectionIndex]) * ActionProgress / 1000
            ViewBottomY[ProjectionIndex] = BaseBottomY[ProjectionIndex] + (BaseBottomY[ProjectionTarget] - BaseBottomY[ProjectionIndex]) * ActionProgress / 1000

        End If

    End For

End Sub

Function ProjectLeftX(SideValue, DepthValue)

    Dim ReturnValue As Number

    RawX = 480 + (2 * SideValue - 1) * ViewHalfWidth[DepthValue]
    ReturnValue = 480 + (RawX - 480) * RenderScale / 1000 + RenderOffset
    Return ReturnValue

End Function

Function ProjectRightX(SideValue, DepthValue)

    Dim ReturnValue As Number

    RawX = 480 + (2 * SideValue + 1) * ViewHalfWidth[DepthValue]
    ReturnValue = 480 + (RawX - 480) * RenderScale / 1000 + RenderOffset
    Return ReturnValue

End Function

' -----------------------------------------------------------------------------
' Pseudo-3D wall, door, stair, and scene drawing
' -----------------------------------------------------------------------------

Sub DrawLeftWall(SideValue, DepthValue, FaceColor)

    NearLeft = ProjectLeftX(SideValue, DepthValue)
    FarLeft = ProjectLeftX(SideValue, DepthValue + 1)
    Fill Quadrilateral NearLeft, ViewTopY[DepthValue], FarLeft, ViewTopY[DepthValue + 1], FarLeft, ViewBottomY[DepthValue + 1], NearLeft, ViewBottomY[DepthValue], FaceColor
    Draw Quadrilateral NearLeft, ViewTopY[DepthValue], FarLeft, ViewTopY[DepthValue + 1], FarLeft, ViewBottomY[DepthValue + 1], NearLeft, ViewBottomY[DepthValue], MortarColor
    Draw Line NearLeft, 270, FarLeft, 270, MortarColor

End Sub

Sub DrawRightWall(SideValue, DepthValue, FaceColor)

    NearRight = ProjectRightX(SideValue, DepthValue)
    FarRight = ProjectRightX(SideValue, DepthValue + 1)
    Fill Quadrilateral FarRight, ViewTopY[DepthValue + 1], NearRight, ViewTopY[DepthValue], NearRight, ViewBottomY[DepthValue], FarRight, ViewBottomY[DepthValue + 1], FaceColor
    Draw Quadrilateral FarRight, ViewTopY[DepthValue + 1], NearRight, ViewTopY[DepthValue], NearRight, ViewBottomY[DepthValue], FarRight, ViewBottomY[DepthValue + 1], MortarColor
    Draw Line FarRight, 270, NearRight, 270, MortarColor

End Sub

Sub DrawFrontWall(DepthValue, FaceColor)

    FrontLeft = ProjectLeftX(0, DepthValue)
    FrontRight = ProjectRightX(0, DepthValue)
    Fill Quadrilateral FrontLeft, ViewTopY[DepthValue], FrontRight, ViewTopY[DepthValue], FrontRight, ViewBottomY[DepthValue], FrontLeft, ViewBottomY[DepthValue], FaceColor
    Draw Quadrilateral FrontLeft, ViewTopY[DepthValue], FrontRight, ViewTopY[DepthValue], FrontRight, ViewBottomY[DepthValue], FrontLeft, ViewBottomY[DepthValue], MortarColor
    Draw Line FrontLeft, 270, FrontRight, 270, MortarColor

    If DepthValue <= 3 Then
        Draw Line 480, ViewTopY[DepthValue], 480, ViewBottomY[DepthValue], MortarColor
    End If

End Sub

Sub DrawDoorPanel(DepthValue, ProgressValue)

    DoorLeft = ProjectLeftX(0, DepthValue)
    DoorRight = ProjectRightX(0, DepthValue)
    DoorTop = ViewTopY[DepthValue]
    DoorBottom = ViewBottomY[DepthValue]
    DoorWidth = DoorRight - DoorLeft
    DoorInsetX = Max(2, DoorWidth / 12)
    DoorInsetY = Max(2, (DoorBottom - DoorTop) / 12)
    DoorCenter = (DoorLeft + DoorRight) / 2
    DoorOpening = DoorWidth * ProgressValue / 2000

    Fill Quadrilateral DoorLeft, DoorTop, DoorRight, DoorTop, DoorRight - DoorInsetX, DoorTop + DoorInsetY, DoorLeft + DoorInsetX, DoorTop + DoorInsetY, MortarColor
    Fill Quadrilateral DoorLeft, DoorTop, DoorLeft + DoorInsetX, DoorTop + DoorInsetY, DoorLeft + DoorInsetX, DoorBottom - DoorInsetY, DoorLeft, DoorBottom, MortarColor
    Fill Quadrilateral DoorRight - DoorInsetX, DoorTop + DoorInsetY, DoorRight, DoorTop, DoorRight, DoorBottom, DoorRight - DoorInsetX, DoorBottom - DoorInsetY, MortarColor

    If ProgressValue < 1000 Then

        Fill Quadrilateral DoorLeft + DoorInsetX - DoorOpening, DoorTop + DoorInsetY, DoorCenter - DoorOpening, DoorTop + DoorInsetY, DoorCenter - DoorOpening, DoorBottom - DoorInsetY, DoorLeft + DoorInsetX - DoorOpening, DoorBottom - DoorInsetY, DoorColor
        Fill Quadrilateral DoorCenter + DoorOpening, DoorTop + DoorInsetY, DoorRight - DoorInsetX + DoorOpening, DoorTop + DoorInsetY, DoorRight - DoorInsetX + DoorOpening, DoorBottom - DoorInsetY, DoorCenter + DoorOpening, DoorBottom - DoorInsetY, DoorColor
        Draw Line DoorCenter - DoorOpening, DoorTop + DoorInsetY, DoorCenter - DoorOpening, DoorBottom - DoorInsetY, HighlightColor
        Draw Line DoorCenter + DoorOpening, DoorTop + DoorInsetY, DoorCenter + DoorOpening, DoorBottom - DoorInsetY, HighlightColor

    End If

End Sub

Sub DrawOpenDoorFrame(DepthValue)

    FrameLeft = ProjectLeftX(0, DepthValue)
    FrameRight = ProjectRightX(0, DepthValue)
    Draw Line FrameLeft, ViewTopY[DepthValue], FrameLeft, ViewBottomY[DepthValue], HighlightColor
    Draw Line FrameRight, ViewTopY[DepthValue], FrameRight, ViewBottomY[DepthValue], HighlightColor
    Draw Line FrameLeft, ViewTopY[DepthValue], FrameRight, ViewTopY[DepthValue], HighlightColor

End Sub

Sub DrawStairs(DepthValue, StairTile)

    StairNearLeft = ProjectLeftX(0, DepthValue)
    StairNearRight = ProjectRightX(0, DepthValue)
    StairFarLeft = ProjectLeftX(0, DepthValue + 1)
    StairFarRight = ProjectRightX(0, DepthValue + 1)
    StairNearY = ViewBottomY[DepthValue]
    StairFarY = ViewBottomY[DepthValue + 1]
    Fill Quadrilateral StairNearLeft, StairNearY, StairNearRight, StairNearY, StairFarRight, StairFarY, StairFarLeft, StairFarY, DoorColor

    For StairLine = 1 To 4
        StairY = StairFarY + (StairNearY - StairFarY) * StairLine / 5
        StairLeft = StairFarLeft + (StairNearLeft - StairFarLeft) * StairLine / 5
        StairRight = StairFarRight + (StairNearRight - StairFarRight) * StairLine / 5
        Draw Line StairLeft, StairY, StairRight, StairY, HighlightColor
    End For

    If StairTile = TILE_STAIRS_UP Then
        Draw Line 480, StairFarY, 480, StairNearY, HighlightColor
    Else
        Draw Line StairNearLeft, StairNearY, StairFarRight, StairFarY, HighlightColor
    End If

End Sub

Sub DrawCellSection(DepthValue)

    CellX = WorldX(0, DepthValue, RenderDirection)
    CellY = WorldY(0, DepthValue, RenderDirection)
    CellTile = GetTile(CurrentFloor, CellX, CellY)
    FaceColor = WallColorForDepth(DepthValue)

    NearLeft = ProjectLeftX(0, DepthValue)
    NearRight = ProjectRightX(0, DepthValue)
    FarLeft = ProjectLeftX(0, DepthValue + 1)
    FarRight = ProjectRightX(0, DepthValue + 1)

    Fill Quadrilateral NearLeft, ViewTopY[DepthValue], NearRight, ViewTopY[DepthValue], FarRight, ViewTopY[DepthValue + 1], FarLeft, ViewTopY[DepthValue + 1], CeilingColor
    Fill Quadrilateral NearLeft, ViewBottomY[DepthValue], FarLeft, ViewBottomY[DepthValue + 1], FarRight, ViewBottomY[DepthValue + 1], NearRight, ViewBottomY[DepthValue], DungeonFloorColor
    Draw Line NearLeft, ViewBottomY[DepthValue], FarLeft, ViewBottomY[DepthValue + 1], MortarColor
    Draw Line NearRight, ViewBottomY[DepthValue], FarRight, ViewBottomY[DepthValue + 1], MortarColor

    LeftX = WorldX(-1, DepthValue, RenderDirection)
    LeftY = WorldY(-1, DepthValue, RenderDirection)
    LeftTile = GetTile(CurrentFloor, LeftX, LeftY)

    If BlocksSight(LeftTile) = True Then

        Call DrawLeftWall(0, DepthValue, FaceColor)

    Else

        SideNearLeft = ProjectLeftX(-1, DepthValue)
        SideFarLeft = ProjectLeftX(-1, DepthValue + 1)
        Fill Quadrilateral SideNearLeft, ViewTopY[DepthValue], NearLeft, ViewTopY[DepthValue], FarLeft, ViewTopY[DepthValue + 1], SideFarLeft, ViewTopY[DepthValue + 1], CeilingColor
        Fill Quadrilateral SideNearLeft, ViewBottomY[DepthValue], SideFarLeft, ViewBottomY[DepthValue + 1], FarLeft, ViewBottomY[DepthValue + 1], NearLeft, ViewBottomY[DepthValue], DungeonFloorColor
        OuterLeftX = WorldX(-2, DepthValue, RenderDirection)
        OuterLeftY = WorldY(-2, DepthValue, RenderDirection)

        If BlocksSight(GetTile(CurrentFloor, OuterLeftX, OuterLeftY)) = True Then
            Call DrawLeftWall(-1, DepthValue, FaceColor)
        End If

    End If

    RightX = WorldX(1, DepthValue, RenderDirection)
    RightY = WorldY(1, DepthValue, RenderDirection)
    RightTile = GetTile(CurrentFloor, RightX, RightY)

    If BlocksSight(RightTile) = True Then

        Call DrawRightWall(0, DepthValue, FaceColor)

    Else

        SideNearRight = ProjectRightX(1, DepthValue)
        SideFarRight = ProjectRightX(1, DepthValue + 1)
        Fill Quadrilateral NearRight, ViewTopY[DepthValue], SideNearRight, ViewTopY[DepthValue], SideFarRight, ViewTopY[DepthValue + 1], FarRight, ViewTopY[DepthValue + 1], CeilingColor
        Fill Quadrilateral NearRight, ViewBottomY[DepthValue], FarRight, ViewBottomY[DepthValue + 1], SideFarRight, ViewBottomY[DepthValue + 1], SideNearRight, ViewBottomY[DepthValue], DungeonFloorColor
        OuterRightX = WorldX(2, DepthValue, RenderDirection)
        OuterRightY = WorldY(2, DepthValue, RenderDirection)

        If BlocksSight(GetTile(CurrentFloor, OuterRightX, OuterRightY)) = True Then
            Call DrawRightWall(1, DepthValue, FaceColor)
        End If

    End If

    If CellTile = TILE_DOOR_OPEN Then
        Call DrawOpenDoorFrame(DepthValue)
    Else If CellTile = TILE_STAIRS_UP Or CellTile = TILE_STAIRS_DOWN Then
        Call DrawStairs(DepthValue, CellTile)
    End If

End Sub

Sub DrawDungeonView(DirectionValue, ScaleValue, OffsetValue)

    RenderDirection = DirectionValue
    RenderScale = ScaleValue
    RenderOffset = OffsetValue

    Call PrepareProjection()

    VisibleSections = ProjectionDepth
    FrontBlockTile = TILE_FLOOR

    For SightDepth = 1 To ProjectionDepth

        SightX = WorldX(0, SightDepth, RenderDirection)
        SightY = WorldY(0, SightDepth, RenderDirection)
        SightTile = GetTile(CurrentFloor, SightX, SightY)

        If BlocksSight(SightTile) = True Then

            VisibleSections = SightDepth
            FrontBlockTile = SightTile
            Exit For

        End If

    End For

    For DrawDepth = VisibleSections - 1 Down To 0
        Call DrawCellSection(DrawDepth)
    End For

    If FrontBlockTile = TILE_WALL Then

        Call DrawFrontWall(VisibleSections, WallColorForDepth(VisibleSections))

    Else If FrontBlockTile = TILE_DOOR_CLOSED Then

        DoorDrawProgress = 0
        FrontX = WorldX(0, VisibleSections, RenderDirection)
        FrontY = WorldY(0, VisibleSections, RenderDirection)

        If (ActionState = ACTION_OPEN_DOOR And
            FrontX = DoorX And
            FrontY = DoorY) Then
            DoorDrawProgress = ActionProgress

        End If

        Call DrawDoorPanel(VisibleSections, DoorDrawProgress)

    End If

End Sub

Sub DrawTransitionOverlay()

    If ActionState = ACTION_STAIRS_OUT Then

        If StairStage = 1 Then

            Fill Rectangle 0, 0, 960, 540, BLACK

        Else

            CoverX = ActionProgress * 480 / 1000
            CoverY = ActionProgress * 270 / 1000
            Fill Rectangle 0, 0, CoverX, 540, BLACK
            Fill Rectangle 960 - CoverX, 0, CoverX, 540, BLACK
            Fill Rectangle 0, 0, 960, CoverY, BLACK
            Fill Rectangle 0, 540 - CoverY, 960, CoverY, BLACK

        End If

    Else If ActionState = ACTION_STAIRS_IN Then

        Remaining = 1000 - ActionProgress
        CoverX = Remaining * 480 / 1000
        CoverY = Remaining * 270 / 1000
        Fill Rectangle 0, 0, CoverX, 540, BLACK
        Fill Rectangle 960 - CoverX, 0, CoverX, 540, BLACK
        Fill Rectangle 0, 0, 960, CoverY, BLACK
        Fill Rectangle 0, 540 - CoverY, 960, CoverY, BLACK

    End If

End Sub

Sub DrawHud()

    Fill Rounded Rectangle 16, 14, 142, 46, 8, Rgb(3, 8, 8)
    Draw Rounded Rectangle 16, 14, 142, 46, 8, MortarColor
    Draw Text "Floor" At 30, 27 Size 16 Color LIGHT_GRAY
    Draw Number CurrentFloor + 1 At 88, 21 Size 26 Color HighlightColor

    If PlayerDirection = NORTH Then
        Draw Text "N" At 128, 23 Size 24 Color WHITE
    Else If PlayerDirection = EAST Then
        Draw Text "E" At 128, 23 Size 24 Color WHITE
    Else If PlayerDirection = SOUTH Then
        Draw Text "S" At 128, 23 Size 24 Color WHITE
    Else
        Draw Text "W" At 128, 23 Size 24 Color WHITE
    End If

    If MapFallbackUsed = True And Now < MapFallbackMessageUntil Then

        Fill Rounded Rectangle 245, 474, 470, 42, 8, Rgb(20, 8, 8)
        Draw Rounded Rectangle 245, 474, 470, 42, 8, YELLOW
        Draw Text "Map Not Available - Random Dungeon Used" At 480, 486 Size 15 Color YELLOW Centered

    End If

End Sub

Sub DrawDungeonScene()

    Clear BLACK
    Fill Rectangle 0, 0, 960, 270, CeilingColor
    Fill Rectangle 0, 270, 960, 270, DungeonFloorColor

    If ActionState = ACTION_TURN_LEFT Or ActionState = ACTION_TURN_RIGHT Then

        OldScale = 1000 - ActionProgress
        NewScale = ActionProgress

        If ActionState = ACTION_TURN_LEFT Then
            OldOffset = ActionProgress * 480 / 1000
            NewOffset = -(1000 - ActionProgress) * 480 / 1000
        Else
            OldOffset = -ActionProgress * 480 / 1000
            NewOffset = (1000 - ActionProgress) * 480 / 1000
        End If

        If ActionProgress < 500 Then
            Call DrawDungeonView(TargetDirection, NewScale, NewOffset)
            Call DrawDungeonView(PlayerDirection, OldScale, OldOffset)
        Else
            Call DrawDungeonView(PlayerDirection, OldScale, OldOffset)
            Call DrawDungeonView(TargetDirection, NewScale, NewOffset)
        End If

    Else

        Call DrawDungeonView(PlayerDirection, 1000, 0)

    End If

    Call DrawHud()
    Call DrawTransitionOverlay()

End Sub

' -----------------------------------------------------------------------------
' Player action state machine
' -----------------------------------------------------------------------------

Sub EnterIdle()

    ActionState = ACTION_IDLE
    ActionProgress = 0

End Sub

Sub StartTurnLeft()

    If ActionState = ACTION_IDLE Then

        TargetDirection = (PlayerDirection + 3) Mod 4
        ActionState = ACTION_TURN_LEFT
        ActionStartedAt = Now
        ActionProgress = 0

    End If

End Sub

Sub StartTurnRight()

    If ActionState = ACTION_IDLE Then

        TargetDirection = (PlayerDirection + 1) Mod 4
        ActionState = ACTION_TURN_RIGHT
        ActionStartedAt = Now
        ActionProgress = 0

    End If

End Sub

Sub StartMove(StepValue)

    If ActionState <> ACTION_IDLE Then
        Return
    End If

    MoveX = PlayerX + DirectionX[PlayerDirection] * StepValue
    MoveY = PlayerY + DirectionY[PlayerDirection] * StepValue
    MoveTile = GetTile(CurrentFloor, MoveX, MoveY)

    If MoveTile = TILE_WALL Then

        Call EnterIdle()

    Else If MoveTile = TILE_DOOR_CLOSED Then

        DoorX = MoveX
        DoorY = MoveY
        PendingMoveStep = StepValue
        ActionState = ACTION_OPEN_DOOR
        ActionStartedAt = Now
        ActionProgress = 0

    Else

        TargetX = MoveX
        TargetY = MoveY

        If StepValue > 0 Then
            ActionState = ACTION_MOVE_FORWARD
        Else
            ActionState = ACTION_MOVE_BACKWARD
        End If

        ActionStartedAt = Now
        ActionProgress = 0

    End If

End Sub

Sub OpenFrontDoor()

    If ActionState = ACTION_IDLE Then

        FrontDoorX = PlayerX + DirectionX[PlayerDirection]
        FrontDoorY = PlayerY + DirectionY[PlayerDirection]

        If GetTile(CurrentFloor, FrontDoorX, FrontDoorY) = TILE_DOOR_CLOSED Then

            DoorX = FrontDoorX
            DoorY = FrontDoorY
            PendingMoveStep = 0
            ActionState = ACTION_OPEN_DOOR
            ActionStartedAt = Now

            ActionProgress = 0

        End If

    End If

End Sub

Sub BeginStairTransition(StairTile)

    If StairTile = TILE_STAIRS_DOWN And CurrentFloor < FloorCount - 1 Then

        StairDestinationFloor = CurrentFloor + 1
        StairDestinationX = StairUpX[StairDestinationFloor]
        StairDestinationY = StairUpY[StairDestinationFloor]

    Else If StairTile = TILE_STAIRS_UP And CurrentFloor > 0 Then

        StairDestinationFloor = CurrentFloor - 1
        StairDestinationX = StairDownX[StairDestinationFloor]
        StairDestinationY = StairDownY[StairDestinationFloor]

    Else

        Call EnterIdle()

        Return

    End If

    StairStage = 0
    ActionState = ACTION_STAIRS_OUT
    ActionStartedAt = Now
    ActionProgress = 0

End Sub

Sub UpdateAction()

    If ActionState = ACTION_IDLE Then
        Return
    End If

    If ActionState = ACTION_MOVE_FORWARD Or ActionState = ACTION_MOVE_BACKWARD Then

        ActionProgress = Min(1000, (Now - ActionStartedAt) * 1000 / MoveDuration)

        If ActionProgress >= 1000 Then

            PlayerX = TargetX
            PlayerY = TargetY
            ArrivedTile = GetTile(CurrentFloor, PlayerX, PlayerY)

            If ((ArrivedTile = TILE_STAIRS_UP Or ArrivedTile = TILE_STAIRS_DOWN) And
                StairSuppressed = 0) Then

                Call BeginStairTransition(ArrivedTile)
            Else
                If ArrivedTile <> TILE_STAIRS_UP And ArrivedTile <> TILE_STAIRS_DOWN Then
                    StairSuppressed = 0
                End If

                Call EnterIdle()
            End If

        End If

    Else If ActionState = ACTION_TURN_LEFT Or ActionState = ACTION_TURN_RIGHT Then

        ActionProgress = Min(1000, (Now - ActionStartedAt) * 1000 / TurnDuration)

        If ActionProgress >= 1000 Then
            PlayerDirection = TargetDirection

            Call EnterIdle()
        End If

    Else If ActionState = ACTION_OPEN_DOOR Then

        ActionProgress = Min(1000, (Now - ActionStartedAt) * 1000 / DoorDuration)

        If ActionProgress >= 1000 Then

            Call SetTile(CurrentFloor, DoorX, DoorY, TILE_DOOR_OPEN)

            ContinueStep = PendingMoveStep
            PendingMoveStep = 0
            ActionState = ACTION_IDLE

            If ContinueStep <> 0 Then
                Call StartMove(ContinueStep)
            Else
                Call EnterIdle()
            End If

        End If

    Else If ActionState = ACTION_STAIRS_OUT Then

        If StairStage = 0 Then

            ActionProgress = Min(1000, (Now - ActionStartedAt) * 1000 / StairOutDuration)

            If ActionProgress >= 1000 Then
                StairStage = 1
                ActionStartedAt = Now
            End If

        Else If Now - ActionStartedAt >= StairBlackDuration Then

            CurrentFloor = StairDestinationFloor
            PlayerX = StairDestinationX
            PlayerY = StairDestinationY
            StairSuppressed = 1

            Call SelectPalette()

            StairStage = 0
            ActionState = ACTION_STAIRS_IN
            ActionStartedAt = Now
            ActionProgress = 0

        End If

    Else If ActionState = ACTION_STAIRS_IN Then

        ActionProgress = Min(1000, (Now - ActionStartedAt) * 1000 / StairInDuration)

        If ActionProgress >= 1000 Then
            Call EnterIdle()
        End If

    End If

End Sub

' -----------------------------------------------------------------------------
' Title, idle overlay, and screen transitions
' -----------------------------------------------------------------------------

Sub EnterTitle()

    Stop Music
    ScreenState = STATE_TITLE
    ActionState = ACTION_IDLE
    ActionProgress = 0
    BufferedKey = KEY_NONE

End Sub

Sub StartUserDungeon()

    Call BuildSelectedDungeon()

    CurrentFloor = PlayerStartFloor
    PlayerX = PlayerStartX
    PlayerY = PlayerStartY
    PlayerDirection = PlayerStartDirection
    StairSuppressed = 0
    ActionState = ACTION_IDLE
    BufferedKey = KEY_NONE

    Call SelectPalette()

    ScreenState = STATE_USER_DUNGEON
    LastUserActivityAt = Timer()
    Play Music "Assets\Background.mp3" Loop

End Sub

Sub DrawTitle()

    Clear Rgb(3, 8, 20)

    Fill Quadrilateral 0, 0, 300, 125, 300, 415, 0, 540, Rgb(12, 36, 72)
    Fill Quadrilateral 960, 0, 660, 125, 660, 415, 960, 540, Rgb(12, 36, 72)
    Fill Quadrilateral 300, 125, 660, 125, 580, 205, 380, 205, Rgb(28, 80, 150)
    Fill Quadrilateral 300, 415, 380, 335, 580, 335, 660, 415, Rgb(8, 24, 52)
    Draw Quadrilateral 300, 125, 660, 125, 660, 415, 300, 415, Rgb(70, 135, 215)
    Draw Quadrilateral 380, 205, 580, 205, 580, 335, 380, 335, Rgb(135, 190, 255)
    Draw Line 0, 90, 300, 170, Rgb(20, 58, 112)
    Draw Line 960, 90, 660, 170, Rgb(20, 58, 112)
    Draw Line 0, 450, 300, 370, Rgb(20, 58, 112)
    Draw Line 960, 450, 660, 370, Rgb(20, 58, 112)

    Draw Text "Dungeon Star I" At 480, 34 Size 50 Color LIGHT_BLUE Centered
    Draw Text "Select A Three-Floor Dungeon" At 480, 91 Size 17 Color CYAN Centered

    If SelectedMap = MAP_DEFAULT Then
        Fill Rounded Rectangle 322, 222, 316, 36, 7, Rgb(28, 80, 150)
        Draw Text "> Default.map" At 480, 230 Size 19 Color WHITE Centered
    Else
        Draw Text "Default.map" At 480, 230 Size 19 Color LIGHT_GRAY Centered
    End If

    If SelectedMap = MAP_LOOPS Then
        Fill Rounded Rectangle 322, 264, 316, 36, 7, Rgb(28, 80, 150)

        Draw Text "> Sample-Loops.map" At 480, 272 Size 19 Color WHITE Centered
    Else
        Draw Text "Sample-Loops.map" At 480, 272 Size 19 Color LIGHT_GRAY Centered
    End If

    If SelectedMap = MAP_SWITCHBACKS Then
        Fill Rounded Rectangle 322, 306, 316, 36, 7, Rgb(28, 80, 150)
        Draw Text "> Sample-Switchbacks.map" At 480, 314 Size 18 Color WHITE Centered
    Else
        Draw Text "Sample-Switchbacks.map" At 480, 314 Size 18 Color LIGHT_GRAY Centered
    End If

    If SelectedMap = MAP_RANDOM Then
        Fill Rounded Rectangle 322, 348, 316, 36, 7, Rgb(28, 80, 150)
        Draw Text "> Random Dungeon" At 480, 356 Size 19 Color WHITE Centered
    Else
        Draw Text "Random Dungeon" At 480, 356 Size 19 Color LIGHT_GRAY Centered
    End If

    If (Now / FlashInterval) Mod 2 = 0 Then
        Draw Text "Up/Down Select - Enter Start" At 480, 445 Size 19 Color YELLOW Centered
    End If

    Draw Text "Alt + Enter Full Screen" At 480, 506 Size 12 Color GRAY Centered

End Sub

Sub DrawIdleWarning()

    IdleElapsed = Now - LastUserActivityAt

    If IdleElapsed >= UserIdleWarningTime And IdleElapsed < UserIdleExitTime Then

        IdleCountdown = UserIdleCountdownStart - ((IdleElapsed - UserIdleWarningTime) / 1000)

        If (IdleElapsed / FlashInterval) Mod 2 = 0 Then

            Fill Rounded Rectangle 300, 205, 360, 130, 14, Rgb(20, 8, 8)
            Draw Rounded Rectangle 300, 205, 360, 130, 14, RED
            Draw Text "Returning To Title" At 480, 226 Size 22 Color LIGHT_RED Centered
            Draw Number IdleCountdown At 468, 260 Size 42 Color YELLOW
            Draw Text "Press Any Key" At 480, 310 Size 14 Color WHITE Centered

        End If

    End If

End Sub

' -----------------------------------------------------------------------------
' Per-screen update routines
' -----------------------------------------------------------------------------

Sub UpdateTitle()

    If Key <> KEY_NONE Then

        If Key = KEY_ESCAPE Then

            Stop Music
            End Program

        Else If Key = KEY_UP Or Key = KEY_W Then

            SelectedMap = SelectedMap - 1

            If SelectedMap < MAP_DEFAULT Then
                SelectedMap = MAP_RANDOM
            End If

        Else If Key = KEY_DOWN Or Key = KEY_S Then

            SelectedMap = SelectedMap + 1

            If SelectedMap > MAP_RANDOM Then
                SelectedMap = MAP_DEFAULT
            End If

        Else If Key = KEY_ENTER Or Key = KEY_SPACE Then

            Call StartUserDungeon()

        End If

        Return

    End If

End Sub

Sub UpdateUserDungeon()

    HeldActivity = Key_Held(KEY_W) Or Key_Held(KEY_A) Or Key_Held(KEY_S) Or Key_Held(KEY_D) Or Key_Held(KEY_UP) Or Key_Held(KEY_DOWN) Or Key_Held(KEY_LEFT) Or Key_Held(KEY_RIGHT)

    If Key <> KEY_NONE Or HeldActivity = True Then
        LastUserActivityAt = Now
    End If

    If Key = KEY_ESCAPE Then
        Call EnterTitle()

        Return
    End If

    If ActionState <> ACTION_IDLE And Key <> KEY_NONE Then
        BufferedKey = Key
    End If

    IdleElapsed = Now - LastUserActivityAt

    If IdleElapsed >= UserIdleExitTime Then
        Call EnterTitle()

        Return
    End If

    Call UpdateAction()

    If ActionState = ACTION_IDLE Then

        ActionKey = Key

        If BufferedKey <> KEY_NONE Then
            ActionKey = BufferedKey
            BufferedKey = KEY_NONE
        End If

        If ActionKey = KEY_W Or ActionKey = KEY_UP Then
            Call StartMove(1)
        Else If ActionKey = KEY_S Or ActionKey = KEY_DOWN Then
            Call StartMove(-1)
        Else If ActionKey = KEY_A Or ActionKey = KEY_LEFT Then
            Call StartTurnLeft()
        Else If ActionKey = KEY_D Or ActionKey = KEY_RIGHT Then
            Call StartTurnRight()
        Else If ActionKey = KEY_ENTER Or ActionKey = KEY_SPACE Then
            Call OpenFrontDoor()
        Else If Key_Held(KEY_W) Or Key_Held(KEY_UP) Then
            Call StartMove(1)
        Else If Key_Held(KEY_S) Or Key_Held(KEY_DOWN) Then
            Call StartMove(-1)
        Else If Key_Held(KEY_A) Or Key_Held(KEY_LEFT) Then
            Call StartTurnLeft()
        Else If Key_Held(KEY_D) Or Key_Held(KEY_RIGHT) Then
            Call StartTurnRight()
        End If

    End If

End Sub

End Program
