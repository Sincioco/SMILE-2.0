<SmileProject Version="1.0">
  <PropertyGroup>
    <ProjectKind>Game</ProjectKind>
    <StartupFile>Program-Validation.smile</StartupFile>
    <OutputName>SpaceWarsStateTests</OutputName>
    <ApplicationId>smile.game.space-wars-state-tests</ApplicationId>
    <GraphicsBackend>GDI</GraphicsBackend>
    <VSync>false</VSync>
  </PropertyGroup>
  <ItemGroup>
    <SmileSource Include="Program-Validation.smile" StartupOnly="true" />
    <SmileSource Include="SpaceWarsTypes.smile" />
    <SmileSource Include="SpaceWarsModels.smile" />
    <SmileSource Include="SpaceWarsGameplay.smile" />
    <SmileProjectReference Include="..\..\libraries\Smile.Simple3D\Smile.Simple3D.smilelibproj" />
    <Asset Include="Assets\**\*" />
  </ItemGroup>
</SmileProject>
