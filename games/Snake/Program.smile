' SMILE 2.0 Snake - full game with its attract demo.
Const CanvasWidth = 960
Const CanvasHeight = 540
Const FieldX = 20
Const FieldY = 30
Const FieldWidth = 700
Const FieldHeight = 480
Const GridWidth = 35
Const GridHeight = 24
Const CellSize = 20
Const StartDelay = 100
Const MinimumDelay = 45
Const TitleDemoDelay = 5000
Const DemoMinimumPlayTime = 30000
Const DemoMaximumPlayTime = 45000
Const TitleInputArmDelay = 250

Dim Player As New Snake()
Dim Food As GridPoint
Dim State As GameState
Dim BFSQueueX[840]
Dim BFSQueueY[840]
Dim BFSVisited[GridWidth, GridHeight]
Dim BFSParentX[GridWidth, GridHeight]
Dim BFSParentY[GridWidth, GridHeight]
Dim BFSFirstDirection[GridWidth, GridHeight] As MoveDirection
Dim FloodQueueX[840]
Dim FloodQueueY[840]
Dim FloodVisited[GridWidth, GridHeight]

With Food
    .X = 0
    .Y = 0
End With

Score = 0
MoveDelay = StartDelay
NextMoveTime = 0
State = GameState.Title
Key = KEY_NONE
FoodValid = False
Collision = False
DemoMode = False
TitleStartedAt = 0
TitleAcceptInputAt = 0
DemoStartedAt = 0
DemoHasSafeMove = False
SimulatedHeadX = 0
SimulatedHeadY = 0
SimulatedEating = 0

'----------------------------------------------------------------------------------------------------

Load HighScore From "HighScore" Default 0

Game Window "SMILE 2.0 Snake"

Call EnterTitle()

Do
    Get Key Key

    If DemoMode = True And Key <> KEY_NONE Then
        Call EnterTitle()

        Key = KEY_NONE
    End If

    If State = GameState.Title Then

        If Key <> KEY_NONE And Timer() >= TitleAcceptInputAt Then

            TitleStartedAt = Timer()

            If Key = KEY_ESCAPE Then
                End Program
            Else If Key = KEY_ENTER Then
                Call ResetGame()
            End If

        End If

        If State = GameState.Title And Timer() - TitleStartedAt >= TitleDemoDelay Then
            Call StartDemo()
        End If

        Call DrawTitle()

    Else If State = GameState.Playing Then

        If DemoMode = False And Key = KEY_ESCAPE Then
            End Program
        End If

        If DemoMode = True And Timer() - DemoStartedAt >= DemoMaximumPlayTime Then
            Call EnterTitle()
        End If

        If State = GameState.Playing And DemoMode = False Then

            If Key = KEY_W Or Key = KEY_UP Then
                Call Player.TryTurn(MoveDirection.Up)
            Else If Key = KEY_S Or Key = KEY_DOWN Then
                Call Player.TryTurn(MoveDirection.Down)
            Else If Key = KEY_A Or Key = KEY_LEFT Then
                Call Player.TryTurn(MoveDirection.Left)
            Else If Key = KEY_D Or Key = KEY_RIGHT Then
                Call Player.TryTurn(MoveDirection.Right)
            End If

        End If

        If State = GameState.Playing And Timer() >= NextMoveTime Then

            If DemoMode = True Then

                Call PlanDemoDirection()

                If DemoHasSafeMove = True Then
                    Call MoveSnake()
                Else

                    Call RecoverDemo()
                End If

            Else

                Call MoveSnake()

            End If

        End If

        Call DrawBoard()

        If State = GameState.GameOver Then
            Call DrawGameOver()
        End If

    Else

        If Key = KEY_ESCAPE Then
            End Program
        Else If Key = KEY_ENTER Then
            Call ResetGame()
        End If

        If State = GameState.Title Then
            Call DrawTitle()
        Else

            Call DrawBoard()
            Call DrawGameOver()
        End If

    End If

    Show Screen

Loop Until Game_Closed() = True

Stop Music
Stop Sound

'----------------------------------------------------------------------------------------------------

Sub SpawnFood()

    Dim NewX As Number
    Dim NewY As Number

    FoodValid = False

    Do

        Random NewX From 0 To GridWidth - 1
        Random NewY From 0 To GridHeight - 1

        Food.X = NewX
        Food.Y = NewY
        FoodValid = Not Player.Contains(Food.X, Food.Y)

    Loop Until FoodValid = True

End Sub

Sub ResetPlay()

    Call Player.Reset()

    Score = 0
    MoveDelay = StartDelay

    Call SpawnFood()

    NextMoveTime = Timer() + StartDelay
    State = GameState.Playing

    Play Sound "Assets\Start.wav"

End Sub

Sub RecoverDemo()

    Call Player.Reset()

    MoveDelay = Max(MinimumDelay, StartDelay - (Score / 50) * 4)

    Call SpawnFood()

    NextMoveTime = Timer() + MoveDelay
    State = GameState.Playing

End Sub

Sub EndRound()

    If DemoMode = True And Timer() - DemoStartedAt < DemoMinimumPlayTime Then
        Call RecoverDemo()

        Return
    End If

    If DemoMode = True Then
        Call EnterTitle()

        Return
    End If

    Stop Music
    State = GameState.GameOver

    If DemoMode = False And Score > HighScore Then
        HighScore = Score
        Save HighScore To "HighScore"
    End If

    Play Sound "Assets\GameOver.wav"

End Sub

Function DirectionFromIndex(DirectionIndex As Number) As MoveDirection

    Dim ReturnValue As MoveDirection

    If DirectionIndex = 0 Then
        ReturnValue = MoveDirection.Up
        Return ReturnValue
    Else If DirectionIndex = 1 Then
        ReturnValue = MoveDirection.Right
        Return ReturnValue
    Else If DirectionIndex = 2 Then
        ReturnValue = MoveDirection.Down
        Return ReturnValue
    End If

    ReturnValue = MoveDirection.Left

    Return ReturnValue

End Function

Function DirectionX(DirectionValue As MoveDirection) As Number

    Dim ReturnValue As Number

    If DirectionValue = MoveDirection.Left Then
        ReturnValue = -1
        Return ReturnValue
    Else If DirectionValue = MoveDirection.Right Then
        ReturnValue = 1
        Return ReturnValue
    End If

    ReturnValue = 0

    Return ReturnValue

End Function

Function DirectionY(DirectionValue As MoveDirection) As Number

    Dim ReturnValue As Number

    If DirectionValue = MoveDirection.Up Then
        ReturnValue = -1
        Return ReturnValue
    Else If DirectionValue = MoveDirection.Down Then
        ReturnValue = 1
        Return ReturnValue
    End If

    ReturnValue = 0

    Return ReturnValue

End Function

Function IsSafeImmediate(TestDirection As MoveDirection) As Boolean

    If Not Player.CanTurn(TestDirection) Then
        Return False
    End If

    SafetyX = Player.HeadX + DirectionX(TestDirection)
    SafetyY = Player.HeadY + DirectionY(TestDirection)
    SafetyEating = 0
    SafetyAllowTail = True

    If SafetyX = Food.X And SafetyY = Food.Y Then
        SafetyEating = 1
        SafetyAllowTail = False
    End If

    If Not Player.CellBlocked(SafetyX, SafetyY, GridWidth, GridHeight, SafetyAllowTail) Then
        Return True
    End If

    Return False

End Function

Function SimulatedCellBlocked(TestX As Number, TestY As Number) As Boolean

    If (TestX < 0 Or
        TestX >= GridWidth Or
        TestY < 0 Or
        TestY >= GridHeight) Then
        Return True
    End If

    If TestX = SimulatedHeadX And TestY = SimulatedHeadY Then
        Return False
    End If

    LastSimulatedBody = Player.Length - 2

    If SimulatedEating = 1 Then
        LastSimulatedBody = Player.Length - 1
    End If

    For SimBodyIndex = 0 To LastSimulatedBody

        If TestX = Player.SegmentX(SimBodyIndex) And TestY = Player.SegmentY(SimBodyIndex) Then
            Return True
        End If

    End For

    Return False

End Function

Function FloodAreaForDirection(TestDirection As MoveDirection) As Number

    Dim ReturnValue As Number

    If IsSafeImmediate(TestDirection) = False Then
        ReturnValue = -1
        Return ReturnValue
    End If

    FloodStartX = Player.HeadX + DirectionX(TestDirection)
    FloodStartY = Player.HeadY + DirectionY(TestDirection)
    SimulatedHeadX = FloodStartX
    SimulatedHeadY = FloodStartY
    SimulatedEating = 0

    If FloodStartX = Food.X And FloodStartY = Food.Y Then
        SimulatedEating = 1
    End If

    For FloodClearY = 0 To GridHeight - 1

        For FloodClearX = 0 To GridWidth - 1
            FloodVisited[FloodClearX, FloodClearY] = 0
        End For
    End For

    FloodRead = 0
    FloodWrite = 1
    FloodQueueX[0] = FloodStartX
    FloodQueueY[0] = FloodStartY
    FloodVisited[FloodStartX, FloodStartY] = 1

    Do

        FloodX = FloodQueueX[FloodRead]
        FloodY = FloodQueueY[FloodRead]
        FloodRead = FloodRead + 1

        For FloodDirectionIndex = 0 To 3

            FloodDirection = DirectionFromIndex(FloodDirectionIndex)
            FloodNextX = FloodX + DirectionX(FloodDirection)
            FloodNextY = FloodY + DirectionY(FloodDirection)

            If (FloodNextX >= 0 And
                FloodNextX < GridWidth And
                FloodNextY >= 0 And
                FloodNextY < GridHeight) Then

                If FloodVisited[FloodNextX, FloodNextY] = 0 Then

                    If SimulatedCellBlocked(FloodNextX, FloodNextY) = False Then

                        FloodVisited[FloodNextX, FloodNextY] = 1
                        FloodQueueX[FloodWrite] = FloodNextX
                        FloodQueueY[FloodWrite] = FloodNextY
                        FloodWrite = FloodWrite + 1

                    End If

                End If

            End If

        End For

    Loop Until FloodRead >= FloodWrite

    Return FloodWrite

End Function

Sub ChooseSafeFallback()

    Dim BestSafeDirection As MoveDirection
    Dim SafeDirection As MoveDirection

    BestSafeArea = -1
    BestFoodDistance = 999999
    BestSafeDirection = MoveDirection.Up
    BestSafeDirectionFound = False

    For SafeDirectionIndex = 0 To 3

        SafeDirection = DirectionFromIndex(SafeDirectionIndex)
        SafeArea = FloodAreaForDirection(SafeDirection)

        If SafeArea >= 0 Then

            SafeX = Player.HeadX + DirectionX(SafeDirection)
            SafeY = Player.HeadY + DirectionY(SafeDirection)
            SafeFoodDistance = Abs(SafeX - Food.X) + Abs(SafeY - Food.Y)

            If (SafeArea > BestSafeArea Or
                (SafeArea = BestSafeArea And SafeFoodDistance < BestFoodDistance)) Then

                BestSafeArea = SafeArea
                BestFoodDistance = SafeFoodDistance
                BestSafeDirection = SafeDirection
                BestSafeDirectionFound = True

            End If

        End If

    End For

    If BestSafeDirectionFound Then
        Call Player.TryTurn(BestSafeDirection)

        DemoHasSafeMove = True
    End If

End Sub

Sub PlanDemoDirection()

    Dim BFSDirection As MoveDirection
    Dim BFSFoodDirection As MoveDirection

    DemoHasSafeMove = False
    BFSFound = False
    BFSFoodDirection = MoveDirection.Up

    For BFSClearY = 0 To GridHeight - 1

        For BFSClearX = 0 To GridWidth - 1
            BFSVisited[BFSClearX, BFSClearY] = 0
            BFSParentX[BFSClearX, BFSClearY] = -1
            BFSParentY[BFSClearX, BFSClearY] = -1
            BFSFirstDirection[BFSClearX, BFSClearY] = MoveDirection.Up
        End For
    End For

    BFSRead = 0
    BFSWrite = 1
    BFSQueueX[0] = Player.HeadX
    BFSQueueY[0] = Player.HeadY
    BFSVisited[Player.HeadX, Player.HeadY] = 1

    Do

        Bfsx = BFSQueueX[BFSRead]
        Bfsy = BFSQueueY[BFSRead]
        BFSRead = BFSRead + 1

        For BFSDirectionIndex = 0 To 3

            BFSDirection = DirectionFromIndex(BFSDirectionIndex)
            BFSNextX = Bfsx + DirectionX(BFSDirection)
            BFSNextY = Bfsy + DirectionY(BFSDirection)

            If (BFSNextX >= 0 And
                BFSNextX < GridWidth And
                BFSNextY >= 0 And
                BFSNextY < GridHeight) Then

                If BFSVisited[BFSNextX, BFSNextY] = 0 Then

                    If Not Player.CellBlocked(BFSNextX, BFSNextY, GridWidth, GridHeight, True) Then

                        BFSVisited[BFSNextX, BFSNextY] = 1
                        BFSParentX[BFSNextX, BFSNextY] = Bfsx
                        BFSParentY[BFSNextX, BFSNextY] = Bfsy

                        If Bfsx = Player.HeadX And Bfsy = Player.HeadY Then
                            BFSFirstDirection[BFSNextX, BFSNextY] = BFSDirection
                        Else
                            BFSFirstDirection[BFSNextX, BFSNextY] = BFSFirstDirection[Bfsx, Bfsy]
                        End If

                        BFSQueueX[BFSWrite] = BFSNextX
                        BFSQueueY[BFSWrite] = BFSNextY
                        BFSWrite = BFSWrite + 1

                        If BFSNextX = Food.X And BFSNextY = Food.Y Then
                            BFSFound = True
                            BFSFoodDirection = BFSFirstDirection[BFSNextX, BFSNextY]
                        End If

                    End If

                End If

            End If

        End For

    Loop Until BFSRead >= BFSWrite Or BFSFound = True

    If BFSFound = True And IsSafeImmediate(BFSFoodDirection) = True Then

        Call Player.TryTurn(BFSFoodDirection)

        DemoHasSafeMove = True
        Return

    End If

    Call ChooseSafeFallback()

End Sub

Sub MoveSnake()

    Dim Grew As Boolean

    Call Player.Move()

    Collision = Player.HitWall(GridWidth, GridHeight)
    Collision = Collision Or Player.HitSelf()

    If Collision = True Then

        Call EndRound()

    Else If Player.HeadX = Food.X And Player.HeadY = Food.Y Then

        Grew = Player.Grow()

        If Grew Then
            Score = Score + 10
            MoveDelay = Max(MinimumDelay, StartDelay - (Score / 50) * 4)
        End If

        Play Sound "Assets\Eat.wav"
        Call SpawnFood()

    End If

    NextMoveTime = Timer() + MoveDelay

End Sub

Sub DrawBoard()

    Dim SegmentX As Number
    Dim SegmentY As Number

    Clear Rgb(10, 18, 35)
    Fill Rectangle FieldX, FieldY, FieldWidth, FieldHeight, BLACK
    Draw Rectangle FieldX, FieldY, FieldWidth, FieldHeight, Rgb(40, 70, 95)

    For I = 0 To Player.Length - 1

        SegmentX = Player.SegmentX(I)
        SegmentY = Player.SegmentY(I)

        If (SegmentX >= 0 And
            SegmentX < GridWidth And
            SegmentY >= 0 And
            SegmentY < GridHeight) Then
            Fill Rectangle FieldX + SegmentX * CellSize + 2, FieldY + SegmentY * CellSize + 2, 16, 16, Rgb(60, 230, 75)
            Draw Rectangle FieldX + SegmentX * CellSize + 2, FieldY + SegmentY * CellSize + 2, 16, 16, Rgb(20, 105, 35)
        End If

    End For

    Fill Rectangle FieldX + Food.X * CellSize + 3, FieldY + Food.Y * CellSize + 3, 14, 14, Rgb(245, 45, 55)
    Draw Rectangle FieldX + Food.X * CellSize + 3, FieldY + Food.Y * CellSize + 3, 14, 14, Rgb(120, 15, 25)

    Draw Text "SMILE Snake" At 835, 55 Size 27 Color LIGHT_GREEN Centered
    Draw Text "Score" At 755, 115 Size 20 Color LIGHT_GRAY
    Draw Number Score At 755, 142 Size 34 Color YELLOW
    Draw Text "High Score" At 755, 205 Size 20 Color LIGHT_GRAY
    Draw Number HighScore At 755, 232 Size 34 Color CYAN
    Draw Text "WASD / Arrows" At 835, 330 Size 16 Color WHITE Centered
    Draw Text "Move The Snake" At 835, 355 Size 16 Color LIGHT_GRAY Centered
    Draw Text "Alt+Enter" At 835, 415 Size 16 Color WHITE Centered
    Draw Text "Full Screen" At 835, 440 Size 16 Color LIGHT_GRAY Centered
    Draw Text "Escape Exits" At 835, 490 Size 16 Color LIGHT_GRAY Centered

    If DemoMode = True And State = GameState.Playing Then

        Fill Rounded Rectangle 740, 375, 200, 88, 10, Rgb(16, 25, 45)
        Draw Rounded Rectangle 740, 375, 200, 88, 10, CYAN
        Draw Text "Demo" At 840, 388 Size 21 Color YELLOW Centered
        Draw Text "Press Any Key" At 840, 420 Size 13 Color WHITE Centered
        Draw Text "To Return" At 840, 440 Size 13 Color WHITE Centered

    End If

End Sub

Sub DrawTitle()

    Clear Rgb(10, 18, 35)
    Fill Rectangle FieldX, FieldY, FieldWidth, FieldHeight, BLACK
    Draw Rectangle FieldX, FieldY, FieldWidth, FieldHeight, Rgb(40, 70, 95)
    Fill Rectangle 260, 255, 80, 18, Rgb(60, 230, 75)
    Draw Rectangle 260, 255, 80, 18, Rgb(20, 105, 35)
    Fill Rectangle 360, 257, 14, 14, Rgb(245, 45, 55)
    Draw Text "SMILE Snake" At 370, 140 Size 54 Color LIGHT_GREEN Centered
    Draw Text "A Native Game Written In SMILE" At 370, 215 Size 19 Color LIGHT_GRAY Centered
    Draw Text "Press Enter To Start" At 370, 335 Size 28 Color YELLOW Centered
    Draw Text "WASD Or Arrow Keys To Move" At 370, 385 Size 18 Color WHITE Centered
    Draw Text "Escape To Exit" At 370, 415 Size 18 Color LIGHT_GRAY Centered
    Draw Text "High Score" At 835, 165 Size 20 Color LIGHT_GRAY Centered
    Draw Number HighScore At 805, 205 Size 38 Color CYAN

End Sub

Sub DrawGameOver()

    Fill Rounded Rectangle 145, 135, 590, 285, 22, Rgb(16, 25, 45)
    Draw Rounded Rectangle 145, 135, 590, 285, 22, Rgb(245, 45, 55)
    Draw Text "Game Over" At 440, 185 Size 50 Color RED Centered
    Draw Text "Final Score" At 330, 255 Size 22 Color LIGHT_GRAY Centered
    Draw Number Score At 530, 247 Size 38 Color YELLOW
    Draw Text "High Score" At 330, 305 Size 22 Color LIGHT_GRAY Centered
    Draw Number HighScore At 530, 297 Size 38 Color CYAN
    Draw Text "Enter To Retry" At 440, 360 Size 24 Color WHITE Centered
    Draw Text "Escape To Exit" At 440, 392 Size 18 Color LIGHT_GRAY Centered

End Sub

Sub DrainPendingKeys()

    For DrainIndex = 1 To 64
        Get Key DrainedKey
    End For

End Sub

Sub EnterTitle()

    Stop Music
    DemoMode = False
    State = GameState.Title
    Key = KEY_NONE
    Stop Sound

    Call DrainPendingKeys()

    TitleStartedAt = Timer()
    TitleAcceptInputAt = TitleStartedAt + TitleInputArmDelay

End Sub

Sub ResetGame()

    DemoMode = False

    Call ResetPlay()

    Play Music "Assets\Background.mp3" Loop

End Sub

Sub StartDemo()

    DemoMode = True
    DemoStartedAt = Timer()

    Call ResetPlay()

    Play Music "Assets\Background.mp3" Loop

End Sub

End Program
