<SmileProject Version="1.0">
  <PropertyGroup>
    <ProjectKind>Game</ProjectKind>
    <StartupFile>Program.smile</StartupFile>
    <OutputName>Dragonfall</OutputName>
    <ApplicationId>smile.game.dragonfall</ApplicationId>
    <GraphicsBackend>DirectX</GraphicsBackend>
    <VSync>true</VSync>
  </PropertyGroup>
  <ItemGroup>
    <SmileSource Include="Program.smile" StartupOnly="true" />
    <SmileSource Include="Program-NoDemo.smile" StartupOnly="true" />
    <SmileSource Include="DragonfallBattle.smile" />
    <SmileSource Include="DragonfallScene.smile" />
    <SmileSource Include="DragonfallAudio.smile" />
    <SmileSource Include="DragonfallVisualActor.smile" />
    <SmileProjectReference Include="..\..\libraries\Smile.RPG\Smile.RPG.smilelibproj" />
    <SmileProjectReference Include="..\..\libraries\Smile.BattleTime\Smile.BattleTime.smilelibproj" />
    <SmileProjectReference Include="..\..\libraries\Smile.Battle3D\Smile.Battle3D.smilelibproj" />
    <SmileProjectReference Include="..\..\libraries\Smile.Simple3D\Smile.Simple3D.smilelibproj" />
    <Asset Include="Assets\**\*" />
  </ItemGroup>
</SmileProject>
