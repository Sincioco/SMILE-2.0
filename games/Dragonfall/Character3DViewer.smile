''' Reusable SM3D character inspection project. Arin is the included sample asset.

Option Explicit

Import Smile.Simple3D.Character3D As Character3D
Import Smile.Simple3D.CharacterViewer As CharacterViewer
Import Smile.Simple3D.Core As Core
Import Smile.Simple3D.Graphics3D As Graphics3D
Import Smile.Simple3D.Interaction As Interaction
Import Smile.Simple3D.Scene3D As Scene3D
Import Dragonfall.Character3DViewerProfile As ViewerProfiles

Const DRAG_ORBIT = 0
Const DRAG_PAN = 1
Const PAN_POINTER_DIVISOR = 3
Const ORBIT_PITCH_LIMIT = 60
Const ZOOM_IN_LIMIT = -24
Const ZOOM_OUT_LIMIT = 36

Dim BaseCamera As Core.Camera3D
Dim Camera As Core.Camera3D
Dim CameraControls As Core.CameraControl3D
Dim Character As Character3D.Actor
Dim CharacterBounds As Character3D.Bounds3D
Dim LocalCharacterBounds As Character3D.Bounds3D
Dim ActiveProfile As CharacterViewer.Profile
Dim ViewerFrame As CharacterViewer.Framing
Dim SmoothZoom As CharacterViewer.ZoomState
Dim Floor As Core.Object3D
Dim SocketGizmos[24] As Core.Object3D
Dim SocketGizmoCount As Number
Dim SocketGizmosVisible As Boolean
Dim Ready As Boolean
Dim Running As Boolean
Dim ViewerError As Boolean
Dim FirstViewerError As Number
Dim FirstRendererError As Number
Dim ViewerEpoch As Number
Dim InterfacePointerBlocked As Boolean
Dim DragMode As Number
Dim SelectedClip As Number
Dim LightingIndex As Number
Dim ProfileIndex As Number
Dim PlaybackSpeed As Number
Dim MaterialInspection As Number
Dim Key As Number
Dim CurrentTime As Number
Dim PreviousTime As Number
Dim FrameMilliseconds As Number
Dim PanPointerRemainderX As Number
Dim PanPointerRemainderY As Number
Dim AutoOrbit As Boolean
Dim AutoOrbitYaw1000 As Number

Game Window "SMILE Character 3D Viewer" Size 960 By 540

Call Graphics3D.ResetRenderer3D()
Call LoadViewer()

Running = True
PreviousTime = Timer()

Do

    Get Key Key

    Call HandleKeyboard(Key)

    InterfacePointerBlocked = HandleInterfacePointer()

    Call UpdateCameraPointer(InterfacePointerBlocked)

    CurrentTime = Timer()
    FrameMilliseconds = Min(40, Max(0, CurrentTime - PreviousTime))
    PreviousTime = CurrentTime

    If Not ViewerError Then

        Ready = Character3D.Update(Character, FrameMilliseconds) And Ready

        If SocketGizmosVisible Then
            Call UpdateSocketGizmos()
        End If

        Call AdvanceSmoothZoom()
        Call AdvanceAutoOrbit()

        Camera = Interaction.ApplyCameraControls(BaseCamera, CameraControls)

        If Character3D.IsValid(Character) Then
            CharacterBounds = Character3D.WorldBounds(Character, ActiveProfile.AnimationMargin)
        End If

        Ready = Scene3D.Begin(Camera, 5, 9, 20) And Ready

        If Ready Then

            Ready = Graphics3D.DrawObject3D(Floor)
            Ready = Character3D.Draw(Character) And Ready

            If SocketGizmosVisible Then
                Ready = DrawSocketGizmos() And Ready
            End If

            Ready = Scene3D.EndScene() And Ready

        End If

        If Not Ready Then
            Call RecordViewerError()
        End If

    End If

    Call DrawViewerOverlay()

    Show Screen

    Running = Running And Not Game_Closed()

Loop Until Not Running

Call DestroyViewer()

Sub LoadViewer()

    ActiveProfile = ViewerProfiles.ProfileAt(ProfileIndex)
    Ready = CharacterViewer.ValidateProfile(ActiveProfile)
    Character = Character3D.LoadWithPolicy(
        ActiveProfile.AssetPath,
        Character3D.CHARACTER_LOAD_REQUIRE_PBR
    )
    Ready = Character3D.IsValid(Character) And Ready
    LocalCharacterBounds = Character3D.LocalBounds(Character)
    ViewerFrame = CharacterViewer.AutoFit(ActiveProfile, LocalCharacterBounds)
    Ready = ViewerFrame.Valid And Ready
    BaseCamera = Graphics3D.DefaultCamera()
    BaseCamera.Position.X = 0
    BaseCamera.Position.Y = ViewerFrame.CameraY
    BaseCamera.Position.Z = ViewerFrame.CameraZ
    BaseCamera.Target.X = 0
    BaseCamera.Target.Y = ViewerFrame.TargetY
    BaseCamera.Target.Z = 0
    Floor = Graphics3D.CreatePlane3D(ViewerFrame.FloorWidth, ViewerFrame.FloorDepth)

    Call Graphics3D.SetObjectPosition(Floor, 0, 0, 0)
    Call Graphics3D.SetObjectColor(Floor, 28, 35, 54)
    Call Interaction.ResetCameraControls(CameraControls)
    Call CharacterViewer.InitializeZoom(SmoothZoom, 0, ZOOM_IN_LIMIT, ZOOM_OUT_LIMIT, 48000)

    Ready = Scene3D.SetQuality(Scene3D.QUALITY_HIGH)
    Ready = Scene3D.SetShadowArea(
        0,
        ViewerFrame.TargetY,
        0,
        ViewerFrame.ShadowWidth,
        ViewerFrame.ShadowDepth,
        ViewerFrame.ShadowNear,
        ViewerFrame.ShadowFar
    ) And Ready

    Call ApplyLighting()

    Ready = Character3D.SetScale(Character, ViewerFrame.ScalePercent) And Ready
    Ready = Character3D.Place(
        Character,
        ViewerFrame.PositionX,
        ViewerFrame.PositionY,
        ViewerFrame.PositionZ
    ) And Ready
    Ready = Character3D.Rotate(Character, 0, 0, 0) And Ready
    Ready = Character3D.SetShadows(Character, True, True) And Ready
    SocketGizmosVisible = False

    Call CreateSocketGizmos()

    SelectedClip = 0
    PlaybackSpeed = ActiveProfile.DefaultPlaybackSpeed
    MaterialInspection = Graphics3D.MATERIAL_INSPECTION_LIT
    Ready = Graphics3D.SetMaterialInspection3D(MaterialInspection) And Ready

    Call PlaySelectedClip()

    ViewerEpoch = Graphics3D.ResourceEpoch3D()

    If Not Ready Then
        Call RecordViewerError()
    End If

End Sub

Sub HandleKeyboard(PressedKey As Number)

    If PressedKey = KEY_ESCAPE Then

        Running = False

    Else If PressedKey = KEY_LEFT Then

        Call NudgeOrbit(-5, 0)

    Else If PressedKey = KEY_RIGHT Then

        Call NudgeOrbit(5, 0)

    Else If PressedKey = KEY_UP Then

        Call NudgeOrbit(0, -5)

    Else If PressedKey = KEY_DOWN Then

        Call NudgeOrbit(0, 5)

    Else If PressedKey = KEY_A Then

        Call NudgePan(5, 0)

    Else If PressedKey = KEY_D Then

        Call NudgePan(-5, 0)

    Else If PressedKey = KEY_W Then

        Call NudgePan(0, -5)

    Else If PressedKey = KEY_S Then

        Call NudgePan(0, 5)

    Else If PressedKey = KEY_1 And ViewerProfiles.ClipCount(ProfileIndex) > 0 Then

        SelectedClip = 0

        Call PlaySelectedClip()

    Else If PressedKey = KEY_2 And ViewerProfiles.ClipCount(ProfileIndex) > 1 Then

        SelectedClip = 1

        Call PlaySelectedClip()

    Else If PressedKey = KEY_3 And ViewerProfiles.ClipCount(ProfileIndex) > 2 Then

        SelectedClip = 2

        Call PlaySelectedClip()

    Else If PressedKey = KEY_SPACE Then

        Call CycleLighting()

    Else If PressedKey = KEY_ENTER Then

        If ViewerError Then
            Call RetryViewer()
        Else

            Call ResetView()
        End If

    Else If PressedKey = KEY_TAB Then

        Call ToggleDragMode()

    Else If PressedKey = KEY_O Then

        Call ToggleAutoOrbit()

    Else If PressedKey = KEY_4 Then

        Call CycleProfile()

    End If

End Sub

Sub RecordViewerError()

    ViewerError = True

    If FirstViewerError = 0 Then

        FirstViewerError = Character3D.LastError()

        If FirstViewerError = 0 Then
            FirstViewerError = Scene3D.LastError()
        End If

    End If

    If FirstRendererError = 0 Then

        FirstRendererError = Character3D.LastRendererError()

        If FirstRendererError = 0 Then
            FirstRendererError = Scene3D.LastRendererError()
        End If

        If FirstRendererError = 0 Then
            FirstRendererError = Graphics3D.LastError()
        End If

    End If

End Sub

Sub RetryViewer()

    Call DestroyViewerResources()
    Call Character3D.Shutdown()
    Call Scene3D.Shutdown()
    Call Graphics3D.ResetRenderer3D()

    Ready = True
    ViewerError = False
    FirstViewerError = 0
    FirstRendererError = 0

    Call LoadViewer()

End Sub

Sub CycleProfile()

    Call DestroyViewerResources()

    ProfileIndex = (ProfileIndex + 1) Mod ViewerProfiles.ProfileCount()
    Ready = True
    ViewerError = False
    FirstViewerError = 0
    FirstRendererError = 0

    Call LoadViewer()

End Sub

Sub CycleMaterialInspection()

    MaterialInspection = (MaterialInspection + 1) Mod 7
    Ready = Graphics3D.SetMaterialInspection3D(MaterialInspection) And Ready

End Sub

Sub ToggleAutoOrbit()

    AutoOrbit = Not AutoOrbit
    AutoOrbitYaw1000 = CameraControls.OrbitYaw * 1000

End Sub

Sub AdvanceAutoOrbit()

    If AutoOrbit Then
        AutoOrbitYaw1000 = AutoOrbitYaw1000 + FrameMilliseconds * 30
        CameraControls.OrbitYaw = AutoOrbitYaw1000 / 1000
    End If

End Sub

Function HandleInterfacePointer() As Boolean

    Dim Blocked As Boolean

    If Not Pointer_Inside() Then
        Return False
    End If

    Blocked = (Pointer_Y() < 72 Or
        Pointer_Y() >= 458 Or
        (Pointer_X() >= 716 And Pointer_Y() >= 82 And Pointer_Y() < 430))

    If Not Pointer_Pressed(POINTER_PRIMARY) Then
        Return Blocked
    End If

    If PointerInRectangle(510, 18, 62, 34) Then

        SelectedClip = 0

        Call PlaySelectedClip()

    Else If PointerInRectangle(578, 18, 62, 34) Then

        SelectedClip = 1

        Call PlaySelectedClip()

    Else If PointerInRectangle(646, 18, 62, 34) Then

        SelectedClip = 2

        Call PlaySelectedClip()

    Else If PointerInRectangle(714, 18, 82, 34) Then

        Call CycleLighting()

    Else If PointerInRectangle(802, 18, 70, 34) Then

        Call ToggleDragMode()

    Else If PointerInRectangle(878, 18, 66, 34) Then

        Call CycleProfile()

    Else If PointerInRectangle(868, 214, 30, 24) Then

        Call AdjustPlaybackSpeed(-25)

    Else If PointerInRectangle(904, 214, 30, 24) Then

        Call AdjustPlaybackSpeed(25)

    Else If PointerInRectangle(732, 374, 92, 30) Then

        SocketGizmosVisible = Not SocketGizmosVisible

    Else If PointerInRectangle(12, 482, 70, 36) Then

        Call NudgeOrbit(-5, 0)

    Else If PointerInRectangle(88, 482, 70, 36) Then

        Call NudgeOrbit(5, 0)

    Else If PointerInRectangle(164, 482, 70, 36) Then

        Call NudgeOrbit(0, -5)

    Else If PointerInRectangle(240, 482, 70, 36) Then

        Call NudgeOrbit(0, 5)

    Else If PointerInRectangle(316, 482, 70, 36) Then

        Call NudgePan(5, 0)

    Else If PointerInRectangle(392, 482, 70, 36) Then

        Call NudgePan(-5, 0)

    Else If PointerInRectangle(468, 482, 70, 36) Then

        Call NudgePan(0, -5)

    Else If PointerInRectangle(544, 482, 70, 36) Then

        Call NudgePan(0, 5)

    Else If PointerInRectangle(620, 482, 70, 36) Then

        Call NudgeZoom(1)

    Else If PointerInRectangle(696, 482, 70, 36) Then

        Call NudgeZoom(-1)

    Else If PointerInRectangle(772, 482, 82, 36) Then

        Call CycleMaterialInspection()

    Else If PointerInRectangle(860, 482, 84, 36) Then

        If ViewerError Then
            Call RetryViewer()
        Else

            Call ResetView()
        End If

    End If

    Return Blocked

End Function

Sub UpdateCameraPointer(Blocked As Boolean)

    Dim PrimaryOrbit As Boolean
    Dim PrimaryPan As Boolean
    Dim OrbitPressed As Boolean
    Dim OrbitHeld As Boolean
    Dim OrbitReleased As Boolean
    Dim PanPressed As Boolean
    Dim PanHeld As Boolean
    Dim PanReleased As Boolean
    Dim WheelDelta As Number
    Dim PointerDeltaX As Number
    Dim PointerDeltaY As Number
    Dim OrbitDeltaX As Number
    Dim OrbitDeltaY As Number
    Dim PanDeltaX As Number
    Dim PanDeltaY As Number

    PrimaryOrbit = DragMode = DRAG_ORBIT
    PrimaryPan = DragMode = DRAG_PAN
    OrbitPressed = ((PrimaryOrbit And Not Blocked And Pointer_Pressed(POINTER_PRIMARY)) Or
        Pointer_Pressed(POINTER_MIDDLE))
    OrbitHeld = ((PrimaryOrbit And Pointer_Held(POINTER_PRIMARY)) Or
        Pointer_Held(POINTER_MIDDLE))
    OrbitReleased = ((PrimaryOrbit And Pointer_Released(POINTER_PRIMARY)) Or
        Pointer_Released(POINTER_MIDDLE))
    PanPressed = ((PrimaryPan And Not Blocked And Pointer_Pressed(POINTER_PRIMARY)) Or
        Pointer_Pressed(POINTER_SECONDARY))
    PanHeld = ((PrimaryPan And Pointer_Held(POINTER_PRIMARY)) Or
        Pointer_Held(POINTER_SECONDARY))
    PanReleased = ((PrimaryPan And Pointer_Released(POINTER_PRIMARY)) Or
        Pointer_Released(POINTER_SECONDARY))
    PointerDeltaX = Pointer_Delta_X()
    PointerDeltaY = Pointer_Delta_Y()

    If OrbitHeld Then
        OrbitDeltaX = PointerDeltaX
        OrbitDeltaY = PointerDeltaY
    End If

    If PanPressed Then
        PanPointerRemainderX = 0
        PanPointerRemainderY = 0
    End If

    If PanHeld Then
        PanDeltaX = CharacterViewer.RetainedPointerDelta(
            PanPointerRemainderX,
            PointerDeltaX,
            PAN_POINTER_DIVISOR
        )
        PanDeltaY = CharacterViewer.RetainedPointerDelta(
            PanPointerRemainderY,
            PointerDeltaY,
            PAN_POINTER_DIVISOR
        )
    End If

    If Not Blocked Then
        WheelDelta = Pointer_Wheel_Delta()
    End If

    If WheelDelta <> 0 Then
        Call AdjustZoomTarget(WheelDelta)
    End If

    Ready = Interaction.UpdateOrbitControls(
        CameraControls,
        OrbitPressed,
        OrbitHeld,
        OrbitReleased,
        0,
        0
    ) And Ready
    Ready = Interaction.UpdatePanZoomControls(
        CameraControls,
        PanPressed,
        PanHeld,
        PanReleased,
        0,
        0,
        0
    ) And Ready

    If OrbitHeld Then

        AutoOrbit = False
        CameraControls.OrbitYaw = CameraControls.OrbitYaw + OrbitDeltaX
        CameraControls.OrbitPitch = CameraControls.OrbitPitch + OrbitDeltaY

    End If

    If PanHeld Then
        CameraControls.PanX = CameraControls.PanX - PanDeltaX
        CameraControls.PanY = CameraControls.PanY + PanDeltaY
    End If

    Call ClampCameraControls()

    If PanReleased Then
        PanPointerRemainderX = 0
        PanPointerRemainderY = 0
    End If

End Sub

Sub CreateSocketGizmos()

    Dim Index As Number
    Dim Axis As Number

    SocketGizmoCount = ViewerProfiles.SocketCount(ProfileIndex) * 4

    For Index = 0 To SocketGizmoCount - 1

        SocketGizmos[Index] = Graphics3D.CreateCube3D(3)
        Axis = Index Mod 4

        If Axis = 0 Then
            Call Graphics3D.SetObjectColor(SocketGizmos[Index], 255, 255, 255)
        Else If Axis = 1 Then
            Call Graphics3D.SetObjectColor(SocketGizmos[Index], 255, 60, 60)
        Else If Axis = 2 Then
            Call Graphics3D.SetObjectColor(SocketGizmos[Index], 70, 255, 90)
        Else

            Call Graphics3D.SetObjectColor(SocketGizmos[Index], 80, 140, 255)
        End If

    End For

End Sub

Sub UpdateSocketGizmos()

    Dim SocketIndex As Number
    Dim GizmoIndex As Number
    Dim Name As Text
    Dim PositionX1000 As Number
    Dim PositionY1000 As Number
    Dim PositionZ1000 As Number
    Dim AxisX1000 As Number
    Dim AxisY1000 As Number
    Dim AxisZ1000 As Number
    Dim AxisLength As Number
    Dim MatrixProperty As Number
    Dim Axis As Number

    For SocketIndex = 0 To ViewerProfiles.SocketCount(ProfileIndex) - 1

        Name = ViewerProfiles.SocketName(ProfileIndex, SocketIndex)
        PositionX1000 = Character3D.SocketValueThousandths(
            Character,
            Name,
            Graphics3D.ANIMATOR_SOCKET_POSITION_X
        )
        PositionY1000 = Character3D.SocketValueThousandths(
            Character,
            Name,
            Graphics3D.ANIMATOR_SOCKET_POSITION_Y
        )
        PositionZ1000 = Character3D.SocketValueThousandths(
            Character,
            Name,
            Graphics3D.ANIMATOR_SOCKET_POSITION_Z
        )

        For Axis = 0 To 3

            GizmoIndex = SocketIndex * 4 + Axis
            AxisX1000 = 0
            AxisY1000 = 0
            AxisZ1000 = 0

            If Axis > 0 Then

                MatrixProperty = Graphics3D.ANIMATOR_SOCKET_MATRIX_M11 + (Axis - 1) * 3
                AxisX1000 = Character3D.SocketValueThousandths(Character, Name, MatrixProperty)
                AxisY1000 = Character3D.SocketValueThousandths(Character, Name, MatrixProperty + 1)
                AxisZ1000 = Character3D.SocketValueThousandths(Character, Name, MatrixProperty + 2)
                AxisLength = Max(1, Max(Abs(AxisX1000), Max(Abs(AxisY1000), Abs(AxisZ1000))))
                AxisX1000 = AxisX1000 * 8000 / AxisLength
                AxisY1000 = AxisY1000 * 8000 / AxisLength
                AxisZ1000 = AxisZ1000 * 8000 / AxisLength

            End If

            Call Graphics3D.SetObjectPosition(
                SocketGizmos[GizmoIndex],
                (PositionX1000 + AxisX1000) / 1000,
                (PositionY1000 + AxisY1000) / 1000,
                (PositionZ1000 + AxisZ1000) / 1000
            )
        End For
    End For

End Sub

Function DrawSocketGizmos() As Boolean

    Dim Result As Boolean
    Dim Index As Number

    Result = True

    For Index = 0 To SocketGizmoCount - 1
        Result = Graphics3D.DrawObject3D(SocketGizmos[Index]) And Result
    End For

    Return Result

End Function

Sub AdjustPlaybackSpeed(Amount As Number)

    PlaybackSpeed = Min(ActiveProfile.MaximumPlaybackSpeed,
        Max(ActiveProfile.MinimumPlaybackSpeed, PlaybackSpeed + Amount))

    Call PlaySelectedClip()

End Sub

Sub ClampCameraControls()

    CameraControls.PanX = Min(ViewerFrame.PanXLimit,
        Max(0 - ViewerFrame.PanXLimit, CameraControls.PanX))
    CameraControls.PanY = Min(ViewerFrame.PanYLimit,
        Max(0 - ViewerFrame.PanYLimit, CameraControls.PanY))
    CameraControls.OrbitPitch = Min(ORBIT_PITCH_LIMIT,
        Max(0 - ORBIT_PITCH_LIMIT, CameraControls.OrbitPitch))

End Sub

Sub NudgeOrbit(DeltaX As Number, DeltaY As Number)

    AutoOrbit = False
    Ready = Interaction.UpdateOrbitControls(
        CameraControls,
        True,
        True,
        True,
        DeltaX,
        DeltaY
    ) And Ready

    Call ClampCameraControls()

End Sub

Sub NudgePan(DeltaX As Number, DeltaY As Number)

    Ready = Interaction.UpdatePanZoomControls(
        CameraControls,
        True,
        True,
        True,
        DeltaX,
        DeltaY,
        0
    ) And Ready

    Call ClampCameraControls()

End Sub

Sub NudgeZoom(WheelDelta As Number)

    Call AdjustZoomTarget(WheelDelta)

End Sub

Sub AdjustZoomTarget(WheelDelta As Number)

    Call CharacterViewer.AdjustZoomTarget(SmoothZoom, WheelDelta, 4)

End Sub

Sub AdvanceSmoothZoom()

    Ready = CharacterViewer.AdvanceZoom(SmoothZoom, FrameMilliseconds) And Ready
    CameraControls.Zoom = CharacterViewer.ZoomDegrees(SmoothZoom)

End Sub

Sub ResetView()

    Call Interaction.ResetCameraControls(CameraControls)

    AutoOrbit = False
    AutoOrbitYaw1000 = 0
    PanPointerRemainderX = 0
    PanPointerRemainderY = 0

    Call CharacterViewer.InitializeZoom(SmoothZoom, 0, ZOOM_IN_LIMIT, ZOOM_OUT_LIMIT, 48000)

End Sub

Sub ToggleDragMode()

    If DragMode = DRAG_ORBIT Then
        DragMode = DRAG_PAN
    Else
        DragMode = DRAG_ORBIT
    End If

End Sub

Sub CycleLighting()

    LightingIndex = (LightingIndex + 1) Mod 4

    Call ApplyLighting()

End Sub

Sub ApplyLighting()

    If LightingIndex = 0 Then

        Ready = Graphics3D.ClearAdditionalLights3DChecked() And Ready
        Ready = Graphics3D.SetAmbientLight3D(255, 255, 255, 68) And Ready
        Ready = Graphics3D.SetDirectionalLight3D(-35, -80, 25, 255, 248, 235, 220) And Ready
        Ready = Graphics3D.SetPointLight3D(0, -80, 120, -30, 170, 205, 255, 260, 360) And Ready
        Ready = Graphics3D.SetPointLight3D(1, 80, 80, 0, 255, 205, 145, 180, 300) And Ready

        Call Scene3D.UseCustomLighting()

    Else If LightingIndex = 1 Then

        Ready = Scene3D.UseLighting("CharacterStudio") And Ready

    Else If LightingIndex = 2 Then

        Ready = Scene3D.UseLighting("Daylight") And Ready

    Else
        Ready = Scene3D.UseLighting("Moonlight") And Ready

    End If

End Sub

Sub PlaySelectedClip()

    Ready = Character3D.PlayMode(
        Character,
        SelectedClipName(),
        SelectedClipMode(),
        PlaybackSpeed
    ) And Ready

End Sub

Function SelectedClipName() As Text

    Dim Result As Text

    Result = ViewerProfiles.ClipName(ProfileIndex, SelectedClip)

    Return Result

End Function

Function SelectedClipLabel() As Text

    Dim Result As Text

    Result = ViewerProfiles.ClipLabel(ProfileIndex, SelectedClip)

    Return Result

End Function

Function SelectedClipMode() As Number

    Dim Result As Number

    If ViewerProfiles.ClipLoops(ProfileIndex, SelectedClip) Then
        Result = Graphics3D.ANIMATION_LOOP
    Else
        Result = Graphics3D.ANIMATION_ONCE
    End If

    Return Result

End Function

Function LightingLabel() As Text

    Dim Result As Text

    If LightingIndex = 0 Then
        Result = "Viewer Studio"
    Else If LightingIndex = 1 Then
        Result = "Character Studio"
    Else If LightingIndex = 2 Then
        Result = "Daylight"
    Else
        Result = "Moonlight"
    End If

    Return Result

End Function

Function DragModeLabel() As Text

    Dim Result As Text

    If DragMode = DRAG_ORBIT Then
        Result = "Orbit"
    Else
        Result = "Pan"
    End If

    Return Result

End Function

Function PointerInRectangle(X As Number, Y As Number, Width As Number, Height As Number) As Boolean

    Dim ReturnValue As Boolean

    ReturnValue = (Pointer_X() >= X And
        Pointer_X() < X + Width And
        Pointer_Y() >= Y And
        Pointer_Y() < Y + Height)

    Return ReturnValue

End Function

Sub DrawViewerOverlay()

    Dim Subtitle As Text

    Subtitle = ActiveProfile.DisplayName + "  •  Party role: " + PartyRoleLabel() + "  •  Renderer3D PBR"

    Fill Rectangle 0, 0, 960, 70, Rgb(3, 7, 18)
    Draw Text "SMILE CHARACTER 3D VIEWER" At 18, 10 Size 22 Color CYAN
    Draw Text Subtitle At 18, 42 Size 13 Color LIGHT_GRAY

    Call DrawButton(510, 18, 62, 34, ViewerProfiles.ClipLabel(ProfileIndex, 0), SelectedClip = 0)
    Call DrawButton(578, 18, 62, 34, ViewerProfiles.ClipLabel(ProfileIndex, 1), SelectedClip = 1)
    Call DrawButton(646, 18, 62, 34, ViewerProfiles.ClipLabel(ProfileIndex, 2), SelectedClip = 2)
    Call DrawButton(714, 18, 82, 34, "LIGHT", False)
    Call DrawButton(802, 18, 70, 34, "DRAG", False)
    Call DrawButton(878, 18, 66, 34, "PROFILE", False)

    Fill Rectangle 716, 82, 228, 342, Rgb(4, 9, 24)
    Draw Text "CHARACTER STATUS" At 732, 98 Size 16 Color WHITE
    Draw Text "Name" At 732, 130 Size 12 Color LIGHT_GRAY
    Draw Text ActiveProfile.DisplayName At 822, 130 Size 12 Color CYAN
    Draw Text "Party Role" At 732, 154 Size 12 Color LIGHT_GRAY
    Draw Text PartyRoleLabel() At 822, 154 Size 12 Color CYAN
    Draw Text "Animation" At 732, 178 Size 12 Color LIGHT_GRAY
    Draw Text SelectedClipLabel() At 822, 178 Size 12 Color GREEN
    Draw Text "Production Gate" At 732, 202 Size 12 Color LIGHT_GRAY
    Draw Text ProductionClipStatusLabel() At 842, 202 Size 11 Color YELLOW
    Draw Text "Speed" At 732, 222 Size 12 Color LIGHT_GRAY
    Draw Number PlaybackSpeed At 822, 222 Size 12 Color WHITE

    Call DrawButton(868, 214, 30, 24, "-", False)
    Call DrawButton(904, 214, 30, 24, "+", False)

    Draw Text "Material" At 732, 250 Size 12 Color LIGHT_GRAY
    Draw Text MaterialInspectionLabel() At 822, 250 Size 12 Color YELLOW
    Draw Text "Drag" At 732, 274 Size 12 Color LIGHT_GRAY
    Draw Text DragModeLabel() At 822, 274 Size 12 Color WHITE
    Draw Text "Zoom / Target" At 732, 298 Size 12 Color LIGHT_GRAY
    Draw Number CharacterViewer.ZoomDegrees(SmoothZoom) At 842, 298 Size 12 Color WHITE
    Draw Number CharacterViewer.ZoomTargetDegrees(SmoothZoom) At 894, 298 Size 12 Color WHITE
    Draw Text "Draws / Triangles" At 732, 322 Size 12 Color LIGHT_GRAY
    Draw Number Graphics3D.DrawCallCount3D() At 856, 322 Size 12 Color WHITE
    Draw Number Graphics3D.SubmittedTriangleCount3D() At 896, 322 Size 12 Color WHITE
    Draw Text "Auto Orbit (O)" At 732, 346 Size 12 Color LIGHT_GRAY
    Draw Text AutoOrbitLabel() At 842, 346 Size 12 Color CYAN

    Call DrawButton(732, 374, 92, 30, "SOCKETS", SocketGizmosVisible)

    Draw Text SocketStatusLabel() At 836, 384 Size 11 Color LIGHT_GRAY
    Fill Rectangle 0, 458, 960, 82, Rgb(3, 7, 18)
    Draw Text "Drag character to orbit  •  Switch DRAG for pan  •  Wheel or buttons zoom  •  Middle orbit  •  Right pan" At 14, 462 Size 11 Color LIGHT_GRAY

    Call DrawButton(12, 482, 70, 36, "ORBIT <", False)
    Call DrawButton(88, 482, 70, 36, "ORBIT >", False)
    Call DrawButton(164, 482, 70, 36, "ORBIT ^", False)
    Call DrawButton(240, 482, 70, 36, "ORBIT V", False)
    Call DrawButton(316, 482, 70, 36, "PAN <", False)
    Call DrawButton(392, 482, 70, 36, "PAN >", False)
    Call DrawButton(468, 482, 70, 36, "PAN ^", False)
    Call DrawButton(544, 482, 70, 36, "PAN V", False)
    Call DrawButton(620, 482, 70, 36, "ZOOM +", False)
    Call DrawButton(696, 482, 70, 36, "ZOOM -", False)
    Call DrawButton(772, 482, 82, 36, "CHANNEL", False)
    Call DrawButton(860, 482, 84, 36, "RESET", False)

    If ViewerError Then

        Fill Rectangle 120, 142, 580, 190, Rgb(56, 8, 18)
        Draw Text "CHARACTER VIEWER RECOVERY" At 148, 166 Size 22 Color WHITE
        Draw Text "The 3D renderer or character resource became unavailable." At 148, 204 Size 14 Color LIGHT_GRAY
        Draw Text "Viewer error" At 148, 238 Size 13 Color LIGHT_GRAY
        Draw Number FirstViewerError At 270, 238 Size 13 Color YELLOW
        Draw Text "Renderer error" At 348, 238 Size 13 Color LIGHT_GRAY
        Draw Number FirstRendererError At 486, 238 Size 13 Color YELLOW
        Draw Text "Press Enter or Reset to reload the profile safely." At 148, 280 Size 14 Color CYAN

    End If

End Sub

Function ProductionClipStatusLabel() As Text

    Dim Result As Text

    If ProfileIndex = ViewerProfiles.PROFILE_ARIN Then
        Result = "7 clips missing"
    Else
        Result = "Technical fixture"
    End If

    Return Result

End Function

Function SocketStatusLabel() As Text

    Dim Result As Text

    If SocketGizmosVisible Then
        Result = "Prototype aliases"
    Else
        Result = "Hidden"
    End If

    Return Result

End Function

Function PartyRoleLabel() As Text

    Dim Result As Text

    Result = ActiveProfile.PartyRole

    If Result = "" Then
        Result = "Technical"
    End If

    Return Result

End Function

Function MaterialInspectionLabel() As Text

    Dim Result As Text

    If MaterialInspection = Graphics3D.MATERIAL_INSPECTION_LIT Then
        Result = "Lit"
    Else If MaterialInspection = Graphics3D.MATERIAL_INSPECTION_BASE_COLOR Then
        Result = "Base Color"
    Else If MaterialInspection = Graphics3D.MATERIAL_INSPECTION_NORMAL Then
        Result = "Normal"
    Else If MaterialInspection = Graphics3D.MATERIAL_INSPECTION_ROUGHNESS Then
        Result = "Roughness"
    Else If MaterialInspection = Graphics3D.MATERIAL_INSPECTION_METALLIC Then
        Result = "Metallic"
    Else If MaterialInspection = Graphics3D.MATERIAL_INSPECTION_OCCLUSION Then
        Result = "Occlusion"
    Else
        Result = "Emissive"
    End If

    Return Result

End Function

Function AutoOrbitLabel() As Text

    Dim Result As Text

    If AutoOrbit Then
        Result = "On"
    Else
        Result = "Off"
    End If

    Return Result

End Function

Sub DrawButton(
    X As Number,
    Y As Number,
    Width As Number,
    Height As Number,
    Label As Text,
    Selected As Boolean
)

    If Selected Then
        Fill Rectangle X, Y, Width, Height, Rgb(16, 102, 136)
    Else
        Fill Rectangle X, Y, Width, Height, Rgb(18, 35, 58)
    End If

    Draw Text Label At X + 7, Y + 11 Size 11 Color WHITE

End Sub

Sub DestroyViewer()

    Call DestroyViewerResources()
    Call Character3D.Shutdown()
    Call Scene3D.Shutdown()
    Call Graphics3D.ResetRenderer3D()

End Sub

Sub DestroyViewerResources()

    Dim Index As Number

    Call Character3D.Destroy(Character)
    Call Graphics3D.DestroyObject3D(Floor)

    For Index = 0 To SocketGizmoCount - 1
        Call Graphics3D.DestroyObject3D(SocketGizmos[Index])
    End For

    SocketGizmoCount = 0

End Sub
