Option Explicit

Import Smile.Simple3D.Character3D As Character3D
Import Smile.Simple3D.Graphics3D As Graphics3D
Import Dragonfall.Battle As Battle
Import Dragonfall.Scene As Scene

Dim ArinBounds As Character3D.Bounds3D
Dim Failures As Number
Dim Ready As Boolean
Dim ReadyPlayer As Number
Dim Submitted As Boolean
Dim StepValue As Number

Game Window "Dragonfall2 Integration Tests" Size 480 By 270

Call Graphics3D.ResetRenderer3D()
Call Scene.ConfigureDragonfall2(True)

Ready = Battle.Initialize()

If Ready Then
    Ready = Scene.Initialize(Battle.StateHandle())
End If

Call Check(Ready, "initial scene ready")
Call Check(Battle.ActiveEnemyCount() = 3, "wave one enemy count")
Call Check(Not Battle.BossIsIntroduced(), "boss initially absent")
Call Check(Scene.UsesGeneration2Arin(), "generation two Arin active")
Call Check(Scene.EnhancedVfxIsReady(), "enhanced VFX ready")
Call Check(Scene.Generation2ArinRequestedClip() = "Idle", "Arin idle requested")
Call Check(Scene.Generation2ArinActualClip() = "Idle", "Arin idle active")
Call Check(Character3D.LiveActorCount() = 1, "one Character3D actor")
Call Check(Graphics3D.MaximumObjectCount3D() = 1024, "live object capacity")
Call Check(Graphics3D.LiveObjectCount3D() = 445, "wave one object count")

For StepValue = 1 To 6
    Call Battle.Update()
    Call Scene.Update(Battle.StateHandle(), StepValue)
End For

Call Scene.Draw()

Show Screen

Call Check(Scene.LastFrameWasReady(), "wave one draw")

Call CheckArin("wave one")

Do

    ReadyPlayer = Battle.NextReadyPlayer()

    If ReadyPlayer > 0 Then

        Submitted = Battle.SubmitPlayerCommand(ReadyPlayer, Battle.COMMAND_SPECIAL)

        If Not Submitted Then
            Submitted = Battle.SubmitPlayerCommand(ReadyPlayer, Battle.COMMAND_ATTACK)
        End If

    End If

    Call Battle.Update()

    StepValue = StepValue + 1

    Call Scene.Update(Battle.StateHandle(), StepValue)

Loop Until Battle.BossIsIntroduced() Or StepValue >= 20000 Or Not Scene.IsReady()

Call Check(Battle.BossIsIntroduced(), "wave two introduced")
Call Check(Scene.IsReady(), "wave two scene ready")
Call Check(
    Scene.BossResourceActual() = Scene.BossResourceExpected(),
    "wave two object count"
)
Call Check(Scene.BossResourceHeadroom() >= 64, "wave two resource headroom")

If Scene.IsReady() Then

    Call Scene.Draw()

    Show Screen

    Call Check(Scene.LastFrameWasReady(), "wave two draw")

    Call CheckArin("wave two")

End If

Call Scene.Shutdown()
Call Battle.Shutdown()

Call Check(Character3D.LiveActorCount() = 0, "actor cleanup")
Call Check(Graphics3D.LiveMeshCount3D() = 0, "mesh cleanup")
Call Check(Graphics3D.LiveObjectCount3D() = 0, "object cleanup")
Call Check(Graphics3D.LiveMaterialCount3D() = 0, "material cleanup")
Call Check(Graphics3D.LiveTextureCount3D() = 0, "texture cleanup")
Call Check(Graphics3D.LiveSkeletonCount3D() = 0, "skeleton cleanup")
Call Check(Graphics3D.LiveAnimationClipCount3D() = 0, "clip cleanup")
Call Check(Graphics3D.LiveAnimatorCount3D() = 0, "animator cleanup")

Ready = Battle.Initialize()

If Ready Then
    Ready = Scene.Initialize(Battle.StateHandle())
End If

If Not Ready Then

    Print "Second encounter renderer error: "; Graphics3D.LastError()
    Print "Second encounter objects after rollback: "; Graphics3D.LiveObjectCount3D()
    Print "Second encounter meshes after rollback: "; Graphics3D.LiveMeshCount3D()
    Print "Second encounter materials after rollback: "; Graphics3D.LiveMaterialCount3D()
    Print "Second encounter textures after rollback: "; Graphics3D.LiveTextureCount3D()

End If

Call Check(Ready, "second encounter scene ready")
Call Check(Scene.IsReady(), "second encounter renderer ready")
Call Check(Scene.UsesGeneration2Arin(), "second encounter generation two Arin active")
Call Check(Scene.Generation2ArinActualClip() = "Idle", "second encounter Arin idle active")
Call Check(Graphics3D.LiveObjectCount3D() = 445, "second encounter object count")

If Ready Then

    Call Scene.Update(Battle.StateHandle(), StepValue + 1)
    Call Scene.Draw()

    Show Screen

    Call Check(Scene.LastFrameWasReady(), "second encounter draw")

End If

Call Scene.Shutdown()
Call Battle.Shutdown()

Call Check(Character3D.LiveActorCount() = 0, "second encounter actor cleanup")
Call Check(Graphics3D.LiveObjectCount3D() = 0, "second encounter object cleanup")

Call Graphics3D.ResetRenderer3D()

If Failures = 0 Then

    Print "Dragonfall2 integration tests passed"

Else
    Print "Dragonfall2 integration tests failed: "; Failures
    Print "Boss resources expected: "; Scene.BossResourceExpected()
    Print "Boss resources actual: "; Scene.BossResourceActual()
    Print "Boss resource error: "; Scene.BossResourceError()
    Print "Boss resource headroom: "; Scene.BossResourceHeadroom()
    Print "Boss invalid part: "; Scene.BossInvalidPart()
    Print "Boss created at audit: "; Scene.BossCreatedAtAudit()
    Print "Cinderlings created at boss audit: "; Scene.CinderlingsCreatedAtBossAudit()

End If

Sub CheckArin(PhaseName As Text)

    ArinBounds = Scene.Generation2ArinBounds()

    Call Check(Scene.Generation2ArinIsVisible(), PhaseName + " Arin visible")

    Call Check(Scene.Generation2ArinWasDrawn(), PhaseName + " Arin drawn")

    Call Check(ArinBounds.Valid, PhaseName + " Arin bounds valid")

    If (ArinBounds.Center.X < -1060000 Or
        ArinBounds.Center.X > -800000 Or
        ArinBounds.Center.Z < -460000 Or
        ArinBounds.Center.Z > -200000) Then
        Print PhaseName; " Arin center: "; ArinBounds.Center.X; ", "; ArinBounds.Center.Z
    End If

    If ArinBounds.Size.Y < 220000 Or ArinBounds.Size.Y > 270000 Then
        Print PhaseName; " Arin height: "; ArinBounds.Size.Y
    End If

    Call Check(
        ArinBounds.Size.Y >= 220000 And ArinBounds.Size.Y <= 270000,
        PhaseName + " Arin height"
    )

    Call Check(
        ArinBounds.Center.X >= -1060000 And ArinBounds.Center.X <= -800000,
        PhaseName + " Arin centered X"
    )

    Call Check(
        ArinBounds.Center.Z >= -460000 And ArinBounds.Center.Z <= -200000,
        PhaseName + " Arin centered Z"
    )

    Call Check(Graphics3D.DrawCallCount3D() >= 4, PhaseName + " draw calls")

    Call Check(Graphics3D.SubmittedTriangleCount3D() >= 10296, PhaseName + " triangles")

End Sub

Sub Check(Condition As Boolean, Name As Text)

    If Not Condition Then
        Failures = Failures + 1
        Print "FAILED: "; Name
    End If

End Sub
