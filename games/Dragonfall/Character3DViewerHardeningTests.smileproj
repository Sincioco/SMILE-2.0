<SmileProject Version="1.0">
  <PropertyGroup>
    <ProjectKind>Game</ProjectKind>
    <StartupFile>..\..\tools\Character3DViewer\HardeningTests.smile</StartupFile>
    <OutputName>Character3DViewerHardeningTests</OutputName>
    <ApplicationId>smile.tests.character3d-viewer-hardening</ApplicationId>
  </PropertyGroup>
  <ItemGroup>
    <SmileSource Include="..\..\tools\Character3DViewer\HardeningTests.smile" StartupOnly="true" />
    <SmileSource Include="..\..\tools\Character3DViewer\Profiles.smile" />
    <SmileProjectReference Include="..\..\libraries\Smile.Simple3D\Smile.Simple3D.smilelibproj" />
  </ItemGroup>
</SmileProject>
