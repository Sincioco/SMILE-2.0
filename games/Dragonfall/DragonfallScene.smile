Private Dim CurrentActionShot As Number

Private Function Material(
    RedValue As Number,
    GreenValue As Number,
    BlueValue As Number,
    EmissiveValue As Number,
    Additive As Boolean
) As Core.Material3D

    Dim ReturnValue As Core.Material3D

    Dim AlphaMode As Number

    AlphaMode = Graphics3D.MATERIAL_ALPHA_OPAQUE

    If Additive Then
        AlphaMode = Graphics3D.MATERIAL_ALPHA_ADDITIVE
    End If

    ReturnValue = Graphics3D.CreateMaterial3D(
        EmptyTexture,
        AlphaMode,
        RedValue,
        GreenValue,
        BlueValue,
        100,
        EmissiveValue > 0,
        EmissiveValue,
        50
    )

    Return ReturnValue

End Function

Private Sub Configure(
    ByRef Object As Core.Object3D,
    MaterialValue As Core.Material3D,
    X As Number,
    Y As Number,
    Z As Number,
    ScaleX As Number,
    ScaleY As Number,
    ScaleZ As Number
)

    OperationAccepted = Graphics3D.SetObjectMaterial3D(Object, MaterialValue)

    Call Graphics3D.SetObjectPosition(Object, X, Y, Z)
    Call Graphics3D.SetObjectScale(Object, ScaleX, ScaleY, ScaleZ)

End Sub

Private Sub DefineCameraShot(
    Id As Number,
    Name As Text,
    X As Number,
    Y As Number,
    Z As Number,
    TargetX As Number,
    TargetY As Number,
    TargetZ As Number,
    Fov As Number,
    Duration As Number
)

    Dim Shot As BattleCamera.ShotDefinition

    Shot.Id = Id
    Shot.Name = Name
    Shot.PositionX = X
    Shot.PositionY = Y
    Shot.PositionZ = Z
    Shot.TargetX = TargetX
    Shot.TargetY = TargetY
    Shot.TargetZ = TargetZ
    Shot.FovDegrees = Fov
    Shot.Duration = Duration
    OperationAccepted = BattleCamera.DefineShot(State, Shot)

End Sub

Private Sub DefineEffect(
    Id As Number,
    Name As Text,
    ParticleCountValue As Number,
    LifetimeValue As Number,
    SpeedValue As Number,
    SpreadValue As Number,
    GravityValue As Number,
    StartRedValue As Number,
    StartGreenValue As Number,
    StartBlueValue As Number,
    EndRedValue As Number,
    EndGreenValue As Number,
    EndBlueValue As Number,
    StartSizeValue As Number,
    EndSizeValue As Number,
    FlashValue As Number,
    ShakeValue As Number
)

    Dim Preset As BattleEffects.EffectPreset

    Preset.Id = Id
    Preset.Name = Name
    Preset.ParticleCount = ParticleCountValue
    Preset.Lifetime = LifetimeValue
    Preset.Speed = SpeedValue
    Preset.Spread = SpreadValue
    Preset.Gravity = GravityValue
    Preset.StartRed = StartRedValue
    Preset.StartGreen = StartGreenValue
    Preset.StartBlue = StartBlueValue
    Preset.EndRed = EndRedValue
    Preset.EndGreen = EndGreenValue
    Preset.EndBlue = EndBlueValue
    Preset.StartSize = StartSizeValue
    Preset.EndSize = EndSizeValue
    Preset.BlendMode = BattleEffects.BATTLE3D_BLEND_ADDITIVE
    Preset.Billboard = True
    Preset.FlashPercent = FlashValue
    Preset.FlashDuration = 8
    Preset.ShakeAmplitude = ShakeValue
    OperationAccepted = BattleEffects.DefinePreset(State, Preset)

End Sub

Private Sub CreateArena()

    Arena[0] = Graphics3D.CreatePlane3D(2100, 1450)
    OperationAccepted = Graphics3D.SetObjectMaterial3D(Arena[0], FloorMaterial)

    Call Graphics3D.SetObjectPosition(Arena[0], 0, -55, 30)

    Arena[1] = Graphics3D.CreateTorus3D(690, 15)

    Call Configure(Arena[1], LavaMaterial, 0, -42, 30, 100, 100, 100)

    Arena[2] = Graphics3D.CreateTorus3D(555, 7)

    Call Configure(Arena[2], BronzeMaterial, 0, -38, 30, 100, 100, 100)

    Arena[3] = Graphics3D.CreateCube3D(100)

    Call Configure(Arena[3], LavaMaterial, 0, -43, 30, 1500, 8, 5)

    Arena[4] = Graphics3D.CreateCube3D(100)

    Call Configure(Arena[4], LavaMaterial, 0, -43, 30, 5, 8, 1120)

    Arena[5] = Graphics3D.CreateCylinder3D(28, 180)

    Call Configure(Arena[5], StoneMaterial, -780, 30, -520, 125, 150, 125)

    Arena[6] = Graphics3D.CreateCylinder3D(28, 180)

    Call Configure(Arena[6], StoneMaterial, 780, 30, -520, 125, 150, 125)

    Arena[7] = Graphics3D.CreateCylinder3D(28, 180)

    Call Configure(Arena[7], StoneMaterial, -780, 30, 580, 125, 150, 125)

    Arena[8] = Graphics3D.CreateCylinder3D(28, 180)

    Call Configure(Arena[8], StoneMaterial, 780, 30, 580, 125, 150, 125)

    Arena[9] = Graphics3D.CreateSphere3D(20)

    Call Configure(Arena[9], LavaMaterial, -780, 188, -520, 130, 130, 130)

    Arena[10] = Graphics3D.CreateSphere3D(20)

    Call Configure(Arena[10], LavaMaterial, 780, 188, -520, 130, 130, 130)

    Arena[11] = Graphics3D.CreateTorus3D(845, 4)

    Call Configure(Arena[11], LavaMaterial, 0, -48, 30, 100, 100, 100)

End Sub

Private Sub MovePartyFormation(IndexStart As Number, IndexEnd As Number, DeltaX As Number, DeltaZ As Number)

    Dim Index As Number

    For Index = IndexStart To IndexEnd
        Call Graphics3D.MoveObject(PartyParts[Index], DeltaX, 0, DeltaZ)
    End For

End Sub

