''' Procedural Dragonfall arena, actors, cameras, and battle effects.
Module Dragonfall.Scene

Option Explicit

Import Smile.Simple3D.Core As Core
Import Smile.Simple3D.FixedMath As Math3D
Import Smile.Simple3D.Graphics3D As Graphics3D
Import Smile.Battle3D.Camera As BattleCamera
Import Smile.Battle3D.Effects As BattleEffects
Import Dragonfall.Battle As Battle

Public Const SHOT_WIDE = 1
