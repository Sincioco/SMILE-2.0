Private Const DRAGON_ROOT_Z = 45
Private Const DRAGON_SCALE_PERCENT = 200
Private Const CINDERLING_MINION_SCALE_PERCENT = 135
Private Const CINDER_WARDEN_SCALE_PERCENT = 165
Private Const PARTY_CENTER_X = -960
Private Const PARTY_CENTER_Z = 30
