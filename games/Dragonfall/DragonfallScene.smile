Private Function Material(
    RedValue As Number,
    GreenValue As Number,
    BlueValue As Number,
    EmissiveValue As Number,
    Additive As Boolean
) As Core.Material3D

    Dim ReturnValue As Core.Material3D

    Dim AlphaMode As Number

    AlphaMode = Graphics3D.MATERIAL_ALPHA_OPAQUE

    If Additive Then
        AlphaMode = Graphics3D.MATERIAL_ALPHA_ADDITIVE
    End If

    ReturnValue = Graphics3D.CreateMaterial3D(
        EmptyTexture,
        AlphaMode,
        RedValue,
        GreenValue,
        BlueValue,
        100,
        EmissiveValue > 0,
        EmissiveValue,
        50
    )

    Return ReturnValue

End Function

Private Sub Configure(
    ByRef Object As Core.Object3D,
    MaterialValue As Core.Material3D,
    X As Number,
    Y As Number,
    Z As Number,
    ScaleX As Number,
    ScaleY As Number,
    ScaleZ As Number
)

    OperationAccepted = Graphics3D.SetObjectMaterial3D(Object, MaterialValue)

    Call Graphics3D.SetObjectPosition(Object, X, Y, Z)
    Call Graphics3D.SetObjectScale(Object, ScaleX, ScaleY, ScaleZ)

End Sub

Private Sub CreateRigTemplates()

    Dim Index As Number
    Dim WingMesh As Number

    RigTemplates[RIG_CUBE] = Graphics3D.CreateCube3D(100)
    RigTemplates[RIG_SPHERE] = Graphics3D.CreateSphere3D(50)
    RigTemplates[RIG_CYLINDER] = Graphics3D.CreateCylinder3D(10, 100)
    RigTemplates[RIG_PYRAMID] = Graphics3D.CreatePyramid3D(100, 100)
    RigTemplates[RIG_TORUS] = Graphics3D.CreateTorus3D(50, 8)
    ''' A shallow triangular prism stays visible from oblique action cameras and
    ''' gives broad low-poly wings a solid, connected silhouette.
    WingMesh = Graphics3D.CreateMesh3D(6, 24)
    ''' Segment transforms map local negative Y to the parent joint. Keep the
    ''' broad membrane edge there and taper toward positive Y so every span is
    ''' rooted in its parent mass instead of flaring away from it.
    OperationAccepted = Graphics3D.SetMeshVertex3D(WingMesh, 0, -50, -50, -50)
    OperationAccepted = Graphics3D.SetMeshVertex3D(WingMesh, 1, 50, -50, -50)
    OperationAccepted = Graphics3D.SetMeshVertex3D(WingMesh, 2, 0, 50, -50)
    OperationAccepted = Graphics3D.SetMeshVertex3D(WingMesh, 3, -50, -50, 50)
    OperationAccepted = Graphics3D.SetMeshVertex3D(WingMesh, 4, 50, -50, 50)
    OperationAccepted = Graphics3D.SetMeshVertex3D(WingMesh, 5, 0, 50, 50)
    OperationAccepted = Graphics3D.SetMeshTriangle3D(WingMesh, 0, 0, 1, 2)
    OperationAccepted = Graphics3D.SetMeshTriangle3D(WingMesh, 1, 5, 4, 3)
    OperationAccepted = Graphics3D.SetMeshTriangle3D(WingMesh, 2, 0, 3, 4)
    OperationAccepted = Graphics3D.SetMeshTriangle3D(WingMesh, 3, 0, 4, 1)
    OperationAccepted = Graphics3D.SetMeshTriangle3D(WingMesh, 4, 1, 4, 5)
    OperationAccepted = Graphics3D.SetMeshTriangle3D(WingMesh, 5, 1, 5, 2)
    OperationAccepted = Graphics3D.SetMeshTriangle3D(WingMesh, 6, 2, 5, 3)
    OperationAccepted = Graphics3D.SetMeshTriangle3D(WingMesh, 7, 2, 3, 0)
    OperationAccepted = Graphics3D.CommitMesh3D(WingMesh)
    RigTemplates[RIG_WING] = Graphics3D.CreateObjectFromMesh3D(WingMesh)

    For Index = 0 To RIG_TEMPLATE_COUNT - 1
        Call Graphics3D.SetObjectVisible(RigTemplates[Index], False)
    End For

End Sub

Private Function CreateRigPart(Shape As Number) As Core.Object3D

    Dim ReturnValue As Core.Object3D

    If Shape < 0 Or Shape >= RIG_TEMPLATE_COUNT Then
        Return ReturnValue
    End If

    ReturnValue = Graphics3D.CreateObjectFromMesh3D(RigTemplates[Shape].MeshHandle)
    Return ReturnValue

End Function

Private Sub InitializeRigPart(
    ByRef Object As Core.Object3D,
    Shape As Number,
    MaterialValue As Core.Material3D
)

    Object = CreateRigPart(Shape)
    OperationAccepted = Graphics3D.SetObjectMaterial3D(Object, MaterialValue)

End Sub

Private Sub ApplySegment(
    ByRef Object As Core.Object3D,
    Pose As Articulation.SegmentPose3D,
    Radius As Number
)

    Call Graphics3D.SetObjectPosition(Object, Pose.CenterX, Pose.CenterY, Pose.CenterZ)
    Call Graphics3D.SetObjectScale(Object, Radius * 10, Pose.Length, Radius * 10)
    Call Graphics3D.SetObjectRotation(Object, Pose.RotationX, Pose.RotationY, Pose.RotationZ)

End Sub

Private Sub ApplyPart(
    ByRef Object As Core.Object3D,
    X As Number,
    Y As Number,
    Z As Number,
    ScaleX As Number,
    ScaleY As Number,
    ScaleZ As Number,
    RotationX As Number,
    RotationY As Number,
    RotationZ As Number
)

    Call Graphics3D.SetObjectPosition(Object, X, Y, Z)
    Call Graphics3D.SetObjectScale(Object, ScaleX, ScaleY, ScaleZ)
    Call Graphics3D.SetObjectRotation(Object, RotationX, RotationY, RotationZ)

End Sub

Private Sub DefineCameraShot(
    Id As Number,
    Name As Text,
    X As Number,
    Y As Number,
    Z As Number,
    TargetX As Number,
    TargetY As Number,
    TargetZ As Number,
    Fov As Number,
    Duration As Number
)

    Dim Shot As BattleCamera.ShotDefinition

    Shot.Id = Id
    Shot.Name = Name
    Shot.PositionX = X
    Shot.PositionY = Y
    Shot.PositionZ = Z
    Shot.TargetX = TargetX
    Shot.TargetY = TargetY
    Shot.TargetZ = TargetZ
    Shot.FovDegrees = Fov
    Shot.Duration = Duration
    OperationAccepted = BattleCamera.DefineShot(State, Shot)

End Sub

Private Sub DefineEffect(
    Id As Number,
    Name As Text,
    ParticleCountValue As Number,
    LifetimeValue As Number,
    SpeedValue As Number,
    SpreadValue As Number,
    GravityValue As Number,
    StartRedValue As Number,
    StartGreenValue As Number,
    StartBlueValue As Number,
    EndRedValue As Number,
    EndGreenValue As Number,
    EndBlueValue As Number,
    StartSizeValue As Number,
    EndSizeValue As Number,
    FlashValue As Number,
    ShakeValue As Number
)

    Dim Preset As BattleEffects.EffectPreset

    Preset.Id = Id
    Preset.Name = Name
    Preset.ParticleCount = ParticleCountValue
    Preset.Lifetime = LifetimeValue
    Preset.Speed = SpeedValue
    Preset.Spread = SpreadValue
    Preset.Gravity = GravityValue
    Preset.StartRed = StartRedValue
    Preset.StartGreen = StartGreenValue
    Preset.StartBlue = StartBlueValue
    Preset.EndRed = EndRedValue
    Preset.EndGreen = EndGreenValue
    Preset.EndBlue = EndBlueValue
    Preset.StartSize = StartSizeValue
    Preset.EndSize = EndSizeValue
    Preset.BlendMode = BattleEffects.BATTLE3D_BLEND_ADDITIVE
    Preset.Billboard = True
    Preset.FlashPercent = FlashValue
    Preset.FlashDuration = 8
    Preset.ShakeAmplitude = ShakeValue
    OperationAccepted = BattleEffects.DefinePreset(State, Preset)

End Sub

Private Sub CreateArena()

    Dim LineIndex As Number
    Dim ObjectIndex As Number
    Dim Coordinate As Number

    ''' Oversized near-black ground and emissive blue lines keep every camera
    ''' frustum inside the grid, so orbiting and wide shots never reveal an edge.

    Arena[0] = Graphics3D.CreatePlane3D(10000, 10000)
    OperationAccepted = Graphics3D.SetObjectMaterial3D(Arena[0], FloorMaterial)

    Call Graphics3D.SetObjectPosition(Arena[0], 0, -55, 30)

    ObjectIndex = 1

    For LineIndex = 0 To 16
        Coordinate = -3200 + LineIndex * 400
        Arena[ObjectIndex] = Graphics3D.CreateCube3D(100)

        Call Configure(Arena[ObjectIndex], GridMaterial, 0, -51, Coordinate + 30, 9000, 3, 7)

        ObjectIndex = ObjectIndex + 1
    End For

    For LineIndex = 0 To 16
        Coordinate = -3200 + LineIndex * 400
        Arena[ObjectIndex] = Graphics3D.CreateCube3D(100)

        Call Configure(Arena[ObjectIndex], GridMaterial, Coordinate, -51, 30, 7, 3, 9000)

        ObjectIndex = ObjectIndex + 1
    End For

    ''' Four distant textured walls surround the grid. Each wall is far beyond
    ''' combat bounds and tall enough for low, wide, close-up, and orbit shots,
    ''' creating a static cosmic panorama without adding runtime particles.

    Arena[ObjectIndex] = Graphics3D.CreateCube3D(100)

    Call Configure(Arena[ObjectIndex], CosmicMaterial, 4500, 1100, 30, 18, 2500, 9000)

    ObjectIndex = ObjectIndex + 1
    Arena[ObjectIndex] = Graphics3D.CreateCube3D(100)

    Call Configure(Arena[ObjectIndex], CosmicMaterial, -4500, 1100, 30, 18, 2500, 9000)

    ObjectIndex = ObjectIndex + 1
    Arena[ObjectIndex] = Graphics3D.CreateCube3D(100)

    Call Configure(Arena[ObjectIndex], CosmicMaterial, 0, 1100, 4530, 9000, 2500, 18)

    ObjectIndex = ObjectIndex + 1
    Arena[ObjectIndex] = Graphics3D.CreateCube3D(100)

    Call Configure(Arena[ObjectIndex], CosmicMaterial, 0, 1100, -4470, 9000, 2500, 18)

End Sub

Private Sub CreateHero(
    BaseIndex As Number,
    BodyMaterial As Core.Material3D,
    AccentMaterial As Core.Material3D,
    Role As Number
)

    Dim RoleHairMaterial As Core.Material3D

    RoleHairMaterial = HairMaterial

    If Role = ROLE_DEFENDER Then
        RoleHairMaterial = ArinHairMaterial
    Else If Role = ROLE_ATTACKER Then
        RoleHairMaterial = TorHairMaterial
    End If

    Call InitializeRigPart(PartyParts[BaseIndex], RIG_CYLINDER, BodyMaterial)
    Call InitializeRigPart(PartyParts[BaseIndex + 1], RIG_CYLINDER, BodyMaterial)
    Call InitializeRigPart(PartyParts[BaseIndex + 2], RIG_CUBE, LeatherMaterial)
    Call InitializeRigPart(PartyParts[BaseIndex + 3], RIG_CYLINDER, BodyMaterial)
    Call InitializeRigPart(PartyParts[BaseIndex + 4], RIG_CYLINDER, BodyMaterial)
    Call InitializeRigPart(PartyParts[BaseIndex + 5], RIG_CUBE, LeatherMaterial)
    Call InitializeRigPart(PartyParts[BaseIndex + 6], RIG_SPHERE, BodyMaterial)
    Call InitializeRigPart(PartyParts[BaseIndex + 7], RIG_SPHERE, BodyMaterial)
    Call InitializeRigPart(PartyParts[BaseIndex + 8], RIG_SPHERE, AccentMaterial)
    Call InitializeRigPart(PartyParts[BaseIndex + 9], RIG_SPHERE, SkinMaterial)

    If Role = ROLE_WIZARD Or Role = ROLE_HEALER Then
        Call InitializeRigPart(PartyParts[BaseIndex + 10], RIG_SPHERE, RoleHairMaterial)
        Call InitializeRigPart(PartyParts[BaseIndex + 11], RIG_CYLINDER, RoleHairMaterial)
    Else If Role = ROLE_ATTACKER Then
        Call InitializeRigPart(PartyParts[BaseIndex + 10], RIG_SPHERE, RoleHairMaterial)
        Call InitializeRigPart(PartyParts[BaseIndex + 11], RIG_CUBE, RoleHairMaterial)
    Else

        Call InitializeRigPart(PartyParts[BaseIndex + 10], RIG_SPHERE, RoleHairMaterial)
        Call InitializeRigPart(PartyParts[BaseIndex + 11], RIG_PYRAMID, RoleHairMaterial)
    End If

    Call InitializeRigPart(PartyParts[BaseIndex + 12], RIG_CYLINDER, BodyMaterial)
    Call InitializeRigPart(PartyParts[BaseIndex + 13], RIG_CYLINDER, AccentMaterial)
    Call InitializeRigPart(PartyParts[BaseIndex + 14], RIG_SPHERE, SkinMaterial)
    Call InitializeRigPart(PartyParts[BaseIndex + 15], RIG_CYLINDER, BodyMaterial)
    Call InitializeRigPart(PartyParts[BaseIndex + 16], RIG_CYLINDER, AccentMaterial)
    Call InitializeRigPart(PartyParts[BaseIndex + 17], RIG_SPHERE, SkinMaterial)
    Call InitializeRigPart(PartyParts[BaseIndex + 22], RIG_PYRAMID, AccentMaterial)
    Call InitializeRigPart(PartyParts[BaseIndex + 23], RIG_PYRAMID, AccentMaterial)
    Call InitializeRigPart(PartyParts[BaseIndex + 24], RIG_SPHERE, FrostMaterial)
    Call InitializeRigPart(PartyParts[BaseIndex + 25], RIG_SPHERE, FrostMaterial)

    If Role = ROLE_DEFENDER Then

        Call InitializeRigPart(PartyParts[BaseIndex + 26], RIG_PYRAMID, RoleHairMaterial)
        Call InitializeRigPart(PartyParts[BaseIndex + 27], RIG_PYRAMID, RoleHairMaterial)
        Call InitializeRigPart(PartyParts[BaseIndex + 28], RIG_PYRAMID, RoleHairMaterial)
        Call InitializeRigPart(PartyParts[BaseIndex + 29], RIG_PYRAMID, RoleHairMaterial)

    Else If Role = ROLE_ATTACKER Then

        Call InitializeRigPart(PartyParts[BaseIndex + 26], RIG_CUBE, RoleHairMaterial)
        Call InitializeRigPart(PartyParts[BaseIndex + 27], RIG_CUBE, RoleHairMaterial)
        Call InitializeRigPart(PartyParts[BaseIndex + 28], RIG_CUBE, RoleHairMaterial)
        Call InitializeRigPart(PartyParts[BaseIndex + 29], RIG_CUBE, RoleHairMaterial)

    Else

        Call InitializeRigPart(PartyParts[BaseIndex + 26], RIG_PYRAMID, RoleHairMaterial)
        Call InitializeRigPart(PartyParts[BaseIndex + 27], RIG_PYRAMID, RoleHairMaterial)
        Call InitializeRigPart(PartyParts[BaseIndex + 28], RIG_PYRAMID, RoleHairMaterial)
        Call InitializeRigPart(PartyParts[BaseIndex + 29], RIG_PYRAMID, RoleHairMaterial)

    End If

    ''' Shared stylized-RPG detail layer: belt and buckle, independent boot
    ''' cuffs and bracers, split coat panels, angular nose, and raised collar.
    ''' These parts inherit each role palette rather than encoding one game's
    ''' character art in the renderer.

    Call InitializeRigPart(PartyParts[BaseIndex + 30], RIG_CUBE, LeatherMaterial)
    Call InitializeRigPart(PartyParts[BaseIndex + 31], RIG_CUBE, BronzeMaterial)
    Call InitializeRigPart(PartyParts[BaseIndex + 32], RIG_CUBE, LeatherMaterial)
    Call InitializeRigPart(PartyParts[BaseIndex + 33], RIG_CUBE, LeatherMaterial)
    Call InitializeRigPart(PartyParts[BaseIndex + 34], RIG_CUBE, AccentMaterial)
    Call InitializeRigPart(PartyParts[BaseIndex + 35], RIG_CUBE, AccentMaterial)
    Call InitializeRigPart(PartyParts[BaseIndex + 36], RIG_PYRAMID, BodyMaterial)
    Call InitializeRigPart(PartyParts[BaseIndex + 37], RIG_PYRAMID, AccentMaterial)
    Call InitializeRigPart(PartyParts[BaseIndex + 38], RIG_PYRAMID, SkinMaterial)
    Call InitializeRigPart(PartyParts[BaseIndex + 39], RIG_TORUS, AccentMaterial)

    If Role = ROLE_DEFENDER Then

        Call InitializeRigPart(PartyParts[BaseIndex + 18], RIG_CUBE, SteelMaterial)
        Call InitializeRigPart(PartyParts[BaseIndex + 19], RIG_CUBE, BronzeMaterial)
        Call InitializeRigPart(PartyParts[BaseIndex + 20], RIG_CYLINDER, SteelMaterial)
        Call InitializeRigPart(PartyParts[BaseIndex + 21], RIG_SPHERE, BronzeMaterial)

    Else If Role = ROLE_ATTACKER Then

        Call InitializeRigPart(PartyParts[BaseIndex + 18], RIG_CUBE, SteelMaterial)
        Call InitializeRigPart(PartyParts[BaseIndex + 19], RIG_CYLINDER, SteelMaterial)
        Call InitializeRigPart(PartyParts[BaseIndex + 20], RIG_CUBE, LeatherMaterial)
        Call InitializeRigPart(PartyParts[BaseIndex + 21], RIG_CYLINDER, LavaMaterial)

    Else If Role = ROLE_HEALER Then

        Call InitializeRigPart(PartyParts[BaseIndex + 18], RIG_CYLINDER, SteelMaterial)
        Call InitializeRigPart(PartyParts[BaseIndex + 19], RIG_SPHERE, FrostMaterial)
        Call InitializeRigPart(PartyParts[BaseIndex + 20], RIG_TORUS, LyraMaterial)
        Call InitializeRigPart(PartyParts[BaseIndex + 21], RIG_SPHERE, FrostMaterial)

    Else

        Call InitializeRigPart(PartyParts[BaseIndex + 18], RIG_CYLINDER, BronzeMaterial)
        Call InitializeRigPart(PartyParts[BaseIndex + 19], RIG_SPHERE, FrostMaterial)
        Call InitializeRigPart(PartyParts[BaseIndex + 20], RIG_CUBE, MiraMaterial)
        Call InitializeRigPart(PartyParts[BaseIndex + 21], RIG_SPHERE, FrostMaterial)

    End If

End Sub

Private Sub CreateParty()

    Call CreateHero(0, ArinMaterial, SteelMaterial, ROLE_DEFENDER)
    Call CreateHero(40, TorMaterial, SteelMaterial, ROLE_ATTACKER)
    Call CreateHero(80, LyraMaterial, FrostMaterial, ROLE_HEALER)
    Call CreateHero(120, MiraMaterial, FrostMaterial, ROLE_WIZARD)
    Call PoseHero(0, Battle.PARTICIPANT_ARIN, ARIN_FORMATION_X, ARIN_FORMATION_Z, ROLE_DEFENDER, Battle.VISUAL_IDLE, 0, 0)
    Call PoseHero(40, Battle.PARTICIPANT_TOR, TOR_FORMATION_X, TOR_FORMATION_Z, ROLE_ATTACKER, Battle.VISUAL_IDLE, 0, 0)
    Call PoseHero(80, Battle.PARTICIPANT_LYRA, LYRA_FORMATION_X, LYRA_FORMATION_Z, ROLE_HEALER, Battle.VISUAL_IDLE, 0, 0)
    Call PoseHero(120, Battle.PARTICIPANT_MIRA, MIRA_FORMATION_X, MIRA_FORMATION_Z, ROLE_WIZARD, Battle.VISUAL_IDLE, 0, 0)

End Sub

Private Sub PoseHero(
    BaseIndex As Number,
    Participant As Number,
    RootX As Number,
    RootZ As Number,
    Role As Number,
    Visual As Number,
    StepValue As Number,
    AnimationStep As Number
)

    Dim IsActor As Boolean
    Dim Moving As Boolean
    Dim Defeated As Boolean
    Dim CorpsePose As Boolean
    Dim HipY As Number
    Dim HipSpacing As Number
    Dim UpperLegLength As Number
    Dim LowerLegLength As Number
    Dim LegRadius As Number
    Dim TorsoWidth As Number
    Dim TorsoHeight As Number
    Dim TorsoDepth As Number
    Dim ShoulderSpacing As Number
    Dim UpperArmLength As Number
    Dim LowerArmLength As Number
    Dim ArmRadius As Number
    Dim HeadRadius As Number
    Dim BodyBob As Number
    Dim BodyLean As Number
    Dim WalkSwing As Number
    Dim LeftUpperLegAngle As Number
    Dim LeftLowerLegAngle As Number
    Dim RightUpperLegAngle As Number
    Dim RightLowerLegAngle As Number
    Dim LeftUpperArmAngle As Number
    Dim LeftLowerArmAngle As Number
    Dim RightUpperArmAngle As Number
    Dim RightLowerArmAngle As Number
    Dim WeaponAngle As Number
    Dim Raise As Number
    Dim Strike As Number
    Dim Recoil As Number
    Dim TargetRecoil As Number
    Dim CheerCycle As Number
    Dim TorsoX As Number
    Dim ShoulderX As Number
    Dim HeadX As Number
    Dim TorsoY As Number
    Dim ShoulderY As Number
    Dim HeadY As Number
    Dim EquipmentX As Number
    Dim EquipmentY As Number
    Dim EquipmentZ As Number
    Dim LeftThigh As Articulation.SegmentPose3D
    Dim LeftShin As Articulation.SegmentPose3D
    Dim RightThigh As Articulation.SegmentPose3D
    Dim RightShin As Articulation.SegmentPose3D
    Dim LeftUpperArm As Articulation.SegmentPose3D
    Dim LeftLowerArm As Articulation.SegmentPose3D
    Dim RightUpperArm As Articulation.SegmentPose3D
    Dim RightLowerArm As Articulation.SegmentPose3D
    Dim WeaponPose As Articulation.SegmentPose3D
    Dim Index As Number

    IsActor = Battle.VisualActor() = Participant

    For Index = BaseIndex To BaseIndex + HERO_PART_COUNT - 1
        Call Graphics3D.SetObjectColor(PartyParts[Index], 255, 255, 255)
    End For
    ''' Battle actions use cinematic snap-staging, so feet stay planted instead of
    ''' playing a walk cycle while the actor is being repositioned.

    Moving = False
    Defeated = Battle.Health(Participant) <= 0

    If (Defeated And
        VisualHasImpact(Visual) And
        StepValue < 33 And
        (Battle.VisualTarget() = Participant Or VisualHitsWholeParty(Visual))) Then
        Defeated = False
    End If

    TargetRecoil = 0

    If ((Battle.VisualTarget() = Participant Or VisualHitsWholeParty(Visual)) And
        VisualHasImpact(Visual)) Then

        If Visual = Battle.VISUAL_DRAGON_CATASTROPHE Then
            TargetRecoil = Articulation.ActionEnvelope(StepValue, 25, 34, 62, 220)
        Else If Visual = Battle.VISUAL_DRAGON_BREATH Then
            TargetRecoil = Articulation.ActionEnvelope(StepValue, 25, 34, 62, 135)
        Else

            TargetRecoil = Articulation.ActionEnvelope(StepValue, 28, 33, 45, 28)
        End If

        RootX = RootX - TargetRecoil

    End If

    If ((Battle.VisualTarget() = Participant Or VisualHitsWholeParty(Visual)) And
        VisualHasImpact(Visual) And
        StepValue >= 29 And
        StepValue <= 35) Then

        For Index = BaseIndex To BaseIndex + HERO_PART_COUNT - 1
            Call Graphics3D.SetObjectColor(PartyParts[Index], 255, 138, 82)
        End For

    End If

    HipY = 48
    HipSpacing = 17
    UpperLegLength = 44
    LowerLegLength = 42
    LegRadius = 11
    TorsoWidth = 54
    TorsoHeight = 70
    TorsoDepth = 34
    ShoulderSpacing = 32
    UpperArmLength = 38
    LowerArmLength = 36
    ArmRadius = 9
    HeadRadius = 24

    If Role = ROLE_ATTACKER Then

        HipY = 54
        HipSpacing = 21
        UpperLegLength = 48
        LowerLegLength = 44
        LegRadius = 14
        TorsoWidth = 72
        TorsoHeight = 76
        TorsoDepth = 48
        ShoulderSpacing = 42
        UpperArmLength = 43
        LowerArmLength = 40
        ArmRadius = 12
        HeadRadius = 27

    Else If Role = ROLE_HEALER Or Role = ROLE_WIZARD Then

        HipSpacing = 15
        LegRadius = 9
        TorsoWidth = 48
        TorsoDepth = 30
        ShoulderSpacing = 28
        ArmRadius = 8
        HeadRadius = 23

    End If

    BodyBob = Articulation.CycleAngle(AnimationStep, 72, 2, Participant * 35)
    LeftUpperLegAngle = 0
    LeftLowerLegAngle = 0
    RightUpperLegAngle = 0
    RightLowerLegAngle = 0
    LeftUpperArmAngle = Articulation.CycleAngle(AnimationStep, 90, 2, 180)
    RightUpperArmAngle = Articulation.CycleAngle(AnimationStep, 90, 2, 0)
    LeftLowerArmAngle = LeftUpperArmAngle
    RightLowerArmAngle = RightUpperArmAngle

    If Moving Then

        WalkSwing = Articulation.CycleAngle(StepValue, 18, 34, 0)
        BodyBob = Articulation.PositiveCycle(StepValue, 9, 6, 0)
        LeftUpperLegAngle = WalkSwing
        RightUpperLegAngle = 0 - WalkSwing
        LeftLowerLegAngle = WalkSwing - Articulation.PositiveCycle(StepValue, 18, 28, 180)
        RightLowerLegAngle = 0 - WalkSwing - Articulation.PositiveCycle(StepValue, 18, 28, 0)

    End If

    WeaponAngle = RightLowerArmAngle - 18
    BodyLean = 0

    If Moving Then

        LeftUpperArmAngle = 0 - WalkSwing * 3 / 4
        RightUpperArmAngle = WalkSwing * 3 / 4
        LeftLowerArmAngle = LeftUpperArmAngle
        RightLowerArmAngle = RightUpperArmAngle

    End If

    If IsActor And (Visual = Battle.VISUAL_ARIN_ATTACK Or Visual = Battle.VISUAL_ARIN_EMBER) Then

        Raise = Articulation.ActionEnvelope(StepValue, 2, 16, 32, -68)
        Strike = Articulation.ActionEnvelope(StepValue, 18, 31, 50, 132)
        RightUpperArmAngle = Raise + Strike
        RightLowerArmAngle = RightUpperArmAngle + 18
        LeftUpperArmAngle = Articulation.ActionEnvelope(StepValue, 4, 24, 58, 72)
        LeftLowerArmAngle = LeftUpperArmAngle + 15
        WeaponAngle = RightLowerArmAngle + 6
        BodyLean = Articulation.ActionEnvelope(StepValue, 12, 31, 52, 16)

    Else If IsActor And (Visual = Battle.VISUAL_TOR_ATTACK Or Visual = Battle.VISUAL_TOR_BASH) Then

        Raise = Articulation.ActionEnvelope(StepValue, 3, 18, 58, 82)
        Recoil = Articulation.ActionEnvelope(StepValue, 29, 34, 43, -24)
        LeftUpperArmAngle = Raise + Recoil
        RightUpperArmAngle = Raise + Recoil
        LeftLowerArmAngle = Min(98, Raise + 18 + Recoil)
        RightLowerArmAngle = Min(98, Raise + 18 + Recoil)
        BodyLean = 0 - Recoil / 2

    Else If IsActor And Visual = Battle.VISUAL_LYRA_ATTACK Then

        Raise = Articulation.ActionEnvelope(StepValue, 2, 18, 54, 118)
        LeftUpperArmAngle = Raise - 22
        RightUpperArmAngle = Raise
        LeftLowerArmAngle = Raise + 5
        RightLowerArmAngle = Raise + 18
        WeaponAngle = RightLowerArmAngle + 10

    Else If (IsActor And
        (Visual = Battle.VISUAL_MIRA_FLAME Or
        Visual = Battle.VISUAL_MIRA_FROST Or
        Visual = Battle.VISUAL_MIRA_LIGHTNING)) Then

        Raise = Articulation.ActionEnvelope(StepValue, 1, 22, 66, 126)
        LeftUpperArmAngle = Raise - 28
        RightUpperArmAngle = Raise
        LeftLowerArmAngle = Raise + 8
        RightLowerArmAngle = Raise + 20
        WeaponAngle = RightLowerArmAngle + 4
        BodyLean = 0 - Raise / 12

    Else If IsActor And Visual = Battle.VISUAL_LYRA_MEND Then

        Raise = Articulation.ActionEnvelope(StepValue, 1, 24, 64, 148)
        LeftUpperArmAngle = Raise - 12
        RightUpperArmAngle = Raise
        LeftLowerArmAngle = Raise + 12
        RightLowerArmAngle = Raise + 16
        WeaponAngle = RightLowerArmAngle

    Else If IsActor And Visual = Battle.VISUAL_DEFEND Then

        LeftUpperArmAngle = Articulation.ActionEnvelope(StepValue, 1, 16, 46, 84)
        LeftLowerArmAngle = LeftUpperArmAngle + 12
        RightUpperArmAngle = LeftUpperArmAngle / 2
        RightLowerArmAngle = RightUpperArmAngle + 18
        BodyLean = -10

    Else If IsActor And Visual = Battle.VISUAL_ITEM Then

        RightUpperArmAngle = Articulation.ActionEnvelope(StepValue, 1, 18, 50, 120)
        RightLowerArmAngle = RightUpperArmAngle + 10

    End If

    If TargetRecoil > 0 Then
        BodyLean = 0 - TargetRecoil / 2
    End If

    If Defeated Then

        CorpsePose = True
        HipY = -18
        BodyBob = 0
        BodyLean = 86
        LeftUpperArmAngle = 58
        LeftLowerArmAngle = 76
        RightUpperArmAngle = -42
        RightLowerArmAngle = -65
        LeftUpperLegAngle = 72
        RightUpperLegAngle = -56
        LeftLowerLegAngle = 84
        RightLowerLegAngle = -70

    Else If Visual = Battle.VISUAL_VICTORY Then

        CheerCycle = Articulation.CycleAngle(AnimationStep, 32, 28, Participant * 47)
        BodyBob = Articulation.PositiveCycle(AnimationStep, 24, 13, Participant * 50)

        If Participant = Battle.PARTICIPANT_ARIN Then

            LeftUpperArmAngle = 145 + CheerCycle
            LeftLowerArmAngle = 168 + CheerCycle / 2
            RightUpperArmAngle = 132 - CheerCycle
            RightLowerArmAngle = 155 - CheerCycle / 2
            BodyLean = CheerCycle / 7

        Else If Participant = Battle.PARTICIPANT_TOR Then

            LeftUpperArmAngle = 98 + CheerCycle / 2
            LeftLowerArmAngle = 55 - CheerCycle / 2
            RightUpperArmAngle = 98 - CheerCycle / 2
            RightLowerArmAngle = 55 + CheerCycle / 2
            BodyLean = 0 - Abs(CheerCycle) / 8

        Else If Participant = Battle.PARTICIPANT_LYRA Then

            LeftUpperArmAngle = 118 + CheerCycle
            LeftLowerArmAngle = 145 + CheerCycle / 2
            RightUpperArmAngle = 155 - CheerCycle
            RightLowerArmAngle = 172 - CheerCycle / 2
            WeaponAngle = RightLowerArmAngle + CheerCycle

        Else

            LeftUpperArmAngle = 162 + CheerCycle / 2
            LeftLowerArmAngle = 178
            RightUpperArmAngle = 162 - CheerCycle / 2
            RightLowerArmAngle = 178
            BodyLean = CheerCycle / 6

        End If

    Else If Visual = Battle.VISUAL_DEFEAT Then

        BodyBob = 0 - Min(38, StepValue)
        BodyLean = Min(78, StepValue * 2)
        LeftUpperArmAngle = 30
        LeftLowerArmAngle = 55
        RightUpperArmAngle = -20
        RightLowerArmAngle = -50
        LeftUpperLegAngle = 20
        RightUpperLegAngle = -28
        LeftLowerLegAngle = -35
        RightLowerLegAngle = 34

    End If

    LeftThigh = Articulation.SolveHangingSegment(RootX, HipY + BodyBob, RootZ - HipSpacing, UpperLegLength, LeftUpperLegAngle, 0)
    LeftShin = Articulation.SolveHangingSegment(LeftThigh.EndX, LeftThigh.EndY, LeftThigh.EndZ, LowerLegLength, LeftLowerLegAngle, 0)
    RightThigh = Articulation.SolveHangingSegment(RootX, HipY + BodyBob, RootZ + HipSpacing, UpperLegLength, RightUpperLegAngle, 0)
    RightShin = Articulation.SolveHangingSegment(RightThigh.EndX, RightThigh.EndY, RightThigh.EndZ, LowerLegLength, RightLowerLegAngle, 0)

    Call ApplySegment(PartyParts[BaseIndex], LeftThigh, LegRadius)
    Call ApplySegment(PartyParts[BaseIndex + 1], LeftShin, LegRadius - 2)
    Call ApplyPart(PartyParts[BaseIndex + 2], LeftShin.EndX + 8, LeftShin.EndY - 2, LeftShin.EndZ, 28, 18, 22, 0, 0, LeftLowerLegAngle / 2)
    Call ApplySegment(PartyParts[BaseIndex + 3], RightThigh, LegRadius)
    Call ApplySegment(PartyParts[BaseIndex + 4], RightShin, LegRadius - 2)
    Call ApplyPart(PartyParts[BaseIndex + 5], RightShin.EndX + 8, RightShin.EndY - 2, RightShin.EndZ, 28, 18, 22, 0, 0, RightLowerLegAngle / 2)

    TorsoY = HipY + BodyBob + TorsoHeight / 2
    ShoulderY = HipY + BodyBob + TorsoHeight - 10
    HeadY = HipY + BodyBob + TorsoHeight + HeadRadius + 6
    TorsoX = RootX
    ShoulderX = RootX
    HeadX = RootX

    If CorpsePose Then

        TorsoX = RootX - 42
        ShoulderX = RootX - 46
        HeadX = RootX - 92
        TorsoY = -18
        ShoulderY = -16
        HeadY = -22

    End If

    Call ApplyPart(PartyParts[BaseIndex + 6], RootX, HipY + BodyBob + 3, RootZ, TorsoWidth - 8, 24, TorsoDepth + 2, 0, 0, BodyLean / 3)
    Call ApplyPart(PartyParts[BaseIndex + 7], TorsoX, TorsoY, RootZ, TorsoWidth, TorsoHeight, TorsoDepth, 0, 0, BodyLean)
    Call ApplyPart(PartyParts[BaseIndex + 8], TorsoX + 4, TorsoY + 8, RootZ, 18, TorsoHeight - 18, TorsoDepth + 5, 0, 0, BodyLean)
    Call ApplyPart(PartyParts[BaseIndex + 9], HeadX, HeadY, RootZ, HeadRadius * 2, HeadRadius * 2, HeadRadius * 2, 0, 0, BodyLean / 2)

    ''' Layered costume geometry reads in both party-back and actor close-up
    ''' shots: a dimensional belt, metal buckle, boots, split coat, face plane,
    ''' and collar replace the old uninterrupted primitive silhouette.

    Call ApplyPart(PartyParts[BaseIndex + 30], TorsoX, TorsoY - TorsoHeight / 2 + 20, RootZ, TorsoWidth + 5, 10, TorsoDepth + 6, 0, 0, BodyLean)
    Call ApplyPart(PartyParts[BaseIndex + 31], TorsoX + TorsoWidth / 2 + 3, TorsoY - TorsoHeight / 2 + 20, RootZ, 7, 13, 15, 0, 0, BodyLean)
    Call ApplyPart(PartyParts[BaseIndex + 32], LeftShin.EndX, LeftShin.EndY + 10, LeftShin.EndZ, (LegRadius + 4) * 2, 20, (LegRadius + 5) * 2, LeftShin.RotationX, LeftShin.RotationY, LeftShin.RotationZ)
    Call ApplyPart(PartyParts[BaseIndex + 33], RightShin.EndX, RightShin.EndY + 10, RightShin.EndZ, (LegRadius + 4) * 2, 20, (LegRadius + 5) * 2, RightShin.RotationX, RightShin.RotationY, RightShin.RotationZ)

    If Role = ROLE_HEALER Or Role = ROLE_WIZARD Then
        Call ApplyPart(PartyParts[BaseIndex + 36], TorsoX + TorsoWidth / 2 - 3, TorsoY - TorsoHeight / 2 - 5, RootZ - TorsoDepth / 4, 11, 56, TorsoDepth / 2 + 3, 0, 0, BodyLean + 180)
        Call ApplyPart(PartyParts[BaseIndex + 37], TorsoX + TorsoWidth / 2 - 3, TorsoY - TorsoHeight / 2 - 5, RootZ + TorsoDepth / 4, 11, 56, TorsoDepth / 2 + 3, 0, 0, BodyLean + 180)
    Else

        Call ApplyPart(PartyParts[BaseIndex + 36], TorsoX + TorsoWidth / 2 - 3, TorsoY - TorsoHeight / 2 - 1, RootZ - TorsoDepth / 4, 11, 44, TorsoDepth / 2 + 3, 0, 0, BodyLean + 180)
        Call ApplyPart(PartyParts[BaseIndex + 37], TorsoX + TorsoWidth / 2 - 3, TorsoY - TorsoHeight / 2 - 1, RootZ + TorsoDepth / 4, 11, 44, TorsoDepth / 2 + 3, 0, 0, BodyLean + 180)
    End If

    Call ApplyPart(PartyParts[BaseIndex + 38], HeadX + HeadRadius - 1, HeadY, RootZ, 9, 14, 9, 0, 0, -90 + BodyLean / 2)
    Call ApplyPart(PartyParts[BaseIndex + 39], HeadX - 3, HeadY - HeadRadius + 1, RootZ, TorsoDepth + 8, 8, TorsoDepth + 8, 0, 0, BodyLean / 2)

    If Role = ROLE_WIZARD Then

        ''' Mira now has a layered shoulder-length cut instead of a pointy hat.

        Call ApplyPart(PartyParts[BaseIndex + 10], HeadX - 6, HeadY + 9, RootZ, 51, 48, 54, 0, 0, BodyLean / 2)
        Call ApplyPart(PartyParts[BaseIndex + 11], HeadX + 7, HeadY - 19, RootZ, 42, 58, 50, 0, 0, BodyLean + 8)
        Call ApplyPart(PartyParts[BaseIndex + 26], HeadX - 5, HeadY - 12, RootZ - 27, 18, 48, 18, -15, 0, BodyLean + 174)
        Call ApplyPart(PartyParts[BaseIndex + 27], HeadX - 5, HeadY - 12, RootZ + 27, 18, 48, 18, 15, 0, BodyLean + 174)
        Call ApplyPart(PartyParts[BaseIndex + 28], HeadX - 20, HeadY - 20, RootZ - 14, 19, 52, 19, -8, 0, BodyLean + 178)
        Call ApplyPart(PartyParts[BaseIndex + 29], HeadX - 20, HeadY - 20, RootZ + 14, 19, 52, 19, 8, 0, BodyLean + 178)

    Else If Role = ROLE_HEALER Then

        Call ApplyPart(PartyParts[BaseIndex + 10], HeadX - 7, HeadY + 8, RootZ, 48, 44, 52, 0, 0, BodyLean / 2)
        Call ApplyPart(PartyParts[BaseIndex + 11], HeadX - 15, HeadY - 16, RootZ, 42, 48, 48, 0, 0, BodyLean + 4)
        Call ApplyPart(PartyParts[BaseIndex + 26], HeadX - 5, HeadY - 8, RootZ - 26, 17, 42, 17, -12, 0, BodyLean + 170)
        Call ApplyPart(PartyParts[BaseIndex + 27], HeadX - 5, HeadY - 8, RootZ + 26, 17, 42, 17, 12, 0, BodyLean + 170)
        Call ApplyPart(PartyParts[BaseIndex + 28], HeadX - 18, HeadY - 14, RootZ - 13, 18, 44, 18, -6, 0, BodyLean + 176)
        Call ApplyPart(PartyParts[BaseIndex + 29], HeadX - 18, HeadY - 14, RootZ + 13, 18, 44, 18, 6, 0, BodyLean + 176)

    Else If Role = ROLE_DEFENDER Then

        ''' Arin's layered hero cut uses a fitted crown plus five independent
        ''' spikes, preserving a youthful silhouette from the party-back camera.

        Call ApplyPart(PartyParts[BaseIndex + 10], HeadX - 5, HeadY + 15, RootZ, 50, 30, 54, 0, 0, BodyLean - 6)
        Call ApplyPart(PartyParts[BaseIndex + 11], HeadX + 13, HeadY + 34, RootZ, 25, 48, 25, 0, 0, BodyLean - 28)
        Call ApplyPart(PartyParts[BaseIndex + 26], HeadX - 9, HeadY + 36, RootZ - 16, 22, 42, 22, -15, 0, BodyLean + 13)
        Call ApplyPart(PartyParts[BaseIndex + 27], HeadX - 9, HeadY + 36, RootZ + 16, 22, 42, 22, 15, 0, BodyLean + 13)
        Call ApplyPart(PartyParts[BaseIndex + 28], HeadX + 16, HeadY + 28, RootZ - 18, 20, 39, 20, -18, 0, BodyLean - 43)
        Call ApplyPart(PartyParts[BaseIndex + 29], HeadX + 16, HeadY + 28, RootZ + 18, 20, 39, 20, 18, 0, BodyLean - 43)

    Else

        ''' Tor's close military fade covers the scalp and sides, with a short
        ''' squared textured top instead of the old isolated bald-looking tuft.

        Call ApplyPart(PartyParts[BaseIndex + 10], HeadX - 5, HeadY + 12, RootZ, 54, 24, 57, 0, 0, BodyLean)
        Call ApplyPart(PartyParts[BaseIndex + 11], HeadX - 2, HeadY + 25, RootZ, 36, 14, 42, 0, 0, BodyLean - 3)
        Call ApplyPart(PartyParts[BaseIndex + 26], HeadX - 18, HeadY + 6, RootZ, 10, 28, 40, 0, 0, BodyLean)
        Call ApplyPart(PartyParts[BaseIndex + 27], HeadX - 2, HeadY + 8, RootZ - 23, 38, 25, 8, 0, 0, BodyLean)
        Call ApplyPart(PartyParts[BaseIndex + 28], HeadX - 2, HeadY + 8, RootZ + 23, 38, 25, 8, 0, 0, BodyLean)
        Call ApplyPart(PartyParts[BaseIndex + 29], HeadX + 9, HeadY + 29, RootZ, 18, 12, 34, 0, 0, BodyLean - 8)

    End If

    LeftUpperArm = Articulation.SolveHangingSegment(ShoulderX, ShoulderY, RootZ - ShoulderSpacing, UpperArmLength, LeftUpperArmAngle, -4)
    LeftLowerArm = Articulation.SolveHangingSegment(LeftUpperArm.EndX, LeftUpperArm.EndY, LeftUpperArm.EndZ, LowerArmLength, LeftLowerArmAngle, -2)
    RightUpperArm = Articulation.SolveHangingSegment(ShoulderX, ShoulderY, RootZ + ShoulderSpacing, UpperArmLength, RightUpperArmAngle, 4)
    RightLowerArm = Articulation.SolveHangingSegment(RightUpperArm.EndX, RightUpperArm.EndY, RightUpperArm.EndZ, LowerArmLength, RightLowerArmAngle, 2)

    Call ApplySegment(PartyParts[BaseIndex + 12], LeftUpperArm, ArmRadius)
    Call ApplySegment(PartyParts[BaseIndex + 13], LeftLowerArm, ArmRadius - 1)
    Call ApplyPart(PartyParts[BaseIndex + 14], LeftLowerArm.EndX, LeftLowerArm.EndY, LeftLowerArm.EndZ, 20, 20, 20, 0, 0, 0)
    Call ApplySegment(PartyParts[BaseIndex + 15], RightUpperArm, ArmRadius)
    Call ApplySegment(PartyParts[BaseIndex + 16], RightLowerArm, ArmRadius - 1)
    Call ApplyPart(PartyParts[BaseIndex + 17], RightLowerArm.EndX, RightLowerArm.EndY, RightLowerArm.EndZ, 20, 20, 20, 0, 0, 0)
    Call ApplyPart(PartyParts[BaseIndex + 22], ShoulderX, ShoulderY + 2, RootZ - ShoulderSpacing, (ArmRadius + 9) * 2, (ArmRadius + 7) * 2, (ArmRadius + 10) * 2, 58, 0, BodyLean - 8)
    Call ApplyPart(PartyParts[BaseIndex + 23], ShoulderX, ShoulderY + 2, RootZ + ShoulderSpacing, (ArmRadius + 9) * 2, (ArmRadius + 7) * 2, (ArmRadius + 10) * 2, -58, 0, BodyLean - 8)
    Call ApplyPart(PartyParts[BaseIndex + 24], HeadX + HeadRadius - 2, HeadY + 5, RootZ - 10, 7, 7, 7, 0, 0, BodyLean)
    Call ApplyPart(PartyParts[BaseIndex + 25], HeadX + HeadRadius - 2, HeadY + 5, RootZ + 10, 7, 7, 7, 0, 0, BodyLean)
    Call ApplyPart(PartyParts[BaseIndex + 34], LeftLowerArm.CenterX, LeftLowerArm.CenterY, LeftLowerArm.CenterZ, (ArmRadius + 3) * 2, LowerArmLength / 2, (ArmRadius + 3) * 2, LeftLowerArm.RotationX, LeftLowerArm.RotationY, LeftLowerArm.RotationZ)
    Call ApplyPart(PartyParts[BaseIndex + 35], RightLowerArm.CenterX, RightLowerArm.CenterY, RightLowerArm.CenterZ, (ArmRadius + 3) * 2, LowerArmLength / 2, (ArmRadius + 3) * 2, RightLowerArm.RotationX, RightLowerArm.RotationY, RightLowerArm.RotationZ)

    If Role = ROLE_DEFENDER Then

        WeaponPose = Articulation.SolveHangingSegment(RightLowerArm.EndX, RightLowerArm.EndY, RightLowerArm.EndZ, 92, WeaponAngle, 0)

        Call ApplyPart(PartyParts[BaseIndex + 18], WeaponPose.CenterX, WeaponPose.CenterY, WeaponPose.CenterZ, 8, 92, 4, 0, 0, WeaponPose.RotationZ)
        Call ApplyPart(PartyParts[BaseIndex + 19], RightLowerArm.EndX, RightLowerArm.EndY, RightLowerArm.EndZ, 8, 7, 34, 0, 0, WeaponPose.RotationZ)
        Call ApplyPart(PartyParts[BaseIndex + 20], LeftLowerArm.EndX + 3, LeftLowerArm.EndY + 8, LeftLowerArm.EndZ, 420, 8, 420, 0, 0, 90)
        Call ApplyPart(PartyParts[BaseIndex + 21], LeftLowerArm.EndX - 2, LeftLowerArm.EndY + 8, LeftLowerArm.EndZ, 26, 26, 26, 0, 0, 0)

    Else If Role = ROLE_ATTACKER Then

        Recoil = Articulation.ActionEnvelope(StepValue, 29, 34, 43, 18)
        EquipmentX = Max(LeftLowerArm.EndX, RightLowerArm.EndX) + 35 - Recoil
        EquipmentY = (LeftLowerArm.EndY + RightLowerArm.EndY) / 2 + 5
        EquipmentZ = RootZ

        Call ApplyPart(PartyParts[BaseIndex + 18], EquipmentX, EquipmentY, EquipmentZ, 72, 20, 24, 0, 0, 0)
        Call ApplyPart(PartyParts[BaseIndex + 19], EquipmentX + 60, EquipmentY, EquipmentZ, 100, 58, 100, 0, 0, -90)
        Call ApplyPart(PartyParts[BaseIndex + 20], EquipmentX - 42, EquipmentY - 4, EquipmentZ, 38, 27, 27, 0, 0, 0)
        Call ApplyPart(PartyParts[BaseIndex + 21], EquipmentX + 91, EquipmentY, EquipmentZ, 130, 10, 130, 0, 0, -90)

    Else If Role = ROLE_HEALER Or Role = ROLE_WIZARD Then

        WeaponPose = Articulation.SolveHangingSegment(RightLowerArm.EndX, RightLowerArm.EndY, RightLowerArm.EndZ, 132, WeaponAngle, 0)

        Call ApplySegment(PartyParts[BaseIndex + 18], WeaponPose, 6)
        Call ApplyPart(PartyParts[BaseIndex + 19], WeaponPose.EndX, WeaponPose.EndY, WeaponPose.EndZ, 34, 34, 34, 0, AnimationStep * 3, 0)

        If Role = ROLE_HEALER Then
            Call ApplyPart(PartyParts[BaseIndex + 20], WeaponPose.EndX, WeaponPose.EndY, WeaponPose.EndZ, 42, 42, 42, 90, AnimationStep * 4, 0)
            Call ApplyPart(PartyParts[BaseIndex + 21], WeaponPose.EndX, WeaponPose.EndY + 1, WeaponPose.EndZ, 17, 17, 17, 0, 0, 0)
        Else

            Call ApplyPart(PartyParts[BaseIndex + 20], LeftLowerArm.EndX + 4, LeftLowerArm.EndY - 3, LeftLowerArm.EndZ, 28, 36, 10, 0, 0, -12)
            Call ApplyPart(PartyParts[BaseIndex + 21], LeftLowerArm.EndX + 9, LeftLowerArm.EndY + 2, LeftLowerArm.EndZ - 7, 16, 16, 16, 0, AnimationStep * 5, 0)
        End If

    End If

End Sub

Private Sub CreateCinderling(EnemyIndex As Number, X As Number, Z As Number)

    Dim BaseIndex As Number

    BaseIndex = EnemyIndex * CINDERLING_PARTS_PER_ENEMY

    ''' Shared anatomical skeleton: pelvis, skull and jaw, articulated long bones,
    ''' hands and boots, paired pauldrons and ribs, spine/neck, plus eye sockets.

    Call InitializeRigPart(CinderlingParts[BaseIndex], RIG_CUBE, LeatherMaterial)
    Call InitializeRigPart(CinderlingParts[BaseIndex + 1], RIG_SPHERE, BoneMaterial)
    Call InitializeRigPart(CinderlingParts[BaseIndex + 2], RIG_CYLINDER, BoneMaterial)
    Call InitializeRigPart(CinderlingParts[BaseIndex + 3], RIG_CYLINDER, BoneMaterial)
    Call InitializeRigPart(CinderlingParts[BaseIndex + 4], RIG_CYLINDER, BoneMaterial)
    Call InitializeRigPart(CinderlingParts[BaseIndex + 5], RIG_CYLINDER, BoneMaterial)
    Call InitializeRigPart(CinderlingParts[BaseIndex + 6], RIG_CYLINDER, BoneMaterial)
    Call InitializeRigPart(CinderlingParts[BaseIndex + 7], RIG_CUBE, BoneMaterial)
    Call InitializeRigPart(CinderlingParts[BaseIndex + 8], RIG_CYLINDER, BoneMaterial)
    Call InitializeRigPart(CinderlingParts[BaseIndex + 9], RIG_CYLINDER, BoneMaterial)
    Call InitializeRigPart(CinderlingParts[BaseIndex + 10], RIG_CYLINDER, BoneMaterial)
    Call InitializeRigPart(CinderlingParts[BaseIndex + 11], RIG_CYLINDER, BoneMaterial)
    Call InitializeRigPart(CinderlingParts[BaseIndex + 12], RIG_SPHERE, BoneMaterial)
    Call InitializeRigPart(CinderlingParts[BaseIndex + 13], RIG_SPHERE, BoneMaterial)
    Call InitializeRigPart(CinderlingParts[BaseIndex + 14], RIG_CUBE, LeatherMaterial)
    Call InitializeRigPart(CinderlingParts[BaseIndex + 15], RIG_CUBE, LeatherMaterial)
    Call InitializeRigPart(CinderlingParts[BaseIndex + 18], RIG_TORUS, BoneMaterial)
    Call InitializeRigPart(CinderlingParts[BaseIndex + 19], RIG_TORUS, BoneMaterial)
    Call InitializeRigPart(CinderlingParts[BaseIndex + 20], RIG_CYLINDER, BoneMaterial)
    Call InitializeRigPart(CinderlingParts[BaseIndex + 28], RIG_SPHERE, VoidMaterial)
    Call InitializeRigPart(CinderlingParts[BaseIndex + 29], RIG_SPHERE, VoidMaterial)

    If EnemyIndex = 0 Then

        ''' Armored Boneguard: sword, crossguard, shield/boss, helmet/crest,
        ''' leather battle skirt, and asymmetric metal pauldrons.

        Call InitializeRigPart(CinderlingParts[BaseIndex + 16], RIG_PYRAMID, SteelMaterial)
        Call InitializeRigPart(CinderlingParts[BaseIndex + 17], RIG_PYRAMID, BronzeMaterial)
        Call InitializeRigPart(CinderlingParts[BaseIndex + 21], RIG_CUBE, SteelMaterial)
        Call InitializeRigPart(CinderlingParts[BaseIndex + 22], RIG_CUBE, BronzeMaterial)
        Call InitializeRigPart(CinderlingParts[BaseIndex + 23], RIG_CYLINDER, SteelMaterial)
        Call InitializeRigPart(CinderlingParts[BaseIndex + 24], RIG_SPHERE, BronzeMaterial)
        Call InitializeRigPart(CinderlingParts[BaseIndex + 25], RIG_SPHERE, SteelMaterial)
        Call InitializeRigPart(CinderlingParts[BaseIndex + 26], RIG_PYRAMID, SteelMaterial)
        Call InitializeRigPart(CinderlingParts[BaseIndex + 27], RIG_PYRAMID, LeatherMaterial)

    Else If EnemyIndex = 1 Then

        ''' Necromancer mini-boss: layered hood, mantle, robe, belt, staff and
        ''' luminous orb/rune provide the imposing central silhouette.

        Call InitializeRigPart(CinderlingParts[BaseIndex + 16], RIG_PYRAMID, MiraMaterial)
        Call InitializeRigPart(CinderlingParts[BaseIndex + 17], RIG_PYRAMID, MiraMaterial)
        Call InitializeRigPart(CinderlingParts[BaseIndex + 21], RIG_CYLINDER, BronzeMaterial)
        Call InitializeRigPart(CinderlingParts[BaseIndex + 22], RIG_SPHERE, FrostMaterial)
        Call InitializeRigPart(CinderlingParts[BaseIndex + 23], RIG_SPHERE, MiraMaterial)
        Call InitializeRigPart(CinderlingParts[BaseIndex + 24], RIG_PYRAMID, MiraMaterial)
        Call InitializeRigPart(CinderlingParts[BaseIndex + 25], RIG_PYRAMID, MiraMaterial)
        Call InitializeRigPart(CinderlingParts[BaseIndex + 26], RIG_CUBE, BronzeMaterial)
        Call InitializeRigPart(CinderlingParts[BaseIndex + 27], RIG_TORUS, FrostMaterial)

    Else

        ''' Dread Archer: segmented bow, taut string, nocked arrow, broad hat,
        ''' quiver, dark leather mantle and green metal shoulder guard.

        Call InitializeRigPart(CinderlingParts[BaseIndex + 16], RIG_PYRAMID, LyraMaterial)
        Call InitializeRigPart(CinderlingParts[BaseIndex + 17], RIG_PYRAMID, LeatherMaterial)
        Call InitializeRigPart(CinderlingParts[BaseIndex + 21], RIG_CYLINDER, LeatherMaterial)
        Call InitializeRigPart(CinderlingParts[BaseIndex + 22], RIG_CYLINDER, LeatherMaterial)
        Call InitializeRigPart(CinderlingParts[BaseIndex + 23], RIG_CYLINDER, SteelMaterial)
        Call InitializeRigPart(CinderlingParts[BaseIndex + 24], RIG_CYLINDER, SteelMaterial)
        Call InitializeRigPart(CinderlingParts[BaseIndex + 25], RIG_CYLINDER, LeatherMaterial)
        Call InitializeRigPart(CinderlingParts[BaseIndex + 26], RIG_PYRAMID, LeatherMaterial)
        Call InitializeRigPart(CinderlingParts[BaseIndex + 27], RIG_CUBE, LeatherMaterial)

    End If

    Call PoseCinderling(EnemyIndex, X, Z, False, 0)

End Sub

Private Sub CreateCinderlings()

    Call CreateCinderling(0, 250, -280)
    Call CreateCinderling(1, 390, 40)
    Call CreateCinderling(2, 270, 380)

End Sub

Private Sub ScaleCinderlingPose(EnemyIndex As Number, PivotX As Number, PivotZ As Number)

    Dim BaseIndex As Number
    Dim Index As Number
    Dim ScalePercent As Number

    ScalePercent = CINDERLING_MINION_SCALE_PERCENT

    If EnemyIndex = 1 Then
        ScalePercent = CINDER_WARDEN_SCALE_PERCENT
    End If

    BaseIndex = EnemyIndex * CINDERLING_PARTS_PER_ENEMY

    For Index = BaseIndex To BaseIndex + CINDERLING_PARTS_PER_ENEMY - 1

        Call Graphics3D.SetObjectPosition(
            CinderlingParts[Index],
            PivotX + (CinderlingParts[Index].Position.X - PivotX) * ScalePercent / 100,
            -55 + (CinderlingParts[Index].Position.Y + 55) * ScalePercent / 100,
            PivotZ + (CinderlingParts[Index].Position.Z - PivotZ) * ScalePercent / 100
        )
        Call Graphics3D.SetObjectScale(
            CinderlingParts[Index],
            CinderlingParts[Index].ScaleX * ScalePercent / 100,
            CinderlingParts[Index].ScaleY * ScalePercent / 100,
            CinderlingParts[Index].ScaleZ * ScalePercent / 100
        )
    End For

End Sub

Private Sub PoseCinderling(
    EnemyIndex As Number,
    X As Number,
    Z As Number,
    Defeated As Boolean,
    AnimationStep As Number
)

    Dim Index As Number
    Dim BaseIndex As Number
    Dim Pulse As Number
    Dim AttackSwing As Number
    Dim LeftThigh As Articulation.SegmentPose3D
    Dim LeftShin As Articulation.SegmentPose3D
    Dim RightThigh As Articulation.SegmentPose3D
    Dim RightShin As Articulation.SegmentPose3D
    Dim Spine As Articulation.SegmentPose3D
    Dim Neck As Articulation.SegmentPose3D
    Dim LeftUpperArm As Articulation.SegmentPose3D
    Dim LeftLowerArm As Articulation.SegmentPose3D
    Dim RightUpperArm As Articulation.SegmentPose3D
    Dim RightLowerArm As Articulation.SegmentPose3D
    Dim WeaponPose As Articulation.SegmentPose3D
    Dim BowUpper As Articulation.SegmentPose3D
    Dim BowLower As Articulation.SegmentPose3D
    Dim HipY As Number
    Dim ShoulderY As Number
    Dim HeadY As Number
    Dim LeftUpperAngle As Number
    Dim LeftLowerAngle As Number
    Dim RightUpperAngle As Number
    Dim RightLowerAngle As Number

    BaseIndex = EnemyIndex * CINDERLING_PARTS_PER_ENEMY
    Pulse = Articulation.CycleAngle(AnimationStep, 72, 3, EnemyIndex * 45)
    AttackSwing = 0

    If (Battle.Visual() = Battle.VISUAL_CINDERLING_ATTACK And
        Battle.VisualActor() = Battle.PARTICIPANT_CINDERLING_ONE + EnemyIndex) Then
        AttackSwing = Articulation.ActionEnvelope(Battle.VisualStep(), 2, 28, 58, -78)
    End If

    For Index = BaseIndex To BaseIndex + CINDERLING_PARTS_PER_ENEMY - 1
        Call Graphics3D.SetObjectVisible(CinderlingParts[Index], True)
        Call Graphics3D.SetObjectColor(CinderlingParts[Index], 255, 255, 255)
    End For

    If (Not Defeated And
        Battle.VisualTarget() = Battle.PARTICIPANT_CINDERLING_ONE + EnemyIndex And
        VisualHasImpact(Battle.Visual()) And
        Battle.VisualStep() >= 29 And
        Battle.VisualStep() <= 35) Then

        For Index = BaseIndex To BaseIndex + CINDERLING_PARTS_PER_ENEMY - 1
            Call Graphics3D.SetObjectColor(CinderlingParts[Index], 255, 225, 190)
        End For

    End If

    If Defeated Then

        ''' A readable bone pile remains for the rest of the wave. Equipment
        ''' stays beside the collapsed anatomy so each defeated role is still
        ''' identifiable until the scene clears it at the next wave boundary.

        Call ApplyPart(CinderlingParts[BaseIndex], X, -46, Z, 64, 20, 50, 0, 0, 88)
        Call ApplyPart(CinderlingParts[BaseIndex + 1], X - 74, -42, Z + 8, 54, 48, 50, 0, 0, 96)
        Call ApplyPart(CinderlingParts[BaseIndex + 2], X - 18, -48, Z - 36, 14, 76, 14, 0, 0, 88)
        Call ApplyPart(CinderlingParts[BaseIndex + 3], X - 48, -49, Z - 39, 12, 66, 12, 0, 0, 93)
        Call ApplyPart(CinderlingParts[BaseIndex + 4], X + 26, -48, Z + 34, 14, 76, 14, 0, 0, 94)
        Call ApplyPart(CinderlingParts[BaseIndex + 5], X + 60, -49, Z + 37, 12, 66, 12, 0, 0, 87)
        Call ApplyPart(CinderlingParts[BaseIndex + 6], X - 18, -39, Z, 14, 82, 14, 0, 0, 91)
        Call ApplyPart(CinderlingParts[BaseIndex + 7], X - 88, -47, Z + 8, 34, 13, 38, 0, 0, 97)
        Call ApplyPart(CinderlingParts[BaseIndex + 8], X - 24, -43, Z - 68, 12, 62, 12, 0, 0, 82)
        Call ApplyPart(CinderlingParts[BaseIndex + 9], X - 47, -43, Z - 72, 10, 54, 10, 0, 0, 99)
        Call ApplyPart(CinderlingParts[BaseIndex + 10], X + 8, -43, Z + 69, 12, 62, 12, 0, 0, 98)
        Call ApplyPart(CinderlingParts[BaseIndex + 11], X + 36, -43, Z + 72, 10, 54, 10, 0, 0, 81)
        Call ApplyPart(CinderlingParts[BaseIndex + 12], X - 61, -38, Z - 72, 20, 20, 20, 0, 0, 0)
        Call ApplyPart(CinderlingParts[BaseIndex + 13], X + 52, -38, Z + 72, 20, 20, 20, 0, 0, 0)
        Call ApplyPart(CinderlingParts[BaseIndex + 14], X - 76, -48, Z - 33, 30, 18, 24, 0, 0, 86)
        Call ApplyPart(CinderlingParts[BaseIndex + 15], X + 78, -48, Z + 32, 30, 18, 24, 0, 0, 94)
        Call ApplyPart(CinderlingParts[BaseIndex + 16], X - 6, -42, Z - 56, 36, 28, 42, 77, 0, 83)
        Call ApplyPart(CinderlingParts[BaseIndex + 17], X + 15, -42, Z + 53, 36, 28, 42, -77, 0, 97)
        Call ApplyPart(CinderlingParts[BaseIndex + 18], X - 20, -40, Z - 16, 54, 54, 18, 90, 0, 90)
        Call ApplyPart(CinderlingParts[BaseIndex + 19], X + 18, -40, Z + 15, 54, 54, 18, 90, 0, 90)
        Call ApplyPart(CinderlingParts[BaseIndex + 20], X - 42, -45, Z + 1, 11, 34, 11, 0, 0, 91)

        For Index = BaseIndex + 21 To BaseIndex + 29
            Call ApplyPart(CinderlingParts[Index], X + ((Index - BaseIndex) Mod 5) * 27 - 54, -39, Z + ((Index - BaseIndex) Mod 4) * 32 - 48, 24, 31, 24, 90, 0, (Index - BaseIndex) * 19)
        End For

        For Index = BaseIndex To BaseIndex + CINDERLING_PARTS_PER_ENEMY - 1
            Call Graphics3D.SetObjectColor(CinderlingParts[Index], 128, 112, 116)
        End For

        Call Graphics3D.SetObjectColor(CinderlingParts[BaseIndex + 28], 18, 7, 24)
        Call Graphics3D.SetObjectColor(CinderlingParts[BaseIndex + 29], 18, 7, 24)

        Call ScaleCinderlingPose(EnemyIndex, X, Z)

        Return

    End If

    HipY = 42 + Pulse / 6
    ShoulderY = 132 + Pulse / 6
    HeadY = 178 + Pulse / 6

    LeftUpperAngle = -12
    LeftLowerAngle = 8
    RightUpperAngle = 12
    RightLowerAngle = -8

    If EnemyIndex = 0 Then

        RightUpperAngle = -22 + AttackSwing
        RightLowerAngle = -16 + AttackSwing / 2
        LeftUpperAngle = 14 - AttackSwing / 5
        LeftLowerAngle = -5

    Else If EnemyIndex = 1 Then

        LeftUpperAngle = 142 - AttackSwing / 3
        LeftLowerAngle = 166 - AttackSwing / 4
        RightUpperAngle = 28 + AttackSwing / 4
        RightLowerAngle = 5 + AttackSwing / 3

    Else

        LeftUpperAngle = 72 + AttackSwing / 5
        LeftLowerAngle = 84 + AttackSwing / 5
        RightUpperAngle = 68 - AttackSwing / 6
        RightLowerAngle = 82 - AttackSwing / 5

    End If

    LeftThigh = Articulation.SolveHangingSegment(X, HipY, Z - 24, 48, 5, -3)
    LeftShin = Articulation.SolveHangingSegment(LeftThigh.EndX, LeftThigh.EndY, LeftThigh.EndZ, 46, -6, 0)
    RightThigh = Articulation.SolveHangingSegment(X, HipY, Z + 24, 48, -5, 3)
    RightShin = Articulation.SolveHangingSegment(RightThigh.EndX, RightThigh.EndY, RightThigh.EndZ, 46, 6, 0)
    Spine = Articulation.SolveHangingSegment(X, HipY + 8, Z, 82, 180, 0)
    Neck = Articulation.SolveHangingSegment(Spine.EndX, Spine.EndY, Spine.EndZ, 18, 180, 0)
    LeftUpperArm = Articulation.SolveHangingSegment(X, ShoulderY, Z - 43, 42, LeftUpperAngle, -5)
    LeftLowerArm = Articulation.SolveHangingSegment(LeftUpperArm.EndX, LeftUpperArm.EndY, LeftUpperArm.EndZ, 38, LeftLowerAngle, -2)
    RightUpperArm = Articulation.SolveHangingSegment(X, ShoulderY, Z + 43, 42, RightUpperAngle, 5)
    RightLowerArm = Articulation.SolveHangingSegment(RightUpperArm.EndX, RightUpperArm.EndY, RightUpperArm.EndZ, 38, RightLowerAngle, 2)

    Call ApplyPart(CinderlingParts[BaseIndex], X, HipY + 8, Z, 54, 28, 54, 0, 0, 0)
    Call ApplyPart(CinderlingParts[BaseIndex + 1], X - 4, HeadY, Z, 55, 58, 52, 0, 0, -4)
    Call ApplySegment(CinderlingParts[BaseIndex + 2], LeftThigh, 12)
    Call ApplySegment(CinderlingParts[BaseIndex + 3], LeftShin, 10)
    Call ApplySegment(CinderlingParts[BaseIndex + 4], RightThigh, 12)
    Call ApplySegment(CinderlingParts[BaseIndex + 5], RightShin, 10)
    Call ApplySegment(CinderlingParts[BaseIndex + 6], Spine, 8)
    Call ApplyPart(CinderlingParts[BaseIndex + 7], X - 30, HeadY - 16, Z, 31, 14, 42, 0, 0, 0)
    Call ApplySegment(CinderlingParts[BaseIndex + 8], LeftUpperArm, 7)
    Call ApplySegment(CinderlingParts[BaseIndex + 9], LeftLowerArm, 6)
    Call ApplySegment(CinderlingParts[BaseIndex + 10], RightUpperArm, 7)
    Call ApplySegment(CinderlingParts[BaseIndex + 11], RightLowerArm, 6)
    Call ApplyPart(CinderlingParts[BaseIndex + 12], LeftLowerArm.EndX, LeftLowerArm.EndY, LeftLowerArm.EndZ, 17, 18, 17, 0, 0, 0)
    Call ApplyPart(CinderlingParts[BaseIndex + 13], RightLowerArm.EndX, RightLowerArm.EndY, RightLowerArm.EndZ, 17, 18, 17, 0, 0, 0)
    Call ApplyPart(CinderlingParts[BaseIndex + 14], LeftShin.EndX + 7, LeftShin.EndY - 2, LeftShin.EndZ, 29, 18, 25, 0, 0, 0)
    Call ApplyPart(CinderlingParts[BaseIndex + 15], RightShin.EndX + 7, RightShin.EndY - 2, RightShin.EndZ, 29, 18, 25, 0, 0, 0)
    Call ApplyPart(CinderlingParts[BaseIndex + 18], X - 5, HipY + 56, Z, 61, 54, 18, 90, 0, 90)
    Call ApplyPart(CinderlingParts[BaseIndex + 19], X - 5, HipY + 78, Z, 68, 58, 18, 90, 0, 90)
    Call ApplySegment(CinderlingParts[BaseIndex + 20], Neck, 7)
    Call ApplyPart(CinderlingParts[BaseIndex + 28], X - 30, HeadY + 7, Z - 11, 12, 15, 10, 0, 0, 0)
    Call ApplyPart(CinderlingParts[BaseIndex + 29], X - 30, HeadY + 7, Z + 11, 12, 15, 10, 0, 0, 0)

    If EnemyIndex = 0 Then

        ''' Boneguard: heavy asymmetric armor, crested helm, sword and shield.

        WeaponPose = Articulation.SolveHangingSegment(RightLowerArm.EndX, RightLowerArm.EndY, RightLowerArm.EndZ, 105, -76 + AttackSwing / 3, 0)

        Call ApplyPart(CinderlingParts[BaseIndex + 16], X, ShoulderY + 2, Z - 44, 50, 42, 52, 70, 0, 18)
        Call ApplyPart(CinderlingParts[BaseIndex + 17], X, ShoulderY + 1, Z + 44, 43, 36, 47, -70, 0, 18)
        Call ApplySegment(CinderlingParts[BaseIndex + 21], WeaponPose, 7)
        Call ApplyPart(CinderlingParts[BaseIndex + 22], RightLowerArm.EndX, RightLowerArm.EndY, RightLowerArm.EndZ, 8, 8, 42, 0, 0, WeaponPose.RotationZ)
        Call ApplyPart(CinderlingParts[BaseIndex + 23], LeftLowerArm.EndX - 4, LeftLowerArm.EndY + 9, LeftLowerArm.EndZ, 82, 15, 82, 0, 0, 90)
        Call ApplyPart(CinderlingParts[BaseIndex + 24], LeftLowerArm.EndX - 8, LeftLowerArm.EndY + 9, LeftLowerArm.EndZ, 27, 27, 27, 0, 0, 0)
        Call ApplyPart(CinderlingParts[BaseIndex + 25], X - 3, HeadY + 9, Z, 64, 48, 60, 0, 0, 0)
        Call ApplyPart(CinderlingParts[BaseIndex + 26], X + 2, HeadY + 43, Z, 21, 43, 22, 0, 0, 0)
        Call ApplyPart(CinderlingParts[BaseIndex + 27], X, HipY - 2, Z, 72, 52, 64, 0, 0, 180)

    Else If EnemyIndex = 1 Then

        ''' Necromancer: layered hood and robe with an elevated glowing staff.

        WeaponPose = Articulation.SolveHangingSegment(LeftLowerArm.EndX, LeftLowerArm.EndY, LeftLowerArm.EndZ, 166, 168 - AttackSwing / 5, 0)

        Call ApplyPart(CinderlingParts[BaseIndex + 16], X - 1, HeadY + 10, Z, 90, 102, 90, 0, 0, 180)
        Call ApplyPart(CinderlingParts[BaseIndex + 17], X + 3, ShoulderY + 1, Z, 124, 55, 108, 0, 0, 180)
        Call ApplySegment(CinderlingParts[BaseIndex + 21], WeaponPose, 6)
        Call ApplyPart(CinderlingParts[BaseIndex + 22], WeaponPose.EndX, WeaponPose.EndY, WeaponPose.EndZ, 38, 38, 38, 0, AnimationStep * 4, 0)
        Call ApplyPart(CinderlingParts[BaseIndex + 23], WeaponPose.EndX, WeaponPose.EndY, WeaponPose.EndZ, 52, 52, 52, 90, AnimationStep * 6, 0)
        Call ApplyPart(CinderlingParts[BaseIndex + 24], X, HipY + 25, Z - 23, 73, 124, 55, 0, 0, 180)
        Call ApplyPart(CinderlingParts[BaseIndex + 25], X, HipY + 25, Z + 23, 73, 124, 55, 0, 0, 180)
        Call ApplyPart(CinderlingParts[BaseIndex + 26], X - 2, HipY + 12, Z, 75, 10, 61, 0, 0, 0)
        Call ApplyPart(CinderlingParts[BaseIndex + 27], X - 38, HipY + 65, Z, 49, 49, 49, 90, AnimationStep * 3, 0)

    Else

        ''' Dread Archer: broad hat, quiver, segmented bow and nocked arrow.

        BowUpper = Articulation.SolveHangingSegment(LeftLowerArm.EndX - 4, LeftLowerArm.EndY, LeftLowerArm.EndZ, 72, 145, 0)
        BowLower = Articulation.SolveHangingSegment(LeftLowerArm.EndX - 4, LeftLowerArm.EndY, LeftLowerArm.EndZ, 72, 35, 0)

        Call ApplyPart(CinderlingParts[BaseIndex + 16], X, ShoulderY, Z - 43, 44, 38, 46, 70, 0, 16)
        Call ApplyPart(CinderlingParts[BaseIndex + 17], X + 4, ShoulderY - 8, Z + 20, 91, 48, 80, -28, 0, 178)
        Call ApplySegment(CinderlingParts[BaseIndex + 21], BowUpper, 5)
        Call ApplySegment(CinderlingParts[BaseIndex + 22], BowLower, 5)
        Call ApplyPart(CinderlingParts[BaseIndex + 23], LeftLowerArm.EndX - 46, LeftLowerArm.EndY, LeftLowerArm.EndZ, 3, 136, 3, 0, 0, 0)
        Call ApplyPart(CinderlingParts[BaseIndex + 24], LeftLowerArm.EndX - 50, LeftLowerArm.EndY, LeftLowerArm.EndZ, 4, 112, 4, 0, 0, 90)
        Call ApplyPart(CinderlingParts[BaseIndex + 25], X + 24, ShoulderY + 2, Z + 39, 39, 108, 39, 15, 0, -28)
        Call ApplyPart(CinderlingParts[BaseIndex + 26], X - 2, HeadY + 27, Z, 104, 47, 104, 0, 0, 180)
        Call ApplyPart(CinderlingParts[BaseIndex + 27], X + 20, ShoulderY - 20, Z + 37, 34, 92, 34, 12, 0, -25)

    End If

    Call ScaleCinderlingPose(EnemyIndex, X, Z)

End Sub

Private Sub CreateDragon()

    ''' Sixty-piece faceted boss rig. The broad masses stay readable at arena
    ''' distance, while the articulated outer wings, jaw, teeth, brow blades,
    ''' layered belly, extra talons, and tail fins hold up during close shots.

    Call InitializeRigPart(DragonParts[0], RIG_SPHERE, DragonMaterial)
    Call InitializeRigPart(DragonParts[1], RIG_SPHERE, DragonMaterial)
    Call InitializeRigPart(DragonParts[2], RIG_CYLINDER, DragonMaterial)
    Call InitializeRigPart(DragonParts[3], RIG_CYLINDER, DragonMaterial)
    Call InitializeRigPart(DragonParts[4], RIG_SPHERE, DragonMaterial)
    Call InitializeRigPart(DragonParts[5], RIG_CUBE, DragonMaterial)
    Call InitializeRigPart(DragonParts[6], RIG_CUBE, DragonMaterial)
    Call InitializeRigPart(DragonParts[7], RIG_PYRAMID, DragonUnderbellyMaterial)
    Call InitializeRigPart(DragonParts[8], RIG_PYRAMID, DragonUnderbellyMaterial)
    Call InitializeRigPart(DragonParts[9], RIG_SPHERE, LavaMaterial)
    Call InitializeRigPart(DragonParts[10], RIG_SPHERE, LavaMaterial)
    Call InitializeRigPart(DragonParts[11], RIG_CYLINDER, DragonMaterial)
    Call InitializeRigPart(DragonParts[12], RIG_WING, DragonWingMaterial)
    Call InitializeRigPart(DragonParts[13], RIG_CYLINDER, DragonMaterial)
    Call InitializeRigPart(DragonParts[14], RIG_WING, DragonWingMaterial)
    Call InitializeRigPart(DragonParts[15], RIG_CYLINDER, DragonMaterial)
    Call InitializeRigPart(DragonParts[16], RIG_CYLINDER, DragonMaterial)
    Call InitializeRigPart(DragonParts[17], RIG_PYRAMID, DragonUnderbellyMaterial)
    Call InitializeRigPart(DragonParts[18], RIG_CYLINDER, DragonMaterial)
    Call InitializeRigPart(DragonParts[19], RIG_CYLINDER, DragonMaterial)
    Call InitializeRigPart(DragonParts[20], RIG_PYRAMID, DragonUnderbellyMaterial)
    Call InitializeRigPart(DragonParts[21], RIG_CYLINDER, DragonMaterial)
    Call InitializeRigPart(DragonParts[22], RIG_CYLINDER, DragonMaterial)
    Call InitializeRigPart(DragonParts[23], RIG_PYRAMID, DragonUnderbellyMaterial)
    Call InitializeRigPart(DragonParts[24], RIG_CYLINDER, DragonMaterial)
    Call InitializeRigPart(DragonParts[25], RIG_CYLINDER, DragonMaterial)
    Call InitializeRigPart(DragonParts[26], RIG_PYRAMID, DragonUnderbellyMaterial)
    Call InitializeRigPart(DragonParts[27], RIG_CYLINDER, DragonMaterial)
    Call InitializeRigPart(DragonParts[28], RIG_CYLINDER, DragonMaterial)
    Call InitializeRigPart(DragonParts[29], RIG_CYLINDER, DragonMaterial)
    Call InitializeRigPart(DragonParts[30], RIG_PYRAMID, DragonUnderbellyMaterial)
    Call InitializeRigPart(DragonParts[31], RIG_SPHERE, LavaMaterial)
    Call InitializeRigPart(DragonParts[32], RIG_PYRAMID, DragonMaterial)
    Call InitializeRigPart(DragonParts[33], RIG_PYRAMID, DragonMaterial)
    Call InitializeRigPart(DragonParts[34], RIG_PYRAMID, DragonMaterial)
    Call InitializeRigPart(DragonParts[35], RIG_SPHERE, DragonUnderbellyMaterial)
    Call InitializeRigPart(DragonParts[36], RIG_PYRAMID, DragonUnderbellyMaterial)
    Call InitializeRigPart(DragonParts[37], RIG_PYRAMID, DragonUnderbellyMaterial)
    Call InitializeRigPart(DragonParts[38], RIG_PYRAMID, DragonMaterial)
    Call InitializeRigPart(DragonParts[39], RIG_PYRAMID, DragonMaterial)
    Call InitializeRigPart(DragonParts[40], RIG_PYRAMID, SteelMaterial)
    Call InitializeRigPart(DragonParts[41], RIG_PYRAMID, SteelMaterial)
    Call InitializeRigPart(DragonParts[42], RIG_PYRAMID, SteelMaterial)
    Call InitializeRigPart(DragonParts[43], RIG_PYRAMID, SteelMaterial)
    Call InitializeRigPart(DragonParts[44], RIG_PYRAMID, SteelMaterial)
    Call InitializeRigPart(DragonParts[45], RIG_PYRAMID, SteelMaterial)
    Call InitializeRigPart(DragonParts[46], RIG_PYRAMID, DragonUnderbellyMaterial)
    Call InitializeRigPart(DragonParts[47], RIG_PYRAMID, DragonUnderbellyMaterial)
    Call InitializeRigPart(DragonParts[48], RIG_PYRAMID, DragonUnderbellyMaterial)
    Call InitializeRigPart(DragonParts[49], RIG_PYRAMID, DragonUnderbellyMaterial)
    Call InitializeRigPart(DragonParts[50], RIG_CYLINDER, DragonMaterial)
    Call InitializeRigPart(DragonParts[51], RIG_WING, DragonWingMaterial)
    Call InitializeRigPart(DragonParts[52], RIG_CYLINDER, DragonMaterial)
    Call InitializeRigPart(DragonParts[53], RIG_WING, DragonWingMaterial)
    Call InitializeRigPart(DragonParts[54], RIG_PYRAMID, DragonMaterial)
    Call InitializeRigPart(DragonParts[55], RIG_PYRAMID, DragonMaterial)
    Call InitializeRigPart(DragonParts[56], RIG_PYRAMID, DragonMaterial)
    Call InitializeRigPart(DragonParts[57], RIG_PYRAMID, DragonMaterial)
    Call InitializeRigPart(DragonParts[58], RIG_PYRAMID, DragonMaterial)
    Call InitializeRigPart(DragonParts[59], RIG_PYRAMID, DragonMaterial)

    Call PoseDragon(DRAGON_ROOT_X, DRAGON_ROOT_Y, DRAGON_ROOT_Z, Battle.VISUAL_IDLE, 0, 0)

End Sub

Private Sub ScaleDragonPose(PivotX As Number, PivotY As Number, PivotZ As Number)

    Dim Index As Number

    For Index = 0 To DRAGON_OBJECT_COUNT - 1

        Call Graphics3D.SetObjectPosition(
            DragonParts[Index],
            PivotX + (DragonParts[Index].Position.X - PivotX) * DRAGON_SCALE_PERCENT / 100,
            PivotY + (DragonParts[Index].Position.Y - PivotY) * DRAGON_SCALE_PERCENT / 100,
            PivotZ + (DragonParts[Index].Position.Z - PivotZ) * DRAGON_SCALE_PERCENT / 100
        )
        Call Graphics3D.SetObjectScale(
            DragonParts[Index],
            DragonParts[Index].ScaleX * DRAGON_SCALE_PERCENT / 100,
            DragonParts[Index].ScaleY * DRAGON_SCALE_PERCENT / 100,
            DragonParts[Index].ScaleZ * DRAGON_SCALE_PERCENT / 100
        )
    End For

End Sub

Private Sub PoseDragon(
    RootX As Number,
    RootY As Number,
    RootZ As Number,
    Visual As Number,
    StepValue As Number,
    AnimationStep As Number
)

    Dim Index As Number
    Dim WingFlap As Number
    Dim WingSpread As Number
    Dim TailSweep As Number
    Dim ClawReach As Number
    Dim JawOpen As Number
    Dim RoarLift As Number
    Dim BodyPulse As Number
    Dim BodyTilt As Number
    Dim LegTuck As Number
    Dim LandingCompression As Number
    Dim NeckBaseFall As Number
    Dim NeckUpperFall As Number
    Dim HeadTilt As Number
    Dim HitRecoil As Number
    Dim HeadX As Number
    Dim HeadY As Number
    Dim HeadZ As Number
    Dim LeftWing As Articulation.SegmentPose3D
    Dim LeftWingTip As Articulation.SegmentPose3D
    Dim RightWing As Articulation.SegmentPose3D
    Dim RightWingTip As Articulation.SegmentPose3D
    Dim NeckBase As Articulation.SegmentPose3D
    Dim NeckUpper As Articulation.SegmentPose3D
    Dim FrontLeftUpper As Articulation.SegmentPose3D
    Dim FrontLeftLower As Articulation.SegmentPose3D
    Dim FrontRightUpper As Articulation.SegmentPose3D
    Dim FrontRightLower As Articulation.SegmentPose3D
    Dim RearLeftUpper As Articulation.SegmentPose3D
    Dim RearLeftLower As Articulation.SegmentPose3D
    Dim RearRightUpper As Articulation.SegmentPose3D
    Dim RearRightLower As Articulation.SegmentPose3D
    Dim TailBase As Articulation.SegmentPose3D
    Dim TailMiddle As Articulation.SegmentPose3D
    Dim TailTip As Articulation.SegmentPose3D

    WingFlap = Articulation.CycleAngle(AnimationStep, 48, 10, 0)
    WingSpread = 52 + WingFlap / 3
    BodyPulse = Abs(Articulation.CycleAngle(AnimationStep, 54, 8, 0))

    For Index = 0 To DRAGON_OBJECT_COUNT - 1
        Call Graphics3D.SetObjectColor(DragonParts[Index], 255, 255, 255)
    End For

    If (Battle.VisualTarget() = Battle.PARTICIPANT_ASHWING And
        VisualHasImpact(Visual) And
        StepValue >= 29 And
        StepValue <= 35) Then

        For Index = 0 To DRAGON_OBJECT_COUNT - 1
            Call Graphics3D.SetObjectColor(DragonParts[Index], 255, 185, 155)
        End For

    End If

    If (Battle.VisualTarget() = Battle.PARTICIPANT_ASHWING And
        VisualHasImpact(Visual)) Then
        HitRecoil = Articulation.ActionEnvelope(StepValue, 28, 33, 45, 38)
    End If

    If Visual = Battle.VISUAL_BOSS_ENTRANCE Then

        WingFlap = Articulation.CycleAngle(StepValue, 20, 26, 0)
        WingSpread = 56 + WingFlap / 2
        LegTuck = Max(0, 64 - StepValue / 3)
        LandingCompression = Articulation.ActionEnvelope(StepValue, 164, 190, 222, 34)

    Else If Visual = Battle.VISUAL_DRAGON_CLAW Then

        ClawReach = Articulation.ActionEnvelope(StepValue, 3, 24, 55, -82)
        RoarLift = Articulation.ActionEnvelope(StepValue, 2, 18, 48, 18)

    Else If Visual = Battle.VISUAL_DRAGON_TAIL Then

        TailSweep = Articulation.ActionEnvelope(StepValue, 2, 28, 64, 58)
        BodyTilt = Articulation.ActionEnvelope(StepValue, 2, 28, 64, -12)

    Else If (Visual = Battle.VISUAL_DRAGON_BREATH Or
        Visual = Battle.VISUAL_DRAGON_CATASTROPHE) Then

        JawOpen = Articulation.ActionEnvelope(StepValue, 2, 22, 68, 34)
        RoarLift = Articulation.ActionEnvelope(StepValue, 2, 22, 68, 24)
        BodyPulse = BodyPulse + Articulation.ActionEnvelope(StepValue, 10, 35, 68, 24)

        If Visual = Battle.VISUAL_DRAGON_CATASTROPHE Then

            JawOpen = JawOpen + 12
            RoarLift = RoarLift + 12
            WingSpread = WingSpread + 18
            BodyPulse = BodyPulse + 28

        End If

    Else If Visual = Battle.VISUAL_ENRAGE Then

        JawOpen = Articulation.ActionEnvelope(StepValue, 2, 30, 78, 38)
        RoarLift = Articulation.ActionEnvelope(StepValue, 2, 28, 82, 30)
        WingSpread = WingSpread + Articulation.ActionEnvelope(StepValue, 2, 32, 88, 18)
        BodyPulse = BodyPulse + Articulation.ActionEnvelope(StepValue, 8, 35, 86, 32)

    Else If Visual = Battle.VISUAL_VICTORY Then

        WingFlap = 0
        BodyPulse = 0
        BodyTilt = 0
        JawOpen = Min(30, StepValue / 5)
        WingSpread = 38
        TailSweep = 28
        NeckBaseFall = Min(74, StepValue * 2)
        NeckUpperFall = Min(28, StepValue)
        HeadTilt = Min(78, StepValue * 2)

    Else If Visual = Battle.VISUAL_DEFEAT Then

        JawOpen = Articulation.ActionEnvelope(StepValue, 2, 30, 84, 38)
        RoarLift = Articulation.ActionEnvelope(StepValue, 2, 30, 84, 32)
        WingSpread = 58 + WingFlap / 2

    End If

    RootX = RootX + HitRecoil

    Call ApplyPart(DragonParts[0], RootX, RootY - LandingCompression, RootZ, 372 + BodyPulse, 216 + BodyPulse, 224 + BodyPulse, 0, 0, BodyTilt)
    Call ApplyPart(DragonParts[1], RootX - 112, RootY + 8 - LandingCompression, RootZ, 224 + BodyPulse, 224 + BodyPulse, 210 + BodyPulse, 0, 0, BodyTilt - 4)
    Call ApplyPart(DragonParts[35], RootX - 146, RootY - 20 - LandingCompression, RootZ, 92, 166, 184, 0, 0, -10)

    NeckBase = Articulation.SolveHangingSegment(RootX - 126, RootY + 82 - LandingCompression, RootZ, 178, -138 - RoarLift / 3 + NeckBaseFall, 0)
    NeckUpper = Articulation.SolveHangingSegment(NeckBase.EndX, NeckBase.EndY, NeckBase.EndZ, 154, -148 - RoarLift / 2 + NeckUpperFall, 0)

    Call ApplySegment(DragonParts[2], NeckBase, 44)
    Call ApplySegment(DragonParts[3], NeckUpper, 36)

    HeadX = NeckUpper.EndX - 10
    HeadY = NeckUpper.EndY
    HeadZ = NeckUpper.EndZ

    Call ApplyPart(DragonParts[4], HeadX, HeadY, HeadZ, 158, 120, 142, 0, 0, HeadTilt - RoarLift / 3)
    Call ApplyPart(DragonParts[5], HeadX - 104, HeadY - 11, HeadZ, 152, 56, 92, 0, 0, HeadTilt - JawOpen / 4)
    Call ApplyPart(DragonParts[6], HeadX - 94, HeadY - 47 - JawOpen / 2, HeadZ, 138, 34, 84, 0, 0, HeadTilt - JawOpen)
    Call ApplyPart(DragonParts[7], HeadX + 20, HeadY + 62, HeadZ - 38, 38, 124, 38, 10, 0, -42)
    Call ApplyPart(DragonParts[8], HeadX + 20, HeadY + 62, HeadZ + 38, 38, 124, 38, -10, 0, -42)
    Call ApplyPart(DragonParts[9], HeadX - 48, HeadY + 22, HeadZ - 54, 22, 18, 22, 0, 0, 0)
    Call ApplyPart(DragonParts[10], HeadX - 48, HeadY + 22, HeadZ + 54, 22, 18, 22, 0, 0, 0)
    Call ApplyPart(DragonParts[31], HeadX - 75, HeadY - 34 - JawOpen / 3, HeadZ, 68 + BodyPulse, 68 + BodyPulse, 68 + BodyPulse, 0, 0, 0)

    ''' Layered orange throat plates and swept brow fins reproduce the angular
    ''' red/orange silhouette of the visual reference without relying on a
    ''' single rounded primitive.

    Call ApplyPart(DragonParts[36], NeckBase.CenterX - 12, NeckBase.CenterY - 30, NeckBase.CenterZ, 76, 112, 102, 0, 0, NeckBase.RotationZ + 180)
    Call ApplyPart(DragonParts[37], NeckUpper.CenterX - 10, NeckUpper.CenterY - 26, NeckUpper.CenterZ, 64, 96, 88, 0, 0, NeckUpper.RotationZ + 180)
    Call ApplyPart(DragonParts[38], HeadX - 8, HeadY + 34, HeadZ - 44, 44, 72, 24, 22, 0, -62)
    Call ApplyPart(DragonParts[39], HeadX - 8, HeadY + 34, HeadZ + 44, 44, 72, 24, -22, 0, -62)

    ''' Six individually posed teeth remain visible as the lower jaw opens.

    Call ApplyPart(DragonParts[40], HeadX - 128, HeadY - 30, HeadZ - 31, 12, 30, 12, 0, 0, 180)
    Call ApplyPart(DragonParts[41], HeadX - 128, HeadY - 30, HeadZ + 31, 12, 30, 12, 0, 0, 180)
    Call ApplyPart(DragonParts[42], HeadX - 82, HeadY - 30, HeadZ - 38, 11, 26, 11, 0, 0, 180)
    Call ApplyPart(DragonParts[43], HeadX - 82, HeadY - 30, HeadZ + 38, 11, 26, 11, 0, 0, 180)
    Call ApplyPart(DragonParts[44], HeadX - 111, HeadY - 51 - JawOpen / 2, HeadZ - 27, 12, 27, 12, 0, 0, 0)
    Call ApplyPart(DragonParts[45], HeadX - 111, HeadY - 51 - JawOpen / 2, HeadZ + 27, 12, 27, 12, 0, 0, 0)

    LeftWing = Articulation.SolveHangingSegment(RootX + 18, RootY + 72 - LandingCompression, RootZ - 68, 272, -132 - WingFlap / 3, 0 - WingSpread)
    RightWing = Articulation.SolveHangingSegment(RootX + 18, RootY + 72 - LandingCompression, RootZ + 68, 272, -132 - WingFlap / 3, WingSpread)
    LeftWingTip = Articulation.SolveHangingSegment(LeftWing.EndX, LeftWing.EndY, LeftWing.EndZ, 236, -70 + WingFlap / 4, 0 - Min(82, WingSpread + 22))
    RightWingTip = Articulation.SolveHangingSegment(RightWing.EndX, RightWing.EndY, RightWing.EndZ, 236, -70 + WingFlap / 4, Min(82, WingSpread + 22))

    Call ApplySegment(DragonParts[11], LeftWing, 25)
    Call ApplyPart(DragonParts[12], LeftWing.CenterX, LeftWing.CenterY, LeftWing.CenterZ, 204, LeftWing.Length + 92, 20, LeftWing.RotationX, LeftWing.RotationY, LeftWing.RotationZ)
    Call ApplySegment(DragonParts[13], RightWing, 25)
    Call ApplyPart(DragonParts[14], RightWing.CenterX, RightWing.CenterY, RightWing.CenterZ, 204, RightWing.Length + 92, 20, RightWing.RotationX, RightWing.RotationY, RightWing.RotationZ)
    Call ApplySegment(DragonParts[50], LeftWingTip, 17)
    Call ApplyPart(DragonParts[51], LeftWingTip.CenterX, LeftWingTip.CenterY, LeftWingTip.CenterZ, 158, LeftWingTip.Length + 82, 17, LeftWingTip.RotationX, LeftWingTip.RotationY, LeftWingTip.RotationZ)
    Call ApplySegment(DragonParts[52], RightWingTip, 17)
    Call ApplyPart(DragonParts[53], RightWingTip.CenterX, RightWingTip.CenterY, RightWingTip.CenterZ, 158, RightWingTip.Length + 82, 17, RightWingTip.RotationX, RightWingTip.RotationY, RightWingTip.RotationZ)

    FrontLeftUpper = Articulation.SolveHangingSegment(RootX - 92, RootY - 34 - LandingCompression, RootZ - 78, 104, -20 - LegTuck + ClawReach, -8)
    FrontLeftLower = Articulation.SolveHangingSegment(FrontLeftUpper.EndX, FrontLeftUpper.EndY, FrontLeftUpper.EndZ, 92, 13 + LegTuck - ClawReach / 3, -5)
    FrontRightUpper = Articulation.SolveHangingSegment(RootX - 92, RootY - 34 - LandingCompression, RootZ + 78, 104, -20 - LegTuck + ClawReach / 2, 8)
    FrontRightLower = Articulation.SolveHangingSegment(FrontRightUpper.EndX, FrontRightUpper.EndY, FrontRightUpper.EndZ, 92, 13 + LegTuck - ClawReach / 5, 5)
    RearLeftUpper = Articulation.SolveHangingSegment(RootX + 105, RootY - 38 - LandingCompression, RootZ - 74, 112, 24 + LegTuck, -8)
    RearLeftLower = Articulation.SolveHangingSegment(RearLeftUpper.EndX, RearLeftUpper.EndY, RearLeftUpper.EndZ, 94, -9 - LegTuck / 2, -5)
    RearRightUpper = Articulation.SolveHangingSegment(RootX + 105, RootY - 38 - LandingCompression, RootZ + 74, 112, 24 + LegTuck, 8)
    RearRightLower = Articulation.SolveHangingSegment(RearRightUpper.EndX, RearRightUpper.EndY, RearRightUpper.EndZ, 94, -9 - LegTuck / 2, 5)

    Call ApplySegment(DragonParts[15], FrontLeftUpper, 31)
    Call ApplySegment(DragonParts[16], FrontLeftLower, 25)
    Call ApplyPart(DragonParts[17], FrontLeftLower.EndX - 22, FrontLeftLower.EndY, FrontLeftLower.EndZ, 58, 44, 58, 0, 0, -90)
    Call ApplyPart(DragonParts[46], FrontLeftLower.EndX - 30, FrontLeftLower.EndY - 3, FrontLeftLower.EndZ - 22, 22, 54, 22, 0, 0, -90)
    Call ApplySegment(DragonParts[18], FrontRightUpper, 31)
    Call ApplySegment(DragonParts[19], FrontRightLower, 25)
    Call ApplyPart(DragonParts[20], FrontRightLower.EndX - 22, FrontRightLower.EndY, FrontRightLower.EndZ, 58, 44, 58, 0, 0, -90)
    Call ApplyPart(DragonParts[47], FrontRightLower.EndX - 30, FrontRightLower.EndY - 3, FrontRightLower.EndZ + 22, 22, 54, 22, 0, 0, -90)
    Call ApplySegment(DragonParts[21], RearLeftUpper, 36)
    Call ApplySegment(DragonParts[22], RearLeftLower, 28)
    Call ApplyPart(DragonParts[23], RearLeftLower.EndX - 18, RearLeftLower.EndY, RearLeftLower.EndZ, 64, 48, 64, 0, 0, -90)
    Call ApplyPart(DragonParts[48], RearLeftLower.EndX - 27, RearLeftLower.EndY - 3, RearLeftLower.EndZ - 24, 24, 58, 24, 0, 0, -90)
    Call ApplySegment(DragonParts[24], RearRightUpper, 36)
    Call ApplySegment(DragonParts[25], RearRightLower, 28)
    Call ApplyPart(DragonParts[26], RearRightLower.EndX - 18, RearRightLower.EndY, RearRightLower.EndZ, 64, 48, 64, 0, 0, -90)
    Call ApplyPart(DragonParts[49], RearRightLower.EndX - 27, RearRightLower.EndY - 3, RearRightLower.EndZ + 24, 24, 58, 24, 0, 0, -90)

    TailBase = Articulation.SolveHangingSegment(RootX + 140, RootY + 18 - LandingCompression, RootZ, 182, 72, TailSweep / 3)
    TailMiddle = Articulation.SolveHangingSegment(TailBase.EndX, TailBase.EndY, TailBase.EndZ, 164, 82, 0 - TailSweep / 2)
    TailTip = Articulation.SolveHangingSegment(TailMiddle.EndX, TailMiddle.EndY, TailMiddle.EndZ, 142, 87, TailSweep)

    Call ApplySegment(DragonParts[27], TailBase, 42)
    Call ApplySegment(DragonParts[28], TailMiddle, 31)
    Call ApplySegment(DragonParts[29], TailTip, 21)
    Call ApplyPart(DragonParts[30], TailTip.EndX + 22, TailTip.EndY, TailTip.EndZ, 58, 112, 58, 0, 0, -90)

    Call ApplyPart(DragonParts[32], RootX - 58, RootY + 124 - LandingCompression, RootZ, 52, 110, 52, 0, 0, -12)
    Call ApplyPart(DragonParts[33], RootX + 20, RootY + 126 - LandingCompression, RootZ, 48, 102, 48, 0, 0, 0)
    Call ApplyPart(DragonParts[34], RootX + 96, RootY + 112 - LandingCompression, RootZ, 44, 92, 44, 0, 0, 12)
    Call ApplyPart(DragonParts[54], NeckBase.CenterX + 4, NeckBase.CenterY + 28, NeckBase.CenterZ, 34, 62, 34, 0, 0, NeckBase.RotationZ - 8)
    Call ApplyPart(DragonParts[55], NeckUpper.CenterX + 3, NeckUpper.CenterY + 24, NeckUpper.CenterZ, 30, 54, 30, 0, 0, NeckUpper.RotationZ - 10)
    Call ApplyPart(DragonParts[56], RootX + 155, RootY + 78 - LandingCompression, RootZ, 38, 80, 38, 0, 0, 28)
    Call ApplyPart(DragonParts[57], TailBase.CenterX + 4, TailBase.CenterY + 38, TailBase.CenterZ, 32, 70, 32, 0, 0, TailBase.RotationZ - 8)
    Call ApplyPart(DragonParts[58], TailMiddle.CenterX, TailMiddle.CenterY + 30, TailMiddle.CenterZ, 28, 58, 28, 0, 0, TailMiddle.RotationZ - 8)
    Call ApplyPart(DragonParts[59], TailTip.CenterX, TailTip.CenterY + 22, TailTip.CenterZ, 22, 46, 22, 0, 0, TailTip.RotationZ - 8)
    Call ScaleDragonPose(RootX, RootY - 200, RootZ)

    ''' Keep attack effects attached to the animated mouth, including entrance,
    ''' recoil, roar, death, and future dragon rigs that change proportions.

    LastDragonMouthX = RootX + (HeadX - 148 - RootX) * DRAGON_SCALE_PERCENT / 100
    LastDragonMouthY = RootY - 200 + (HeadY - 28 - JawOpen / 4 - (RootY - 200)) * DRAGON_SCALE_PERCENT / 100
    LastDragonMouthZ = RootZ + (HeadZ - RootZ) * DRAGON_SCALE_PERCENT / 100

    If Visual = Battle.VISUAL_VICTORY Then

        For Index = 0 To DRAGON_OBJECT_COUNT - 1
            Call Graphics3D.SetObjectColor(DragonParts[Index], 82, 70, 74)
        End For

        ''' Extinguish the eyes and throat core so the grounded silhouette reads
        ''' as a corpse rather than a resting or stunned dragon.

        Call Graphics3D.SetObjectColor(DragonParts[9], 10, 8, 10)
        Call Graphics3D.SetObjectColor(DragonParts[10], 10, 8, 10)
        Call Graphics3D.SetObjectColor(DragonParts[31], 22, 14, 18)

    End If

End Sub

Private Sub CreateParticles()

    Dim Index As Number

    ParticleTemplate = Graphics3D.CreateSphere3D(10)
    OperationAccepted = Graphics3D.SetObjectMaterial3D(ParticleTemplate, ParticleMaterial)

    Call Graphics3D.SetObjectVisible(ParticleTemplate, False)

    For Index = 0 To PARTICLE_OBJECT_COUNT - 1
        ParticleObjects[Index] = Graphics3D.CreateObjectFromMesh3D(ParticleTemplate.MeshHandle)
        OperationAccepted = Graphics3D.SetObjectMaterial3D(ParticleObjects[Index], ParticleMaterial)

        Call Graphics3D.SetObjectVisible(ParticleObjects[Index], False)
    End For

End Sub

Private Sub CreateImpactObjects()

    Dim Index As Number

    Call InitializeRigPart(ImpactObjects[0], RIG_SPHERE, ParticleMaterial)
    Call InitializeRigPart(ImpactObjects[1], RIG_CYLINDER, ParticleMaterial)
    Call InitializeRigPart(ImpactObjects[2], RIG_TORUS, ParticleMaterial)
    Call InitializeRigPart(ImpactObjects[3], RIG_TORUS, ParticleMaterial)
    Call InitializeRigPart(ImpactObjects[4], RIG_CYLINDER, ParticleMaterial)
    Call InitializeRigPart(ImpactObjects[5], RIG_CYLINDER, ParticleMaterial)
    Call InitializeRigPart(ImpactObjects[6], RIG_CYLINDER, ParticleMaterial)
    Call InitializeRigPart(ImpactObjects[7], RIG_PYRAMID, ParticleMaterial)
    Call InitializeRigPart(ImpactObjects[8], RIG_PYRAMID, ParticleMaterial)
    Call InitializeRigPart(ImpactObjects[9], RIG_PYRAMID, ParticleMaterial)
    Call InitializeRigPart(ImpactObjects[10], RIG_CYLINDER, ParticleMaterial)
    Call InitializeRigPart(ImpactObjects[11], RIG_SPHERE, ParticleMaterial)
    Call InitializeRigPart(ImpactObjects[12], RIG_TORUS, ParticleMaterial)
    Call InitializeRigPart(ImpactObjects[13], RIG_TORUS, ParticleMaterial)
    Call InitializeRigPart(ImpactObjects[14], RIG_SPHERE, ParticleMaterial)
    Call InitializeRigPart(ImpactObjects[15], RIG_CYLINDER, ParticleMaterial)
    Call InitializeRigPart(ImpactObjects[16], RIG_CYLINDER, ParticleMaterial)
    Call InitializeRigPart(ImpactObjects[17], RIG_PYRAMID, ParticleMaterial)
    Call InitializeRigPart(ImpactObjects[18], RIG_PYRAMID, ParticleMaterial)
    Call InitializeRigPart(ImpactObjects[19], RIG_SPHERE, ParticleMaterial)

    For Index = 0 To IMPACT_OBJECT_COUNT - 1
        Call Graphics3D.SetObjectVisible(ImpactObjects[Index], False)
    End For

End Sub

Private Sub DefineActiveCameraShots()

    Dim Bounds As BattleCamera.FramingBounds3D
    Dim CombatBounds As BattleCamera.FramingBounds3D

    ''' These are group extents, not boss-specific camera coordinates. The reusable
    ''' framing API derives distance from the current encounter's occupied volume.

    Bounds.MinX = LYRA_FORMATION_X - 140
    Bounds.MinY = -70
    Bounds.MinZ = -340
    Bounds.MaxX = 650
    Bounds.MaxY = 210
    Bounds.MaxZ = 610
    CombatBounds.MinX = Bounds.MinX
    CombatBounds.MinY = Bounds.MinY
    CombatBounds.MinZ = Bounds.MinZ
    CombatBounds.MaxX = Bounds.MaxX
    CombatBounds.MaxY = Bounds.MaxY
    CombatBounds.MaxZ = Bounds.MaxZ

    If Battle.BossIsIntroduced() Then

        Bounds.MinX = LYRA_FORMATION_X - 180
        Bounds.MaxX = 2200
        Bounds.MaxY = 1020
        Bounds.MinZ = -1200
        Bounds.MaxZ = 1250
        CombatBounds.MinX = LYRA_FORMATION_X - 180
        CombatBounds.MaxX = 1500
        CombatBounds.MaxY = 1020
        CombatBounds.MinZ = -760
        CombatBounds.MaxZ = 850

    End If

    OperationAccepted = BattleCamera.DefineFramedShot(State, SHOT_WIDE, "EMBER OBSERVATORY", Bounds, -32, 25, -100, 960, 540, 54, 42, 28)
    OperationAccepted = BattleCamera.DefineFramedShot(State, SHOT_PARTY, "THE LAST LIGHT", CombatBounds, -58, 22, -100, 960, 540, 55, 35, 24)
    OperationAccepted = BattleCamera.DefineFramedShot(State, SHOT_DRAGON, "ENEMY PRESSURE", CombatBounds, -24, 28, -108, 960, 540, 59, 30, 24)
    OperationAccepted = BattleCamera.DefineFramedShot(State, SHOT_ATTACK, "HEROIC CHARGE", CombatBounds, -46, 19, -100, 960, 540, 60, 28, 14)
    OperationAccepted = BattleCamera.DefineFramedShot(State, SHOT_MAGIC, "ARCANE STORM", CombatBounds, -31, 35, -105, 960, 540, 58, 34, 18)
    OperationAccepted = BattleCamera.DefineFramedShot(State, SHOT_IMPACT, "TITAN IMPACT", CombatBounds, -12, 21, -104, 960, 540, 58, 30, 8)
    OperationAccepted = BattleCamera.DefineFramedShot(State, SHOT_BREATH, "WORLD IN FLAME", CombatBounds, -48, 24, -112, 960, 540, 62, 36, 10)
    OperationAccepted = BattleCamera.DefineFramedShot(State, SHOT_ENRAGE, "CROWN OF CINDERS", CombatBounds, -22, 39, -104, 960, 540, 55, 38, 14)
    OperationAccepted = BattleCamera.DefineFramedShot(State, SHOT_DEATH, "DRAGONFALL", Bounds, -34, 32, -114, 960, 540, 56, 45, 50)
    OperationAccepted = BattleCamera.DefineFramedShot(State, SHOT_VICTORY, "DAWN RETURNS", Bounds, -55, 31, -104, 960, 540, 54, 42, 55)
    OperationAccepted = BattleCamera.DefineFramedShot(State, SHOT_BOSS_ENTRANCE, "THE SKY BREAKS OPEN", Bounds, -44, 38, -118, 960, 540, 58, 45, 12)
    OperationAccepted = BattleCamera.DefineFramedShot(State, SHOT_IDLE_PARTY_BACK, "PARTY LINE // OVERWATCH", CombatBounds, -100, 24, -12, 960, 540, 60, 18, 28)

    LastFramedEnemyCount = Battle.ActiveEnemyCount()
    LastBossFramed = Battle.BossIsIntroduced()

End Sub

Private Sub DefinePresentation()

    Call DefineActiveCameraShots()

    Call DefineEffect(Battle.EFFECT_SLASH, "STARFIRE SLASH", 28, 32, 9, 18, -1, 255, 248, 215, 255, 70, 20, 18, 2, 72, 10)
    Call DefineEffect(Battle.EFFECT_FIRE, "EMBER NOVA", 42, 52, 11, 24, -1, 255, 205, 35, 220, 15, 3, 22, 3, 78, 13)
    Call DefineEffect(Battle.EFFECT_FROST, "ABSOLUTE ZERO", 46, 58, 9, 26, 0, 215, 250, 255, 40, 120, 255, 19, 4, 70, 11)
    Call DefineEffect(Battle.EFFECT_HEAL, "PHOENIX HYMN", 30, 62, 7, 23, 0, 255, 245, 125, 45, 255, 130, 11, 3, 40, 5)
    Call DefineEffect(Battle.EFFECT_BREATH, "CALAMITY BREATH", 64, 70, 14, 34, -1, 255, 250, 100, 180, 5, 0, 28, 5, 100, 24)
    Call DefineEffect(Battle.EFFECT_ENRAGE, "CINDER CROWN", 64, 96, 13, 38, 0, 255, 225, 55, 150, 0, 20, 26, 8, 100, 28)
    Call DefineEffect(Battle.EFFECT_DEATH, "DRAGONFALL", 64, 130, 16, 48, -2, 255, 245, 190, 65, 8, 5, 30, 2, 100, 35)
    Call DefineEffect(Battle.EFFECT_BASH, "TITAN BREAKER", 34, 42, 10, 25, -1, 255, 230, 120, 255, 45, 5, 24, 3, 88, 20)
    Call DefineEffect(Battle.EFFECT_AURORA, "AURORA STAFF", 48, 58, 13, 30, 0, 170, 255, 245, 15, 120, 255, 18, 3, 84, 18)
    Call DefineEffect(Battle.EFFECT_LIGHTNING, "SKYBREAKER ARC", 44, 42, 18, 22, -1, 245, 250, 255, 38, 105, 255, 18, 3, 92, 22)
    Call DefineEffect(Battle.EFFECT_BURNING, "LINGERING FLAME", 4, 30, 5, 16, -1, 255, 168, 30, 180, 8, 0, 13, 3, 20, 2)
    Call DefineEffect(Battle.EFFECT_CATASTROPHE, "CALDERA ANNIHILATION", 64, 96, 18, 52, -1, 255, 245, 170, 145, 0, 18, 34, 6, 100, 38)

    OperationAccepted = BattleCamera.PlayShot(State, SHOT_WIDE, 0)

End Sub

Public Function Initialize(StateHandle As Number) As Boolean

    If StateHandle = 0 Or Not Graphics3D.RendererAvailable() Then
        Return False
    End If

    State = StateHandle
    Camera = Graphics3D.DefaultCamera()
    CosmicTexture = Graphics3D.LoadTexture3D(
        "Assets\CosmicBackdrop.png",
        Graphics3D.TEXTURE_FILTER_LINEAR,
        Graphics3D.TEXTURE_WRAP_REPEAT
    )

    FloorMaterial = Material(3, 7, 18, 0, False)
    GridMaterial = Material(24, 126, 255, 90, False)
    CosmicMaterial = Graphics3D.CreateMaterial3D(
        CosmicTexture,
        Graphics3D.MATERIAL_ALPHA_OPAQUE,
        92,
        96,
        118,
        100,
        True,
        32,
        50
    )
    StoneMaterial = Material(52, 55, 68, 0, False)
    BronzeMaterial = Material(205, 110, 38, 22, False)
    LavaMaterial = Material(255, 62, 7, 100, True)
    ArinMaterial = Material(210, 30, 42, 12, False)
    SteelMaterial = Material(205, 220, 235, 18, False)
    MiraMaterial = Material(85, 35, 185, 20, False)
    FrostMaterial = Material(75, 205, 255, 90, False)
    TorMaterial = Material(220, 135, 25, 18, False)
    LyraMaterial = Material(25, 188, 172, 38, False)
    SkinMaterial = Material(232, 155, 112, 4, False)
    HairMaterial = Material(92, 58, 28, 8, False)
    ArinHairMaterial = Material(232, 186, 72, 20, False)
    TorHairMaterial = Material(38, 24, 19, 5, False)
    LeatherMaterial = Material(76, 42, 28, 5, False)
    BoneMaterial = Material(220, 224, 216, 12, False)
    VoidMaterial = Material(7, 5, 12, 0, False)
    DragonMaterial = Material(154, 20, 27, 20, False)
    DragonGlowMaterial = Material(238, 55, 12, 68, False)
    DragonWingMaterial = Material(190, 48, 19, 24, False)
    DragonUnderbellyMaterial = Material(226, 108, 35, 20, False)
    ParticleMaterial = Material(255, 255, 255, 100, True)

    Call CreateArena()
    Call CreateRigTemplates()
    Call CreateImpactObjects()
    Call CreateParty()
    Call CreateCinderlings()
    Call CreateDragon()
    Call CreateParticles()
    Call DefinePresentation()

    LastVisual = -1
    LastVisualStep = -1
    GlobalStep = 0
    LastArinOffset = 0
    LastTorOffset = 0
    LastLyraOffset = 0
    LastMiraOffset = 0
    LastArinOffsetZ = 0
    LastTorOffsetZ = 0
    LastLyraOffsetZ = 0
    LastMiraOffsetZ = 0
    LastDragonOffsetX = 0
    LastDragonOffsetY = 0
    LastDragonOffsetZ = 0
    LastCinderlingOffset[0] = 0
    LastCinderlingOffset[1] = 0
    LastCinderlingOffset[2] = 0
    BurningSteps[0] = 0
    BurningSteps[1] = 0
    BurningSteps[2] = 0
    BurningSteps[3] = 0
    CurrentActionShot = 0
    CameraInputAccepted = False
    Ready = True
    Return True

End Function

Private Sub ParticipantAnchor(Participant As Number, ByRef X As Number, ByRef Y As Number, ByRef Z As Number)

    X = 0
    Y = 80
    Z = 30

    If Participant = Battle.PARTICIPANT_ARIN Then

        X = ARIN_FORMATION_X + LastArinOffset
        Y = 72
        Z = ARIN_FORMATION_Z + LastArinOffsetZ

    Else If Participant = Battle.PARTICIPANT_MIRA Then

        X = MIRA_FORMATION_X + LastMiraOffset
        Y = 88
        Z = MIRA_FORMATION_Z + LastMiraOffsetZ

    Else If Participant = Battle.PARTICIPANT_TOR Then

        X = TOR_FORMATION_X + LastTorOffset
        Y = 78
        Z = TOR_FORMATION_Z + LastTorOffsetZ

    Else If Participant = Battle.PARTICIPANT_LYRA Then

        X = LYRA_FORMATION_X + LastLyraOffset
        Y = 82
        Z = LYRA_FORMATION_Z + LastLyraOffsetZ

    Else If Participant = Battle.PARTICIPANT_CINDERLING_ONE Then

        X = 250 + LastCinderlingOffset[0]
        Y = 110
        Z = -280

    Else If Participant = Battle.PARTICIPANT_CINDERLING_TWO Then

        X = 390 + LastCinderlingOffset[1]
        Y = 185
        Z = 40

    Else If Participant = Battle.PARTICIPANT_CINDERLING_THREE Then

        X = 270 + LastCinderlingOffset[2]
        Y = 110
        Z = 380

    Else If Participant = Battle.PARTICIPANT_ASHWING Then

        X = 420 + LastDragonOffsetX
        Y = 450 + LastDragonOffsetY
        Z = DRAGON_ROOT_Z + LastDragonOffsetZ

    End If

End Sub

Private Sub PlayVariedShot(Shot As Number)

    Dim Variation As Number

    Variation = ((GlobalStep / 73 + Shot + Battle.Visual()) Mod 3) - 1
    OperationAccepted = BattleCamera.PlayShotVariation(
        State,
        Shot,
        0,
        Variation * 48,
        Abs(Variation) * 20,
        Variation * 26,
        0,
        Variation * 8,
        0 - Variation * 24,
        Variation * 2
    )

End Sub

Private Function ParticipantFramingRadius(Participant As Number) As Number

    If Participant = Battle.PARTICIPANT_ASHWING Then
        Return 600
    End If

    If (Participant >= Battle.PARTICIPANT_CINDERLING_ONE And
        Participant <= Battle.PARTICIPANT_CINDERLING_THREE) Then

        If Participant = Battle.PARTICIPANT_CINDERLING_TWO Then
            Return 170
        End If

        Return 112

    End If

    Return 78

End Function

Private Sub DefineActionFocusShot(Shot As Number, Actor As Number, Target As Number)

    Dim ActorX As Number
    Dim ActorY As Number
    Dim ActorZ As Number
    Dim TargetX As Number
    Dim TargetY As Number
    Dim TargetZ As Number
    Dim ActorRadius As Number
    Dim TargetRadius As Number
    Dim ViewX As Number
    Dim ViewY As Number
    Dim ViewZ As Number
    Dim FocusFov As Number
    Dim Padding As Number
    Dim Bounds As BattleCamera.FramingBounds3D

    If Actor <= 0 Or Target <= 0 Then
        Return
    End If

    Call ParticipantAnchor(Actor, ActorX, ActorY, ActorZ)
    Call ParticipantAnchor(Target, TargetX, TargetY, TargetZ)

    If (Actor >= Battle.PARTICIPANT_ARIN And
        Actor <= Battle.PARTICIPANT_MIRA And
        IsPartyOffensiveVisual(Battle.Visual())) Then
        Call ActionStagePosition(Actor, Target, ActorX, ActorZ)
    End If

    ActorRadius = ParticipantFramingRadius(Actor)
    TargetRadius = ParticipantFramingRadius(Target)
    Bounds.MinX = Min(ActorX - ActorRadius, TargetX - TargetRadius)
    Bounds.MinY = Min(-65, Min(ActorY - ActorRadius, TargetY - TargetRadius))
    Bounds.MinZ = Min(ActorZ - ActorRadius, TargetZ - TargetRadius)
    Bounds.MaxX = Max(ActorX + ActorRadius, TargetX + TargetRadius)
    Bounds.MaxY = Max(ActorY + ActorRadius, TargetY + TargetRadius)
    Bounds.MaxZ = Max(ActorZ + ActorRadius, TargetZ + TargetRadius)

    ViewX = -18
    ViewY = 14
    ViewZ = 92
    FocusFov = 58
    Padding = 14

    If (Actor + Battle.Visual()) Mod 2 = 0 Then
        ViewZ = -92
    End If

    ''' Enemy attacks use a wider, more lateral view so a large creature never
    ''' occludes its target with its back while lunging toward the party.

    If Actor >= Battle.PARTICIPANT_CINDERLING_ONE Then

        ViewX = -14
        ViewY = 24
        ViewZ = -100
        FocusFov = 68
        Padding = 36

    End If

    If VisualHitsWholeParty(Battle.Visual()) Then

        Bounds.MinX = Min(Bounds.MinX, LYRA_FORMATION_X - 120)
        Bounds.MinY = Min(Bounds.MinY, -65)
        Bounds.MinZ = Min(Bounds.MinZ, -420)
        Bounds.MaxX = Max(Bounds.MaxX, TOR_FORMATION_X + 120)
        Bounds.MaxY = Max(Bounds.MaxY, 175)
        Bounds.MaxZ = Max(Bounds.MaxZ, 480)

    End If

    ''' The negative-X, negative-Z view stays on the heroes' side of every encounter.

    OperationAccepted = BattleCamera.DefineFramedShot(
        State,
        Shot,
        "ACTOR + TARGET FOCUS",
        Bounds,
        ViewX,
        ViewY,
        ViewZ,
        960,
        540,
        FocusFov,
        Padding,
        12
    )

End Sub

Private Sub DefineActorAnticipationShot(Shot As Number, Actor As Number)

    Dim X As Number
    Dim Y As Number
    Dim Z As Number
    Dim Radius As Number
    Dim ViewX As Number
    Dim ViewY As Number
    Dim ViewZ As Number
    Dim AnticipationFov As Number
    Dim Padding As Number
    Dim Bounds As BattleCamera.FramingBounds3D

    If Actor <= 0 Then
        Return
    End If

    Call ParticipantAnchor(Actor, X, Y, Z)

    Radius = ParticipantFramingRadius(Actor)
    ViewX = -35
    ViewY = 18
    ViewZ = -85
    AnticipationFov = 55
    Padding = 30
    Bounds.MinX = X - Radius
    Bounds.MinY = Min(-65, Y - Radius)
    Bounds.MinZ = Z - Radius
    Bounds.MaxX = X + Radius
    Bounds.MaxY = Y + Radius
    Bounds.MaxZ = Z + Radius

    If Actor >= Battle.PARTICIPANT_ARIN And Actor <= Battle.PARTICIPANT_MIRA Then

        ''' Look back from the enemy side so the hero's face, weapon pose, and
        ''' casting gesture dominate a centered close-up before the impact cut.

        ViewX = 100
        ViewY = 15
        ViewZ = 22
        AnticipationFov = 42
        Padding = 0
        Bounds.MinY = Y - Radius

    End If

    OperationAccepted = BattleCamera.DefineFramedShot(
        State,
        Shot,
        "ACTION ANTICIPATION",
        Bounds,
        ViewX,
        ViewY,
        ViewZ,
        960,
        540,
        AnticipationFov,
        Padding,
        8
    )

End Sub

Private Function VisualHasImpact(Visual As Number) As Boolean

    Dim ReturnValue As Boolean

    If Not Battle.VisualImpactLanded() Then
        Return False
    End If

    ReturnValue = (Visual = Battle.VISUAL_ARIN_ATTACK Or
        Visual = Battle.VISUAL_ARIN_EMBER Or
        Visual = Battle.VISUAL_MIRA_FLAME Or
        Visual = Battle.VISUAL_MIRA_FROST Or
        Visual = Battle.VISUAL_MIRA_LIGHTNING Or
        Visual = Battle.VISUAL_TOR_ATTACK Or
        Visual = Battle.VISUAL_TOR_BASH Or
        Visual = Battle.VISUAL_LYRA_ATTACK Or
        Visual = Battle.VISUAL_CINDERLING_ATTACK Or
        Visual = Battle.VISUAL_DRAGON_CLAW Or
        Visual = Battle.VISUAL_DRAGON_BREATH Or
        Visual = Battle.VISUAL_DRAGON_CATASTROPHE Or
        Visual = Battle.VISUAL_DRAGON_TAIL)
    Return ReturnValue

End Function

Private Function VisualHitsWholeParty(Visual As Number) As Boolean

    Dim ReturnValue As Boolean

    ReturnValue = (Visual = Battle.VISUAL_DRAGON_BREATH Or
        Visual = Battle.VISUAL_DRAGON_CATASTROPHE Or
        Visual = Battle.VISUAL_DRAGON_TAIL)

    Return ReturnValue

End Function

Private Sub TriggerImpactCue(Visual As Number)

    Dim EffectId As Number
    Dim X As Number
    Dim Y As Number
    Dim Z As Number
    Dim Shake As Number

    If Not VisualHasImpact(Visual) Or Battle.VisualTarget() <= 0 Then
        Return
    End If

    Call ParticipantAnchor(Battle.VisualTarget(), X, Y, Z)

    Shake = 16

    If (Visual = Battle.VISUAL_TOR_BASH Or
        Visual = Battle.VISUAL_DRAGON_BREATH Or
        Visual = Battle.VISUAL_DRAGON_CATASTROPHE Or
        Visual = Battle.VISUAL_DRAGON_TAIL) Then
        Shake = 24
    End If

    If Visual = Battle.VISUAL_DRAGON_CATASTROPHE Then
        Shake = 38
    End If

    If Visual = Battle.VISUAL_ARIN_ATTACK Or Visual = Battle.VISUAL_ARIN_EMBER Then

        EffectId = Battle.EFFECT_SLASH

    Else If Visual = Battle.VISUAL_TOR_ATTACK Or Visual = Battle.VISUAL_TOR_BASH Then

        EffectId = Battle.EFFECT_BASH

    Else If Visual = Battle.VISUAL_LYRA_ATTACK Then

        EffectId = Battle.EFFECT_AURORA

    Else If Visual = Battle.VISUAL_MIRA_FLAME Then

        EffectId = Battle.EFFECT_FIRE

    Else If Visual = Battle.VISUAL_MIRA_FROST Then

        EffectId = Battle.EFFECT_FROST

    Else If Visual = Battle.VISUAL_MIRA_LIGHTNING Then

        EffectId = Battle.EFFECT_LIGHTNING

    Else If Visual = Battle.VISUAL_DRAGON_BREATH Then

        EffectId = Battle.EFFECT_BREATH

    Else If Visual = Battle.VISUAL_DRAGON_CATASTROPHE Then

        EffectId = Battle.EFFECT_CATASTROPHE
        X = PARTY_CENTER_X
        Y = 82
        Z = 30

    Else
        EffectId = Battle.EFFECT_SLASH

    End If

    If EffectId > 0 Then
        OperationAccepted = BattleEffects.Spawn(State, EffectId, X, Y, Z, GlobalStep + Visual * 1613)
    End If

    OperationAccepted = BattleCamera.StartShake(State, Shake, 18, GlobalStep + Visual * 313)

End Sub

Private Sub UpdateImpactObjects()

    Dim Index As Number
    Dim Visual As Number
    Dim StepValue As Number
    Dim Age As Number
    Dim Target As Number
    Dim X As Number
    Dim Y As Number
    Dim Z As Number
    Dim BaseSize As Number
    Dim SphereSize As Number
    Dim RingSize As Number
    Dim Opacity As Number
    Dim RedValue As Number
    Dim GreenValue As Number
    Dim BlueValue As Number
    Dim Progress As Number
    Dim MouthX As Number
    Dim MouthY As Number
    Dim MouthZ As Number
    Dim BeamEndX As Number
    Dim BeamEndY As Number
    Dim BeamEndZ As Number
    Dim BeamRadius As Number
    Dim BeamPose As Articulation.SegmentPose3D
    Dim ArcOne As Articulation.SegmentPose3D
    Dim ArcTwo As Articulation.SegmentPose3D
    Dim ArcThree As Articulation.SegmentPose3D
    Dim ArcFour As Articulation.SegmentPose3D
    Dim ArcFive As Articulation.SegmentPose3D
    Dim OrbitAngle As Number
    Dim OrbitRadius As Number

    For Index = 0 To IMPACT_OBJECT_COUNT - 1
        Call Graphics3D.SetObjectVisible(ImpactObjects[Index], False)
    End For

    Visual = Battle.Visual()
    StepValue = Battle.VisualStep()
    Target = Battle.VisualTarget()

    If ((Visual = Battle.VISUAL_ITEM Or Visual = Battle.VISUAL_LYRA_MEND) And
        Target > 0 And
        StepValue >= 8 And
        StepValue <= 58) Then

        Call ParticipantAnchor(Target, X, Y, Z)

        Age = StepValue - 8
        RingSize = 64 + Age * 2
        Opacity = Max(0, 100 - Max(0, Age - 30) * 4)
        OrbitAngle = GlobalStep * 12
        OrbitRadius = 54 + Age / 2

        If StepValue = 24 Then
            OperationAccepted = BattleEffects.Spawn(State, Battle.EFFECT_HEAL, X, Y, Z, GlobalStep + Target * 1709)
        End If

        Call Graphics3D.SetObjectVisible(ImpactObjects[0], True)
        Call Graphics3D.SetObjectVisible(ImpactObjects[7], True)
        Call Graphics3D.SetObjectVisible(ImpactObjects[8], True)
        Call Graphics3D.SetObjectVisible(ImpactObjects[9], True)
        Call Graphics3D.SetObjectVisible(ImpactObjects[2], True)
        Call Graphics3D.SetObjectVisible(ImpactObjects[3], True)
        Call Graphics3D.SetObjectVisible(ImpactObjects[12], True)
        Call Graphics3D.SetObjectVisible(ImpactObjects[13], True)
        Call Graphics3D.SetObjectVisible(ImpactObjects[14], True)
        Call Graphics3D.SetObjectVisible(ImpactObjects[17], True)
        Call Graphics3D.SetObjectVisible(ImpactObjects[18], True)
        Call ApplyPart(ImpactObjects[0], X, Y + 18, Z, 42 + Age, 68 + Age, 42 + Age, 0, 0, 0)
        Call ApplyPart(ImpactObjects[2], X, Y - 55 + (Age Mod 24) * 8, Z, RingSize, RingSize, RingSize, 90, GlobalStep * 5, 0)
        Call ApplyPart(ImpactObjects[3], X, Y - 55 + ((Age + 12) Mod 24) * 8, Z, RingSize + 35, RingSize + 35, RingSize + 35, 90, 0 - GlobalStep * 4, 0)
        Call ApplyPart(ImpactObjects[12], X, Y - 46 + (Age Mod 18) * 8, Z, RingSize + 38, RingSize + 38, RingSize + 38, 90, GlobalStep * 8, 0)
        Call ApplyPart(ImpactObjects[13], X, Y + 58, Z, RingSize + 52, RingSize + 52, RingSize + 52, 0, GlobalStep * 6, 0)
        Call ApplyPart(ImpactObjects[14], X, Y + 42, Z, 28, 112, 28, 0, 0, 0)
        Call ApplyPart(ImpactObjects[7], X + Math3D.CosFixed(OrbitAngle) * OrbitRadius / Core.FIXED_ONE, Y + 20 + (Age Mod 16) * 7, Z + Math3D.SinFixed(OrbitAngle) * OrbitRadius / Core.FIXED_ONE, 17, 31, 17, 0, OrbitAngle, 0)
        Call ApplyPart(ImpactObjects[8], X + Math3D.CosFixed(OrbitAngle + 120) * OrbitRadius / Core.FIXED_ONE, Y + 45 + ((Age + 5) Mod 16) * 7, Z + Math3D.SinFixed(OrbitAngle + 120) * OrbitRadius / Core.FIXED_ONE, 15, 27, 15, 0, OrbitAngle + 120, 0)
        Call ApplyPart(ImpactObjects[9], X + Math3D.CosFixed(OrbitAngle + 240) * OrbitRadius / Core.FIXED_ONE, Y + 30 + ((Age + 10) Mod 16) * 7, Z + Math3D.SinFixed(OrbitAngle + 240) * OrbitRadius / Core.FIXED_ONE, 14, 25, 14, 0, OrbitAngle + 240, 0)
        Call ApplyPart(ImpactObjects[17], X + Math3D.CosFixed(0 - OrbitAngle) * (OrbitRadius + 22) / Core.FIXED_ONE, Y + 75, Z + Math3D.SinFixed(0 - OrbitAngle) * (OrbitRadius + 22) / Core.FIXED_ONE, 13, 23, 13, 0, 0 - OrbitAngle, 0)
        Call ApplyPart(ImpactObjects[18], X + Math3D.CosFixed(180 - OrbitAngle) * (OrbitRadius + 22) / Core.FIXED_ONE, Y + 105, Z + Math3D.SinFixed(180 - OrbitAngle) * (OrbitRadius + 22) / Core.FIXED_ONE, 12, 21, 12, 0, 180 - OrbitAngle, 0)

        For Index = 0 To IMPACT_OBJECT_COUNT - 1
            Call Graphics3D.SetObjectColor(ImpactObjects[Index], 95, 255, 178)
            Call Graphics3D.SetObjectOpacity(ImpactObjects[Index], Opacity)
        End For

        ''' Keep a brilliant core and readable orbiting motes, while the larger
        ''' aura volumes remain translucent enough to preserve actor silhouettes.

        Call Graphics3D.SetObjectOpacity(ImpactObjects[0], Opacity * 2 / 5)
        Call Graphics3D.SetObjectOpacity(ImpactObjects[2], Opacity * 3 / 5)
        Call Graphics3D.SetObjectOpacity(ImpactObjects[3], Opacity * 2 / 5)
        Call Graphics3D.SetObjectOpacity(ImpactObjects[12], Opacity / 2)
        Call Graphics3D.SetObjectOpacity(ImpactObjects[13], Opacity * 2 / 5)
        Call Graphics3D.SetObjectOpacity(ImpactObjects[14], Opacity / 2)

        Return

    End If

    If Not VisualHasImpact(Visual) Or Target <= 0 Then
        Return
    End If

    Call ParticipantAnchor(Target, X, Y, Z)

    If ((Visual = Battle.VISUAL_DRAGON_BREATH Or
        Visual = Battle.VISUAL_DRAGON_CATASTROPHE) And
        StepValue >= 8 And
        StepValue <= 64) Then

        X = PARTY_CENTER_X
        Y = 82
        Z = 30

        MouthX = LastDragonMouthX
        MouthY = LastDragonMouthY
        MouthZ = LastDragonMouthZ
        Progress = Min(100, (StepValue - 7) * 8)
        BeamEndX = MouthX + (X - MouthX) * Progress / 100
        BeamEndY = MouthY + (Y - MouthY) * Progress / 100
        BeamEndZ = MouthZ + (Z - MouthZ) * Progress / 100
        BeamRadius = 22 + Abs(Articulation.CycleAngle(GlobalStep, 12, 8, 0))

        If Visual = Battle.VISUAL_DRAGON_CATASTROPHE Then
            BeamRadius = BeamRadius + 34
        End If

        BeamPose = Articulation.SolveSegmentBetweenPoints(
            MouthX,
            MouthY,
            MouthZ,
            BeamEndX,
            BeamEndY,
            BeamEndZ
        )
        SphereSize = 72 + Abs(Articulation.CycleAngle(GlobalStep, 10, 24, 0))

        If StepValue >= 29 Then
            SphereSize = 145 + (StepValue - 29) * 9
        End If

        Call Graphics3D.SetObjectVisible(ImpactObjects[0], True)
        Call Graphics3D.SetObjectVisible(ImpactObjects[1], True)
        Call Graphics3D.SetObjectVisible(ImpactObjects[2], StepValue >= 24)
        Call Graphics3D.SetObjectVisible(ImpactObjects[3], StepValue >= 28)
        Call Graphics3D.SetObjectVisible(ImpactObjects[10], StepValue >= 29)
        Call Graphics3D.SetObjectVisible(ImpactObjects[11], StepValue >= 29)
        Call Graphics3D.SetObjectVisible(ImpactObjects[12], StepValue >= 22)
        Call Graphics3D.SetObjectVisible(ImpactObjects[13], StepValue >= 26)
        Call Graphics3D.SetObjectVisible(ImpactObjects[14], True)
        Call Graphics3D.SetObjectVisible(ImpactObjects[15], True)
        Call Graphics3D.SetObjectVisible(ImpactObjects[17], StepValue >= 27)
        Call Graphics3D.SetObjectVisible(ImpactObjects[18], StepValue >= 27)
        Call Graphics3D.SetObjectVisible(ImpactObjects[19], StepValue >= 29)
        Call Graphics3D.SetObjectPosition(ImpactObjects[0], BeamEndX, BeamEndY, BeamEndZ)
        Call Graphics3D.SetObjectScale(ImpactObjects[0], SphereSize, SphereSize, SphereSize)
        Call Graphics3D.SetObjectColor(ImpactObjects[0], 255, 92, 18)
        Call Graphics3D.SetObjectColor(ImpactObjects[1], 255, 178, 32)
        Call Graphics3D.SetObjectOpacity(ImpactObjects[0], 100)
        Call Graphics3D.SetObjectOpacity(ImpactObjects[1], 88)
        Call ApplySegment(ImpactObjects[1], BeamPose, BeamRadius)
        Call ApplySegment(ImpactObjects[15], BeamPose, Max(6, BeamRadius / 3))
        Call ApplyPart(ImpactObjects[2], X, -38, Z, SphereSize * 2, SphereSize * 2, SphereSize * 2, 90, GlobalStep * 9, 0)
        Call ApplyPart(ImpactObjects[3], X, -32, Z, SphereSize * 3, SphereSize * 3, SphereSize * 3, 90, 0 - GlobalStep * 7, 0)
        Call ApplyPart(ImpactObjects[10], X, Y + 55, Z, SphereSize, 390, SphereSize, 0, 0, 0)
        Call ApplyPart(ImpactObjects[11], X, Y, Z, SphereSize * 2, SphereSize * 2, SphereSize * 2, 0, 0, 0)
        Call ApplyPart(ImpactObjects[12], X, -34, Z, SphereSize * 4, SphereSize * 4, SphereSize * 4, 90, GlobalStep * 14, 0)
        Call ApplyPart(ImpactObjects[13], X, Y + 10, Z, SphereSize * 3, SphereSize * 3, SphereSize * 3, 0, 0 - GlobalStep * 11, 0)
        Call ApplyPart(ImpactObjects[14], BeamEndX, BeamEndY, BeamEndZ, SphereSize * 2, SphereSize * 2, SphereSize * 2, 0, 0, 0)
        Call ApplyPart(ImpactObjects[17], X - SphereSize, Y + 42, Z - SphereSize / 2, SphereSize / 2, SphereSize * 2, SphereSize / 2, 0, GlobalStep * 9, -18)
        Call ApplyPart(ImpactObjects[18], X + SphereSize, Y + 55, Z + SphereSize / 2, SphereSize / 2, SphereSize * 2, SphereSize / 2, 0, 0 - GlobalStep * 8, 16)
        Call ApplyPart(ImpactObjects[19], X, Y + 20, Z, SphereSize * 3, SphereSize * 2, SphereSize * 3, 0, 0, 0)
        Call Graphics3D.SetObjectColor(ImpactObjects[2], 255, 68, 8)
        Call Graphics3D.SetObjectColor(ImpactObjects[3], 255, 220, 70)
        Call Graphics3D.SetObjectColor(ImpactObjects[10], 255, 62, 10)
        Call Graphics3D.SetObjectColor(ImpactObjects[11], 255, 178, 42)
        Call Graphics3D.SetObjectColor(ImpactObjects[12], 255, 52, 6)
        Call Graphics3D.SetObjectColor(ImpactObjects[13], 255, 235, 110)
        Call Graphics3D.SetObjectColor(ImpactObjects[14], 255, 245, 175)
        Call Graphics3D.SetObjectColor(ImpactObjects[15], 255, 255, 225)
        Call Graphics3D.SetObjectColor(ImpactObjects[17], 255, 88, 8)
        Call Graphics3D.SetObjectColor(ImpactObjects[18], 255, 180, 24)
        Call Graphics3D.SetObjectColor(ImpactObjects[19], 255, 66, 8)
        Call Graphics3D.SetObjectOpacity(ImpactObjects[2], 86)
        Call Graphics3D.SetObjectOpacity(ImpactObjects[3], 72)
        Call Graphics3D.SetObjectOpacity(ImpactObjects[10], 68)
        Call Graphics3D.SetObjectOpacity(ImpactObjects[11], 70)
        Call Graphics3D.SetObjectOpacity(ImpactObjects[12], 78)
        Call Graphics3D.SetObjectOpacity(ImpactObjects[13], 74)
        Call Graphics3D.SetObjectOpacity(ImpactObjects[14], 76)
        Call Graphics3D.SetObjectOpacity(ImpactObjects[15], 100)
        Call Graphics3D.SetObjectOpacity(ImpactObjects[17], 82)
        Call Graphics3D.SetObjectOpacity(ImpactObjects[18], 82)
        Call Graphics3D.SetObjectOpacity(ImpactObjects[19], 55)

        Return

    End If

    If (Visual = Battle.VISUAL_MIRA_LIGHTNING And
        StepValue >= 18 And
        StepValue <= 46) Then

        ArcOne = Articulation.SolveSegmentBetweenPoints(X - 28, Y + 620, Z + 45, X + 55, Y + 390, Z - 50)
        ArcTwo = Articulation.SolveSegmentBetweenPoints(X + 55, Y + 390, Z - 50, X - 46, Y + 185, Z + 38)
        ArcThree = Articulation.SolveSegmentBetweenPoints(X - 46, Y + 185, Z + 38, X, Y, Z)
        ArcFour = Articulation.SolveSegmentBetweenPoints(X + 55, Y + 390, Z - 50, X + 225, Y + 255, Z + 150)
        ArcFive = Articulation.SolveSegmentBetweenPoints(X - 46, Y + 185, Z + 38, X - 195, Y + 95, Z - 135)

        Call Graphics3D.SetObjectVisible(ImpactObjects[0], True)
        Call Graphics3D.SetObjectVisible(ImpactObjects[2], True)
        Call Graphics3D.SetObjectVisible(ImpactObjects[3], True)
        Call Graphics3D.SetObjectVisible(ImpactObjects[4], True)
        Call Graphics3D.SetObjectVisible(ImpactObjects[5], True)
        Call Graphics3D.SetObjectVisible(ImpactObjects[6], True)
        Call Graphics3D.SetObjectVisible(ImpactObjects[12], True)
        Call Graphics3D.SetObjectVisible(ImpactObjects[13], True)
        Call Graphics3D.SetObjectVisible(ImpactObjects[14], True)
        Call Graphics3D.SetObjectVisible(ImpactObjects[15], True)
        Call Graphics3D.SetObjectVisible(ImpactObjects[16], True)
        Call Graphics3D.SetObjectVisible(ImpactObjects[17], True)
        Call Graphics3D.SetObjectVisible(ImpactObjects[18], True)
        Call Graphics3D.SetObjectVisible(ImpactObjects[19], True)
        Call ApplySegment(ImpactObjects[4], ArcOne, 9)
        Call ApplySegment(ImpactObjects[5], ArcTwo, 12)
        Call ApplySegment(ImpactObjects[6], ArcThree, 16)
        Call ApplySegment(ImpactObjects[15], ArcFour, 8)
        Call ApplySegment(ImpactObjects[16], ArcFive, 7)
        Call ApplyPart(ImpactObjects[0], X, Y, Z, 170, 170, 170, 0, 0, 0)
        Call ApplyPart(ImpactObjects[2], X, Y, Z, 210, 210, 210, 90, GlobalStep * 18, 0)
        Call ApplyPart(ImpactObjects[3], X, Y, Z, 320, 320, 320, 0, GlobalStep * 13, 0)
        Call ApplyPart(ImpactObjects[12], X, Y, Z, 430, 430, 430, 90, GlobalStep * 23, 0)
        Call ApplyPart(ImpactObjects[13], X, Y + 35, Z, 560, 560, 560, 0, 0 - GlobalStep * 19, 0)
        Call ApplyPart(ImpactObjects[14], X, Y, Z, 280, 280, 280, 0, 0, 0)
        Call ApplyPart(ImpactObjects[17], X - 155, Y + 75, Z - 75, 52, 235, 52, 0, GlobalStep * 15, -34)
        Call ApplyPart(ImpactObjects[18], X + 145, Y + 115, Z + 90, 46, 210, 46, 0, 0 - GlobalStep * 14, 31)
        Call ApplyPart(ImpactObjects[19], X, Y, Z, 420, 420, 420, 0, 0, 0)

        For Index = 0 To IMPACT_OBJECT_COUNT - 1
            Call Graphics3D.SetObjectColor(ImpactObjects[Index], 190, 225, 255)
            Call Graphics3D.SetObjectOpacity(ImpactObjects[Index], 92)
        End For

        Call Graphics3D.SetObjectColor(ImpactObjects[4], 255, 255, 255)
        Call Graphics3D.SetObjectColor(ImpactObjects[6], 80, 145, 255)
        Call Graphics3D.SetObjectColor(ImpactObjects[14], 255, 255, 255)
        Call Graphics3D.SetObjectColor(ImpactObjects[15], 105, 155, 255)
        Call Graphics3D.SetObjectColor(ImpactObjects[16], 225, 245, 255)
        Call Graphics3D.SetObjectColor(ImpactObjects[19], 95, 75, 255)
        Call Graphics3D.SetObjectOpacity(ImpactObjects[0], 62)
        Call Graphics3D.SetObjectOpacity(ImpactObjects[2], 58)
        Call Graphics3D.SetObjectOpacity(ImpactObjects[3], 42)
        Call Graphics3D.SetObjectOpacity(ImpactObjects[12], 55)
        Call Graphics3D.SetObjectOpacity(ImpactObjects[13], 38)
        Call Graphics3D.SetObjectOpacity(ImpactObjects[14], 88)
        Call Graphics3D.SetObjectOpacity(ImpactObjects[15], 74)
        Call Graphics3D.SetObjectOpacity(ImpactObjects[16], 68)
        Call Graphics3D.SetObjectOpacity(ImpactObjects[17], 62)
        Call Graphics3D.SetObjectOpacity(ImpactObjects[18], 62)
        Call Graphics3D.SetObjectOpacity(ImpactObjects[19], 24)

        Return

    End If

    If StepValue < 29 Or StepValue > 43 Then
        Return
    End If

    Age = StepValue - 29
    BaseSize = 84
    RedValue = 255
    GreenValue = 238
    BlueValue = 165

    If Target = Battle.PARTICIPANT_ASHWING Then

        BaseSize = 280

    Else If Visual = Battle.VISUAL_MIRA_FLAME Or Visual = Battle.VISUAL_DRAGON_BREATH Then

        RedValue = 255
        GreenValue = 82
        BlueValue = 18

    Else If Visual = Battle.VISUAL_MIRA_FROST Then

        RedValue = 80
        GreenValue = 225
        BlueValue = 255

    Else If Visual = Battle.VISUAL_LYRA_ATTACK Then

        RedValue = 115
        GreenValue = 255
        BlueValue = 215

    End If

    SphereSize = BaseSize + Age * 10
    RingSize = BaseSize + Age * 22
    Opacity = Max(0, 100 - Age * 7)

    Call Graphics3D.SetObjectVisible(ImpactObjects[0], True)
    Call Graphics3D.SetObjectVisible(ImpactObjects[1], True)
    Call Graphics3D.SetObjectVisible(ImpactObjects[2], True)
    Call Graphics3D.SetObjectVisible(ImpactObjects[3], True)
    Call Graphics3D.SetObjectVisible(ImpactObjects[12], True)
    Call Graphics3D.SetObjectVisible(ImpactObjects[13], True)
    Call Graphics3D.SetObjectVisible(ImpactObjects[14], True)
    Call Graphics3D.SetObjectVisible(ImpactObjects[19], True)
    Call Graphics3D.SetObjectPosition(ImpactObjects[0], X, Y, Z)
    Call Graphics3D.SetObjectPosition(ImpactObjects[1], X, Y, Z)
    Call Graphics3D.SetObjectScale(ImpactObjects[0], SphereSize, SphereSize, SphereSize)
    Call Graphics3D.SetObjectScale(ImpactObjects[1], 90, RingSize, 90)
    Call Graphics3D.SetObjectRotation(ImpactObjects[1], GlobalStep * 17, 0, 55 + Age * 11)
    Call Graphics3D.SetObjectColor(ImpactObjects[0], RedValue, GreenValue, BlueValue)
    Call Graphics3D.SetObjectColor(ImpactObjects[1], 255, 255, 255)
    Call Graphics3D.SetObjectOpacity(ImpactObjects[0], Opacity)
    Call Graphics3D.SetObjectOpacity(ImpactObjects[1], Opacity)
    Call ApplyPart(ImpactObjects[2], X, Y, Z, RingSize, RingSize, RingSize, 90, GlobalStep * 12, 0)
    Call ApplyPart(ImpactObjects[3], X, Y, Z, RingSize + 80, RingSize + 80, RingSize + 80, 0, GlobalStep * 9, 0)
    Call Graphics3D.SetObjectColor(ImpactObjects[2], RedValue, GreenValue, BlueValue)
    Call Graphics3D.SetObjectColor(ImpactObjects[3], 255, 255, 255)
    Call Graphics3D.SetObjectOpacity(ImpactObjects[2], Opacity)
    Call Graphics3D.SetObjectOpacity(ImpactObjects[3], Opacity * 3 / 4)
    Call ApplyPart(ImpactObjects[12], X, Y, Z, RingSize + 150, RingSize + 150, RingSize + 150, 90, 0 - GlobalStep * 19, 0)
    Call ApplyPart(ImpactObjects[13], X, Y + 15, Z, RingSize + 230, RingSize + 230, RingSize + 230, 0, GlobalStep * 15, 0)
    Call ApplyPart(ImpactObjects[14], X, Y, Z, SphereSize * 2, SphereSize * 2, SphereSize * 2, 0, 0, 0)
    Call ApplyPart(ImpactObjects[19], X, Y, Z, SphereSize * 3, SphereSize * 3, SphereSize * 3, 0, 0, 0)
    Call Graphics3D.SetObjectColor(ImpactObjects[12], RedValue, GreenValue, BlueValue)
    Call Graphics3D.SetObjectColor(ImpactObjects[13], 255, 255, 255)
    Call Graphics3D.SetObjectColor(ImpactObjects[14], 255, 255, 255)
    Call Graphics3D.SetObjectColor(ImpactObjects[19], RedValue, GreenValue, BlueValue)
    Call Graphics3D.SetObjectOpacity(ImpactObjects[12], Opacity * 4 / 5)
    Call Graphics3D.SetObjectOpacity(ImpactObjects[13], Opacity / 2)
    Call Graphics3D.SetObjectOpacity(ImpactObjects[14], Opacity * 2 / 3)
    Call Graphics3D.SetObjectOpacity(ImpactObjects[19], Opacity / 3)

    If Visual = Battle.VISUAL_MIRA_FLAME Then

        Call Graphics3D.SetObjectVisible(ImpactObjects[10], True)
        Call Graphics3D.SetObjectVisible(ImpactObjects[11], True)
        Call Graphics3D.SetObjectVisible(ImpactObjects[15], True)
        Call Graphics3D.SetObjectVisible(ImpactObjects[16], True)
        Call Graphics3D.SetObjectVisible(ImpactObjects[17], True)
        Call Graphics3D.SetObjectVisible(ImpactObjects[18], True)
        Call ApplyPart(ImpactObjects[10], X, Y + 75, Z, BaseSize, 360 + Age * 18, BaseSize, 0, 0, 0)
        Call ApplyPart(ImpactObjects[11], X, Y + 45, Z, SphereSize * 2, SphereSize * 2, SphereSize * 2, 0, 0, 0)
        Call Graphics3D.SetObjectColor(ImpactObjects[10], 255, 62, 8)
        Call Graphics3D.SetObjectColor(ImpactObjects[11], 255, 185, 32)
        Call Graphics3D.SetObjectOpacity(ImpactObjects[10], Opacity)
        Call Graphics3D.SetObjectOpacity(ImpactObjects[11], Opacity * 4 / 5)
        Call ApplyPart(ImpactObjects[15], X - 48, Y + 105, Z - 42, 28, 340 + Age * 14, 28, 0, GlobalStep * 12, -15)
        Call ApplyPart(ImpactObjects[16], X + 56, Y + 85, Z + 38, 24, 290 + Age * 12, 24, 0, 0 - GlobalStep * 10, 18)
        Call ApplyPart(ImpactObjects[17], X - 72, Y + 35, Z + 46, 48, 165, 48, 0, GlobalStep * 11, -22)
        Call ApplyPart(ImpactObjects[18], X + 80, Y + 60, Z - 35, 42, 145, 42, 0, 0 - GlobalStep * 9, 20)
        Call Graphics3D.SetObjectColor(ImpactObjects[15], 255, 238, 145)
        Call Graphics3D.SetObjectColor(ImpactObjects[16], 255, 105, 12)
        Call Graphics3D.SetObjectColor(ImpactObjects[17], 255, 186, 35)
        Call Graphics3D.SetObjectColor(ImpactObjects[18], 255, 72, 8)
        Call Graphics3D.SetObjectOpacity(ImpactObjects[15], Opacity)
        Call Graphics3D.SetObjectOpacity(ImpactObjects[16], Opacity)
        Call Graphics3D.SetObjectOpacity(ImpactObjects[17], Opacity * 4 / 5)
        Call Graphics3D.SetObjectOpacity(ImpactObjects[18], Opacity * 4 / 5)

    Else If Visual = Battle.VISUAL_MIRA_FROST Then

        For Index = 7 To 9
            Call Graphics3D.SetObjectVisible(ImpactObjects[Index], True)
            Call Graphics3D.SetObjectColor(ImpactObjects[Index], 125, 235, 255)
            Call Graphics3D.SetObjectOpacity(ImpactObjects[Index], Opacity)
        End For

        Call Graphics3D.SetObjectVisible(ImpactObjects[17], True)
        Call Graphics3D.SetObjectVisible(ImpactObjects[18], True)
        Call Graphics3D.SetObjectColor(ImpactObjects[17], 205, 250, 255)
        Call Graphics3D.SetObjectColor(ImpactObjects[18], 80, 175, 255)
        Call Graphics3D.SetObjectOpacity(ImpactObjects[17], Opacity)
        Call Graphics3D.SetObjectOpacity(ImpactObjects[18], Opacity)

        Call ApplyPart(ImpactObjects[7], X - 55, Y + 40, Z - 48, 105, 280, 105, 0, 0, -12)
        Call ApplyPart(ImpactObjects[8], X + 30, Y + 65, Z + 52, 125, 360, 125, 0, 0, 9)
        Call ApplyPart(ImpactObjects[9], X + 78, Y + 25, Z - 8, 88, 235, 88, 0, 0, 18)
        Call ApplyPart(ImpactObjects[17], X - 95, Y + 85, Z + 38, 74, 205, 74, 0, GlobalStep * 8, -28)
        Call ApplyPart(ImpactObjects[18], X + 105, Y + 105, Z - 55, 68, 190, 68, 0, 0 - GlobalStep * 7, 26)

    Else If (Visual = Battle.VISUAL_ARIN_ATTACK Or
        Visual = Battle.VISUAL_ARIN_EMBER Or
        Visual = Battle.VISUAL_LYRA_ATTACK) Then

        For Index = 4 To 6
            Call Graphics3D.SetObjectVisible(ImpactObjects[Index], True)
            Call Graphics3D.SetObjectColor(ImpactObjects[Index], 255, 248, 218)
            Call Graphics3D.SetObjectOpacity(ImpactObjects[Index], Opacity)
        End For

        Call Graphics3D.SetObjectVisible(ImpactObjects[15], True)
        Call Graphics3D.SetObjectVisible(ImpactObjects[16], True)
        Call Graphics3D.SetObjectColor(ImpactObjects[15], 255, 185, 55)
        Call Graphics3D.SetObjectColor(ImpactObjects[16], 255, 255, 255)
        Call Graphics3D.SetObjectOpacity(ImpactObjects[15], Opacity * 4 / 5)
        Call Graphics3D.SetObjectOpacity(ImpactObjects[16], Opacity * 3 / 5)

        ''' Three luminous contact marks make a confirmed sword/staff strike
        ''' unmistakable. The entire branch is skipped for a mechanics miss.

        Call ApplyPart(ImpactObjects[4], X, Y + 8, Z, 14, BaseSize + 140, 14, 0, 0, 52)
        Call ApplyPart(ImpactObjects[5], X, Y + 8, Z, 11, BaseSize + 105, 11, 0, 0, -48)
        Call ApplyPart(ImpactObjects[6], X, Y + 8, Z, 9, BaseSize + 75, 9, 72, 0, 12)
        Call ApplyPart(ImpactObjects[15], X - 32, Y + 8, Z, 8, BaseSize + 210, 8, 0, 0, 67)
        Call ApplyPart(ImpactObjects[16], X + 30, Y + 8, Z, 7, BaseSize + 185, 7, 0, 0, -66)

    End If

End Sub

Private Sub TriggerVisual(Visual As Number, StepValue As Number)

    Dim X As Number
    Dim Y As Number
    Dim Z As Number
    Dim EffectId As Number
    Dim Shot As Number
    Dim Shake As Number

    X = 95
    Y = 120
    Z = 30
    Shot = SHOT_IMPACT
    Shake = 12
    CurrentActionShot = 0

    Call ParticipantAnchor(Battle.VisualTarget(), X, Y, Z)

    If Visual = Battle.VISUAL_BOSS_ENTRANCE Then

        Call DefineActiveCameraShots()
        Call PlayVariedShot(SHOT_BOSS_ENTRANCE)

        Return

    End If

    If Visual = Battle.VISUAL_ARIN_ATTACK Or Visual = Battle.VISUAL_ARIN_EMBER Then

        EffectId = Battle.EFFECT_SLASH
        Shot = SHOT_ATTACK

    Else If Visual = Battle.VISUAL_MIRA_FLAME Then

        EffectId = Battle.EFFECT_FIRE
        Shot = SHOT_MAGIC

    Else If Visual = Battle.VISUAL_MIRA_FROST Then

        EffectId = Battle.EFFECT_FROST
        Shot = SHOT_MAGIC

    Else If Visual = Battle.VISUAL_MIRA_LIGHTNING Then

        EffectId = Battle.EFFECT_LIGHTNING
        Shot = SHOT_MAGIC
        Shake = 22

    Else If Visual = Battle.VISUAL_ITEM Or Visual = Battle.VISUAL_LYRA_MEND Then

        EffectId = Battle.EFFECT_HEAL
        Shot = SHOT_PARTY
        Shake = 3

    Else If Visual = Battle.VISUAL_TOR_ATTACK Or Visual = Battle.VISUAL_TOR_BASH Then

        EffectId = Battle.EFFECT_BASH
        Shot = SHOT_ATTACK

    Else If Visual = Battle.VISUAL_LYRA_ATTACK Then

        EffectId = Battle.EFFECT_AURORA
        Shot = SHOT_ATTACK
        X = 85
        Y = 110
        Z = 80
        Shake = 16

    Else If Visual = Battle.VISUAL_CINDERLING_ATTACK Then

        EffectId = Battle.EFFECT_SLASH
        Shot = SHOT_DRAGON
        Shake = 8

    Else If Visual = Battle.VISUAL_DRAGON_BREATH Then

        EffectId = Battle.EFFECT_BREATH
        Shot = SHOT_BREATH
        X = PARTY_CENTER_X
        Y = 105
        Z = 25
        Shake = 24

    Else If Visual = Battle.VISUAL_DRAGON_CATASTROPHE Then

        EffectId = Battle.EFFECT_CATASTROPHE
        Shot = SHOT_BREATH
        X = PARTY_CENTER_X
        Y = 82
        Z = 30
        Shake = 38

    Else If Visual = Battle.VISUAL_DRAGON_CLAW Or Visual = Battle.VISUAL_DRAGON_TAIL Then

        EffectId = Battle.EFFECT_SLASH
        Shot = SHOT_DRAGON
        X = PARTY_CENTER_X
        Y = 65
        Z = 65
        Shake = 18

    Else If Visual = Battle.VISUAL_ENRAGE Then

        EffectId = Battle.EFFECT_ENRAGE
        Shot = SHOT_ENRAGE
        X = 145
        Y = 130
        Z = 40
        Shake = 28

        Call ParticipantAnchor(Battle.PARTICIPANT_ASHWING, X, Y, Z)

    Else If Visual = Battle.VISUAL_VICTORY Then

        EffectId = Battle.EFFECT_DEATH
        Shot = SHOT_DEATH
        X = 160
        Y = 125
        Z = 45
        Shake = 35

    Else If Visual = Battle.VISUAL_DEFEAT Then

        EffectId = Battle.EFFECT_BREATH
        Shot = SHOT_DRAGON
        X = -200
        Y = 75
        Z = 60
        Shake = 30

    End If

    If EffectId > 0 Then

        If Battle.VisualImpactLanded() Then
            OperationAccepted = BattleEffects.Spawn(State, EffectId, X, Y, Z, GlobalStep + Visual * 997 + StepValue)
        End If

        If (Battle.VisualActor() >= Battle.PARTICIPANT_ARIN And
            Battle.VisualActor() <= Battle.PARTICIPANT_MIRA) Then
            Call DefineActorAnticipationShot(Shot, Battle.VisualActor())
        Else If Battle.VisualActor() >= Battle.PARTICIPANT_CINDERLING_ONE Then
            Call DefineActionFocusShot(Shot, Battle.VisualActor(), Battle.VisualTarget())
        End If

        If Battle.VisualActor() > 0 And Battle.VisualTarget() > 0 Then
            CurrentActionShot = Shot
        End If

        If (Battle.VisualActor() >= Battle.PARTICIPANT_ARIN And
            Battle.VisualActor() <= Battle.PARTICIPANT_MIRA) Then
            OperationAccepted = BattleCamera.PlayShot(State, Shot, 0)
        Else

            Call PlayVariedShot(Shot)
        End If

        If Battle.VisualImpactLanded() Then
            OperationAccepted = BattleCamera.StartShake(State, Shake, 30, GlobalStep + 177)
        End If

    End If

End Sub

Private Sub ApplyCameraView()

    Camera.Position.X = BattleCamera.PositionX(State)
    Camera.Position.Y = BattleCamera.PositionY(State)
    Camera.Position.Z = BattleCamera.PositionZ(State)
    Camera.Target.X = BattleCamera.TargetX(State)
    Camera.Target.Y = BattleCamera.TargetY(State)
    Camera.Target.Z = BattleCamera.TargetZ(State)
    Camera.FovDegrees = BattleCamera.FovDegrees(State)
    Camera.NearPlane = 1
    Camera.FarPlane = 10000

End Sub

Private Sub UpdateCamera()

    OperationAccepted = BattleCamera.Update(State, 1)

    Call ApplyCameraView()

End Sub

Private Function PointerHitsSphere(
    PointerX As Number,
    PointerY As Number,
    WorldX As Number,
    WorldY As Number,
    WorldZ As Number,
    Radius As Number
) As Boolean

    Dim ReturnValue As Boolean

    Dim Center As BattleCamera.ProjectedPoint3D
    Dim HorizontalEdge As BattleCamera.ProjectedPoint3D
    Dim VerticalEdge As BattleCamera.ProjectedPoint3D
    Dim PixelRadius As Number
    Dim DeltaX As Number
    Dim DeltaY As Number

    Center = BattleCamera.ProjectWorldPoint(State, WorldX, WorldY, WorldZ, 960, 540)

    If Not Center.Visible Then
        Return False
    End If

    HorizontalEdge = BattleCamera.ProjectWorldPoint(State, WorldX + Radius, WorldY, WorldZ, 960, 540)
    VerticalEdge = BattleCamera.ProjectWorldPoint(State, WorldX, WorldY + Radius, WorldZ, 960, 540)
    PixelRadius = 12

    If HorizontalEdge.Visible Then
        PixelRadius = Max(PixelRadius, Abs(HorizontalEdge.X - Center.X))
    End If

    If VerticalEdge.Visible Then
        PixelRadius = Max(PixelRadius, Abs(VerticalEdge.Y - Center.Y))
    End If

    DeltaX = PointerX - Center.X
    DeltaY = PointerY - Center.Y

    ReturnValue = DeltaX * DeltaX + DeltaY * DeltaY <= PixelRadius * PixelRadius

    Return ReturnValue

End Function

Private Function PointerHitsActor(PointerX As Number, PointerY As Number) As Boolean

    If (PointerHitsSphere(PointerX, PointerY, ARIN_FORMATION_X + LastArinOffset, 72, ARIN_FORMATION_Z + LastArinOffsetZ, 65) Or
        PointerHitsSphere(PointerX, PointerY, TOR_FORMATION_X + LastTorOffset, 76, TOR_FORMATION_Z + LastTorOffsetZ, 75) Or
        PointerHitsSphere(PointerX, PointerY, LYRA_FORMATION_X + LastLyraOffset, 78, LYRA_FORMATION_Z + LastLyraOffsetZ, 65) Or
        PointerHitsSphere(PointerX, PointerY, MIRA_FORMATION_X + LastMiraOffset, 86, MIRA_FORMATION_Z + LastMiraOffsetZ, 68)) Then
        Return True
    End If

    If (Battle.EnemyIsActive(Battle.PARTICIPANT_CINDERLING_ONE) And
        PointerHitsSphere(PointerX, PointerY, 250 + LastCinderlingOffset[0], 105, -280, 118)) Then
        Return True
    End If

    If (Battle.EnemyIsActive(Battle.PARTICIPANT_CINDERLING_TWO) And
        PointerHitsSphere(PointerX, PointerY, 390 + LastCinderlingOffset[1], 185, 40, 205)) Then
        Return True
    End If

    If (Battle.EnemyIsActive(Battle.PARTICIPANT_CINDERLING_THREE) And
        PointerHitsSphere(PointerX, PointerY, 270 + LastCinderlingOffset[2], 105, 380, 118)) Then
        Return True
    End If

    If (Battle.BossIsIntroduced() And
        (PointerHitsSphere(PointerX, PointerY, 360 + LastDragonOffsetX, 148 + LastDragonOffsetY, 45 + LastDragonOffsetZ, 210) Or
        PointerHitsSphere(PointerX, PointerY, 114 + LastDragonOffsetX, 322 + LastDragonOffsetY, -40 + LastDragonOffsetZ, 115) Or
        PointerHitsSphere(PointerX, PointerY, 333 + LastDragonOffsetX, 243 + LastDragonOffsetY, -180 + LastDragonOffsetZ, 180) Or
        PointerHitsSphere(PointerX, PointerY, 333 + LastDragonOffsetX, 243 + LastDragonOffsetY, 270 + LastDragonOffsetZ, 180))) Then
        Return True
    End If

    Return False

End Function

''' Returns true only for visible arena pixels that are not occupied by a combatant.
Public Function ArenaPointerAvailable(PointerX As Number, PointerY As Number) As Boolean

    Dim ReturnValue As Boolean

    If (Not Ready Or
        PointerX < 0 Or
        PointerX >= 960 Or
        PointerY < 116 Or
        PointerY >= 420) Then
        Return False
    End If

    ReturnValue = Not PointerHitsActor(PointerX, PointerY)

    Return ReturnValue

End Function

''' Routes cross-target pointer input to the reusable camera override.
Public Sub HandleCameraPointer(BlockedByInterface As Boolean, AdvancePausedReturn As Boolean)

    Dim StartDrag As Boolean
    Dim StartOrbit As Boolean
    Dim WheelDelta As Number

    If Not Ready Then
        Return
    End If

    StartDrag = (Pointer_Pressed(POINTER_PRIMARY) And
        Not BlockedByInterface And
        ArenaPointerAvailable(Pointer_X(), Pointer_Y()))
    StartOrbit = (Pointer_Pressed(POINTER_MIDDLE) And
        Not BlockedByInterface And
        ArenaPointerAvailable(Pointer_X(), Pointer_Y()))
    WheelDelta = 0

    If (Not BlockedByInterface And
        Pointer_Inside() And
        Pointer_Y() >= 116 And
        Pointer_Y() < 420) Then
        WheelDelta = Pointer_Wheel_Delta()
    End If

    CameraInputAccepted = BattleCamera.UpdateManualInput(State,
        StartDrag,
        Pointer_Held(POINTER_PRIMARY),
        Pointer_Released(POINTER_PRIMARY),
        Pointer_Delta_X(),
        Pointer_Delta_Y(),
        WheelDelta)
    CameraInputAccepted = BattleCamera.UpdateManualOrbitInput(State,
        StartOrbit,
        Pointer_Held(POINTER_MIDDLE),
        Pointer_Released(POINTER_MIDDLE),
        Pointer_Delta_X(),
        Pointer_Delta_Y())

    If AdvancePausedReturn Then
        CameraInputAccepted = BattleCamera.UpdateManualReturnOnly(State, 1)
    End If

    Call ApplyCameraView()

End Sub

Public Function CameraOverrideActive() As Boolean

    Dim ReturnValue As Boolean

    ReturnValue = Ready And BattleCamera.IsManualActive(State)

    Return ReturnValue

End Function

Public Function CameraDragging() As Boolean

    Dim ReturnValue As Boolean

    ReturnValue = Ready And BattleCamera.IsManualDragging(State)

    Return ReturnValue

End Function

Private Sub SetCinderlingVisible(EnemyIndex As Number, Visible As Boolean)

    Dim Index As Number
    Dim BaseIndex As Number

    BaseIndex = EnemyIndex * CINDERLING_PARTS_PER_ENEMY

    For Index = BaseIndex To BaseIndex + CINDERLING_PARTS_PER_ENEMY - 1
        Call Graphics3D.SetObjectVisible(CinderlingParts[Index], Visible)
    End For

End Sub

Private Sub UpdateEnemyVisibility()

    Dim Index As Number
    Dim DragonVisible As Boolean
    Dim WaveOneVisible As Boolean

    WaveOneVisible = Not Battle.BossIsIntroduced()

    Call SetCinderlingVisible(0, WaveOneVisible)
    Call SetCinderlingVisible(1, WaveOneVisible)
    Call SetCinderlingVisible(2, WaveOneVisible)

    DragonVisible = Battle.BossIsIntroduced()

    For Index = 0 To DRAGON_OBJECT_COUNT - 1
        Call Graphics3D.SetObjectVisible(DragonParts[Index], DragonVisible)
    End For

End Sub

Private Sub ApplyResultOrbit(StepValue As Number)

    Dim Angle As Number
    Dim Radius As Number
    Dim OffsetX As Number
    Dim OffsetY As Number
    Dim OffsetZ As Number

    If BattleCamera.IsManualActive(State) Then
        Return
    End If

    ''' One degree per simulation step completes exactly one revolution in the
    ''' 360-step result sequence, with a small vertical breathing arc.

    Angle = 180 + StepValue - 1
    Radius = 1850
    OffsetX = Math3D.CosFixed(Angle) * Radius / Core.FIXED_ONE
    OffsetY = 520 + Math3D.SinFixed(Angle * 2) * 55 / Core.FIXED_ONE
    OffsetZ = Math3D.SinFixed(Angle) * Radius / Core.FIXED_ONE
    OperationAccepted = BattleCamera.FollowPoint(State, 30, 105, 120, OffsetX, OffsetY, OffsetZ, 56)

    Call ApplyCameraView()

End Sub

Private Function IsPartyOffensiveVisual(Visual As Number) As Boolean

    Dim ReturnValue As Boolean

    ReturnValue = (Visual = Battle.VISUAL_ARIN_ATTACK Or
        Visual = Battle.VISUAL_ARIN_EMBER Or
        Visual = Battle.VISUAL_TOR_ATTACK Or
        Visual = Battle.VISUAL_TOR_BASH Or
        Visual = Battle.VISUAL_LYRA_ATTACK Or
        Visual = Battle.VISUAL_MIRA_FLAME Or
        Visual = Battle.VISUAL_MIRA_FROST Or
        Visual = Battle.VISUAL_MIRA_LIGHTNING)

    Return ReturnValue

End Function

Private Sub ActionStagePosition(
    Actor As Number,
    Target As Number,
    ByRef X As Number,
    ByRef Z As Number
)

    Dim TargetX As Number
    Dim TargetY As Number
    Dim TargetZ As Number
    Dim StandOff As Number

    If Target <= 0 Then
        Return
    End If

    Call ParticipantAnchor(Target, TargetX, TargetY, TargetZ)

    ''' An instantaneous, target-relative staging point keeps this reusable for
    ''' small enemies, large bosses, and future formations without interpolating
    ''' through the arena. The slight lane offset preserves both silhouettes.

    StandOff = Max(170, ParticipantFramingRadius(Target) + 40)
    X = TargetX - StandOff
    Z = TargetZ - 34

    If Actor = Battle.PARTICIPANT_TOR Or Actor = Battle.PARTICIPANT_MIRA Then
        Z = TargetZ + 34
    End If

End Sub

Private Sub StartPartyBurning()

    Dim Index As Number

    For Index = 0 To 3
        BurningSteps[Index] = 180
    End For

End Sub

Private Sub UpdateBurningEffects()

    Dim Index As Number
    Dim Participant As Number
    Dim X As Number
    Dim Y As Number
    Dim Z As Number

    For Index = 0 To 3

        If BurningSteps[Index] > 0 Then

            Participant = Battle.PARTICIPANT_ARIN + Index

            If BurningSteps[Index] Mod 15 = 0 Then
                Call ParticipantAnchor(Participant, X, Y, Z)

                OperationAccepted = BattleEffects.Spawn(
                    State,
                    Battle.EFFECT_BURNING,
                    X,
                    Y - 22,
                    Z,
                    GlobalStep + Participant * 1709
                )
            End If

            BurningSteps[Index] = BurningSteps[Index] - 1

        End If

    End For

End Sub

Private Sub UpdateActors()

    Dim Visual As Number
    Dim StepValue As Number
    Dim Wing As Number
    Dim Lunge As Number
    Dim Rise As Number
    Dim ArinX As Number
    Dim ArinZ As Number
    Dim TorX As Number
    Dim TorZ As Number
    Dim LyraX As Number
    Dim LyraZ As Number
    Dim MiraX As Number
    Dim MiraZ As Number
    Dim DragonOffsetX As Number
    Dim DragonOffsetY As Number
    Dim DragonOffsetZ As Number
    Dim CinderlingOffsetOne As Number
    Dim CinderlingOffsetTwo As Number
    Dim CinderlingOffsetThree As Number
    Dim Approach As Number
    Dim ImpactRecoil As Number
    Dim CinderlingOneDefeated As Boolean
    Dim CinderlingTwoDefeated As Boolean
    Dim CinderlingThreeDefeated As Boolean

    Visual = Battle.Visual()
    StepValue = Battle.VisualStep()
    Wing = (GlobalStep Mod 48) - 24
    ArinX = ARIN_FORMATION_X
    ArinZ = ARIN_FORMATION_Z
    TorX = TOR_FORMATION_X
    TorZ = TOR_FORMATION_Z
    LyraX = LYRA_FORMATION_X
    LyraZ = LYRA_FORMATION_Z
    MiraX = MIRA_FORMATION_X
    MiraZ = MIRA_FORMATION_Z
    DragonOffsetX = 0
    DragonOffsetY = 0
    DragonOffsetZ = 0
    CinderlingOffsetOne = 0
    CinderlingOffsetTwo = 0
    CinderlingOffsetThree = 0

    If StepValue = 30 And VisualHasImpact(Visual) Then

        Call TriggerImpactCue(Visual)

        If (Visual = Battle.VISUAL_DRAGON_BREATH Or
            Visual = Battle.VISUAL_DRAGON_CATASTROPHE) Then
            Call StartPartyBurning()
        End If

    End If

    If StepValue < 36 Then
        Lunge = StepValue * 6
    Else
        Lunge = (72 - StepValue) * 6
    End If

    Lunge = Max(0, Lunge)

    If (IsPartyOffensiveVisual(Visual) And
        StepValue >= 20 And
        StepValue <= 54) Then

        If Battle.VisualActor() = Battle.PARTICIPANT_ARIN Then
            Call ActionStagePosition(Battle.PARTICIPANT_ARIN, Battle.VisualTarget(), ArinX, ArinZ)
        Else If Battle.VisualActor() = Battle.PARTICIPANT_TOR Then
            Call ActionStagePosition(Battle.PARTICIPANT_TOR, Battle.VisualTarget(), TorX, TorZ)
        Else If Battle.VisualActor() = Battle.PARTICIPANT_LYRA Then
            Call ActionStagePosition(Battle.PARTICIPANT_LYRA, Battle.VisualTarget(), LyraX, LyraZ)
        Else If Battle.VisualActor() = Battle.PARTICIPANT_MIRA Then
            Call ActionStagePosition(Battle.PARTICIPANT_MIRA, Battle.VisualTarget(), MiraX, MiraZ)
        End If

    Else If Visual = Battle.VISUAL_CINDERLING_ATTACK Then

        If Battle.VisualActor() = Battle.PARTICIPANT_CINDERLING_ONE Then
            CinderlingOffsetOne = 0 - Lunge / 2
        Else If Battle.VisualActor() = Battle.PARTICIPANT_CINDERLING_TWO Then
            CinderlingOffsetTwo = 0 - Lunge / 2
        Else If Battle.VisualActor() = Battle.PARTICIPANT_CINDERLING_THREE Then
            CinderlingOffsetThree = 0 - Lunge / 2
        End If

    Else If Visual = Battle.VISUAL_BOSS_ENTRANCE Then

        Approach = Max(0, 190 - StepValue)
        DragonOffsetX = Approach * 720 / 190
        DragonOffsetY = Approach * 760 / 190 + Abs(Wing) * Approach / 190
        DragonOffsetZ = 0 - Approach * 920 / 190

        If Not BattleCamera.IsManualActive(State) Then
            OperationAccepted = BattleCamera.FollowPoint(
                State,
                DRAGON_ROOT_X - 120 + DragonOffsetX,
                DRAGON_ROOT_Y + 240 + DragonOffsetY,
                DRAGON_ROOT_Z + DragonOffsetZ,
                -1750,
                650,
                -2400,
                62
            )

            Call ApplyCameraView()
        End If

        If StepValue = 190 Then

            Call DefineActiveCameraShots()
            Call PlayVariedShot(SHOT_WIDE)

            OperationAccepted = BattleCamera.StartShake(State, 34, 42, GlobalStep + 991)

        End If

    Else If Visual = Battle.VISUAL_VICTORY Then

        Rise = Min(165, StepValue * 2)

        DragonOffsetY = 0 - Rise

        If StepValue = 145 Then
            OperationAccepted = BattleCamera.PlayShot(State, SHOT_VICTORY, 0)
        End If

        Call ApplyResultOrbit(StepValue)

    Else If Visual = Battle.VISUAL_DEFEAT Then

        Call ApplyResultOrbit(StepValue)

    End If

    ImpactRecoil = Articulation.ActionEnvelope(StepValue, 28, 33, 45, 34)

    If VisualHasImpact(Visual) Then

        If Battle.VisualTarget() = Battle.PARTICIPANT_CINDERLING_ONE Then
            CinderlingOffsetOne = CinderlingOffsetOne + ImpactRecoil
        Else If Battle.VisualTarget() = Battle.PARTICIPANT_CINDERLING_TWO Then
            CinderlingOffsetTwo = CinderlingOffsetTwo + ImpactRecoil
        Else If Battle.VisualTarget() = Battle.PARTICIPANT_CINDERLING_THREE Then
            CinderlingOffsetThree = CinderlingOffsetThree + ImpactRecoil
        End If

    End If

    CinderlingOneDefeated = Not Battle.EnemyIsActive(Battle.PARTICIPANT_CINDERLING_ONE)
    CinderlingTwoDefeated = Not Battle.EnemyIsActive(Battle.PARTICIPANT_CINDERLING_TWO)
    CinderlingThreeDefeated = Not Battle.EnemyIsActive(Battle.PARTICIPANT_CINDERLING_THREE)

    If VisualHasImpact(Visual) And StepValue < 33 Then

        If Battle.VisualTarget() = Battle.PARTICIPANT_CINDERLING_ONE Then
            CinderlingOneDefeated = False
        Else If Battle.VisualTarget() = Battle.PARTICIPANT_CINDERLING_TWO Then
            CinderlingTwoDefeated = False
        Else If Battle.VisualTarget() = Battle.PARTICIPANT_CINDERLING_THREE Then
            CinderlingThreeDefeated = False
        End If

    End If

    Call PoseCinderling(0, 250 + CinderlingOffsetOne, -280, CinderlingOneDefeated, GlobalStep)
    Call PoseCinderling(1, 390 + CinderlingOffsetTwo, 40, CinderlingTwoDefeated, GlobalStep)
    Call PoseCinderling(2, 270 + CinderlingOffsetThree, 380, CinderlingThreeDefeated, GlobalStep)
    Call PoseHero(0, Battle.PARTICIPANT_ARIN, ArinX, ArinZ, ROLE_DEFENDER, Visual, StepValue, GlobalStep)
    Call PoseHero(40, Battle.PARTICIPANT_TOR, TorX, TorZ, ROLE_ATTACKER, Visual, StepValue, GlobalStep)
    Call PoseHero(80, Battle.PARTICIPANT_LYRA, LyraX, LyraZ, ROLE_HEALER, Visual, StepValue, GlobalStep)
    Call PoseHero(120, Battle.PARTICIPANT_MIRA, MiraX, MiraZ, ROLE_WIZARD, Visual, StepValue, GlobalStep)
    Call PoseDragon(
        DRAGON_ROOT_X + DragonOffsetX,
        DRAGON_ROOT_Y + DragonOffsetY,
        DRAGON_ROOT_Z + DragonOffsetZ,
        Visual,
        StepValue,
        GlobalStep
    )

    ''' Posing enables every component while assembling the current frame.
    ''' Apply wave ownership afterwards so old-wave corpses disappear exactly
    ''' when the next encounter arrives and cannot be re-enabled by a pose.

    Call UpdateEnemyVisibility()

    LastArinOffset = ArinX - ARIN_FORMATION_X
    LastTorOffset = TorX - TOR_FORMATION_X
    LastLyraOffset = LyraX - LYRA_FORMATION_X
    LastMiraOffset = MiraX - MIRA_FORMATION_X
    LastArinOffsetZ = ArinZ - ARIN_FORMATION_Z
    LastTorOffsetZ = TorZ - TOR_FORMATION_Z
    LastLyraOffsetZ = LyraZ - LYRA_FORMATION_Z
    LastMiraOffsetZ = MiraZ - MIRA_FORMATION_Z
    LastCinderlingOffset[0] = CinderlingOffsetOne
    LastCinderlingOffset[1] = CinderlingOffsetTwo
    LastCinderlingOffset[2] = CinderlingOffsetThree
    LastDragonOffsetX = DragonOffsetX
    LastDragonOffsetY = DragonOffsetY
    LastDragonOffsetZ = DragonOffsetZ

End Sub

Private Sub UpdateParticles()

    Dim Index As Number
    Dim SizeValue As Number
    Dim LifetimeValue As Number

    OperationAccepted = BattleEffects.Update(State, 1)

    For Index = 0 To PARTICLE_OBJECT_COUNT - 1

        If BattleEffects.IsActive(State, Index) Then

            LifetimeValue = Max(1, BattleEffects.Lifetime(State, Index))
            SizeValue = BattleEffects.Size(State, Index)

            Call Graphics3D.SetObjectVisible(ParticleObjects[Index], True)
            Call Graphics3D.SetObjectPosition(
                ParticleObjects[Index],
                BattleEffects.X(State, Index),
                BattleEffects.Y(State, Index),
                BattleEffects.Z(State, Index)
            )
            Call Graphics3D.SetObjectScale(ParticleObjects[Index], SizeValue, SizeValue, SizeValue)
            Call Graphics3D.SetObjectColor(
                ParticleObjects[Index],
                BattleEffects.ParticleRedValue(State, Index),
                BattleEffects.ParticleGreenValue(State, Index),
                BattleEffects.ParticleBlueValue(State, Index)
            )
            Call Graphics3D.SetObjectOpacity(
                ParticleObjects[Index],
                100 - BattleEffects.Age(State, Index) * 100 / LifetimeValue
            )

        Else

            Call Graphics3D.SetObjectVisible(ParticleObjects[Index], False)

        End If

    End For

End Sub

Public Sub Update(StateHandle As Number, StepValue As Number)

    Dim VisualValue As Number
    Dim VisualStepValue As Number

    If Not Ready Or StateHandle <> State Then
        Return
    End If

    GlobalStep = StepValue
    VisualValue = Battle.Visual()
    VisualStepValue = Battle.VisualStep()

    If (Battle.ActiveEnemyCount() <> LastFramedEnemyCount Or
        Battle.BossIsIntroduced() <> LastBossFramed) Then
        Call DefineActiveCameraShots()
    End If

    If VisualStepValue = 1 And (VisualValue <> LastVisual Or LastVisualStep <> VisualStepValue) Then
        Call TriggerVisual(VisualValue, VisualStepValue)
    Else If VisualValue = Battle.VISUAL_IDLE And LastVisual > Battle.VISUAL_IDLE Then
        Call PlayVariedShot(SHOT_IDLE_PARTY_BACK)
    End If

    ''' Party actions cut and teleport on the same simulation step. After the
    ''' impact/recovery beat, the actor snaps home while the camera eases back to
    ''' the party-versus-enemy composition. No interpolated actor travel occurs.

    If (VisualStepValue = 20 And
        CurrentActionShot > 0 And
        Battle.VisualActor() >= Battle.PARTICIPANT_ARIN And
        Battle.VisualActor() <= Battle.PARTICIPANT_MIRA) Then
        Call DefineActionFocusShot(CurrentActionShot, Battle.VisualActor(), Battle.VisualTarget())

        OperationAccepted = BattleCamera.PlayShot(State, CurrentActionShot, 0)
    Else If (VisualStepValue = 55 And
        CurrentActionShot > 0 And
        Battle.VisualActor() >= Battle.PARTICIPANT_ARIN And
        Battle.VisualActor() <= Battle.PARTICIPANT_MIRA) Then
        ''' Cut directly to the party-back composition. Interpolating between
        ''' opposing hemispheres can travel through the dragon's back and briefly
        ''' fill the screen with its body, obscuring the battlefield.
        OperationAccepted = BattleCamera.PlayShot(State, SHOT_IDLE_PARTY_BACK, 0)
    End If

    LastVisual = VisualValue
    LastVisualStep = VisualStepValue

    Call UpdateCamera()
    Call UpdateActors()
    Call UpdateImpactObjects()
    Call UpdateBurningEffects()
    Call UpdateParticles()

End Sub

Public Sub Draw()

    Dim Index As Number
    Dim FrameReady As Boolean

    If Not Ready Then
        Return
    End If

    FrameReady = Graphics3D.Begin3D(Camera, 3, 2, 10)

    If Not FrameReady Then
        Return
    End If

    For Index = 0 To ARENA_OBJECT_COUNT - 1
        FrameReady = Graphics3D.DrawObject3D(Arena[Index])
    End For

    For Index = 0 To PARTY_OBJECT_COUNT - 1
        FrameReady = Graphics3D.DrawObject3D(PartyParts[Index])
    End For

    For Index = 0 To CINDERLING_OBJECT_COUNT - 1
        FrameReady = Graphics3D.DrawObject3D(CinderlingParts[Index])
    End For

    For Index = 0 To DRAGON_OBJECT_COUNT - 1
        FrameReady = Graphics3D.DrawObject3D(DragonParts[Index])
    End For

    ''' Additive particles deliberately render last.

    For Index = 0 To PARTICLE_OBJECT_COUNT - 1

        If BattleEffects.IsActive(State, Index) Then
            FrameReady = Graphics3D.DrawObject3D(ParticleObjects[Index])
        End If

    End For

    For Index = 0 To IMPACT_OBJECT_COUNT - 1
        FrameReady = Graphics3D.DrawObject3D(ImpactObjects[Index])
    End For

    Call Graphics3D.End3D()

End Sub

Public Function IsReady() As Boolean

    Dim ReturnValue As Boolean

    ReturnValue = Ready

    Return ReturnValue

End Function

Public Function FlashOpacity() As Number

    Dim ReturnValue As Number

    If Not Ready Then
        Return 0
    End If

    ReturnValue = BattleEffects.FlashOpacity(State)

    Return ReturnValue

End Function

Public Function ActiveParticleCount() As Number

    Dim ReturnValue As Number

    If Not Ready Then
        Return 0
    End If

    ReturnValue = BattleEffects.ActiveCount(State)

    Return ReturnValue

End Function

Public Function CurrentCameraName() As Text

    Dim ReturnValue As Text

    If Not Ready Then
        Return "2D FALLBACK"
    End If

    ReturnValue = BattleCamera.CurrentShotName(State)

    If BattleCamera.IsManualOrbiting(State) Then
        ReturnValue = ReturnValue + " // PLAYER ORBIT"
    Else If BattleCamera.IsManualDragging(State) Then
        ReturnValue = ReturnValue + " // PLAYER CAMERA"
    Else If BattleCamera.IsManualActive(State) Then
        ReturnValue = ReturnValue + " // RETURNING"
    End If

    Return ReturnValue

End Function

Public Sub Shutdown()

    Dim Index As Number

    If Not Ready Then
        Return
    End If

    For Index = 0 To PARTICLE_OBJECT_COUNT - 1
        Call Graphics3D.DestroyObjectInstance3D(ParticleObjects[Index])
    End For

    For Index = 0 To IMPACT_OBJECT_COUNT - 1
        Call Graphics3D.DestroyObjectInstance3D(ImpactObjects[Index])
    End For

    Call Graphics3D.DestroyObject3D(ParticleTemplate)

    For Index = 0 To DRAGON_OBJECT_COUNT - 1
        Call Graphics3D.DestroyObjectInstance3D(DragonParts[Index])
    End For

    For Index = 0 To CINDERLING_OBJECT_COUNT - 1
        Call Graphics3D.DestroyObjectInstance3D(CinderlingParts[Index])
    End For

    For Index = 0 To PARTY_OBJECT_COUNT - 1
        Call Graphics3D.DestroyObjectInstance3D(PartyParts[Index])
    End For

    For Index = 0 To RIG_TEMPLATE_COUNT - 1
        Call Graphics3D.DestroyObject3D(RigTemplates[Index])
    End For

    For Index = 0 To ARENA_OBJECT_COUNT - 1
        Call Graphics3D.DestroyObject3D(Arena[Index])
    End For

    Call Graphics3D.DestroyMaterial3D(ParticleMaterial)
    Call Graphics3D.DestroyMaterial3D(DragonUnderbellyMaterial)
    Call Graphics3D.DestroyMaterial3D(DragonWingMaterial)
    Call Graphics3D.DestroyMaterial3D(DragonGlowMaterial)
    Call Graphics3D.DestroyMaterial3D(DragonMaterial)
    Call Graphics3D.DestroyMaterial3D(VoidMaterial)
    Call Graphics3D.DestroyMaterial3D(BoneMaterial)
    Call Graphics3D.DestroyMaterial3D(LeatherMaterial)
    Call Graphics3D.DestroyMaterial3D(TorHairMaterial)
    Call Graphics3D.DestroyMaterial3D(ArinHairMaterial)
    Call Graphics3D.DestroyMaterial3D(HairMaterial)
    Call Graphics3D.DestroyMaterial3D(SkinMaterial)
    Call Graphics3D.DestroyMaterial3D(TorMaterial)
    Call Graphics3D.DestroyMaterial3D(LyraMaterial)
    Call Graphics3D.DestroyMaterial3D(FrostMaterial)
    Call Graphics3D.DestroyMaterial3D(MiraMaterial)
    Call Graphics3D.DestroyMaterial3D(SteelMaterial)
    Call Graphics3D.DestroyMaterial3D(ArinMaterial)
    Call Graphics3D.DestroyMaterial3D(LavaMaterial)
    Call Graphics3D.DestroyMaterial3D(BronzeMaterial)
    Call Graphics3D.DestroyMaterial3D(StoneMaterial)
    Call Graphics3D.DestroyMaterial3D(CosmicMaterial)
    Call Graphics3D.DestroyMaterial3D(GridMaterial)
    Call Graphics3D.DestroyMaterial3D(FloorMaterial)
    Call Graphics3D.DestroyTexture3D(CosmicTexture)

    Ready = False
    State = 0

End Sub

End Module
