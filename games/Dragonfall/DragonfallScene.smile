Private Sub CreateCinderling(EnemyIndex As Number, X As Number, Z As Number)

    Dim BaseIndex As Number

    BaseIndex = EnemyIndex * CINDERLING_PARTS_PER_ENEMY
    CinderlingParts[BaseIndex] = Graphics3D.CreateSphere3D(55)

    Call Configure(CinderlingParts[BaseIndex], DragonMaterial, X, 36, Z, 125, 82, 100)

    CinderlingParts[BaseIndex + 1] = Graphics3D.CreateSphere3D(34)

    Call Configure(CinderlingParts[BaseIndex + 1], DragonGlowMaterial, X - 52, 78, Z, 120, 90, 100)

    CinderlingParts[BaseIndex + 2] = Graphics3D.CreateCylinder3D(12, 76)

    Call Configure(CinderlingParts[BaseIndex + 2], DragonMaterial, X - 23, -18, Z - 30, 100, 100, 100)

    CinderlingParts[BaseIndex + 3] = Graphics3D.CreateCylinder3D(12, 76)

    Call Configure(CinderlingParts[BaseIndex + 3], DragonMaterial, X - 23, -18, Z + 30, 100, 100, 100)

    CinderlingParts[BaseIndex + 4] = Graphics3D.CreateCylinder3D(12, 76)

    Call Configure(CinderlingParts[BaseIndex + 4], DragonMaterial, X + 28, -18, Z - 30, 100, 100, 100)

    CinderlingParts[BaseIndex + 5] = Graphics3D.CreateCylinder3D(12, 76)

    Call Configure(CinderlingParts[BaseIndex + 5], DragonMaterial, X + 28, -18, Z + 30, 100, 100, 100)

    CinderlingParts[BaseIndex + 6] = Graphics3D.CreatePyramid3D(88, 72)

    Call Configure(CinderlingParts[BaseIndex + 6], DragonMaterial, X + 15, 82, Z - 68, 100, 100, 100)
    Call Graphics3D.SetObjectRotation(CinderlingParts[BaseIndex + 6], 68, 0, -12)

    CinderlingParts[BaseIndex + 7] = Graphics3D.CreatePyramid3D(88, 72)

    Call Configure(CinderlingParts[BaseIndex + 7], DragonMaterial, X + 15, 82, Z + 68, 100, 100, 100)
    Call Graphics3D.SetObjectRotation(CinderlingParts[BaseIndex + 7], -68, 0, -12)

    CinderlingParts[BaseIndex + 8] = Graphics3D.CreateSphere3D(8)

    Call Configure(CinderlingParts[BaseIndex + 8], LavaMaterial, X - 78, 88, Z - 16, 100, 100, 100)

    CinderlingParts[BaseIndex + 9] = Graphics3D.CreateCylinder3D(16, 105)

    Call Configure(CinderlingParts[BaseIndex + 9], DragonGlowMaterial, X + 82, 42, Z, 100, 100, 100)
    Call Graphics3D.SetObjectRotation(CinderlingParts[BaseIndex + 9], 0, 0, -72)

End Sub

Private Sub CreateCinderlings()

    Call CreateCinderling(0, 250, -280)
    Call CreateCinderling(1, 390, 40)
    Call CreateCinderling(2, 270, 380)

End Sub

Private Sub EnlargeAndPlaceDragon()

    Dim Index As Number
    Dim PivotX As Number
    Dim PivotY As Number
    Dim PivotZ As Number
    Dim TargetX As Number
    Dim ScalePercent As Number

    PivotX = 210
    PivotY = -55
    PivotZ = 45
    TargetX = 360
    ScalePercent = 135

    For Index = 0 To DRAGON_OBJECT_COUNT - 1

        Call Graphics3D.SetObjectPosition(
            DragonParts[Index],
            TargetX + (DragonParts[Index].Position.X - PivotX) * ScalePercent / 100,
            PivotY + (DragonParts[Index].Position.Y - PivotY) * ScalePercent / 100,
            PivotZ + (DragonParts[Index].Position.Z - PivotZ) * ScalePercent / 100
        )
        Call Graphics3D.SetObjectScale(
            DragonParts[Index],
            DragonParts[Index].ScaleX * ScalePercent / 100,
            DragonParts[Index].ScaleY * ScalePercent / 100,
            DragonParts[Index].ScaleZ * ScalePercent / 100
        )
    End For

End Sub

