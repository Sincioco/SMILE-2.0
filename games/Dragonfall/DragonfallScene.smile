Import Smile.Simple3D.FixedMath As Math3D
Import Smile.Simple3D.Graphics3D As Graphics3D
Import Smile.Battle3D.Articulation As Articulation
Import Smile.Battle3D.Camera As BattleCamera
Import Smile.Battle3D.Effects As BattleEffects
Import Dragonfall.Battle As Battle

Public Const SHOT_WIDE = 1
Public Const SHOT_PARTY = 2
Public Const SHOT_DRAGON = 3
Public Const SHOT_ATTACK = 4
Public Const SHOT_MAGIC = 5
Public Const SHOT_IMPACT = 6
Public Const SHOT_BREATH = 7
Public Const SHOT_ENRAGE = 8
Public Const SHOT_DEATH = 9
Public Const SHOT_VICTORY = 10
Public Const SHOT_BOSS_ENTRANCE = 11
Public Const SHOT_IDLE_PARTY_BACK = 12

