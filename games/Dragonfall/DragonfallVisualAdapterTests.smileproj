<SmileProject Version="1.0">
  <PropertyGroup>
    <ProjectKind>Game</ProjectKind>
    <StartupFile>DragonfallVisualAdapterTests.smile</StartupFile>
    <OutputName>DragonfallVisualAdapterTests</OutputName>
    <ApplicationId>smile.tests.dragonfall.visual-adapter</ApplicationId>
  </PropertyGroup>
  <ItemGroup>
    <SmileSource Include="DragonfallVisualAdapterTests.smile" StartupOnly="true" />
    <SmileSource Include="DragonfallVisualActor.smile" />
    <Asset Include="TechnicalAssets\Generation2\AnimationArticulated.sm3d" />
    <Asset Include="TechnicalAssets\Generation2\AnimationArticulatedMissingTexture.sm3d" />
    <Asset Include="TechnicalAssets\Generation2\VfxAtlas.png" />
    <SmileProjectReference Include="..\..\libraries\Smile.Simple3D\Smile.Simple3D.smilelibproj" />
  </ItemGroup>
</SmileProject>
