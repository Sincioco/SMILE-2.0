<SmileProject Version="1.0">
  <PropertyGroup>
    <ProjectKind>Game</ProjectKind>
    <StartupFile>..\..\tools\Character3DViewer\Program.smile</StartupFile>
    <OutputName>Character3DViewerPrecooked</OutputName>
    <ApplicationId>smile.tools.character3d-viewer-precooked</ApplicationId>
    <RememberWindowPlacement>true</RememberWindowPlacement>
    <ResponsiveWindow>true</ResponsiveWindow>
    <GraphicsBackend>DirectX</GraphicsBackend>
    <VSync>true</VSync>
  </PropertyGroup>
  <ItemGroup>
    <SmileSource Include="..\..\tools\Character3DViewer\Program.smile" StartupOnly="true" />
    <SmileSource Include="..\..\tools\Character3DViewer\Profiles.smile" />
    <Asset Include="Assets\Generation2\ArinV55\ArinV55.sm3d" />
    <Asset Include="Assets\Generation2\ArinV55\Textures\ArinV55-m0-base-color-86d0e5baea69.png" />
    <Asset Include="Assets\Generation2\ArinV55\Textures\ArinV55-m0-normal-559cefd6d085.png" />
    <Asset Include="Assets\Generation2\ArinV55\Textures\ArinV55-m0-orm-3ebee4335ebd.png" />
    <Asset Include="Assets\Generation2\ArinV55\Textures\ArinV55-m1-base-color-531735e0eb8c.png" />
    <Asset Include="Assets\Generation2\ArinV55\Textures\ArinV55-m1-normal-e2ea7fdb9e58.png" />
    <Asset Include="Assets\Generation2\ArinV55\Textures\ArinV55-m1-orm-8fa59370084a.png" />
    <Asset Include="Assets\Generation2\Arin\ArinPrototype.sm3d" />
    <Asset Include="Assets\Generation2\Arin\Textures\Arin-base-color.png" />
    <Asset Include="Assets\Generation2\Arin\Textures\Arin-normal.png" />
    <Asset Include="Assets\Generation2\Arin\Textures\Arin-orm.png" />
    <Asset Include="TechnicalAssets\Generation2\AnimationArticulated.sm3d" />
    <Asset Include="TechnicalAssets\Generation2\VfxAtlas.png" />
    <SmileProjectReference Include="..\..\libraries\Smile.Simple3D\Smile.Simple3D.smilelibproj" />
  </ItemGroup>
</SmileProject>
