<SmileProject Version="1.0">
  <PropertyGroup>
    <ProjectKind>Console</ProjectKind>
    <StartupFile>DragonfallTests.smile</StartupFile>
    <OutputName>DragonfallTests</OutputName>
    <ApplicationId>smile.tests.dragonfall</ApplicationId>
  </PropertyGroup>
  <ItemGroup>
    <SmileSource Include="DragonfallTests.smile" />
    <SmileSource Include="DragonfallBattle.smile" />
    <SmileProjectReference Include="..\..\libraries\Smile.RPG\Smile.RPG.smilelibproj" />
    <SmileProjectReference Include="..\..\libraries\Smile.BattleTime\Smile.BattleTime.smilelibproj" />
  </ItemGroup>
</SmileProject>
