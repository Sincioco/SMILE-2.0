    Return CurrentVisualStep

End Function

Public Function VisualActor() As Number

    Return CurrentActor

End Function

Public Function VisualTarget() As Number

    Return CurrentTarget

End Function

Public Function DamageNumber() As Number

    Return CurrentDamage

End Function

Public Function VisualImpactLanded() As Boolean

    Return CurrentImpactLanded

End Function

Public Sub SetDemoCatastropheEnabled(Enabled As Boolean)

    DemoCatastropheEnabled = Enabled

End Sub

Public Function DemoCatastropheWasUsed() As Boolean

    Return CatastropheUsed

End Function

Public Function Message() As Text

    Return CurrentMessage

End Function

Public Function IsPhaseTwo() As Boolean

    Return PhaseTwo

End Function

Public Function BossIsIntroduced() As Boolean

    Return BossIntroduced

End Function

Public Function EnemyIsActive(ParticipantId As Number) As Boolean

    Dim ReturnValue As Boolean

    If (ParticipantId < PARTICIPANT_CINDERLING_ONE Or
        ParticipantId > PARTICIPANT_ASHWING) Then
        Return False
    End If

    If ParticipantId = PARTICIPANT_ASHWING And Not BossIntroduced Then
        Return False
    End If

    ReturnValue = BattleCore.IsAlive(State, ParticipantId)

    Return ReturnValue

End Function

Public Function ActiveEnemyCount() As Number

    Dim ParticipantId As Number
    Dim EnemyCount As Number

    For ParticipantId = PARTICIPANT_CINDERLING_ONE To PARTICIPANT_ASHWING

        If EnemyIsActive(ParticipantId) Then
            EnemyCount = EnemyCount + 1
        End If

    End For

    Return EnemyCount

End Function

Public Function Health(ParticipantId As Number) As Number

    Dim ReturnValue As Number

    ReturnValue = BattleCore.Health(State, ParticipantId)

    Return ReturnValue

End Function

Public Function MaximumHealth(ParticipantId As Number) As Number

    Dim ReturnValue As Number

    ReturnValue = BattleCore.MaximumHealth(State, ParticipantId)

    Return ReturnValue

End Function

Public Function MagicPoints(ParticipantId As Number) As Number

    Dim ReturnValue As Number

    ReturnValue = BattleCore.MagicPoints(State, ParticipantId)

    Return ReturnValue

End Function

Public Function MaximumMagicPoints(ParticipantId As Number) As Number

    Dim ReturnValue As Number

    ReturnValue = BattleCore.MaximumMagicPoints(State, ParticipantId)

    Return ReturnValue

End Function

Public Function Level(ParticipantId As Number) As Number

    Dim CharacterId As Number
    Dim ReturnValue As Number

    If (ParticipantId = PARTICIPANT_CINDERLING_ONE Or
        ParticipantId = PARTICIPANT_CINDERLING_THREE) Then
        Return LEVEL_INFERNAL_SENTINEL
    Else If ParticipantId = PARTICIPANT_CINDERLING_TWO Then
        Return LEVEL_CINDER_WARDEN
    Else If ParticipantId = PARTICIPANT_ASHWING Then
        Return LEVEL_ASHWING
    Else If ParticipantId < PARTICIPANT_ARIN Or ParticipantId > PARTICIPANT_MIRA Then
        Return 0
    End If

    CharacterId = BattleCore.ParticipantReferenceId(State, ParticipantId)
    ReturnValue = Characters.Level(State, CharacterId)

    Return ReturnValue

End Function

Public Function Gauge(ParticipantId As Number) As Number

    Dim ReturnValue As Number

    ReturnValue = BattleTime.Gauge(State, ParticipantId)

    Return ReturnValue

End Function

Public Function Outcome() As Number

    Dim ReturnValue As Number

    ReturnValue = BattleCore.Outcome(State)

    Return ReturnValue

End Function

Public Function IsResultSequenceComplete() As Boolean

    Dim ReturnValue As Boolean

    ReturnValue = ResultShown And CurrentVisualStep = 0

    Return ReturnValue

End Function

Public Sub Shutdown()

    Dim Accepted As Boolean

    If State = 0 Then
        Return
    End If

    If BattleTime.IsRunning(State) Then
        Accepted = BattleTime.Finish(State)
    End If

    If BattleCore.IsActive(State) Then
        Accepted = BattleCore.CancelBattle(State)
    End If

    Call RPG.Destroy(State)

    State = 0

End Sub

End Module
