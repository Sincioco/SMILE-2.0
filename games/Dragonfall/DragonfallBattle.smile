''' Original deterministic boss encounter built on Smile.RPG and BattleTime.
Module Dragonfall.Battle

Option Explicit

Import Smile.RPG.Core As RPG
Import Smile.RPG.Characters As Characters
Import Smile.RPG.Party As Party
Import Smile.RPG.Inventory As Inventory
Import Smile.RPG.Abilities As Abilities
Import Smile.RPG.BattleEffects As Effects
Import Smile.RPG.BattleCore As BattleCore
Import Smile.RPG.BattleTime As BattleTime

Public Const PARTICIPANT_ARIN = 1
Public Const PARTICIPANT_TOR = 2
Public Const PARTICIPANT_LYRA = 3
Public Const PARTICIPANT_MIRA = 4
Public Const PARTICIPANT_CINDERLING_ONE = 5
Public Const PARTICIPANT_CINDERLING_TWO = 6
Public Const PARTICIPANT_CINDERLING_THREE = 7
Public Const PARTICIPANT_ASHWING = 8

Public Const VISUAL_IDLE = 0
Public Const VISUAL_ARIN_ATTACK = 1
Public Const VISUAL_ARIN_EMBER = 2
Public Const VISUAL_MIRA_FLAME = 3
Public Const VISUAL_MIRA_FROST = 4
Public Const VISUAL_ITEM = 5
Public Const VISUAL_TOR_ATTACK = 6
Public Const VISUAL_TOR_BASH = 7
Public Const VISUAL_DEFEND = 8
Public Const VISUAL_DRAGON_CLAW = 9
Public Const VISUAL_DRAGON_BREATH = 10
Public Const VISUAL_DRAGON_TAIL = 11
Public Const VISUAL_ENRAGE = 12
Public Const VISUAL_VICTORY = 13
Public Const VISUAL_DEFEAT = 14
Public Const VISUAL_LYRA_ATTACK = 15
Public Const VISUAL_LYRA_MEND = 16
Public Const VISUAL_CINDERLING_ATTACK = 17
Public Const VISUAL_BOSS_ENTRANCE = 18
Public Const VISUAL_MIRA_LIGHTNING = 19
Public Const VISUAL_DRAGON_CATASTROPHE = 20

Public Const COMMAND_ATTACK = 1
Public Const COMMAND_SPECIAL = 2
Public Const COMMAND_HEAL = 3
Public Const COMMAND_DEFEND = 4
Public Const COMMAND_ITEM = 5
Public Const COMMAND_SKILL_ONE = 6
Public Const COMMAND_SKILL_TWO = 7
Public Const COMMAND_SKILL_THREE = 8

Public Const EFFECT_SLASH = 1
Public Const EFFECT_FIRE = 2
Public Const EFFECT_FROST = 3
Public Const EFFECT_HEAL = 4
Public Const EFFECT_BREATH = 5
Public Const EFFECT_ENRAGE = 6
Public Const EFFECT_DEATH = 7
Public Const EFFECT_BASH = 8
Public Const EFFECT_AURORA = 9
Public Const EFFECT_LIGHTNING = 10
Public Const EFFECT_BURNING = 11
Public Const EFFECT_CATASTROPHE = 12

Private Const CHARACTER_ARIN = 100
Private Const CHARACTER_MIRA = 101
Private Const CHARACTER_TOR = 102
Private Const CHARACTER_LYRA = 103
Private Const ENEMY_CINDERLING = 199
Private Const ENEMY_CINDER_WARDEN = 198
Private Const ENEMY_ASHWING = 200
Private Const FORMATION_ASHWING = 300
Private Const ITEM_CINDER_TONIC = 400
Private Const ABILITY_AEGIS_BREAK = 500
Private Const ABILITY_FLAME = 501
Private Const ABILITY_FROST = 502
Private Const ABILITY_MEND = 503
Private Const ABILITY_METEOR_BARRAGE = 504
Private Const ABILITY_FIRE_BREATH = 505
Private Const ABILITY_TAIL_SWEEP = 506
Private Const ABILITY_LIGHTNING = 507
Private Const ABILITY_CALDERA_ANNIHILATION = 508
Private Const MECHANIC_AEGIS = 600
Private Const MECHANIC_FLAME = 601
Private Const MECHANIC_FROST = 602
Private Const MECHANIC_MEND = 603
Private Const MECHANIC_BASH = 604
Private Const MECHANIC_BREATH = 605
Private Const MECHANIC_TAIL = 606
Private Const MECHANIC_TONIC = 607
Private Const MECHANIC_LIGHTNING = 608
Private Const MECHANIC_CATASTROPHE = 609
Private Const STATUS_BURNING = 700
Private Const ACTION_VISUAL_STEPS = 72
Private Const ENRAGE_VISUAL_STEPS = 150
Private Const BOSS_ENTRANCE_VISUAL_STEPS = 240
Private Const RESULT_VISUAL_STEPS = 360
Private Const LEVEL_INFERNAL_SENTINEL = 17
Private Const LEVEL_CINDER_WARDEN = 20
Private Const LEVEL_ASHWING = 24

Private Dim State As Number
Private Dim CurrentVisual As Number
Private Dim CurrentVisualStep As Number
Private Dim CurrentVisualDuration As Number
Private Dim CurrentActor As Number
Private Dim CurrentTarget As Number
Private Dim CurrentDamage As Number
Private Dim CurrentMessage As Text
Private Dim CurrentImpactLanded As Boolean
Private Dim PhaseTwo As Boolean
Private Dim PhaseTwoPending As Boolean
Private Dim BossIntroduced As Boolean
Private Dim BossIntroductionPending As Boolean
Private Dim ResultShown As Boolean
Private Dim DemoCatastropheEnabled As Boolean
Private Dim CatastropheUsed As Boolean
Private Dim EventStart As Number
Private Dim Character As Characters.CharacterDefinition
Private Dim Enemy As BattleCore.EnemyDefinition
Private Dim Formation As BattleCore.FormationDefinition
Private Dim Member As BattleCore.FormationMemberDefinition
Private Dim Effect As Effects.EffectDefinition
Private Dim Component As Effects.EffectComponentDefinition
Private Dim Ability As Abilities.AbilityDefinition
Private Dim Item As Inventory.ItemDefinition
Private Dim Status As Effects.StatusDefinition

Public Function Initialize() As Boolean

    State = RPG.Create()

    If State = 0 Then
        Return False
    End If

    If (Not DefineParty() Or
        Not DefineMechanics() Or
        Not DefineBoss() Or
        BattleCore.BeginBattle(State, FORMATION_ASHWING, 7301) = 0 Or
        Not BattleTime.Begin(State, BattleTime.BATTLE_TIME_MODE_WAIT, 4)) Then
        Call Shutdown()

        Return False
    End If

    ''' Dragonfall opts into the reusable progression-aware accuracy system. The
    ''' proficiency values represent each role's weapon training; Level, combat
    ''' statistics, and future equipment bonuses are added by Smile.RPG.

    If (Not BattleCore.ConfigureAttackBaseHitChance(State, BattleCore.BATTLE_SIDE_PARTY, 91) Or
        Not BattleCore.ConfigureAttackProficiencyBonus(State, PARTICIPANT_ARIN, 2) Or
        Not BattleCore.ConfigureAttackProficiencyBonus(State, PARTICIPANT_TOR, 4) Or
        Not BattleCore.ConfigureAttackProficiencyBonus(State, PARTICIPANT_LYRA, 1) Or
        Not BattleCore.ConfigureAttackProficiencyBonus(State, PARTICIPANT_MIRA, 3)) Then
        Call Shutdown()

        Return False
    End If

    CurrentVisual = VISUAL_IDLE
    CurrentVisualStep = 0
    CurrentMessage = "THE BONEGUARD, NECROMANCER, AND DREAD ARCHER BLOCK THE WAY"
    PhaseTwo = False
    PhaseTwoPending = False
    BossIntroduced = False
    BossIntroductionPending = False
    ResultShown = False
    DemoCatastropheEnabled = False
    CatastropheUsed = False
    Return True

End Function

Private Function AddEffectComponent(
    EffectId As Number,
    Kind As Number,
    Power As Number,
    StatusId As Number,
    Duration As Number
) As Boolean

    Dim ReturnValue As Boolean

    Component.EffectId = EffectId
    Component.Kind = Kind
    Component.Power = Power
    Component.StatusId = StatusId
    Component.Duration = Duration
    ReturnValue = Effects.AddComponent(State, Component)

    Return ReturnValue

End Function

Private Function DefineCharacter(Id As Number, Name As Text, Health As Number, MagicPoints As Number, Strength As Number, Defense As Number, Magic As Number, Resistance As Number, Agility As Number, Luck As Number) As Boolean

    Dim ReturnValue As Boolean

    Character.Id = Id
    Character.Name = Name
    Character.StartingLevel = 18
    Character.StartingMaximumHealth = Health
    Character.StartingMaximumMagicPoints = MagicPoints
    Character.Strength = Strength
    Character.Defense = Defense
    Character.Magic = Magic
    Character.Resistance = Resistance
    Character.Agility = Agility
    Character.Luck = Luck
    ReturnValue = Characters.DefineCharacter(State, Character)

    Return ReturnValue

End Function

Private Function DefineParty() As Boolean

    If (Not DefineCharacter(CHARACTER_ARIN, "Arin", 780, 85, 56, 72, 30, 52, 40, 24) Or
        Not DefineCharacter(CHARACTER_TOR, "Tor", 820, 75, 78, 48, 28, 40, 38, 20) Or
        Not DefineCharacter(CHARACTER_LYRA, "Lyra", 600, 210, 30, 40, 70, 72, 52, 32) Or
        Not DefineCharacter(CHARACTER_MIRA, "Mira", 540, 230, 28, 34, 88, 58, 58, 30) Or
        Not Party.AddCharacter(State, CHARACTER_ARIN) Or
        Not Party.AddCharacter(State, CHARACTER_TOR) Or
        Not Party.AddCharacter(State, CHARACTER_LYRA) Or
        Not Party.AddCharacter(State, CHARACTER_MIRA)) Then
        Return False
    End If

    Return True

End Function

Private Function AddEffect(Id As Number, Name As Text, Kind As Number, Power As Number) As Boolean

    Dim ReturnValue As Boolean

    Effect.Id = Id
    Effect.Name = Name

    If Not Effects.DefineEffect(State, Effect) Then
        Return False
    End If

    Component.EffectId = Id
    Component.Kind = Kind
    Component.Power = Power
    Component.StatusId = 0
    Component.Duration = 0
    ReturnValue = Effects.AddComponent(State, Component)

    Return ReturnValue

End Function

Private Function AddAbility(Id As Number, Name As Text, Cost As Number, Power As Number, TargetMode As Number, EffectId As Number) As Boolean

    Dim ReturnValue As Boolean

    Ability.Id = Id
    Ability.Name = Name
    Ability.MagicPointCost = Cost
    Ability.Power = Power
    Ability.TargetMode = TargetMode
    Ability.EffectId = EffectId
    ReturnValue = Abilities.DefineAbility(State, Ability)

    Return ReturnValue

End Function

Private Function DefineMechanics() As Boolean

    Dim ReturnValue As Boolean

    Status.Id = STATUS_BURNING
    Status.Name = "Burning"
    Status.Kind = Effects.BATTLE_STATUS_POISON
    Status.Statistic = 0
    Status.Value = 24
    Status.TickTiming = Effects.BATTLE_STATUS_TICK_ROUND_END

    If Not Effects.DefineStatus(State, Status) Then
        Return False
    End If

    If (Not AddEffect(MECHANIC_AEGIS, "Aegis Break", Effects.BATTLE_EFFECT_PHYSICAL_DAMAGE, 108) Or
        Not AddEffect(MECHANIC_FLAME, "Astral Flame", Effects.BATTLE_EFFECT_MAGIC_DAMAGE, 135) Or
        Not AddEffect(MECHANIC_FROST, "Comet Frost", Effects.BATTLE_EFFECT_MAGIC_DAMAGE, 128) Or
        Not AddEffect(MECHANIC_LIGHTNING, "Skybreaker Arc", Effects.BATTLE_EFFECT_MAGIC_DAMAGE, 148) Or
        Not AddEffect(MECHANIC_MEND, "Starlight Mend", Effects.BATTLE_EFFECT_HEAL_HEALTH, 155) Or
        Not AddEffect(MECHANIC_BASH, "Meteor Barrage", Effects.BATTLE_EFFECT_PHYSICAL_DAMAGE, 142) Or
        Not AddEffect(MECHANIC_BREATH, "Cataclysm Breath", Effects.BATTLE_EFFECT_MAGIC_DAMAGE, 108) Or
        Not AddEffect(MECHANIC_CATASTROPHE, "Caldera Annihilation", Effects.BATTLE_EFFECT_MAGIC_DAMAGE, 1400) Or
        Not AddEffect(MECHANIC_TAIL, "Volcanic Tail", Effects.BATTLE_EFFECT_PHYSICAL_DAMAGE, 82) Or
        Not AddEffect(MECHANIC_TONIC, "Cinder Tonic", Effects.BATTLE_EFFECT_HEAL_HEALTH, 180)) Then
        Return False
    End If

    If (Not AddEffectComponent(MECHANIC_BREATH, Effects.BATTLE_EFFECT_APPLY_STATUS, 0, STATUS_BURNING, 3) Or
        Not AddEffectComponent(MECHANIC_CATASTROPHE, Effects.BATTLE_EFFECT_APPLY_STATUS, 0, STATUS_BURNING, 3)) Then
        Return False
    End If

    If (Not AddAbility(ABILITY_AEGIS_BREAK, "Aegis Break", 7, 108, RPG.RPG_TARGET_ONE_ENEMY, MECHANIC_AEGIS) Or
        Not AddAbility(ABILITY_FLAME, "Astral Flame", 10, 135, RPG.RPG_TARGET_ONE_ENEMY, MECHANIC_FLAME) Or
        Not AddAbility(ABILITY_FROST, "Comet Frost", 9, 128, RPG.RPG_TARGET_ONE_ENEMY, MECHANIC_FROST) Or
        Not AddAbility(ABILITY_LIGHTNING, "Skybreaker Arc", 12, 148, RPG.RPG_TARGET_ONE_ENEMY, MECHANIC_LIGHTNING) Or
        Not AddAbility(ABILITY_MEND, "Starlight Mend", 8, 155, RPG.RPG_TARGET_ONE_ALLY, MECHANIC_MEND) Or
        Not AddAbility(ABILITY_METEOR_BARRAGE, "Meteor Barrage", 7, 142, RPG.RPG_TARGET_ONE_ENEMY, MECHANIC_BASH) Or
        Not AddAbility(ABILITY_FIRE_BREATH, "Cataclysm Breath", 0, 48, RPG.RPG_TARGET_ALL_ENEMIES, MECHANIC_BREATH) Or
        Not AddAbility(ABILITY_CALDERA_ANNIHILATION, "Caldera Annihilation", 0, 1400, RPG.RPG_TARGET_ALL_ENEMIES, MECHANIC_CATASTROPHE) Or
        Not AddAbility(ABILITY_TAIL_SWEEP, "Volcanic Tail", 0, 42, RPG.RPG_TARGET_ALL_ENEMIES, MECHANIC_TAIL)) Then
        Return False
    End If

    If (Not Abilities.LearnAbility(State, CHARACTER_ARIN, ABILITY_AEGIS_BREAK) Or
        Not Abilities.LearnAbility(State, CHARACTER_MIRA, ABILITY_FLAME) Or
        Not Abilities.LearnAbility(State, CHARACTER_MIRA, ABILITY_FROST) Or
        Not Abilities.LearnAbility(State, CHARACTER_MIRA, ABILITY_LIGHTNING) Or
        Not Abilities.LearnAbility(State, CHARACTER_LYRA, ABILITY_MEND) Or
        Not Abilities.LearnAbility(State, CHARACTER_TOR, ABILITY_METEOR_BARRAGE)) Then
        Return False
    End If

    Item.Id = ITEM_CINDER_TONIC
    Item.Name = "Cinder Tonic"
    Item.Kind = RPG.RPG_ITEM_CONSUMABLE
    Item.MaximumStack = 9
    Item.BasePrice = 25
    Item.CanSell = True
    Item.EffectId = MECHANIC_TONIC
    Item.EquipmentSlotId = 0

    ReturnValue = Inventory.DefineItem(State, Item) And Inventory.AddItem(State, ITEM_CINDER_TONIC, 3)

    Return ReturnValue

End Function

Private Function DefineBoss() As Boolean

    Dim ReturnValue As Boolean

    Enemy.Id = ENEMY_CINDERLING
    Enemy.Name = "Cinderling"
    Enemy.MaximumHealth = 210
    Enemy.MaximumMagicPoints = 0
    Enemy.Strength = 26
    Enemy.Defense = 12
    Enemy.Magic = 8
    Enemy.Resistance = 10
    Enemy.Agility = 38
    Enemy.Luck = 5
    Enemy.ExperienceReward = 35
    Enemy.GoldReward = 20
    Enemy.AiProfileId = 1

    If Not BattleCore.DefineEnemy(State, Enemy) Then
        Return False
    End If

    Enemy.Id = ENEMY_CINDER_WARDEN
    Enemy.Name = "Cinder Warden"
    Enemy.MaximumHealth = 560
    Enemy.MaximumMagicPoints = 80
    Enemy.Strength = 38
    Enemy.Defense = 22
    Enemy.Magic = 24
    Enemy.Resistance = 20
    Enemy.Agility = 34
    Enemy.Luck = 9
    Enemy.ExperienceReward = 110
    Enemy.GoldReward = 75
    Enemy.AiProfileId = 1

    If Not BattleCore.DefineEnemy(State, Enemy) Then
        Return False
    End If

    Enemy.Id = ENEMY_ASHWING
    Enemy.Name = "Ashwing, Caldera Tyrant"
    Enemy.MaximumHealth = 3000
    Enemy.MaximumMagicPoints = 999
    Enemy.Strength = 62
    Enemy.Defense = 24
    Enemy.Magic = 68
    Enemy.Resistance = 24
    Enemy.Agility = 34
    Enemy.Luck = 12
    Enemy.ExperienceReward = 950
    Enemy.GoldReward = 700
    Enemy.AiProfileId = 1

    If Not BattleCore.DefineEnemy(State, Enemy) Then
        Return False
    End If

    Formation.Id = FORMATION_ASHWING
    Formation.Name = "The Ember Observatory"
    Formation.EscapeChance = 0

    If Not BattleCore.DefineFormation(State, Formation) Then
        Return False
    End If

    Member.FormationId = FORMATION_ASHWING
    Member.EnemyId = ENEMY_CINDERLING
    Member.GroupId = 1
    Member.SlotId = 1

    If Not BattleCore.AddFormationMember(State, Member) Then
        Return False
    End If

    Member.EnemyId = ENEMY_CINDER_WARDEN
    Member.SlotId = 2

    If Not BattleCore.AddFormationMember(State, Member) Then
        Return False
    End If

    Member.EnemyId = ENEMY_CINDERLING
    Member.SlotId = 3

    If Not BattleCore.AddFormationMember(State, Member) Then
        Return False
    End If

    Member.EnemyId = ENEMY_ASHWING
    Member.GroupId = 2
    Member.SlotId = 4
    ReturnValue = BattleCore.AddFormationMember(State, Member)

    Return ReturnValue

End Function

Private Sub StartVisual(Visual As Number, ActorId As Number, TargetId As Number, Message As Text, Duration As Number)

    CurrentVisual = Visual
    CurrentVisualStep = 1
    CurrentVisualDuration = Duration
    CurrentActor = ActorId
    CurrentTarget = TargetId
    CurrentDamage = 0
    CurrentMessage = Message
    CurrentImpactLanded = True

End Sub

Private Sub BuildActionVisual(FirstEvent As Number)

    Dim Index As Number
    Dim Kind As Number
    Dim ActorId As Number
    Dim TargetId As Number
    Dim SourceId As Number

    For Index = FirstEvent To BattleCore.EventCount(State) - 1

        Kind = BattleCore.EventKindAt(State, Index)
        ActorId = BattleCore.EventActorIdAt(State, Index)
        TargetId = BattleCore.EventTargetIdAt(State, Index)

        If Kind = BattleCore.BATTLE_EVENT_ATTACK Then

            If ActorId = PARTICIPANT_ARIN Then
                Call StartVisual(VISUAL_ARIN_ATTACK, ActorId, TargetId, "ARIN // STARFALL STRIKE", ACTION_VISUAL_STEPS)
            Else If ActorId = PARTICIPANT_TOR Then
                Call StartVisual(VISUAL_TOR_ATTACK, ActorId, TargetId, "TOR // IRON COMET", ACTION_VISUAL_STEPS)
            Else If ActorId = PARTICIPANT_MIRA Then
                Call StartVisual(VISUAL_MIRA_FLAME, ActorId, TargetId, "MIRA // ARCANE BOLT", ACTION_VISUAL_STEPS)
            Else If ActorId = PARTICIPANT_LYRA Then
                Call StartVisual(VISUAL_LYRA_ATTACK, ActorId, TargetId, "LYRA // GALE LANCE", ACTION_VISUAL_STEPS)
            Else If ActorId = PARTICIPANT_CINDERLING_ONE Then
                Call StartVisual(VISUAL_CINDERLING_ATTACK, ActorId, TargetId, "BONEGUARD // GRAVE CLEAVE", ACTION_VISUAL_STEPS)
            Else If ActorId = PARTICIPANT_CINDERLING_TWO Then
                Call StartVisual(VISUAL_CINDERLING_ATTACK, ActorId, TargetId, "NECROMANCER // SOUL HEX", ACTION_VISUAL_STEPS)
            Else If ActorId = PARTICIPANT_CINDERLING_THREE Then
                Call StartVisual(VISUAL_CINDERLING_ATTACK, ActorId, TargetId, "DREAD ARCHER // BLACK ARROW", ACTION_VISUAL_STEPS)
            Else

                Call StartVisual(VISUAL_DRAGON_CLAW, ActorId, TargetId, "ASHWING // OBSIDIAN CLAW", ACTION_VISUAL_STEPS)
            End If

        Else If Kind = BattleCore.BATTLE_EVENT_ABILITY Then

            SourceId = BattleCore.EventValueOneAt(State, Index)

            If SourceId = ABILITY_AEGIS_BREAK Then
                Call StartVisual(VISUAL_ARIN_EMBER, ActorId, TargetId, "ARIN // AEGIS BREAK", ACTION_VISUAL_STEPS)
            Else If SourceId = ABILITY_FLAME Then
                Call StartVisual(VISUAL_MIRA_FLAME, ActorId, TargetId, "MIRA // ASTRAL FLAME", ACTION_VISUAL_STEPS)
            Else If SourceId = ABILITY_FROST Then
                Call StartVisual(VISUAL_MIRA_FROST, ActorId, TargetId, "MIRA // COMET FROST", ACTION_VISUAL_STEPS)
            Else If SourceId = ABILITY_LIGHTNING Then
                Call StartVisual(VISUAL_MIRA_LIGHTNING, ActorId, TargetId, "MIRA // SKYBREAKER ARC", ACTION_VISUAL_STEPS + 12)
            Else If SourceId = ABILITY_MEND Then
                Call StartVisual(VISUAL_LYRA_MEND, ActorId, TargetId, "LYRA // AURORA MEND", ACTION_VISUAL_STEPS)
            Else If SourceId = ABILITY_METEOR_BARRAGE Then
                Call StartVisual(VISUAL_TOR_BASH, ActorId, TargetId, "TOR // METEOR BARRAGE", ACTION_VISUAL_STEPS)
            Else If SourceId = ABILITY_FIRE_BREATH Then
                Call StartVisual(VISUAL_DRAGON_BREATH, ActorId, TargetId, "ASHWING // CATACLYSM BREATH", ACTION_VISUAL_STEPS + 24)
            Else If SourceId = ABILITY_CALDERA_ANNIHILATION Then
                Call StartVisual(VISUAL_DRAGON_CATASTROPHE, ActorId, TargetId, "ASHWING // CALDERA ANNIHILATION", ENRAGE_VISUAL_STEPS)
            Else If SourceId = ABILITY_TAIL_SWEEP Then
                Call StartVisual(VISUAL_DRAGON_TAIL, ActorId, TargetId, "ASHWING // VOLCANIC TAIL", ACTION_VISUAL_STEPS)
            End If

        Else If Kind = BattleCore.BATTLE_EVENT_DEFEND Then

            If ActorId <> PARTICIPANT_ASHWING Or BossIntroduced Then
                Call StartVisual(VISUAL_DEFEND, ActorId, 0, BattleCore.EventTextAt(State, Index), 48)
            End If

        Else If Kind = BattleCore.BATTLE_EVENT_ITEM Then

            Call StartVisual(VISUAL_ITEM, ActorId, TargetId, "CINDER TONIC", 56)

        Else If Kind = BattleCore.BATTLE_EVENT_DAMAGE Then

            CurrentDamage = BattleCore.EventValueOneAt(State, Index)
            CurrentTarget = TargetId

        Else If Kind = BattleCore.BATTLE_EVENT_HEAL Then

            CurrentDamage = -BattleCore.EventValueOneAt(State, Index)
            CurrentTarget = TargetId

        Else If Kind = BattleCore.BATTLE_EVENT_MISS Then

            CurrentImpactLanded = False
            CurrentDamage = 0
            CurrentTarget = TargetId
            CurrentMessage = CurrentMessage + " // MISS"

        End If

    End For

End Sub

Private Sub SubmitBossIfReady()

    Dim EnemyParticipant As Number
    Dim Round As Number
    Dim TargetParticipant As Number
    Dim Accepted As Boolean

    EnemyParticipant = BattleTime.NextReadyEnemy(State)

    If EnemyParticipant = 0 Then
        Return
    End If

    If EnemyParticipant <= PARTICIPANT_CINDERLING_THREE Then
        Accepted = BattleTime.SubmitReadyEnemyAttack(State, EnemyParticipant, LowestLivingParty())

        Return
    End If

    If Not BossIntroduced Then
        Accepted = BattleTime.SubmitAction(State, EnemyParticipant, BattleCore.BATTLE_ACTION_DEFEND, 0, 0)

        Return
    End If

    Round = BattleCore.RoundNumber(State) + 1
    TargetParticipant = LowestLivingParty()

    If DemoCatastropheEnabled And Not CatastropheUsed And PhaseTwo Then

        Accepted = BattleTime.SubmitAction(
            State,
            EnemyParticipant,
            BattleCore.BATTLE_ACTION_ABILITY,
            ABILITY_CALDERA_ANNIHILATION,
            TargetParticipant
        )

        If Accepted Then
            CatastropheUsed = True
        End If

        Return

    End If

    If PhaseTwo And Round Mod 2 = 0 Then
        Accepted = BattleTime.SubmitAction(State, EnemyParticipant, BattleCore.BATTLE_ACTION_ABILITY, ABILITY_TAIL_SWEEP, TargetParticipant)
    Else If Round Mod 3 = 0 Or PhaseTwo Then
        Accepted = BattleTime.SubmitAction(State, EnemyParticipant, BattleCore.BATTLE_ACTION_ABILITY, ABILITY_FIRE_BREATH, TargetParticipant)
    Else
        Accepted = BattleTime.SubmitReadyEnemyAttack(State, EnemyParticipant, TargetParticipant)
    End If

End Sub

''' Advances one deterministic battle tick. Player command decisions stay in the startup program.
Public Sub Update()

    Dim Accepted As Boolean

    If CurrentVisualStep > 0 Then

        CurrentVisualStep = CurrentVisualStep + 1

        If CurrentVisualStep > CurrentVisualDuration Then

            CurrentVisualStep = 0
            CurrentVisual = VISUAL_IDLE
            CurrentDamage = 0

        End If

        Return

    End If

    If BossIntroductionPending Then

        BossIntroductionPending = False
        BossIntroduced = True

        Call StartVisual(
            VISUAL_BOSS_ENTRANCE,
            PARTICIPANT_ASHWING,
            0,
            "ASHWING // THE SKY BREAKS OPEN",
            BOSS_ENTRANCE_VISUAL_STEPS
        )

        Return

    End If

    If PhaseTwoPending Then

        PhaseTwoPending = False
        PhaseTwo = True
        Accepted = BattleTime.Configure(State, BattleTime.BATTLE_TIME_MODE_ACTIVE, 5)

        Call StartVisual(VISUAL_ENRAGE, PARTICIPANT_ASHWING, 0, "ASHWING IS ENRAGED!", ENRAGE_VISUAL_STEPS)

        Return

    End If

    If BattleCore.Outcome(State) <> BattleCore.BATTLE_OUTCOME_NONE Then

        If Not ResultShown Then

            ResultShown = True

            If BattleCore.Outcome(State) = BattleCore.BATTLE_OUTCOME_VICTORY Then
                Call StartVisual(VISUAL_VICTORY, 0, 0, "DRAGONFALL // VICTORY", RESULT_VISUAL_STEPS)
            Else

                Call StartVisual(VISUAL_DEFEAT, 0, 0, "THE OBSERVATORY FALLS SILENT", RESULT_VISUAL_STEPS)
            End If

        End If

        Return

    End If

    If BattleCore.Phase(State) = BattleCore.BATTLE_PHASE_RESOLVING Then

        EventStart = BattleCore.EventCount(State)

        If BattleCore.Advance(State) Then

            Call BuildActionVisual(EventStart)

            If (Not BossIntroduced And
                Not BattleCore.IsAlive(State, PARTICIPANT_CINDERLING_ONE) And
                Not BattleCore.IsAlive(State, PARTICIPANT_CINDERLING_TWO) And
                Not BattleCore.IsAlive(State, PARTICIPANT_CINDERLING_THREE)) Then
                BossIntroductionPending = True
            End If

            If (BossIntroduced And
                Not PhaseTwo And
                BattleCore.Health(State, PARTICIPANT_ASHWING) * 10 <= BattleCore.MaximumHealth(State, PARTICIPANT_ASHWING) * 7 And
                BattleCore.IsAlive(State, PARTICIPANT_ASHWING)) Then
                PhaseTwoPending = True
            End If

        End If

        Return

    End If

    Accepted = BattleTime.Advance(State, 1, False)

    Call SubmitBossIfReady()

    If BattleTime.CanStartRound(State) Then
        Accepted = BattleTime.TryStartRound(State)
    End If

End Sub

Private Function FirstLivingEnemy() As Number

    ''' Clear the warden's two escorts before focusing the Wave 1 mini-boss.

    If BattleCore.IsAlive(State, PARTICIPANT_CINDERLING_ONE) Then
        Return PARTICIPANT_CINDERLING_ONE
    End If

    If BattleCore.IsAlive(State, PARTICIPANT_CINDERLING_THREE) Then
        Return PARTICIPANT_CINDERLING_THREE
    End If

    If BattleCore.IsAlive(State, PARTICIPANT_CINDERLING_TWO) Then
        Return PARTICIPANT_CINDERLING_TWO
    End If

    If BossIntroduced And BattleCore.IsAlive(State, PARTICIPANT_ASHWING) Then
        Return PARTICIPANT_ASHWING
    End If

    Return 0

End Function

Public Function SubmitPlayerCommand(ParticipantId As Number, Command As Number) As Boolean

    Dim ReturnValue As Boolean
    Dim EnemyTarget As Number

    If (ParticipantId <= 0 Or
        ParticipantId > PARTICIPANT_MIRA Or
        Not BattleTime.IsReady(State, ParticipantId)) Then
        Return False
    End If

    EnemyTarget = FirstLivingEnemy()

    If Command = COMMAND_DEFEND Then

        ReturnValue = BattleTime.SubmitAction(State, ParticipantId, BattleCore.BATTLE_ACTION_DEFEND, 0, 0)

        Return ReturnValue

    Else If Command = COMMAND_ITEM Then

        ReturnValue = BattleTime.SubmitAction(State, ParticipantId, BattleCore.BATTLE_ACTION_ITEM, ITEM_CINDER_TONIC, LowestLivingParty())

        Return ReturnValue

    Else If Command = COMMAND_HEAL And ParticipantId = PARTICIPANT_LYRA Then

        ReturnValue = BattleTime.SubmitAction(State, ParticipantId, BattleCore.BATTLE_ACTION_ABILITY, ABILITY_MEND, LowestHealthParty())

        Return ReturnValue

    Else If Command = COMMAND_SPECIAL Then

        If ParticipantId = PARTICIPANT_ARIN Then

            ReturnValue = BattleTime.SubmitAction(State, ParticipantId, BattleCore.BATTLE_ACTION_ABILITY, ABILITY_AEGIS_BREAK, EnemyTarget)

            Return ReturnValue

        Else If ParticipantId = PARTICIPANT_TOR Then

            ReturnValue = BattleTime.SubmitAction(State, ParticipantId, BattleCore.BATTLE_ACTION_ABILITY, ABILITY_METEOR_BARRAGE, EnemyTarget)

            Return ReturnValue

        Else If ParticipantId = PARTICIPANT_LYRA Then

            ReturnValue = BattleTime.SubmitAction(State, ParticipantId, BattleCore.BATTLE_ACTION_ABILITY, ABILITY_MEND, LowestHealthParty())

            Return ReturnValue

        Else If ParticipantId = PARTICIPANT_MIRA Then

            If BattleCore.RoundNumber(State) Mod 3 = 0 Then
                ReturnValue = BattleTime.SubmitAction(State, ParticipantId, BattleCore.BATTLE_ACTION_ABILITY, ABILITY_FLAME, EnemyTarget)

                Return ReturnValue
            Else If BattleCore.RoundNumber(State) Mod 3 = 1 Then
                ReturnValue = BattleTime.SubmitAction(State, ParticipantId, BattleCore.BATTLE_ACTION_ABILITY, ABILITY_FROST, EnemyTarget)

                Return ReturnValue
            End If

            ReturnValue = BattleTime.SubmitAction(State, ParticipantId, BattleCore.BATTLE_ACTION_ABILITY, ABILITY_LIGHTNING, EnemyTarget)

            Return ReturnValue

        End If

    Else If Command = COMMAND_SKILL_ONE Then

        If ParticipantId = PARTICIPANT_ARIN Then
            ReturnValue = BattleTime.SubmitAction(State, ParticipantId, BattleCore.BATTLE_ACTION_ABILITY, ABILITY_AEGIS_BREAK, EnemyTarget)

            Return ReturnValue
        Else If ParticipantId = PARTICIPANT_TOR Then
            ReturnValue = BattleTime.SubmitAction(State, ParticipantId, BattleCore.BATTLE_ACTION_ABILITY, ABILITY_METEOR_BARRAGE, EnemyTarget)

            Return ReturnValue
        Else If ParticipantId = PARTICIPANT_LYRA Then
            ReturnValue = BattleTime.SubmitAction(State, ParticipantId, BattleCore.BATTLE_ACTION_ABILITY, ABILITY_MEND, LowestHealthParty())

            Return ReturnValue
        Else If ParticipantId = PARTICIPANT_MIRA Then
            ReturnValue = BattleTime.SubmitAction(State, ParticipantId, BattleCore.BATTLE_ACTION_ABILITY, ABILITY_FLAME, EnemyTarget)

            Return ReturnValue
        End If

    Else If Command = COMMAND_SKILL_TWO And ParticipantId = PARTICIPANT_MIRA Then

        ReturnValue = BattleTime.SubmitAction(State, ParticipantId, BattleCore.BATTLE_ACTION_ABILITY, ABILITY_FROST, EnemyTarget)

        Return ReturnValue

    Else If Command = COMMAND_SKILL_THREE And ParticipantId = PARTICIPANT_MIRA Then

        ReturnValue = BattleTime.SubmitAction(State, ParticipantId, BattleCore.BATTLE_ACTION_ABILITY, ABILITY_LIGHTNING, EnemyTarget)

        Return ReturnValue

    End If

    If EnemyTarget = 0 Then
        Return False
    End If

    ReturnValue = BattleTime.SubmitAction(State, ParticipantId, BattleCore.BATTLE_ACTION_ATTACK, 0, EnemyTarget)

    Return ReturnValue

End Function

Public Function NextReadyPlayer() As Number

    Dim ReturnValue As Number

    ReturnValue = BattleTime.NextReadyPlayer(State)

    Return ReturnValue

End Function

Public Function LowestHealthParty() As Number

    Dim ParticipantId As Number
    Dim BestParticipant As Number
    Dim BestRatio As Number
    Dim Ratio As Number

    BestRatio = 1001

    For ParticipantId = PARTICIPANT_ARIN To PARTICIPANT_MIRA

        If BattleCore.IsAlive(State, ParticipantId) Then

            Ratio = BattleCore.Health(State, ParticipantId) * 1000 / BattleCore.MaximumHealth(State, ParticipantId)

            If Ratio < BestRatio Then
                BestRatio = Ratio
                BestParticipant = ParticipantId
            End If

        End If

    End For

    Return BestParticipant

End Function

Public Function LowestLivingParty() As Number

    Dim ParticipantId As Number

    For ParticipantId = PARTICIPANT_ARIN To PARTICIPANT_MIRA

        If BattleCore.IsAlive(State, ParticipantId) Then
            Return ParticipantId
        End If

    End For

    Return 0

End Function

