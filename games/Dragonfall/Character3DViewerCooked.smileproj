<SmileProject Version="1.0">
  <PropertyGroup>
    <ProjectKind>Game</ProjectKind>
    <StartupFile>..\..\tools\Character3DViewer\Program.smile</StartupFile>
    <OutputName>Character3DViewer</OutputName>
    <ApplicationId>smile.tools.character3d-viewer</ApplicationId>
    <RememberWindowPlacement>true</RememberWindowPlacement>
    <ResponsiveWindow>true</ResponsiveWindow>
    <GraphicsBackend>DirectX</GraphicsBackend>
    <VSync>true</VSync>
  </PropertyGroup>
  <ItemGroup>
    <SmileSource Include="..\..\tools\Character3DViewer\Program.smile" StartupOnly="true" />
    <SmileSource Include="..\..\tools\Character3DViewer\Profiles.smile" />
    <Model3DAsset Include="SourceAssets\Arin\arin-integrated-candidate-v5.6.glb"
                  Descriptor="SourceAssets\Arin\ArinV56.sm3d.json"
                  LogicalPath="Assets\Generation2\ArinV56\ArinV56.sm3d"
                  TextureOutputDirectory="Assets\Generation2\ArinV56\Textures"
                  Profile="Character"
                  Identity="sin-star-i.character-1.paladin"
                  ProductionState="Prototype" />
    <Model3DAsset Include="SourceAssets\Arin\sin-star-i-character-1-paladin-tripo-v01.original.glb"
                  Descriptor="SourceAssets\Arin\ArinPrototype.sm3d.json"
                  LogicalPath="Assets\Generation2\Arin\ArinPrototype.sm3d"
                  TextureOutputDirectory="Assets\Generation2\Arin\Textures"
                  Profile="Character"
                  Identity="sin-star-i.character-1.paladin"
                  ProductionState="Prototype" />
    <Asset Include="TechnicalAssets\Generation2\AnimationArticulated.sm3d" />
    <Asset Include="TechnicalAssets\Generation2\VfxAtlas.png" />
    <SmileProjectReference Include="..\..\libraries\Smile.Simple3D\Smile.Simple3D.smilelibproj" />
  </ItemGroup>
</SmileProject>
