<SmileProject Version="1.0">
  <PropertyGroup>
    <ProjectKind>Console</ProjectKind>
    <StartupFile>Tests\PersistenceIsolation.smile</StartupFile>
    <OutputName>RPGSystemsPersistenceTests</OutputName>
    <ApplicationId>smile.tests.rpg-systems-storage</ApplicationId>
  </PropertyGroup>
  <ItemGroup>
