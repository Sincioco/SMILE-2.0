<SmileProject Version="1.0">
  <PropertyGroup>
    <ProjectKind>Console</ProjectKind>
    <StartupFile>Tests\InitializationFailures.smile</StartupFile>
    <OutputName>RPGSystemsInitializationTests</OutputName>
    <ApplicationId>smile.tests.rpg-systems-initialization</ApplicationId>
    <GraphicsBackend>GDI</GraphicsBackend>
    <VSync>false</VSync>
  </PropertyGroup>
  <ItemGroup>
    <SmileSource Include="Tests\InitializationFailures.smile" StartupOnly="true" />
    <SmileSource Include="Storage.smile" />
    <SmileSource Include="BattleSystem.smile" />
    <SmileSource Include="DungeonSystem.smile" />
    <SmileSource Include="DungeonWorkflow.smile" />
    <SmileSource Include="ManagementSystem.smile" />
    <SmileSource Include="WorldSystem.smile" />
    <SmileProjectReference Include="..\..\libraries\Smile.Game\Smile.Game.smilelibproj" />
    <SmileProjectReference Include="..\..\libraries\Smile.RPG\Smile.RPG.smilelibproj" />
    <SmileProjectReference Include="..\..\libraries\Smile.UI\Smile.UI.smilelibproj" />
    <Asset Include="Assets\**\*.png" />
    <Asset Include="Assets\**\*.wav" />
    <Asset Include="Maps\**\*.smilemap" />
  </ItemGroup>
</SmileProject>
